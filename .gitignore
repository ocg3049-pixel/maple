# Claude AI 도구 설정 (게임과 무관)
.claude/

# MSW 플랫폼 제공 파일 (읽기 전용, 변경 불가)
Environment/

# 배포 패키지 (빌드 결과물)
*.mod

# 임시 파일 / 스크린샷
*.tmp
*.png

# 화면 녹화 영상 (용량 큼, 커밋 금지)
*.mp4
*.mov

# 잘못 배치된 파일 폴더
Mislocated/

# macOS 시스템 파일
.DS_Store

# MCP 인증 토큰 포함 (비밀값이라 커밋 금지)
.mcp.json

# 복원에 필요한 게임 이미지 원본
!RootDesk/MyDesk/Assets/**/*.png

# 로컬 에이전트 설정 및 임시 작업 백업
.agents/
.codex/
.builder-work/*.bak
.builder-work/login-original.ui
.builder-work/portal-backup-*/
