@Component
script AngelRayProjectile extends Component

	property number Speed = 6

	property number MaxLifetime = 1.5

	property number CombatPower = 0

	-- 캐릭터 정보창의 실제 크리티컬 확률(%) - PlayerAttack이 발사 시점에 채워준다. CalcCritical/CalcDamage가
	-- 서버에서 실행되는데 장비 잠재능력은 클라이언트 전용 상태라 직접 읽을 수 없어, 발사한 플레이어가
	-- 동기화해둔 값을 그대로 넘겨받는다(아이언에로우와 동일한 구조).
	property number CritRate = 50

	-- 빛줄기 하나가 관통 가능한 최대 대상 수. 엔젤레이는 전방의 적을 10명까지 관통한다
	-- (아이언에로우 6명의 상위 4차 버전 - 사용자 요청 사양).
	property integer MaxHitCount = 10

	-- 쉐도우 파트너: true면 그림자 몫의 "시각 전용" 빛줄기 - 판정(AttackFast) 없이 날아가기만 한다
	-- (그림자 스킬 이펙트는 몬스터에게 직접적인 데미지를 주지 않는다는 요청).
	property boolean VisualOnly = false

	-- 원본 전용(서버에서만 읽음): 쉐도우 파트너 버프 중에 발사됐는지 여부.
	-- 히트 시 원본+보너스(타수 2배) 합산·2줄 표시에 쓰인다.
	property boolean ShadowEchoOn = false

	-- 발사한 플레이어의 "현재" 데미지 스킨 RUID(PlayerAttack이 발사 시점에 채워준다).
	-- 블리자드처럼 스킨을 한시적으로 바꾸는 연출이 이 투사체의 수동 데미지 표시에도 적용되게 하려면
	-- 하드코딩된 기본 스킨 대신 이 값을 써야 한다(비어 있으면 기본 스킨으로 폴백).
	property string DamageSkinRUID = ""

	@Sync
	property boolean Fired = false

	method void OnBeginPlay()
		-- 발사 상태 초기화 (서버 전용 필드). 방향은 기본적으로 전방(+X)을 가리킨다.
		if self:IsServer() then
			self._T.lifetime = 0
			self._T.dirX = 1
			self._T.dirY = 0
			self._T.hitSet = {}
			self._T.hitCount = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void Fire(number dirX, number dirY)
		-- 정규화된 방향 벡터를 받아 발사 시작. 엔젤레이는 8방향 조준 없이 전방(dirY=0)으로만 나가지만,
		-- 쉐도우 에코 공용 헬퍼(SpawnShadowEchoArrowProjectile)와 시그니처를 맞추기 위해 dirY도 받는다.
		-- 빛줄기 스프라이트는 원본 아트가 머리 -x 방향이라 +180도 보정한다(아이언에로우와 동일).
		self._T.dirX = dirX
		self._T.dirY = dirY
		local angleDeg = math.deg(math.atan(dirY, dirX)) + 180
		self.Entity.TransformComponent.ZRotation = angleDeg
		self.Fired = true
	end

	@ExecSpace("ServerOnly")
	method boolean HasHit(string defenderName)
		return self._T.hitSet[defenderName] == true
	end

	@ExecSpace("ServerOnly")
	method boolean HasReachedMaxHits()
		return self._T.hitCount >= self.MaxHitCount
	end

	@ExecSpace("ServerOnly")
	method void MarkHit(string defenderName)
		self._T.hitSet[defenderName] = true
		self._T.hitCount = self._T.hitCount + 1
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if not self.Fired then return end

		self._T.lifetime = self._T.lifetime + delta
		if self._T.lifetime >= self.MaxLifetime then
			_EntityService:Destroy(self.Entity)
			return
		end

		-- 최대 관통 수(10명)만큼 맞혔으면(직전 프레임에 기록됨) 더 이상 판정하지 않고 사라진다.
		if self._T.hitCount >= self.MaxHitCount then
			_EntityService:Destroy(self.Entity)
			return
		end

		self.Entity.TransformComponent:Translate(self._T.dirX * self.Speed * delta, self._T.dirY * self.Speed * delta)

		-- 쉐도우 파트너의 그림자 몫(시각 전용) 빛줄기는 판정 자체를 하지 않는다 - 직접적인 데미지 없음.
		if self.VisualOnly then return end

		---@type AngelRayProjectileAttack
		local ac = self.Entity:GetComponent("script.AngelRayProjectileAttack")
		if ac ~= nil then
			local pos = self.Entity.TransformComponent.Position
			-- (요청) 피격 범위를 위아래로 넓힌다 - 원형(지름 0.6) 대신 세로로 긴 상자(가로 0.6 x 세로 1.2)로
			-- 판정해, 빛줄기 경로보다 조금 위/아래에 있는 적도 맞는다.
			ac:AttackFast(BoxShape(Vector2(pos.x, pos.y), Vector2(0.6, 1.2), 0), "skill.angelray", CollisionGroups.HitBox)
		end
	end

end
