@Component
script HolyArrowProjectile extends Component

	-- (비숍 개편 2026-08-08) 6 → 10. "지금보다 빠르게 날아가야 한다"는 요청으로 비행 속도를 올렸다.
	-- ⚠ 엔젤레이/아이언에로우(둘 다 6)와 갈라진 값이다 - 홀리 에로우만 빠르다.
	property number Speed = 10

	-- 현재 사거리를 추가로 20% 줄인다: 6.3 × 0.8 = 10 × 0.504 = 5.04유닛.
	property number MaxLifetime = 0.504

	property number CombatPower = 0

	-- 캐릭터 정보창의 실제 크리티컬 확률(%) - PlayerAttack이 발사 시점에 채워준다(엔젤레이와 동일한 구조).
	property number CritRate = 50

	-- (비숍 개편 2026-08-08) 화살 1발당 데미지 배율. **아이언 에로우와 완전히 같은 값**이고 공식은
	-- 클라 SkillManager의 GetHolyArrowMinPercent/MaxPercent(→ GetIronArrow*Percent) 한 곳에서 나온다.
	-- PlayerAttack이 발사 시점에 새겨준다 - 구 사양은 CalcDamage가 3.0~4.0으로 고정 계산했다.
	property number RateMin = 1.5
	property number RateMax = 2.0

	-- 화살 하나가 관통 가능한 최대 대상 수. 홀리 에로우는 2차 스킬이라 아이언에로우와 같은 6명이다
	-- (엔젤레이(4차) 10명의 하위 버전).
	property integer MaxHitCount = 6

	-- 쉐도우 파트너: true면 그림자 몫의 "시각 전용" 화살 - 판정(AttackFast) 없이 날아가기만 한다.
	property boolean VisualOnly = false

	-- 원본 전용(서버에서만 읽음): 쉐도우 파트너 버프 중에 발사됐는지 여부.
	property boolean ShadowEchoOn = false

	-- (2026-08-05 개편) 분신 몫의 데미지 배율(본체 대비). PlayerAttack.GetShadowEchoRate()가 계산한
	-- 값을 발사 시점에 새겨준다 - 쉐도우 파트너 투자 레벨에 따라 0.50(1레벨)~0.79(마스터 30)다.
	property number ShadowEchoRate = 0.5

	-- 발사한 플레이어의 "현재" 데미지 스킨 RUID(PlayerAttack이 발사 시점에 채워준다).
	property string DamageSkinRUID = ""

	@Sync
	property boolean Fired = false

	method void OnBeginPlay()
        if self:IsClient() then _NetworkMotionVisual:Register(self.Entity) end
		-- 발사 상태 초기화 (서버 전용 필드). 방향은 기본적으로 전방(+X)을 가리킨다.
		if self:IsServer() then
			self._T.lifetime = 0
			self._T.dirX = 1
			self._T.dirY = 0
			self._T.hitSet = {}
			self._T.hitCount = 0
			self._T.ballFrame = 1
		end
	end

	@ExecSpace("ServerOnly")
	method void Fire(number dirX, number dirY)
		-- 정규화된 방향 벡터를 받아 발사 시작. 홀리 에로우는 8방향 조준 없이 전방(dirY=0)으로만 나가지만,
		-- 쉐도우 에코 공용 헬퍼(SpawnShadowEchoArrowProjectile)와 시그니처를 맞추기 위해 dirY도 받는다.
		-- 화살 스프라이트는 원본 아트가 머리 -x 방향이라 +180도 보정한다(아이언에로우/엔젤레이와 동일).
		self._T.dirX = dirX
		self._T.dirY = dirY
		local angleDeg = math.deg(math.atan(dirY, dirX)) + 180
		self.Entity.TransformComponent.ZRotation = angleDeg
        local attack = self.Entity:GetComponent("script.HolyArrowProjectileAttack")
        local owner = isvalid(attack) and attack.OwnerEntity or nil
        local pa = isvalid(owner) and owner:GetComponent("script.PlayerAttack") or nil
        if not self.VisualOnly and isvalid(pa) then
            pa:PlanFlyingDamage(attack,dirX,dirY,self.Speed*self.MaxLifetime,self.MaxHitCount,.6,"skill.holyarrow",self.MaxLifetime+.5)
            if not pa._T.holyRangeVerified then
                pa._T.holyRangeVerified=true
                if Environment:IsMakerPlay() then log("[VRF] HolyArrow range="..tostring(self.Speed*self.MaxLifetime).." cap="..tostring(self.MaxHitCount).." identity=entityId") end
            end
        end

		self.Fired = true
	end

	@ExecSpace("ServerOnly")
	method boolean HasHit(string defenderId)
		return self._T.hitSet[defenderId] == true
	end

	@ExecSpace("ServerOnly")
	method boolean HasReachedMaxHits()
		return self._T.hitCount >= self.MaxHitCount
	end

	@ExecSpace("ServerOnly")
	method void MarkHit(string defenderId)
		if self._T.hitSet[defenderId] then return end
		self._T.hitSet[defenderId] = true
		self._T.hitCount = self._T.hitCount + 1
	end

	method void OnUpdate(number delta)
		if not self.Fired then return end
		if self:IsClient() then
			self._T.visualAge = (self._T.visualAge or 0) + delta
			if self._T.visualFrames == nil then self._T.visualFrames = {"d8275b5454a84af580d7dc865ae7ada0", "f07b1a483b564ef590bd026dc36c4422", "863eab6bbf1d486794ed8335f4f8c86d"} end
			local index = math.floor(self._T.visualAge / 0.1) % 3 + 1
			local spr = self.Entity.SpriteRendererComponent
			if isvalid(spr) and self._T.visualFrame ~= index then
				self._T.visualFrame = index
				spr.SpriteRUID = self._T.visualFrames[index]
			end
			return
		end

		local step = math.min(delta, math.max(0, self.MaxLifetime - self._T.lifetime))
		if step <= 0 then
			_EntityService:Destroy(self.Entity)
			return
		end

		-- 최대 관통 수(6명)만큼 맞혔으면(직전 프레임에 기록됨) 더 이상 판정하지 않고 사라진다.
		if self._T.hitCount >= self.MaxHitCount then
			_EntityService:Destroy(self.Entity)
			return
		end

		local previous = self.Entity.TransformComponent.WorldPosition
		self._T.lifetime = self._T.lifetime + step
		self.Entity.TransformComponent:Translate(self._T.dirX * self.Speed * step, self._T.dirY * self.Speed * step)

		-- 쉐도우 파트너의 그림자 몫(시각 전용) 화살은 판정 자체를 하지 않는다.
		if self.VisualOnly then return end

		---@type HolyArrowProjectileAttack
		local ac = self.Entity:GetComponent("script.HolyArrowProjectileAttack")
		if ac ~= nil then
			local pos = self.Entity.TransformComponent.WorldPosition
			-- Cover the traveled segment so fast arrows cannot skip enemies between updates.
			local center = Vector2((previous.x + pos.x) / 2, (previous.y + pos.y) / 2)
			local angle = math.deg(math.atan(self._T.dirY, self._T.dirX))
			ac:AttackFast(BoxShape(center, Vector2(self.Speed * step + 0.6, 1.2), angle), "skill.holyarrow", CollisionGroups.HitBox)
		end
	end

end
