@Component
script ShadowClone extends Component

	-- 분신 소환(섀도어 1차, 2026-08-06 신설)
	-- 주인과 **똑같은 외형**의 아바타 NPC를 소환해 곁에서 함께 싸우게 한다.
	-- 구조는 용사 소환(HeroSummon)과 같은 계열이며, 모델도 `herosummon`을 그대로 재사용한다
	-- (Rigidbody + Movement + AvatarRenderer + CostumeManager + NameTag - 분신에 필요한 구성이
	--  정확히 같다. 전용 모델을 새로 만들면 같은 내용이 두 벌로 갈라져 드리프트만 생긴다).
	--
	-- 용사 소환과 다른 점 3가지:
	--   ① **HP가 없다** - 분신은 피격 대상이 아니다. `herosummon` 모델에는 HitComponent가 없고
	--      script.HeroSummon도 붙이지 않으므로, 몬스터의 IsAttackTarget(script.HeroSummon 확인)에
	--      걸리지 않아 자동으로 무적이 된다. 아군 투사체 제외 처리도 필요 없다.
	--   ② 외형은 랜덤이 아니라 **주인의 장비를 그대로 복사**한다(PlayerAttack.SummonShadowClone이
	--      스폰 직후 CostumeManager에 입힌다 - 서버는 플레이어 장비를 직접 읽을 수 없어 클라가
	--      RUID 목록을 RPC로 올려준다).
	--   ③ 지속시간·데미지·사용 스킬 차수를 전부 **주인의 투자 레벨**에서 계산해 주입받는다
	--      (공식은 SkillManager의 GetShadowClone* 헬퍼 한 곳).
	--
	-- 이동은 서버 권한(몬스터/용사와 동일), 아바타 모션은 @Sync 값을 클라가 보고 body 엔티티에
	-- ActionStateChangedEvent를 직접 보내 재생한다(컨트롤러가 없어 엔진 자동 재생과 충돌하지 않는다).
	--
	-- ⚠ SummonShadowClone은 AddComponent 직후 프로퍼티만 대입한다(용사/드래곤과 같은 패턴).
	--   AddComponent와 같은 프레임에 메서드를 호출해 self._T를 만지면 [LEA-2007] '_T' nil이
	--   나거나 프로퍼티 대입이 유실된다(실측) - 실제 초기화는 첫 ServerTick에서 지연 실행한다.

	property Entity OwnerEntity = nil

	-- 주인이 소환 시점에 넣어주는 값들(전부 SkillManager가 투자 레벨로 계산해 RPC로 올린 것).
	property number Lifetime = 30
	-- 분신 데미지 = 본체 데미지의 이 % (50~90).
	property number DamagePercent = 50
	-- 분신이 쓸 수 있는 공격 스킬의 최고 차수(1~4).
	property integer SkillTier = 1
	-- 주인의 전투력(서버가 직접 읽을 수 없는 클라 상태라 시전 시점에 받아둔다).
	property number CombatPower = 0
	-- 주인의 다크사이트 재사용 대기시간(초). 0이면 주인이 안 배운 것 - 분신도 쓰지 않는다.
	-- 분신은 이 값을 기준으로 **쿨타임 ~ 쿨타임×4** 사이 랜덤 주기로 잠복한다(주인 자동사냥과 같은 규칙).
	property number DarkSightCooldown = 0

	-- 아바타 모션 채널(용사 소환과 동일 규격).
	--   LocoState: stand / walk / jump - 이동 상태가 바뀔 때만 대입한다.
	--   MotionCmd: "seq|모션명|재생속도" - 1회성 공격 모션 명령. 단일 문자열이라 필드 간
	--              도착 순서가 어긋날 일이 없고, seq가 같은 모션의 연속 재생을 구분한다.
	@Sync property string LocoState = "stand"
	@Sync property string MotionCmd = ""

	method void OnUpdate(number delta)
		-- 서버=이동/AI, 클라이언트=아바타 모션 반영.
		if self:IsServer() then
			self:ServerTick(delta)
		else
			self:ClientTick(delta)
		end
	end

	---@type PlayerAttack
	method any GetOwnerAttack()
		-- 주인 플레이어의 PlayerAttack(판정/데미지 파이프라인을 그대로 빌려 쓴다).
		if not isvalid(self.OwnerEntity) then return nil end
		return self.OwnerEntity:GetComponent("script.PlayerAttack")
	end

	@ExecSpace("ServerOnly")
	method void InitServer()
		-- 첫 ServerTick에서 한 번만 도는 지연 초기화(상단 ⚠ 주석 참고).
		local now = _UtilLogic.ServerElapsedSeconds
		self._T.faceDir = -1
		self._T.nextTargetAt = 0
		self._T.nextAttackAt = now + 0.4
		self._T.attackLockUntil = 0
		-- 소환 직후 1초는 추적하지 않는다 - 스폰하자마자 발판 밖으로 뛰어나가는 것을 막는다
		-- (용사 소환에서 "소환하자마자 발판 아래로 떨어짐" 신고를 받고 넣은 유예와 같은 이유).
		self._T.noChaseUntil = now + 1.0
		-- (자동사냥 개편 2026-08-06) 헤이스트 보정을 되돌릴 기준값 - 소환 시점의 원본 이동/점프 성능.
		local mvInit = self.Entity.MovementComponent
		if isvalid(mvInit) then
			self._T.baseInputSpeed = mvInit.InputSpeed
			self._T.baseJumpForce = mvInit.JumpForce
		end
		self._T.hasteMultApplied = 1.0
		-- 다크사이트: 첫 잠복은 소환 5~20초 뒤(주인과 시작이 겹치지 않게 흩어 놓는다).
		self._T.dsNextAt = now + 5.0 + _UtilLogic:RandomDouble() * 15.0
		self._T.dsHiddenUntil = 0
		self._T.dsAmbushUntil = 0
		self._T.nextAssaulterAt = 0
		local ntc = self.Entity.NameTagComponent
		if isvalid(ntc) then
			-- 주인과 같은 이름 - "분신"임을 알 수 있게 접두사만 붙인다.
			local ownerName = "분신"
			if isvalid(self.OwnerEntity) and isvalid(self.OwnerEntity.NameTagComponent) then
				ownerName = tostring(self.OwnerEntity.NameTagComponent.Name)
			end
			ntc.Name = ownerName
		end
		-- 수명 만료 시 소멸(주인이 위치 교환으로 자리를 바꿔도 이 시각은 그대로다).
		self._T.lifetimeEndAt = now + self.Lifetime
		_TimerService:SetTimerOnce(function()
			if isvalid(self.Entity) then
				log("[ShadowClone] 소환 종료(수명 " .. tostring(math.floor(self.Lifetime)) .. "초)")
				self.Entity:Destroy()
			end
		end, self.Lifetime)
		log("[ShadowClone] 소환 - 수명 " .. tostring(math.floor(self.Lifetime))
			.. "초 / 데미지 " .. tostring(math.floor(self.DamagePercent))
			.. "% / 스킬 " .. tostring(self.SkillTier) .. "차 / 전투력 " .. tostring(math.floor(self.CombatPower)))
	end

	@ExecSpace("ServerOnly")
	method void ServerTick(number delta)
		-- 이동/표적 선정/공격을 담당하는 서버 루프.
		-- ⚠ 실측(2026-08-06): **한 틱만 미루면 부족하다.** OwnerEntity는 도착했는데 뒤이은
		--   Lifetime/DamagePercent/SkillTier/CombatPower가 아직 기본값인 채로 첫 틱이 돌아
		--   "수명 30초 / 데미지 50% / 전투력 0"으로 굳었다(힐러 소환이 겪은 것과 같은 경쟁 상태).
		--   한 틱 더 기다렸다가 모든 대입이 도착한 뒤의 값을 읽는다.
		if not self._T.inited then
			self._T.initTicks = (self._T.initTicks or 0) + 1
			if self._T.initTicks < 2 then return end
			self._T.inited = true
			self:InitServer()
		end
		if not isvalid(self.Entity) then return end
		-- 주인이 사라졌으면(퇴장/사망 정리) 2초 유예 후 소멸.
		if not isvalid(self.OwnerEntity) then
			self._T.ownerGoneAt = self._T.ownerGoneAt or _UtilLogic.ServerElapsedSeconds
			if _UtilLogic.ServerElapsedSeconds - self._T.ownerGoneAt > 2.0 then
				self.Entity:Destroy()
			end
			return
		end
		self._T.ownerGoneAt = nil

		local now = _UtilLogic.ServerElapsedSeconds
		local mv = self.Entity.MovementComponent
		local rb = self.Entity.RigidbodyComponent
		if not isvalid(mv) or not isvalid(rb) then return end
		local myPos = self.Entity.TransformComponent.WorldPosition
		local ownerPos = self.OwnerEntity.TransformComponent.WorldPosition

		-- (요청 2026-08-06) 주인이 헤이스트를 쓰면 분신도 같은 배율의 이동속도·점프 보정을 받는다.
		self:HasteTick(mv)
		-- (요청 2026-08-06) 분신도 주인과 같은 기준으로 다크사이트를 쓴다(잠복 → 뒤잡기).
		self:DarkSightTick(now)

		-- 주인과 너무 벌어지면 곁으로 순간이동(용사 소환과 같은 규칙).
		-- (요청 2026-08-06) "분신이 주인에게서 좀 더 멀리 떨어져도 돌아오지 않게 - 지금의 3배까지 허용" →
		-- 복귀 거리를 8유닛 → **24유닛**(24² = 576)으로 넓힌다. 표적이 없을 때 곁으로 걸어오는
		-- 기준(FollowOwnerTick)도 같은 배율로 넓혀야 "안 돌아온다"가 실제로 체감된다.
		-- ⚠ SetWorldPosition은 짧은 시간에 나눠 여러 번 부르면 몇 틱 뒤 원위치로 되돌아간다(실측) -
		--   한 번만 호출하고 바로 리턴한다.
		local odx = ownerPos.x - myPos.x
		local ody = ownerPos.y - myPos.y
		if (odx * odx + ody * ody) > 576.0 then
			mv:SetWorldPosition(Vector2(ownerPos.x, ownerPos.y + 0.3))
			self._T.target = nil
			return
		end

		-- 시전 잠금 중에는 이동/방향 전환을 완전히 멈춘다(모션이 끊겨 보이는 것을 막는다).
		if (self._T.attackLockUntil or 0) > now then
			mv:Stop()
			self._T.moving = false
			self:UpdateLoco(rb)
			return
		end

		-- 표적 유지 정책: 살아 있고 반경 안이면 계속 그 대상을 본다(0.3초마다 재선정하면
		-- 방향이 수시로 뒤집혀 덜렁거린다 - 용사 소환에서 같은 피드백을 받고 바뀐 규칙).
		if self:IsTargetGone(myPos) then
			self._T.target = nil
		end
		if self._T.target == nil and (self._T.nextTargetAt or 0) <= now then
			self._T.nextTargetAt = now + 0.3
			self._T.target = self:PickTarget(myPos)
		end

		local target = self._T.target
		if not isvalid(target) or (self._T.noChaseUntil or 0) > now then
			-- 표적이 없으면 주인 곁으로 붙는다(6.6유닛 밖일 때만 - 계속 붙으면 겹쳐 보인다).
			self:FollowOwnerTick(mv, rb, myPos, ownerPos)
			return
		end

		local tp = target.TransformComponent.WorldPosition
		-- (요청 2026-08-06) 다크사이트 잠복 중에는 대상의 **뒤통수 자리**로 이동해서 기다린다.
		-- 그 사이에는 어떤 공격도 하지 않는다 - 공격 동작 자체가 은신을 풀기 때문(주인 규칙과 동일).
		local ambushing = self:IsDarkSightHidden(now)
		local wantX = tp.x
		if ambushing then
			wantX = tp.x + self:GetBehindDirOf(target) * 0.9
		end
		local dx = wantX - myPos.x
		local dy = tp.y - myPos.y
		-- 바라보는 방향은 언제나 대상 쪽(뒤로 돌아 들어가는 동안에는 걷는 방향을 본다).
		local dir = ((tp.x - myPos.x) >= 0) and 1 or -1
		if math.abs(dx) > 1.1 or math.abs(dy) >= 1.2 then
			-- 접근: 좌우로 걷고, 위/아래 발판은 점프/아랫점프로 넘는다.
			local moveDir = (dx >= 0) and 1 or -1
			self._T.faceDir = moveDir
			mv:MoveToDirection(Vector2(moveDir, 0), 0)
			self._T.moving = true
			if rb:IsOnGround() then
				-- (요청 2026-08-06) 헤이스트 점프 보정을 받으면 **더 높은 발판까지** 따라 오를 수 있다 -
				-- 분신도 그걸 알고 움직여야 하므로 점프 추적 한계를 배율만큼 함께 넓힌다
				-- (JumpForce만 올리고 판단 기준을 그대로 두면 "올라갈 수 있는데 포기"가 된다).
				local jumpReach = 1.2 * (self._T.hasteJumpApplied or 1.0)
				if dy >= jumpReach and (self._T.nextJumpAt or 0) <= now then
					self._T.nextJumpAt = now + 1.0
					mv:Jump()
				elseif dy <= -1.1 and math.abs(dx) <= 1.5 and (self._T.nextDownAt or 0) <= now then
					self._T.nextDownAt = now + 0.8
					mv:DownJump()
				end
			end
			-- 걷는데도 거의 못 움직이면(벽) 방향을 뒤집는다.
			-- ⚠ PredictFootholdEnd는 조각 발판 지형에서 양방향 모두 true라 엣지 감지에 쓸 수 없다(실측) -
			--   0.5초 실이동량으로 판정한다.
			if (self._T.stuckCheckAt or 0) <= now then
				if self._T.stuckLastX ~= nil and math.abs(myPos.x - self._T.stuckLastX) < 0.05 then
					if rb:IsOnGround() then mv:Jump() end
				end
				self._T.stuckCheckAt = now + 0.5
				self._T.stuckLastX = myPos.x
			end
		else
			-- 사거리 안 - 멈추고 때린다.
			mv:Stop()
			self._T.moving = false
			self._T.faceDir = dir
			if ambushing then
				-- 잠복 중: 뒤통수 자리를 잡았어도 **정해둔 시각(3~10초 뒤)까지는** 기다린다.
				-- 시간이 되면 은신을 풀며 그 자리에서 기습한다(= 다크사이트 딜).
				if now >= (self._T.dsAmbushAt or 0) then
					self:EndDarkSightHidden(true)
					if (self._T.nextAttackAt or 0) <= now then
						self:UseAttackSkill(target, dir, now)
					end
				end
			elseif (self._T.nextAttackAt or 0) <= now then
				self:UseAttackSkill(target, dir, now)
			end
		end
		self:ApplyFacing()
		self:UpdateLoco(rb)
	end

	-- ── 헤이스트 연동 (요청 2026-08-06) ────────────────────────────────────
	-- 주인이 헤이스트를 쓰면 분신도 같은 이동 속도 배율과 점프 보정을 받는다. 주인 쪽 값은
	-- PlayerAttack이 들고 있으므로(클라 전용 투자 레벨에서 계산돼 서버로 내려온 값) 매 틱 조회해
	-- 바뀐 순간에만 적용한다 - 소환 이후에 헤이스트를 써도, 지속이 끝나도 알아서 따라간다.

	@ExecSpace("ServerOnly")
	method void HasteTick(MovementComponent mv)
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) or not isvalid(mv) then return end
		local mult = pa:GetHasteSpeedMultForClone()
		local jumpMult = pa:GetHasteJumpRangeMultForClone()
		local applied = self._T.hasteMultApplied or 1.0
		if math.abs(mult - applied) < 0.001 then return end
		self._T.hasteMultApplied = mult
		self._T.hasteJumpApplied = jumpMult
		mv.InputSpeed = (self._T.baseInputSpeed or mv.InputSpeed) * mult
		mv.JumpForce = (self._T.baseJumpForce or mv.JumpForce) * jumpMult
		if mult > 1.0 then
			-- 새로 걸린 순간에만 "버프 받는" 이펙트 1회(꺼질 때는 조용히 원복만 한다).
			-- ⚠ (신고 2026-08-06) 분신 컴포넌트의 Multicast로 쏘면 클라이언트에 컴포넌트가 붙기 전
			--   타이밍에 조용히 유실된다 - 항상 존재하는 주인 PlayerAttack에서 재생한다.
			pa:PlayShadowCloneHasteFx(self.Entity)
			log("[ShadowClone] 헤이스트 적용 - 이동 ×" .. string.format("%.2f", mult)
				.. " / 점프 ×" .. string.format("%.2f", jumpMult))
		else
			log("[ShadowClone] 헤이스트 해제 - 이동/점프 원복")
		end
	end

	-- ── 다크사이트 (요청 2026-08-06) ───────────────────────────────────────
	-- 주인과 같은 기준: 재사용 대기시간 ~ 그 4배 사이 랜덤 주기로 잠복하고, 3~10초 뒤 적의 뒤를
	-- 잡을 수 있으면 잡아서 때린다(그 공격이 다크사이트 딜 = 데미지 2배). 뒤를 못 잡으면 스스로 풀린다.

	@ExecSpace("ServerOnly")
	method boolean IsDarkSightHidden(number now)
		return (self._T.dsHiddenUntil or 0) > now
	end

	@ExecSpace("ServerOnly")
	method number GetBehindDirOf(Entity target)
		-- 대상의 뒤통수가 어느 쪽인가(-1 = 대상보다 왼쪽 / 1 = 오른쪽). 판정은 주인 PlayerAttack의
		-- IsFacingRight를 그대로 빌려 쓴다(몬스터 Scale.x 반전 관례 - 백스탭과 같은 기준이어야 한다).
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) or not isvalid(target) then return -1 end
		if pa:IsFacingRight(target) then return -1 end
		return 1
	end

	@ExecSpace("ServerOnly")
	method void DarkSightTick(number now)
		if (self._T.dsHiddenUntil or 0) > now then
			-- 잠복 유지 중 - 만료(뒤를 못 잡음)는 아래 분기가 처리한다.
			return
		end
		if self._T.dsActive == true then
			-- 잠복 시간이 다 됐는데 아직 못 때렸다 - 그냥 풀린다(주인의 "최대 지속" 만료와 같은 처리).
			self:EndDarkSightHidden(false)
		end
		local cd = self.DarkSightCooldown or 0
		if cd <= 0 then return end   -- 주인이 다크사이트를 안 배웠다
		if (self._T.dsNextAt or 0) > now then return end
		-- 다음 잠복은 쿨타임 ~ 쿨타임×4 뒤(요청 - "가끔"의 정의).
		self._T.dsNextAt = now + cd + _UtilLogic:RandomDouble() * cd * 3.0
		self._T.dsActive = true
		-- (요청 2026-08-06) **주변에 적이 있으면 1초 뒤** 바로 친다. 적이 없을 때만 2~5초 기다린다.
		-- 그 뒤로 6초 안에 뒤를 못 잡으면 스스로 풀린다.
		local dsNear = 0
		---@type PlayerAttack
		local dsPa = self:GetOwnerAttack()
		if isvalid(dsPa) then
			local myP = self.Entity.TransformComponent.WorldPosition
			local around = dsPa:FindMonstersInRadius(Vector2(myP.x, myP.y), 3.0, 4)
			if around ~= nil then dsNear = #around end
		end
		if dsNear > 0 then
			self._T.dsAmbushAt = now + 1.0
		else
			self._T.dsAmbushAt = now + 2.0 + _UtilLogic:RandomDouble() * 3.0
		end
		self._T.dsHiddenUntil = self._T.dsAmbushAt + 6.0
		self:PlayDarkSightVisual(true)
		log("[ShadowClone] 다크사이트 잠복 시작 (기습 " .. string.format("%.1f", self._T.dsAmbushAt - now)
			.. "초 뒤 / 다음 주기 " .. string.format("%.0f", self._T.dsNextAt - now) .. "초)")
	end

	@ExecSpace("ServerOnly")
	method void EndDarkSightHidden(boolean ambushed)
		-- 은신 해제. ambushed면 다음 한 방이 다크사이트 딜(데미지 2배)이 된다.
		if self._T.dsActive ~= true then return end
		self._T.dsActive = false
		self._T.dsHiddenUntil = 0
		self._T.dsAmbushBonus = (ambushed == true)
		self:PlayDarkSightVisual(false)
		if ambushed then
			log("[ShadowClone] 다크사이트 기습! - 다음 공격 데미지 2배")
		end
	end

	@ExecSpace("Multicast")
	method void PlayDarkSightVisual(boolean on)
		-- 은신 표현: 주인 다크사이트와 같은 반투명(30%)으로 낮췄다가 되돌린다.
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local ar = self.Entity.AvatarRendererComponent
		if not isvalid(ar) then return end
		if on then
			ar:SetAlpha(0.3, nil)
		else
			ar:SetAlpha(1.0, nil)
		end
	end

	@ExecSpace("ServerOnly")
	method void FollowOwnerTick(MovementComponent mv, RigidbodyComponent rb, Vector3 myPos, Vector3 ownerPos)
		-- 표적이 없을 때 주인 곁을 지킨다. 이 거리 안이면 멈춰 서서 대기한다.
		-- (요청 2026-08-06) 복귀 거리 3배 완화 - 2.2 → **6.6유닛**. 순간이동 복귀선(24유닛)과 한 세트로
		-- 움직여야 "멀리 떨어져도 주인 쪽으로 안 온다"가 성립한다(여기만 좁게 두면 결국 걸어서 붙는다).
		local dx = ownerPos.x - myPos.x
		if math.abs(dx) > 6.6 then
			local dir = (dx >= 0) and 1 or -1
			self._T.faceDir = dir
			mv:MoveToDirection(Vector2(dir, 0), 0)
			self._T.moving = true
		else
			mv:Stop()
			self._T.moving = false
		end
		self:ApplyFacing()
		self:UpdateLoco(rb)
	end

	@ExecSpace("ServerOnly")
	method boolean IsTargetGone(Vector3 myPos)
		-- 표적이 죽었거나(부활 대기 포함) 반경 7유닛 밖으로 벗어났는가.
		local t = self._T.target
		if not isvalid(t) then return true end
		if t.Enable ~= true then return true end
		---@type Monster
		local mc = t:GetComponent("script.Monster")
		if mc ~= nil and isvalid(mc) and mc.IsDead then return true end
		local tp = t.TransformComponent.WorldPosition
		local dx = tp.x - myPos.x
		local dy = tp.y - myPos.y
		if (dx * dx + dy * dy) > 49.0 then return true end
		return false
	end

	@ExecSpace("ServerOnly")
	method Entity PickTarget(Vector3 myPos)
		-- 주인의 몬스터 탐색 API를 그대로 빌려 쓴다(캐시가 걸려 있어 소환수 반복 호출에 안전).
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return nil end
		local cands = pa:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 6.0, 8)
		local reach = {}
		for _, t in ipairs(cands) do
			if isvalid(t) then
				local dy = t.TransformComponent.WorldPosition.y - myPos.y
				-- 닿을 수 있는 높이만(위 2.2 / 아래 3.0) - 용사 소환과 같은 기준.
				if dy <= 2.2 and dy >= -3.0 then
					table.insert(reach, t)
				end
			end
		end
		if #reach == 0 then return nil end
		return reach[_UtilLogic:RandomIntegerRange(1, math.min(3, #reach))]
	end

	@ExecSpace("ServerOnly")
	method void ApplyFacing()
		-- 아바타 NPC는 MoveToDirection으로 화면 방향이 안 뒤집힌다(LookAt 경로는 PlayerController 전용) -
		-- 몬스터 관례대로 Scale.x 부호 반전으로 미러링한다(기본 아트가 왼쪽을 보므로 오른쪽일 때 -1).
		local tr = self.Entity.TransformComponent
		if not isvalid(tr) then return end
		local wantScaleX = 1
		if (self._T.faceDir or -1) > 0 then wantScaleX = -1 end
		if self._T.lastScaleX ~= wantScaleX then
			self._T.lastScaleX = wantScaleX
			tr.Scale = Vector3(wantScaleX, 1, 1)
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateLoco(RigidbodyComponent rb)
		-- 이동 모션 상태를 @Sync로 클라이언트에 알린다(변할 때만 대입).
		local want = "stand"
		if not rb:IsOnGround() then
			want = "jump"
		elseif self._T.moving then
			want = "walk"
		end
		if self.LocoState ~= want then
			self.LocoState = want
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayMotion(string motionName, number rate)
		-- 1회성 공격 모션 명령(단일 @Sync 문자열이라 필드 간 도착 순서 문제가 없다).
		self._T.motionSeq = (self._T.motionSeq or 0) + 1
		self.MotionCmd = tostring(self._T.motionSeq) .. "|" .. motionName .. "|" .. tostring(rate)
	end

	@ExecSpace("ServerOnly")
	method void PlayPose(string action, integer frameIdx)
		-- (요청 2026-08-06) 본체 새비지블로우처럼 **액션의 특정 프레임 하나에 고정**하는 포즈 명령.
		-- ⚠ 본체(ApplySavageBlowPose)에서 실측된 두 함정을 그대로 따른다:
		--   ① StartFrameIndex == EndFrameIndex면 엔진이 이벤트를 통째로 무시한다 → end = start + 1
		--   ② Onetime이 끝나면 stand로 되돌아간다 → PlayRate 0.001로 사실상 정지시킨다
		-- 명령 형식을 "seq|액션|재생속도|시작프레임|끝프레임"으로 늘렸다(3토막이면 기존 동작 그대로).
		self._T.motionSeq = (self._T.motionSeq or 0) + 1
		self.MotionCmd = tostring(self._T.motionSeq) .. "|" .. action .. "|0.001|"
			.. tostring(frameIdx) .. "|" .. tostring(frameIdx + 1)
	end

	@ExecSpace("ServerOnly")
	method string PickAttackVariant(number now, number nearby, boolean smokeOn)
		-- (요청 2026-08-06) 분신도 **주인과 같은 기준**으로 스킬을 고른다. 쓸 수 있는 후보는 주인이
		-- 배운 분신 강화 차수(SkillTier)까지다.
		--   · 2차부터: 새비지블로우가 더블스탭의 상위 호환 - 더블스탭은 1%만 나온다.
		--   · 3차부터: 어썰터가 끼어든다. 다만 연속으로 몰아쓰지 않게 최소 간격을 둔다(요청 - "자연스럽게").
		--   · 4차부터: 암살이 주력(다수기). 새비지블로우는 10%이고 그마저도 **주변 적이 적을 때** 위주다.
		--   · 연막 안(주인이 깔아준 것): 어썰터 5% / 암살 92% / 새비지블로우 3%.
		--     단 연막 안에 적이 1~2명뿐이면 단일 대상이 더 센 새비지블로우를 쓴다.
		local tier = math.max(1, math.min(self.SkillTier or 1, 4))
		if tier <= 1 then return "doublestab" end

		local assaulterReady = (tier >= 3) and ((self._T.nextAssaulterAt or 0) <= now)

		if tier >= 4 and smokeOn then
			if nearby <= 2 then return "savageblow" end
			local r = _UtilLogic:RandomDouble() * 100.0
			if r < 5.0 and assaulterReady then return "assaulter" end
			if r < 97.0 then return "assassinate" end
			return "savageblow"
		end

		local pool = {}
		table.insert(pool, { name = "doublestab", w = 0.01 })
		if tier >= 4 then
			-- 암살 주력 - 새비지블로우는 10%. 몰려 있을수록 암살이 더 이득이라 그 10%도 더 줄어든다.
			local savageW = (nearby <= 2) and 10.0 or 3.0
			table.insert(pool, { name = "savageblow", w = savageW })
			table.insert(pool, { name = "assassinate", w = 90.0 })
		else
			table.insert(pool, { name = "savageblow", w = 100.0 })
		end
		if assaulterReady then
			-- 몰려 있으면 조금 더, 단독이면 거의 안 쓴다(광역 돌진기라 단독에게 쓰면 손해).
			table.insert(pool, { name = "assaulter", w = (nearby >= 3) and 20.0 or 5.0 })
		end

		local total = 0
		for _, c in ipairs(pool) do total += c.w end
		if total <= 0 then return "savageblow" end
		local r = _UtilLogic:RandomDouble() * total
		local pick = pool[#pool].name
		for _, c in ipairs(pool) do
			r = r - c.w
			if r <= 0 then
				pick = c.name
				break
			end
		end
		return pick
	end

	@ExecSpace("ServerOnly")
	method void UseAttackSkill(Entity target, number dir, number now)
		-- 분신의 공격 1회. 어떤 스킬을 쓸지는 PickAttackVariant가 주인과 같은 규칙으로 고른다.
		--   더블스탭 흉내   : 2타 × 전투력 100%~200%
		--   새비지블로우    : 6타 × 전투력 100%~200%
		--   어썰터          : 1타 × 전투력 400%~600% (주변 최대 6명)
		--   암살            : 1타 × 전투력 500%~700% (주변 최대 6명 - 다수기)
		-- 타수/배율은 암행2 그림자(더블스탭 2줄 / 새비지블로우 6줄, 한 타당 100%~200%)의 관례를
		-- 그대로 따른다. 여기에 분신 데미지 비율(DamagePercent)을 곱한 값이 실제 피해다.
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		local myPos = self.Entity.TransformComponent.WorldPosition
		-- 주변 적 수 / 연막 여부 - 둘 다 주인 PlayerAttack에서 그대로 읽는다(판정 기준 통일).
		local nearby = 1
		local smokeOn = false
		if isvalid(pa) then
			local around = pa:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 2.2, 8)
			if around ~= nil then nearby = math.max(1, #around) end
			smokeOn = pa:IsSmokeScreenActive()
		end

		local variant = self:PickAttackVariant(now, nearby, smokeOn)
		local hits = 2
		local splash = 1
		-- (버그 수정 2026-08-06) 배율은 **본체가 실제로 쓰는 값**을 그대로 받아 쓴다.
		-- 예전에는 개편 전 관례(한 타당 100%~200%)를 하드코딩해서 본체보다 2배 넘게 셌다
		-- (스킬 설명 "분신 데미지 = 본체의 50~90%"와 정반대). 여기에 아래에서 DamagePercent를 곱한다.
		local mn = 1.0
		local mx = 2.0
		if isvalid(pa) then
			mn = pa:GetShadowCloneRateMin(variant)
			mx = pa:GetShadowCloneRateMax(variant)
		end
		-- (요청 2026-08-06) 모션도 **본체 스킬과 같은 것**을 쓴다. 더블스탭은 stabO1/stabO2 랜덤,
		-- 새비지블로우는 7포즈 체인(아래 별도 처리), 어썰터/암살은 본체와 같은 착지·마무리 모션.
		local motion = ""
		if variant == "doublestab" then
			-- 본체 GetDoubleStabStab과 같은 후보/같은 랜덤 방식.
			motion = (_UtilLogic:RandomIntegerRange(1, 2) == 1) and "stabO1" or "stabO2"
		elseif variant == "savageblow" then
			hits = 6
		elseif variant == "assaulter" then
			hits = 1
			motion = "prone"
			splash = 6
			-- (요청) 연속으로 몰아쓰지 않게 최소 간격 - 주인의 스택 충전 리듬과 비슷하게 6~10초.
			self._T.nextAssaulterAt = now + 6.0 + _UtilLogic:RandomDouble() * 4.0
		elseif variant == "assassinate" then
			hits = 1
			motion = "swingO3"
			splash = 6
		end
		-- 분신 데미지 비율 적용(본체의 50~90%).
		local rate = math.max(0, self.DamagePercent or 50) / 100.0
		-- (다크사이트) 잠복 후 첫 기습 한 방은 데미지 2배(주인의 다크사이트 딜과 같은 규칙).
		if self._T.dsAmbushBonus == true then
			self._T.dsAmbushBonus = false
			rate = rate * 2.0
			log("[ShadowClone] 다크사이트 기습 타격(데미지 2배) variant=" .. variant)
		end
		mn = mn * rate
		mx = mx * rate

		-- 시전 잠금 = 모션 전체. 잠금 중에는 이동/방향 전환이 멈춘다(위 ServerTick 앞단 게이트).
		-- (신고 2026-08-06) 분신이 **본체보다 훨씬 빠른 공속**으로 때리는 문제 - 공격 간격이 스킬과
		-- 무관하게 0.9초 고정이라 본체의 스킬별 재사용 대기시간(전부 공격속도 배율이 곱해진 값)보다
		-- 짧았다. 이제 본체와 **같은 값 × 같은 배율**을 쓴다.
		--   더블스탭 0.75×배율×0.9(더블스탭은 1단계 빠름) / 새비지블로우 0.82×배율 / 암살 1.2×배율
		--   어썰터는 본체가 스택제라 별도 - 시전 자체 길이만 본체 연출(0.25초 순간이동 + 착지)에 맞춘다.
		local atkMult = 1.0
		if isvalid(pa) then atkMult = pa:GetAtkMultiplierForClone() end
		local frameInterval = 0.09 * atkMult
		if variant == "savageblow" then
			self._T.nextAttackAt = now + frameInterval * 8 + 0.2 * atkMult
			self._T.attackLockUntil = now + frameInterval * 8 + 0.1 * atkMult
		elseif variant == "doublestab" then
			self._T.nextAttackAt = now + 0.75 * atkMult * 0.9
			self._T.attackLockUntil = now + 0.6 * atkMult * 0.9
		elseif variant == "assassinate" then
			-- 연쇄가 최대 10명 × 0.1초라 시전 잠금이 그 시간을 덮어야 한다(본체도 연쇄 내내 조작이 잠긴다).
			self._T.nextAttackAt = now + 1.2 * atkMult
			self._T.attackLockUntil = now + 1.1 * atkMult
		else
			self._T.nextAttackAt = now + 0.9 * atkMult
			self._T.attackLockUntil = now + 0.65 * atkMult
		end
		self._T.faceDir = dir
		self:ApplyFacing()

		-- ── 모션 (본체와 동일) ────────────────────────────────────────────
		if variant == "savageblow" then
			-- 본체 GetSavageBlowPoses와 **같은 포즈/같은 프레임/같은 간격**을 그대로 재생한다.
			local poses = {
				{ action = "stabO1",    frame = 0 },
				{ action = "swingOF",   frame = 3 },
				{ action = "proneStab", frame = 0 },
				{ action = "swingOF",   frame = 3 },
				{ action = "swingO2",   frame = 0 },
				{ action = "stabO1",    frame = 1 },
				{ action = "alert",     frame = 1 },
			}
			for i = 1, #poses do
				local p = poses[i]
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) then return end
					self:PlayPose(p.action, p.frame)
				end, (i - 1) * frameInterval)
			end
		elseif motion ~= "" then
			-- 본체와 같은 재생 속도: 공격속도 배율이 빠를수록(mult<1) 모션도 빨라진다(playRate = 1/mult).
			self:PlayMotion(motion, 1.0 / atkMult)
		end

		-- ── 시전 연출 (본체와 동일한 클립/사운드) ─────────────────────────
		if isvalid(pa) then
			pa:PlayShadowCloneCastFx(self.Entity, variant, dir, frameInterval)
		end
		-- 어썰터/암살은 사라졌다가 다시 나타나는 연출이라 마지막 타격 뒤 알파를 되돌린다.
		if variant == "assaulter" or variant == "assassinate" then
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				---@type PlayerAttack
				local paBack = self:GetOwnerAttack()
				if isvalid(paBack) then paBack:PlayShadowCloneReappear(self.Entity) end
			end, 0.45)
		end

		-- 광역기(어썰터/암살)는 주변 적을 함께 때린다 - 단일 대상만 때리면 "다수기"가 아니다.
		local targets = { target }
		if variant == "assassinate" and isvalid(pa) then
			-- (버그 수정 2026-08-06) 암살은 본체와 **완전히 같은 연쇄 규칙**을 쓴다 -
			-- 직전 대상에서 가장 가까운 적으로 이어가고, 반경은 4.5(연막 중 9.0), 최대 10명.
			-- 예전에는 "첫 대상 주변 2.5유닛에서 6명"이라 사거리도 퍼지는 정도도 본체와 달랐다(신고).
			local chain = pa:BuildShadowCloneAssassinateChain(self.Entity, 10)
			if chain ~= nil and #chain > 0 then
				targets = chain
			end
		elseif splash > 1 and isvalid(pa) then
			local tp = target.TransformComponent.WorldPosition
			local around = pa:FindMonstersInRadius(Vector2(tp.x, tp.y), 2.5, splash)
			if around ~= nil then
				targets = {}
				for _, t in ipairs(around) do
					if isvalid(t) then table.insert(targets, t) end
				end
				if #targets == 0 then targets = { target } end
			end
		end

		-- 새비지블로우 히트 이펙트 3종은 본체와 같이 **시전당 1개**를 골라 6타 내내 같은 것을 쓴다.
		local hitRuid = ""
		if variant == "savageblow" and isvalid(pa) then
			hitRuid = pa:RollSavageBlowHitRuid()
		end

		-- 타수만큼 시간차를 두고 때린다(한 프레임에 몰아치면 데미지 숫자가 겹쳐 한 줄로 보인다).
		-- 본체와 같은 간격: 새비지블로우는 프레임 간격(0.09×공속), 더블스탭은 두 찌르기 사이 0.15×공속.
		local step = 0.06 * atkMult
		if variant == "savageblow" then
			step = frameInterval
		elseif variant == "doublestab" then
			step = 0.15 * atkMult
		end
		-- (버그 수정 2026-08-06) 암살은 본체처럼 **대상마다 시간차를 두고 옮겨 붙는다**.
		-- 예전에는 주변 대상 전원을 한 프레임에 몰아쳐서 "본체보다 훨씬 빠르게 번진다"는 신고가 났다
		-- (본체 hop 간격 = 진입 0.05 + 타격 0.05 ≈ 0.1초, 공격속도 배율 적용).
		local hopStep = 0.0
		if variant == "assassinate" then hopStep = 0.1 * atkMult end
		for i = 1, hits do
			local idx = i
			for ti = 1, #targets do
				local tIdx = ti
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) then return end
					if self._T == nil then return end
					local t = targets[tIdx]
					if not isvalid(t) then return end
					---@type PlayerAttack
					local paHit = self:GetOwnerAttack()
					if isvalid(paHit) then
						paHit:PlayShadowCloneHitFx(self.Entity, t, variant, dir, hitRuid)
					end
					-- (버그 수정 2026-08-06) 타수 번호와 스킬 종류를 함께 넘긴다 - 주인 쪽에서 본체와 같은
					-- 수동 다중 표시(더블스탭 2줄 / 새비지블로우 6줄)를 그리는 데 쓴다.
					self:DealHitLine(t, mn, mx, variant, idx)
				end, (idx - 1) * step + (tIdx - 1) * hopStep)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void DealHitLine(Entity target, number multMin, number multMax, string variant, integer hitIndex)
		-- 주인 PlayerAttack의 skill.shadowclone 파이프라인으로 1타
		-- (데미지 스킨/크리티컬 표시가 본체 공격과 똑같이 처리된다).
		-- (2026-08-06) 백스탭은 **분신 자신의 위치**로 판정하고, 쉐도우 파트너는 분신 강화 II(3차)를
		-- 배웠을 때만 함께 쓴다 - 둘 다 주인 쪽에서 판단할 수 없어 여기서 넘겨준다.
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) or not isvalid(target) then return end
		local echoAllowed = (math.max(1, self.SkillTier or 1) >= 3)
		pa:DealShadowCloneHitLine(self.Entity, target, self.CombatPower, multMin, multMax, echoAllowed, variant, hitIndex)
	end

	@ExecSpace("ServerOnly")
	method number GetRemainingLifetime()
		-- 남은 수명(초). 버프바 표시/위치 교환 안내에 쓴다.
		local endAt = self._T.lifetimeEndAt
		if endAt == nil then return 0 end
		return math.max(0, endAt - _UtilLogic.ServerElapsedSeconds)
	end

	@ExecSpace("ServerOnly")
	method void TeleportTo(Vector3 pos)
		-- 위치 교환용 순간이동. 주인 쪽에서 좌표를 계산해 한 번만 부른다
		-- (⚠ SetWorldPosition 반복 호출은 몇 틱 뒤 되돌아간다 - 실측).
		local mv = self.Entity.MovementComponent
		if not isvalid(mv) then return end
		mv:Stop()
		mv:SetWorldPosition(Vector2(pos.x, pos.y))
		self._T.target = nil
		-- 교환 직후 잠깐은 추적하지 않는다(바뀐 자리에서 곧장 뛰쳐나가지 않게).
		self._T.noChaseUntil = _UtilLogic.ServerElapsedSeconds + 0.6
	end

	@ExecSpace("ClientOnly")
	method void ClientTick(number delta)
		-- 스킬 모션 재생 중이 아니면 LocoState(stand/walk/jump)에 맞는 이동 클립을 body에 보낸다.
		local ar = self.Entity.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.motionLockUntil or 0) > now then return end
		local want = self.LocoState
		if self._T.lastLoco == want then return end
		local ev = ActionStateChangedEvent()
		if want == "walk" then
			ev.CoreActionName = "walk1"
			ev.PartsActionName = "walk1"
			ev.PlayType = SpriteAnimClipPlayType.Loop
		elseif want == "jump" then
			ev.CoreActionName = "jump"
			ev.PartsActionName = "jump"
			ev.PlayType = SpriteAnimClipPlayType.Loop
		else
			ev.CoreActionName = "stand1"
			ev.PartsActionName = "stand1"
			ev.PlayType = SpriteAnimClipPlayType.ZigzagLoop
		end
		body:SendEvent(ev)
		self._T.lastLoco = want
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 공격 모션 명령 수신: "seq|모션명|재생속도"를 body 엔티티에 Onetime으로 재생한다.
		-- 재생 동안은 이동 클립이 덮지 않게 잠그고, 끝나면 lastLoco를 비워 이동 클립을 다시 적용시킨다.
		if name ~= "MotionCmd" then return end
		local cmd = tostring(value)
		if cmd == "" then return end
		local ar = self.Entity.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		local parts = {}
		for token in string.gmatch(cmd, "[^|]+") do
			table.insert(parts, token)
		end
		if #parts < 3 then return end
		local motion = parts[2]
		local rate = tonumber(parts[3]) or 1.0
		if #parts >= 5 then
			-- 프레임 고정 포즈(새비지블로우) - 본체 ApplySavageBlowPose와 **같은 이벤트 형태**로 보낸다.
			local sf = math.floor(tonumber(parts[4]) or 0)
			local ef = math.floor(tonumber(parts[5]) or (sf + 1))
			local poseEv = ActionStateChangedEvent(motion, motion, rate, SpriteAnimClipPlayType.Onetime, sf, ef)
			body:SendEvent(poseEv)
			-- 포즈는 다음 포즈/이동 클립이 덮을 때까지 유지된다 - 잠금은 짧게만 걸어 다음 포즈를 막지 않는다.
			self._T.motionLockUntil = _UtilLogic.ElapsedSeconds + 0.5
			self._T.lastLoco = nil
			return
		end
		local ev = ActionStateChangedEvent()
		ev.CoreActionName = motion
		ev.PartsActionName = motion
		ev.PlayRate = rate
		ev.PlayType = SpriteAnimClipPlayType.Onetime
		body:SendEvent(ev)
		self._T.motionLockUntil = _UtilLogic.ElapsedSeconds + 0.7 / math.max(rate, 0.001)
		self._T.lastLoco = nil
	end
end
