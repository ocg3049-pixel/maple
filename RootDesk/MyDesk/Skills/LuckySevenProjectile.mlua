@Component
script LuckySevenProjectile extends Component

	property number Speed = 8

	property number MaxLifetime = 2.0

	property number HitRadius = 0.35

	property number CombatPower = 0

	-- 표창 1개가 주는 데미지의 전투력 대비 배율 범위. 기본값은 럭키세븐 규격(100%~150%).
	-- 아대 기본공격이 던지는 표창은 발사 시점에 0.5/1.0(50%~100%)으로 낮춰 넣는다.
	property number DamageRateMin = 1.0
	property number DamageRateMax = 1.5

	-- 럭키세븐 계열 다중 표창의 위→아래 조준 오프셋. 스트레이프 분산각의 절반 폭을 사용한다.
	property number AimYOffset = 0

	-- 다중 표창의 피해 숫자를 한곳에 묶을 공통 대상. 비행체 자체를 앵커로 쓰면 각도별 도착 높이마다
	-- 숫자가 따로 떨어져 보여 쉐도우 파트너의 4·6·8줄이 한 묶음으로 보이지 않는다.
	@Sync property Entity DamageAnchor = ""

	-- ── 마크 오브 어쌔신 (2026-08-05 신설, 이후 연출 여러 차례 개편) ─────────────
	-- (요청 2026-08-07 4차 = 현재 사양) 마크 표창은 **플레이어 등 뒤 위쪽 화면 밖**에서 스폰돼
	--   **직선으로** 날아와 표적에 꽂힌다. 곡선 비행(CurveFly)도, 크기로 주던 원근감도 쓰지 않는다.
	--   설정은 PlayerAttack.SpawnAssassinMarkStar 참고 - 이 스크립트에서 마크가 쓰는 건
	--   AngleTracked / RetargetOnDeath / MarkEligible / HitSoundRUID / SilentOnMiss뿐이다.
	--
	-- AngleTracked: true면 부착 이펙트 대신 **동반 시각 엔티티**로 표창을 보여주고, 진행각을 매 틱
	--   그 엔티티의 ZRotation에 반영한다. 부착 이펙트는 재생 후 회전을 못 바꾸는데, 마크 표창은
	--   표적이 죽으면 다른 적으로 갈아타 **비행 중 방향이 바뀌므로** 각도 추종이 필요하다.
	--   클라이언트가 시각 경로를 갈라야 하므로 @Sync.
	-- RetargetOnDeath: true면 비행 중 표적이 죽었을 때 근처의 다른 살아있는 몬스터로 갈아탄다
	--   (RetargetNearestMonster). 서버에서만 읽는다.
	-- MarkEligible: 이 표창의 실히트가 마크 프록을 일으킬 수 있는가(표창 3종의 원본 표창만 true -
	--   마크 표창 자신은 false라 연쇄 폭발하지 않는다).
	--
	-- ⚠ 아래 CurveFly 계열(CurveSide/CurveBend/ArcOutTime/ApexSpeed/FormationX·Y/LaunchDelay)은
	--   지금 **아무도 켜지 않는다**(마크가 직선으로 바뀌면서 사용처가 사라졌다). 곡선 비행이 다시
	--   필요해질 때를 위해 코드는 남겨뒀다 - CurveFly=true로 켜면 그대로 동작한다.
	@Sync
	property boolean CurveFly = false
	@Sync
	property boolean AngleTracked = false
	property boolean RetargetOnDeath = false
	property number CurveSide = 1
	property number CurveBend = 0.7
	property number ArcOutTime = 0.42
	property number ApexSpeed = 2.8
	property boolean MarkEligible = false

	-- (요청 2026-08-06) 발사 후 이 시간 동안은 **도달 판정을 하지 않는다** - 마크 표창이 반원의
	-- 앞 절반을 솟아오르는 동안 스쳐 지나가는 다른 적에게 부딪혀 즉시 사라지는 것을 막고,
	-- 호를 다 그린 뒤에만 꽂히게 한다(기본 0 = 기존 표창들은 그대로 즉시 판정).
	property number NoHitTime = 0

	-- (요청 2026-08-07 3차) **반원의 꼭대기**(월드 좌표)와 발당 발사 시차. 시전 쪽
	-- (PlayerAttack.TryProcAssassinMark)이 플레이어 → 표적을 잇는 현 위의 한 점에서 수직으로
	-- 띄워 계산해 넣는다(띄운 높이 = 현의 절반이면 정확한 반원). 서버 전용 값이라 동기화하지 않는다.
	property number FormationX = 0
	property number FormationY = 0
	property number LaunchDelay = 0

	-- 명중 시 재생할 타격음. 마크 표창은 전용 히트사운드를 쓴다 - 클라이언트 표시 RPC(ShowHitEffect)가
	-- 자기 복제본에서 읽으므로 @Sync로 내린다.
	@Sync
	property string HitSoundRUID = "48c2f4049db54b3b88b9144320d3d41a"

	-- 캐릭터 정보창의 실제 크리티컬 확률(%) - PlayerAttack이 발사 시점에 채워준다. CalcCritical/CalcDamage가
	-- 서버에서 실행되는데 장비 잠재능력은 클라이언트 전용 상태라 직접 읽을 수 없어, 발사한 플레이어가
	-- SyncCritRate로 동기화해둔 값을 그대로 넘겨받는다.
	property number CritRate = 50

	-- 몇 번째 표창인지(1부터). ShowDamageSkin이 이 값으로 데미지 숫자가 뜨는 세로 위치를 정한다
	-- (쉐도우 파트너 중에는 표창마다 원본+보너스 2줄씩 나뉜다).
	property integer HitIndex = 0

	-- (트리플/쿼드러플 스로우) 이 시전이 던지는 표창 총 개수. 데미지 숫자 줄 수와 세로 배치가
	-- 이 값으로 정해진다(럭키세븐 2발 → 2줄/쉐도우 4줄, 트리플 3발 → 3줄/6줄, 쿼드러플 4발 → 4줄/8줄).
	property integer TotalShots = 2

	-- 명중 시 재생할 타격 이펙트 animationclip RUID. 스킬마다 다르다(기본값은 럭키세븐 것).
	property string HitEffectRUID = "458e72f0720a4584a9a7fc3642b6e601"

	-- true면 대상에 맞지 않고 끝났을 때(허공 투척) 데미지 숫자를 띄우지 않고 조용히 사라진다.
	-- 럭키세븐은 "대상이 먼저 죽어도 표창 2개 분의 숫자가 항상 떠야 한다"가 사양이라 false를 유지하고,
	-- 아대 기본공격의 **애초에 대상이 없는** 허공 투척만 true로 켠다(허공에 숫자가 뜨면 안 된다).
	property boolean SilentOnMiss = false

	-- 쉐도우 파트너: true면 그림자 몫의 "시각 전용" 표창 - 데미지/데미지 스킨/히트 이펙트 없이
	-- 원본을 따라 날아가기만 한다(그림자 스킬 이펙트는 직접적인 데미지를 주지 않는다는 요청).
	-- 클라이언트의 부착 이펙트(OnSyncProperty)를 투명도 70%로 재생해야 하므로 @Sync로 내린다.
	@Sync
	property boolean VisualOnly = false

	-- 쉐도우 파트너의 시각 표창이 도착할 때 표시할 후반부 피해 줄. 실제 HP 피해는 원본 표창이 이미
	-- 합산 적용하므로 여기서는 숫자만 표시한다.
	property integer VisualDamage = 0
	property boolean VisualDamageCritical = false
	-- true면 원본 표창은 합산 피해를 그대로 적용하되 그림자 몫 숫자는 즉시 표시하지 않는다.
	property boolean DeferBonusDisplay = false

	-- (요청) "단일 타게팅 스킬은 스킬 사용 시점에 대상과 데미지를 바로 정한다."
	-- PlayerAttack.AttackStarThrow가 시전 시점에 표창 N발 몫을 미리 굴려 발마다 넣어준다.
	-- PreRolled=true면 LuckySevenProjectileAttack.CalcDamage가 새로 굴리지 않고 이 값을 그대로 쓴다.
	--
	-- ⚠ 왜 미리 굴려야 하는가: 시전 시점에 "이번 공격으로 대상이 죽는다"를 판정해 다음 공격의
	--   대상 선정에서 제외(Monster.ReserveDamage)하려면, 그 판정에 쓴 데미지가 **실제로 들어가는
	--   데미지와 동일**해야 한다. 히트 시점에 다시 굴리면 예측보다 적게 나와 죽는다고 선고한
	--   몬스터가 살아남는 어긋남이 생긴다.
	property boolean PreRolled = false
	property integer PreDamage = 0
	property integer PreBonus = 0
	property boolean PreDamageCritical = false
	property boolean PreBonusCritical = false

	-- 원본 표창 전용(서버에서만 읽음): 쉐도우 파트너 버프 중에 발사됐는지 여부.
	-- 히트 시 원본+보너스(타수 2배) 합산·2줄 표시와 히트 이펙트 시간차 2배 재생에 쓰인다.
	property boolean ShadowEchoOn = false

	-- (2026-08-05 개편) 분신 몫의 데미지 배율(본체 대비). PlayerAttack.GetShadowEchoRate()가 계산한
	-- 값을 발사 시점에 새겨준다 - 쉐도우 파트너 투자 레벨에 따라 0.50(1레벨)~0.79(마스터 30)다.
	property number ShadowEchoRate = 0.5

	-- 발사한 플레이어의 "현재" 데미지 스킨 RUID(PlayerAttack이 발사 시점에 채워준다).
	-- 블리자드처럼 스킨을 한시적으로 바꾸는 연출이 이 투사체의 수동 데미지 표시에도 적용되게 하려면
	-- 하드코딩된 기본 스킨 대신 이 값을 써야 한다(비어 있으면 기본 스킨으로 폴백).
	property string DamageSkinRUID = ""

	-- (표창+) 던질 표창으로 고른 번호(1~9). PlayerAttack이 발사 시점에 채워준다.
	-- 클라이언트가 "날아가는 모습"을 이 값으로 정하므로 @Sync로 내린다.
	@Sync
	property integer SkinIndex = 1

	-- (표창+) 날아가는 방향. 진행 방향으로 눕히는 데 쓴다.
	-- FlyDirX < 0 이면 왼쪽으로 던진 것, FlyAngle은 진행 방향 각도(-180~180도, atan2 전 범위).
	-- ⚠ 예전엔 FlipX를 **진행 방향과 반대로** 걸고(클립 기본이 왼쪽인데 왼쪽 비행에 flip을 켰다)
	--   기울기도 |dx| 기준으로 계산해서, 좌우도 각도도 맞지 않았다(신고: "오른쪽으로 던지면 반대로 보인다",
	--   "각도가 안 바뀐다"). 반대로 FlipX를 아예 빼고 회전만 쓰면 오른쪽 비행이 180도 회전이 되어
	--   **위아래가 뒤집힌다**(신고: "오른쪽으로 날릴 때 이미지 위아래가 바뀐다").
	--   → 좌우는 FlipX, 기울기는 회전. 구체적인 합성 규칙은 ApplyFlyVisual 주석에 실측값으로 적어뒀다.
	@Sync property number FlyDirX = 1
	@Sync property number FlyAngle = 0

	@Sync
	property boolean Fired = false

	method void OnBeginPlay()
		-- 표창 발사 상태 초기화 (서버 전용 필드)
		if self:IsServer() then
			self._T.lifetime = 0
			self._T.target = nil
			self._T.hit = false
		end
		-- 클라이언트가 엔티티를 이미 Fired=true 상태로 받는 경우(스폰과 같은 프레임에 발사)는
		-- 변경 이벤트(OnSyncProperty)가 오지 않으므로 여기서 한 번 확인해 재생한다.
		if self:IsClient() then
			self:ApplyFlyVisual()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 서버 Fire() 호출로 Fired가 true가 되는 순간, 표창 스프라이트를 엔티티에 부착 재생한다.
		-- ⚠ Fired와 SkinIndex는 같은 프레임에 내려가므로 **도착 순서가 보장되지 않는다**.
		--   Fired만 보고 재생하면 SkinIndex가 아직 기본값(1)일 때 엉뚱한 표창이 날아갈 수 있어,
		--   두 프로퍼티 어느 쪽이 와도 같은 함수를 태워 순서에 상관없이 올바른 표창이 되게 한다.
		if name == "Fired" or name == "SkinIndex" or name == "FlyDirX" or name == "FlyAngle" then
			-- ⚠ FlyDirX/FlyAngle이 Fired보다 늦게 도착하면, 이미 재생을 시작해 잠가둔 탓에 좌우 반전과
			--   기울기가 영영 반영되지 않았다(실측 신고: "오른쪽으로 던질 때 좌우가 반대", "각도가 안 바뀜").
			--   방향 정보가 새로 오면 이전 이펙트를 지우고 올바른 값으로 다시 재생한다.
			if (name == "FlyDirX" or name == "FlyAngle") and self._T.flyStarted then
				if self._T.effectSerial ~= nil and self._T.effectSerial ~= 0 then
					_EffectService:RemoveEffect(self._T.effectSerial)
					self._T.effectSerial = nil
				end
				self._T.flyStarted = false
			end
			self:ApplyFlyVisual()
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyFlyVisual()
		-- (표창+) 고른 표창 종류에 맞는 비행 클립을 재생한다. 한 번만 재생한다.
		-- 전용 비행 클립이 없는 종류(토피/일비)는 여기서 아무것도 재생하지 않고,
		-- 서버가 띄운 회전 동반 엔티티(SpawnSpinVisualIfNeeded)가 아이콘을 돌리며 대신 보여준다.
		if not self.Fired then return end
		if self._T.flyStarted then return end
		-- (마크 오브 어쌔신) 각도 추종 표창은 부착 이펙트를 쓰지 않는다 - 부착 이펙트는 재생 후 회전을
		-- 바꿀 수 없어 진행 방향을 따라가지 못한다. 동반 엔티티(SpawnSpinVisualIfNeeded)가 대신 보여준다.
		if self.CurveFly or self.AngleTracked then
			self._T.flyStarted = true
			return
		end
		self._T.flyStarted = true
		-- 그림자 몫(시각 전용) 표창은 투명도 70%로 재생해 원본과 구분되면서도 같은 모습이 되게 한다.
		local opts = {}
		if self.VisualOnly then
			opts["Alpha"] = 0.7
		end
		-- (요청) "오른쪽으로 던질 때 좌우가 반대", "몬스터 위치에 따라 날아가는 각도가 바뀌어야 한다",
		--        "오른쪽으로 날릴 때 이미지 위아래가 바뀐다".
		--
		-- info.head = 클립이 아무 회전 없이 기본으로 향하는 각도(0 = 오른쪽, 180 = 왼쪽. 실측값 - 9종 전부 180).
		--
		-- ⚠ 회전만으로 좌우를 뒤집으면 안 된다: 180도 회전은 좌우 반전 + **위아래 반전**이라 아트가
		--   뒤집혀 보인다(신고 내용). 좌우는 반드시 FlipX(거울)로, 기울기만 회전으로 준다.
		-- ⚠ 합성 순서 실측: FlipX를 켜면 아트가 향하는 기준이 0도(오른쪽)로 바뀌고, zRotation은 그 기준에서
		--   **반시계 양수**로 그대로 더해진다(flip=true·rot=45 → 우상향 45도로 확인).
		--   FlipX가 꺼져 있으면 기준이 head이고 렌더 방향 = head + zRotation이다(rot=180 → 오른쪽, -90 → 위).
		--   => 진행 방향과 같은 쪽을 보게 만든 뒤(flip) 남은 기울기만 회전으로 주면 |회전|이 항상 작아
		--      위아래가 뒤집히는 일이 없다.
		local info = _ShurikenLibrary:Get(self.SkinIndex)
		local goingRight = (self.FlyDirX >= 0)
		local nativeRight = ((info.head or 0) == 0)
		opts["FlipX"] = (goingRight ~= nativeRight)
		local zrot = goingRight and self.FlyAngle or (self.FlyAngle - 180)
		-- -180~180으로 정규화(왼쪽 비행에서 -355 같은 값이 나와 로그가 읽기 어려워지는 것만 정리).
		while zrot > 180 do zrot = zrot - 360 end
		while zrot < -180 do zrot = zrot + 360 end
		if info.fly ~= "" then
			self._T.effectSerial = _EffectService:PlayEffectAttached(
				info.fly, self.Entity,
				Vector3(0, 0, 0), zrot, Vector3(1, 1, 1), true, opts
			)
		end
		log("[Shuriken] 비행 표창 " .. tostring(self.SkinIndex) .. "번(" .. tostring(info.name)
			.. ") FlyAngle=" .. tostring(self.FlyAngle) .. " head=" .. tostring(info.head or 0)
			.. " flipX=" .. tostring(opts["FlipX"]) .. " zrot=" .. tostring(zrot)
			.. " visualOnly=" .. tostring(self.VisualOnly))
	end

	@ExecSpace("ServerOnly")
	method void Fire(Entity target, Vector3 fallbackPos)
		-- 대상을 향해 발사 시작 (단일 고정 표적 - 이후 OnUpdate에서 계속 추적).
		-- 비행 중 대상이 죽어서 사라지면 캐스팅 시점에 저장해둔 마지막 위치(fallbackPos)로 계속 날아간다.
		-- ⚠ 대상이 없을 때는 이 메서드를 부르지 말고 FireNoTarget을 쓸 것 (아래 주석 참고).
		self._T.target = target
		self:BeginFly(fallbackPos)
	end

	@ExecSpace("ServerOnly")
	method void FireNoTarget(Vector3 fallbackPos)
		-- 대상 없이 정해진 지점(허공)으로만 날아가는 발사.
		-- ⚠ 왜 별도 진입점인가: Entity 타입 파라미터에 nil을 넘기면 호출이 조용히 실패해
		--   Fired가 영영 true가 되지 않았고, 그래서 "대상 없는 곳을 공격하면 표창이 아예 안 보인다"는
		--   신고가 나왔다(실측). 대상이 없을 때는 Entity를 아예 넘기지 않는 경로로 우회한다.
		self._T.target = nil
		self:BeginFly(fallbackPos)
	end

	-- ⚠ 몬스터는 죽어도 **엔티티가 파괴되지 않는다** - Enable=false로 숨겼다가 RespawnDelay 뒤
	--   Respawn()으로 최초 배치 위치에 되살린다(Combat/Monster.mlua). 그래서 `isvalid(target)`은
	--   죽은 뒤에도 계속 true다. 이걸 그대로 추적하면 비행 중인 표창이 **부활 지점까지 따라가서
	--   되살아난 몬스터를 때리고 타격 이펙트까지 씌운다**(신고: "죽었던 몬스터가 hit 이펙트를 달고
	--   부활한다"). 표창을 여러 발 던지는 트리플/쿼드러플에서 특히 잘 걸린다.
	--   → 죽은 순간 추적을 끊고, 캐스팅 시점에 저장한 지점으로만 날아가게 한다.
	-- 다중 표창의 "마지막 타에만 죽기" 처리. 대상 몬스터의 사망 유예 창을 열고/닫는다.
	@ExecSpace("ServerOnly")
	method void ApplyDeathDefer()
		-- 마지막 발이 아니면 유예를 열고(HP 1로 버팀), 마지막 발이면 풀어서 이 타격에 죽게 한다.
		local mc = self._T.targetMonster
		if mc == nil or not isvalid(mc) then return end
		local shots = (self.TotalShots ~= nil and self.TotalShots > 0) and self.TotalShots or 1
		if self.HitIndex > 0 and self.HitIndex < shots then
			-- 다음 표창이 도달할 때까지만 버티면 된다(발사 간격 0.07~0.1초 + 비행 시간차).
			-- 넉넉히 0.8초를 주되 매 타격마다 갱신되고, 마지막 발이 유실돼도 이 시간이면 자동 해제된다.
			mc:DeferDeath(0.8)
		else
			mc:ClearDeathDefer()
		end
	end

	-- 마지막 표창이 명중하지 못하고(사거리/수명) 사라지는 경우에도 유예를 풀어준다
	-- (안 풀면 대상이 최대 0.8초 동안 HP 1로 안 죽는 상태가 남는다).
	@ExecSpace("ServerOnly")
	method void ReleaseDeathDefer()
		-- 사망 유예를 해제한다.
		local mc = self._T.targetMonster
		if mc == nil or not isvalid(mc) then return end
		mc:ClearDeathDefer()
	end

	@ExecSpace("ServerOnly")
	method boolean IsTargetGone()
		-- 대상이 사라졌거나 **죽었는지**(부활 대기 중 포함).
		local t = self._T.target
		if not isvalid(t) then return true end
		if not t.Enable then return true end
		local mc = self._T.targetMonster
		if mc ~= nil and isvalid(mc) and mc.IsDead then return true end
		return false
	end

	@ExecSpace("ServerOnly")
	method Vector3 GetAimPos(Vector3 fallbackPos)
		-- 지금 조준해야 할 지점. 대상이 살아있으면 **발밑이 아니라 던진 높이만큼 올린 곳**을 노린다
		-- (요청: "몬스터의 타격점이 몬스터 발 아래 있어 표창이 어색한 쪽으로 날아간다").
		-- 대상이 죽었거나 사라졌으면 추적을 끊고 캐스팅 시점에 저장해둔 지점으로 계속 날아간다
		-- (이미 같은 높이로 맞춰져 있다).
		if self:IsTargetGone() then
			if self._T.target ~= nil then
				self._T.target = nil
				self._T.targetDied = true
			end
			return fallbackPos
		end
		if isvalid(self._T.target) then
			local tp = self._T.target.TransformComponent.Position
			return Vector3(tp.x, tp.y + _ShurikenLibrary:GetThrowHeight() + self.AimYOffset, tp.z)
		end
		return fallbackPos
	end

	@ExecSpace("ServerOnly")
	method void BeginFly(Vector3 fallbackPos)
		-- Fire / FireNoTarget 공통 본체 - 진행 방향을 계산해 클라이언트에 내리고 비행을 시작한다.
		self._T.fallbackPos = fallbackPos
		-- 사망 감지에 쓸 몬스터 컴포넌트를 여기서 한 번만 잡아둔다(IsTargetGone 참고 - 매 프레임
		-- GetComponent를 피한다).
		if isvalid(self._T.target) then
			self._T.targetMonster = self._T.target:GetComponent("script.Monster")
		end
		local aim = self:GetAimPos(fallbackPos)
		if aim ~= nil then
			local myPos = self.Entity.TransformComponent.Position
			local dx = aim.x - myPos.x
			local dy = aim.y - myPos.y
			self.FlyDirX = (dx < 0) and -1 or 1
			-- 진행 방향 각도를 그대로(-180~180도) 담는다. 좌우 반전 없이 이 각도만으로 눕힌다.
			self.FlyAngle = math.deg(math.atan(dy, dx))
		end
		-- (곡선 비행 전용) 첫 진행 방향 = 던짐 호의 **시작 접선**
		-- (2차 베지어의 u=0 접선은 시작점→제어점 방향). 직선으로 최고점을 겨누면 실제로는 호를
		-- 그리며 나가는데 표창만 엉뚱한 쪽을 보고 출발한다. 이후는 OnUpdate CurveFly 분기가 이어받는다.
		if self.CurveFly then
			local sp = self.Entity.TransformComponent.Position
			local start = Vector3(sp.x, sp.y, sp.z)
			local apex = Vector3(self.FormationX, self.FormationY, sp.z)
			local ctrl = self:GetArcControl(start, apex)
			self._T.formStart = start
			self._T.outCtrl = ctrl
			local a = math.atan(ctrl.y - sp.y, ctrl.x - sp.x)
			self._T.velAngle = a
			self.FlyDirX = (math.cos(a) < 0) and -1 or 1
			self.FlyAngle = math.deg(a)
			-- 솟아오르는 동안은 도달 판정을 열지 않는다(스쳐 지나가는 몬스터에 걸리지 않게) -
			-- 유예 길이를 여기서 직접 맞춰야
			-- 시전 쪽(PlayerAttack)과 값이 어긋나지 않는다.
			self.NoHitTime = self.ArcOutTime + (self.LaunchDelay or 0)
		end
		self.Fired = true
		self:SpawnSpinVisualIfNeeded()
		log("[Shuriken] Fire skin=" .. tostring(self.SkinIndex)
			.. " dirX=" .. tostring(self.FlyDirX) .. " angle=" .. tostring(self.FlyAngle)
			.. " hasTarget=" .. tostring(isvalid(self._T.target)))
	end

	-- (표창+) 전용 비행 클립이 없는 표창(토피/일비)은 아이콘을 직접 회전시키며 날려야 한다는 요청.
	-- ⚠ 표창 투사체 모델에는 SpriteRendererComponent가 없다(실측 - 비행 모습을 전부 PlayEffectAttached로
	--   처리하는 모델이다). 그래서 스프라이트를 가진 공용 이펙트 모델을 하나 띄워 따라다니게 하고,
	--   서버에서 위치·회전을 매 틱 갱신한다(회전을 클라에서 돌리면 서버 트랜스폼 동기화에 덮인다).
	--
	-- ⚠ 이 호스트 모델에는 script.SpearBurstFadingEffect가 **기본으로 붙어 있지 않다**(실측 -
	--   GetComponent가 nil을 돌려준다. 그 컴포넌트는 쓰는 쪽에서 AddComponent해 붙이는 구조다).
	--   그래서 스프라이트는 우리 SpinningShuriken이 클라이언트에서 직접 입힌다(확대 대조로 렌더 확인).
	@ExecSpace("ServerOnly")
	method void SpawnSpinVisualIfNeeded()
		-- 회전형 표창이면 아이콘을 들고 따라다닐 동반 엔티티를 띄운다.
		-- (마크 오브 어쌔신) 각도 추종(AngleTracked) 표창도 동반 엔티티를 쓴다 - 부착 이펙트는 회전을
		-- 못 바꾸는데, 마크 표창은 표적이 죽으면 갈아타서 **비행 중 방향이 바뀐다**. 비행 클립을 실은
		-- 동반 엔티티의 ZRotation을 진행각에 맞춰 매 틱 갱신해야 방향이 따라 돈다.
		-- 전용 비행 클립이 없는 표창(토피/일비)은 기존처럼 아이콘 회전으로 대신한다.
		local info = _ShurikenLibrary:Get(self.SkinIndex)
		local tracked = self.CurveFly or self.AngleTracked
		local curveAligned = tracked and (info.fly ~= nil and info.fly ~= "") and not info.spin
		if not info.spin and not tracked then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local ent = _SpawnService:SpawnByModelId("spearburstfadingeffect", "shuriken_spin", pos, map)
		if not isvalid(ent) then return end
		self._T.curveAligned = curveAligned
		-- 아이콘 스프라이트의 중심이 엔티티 원점에서 어긋난 양(피벗이 좌하단이라 생기는 값, 실측).
		-- 이걸 회전시켜 빼주지 않으면 회전축이 모서리라 "제자리 회전"이 아니라 원을 그리며 돈다.
		self._T.spinOx = info.ox or 0
		self._T.spinOy = info.oy or 0
		-- 스프라이트는 **클라이언트에서** 입혀야 한다(서버에서 네이티브 SpriteRUID를 써도 반영되지 않는다).
		ent:AddComponent("script.SpinningShuriken")
		---@type SpinningShuriken
		local sv = ent:GetComponent("script.SpinningShuriken")
		if sv ~= nil then sv.IconRUID = curveAligned and info.fly or info.icon end
		-- 안전장치: 어떤 경로로도 정리되지 않는 경우가 있어(실측 - 맵에 동반 엔티티 4개가 쌓여 있었다)
		-- 표창 최대 수명보다 조금 뒤에 스스로 사라지게 못을 박아둔다.
		ent:Destroy(self.MaxLifetime + 0.5)
		self._T.spinEnt = ent
		self._T.spinAngle = 0
	end

	@ExecSpace("ServerOnly")
	method void ClearSpinVisual()
		-- 동반 회전 엔티티 정리(명중/수명 종료 시).
		if isvalid(self._T.spinEnt) then
			self._T.spinEnt:Destroy()
		end
		self._T.spinEnt = nil
	end

	@ExecSpace("ServerOnly")
	method Entity GetTarget()
		-- LuckySevenProjectileAttack.IsAttackTarget이 밀집 지역에서 고정 표적 하나만 통과시키기 위해 조회한다
		return self._T.target
	end

	@ExecSpace("ServerOnly")
	method void RetargetNearestMonster()
		-- (마크 오브 어쌔신) 비행 중 대상이 죽으면 다른 살아있는 몬스터로 갈아타 계속 날아간다.
		-- 매 프레임 맵 전체를 훑지 않게 0.2초 간격으로만 재시도한다.
		-- (요청 2026-08-07) 후보를 **표창 주변 8유닛의 가장 가까운 1마리**에서 **시전자 전방의
		--   아무 몬스터(랜덤)**로 바꿨다 - 가장 가까운 놈을 고르면 여러 발이 전부 같은 한 마리로
		--   몰려 "표적이 죽으면 다른 적들에게 퍼진다"는 그림이 안 나왔다(실측: 3발 전부 같은 대상).
		--   후보 범위는 최초 프록 때와 같은 규칙(PlayerAttack.TryProcAssassinMark) -
		--   플레이어가 바라보는 쪽 전방 9유닛 / 상하 5유닛.
		local nowT = _UtilLogic.ServerElapsedSeconds
		if (self._T.nextRetargetAt or 0) > nowT then return end
		self._T.nextRetargetAt = nowT + 0.2
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		-- 시전자(플레이어)를 잡는다 - 전방 판정의 기준점이다.
		local ownerEnt = nil
		---@type LuckySevenProjectileAttack
		local acRT = self.Entity:GetComponent("script.LuckySevenProjectileAttack")
		if acRT ~= nil and isvalid(acRT.OwnerEntity) then
			ownerEnt = acRT.OwnerEntity
		end
		-- 시전자를 못 잡으면(예외 경로) 표창 자신을 기준으로 반경 안에서만 고른다.
		local basePos = self.Entity.TransformComponent.WorldPosition
		local lookDir = 0
		if isvalid(ownerEnt) then
			basePos = ownerEnt.TransformComponent.WorldPosition
			local ctrl = ownerEnt.PlayerControllerComponent
			lookDir = (isvalid(ctrl) and ctrl.LookDirectionX < 0) and -1 or 1
		end
		local comps = map:GetChildComponentsByTypeName("script.Monster", true)
		local cands = {}
		for _, comp in ipairs(comps) do
			---@type Monster
			local mc = comp
			-- (2026-08-07) 예전엔 시전자가 지금 노리는 표적을 IsAssassinMarkExcluded로 걸러냈지만,
			-- 마크 시스템과 함께 그 메서드가 사라져 조건에서 뺐다(이 재타게팅 경로는 지금 아무도
			-- 켜지 않는 RetargetOnDeath 전용이라 실사용 영향이 없다).
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead and mc.Entity.Enable then
				local mp = mc.Entity.TransformComponent.WorldPosition
				local ddx = mp.x - basePos.x
				local ddy = mp.y - basePos.y
				local ok = false
				if lookDir ~= 0 then
					ok = (ddx * lookDir > 0.2) and math.abs(ddx) <= 9.0 and math.abs(ddy) <= 5.0
				else
					ok = (ddx * ddx + ddy * ddy) < 64.0
				end
				if ok then table.insert(cands, mc) end
			end
		end
		if #cands == 0 then return end
		-- 아무나 한 마리(균등 랜덤) - 발마다 다른 대상으로 흩어진다.
		local best = cands[_UtilLogic:RandomIntegerRange(1, #cands)]
		self._T.target = best.Entity
		self._T.targetMonster = best
		self._T.targetDied = nil
		local tp = best.Entity.TransformComponent.Position
		self._T.fallbackPos = Vector3(tp.x, tp.y + _ShurikenLibrary:GetThrowHeight(), tp.z)
		log("[Shuriken] 마크 표창 재타게팅 → " .. tostring(best.Entity.Name)
			.. " (전방 후보 " .. tostring(#cands) .. "마리 중 랜덤)")
	end

	@ExecSpace("ServerOnly")
	method Vector3 GetArcControl(Vector3 fromPos, Vector3 toPos)
		-- (마크 오브 어쌔신) 두 점을 잇는 **호**의 2차 베지어 제어점: 현의 중점에서 현에 수직으로
		-- 부풀린다. 부푸는 쪽은 CurveSide(±1), 세기는 CurveBend(현 길이 대비 비율)로 발마다 다르다.
		-- 2차 베지어는 제어점까지 절반만 따라가므로 실제 부푸는 폭은 현 길이 × CurveBend ÷ 2다.
		local dx = toPos.x - fromPos.x
		local dy = toPos.y - fromPos.y
		local len = math.sqrt(dx * dx + dy * dy)
		local mx = (fromPos.x + toPos.x) * 0.5
		local my = (fromPos.y + toPos.y) * 0.5
		-- 두 점이 겹치다시피 하면 수직 방향을 못 구한다 - 중점을 그대로 써서 직선으로 폴백한다.
		if len < 0.05 then return Vector3(mx, my, fromPos.z) end
		local side = (self.CurveSide < 0) and -1 or 1
		local bow = len * self.CurveBend * side
		return Vector3(mx - dy / len * bow, my + dx / len * bow, fromPos.z)
	end

	@ExecSpace("ServerOnly")
	method number GetEaseBlend(number chordLen, number durSec)
		-- (요청 2026-08-06) "최고점에서 완전히 멈추는 게 부자연스럽다" - ease-out(1-(1-s)²)은 끝
		-- 기울기가, ease-in(s²)은 시작 기울기가 정확히 0이라 그 지점에서 속도가 0이 된다.
		-- 그래서 두 곡선에 **선형 성분(등속)을 이 비율만큼 섞는다** - 섞은 곡선의 끝(시작) 기울기가
		-- 곧 이 비율이 되어 최고점을 그 속도로 통과한다.
		-- 비율 = 목표 통과 속도(ApexSpeed) ÷ 평균 속도(호 길이 ÷ 구간 시간).
		-- ⚠ 1에 가까울수록 곡선이 등속 직선에 가까워져 "빠르게 나갔다 느려지는" 맛이 사라진다 -
		--   0.55에서 자른다(이때도 시작:끝 속도비가 1.45:0.55 ≈ 2.6배라 감속이 충분히 보인다).
		--   반지름이 아주 작은 발은 이 상한에 걸려 목표보다 느리게 통과하지만, 호 자체가 짧아 티나지 않는다.
		if durSec <= 0.0001 or chordLen <= 0.01 then return 0.0 end
		local ratio = self.ApexSpeed * durSec / chordLen
		if ratio > 0.55 then ratio = 0.55 elseif ratio < 0 then ratio = 0 end
		return ratio
	end

	@ExecSpace("ServerOnly")
	method number SmoothStep(number u)
		-- 0~1을 부드럽게(양 끝 기울기 0) 이어주는 곡선 3u²-2u³. 원근감 크기 변화가 갑자기
		-- 시작/멈추지 않게 하는 용도라 위치 계산의 가감속(GetEaseBlend)과는 목적이 다르다.
		if u <= 0 then return 0.0 end
		if u >= 1 then return 1.0 end
		return u * u * (3.0 - 2.0 * u)
	end

	@ExecSpace("ServerOnly")
	method Vector3 EvalArc(Vector3 fromPos, Vector3 ctrlPos, Vector3 toPos, number u)
		-- 2차 베지어 B(u) = (1-u)²·from + 2(1-u)u·ctrl + u²·to. u는 호출부에서 이미
		-- 가감속 곡선(ease-out/ease-in)을 먹인 값이 들어온다 - 여기서는 위치만 낸다.
		local iu = 1.0 - u
		return Vector3(
			iu * iu * fromPos.x + 2 * iu * u * ctrlPos.x + u * u * toPos.x,
			iu * iu * fromPos.y + 2 * iu * u * ctrlPos.y + u * u * toPos.y,
			fromPos.z)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self._T.hit then return end
		
		self._T.lifetime = self._T.lifetime + delta
		if self._T.lifetime >= self.MaxLifetime then
			-- 명중하지 못하고 사라지는 경우 - 대상이 사망 유예 상태로 남지 않게 풀어준다.
			self:ReleaseDeathDefer()
			self:ClearSpinVisual()
			_EntityService:Destroy(self.Entity)
			return
		end

		-- 회전형 표창: 동반 엔티티를 표창 위치에 붙이고 계속 돌린다(초당 2바퀴).
		-- ⚠ 아이콘 피벗이 좌하단이라 ZRotation만 주면 스프라이트가 원점 둘레를 도는 것처럼 보인다
		--   ("제자리 회전이 아니라 이동하며 도는 것 같다"는 신고). 스프라이트 중심 오프셋(ox,oy)을
		--   같은 각도로 돌려서 위치에서 빼주면 중심이 표창 위치에 고정된 채 제자리에서만 돈다.
		if isvalid(self._T.spinEnt) then
			local p = self.Entity.TransformComponent.WorldPosition
			if self._T.curveAligned then
				-- (마크 오브 어쌔신) 비행 클립을 진행 방향으로 정렬한다 - 표적을 갈아탈 때마다 각도가 따라 돈다.
				-- 클립 기본 방향은 왼쪽(head=180, 9종 전부 실측)이라 진행각 - 180이 렌더 각도다.
				self._T.spinEnt.TransformComponent.WorldPosition = Vector3(p.x, p.y, p.z)
				self._T.spinEnt.TransformComponent.ZRotation = math.deg(self._T.velAngle or 0) - 180
			else
				self._T.spinAngle = ((self._T.spinAngle or 0) + 720 * delta) % 360
				local th = math.rad(self._T.spinAngle)
				local ox = self._T.spinOx or 0
				local oy = self._T.spinOy or 0
				local rx = ox * math.cos(th) - oy * math.sin(th)
				local ry = ox * math.sin(th) + oy * math.cos(th)
				self._T.spinEnt.TransformComponent.WorldPosition = Vector3(p.x - rx, p.y - ry, p.z)
				self._T.spinEnt.TransformComponent.ZRotation = self._T.spinAngle
			end
		end

		-- 대상이 살아있으면 계속 추적하고, 죽어서 사라졌으면 캐스팅 시점에 저장된 마지막 위치로 계속 날아간다
		-- (럭키세븐은 항상 표창 2개 분의 데미지 표시가 나가야 하므로, 대상 소멸 여부와 무관하게 끝까지 도달시킨다).
		-- (마크 오브 어쌔신) 마크 표창만 예외 - 대상이 죽으면 근처의 다른 살아있는 몬스터로 갈아탄다.
		if (self.RetargetOnDeath or self.CurveFly) and self:IsTargetGone() then
			self:RetargetNearestMonster()
		end
		local aimPos = self:GetAimPos(self._T.fallbackPos)
		if aimPos == nil then
			self:ClearSpinVisual()
			_EntityService:Destroy(self.Entity)
			return
		end
		
		local myPos = self.Entity.TransformComponent.Position
		local dx = aimPos.x - myPos.x
		local dy = aimPos.y - myPos.y
		local dist = math.sqrt(dx * dx + dy * dy)
		
		-- 무충돌 유예(NoHitTime) 안에는 도달로 치지 않는다 - 유예 중에는 대상을 스쳐 지나가며 계속 유영한다.
		if dist <= self.HitRadius and self._T.lifetime >= self.NoHitTime then
			self:OnHit()
			return
		end

		-- (마크 오브 어쌔신, 연출 개편 2026-08-06 3차) **끊김 없는 호 비행**.
		-- (2026-08-07 3차) 스폰점이 **플레이어**, 최고점이 **플레이어→표적 현 위에 수직으로 띄운 점**이
		--   되면서 전체 궤적이 "뒤로 갔다 되돌아옴"에서 **전방으로 그리는 반원**으로 바뀌었다.
		--   아래 두 호를 잇는 구조 자체는 그대로다(꼭대기 좌표만 시전 쪽에서 다르게 준다).
		--   ① 솟아오름(0 ~ outDur): 스폰점(플레이어) → 꼭대기(FormationX/Y)까지 부풀린 호를
		--      **ease-out**으로 - 던지는 순간이 가장 빠르고 꼭대기로 갈수록 느려진다.
		--   ② 내려꽂힘(outDur ~): 꼭대기 → 표적까지 다시 부풀린 호를 **ease-in**으로 - 꼭대기를
		--      지나면서 다시 가속해 표적에 꽂힌다. 두 번째 호의 시작 제어점을 ①의 끝 진행
		--      방향으로 잡아, 두 호가 만나는 지점에서 방향이 꺾이지 않고 반원처럼 이어진다.
		-- ⚠ (요청 2026-08-06) 순수 ease-out/ease-in은 이음매에서 속도가 **정확히 0**이라 최고점에
		--   딱 멎는 게 부자연스러웠다. 두 곡선 모두 선형 성분을 GetEaseBlend 비율만큼 섞어
		--   ApexSpeed(유닛/초)로 통과시킨다 - 양쪽에 같은 목표 속도를 쓰므로 이음매에서 속도가
		--   이어지고(방향은 접선 일치로 이미 이어져 있다) 멈추는 순간 없이 흐른다.
		-- 발당 순차감은 "기다리는 시간"이 아니라 outDur(뻗어 나가는 시간) 자체를 LaunchDelay만큼
		-- 늘려서 준다 - 그래서 발마다 되돌아오기 시작하는 시점이 어긋나되 어느 발도 멈추지 않는다.
		-- 표창 각도(velAngle)는 매 틱 **실제 이동 벡터**에서 뽑으므로 곡선을 따라 자연히 돌아간다.
		if self.CurveFly then
			local t = self._T.lifetime
			local outDur = self.ArcOutTime + (self.LaunchDelay or 0)
			local p0 = self._T.formStart
			if p0 == nil then
				p0 = Vector3(myPos.x, myPos.y, myPos.z)
				self._T.formStart = p0
			end
			local apex = Vector3(self.FormationX, self.FormationY, myPos.z)
			-- 던짐 호의 제어점은 발사 시점에 한 번만 정한다(스폰점·최고점 모두 고정값이라 불변).
			local outCtrl = self._T.outCtrl
			if outCtrl == nil then
				outCtrl = self:GetArcControl(p0, apex)
				self._T.outCtrl = outCtrl
			end
			local nextPos
			if t < outDur then
				-- ① 던짐: ease-out에 선형 성분(r)을 섞어 **최고점에서도 ApexSpeed만큼은 남긴다**
				--   (순수 ease-out은 끝 기울기가 0이라 딱 멈춰 버린다 - 요청).
				--   k(0)=0, k(1)=1은 그대로 유지되므로 스폰점/최고점에 정확히 닿는다.
				local s = t / outDur
				local dxo = apex.x - p0.x
				local dyo = apex.y - p0.y
				local r = self:GetEaseBlend(math.sqrt(dxo * dxo + dyo * dyo), outDur)
				local k = (1.0 - r) * (1.0 - (1.0 - s) * (1.0 - s)) + r * s
				nextPos = self:EvalArc(p0, outCtrl, apex, k)
			else
				-- ② 내려꽂힘: 표적까지 걸릴 시간은 꼭대기를 넘는 순간의 거리로 한 번만 정한다
				--   (매 틱 다시 재면 표적이 다가올 때 영영 도착하지 않는다).
				if self._T.inDur == nil then
					local sp = (self.Speed > 0.01) and self.Speed or 9.5
					local ddx = aimPos.x - apex.x
					local ddy = aimPos.y - apex.y
					-- 호는 현보다 길고(≈1.35배) ease-in이라 평균 속도가 낮다 - 그만큼 시간을 준다.
					-- (2026-08-07) 호가 커지면서 뒤 절반 거리도 길어졌다 - 상한 1.6초로는 먼 발이
					-- 전부 상한에 걸려 총알처럼 직진했다. 2.2초로 늘린다
					-- (앞 절반 최대 ~1.4초 + 2.2초 < MaxLifetime 4.5초라 수명 안에 반드시 도착한다).
					local chord0 = math.sqrt(ddx * ddx + ddy * ddy)
					local dur = chord0 * 1.35 / sp
					if dur < 0.45 then dur = 0.45 elseif dur > 2.2 then dur = 2.2 end
					self._T.inDur = dur
					self._T.inChord = chord0
					log("[Shuriken] 곡선 표창 꼭대기 통과 - 내려꽂히는 시간=" .. tostring(dur))
				end
				local s = (t - outDur) / self._T.inDur
				if s > 1 then s = 1 end
				-- 시작 제어점 = 꼭대기에서 **①의 끝 진행 방향**으로 뻗은 점(2차 베지어의 u=1
				-- 접선은 제어점→끝점 방향이다). 이 방향을 물려받아야 꺾이는 지점 없이 이어진다.
				local tx = apex.x - outCtrl.x
				local ty = apex.y - outCtrl.y
				local tl = math.sqrt(tx * tx + ty * ty)
				local ddx = aimPos.x - apex.x
				local ddy = aimPos.y - apex.y
				-- (2026-08-07 3차) 뻗는 길이 0.45 → **0.70**. 정사분원을 2차 베지어로 근사할 때
				-- 제어점은 현 길이의 0.707 지점(두 접선의 교점)에 온다 - 0.45로는 뒤 절반이
				-- 납작해져 "반원"보다 직선 급강하에 가까웠다.
				local reach = math.sqrt(ddx * ddx + ddy * ddy) * 0.70
				local inCtrl = apex
				if tl > 0.0001 then
					inCtrl = Vector3(apex.x + tx / tl * reach, apex.y + ty / tl * reach, apex.z)
				end
				-- ease-in에 선형 성분(q)을 섞어 **최고점을 ApexSpeed로 지나며 출발**한다(순수 ease-in은
				-- 시작 기울기가 0이라 멈춘 채 출발한다 - 요청). 표적에 닿을 때가 여전히 가장 빠르다.
				-- 거리는 되돌아서던 순간 값(inChord)을 쓴다 - 표적이 다가오면 매 틱 값이 흔들린다.
				local dxi = aimPos.x - apex.x
				local dyi = aimPos.y - apex.y
				local chordIn = math.sqrt(dxi * dxi + dyi * dyi)
				if self._T.inChord ~= nil then chordIn = self._T.inChord end
				local q = self:GetEaseBlend(chordIn, self._T.inDur)
				nextPos = self:EvalArc(apex, inCtrl, aimPos, (1.0 - q) * s * s + q * s)
			end
			local mvx = nextPos.x - myPos.x
			local mvy = nextPos.y - myPos.y
			if mvx * mvx + mvy * mvy > 0.0000001 then
				self._T.velAngle = math.atan(mvy, mvx)
			end
			self.Entity.TransformComponent.Position = Vector3(nextPos.x, nextPos.y, myPos.z)
			return
		end

		local moveX, moveY = 0, 0
		if dist > 0.0001 then
			moveX = dx / dist
			moveY = dy / dist
			-- (마크 오브 어쌔신) 동반 시각 엔티티가 진행 방향을 따라 돌 수 있게 진행각을 남긴다 -
			-- 직선 비행이라 평소엔 고정이지만, 표적이 죽어 갈아타면 여기서 새 방향이 반영된다.
			self._T.velAngle = math.atan(moveY, moveX)
		end
		self.Entity.TransformComponent:Translate(moveX * self.Speed * delta, moveY * self.Speed * delta)
	end

	@ExecSpace("ServerOnly")
	method void OnHit()
		-- 표창 1개 명중 처리: AttackFrom으로 데미지 판정 후 타격 이펙트/사운드/데미지 스킨 재생, 자기 자신 제거
		-- self._T.hit를 즉시 true로 세팅 - 이게 빠져있어서 Destroy가 실제 반영되기 전에 OnUpdate가 한 번 더 돌면
		-- OnHit()이 중복 호출되어 데미지 스킨이 표창 1개당 2번씩(총 4줄) 뜨던 버그가 있었다.
		if self._T.hit then return end
		self._T.hit = true
		if self.RetargetOnDeath or self.CurveFly then
			log("[Shuriken] 마크 표창 적중 (비행 " .. string.format("%.2f", self._T.lifetime or 0) .. "초)")
		end
		self:ClearSpinVisual()

		-- 쉐도우 파트너의 그림자 몫(시각 전용) 표창: 직접적인 데미지를 주지 않는다는 요청 -
		-- 데미지 판정과 데미지 숫자는 없다.
		-- (요청 2026-08-05) 다만 **타격 이펙트와 타격음은 원본 표창과 똑같이** 낸다 - 그림자 표창이
		--   원본 뒤에 이어서 날아가게 바뀌면서, 소리 없이 꽂히면 뒤쪽 절반이 통째로 먹통처럼 들렸다.
		-- ⚠ 허공 투척(SilentOnMiss)이면 원본도 조용히 사라지므로 그림자도 소리/이펙트를 내면 안 된다.
		-- ⚠ 대상이 비행 중에 죽었으면 **타격 이펙트만** 생략하고 타격음은 그대로 낸다.
		--   그림자 몫은 원본보다 뒤에 도착하는데, 사망 유예(마지막 원본 표창에만 죽음)를 쓰는 구조라
		--   대상이 죽는 시전에서는 그림자 표창이 **항상** 사후 도착이다 - 여기서 소리까지 막으면
		--   "몬스터를 잡을 때마다 뒤쪽 절반이 무음"이 된다(요청과 정반대). 이펙트를 막는 이유는
		--   그 자리에 몬스터가 부활하면 "hit 이펙트를 달고 부활"하는 것처럼 보이기 때문이고,
		--   소리에는 그 문제가 없다.
		if self.VisualOnly then
			if not self.SilentOnMiss then
				local vpos = self.Entity.TransformComponent.Position
				self:ShowShadowHitEffect(vpos.x, vpos.y, vpos.z, self.HitEffectRUID, self._T.targetDied ~= true)
				if self.VisualDamage > 0 then
					self:ShowDamageSkin(self.VisualDamage, 0, self.HitIndex, self.VisualDamageCritical, false,
						(self.DamageSkinRUID ~= "") and self.DamageSkinRUID or "3271c3e79bf04ecba9a107d55495970d", self.TotalShots)
				end
			end
			_EntityService:Destroy(self.Entity)
			return
		end

		local pos = self.Entity.TransformComponent.Position
		---@type LuckySevenProjectileAttack
		local ac = self.Entity:GetComponent("script.LuckySevenProjectileAttack")
		local target = self._T.target
		local damage = 0
		local bonus = 0
		local damageIsCritical = false
		local bonusIsCritical = false
		local landedRealHit = false
		-- ⚠ 대상이 비행 중에 죽었으면 **판정을 아예 하지 않는다**. 몬스터는 죽어도 엔티티가 남아 있고
		--   잠시 뒤 최초 배치 위치로 부활하는데(Monster.Respawn), 그 자리가 죽은 자리와 비슷하면
		--   남은 표창의 AttackFrom이 되살아난 몬스터를 때려 "죽었던 몬스터가 hit 이펙트를 달고
		--   부활"하는 것처럼 보였다(신고). 숫자만 표시 경로로 띄우고 판정/타격 이펙트는 건너뛴다.
		if ac ~= nil and isvalid(target) and self._T.targetDied ~= true then
			-- (요청) 표창을 여러 발 던지는 스킬은 **마지막 발에만** 죽어야 한다
			-- ("hit 사운드를 온전히 다 들려주고 죽는 모션을 늦추기 위함").
			-- 마지막이 아니면 대상의 사망을 유예해 HP 1로 버티게 하고, 마지막 발이면 유예를 풀어 죽게 한다.
			-- ⚠ 반드시 AttackFrom(실제 데미지 적용) **전에** 해야 한다.
			self:ApplyDeathDefer()
			local hitList = ac:AttackFrom(
				Vector2(self.HitRadius * 2, self.HitRadius * 2),
				pos:ToVector2(),
				"skill.luckyseven",
				CollisionGroups.HitBox
			)
			if hitList ~= nil and #hitList > 0 then
				landedRealHit = true
				damage = ac._T.lastDamage or 0
				bonus = ac._T.lastBonus or 0
				damageIsCritical = ac._T.lastDamageIsCritical or false
				bonusIsCritical = ac._T.lastBonusIsCritical or false
			end
		end
		-- (2026-08-07) 여기 있던 마크 오브 어쌔신 프록 위임(TryProcAssassinMark)은 스킬이
		-- "트레이닝"(순수 공격력 패시브)으로 바뀌면서 함께 제거했다. MarkEligible 프로퍼티는
		-- 아무도 켜지 않는 휴면 상태로 남아 있다.
		if not landedRealHit and self.SilentOnMiss then
			-- 애초에 대상이 없어 허공으로 던진 표창: 도달 지점에서 조용히 사라진다(숫자/이펙트 없음).
			log("[Shuriken] 허공 투척 표창 도달 - 표시 없이 소멸")
			_EntityService:Destroy(self.Entity)
			return
		end
		if self._T.targetDied == true then
			-- 비행 중에 대상이 죽은 표창: **아무 표시도 하지 않고** 사라진다.
			-- 예전엔 "럭키세븐은 표창 개수만큼 숫자가 항상 떠야 한다"는 사양 때문에 표시용 데미지를
			-- 계산해 띄웠는데, 지금은 사망 유예(Monster.DeferDeath)가 "마지막 타에만 죽기"를 보장하므로
			-- 한 시전의 모든 표창이 살아있는 대상에 정상으로 꽂힌다 - 이 경로는 다른 원인으로 대상이
			-- 먼저 죽은 예외 상황뿐이고, 그때 빈 자리에 숫자가 뜨는 게 문제였다(신고).
			log("[Shuriken] 비행 중 대상 사망 - 표시 없이 소멸")
			_EntityService:Destroy(self.Entity)
			return
		end
		if not landedRealHit then
			-- 대상이 먼저 죽어서 사라진 경우: 실제 타격 판정은 없지만, 럭키세븐은 표창 분의
			-- 데미지 숫자가 항상 떠야 하므로 동일한 공식으로 표시용 데미지만 계산해 보여준다.
			-- 쉐도우 파트너 중에는 표시용 보너스(타수 2배 몫)도 같은 공식으로 함께 굴린다.
			-- (버그 수정) "1번째 표창이 대상을 처치하면 2번째 표창은 항상 이 표시 전용 경로로 빠지는데,
			-- 크리티컬을 항상 false로 고정해서 결과적으로 2번째 줄만 크리티컬이 거의 안 뜨는 것처럼
			-- 보였다"는 신고 - 실제 판정이 없다는 이유로 크리티컬 자체를 꺼둔 것이 원인. 실제 히트와
			-- 동일하게 CritRate로 독립적으로 굴려 배율을 반영한다(실 데미지에는 영향 없는 표시 전용 값).
			-- 시전 시점에 이미 확정해둔 값이 있으면 그것을 그대로 보여준다(재굴림 금지).
			if self.PreRolled then
				damage = self.PreDamage
				bonus = self.PreBonus
				damageIsCritical = self.PreDamageCritical
				bonusIsCritical = self.PreBonusCritical
			else
				local critRate = (self.CritRate or 50) / 100
				local mult = 1.0 + math.random() * (1.5 - 1.0)
				damage = math.floor(self.CombatPower * mult)
				damageIsCritical = _UtilLogic:RandomDouble() < critRate
				if damageIsCritical then
					damage = math.floor(damage * 2.0)
				end
				if self.ShadowEchoOn then
					-- (2026-08-05 개편) 분신 몫은 투자 레벨별 고정 배율(0.50~0.79)이다 - 발사 시점에 새겨진 값을 쓴다.
					bonus = math.floor(damage * (self.ShadowEchoRate or 0.5))
					bonusIsCritical = _UtilLogic:RandomDouble() < critRate
					if bonusIsCritical then
						bonus = math.floor(bonus * 2.0)
					end
				end
			end
		end

		local displayBonus = self.DeferBonusDisplay and 0 or bonus
		self:ShowDamageSkin(damage, displayBonus, self.HitIndex, damageIsCritical, bonusIsCritical, (self.DamageSkinRUID ~= "") and self.DamageSkinRUID or "3271c3e79bf04ecba9a107d55495970d", self.TotalShots)
		-- 대상이 죽은 뒤 도달한 표창은 **타격 이펙트를 재생하지 않는다**. 그 자리에 몬스터가 부활하면
		-- 이펙트가 되살아난 몬스터 위에서 터져 "hit 이펙트를 달고 부활"하는 것처럼 보인다(신고).
		-- 데미지 숫자는 럭키세븐 사양대로 계속 띄운다.
		if self._T.targetDied ~= true then
			self:ShowHitEffect(pos.x, pos.y, pos.z, self.ShadowEchoOn, self.HitEffectRUID)
		else
			log("[Shuriken] 대상이 죽은 뒤 도달 - 숫자만 표시, 타격 이펙트 생략")
		end
		_EntityService:Destroy(self.Entity)
	end

	@ExecSpace("Client")
	method void ShowDamageSkin(integer damage, integer bonus, integer hitIndex, boolean damageIsCritical, boolean bonusIsCritical, string skinRuid, integer totalShots)
		-- (버그 수정) 예전엔 기본 히트 스킨 RUID가 여기 하드코딩돼 있어서, 블리자드처럼 스킨을 한시적으로
		-- 바꾸는 연출이 표창(다중 타격)에는 적용되지 않았다 - 발사 시점의 스킨을 인자로 받아 그대로 쓴다.
		-- 대상 엔티티가 이미 사라졌을 수도 있으므로(먼저 죽은 경우) 항상 유효한 표창 자신(self.Entity)에 앵커링한다.
		local shots = (totalShots ~= nil and totalShots > 0) and totalShots or 2
		-- 피해 숫자 자체가 위로 떠오르는 연출을 가지므로 시작 높이와 줄 간격을 낮고 촘촘하게 둔다.
		local gap = 0.2
		local topY = 0.15
		-- 공통 몬스터 앵커가 있으면 충돌체의 실제 윗부분 바로 위에서 첫 줄을 시작한다.
		if isvalid(self.DamageAnchor) then
			local hit = self.DamageAnchor.HitComponent
			if isvalid(hit) then
				local halfH = 0.3
				if hit.ColliderType == ColliderType.Box then
					halfH = hit.BoxSize.y / 2
				elseif hit.ColliderType == ColliderType.Circle then
					halfH = hit.CircleRadius
				end
				-- 충돌체 최상단보다 0.1 아래에서 시작해 실제 렌더가 지나치게 높아지는 것을 막는다.
				topY = hit.ColliderOffset.y + halfH - 0.1
			end
		end
		-- 1번 줄은 몬스터 바로 위, 이후 줄은 번호가 커질수록 그 위로 쌓인다.
		local offsetY = topY + (math.max(1, hitIndex) - 1) * gap
		local bonusGap = shots * gap
		-- (버그 수정) "각자 크리티컬 여부를 독립적으로 판단해야 한다" - 하드코딩된 false 대신 CalcDamage가
		-- 독립적으로 굴린 결과를 그대로 전달한다.
		local damageAnchor = isvalid(self.DamageAnchor) and self.DamageAnchor or self.Entity
		_DamageSkinService:Play(
			damageAnchor, skinRuid, 0,
			{ damage }, DamageSkinTweenType.Default, damageIsCritical,
			Vector2(0, offsetY), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		)
		if bonus > 0 then
			_DamageSkinService:Play(
				damageAnchor, skinRuid, 0,
				{ bonus }, DamageSkinTweenType.Default, bonusIsCritical,
				Vector2(0, offsetY + bonusGap), Vector2(1, 1), 1.0, 1.0, LitMode.Default
			)
		end
		log("[LuckySeven] ShowDamageSkin hitIndex=" .. tostring(hitIndex) .. " damage=" .. tostring(damage) .. " bonus=" .. tostring(bonus) .. " offsetY=" .. tostring(offsetY) .. " dmgCrit=" .. tostring(damageIsCritical) .. " bonusCrit=" .. tostring(bonusIsCritical))
	end

	@ExecSpace("Client")
	method void ShowHitEffect(number px, number py, number pz, boolean echo, string hitRuid)
		-- 타격시 몬스터 위치에서 나오는 모션 + 타격음. 타격 이펙트는 스킬마다 달라서 인자로 받는다
		-- (럭키세븐 = skill/400.img/skill/4001344의 hit/0, 트리플/쿼드러플 스로우는 각자 팩의 hit/0).
		-- 타격음은 세 스킬 모두 럭키세븐과 같다는 요청.
		local mapEnt = self.Entity.CurrentMap
		if not isvalid(mapEnt) then return end
		local ruid = (hitRuid ~= nil and hitRuid ~= "") and hitRuid or "458e72f0720a4584a9a7fc3642b6e601"
		_EffectService:PlayEffect(
			ruid, mapEnt,
			Vector3(px, py, pz), 0, Vector3(1, 1, 1), false
		)
		-- 타격음은 표창마다 다를 수 있다(마크 오브 어쌔신 전용음) - @Sync로 내려온 값을 쓴다.
		local sndRuid = (self.HitSoundRUID ~= nil and self.HitSoundRUID ~= "") and self.HitSoundRUID or "48c2f4049db54b3b88b9144320d3d41a"
		_SoundService:PlaySound(sndRuid, 1.0)
		-- ⚠ (2026-08-05) 예전에는 여기서 "그림자 몫"을 흉내내려고 같은 이펙트를 0.25초 뒤에 한 번 더
		--   재생했다. 지금은 그림자 표창이 **실제로 뒤이어 날아와 자기 자리에서 터지므로**(아래
		--   ShowShadowHitEffect) 그 흉내는 폐기했다 - 남겨두면 표창 1발에 이펙트가 3번 터진다.
		--   echo 인자는 호출부 시그니처를 건드리지 않으려고 그대로 두었다(지금은 쓰지 않는다).
	end

	@ExecSpace("Client")
	method void ShowShadowHitEffect(number px, number py, number pz, string hitRuid, boolean showEffect)
		-- 쉐도우 파트너의 그림자 몫 표창이 꽂힌 자리의 타격 이펙트 + 타격음.
		-- 이펙트는 원본과 같은 클립을 투명도 70%로(그림자 몫 공통 규칙), 타격음은 원본과 **동일하게**
		-- 낸다(요청: "그림자 표창의 히트사운드도 플레이어 것과 같이 있어야 한다").
		-- showEffect=false = 대상이 이미 죽어 사라진 뒤 도착 → 소리만 내고 이펙트는 생략한다.
		local mapEnt = self.Entity.CurrentMap
		if not isvalid(mapEnt) then return end
		if showEffect then
			local ruid = (hitRuid ~= nil and hitRuid ~= "") and hitRuid or "458e72f0720a4584a9a7fc3642b6e601"
			_EffectService:PlayEffect(
				ruid, mapEnt,
				Vector3(px, py, pz), 0, Vector3(1, 1, 1), false, { ["Alpha"] = 0.7 }
			)
		end
		_SoundService:PlaySound("48c2f4049db54b3b88b9144320d3d41a", 1.0)
		log("[LuckySeven] 그림자 표창 타격음" .. (showEffect and " + 이펙트" or "(이펙트 생략 - 대상 사망)")
			.. " pos=(" .. tostring(px) .. "," .. tostring(py) .. ")")
	end

end
