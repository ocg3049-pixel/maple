@Component
script LuckySevenProjectileAttack extends AttackComponent

	-- 불의 영역/빙하지대 온히트 프록용 시전자 참조 - 발사 시점에 PlayerAttack이 넣어준다.
	property Entity OwnerEntity = ""

	method void OnAttack(Entity defender)
		-- 시전자(PlayerAttack)의 불의 영역/빙하지대 공용 프록 판정으로 위임한다 - 프록이 본체
		-- OnAttack에만 걸려 있어 이 스킬로는 지대가 생성되지 않던 버그 수정. 부모 OnAttack은
		-- ExecSpace 미지정이라 어노테이션 없이 오버라이드한다(LEA-3014 방지).
		if not self:IsServer() then return end
		if not isvalid(self.OwnerEntity) then return end
		---@type PlayerAttack
		local pa = self.OwnerEntity:GetComponent("script.PlayerAttack")
		if isvalid(pa) then
			pa:TryProcElementalZones(defender)
		end
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- 밀집 몬스터 구역에서 표창의 작은 히트박스가 겹쳐있는 다른 몬스터까지 함께 맞히는 것을 방지 -
		-- 발사 시 고정된 단일 표적(LuckySevenProjectile.GetTarget)만 통과시킨다.
		---@type LuckySevenProjectile
		local proj = self.Entity:GetComponent("script.LuckySevenProjectile")
		if proj ~= nil then
			local target = proj:GetTarget()
			if isvalid(target) and defender ~= target then
				return false
			end
		end
		if isvalid(defender.PlayerComponent) then
			return false
		end
		return __base:IsAttackTarget(defender, attackInfo)
	end

	method integer ApplyBackstabToDamage(integer dmg, Entity defender, string attackInfo)
		-- (백스탭) 시전자가 대상이 바라보는 방향의 뒤쪽에 있으면 추가 데미지를 얹은 값을 돌려준다.
		-- 판정과 배율(포인트 1당 +5%)은 시전자의 PlayerAttack 한 곳에서만 관리한다 - 투사체 스킬들이
		-- 같은 규칙을 공유하고, ON/OFF·투자 포인트도 그쪽에만 있다.
		if not isvalid(self.OwnerEntity) then return dmg end
		---@type PlayerAttack
		local pa = self.OwnerEntity:GetComponent("script.PlayerAttack")
		if not isvalid(pa) then return dmg end
		return pa:ApplyBackstabBonus(dmg, self.OwnerEntity, defender, attackInfo)
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 표창 1개당 전투력의 100%~150% 데미지(럭키세븐 기본 규격).
		-- 배율은 투사체의 DamageRateMin/Max에서 읽는다 - 아대 기본공격 표창은 발사 시점에
		-- 0.5/1.0(50%~100%)으로 낮춰 넣기 때문이다.
		-- (기능 변경) 쉐도우 파트너의 "타수 2배"는 이 진짜 히트 하나 안에서 원본+보너스(원본의 55~65%)를
		-- 합산해 적용하고, 표시는 OnHit이 원본/보너스를 서로 다른 위치의 2줄로 나눠 띄운다 - 그림자가
		-- 던지는 에코 표창은 시각 전용(무데미지)이다.
		---@type LuckySevenProjectile
		local proj = self.Entity:GetComponent("script.LuckySevenProjectile")
		local combatPower = 0
		local echoOn = false
		local critRate = 0.5
		local rateMin = 1.0
		local rateMax = 1.5
		if proj ~= nil then
			combatPower = proj.CombatPower
			echoOn = proj.ShadowEchoOn
			critRate = (proj.CritRate or 50) / 100
			rateMin = proj.DamageRateMin or 1.0
			rateMax = proj.DamageRateMax or 1.5
		end
		-- (요청) 단일 표적 스킬(럭키세븐/트리플/쿼드러플 스로우)은 **시전 시점에** 데미지를 확정한다.
		-- 시전 시점에 굴린 값이 있으면 여기서 다시 굴리지 않고 그대로 쓴다 - 그 값으로 "이번 공격에
		-- 대상이 죽는지"를 판정해 다음 공격의 대상 선정에서 제외했으므로(Monster.ReserveDamage),
		-- 실제 적용 데미지가 그 판정과 어긋나면 안 된다.
		if proj ~= nil and proj.PreRolled then
			self._T.lastDamage = proj.PreDamage
			self._T.lastBonus = proj.PreBonus
			self._T.lastDamageIsCritical = proj.PreDamageCritical
			self._T.lastBonusIsCritical = proj.PreBonusCritical
			return proj.PreDamage + proj.PreBonus
		end
		-- math.random() 대신 _UtilLogic:RandomDouble()을 쓴다 - 바로 아래 크리티컬 굴림이 같은 이유로
		-- 이미 그렇게 하고 있고, 아대 기본공격은 연타라 짧은 간격 반복 호출이 럭키세븐보다 잦다.
		local mult = rateMin + _UtilLogic:RandomDouble() * (rateMax - rateMin)
		local dmg = math.floor(combatPower * mult)
		-- (백스탭) 뒤통수에서 쏜 발이면 추가 데미지를 얹는다(크리티컬 배율보다 앞에서 적용).
		dmg = self:ApplyBackstabToDamage(dmg, defender, attackInfo)
		-- (버그 수정) "각자 크리티컬 여부를 캐릭터 정보창의 크리티컬 확률로 독립 판단해야 한다" - 표창
		-- 하나하나(1번째/2번째)가 이미 독립된 실제 Attack() 히트이므로, 이 히트에 대해서만 크리티컬을
		-- 굴리고 배율을 반환값에 바로 곱한다(아래 CalcCritical은 엔진의 이중 배율 적용을 막기 위해 계속 false 반환).
		-- math.random() 대신 _UtilLogic:RandomDouble()을 쓴다 - 표창 1번째/2번째가 짧은 간격으로 잇따라
		-- 호출되어(PlayerAttack.mlua에 문서화된 버그) math.random()이 같은 시퀀스를 반복 소비할 위험이 크다.
		local dmgIsCritical = _UtilLogic:RandomDouble() < critRate
		if dmgIsCritical then
			dmg = math.floor(dmg * 2.0)
		end
		local bonus = 0
		local bonusIsCritical = false
		if echoOn then
			bonus = math.floor(dmg * (0.55 + math.random() * 0.10))
			bonusIsCritical = _UtilLogic:RandomDouble() < critRate
			if bonusIsCritical then
				bonus = math.floor(bonus * 2.0)
			end
		end
		-- OnHit()이 실제 명중 직후 같은 프레임에서 데미지 스킨 표시에 재사용하기 위해 캐싱
		self._T.lastDamage = dmg
		self._T.lastBonus = bonus
		self._T.lastDamageIsCritical = dmgIsCritical
		self._T.lastBonusIsCritical = bonusIsCritical
		return dmg + bonus
	end

	-- CalcDamage가 자체적으로 크리티컬을 굴리고 배율을 이미 반환값에 곱했으므로, 엔진이 여기서 또 true를
	-- 반환하면 실제 적용 데미지가 표시값의 2배로 이중 적용된다. 항상 false를 반환해 이중 적용을 막는다.
	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		return false
	end

	method int32 GetDisplayHitCount(string attackInfo)
		-- 럭키세븐은 데미지 스킨을 LuckySevenProjectile에서 수동(_DamageSkinService:Play)으로 직접
		-- 띄우므로, 엔진의 자동 데미지 스킨 표시 개수를 0으로 만들어 이중으로 뜨는 걸 막는다.
		return 0
	end

end
