@Component
script RecoveryAuraVisual extends Component

	-- 리커버리 오로라(4차) 설치형 장판 비주얼. 서버가 SpearBurstFadingEffect.model(빈 스프라이트 엔티티)을
	-- 시전자 발밑에 스폰한 뒤 이 컴포넌트를 붙이면, 각 클라이언트가 패딩 정렬된 20프레임 아트를
	-- 프레임당 120ms(ori.txt 실측)로 계속 순환 재생한다. 전체 투명도 60%(요청 사양).
	-- 엔티티 수명(60초)은 서버 타이머(PlayerAttack.CastRecoveryAura)가 관리하므로 여기선 그리기만 한다.
	-- 프레임 아트는 크기가 제각각인 원본을 동일 캔버스(412x150)로 origin 정렬해 재업로드한 것이라
	-- 단일 위치에서 순환해도 흔들림이 없다(RUID 표: msw-dev-tools/resources/리커버리오로라/RUID.md).

	method void OnBeginPlay()
		-- 클라이언트에서만 그림을 다룬다(서버는 판정 좌표만 알면 되고 이 엔티티를 그리지 않는다).
		if not self:IsClient() then return end
		self._T.frames = {
			"37e2991ed2844a00b1b5060cda90f9c8", "dff2c72fbf0647b3b0b6c02c9c3c05af",
			"41bf5a1e707c488791c2e26f55a671f1", "63fff23d556c40a3a6d37ebb6802c1ea",
			"f5c4e5350eb04a1fbcff799b5dd5fbab", "4e16295d271d4fdeba2a04f7e07120de",
			"d4861b4c548a4275a63756bf53026b57", "2362c1684ea3458db2aaee6d0e621f97",
			"139fbbbd6dfb4e28a266c5acc7861083", "51cf28032ba44dc1a3019b4747d66e9d",
			"b69844a9d8d44a4491bbc766b463d415", "0c67dc83e10447309402d0d11d1f9f0a",
			"04bd1c39120842728bb9a4c629d9aae2", "e74dddbbfd92484a8a31a6110e72ccff",
			"2c4cc1cb7ce9433c8d9864bbf5fe3ae6", "9c032d93a40c4ffa859229983803c508",
			"f01b1676d8244ae0b9151a5c42dc9c21", "7436266d3b58401cac27a7d136b83c1f",
			"2dbb388d69934e5c8f516cfb019381e4", "bcc8e978c0e44256a8e9cddcb39d73bb",
		}
		self._T.frameIdx = 1
		local spr = self.Entity.SpriteRendererComponent
		if isvalid(spr) then
			-- 캐릭터/몬스터를 가리지 않게 바닥 장판처럼 뒤에 깐다 - 화상 저주 장판과 동일한 실측값
			-- (SortingLayer를 아바타와 같은 MapLayer0으로 맞추고 OrderInLayer를 아바타(4)보다 작게).
			spr.SortingLayer = "MapLayer0"
			spr.OrderInLayer = 3
			spr.Color = Color(1, 1, 1, 0.6)
			spr.SpriteRUID = self._T.frames[1]
		end
		self._T.timerId = _TimerService:SetTimerRepeat(function()
			self:AdvanceFrame()
		end, 0.12)
		log("[RecoveryAura] 오로라 비주얼 시작(20프레임 루프, 알파 0.6)")
	end

	@ExecSpace("ClientOnly")
	method void AdvanceFrame()
		-- 다음 프레임 스프라이트로 교체한다(20프레임 순환).
		if not isvalid(self.Entity) then return end
		local spr = self.Entity.SpriteRendererComponent
		if not isvalid(spr) then return end
		self._T.frameIdx = (self._T.frameIdx % 20) + 1
		spr.SpriteRUID = self._T.frames[self._T.frameIdx]
	end

	method void OnEndPlay()
		-- 엔티티 파괴(서버 60초 타이머) 시 프레임 타이머를 정리한다.
		if self._T.timerId then
			_TimerService:ClearTimer(self._T.timerId)
			self._T.timerId = nil
		end
	end

end
