@Component
script IfritSummon extends Component

	-- 이프리트(4차) 소환수. **엘퀴네스(ElquinesSummon)와 완전히 같은 개념**이다.
	--   1) 적에게 날아가지 않는다. 항상 주인 곁(뒤 위)에 머물면서 그 자리에서 불꽃을 내뿜어
	--      주변의 적을 최대 6마리까지 한 번에 때린다.
	--   2) 따라오는 방식이 등속 추종이 아니라 **임계감쇠 스프링(SmoothDamp)** 이다.
	--   3) **맵의 자식으로 스폰한다** - 플레이어 자식으로 두면 텔레포트 때 같이 순간이동한다.
	--      좌표 계산은 전부 월드 좌표(맵 루트가 원점이라 맵 로컬 == 월드).
	--
	-- **엘퀴네스와 다른 단 한 가지 - 리소스가 라이브러리 몹 팩이다**(사용자 지정: `mob/8610015.img`).
	-- 엘퀴네스는 사용자 제공 낱장 아트라 프레임 테이블 + 수동 프레임 교체가 필요했지만,
	-- 이프리트는 팩의 **animationclip을 SpriteRUID에 그대로 넣으면 엔진이 알아서 재생**한다
	-- (용 소환/SummonDragon과 같은 방식). 그래서 프레임 표도, 오프셋 표도 없다.
	--
	-- 팩 구성(mob/8610015.img "이프리트"): stand 6 / move 6 / attack1 19 / die1 12 프레임,
	-- 타격 이펙트 attack1/info/hit 8프레임, 사운드 _audio/Attack1 · _audio/Die.

	-- 맵 자식이라 클라가 부모로 주인을 알 수 없다 → 주인을 @Sync로 내려준다.
	@Sync property Entity OwnerEntity = nil
	property number Lifetime = 600               -- 서버 전용 수명(초). 10분.
	@Sync property string AtkState = ""          -- "" | "atk"
	@Sync property integer AtkSeq = 0            -- 공격 시작마다 +1(클립 재시작 트리거)
	@Sync property number FacingX = -1           -- 시트 원본이 왼쪽을 보므로 -1=왼쪽(원본), +1=오른쪽(Flip)
	@Sync property boolean Dying = false         -- 수명 종료 → die 클립 재생 중

	-- 공격 규격: attack1은 19프레임(엘퀴네스와 같은 장수)이라 타이밍도 같은 값을 쓴다.
	-- 불꽃이 터지는 시점 1.44초에 데미지, 모션 완주 2.25초.

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 서버: 수명 타이머 + 0.5초 간격 전투 판단 루프.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			self.Dying = true
			_TimerService:SetTimerOnce(function()
				if isvalid(self.Entity) then self.Entity:Destroy() end
			end, 1.4)
		end, self.Lifetime)
		-- 등장 연출(die1 역재생 1.44초)이 끝난 뒤부터 싸운다 - 등장과 공격 모션이 겹치지 않게.
		self._T.nextAtkAt = _UtilLogic.ElapsedSeconds + 1.5
		self._T.combatTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self.Entity) then return end
			self:CombatTick()
		end, 0.5)
		log("[Ifrit] 소환 - 수명 " .. tostring(self.Lifetime) .. "초")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self._T.combatTimerId ~= nil then
			_TimerService:ClearTimer(self._T.combatTimerId)
			self._T.combatTimerId = nil
		end
	end

	@ExecSpace("Server")
	method void ReportIfritPos(number x, number y)
		-- 소유 클라가 계산한 실제 이프리트 월드좌표(0.15초마다). 이동을 클라가 계산하므로
		-- 서버 Transform은 스폰 좌표 그대로다 → 적 탐색 기준점으로 쓰려면 클라가 알려줘야 한다.
		self._T.serverWorldPos = Vector2(x, y)
	end

	@ExecSpace("ServerOnly")
	method Vector2 GetSearchCenter()
		-- 적 탐색/타격 기준점 = 이프리트 자신. 클라 보고 전이면 주인 위치로 대체.
		local wp = self._T.serverWorldPos
		if wp ~= nil then return wp end
		if not isvalid(self.OwnerEntity) then
			local sp = self.Entity.TransformComponent.WorldPosition
			return Vector2(sp.x, sp.y)
		end
		local op = self.OwnerEntity.TransformComponent.WorldPosition
		return Vector2(op.x, op.y)
	end

	@ExecSpace("ServerOnly")
	method void CombatTick()
		-- 0.5초마다: 주변 반경 6.5 안에 적이 있으면 그 자리에서 공격 모션을 시작한다.
		if self.Dying then return end
		-- 맵 자식이라 주인이 사라져도 자동 정리가 안 된다 → 주인이 없으면 스스로 소멸.
		if not isvalid(self.OwnerEntity) then
			self._T.noOwnerTime = (self._T.noOwnerTime or 0) + 0.5
			if self._T.noOwnerTime > 2.0 then
				self.Dying = true
				_TimerService:SetTimerOnce(function()
					if isvalid(self.Entity) then self.Entity:Destroy() end
				end, 1.4)
			end
			return
		end
		self._T.noOwnerTime = 0
		if self.OwnerEntity.CurrentMap ~= self.Entity.CurrentMap then return end
		if self.AtkState ~= "" then return end
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.nextAtkAt or 0) > now then return end
		---@type PlayerAttack
		local pa = self.OwnerEntity:GetComponent("script.PlayerAttack")
		if not isvalid(pa) then return end
		local center = self:GetSearchCenter()
		local cands = pa:FindMonstersInRadius(center, 6.5, 6)
		if #cands == 0 then return end

		-- 바라보는 방향 = 잡힌 적들의 평균 x가 이프리트보다 오른쪽이면 오른쪽.
		local sumX = 0
		for _, m in ipairs(cands) do
			sumX = sumX + m.TransformComponent.WorldPosition.x
		end
		self.FacingX = ((sumX / #cands) >= center.x) and 1 or -1
		self.AtkSeq = self.AtkSeq + 1
		self.AtkState = "atk"
		self._T.nextAtkAt = now + 4.8
		self:PlayIfritAttackSound()

		-- 데미지는 불꽃이 터지는 시점(1.44초).
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			self:DoFlame()
		end, 1.44)
		-- 모션 완주(19프레임 ≈ 2.25초) 후 대기로.
		_TimerService:SetTimerOnce(function()
			if isvalid(self.Entity) and self.AtkState == "atk" then self.AtkState = "" end
		end, 2.25)
	end

	@ExecSpace("ServerOnly")
	method void DoFlame()
		-- 실제 타격. 예약 당시 목록이 아니라 **터지는 그 순간** 다시 훑어서 최대 6마리를 때린다.
		if not isvalid(self.OwnerEntity) then return end
		---@type PlayerAttack
		local pa = self.OwnerEntity:GetComponent("script.PlayerAttack")
		if not isvalid(pa) then return end
		local targets = pa:FindMonstersInRadius(self:GetSearchCenter(), 6.5, 6)
		if #targets == 0 then
			log("[Ifrit] 화염 - 타격 시점에 대상 없음")
			return
		end
		local hitCount = 0
		for _, t in ipairs(targets) do
			if isvalid(t) then
				pa:DealIfritHit(t)
				self:PlayIfritHitFx(t)
				hitCount = hitCount + 1
			end
		end
		log("[Ifrit] 화염 타격 " .. tostring(hitCount) .. "마리(최대 6)")
	end

	@ExecSpace("Multicast")
	method void PlayIfritHitFx(Entity target)
		-- 맞은 적 위에 팩의 attack1/info/hit(8프레임 불꽃) 재생. 클립이라 그대로 붙이면 자동 재생된다
		-- (엘퀴네스는 낱장이라 프레임을 갈아끼워야 했던 것과 다른 점).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("05959535067a4e65a7c8db8ff235670d", target, Vector3(0, 0.3, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 7 })
		_TimerService:SetTimerOnce(function() _EffectService:RemoveEffect(serial) end, 1.2)
	end

	@ExecSpace("Multicast")
	method void PlayIfritAttackSound()
		-- 공격음(팩 _audio/Attack1). 6마리를 동시에 때려도 공격 시작 시 한 번만 난다.
		if not self:IsClient() then return end
		_SoundService:PlaySound("d769daa17e6c4e9eb78a57e5a02f80a9", 1.0)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 클라: 위치(임계감쇠 추종) + 클립 선택 + 좌우 방향 + 페이드.
		local tr = self.Entity.TransformComponent
		if not isvalid(tr) then return end
		local sr = self.Entity.SpriteRendererComponent
		if not isvalid(sr) then return end

		local owner = self.OwnerEntity
		if not isvalid(owner) or not isvalid(owner.TransformComponent) then return end
		local pw = owner.TransformComponent.WorldPosition

		local look = 1
		local ctrl = owner.PlayerControllerComponent
		if isvalid(ctrl) then look = (ctrl.LookDirectionX >= 0) and 1 or -1 end

		-- 정위치(홈) = 주인 뒤쪽 1.1 / 위 0.75 + 완만한 부양(바하뮤트/엘퀴네스와 같은 값).
		self._T.bobT = (self._T.bobT or 0) + delta
		local homeX = pw.x - look * 1.1
		local homeY = pw.y + 0.75 + math.sin(self._T.bobT * 1.2) * 0.13

		if self._T.posX == nil then
			self._T.posX = homeX
			self._T.posY = homeY
			self._T.velX = 0
			self._T.velY = 0
		end

		-- ── 자연스러운 추종(임계감쇠 SmoothDamp) ────────────────────────────────
		local smoothTime = 0.55
		local maxSpeed = 9.0
		local omega = 2.0 / smoothTime
		local xTerm = omega * delta
		local expTerm = 1.0 / (1.0 + xTerm + 0.48 * xTerm * xTerm + 0.235 * xTerm * xTerm * xTerm)
		local maxChange = maxSpeed * smoothTime

		local changeX = self._T.posX - homeX
		if changeX > maxChange then changeX = maxChange end
		if changeX < -maxChange then changeX = -maxChange end
		local baseX = self._T.posX - changeX
		local tempX = (self._T.velX + omega * changeX) * delta
		self._T.velX = (self._T.velX - omega * tempX) * expTerm
		local nx = baseX + (changeX + tempX) * expTerm

		local changeY = self._T.posY - homeY
		if changeY > maxChange then changeY = maxChange end
		if changeY < -maxChange then changeY = -maxChange end
		local baseY = self._T.posY - changeY
		local tempY = (self._T.velY + omega * changeY) * delta
		self._T.velY = (self._T.velY - omega * tempY) * expTerm
		local ny = baseY + (changeY + tempY) * expTerm

		-- 맵 이동/텔레포트처럼 좌표가 통째로 튄 경우에만 즉시 복귀(추종이 아니라 재배치).
		local gapX = homeX - nx
		local gapY = homeY - ny
		if (gapX * gapX + gapY * gapY) > 625 then
			nx = homeX
			ny = homeY
			self._T.velX = 0
			self._T.velY = 0
		end

		local moveDist = math.sqrt((nx - self._T.posX) ^ 2 + (ny - self._T.posY) ^ 2)
		local speed = (delta > 0) and (moveDist / delta) or 0
		self._T.posX = nx
		self._T.posY = ny

		-- 소유 클라만 실제 월드좌표를 서버에 보고한다(서버의 적 탐색 기준점).
		if _UserService.LocalPlayer == owner then
			self._T.reportTimer = (self._T.reportTimer or 0) + delta
			if self._T.reportTimer >= 0.15 then
				self._T.reportTimer = 0
				self:ReportIfritPos(nx, ny)
			end
		end

		-- ── 클립 선택 ───────────────────────────────────────────────────────────
		-- 라이브러리 animationclip이라 SpriteRUID에 넣기만 하면 엔진이 재생한다.
		-- 이동/제자리 전환은 히스테리시스로(부양 흔들림에 클립이 매 프레임 재시작되는 것 방지).
		if self._T.movingAnim then
			if speed < 0.35 then self._T.movingAnim = false end
		else
			if speed > 0.9 then self._T.movingAnim = true end
		end

		-- (요청) **등장 = die1 클립의 역재생**. 팩에 등장 전용 클립이 없어서, 소멸 모션을 거꾸로 돌려
		-- "흩어진 것이 다시 모여 형태를 갖추는" 연출로 쓴다.
		-- ⚠ MSW는 클립 역방향 재생을 지원하지 않는다(PlayRate 음수도 보장되지 않음). 대신
		-- StartFrameIndex == EndFrameIndex로 **클립을 특정 프레임에 고정**할 수 있으므로,
		-- 마지막 프레임(11)부터 0까지 120ms 간격으로 내려가며 고정해 역재생을 만든다.
		if self._T.spawnClock == nil then self._T.spawnClock = _UtilLogic.ElapsedSeconds end
		local sinceSpawn = _UtilLogic.ElapsedSeconds - self._T.spawnClock
		local DIE_FRAMES = 12
		local REVERSE_STEP = 0.12                                  -- 12프레임 × 120ms = 1.44초
		local reverseSpawning = (not self.Dying) and (sinceSpawn < DIE_FRAMES * REVERSE_STEP)

		local want = "23b5af3095bd4be6af97422e7bf98df4"        -- stand
		if self.Dying then
			want = "6d33d5e5eed64028beab08a5118acbe3"           -- die1
		elseif reverseSpawning then
			want = "6d33d5e5eed64028beab08a5118acbe3"           -- die1(역재생 - 등장 연출)
		elseif self.AtkState == "atk" then
			want = "12eb937249b94fa1a4a2b28039b42f9e"           -- attack1
		elseif self._T.movingAnim then
			want = "c60a03ce4cfd46c2a0a964b8258f2864"           -- move
		end
		if sr.SpriteRUID ~= want then sr.SpriteRUID = want end

		-- 프레임 고정: 등장 중에는 뒤에서 앞으로, 그 외에는 전체 구간을 정상 재생한다.
		if reverseSpawning then
			local idx = DIE_FRAMES - 1 - math.floor(sinceSpawn / REVERSE_STEP)
			if idx < 0 then idx = 0 end
			if idx > DIE_FRAMES - 1 then idx = DIE_FRAMES - 1 end
			if sr.StartFrameIndex ~= idx then sr.StartFrameIndex = idx end
			if sr.EndFrameIndex ~= idx then sr.EndFrameIndex = idx end
		else
			-- 등장이 끝나면 반드시 전체 구간으로 되돌린다(안 하면 이후 클립이 한 프레임에 멈춘다).
			if sr.StartFrameIndex ~= 0 then sr.StartFrameIndex = 0 end
			if sr.EndFrameIndex ~= 2147483647 then sr.EndFrameIndex = 2147483647 end
		end

		-- ── 방향 ───────────────────────────────────────────────────────────────
		local face = look
		if self.AtkState == "atk" then
			face = self.FacingX
		elseif speed > 0.6 then
			local moved = nx - (self._T.prevX or nx)
			if math.abs(moved) > 0.0008 then
				self._T.faceMove = (moved > 0) and 1 or -1
			end
			face = self._T.faceMove or look
		end
		self._T.prevX = nx
		sr.FlipX = (face > 0)   -- 시트 원본이 왼쪽을 봄 → 오른쪽 볼 때만 Flip

		-- ── 적용 ───────────────────────────────────────────────────────────────
		-- 클립 피벗이 중앙이다(약 150x160px = 배율 0.85에서 약 1.36유닛).
		-- ⚠ 처음 +0.5를 줬더니 실측 dy가 1.18까지 올라가 주인 머리 위로 한참 떠버렸다(스크린샷 확인).
		-- 오프셋을 0으로 두면 스프라이트 중앙이 홈(주인 발끝 +0.75)에 오고 몸통 아래가 발끝 근처가 되어
		-- 주인 곁을 지키는 소환수답게 보인다(바하뮤트가 홈 높이를 1.6→0.75로 낮춘 것과 같은 이유).
		local scale = 0.85
		local FRAME_OFF_Y = 0.0
		tr.Position = Vector3(nx, ny + FRAME_OFF_Y * scale, 0)
		tr.Scale = Vector3(scale, scale, 1)
		if sr.SortingLayer ~= "MapLayer0" then sr.SortingLayer = "MapLayer0" end
		if sr.OrderInLayer ~= 3 then sr.OrderInLayer = 3 end

		-- 등장 페이드인 0.3초(팩에 등장 전용 클립이 없다). 소멸 중에는 die 클립과 함께 흐려진다.
		if self._T.fadeStart == nil then self._T.fadeStart = _UtilLogic.ElapsedSeconds end
		local alpha = math.min(1.0, math.max(0.0, (_UtilLogic.ElapsedSeconds - self._T.fadeStart) / 0.3))
		if self.Dying then
			if self._T.dieT == nil then self._T.dieT = 0 end
			self._T.dieT = self._T.dieT + delta
			if self._T.dieT > 0.9 then alpha = math.max(0.0, 1.0 - (self._T.dieT - 0.9) / 0.5) end
		end
		sr.Color = Color(1, 1, 1, alpha)
	end

end
