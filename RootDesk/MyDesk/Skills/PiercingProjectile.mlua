@Component
script PiercingProjectile extends Component

	-- 피어싱(신궁 4차) 차지 화살. 스나이핑과 **완전히 같은 원리**(키를 누르는 동안 기를 모았다가
	-- 떼면 관통 화살 한 발)이고, 다른 점은 셋뿐이다:
	--   ① 기를 모으는 속도가 스나이핑의 **10배**(완충 1초 - 스나이핑은 10초)
	--   ② 데미지가 약한 대신 **위아래 판정 범위가 넓다**(원형 0.35 → 세로로 긴 박스 0.7×1.6)
	--   ③ 관통 인원이 **10명**(스나이핑은 3명)
	-- 아트는 원본 팩 skill/322.img/skill/3221017(피어싱)의 ball 클립을 쓴다.
	-- 원본 ball 클립은 머리가 -x(왼쪽) 기준이라 다른 화살 스킬처럼 +180도 보정한다.

	property number Speed = 12

	property number MaxLifetime = 1.2

	property number CombatPower = 0

	-- 차지 비율(0.0~1.0). 기 배율(완충 5배)을 결정한다.
	property number ChargeRatio = 0

	-- 투자 레벨별 **기본** 데미지 배율. 1레벨 0.30~0.50 → 마스터 30에서 3.20~3.40.
	-- 공식은 클라 SkillManager의 GetPiercing*Percent 한 곳에서 나온다(PlayerAttack이 발사 시점에 새겨준다).
	-- ⚠ 여기에 기 배율(ChargeRatio × 5, 하한 1배)이 **곱해진다** - 완충 시 5배.
	property number RateMin = 0.30
	property number RateMax = 0.50

	-- 캐릭터 정보창의 실제 크리티컬 확률(%) - PlayerAttack이 발사 시점에 채워준다(스나이핑과 동일한 이유).
	property number CritRate = 50

	-- 발사한 플레이어의 "현재" 데미지 스킨 RUID. 비어 있으면 공용 기본 히트 스킨으로 폴백한다.
	property string DamageSkinRUID = ""

	-- 관통 최대 타격 인원(요청: 10명).
	property integer MaxTargets = 10

	-- 판정 박스 크기(월드 유닛). 스나이핑의 원형 반경 0.35(= 0.7×0.7) 대비 **세로로 넓다**.
	property number HitBoxWidth = 0.7
	property number HitBoxHeight = 1.6

	@Sync
	property boolean Fired = false

	method void OnBeginPlay()
		-- 발사 상태 초기화(서버 전용 필드). 관통 화살이라 명중해도 사라지지 않고 hitList로 중복만 막는다.
		if self:IsServer() then
			self._T.lifetime = 0
			self._T.dirX = 1
			self._T.dirY = 0
			self._T.hitCount = 0
			self._T.hitList = {}
		end
	end

	@ExecSpace("ServerOnly")
	method void Fire(number dirX, number dirY)
		-- 정규화된 방향으로 발사 시작(+180도 보정 - 원본 화살 머리가 -x 기준).
		self._T.dirX = dirX
		self._T.dirY = dirY
		self.Entity.TransformComponent.ZRotation = math.deg(math.atan(dirY, dirX)) + 180
		self.Fired = true
	end

	@ExecSpace("ServerOnly")
	method boolean HasHitTarget(string targetName)
		-- 이미 맞힌 대상인지(관통 중복 타격 방지). PiercingProjectileAttack.IsAttackTarget이 호출한다.
		return self._T.hitList ~= nil and self._T.hitList[targetName] == true
	end

	@ExecSpace("ServerOnly")
	method boolean IsFull()
		-- 최대 타격 인원(10명)을 다 채웠는지.
		return (self._T.hitCount or 0) >= self.MaxTargets
	end

	@ExecSpace("ServerOnly")
	method void RegisterHit(string targetName)
		-- 명중 기록(PiercingProjectileAttack.CalcDamage가 호출). 10명을 채우면 다음 프레임에 사라진다.
		if self._T.hitList == nil then self._T.hitList = {} end
		self._T.hitList[targetName] = true
		self._T.hitCount = (self._T.hitCount or 0) + 1
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if not self.Fired then return end

		-- 10명을 다 맞혔으면 사라진다(판정과 같은 프레임 파괴를 피해 다음 프레임에 파괴 - 다른 화살과 동일).
		if self:IsFull() then
			_EntityService:Destroy(self.Entity)
			return
		end

		self._T.lifetime = self._T.lifetime + delta
		if self._T.lifetime >= self.MaxLifetime then
			_EntityService:Destroy(self.Entity)
			return
		end

		self.Entity.TransformComponent:Translate(self._T.dirX * self.Speed * delta, self._T.dirY * self.Speed * delta)

		-- 매 프레임 화살 위치에서 판정을 낸다. 스나이핑은 원형(반경 0.35)이지만 피어싱은 **세로로 긴 박스**라
		-- 위아래로 벌어져 선 적까지 한 발에 훑는다(요청: "위아래 공격범위가 좀더 넓으며").
		---@type PiercingProjectileAttack
		local ac = self.Entity:GetComponent("script.PiercingProjectileAttack")
		if ac ~= nil then
			local pos = self.Entity.TransformComponent.Position
			ac:AttackFast(BoxShape(Vector2(pos.x, pos.y), Vector2(self.HitBoxWidth, self.HitBoxHeight), 0),
				"skill.piercing", CollisionGroups.HitBox)
		end
	end

end
