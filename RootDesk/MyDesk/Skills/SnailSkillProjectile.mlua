@Component
script SnailSkillProjectile extends Component

    property number Speed = 6
    property number MaxRange = 4
    property string HitEffectRUID = "bb996be9b40e45559d12981c6be603b0"
    property number YTolerance = 1.0

    -- Default 0 so Fire(1) or Fire(-1) always triggers OnSyncProperty
    @Sync property number SyncDirX = 0

    method void OnBeginPlay()
        if self:IsServer() then
            self._T.moved = 0
            self._T.hit = false
            self._T.targetEntity = nil
            self._T.ownerEntity = nil
            self._T.hitTargetPos = nil
        end
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        if name == "SyncDirX" then
            local opts = {}
            if self.SyncDirX < 0 then opts["FlipX"] = true end
            self._T.effectSerial = _EffectService:PlayEffectAttached(
                "656a620d18744c9bbcb7b4073ba5eb7b", self.Entity,
                Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true, opts
            )
        end
    end

    @ExecSpace("ServerOnly")
    method void Fire(number dirX, Entity ownerEntity)
        self._T.moved = 0
        self._T.hit = false
        self._T.ownerEntity = ownerEntity
        self.SyncDirX = dirX
        self:FindNearestTarget(dirX)
    end

    method Vector3 GetTargetCenter(Entity target)
        -- 발밑 원점 대신 몬스터 이미지에 맞춰진 피격 박스의 중심을 추적한다.
        local hit = target.HitComponent
        local offset = hit.IsLegacy and hit.BoxOffset or hit.ColliderOffset
        return target.TransformComponent:ToWorldPoint(Vector3(offset.x, offset.y, 0))
    end

    @ExecSpace("ServerOnly")
    method void FindNearestTarget(number dirX)
        -- 지형/NPC/아군은 타깃으로 잡지 않는다. 중첩된 몬스터 엔티티도 검색한다.
        local myPos = self.Entity.TransformComponent.WorldPosition
        local currentMap = self.Entity.CurrentMap
        if not isvalid(currentMap) then return end
        local nearest = nil
        local nearestDist = self.MaxRange
        for _, monster in ipairs(currentMap:GetChildComponentsByTypeName("script.Monster", true)) do
            local target = monster.Entity
            if isvalid(target) and target.Enable and not monster.IsDead and monster.Hp > 0 and isvalid(target.HitComponent) and target.HitComponent.Enable then
                local tPos = self:GetTargetCenter(target)
                local dx, dy = tPos.x - myPos.x, tPos.y - myPos.y
                local dist = math.sqrt(dx * dx + dy * dy)
                if dx * dirX >= 0 and dist < nearestDist and math.abs(dy) <= self.YTolerance then
                    nearestDist = dist
                    nearest = target
                end
            end
        end
        self._T.targetEntity = nearest
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- 물리 바디 없는 투사체: 지형은 통과하고 이동 경로의 몬스터만 판정한다.
        if self._T.hit or self.SyncDirX == 0 then return end
        if not isvalid(self._T.ownerEntity) or self._T.ownerEntity.CurrentMap ~= self.Entity.CurrentMap then
            _EntityService:Destroy(self.Entity)
            return
        end
        local remaining = math.min(self.Speed * delta, self.MaxRange - self._T.moved)
        while remaining > 0 do
            local pos = self.Entity.TransformComponent.WorldPosition
            local moveX, moveY = self.SyncDirX, 0
            local distance = math.min(0.12, remaining)
            local target = self._T.targetEntity
            if isvalid(target) and target.CurrentMap == self.Entity.CurrentMap and isvalid(target.Monster) and not target.Monster.IsDead and isvalid(target.HitComponent) then
                local tPos = self:GetTargetCenter(target)
                local dx, dy = tPos.x - pos.x, tPos.y - pos.y
                local d = math.sqrt(dx * dx + dy * dy)
                if d > 0.001 then moveX, moveY = dx / d, dy / d end
                distance = math.min(distance, math.max(0.001, d))
            end
            self.Entity.TransformComponent:Translate(moveX * distance, moveY * distance)
            self._T.moved = self._T.moved + distance
            remaining = remaining - distance
            local ac = self.Entity.SnailSkillProjectileAttack
            if isvalid(ac) then
                local position = self.Entity.TransformComponent.WorldPosition
                local hits = ac:AttackFrom(Vector2(0.20, 0.20), position:ToVector2(), "snailSkill", CollisionGroups.HitBox)
                for _, defender in ipairs(ac._T.restoreSkins or {}) do
                    if isvalid(defender) and not isvalid(defender:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then
                        defender:AddComponent("MOD.Core.DamageSkinSpawnerComponent")
                    end
                end
                ac._T.restoreSkins = nil
                if hits ~= nil and #hits > 0 then
                    self._T.hit = true
                    self._T.hitTargetPos = position
                    log("[SnailSkill] hit=" .. hits[1].Entity.Name)
                    self:OnHit()
                    return
                end
            end
        end
        if self._T.moved >= self.MaxRange then _EntityService:Destroy(self.Entity) end
    end

    @ExecSpace("ServerOnly")
    method void OnHit()
        local p = self._T.hitTargetPos
        if p == nil then
            p = self.Entity.TransformComponent.Position
        end
        self:ShowHitEffect(p.x, p.y, p.z)
        _EntityService:Destroy(self.Entity)
    end

    @ExecSpace("Client")
    method void ShowHitEffect(number px, number py, number pz)
        local mapEnt = self.Entity.CurrentMap
        if not isvalid(mapEnt) then return end
        _EffectService:PlayEffect(
            self.HitEffectRUID, mapEnt,
            Vector3(px, py, pz), 0, Vector3(1, 1, 1), false
        )
        _GameAudio:PlaySound("04edcf3c77b049bc9bfa1fa0f541b063", 1.0)
    end

end
