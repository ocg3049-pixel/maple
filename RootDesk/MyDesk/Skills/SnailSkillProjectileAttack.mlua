@Component
script SnailSkillProjectileAttack extends AttackComponent

    -- 불의 영역/빙하지대 온히트 프록용 시전자 참조 - 발사 시점에 SkillManager가 넣어준다.
    property Entity OwnerEntity = ""
    property string DamageSkinRUID = "3271c3e79bf04ecba9a107d55495970d"

    method void OnAttack(Entity defender)
        -- 시전자(PlayerAttack)의 불의 영역/빙하지대 공용 프록 판정으로 위임한다 - 프록이 본체
        -- OnAttack에만 걸려 있어 이 스킬로는 지대가 생성되지 않던 버그 수정. 부모 OnAttack은
        -- ExecSpace 미지정이라 어노테이션 없이 오버라이드한다(LEA-3014 방지).
        if not self:IsServer() then return end
        self._T.struck = true
        if not isvalid(self.OwnerEntity) then return end
        ---@type PlayerAttack
        local pa = self.OwnerEntity:GetComponent("script.PlayerAttack")
        if isvalid(pa) then
            pa:TryProcElementalZones(defender)
        end
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 적 몬스터 한 마리만 맞힌다. 지형 HitComponent는 투사체를 막지 않는다.
        if self._T.struck or not isvalid(defender) or not defender.Enable then return false end
        local monster = defender:GetComponent("script.Monster")
        if not isvalid(monster) or monster.IsDead or monster.Hp <= 0 then return false end
        return __base:IsAttackTarget(defender, attackInfo)
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- 초보자 공격도 시전자의 레벨 차이 감소를 적용한다.
        -- 자동 HitEvent 숫자를 차단하고 아래 공통 스킨만 한 번 표시한다.
        local spawner = defender:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
        if isvalid(spawner) then
            self._T.restoreSkins = self._T.restoreSkins or {}
            table.insert(self._T.restoreSkins, defender)
            defender:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent")
        end
        local damage = _RegionTierLogic:ApplyMonsterLevelDamage(40, self.OwnerEntity, defender)
        local pa = isvalid(self.OwnerEntity) and self.OwnerEntity:GetComponent("script.PlayerAttack") or nil
        if isvalid(pa) and pa:GetServerCombatPower() <= 1 then damage = pa:RollBeginnerDamage() end
        _SkillManager:ShowSnailDamage(defender, damage, self.DamageSkinRUID)
        return damage
    end

    method int32 GetDisplayHitCount(string attackInfo)
        return 0
    end

end
