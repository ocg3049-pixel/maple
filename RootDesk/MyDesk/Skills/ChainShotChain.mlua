@Component
script ChainShotChain extends Component

	-- 체인샷(2차)의 체인 줄. 플레이어에 자식으로 붙은 채로, 매 프레임 "플레이어 가슴 → 고정점"을
	-- 잇도록 위치/각도(ZRotation)/가로 길이(Scale.x)를 스스로 계산한다.
	-- 서버가 트랜스폼을 직접 @Sync로 밀면 보간이 걸려 줄이 떨리기 때문에(SpearBurstFadingEffect
	-- 주석과 같은 이유), 서버는 고정점 좌표만 넘기고 실제 계산은 각 클라이언트가 한다.
	-- 원본 아트는 가로로 누운 체인이고 피벗이 왼쪽 끝(5/476)이며, 작살 머리가 피벗 끝에서
	-- -x를 향해 그려져 있다. 그래서 이 엔티티(피벗)를 "체인 끝(작살 머리)"에 두고 아트가
	-- 가슴 쪽으로 뻗도록 회전시킨다 - 머리가 항상 진행 방향 끝에서 바깥을 향하고, 뻗어나가는
	-- 동안에도 머리가 앞장선다. (FlipX는 피벗 축 기준 쿼드 미러링이라 쓰면 반대쪽으로 뻗는다)

	-- 체인 원본 아트의 가로 길이(월드 유닛). 476px / 100 = 4.76.
	@Sync property number ArtLength = 4.76
	-- 줄이 이어질 목표 지점(월드 좌표). 서버가 발사 직후 채워준다.
	@Sync property Vector2 AnchorPos = Vector2(0, 0)
	-- 지형에 실제로 박혔는지. false면 최대 사거리까지 뻗기만 하고 사라지는 빗나간 체인이다.
	@Sync property boolean Anchored = false
	-- 줄이 0에서 목표 길이까지 뻗어나가는 데 걸리는 시간(초).
	@Sync property number GrowDuration = 0.12
	-- (소환수 지원 2026-08-08) 부모가 아닌 다른 엔티티에서 줄이 시작되게 하는 선택 프로퍼티.
	-- 소환 용사(HeroSummon)는 루트 Scale.x 부호로 방향을 표현해 자식으로 붙이면 줄이 미러링된다 -
	-- 맵 자식으로 스폰하고 이 값에 소환수를 넣으면 월드 좌표로 직접 계산한다(플레이어는 기존대로 nil).
	@Sync property Entity SourceEntity = nil

	method void OnBeginPlay()
		-- 뻗어나가는 연출용 경과 시간. 클라이언트에서만 쓴다.
		if self:IsClient() then
			self._T.elapsed = 0
			self._T.frozen = false
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 매 프레임 플레이어 가슴에서 고정점까지를 잇는다. 플레이어가 움직이면 각도와
		-- 길이가 따라 변하므로 "캐릭터와 벽이 계속 이어져 있는" 모양이 유지된다(요청).
		-- (경쟁 상태 방어) 서버가 보낸 AnchorPos가 아직 도착하지 않았으면 원점을 향한 엉뚱한 줄이
		-- 한 프레임 보일 수 있어, 값이 채워질 때까지 그리지 않는다.
		if self.AnchorPos.x == 0 and self.AnchorPos.y == 0 then return end
		local tr = self.Entity.TransformComponent
		if not isvalid(tr) then return end
		local parent = self.Entity.Parent
		if not isvalid(parent) then return end

		-- 가슴 높이는 PlayerAttack.AttackChainShot의 CHAIN_ORIGIN_Y(0.35)와 동일해야 한다
		local src = parent
		local worldMode = false
		if isvalid(self.SourceEntity) then
			src = self.SourceEntity
			worldMode = true
		end
		local pw = src.TransformComponent.WorldPosition
		local chestX = pw.x
		local chestY = pw.y + 0.35
		local dx = self.AnchorPos.x - chestX
		local dy = self.AnchorPos.y - chestY
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < 0.001 then return end

		self._T.elapsed = (self._T.elapsed or 0) + delta
		local grow = 1.0
		if self.GrowDuration > 0 and self._T.elapsed < self.GrowDuration then
			grow = self._T.elapsed / self.GrowDuration
		end

		-- 엔티티(피벗=작살 머리)를 체인 끝에 두고, 아트는 반대(가슴) 방향으로 뻗게 회전시킨다.
		-- 부모(플레이어 루트)는 회전/스케일이 없으므로 로컬 좌표 = 플레이어 기준 오프셋.
		local reach = dist * grow
		local nx = dx / dist
		local ny = dy / dist
		if worldMode then
			-- SourceEntity 모드: 부모가 맵(무회전·무스케일 - 로컬=월드)이라 피벗을 월드 좌표로 직접 둔다.
			tr.Position = Vector3(chestX + nx * reach, chestY + ny * reach, tr.Position.z)
		else
			tr.Position = Vector3(nx * reach, 0.35 + ny * reach, tr.Position.z)
		end
		tr.ZRotation = math.deg(math.atan(-dy, -dx))
		local sx = reach / math.max(self.ArtLength, 0.001)
		tr.Scale = Vector3(sx, 1, 1)

		-- (요청) 지형에 부딪히면 이펙트가 멈춘다 - 다 뻗은 시점에 클립 재생을 정지시켜 박힌 상태로 굳힌다.
		if self.Anchored and not self._T.frozen and self._T.elapsed >= self.GrowDuration then
			self._T.frozen = true
			local spr = self.Entity.SpriteRendererComponent
			if isvalid(spr) then spr.PlayRate = 0 end
		end
	end

end
