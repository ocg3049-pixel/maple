		-- 분신 소환(섀도어 1차) 시전 MP. ⚠ 분신이 살아 있을 때의 **위치 교환**은 소환이 아니므로 무료다.
		return 200
	end

	@ExecSpace("ClientOnly")
	method integer GetHasteMpCost()
		-- 헤이스트(나이트로드 2차 버프) 시전 MP.
		return 30
	end

	@ExecSpace("ClientOnly")
	method integer GetSavageBlowMpCost()
		-- 새비지블로우(섀도어 2차) 시전 MP.
		return 20
	end

	@ExecSpace("ClientOnly")
	method integer GetAmhaengMpCost()
		-- 암행(나이트로드 2차) / 암행2(섀도어 3차) 시전 MP. 두 스킬의 요청 사양이 같아 헬퍼도 하나만 둔다
		-- (지속시간·발동 확률·데미지도 이미 암행1 헬퍼를 공유한다).
		return 30
	end

	@ExecSpace("ClientOnly")
	method integer GetFlashJumpMpCost()
		-- 플래시 점프(3차) 발동 MP. 공중에서 도약할 때마다 든다(더블 점프와 같은 관례).
		return 20
	end

	@ExecSpace("ClientOnly")
	method integer GetShadowPartnerMpCost()
		-- 쉐도우 파트너(나이트로드 3차 버프) 시전 MP.
		return 100
	end

	@ExecSpace("ClientOnly")
	method integer GetAssaulterMpCost()
		-- 어썰터(섀도어 3차) 시전 MP. ⚠ 스택과 달리 MP는 **시전 요청 시점**에 빠진다 - 사거리 내 대상이
		--   없어 서버가 스택을 돌려주는 경우에도 MP는 돌아오지 않는다(다른 스킬과 같은 규칙).
		return 30
	end

	@ExecSpace("ClientOnly")
	method integer GetAssassinateMpCost()
		-- 암살(섀도어 4차) 시전 MP. (요청) **체인 라이트닝과 같다** - 데미지를 위임받는 것과 같은 이유로
		-- 값을 복사하지 않고 체인 라이트닝 헬퍼를 그대로 호출한다(현재 50).
		return self:GetChainLightningMpCost()
	end

	@ExecSpace("ClientOnly")
	method integer GetSmokeScreenMpCost()
		-- 연막(섀도어 4차) 시전 MP.
		return 100
	end

	-- ── 나이트로드 표창 계열 시전 MP (요청 2026-08-14 5차) ─────────────────
	-- ⚠ 새 비용을 만들면 **GetSkillMpCost에도 반드시 등록**할 것(자동사냥 사전 판정용).
	@ExecSpace("ClientOnly")
	method integer GetLuckySevenMpCost()
		-- 럭키세븐(1차) 시전 MP. (요청) **더블샷과 같다** - 데미지 규격을 위임받는 것과 같은 이유로
		-- 값을 복사하지 않고 더블샷 헬퍼를 그대로 호출한다(현재 10).
		return self:GetDoubleShotMpCost()
	end

	@ExecSpace("ClientOnly")
	method integer GetDrainShotMpCost()
		-- 드레인 샷(2차) 시전 MP.
		return 50
	end

	@ExecSpace("ClientOnly")
	method integer GetAvengerMpCost()
		-- 어벤져(3차) 시전 MP.
		return 30
	end

	@ExecSpace("ClientOnly")
	method integer GetTripleThrowMpCost()
		-- 트리플 스로우(3차) 시전 MP.
		return 20
	end

	@ExecSpace("ClientOnly")
	method integer GetQuadThrowMpCost()
		-- 쿼드러플 스로우(4차) 시전 MP.
		return 30
	end

	@ExecSpace("ClientOnly")
	method integer GetAwakeningMpCost()
		-- 각성(4차) 시전 MP.
		return 100
	end

	-- ── 서먼 다크드래곤 (요청 2026-08-12 3차) ─────────────────────────────
	-- 지속 10초 + 분배당 5초(마스터 20 = 105초). 종전 200초 + 분배당 20초(마스터 600초 고정).
	-- 데미지 전투력의 90~100%에서 분배 1포인트당 최소·최대 각 +3%p(마스터 20 = 147~157%).
	-- ⚠ 배율 계산은 클라가 하고 시전 RPC로 넘긴다 - 서버는 스킬 투자 상태를 직접 읽을 수 없다
	--   (파워스트라이크/차지 블로우와 같은 관례).
	@ExecSpace("ClientOnly")
	method number GetDarkDragonDurationForLevel(integer lv)
		-- 다크드래곤 지속시간(초).
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 10 + 5 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method number GetDarkDragonMinPercent(integer lv)
		-- 다크드래곤 공격 데미지 하한(%). 1레벨 93 → 마스터 20에서 150(분배당 +3%p).
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 93 + 3 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method number GetDarkDragonMaxPercent(integer lv)
		-- 다크드래곤 공격 데미지 상한(%). 1레벨 103 → 마스터 20에서 160(분배당 +3%p).
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 103 + 3 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method integer GetChargeBlowMpCost()
		-- 차지 블로우 시전 MP.
		return 20
	end

	-- ── 차지 블로우 데미지 배율 (요청 2026-08-12 2차) ──────────────────────
	-- 1레벨 180~240% → 분배 1포인트당 최소·최대 각 +4%p (마스터 20 = 256~316%).
	-- 종전엔 파워스트라이크 곡선(GetPowerStrikeMin/MaxPercent)을 그대로 빌려 썼다.
	-- ⚠ 레벨 성장이 이 배율에 직접 들어가므로 시전부에서 pendingSkillPowerMult = 1.0 유지 필수
	--   (공용 위력 배율과 이중 적용 방지 - 파워스트라이크 관례).
	@ExecSpace("ClientOnly")
	method number GetChargeBlowMinPercent(integer lv)
		-- 차지 블로우 데미지 하한(%).
		-- (요청 2026-08-16) 분배당 증가분 4%p → **3%p**(마스터 20 = 237%).
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 180 + 3 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method number GetChargeBlowMaxPercent(integer lv)
		-- 차지 블로우 데미지 상한(%).
		-- (요청 2026-08-16) 분배당 증가분 4%p → **3%p**(마스터 20 = 297%).
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 240 + 3 * (lv - 1)
	end

	-- ── 궁병 지원 화살당 데미지 배율 (요청 2026-08-12 2차) ─────────────────
	-- 1레벨 90~120% → 분배 1포인트당 최소·최대 각 +4%p (마스터 20 = 166~196%).
	-- ⚠ 실제 계산은 **서버**(PlayerAttack의 skill.archersupport 분기)가 시전 시 넘겨받은 레벨로
	--   똑같은 공식을 돌린다 - 두 곳을 함께 고쳐야 표시와 실제가 어긋나지 않는다.
	@ExecSpace("ClientOnly")
	method number GetArcherSupportMinPercent(integer lv)
		-- 궁병 지원 화살 1발 데미지 하한(%).
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 90 + 4 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method number GetArcherSupportMaxPercent(integer lv)
		-- 궁병 지원 화살 1발 데미지 상한(%).
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 120 + 4 * (lv - 1)
	end

	-- ── 패닉/코마 데미지 배율 (요청 2026-08-12, 구슬 1개당 %) ──────────────
	-- 패닉: 1레벨 180~240% → 마스터(20) 360~480%. 코마: 1레벨 90~120% → 마스터 180~240%(패닉의 절반).
	-- 파워스트라이크/포이즌 미스트와 같은 방식 - 클라가 투자 레벨로 계산해 시전 시 서버로 넘긴다.
	@ExecSpace("ClientOnly")
	method number GetPanicMinPercent(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 180 + (360 - 180) / 19 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method number GetPanicMaxPercent(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 240 + (480 - 240) / 19 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method number GetComaMinPercent(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 90 + (180 - 90) / 19 * (lv - 1)
	end

	@ExecSpace("ClientOnly")
	method number GetComaMaxPercent(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 120 + (240 - 120) / 19 * (lv - 1)
	end

	-- 콤보 어택(3차 버프) 시전 MP 소모. 기본 30이지만 **어드밴스드 콤보에 1포인트라도 분배하면 100**
	-- (요청 2026-08-12) - 구슬 상한/2개 동시 획득이 붙는 대가.
	@ExecSpace("ClientOnly")
	method integer GetComboAttackMpCost()
		if self:GetHeroSkillLevelByName("어드밴스드 콤보") >= 1 then
			return 100
		end
		return 30
	end

	-- 패닉/코마(3차, 구슬 소모형 공격) 시전 MP 소모(고정 50 - 요청 2026-08-12).
	@ExecSpace("ClientOnly")
	method integer GetOrbSkillMpCost()
		return 50
	end

	-- 슬래시블러스트 시전 HP 소모(고정 5).
	@ExecSpace("ClientOnly")
	method integer GetSlashBlastHpCost()
		-- 사용자 확정 사양: HP가 이 값 이하면 시전 자체가 막힌다(자살 없음).
		return 5
	end

	-- 지금 이 스킬의 자원(HP/MP) 비용을 감당할 수 있는지. 비용이 없는 스킬은 항상 true.
	-- (요청 2026-08-09) 자동사냥이 "MP가 없으면 기본공격"으로 넘어가기 위한 사전 판정 -
	-- 이게 없으면 UseSkillInSlot이 비용 부족으로 **조용히 return**해서 캐릭터가 아무것도 하지 않고 선다.
	-- ⚠ 수동 시전의 실제 차감은 여전히 UseSkillInSlot이 한다(여기는 순수 조회 - 아무것도 소모하지 않는다).
	--   비용이 있는 스킬을 새로 만들면 이 표에도 함께 등록해야 자동사냥이 올바로 건너뛴다.
	-- 그 스킬의 MP 비용(조회 전용, 0 = 무료). CanAffordSkillCost와 자동사냥 마나 절약 모드가 공유한다.
	-- ⚠ 비용이 있는 스킬을 새로 만들면 **여기 한 곳**에만 등록하면 된다.
	@ExecSpace("ClientOnly")
	method integer GetSkillMpCost(string skillName)
		-- 이름 정규화: 슬래시블러스트는 옛 이름("슬래쉬블래스트")으로 퀵슬롯에 저장돼 있을 수 있다.
		local n = skillName or ""
		if n == "슬래쉬블래스트" then n = "슬래시블러스트" end
		if n == "파워스트라이크" then return self:GetPowerStrikeMpCost() end
		if n == "슬래시블러스트" then return self:GetSlashBlastMpCost() end
		if n == "텔레포트" then return self:GetTeleportMpCost(math.max(1, self:GetHeroSkillLevelByName("텔레포트"))) end
		if n == "러시" then return self:GetRushMpCost() end
		-- (요청 2026-08-12) 2차 버프 3종 MP 30 - 자동사냥 버프 유지가 부족 시 건너뛰고 재시도한다.
		if n == "부스터" or n == "분노" or n == "파워가드" then return self:GetSecondBuffMpCost() end
		if n == "콤보 어택" then return self:GetComboAttackMpCost() end
		if n == "브랜디쉬" then return self:GetBrandishMpCost() end
		if n == "패닉" or n == "코마" then return self:GetOrbSkillMpCost() end
		-- (요청 2026-08-12 2차·3차) 팔라딘 계열 + 서먼 다크드래곤. 등록해두지 않으면 자동사냥이
		-- "비용 없음"으로 오인해 MP가 없는데도 후보로 뽑아 조용히 아무것도 하지 않는다.
		if n == "리스토네이션" then return self:GetRestorationMpCost() end
		if n == "속성필드" then return self:GetElementalFieldMpCost() end
		if n == "가드" then return self:GetGuardMpCost() end
		if n == "차지 블로우" then return self:GetChargeBlowMpCost() end
		if n == "서먼 다크드래곤" then return self:GetDarkDragonMpCost() end
		if n == "스피어 버스터" then return self:GetSpearBurstMpCost() end
		if n == "드래곤 라이딩" then return self:GetDragonRideMpCost() end
		if n == "힐러 소환" then return self:GetHealerSummonMpCost() end
		if n == "드래곤 블러드" then return self:GetDragonBloodMpCost() end
		-- (요청 2026-08-13) 신궁·보우마스터 계열 10종. 여기 등록이 빠지면 자동사냥이 MP 부족을
		-- 알아채지 못하고 후보로 뽑아 조용히 아무것도 하지 않는다.
		if n == "더블샷" then return self:GetDoubleShotMpCost() end
		if n == "에로우 블로우" then return self:GetArrowBlowMpCost() end
		if n == "체인샷" then return self:GetChainShotMpCost() end
		if n == "더블 점프" then return self:GetDoubleJumpMpCost() end
		if n == "아이언 에로우" then return self:GetIronArrowMpCost() end
		if n == "스트레이프" then return self:GetStrafeMpCost() end
		if n == "아이스 샷" then return self:GetIceShotMpCost() end
		if n == "용사 소환" then return self:GetHeroSummonMpCost() end
		if n == "스나이핑" then return self:GetSnipingMpCost() end
		if n == "프리져" then return self:GetFreezerMpCost() end
		-- (요청 2026-08-13) 보우마스터 계열 5종.
		-- ⚠ 속사·폭풍의 시는 **한 발당** 비용을 돌려준다 - 이 값은 "지금 시작할 수 있는가"(CanAffordSkillCost)
		--   판정용이라 1발치면 충분하고, 연사 도중 MP가 마르는 것은 각 발사 틱이 스스로 끝낸다.
		if n == "속사" then return self:GetRapidFireMpCost() end
		if n == "폭풍의 시" then return self:GetHurricaneMpCost() end
		if n == "에로우 봄" then return self:GetArrowBombMpCost() end
		if n == "파이어 샷" then return self:GetFireShotMpCost() end
		if n == "피닉스" then return self:GetPhoenixMpCost() end
		-- (요청 2026-08-13 2차) 비숍 계열 13종. 등록이 빠지면 자동사냥이 MP 부족을 알아채지 못하고
		-- 후보로 뽑아 조용히 아무것도 하지 않는다.
		if n == "매직클로" then return self:GetMagicClawMpCost() end
		if n == "매직 미사일" then return self:GetMagicMissileMpCost() end
		if n == "힐" then return self:GetHealMpCost() end
		if n == "홀리 에로우" then return self:GetHolyArrowMpCost() end
		if n == "샤이닝 레이" then return self:GetShiningRayMpCost() end
		if n == "홀리 매직쉘" then return self:GetHolyShellMpCost() end
		if n == "바하뮤트" then return self:GetBahamutMpCost() end
		if n == "제네시스" then return self:GetGenesisMpCost() end
		if n == "리저렉션" then return self:GetResurrectionMpCost() end
		if n == "엔젤레이" then return self:GetAngelRayMpCost() end
		-- ⚠ 불독 4차 "리커버리 마나"는 여기 넣지 않는다 - MP를 채워주는 스킬이라 무료다(시전 분기 참고).
		if n == "리커버리 오로라" then return self:GetRecoveryAuraMpCost() end
		if n == "궁수 소환" then return self:GetArcherSummonMpCost() end
		if n == "도적 소환" then return self:GetThiefSummonMpCost() end
		-- (요청 2026-08-14) 썬콜·불독 계열 6종. 메디테이션/블레스는 현재 0(무료)이라 등록해도 그만이지만,
		-- 나중에 값이 생겼을 때 자동사냥이 조용히 놓치지 않도록 함께 등록해 둔다.
		if n == "블레스" then return self:GetBlessMpCost() end
		if n == "메디테이션" then return self:GetMeditationMpCost() end
		if n == "썬더볼트" then return self:GetThunderboltMpCost() end
		if n == "빙하지대" then return self:GetGlacierZoneMpCost() end
		if n == "체인라이트닝" then return self:GetChainLightningMpCost() end
		if n == "블리자드" then return self:GetBlizzardMpCost() end
		if n == "이프리트" then return self:GetIfritMpCost() end
		if n == "엘퀴네스" then return self:GetElquinesMpCost() end
		-- (요청 2026-08-14 3차) 불독 계열 5종.
		if n == "파이어에로우" then return self:GetFireArrowMpCost() end
		if n == "불의 영역" then return self:GetFireZoneMpCost() end
		if n == "포이즌 미스트" then return self:GetPoisonMistMpCost() end
		if n == "익스플로젼" then return self:GetExplosionMpCost() end
		if n == "메테오" then return self:GetMeteorMpCost() end
		-- (요청 2026-08-14 4차) 나이트로드·섀도어 계열 12종. 등록이 빠지면 자동사냥이 MP 부족을
		-- 알아채지 못하고 후보로 뽑아 조용히 아무것도 하지 않는다.
		if n == "더블스탭" then return self:GetDoubleStabMpCost() end
		if n == "다크사이트" then return self:GetDarkSightMpCost() end
		if n == "분신 소환" then return self:GetShadowCloneMpCost() end
		if n == "헤이스트" then return self:GetHasteMpCost() end
		if n == "새비지블로우" then return self:GetSavageBlowMpCost() end
		if n == "암행" or n == "암행2" then return self:GetAmhaengMpCost() end
		if n == "플래시 점프" then return self:GetFlashJumpMpCost() end
		if n == "쉐도우 파트너" then return self:GetShadowPartnerMpCost() end
		if n == "어썰터" then return self:GetAssaulterMpCost() end
		if n == "암살" then return self:GetAssassinateMpCost() end
		if n == "연막" then return self:GetSmokeScreenMpCost() end
		-- (요청 2026-08-14 5차) 나이트로드 표창 계열 6종.
		if n == "럭키세븐" then return self:GetLuckySevenMpCost() end
		if n == "드레인 샷" then return self:GetDrainShotMpCost() end
		if n == "어벤져" then return self:GetAvengerMpCost() end
		if n == "트리플 스로우" then return self:GetTripleThrowMpCost() end
		if n == "쿼드러플 스로우" then return self:GetQuadThrowMpCost() end
		if n == "각성" then return self:GetAwakeningMpCost() end
		return 0
	end

	@ExecSpace("ClientOnly")
	method boolean CanAffordSkillCost(string skillName)
		-- 이름 정규화: 슬래시블러스트는 옛 이름("슬래쉬블래스트")으로 퀵슬롯에 저장돼 있을 수 있다.
		local n = skillName or ""
		if n == "슬래쉬블래스트" then n = "슬래시블러스트" end

		local mpCost = self:GetSkillMpCost(n)
		local hpCost = 0
		if n == "슬래시블러스트" then
			hpCost = self:GetSlashBlastHpCost()
		end
		if mpCost <= 0 and hpCost <= 0 then return true end

		if mpCost > 0 and _MpManager:GetCurrentMp() < mpCost then return false end
		if hpCost > 0 then
			-- HP 비용은 "이하면 시전 불가"(자살 금지) 규칙이라 초과해야 통과한다 - 서버 게이트와 같은 부등호.
			local p = _UserService.LocalPlayer
			local pc = isvalid(p) and p.PlayerComponent or nil
			if isvalid(pc) and (pc.Hp or 0) <= hpCost then return false end
		end
		return true
	end

	-- ── 나이트로드 스킬 효과 공식 (2026-08-05 개편) ──────────────────────
	-- 다크나이트 3·4차와 같은 관례: 시전 분기 / 툴팁(GetSkillLevelEffectText) / 서버 전달값이
	-- 전부 아래 메서드들만 읽는다. 수치를 바꿀 때는 여기 한 곳만 고치면 세 곳이 함께 따라온다.

	-- 럭키세븐 표창 1발당 데미지 배율(최소). (요청 2026-08-14 5차) 파워스트라이크 1/3 파생을 끊고
	-- **더블샷 화살 1발과 완전히 같다**(40% + 분배 1포인트당 3%p, 마스터 20 = 97%).
	-- ⚠ 인자 없던 GetLuckySevenRateMin에 레벨을 더하지 않고 이름을 새로 지었다(LEA-1102 회피 관례 -
	--   더블샷/더블스탭이 *Lv로 옮겨간 것과 같다).
	-- ⚠ 반환은 **배율**(0.0~)이다 - 서버 CalcDamage가 그대로 곱한다(더블샷과 같은 규격).
	-- ⚠ 더블샷과 같은 계보라 공용 위력 배율(pendingSkillPowerMult)도 더블샷처럼 **끄지 않는다**.
	-- ⚠ 트리플 스로우는 이 헬퍼에서 파생시키던 것을 **끊었다**(아래 GetTripleThrow*Percent 주석 참고) -
	--   "럭키세븐만 더블샷 규격으로" 요청이라 3·4차가 조용히 따라 오르는 것을 막았다.
	@ExecSpace("ClientOnly")
	method number GetLuckySevenRateMinLv(integer lv)
		return self:GetDoubleShotRateMinLv(lv)
	end

	-- 럭키세븐 표창 1발당 데미지 배율(최대): 더블샷 화살 1발 상한과 같다(50% + 분배당 3%p, M20 107%).
	@ExecSpace("ClientOnly")
	method number GetLuckySevenRateMaxLv(integer lv)
		-- 최소 배율과 짝을 이루는 상한 - 서버가 이 둘 사이에서 발마다 1회 굴린다.
		return self:GetDoubleShotRateMaxLv(lv)
	end

	-- 드레인 샷 회복량(최대 HP %): 10% + 분배 1포인트당 1% (마스터 20 = 30%).
	@ExecSpace("ClientOnly")
	method number GetDrainShotHealPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 10 + (v - 1) + 1
	end

	-- ── 분신 소환 계열(섀도어 1~4차, 2026-08-06 신설) ────────────────────────────
	-- 4개 스킬(1차 분신 소환 + 강화 2·3·4차)이 **함께** 지속시간과 데미지를 정한다.
	-- 아래 3개 헬퍼가 유일한 공식 출처다 - 시전 분기·툴팁·서버 RPC가 전부 여기만 본다.

	-- 분신 지속시간(초).
	--   · 1차 분신 소환: 30초 + **2분배마다** 10초 (마스터 20 = 130초)
	--   · 강화 3종: 분배 1포인트당 (170/60)초씩 - 셋 다 마스터 20이면 정확히 +170초 = 300초(5분)
	-- 요청 사양: "1차 Lv20 130초 → 강화 셋이 나눠 채워 5분이 상한".
	@ExecSpace("ClientOnly")
	method number GetShadowCloneDuration(integer lv1, integer lv2, integer lv3, integer lv4)
		local a = math.max(1, math.min(lv1, 20))
		local b = math.max(0, math.min(lv2, 20)) + math.max(0, math.min(lv3, 20)) + math.max(0, math.min(lv4, 20))
		-- 2분배마다 +10초 = floor(레벨/2) × 10 (1레벨에서는 아직 0 - 기준값 30초).
		return 30 + 10 * math.floor(a / 2) + (170.0 / 60.0) * b
	end

	-- 분신 데미지(본체 대비 %).
	--   기본 50% + **네 스킬 각각** 2분배마다 +1%p (스킬당 마스터 20에서 +10%p).
	--   넷을 모두 마스터하면 50 + 10×4 = 90%(요청 확정값).
	@ExecSpace("ClientOnly")
	method number GetShadowCloneDamagePercent(integer lv1, integer lv2, integer lv3, integer lv4)
		local a = math.max(0, math.min(lv1, 20))
		local b = math.max(0, math.min(lv2, 20))
		local c = math.max(0, math.min(lv3, 20))
		local d = math.max(0, math.min(lv4, 20))
		return 50 + math.floor(a / 2) + math.floor(b / 2) + math.floor(c / 2) + math.floor(d / 2)
	end

	-- 분신이 쓸 수 있는 공격 스킬의 최고 차수(1~4). 강화를 1포인트라도 투자한 차수까지 열린다.
	-- ⚠ 중간을 건너뛴 투자(2차 미투자 + 3차 투자)는 인정하지 않는다 - 순서대로 이어질 때만 올라간다.
	@ExecSpace("ClientOnly")
	method integer GetShadowCloneSkillTier(integer lv2, integer lv3, integer lv4)
		if lv2 < 1 then return 1 end
		if lv3 < 1 then return 2 end
		if lv4 < 1 then return 3 end
		return 4
	end

	-- 암행 지속시간(초): (요청 2026-08-14 4차) 1레벨 20초 + 분배 1포인트당 10초 (마스터 20 = 210초).
	-- 종전엔 1레벨 60초였다 - 다른 버프(헤이스트/쉐도우 파트너)와 같은 "20초 + 10초/pt" 규격으로 통일했다.
	-- ⚠ 시전 분기·툴팁이 전부 이 헬퍼 하나만 본다(공식을 고칠 곳은 언제나 여기 한 곳).
	-- ⚠ 암행2(3차)도 이 헬퍼를 그대로 쓴다 - 요청 사양이 둘 다 "20초 + 분배당 10초"로 같다.
	@ExecSpace("ClientOnly")
	method number GetAmhaengDuration(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 20 + 10 * (v - 1)
	end

	-- 암행 발동 확률(%): 1~9레벨 4% / 10~19레벨 6% / 20레벨 8%.
	-- (요청 2026-08-06) 전 구간 **2배**로 상향(구 사양 2%/3%/4%) - 분배로 오르는 폭도 함께 2배가 된다.
	-- ⚠ 암행2(3차)도 같은 곡선을 쓴다(서버 GetAmhaeng2ProcRate) - 한쪽만 고치면 둘이 어긋난다.
	@ExecSpace("ClientOnly")
	method number GetAmhaengProcPercent(integer lv)
		-- 스피어 버스터 동시 타격 수와 같은 "구간형" 수치 - 서버(PlayerAttack)가 이 값을 그대로 쓴다.
		if lv >= 20 then return 8 end
		if lv >= 10 then return 6 end
		return 4
	end

	-- 암행 표창 데미지 최소%: (요청 2026-08-14 4차) 200% + 분배당 4%p (마스터 20 = 276%).
	-- 종전 100% + 분배당 5%p. ⚠ 서버(PlayerAttack.RollAmhaengMult / RollAmhaeng2Mult)가 같은 식을
	--   레벨만 받아 다시 돌린다 - 한쪽만 고치면 툴팁과 실제 데미지가 어긋난다.
	@ExecSpace("ClientOnly")
	method number GetAmhaengMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 200 + 4 * (v - 1)
	end

	-- 암행 표창 데미지 최대%: 220% + 분배당 4%p (마스터 20 = 296%).
	@ExecSpace("ClientOnly")
	method number GetAmhaengMaxPercent(integer lv)
		-- 최소%와 폭(20%p)이 같이 밀려 올라간다 - 요청대로 "최소 4% 최대 4%씩" 오른다.
		local v = math.max(1, math.min(lv, 20))
		return 220 + 4 * (v - 1)
	end

	-- 헤이스트 지속시간(초): (요청 2026-08-14 4차) 1레벨 20초 + 분배 1포인트당 10초 (마스터 20 = 210초).
	-- 종전엔 1분 → 5분 선형이었다 - 암행/쉐도우 파트너와 같은 "20초 + 10초/pt" 규격으로 통일했다.
	@ExecSpace("ClientOnly")
	method number GetHasteDurationForLevel(integer lv)
		-- 버프바 표시 / 서버 만료 예약이 같은 값을 쓴다.
		local v = math.max(1, math.min(lv, 20))
		return 20 + 10 * (v - 1)
	end

	-- 헤이스트 이동 속도 배율: 분배 1포인트당 +1% (1레벨 1.01 → 마스터 20 = 1.20).
	@ExecSpace("ClientOnly")
	method number GetHasteSpeedMult(integer lv)
		-- 서버 RecomputeMoveJumpBuffs가 이 배율을 원래 InputSpeed에 곱한다.
		local v = math.max(1, math.min(lv, 20))
		return 1.0 + 0.01 * v
	end

	-- 헤이스트 점프 보정 사거리(점프력 배율 기준): 1레벨 1.02 → 분배당 +0.02 → 마스터 20 = 1.40.
	-- "점프력이 이 배율일 때 올라갈 수 있는 발판까지" 보정이 걸린다는 뜻이고, 실제 점프력은
	-- 그 안에서 **바로 위 발판을 살짝 넘길 만큼만** 올라간다(서버 HasteJumpAssistTick).
	@ExecSpace("ClientOnly")
	method number GetHasteJumpRangeMult(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 1.0 + 0.02 * v
	end

	-- ── 나이트로드 3·4차 스킬 효과 공식 (2026-08-05 개편) ──────────────────
	-- 위 1·2차와 같은 관례: 시전 분기 / 툴팁 / 서버 전달값이 전부 아래 메서드만 읽는다.

	-- 쉐도우 파트너 지속시간(초): (요청 2026-08-14 4차) 1레벨 20초 + 분배 1포인트당 +10초
	-- (마스터 30 = 310초). 종전 30초 시작 - 암행/헤이스트와 같은 "20초 + 10초/pt" 규격으로 통일했다.
	@ExecSpace("ClientOnly")
	method number GetShadowPartnerDurationForLevel(integer lv)
		-- 버프바 표시 / 서버 만료 예약이 같은 값을 쓴다.
		local v = math.max(1, math.min(lv, 30))
		return 20 + 10 * (v - 1)
	end

	-- 쉐도우 파트너 분신 데미지(본체 대비 %): 50% + 분배 1포인트당 +1%p (마스터 30 = 79%).
	@ExecSpace("ClientOnly")
	method number GetShadowPartnerDamagePercent(integer lv)
		-- 서버(PlayerAttack.GetShadowEchoRate)가 이 값을 100으로 나눈 배율로 보너스 줄을 계산한다.
		local v = math.max(1, math.min(lv, 30))
		return 50 + 1 * (v - 1)
	end

	-- 트리플 스로우 표창 1개당(줄당) 데미지 최소%: (요청 2026-08-14 6차) 80% + 분배 1포인트당 +2%p
	-- (마스터 30 = 138%). 종전 50/3 ≈ 16.7% + 2%p/pt.
	-- ⚠ 럭키세븐 파생은 08-14 5차에 이미 끊어 자체 곡선이다(럭키세븐이 더블샷 규격으로 옮겨갈 때
	--   3·4차가 조용히 따라 오르는 것을 막은 조치) - 여기 리터럴만 고치면 된다.
	@ExecSpace("ClientOnly")
	method number GetTripleThrowMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 80 + 2 * (v - 1)
	end

	-- 트리플 스로우 표창 1개당(줄당) 데미지 최대%: 90% + 분배 1포인트당 +2%p (마스터 30 = 148%).
	@ExecSpace("ClientOnly")
	method number GetTripleThrowMaxPercent(integer lv)
		-- 최소%와 폭(10%p)이 함께 밀려 올라간다 - 요청대로 "최소 2% 최대 2%씩" 오른다.
		local v = math.max(1, math.min(lv, 30))
		return 90 + 2 * (v - 1)
	end

	-- 쿼드러플 스로우 표창 1개당(줄당) 데미지 최소%: (요청 2026-08-14 6차) 140% + 분배 1포인트당 +2%p
	-- (마스터 30 = 198%).
	-- ⚠ 종전엔 "트리플 스로우 마스터(30)의 최소값 + 5%p/pt"로 **트리플에서 파생**시켜 "4차 1레벨 =
	--   3차 마스터" 관계를 고정했다. 요청이 두 스킬의 기준값을 따로 지정했으므로 파생을 끊고
	--   자체 곡선으로 바꿨다 - 이제 트리플을 고쳐도 쿼드러플은 따라오지 않는다.
	@ExecSpace("ClientOnly")
	method number GetQuadThrowMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 140 + 2 * (v - 1)
	end

	-- 쿼드러플 스로우 표창 1개당(줄당) 데미지 최대%: 150% + 분배 1포인트당 +2%p (마스터 30 = 208%).
	@ExecSpace("ClientOnly")
	method number GetQuadThrowMaxPercent(integer lv)
		-- 최소%와 폭(10%p)이 함께 밀려 올라간다 - 요청대로 "최소 2% 최대 2%씩" 오른다.
		local v = math.max(1, math.min(lv, 30))
		return 150 + 2 * (v - 1)
	end

	-- 어벤져 데미지 최소%: (요청 2026-08-14 5차) 160% + 분배 1포인트당 +3%p (마스터 20 = 217%).
	-- 종전 100% + 분배당 5%p.
	@ExecSpace("ClientOnly")
	method number GetAvengerMinPercent(integer lv)
		-- 암행/스피어 버스터와 같은 "1레벨 기준값 + (lv-1)" 관례.
		local v = math.max(1, math.min(lv, 20))
		return 160 + 3 * (v - 1)
	end

	-- 어벤져 데미지 최대%: 180% + 분배 1포인트당 +3%p (마스터 20 = 237%).
	@ExecSpace("ClientOnly")
	method number GetAvengerMaxPercent(integer lv)
		-- 최소%와 폭(20%p)이 함께 밀려 올라간다 - 요청대로 "최소 3 최대 3%씩" 오른다.
		local v = math.max(1, math.min(lv, 20))
		return 180 + 3 * (v - 1)
	end

	-- ── 플래시 점프(나이트로드·섀도어 3차) 레벨 공식 ─────────────────────
	-- ⚠ 도약 계산(RunFlashJumpMove)·툴팁이 전부 아래 두 헬퍼만 본다 - 수치를 고칠 곳은 여기 한 곳이다.

	-- 분배 레벨별 "날아가는 힘" 단위: 3,3,3,4,4,5,5,6,6,7 (마스터 10).
	-- 요청 사양이 **더블 점프의 힘을 5로 놓은 상대 수치**라서, 아래 GetFlashJumpForceScale이
	-- 이 값을 5로 나눈 배율을 더블 점프의 실제 힘(가로 4.5 / 세로 4.04)에 곱한다.
	@ExecSpace("ClientOnly")
	method number GetFlashJumpForceUnit(integer lv)
		local units = {3, 3, 3, 4, 4, 5, 5, 6, 6, 7}
		local v = math.max(1, math.min(lv, 10))
		return units[v]
	end

	-- 더블 점프 대비 도약 힘 배율(1레벨 0.6배 → 마스터 10에서 1.4배).
	-- 가로·세로에 같은 배율을 곱하므로 "힘"과 "거리"가 함께 강해진다(도약 높이는 힘의 제곱에 비례).
	@ExecSpace("ClientOnly")
	method number GetFlashJumpForceScale(integer lv)
		return self:GetFlashJumpForceUnit(lv) / 5.0
	end

	-- ── 각성(나이트로드 4차) 레벨 공식 ─────────────────────────────────
	-- ⚠ 시전 분기(UseSkillInSlot)·툴팁·서버 전달값이 전부 이 두 헬퍼 하나만 본다
	--   (다크나이트 3·4차 개편과 같은 관례 - 공식을 고칠 곳은 언제나 여기 한 곳이다).

	-- 지속시간(초): 1레벨 10초 + 분배 1포인트당 +1초 (마스터 30 = 39초).
	@ExecSpace("ClientOnly")
	method number GetAwakeningDuration(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 10 + (v - 1)
	end

	-- 공격속도 상승 단계: 1~9분배 5단계 / 10~19분배 10단계 / 20분배 이상 15단계(구간형).
	@ExecSpace("ClientOnly")
	method integer GetAwakeningAtkSpeedStages(integer lv)
		local v = math.max(1, math.min(lv, 30))
		if v >= 20 then return 15 end
		if v >= 10 then return 10 end
		return 5
	end

	-- ── 섀도어 스킬 효과 공식 (2026-08-06 개편) ────────────────────────────
	-- 나이트로드/다크나이트 개편과 같은 관례: 시전 분기 / 툴팁 / 서버 전달값이 전부 아래 메서드만
	-- 읽는다. 수치를 바꿀 곳은 언제나 여기 한 곳이다.
	-- ⚠ 파생 관계는 (요청 2026-08-14 4차)로 크게 바뀌었다 - 지금 살아 있는 링크는 두 개뿐이다.
	--   · 더블스탭 = **더블샷 × 2**(신설 - 구 사양은 럭키세븐 × 1.3)
	--   · 암살 = **체인 라이트닝과 동일**(신설 - 구 사양은 쿼드러플 스로우 총합의 1/2)
	--   · 암행2 = 암행1과 동일 곡선(유지)
	--   새비지블로우(트리플 스로우 파생)·어썰터(새비지블로우 파생)는 링크를 끊고 자체 곡선을 갖는다.

	-- 더블스탭 한 타당 데미지 배율(최소). (요청 2026-08-14 4차) 럭키세븐 × 1.3 파생을 끊고
	-- **더블샷 화살 1발의 2배**가 된다 - 두 스킬 모두 2타/2발이라 시전 1회 총합도 정확히 더블샷의 2배다.
	-- ⚠ 인자 없던 GetDoubleStabRateMin에 레벨을 더하지 않고 이름을 새로 지었다(LEA-1102 회피 관례 -
	--   더블샷이 GetDoubleShotRateMin → GetDoubleShotRateMinLv로 옮겨간 것과 같다).
	-- ⚠ 반환은 **배율**(0.0~)이다 - 서버 CalcDamage가 그대로 곱한다(더블샷과 같은 규격).
	-- ⚠ 더블샷과 같은 규격이라 공용 위력 배율(pendingSkillPowerMult)도 더블샷처럼 **끄지 않는다**.
	@ExecSpace("ClientOnly")
	method number GetDoubleStabRateMinLv(integer lv)
		return self:GetDoubleShotRateMinLv(lv) * 2
	end

	-- 더블스탭 한 타당 데미지 배율(최대). 더블샷 화살 1발 상한의 2배.
	@ExecSpace("ClientOnly")
	method number GetDoubleStabRateMaxLv(integer lv)
		return self:GetDoubleShotRateMaxLv(lv) * 2
	end

	-- 새비지블로우 한 타당(줄당) 데미지 최소%: (요청 2026-08-14 4차) 50% + 분배 1포인트당 2%p
	-- (마스터 30 = 108%). 트리플 스로우 파생(표창 1개분의 절반)을 끊고 자체 곡선을 갖는다.
	@ExecSpace("ClientOnly")
	method number GetSavageBlowMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 50 + 2 * (v - 1)
	end

	-- 새비지블로우 한 타당(줄당) 데미지 최대%: 60% + 분배 1포인트당 2%p (마스터 30 = 118%).
	@ExecSpace("ClientOnly")
	method number GetSavageBlowMaxPercent(integer lv)
		-- 최소%와 폭(10%p)이 같이 밀려 올라간다 - 요청대로 "최소 2% 최대 2%씩" 오른다.
		local v = math.max(1, math.min(lv, 30))
		return 60 + 2 * (v - 1)
	end

	-- 다크사이트 재사용 대기시간(초): 1레벨 30초, 분배 1포인트당 -1초 (마스터 20 = 11초).
	@ExecSpace("ClientOnly")
	method number GetDarkSightCooldown(integer lv)
		-- 가드(30 - (lv-1))와 같은 역방향 선형 곡선.
		local v = math.max(1, math.min(lv, 20))
		return 30 - (v - 1)
	end

	-- 다크사이트 중 이동 속도 배율: 1레벨 0.30(30%), 분배 1포인트당 +0.01 (마스터 20 = 0.49).
	@ExecSpace("ClientOnly")
	method number GetDarkSightSpeedMult(integer lv)
		-- 서버 AttackDarkSightLv가 이 배율을 원래 InputSpeed에 곱한다(구 사양 고정 0.5를 대체).
		local v = math.max(1, math.min(lv, 20))
		return 0.30 + 0.01 * (v - 1)
	end

	-- 어썰터 대상당 데미지 최소%: (요청 2026-08-14 4차) 200% + 분배 1포인트당 4%p (마스터 30 = 316%).
	-- 새비지블로우 6타 합계 파생을 끊고 자체 곡선을 갖는다(암행과 같은 200~220% 규격).
	@ExecSpace("ClientOnly")
	method number GetAssaulterMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 200 + 4 * (v - 1)
	end

	-- 어썰터 대상당 데미지 최대%: 220% + 분배 1포인트당 4%p (마스터 30 = 336%).
	@ExecSpace("ClientOnly")
	method number GetAssaulterMaxPercent(integer lv)
		-- 최소%와 폭(20%p)이 같이 밀려 올라간다 - 요청대로 "최소 4 최대 4%씩" 오른다.
		local v = math.max(1, math.min(lv, 30))
		return 220 + 4 * (v - 1)
	end

	-- 어썰터 스택 1개가 차는 데 걸리는 시간(초): 1레벨 10초 / 10레벨 8초 / 20레벨 6초 / 30레벨 5초.
	-- 구간마다 기울기가 다른 요청값이라 세 구간 선형으로 잇는다(구 사양은 레벨 무관 3초 고정).
	@ExecSpace("ClientOnly")
	method number GetAssaulterChargeSeconds(integer lv)
		local v = math.max(1, math.min(lv, 30))
		if v <= 10 then return 10.0 - 2.0 * (v - 1) / 9.0 end
		if v <= 20 then return 8.0 - 2.0 * (v - 10) / 10.0 end
		return 6.0 - 1.0 * (v - 20) / 10.0
	end

	-- 암살 대상당 데미지 최소%: (요청 2026-08-14 4차) **체인 라이트닝과 완전히 같다**
	-- (500% + 분배 1포인트당 10%p, 마스터 30 = 790%). 쿼드러플 스로우 총합의 1/2 파생은 끊었다.
	-- ⚠ 값을 복사하지 않고 체인 라이트닝 헬퍼를 그대로 호출한다 - 한쪽만 고쳐 갈라지는 것을 막는다.
	--   두 스킬 모두 마스터 30이라 상한 클램프도 어긋나지 않는다.
	@ExecSpace("ClientOnly")
	method number GetAssassinateMinPercent(integer lv)
		return self:GetChainLightningMinPercent(lv)
	end

	-- 암살 대상당 데미지 최대%: 체인 라이트닝과 같다(700% + 분배당 20%p, 마스터 30 = 1280%).
	@ExecSpace("ClientOnly")
	method number GetAssassinateMaxPercent(integer lv)
		return self:GetChainLightningMaxPercent(lv)
	end

	-- 연막 지속시간(초): 1레벨 20초 + 분배 1포인트당 1초 (마스터 40 = 59초).
	-- ⚠ 마스터가 40인 유일한 스킬이다 - CSV(HeroSkillTable)의 master 값도 40이어야 위력 배율이 맞는다.
	@ExecSpace("ClientOnly")
	method number GetSmokeScreenDuration(integer lv)
		local v = math.max(1, math.min(lv, 40))
		return 20 + (v - 1)
	end

	-- ── 신궁(보우마스터 공유) 스킬 효과 공식 (2026-08-06 개편) ──────────────
	-- 나이트로드/섀도어/다크나이트 개편과 같은 관례: 시전 분기 / 툴팁(GetSkillLevelEffectText) /
	-- 서버 전달값이 전부 아래 메서드만 읽는다. 수치를 바꿀 곳은 언제나 여기 한 곳이다.
	-- ⚠ 두 종류가 섞여 있다:
	--   · **배율(0.0~) 반환** - 더블샷 / 에로우 블로우: 서버 CalcDamage가 그대로 곱한다.
	--   · **퍼센트(100 = 1배) 반환** - 나머지: 서버에 넘길 때 /100 해서 배율로 바꾼다(다른 직업과 동일).

	-- 더블샷 화살 1발당 데미지 배율(최소). (요청 2026-08-13) 럭키세븐 파생(파워스트라이크의 1/3)을 끊고
	-- **자체 곡선**을 갖는다: 1레벨 40%, 분배 1포인트당 +3%p (마스터 20 = 97%).
	-- ⚠ 인자 없던 GetDoubleShotRateMin에 레벨을 더하지 않고 이름을 새로 지었다(LEA-1102 회피 관례).
	-- ⚠ 반환은 여전히 **배율**(0.0~)이다 - 서버 CalcDamage가 그대로 곱한다.
	@ExecSpace("ClientOnly")
	method number GetDoubleShotRateMinLv(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return (40 + 3 * (v - 1)) / 100
	end

	-- 더블샷 화살 1발당 데미지 배율(최대): 1레벨 50%, 분배 1포인트당 +3%p (마스터 20 = 107%).
	@ExecSpace("ClientOnly")
	method number GetDoubleShotRateMaxLv(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return (50 + 3 * (v - 1)) / 100
	end

	-- 에로우 블로우 데미지 배율(최소). (요청 2026-08-13) 슬래시블러스트 파생(0.5~1.5 고정)을 끊고
	-- **자체 곡선**을 갖는다: 1레벨 50%, 분배 1포인트당 +2%p (마스터 20 = 88%).
	-- 여기에 "에로우 블로우 강화" 투자 1포인트당 +2%p가 더해진다(마스터 20에서 +40%p).
	-- ⚠ 인자가 (enhanceLv) 하나뿐이던 GetArrowBlowRateMin에 인자를 더하지 않고 이름을 새로 지었다.
	@ExecSpace("ClientOnly")
	method number GetArrowBlowRateMinLv(integer lv, integer enhanceLv)
		local v = math.max(1, math.min(lv, 20))
		local e = math.max(0, math.min(enhanceLv, 20))
		return (50 + 2 * (v - 1) + 2 * e) / 100
	end

	-- 에로우 블로우 데미지 배율(최대): 1레벨 60%, 분배 1포인트당 +2%p + 강화 1포인트당 +2%p
	-- (에로우 블로우 마스터 20 = 98%, 강화까지 마스터면 138%).
	@ExecSpace("ClientOnly")
	method number GetArrowBlowRateMaxLv(integer lv, integer enhanceLv)
		local v = math.max(1, math.min(lv, 20))
		local e = math.max(0, math.min(enhanceLv, 20))
		return (60 + 2 * (v - 1) + 2 * e) / 100
	end

	-- 아이언 에로우 데미지 최소%: (요청 2026-08-13) 150% + 분배 1포인트당 4%p (마스터 20 = 226%).
	@ExecSpace("ClientOnly")
	method number GetIronArrowMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 150 + 4 * (v - 1)
	end

	-- 아이언 에로우 데미지 최대%: (요청 2026-08-13) 170% + 분배 1포인트당 4%p (마스터 20 = 246%).
	@ExecSpace("ClientOnly")
	method number GetIronArrowMaxPercent(integer lv)
		-- 최소%와 폭(20%p)이 함께 밀려 올라간다 - 요청대로 "최소·최대 4%씩" 오른다.
		local v = math.max(1, math.min(lv, 20))
		return 170 + 4 * (v - 1)
	end

	-- 더블 점프 상시 이동 속도 배율: 분배 1포인트당 +1% (1레벨 1.01 → 마스터 10 = 1.10).
	-- ⚠ 지속시간이 있는 버프가 아니라 **배우기만 하면 항상 걸리는 패시브**다 - 서버
	--   PlayerAttack.RecomputeMoveJumpBuffs가 헤이스트 배율과 곱으로 겹쳐 적용한다.
	@ExecSpace("ClientOnly")
	method number GetDoubleJumpSpeedMult(integer lv)
		local v = math.max(0, math.min(lv, 10))
		return 1.0 + 0.01 * v
	end

	-- 스트레이프 화살 1발당 데미지 최소%: (요청 2026-08-13) 120% + 분배 1포인트당 5%p (마스터 30 = 265%).
	@ExecSpace("ClientOnly")
	method number GetStrafeMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 120 + 5 * (v - 1)
	end

	-- 스트레이프 화살 1발당 데미지 최대%: (요청 2026-08-13) 130% + 분배 1포인트당 **6%p**
	-- (최소보다 1%p 빠르게 올라간다 - 마스터 30 = 304%).
	@ExecSpace("ClientOnly")
	method number GetStrafeMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 130 + 6 * (v - 1)
	end

	-- 아이스 샷 대상 1명당 데미지 최소%: (요청 2026-08-13) 200% + 분배 1포인트당 5%p (마스터 30 = 345%).
	-- ⚠ 파이어 샷(보우마스터 3차)이 이 헬퍼를 그대로 위임받는다 - 함께 따라 움직인다.
	@ExecSpace("ClientOnly")
	method number GetIceShotMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 200 + 5 * (v - 1)
	end

	-- 아이스 샷 대상 1명당 데미지 최대%: (요청 2026-08-13) 220% + 분배 1포인트당 5%p (마스터 30 = 365%).
	@ExecSpace("ClientOnly")
	method number GetIceShotMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 220 + 5 * (v - 1)
	end

	-- 에로우 봄(보우마스터 2차) 대상 1명당 데미지 최소%: (요청 2026-08-13) 130% + 분배 1포인트당 4%p
	-- (마스터 20 = 206%).
	-- ⚠ 직격 대상과 폭발에 휘말린 주변 적이 **같은 배율**을 쓴다(에로우 블로우 강화와 같은 규칙).
	@ExecSpace("ClientOnly")
	method number GetArrowBombMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 130 + 4 * (v - 1)
	end

	-- 에로우 봄 대상 1명당 데미지 최대%: (요청 2026-08-13) 140% + 분배 1포인트당 4%p (마스터 20 = 216%).
	@ExecSpace("ClientOnly")
	method number GetArrowBombMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 140 + 4 * (v - 1)
	end

	-- 파이어 샷(보우마스터 3차): **아이스 샷과 완전히 같은 규격**(요청 2026-08-07 - "마스터 레벨과
	-- 분배별 데미지가 아이스 샷과 같다"). ⚠ 기준값을 아이스 샷 헬퍼에서 파생시킨다 - 아이스 샷 수치를
	-- 고치면 파이어 샷도 자동으로 따라온다(프리져↔용 소환과 같은 관례).
	@ExecSpace("ClientOnly")
	method number GetFireShotMinPercent(integer lv)
		return self:GetIceShotMinPercent(lv)
	end

	@ExecSpace("ClientOnly")
	method number GetFireShotMaxPercent(integer lv)
		return self:GetIceShotMaxPercent(lv)
	end

	-- 속사(보우마스터 2차) 화살 1발당 데미지 최소%: (요청 2026-08-13) 130% + 분배 1포인트당 4%p
	-- (마스터 20 = 206%). ⚠ 초당 6발 홀드 연사라 **한 발당 MP 4**가 따로 든다(GetRapidFireMpCost).
	@ExecSpace("ClientOnly")
	method number GetRapidFireMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 130 + 4 * (v - 1)
	end

	-- 속사 화살 1발당 데미지 최대%: (요청 2026-08-13) 140% + 분배 1포인트당 4%p (마스터 20 = 216%).
	@ExecSpace("ClientOnly")
	method number GetRapidFireMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 140 + 4 * (v - 1)
	end

	-- 폭풍의 시(보우마스터 4차) 화살 1발당 데미지 최소%: 200% + 분배 1포인트당 5%p (마스터 30 = 345%).
	-- ⚠ 0.1초마다 한 발이 나가는 홀드 연사다 - 한 발의 배율이 낮은 대신 초당 10발이라는 점에 주의.
	@ExecSpace("ClientOnly")
	method number GetHurricaneMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 200 + 5 * (v - 1)
	end

	-- 폭풍의 시 화살 1발당 데미지 최대%: 250% + 분배 1포인트당 5%p (마스터 30 = 395%).
	@ExecSpace("ClientOnly")
	method number GetHurricaneMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 250 + 5 * (v - 1)
