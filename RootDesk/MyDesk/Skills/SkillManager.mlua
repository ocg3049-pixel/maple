	@ExecSpace("ClientOnly")
	method number GetChainShotCooldown()
		-- 체인샷 재사용 대기시간(초). (요청 2026-08-10) 2초 → 5초.
		-- ⚠ 이 값을 바꾸면 자동사냥의 재시도 간격(AutoHuntManager.TryChainShotMove의 nextChainShot)도
		--   함께 봐야 한다 - 거기는 "발사 → 당기기 → 쿨타임"이 다 끝날 만큼 넉넉해야 한다.
		return 5.0
	end

	@ExecSpace("ClientOnly")
	method void StartChainShotCooldown()
		-- (요청 2026-08-13) 체인샷 쿨타임을 **지금부터** 건다. 종전엔 체인을 쏘는 순간 걸었지만,
		-- 요청 사양은 "사용 후 (당겨져) 날아갔을 때부터 5초"다 - 그래서 거는 시점이 세 군데로 나뉜다:
		--   ① 당기기 성공(= 날아간 순간, UseSkillInSlot의 체인샷 당기기 분기)
		--   ② 체인이 지형에 안 박힘(빗나감 - 당길 것이 없으니 즉시)
		--   ③ 박힌 채로 유지시간이 끝남(당기지 않고 흘려보냄)
		-- ②③은 서버 통지(OnChainShotAnchored의 anchored=false)로 들어온다.
		-- ⚠ 한 번 쏜 체인에 대해 **두 번 걸리면 안 된다** - 빗나감(②)으로 이미 걸어둔 뒤 유지시간
		--   만료 통지(③)가 또 오면 쿨타임이 그 시점부터 새로 도는 사고가 난다. 발사할 때 내려두는
		--   chainCooldownCharged 플래그로 체인 1개당 한 번만 걸리게 막는다.
		if self._T.chainCooldownCharged == true then return end
		self._T.chainCooldownCharged = true
		-- 리커버리 오로라 안에서는 쿨타임 자체를 걸지 않는다(오로라 = 노쿨 - 다른 스킬과 같은 규칙).
		if self:IsInRecoveryAura() then return end
		local cd = self:GetChainShotCooldown()
		self._T.chainShotCooldownUntil = _UtilLogic.ElapsedSeconds + cd
		-- 퀵슬롯 표기. 발사 분기의 key를 여기까지 들고 오지 않고 스킬 이름으로 슬롯을 찾는다
		-- (더블 점프/러시가 쓰는 것과 같은 조회 - 배정돼 있을 때만 그린다).
		local chainBarPos = self:FindBarPosForSkillName("체인샷")
		if chainBarPos ~= "" then
			_ChainShotCooldownUI:ShowCooldown(cd, chainBarPos)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnChainShotAnchored(boolean anchored, number holdSeconds)
		-- 서버(PlayerAttack.AttackChainShot)가 "지형에 박혔는지"를 알려준다. 박혔을 때만 다음 입력이
		-- 당기기가 되고, 빗나갔으면 다음 입력은 새 체인 발사가 된다.
		local now = _UtilLogic.ElapsedSeconds
		if anchored then
			-- ⚠ (신고 2026-08-13) 서버의 유지 타이머는 **발사 시각**에 시작하는데 이 통지는 왕복 지연
			--   뒤에 도착한다 - 클라가 holdSeconds를 그대로 쓰면 창이 서버보다 늦게까지 열려 있어,
			--   경계 근처의 입력이 "당기기"로 갔다가 서버에서 버려지고 아무 일도 안 일어났다.
			--   왕복 지연 몫(0.5초)을 미리 깎아 클라 창이 항상 서버보다 먼저 닫히게 한다.
			local usable = math.max(0.5, holdSeconds - 0.5)
			self._T.chainAnchoredUntil = now + usable
			-- 키를 누르고 있을 때 반복 KeyDown이 곧바로 당기기로 이어지지 않게 짧은 유예를 둔다.
			-- (키를 뗐다 다시 누른 경우는 이 유예를 건너뛴다 - 아래 시전 분기의 상승 엣지 판정 참고.)
			self._T.chainPullReadyAt = now + 0.3
			log("[SkillManager] 체인샷 고정 - " .. string.format("%.1f", usable) .. "초 안에 다시 누르면 당겨진다")
		else
			-- 빗나갔거나(지형 미명중) 서버에서 유지시간이 끝났다 - 다음 입력은 새 체인 발사가 된다.
			-- (요청 2026-08-13) 당기기가 없었으므로 쿨타임을 **여기서** 건다
			-- (당긴 경우는 당기기 분기가 이미 걸었고, 플래그가 중복 적용을 막는다).
			-- ⚠ 단, "박힌 채로 유지시간(5.5초)을 다 흘려보낸" 경우는 이미 쿨타임(5초)보다 긴 시간이
			--   지났다 - 여기서 5초를 또 걸면 체인 한 번 낭비에 10초 넘게 묶인다. 발사 이후 흐른
			--   시간이 쿨타임 이상이면 쿨타임을 소진한 것으로 보고 곧바로 다시 쓸 수 있게 한다.
			--   (빗나감 통지는 발사 직후에 오므로 이 조건에 걸리지 않아 정상적으로 5초가 걸린다.)
			self._T.chainAnchoredUntil = 0
			local sinceFire = now - (self._T.chainFiredAt or 0)
			if sinceFire >= self:GetChainShotCooldown() then
				self._T.chainCooldownCharged = true
				log("[SkillManager] 체인샷 고정 해제 - 유지시간 만료(재사용 대기 이미 소진)")
			else
				self:StartChainShotCooldown()
				log("[SkillManager] 체인샷 고정 해제 - 다음 입력은 새 체인 발사(재사용 대기 시작)")
			end
		end
	end

	@ExecSpace("Server")
	method void RequestEndRapidFire()
		-- 연사 종료를 서버에 알려 이동 잠금(PlayerControllerComponent.Enable)을 즉시 되돌린다.
		-- 이 요청이 유실돼도 서버가 마지막 발사 1초 뒤에 스스로 복구한다(AttackRapidFire의 토큰 가드).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:RestoreRapidFireControl()
	end

	@ExecSpace("Server")
	method void RequestFireDoubleJump(number dirX)
		-- 더블 점프의 이펙트/사용음만 서버에 요청한다(이동은 위 RunDoubleJumpMove가 클라에서 처리).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireDoubleJump: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireDoubleJump: PlayerAttack component not found")
			return
		end
		pa:CastDoubleJump(dirX)
	end

	@ExecSpace("Server")
	method void RequestFireFlashJump(number dirX)
		-- 플래시 점프의 이펙트/사용음만 서버에 요청한다(이동은 RunFlashJumpMove가 클라에서 처리).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireFlashJump: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireFlashJump: PlayerAttack component not found")
			return
		end
		pa:CastFlashJump(dirX)
	end

	-- (M2 자동사냥) 슬롯에 사용 가능한 스킬이 배정돼 있는지 (AutoHuntManager 전용 조회)
	@ExecSpace("ClientOnly")
	method boolean HasSkillInSlot(string key)
		local slot = self._T.slotData[key]
		return slot ~= nil and slot.ruid ~= nil and slot.ruid ~= ""
	end

	@ExecSpace("ClientOnly")
	method void UseSkillInSlot(string key)
		local slot = self._T.slotData[key]
		if slot == nil or slot.ruid == "" then return end
		-- (요청) 스킬 포인트 미투자 스킬은 사용 불가 (회수로 0이 된 직후의 잔여 입력까지 차단)
		if not self:IsSkillUsableByInvestment(slot.name) then
			log("[SkillManager] " .. tostring(slot.name) .. ": 스킬 포인트 미투자 - 사용 불가")
			return
		end
		-- (Phase 4) 스킬 투자 위력 배율을 이번 시전에 예약한다 - 아래 분기들이 GetEffectiveCombatPower를
		-- 부르면 이 배율이 곱해진 전투력이 서버로 넘어간다 (spendable 스킬이 아니면 1.0).
		self._T.pendingSkillPowerMult = self:GetSkillPowerMultiplier(slot.name)
		-- (전투분석) 이번 시전 스킬명을 예약 - 실제 공격 발동 신호인 GetEffectiveCombatPower가
		-- 소비하며 사용 횟수를 집계한다(1회성). 발동에 실패(쿨다운/사거리 등)하면 소비되지 않아 카운트 안 됨.
		-- ⚠ (버그 수정 2026-08-14) **예약에 유효시간을 둔다.** 발동에 실패하면 예약명이 그대로 남는데,
		--   나중에 전혀 다른 경로가 GetEffectiveCombatPower를 부르면 그 낡은 이름이 소비되어 **엉뚱한
		--   스킬의 사용 횟수로 집계**된다(신고: 1분 넘게 싸우면 사용 횟수가 폭증 - 자동사냥이 매 틱
		--   판정용으로 부르던 것이 방아쇠였다). 근본은 판정용 호출을 Peek으로 바꿔 막았고, 여기서는
		--   같은 사고가 다시 나지 않도록 "같은 시전 흐름 안(0.5초)에서만 유효"하게 못 박는다.
		self._T.castingSkillName = slot.name
		self._T.castingSkillNameAt = _UtilLogic.ElapsedSeconds
		-- (기능 추가) "사망했을 때 부활 전까지 다른 행동을 못하게 해달라"는 요청 - 사망(DEAD) 상태에서는
		-- 어떤 슬롯도 사용할 수 없다(HP포션 포함). 이동/점프/기본공격은 서버 쪽에서 조작 자체를 꺼서 막는다
		-- (PlayerAttack.HandleDeadLockStateEvent). 부활하면 자동으로 다시 풀린다.
		local localPlayerForDeath = _UserService.LocalPlayer
		local deathState = isvalid(localPlayerForDeath) and localPlayerForDeath.StateComponent or nil
		if isvalid(deathState) and deathState.CurrentStateName == "DEAD" then
			log("[SkillManager] 사망 상태 - 스킬 사용 불가 (부활 후 사용 가능)")
			return
		end
		-- (피드백) 리저렉션 시전 중에는 이동뿐 아니라 모든 스킬도 못 쓰는 행동 불가 상태여야 한다 -
		-- 시전 시 걸어둔 전역 행동잠금 동안에는 어떤 슬롯 입력도 받지 않는다(독립 쿨다운 스킬 포함).
		if (self._T.actionLockUntil or 0) > _UtilLogic.ElapsedSeconds then
			log("[SkillManager] 시전 중 - 행동 불가")
			return
		end
		-- (요청) 암살이 진행되는 동안(사라져 있는 내내)은 행동 불가 - 암살 자신(홀드 연속 시전)만 통과시킨다.
		-- 이동은 PlayerControllerComponent를 끄는 것으로 막지만, 스킬 입력은 _InputService를 직접 타므로
		-- 여기서 따로 막아야 한다(다크사이트가 암살 중에 써지던 문제).
		if self._T.assassinateActive == true and slot.name ~= "암살" then
			log("[SkillManager] 암살 중 - 다른 스킬 사용 불가 (" .. tostring(slot.name) .. ")")
			return
		end
		-- (요청) 드래곤 라이딩 탑승 중에는 "이동 외 다른 스킬 사용은 제한"된다.
		-- 드래곤 라이딩 자체(=내리기)만 허용한다. 이동/점프는 조작 자체를 막지 않으므로 그대로 된다.
		if self._T.dragonRideMounted == true and slot.name ~= "드래곤 라이딩" then
			log("[SkillManager] 드래곤 라이딩 탑승 중 - 다른 스킬 사용 불가")
			return
		end
		-- (요청 2026-08-11) 마법사(썬콜/불독/비숍)의 **모든 공격 스킬은 공중에서 시전할 수 없다.**
		-- 마법 시전은 지팡이를 땅에 딛고 외우는 그림이라 점프 중 난사가 어색하고, 점프 시전은
		-- 복제 위치 지연 헛빵의 단골이기도 하다. 소환/버프/힐/텔레포트는 대상이 아니다.
		local mageAirBlock = {
			["매직클로"] = true, ["매직 미사일"] = true,
			["썬더볼트"] = true, ["체인라이트닝"] = true, ["블리자드"] = true,
			["파이어에로우"] = true, ["포이즌 미스트"] = true, ["익스플로젼"] = true, ["메테오"] = true,
			["홀리 에로우"] = true, ["샤이닝 레이"] = true, ["엔젤레이"] = true, ["제네시스"] = true,
		}
		if mageAirBlock[slot.name] == true then
			local airPlayer = _UserService.LocalPlayer
			local airRb = isvalid(airPlayer) and airPlayer.RigidbodyComponent or nil
			if isvalid(airRb) and not airRb:IsOnGround() then
				log("[SkillManager] " .. slot.name .. ": 공중 시전 불가 (지상에서만)")
				return
			end
		end
		-- (요청 2026-08-05) 드래곤 로어는 사용에 필요한 HP가 모자라면 아예 쓸 수 없다.
		-- 소모량 = 최대 HP × 투자 레벨별 소모율(1레벨 70% ~ 마스터 41%)이고, 예전에는 현재 HP가
		-- 모자라도 HP를 1까지 깎으며 무조건 시전됐다(PlayerAttack.AttackDragonRoar의 max(...,1)).
		-- 서버에도 같은 게이트가 있으니 여기서는 "헛 시전 + 연출/쿨다운 소모"만 막는다.
		-- ⚠ 이 스킬은 홀드 지속 시전 목록(OnUpdate)에 있어 HP가 모자란 채로 키를 누르고 있으면
		-- 매 프레임 이 분기를 탄다 - 토스트/로그는 1초에 한 번만 낸다.
		if slot.name == "드래곤 로어" then
			local roarPlayer = _UserService.LocalPlayer
			local roarPc = isvalid(roarPlayer) and roarPlayer.PlayerComponent or nil
			if isvalid(roarPc) and (roarPc.MaxHp or 0) > 0 then
				local roarGateLv = math.max(1, self:GetHeroSkillLevelByName("드래곤 로어"))
				local roarCost = math.floor(roarPc.MaxHp * (self:GetDragonRoarHpCostPercent(roarGateLv) / 100))
				if roarPc.Hp <= roarCost then
					local nowRoar = _UtilLogic.ElapsedSeconds
					if (self._T.roarHpWarnUntil or 0) <= nowRoar then
						self._T.roarHpWarnUntil = nowRoar + 1.0
						_UIToast:ShowMessage("HP가 부족해 드래곤 로어를 사용할 수 없습니다.")
						log("[SkillManager] 드래곤 로어: HP 부족 - 사용 불가(필요 " .. tostring(roarCost + 1)
							.. ", 현재 " .. tostring(math.floor(roarPc.Hp)) .. "/" .. tostring(math.floor(roarPc.MaxHp)) .. ")")
					end
					return
				end
			end
		end
		-- (요청 2026-08-05) "어드밴스드 스피어 버스터"는 사용해도 **이펙트 아트만** ON/OFF 토글된다.
		-- 데미지 보너스(분배당 최소 +5%p / 최대 +10%p)는 토글과 무관하게 투자 레벨만으로 항상 적용되므로
		-- 여기서는 연출 상태만 바꾼다. OFF면 안 배운 것처럼 원래 스피어 버스터 이펙트로 나간다.
		-- 공격 스킬이 아니라 상태 토글이므로 쿨다운/전투 로직을 타지 않고 즉시 반환한다.
		if slot.name == "어드밴스드 스피어 버스터" then
			local on = _CharInfoManager:ToggleAdvancedSpearBusterEffect()
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] 어드밴스드 스피어 버스터 강화 이펙트 → " .. (on and "ON" or "OFF") .. " (데미지 보너스는 항상 적용)")
			return
		end
		-- ⚠ (요청 2026-08-06) "에로우 블로우 강화"의 ON/OFF 토글 분기는 폐지했다 - 이제 패시브라
		--   퀵슬롯에 올릴 수 없고(IsPassiveSkillName), 투자만 하면 폭발이 항상 켜져 있다.
		-- (요청 2026-08-05) 암행(2차)은 ON/OFF 토글 → **지속시간 버프**로 바뀌었다.
		--   · 지속시간 1레벨 1분 + 분배 1포인트당 10초 (마스터 20 = 4분 10초)
		--   · 남은 시간은 우측 상단 버프바에 표시된다(AmhaengBuffUI). 아이콘 우클릭으로 조기 해제.
		--   · 지속 중 다시 쓰면 지속시간이 갱신된다(다른 버프와 같은 규칙 - 중첩되지 않는다).
		-- 발동 판정은 서버(PlayerAttack)라 켜고 끌 때마다 RPC로 서버에도 반영한다.
		if slot.name == "암행" then
			-- (요청 2026-08-14 4차) MP 30 소모. 암행은 재사용 대기시간이 없어 순수 게이트로만 쓰인다.
			if not _MpManager:TryConsumeMp(self:GetAmhaengMpCost()) then
				log("[SkillManager] 암행: MP 부족(필요 " .. tostring(self:GetAmhaengMpCost()) .. ")")
				return
			end
			local amLv = math.max(1, self:GetHeroSkillLevelByName("암행"))
			local amDur = self:GetAmhaengDuration(amLv)
			self:StartAmhaengLocal(amDur, amLv)
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] 암행 사용! (Lv." .. tostring(amLv) .. " 지속 " .. tostring(amDur) .. "초)")
			return
		end
		-- (요청 2026-08-06) 암행2(3차)도 암행1과 **완전히 같은 지속시간 버프**로 바뀌었다.
		--   · 지속시간·발동 확률·한 타당 데미지 전부 암행1의 헬퍼(GetAmhaeng*)를 그대로 쓴다.
		--   · 남은 시간은 우측 상단 버프바에 표시된다(Amhaeng2BuffUI). 아이콘 우클릭으로 조기 해제.
		--   · 지속 중 다시 쓰면 지속시간이 갱신된다(중첩되지 않는다).
		-- 발동 판정(독립 굴림)은 서버 PlayerAttack이므로 켜고 끌 때마다 RPC로 서버에도 반영한다.
		if slot.name == "암행2" then
			-- (요청 2026-08-14 4차) MP 30 소모(암행1과 같은 헬퍼 - 요청 사양이 둘 다 30이다).
			if not _MpManager:TryConsumeMp(self:GetAmhaengMpCost()) then
				log("[SkillManager] 암행2: MP 부족(필요 " .. tostring(self:GetAmhaengMpCost()) .. ")")
				return
			end
			local am2Lv = math.max(1, self:GetHeroSkillLevelByName("암행2"))
			local am2Dur = self:GetAmhaengDuration(am2Lv)
			self:StartAmhaeng2Local(am2Dur, am2Lv)
			local pos2 = self:GetBarPosForKey(key)
			if pos2 ~= "" then self:BlinkSlotReady(pos2) end
			log("[SkillManager] 암행2 사용! (Lv." .. tostring(am2Lv) .. " 지속 " .. tostring(am2Dur) .. "초)")
			return
		end
		-- (요청 2026-08-06) 백스탭은 **패시브**가 됐다 - 배우기만 하면 항상 발동하고 퀵슬롯에 올릴 수
		-- 없다(IsPassiveSkillName). 시전 분기 자체가 사라졌으므로 여기서는 아무것도 하지 않는다.
		-- (요청) 다크사이트(1차): 은신 버프 토글.
		--   · 이미 켜져 있으면 → 그냥 풀린다. 이것은 "스킬을 사용한 것"이 아니므로 쿨타임 게이트를
		--     확인하지도 않고, 새 쿨타임을 걸지도 않는다(요청 사양).
		--   · 꺼져 있으면 → 쿨타임 확인 후 시전. 최대 160초 유지.
		-- (섀도어 개편 2026-08-06) 마스터 20 spendable - 쿨타임 30초에서 분배당 -1초(마스터 11초),
		--   은신 중 이동 속도 30%에서 분배당 +1%p(마스터 49%). 공식은 GetDarkSight* 헬퍼 한 곳에서 나온다.
		if slot.name == "다크사이트" then
			local nowDS = _UtilLogic.ElapsedSeconds
			if self:IsDarkSightActive() then
				self:CancelDarkSightEarly()
				return
			end
			local inAuraDS = self:IsInRecoveryAura()
			if (self._T.darkSightCooldownUntil or 0) > nowDS and not inAuraDS then
				log("[SkillManager] 다크사이트: 쿨타임 중(" .. tostring(math.ceil(self._T.darkSightCooldownUntil - nowDS)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-14 4차) MP 10 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			--   위의 "이미 켜져 있으면 그냥 풀린다" 분기보다 뒤에 둔다 - 해제는 시전이 아니라 무료다.
			if not _MpManager:TryConsumeMp(self:GetDarkSightMpCost()) then
				log("[SkillManager] 다크사이트: MP 부족(필요 " .. tostring(self:GetDarkSightMpCost()) .. ")")
				return
			end
			local dsLv = math.max(1, self:GetHeroSkillLevelByName("다크사이트"))
			local dsCd = self:ApplyCooldownReduction(self:GetDarkSightCooldown(dsLv))
			local dsSpeed = self:GetDarkSightSpeedMult(dsLv)
			if not inAuraDS then
				self._T.darkSightCooldownUntil = nowDS + dsCd
				local dsBarPos = self:GetBarPosForKey(key)
				if dsBarPos ~= "" then
					_DarkSightCooldownUI:ShowCooldown(dsCd, dsBarPos)
				end
			end
			self:StartDarkSightLocal()
			self:RequestFireDarkSightLv(dsSpeed)
			log("[SkillManager] 다크사이트 사용(Lv." .. tostring(dsLv) .. " 최대 160초, 이동속도 "
				.. tostring(math.floor(dsSpeed * 100 + 0.5)) .. "%, 공격 시 2배+크리티컬 후 해제, 쿨타임 "
				.. tostring(math.floor(dsCd)) .. "초)")
			return
		end
		-- (요청) 매직 에로우 3종(빛/얼음/불, 3차)도 동일한 ON/OFF 토글 스킬이다. 켜면 매직 미사일의
		-- 색이 속성색으로 바뀌고 데미지가 2배가 된다. 세 속성은 배타적 - 하나를 켜면 나머지는 꺼진다.
		if slot.name == "매직 에로우(빛)" or slot.name == "매직 에로우(얼음)" or slot.name == "매직 에로우(불)" then
			local element = "light"
			if slot.name == "매직 에로우(얼음)" then
				element = "ice"
			elseif slot.name == "매직 에로우(불)" then
				element = "fire"
			end
			local on = _CharInfoManager:ToggleMagicMissileElement(element)
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] " .. slot.name .. " 스킬 사용 → " .. (on and "ON" or "OFF"))
			return
		end
		-- (새 대쉬=질주) 러시 스킬: 방향키(좌/우)를 누르고 있으면 질주 진입, 아니면 아무 일도 안 함. 쿨다운/RPC 없음.
		if slot.name == "러시" then
			self:TryEnterSprintFromSkill()
			return
		end
		-- (더블 점프) 주 조작은 "공중에서 점프키 한 번 더"(OnKeyDown)지만, 배정된 퀵슬롯 키로도
		-- 똑같이 쓸 수 있게 한다. 공중이 아니거나 쿨타임 중이면 TryDoubleJump가 알아서 무시한다.
		if slot.name == "더블 점프" then
			self:TryDoubleJump()
			return
		end
		-- (플래시 점프) 더블 점프와 같은 관례 - 주 조작은 "공중에서 점프키 한 번 더"지만 배정된 퀵슬롯
		-- 키로도 쓸 수 있다. 공중이 아니거나 이미 이번 체공에서 썼으면 TryFlashJump가 알아서 무시한다.
		if slot.name == "플래시 점프" then
			self:TryFlashJump()
			return
		end
		-- (속사) 키를 누르고 있는 동안 계속 발사되는 지속 스킬. 여기서는 연사를 "시작"만 하고,
		-- 실제 발사 간격(0.5초)·조준 각도 보간·종료 판정은 OnUpdate의 RapidFireTick이 담당한다.
		-- 이미 연사 중이면 StartRapidFire가 그냥 무시하므로 KeyDown 반복이 들어와도 안전하다.
		if slot.name == "속사" then
			self:StartRapidFire(key)
			return
		end
		-- (폭풍의 시) 키를 누르고 있는 동안 0.1초마다 화살이 계속 나가는 홀드 연사 스킬. 속사와 같은
		-- 구조로 여기서는 연사를 "시작"만 하고, 발사 간격(0.1초)·종료 판정은 OnUpdate의 HurricaneTick이
		-- 담당한다. 이미 연사 중이면 StartHurricane이 그냥 무시하므로 KeyDown 반복이 들어와도 안전하다.
		if slot.name == "폭풍의 시" then
			self:StartHurricane(key)
			return
		end
		-- (스나이핑) 키를 누르고 있으면 게이지를 채우고 떼면 발사하는 차지 스킬. 여기서는 차지를
		-- "시작"만 하고, 게이지 누적·단계 전환·발사는 OnUpdate의 SnipingTick이 담당한다.
		if slot.name == "스나이핑" then
			self:StartSniping(key)
			return
		end
		-- (피어싱) 스나이핑과 같은 차지 스킬 - 여기서는 차지를 "시작"만 하고, 게이지 누적과 발사는
		-- OnUpdate의 PiercingTick이 담당한다(완충 1초).
		if slot.name == "피어싱" then
			self:StartPiercing(key)
			return
		end
		-- (체인샷) 한 키가 상황에 따라 둘로 갈린다.
		--  ① 박혀 있는 체인이 있고 유지 창이 살아있으면 → 그 각도로 당겨져 날아간다
		--  ② 아니면 → 새 체인을 8방향으로 발사한다
		-- 키를 누르고 있으면 KeyDown이 반복되므로, 발사 직후 잠깐(0.3초)은 당기기로 넘어가지 않게 막는다.
		-- ⚠ (신고 2026-08-13) 그런데 이 0.3초가 **손으로 빠르게 두 번 누른 진짜 두 번째 입력까지** 통째로
		--   삼켜서(아래 "연타 무시" return) 아무 일도 일어나지 않는 사고가 있었다. 키를 뗐다가 다시 누른
		--   경우는 자동 반복이 아니므로 유예를 건너뛴다 - 판정은 "발사 뒤에 키를 뗀 적이 있는가"다
		--   (자동사냥은 실제 키 입력이 없어 이 값이 갱신되지 않으므로 종전대로 0.3초 유예를 탄다).
		if slot.name == "체인샷" then
			local nowChain = _UtilLogic.ElapsedSeconds
			local releasedSinceFire = (self._T.chainKeyUpAt or 0) > (self._T.chainFiredAt or 0)
			local pullReady = releasedSinceFire or (self._T.chainPullReadyAt or 0) <= nowChain
			if (self._T.chainAnchoredUntil or 0) > nowChain and pullReady then
				self._T.chainAnchoredUntil = 0
				self:RequestChainShotPull(self:GetEffectiveCombatPower())
				-- (요청 2026-08-13) 쿨타임은 **당겨져 날아간 이 시점부터** 5초다(종전엔 체인을 쏜 시점부터).
				self:StartChainShotCooldown()
				log("[SkillManager] 체인샷 당기기 - 재사용 대기 " .. tostring(self:GetChainShotCooldown()) .. "초 시작")
				return
			end
			if (self._T.chainAnchoredUntil or 0) > nowChain then return end   -- 발사 직후 연타 무시
			if self._T.skillOnCooldown then return end
			-- (요청 2026-07-28) 체인샷 자체 쿨타임(새 체인 발사 기준 - 박힌 체인 당기기는 예외).
			-- (요청 2026-08-10) 2초 → **5초**. 쿨타임은 퀵슬롯에 표기한다(블리자드와 같은 방식 - ChainShotCooldownUI).
			-- (요청 2026-08-13) 쿨타임 **시작 시점**을 발사 → **당겨져 날아간 순간**으로 옮겼다 -
			--   여기서는 "돌고 있는 쿨타임인가"만 보고, 거는 것은 StartChainShotCooldown 한 곳이 한다.
			local inAuraChain = self:IsInRecoveryAura()
			if (self._T.chainShotCooldownUntil or 0) > nowChain and not inAuraChain then
				log("[SkillManager] 체인샷: 쿨타임 중")
				return
			end
			-- (요청 2026-08-13) MP 10 소모. **새 체인을 쏠 때만** - 위쪽 "당기기" 분기는 이미 return했다.
			if not _MpManager:TryConsumeMp(self:GetChainShotMpCost()) then
				log("[SkillManager] 체인샷: MP 부족(필요 " .. tostring(self:GetChainShotMpCost()) .. ")")
				return
			end
			-- 이번 발사 시각을 남긴다 - 위 "키를 뗐다 다시 눌렀는가"(상승 엣지) 판정의 기준점이다.
			self._T.chainFiredAt = nowChain
			-- 이번 체인의 쿨타임은 아직 안 걸렸다(당기기 / 빗나감 / 유지시간 만료 중 하나에서 걸린다).
			self._T.chainCooldownCharged = false
			local atkMultChain = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.5 * atkMultChain)
			-- 8방향 조준(아이언 에로우와 동일한 입력 처리). 아무 방향키도 안 눌렸으면 바라보는 쪽.
			local cdx, cdy = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				cdx = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				cdx = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				cdy = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				cdy = -1
			end
			-- (M2 자동사냥, 요청 2026-08-06) 체인샷은 신궁 자동사냥의 이동기다 - 방향키 입력이 없고
			-- 자동사냥 중이면 대상 쪽(수평+수직) 조준을 그대로 쓴다(아이언 에로우/어벤져와 같은 관례).
			if cdx == 0 and cdy == 0 and _AutoHuntManager:IsActive() then
				cdx = _AutoHuntManager:GetAimDirX()
				cdy = _AutoHuntManager:GetAimDirY()
			end
			self:RequestFireChainShot(self:GetEffectiveCombatPower(), atkMultChain, cdx, cdy)
			log("[SkillManager] 체인샷 발사 dir=(" .. tostring(cdx) .. "," .. tostring(cdy) .. ")")
			return
		end
		-- (궁병 지원) 30초 지속 지원 사격. 자체 쿨타임 2분 + 퀵슬롯 표기.
		if slot.name == "궁병 지원" then
			local nowArcher = _UtilLogic.ElapsedSeconds
			local inAuraArcher = self:IsInRecoveryAura()
			if (self._T.archerSupportCooldownUntil or 0) > nowArcher and not inAuraArcher then
				log("[SkillManager] 궁병 지원: 쿨타임 중")
				return
			end
			if not inAuraArcher then
				self._T.archerSupportCooldownUntil = nowArcher + self:ApplyCooldownReduction(120.0)
				local archerBarPos = self:GetBarPosForKey(key)
				if archerBarPos ~= "" then
					_ArcherSupportCooldownUI:ShowCooldown(120.0, archerBarPos)
				end
			end
			-- (요청 2026-08-12 2차) 화살당 데미지 = 전투력 90~120%에서 분배당 최소/최대 각 +4%p (마스터 20).
			local archerLv = math.max(1, self:GetHeroSkillLevelByName("궁병 지원"))
			self:RequestFireArcherSupport(self:GetEffectiveCombatPower(), archerLv)
			log("[SkillManager] 궁병 지원 사용(Lv." .. tostring(archerLv) .. ", 화살당 "
				.. tostring(math.floor(self:GetArcherSupportMinPercent(archerLv))) .. "~"
				.. tostring(math.floor(self:GetArcherSupportMaxPercent(archerLv))) .. "%)")
			return
		end
		-- (샤이닝 레이) 주변 전방위(드래곤 로어의 절반 범위) 최대 30명 광역 공격. 자체 쿨타임 1분 + 퀵슬롯 표기.
		if slot.name == "샤이닝 레이" then
			local nowShining = _UtilLogic.ElapsedSeconds
			local inAuraShining = self:IsInRecoveryAura()
			if (self._T.shiningRayCooldownUntil or 0) > nowShining and not inAuraShining then
				log("[SkillManager] 샤이닝 레이: 쿨타임 중")
				return
			end
			-- (비숍 개편 2026-08-08) 마스터 20 spendable - 데미지 1000%~1500%에서 분배당 최소·최대 +30%p,
			-- 쿨타임 60초에서 분배당 -1초. 공식은 GetShiningRay* 헬퍼 한 곳에서 나온다.
			local srLv = math.max(1, self:GetHeroSkillLevelByName("샤이닝 레이"))
			-- (요청 2026-08-13 2차) MP 100 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetShiningRayMpCost()) then
				log("[SkillManager] 샤이닝 레이: MP 부족(필요 " .. tostring(self:GetShiningRayMpCost()) .. ")")
				return
			end
			local srCd = self:ApplyCooldownReduction(self:GetShiningRayCooldown(srLv))
			if not inAuraShining then
				self._T.shiningRayCooldownUntil = nowShining + srCd
				local shiningBarPos = self:GetBarPosForKey(key)
				if shiningBarPos ~= "" then
					_ShiningRayCooldownUI:ShowCooldown(srCd, shiningBarPos)
				end
			end
			local atkMultShining = _CharInfoManager:GetAttackSpeedMultiplier()
			self:RequestFireShiningRayLv(self:GetEffectiveCombatPower(), atkMultShining,
				self:GetShiningRayMinPercent(srLv) / 100, self:GetShiningRayMaxPercent(srLv) / 100)
			log("[SkillManager] 샤이닝 레이 사용(Lv." .. tostring(srLv) .. " 주변 최대 30명, "
				.. tostring(math.floor(self:GetShiningRayMinPercent(srLv))) .. "%~"
				.. tostring(math.floor(self:GetShiningRayMaxPercent(srLv))) .. "%, 쿨타임 "
				.. tostring(math.floor(srCd)) .. "초)")
			return
		end
		-- (리스토네이션) 자기 자신 최대 HP 50% 회복. 자체 쿨타임 10초 + 퀵슬롯 표기(블리자드 방식).
		if slot.name == "리스토네이션" then
			local nowRestore = _UtilLogic.ElapsedSeconds
			local inAuraRestore = self:IsInRecoveryAura()
			if (self._T.restorationCooldownUntil or 0) > nowRestore and not inAuraRestore then
				log("[SkillManager] 리스토네이션: 쿨타임 중")
				return
			end
			-- (요청 2026-08-12 2차) MP 50 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetRestorationMpCost()) then
				log("[SkillManager] 리스토네이션: MP 부족(필요 " .. tostring(self:GetRestorationMpCost()) .. ")")
				return
			end
			if not inAuraRestore then
				-- (개편) 쿨타임 30초, 초당 회복량 = 분배 포인트 × 1% (마스터 10 = 초당 10%)
				local restoreCd = self:ApplyCooldownReduction(30.0)
				self._T.restorationCooldownUntil = nowRestore + restoreCd
				local restoreBarPos = self:GetBarPosForKey(key)
				if restoreBarPos ~= "" then
					_RestorationCooldownUI:ShowCooldown(restoreCd, restoreBarPos)
				end
			end
			local restoreLv = math.max(1, self:GetHeroSkillLevelByName("리스토네이션"))
			self:RequestFireRestoration(restoreLv)
			-- (요청 2026-08-12 2차) 회복이 도는 5초 동안 우측 상단 버프바에 지속시간을 띄운다
			-- (서버 PlayerAttack.AttackRestoration의 5회 × 1초와 같은 길이 - 한쪽만 바꾸면 어긋난다).
			_RestorationBuffUI:ShowBuff(self:GetRestorationBuffDuration())
			log("[SkillManager] 리스토네이션 사용(5초간 초당 최대HP " .. tostring(restoreLv) .. "%씩, 쿨타임 30초)")
			return
		end
		-- (섬광) 체인샷과 같은 8방향 조준이지만 단발 - 검을 던지고 자동으로 돌진까지 이어진다.
		if slot.name == "섬광" then
			if self._T.skillOnCooldown then return end
			-- (스킬 효과 개편) 섬광 자체 쿨타임 = 투자 레벨 비례 10초 → 3초 (마스터 5). 퀵슬롯 표기 동일.
			local nowFlash = _UtilLogic.ElapsedSeconds
			local inAuraFlash = self:IsInRecoveryAura()
			if (self._T.flashCooldownUntil or 0) > nowFlash and not inAuraFlash then
				log("[SkillManager] 섬광: 쿨타임 중")
				return
			end
			if not inAuraFlash then
				local flashCd = self:GetFlashCooldownForLevel(self:GetHeroSkillLevelByName("섬광"))
				self._T.flashCooldownUntil = nowFlash + flashCd
				local flashBarPos = self:GetBarPosForKey(key)
				if flashBarPos ~= "" then
					_FlashCooldownUI:ShowCooldown(flashCd, flashBarPos)
				end
			end
			local atkMultFlash = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.5 * atkMultFlash)
			local fdx, fdy = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				fdx = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				fdx = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				fdy = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				fdy = -1
			end
			-- (M2 자동사냥) 방향키 입력이 없고 자동사냥 중이면 "적 쪽 방향키를 누르고 쓴 것처럼"
			-- 현재 대상 방향(수평+수직)을 조준으로 넣는다 - 무조준(0,0)의 48방향 자동 벽 탐색 대신
			-- 적 쪽(위아래 발판 포함)으로 날아간다.
			if fdx == 0 and fdy == 0 and _AutoHuntManager:IsActive() then
				fdx = _AutoHuntManager:GetAimDirX()
				fdy = _AutoHuntManager:GetAimDirY()
			end
			-- 장착 무기 RUID는 클라이언트에서만 정확히 읽힌다(장비 적용이 클라 CostumeManager라 서버 GetEquip은
			-- 빈 문자열) - 시전 시점에 읽어 서버로 함께 넘긴다. 두손무기 우선, 없으면 한손무기.
			local weaponRuid = ""
			local lpForFlash = _UserService.LocalPlayer
			if isvalid(lpForFlash) then
				local costumeForFlash = lpForFlash.CostumeManagerComponent
				if isvalid(costumeForFlash) then
					weaponRuid = costumeForFlash:GetEquip(MapleAvatarItemCategory.TwoHandedWeapon) or ""
					if weaponRuid == "" then
						weaponRuid = costumeForFlash:GetEquip(MapleAvatarItemCategory.OneHandedWeapon) or ""
					end
				end
			end
			self:RequestFireFlash(self:GetEffectiveCombatPower(), atkMultFlash, fdx, fdy, weaponRuid)
			log("[SkillManager] 섬광 발사 dir=(" .. tostring(fdx) .. "," .. tostring(fdy) .. ") weapon=" .. tostring(weaponRuid))
			return
		end
		-- 속사 중에 다른 스킬을 누르면 연사를 먼저 끝낸다(질주와 같은 처리 - 이동 잠금이 남지 않게).
		if self._T.rapidFireActive == true then
			self:EndRapidFire()
		end
		-- 폭풍의 시 연사 중에 다른 스킬을 눌러도 같은 처리로 연사를 먼저 끝낸다.
		if self._T.hurricaneActive == true then
			self:EndHurricane()
		end
		-- 스나이핑/피어싱 차지 중에 다른 스킬을 누르면 차지를 취소한다(발사 없이 정리).
		if self._T.snipingActive == true then
			self:CancelSniping()
		end
		if self._T.piercingActive == true then
			self:CancelPiercing()
		end
		-- (요청) 질주 중 다른 스킬을 누르면 제자리로 돌아가지 않고 즉시 그 스킬을 발동한다 - 먼저 질주만 해제한다.
		if self._T.sprintActive == true then
			self:EndSprint()
		end
		-- 캐릭터 정보창의 실제 크리티컬 확률(장비 잠재능력 반영)을 스킬 사용 시마다 서버로 동기화한다 -
		-- CalcCritical은 서버에서만 실행되고 장비/인벤토리는 클라이언트 전용 상태라, combatPower와
		-- 동일한 이유로 매 시전 직전에 최신값을 넘겨줘야 한다.
		local localPlayerForCrit = _UserService.LocalPlayer
		local paForCrit = isvalid(localPlayerForCrit) and localPlayerForCrit:GetComponent(PlayerAttack) or nil
		if paForCrit ~= nil then
			paForCrit:SyncCritRate(self:GetEffectiveCritRate())
			paForCrit:SyncCritDamage(_CharInfoManager:CalcCritDamage())
			paForCrit:SyncCombatPower(self:GetEffectiveCombatPower())
		end
		if slot.name == "HP포션" then
			-- (유실 방지) 힐 진행 중이면 서버가 거부하는데 슬롯만 먼저 비워져 포션이 유실됐다 -
			-- 공용 게이트(TryUsePotion)가 수락한 경우에만 슬롯을 비운다.
			if not _PotionShopManager:TryUsePotion() then return end
			self._T.slotData[key] = { ruid = "", name = "" }
			local potPos = self:GetBarPosForKey(key)
			if potPos ~= "" then self:UpdateBarSlotVisual(potPos) end
			_KeySettingManager:NotifyHotkeysChanged()
			log("[SkillManager] HP포션 사용 키=" .. key)
			-- 포션 사용으로 슬롯이 비워지는 것도 단축키 변경이므로 저장 예약
			_CharacterPersistence:MarkDirty("hotkey")
			return
		end
		if slot.name == "텔레포트" then
			-- (버그 수정) 사다리에 매달린 상태(CLIMB/LADDER)·사망 상태에서는 발동 자체를 막는다.
			-- 이 가드가 MP 소모·쿨타임 세팅보다 먼저 와야, "매달린 채 눌러도 이동은 안 되면서 쿨타임/MP만
			-- 먹던" 문제가 없다(다른 스킬들의 CLIMB/LADDER 게이트와 동일한 관례).
			local tpPlayerGuard = _UserService.LocalPlayer
			if isvalid(tpPlayerGuard) then
				local tpScGuard = tpPlayerGuard.StateComponent
				if isvalid(tpScGuard) and (tpScGuard.CurrentStateName == "DEAD" or tpScGuard.CurrentStateName == "CLIMB" or tpScGuard.CurrentStateName == "LADDER") then
					return
				end
			end
			-- 텔레포트는 다른 스킬들의 공용 쿨다운(skillOnCooldown)과 무관하게 독립된 쿨다운으로 동작한다 -
			-- 다른 스킬의 모션 재생/딜레이 중이라도 텔레포트는 사용할 수 있어야 한다는 요청 반영. 공용
			-- skillOnCooldown 게이트보다 먼저 확인/처리하고, 공용 플래그를 건드리지 않은 채 여기서 끝낸다.
			local inAuraTp = self:IsInRecoveryAura()
			if self._T.teleportOnCooldown and not inAuraTp then return end
			-- (비숍 개편 2026-08-08) 텔레포트는 이 게임 최초의 **MP 소모 스킬**이다. 소모량은
			-- 1레벨 10에서 분배 1포인트당 -1(마스터 10에서 1) - GetTeleportMpCost 한 곳에서 나온다.
			-- ⚠ MP가 모자라면 쿨타임을 걸지 않고 그대로 돌아간다(쿨타임만 먹고 안 나가는 일이 없도록
			--   소모 판정을 쿨타임 세팅보다 먼저 한다).
			local tpLv = math.max(1, self:GetHeroSkillLevelByName("텔레포트"))
			if not _MpManager:TryConsumeMp(self:GetTeleportMpCost(tpLv)) then
				log("[SkillManager] 텔레포트: MP 부족(필요 " .. tostring(self:GetTeleportMpCost(tpLv)) .. ")")
				return
			end
			log("[SkillManager] 스킬 사용: " .. slot.name .. " (단축키: " .. key .. ")")
			-- 방향키 입력 상태는 클라이언트에서만 알 수 있다(_InputService:IsKeyPressed는 ClientOnly) - 여기서 확인해 서버로 전달한다.
			-- 위/아래를 좌우보다 우선한다: 위나 아래 화살표를 누르고 있으면 수직 텔레포트를, 아니면 좌/우(눌린 게 없으면 현재 바라보는 방향)로 이동한다.
			local dirKey = "right"
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirKey = "up"
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirKey = "down"
			elseif _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirKey = "left"
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirKey = "right"
			else
				-- (썬콜 자동사냥 2026-08-08) 방향키 입력이 없으면 자동사냥 조준값을 방향키처럼 읽는다
				-- (체인샷의 GetAimDirX/Y 대체 입력과 같은 관례). 위/아래 조준(|dy|≥1.2 대상)이면 수직
				-- 텔레포트, 아니면 좌우는 아래 LookDirectionX 폴백이 그대로 처리한다(자동사냥이 시전 직전
				-- 대상 쪽으로 맞춰 둔다).
				local autoAimY = 0
				if _AutoHuntManager:IsActive() then autoAimY = _AutoHuntManager:GetAimDirY() end
				if autoAimY > 0 then
					dirKey = "up"
				elseif autoAimY < 0 then
					dirKey = "down"
				else
					local localPlayer = _UserService.LocalPlayer
					local ctrl = isvalid(localPlayer) and localPlayer.PlayerControllerComponent or nil
					if isvalid(ctrl) then
						dirKey = (ctrl.LookDirectionX >= 0) and "right" or "left"
					end
				end
			end
			if not inAuraTp then
				self._T.teleportOnCooldown = true
				-- (피드백) "너무 연속해서 빠르게 사용된다" - 재사용 대기시간 1.2배(0.45 → 0.54초).
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.teleportCdGen = (self._T.teleportCdGen or 0) + 1
				local teleportGen = self._T.teleportCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.teleportCdGen ~= teleportGen then return end
					self._T.teleportOnCooldown = false
				end, 0.54)
			end
			self:RequestFireTeleport(dirKey)
			return
		end
		if slot.name == "어썰터" then
			-- (기능 변경) 어썰터는 스택형 충전 스킬 - 3초마다 스택이 1개씩 차고(최대 3개), 스택이 1개
			-- 이상이면 언제든 사용할 수 있다. 사용 시 스택 1개 소모 (요청사항).
			-- assaulterCastActive: 시전 진행 중(사라짐~착지 사이)에는 재시전 불가 - 착지 즉시
			-- (OnAssaulterChainReady) 풀려서 딜레이 없이 연속 시전된다.
			-- "사거리 내 타겟이 없으면 사용이 되지 않아야 한다"는 기존 동작 유지 - 서버가 대상 존재를
			-- 확인한 뒤(PlayerAttack.NotifyAssaulterResult) 성공시에만 스택을 소모한다.
			-- (섀도어 개편 2026-08-06) 마스터 30 spendable - 스택 충전 시간이 레벨에 따라 10→5초로 줄어든다.
			-- (요청 2026-08-14 4차) 대상당 데미지는 자체 곡선 200%~220% + 분배당 4%p(GetAssaulterMin·MaxPercent).
			if self._T.assaulterStacks <= 0 or self._T.assaulterRequestPending or self._T.assaulterCastActive then return end
			-- (요청 2026-08-14 4차) MP 30 소모. ⚠ 스택/재시전 게이트를 모두 통과한 뒤에 뺀다 - 게이트에
			--   걸려 아무 일도 일어나지 않았는데 MP만 빠지는 것을 막는다(파워스트라이크와 같은 순서 원칙).
			if not _MpManager:TryConsumeMp(self:GetAssaulterMpCost()) then
				log("[SkillManager] 어썰터: MP 부족(필요 " .. tostring(self:GetAssaulterMpCost()) .. ")")
				return
			end
			log("[SkillManager] 스킬 사용 요청: " .. slot.name .. " (단축키: " .. key .. ")")
			self._T.assaulterRequestPending = true
			self._T.assaulterPendingKey = key
			-- 서버 응답이 비정상적으로 늦어지는 경우를 대비한 안전장치 - 최대 1초 뒤 자동으로 다시 시도 가능하게 한다.
			_TimerService:SetTimerOnce(function()
				self._T.assaulterRequestPending = false
			end, 1.0)
			local combatPower = self:GetEffectiveCombatPower()
			local asLv = math.max(1, self:GetHeroSkillLevelByName("어썰터"))
			self:RequestFireAssaulterLv(combatPower,
				self:GetAssaulterMinPercent(asLv) / 100, self:GetAssaulterMaxPercent(asLv) / 100)
			return
		end
		if slot.name == "가드" then
			-- 가드(패링, 개편): 독립 쿨타임 = 30초 - (분배-1)초 (성공 시 5초 단축 유지 - NotifyGuardParrySuccess).
			-- 성공 시 2초 무적 + 10초간 받는 피해 5%×분배 감소. 이펙트/모션 없이 서버에 1.2초 패링 창만 연다.
			local inAuraGuard = self:IsInRecoveryAura()
			if (self._T.guardCooldownUntil or 0) >= _UtilLogic.ElapsedSeconds and not inAuraGuard then return end
			-- (요청 2026-08-12 2차) MP 20 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetGuardMpCost()) then
				log("[SkillManager] 가드: MP 부족(필요 " .. tostring(self:GetGuardMpCost()) .. ")")
				return
			end
			self._T.guardUseAt = _UtilLogic.ElapsedSeconds
			local guardLv = math.max(1, self:GetHeroSkillLevelByName("가드"))
			local guardCd = 30.0 - (guardLv - 1)
			if not inAuraGuard then
				self._T.guardCooldownUntil = self._T.guardUseAt + guardCd
				self._T.guardBarPos = self:GetBarPosForKey(key)
				if self._T.guardBarPos ~= "" then
					_GuardCooldownUI:ShowCooldown(guardCd, self._T.guardBarPos)
				end
			end
			self:RequestFireGuard(guardLv)
			log("[SkillManager] 가드 사용(패링 1.2초, 쿨타임 " .. tostring(guardCd) .. "초, 감소 " .. tostring(5 * guardLv) .. "%)")
			return
		end
		if slot.name == "패링" then
			-- 패링(요청 2026-07-28 개편): 시전 즉시 이펙트/모션이 나가고, 1.5초 안에 공격을 받으면
			-- 가드 표시와 함께 그 데미지를 무시 + 3초 무적. 기본 쿨타임 10초, 가드 성공 시 쿨타임 초기화
			-- (NotifyParrySuccess). 반격 데미지 계산에 쓸 전투력은 여기(클라이언트)에서만 정확히 알 수 있어
			-- 시전 시점에 서버로 넘긴다.
			local inAuraParry = self:IsInRecoveryAura()
			if (self._T.parryCooldownUntil or 0) >= _UtilLogic.ElapsedSeconds and not inAuraParry then return end
			self._T.parryUseAt = _UtilLogic.ElapsedSeconds
			if not inAuraParry then
				self._T.parryCooldownUntil = self._T.parryUseAt + 10.0
				self._T.parryBarPos = self:GetBarPosForKey(key)
				if self._T.parryBarPos ~= "" then
					_ParryCooldownUI:ShowCooldown(10.0, self._T.parryBarPos)
				end
			end
			self:RequestFireParry(self:GetEffectiveCombatPower())
			log("[SkillManager] 패링 사용(가드 창 1.5초, 쿨타임 10초)")
			return
		end
		if slot.name == "차지 블로우" then
			-- 차지 블로우(3차): 자체 쿨타임(퀵슬롯 표시 쿨타임) 없음. 공격 자체는 파워스트라이크와
			-- 완전히 동일하고(같은 모션/판정/데미지/파이널어택 경로를 그대로 태운다) 검 궤적 이펙트만
			-- 디바인 4종으로 정해둔 현재 속성의 전용 아트로 바뀐다.
			-- 연타 방지용 공용 게이트(skillOnCooldown)만 파워스트라이크와 같은 값으로 건다 - 이건
			-- 화면에 표시되는 재사용 대기시간이 아니라 모든 공격 스킬이 쓰는 공용 연타 제한이다.
			-- (요청 개편 2026-08-04) 디바인 속성을 하나도 투자하지 않았으면 차지 블로우 자체를 쓸 수 없다.
			local cbModeNow = self:GetEffectiveChargeBlowMode()
			if cbModeNow == 0 then
				_UIToast:ShowMessage("디바인 속성 스킬을 배워야 차지 블로우를 쓸 수 있습니다.")
				log("[SkillManager] 차지 블로우: 디바인 속성 미투자 - 사용 불가")
				return
			end
			if self._T.skillOnCooldown then return end
			-- (요청 2026-08-12 2차) MP 20 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetChargeBlowMpCost()) then
				log("[SkillManager] 차지 블로우: MP 부족(필요 " .. tostring(self:GetChargeBlowMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (개편) 데미지 = 파스 공식 × 차지 블로우 위력 배율(pendingSkillPowerMult가 이미 적용)
			-- × 현재 속성의 강화 스킬 보너스(분배 1pt당 +2%, 마스터 +40%. 디바인 차지만 +3%/pt).
			local enhBonus = 1.0
			if cbModeNow == 1 then enhBonus = 1 + 0.02 * self:GetHeroSkillLevelByName("디바인 스티그마 강화")
			elseif cbModeNow == 2 then enhBonus = 1 + 0.02 * self:GetHeroSkillLevelByName("디바인 스윙 강화")
			elseif cbModeNow == 3 then enhBonus = 1 + 0.02 * self:GetHeroSkillLevelByName("디바인 저지먼트 강화")
			elseif cbModeNow == 4 then
				-- (요청 2026-08-15) 디바인 차지만 **+3%/pt**로 되돌린다(마스터 20 = +60%). 빛(성)은
				-- 속성 연계에 전혀 참여하지 않는 단일 속성이라(필드도 안 깔리고 소모도 안 된다),
				-- 연계로 장판을 버는 나머지 3종과 같은 +2%/pt면 값이 밀린다.
				enhBonus = 1 + 0.03 * self:GetHeroSkillLevelByName("디바인 차지")
			end
			-- (요청 2026-08-12 2차) 데미지가 **차지 블로우 전용 곡선**으로 독립했다 - 180~240%에서
			-- 분배 1포인트당 최소·최대 각 +4%p(마스터 20 = 256~316%). 종전엔 파워스트라이크 곡선을
			-- 그대로 빌려 썼다("skill.powerstrike" 태그는 판정·모션 공유용이라 그대로 둔다).
			-- 파워스트라이크와 같은 이유로 공용 위력 배율은 끈다(레벨 성장이 배율에 이미 들어가 있어 이중 적용).
			local cbLv = math.max(1, self:GetHeroSkillLevelByName("차지 블로우"))
			self._T.pendingSkillPowerMult = 1.0
			local combatPower = math.floor(self:GetEffectiveCombatPower() * enhBonus)
			-- 속성을 아직 한 번도 안 골랐으면 기본 속성(GetEffectiveChargeBlowMode)으로 나간다.
			self:RequestFireChargeBlowLv(combatPower, atkMult, self:GetWeaponMotionClass(), cbModeNow,
				self:GetChargeBlowMinPercent(cbLv) / 100, self:GetChargeBlowMaxPercent(cbLv) / 100)
			log("[SkillManager] 차지 블로우(" .. self:GetChargeBlowModeName() .. " 상태) 사용 (속성 강화 ×" .. string.format("%.2f", enhBonus) .. ")")
			return
		end
		if self:IsChargeBlowModeSkill(slot.name) then
			-- 디바인 4종(스티그마 강화 / 스윙 강화 / 저지먼트 강화 / 차지): 차지 블로우의 속성을 정하는 스킬.
			-- ① 4개가 공용 0.5초 쿨타임을 함께 쓴다(하나를 쓰면 4개 전부 대기). 요청으로 2초 → 0.5초.
			-- ② 지금 켜져 있는 속성과 같은 스킬은 연속 사용 불가 - 눌러도 아무 반응이 없다.
			-- ③ (요청 2026-08-15) 전환하면 **방금까지 쓰던 속성**만 20초 쿨타임에 들어간다 - 불→얼음이면
			--    불을 20초 동안 다시 들 수 없다. 나머지 속성은 종전대로 공용 0.5초만 받는다.
			local newMode = self:GetChargeBlowModeIndex(slot.name)
			local prevMode = self._T.chargeBlowMode or 0
			if newMode == prevMode then
				log("[SkillManager] " .. slot.name .. ": 이미 적용된 속성 - 연속 사용 불가")
				return
			end
			local now = _UtilLogic.ElapsedSeconds
			local inAuraCb = self:IsInRecoveryAura()
			if (self._T.chargeBlowCooldownUntil or 0) > now and not inAuraCb then
				log("[SkillManager] " .. slot.name .. ": 전환 대기 중(" .. string.format("%.1f", self._T.chargeBlowCooldownUntil - now) .. "초 남음)")
				return
			end
			local modeLeft = self:GetChargeBlowModeCooldownLeft(newMode)
			if modeLeft > 0 and not inAuraCb then
				log("[SkillManager] " .. slot.name .. ": 직전에 쓰던 속성 재사용 대기 중(" .. string.format("%.1f", modeLeft) .. "초 남음)")
				return
			end
			self._T.chargeBlowMode = newMode
			self:RefreshChargeBlowSlotIcon()
			if not inAuraCb then
				self._T.chargeBlowCooldownUntil = now + 0.5
				-- 방금까지 쓰던 속성에 20초 쿨타임을 건다(맨 처음 선택이라 이전 속성이 없으면 건너뜀).
				if prevMode >= 1 and prevMode <= 4 then
					if self._T.chargeBlowModeCdUntil == nil then self._T.chargeBlowModeCdUntil = {} end
					self._T.chargeBlowModeCdUntil[prevMode] = now + self:GetChargeBlowModeCooldown()
				end
				-- 4종이 각각 어느 퀵슬롯에 있든 그 칸들에 쿨타임을 그린다(배정 안 된 건 건너뜀).
				-- 칸마다 길이가 다르다 - 20초가 걸린 칸은 그 잔여를, 나머지는 공용 0.5초를 그린다.
				-- ⚠ names의 순서는 속성 인덱스(1 얼음 / 2 불 / 3 전기 / 4 성)와 반드시 같아야 한다.
				local slots = {}
				local durs = {}
				local names = { "디바인 스티그마 강화", "디바인 스윙 강화", "디바인 저지먼트 강화", "디바인 차지" }
				for i, n in ipairs(names) do
					slots[i] = self:FindBarPosForSkillName(n)
					durs[i] = math.max(0.5, self:GetChargeBlowModeCooldownLeft(i))
				end
				_ChargeBlowCooldownUI:ShowCooldownPerSlot(slots, durs)
			end
			log("[SkillManager] 차지 블로우 속성 변경 → " .. self:GetChargeBlowModeName()
				.. " (직전 속성 " .. tostring(prevMode) .. "은 " .. tostring(self:GetChargeBlowModeCooldown()) .. "초 대기)")
			return
		end
		if slot.name == "드래곤 라이딩" then
			-- 드래곤 라이딩(3차). (요청 2026-08-12 5차) **재사용 대기시간 폐지 + MP 50**.
			-- 한 번의 키가 상황에 따라 3가지로 갈린다.
			--  ① 소환 중 + 탑승 중  → 내리기(하차)
			--  ② 소환 중 + 미탑승   → 탑승(MP를 다시 쓰지 않는다 - 소환에만 든다)
			--  ③ 미소환             → 소환(20초 + 분배당 10초 지속, MP 50)
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.dragonRideActiveUntil or 0) > now then
				-- (요청) 키를 누르고 있으면 탑승 → 해제 → 탑승이 계속 반복된다. 다만 KeyDown 반복은
				-- 초당 수십 번이라 그대로 두면 워프 연출(0.5초)이 끝나기도 전에 뒤집혀 엉킨다.
				-- 한 번 전환하면 1초는 다음 전환을 막아, 연출이 끝난 뒤 또박또박 번갈아 돌게 한다.
				if (self._T.dragonRideToggleUntil or 0) > now then return end
				self._T.dragonRideToggleUntil = now + 1.0
				self:ToggleDragonRide()
				return
			end
			-- (요청 2026-08-12 5차) **재사용 대기시간 폐지**(종전 5분) - MP 50이 유일한 비용이다.
			if not _MpManager:TryConsumeMp(self:GetDragonRideMpCost()) then
				log("[SkillManager] 드래곤 라이딩: MP 부족(필요 " .. tostring(self:GetDragonRideMpCost()) .. ")")
				return
			end
			-- (요청 2026-08-12 5차) 지속 = 20초 + 분배당 10초(마스터 30 = 310초). 종전 2분 30초 + 분배당 20초.
			-- 아래 버프바/만료 예약/서버 소환수 수명이 전부 이 한 값을 쓴다.
			local rdLv = math.max(1, self:GetHeroSkillLevelByName("드래곤 라이딩"))
			local rdDur = self:GetDragonRideDurationForLevel(rdLv)
			self._T.dragonRideActiveUntil = now + rdDur
			self._T.dragonRideMounted = false
			-- (버그 수정 2026-08-05) "소환하자마자 탑승한 상태로 시작한다"는 신고의 원인:
			-- 이 스킬은 홀드 중 탑승↔해제 반복 요청 때문에 상승 엣지 게이팅에서 빠져 있어,
			-- 키를 누르고 있는 동안 KeyDown 자동 반복과 OnUpdate 홀드 루프가 매 프레임 이 메서드를
			-- 다시 부른다. 소환으로 dragonRideActiveUntil이 켜진 **바로 다음 프레임**에 위쪽
			-- "소환 중" 분기로 들어가 탑승 토글이 즉시 발동했다(토글 게이트가 0이라 못 막았다).
			-- 소환 시점에 토글 게이트를 함께 걸어, 소환한 그 누름으로는 절대 탑승하지 않게 한다
			-- (계속 누르고 있으면 1초 뒤부터 기존대로 탑승↔해제가 반복된다).
			self._T.dragonRideToggleUntil = now + 1.0
			-- (요청 2026-08-12 5차) 재사용 대기시간 폐지 - 쿨타임 세팅/퀵슬롯 표기 없음.
			_DragonRidingBuffUI:ShowBuff(rdDur)
			self:SetDragonRideSlotIcon(true)
			-- 소환 만료 처리 예약 - 탑승 중이면 강제로 내리고 퀵슬롯 아이콘을 되돌린다.
			if self._T.dragonRideExpireTimerId ~= nil then
				_TimerService:ClearTimer(self._T.dragonRideExpireTimerId)
			end
			self._T.dragonRideExpireTimerId = _TimerService:SetTimerOnce(function()
				self:OnDragonRideExpired()
			end, rdDur)
			-- (스펙 개편) 드래곤의 공격 배율(150~200% + 분배당 15/20%p)과 지속시간을 투자 레벨로 계산해 넘긴다.
			self:RequestFireRidingDragon(_CharInfoManager:CalcCombatPower(),
				self:GetDragonDamageMinPercent(rdLv) / 100, self:GetDragonDamageMaxPercent(rdLv) / 100, rdDur)
			log("[SkillManager] 드래곤 라이딩 소환! (Lv." .. tostring(rdLv) .. ", 지속 "
				.. tostring(math.floor(rdDur)) .. "초, 쿨타임 5분, 공격 "
				.. tostring(math.floor(self:GetDragonDamageMinPercent(rdLv))) .. "~"
				.. tostring(math.floor(self:GetDragonDamageMaxPercent(rdLv))) .. "%)")
			return
		end
		if slot.name == "프리져" then
			-- 프리져(4차 소환): (요청 2026-08-13) **재사용 대기시간 삭제** - 대신 MP 100이 연타를 막는다.
			-- 소환 중 재시전하면 기존 프리져가 교체된다.
			-- ⚠ 쿨타임이 사라져도 KeyDown 자동 반복으로 한 번 누름에 여러 번 소환되는 것은 막아야 한다 -
			--   용사 소환(DoHeroClassSummon)과 같은 0.5초 재시전 게이트를 둔다(MP 낭비 방지).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.freezerRecastGate or 0) > now then return end
			self._T.freezerRecastGate = now + 0.5
			-- (요청 2026-08-13) MP 100 소모. ⚠ 게이트 통과 후, RPC 전에 소모한다.
			if not _MpManager:TryConsumeMp(self:GetFreezerMpCost()) then
				log("[SkillManager] 프리져: MP 부족(필요 " .. tostring(self:GetFreezerMpCost()) .. ")")
				return
			end
			-- (요청 2026-08-13) 공격 배율(400%~420% + 분배당 최소·최대 5%p)과 지속시간(20초 + 분배당
			-- 10초)을 투자 레벨로 계산해 함께 넘긴다 - 공식은 GetFreezer* 헬퍼 한 곳에서 나온다.
			local frLv = math.max(1, self:GetHeroSkillLevelByName("프리져"))
			local frDur = self:GetFreezerDuration(frLv)
			self:RequestFireFreezerLvDur(_CharInfoManager:CalcCombatPower(),
				self:GetFreezerMinPercent(frLv) / 100, self:GetFreezerMaxPercent(frLv) / 100, frDur)
			log("[SkillManager] 프리져 소환! (Lv." .. tostring(frLv) .. ", 지속 " .. tostring(math.floor(frDur))
				.. "초, 재사용 대기시간 없음, 공격 "
				.. tostring(math.floor(self:GetFreezerMinPercent(frLv))) .. "~" .. tostring(math.floor(self:GetFreezerMaxPercent(frLv))) .. "%)")
			return
		end
		if slot.name == "피닉스" then
			-- 피닉스(4차 소환): (요청 2026-08-13) **재사용 대기시간 삭제** - 프리져와 완전히 같은 규격이
			-- 됐다(데미지·지속시간·MP·무쿨). 대신 MP 100이 연타를 막는다.
			-- 소환 중 재시전하면 기존 피닉스가 교체된다.
			-- ⚠ 쿨타임이 사라져도 KeyDown 자동 반복으로 한 번 누름에 여러 번 소환되는 것은 막아야 한다 -
			--   프리져와 같은 0.5초 재시전 게이트를 둔다(MP 낭비 방지).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.phoenixRecastGate or 0) > now then return end
			self._T.phoenixRecastGate = now + 0.5
			-- (요청 2026-08-13) MP 100 소모(프리져와 같다). ⚠ 게이트 통과 후, RPC 전에 소모한다.
			if not _MpManager:TryConsumeMp(self:GetPhoenixMpCost()) then
				log("[SkillManager] 피닉스: MP 부족(필요 " .. tostring(self:GetPhoenixMpCost()) .. ")")
				return
			end
			-- (요청 2026-08-13) 공격 배율과 지속시간 모두 **프리져와 같은 헬퍼**에서 나온다
			-- (GetPhoenix*Percent / GetPhoenixDuration → 각각 프리져 헬퍼 위임).
			local phLv = math.max(1, self:GetHeroSkillLevelByName("피닉스"))
			local phDur = self:GetPhoenixDuration(phLv)
			self:RequestFirePhoenixLvDur(_CharInfoManager:CalcCombatPower(),
				self:GetPhoenixMinPercent(phLv) / 100, self:GetPhoenixMaxPercent(phLv) / 100, phDur)
			log("[SkillManager] 피닉스 소환! (Lv." .. tostring(phLv) .. ", 지속 " .. tostring(math.floor(phDur))
				.. "초, 재사용 대기시간 없음, 공격 "
				.. tostring(math.floor(self:GetPhoenixMinPercent(phLv))) .. "~" .. tostring(math.floor(self:GetPhoenixMaxPercent(phLv))) .. "%)")
			return
		end
		if slot.name == "바하뮤트" then
			-- 바하뮤트(4차 소환): (요청 2026-08-13 2차) **재사용 대기시간 삭제** - 대신 MP 100(프리져와
			-- 같은 값)이 연타를 막는다. 소환 중 재시전하면 기존 바하뮤트가 교체된다.
			-- ⚠ 쿨타임이 사라져도 KeyDown 자동 반복으로 한 번 누름에 여러 번 소환되는 것은 막아야 한다 -
			--   프리져와 같은 0.5초 재시전 게이트를 둔다(MP 낭비 방지).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.bahamutRecastGate or 0) > now then return end
			self._T.bahamutRecastGate = now + 0.5
			-- (요청 2026-08-13 2차) MP 100 소모. ⚠ 게이트 통과 후, RPC 전에 소모한다(프리져와 같은 순서).
			if not _MpManager:TryConsumeMp(self:GetBahamutMpCost()) then
				log("[SkillManager] 바하뮤트: MP 부족(필요 " .. tostring(self:GetBahamutMpCost()) .. ")")
				return
			end
			-- (요청 2026-08-13 2차) 지속 30초+분배당 10초(마스터 220초)는 그대로이고, 브레스 데미지는
			-- **프리져와 같은 곡선**을 위임받는다(GetBahamut*Percent → GetFreezer*Percent).
			local bhLv = math.max(1, self:GetHeroSkillLevelByName("바하뮤트"))
			local bhDur = self:GetBahamutDuration(bhLv)
			self:RequestFireBahamutLv(_CharInfoManager:CalcCombatPower(), bhDur,
				self:GetBahamutMinPercent(bhLv) / 100, self:GetBahamutMaxPercent(bhLv) / 100)
			-- (요청) 소환 중에는 우측 위 버프바에 남은 지속시간을 띄운다.
			_BahamutBuffUI:ShowBuff(bhDur)
			log("[SkillManager] 바하뮤트 소환! (Lv." .. tostring(bhLv) .. " 지속 " .. tostring(math.floor(bhDur))
				.. "초, " .. tostring(math.floor(self:GetBahamutMinPercent(bhLv))) .. "%~"
				.. tostring(math.floor(self:GetBahamutMaxPercent(bhLv))) .. "%, 재사용 대기시간 없음)")
			return
		end
		if slot.name == "이프리트" then
			-- 이프리트(4차 소환): 엘퀴네스와 같은 규격 - 독립 쿨타임 30초, 재시전 시 교체.
			local now = _UtilLogic.ElapsedSeconds
			local inAuraIfrit = self:IsInRecoveryAura()
			if (self._T.ifritCooldownUntil or 0) > now and not inAuraIfrit then
				log("[SkillManager] 이프리트: 쿨타임 중(" .. tostring(math.ceil(self._T.ifritCooldownUntil - now)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-14) MP 100 소모(프리져와 같다). ⚠ 쿨타임 세팅보다 먼저(파워스트라이크 관례).
			if not _MpManager:TryConsumeMp(self:GetIfritMpCost()) then
				log("[SkillManager] 이프리트: MP 부족(필요 " .. tostring(self:GetIfritMpCost()) .. ")")
				return
			end
			if not inAuraIfrit then
				self._T.ifritCooldownUntil = now + self:ApplyCooldownReduction(30.0)
			end
			-- (요청 2026-08-14) 화염 데미지·지속시간이 **프리져와 완전히 같아졌다**
			-- (GetIfrit*Percent / GetIfritDuration → 각각 프리져 헬퍼 위임).
			local ifLv = math.max(1, self:GetHeroSkillLevelByName("이프리트"))
			local ifDur = self:GetIfritDuration(ifLv)
			self:RequestFireIfritLvDur(_CharInfoManager:CalcCombatPower(),
				self:GetIfritMinPercent(ifLv) / 100, self:GetIfritMaxPercent(ifLv) / 100, ifDur)
			-- (요청 2026-08-11) 소환 중에는 우측 위 버프바에 남은 지속시간을 띄운다.
			_IfritBuffUI:ShowBuff(ifDur)
			log("[SkillManager] 이프리트 소환! (Lv." .. tostring(ifLv) .. " "
				.. tostring(math.floor(self:GetIfritMinPercent(ifLv))) .. "%~"
				.. tostring(math.floor(self:GetIfritMaxPercent(ifLv))) .. "%, 지속 "
				.. tostring(math.floor(ifDur)) .. "초, 재사용 30초)")
			return
		end
		if slot.name == "엘퀴네스" then
			-- 엘퀴네스(4차 소환): 바하뮤트와 같은 규격 - 독립 쿨타임 30초, 소환 중 재시전하면 교체된다.
			local now = _UtilLogic.ElapsedSeconds
			local inAuraElq = self:IsInRecoveryAura()
			if (self._T.elquinesCooldownUntil or 0) > now and not inAuraElq then
				log("[SkillManager] 엘퀴네스: 쿨타임 중(" .. tostring(math.ceil(self._T.elquinesCooldownUntil - now)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-14) MP 100 소모(프리져와 같다). ⚠ 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetElquinesMpCost()) then
				log("[SkillManager] 엘퀴네스: MP 부족(필요 " .. tostring(self:GetElquinesMpCost()) .. ")")
				return
			end
			if not inAuraElq then
				self._T.elquinesCooldownUntil = now + self:ApplyCooldownReduction(30.0)
			end
			-- (요청 2026-08-14) 얼음 데미지·지속시간이 이프리트 = **프리져와 완전히 같다**
			-- (GetElquines* → GetIfrit* → GetFreezer* 위임 사슬).
			local elqLv = math.max(1, self:GetHeroSkillLevelByName("엘퀴네스"))
			local elqDur = self:GetElquinesDuration(elqLv)
			self:RequestFireElquinesLvDur(_CharInfoManager:CalcCombatPower(),
				self:GetElquinesMinPercent(elqLv) / 100, self:GetElquinesMaxPercent(elqLv) / 100, elqDur)
			-- (요청 2026-08-11) 소환 중에는 우측 위 버프바에 남은 지속시간을 띄운다.
			_ElquinesBuffUI:ShowBuff(elqDur)
			log("[SkillManager] 엘퀴네스 소환! (Lv." .. tostring(elqLv) .. " "
				.. tostring(math.floor(self:GetElquinesMinPercent(elqLv))) .. "%~"
				.. tostring(math.floor(self:GetElquinesMaxPercent(elqLv))) .. "%, 지속 "
				.. tostring(math.floor(elqDur)) .. "초, 재사용 30초)")
			return
		end
		-- (비숍 개편 2026-08-08) 소환 3종(용사 2차 / 궁수 3차 / 도적 4차)은 **규격이 완전히 같다** -
		-- 레벨/전투력 환산·지속시간·재소환 교체 규칙이 한 헬퍼(DoHeroClassSummon)에 모여 있고,
		-- 여기서는 계통과 버프바 아이콘만 갈라준다.
		if slot.name == "용사 소환" then
			-- (요청 2026-08-13 2차) 소환 3종이 모두 MP를 쓴다 - 용사 200 / 궁수 200 / 도적 200.
			-- ⚠ 부족 판정(GetCurrentMp)과 실제 차감(TryConsumeMp)을 나눠 둔 이유:
			--   DoHeroClassSummon은 0.5초 연타 게이트에 걸리면 소환하지 않고 false를 돌려주는데,
			--   먼저 차감해 버리면 그 경우 MP만 사라진다. 부족하면 시전 자체를 막고(위), 실제 차감은
			--   소환이 성사된 뒤에 한다(아래). 궁수/도적 소환도 같은 순서다.
			if _MpManager:GetCurrentMp() < self:GetHeroSummonMpCost() then
				log("[SkillManager] 용사 소환: MP 부족(필요 " .. tostring(self:GetHeroSummonMpCost()) .. ")")
				return
			end
			if self:DoHeroClassSummon("용사 소환", "warrior") then
				_MpManager:TryConsumeMp(self:GetHeroSummonMpCost())
				-- 우측 상단 버프바에 소환 지속시간(5분)을 표시한다 - 재소환 시 타이머가 새로 갱신된다.
				_HeroSummonBuffUI:ShowBuff(300)
			end
			return
		end
		if slot.name == "궁수 소환" then
			-- (요청 2026-08-13 2차) MP 200 소모 - 용사 소환과 같은 "부족 판정 → 소환 성사 후 차감" 순서.
			if _MpManager:GetCurrentMp() < self:GetArcherSummonMpCost() then
				log("[SkillManager] 궁수 소환: MP 부족(필요 " .. tostring(self:GetArcherSummonMpCost()) .. ")")
				return
			end
			if self:DoHeroClassSummon("궁수 소환", "archer") then
				_MpManager:TryConsumeMp(self:GetArcherSummonMpCost())
				_ArcherSummonBuffUI:ShowBuff(300)
			end
			return
		end
		if slot.name == "도적 소환" then
			-- (요청 2026-08-13 2차) MP 200 소모 - 용사 소환과 같은 순서.
			if _MpManager:GetCurrentMp() < self:GetThiefSummonMpCost() then
				log("[SkillManager] 도적 소환: MP 부족(필요 " .. tostring(self:GetThiefSummonMpCost()) .. ")")
				return
			end
			if self:DoHeroClassSummon("도적 소환", "thief") then
				_MpManager:TryConsumeMp(self:GetThiefSummonMpCost())
				_ThiefSummonBuffUI:ShowBuff(300)
			end
			return
		end
		if slot.name == "홀리 매직쉘" then
			-- 홀리 매직쉘(4차): 공용 쿨다운과 무관한 독립 쿨타임 2분. 자신 + HP를 가진 아군 소환수
			-- 전원에게 10회 방어 쉴드를 건다(개체마다 각각 10회 - 서버 PlayerAttack.CastHolyMagicShell).
			local now = _UtilLogic.ElapsedSeconds
			local inAuraShell = self:IsInRecoveryAura()
			if (self._T.holyShellCooldownUntil or 0) > now and not inAuraShell then
				log("[SkillManager] 홀리 매직쉘: 쿨타임 중(" .. tostring(math.ceil(self._T.holyShellCooldownUntil - now)) .. "초 남음)")
				return
			end
			-- (비숍 개편 2026-08-08) 마스터 30 spendable - 쿨타임 60초에서 분배 1포인트당 -1초(마스터 31초).
			-- 테스트용 임시값 5초 상수를 걷어내고 GetHolyShellCooldown 헬퍼 한 곳으로 통일했다.
			local shellLv = math.max(1, self:GetHeroSkillLevelByName("홀리 매직쉘"))
			-- (요청 2026-08-13 2차) MP 100 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetHolyShellMpCost()) then
				log("[SkillManager] 홀리 매직쉘: MP 부족(필요 " .. tostring(self:GetHolyShellMpCost()) .. ")")
				return
			end
			local shellCd = self:ApplyCooldownReduction(self:GetHolyShellCooldown(shellLv))
			if not inAuraShell then
				self._T.holyShellCooldownUntil = now + shellCd
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_HolyMagicShellCooldownUI:ShowCooldown(shellCd, barPos)
				end
			end
			self:RequestFireHolyMagicShellLv(_CharInfoManager:GetAttackSpeedMultiplier())
			log("[SkillManager] 홀리 매직쉘! (Lv." .. tostring(shellLv) .. " 개체별 10회 방어, 쿨타임 " .. tostring(math.floor(shellCd)) .. "초)")
			return
		end
		if slot.name == "리커버리 오로라" or slot.name == "리커버리 마나" then
			-- 리커버리 오로라(4차): 발밑에 60초 오로라를 설치한다. 오로라 주변(가로 3.0 / 세로 2.5)에서는
			-- 쿨타임 스킬의 쿨타임 게이트가 전부 우회된다(각 게이트의 IsInRecoveryAura 확인).
			-- 자기 자신의 쿨타임(3분)만은 오로라 안에서도 그대로 적용된다 - 우회를 허용하면 무한 재설치로
			-- 영구 노쿨이 되기 때문(설계 의도상 예외).
			-- (불독 개편 2026-08-08) "리커버리 마나"(불독 4차)는 이 스킬의 불독판 - 서버 파이프라인·쿨타임
			-- 상태·쿨타임 UI를 전부 공유하고, 설치하는 순간 자신의 MP를 가득 채우는 점만 다르다.
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.recoveryAuraCooldownUntil or 0) > now then
				log("[SkillManager] " .. slot.name .. ": 쿨타임 중(" .. tostring(math.ceil(self._T.recoveryAuraCooldownUntil - now)) .. "초 남음)")
				return
			end
			-- (비숍 개편 2026-08-08) 마스터 30 spendable - 쿨타임 180초에서 분배 1포인트당 -2초(마스터 122초).
			-- 지속시간(60초)과 범위는 그대로다.
			local raLv = math.max(1, self:GetHeroSkillLevelByName(slot.name))
			-- (요청 2026-08-13 2차) 리커버리 오로라는 MP 100을 쓴다. ⚠ 쿨타임 세팅보다 먼저.
			-- ⚠ 불독 4차 "리커버리 마나"는 **무료**다 - MP를 가득 채워주는 스킬이라 MP가 없으면
			--   못 쓰게 만들면 앞뒤가 맞지 않는다(GetSkillMpCost 등록도 오로라만 되어 있다).
			if slot.name == "리커버리 오로라" then
				if not _MpManager:TryConsumeMp(self:GetRecoveryAuraMpCost()) then
					log("[SkillManager] 리커버리 오로라: MP 부족(필요 " .. tostring(self:GetRecoveryAuraMpCost()) .. ")")
					return
				end
			end
			local raCd = self:ApplyCooldownReduction(self:GetRecoveryAuraCooldown(raLv))
			self._T.recoveryAuraCooldownUntil = now + raCd
			local barPos = self:GetBarPosForKey(key)
			if barPos ~= "" then
				_RecoveryAuraCooldownUI:ShowCooldown(raCd, barPos)
			end
			if slot.name == "리커버리 마나" then
				_MpManager:FillMp()
			end
			self:RequestFireRecoveryAura()
			log("[SkillManager] " .. slot.name .. " 설치! (Lv." .. tostring(raLv) .. " 지속 1분, 주변 노쿨"
				.. (slot.name == "리커버리 마나" and " + MP 전량 회복" or "") .. ", 쿨타임 "
				.. tostring(math.floor(raCd)) .. "초)")
			return
		end
		if slot.name == "드래곤 블러드" then
			-- 드래곤 블러드(4차 버프): 재사용 대기시간 없음(연타 오발동만 0.5초 차단).
			-- (스펙 개편 2026-08-05) 지속시간(3분~10분) / 공격력(+lv) / 소환 용 타격 회복률(1~3%)이
			-- 모두 투자 레벨 비례 - 클라가 헬퍼로 계산해 서버에 넘긴다(공식 이중화 방지).
			-- 10초마다 최대HP 4% 소모 / HP 10% 이하 자동 해제는 레벨과 무관하게 동일(서버 처리).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.dragonBloodGateUntil or 0) > now then return end
			-- (요청 2026-08-12 5차) MP 100 소모. ⚠ 게이트/버프 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetDragonBloodMpCost()) then
				log("[SkillManager] 드래곤 블러드: MP 부족(필요 " .. tostring(self:GetDragonBloodMpCost()) .. ")")
				return
			end
			self._T.dragonBloodGateUntil = now + 0.5
			local dbLv = math.max(1, self:GetHeroSkillLevelByName("드래곤 블러드"))
			local dbDur = self:GetDragonBloodDurationForLevel(dbLv)
			local dbAtk = self:GetDragonBloodAttackBonus(dbLv)
			local dbHealPct = self:GetDragonBloodHealPercent(dbLv)
			-- 공격력 보너스는 다른 공격 버프(분노/메디테이션)와 같은 경로로 스탯창에 반영된다.
			_CharInfoManager:ApplyAttackBuff("dragonblood", dbAtk, dbDur)
			_DragonBloodBuffUI:ShowBuff(dbDur)
			self:RequestFireDragonBlood(dbDur, dbHealPct)
			log("[SkillManager] 드래곤 블러드! (Lv." .. tostring(dbLv) .. " 지속 " .. tostring(math.floor(dbDur))
				.. "초, 공격력 +" .. tostring(dbAtk) .. ", 용 타격 회복 " .. tostring(dbHealPct) .. "%)")
			return
		end
		if slot.name == "용 소환" then
			-- 용 소환(3차): 공용 쿨다운과 무관한 독립 쿨타임 10분.
			-- (스펙 개편 2026-08-04) 소환 지속시간은 투자 레벨 비례(1레벨 2분 ~ 마스터 10분)이고,
			-- 6마리 동시가 아니라 시전 즉시 1마리 + 1분마다 1마리씩 추가된다(서버가 처리).
			-- 재사용 대기 중에는 다시 쓸 수 없다(라이딩과 달리 탑승/토글이 없어 분기가 하나뿐).
			local now = _UtilLogic.ElapsedSeconds
			local inAuraDragons = self:IsInRecoveryAura()
			if (self._T.sixDragonsCooldownUntil or 0) > now and not inAuraDragons then
				log("[SkillManager] 용 소환: 쿨타임 중(" .. tostring(math.ceil(self._T.sixDragonsCooldownUntil - now)) .. "초 남음)")
				return
			end
			if not inAuraDragons then
				self._T.sixDragonsCooldownUntil = now + self:ApplyCooldownReduction(600.0)
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_SixDragonsCooldownUI:ShowCooldown(600.0, barPos)
				end
			end
			local sdLv = math.max(1, self:GetHeroSkillLevelByName("용 소환"))
			local sdDur = self:GetSixDragonsDurationForLevel(sdLv)
			_SixDragonsBuffUI:ShowBuff(sdDur)
			self:RequestFireSixDragons(_CharInfoManager:CalcCombatPower(),
				self:GetDragonDamageMinPercent(sdLv) / 100, self:GetDragonDamageMaxPercent(sdLv) / 100, sdDur)
			log("[SkillManager] 용 소환! (Lv." .. tostring(sdLv) .. ", 즉시 1마리 + 1분마다 1마리, 지속 "
				.. tostring(math.floor(sdDur)) .. "초, 쿨타임 10분)")
			return
		end
		if self:IsShurikenPlusSkill(slot.name) then
			-- (요청) 표창+ 시전 = 던질 표창 고르기. 주변에 표창 종류가 뜨고 번호키로 3초 안에 고른다.
			-- 데미지를 주는 스킬이 아니라서 쿨타임/전투력 계산 없이 선택 UI만 연다.
			-- ⚠ (요청 2026-08-12) **나이트로드 계열이 아니면 발동하지 않는다.** 투자 레벨과 퀵슬롯 배정은
			--   직업이 바뀌어도 남아 있어서, 막지 않으면 히어로/다크나이트가 눌러도 선택 링이 열린다(신고).
			if not self:IsSkillInCurrentJob(slot.name) then
				log("[SkillManager] " .. slot.name .. ": 현재 직업의 스킬이 아니라 발동하지 않는다")
				return
			end
			self:OpenShurikenSelect()
			return
		end
		if slot.name == "분신 소환" then
			-- 분신 소환(섀도어 1차, 2026-08-06 신설). 한 슬롯이 두 가지 일을 한다:
			--   · 분신이 없으면 → **소환**(요청 2026-08-14 4차로 쿨타임 폐지 - MP 200만 든다)
			--   · 분신이 살아 있으면 → **위치 교환**(별도 쿨타임 5초, MP 무료)
			-- 수명/데미지/사용 스킬 차수는 전부 클라가 투자 레벨로 계산해 넘긴다(백스탭·페이크와 같은
			-- 관례 - 스킬 투자 상태는 클라 전용이라 서버가 직접 읽을 수 없다).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.shadowCloneRecastGateUntil or 0) > now then return end
			self._T.shadowCloneRecastGateUntil = now + 0.3
			-- 분신 생존 여부는 소환 시각 + 지속시간으로 클라가 직접 안다(서버 왕복 없이 즉시 분기).
			if (self._T.shadowCloneEndAt or 0) > now then
				if (self._T.shadowCloneSwapUntil or 0) > now then
					log("[SkillManager] 분신 위치 교환: 쿨타임 중("
						.. tostring(math.ceil(self._T.shadowCloneSwapUntil - now)) .. "초 남음)")
					return
				end
				self._T.shadowCloneSwapUntil = now + 5.0
				-- (신고 2026-08-06) 위치 교환 쿨타임(5초)이 퀵슬롯에 전혀 표시되지 않았다 - 전용 오버레이를 띄운다.
				local swapBarPos = self:GetBarPosForKey(key)
				if swapBarPos ~= "" then
					_ShadowCloneSwapCooldownUI:ShowSwapCooldown(5.0, swapBarPos)
				end
				self:RequestSwapShadowClone()
				log("[SkillManager] 분신과 위치 교환 (쿨타임 5초)")
				return
			end
			-- (요청 2026-08-14 4차) **재사용 대기시간 폐지 + MP 200 소모**. 종전엔 소환 쿨 5분이었다 -
			--   프리져/바하뮤트가 "무쿨 + MP 100"이 된 것과 같은 형태로, 이제 MP가 유일한 게이트다.
			--   ⚠ 위의 "분신이 살아 있으면 위치 교환" 분기보다 뒤에 둔다 - 교환은 소환이 아니라 무료다.
			if not _MpManager:TryConsumeMp(self:GetShadowCloneMpCost()) then
				log("[SkillManager] 분신 소환: MP 부족(필요 " .. tostring(self:GetShadowCloneMpCost()) .. ")")
				return
			end
			local scLv = math.max(1, self:GetHeroSkillLevelByName("분신 소환"))
			local scLv2 = self:GetHeroSkillLevelByName("분신 강화")
			local scLv3 = self:GetHeroSkillLevelByName("분신 강화 II")
			local scLv4 = self:GetHeroSkillLevelByName("분신 강화 III")
			local scDur = self:GetShadowCloneDuration(scLv, scLv2, scLv3, scLv4)
			local scDmg = self:GetShadowCloneDamagePercent(scLv, scLv2, scLv3, scLv4)
			local scTier = self:GetShadowCloneSkillTier(scLv2, scLv3, scLv4)
			-- (요청 2026-08-14 4차) 소환 재사용 대기시간(5분)을 없앴다 - shadowCloneCooldownUntil은
			-- 더 이상 세팅하지 않고(0으로 남는다) 퀵슬롯 소환 쿨타임 오버레이도 띄우지 않는다.
			-- ⚠ 위치 교환의 5초 쿨타임(shadowCloneSwapUntil)은 그대로 유지한다 - 소환이 아니라
			--   순간이동 남용을 막는 별개의 게이트다.
			self._T.shadowCloneEndAt = now + scDur
			-- ⚠ 전투력은 **CalcCombatPower**를 쓴다(GetEffectiveCombatPower가 아니다). 지속 소환수는
			--   시전 자체가 공격이 아니라 다크사이트를 풀면 안 되고, 은신 중 2배가 수명 내내 굳어서도
			--   안 된다(GetEffectiveCombatPower 주석의 "비공격 스킬" 제외 목록과 같은 이유).
			-- (자동사냥 개편 2026-08-06) 분신도 주인과 **같은 기준**으로 다크사이트를 쓴다(쿨타임 ~ 쿨타임×4
			-- 주기). 다크사이트 투자 레벨은 클라 전용 상태라 소환 시점에 실제 쿨타임을 계산해 넘긴다
			-- (미투자면 0 → 분신은 다크사이트를 쓰지 않는다).
			local scDsCd = 0.0
			if self:GetHeroSkillLevelByName("다크사이트") >= 1 then
				scDsCd = self:GetDarkSightAutoCooldown()
			end
			-- 분신이 쓸 스킬 배율을 먼저 서버에 올린다(본체와 같은 값 - SyncShadowCloneRatesToServer 주석 참고).
			self:SyncShadowCloneRatesToServer()
			self:RequestFireShadowCloneEx(self:BuildShadowCloneCostume(), scDur, scDmg, scTier,
				_CharInfoManager:CalcCombatPower(), scDsCd)
			-- (신고 2026-08-06) 분신 지속시간이 버프바에 안 뜨던 문제 - 다른 소환 버프와 같은 규격으로 띄운다.
			_ShadowCloneBuffUI:ShowBuff(scDur)
			log("[SkillManager] 분신 소환! (Lv." .. tostring(scLv) .. " 지속 " .. tostring(math.floor(scDur))
				.. "초 / 데미지 " .. tostring(math.floor(scDmg)) .. "% / " .. tostring(scTier) .. "차 스킬)")
			return
		end
		if slot.name == "힐러 소환" then
			-- 힐러 소환(3차). (요청 2026-08-12 5차) **재사용 대기시간 없음 + MP 50**,
			-- 지속 = 20초 + 분배당 10초(마스터 30 = 310초). 종전 쿨 3분 / 1분 + 분배당 10초.
			-- 힐량(내 최대 HP의 5%~15%)과 힐러 HP(내 최대 HP의 40%~69%)도 투자 레벨로 계산해 넘긴다.
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.healerSummonRecastGateUntil or 0) > now then return end
			local inAuraHealer = self:IsInRecoveryAura()
			-- (요청 2026-08-12 5차) **재사용 대기시간 폐지**(종전 3분) - MP 50이 유일한 비용이다.
			-- 연타 오발동을 막는 0.5초 게이트는 그대로 둔다.
			if not _MpManager:TryConsumeMp(self:GetHealerSummonMpCost()) then
				log("[SkillManager] 힐러 소환: MP 부족(필요 " .. tostring(self:GetHealerSummonMpCost()) .. ")")
				return
			end
			self._T.healerSummonRecastGateUntil = now + 0.5
			-- 힐러 레벨 산정용 내 레벨 (Phase 1: 장비 전투력 환산 - UIMyInfoManager와 동일한 단일 진입점).
			local playerLevel = _CharInfoManager:GetDisplayLevel()
			local hlLv = math.max(1, self:GetHeroSkillLevelByName("힐러 소환"))
			local hlDur = self:GetHealerDurationForLevel(hlLv)
			self:RequestFireHealerSummon(playerLevel, hlDur, self:GetHealerHealPercent(hlLv), self:GetHealerHpPercent(hlLv))
			-- 우측 상단 버프바에 소환 지속시간을 표시한다 - 재소환 시 타이머가 새로 갱신된다.
			_HealerSummonBuffUI:ShowBuff(hlDur)
			log("[SkillManager] 힐러 소환! (Lv." .. tostring(hlLv) .. ", 지속 " .. tostring(math.floor(hlDur))
				.. "초, 쿨타임 없음, 힐 " .. tostring(self:GetHealerHealPercent(hlLv) / 2) .. "% / HP "
				.. tostring(self:GetHealerHpPercent(hlLv)) .. "%, 내 레벨=" .. tostring(playerLevel) .. ")")
			return
		end
		if slot.name == "리저렉션" then
			-- 리저렉션(4차): 죽어 쓰러져 있는 소환 용사를 부활시킨다.
			-- (비숍 개편 2026-08-08) 마스터 20 spendable + **재사용 대기시간 2분 신설**(분배 1포인트당 -2초,
			-- 마스터 82초). 구 사양은 연타 오발동만 막는 0.5초 게이트뿐이었다 - 그 게이트도 그대로 둔다
			-- (오로라 안에서는 쿨타임이 면제되지만 연타 게이트는 계속 살아 있어야 하기 때문).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.resurrectionGateUntil or 0) > now then return end
			local inAuraRes = self:IsInRecoveryAura()
			if (self._T.resurrectionCooldownUntil or 0) > now and not inAuraRes then
				log("[SkillManager] 리저렉션: 쿨타임 중(" .. tostring(math.ceil(self._T.resurrectionCooldownUntil - now)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-13 2차) MP 30 소모. ⚠ 연타 게이트를 통과한 뒤, 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetResurrectionMpCost()) then
				log("[SkillManager] 리저렉션: MP 부족(필요 " .. tostring(self:GetResurrectionMpCost()) .. ")")
				return
			end
			self._T.resurrectionGateUntil = now + 0.5
			local resLv = math.max(1, self:GetHeroSkillLevelByName("리저렉션"))
			if not inAuraRes then
				local resCd = self:ApplyCooldownReduction(self:GetResurrectionCooldown(resLv))
				self._T.resurrectionCooldownUntil = now + resCd
				local resBarPos = self:GetBarPosForKey(key)
				if resBarPos ~= "" then
					_ResurrectionCooldownUI:ShowCooldown(resCd, resBarPos)
				end
			end
			-- 전역 행동잠금: (피드백) 시전 이펙트 전체 길이의 0.7배 ≈ 2.28초 -
			-- 이동은 서버(CastBuffMotion)가, 스킬 입력은 UseSkillInSlot 상단 게이트가 막는다.
			self._T.actionLockUntil = now + 19 * 0.12 / 0.7 * 0.7
			self:RequestFireResurrection()
			log("[SkillManager] 리저렉션 시전 요청")
			return
		end
		-- (브랜디쉬2 콤보) 브랜디쉬 진행 [절반~끝]에 브랜디쉬를 재입력하면, 공용 쿨다운 게이트에 막혀 그냥
		-- 버려지는 대신 브랜디쉬2를 예약한다(서버가 브랜디쉬 종료 시점에 빠른 2줄 추가타로 이어감). 창 밖의
		-- 재입력은 아래로 흘려보내 평소대로(쿨다운 중이면 무시 / 아니면 새 브랜디쉬) 처리한다.
		if slot.name == "브랜디쉬" then
			local st = self._T.brandishCastStartTime
			local dur = self._T.brandishCastDuration
			if st ~= nil and dur ~= nil then
				local elapsed = _UtilLogic.ElapsedSeconds - st
				if elapsed >= 0.5 * dur and elapsed <= dur and not self._T.brandish2Requested then
					self._T.brandish2Requested = true
					_TimerService:SetTimerOnce(function()
						self._T.brandish2Requested = false
					end, dur)
					-- (요청 2026-08-12) 브랜디쉬2 콤보도 본체와 같은 레벨 비례 배율을 쓰므로 공용 위력 배율을 끈다.
					self._T.pendingSkillPowerMult = 1.0
					local combatPower = self:GetEffectiveCombatPower()
					local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
					-- 브랜디쉬 강화 버프 활성 시 콤보(브랜디쉬2)도 데미지 1.5배 + 공속 +1단계로 이어진다.
					if _CharInfoManager:IsBrandishEnhanceActive() then
						combatPower = math.floor(combatPower * 1.5)
						atkMult = atkMult * 0.9
					end
					self:RequestQueueBrandish2(combatPower, atkMult)
					log("[SkillManager] 브랜디쉬2 콤보 예약(재입력) elapsed=" .. tostring(elapsed))
					return
				end
			end
		end
		if self._T.skillOnCooldown then return end
		log("[SkillManager] 스킬 사용: " .. slot.name .. " (단축키: " .. key .. ")")
		if slot.name == "달팽이 세마리" then
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75)
			_SoundService:PlaySound("06f080c8c42e431785a46e20ec9be5bb", 1.0)
			self:RequestFireSnailSkill()
		elseif slot.name == "파워스트라이크" then
			-- (요청 2026-08-09) MP 10 소모. ⚠ 소모 판정을 **쿨타임 세팅보다 먼저** 해야 "쿨타임만 먹고
			--   스킬은 안 나가는" 일이 없다(텔레포트와 같은 관례).
			local psLv = math.max(1, self:GetHeroSkillLevelByName("파워스트라이크"))
			if not _MpManager:TryConsumeMp(self:GetPowerStrikeMpCost()) then
				log("[SkillManager] 파워스트라이크: MP 부족(필요 " .. tostring(self:GetPowerStrikeMpCost()) .. ")")
				return
			end
			-- 공격속도 배율도 쿨다운(재사용 대기시간)에 함께 적용한다 - 공격속도가 빠를수록 다음 스킬을 더 빨리 다시 쓸 수 있어야 한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (요청 2026-08-09) 레벨 성장이 데미지 배율에 직접 들어가므로 공용 위력 배율은 끈다(이중 적용 방지).
			self._T.pendingSkillPowerMult = 1.0
			local combatPower = self:GetEffectiveCombatPower()
			-- (신고 2026-08-10) 시전 순간의 내 좌표 동봉 - 점프 중 서버 복제 위치 지연으로 빗나가던 것 수정.
			local psCastPos = _UserService.LocalPlayer.TransformComponent.WorldPosition
			-- 무기 분류(창·폴암/두손검/한손검) 모션 분기용 - 인벤토리/장비는 클라이언트 전용 상태라 여기서 확인해 전달한다.
			self:RequestFirePowerStrikeLvPos(combatPower, atkMult, self:GetWeaponMotionClass(),
				self:GetPowerStrikeMinPercent(psLv) / 100, self:GetPowerStrikeMaxPercent(psLv) / 100,
				psCastPos.x, psCastPos.y)
		elseif slot.name == "슬래시블러스트" or slot.name == "슬래쉬블래스트" then
			-- (이름 변경) 새 이름 "슬래시블러스트" + 이미 퀵슬롯에 저장된 옛 이름("슬래쉬블래스트")도 호환.
			-- (요청 2026-08-09) HP 5 + MP 5 소모. HP는 서버 권한이라 여기선 "부족하면 시전 자체를 막는"
			-- 선(先)게이트만 두고, 실제 차감은 서버(AttackSlashBlastLvPos)가 한다. 사용자 확정 사양은
			-- "HP 5 이하면 시전 불가" - 자살은 시키지 않는다.
			local sbLv = math.max(1, self:GetHeroSkillLevelByName("슬래시블러스트"))
			local sbPlayer = _UserService.LocalPlayer
			local sbPc = isvalid(sbPlayer) and sbPlayer.PlayerComponent or nil
			if isvalid(sbPc) and (sbPc.Hp or 0) <= self:GetSlashBlastHpCost() then
				log("[SkillManager] 슬래시블러스트: HP 부족(보유 " .. tostring(sbPc.Hp)
					.. " / 필요 " .. tostring(self:GetSlashBlastHpCost()) .. " 초과)")
				return
			end
			-- MP 소모도 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetSlashBlastMpCost()) then
				log("[SkillManager] 슬래시블러스트: MP 부족(필요 " .. tostring(self:GetSlashBlastMpCost()) .. ")")
				return
			end
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- 파워스트라이크와 같은 이유로 공용 위력 배율은 끈다(이중 적용 방지).
			self._T.pendingSkillPowerMult = 1.0
			local combatPower = self:GetEffectiveCombatPower()
			-- (신고 2026-08-10) 시전 순간의 내 좌표 동봉 - 점프 중 서버 복제 위치 지연으로 빗나가던 것 수정.
			local sbCastPos = sbPlayer.TransformComponent.WorldPosition
			self:RequestFireSlashBlastLvPos(combatPower, atkMult, self:GetWeaponMotionClass(),
				self:GetSlashBlastMinPercent(sbLv) / 100, self:GetSlashBlastMaxPercent(sbLv) / 100,
				sbCastPos.x, sbCastPos.y)
		elseif slot.name == "표창 분산" then
			-- (요청 2026-08-07) 표창 분산 = ON/OFF 토글(기본 OFF, 처음부터 마스터).
			-- 쿨다운 없이 상태만 뒤집는다.
			self:SetStarSpreadEnabled(not (self._T.starSpreadEnabled == true))
		elseif slot.name == "드레인 샷" then
			-- (요청) 아대 기본공격과 같은 표창 투척 + 흡혈. 가니어 장착 조건은 럭키세븐과 같다.
			if not self:IsClawEquipped() then
				log("[SkillManager] 드레인 샷: 가니어를 장착하지 않아 사용할 수 없습니다.")
				return
			end
			-- (요청 2026-08-05) 재사용 대기시간 5초 - 다크사이트/연막과 같은 전용 쿨다운 게이트 방식.
			-- ⚠ 이 게이트가 없으면 유일한 비용이 표창 10개인데 **1번 표창은 무제한**이라 사실상
			--   초당 30% 자힐이 된다(밸런스 구멍).
			local nowDS = _UtilLogic.ElapsedSeconds
			local inAuraDS = self:IsInRecoveryAura()
			if (self._T.drainShotCooldownUntil or 0) > nowDS and not inAuraDS then
				log("[SkillManager] 드레인 샷: 쿨타임 중(" .. tostring(math.ceil(self._T.drainShotCooldownUntil - nowDS)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-14 5차) MP 50 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetDrainShotMpCost()) then
				log("[SkillManager] 드레인 샷: MP 부족(필요 " .. tostring(self:GetDrainShotMpCost()) .. ")")
				return
			end
			if not inAuraDS then
				local dsCd = self:ApplyCooldownReduction(5.0)
				self._T.drainShotCooldownUntil = nowDS + dsCd
				local dsBarPos = self:GetBarPosForKey(key)
				if dsBarPos ~= "" then
					_DrainShotCooldownUI:ShowCooldown(dsCd, dsBarPos)
				end
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (표창 재고) 드레인 샷은 표창 10개를 쓴다.
			self:TryConsumeShuriken(10)
			local dsLv = math.max(1, self:GetHeroSkillLevelByName("드레인 샷"))
			local combatPower = self:GetEffectiveCombatPower()
			-- 점프 중에도 지금 높이 기준으로 대상을 찾도록 실제 위치를 먼저 보고한다.
			self:ReportCastOrigin()
			-- (요청) 스윙이 끝날 때까지 좌우 방향 고정 - 표창이 마지막 프레임에 나가므로 중간에 몸이
			-- 돌면 반대쪽으로 던진다(기본공격과 같은 처리).
			-- (요청 2026-08-05 2차) "드레인 샷은 보는 방향을 계속 바꿀 수 있다" - 드레인 샷만 시전 중
			-- 컨트롤러가 켜져 있어 이동/방향 입력이 그대로 살아 있었다. 아대 기본공격과 **같은 구조**답게
			-- 스윙 동안(0.6×공속) 클라에서 컨트롤러를 끈다(아이언 월과 같은 클라 잠금 패턴 - 이동은
			-- 클라 권한). 방향 고정 자체는 서버 멀티캐스트 모션(PlayLuckySevenMotion)의 잠금(1.10×공속)이
			-- 이어받고, 멀티캐스트가 도착하기 전 공백은 아래 LockLookDirectionFor가 메운다.
			-- (요청 2026-08-05 최종) 드래곤 로어 구조 - 컨트롤 잠금(0.70×공속)이 방향 고정(0.65×공속)보다
			-- 오래 유지된다. 쿨다운 5초라 시전은 언제나 직렬이다.
			local playerDS = _UserService.LocalPlayer
			if isvalid(playerDS) then
				local pccDS = playerDS.PlayerControllerComponent
				if isvalid(pccDS) and pccDS.Enable then
					pccDS.Enable = false
					if isvalid(playerDS.MovementComponent) then playerDS.MovementComponent:Stop() end
					_TimerService:SetTimerOnce(function()
						if isvalid(pccDS) then pccDS.Enable = true end
					end, 0.70 * atkMult)
				end
				---@type PlayerAttack
				local paDSLock = playerDS:GetComponent(PlayerAttack)
				if isvalid(paDSLock) then paDSLock:LockLookDirectionFor(0.65 * atkMult) end
			end
			self:RequestFireDrainShot(combatPower, atkMult, self:GetDrainShotHealPercent(dsLv))
		elseif slot.name == "럭키세븐" then
			-- 럭키세븐은 가니어를 장착한 상태에서만 사용 가능하다. 인벤토리/장비 상태는 클라이언트에만 존재하므로
			-- (서버는 CostumeManagerComponent의 실제 장착값을 알 수 없음) 여기 클라이언트 측에서 확인한다.
			if not self:IsClawEquipped() then
				log("[SkillManager] 럭키세븐: 가니어를 장착하지 않아 사용할 수 없습니다.")
				return
			end
			-- (요청 2026-08-14 5차) MP 10 소모(더블샷과 같다). ⚠ 쿨타임·표창 소모보다 먼저
			--   (파워스트라이크와 같은 관례) - MP가 모자란데 표창만 2개 빠지는 사고를 막는다.
			if not _MpManager:TryConsumeMp(self:GetLuckySevenMpCost()) then
				log("[SkillManager] 럭키세븐: MP 부족(필요 " .. tostring(self:GetLuckySevenMpCost()) .. ")")
				return
			end
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			-- (요청 2026-08-05 최종) 서버 컨트롤 잠금(0.75×공속)보다 길어야 재입력이 잠금 중에 먹히지 않는다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.80 * atkMult)
			-- (표창 재고) 럭키세븐은 표창 2개를 쓴다. 모자라면 번호를 내려가며 낼 수 있는 표창을 찾는다
			-- (1번은 무제한이라 시전이 막히는 일은 없다). 소모는 시전이 확정된 이 시점에 한 번만.
			self:TryConsumeShuriken(self:GetShurikenCostForSkill("럭키세븐"))
			local combatPower = self:GetEffectiveCombatPower()
			-- 점프 중에도 지금 있는 높이 기준으로 대상을 찾도록 실제 위치를 먼저 보고한다.
			self:ReportCastOrigin()
			-- (요청 2026-08-14 5차) 표창 1발당 배율이 **레벨 비례**(더블샷 위임)가 되면서 트리플/쿼드러플과
			-- 같이 클라가 계산해 넘긴다. 종전엔 서버 폴백(GetStarThrowRateMin "luckyseven" = 0.5/3)을 썼다.
			local l7Lv = math.max(1, self:GetHeroSkillLevelByName("럭키세븐"))
			self:RequestFireLuckySevenLv(combatPower, atkMult,
				self:GetLuckySevenRateMinLv(l7Lv), self:GetLuckySevenRateMaxLv(l7Lv))
		elseif slot.name == "트리플 스로우" or slot.name == "쿼드러플 스로우" then
			-- 럭키세븐의 상위 스킬(3발/4발). 가니어 장착 조건·쿨다운 구조가 럭키세븐과 같고,
			-- 표창이 늘어난 만큼(발당 0.1초) 재사용 대기시간만 더 길게 잡는다.
			if not self:IsClawEquipped() then
				log("[SkillManager] " .. tostring(slot.name) .. ": 가니어를 장착하지 않아 사용할 수 없습니다.")
				return
			end
			-- (요청 2026-08-14 5차) 트리플 20 / 쿼드러플 30 소모. ⚠ 쿨타임·표창 소모보다 먼저
			--   (파워스트라이크와 같은 관례) - MP가 모자란데 표창만 3~4개 빠지는 사고를 막는다.
			local stMpCost = (slot.name == "쿼드러플 스로우") and self:GetQuadThrowMpCost() or self:GetTripleThrowMpCost()
			if not _MpManager:TryConsumeMp(stMpCost) then
				log("[SkillManager] " .. tostring(slot.name) .. ": MP 부족(필요 " .. tostring(stMpCost) .. ")")
				return
			end
			local shots = (slot.name == "쿼드러플 스로우") and 4 or 3
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			-- (요청) 후딜 축소 - PlayerAttack의 조작 복구 시점(0.4 + 0.07*(발수-1) + 0.06)에
			-- 아주 짧은 여유만 더한다. 트리플 0.63초 / 쿼드러플 0.70초 (기존 0.85 / 0.95초).
			-- ⚠ (2026-08-05) 표창 사이 간격은 공속이 빨라져도 0.6배까지만 줄어든다(PlayerAttack의
			--   AttackStarThrow - "너무 뭉쳐서 날아간다" 요청). **같은 공식**으로 쿨다운도 늘려야
			--   조작 복구보다 쿨다운이 먼저 끝나 재입력이 서버 isLuckySeven 가드에 먹히는 일이 없다.
			local gapMult = math.max(atkMult, 0.6)
			-- (요청 2026-08-05 최종) 서버 컨트롤 잠금 여유가 +0.06→+0.16으로 늘었다 - 쿨다운도 같이
			-- 늘려(+0.09→+0.19) 재입력이 잠금 중에 먹히지 않게 유지한다.
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, (0.4 + 0.19) * atkMult + 0.07 * gapMult * (shots - 1))
			-- (표창 재고) 트리플 3개 / 쿼드러플 4개를 쓴다.
			self:TryConsumeShuriken(self:GetShurikenCostForSkill(slot.name))
			local combatPower = self:GetEffectiveCombatPower()
			-- 점프 중에도 지금 있는 높이 기준으로 대상을 찾도록 실제 위치를 먼저 보고한다.
			self:ReportCastOrigin()
			-- (나이트로드 3·4차 개편) 표창 1발당 데미지 배율을 투자 레벨로 계산해 서버에 넘긴다
			-- (클라 계산 → RPC 인자 → 서버 _T 보관, 다크나이트 3·4차 개편과 같은 관례).
			if shots == 4 then
				local qtLv = self:GetHeroSkillLevelByName("쿼드러플 스로우")
				self:RequestFireQuadThrowLv(combatPower, atkMult,
					self:GetQuadThrowMinPercent(qtLv) / 100, self:GetQuadThrowMaxPercent(qtLv) / 100)
			else
				local ttLv = self:GetHeroSkillLevelByName("트리플 스로우")
				self:RequestFireTripleThrowLv(combatPower, atkMult,
					self:GetTripleThrowMinPercent(ttLv) / 100, self:GetTripleThrowMaxPercent(ttLv) / 100)
			end
		elseif slot.name == "각성" then
			-- 각성(나이트로드 4차): 지속 10초 + 분배 1포인트당 1초 / 재사용 대기시간 **5분 고정**.
			-- ⚠ 5분은 고정값이라 ApplyCooldownReduction(쿨타임 감소)을 태우지 않는다(요청 사양).
			--   리커버리 오로라 안에서만 예외적으로 게이트를 우회한다(다른 쿨타임 스킬과 동일 규칙).
			-- 역할 분담: 여기(클라)는 게이트·공속·버프바·쿨다운 표시, 서버(PlayerAttack.AttackAwakening)는
			--   시전 모션/화면 어두워짐/전용 BGM과 표창 3종의 조준 범위·크리티컬 확정을 담당한다.
			local nowAW = _UtilLogic.ElapsedSeconds
			local inAuraAW = self:IsInRecoveryAura()
			if (self._T.awakeningCooldownUntil or 0) > nowAW and not inAuraAW then
				log("[SkillManager] 각성: 쿨타임 중(" .. tostring(math.ceil(self._T.awakeningCooldownUntil - nowAW)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-14 5차) MP 100 소모. ⚠ 쿨타임(5분) 세팅보다 먼저 - MP가 모자라 시전이
			--   취소됐는데 5분 쿨타임만 도는 사고를 막는다(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetAwakeningMpCost()) then
				log("[SkillManager] 각성: MP 부족(필요 " .. tostring(self:GetAwakeningMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			local awLv = math.max(1, self:GetHeroSkillLevelByName("각성"))
			local awDur = self:GetAwakeningDuration(awLv)
			local awStages = self:GetAwakeningAtkSpeedStages(awLv)
			if not inAuraAW then
				self._T.awakeningCooldownUntil = nowAW + 300.0
				local awBarPos = self:GetBarPosForKey(key)
				if awBarPos ~= "" then
					_AwakeningCooldownUI:ShowCooldown(300.0, awBarPos)
				end
			end
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- 발도술/아이언 월과 동일: 이동 중 시전 시 클라 걷기(MOVE) 상태가 시전 모션을 덮지 않도록
			-- 서버 잠금(0.6×공속)과 같은 시간 동안 클라에서도 이동을 멈춘다(이동은 클라 권한).
			local playerAW = _UserService.LocalPlayer
			if isvalid(playerAW) then
				local pccAW = playerAW.PlayerControllerComponent
				if isvalid(pccAW) and pccAW.Enable then
					pccAW.Enable = false
					if isvalid(playerAW.MovementComponent) then playerAW.MovementComponent:Stop() end
					_TimerService:SetTimerOnce(function()
						if isvalid(pccAW) then pccAW.Enable = true end
					end, 0.6 * atkMult)
				end
			end
			self:RequestFireAwakening(awDur, atkMult)
			self:StartAwakeningLocal(awDur, awStages)
			log("[SkillManager] 각성 사용! (Lv." .. tostring(awLv) .. " 지속 " .. tostring(awDur)
				.. "초 공속 +" .. tostring(awStages * 10) .. "%, 쿨타임 5분)")
		elseif slot.name == "더블스탭" then
			-- (요청 2026-08-14 4차) MP 10 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetDoubleStabMpCost()) then
				log("[SkillManager] 더블스탭: MP 부족(필요 " .. tostring(self:GetDoubleStabMpCost()) .. ")")
				return
			end
			-- 더블스탭은 공격속도가 현재 단계보다 1단계 더 빠르게 고정 적용된다(0.9배 추가) -
			-- GetAttackSpeedMultiplier는 0.9^(stage-5)이므로, 한 단계 더 빠른 속도는 그 값에 0.9를 한 번 더 곱한 것과 같다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier() * 0.9
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (요청 2026-08-14 4차) 한 타당 배율 = **더블샷 화살 1발의 2배**(레벨 비례 - 럭키세븐 파생 해제).
			-- ⚠ 더블샷과 같은 계보라 공용 위력 배율은 끄지 않는다(매직클로와 같은 이유).
			local dstLv = math.max(1, self:GetHeroSkillLevelByName("더블스탭"))
			self:RequestFireDoubleStabLv(combatPower, atkMult,
				self:GetDoubleStabRateMinLv(dstLv), self:GetDoubleStabRateMaxLv(dstLv))
		elseif slot.name == "새비지블로우" then
			-- (요청 2026-08-14 4차) MP 20 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetSavageBlowMpCost()) then
				log("[SkillManager] 새비지블로우: MP 부족(필요 " .. tostring(self:GetSavageBlowMpCost()) .. ")")
				return
			end
			-- 새비지블로우: 전방 1명을 6번 때리는 단일 대상 스킬. 다른 스킬들과 동일하게 공격속도 배율을
			-- 재사용 대기시간에 함께 적용한다.
			-- 재사용 대기시간은 마지막 타격(0.12 + 7*0.09 = 0.75*배율)과 컨트롤 복구(0.77*배율) 직후로 잡는다 -
			-- "끝 딜레이를 더 줄여달라"는 피드백으로 0.90 → 0.82*배율까지 줄였다(키 홀드 연속 시전 포함).
			-- 8번 이미지는 전용 이펙트 엔티티가 자기 타이머로 끝까지 재생하므로 잘리지 않는다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.82 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (요청 2026-08-14 4차) 줄당 배율 = 50%~60% + 분배당 최소·최대 2%p(트리플 스로우 파생 해제).
			local sbLv = math.max(1, self:GetHeroSkillLevelByName("새비지블로우"))
			self:RequestFireSavageBlowLv(combatPower, atkMult,
				self:GetSavageBlowMinPercent(sbLv) / 100, self:GetSavageBlowMaxPercent(sbLv) / 100)
		elseif slot.name == "매직클로" then
			-- (요청 2026-08-13 2차) MP 10 소모(더블샷과 같다). ⚠ 쿨타임 세팅보다 먼저(파워스트라이크 관례).
			if not _MpManager:TryConsumeMp(self:GetMagicClawMpCost()) then
				log("[SkillManager] 매직클로: MP 부족(필요 " .. tostring(self:GetMagicClawMpCost()) .. ")")
				return
			end
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (요청 2026-08-13 2차) 한 타당 배율 = **더블샷 화살 1발과 완전히 같다**(40%~50% + 분배당
			-- 최소·최대 3%p) - 공식은 GetMagicClawRate*Lv → GetDoubleShotRate*Lv 한 곳에서 나온다.
			-- ⚠ 더블샷과 같은 규격이라 공용 위력 배율(pendingSkillPowerMult)도 더블샷처럼 **끄지 않는다** -
			--   여기서 1.0으로 고정하면 더블샷보다 약해져 "같게 해달라"는 요청과 어긋난다.
			local mcLv = math.max(1, self:GetHeroSkillLevelByName("매직클로"))
			self:RequestFireMagicClawLv(combatPower, atkMult,
				self:GetMagicClawRateMinLv(mcLv), self:GetMagicClawRateMaxLv(mcLv))
		elseif slot.name == "매직 미사일" then
			-- 소환→조준(0.5초)→발사 플래시→발사로 이어지는 긴 시퀀스라 쿨다운은 1.0초*배율로 둔다.
			-- 레벨(전투력 10당 1 - 파이어에로우와 동일한 클라이언트 계산식)은 구체 개수 결정용으로 서버에 넘긴다.
			-- (비숍 개편 2026-08-08) 여기에 **재사용 대기시간 5초**가 추가됐다. 위의 공용 쿨다운
			-- (skillOnCooldown, 모션 길이)과 별개인 전용 게이트로, 다크사이트와 같은 방식이다.
			local nowMM = _UtilLogic.ElapsedSeconds
			local inAuraMM = self:IsInRecoveryAura()
			if (self._T.magicMissileCooldownUntil or 0) > nowMM and not inAuraMM then
				log("[SkillManager] 매직 미사일: 쿨타임 중(" .. tostring(math.ceil(self._T.magicMissileCooldownUntil - nowMM)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-13 2차) MP 10 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetMagicMissileMpCost()) then
				log("[SkillManager] 매직 미사일: MP 부족(필요 " .. tostring(self:GetMagicMissileMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			if not inAuraMM then
				local mmCd = self:ApplyCooldownReduction(self:GetMagicMissileCooldown())
				self._T.magicMissileCooldownUntil = nowMM + mmCd
				local mmBarPos = self:GetBarPosForKey(key)
				if mmBarPos ~= "" then
					_MagicMissileCooldownUI:ShowCooldown(mmCd, mmBarPos)
				end
			end
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			-- (요청 2026-08-13 2차) 구체 1개당 배율이 **슬래시블러스트와 같은 레벨 비례 곡선**이 되었으므로,
			-- 슬래시블러스트와 똑같이 공용 위력 배율을 끈다(이중 적용 방지 - 파워스트라이크와 같은 관례).
			-- ⚠ 반드시 GetEffectiveCombatPower **호출 전에** 예약해야 한다(호출이 값을 1회성으로 소비한다).
			self._T.pendingSkillPowerMult = 1.0
			local combatPower = self:GetEffectiveCombatPower()
			-- (Phase 1) 구체 개수용 레벨은 장비 전투력 환산(GetDisplayLevel)으로 통일 - 다크사이트/속성 강화로
			-- 부풀린 전투력이 구체 수까지 올리지 않게 된다(아래 "구체 수 뻥튀기 방지" 의도와 일치).
			local level = _CharInfoManager:GetDisplayLevel()
			-- (요청) 매직 에로우(빛/얼음/불) 토글이 켜져 있으면 데미지 2배 + 속성색. 데미지 2배는
			-- 브랜디쉬 강화와 동일하게 combatPower를 미리 2배로 올려 넘기는 방식(서버 데미지 공식은 그대로).
			-- 레벨(구체 개수)은 강화 전 전투력 기준으로 계산해 구체 수가 같이 2배로 뻥튀기되지 않게 한다.
			local element = _CharInfoManager:GetMagicMissileElement()
			if element ~= "" then
				combatPower = combatPower * 2
			end
			-- (요청 2026-08-13 2차) 구체 1개당 배율 = **슬래시블러스트와 완전히 같다**(50%~60% + 분배당
			-- 최소 2%p / 최대 3%p) - 공식은 GetMagicMissile*Percent → GetSlashBlast*Percent 한 곳.
			-- 구 사양은 서버가 100%~150%로 고정 계산했다(레벨 성장은 위력 배율만 담당).
			local mmLv = math.max(1, self:GetHeroSkillLevelByName("매직 미사일"))
			self:RequestFireMagicMissileLv(combatPower, atkMult, level, element,
				self:GetMagicMissileMinPercent(mmLv) / 100, self:GetMagicMissileMaxPercent(mmLv) / 100)
		elseif slot.name == "체인라이트닝" then
			-- 체인 라이트닝(4차): 기모으기 0.5초 + 발사(≈0.7초)로 시전이 길어 쿨다운은 1.0초*배율.
			-- (요청 2026-08-14) MP 50 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetChainLightningMpCost()) then
				log("[SkillManager] 체인라이트닝: MP 부족(필요 " .. tostring(self:GetChainLightningMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (썬콜 개편 2026-08-08) 대상당 배율을 투자 레벨로 계산해 넘긴다(GetChainLightning* 한 곳에서).
			local clLv = math.max(1, self:GetHeroSkillLevelByName("체인라이트닝"))
			self:RequestFireChainLightningLv(combatPower, atkMult,
				self:GetChainLightningMinPercent(clLv) / 100, self:GetChainLightningMaxPercent(clLv) / 100)
		elseif slot.name == "암살" then
			-- 암살(4차): 연쇄 연출이 0.05초 간격 × 최대 10명(≈1.05초)이라 쿨다운은 1.2초*배율.
			-- (피드백) 홀드 연속 사용 시 "다시 보이기 전에 다시 사라져야" 하므로, 연쇄가 끝난 직후
			-- 바로 다음 시전이 들어오도록 쿨다운을 1.5 → 1.2초로 줄였다(서버 복귀 유예 0.35초보다
			-- 짧은 간격 = 복귀 연출이 취소되고 그대로 이어진다).
			-- (요청 2026-08-14 4차) MP 소모도 **체인 라이트닝과 같다**(현재 50).
			-- ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetAssassinateMpCost()) then
				log("[SkillManager] 암살: MP 부족(필요 " .. tostring(self:GetAssassinateMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.2 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- 시전할 때마다 "아직 누르고 있다"를 서버에 갱신해준다(복귀 판단에 쓰인다).
			self:RequestSetAssassinateHold(true)
			-- (요청 2026-08-14 4차) 대상당 배율 = **체인 라이트닝과 완전히 같다**(쿼드러플 파생 해제).
			local asnLv = math.max(1, self:GetHeroSkillLevelByName("암살"))
			self:RequestFireAssassinateLv(combatPower, atkMult,
				self:GetAssassinateMinPercent(asnLv) / 100, self:GetAssassinateMaxPercent(asnLv) / 100)
		elseif slot.name == "연막" then
			-- 연막(4차, 2026-08-06 스펙 개편): 마스터 40 spendable.
			--   · 지속 20초 + 분배 1포인트당 1초(마스터 40 = 59초) - GetSmokeScreenDuration
			--   · 재사용 대기시간 **3분** 고정(구 사양 20초). 다크사이트와 같은 전용 쿨다운 게이트 방식.
			-- (신고 수정) 예전에는 퀵슬롯에 쿨타임 표시가 전혀 없고(끝날 때 깜빡임만 있었다) 남은 지속도
			-- 어디에도 안 보였다 - 전용 UI 두 개를 신설해 각각 연결한다.
			local nowSmoke = _UtilLogic.ElapsedSeconds
			if (self._T.smokeScreenCooldownUntil or 0) > nowSmoke and not self:IsInRecoveryAura() then
				log("[SkillManager] 연막: 쿨타임 중(" .. tostring(math.ceil(self._T.smokeScreenCooldownUntil - nowSmoke)) .. "초 남음)")
				return
			end
			-- (요청 2026-08-14 4차) MP 100 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetSmokeScreenMpCost()) then
				log("[SkillManager] 연막: MP 부족(필요 " .. tostring(self:GetSmokeScreenMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			local ssLv = math.max(1, self:GetHeroSkillLevelByName("연막"))
			local ssDur = self:GetSmokeScreenDuration(ssLv)
			local ssCd = self:ApplyCooldownReduction(180.0)
			if not self:IsInRecoveryAura() then
				self._T.smokeScreenCooldownUntil = nowSmoke + ssCd
				local smokeBarPos = self:GetBarPosForKey(key)
				if smokeBarPos ~= "" then
					_SmokeScreenCooldownUI:ShowCooldown(ssCd, smokeBarPos)
				end
			end
			-- (요청) 시전 모션(swingOF ≈0.6초×공속) 동안은 행동 불가 - 이동은 서버(AttackSmokeScreenLv)가
			-- 컨트롤러를 꺼서 막고, 다른 스킬 입력은 이 전역 행동잠금이 UseSkillInSlot 상단에서 막는다.
			self._T.actionLockUntil = nowSmoke + 0.6 * atkMult
			-- 버프바에는 "효과가 실제로 살아있는 시간" = 시전 모션(0.6×공속) + 생성 지연 0.5초 + 지속시간을
			-- 보여준다(서버 AttackSmokeScreenLv가 smokeScreenUntil을 잡는 것과 같은 계산).
			_SmokeScreenBuffUI:ShowBuff(0.6 * atkMult + 0.5 + ssDur)
			self:RequestFireSmokeScreenLv(atkMult, ssDur)
			log("[SkillManager] 연막 사용(Lv." .. tostring(ssLv) .. " 지속 " .. tostring(math.floor(ssDur))
				.. "초, 쿨타임 " .. tostring(math.floor(ssCd)) .. "초)")
		elseif slot.name == "썬더볼트" then
			-- (요청 2026-08-14) MP 20 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetThunderboltMpCost()) then
				log("[SkillManager] 썬더볼트: MP 부족(필요 " .. tostring(self:GetThunderboltMpCost()) .. ")")
				return
			end
			-- 다른 스킬들과 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (썬콜 개편 2026-08-08) 데미지 배율은 홀리 에로우와 같은 곡선을 쓴다(GetThunderbolt*Percent).
			local tbLv = math.max(1, self:GetHeroSkillLevelByName("썬더볼트"))
			self:RequestFireThunderboltLv(combatPower, atkMult,
				self:GetThunderboltMinPercent(tbLv) / 100, self:GetThunderboltMaxPercent(tbLv) / 100)
		elseif slot.name == "힐" then
			-- (요청 2026-08-13 2차) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetHealMpCost()) then
				log("[SkillManager] 힐: MP 부족(필요 " .. tostring(self:GetHealMpCost()) .. ")")
				return
			end
			-- 힐은 다른 스킬과 달리 공격속도를 1단계 올린 속도로 사용한다(요청사항) - 기본 배율에
			-- 0.9를 추가로 곱해 "현재 공격속도 단계+1"에 해당하는 배율을 쿨다운/모션 재생시간 모두에 적용한다.
			local baseAtkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			local atkMult = baseAtkMult * 0.9
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = _CharInfoManager:CalcCombatPower()
			-- (비숍 개편 2026-08-08) 회복량이 전투력 비례(5~15%)에서 **대상 최대 HP의 1% × 분배 레벨**로
			-- 바뀌었다. combatPower는 언데드 몬스터 피해 계산에 여전히 쓰이므로 함께 넘긴다.
			local healLv = math.max(1, self:GetHeroSkillLevelByName("힐"))
			self:RequestFireHealLv(combatPower, atkMult, self:GetHealPercent(healLv))
		elseif slot.name == "파이어에로우" then
			-- 방향키 입력 상태는 클라이언트에서만 알 수 있다(_InputService:IsKeyPressed는 ClientOnly) - 여기서 확인해 서버로 전달한다.
			-- 위/아래/좌/우를 동시에 조합해 대각선까지 지원하고, 아무 키도 없으면 서버에서 캐릭터가 바라보는 방향(전방)으로 처리한다.
			local dirX, dirY = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirX = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirX = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirY = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirY = -1
			end
			-- (요청 2026-08-14 3차) MP 20 소모(홀리 에로우와 같다). ⚠ 쿨타임 세팅보다 먼저(파워스트라이크 관례).
			if not _MpManager:TryConsumeMp(self:GetFireArrowMpCost()) then
				log("[SkillManager] 파이어에로우: MP 부족(필요 " .. tostring(self:GetFireArrowMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- 레벨 50 이상 이펙트 분기용 - (Phase 1) 장비 전투력 환산(GetDisplayLevel)으로 통일해 서버로 전달한다
			-- (_UIMyInfoManager.CharLevel은 서버에서 갱신되지 않는 고정값이라 사용 금지).
			local level = _CharInfoManager:GetDisplayLevel()
			-- (불독 개편 2026-08-08) 데미지 배율은 홀리 에로우와 같은 곡선을 쓴다(GetFireArrow*Percent).
			local faLv = math.max(1, self:GetHeroSkillLevelByName("파이어에로우"))
			self:RequestFireFireArrowLv(combatPower, atkMult, dirX, dirY, level,
				self:GetFireArrowMinPercent(faLv) / 100, self:GetFireArrowMaxPercent(faLv) / 100)
		elseif slot.name == "더블샷" then
			-- 더블샷도 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만 발사한다.
			-- 직업 인덱스(신궁 7 / 보우마스터 8)는 캐릭터 선택 슬롯 데이터에서 읽는 클라이언트 전용
			-- 값이라(GetSelectedCharacterJobIdx는 ClientOnly) combatPower와 동일하게 서버로 넘겨준다.
			-- (요청 2026-08-13) MP 10 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetDoubleShotMpCost()) then
				log("[SkillManager] 더블샷: MP 부족(필요 " .. tostring(self:GetDoubleShotMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			local jobIdx = math.floor(_UIMyInfoManager:GetSelectedCharacterJobIdx())
			-- (요청 2026-08-13) 화살 1발당 배율은 투자 레벨이 정한다(40%~50% + 분배당 최소·최대 3%p) -
			-- 공식은 GetDoubleShotRate*Lv 한 곳에서 나온다.
			local dsLv = math.max(1, self:GetHeroSkillLevelByName("더블샷"))
			self:RequestFireDoubleShotLv(combatPower, atkMult, jobIdx,
				self:GetDoubleShotRateMinLv(dsLv), self:GetDoubleShotRateMaxLv(dsLv))
			self:TryArcherFinalAttack("더블샷", atkMult)
		elseif slot.name == "스트레이프" then
			-- 스트레이프(3차)도 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만 발사한다.
			-- 네 발이 0.2 + 0.09*3 = 0.47*배율까지 이어져 나가므로 쿨다운은 더블샷(0.75)보다 긴
			-- 0.9*배율로 잡는다(PlayerAttack.AttackStrafe의 컨트롤 복구 시점과 동일).
			-- (요청 2026-08-13) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetStrafeMpCost()) then
				log("[SkillManager] 스트레이프: MP 부족(필요 " .. tostring(self:GetStrafeMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.9 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (신궁 개편) 화살 1발당 배율을 투자 레벨로 계산해 넘긴다(GetStrafe*Percent 한 곳에서).
			local stLv = math.max(1, self:GetHeroSkillLevelByName("스트레이프"))
			self:RequestFireStrafeLv(combatPower, atkMult,
				self:GetStrafeMinPercent(stLv) / 100, self:GetStrafeMaxPercent(stLv) / 100)
			self:TryArcherFinalAttack("스트레이프", atkMult)
		elseif slot.name == "아이스 샷" then
			-- 아이스 샷(3차): 방향 무관 범위 다중 대상 - 시전 이펙트(약 1초)와 화살 도착까지 감안해
			-- 쿨다운은 1.0*배율(PlayerAttack.AttackIceShot의 컨트롤 복구 시점과 동일)로 잡는다.
			-- (요청 2026-08-13) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저.
			-- ⚠ 쌍둥이인 파이어 샷(보우마스터 3차)은 데미지 규격만 공유하고 MP 비용은 없다(요청 범위).
			if not _MpManager:TryConsumeMp(self:GetIceShotMpCost()) then
				log("[SkillManager] 아이스 샷: MP 부족(필요 " .. tostring(self:GetIceShotMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (신궁 개편) 대상 1명당 배율을 투자 레벨로 계산해 넘긴다(GetIceShot*Percent 한 곳에서).
			local isLv = math.max(1, self:GetHeroSkillLevelByName("아이스 샷"))
			self:RequestFireIceShotLv(combatPower, atkMult,
				self:GetIceShotMinPercent(isLv) / 100, self:GetIceShotMaxPercent(isLv) / 100)
			self:TryArcherFinalAttack("아이스 샷", atkMult)
		elseif slot.name == "파이어 샷" then
			-- 파이어 샷(3차): 아이스 샷과 동일한 규격의 쿨다운(1.0*배율).
			-- (요청 2026-08-13) MP도 아이스 샷과 같다(30). ⚠ 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetFireShotMpCost()) then
				log("[SkillManager] 파이어 샷: MP 부족(필요 " .. tostring(self:GetFireShotMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (보우마스터 개편 2026-08-07) 대상 1명당 배율을 투자 레벨로 계산해 넘긴다
			-- (GetFireShot*Percent 한 곳에서 - 아이스 샷 헬퍼에서 파생된 같은 수치).
			local fsLv = math.max(1, self:GetHeroSkillLevelByName("파이어 샷"))
			self:RequestFireFireShotLv(combatPower, atkMult,
				self:GetFireShotMinPercent(fsLv) / 100, self:GetFireShotMaxPercent(fsLv) / 100)
			self:TryArcherFinalAttack("파이어 샷", atkMult)
		elseif slot.name == "에로우 봄" then
			-- 에로우 봄(2차): 에로우 블로우와 같은 시전 규격(전방 고정 발사, 쿨다운 0.75*배율).
			-- (요청 2026-08-13) MP 20 소모. ⚠ 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetArrowBombMpCost()) then
				log("[SkillManager] 에로우 봄: MP 부족(필요 " .. tostring(self:GetArrowBombMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			local abLv = math.max(1, self:GetHeroSkillLevelByName("에로우 봄"))
			self:RequestFireArrowBombLv(combatPower, atkMult,
				self:GetArrowBombMinPercent(abLv) / 100, self:GetArrowBombMaxPercent(abLv) / 100)
			self:TryArcherFinalAttack("에로우 봄", atkMult)
		elseif slot.name == "에로우 블로우" then
			-- 에로우 블로우(1차)는 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만 발사한다 -
			-- 방향키 상태를 읽을 필요가 없어 combatPower/공격속도 배율만 서버로 넘긴다.
			-- (요청 2026-08-13) MP 10 소모. ⚠ 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetArrowBlowMpCost()) then
				log("[SkillManager] 에로우 블로우: MP 부족(필요 " .. tostring(self:GetArrowBlowMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- ⚠ (요청 2026-08-06) "에로우 블로우 강화"는 패시브다 - ON/OFF 토글이 없어졌으므로
			--   **1포인트라도 투자했으면 폭발이 항상 켜진다**. 데미지 상승폭도 같은 투자 레벨이 정한다.
			-- (요청 2026-08-13) 배율은 **본체 투자 레벨 + 강화 투자 레벨**이 함께 정한다
			--   (50%~60% + 본체 분배당 2%p + 강화 분배당 2%p) - 공식은 GetArrowBlowRate*Lv 한 곳.
			local abLv = math.max(1, self:GetHeroSkillLevelByName("에로우 블로우"))
			local abEnhLv = self:GetHeroSkillLevelByName("에로우 블로우 강화")
			local enhanced = abEnhLv >= 1
			self:RequestFireArrowBlowLv(combatPower, atkMult, enhanced,
				self:GetArrowBlowRateMinLv(abLv, abEnhLv), self:GetArrowBlowRateMaxLv(abLv, abEnhLv))
			self:TryArcherFinalAttack("에로우 블로우", atkMult)
		elseif slot.name == "아이언 에로우" then
			-- 파이어에로우와 동일한 8방향 입력 처리. 레벨에 따른 이펙트 분기는 없다(고정 1종).
			local dirX, dirY = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirX = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirX = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirY = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirY = -1
			end
			-- (M2 자동사냥, 요청 2026-08-06) 방향키 입력이 없고 자동사냥 중이면 "적 쪽 방향키를 누르고
			-- 쓴 것처럼" 현재 대상 방향(수평+수직)을 조준으로 넣는다 - 아이언 에로우는 8방향으로 나가므로
			-- 위아래 발판의 적에게도 그대로 꽂힌다(어벤져/파이어에로우와 같은 관례).
			if dirX == 0 and dirY == 0 and _AutoHuntManager:IsActive() then
				dirX = _AutoHuntManager:GetAimDirX()
				dirY = _AutoHuntManager:GetAimDirY()
			end
			-- (요청 2026-08-13) MP 20 소모. ⚠ 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetIronArrowMpCost()) then
				log("[SkillManager] 아이언 에로우: MP 부족(필요 " .. tostring(self:GetIronArrowMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (신궁 개편) 화살 1발당 배율을 투자 레벨로 계산해 넘긴다(GetIronArrow*Percent 한 곳에서).
			-- (요청 2026-08-10) 누른 순간의 좌표를 동봉한다 - 기모으기 0.7초 사이에 움직여도
			-- 화살은 이 좌표에서 나간다(점프 시전 좌표 동봉과 같은 규칙).
			local iaLv = math.max(1, self:GetHeroSkillLevelByName("아이언 에로우"))
			local iaPos = _UserService.LocalPlayer.TransformComponent.WorldPosition
			self:RequestFireIronArrowLvPos(combatPower, atkMult, dirX, dirY,
				self:GetIronArrowMinPercent(iaLv) / 100, self:GetIronArrowMaxPercent(iaLv) / 100, iaPos.x, iaPos.y)
			self:TryArcherFinalAttack("아이언 에로우", atkMult)
		elseif slot.name == "엔젤레이" then
			-- 엔젤레이(4차): 아이언에로우와 같은 구조지만 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만
			-- 발사한다 - 방향키 상태를 읽을 필요가 없어 combatPower/공격속도 배율만 서버로 넘긴다.
			-- (비숍 개편 2026-08-08) 마스터 30 spendable - 700%~800%에서 분배당 최소·최대 +30%p.
			-- ⚠ 그리고 **후딜이 1초 늘어난다**(요청) - 공용 쿨다운(skillOnCooldown) 해제 시각에
			--   GetAngelRayExtraRecovery()를 그대로 더한다(다른 스킬은 0.75*배율만 쓴다).
			-- (요청 2026-08-13 2차) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetAngelRayMpCost()) then
				log("[SkillManager] 엔젤레이: MP 부족(필요 " .. tostring(self:GetAngelRayMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult + self:GetAngelRayExtraRecovery())
			local combatPower = self:GetEffectiveCombatPower()
			local arLv = math.max(1, self:GetHeroSkillLevelByName("엔젤레이"))
			self:RequestFireAngelRayLv(combatPower, atkMult,
				self:GetAngelRayMinPercent(arLv) / 100, self:GetAngelRayMaxPercent(arLv) / 100,
				self:GetAngelRayExtraRecovery())
		elseif slot.name == "홀리 에로우" then
			-- 홀리 에로우(2차): 엔젤레이와 같은 전방 고정 발사 - combatPower/공격속도 배율만 서버로 넘긴다.
			-- (요청 2026-08-13 2차) MP 20 소모(아이언 에로우와 같다). ⚠ 쿨타임 세팅보다 먼저.
			if not _MpManager:TryConsumeMp(self:GetHolyArrowMpCost()) then
				log("[SkillManager] 홀리 에로우: MP 부족(필요 " .. tostring(self:GetHolyArrowMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (비숍 개편 2026-08-08) 데미지 배율은 아이언 에로우와 같은 곡선을 쓴다(GetHolyArrow*Percent).
			local haLv = math.max(1, self:GetHeroSkillLevelByName("홀리 에로우"))
			self:RequestFireHolyArrowLv(combatPower, atkMult,
				self:GetHolyArrowMinPercent(haLv) / 100, self:GetHolyArrowMaxPercent(haLv) / 100)
		elseif slot.name == "어벤져" then
			-- (요청 2026-08-14 5차) MP 30 소모. ⚠ 쿨타임·표창 소모보다 먼저(파워스트라이크와 같은 관례) -
			--   MP가 모자란데 표창만 15개 빠지는 사고를 막는다.
			if not _MpManager:TryConsumeMp(self:GetAvengerMpCost()) then
				log("[SkillManager] 어벤져: MP 부족(필요 " .. tostring(self:GetAvengerMpCost()) .. ")")
				return
			end
			-- 파이어에로우/아이언에로우와 동일한 8방향 입력 처리.
			local dirX, dirY = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirX = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirX = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirY = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirY = -1
			end
			-- (M2 자동사냥) 방향키 입력이 없고 자동사냥 중이면 "적 쪽 방향키를 누르고 쓴 것처럼"
			-- 현재 대상 방향(수평+수직)을 조준으로 넣는다 - 어벤져는 8방향으로 나가므로 위아래 발판의
			-- 적에게도 그대로 꽂힌다(파이어에로우/아이언에로우와 같은 관례).
			if dirX == 0 and dirY == 0 and _AutoHuntManager:IsActive() then
				dirX = _AutoHuntManager:GetAimDirX()
				dirY = _AutoHuntManager:GetAimDirY()
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			-- (기능 수정) 몸쪽 이펙트(0.6) + 0.2초 뒤 투사체 발사로 PlayerAttack.AttackAvenger의 실제
			-- 발동 주기가 0.85*mult로 늘어난 것에 맞춰 쿨다운도 동일하게 맞춘다(다른 화살류 스킬과 같은 이유).
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.85 * atkMult)
			-- (표창 재고) 어벤져는 표창 15개를 쓴다.
			self:TryConsumeShuriken(self:GetShurikenCostForSkill("어벤져"))
			local combatPower = self:GetEffectiveCombatPower()
			-- (나이트로드 3차 개편) 전투력 500% 고정 → 투자 레벨별 100%~200% + 분배당 최소·최대 5%p.
			local avLv = self:GetHeroSkillLevelByName("어벤져")
			self:RequestFireAvengerLv(combatPower, atkMult, dirX, dirY,
				self:GetAvengerMinPercent(avLv) / 100, self:GetAvengerMaxPercent(avLv) / 100)
		elseif slot.name == "헤이스트" then
			-- (요청 2026-08-14 4차) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetHasteMpCost()) then
				log("[SkillManager] 헤이스트: MP 부족(필요 " .. tostring(self:GetHasteMpCost()) .. ")")
				return
			end
			-- 헤이스트는 공격이 아니라 버프이므로 combatPower는 필요 없다. 다른 스킬과 동일하게
			-- 공격속도 배율만큼 짧은 재사용 대기시간만 두고(연타 스팸 방지), 지속시간 자체는
			-- 재사용 가능 - 지속 중 다시 쓰면 서버 쪽에서 중첩 없이 지속시간만 갱신된다.
			-- (나이트로드 개편) 지속시간/이동속도/점프 보정 사거리를 투자 레벨로 계산해 서버에 넘긴다
			-- (클라 계산 → RPC 인자 → 서버 _T 보관, 다크나이트 3·4차 개편과 같은 관례).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local hasteLv = self:GetHeroSkillLevelByName("헤이스트")
			self:RequestFireHasteLv(atkMult,
				self:GetHasteDurationForLevel(hasteLv),
				self:GetHasteSpeedMult(hasteLv),
				self:GetHasteJumpRangeMult(hasteLv))
		elseif slot.name == "쉐도우 파트너" then
			-- (요청 2026-08-14 4차) MP 100 소모. ⚠ 쿨타임·표창 소모보다 먼저(파워스트라이크와 같은 관례) -
			--   MP가 모자라 시전이 취소됐는데 표창만 100개 빠지는 사고를 막는다.
			if not _MpManager:TryConsumeMp(self:GetShadowPartnerMpCost()) then
				log("[SkillManager] 쉐도우 파트너: MP 부족(필요 " .. tostring(self:GetShadowPartnerMpCost()) .. ")")
				return
			end
			-- 쉐도우 파트너도 헤이스트와 동일하게 공격이 아니라 버프이므로 combatPower는 필요 없다.
			-- 연타 스팸 방지용 짧은 재사용 대기시간만 두고, 지속 중 다시 쓰면 서버에서 중첩 없이
			-- 지속시간만 갱신된다.
			-- (나이트로드 3차 개편) 지속시간을 투자 레벨로 계산해 서버에 넘긴다(30초 + 분배당 10초).
			-- 분신 데미지 비율은 투자 시점에 이미 서버로 넘겨뒀다(RequestSetShadowPartnerLevel).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (표창 재고) 쉐도우 파트너는 표창 100개를 쓴다.
			self:TryConsumeShuriken(self:GetShurikenCostForSkill("쉐도우 파트너"))
			local spLv = self:GetHeroSkillLevelByName("쉐도우 파트너")
			self:RequestFireShadowPartnerLv(atkMult, self:GetShadowPartnerDurationForLevel(spLv))
		elseif slot.name == "부스터" then
			-- 부스터: 5분간 공격속도 1단계 상승. 이 스탯(atkSpeedStage)은 CharInfoManager가 클라이언트
			-- 전용으로 들고 있어(서버에 대응 데이터 없음) 실제 효과는 이 클라이언트에서 즉시 적용하고,
			-- 서버로는 다른 플레이어에게 보이는 시전 이펙트/사운드 재생만 요청한다.
			-- (요청 2026-08-12) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetSecondBuffMpCost()) then
				log("[SkillManager] 부스터: MP 부족(필요 " .. tostring(self:GetSecondBuffMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local jobIdx = _UIMyInfoManager:GetSelectedCharacterJobIdx()
			local isMage = (jobIdx == 4 or jobIdx == 5 or jobIdx == 6)
			-- (스킬 효과 개편) 지속 20초+분배 가산, 10레벨부터 공속 +2단계
			local boosterLv = self:GetHeroSkillLevelByName("부스터")
			local boosterDur = self:GetHeroBuffDuration(boosterLv)
			local boosterStages = (boosterLv >= 10) and 2 or 1
			_CharInfoManager:UseBooster(boosterDur, boosterStages)
			self:RequestFireBooster(isMage, atkMult)
			log("[SkillManager] 부스터 사용! (Lv." .. tostring(boosterLv) .. " 지속 " .. tostring(boosterDur) .. "초 공속 +" .. tostring(boosterStages * 10) .. "%)")
		elseif slot.name == "브랜디쉬 강화" then
			-- 브랜디쉬 강화(4차 버프): 5분간 브랜디쉬 데미지 1.5배 + 브랜디쉬 공속 +1단계 + 붉은 이펙트.
			-- 부스터와 동일하게 클라 전용 상태(CharInfoManager)로 즉시 적용, 공용 쿨다운만 짧게 둔다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			_CharInfoManager:UseBrandishEnhance()
			log("[SkillManager] 브랜디쉬 강화 사용!")
		elseif slot.name == "서먼 다크드래곤" then
			-- 서먼 다크드래곤(2차 버프). (요청 2026-08-12 3차) 지속 = **10초 + 분배당 5초**(마스터 20 = 105초,
			-- 종전 200초 + 분배당 20초·마스터 600초 고정), MP 50, 데미지는 아래 배율을 시전 RPC로 넘긴다.
			-- (요청 2026-08-12 4차) **재사용 대기시간 폐지**(종전 10분) - 지속이 짧아진 만큼 MP가 유일한
			-- 비용이다. 활성 중 재시전만 막는다(드래곤의 블랙드래곤 연쇄 소환은 서버 쪽 경로라 이 게이트 밖).
			local nowDD = _UtilLogic.ElapsedSeconds
			-- (요청 2026-08-12 5차) **소환 중에도 재시전할 수 있다** - 기존 드래곤을 걷어내고 다시 부른다
			-- (종전엔 "이미 소환 중"으로 막았다). 지속시간도 이 시점부터 새로 시작한다.
			local reSummonDD = (self._T.darkDragonActiveUntil or 0) > nowDD
			-- (요청 2026-08-12 3차) MP 50 소모. ⚠ 활성창 세팅/기존 드래곤 정리보다 먼저 -
			--   MP가 모자라 시전이 취소됐는데 있던 드래곤만 사라지는 사고를 막는다.
			if not _MpManager:TryConsumeMp(self:GetDarkDragonMpCost()) then
				log("[SkillManager] 서먼 다크드래곤: MP 부족(필요 " .. tostring(self:GetDarkDragonMpCost()) .. ")")
				return
			end
			if reSummonDD then
				-- (버그 수정 2026-08-15) 여기서 `RequestCancelBuff("darkdragon")`를 따로 보내던 것을 없앴다 -
				-- 정리와 소환이 **다른 RPC**라 순서가 어긋나고, 정리로 죽은 드래곤의 소멸 통보가 바로 아래에서
				-- 세우는 활성 창을 되레 지워 다음 입력이 정리를 건너뛰게 만들었다(연속 입력 시 2마리).
				-- 정리는 이제 서버 소환 진입점(PlayerAttack.SummonDarkDragonLv)이 스폰 직전에 원자적으로 한다.
				log("[SkillManager] 서먼 다크드래곤: 재소환 - 기존 드래곤은 서버가 스폰 직전에 정리한다")
			end
			local ddLv = math.max(1, self:GetHeroSkillLevelByName("서먼 다크드래곤"))
			local ddDur = self:GetDarkDragonDurationForLevel(ddLv)
			self._T.darkDragonActiveUntil = nowDD + ddDur
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = _CharInfoManager:CalcCombatPower()
			self:RequestFireDarkDragonLv(combatPower, ddDur,
				self:GetDarkDragonMinPercent(ddLv) / 100, self:GetDarkDragonMaxPercent(ddLv) / 100)
			_DarkDragonBuffUI:ShowBuff(ddDur)
			log("[SkillManager] 서먼 다크드래곤 사용! (Lv." .. tostring(ddLv) .. " 지속 " .. tostring(ddDur)
				.. "초, 공격 " .. tostring(math.floor(self:GetDarkDragonMinPercent(ddLv))) .. "~"
				.. tostring(math.floor(self:GetDarkDragonMaxPercent(ddLv))) .. "%, 쿨 없음)")
		elseif slot.name == "분노" then
			-- 분노(2차 버프): 5분간 공마 +30. 부스터/헤이스트와 동일하게 공용 쿨다운만 짧게 두고
			-- 실제 효과는 클라이언트 전용 스탯이라 이 클라에서 즉시 적용, 서버로는 시전 연출만 요청.
			-- (요청 2026-08-12) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetSecondBuffMpCost()) then
				log("[SkillManager] 분노: MP 부족(필요 " .. tostring(self:GetSecondBuffMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (요청 2026-08-12 2차) **전투력 +1%/분배**(마스터 +20%) - 추가 전투력% 배율로 표시 전투력까지
			-- 그대로 오른다. 지속시간은 부스터와 동일 곡선.
			local rageLv = self:GetHeroSkillLevelByName("분노")
			local rageDur = self:GetHeroBuffDuration(rageLv)
			local ragePct = math.max(1, rageLv)
			_CharInfoManager:UseRage(rageDur, ragePct)
			self:RequestFireRage(atkMult)
			log("[SkillManager] 분노 사용! (Lv." .. tostring(rageLv) .. " 전투력 +" .. tostring(ragePct) .. "% 지속 " .. tostring(rageDur) .. "초)")
		elseif slot.name == "불의 영역" then
			-- 불의 영역(2차 버프): 일정 시간 공격 적중 시 10% 확률로 화염 지대 생성(판정은 서버).
			-- 전투력은 시전 시점 값을 서버에 넘겨 화염 지대 데미지 기준으로 쓴다.
			-- (요청 2026-08-14 3차) MP 50 + 지속시간이 **빙하지대(얼음 영역)와 완전히 같아졌다**
			-- (= 블레스 곡선 20초 + 분배당 10초, 마스터 20 = 210초). 종전은 무료 + 10분 고정.
			-- ⚠ MP 소모는 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetFireZoneMpCost()) then
				log("[SkillManager] 불의 영역: MP 부족(필요 " .. tostring(self:GetFireZoneMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (불독 개편 2026-08-08) 장판 데미지 배율을 투자 레벨로 계산해 넘긴다(GetFireZone* =
			-- 빙하지대 헬퍼 위임 - 한쪽만 고치면 갈라지는 것 방지).
			local fzLv = math.max(1, self:GetHeroSkillLevelByName("불의 영역"))
			local fzDur = self:GetFireZoneDurationLv(fzLv)
			self:RequestFireFireZoneLvDur(_CharInfoManager:CalcCombatPower(),
				self:GetFireZoneMinPercent(fzLv) / 100, self:GetFireZoneMaxPercent(fzLv) / 100, fzDur)
			_FireZoneBuffUI:ShowBuff(fzDur)
			log("[SkillManager] 불의 영역 사용! (Lv." .. tostring(fzLv) .. " 장판 "
				.. tostring(math.floor(self:GetFireZoneMinPercent(fzLv))) .. "%~"
				.. tostring(math.floor(self:GetFireZoneMaxPercent(fzLv))) .. "%, 지속 "
				.. tostring(math.floor(fzDur)) .. "초)")
		elseif slot.name == "빙하지대" then
			-- 빙하지대(2차 버프): 불의 영역과 동일 구조의 얼음 판.
			-- (썬콜 개편 2026-08-08) 장판 데미지 배율을 투자 레벨로 계산해 넘긴다(GetGlacierZone* 한 곳에서).
			-- (요청 2026-08-14) MP 50 소모 + 지속시간이 **블레스와 같은 5분**이 됐다(종전 10분).
			-- ⚠ MP 소모는 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetGlacierZoneMpCost()) then
				log("[SkillManager] 빙하지대: MP 부족(필요 " .. tostring(self:GetGlacierZoneMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local gzLv = math.max(1, self:GetHeroSkillLevelByName("빙하지대"))
			-- (요청 2026-08-14 2차) 블레스 지속시간이 레벨 비례로 바뀌면서 빙하지대도 함께 따라간다
			-- ("빙하지대 지속 = 블레스 지속"이 사용자 지정 사양) - 자기 투자 레벨로 계산한다.
			local gzDur = self:GetGlacierZoneDurationLv(gzLv)
			self:RequestFireGlacierZoneLvDur(_CharInfoManager:CalcCombatPower(),
				self:GetGlacierZoneMinPercent(gzLv) / 100, self:GetGlacierZoneMaxPercent(gzLv) / 100, gzDur)
			_GlacierBuffUI:ShowBuff(gzDur)
			log("[SkillManager] 빙하지대 사용! (Lv." .. tostring(gzLv) .. " 장판 "
				.. tostring(math.floor(self:GetGlacierZoneMinPercent(gzLv))) .. "%~"
				.. tostring(math.floor(self:GetGlacierZoneMaxPercent(gzLv))) .. "%, 지속 "
				.. tostring(math.floor(gzDur)) .. "초)")
		elseif slot.name == "메디테이션" then
			-- 메디테이션(2차 버프): 분노와 동일한 처리.
			-- (요청 2026-08-14) 마력 +2/분배(마스터 +40)는 그대로이고, **지속시간과 소모 MP가 블레스와
			-- 같아졌다**(5분 / 무료). 그리고 오른 마력이 **실제 전투력**에 반영된다
			-- (CharInfoManager.UseMeditation이 실효 버프 통을 쓴다 - 종전엔 스탯창 표시에만 실렸다).
			-- ⚠ 지금 블레스가 무료라 TryConsumeMp(0)은 항상 통과한다 - 블레스에 비용이 생기면
			--   GetMeditationMpCost가 자동으로 따라오므로 이 게이트가 그대로 작동한다.
			if not _MpManager:TryConsumeMp(self:GetMeditationMpCost()) then
				log("[SkillManager] 메디테이션: MP 부족(필요 " .. tostring(self:GetMeditationMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local mdLv = math.max(1, self:GetHeroSkillLevelByName("메디테이션"))
			local mdDur = self:GetMeditationDuration(mdLv)
			local mdBonus = 2 * mdLv
			_CharInfoManager:UseMeditation(mdDur, mdBonus)
			self:RequestFireMeditation(atkMult)
			log("[SkillManager] 메디테이션 사용! (Lv." .. tostring(mdLv) .. " 마력 +" .. tostring(mdBonus)
				.. " 지속 " .. tostring(math.floor(mdDur)) .. "초)")
		elseif slot.name == "블레스" then
			-- 블레스(2차 버프): 자신 공마/4스탯 보너스는 클라 전용 스탯이라 즉시 적용하고, 시전 연출과
			-- 힐 범위 안 소환 용사들의 버프/피버프 이펙트는 서버(PlayerAttack.AttackBless)가 처리.
			-- (비숍 개편 2026-08-08) 고정 +30 → **분배 1포인트당 공격력 +1 / 마력 +1 / 4스탯 각 +3**.
			-- (요청 2026-08-14 2차) MP 30 소모 + 지속시간이 **1레벨 20초 + 분배당 10초**가 됐다(종전 고정 5분).
			-- ⚠ MP 소모는 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetBlessMpCost()) then
				log("[SkillManager] 블레스: MP 부족(필요 " .. tostring(self:GetBlessMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local blessLv = math.max(1, self:GetHeroSkillLevelByName("블레스"))
			local blessAtk = self:GetBlessAttackBonus(blessLv)
			local blessDur = self:GetBlessBuffDurationLv(blessLv)
			_CharInfoManager:UseBlessLv(blessAtk, self:GetBlessStatBonus(blessLv), blessDur)
			-- 소환 아군에게 걸어줄 몫은 서버가 처리한다 - 공마 보너스만 넘긴다(소환수에겐 4스탯 개념이 없다).
			self:RequestFireBlessLv(atkMult, blessAtk)
			log("[SkillManager] 블레스 사용! (Lv." .. tostring(blessLv) .. " 공마 +" .. tostring(blessAtk)
				.. ", 4스탯 +" .. tostring(self:GetBlessStatBonus(blessLv))
				.. ", 지속 " .. tostring(math.floor(blessDur)) .. "초)")
		elseif slot.name == "아이언 월" then
			-- 아이언 월(팔라딘 2차 버프): 받는 피해 -2%/pt.
			-- (요청 2026-08-12 2차) 지속시간을 **부스터와 동일 곡선**(GetHeroBuffDuration - 20초 +
			-- 9레벨까지 10초/분배, 10레벨부터 20초/분배, 마스터 20 = 310초)으로 통일. 종전 30+20×(lv-1).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local iwLv = math.max(1, self:GetHeroSkillLevelByName("아이언 월"))
			local iwDur = self:GetHeroBuffDuration(iwLv)
			local iwPct = 2 * iwLv
			-- (버그 수정) 이동 중 시전하면 클라 걷기 상태(MOVE)가 시전 모션을 덮어 캔슬됐다 -
			-- 이동은 클라 권한이므로 클라에서도 서버 잠금(0.6×공속)과 같은 시간 동안 이동을 멈춘다.
			local playerIW = _UserService.LocalPlayer
			if isvalid(playerIW) then
				local pccIW = playerIW.PlayerControllerComponent
				if isvalid(pccIW) and pccIW.Enable then
					pccIW.Enable = false
					if isvalid(playerIW.MovementComponent) then playerIW.MovementComponent:Stop() end
					_TimerService:SetTimerOnce(function()
						if isvalid(pccIW) then pccIW.Enable = true end
					end, 0.6 * atkMult)
				end
			end
			self:RequestFireIronWall(iwDur, iwPct, atkMult)
			_IronWallBuffUI:ShowBuff(iwDur)
			log("[SkillManager] 아이언 월 사용! (Lv." .. tostring(iwLv) .. " 피해 -" .. tostring(iwPct) .. "% 지속 " .. tostring(iwDur) .. "초)")
		elseif slot.name == "샤프 아이즈" then
			-- 샤프 아이즈(신궁 4차 버프, 2026-08-06 신설): 지속 30초 + 분배당 +10초.
			-- 효과는 전부 **클라 전용 스탯**(크확 +1%p/분배 · 크뎀 +8%p 고정)이라 CharInfoManager가 들고,
			-- 서버 판정에는 SyncSharpEyesStats가 SyncCritRate/SyncCritDamage로 밀어 넣는다.
			-- 서버(PlayerAttack.AttackSharpEyes)는 시전 모션·사운드·이펙트만 맡는다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local seLv = math.max(1, self:GetHeroSkillLevelByName("샤프 아이즈"))
			local seDur = self:GetSharpEyesDuration(seLv)
			-- 아이언 월/발도술과 동일: 이동 중 시전 시 클라 걷기(MOVE) 상태가 시전 모션을 덮지 않도록
			-- 서버 잠금(0.6×공속)과 같은 시간 동안 클라에서도 이동을 멈춘다(이동은 클라 권한).
			local playerSE = _UserService.LocalPlayer
			if isvalid(playerSE) then
				local pccSE = playerSE.PlayerControllerComponent
				if isvalid(pccSE) and pccSE.Enable then
					pccSE.Enable = false
					if isvalid(playerSE.MovementComponent) then playerSE.MovementComponent:Stop() end
					_TimerService:SetTimerOnce(function()
						if isvalid(pccSE) then pccSE.Enable = true end
					end, 0.6 * atkMult)
				end
			end
			self:RequestFireSharpEyes(atkMult)
			self:StartSharpEyesLocal(seDur, seLv)
			log("[SkillManager] 샤프 아이즈 사용! (Lv." .. tostring(seLv) .. " 지속 " .. tostring(math.floor(seDur))
				.. "초, 크확 +" .. tostring(self:GetSharpEyesCritRate(seLv)) .. "% / 크뎀 +" .. tostring(self:GetSharpEyesCritDamage()) .. "%)")
		elseif slot.name == "발도술" then
			-- 발도술(히어로 3차 버프): (요청 2026-08-12) 지속시간은 **분노와 동일 곡선**(GetHeroBuffDuration -
			-- 20초 + 9레벨까지 +10초/10레벨부터 +20초, 마스터 310초). 기본 사용 효과 = 지속시간 동안
			-- 공속 +1단계(클라 즉시 적용). 지속 중 파워스트라이크/슬래시블러스트/돌진/브랜디쉬로 적을
			-- **공격하면**(구 사양은 처치) 3초 중첩 버프(중첩당 **공격속도 +3%**·크확 +3%).
			-- 중첩 상한은 분배 구간별 1(1~9)/2(10~19)/3(20).
			-- 중첩 상태는 서버(PlayerAttack)가 관리하고, 클라는 스탯 적용(CharInfoManager)과 표시만 맡는다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local btLv = math.max(1, self:GetHeroSkillLevelByName("발도술"))
			local btDur = self:GetHeroBuffDuration(btLv)
			local btStacks = 1
			if btLv >= 20 then
				btStacks = 3
			elseif btLv >= 10 then
				btStacks = 2
			end
			-- 아이언 월과 동일: 이동 중 시전 시 클라 걷기(MOVE) 상태가 시전 모션을 덮지 않도록
			-- 서버 잠금(0.6×공속)과 같은 시간 동안 클라에서도 이동을 멈춘다(이동은 클라 권한).
			local playerBT = _UserService.LocalPlayer
			if isvalid(playerBT) then
				local pccBT = playerBT.PlayerControllerComponent
				if isvalid(pccBT) and pccBT.Enable then
					pccBT.Enable = false
					if isvalid(playerBT.MovementComponent) then playerBT.MovementComponent:Stop() end
					_TimerService:SetTimerOnce(function()
						if isvalid(pccBT) then pccBT.Enable = true end
					end, 0.6 * atkMult)
				end
			end
			self:RequestFireBattojutsu(btDur, btStacks, atkMult)
			-- 기본 사용 효과: 버프 지속시간 동안 공속 +1단계 (부스터와 별도 토큰이라 겹쳐 적용된다).
			_CharInfoManager:UseBattoAtkSpeed(btDur, 1)
			_BattoBuffUI:ShowBuff(btDur)
			log("[SkillManager] 발도술 사용! (Lv." .. tostring(btLv) .. " 지속 " .. tostring(btDur) .. "초 공속 +10%, 최대 " .. tostring(btStacks) .. "중첩)")
		elseif slot.name == "속성필드" then
			-- 속성필드(팔라딘 3차 버프): 필드 지속 10초+2분배당 1초.
			-- (요청) 시전 모션 단축: 2단 홀드 폐지 - 모션(약 0.75초) 동안만 클라 이동/스킬 잠금(0.7초).
			-- (요청 2026-08-12 2차) MP 50 소모 + 버프 지속시간을 **부스터와 동일 곡선**으로 통일
			-- (종전 60초+분배당 20초). ⚠ MP는 쿨타임/잠금 세팅보다 먼저 시도한다.
			if not _MpManager:TryConsumeMp(self:GetElementalFieldMpCost()) then
				log("[SkillManager] 속성필드: MP 부족(필요 " .. tostring(self:GetElementalFieldMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.7)
			self._T.actionLockUntil = _UtilLogic.ElapsedSeconds + 0.7
			local efLv = math.max(1, self:GetHeroSkillLevelByName("속성필드"))
			local efDur = self:GetHeroBuffDuration(efLv)
			local efZoneDur = 10 + math.floor(efLv / 2)
			-- (요청) 이동 중 시전해도 모션이 안 끊기게 클라 이동 잠금 + 모션이 끝날 때까지 좌우
			-- 방향 전환 금지(0.05초마다 시전 방향 재고정 - 컨트롤러가 꺼져도 look은 바뀔 수 있어서).
			local playerEF = _UserService.LocalPlayer
			if isvalid(playerEF) then
				local pccEF = playerEF.PlayerControllerComponent
				if isvalid(pccEF) then
					local lockDir = pccEF.LookDirectionX
					if pccEF.Enable then
						pccEF.Enable = false
						if isvalid(playerEF.MovementComponent) then playerEF.MovementComponent:Stop() end
						_TimerService:SetTimerOnce(function()
							if isvalid(pccEF) then pccEF.Enable = true end
						end, 0.7)
					end
					if self._T.efDirLockTimer ~= nil then _TimerService:ClearTimer(self._T.efDirLockTimer) end
					self._T.efDirLockTimer = _TimerService:SetTimerRepeat(function()
						if isvalid(pccEF) then pccEF.LookDirectionX = lockDir end
					end, 0.05)
					_TimerService:SetTimerOnce(function()
						if self._T.efDirLockTimer ~= nil then
							_TimerService:ClearTimer(self._T.efDirLockTimer)
							self._T.efDirLockTimer = nil
						end
					end, 0.7)
				end
			end
			self:RequestFireElementalField(efDur, efZoneDur, atkMult)
			_ElemFieldBuffUI:ShowBuff(efDur)
			log("[SkillManager] 속성필드 사용! (Lv." .. tostring(efLv) .. " 버프 " .. tostring(efDur) .. "초 / 필드 " .. tostring(efZoneDur) .. "초)")
		elseif slot.name == "파워가드" then
			-- 파워가드(2차 버프): 5분간 공격력 +10(클라 스탯) + 받는 피해 30% 회복(서버 PlayerHit).
			-- (요청 2026-08-12) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetSecondBuffMpCost()) then
				log("[SkillManager] 파워가드: MP 부족(필요 " .. tostring(self:GetSecondBuffMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (요청 2026-08-12 개편) 공격력 +10 폐지. 지속시간 부스터와 동일 곡선,
			-- 회복률 = 분배당 2%(피격 1초 후 10초에 걸쳐), 받는 피해 감소 = 분배당 1%(버프 중 상시).
			local pgLv = self:GetHeroSkillLevelByName("파워가드")
			local pgDur = self:GetHeroBuffDuration(pgLv)
			local pgHealPct = 2 * math.max(1, pgLv)
			local pgReducePct = math.max(1, pgLv)
			_CharInfoManager:UsePowerGuard(pgDur)
			self:RequestFirePowerGuardLv(atkMult, pgDur, pgHealPct, pgReducePct)
			log("[SkillManager] 파워가드 사용! (Lv." .. tostring(pgLv) .. " 지속 " .. tostring(pgDur) .. "초 회복 "
				.. tostring(pgHealPct) .. "% 받는 피해 -" .. tostring(pgReducePct) .. "%)")
		elseif slot.name == "포이즌 미스트" then
			-- 포이즌 미스트: 독 데미지 자체는 공격속도 영향을 받지 않지만, 스킬 자체의 재사용 대기시간은
			-- 다른 스킬과 동일하게 공격속도 배율을 적용한다(연타 스팸 방지 목적일 뿐 독 틱과는 무관).
			-- (요청 2026-08-14 3차) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetPoisonMistMpCost()) then
				log("[SkillManager] 포이즌 미스트: MP 부족(필요 " .. tostring(self:GetPoisonMistMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (불독 개편 2026-08-08) 독 틱 데미지 배율을 투자 레벨로 계산해 넘긴다(GetPoisonMist* 한 곳).
			local pmLv = math.max(1, self:GetHeroSkillLevelByName("포이즌 미스트"))
			self:RequestFirePoisonMistLv(combatPower, atkMult,
				self:GetPoisonMistMinPercent(pmLv) / 100, self:GetPoisonMistMaxPercent(pmLv) / 100)
		elseif slot.name == "익스플로젼" then
			-- (요청 2026-08-14 3차) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetExplosionMpCost()) then
				log("[SkillManager] 익스플로젼: MP 부족(필요 " .. tostring(self:GetExplosionMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- (불독 개편 2026-08-08) 폭발 데미지 배율을 투자 레벨로 계산해 넘긴다(GetExplosion* 한 곳).
			local exLv = math.max(1, self:GetHeroSkillLevelByName("익스플로젼"))
			self:RequestFireExplosionLv(combatPower, atkMult,
				self:GetExplosionMinPercent(exLv) / 100, self:GetExplosionMaxPercent(exLv) / 100)
		elseif slot.name == "드래곤 로어" then
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- (버그 수정 2026-08-07) 재입력 게이트를 **서버 잠금과 같은 고정 2.0초**로 맞춘다.
			-- ⚠ 신고: "자동사냥에서 드래곤 로어 도중에 스피어 버스터를 쓴다".
			--   드래곤 로어만 서버 컨트롤 잠금이 **공격속도와 무관한 고정 2초**(스턴 연출,
			--   PlayerAttack.AttackDragonRoar)인데, 여기 게이트는 다른 스킬과 같은 0.75×공속이었다.
			--   공속이 빠르면 0.3초 안팎이라, 자동사냥 공격 틱(0.5초)이 로어 모션 한가운데서
			--   다음 스킬을 그대로 뽑아 시전했다(스피어 버스터는 자기 플래그만 보므로 그냥 들어간다).
			--   서버가 잠가둔 2초를 클라 게이트가 그대로 덮도록 **공속을 곱하지 않는다**.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 2.0)
			local combatPower = self:GetEffectiveCombatPower()
			-- (스펙 개편) 데미지 배율(300%+분배당 30%p)과 HP 소모율(70%에서 분배당 -1%p)을 클라가
			-- 투자 레벨로 계산해 서버에 넘긴다 - 서버는 받은 값을 그대로 쓴다(공식 이중화 방지).
			local drLv = math.max(1, self:GetHeroSkillLevelByName("드래곤 로어"))
			self:RequestFireDragonRoar(combatPower, atkMult,
				self:GetDragonRoarPercent(drLv) / 100, self:GetDragonRoarHpCostPercent(drLv) / 100)
			log("[SkillManager] 드래곤 로어 사용(Lv." .. tostring(drLv) .. ", "
				.. tostring(math.floor(self:GetDragonRoarPercent(drLv))) .. "~"
				.. tostring(math.floor(self:GetDragonRoarMaxPercent(drLv))) .. "% / HP "
				.. tostring(math.floor(self:GetDragonRoarHpCostPercent(drLv))) .. "% 소모)")
		elseif slot.name == "스피어 버스터" then
			-- (실측 확인) 클라이언트 쿨다운을 다른 스킬과 동일하게 0.75*atkMult로 두면, 서버 쪽
			-- isSpearBursting 잠금이 풀리는 시점(RestoreSpearBurstControl)보다 클라이언트가
			-- 먼저 재시전을 시도하게 돼, 홀드 지속 시전 시 요청의 절반 가까이가 "이미 진행 중"으로
			-- 차단되는 문제가 있었다(로그로 확인: 116번 시도 중 58번 차단). 서버 잠금 해제 시점과
			-- 동일하게 맞춰 홀드 시 매번 성공하도록 한다.
			-- (버그 수정) RestoreSpearBurstControl 자체가 PlayerAttack.mlua에서 반대 방향 모션 재생
			-- 버그를 막기 위해 0.95*atkMult에서 1.55*atkMult로 늦춰졌으므로, 여기 쿨다운도 동일하게
			-- 맞춘다 - 둘이 어긋나면 이 "이미 진행 중" 차단 문제가 다시 재현된다.
			-- (기능 추가) PlayerAttack.AttackSpearBurst에서 이펙트/데미지 공용이었던 hitStartDelay가
			-- "히트 속도는 0.7초 뒤, 찌르기 3종 이펙트 시점은 그보다 0.5초 앞당겨서" 요청으로
			-- damageStartDelay(0.7)/effectStartDelay(0.2)로 다시 분리됐다.
			-- (기능 추가) "스킬이 끝났는데도 못 움직이는 시간이 길게 느껴진다"는 피드백으로
			-- RestoreSpearBurstControl 호출 시점이 damageStartDelay + 1.0*atkMult(여유 과다)에서
			-- damageStartDelay + 0.2*atkMult + 0.05(3번째 실제 데미지 판정 직후 최소 여유)로 줄었다 -
			-- 이 쿨다운도 그와 반드시 동일해야 하므로 맞춘다.
			-- (기능 추가) "3종 찌르기 이펙트 간 시간 간격을 1.5배 늘려달라"는 피드백으로 PlayerAttack.mlua의
			-- 간격 상수가 0.2*mult→0.3*mult로 늘어난 것에 맞춰 이 쿨다운도 동일하게 0.3*atkMult로 맞춘다.
			-- (기능 추가) "데미지 시점을 0.2초 앞당겨달라"는 피드백으로 damageStartDelay가 0.7→0.5로
			-- 줄어든 것에 맞춰 이 쿨다운의 기준값도 0.7→0.5로 함께 맞춘다.
			-- (되돌림) "공격속도 단계를 올려도 스피어 버스터에 적용되지 않는다"는 피드백으로, 이전에
			-- 고정했던 하드코딩(0.9^3, 공격속도 3단계 고정)을 되돌리고 다른 스킬과 동일하게 플레이어의
			-- 실제 현재 공격속도 단계를 그대로 사용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- (버그 수정) PlayerAttack.AttackSpearBurst의 컨트롤 복구 시점과 반드시 동일한 공식으로
			-- 맞춘다(둘이 어긋나면 "이미 진행 중" 차단 문제가 재현된다).
			-- (버그 수정) "꾹 누르고 있으면 중간중간 1-2초씩 불규칙하게 멈춘다"는 피드백 - 로그로 실측한
			-- 결과, 서버 쪽 isSpearBursting 잠금 해제와 클라이언트 쿨다운 해제가 평균적으로는 같은
			-- 공식이라도 매 호출마다 클라이언트→서버 RPC 왕복 지연(네트워크 지터)이 조금씩 달라, 가끔
			-- 클라이언트가 서버보다 미세하게 먼저 재시전을 시도해 "이미 진행 중"으로 막힌다 - 이때
			-- 클라이언트는 이미 자기 쿨다운을 다 쓴 것으로 착각해 다음 재시전까지 꼬박 한 주기를 더
			-- 기다리게 되고, 그 결과 직전 성공 시점부터는 정상 간격의 약 2배로 보인다. 클라이언트
			-- 쿨다운에 지터 흡수용 여유(0.15초)를 추가로 얹어, 클라이언트가 항상 서버보다 확실히 늦게
			-- 재시전을 시도하도록 한다.
			-- (버그 수정) "공속을 올려도 공격 횟수가 거의 안 는다 - 파워스트라이크는 확실히 는다"는
			-- 피드백 - damageStartDelay(0.5)가 atkMult와 무관한 고정값이라 전체 주기가 공속에 비례해
			-- 줄지 않던 것이 원인이었다. PlayerAttack.AttackSpearBurst와 동일하게 damageStartDelay 자체를
			-- 0.5*atkMult로 스케일링했으므로, 여기 쿨다운 공식도 반드시 동일하게 맞춘다.
			-- (버그 수정) 이어서 "+0.05" 안전 여유도 atkMult와 무관한 고정값이라 공속이 빨라질수록 전체
			-- 주기에서 차지하는 비중이 커져 DPS 스케일링을 계속 깎아먹고 있었다 - 0.05*atkMult로 바꿔
			-- 파워스트라이크(0.75*atkMult)와 동일하게 순수 비례식(0.85*atkMult)이 되도록 한다. 지터
			-- 흡수용 여유(jitterMargin)만은 실제 네트워크 왕복 지연(공속과 무관한 고정 시간)을 막기
			-- 위한 것이므로 의도적으로 고정값(0.15초)을 유지한다.
			-- (기능 추가) "날개가 생기고 다음 공격까지의 시간을 단축해달라 - stabT1 frame2가 재생될
			-- 때여야 한다"는 피드백으로 PlayerAttack의 damageStartDelay가 0.5*atkMult에서 5단 조합
			-- 모션의 3번째 포즈 시점(2 * poseInterval = 0.288*atkMult)으로 당겨졌다. 이 쿨다운도
			-- 반드시 동일한 공식이어야 한다.
			-- (버그 수정) motionComboEnd가 (0.12+0.25+0.2)=0.57로 남아 있었는데, PlayerAttack 쪽은
			-- 이미 beat3Hold 0.2→0.35 수정으로 0.72였다(여기만 갱신이 누락돼 있었다). 지금은 5단
			-- 조합 포즈(5 * poseInterval = 0.72*atkMult)로 바뀌었으므로 그 값으로 맞춘다 - 이 값이
			-- 이제 아래 math.max의 승자라서, 어긋나면 곧바로 "이미 진행 중" 차단이 재현된다.
			local poseInterval = 0.144 * atkMult
			local damageStartDelay = 2 * poseInterval
			local motionComboEnd = 5 * poseInterval
			local jitterMargin = 0.15
			local spearBurstCooldownDuration = math.max(damageStartDelay + 0.3 * atkMult + 0.05 * atkMult, motionComboEnd + 0.05 * atkMult) + jitterMargin
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, spearBurstCooldownDuration)
			-- (요청 2026-08-12 5차) MP 20 소모. ⚠ 쿨다운 세팅 뒤이지만 시전 요청 전이라 소모 실패 시
			--   서버로 나가지 않는다(공용 게이트는 0.x초라 다음 입력에서 곧바로 재시도된다).
			if not _MpManager:TryConsumeMp(self:GetSpearBurstMpCost()) then
				log("[SkillManager] 스피어 버스터: MP 부족(필요 " .. tostring(self:GetSpearBurstMpCost()) .. ")")
				return
			end
			local combatPower = self:GetEffectiveCombatPower()
			-- (요청 2026-08-12 5차) 줄당 데미지 배율(104~124% + 분배당 각 4%p)과 동시 타격 수(4/6/8/10명)를
			-- 클라가 투자 레벨로 계산해 서버에 넘긴다.
			local sbLv = math.max(1, self:GetHeroSkillLevelByName("스피어 버스터"))
			-- (4차, 2026-08-05 개편) 어드밴스드 스피어 버스터: **투자 레벨만으로 항상** 줄당 최소/최대에
			-- 보너스를 더한다(구 사양의 combatPower 1.5배는 폐지 - 이중 성장이었다).
			-- ⚠ enhanced(=강화 이펙트 아트) 플래그는 데미지와 완전히 분리됐다 - 토글을 꺼도 데미지 보너스는
			--   그대로 들어가고, 이펙트만 원래 스피어 버스터 아트로 나간다(요청 2026-08-05).
			local advLv = self:GetHeroSkillLevelByName("어드밴스드 스피어 버스터")
			local sbMinPct = self:GetSpearBurstMinPercent(sbLv) + self:GetAdvSpearBurstMinBonus(advLv)
			local sbMaxPct = self:GetSpearBurstMaxPercent(sbLv) + self:GetAdvSpearBurstMaxBonus(advLv)
			local enhanced = (advLv >= 1) and _CharInfoManager:IsAdvancedSpearBusterEffectOn()
			self:RequestFireSpearBurst(combatPower, atkMult, enhanced,
				sbMinPct / 100, sbMaxPct / 100,
				self:GetSpearBurstTargetCount(sbLv))
			log("[SkillManager] 스피어 버스터 사용(Lv." .. tostring(sbLv) .. " + 어드밴스드 Lv." .. tostring(advLv)
				.. " → " .. tostring(math.floor(sbMinPct)) .. "%~" .. tostring(math.floor(sbMaxPct))
				.. "%, 강화 이펙트 " .. (enhanced and "ON" or "OFF") .. ")")
		elseif slot.name == "콤보 어택" then
			-- 콤보 어택(3차 버프): 헤이스트와 동일하게 공격이 아니라 버프이므로 combatPower는
			-- 필요 없고, 짧은 재사용 대기시간만 둔다(연타 스팸 방지). 지속 중 다시 쓰면 서버 쪽에서
			-- 중첩 없이 지속시간만 갱신된다.
			-- (요청 2026-08-12) MP 30 소모. ⚠ 쿨타임 세팅보다 먼저 판정(파워스트라이크와 같은 관례).
			if not _MpManager:TryConsumeMp(self:GetComboAttackMpCost()) then
				log("[SkillManager] 콤보 어택: MP 부족(필요 " .. tostring(self:GetComboAttackMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- (스킬 효과 개편) 지속시간 2분 → 마스터(30) 10분 선형 증가
			local comboLv = self:GetHeroSkillLevelByName("콤보 어택")
			local comboDur = self:GetComboDurationForLevel(comboLv)
			self:RequestFireComboAttack(atkMult, comboDur)
			log("[SkillManager] 콤보 어택 사용! (Lv." .. tostring(comboLv) .. " 지속 " .. tostring(math.floor(comboDur)) .. "초)")
		elseif slot.name == "패닉" then
			-- 패닉: 콤보 어택으로 쌓은 콤보 구슬을 모두 소모해 단일 대상에게 강력한 피해를 입힌다.
			-- 구슬이 하나도 없으면 사용할 수 없다(요청사항) - 서버(PlayerAttack.AttackPanic)에서도
			-- 다시 확인하지만, 클라이언트에서 미리 걸러 헛되이 쿨다운이 걸리지 않게 한다(럭키세븐의
			-- 가니어 장착 확인과 동일한 패턴).
			local localPlayer = _UserService.LocalPlayer
			local paComp = isvalid(localPlayer) and localPlayer:GetComponent(PlayerAttack) or nil
			if paComp == nil or (paComp.ComboOrbCount or 0) <= 0 then
				log("[SkillManager] 패닉: 콤보 구슬이 없어 사용할 수 없습니다.")
				return
			end
			-- (요청 2026-08-12) MP 50 소모. ⚠ 쿨타임 세팅보다 먼저 판정(공용 관례).
			if not _MpManager:TryConsumeMp(self:GetOrbSkillMpCost()) then
				log("[SkillManager] 패닉: MP 부족(필요 " .. tostring(self:GetOrbSkillMpCost()) .. ")")
				return
			end
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- ⚠ 콤보 배율을 뺀 전투력을 쓴다 - 패닉 데미지가 `전투력 × 구슬수 × 배율`이라 전투력에 실린
			--   구슬 보너스까지 곱하면 구슬 수가 두 번 반영된다(요청 2026-08-12 2차 개편).
			local combatPower = self:GetEffectiveCombatPowerNoCombo()
			-- (요청 2026-08-12) 구슬당 배율이 투자 레벨 비례로 바뀌어 시전 시 함께 넘긴다(파워스트라이크 방식).
			local panicLv = math.max(1, self:GetHeroSkillLevelByName("패닉"))
			self:RequestFirePanicLv(combatPower, atkMult,
				self:GetPanicMinPercent(panicLv) / 100, self:GetPanicMaxPercent(panicLv) / 100)
			log("[SkillManager] 패닉 사용! (Lv." .. tostring(panicLv) .. " 구슬당 "
				.. tostring(math.floor(self:GetPanicMinPercent(panicLv))) .. "~"
				.. tostring(math.floor(self:GetPanicMaxPercent(panicLv))) .. "%)")
		elseif slot.name == "코마" then
			-- 코마: 패닉과 동일하게 콤보 어택으로 쌓은 콤보 구슬을 모두 소모한다(다만 다중 대상).
			-- 구슬이 하나도 없으면 사용할 수 없다 - 패닉과 동일한 클라이언트 사전 확인 패턴.
			local localPlayer = _UserService.LocalPlayer
			local paComp = isvalid(localPlayer) and localPlayer:GetComponent(PlayerAttack) or nil
			if paComp == nil or (paComp.ComboOrbCount or 0) <= 0 then
				log("[SkillManager] 코마: 콤보 구슬이 없어 사용할 수 없습니다.")
				return
			end
			-- (요청 2026-08-12) MP 50 소모 - 패닉과 동일.
			if not _MpManager:TryConsumeMp(self:GetOrbSkillMpCost()) then
				log("[SkillManager] 코마: MP 부족(필요 " .. tostring(self:GetOrbSkillMpCost()) .. ")")
				return
			end
			-- 패닉과 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- ⚠ 패닉과 같은 사유로 콤보 배율을 뺀 전투력을 쓴다(구슬 수 이중 반영 방지).
			local combatPower = self:GetEffectiveCombatPowerNoCombo()
			local comaLv = math.max(1, self:GetHeroSkillLevelByName("코마"))
			self:RequestFireComaLv(combatPower, atkMult,
				self:GetComaMinPercent(comaLv) / 100, self:GetComaMaxPercent(comaLv) / 100)
			log("[SkillManager] 코마 사용! (Lv." .. tostring(comaLv) .. " 구슬당 "
				.. tostring(math.floor(self:GetComaMinPercent(comaLv))) .. "~"
				.. tostring(math.floor(self:GetComaMaxPercent(comaLv))) .. "%)")
		elseif slot.name == "블리자드" then
			-- 블리자드(4차): 자체 쿨타임은 제네시스와 동일(120초 - 분배당 1초, 마스터 91초).
			-- 어썰터와 동일하게 퀵슬롯 아이콘 위에 회색 오버레이 + 남은 초 숫자로 쿨타임을 표시한다
			-- (전용 오버레이 엔티티를 쓰므로 어썰터 표시와 서로 간섭하지 않는다).
			local inAuraBliz = self:IsInRecoveryAura()
			if self._T.blizzardOnCooldown and not inAuraBliz then
				log("[SkillManager] 블리자드: 쿨타임 중")
				return
			end
			-- (요청 2026-08-14) MP 100 소모(제네시스와 같다). ⚠ 쿨타임 세팅보다 먼저.
			-- ⚠ 오로라 안에서는 쿨타임이 면제되므로 연사가 되는데, 그때도 시전마다 100씩 든다.
			if not _MpManager:TryConsumeMp(self:GetBlizzardMpCost()) then
				log("[SkillManager] 블리자드: MP 부족(필요 " .. tostring(self:GetBlizzardMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- 시전 모션/연타 방지용 공용 쿨다운은 다른 스킬과 동일하게 짧게만 건다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local bzLv = math.max(1, self:GetHeroSkillLevelByName("블리자드"))
			local bzCd = self:ApplyCooldownReduction(self:GetBlizzardCooldown(bzLv))
			-- 블리자드 전용 쿨타임(공격속도와 무관 - 제네시스와 동일 공식). 오로라 안에서는 걸지 않는다.
			if not inAuraBliz then
				self._T.blizzardOnCooldown = true
				-- 해제 타이머는 세대 번호로 보호한다 - 오로라 진입으로 쿨타임이 중간에 초기화되면 세대가
				-- 올라가므로, 뒤늦게 깨어난 옛 타이머가 그 뒤에 새로 건 쿨타임을 앞당겨 끄지 못한다.
				self._T.blizzardCdGen = (self._T.blizzardCdGen or 0) + 1
				local blizzardGen = self._T.blizzardCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.blizzardCdGen ~= blizzardGen then return end
					self._T.blizzardOnCooldown = false
					log("[SkillManager] 블리자드 쿨타임 종료")
				end, bzCd)
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_BlizzardCooldownUI:ShowCooldown(bzCd, barPos)
				end
			end
			local combatPower = self:GetEffectiveCombatPower()
			-- (썬콜 개편 2026-08-08) 데미지 배율을 투자 레벨로 계산해 넘긴다(GetBlizzard* 한 곳에서 -
			-- 제네시스와 같은 분배당 +30%p 증가량).
			self:RequestFireBlizzardLv(combatPower, atkMult,
				self:GetBlizzardMinPercent(bzLv) / 100, self:GetBlizzardMaxPercent(bzLv) / 100)
			log("[SkillManager] 블리자드 사용! (Lv." .. tostring(bzLv) .. " "
				.. tostring(math.floor(self:GetBlizzardMinPercent(bzLv))) .. "%~"
				.. tostring(math.floor(self:GetBlizzardMaxPercent(bzLv))) .. "%, 쿨타임 "
				.. tostring(math.floor(bzCd)) .. "초)")
		elseif slot.name == "메테오" then
			-- 메테오(4차): 블리자드/제네시스와 같은 규격의 자체 쿨타임 + 전용 오버레이 쿨타임 표시.
			-- (불독 개편 2026-08-08) 마스터 30 spendable - 쿨타임이 20초 고정 → 120초에서 분배
			-- 1포인트당 -1초(GetMeteorCooldown = 제네시스 위임, 마스터 91초)로 바뀌었고,
			-- 운석당 데미지 700%~1000%에서 분배당 최소·최대 +30%p.
			local inAuraMeteor = self:IsInRecoveryAura()
			if self._T.meteorOnCooldown and not inAuraMeteor then
				log("[SkillManager] 메테오: 쿨타임 중")
				return
			end
			-- (요청 2026-08-14 3차) MP 100 소모(제네시스와 같다). ⚠ 쿨타임 세팅보다 먼저.
			-- ⚠ 오로라 안에서는 쿨타임이 면제되므로 연사가 되는데, 그때도 시전마다 100씩 든다(블리자드와 동일).
			if not _MpManager:TryConsumeMp(self:GetMeteorMpCost()) then
				log("[SkillManager] 메테오: MP 부족(필요 " .. tostring(self:GetMeteorMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- 시전 모션/연타 방지용 공용 쿨다운은 다른 스킬과 동일하게 짧게만 건다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local mtLv = math.max(1, self:GetHeroSkillLevelByName("메테오"))
			local mtCd = self:ApplyCooldownReduction(self:GetMeteorCooldown(mtLv))
			-- 메테오 전용 쿨타임(공격속도와 무관 - 블리자드/제네시스와 동일 공식). 오로라 안에서는 걸지 않는다.
			if not inAuraMeteor then
				self._T.meteorOnCooldown = true
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.meteorCdGen = (self._T.meteorCdGen or 0) + 1
				local meteorGen = self._T.meteorCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.meteorCdGen ~= meteorGen then return end
					self._T.meteorOnCooldown = false
					log("[SkillManager] 메테오 쿨타임 종료")
				end, mtCd)
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_MeteorCooldownUI:ShowCooldown(mtCd, barPos)
				end
			end
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireMeteorLv(combatPower, atkMult,
				self:GetMeteorMinPercent(mtLv) / 100, self:GetMeteorMaxPercent(mtLv) / 100)
			log("[SkillManager] 메테오 사용! (Lv." .. tostring(mtLv) .. " "
				.. tostring(math.floor(self:GetMeteorMinPercent(mtLv))) .. "%~"
				.. tostring(math.floor(self:GetMeteorMaxPercent(mtLv))) .. "%, 쿨타임 "
				.. tostring(math.floor(mtCd)) .. "초)")
		elseif slot.name == "제네시스" then
			-- 제네시스(4차): 블리자드/메테오와 같은 규격의 자체 쿨타임 + 전용 오버레이 쿨타임 표시.
			-- (비숍 개편 2026-08-08) 마스터 30 spendable - 쿨타임 120초에서 분배 1포인트당 -1초(마스터 91초),
			-- 기둥당 데미지 1000%~1300%에서 분배당 최소·최대 +30%p.
			-- ⚠ **키를 누르고 있으면 이 쿨타임 게이트를 통과할 때마다 자동으로 다시 나간다**(요청) -
			--   OnUpdate의 제네시스 전용 홀드 블록이 담당한다. 평소에는 쿨타임이 길어 사실상 1회지만,
			--   리커버리 오로라 안에서는 게이트가 통째로 면제되므로 누르고 있는 동안 연사가 된다.
			local inAuraGen = self:IsInRecoveryAura()
			if self._T.genesisOnCooldown and not inAuraGen then
				log("[SkillManager] 제네시스: 쿨타임 중")
				return
			end
			-- (요청 2026-08-13 2차) MP 100 소모. ⚠ 쿨타임 세팅보다 먼저(파워스트라이크와 같은 관례).
			-- ⚠ 홀드 재시전도 이 분기를 다시 타므로 재시전마다 100씩 든다(오로라 안 연사 = MP 소모 연사).
			if not _MpManager:TryConsumeMp(self:GetGenesisMpCost()) then
				log("[SkillManager] 제네시스: MP 부족(필요 " .. tostring(self:GetGenesisMpCost()) .. ")")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- 시전 모션/연타 방지용 공용 쿨다운은 다른 스킬과 동일하게 짧게만 건다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local genLv = math.max(1, self:GetHeroSkillLevelByName("제네시스"))
			local genCd = self:ApplyCooldownReduction(self:GetGenesisCooldown(genLv))
			-- 제네시스 전용 쿨타임(공격속도와 무관 - 블리자드/메테오와 동일). 오로라 안에서는 걸지 않는다.
			if not inAuraGen then
				self._T.genesisOnCooldown = true
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.genesisCdGen = (self._T.genesisCdGen or 0) + 1
				local genesisGen = self._T.genesisCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.genesisCdGen ~= genesisGen then return end
					self._T.genesisOnCooldown = false
					log("[SkillManager] 제네시스 쿨타임 종료")
				end, genCd)
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_GenesisCooldownUI:ShowCooldown(genCd, barPos)
				end
			end
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireGenesisLv(combatPower, atkMult,
				self:GetGenesisMinPercent(genLv) / 100, self:GetGenesisMaxPercent(genLv) / 100)
			log("[SkillManager] 제네시스 사용! (Lv." .. tostring(genLv) .. " "
				.. tostring(math.floor(self:GetGenesisMinPercent(genLv))) .. "%~"
				.. tostring(math.floor(self:GetGenesisMaxPercent(genLv))) .. "%, 쿨타임 "
				.. tostring(math.floor(genCd)) .. "초)")
		elseif slot.name == "브랜디쉬" then
			-- 브랜디쉬(4차): 자체 쿨타임 없이 공용 쿨다운만 쓴다. 시전 시간은 PlayerAttack.AttackBrandish가
			-- 컨트롤을 돌려주는 시각(RestoreBrandishControl)과 같은 공식으로 구한다 - 한쪽을 바꾸면
			-- 반드시 양쪽을 같이 바꿔야 한다:
			--   motionMult   = 0.625 * 배율            (모션 속도 1.6배)
			--   finishMult   = motionMult + 0.2/0.65   (마지막 swingTF만 0.2초 더 길게)
			--   시전 시간    = 0.65*motionMult + 0.75*finishMult
			--
			-- (버그 수정) "꾹 누르고 있으면 2~4번 공격하고 1~2초 아무 반응 없다가 다시 공격한다"
			-- 원인: 이 쿨다운을 서버 시전 시간과 **정확히 같게** 두면, 클라 쿨다운 해제와 서버의
			-- isBrandishing 해제가 같은 시각이라 어느 쪽이 먼저인지가 RPC 지연에 따라 매번 뒤집힌다
			-- (동전던지기). 클라가 먼저면 서버가 "이미 진행 중"으로 요청을 버리는데, 클라는 이미
			-- 그 시전분의 쿨다운(1.1초)을 걸어버린 뒤라 아무 일도 안 일어난 채 한 텀을 통째로 날린다
			-- -> 운 좋게 몇 번 연속 성공하다가 한 번 걸리면 1~2초 정지. 클라 쿨다운을 서버보다
			-- 확실히 뒤에 두어(RPC 왕복 지연 흡수용 여유) 요청이 항상 서버 해제 뒤에 도착하게 한다.
			-- 여유값만큼만 연사 간격이 늘어난다(1.106 -> 1.186초, 약 7%).
			local BRANDISH_COOLDOWN_MARGIN = 0.08
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- (브랜디쉬 강화 버프) 활성 시 공속 +1단계(배율 ×0.9로 더 빠르게). 시전시간/쿨다운도 이 배율을
			-- 그대로 따라가므로 브랜디쉬가 통째로 빨라진다. 데미지 1.5배는 전투력에 곱하고, 붉은 이펙트는
			-- enhanced 플래그로 서버에 전달한다.
			local enhanced = _CharInfoManager:IsBrandishEnhanceActive()
			if enhanced then atkMult = atkMult * 0.9 end
			-- (요청 2026-08-16) MP 20 소모. ⚠ 시전시각 기록/쿨타임 세팅보다 **먼저** 시도한다
			-- (파워스트라이크와 같은 관례 - MP가 모자라 시전이 취소됐는데 쿨타임만 도는 사고 방지).
			if not _MpManager:TryConsumeMp(self:GetBrandishMpCost()) then
				log("[SkillManager] 브랜디쉬: MP 부족(필요 " .. tostring(self:GetBrandishMpCost()) .. ")")
				return
			end
			local brandishMotionMult = 0.625 * atkMult
			local brandishFinishMult = brandishMotionMult + 0.2 / 0.65
			local brandishCastTime = 0.65 * brandishMotionMult + 0.75 * brandishFinishMult
			-- (브랜디쉬2 콤보) 재입력이 "진행 절반~끝" 창에 들어오는지 판단하기 위해 시전 시작시각/길이를 기록한다.
			self._T.brandishCastStartTime = _UtilLogic.ElapsedSeconds
			self._T.brandishCastDuration = brandishCastTime
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, brandishCastTime + BRANDISH_COOLDOWN_MARGIN)
			-- (요청 2026-08-12) 브랜디쉬 데미지가 레벨 비례 배율(180~240% + 4%p/pt)로 바뀌었으므로 공용
			-- 위력 배율은 끈다(이중 적용 방지 - 파워스트라이크와 같은 관례). 강화 버프 1.5배는 그대로 곱한다.
			self._T.pendingSkillPowerMult = 1.0
			local combatPower = self:GetEffectiveCombatPower()
			if enhanced then combatPower = math.floor(combatPower * 1.5) end
			self:RequestFireBrandish(combatPower, atkMult, self:GetWeaponMotionClass(), enhanced)
			log("[SkillManager] 브랜디쉬 사용! enhanced=" .. tostring(enhanced))
		elseif slot.name == "돌진" then
			-- (요청 2026-08-10) 점프/낙하 등 공중에서는 돌진을 쓸 수 없다 - 발판 위에 서 있을 때만.
			-- 접지(IsOnGround)와 상태(JUMP/FALL - AutoHuntManager의 공중 판정과 동일) 둘 다 확인해
			-- 어느 한쪽 판정이 어긋나는 순간에도 새지 않게 한다. 서버(AttackRush)에도 같은 차단이 있다.
			-- ⚠ 돌진은 홀드 지속 시전 목록에 있어 공중에서 키를 누르고 있으면 매 프레임 이 분기를
			-- 탄다 - 드래곤 로어의 HP 부족 게이트와 같은 방식으로 로그는 1초에 한 번만 낸다.
			local rushPlayer = _UserService.LocalPlayer
			local rushRb = isvalid(rushPlayer) and rushPlayer.RigidbodyComponent or nil
			local rushSc = isvalid(rushPlayer) and rushPlayer.StateComponent or nil
			local rushAirborne = (isvalid(rushRb) and not rushRb:IsOnGround())
				or (isvalid(rushSc) and (rushSc.CurrentStateName == "JUMP" or rushSc.CurrentStateName == "FALL"))
			if rushAirborne then
				local nowRushAir = _UtilLogic.ElapsedSeconds
				if (self._T.rushAirWarnUntil or 0) <= nowRushAir then
					self._T.rushAirWarnUntil = nowRushAir + 1.0
					log("[SkillManager] 돌진: 공중에서는 사용 불가")
				end
				return
			end
			-- 돌진(4차): 자체 쿨타임 1초(요청으로 3초에서 단축).
			local inAuraRush = self:IsInRecoveryAura()
			if self._T.rushOnCooldown and not inAuraRush then
				log("[SkillManager] 돌진: 쿨타임 중")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- (요청) 딜레이 0.27초 - 그 사이 다른 스킬로 캔슬되지 않게 공용 쿨다운을 건다.
			-- (요청) 공속이 오르면 딜레이도 그만큼 줄어야 한다 - PlayerAttack.AttackRush의 RUSH_DELAY가
			-- 0.27*배율이므로 여기도 같은 배율을 곱해 딜레이 종료와 쿨다운 해제 시점을 일치시킨다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.27 * atkMult)
			-- (요청) "공속을 올려도 돌진의 재사용까지 후딜이 남아있다" - 자체 쿨타임 1초가 공속과 무관한
			-- 고정값이라, 모션/딜레이가 아무리 빨라져도 재사용은 항상 1초를 기다려야 했다. 이 쿨타임도
			-- 공속을 타게 해서 재사용 간격이 실제로 줄어들게 한다.
			if not inAuraRush then
				self._T.rushOnCooldown = true
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.rushCdGen = (self._T.rushCdGen or 0) + 1
				local rushGen = self._T.rushCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.rushCdGen ~= rushGen then return end
					self._T.rushOnCooldown = false
					log("[SkillManager] 돌진 쿨타임 종료")
				end, 1.0 * atkMult)
			end
			-- (요청 2026-08-12) 돌진 데미지가 레벨 비례 배율(90~120% + 3%p/pt)로 바뀌었으므로 공용 위력
			-- 배율은 끈다 - 안 끄면 레벨 성장이 두 번 곱해진다(파워스트라이크와 같은 관례).
			self._T.pendingSkillPowerMult = 1.0
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireRush(combatPower, atkMult, self:GetWeaponMotionClass())
			log("[SkillManager] 돌진 사용! (쿨타임 1초)")
		end
	end

	@ExecSpace("Client")
	method void LockSkillUse(number duration)
		-- 파이널어택(PlayerAttack.TryTriggerFinalAttack)처럼 서버가 클라이언트 입력 없이 자체적으로 발동시키는
		-- 추가타 동안, 클라이언트의 스킬 공용 쿨다운(skillOnCooldown)을 그 지속시간만큼 다시 걸어준다 -
		-- 그렇지 않으면 원본 스킬의 쿨다운은 이미 끝나있어서 추가타 모션 중에도 다른 스킬을 딜레이 없이 쓸 수 있다.
		self._T.skillOnCooldown = true
		log("[SkillManager] LockSkillUse: 파이널어택 동안 스킬 쿨다운 재설정 duration=" .. tostring(duration))
		_TimerService:SetTimerOnce(function()
			self._T.skillOnCooldown = false
		end, duration)
	end

	@ExecSpace("Server")
	method void RequestFirePowerStrikeLvPos(number combatPower, number atkMultiplier, string weaponClass, number rateMin, number rateMax, number castX, number castY)
		-- (요청 2026-08-09) 레벨 비례 배율(rateMin/rateMax)을 함께 넘긴다. ⚠ 기존 RequestFirePowerStrike에
		-- 인자를 더하지 않고 **이름을 바꾼** 이유는 LEA-1102 회피(트리플 스로우 등과 같은 Lv 접미사 관례).
		-- (신고 2026-08-10 "점프 슬래시블러스트가 확실한 거리인데 안 맞는다") castX/castY = **클라이언트의
		-- 시전 순간 좌표**를 동봉한다(개명 LvPos - 인자 추가는 LEA-1102라 또 개명). 대상 선정이 서버
		-- 복제 위치 기준이라, 점프 상승 중에는 복제 y가 클라보다 뒤처져 세로 박스(±1.0) 밖으로 계산돼
		-- 클라에서는 확실히 닿는 적도 0명 판정이 났다. 서버가 이 좌표로 대상을 고른다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFirePowerStrikeLvPos: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFirePowerStrikeLvPos: PlayerAttack component not found")
			return
		end
		pa:AttackPowerStrikeLvPos(combatPower, atkMultiplier, weaponClass, rateMin, rateMax, castX, castY)
		log("[SkillManager] 파워스트라이크 발동! combatPower=" .. tostring(combatPower) .. " atkMultiplier=" .. tostring(atkMultiplier))
	end

	@ExecSpace("Server")
	method void RequestFireChargeBlowLv(number combatPower, number atkMultiplier, string weaponClass, integer chargeMode, number rateMin, number rateMax)
		-- 차지 블로우(3차): 파워스트라이크와 완전히 같은 공격을 태우되, 검 궤적만 chargeMode(속성)에
		-- 해당하는 전용 아트로 바꾼다. 속성 상태는 클라이언트에만 있으므로(디바인 4종 입력으로 결정)
		-- combatPower/공속과 마찬가지로 여기서 인자로 넘겨받는다. chargeMode 0이면 기본 궤적 그대로.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireChargeBlow: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireChargeBlow: PlayerAttack component not found")
			return
		end
		pa:AttackChargeBlowLv(combatPower, atkMultiplier, weaponClass, chargeMode, rateMin, rateMax)
		log("[SkillManager] 차지 블로우 발동! mode=" .. tostring(chargeMode) .. " combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("Server")
	method void RequestFireGuard(integer guardLv)
		-- 가드(패링) 사용: 서버의 PlayerHit에 1.2초 패링 창을 연다(투자 레벨 동봉 - 감소율 5%×pt).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		local hit = player.PlayerHit
		if isvalid(hit) then
			hit:StartGuardParry(guardLv)
		end
	end

	-- (요청 2026-08-09) 자동사냥 로프 등반 중 무적 토글 - 등반 시작/종료에서 AutoHuntManager가 부른다.
	-- 무적은 HP가 서버 권한이라 클라에서 직접 못 걸고, PlayerHit(서버 컴포넌트)에 위임한다.
	@ExecSpace("Server")
	method void RequestSetClimbInvincible(boolean on)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		local hit = player.PlayerHit
		if isvalid(hit) then
			hit:SetClimbInvincible(on)
		end
	end

	-- (자동사냥) 서버 자동 가드 판정용 상태 동기화 - AutoHuntManager 토글 시 호출된다.
	@ExecSpace("Server")
	method void RequestSetAutoHuntState(boolean autoOn, integer guardLv)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		local hit = player.PlayerHit
		if isvalid(hit) then
			hit:SetAutoHuntGuardState(autoOn, guardLv)
		end
	end

	@ExecSpace("Client")
	method void NotifyGuardParrySuccess()
		-- 가드 패링 성공(서버 PlayerHit.CheckGuardBlock에서 호출): 쿨타임을 5초로 단축하고
		-- 우측 상단에 무적(2초) 버프 아이콘을 띄운다.
		local now = _UtilLogic.ElapsedSeconds
		local shortened = (self._T.guardUseAt or now) + 5.0
		if shortened < (self._T.guardCooldownUntil or 0) then
			self._T.guardCooldownUntil = shortened
			local remaining = math.max(shortened - now, 0.1)
			if (self._T.guardBarPos or "") ~= "" then
				_GuardCooldownUI:ShowCooldown(remaining, self._T.guardBarPos)
			end
		end
		-- (팔라딘 개편) 가드 성공 버프 = 10초간 받는 피해 5%×분배 감소 - 우측 위 아이콘도 10초 표시.
		_GuardBuffUI:ShowBuff(10.0)
		local guardLv = math.max(1, self:GetHeroSkillLevelByName("가드"))
		log("[SkillManager] 가드 성공! 쿨타임 5초 단축 + 2초 무적 + 10초 피해 " .. tostring(5 * guardLv) .. "% 감소")
	end

	@ExecSpace("Server")
	method void RequestFireParry(number combatPower)
		-- 패링 사용: 서버의 PlayerHit에 1.2초 패링 창을 연다(가드와 동일). 실제 판정/무적/성공 통지/반격은
		-- PlayerHit.CheckParryBlock(공격자 MonsterAttack.IsAttackTarget에서 호출)이 처리한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		local hit = player.PlayerHit
		if isvalid(hit) then
			hit:StartParryStance(combatPower)
		end
	end

	@ExecSpace("Client")
	method void NotifyParrySuccess()
		-- 패링 가드 성공(서버 PlayerHit.CheckParryBlock에서 호출): (요청 2026-07-28) 쿨타임을
		-- 완전히 초기화해 즉시 재사용 가능하게 하고, 우측 상단에 무적(3초) 버프 아이콘을 띄운다.
		self._T.parryCooldownUntil = 0
		_ParryCooldownUI:ResetCooldown()
		_ParryBuffUI:ShowBuff(3.0)
		log("[SkillManager] 패링 가드 성공! 쿨타임 초기화 + 3초 무적 버프")
	end

	@ExecSpace("Server")
	method void RequestFireSlashBlastLvPos(number combatPower, number atkMultiplier, string weaponClass, number rateMin, number rateMax, number castX, number castY)
		-- (요청 2026-08-09) 레벨 비례 배율 동봉. 개명 이유는 RequestFirePowerStrikeLvPos와 동일(LEA-1102).
		-- HP 5 소모는 서버(AttackSlashBlastLvPos)가 처리한다 - HP는 서버 권한이라 클라가 깎을 수 없다.
		-- (신고 2026-08-10) castX/castY = 클라이언트 시전 순간 좌표 - 점프 중 서버 복제 위치 지연으로
		-- 세로 박스(±1.0) 판정이 빗나가던 것 수정(RequestFirePowerStrikeLvPos와 같은 이유/방식).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireSlashBlastLvPos: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireSlashBlastLvPos: PlayerAttack component not found")
			return
		end
		pa:AttackSlashBlastLvPos(combatPower, atkMultiplier, weaponClass, rateMin, rateMax, castX, castY)
		log("[SkillManager] 슬래시블러스트 발동! combatPower=" .. tostring(combatPower) .. " atkMultiplier=" .. tostring(atkMultiplier))
	end

