	@ExecSpace("Server")
	method void RequestFireMagicMissile(number combatPower, number atkMultiplier, number playerLevel, string element)
		-- 매직 미사일 시전 요청. 전투력/공격속도 배율/레벨은 전부 클라이언트 전용 상태(장비·인벤토리)로
		-- 계산되는 값이라 서버에서 재계산할 수 없어 RPC 인자로 함께 넘겨받는다(다른 스킬과 동일 패턴).
		-- element: 매직 에로우 토글 속성("" / "light" / "ice" / "fire") - 클라 전용 상태라 함께 넘겨받는다
		-- (combatPower에는 이미 속성 데미지 2배가 반영되어 있고, element는 색상 연출용이다).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireMagicMissile: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent("script.PlayerAttack")
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireMagicMissile: PlayerAttack component not found")
			return
		end
		pa:AttackMagicMissile(combatPower, atkMultiplier, playerLevel, element)
		log("[SkillManager] 매직 미사일 발동! combatPower=" .. tostring(combatPower) .. " level=" .. tostring(playerLevel) .. " element=" .. tostring(element))
	end

	@ExecSpace("Server")
	method void RequestFireThunderbolt(number combatPower, number atkMultiplier)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireThunderbolt: player not found")
			return
