	@ExecSpace("Server")
	method void RequestFirePowerGuardLv(number atkMultiplier, number duration, integer healPct, integer reducePct)
		-- (개편 2026-08-12) 받는 피해 감소율(분배당 1%)이 추가되면서 기존 RequestFirePowerGuard에
		-- 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피, *Lv 관례).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFirePowerGuardLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then pa:AttackPowerGuard(atkMultiplier) end
		-- 회복 창(분배당 2%, 피격 1초 후 10초 10틱)과 받는 피해 상시 감소(분배당 1%)를 함께 연다.
		---@type PlayerHit
		local hit = player:GetComponent("script.PlayerHit")
		if isvalid(hit) then hit:StartPowerGuardLv(duration, healPct, reducePct) end
		log("[SkillManager] 파워가드 발동! (지속 " .. tostring(duration) .. "초, 회복 " .. tostring(healPct)
			.. "%, 받는 피해 -" .. tostring(reducePct) .. "%)")
	end

