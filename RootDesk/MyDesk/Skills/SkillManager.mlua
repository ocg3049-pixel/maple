@Logic
script SkillManager extends Logic

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 창 드래그 상태
		self._T.isDragging    = false
		self._T.dragOffsetX   = 0
		self._T.dragOffsetY   = 0
		-- 툴팁 상태
		self._T.hovering      = false
		self._T.pendingShow   = false
		self._T.hoverTabId    = "0"
		self._T.hoverDataIdx  = 0
		self._T.hoverRowIdx   = 0
		-- 스킬 쿨다운
		self._T.skillOnCooldown = false
		-- 블리자드 전용 쿨다운(20초) - 공용 쿨다운과 별개로 관리하고 퀵슬롯에 남은 시간을 표시한다.
		self._T.blizzardOnCooldown = false
		-- 텔레포트 전용 쿨다운 - 다른 스킬들의 공용 쿨다운(skillOnCooldown)과 분리해서, 다른 스킬의
		-- 모션/딜레이 중에도 텔레포트를 쓸 수 있게 한다.
		self._T.teleportOnCooldown = false
		-- 어썰터 스택형 충전(3초당 1스택, 최대 3스택) - "쿨타임 동안 아예 못 쓰는" 방식에서 "스택이
		-- 1개 이상이면 언제든 쓸 수 있는" 충전형으로 변경 (요청사항). 시작은 풀스택(3개)이다.
		self._T.assaulterStacks = 3
		self._T.assaulterMaxStacks = 3
		self._T.assaulterRechargeTimerId = nil
		-- 시전 진행 중(사라짐~착지 사이) 재시전 잠금 - 착지 즉시(OnAssaulterChainReady) 풀려서
		-- 딜레이 없이 어썰터만은 연속 시전할 수 있다 (요청사항).
		self._T.assaulterCastActive = false
		self._T.assaulterCastGuardSerial = 0
		-- 스킬 키 홀드 상태 (키를 누르고 있는 동안 쿨다운이 끝나면 자동으로 이어서 발동)
		self._T.heldSkillKeys = {}

		-- 스킬 드래그 상태
		self._T.isDraggingSkill = false
		self._T.dragSkillRUID   = ""
		self._T.dragSkillName   = ""
		self._T.dragSource      = ""  -- "window" | "bar"
		self._T.dragFromKey     = ""

		-- 클릭 배정 모드 (클릭 후 슬롯 클릭으로 배정)
		self._T.skillClickMode = false
		self._T.clickModeRUID  = ""
		self._T.clickModeName  = ""
		self._T.clickModeOrigin = ""   -- "window"(스킬창) | "keysetting"(키세팅 키) | "spare"(여분 슬롯)

		-- 퀵슬롯 위치(엔티티 접미사, 고정) 목록. 각 위치는 barKeys를 통해 임의의 키에 연결된다.
		self._T.barPositions = {"Q","W","E","R","1","2","3","4","T","U","V","X","A","S","D","F","5","6","7","8","G","H","J","L"}
		-- 위치 → 연결된 키 이름 (기본값: 위치 접미사와 동일). 퀵슬롯 리매핑(키세팅 창)으로 변경 가능.
		self._T.barKeys = {}
		for _, p in ipairs(self._T.barPositions) do
			self._T.barKeys[p] = p
		end

		-- 슬롯 데이터: 키 이름 → {ruid, name}. 임의 키를 허용하므로 비어있는 키는 nil일 수 있다.
		self._T.slotData = {}
		local allKeys = self._T.barPositions

		-- 탭/스크롤 상태
		self._T.activeSkillTab        = "0"
		self._T.skillScrollRow        = 0
		self._T.isDraggingSkillThumb  = false
		self._T.skillThumbDragOffsetY = 0.0
		self._T.isHoldingSkillTrack   = false
		self._T.skillTrackTimer       = 0.0
		self._T.skillWheelAccum       = 0.0

		-- "+" 버튼이 이번 누름에서 이미 소비됐는지(뗄 때 풀린다). 누름 1회 = 1포인트 보장용.
		self._T.plusConsumed = false

		-- 표창+로 고른 표창 번호(1~9). 기본 1번 = 원래 럭키세븐 표창.
		-- 캐릭터 세이브에서 복원되면 ImportShuriken이 덮어쓴다.
		self._T.shurikenIndex = 1
		self._T.shurikenSelecting = false

		-- 스킬 포인트(SP). 스킬창 우측 위에 표시하고, spendable 스킬 카드의 "+" 버튼으로 분배한다.
		-- (Phase 4) 고정 100개 지급을 폐기 - 총량 = 3 × 현재 레벨(장비 전투력 환산), 남은 SP =
		-- 총량 − 총투자. 레벨이 오르내리면 SP도 함께 변하고, 총투자가 총량을 넘으면(파괴로 레벨
		-- 하락) 스킬 위력이 비율로 약화된다(GetSkillPowerMultiplier). 투자 상태는 세이브에 저장.

		-- 스킬 데이터 (탭별) — 원작처럼 "기본(0)/I/II/III/IV/H/V/VI" 8개 탭 구성.
		-- 기본(0) 탭 = 달팽이 세마리, I~IV 탭 = 1~4차 스킬, H/V 탭은 아직 비어있음.
		--
		-- ⚠ 이 테이블은 **모든 직업의 스킬을 차수별로 모아둔 원본 카탈로그**이고, 스킬창에 실제로
		--   그려지는 목록이 아니다. 화면에 보이는 목록은 GetTabSkills()가 직업(jobIdx)별로 걸러서
		--   만든다(GetJobSkillNames 참고). 여기 항목을 추가하는 것만으로는 어느 직업에도 보이지
		--   않으므로, 새 스킬을 만들면 GetJobSkillNames의 해당 직업/차수 목록에도 이름을 넣어야 한다.
		--   VI(탭 "7")는 테스트용으로 카탈로그 전체를 그대로 보여주는 탭이다.
		self._T.skillData = {
			["0"] = {
				{ ruid = "0e3a7c540e494b41b34c853eadab0d7e", name = "달팽이 세마리", level = 1, desc = "달팽이 3마리를 소환한다.\n일정 시간 후 사라진다." },
				-- (요청 2026-08-12) 초보자 공용 패시브. **전 직업 공통**이며 (요청 2026-08-14 7차)
				-- **전용 0차 SP 풀을 먼저 쓴다** - (요청 2026-08-14 8차) 1레벨 6 + 이후 레벨당 3,
				-- **9레벨에서 적립 종료**(총 30). 10레벨을 넘어도 더 이상 늘지 않는다.
				-- (요청 2026-08-14 9차) 전용분을 다 쓰면 **1~5차 SP를 낮은 차수부터 빌려 쓴다** -
				-- 그래서 초보자 탭에 뜨는 숫자는 "0차 잔여 + 전 차수 잔여"다(GetRemainingBeginnerPoints).
				-- 판정은 IsBeginnerSkill → GetRemainingBeginnerPoints / GetTierBudget(0) 한 갈래다.
				-- ⚠ 아이콘 RUID는 기존 리소스를 임시 재활용했다 - 전용 아이콘이 생기면 교체할 것.
				-- (요청 2026-08-15) 초보자 5종 **마스터 레벨을 전부 200**으로 확장. 아이템 감각만 분배당
				-- 효과를 절반(1% → 0.5%)으로 낮춰 마스터 상한(+100%)을 종전과 같게 유지했고, 나머지 4종은
				-- 분배당 효과를 그대로 둔 채 상한만 늘렸다(무기 숙련 +200 / 민첩 훈련 +40% / 회복 2종 초당 10%).
				{ ruid = "d714c4d5a90a43a7b5a7bfb3b49c4628", name = "아이템 감각", maxLevel = 200, spendable = true, level = 0, desc = "몬스터가 떨어뜨리는 모든 아이템의\n획득 확률과 메소 획득량이 상승한다.\n분배 1포인트당 드롭률·메소 각 +0.5%\n(마스터 200포인트 시 각 2배).\n\n초보자 전용 포인트를 먼저 쓴다\n(1레벨 6, 이후 레벨당 3,\n9레벨에서 적립 종료 - 총 30).\n다 쓰면 1~4차 스킬 포인트를\n낮은 차수부터 끌어 쓴다." },
				{ ruid = "a45e3d7aaeee453d934a451ba3e5cba5", name = "무기 숙련", maxLevel = 200, spendable = true, level = 0, desc = "무기를 다루는 감각을 끌어올린다.\n분배 1포인트당 공격력·마력 +1\n(마스터 200포인트 시 +200).\n상태창 공격력/마력과 전투력에\n곧바로 반영된다.\n\n초보자 전용 포인트를 먼저 쓴다\n(1레벨 6, 이후 레벨당 3,\n9레벨에서 적립 종료 - 총 30).\n다 쓰면 1~4차 스킬 포인트를\n낮은 차수부터 끌어 쓴다." },
				{ ruid = "03b1da381bf046c68488fae4690e4f6f", name = "민첩 훈련", maxLevel = 200, spendable = true, level = 0, desc = "몸놀림을 단련해 공격 속도를 높인다.\n분배 5포인트당 공격 속도 +1%\n(마스터 200포인트 시 +40%).\n\n초보자 전용 포인트를 먼저 쓴다\n(1레벨 6, 이후 레벨당 3,\n9레벨에서 적립 종료 - 총 30).\n다 쓰면 1~4차 스킬 포인트를\n낮은 차수부터 끌어 쓴다." },
				{ ruid = "d4438020aa5544759a178d4a3cbf9105", name = "HP 회복", maxLevel = 200, spendable = true, level = 0, desc = "몸을 단련해 체력이 저절로 차오른다.\n분배 1포인트당 1초에 최대 HP의\n0.05%씩 회복(마스터 200포인트 시\n1초에 10%).\n\n⚠ 분배하지 않으면 HP가 저절로\n회복되지 않는다.\n\n초보자 전용 포인트를 먼저 쓴다\n(1레벨 6, 이후 레벨당 3,\n9레벨에서 적립 종료 - 총 30).\n다 쓰면 1~4차 스킬 포인트를\n낮은 차수부터 끌어 쓴다." },
				{ ruid = "1de1c87ae2ed443184844dc0ea1e831e", name = "MP 회복", maxLevel = 200, spendable = true, level = 0, desc = "정신을 가다듬어 마나가 저절로 차오른다.\n분배 1포인트당 1초에 최대 MP의\n0.05%씩 회복(마스터 200포인트 시\n1초에 10%).\n\n⚠ 분배하지 않으면 MP가 저절로\n회복되지 않는다.\n\n초보자 전용 포인트를 먼저 쓴다\n(1레벨 6, 이후 레벨당 3,\n9레벨에서 적립 종료 - 총 30).\n다 쓰면 1~4차 스킬 포인트를\n낮은 차수부터 끌어 쓴다." },
			},
			["1"] = {
				{ ruid = "5c61ff8df1544c05a200e598ea9164ce", name = "파워스트라이크", maxLevel = 20, spendable = true, level = 0, desc = "무기로 적을 강하게 내려친다." },
				{ ruid = "362ae7fa63104016a89c5172d6c76efd", name = "러시", maxLevel = 15, spendable = true,           level = 0, desc = "방향키를 누른 채 사용하거나 방향키를 두 번 눌러 질주한다.\n질주 자세로 이동속도가 2배가 되며,\n방향키를 떼거나 공격하면 풀린다.\n(아이콘은 임시 - 교체 가능)" },
			{ ruid = "2d2212b2c10242219dd38e35143ec460", name = "아이언 월", maxLevel = 20, spendable = true, level = 0, desc = "몸을 강철처럼 단단하게 만들어\n받는 피해를 감소시킨다.\n분배 1포인트당 피해 2% 감소\n(마스터 시 40%).\n지속 20초, 분배마다 +10초\n(10레벨부터 +20초, 마스터 310초).\n주변 소환수에게도 강화 기운이 깃든다." },
					{ ruid = "42e8d60e495a41bc94d4b3ac7ec022dc", name = "슬래시블러스트", maxLevel = 20, spendable = true, level = 0, desc = "검을 휘둘러 전방의 적들을 베어낸다." },
					-- 더블샷: 화살/적중 이펙트는 직접 구해와 업로드했다(아이콘만 MSW 기본 리소스).
					-- 원본/RUID 대응표: msw-dev-tools/resources/더블샷/RUID.md
					-- (신궁 개편 2026-08-06) spendable 편입. (요청 2026-08-13) 럭키세븐 파생을 끊고 자체 곡선
					-- (40%~50% + 분배당 최소·최대 3%p)을 갖는다 - 사거리도 에로우 블로우와 같은 5.4유닛.
					{ ruid = "56144f55ece34e13b1aeeb6c102eb8b1", name = "더블샷",         maxLevel = 20, spendable = true, level = 0, desc = "전방으로 화살 두 발을 동시에 발사한다.\n화살 1개당 전투력의 40%~50%에서\n분배 1포인트당 최소·최대가 3%p씩\n오른다(마스터 20에서 97%~107%).\n사거리는 에로우 블로우와 같다.\nMP 10 소모." },
					-- 에로우 블로우: MSW 기본 리소스에 없어 직접 구해와 업로드한 아이콘/화살/적중 이펙트다
					-- (원본/RUID 대응표: msw-dev-tools/resources/에로우블로우/RUID.md).
					-- (신궁 개편 2026-08-06) spendable 편입. (요청 2026-08-13) 슬래시블러스트 파생을 끊고
					-- 자체 곡선(50%~60% + 분배당 최소·최대 2%p) + 강화 분배당 2%p로 바뀌었다.
					{ ruid = "444a92e6445241658af778f5e52cd770", name = "에로우 블로우", maxLevel = 20, spendable = true, level = 0, desc = "전방으로 화살 한 발을 쏴서\n적 하나를 공격한다.\n전투력의 50%~60%에서 분배\n1포인트당 최소·최대가 2%p씩\n오른다(마스터 20에서 88%~98%).\n(에로우 블로우 강화를 배우면\n최소·최대가 함께 올라간다)\nMP 10 소모." },
					-- 에로우 블로우 강화: (요청 2026-08-06) ON/OFF 토글 → **패시브**로 바꿨다.
					-- 1포인트라도 투자하면 데미지 상승과 폭발이 항상 적용되고, 퀵슬롯에는 올릴 수 없다.
					-- 전용 아이콘 리소스가 없어 임시로 에로우 블로우 아이콘을 그대로 쓴다(교체 가능).
					{ ruid = "444a92e6445241658af778f5e52cd770", name = "에로우 블로우 강화", maxLevel = 20, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n[에로우 블로우의 강화]\n분배 1포인트당 에로우 블로우의\n최소·최대 데미지가 2%p씩 오른다\n(마스터 20에서 +40%p).\n\n배우기만 하면 에로우 블로우가\n적중 지점에서 항상 폭발해\n주변의 적을 최대 5명까지\n시간차로 타격한다." },
					-- 더블 점프(1차): 공중(점프 상태)에서 점프키를 한 번 더 누르면 앞으로 한 번 날아간다.
					-- 아이콘/이펙트/사용음은 원본 팩 skill/3300.img/skill/33001102(더블 점프)의
					-- icon / effect / _audio/Use RUID를 그대로 쓴다(별도 업로드 없이 MSW 라이브러리에 존재).
					{ ruid = "e1d0cdbf977245e78b3381b106ac043c", name = "더블 점프",     maxLevel = 10, spendable = true, level = 0, desc = "공중에서 점프키를 한 번 더 누르면\n바라보는 방향으로 한 번 더 도약해\n포물선을 그리며 날아간다.\n재사용 대기시간 5초. MP 10 소모.\n\n[상시] 분배 1포인트당 이동 속도가\n1%씩 오른다(마스터 10에서 +10%)." },
				-- 매직클로(비숍 1차, 2026-08-08 개편): 마스터 20 spendable. 한 타당 배율 =
				-- **럭키세븐 표창 1발과 같은 계수**(GetMagicClawRate* → GetLuckySevenRate*)이고,
				-- 2타 스킬이라 총합도 럭키세븐(표창 2발)과 같다. 레벨 성장은 다른 1차 기본기와 똑같이
				-- spendable 공용 위력 배율(0.6배 → 마스터 1.0배)이 담당한다.
				{ ruid = "4e76419dd50a4ca99103118dd05e4628", name = "매직클로",       maxLevel = 20, spendable = true, level = 0, desc = "마법의 힘을 담은 손톱으로\n적을 두 번 할퀸다.\n데미지는 더블샷과 완전히 같다 -\n한 타당 전투력의 40%~50%에서 분배\n1포인트당 최소·최대가 3%p씩\n오른다(마스터 20에서 97%~107%).\nMP 10 소모." },
					-- 매직 미사일(1차): 등 뒤 랜덤 위치에 마법 구체를 소환해 전방의 적을 조준한 뒤 발사하는
					-- 유도 미사일 스킬. 구체/발사 이펙트는 원본 팩 "와일드 발칸"(skill/3312.img/skill/33121214)의
					-- ball과 "트랜센던트: 빛"(skill/40000.img/skill/400001067)의 이펙트 클립을 사용하고,
					-- 아이콘은 와일드 발칸 아이콘을 임시로 쓴다(교체 가능).
					-- (비숍 개편 2026-08-08) 마스터 20 spendable + **재사용 대기시간 5초**(레벨 무관 고정).
					-- 쿨타임은 다크사이트와 같은 전용 게이트 방식이고, 퀵슬롯 표시는 MagicMissileCooldownUI가 맡는다.
					{ ruid = "8d8c512a0ff4466f8461ccffa67f3248", name = "매직 미사일",   maxLevel = 20, spendable = true, level = 0, desc = "등 뒤에 마법 구체를 소환해\n전방의 적을 향해 발사한다.\n데미지는 슬래시블러스트와 완전히 같다 -\n구체 하나당 전투력의 50%~60%에서\n분배 1포인트당 최소 2%p / 최대 3%p씩\n오른다(마스터 20에서 90%~120%).\n20레벨에 구체 1개, 이후 10레벨마다\n1개씩 늘어난다(50레벨이면 4개).\n죽을 것으로 예측되는 적은 건너뛰고\n다음 적을 노린다.\n재사용 대기시간 5초. MP 10 소모.\n(아이콘은 임시 - 교체 가능)" },
					-- 더블스탭(섀도어 1차): 마스터 20 spendable.
					-- (요청 2026-08-14 4차) 럭키세븐 × 1.3 파생을 끊고 **더블샷 화살 1발의 2배**가 됐다 -
					-- 두 스킬 모두 2타(2발)라 시전 1회 총합도 정확히 더블샷의 2배다. 레벨 성장도 더블샷의
					-- 자체 곡선(40~50% + 분배당 3%p)을 그대로 2배로 따라간다.
					-- (공식 한 곳: GetDoubleStabRateMinLv / GetDoubleStabRateMaxLv). MP 10.
				{ ruid = "92a5020c978c46bdabab910598118b86", name = "더블스탭",       maxLevel = 20, spendable = true, level = 0, desc = "단검으로 적을 두 번 빠르게 찌른다.\n한 타당 더블샷 화살 1발의 2배\n(2줄 합 = 더블샷의 2배).\n1레벨 한 타당 80%~100%,\n분배 1포인트당 최소·최대가 6%p씩\n오른다(마스터 20에서 194%~214%).\nMP 10 소모." },
					-- 럭키세븐(1차): 마스터 20 spendable.
					-- (요청 2026-08-14 5차) 파워스트라이크 1/3 파생을 끊고 **더블샷 화살 1발과 완전히 같은
					-- 데미지·MP**가 됐다(GetLuckySevenRate*Lv → GetDoubleShotRate*Lv 위임, MP 10).
					-- 두 스킬 모두 2발이라 시전 1회 총합도 더블샷과 정확히 같다.
					-- ⚠ 트리플 스로우가 이 헬퍼에서 파생되던 링크는 **끊었다**(3·4차 동반 상승 방지).
					{ ruid = "46b22e703399431d9ab0987233cac868", name = "럭키세븐",       maxLevel = 20, spendable = true, level = 0, desc = "표창 2개를 던져 적 하나를 공격한다.\n표창 1개당 더블샷 화살 1발과 같다 -\n1레벨 40%~50%, 분배 1포인트당\n최소·최대가 3%p씩 오른다\n(마스터 20에서 97%~107%).\nMP 10 소모.\n가니어를 장착해야 사용할 수 있다." },
					-- 트레이닝(나이트로드 1차 패시브, 2026-08-07 개편 - 옛 "마크 오브 어쌔신"의 자리를 물려받았다).
					-- 표식(적중 시 표창이 날아오는 프록)은 표창 분산과 역할이 겹쳐 통째로 폐기하고,
					-- **분배 1포인트당 단순 공격력 +2**만 주는 조용한 패시브로 바꿨다.
					-- 적용 경로는 표창+와 동일(ApplyShurikenAttackBonus 한 곳에서 flatATK로 합산).
				{ ruid = "043f60b34b6f4e708b1e0dd914a7a5d1", name = "트레이닝", maxLevel = 20, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n수련을 거듭해 몸에 익힌다.\n\n분배 1포인트당 공격력이 2씩 오른다\n(마스터 20에서 +40).\n\n배우기만 하면 항상 적용된다." },
					-- 표창 분산(나이트로드 1차 토글, 2026-08-07 신설): 표창 3종이 한 마리에 몰리지 않고
					-- 발 수만큼 서로 다른 적에게 한 발씩 날아간다. 한 줄 = 그 스킬 **합산 데미지의 60%**,
					-- 표적이 모자라 겹쳐 맞는 줄은 10%. 표창 개수 자체는 그대로라 화면에 새로 추가되는
					-- 연출이 없다(요청: "원작 느낌을 해치지 않을 것").
					-- ⚠ 마스터가 1이고 **처음부터 1레벨**이라 spendable이 아니다(SP를 쓰지 않는다).
					--   ImportSkillLevels는 spendable만 덮어쓰므로 저장/복원에도 1레벨이 유지된다.
					-- 아이콘은 원본 팩 skill/411.img/skill/4110012("숙련된 표창술")의 icon.
					-- 판정 본체는 서버(PlayerAttack.AttackStarThrow / RollStarSpreadDamages).
				{ ruid = "b688b13858614282b41dd9c7c2812bf4", name = "표창 분산",     maxLevel = 1, level = 1, desc = "[ON/OFF 토글 - 처음부터 마스터]\n사용하면 분산을 켜고 끈다.\n\n켜져 있는 동안 럭키세븐(표창 2개) /\n트리플 스로우(3개) / 쿼드러플\n스로우(4개)의 표창이 한 마리에\n몰리지 않고 표창 하나당 적 하나씩\n서로 다른 적에게 날아간다.\n\n표창 하나의 데미지는 그 스킬\n합산 데미지의 60%.\n적이 모자라 같은 적을 다시 때리는\n표창은 10%만 들어간다.\n\n적이 많을수록 이득, 하나뿐인\n적에게는 손해다." },
				-- 암행(나이트로드 2차): 스킬 1회 시전이 한 대상을 때리는 타수만큼 확률을 굴려
				-- 적 주변에 그림자가 나타나 표창을 던진다(다수 대상으로 퍼진 같은 줄은 1번만 굴림).
				-- 그림자/스윙 모션은 원본 팩 skill/421.img/skill/4211008, 시작 이펙트는 skill/411.img/skill/4111002.
				-- (요청으로 상시 패시브 → ON/OFF 토글 → 2026-08-05 **지속시간 버프**로 전환.)
				--   · (요청 2026-08-14 4차) 지속시간 1레벨 20초 + 분배 1포인트당 10초(마스터 20 = 3분 30초)
				-- (2026-08-05 스펙 개편) 마스터 20 spendable. 발동 확률 1레벨 4% / 10레벨 6% / 20레벨 8%,
				-- (요청 2026-08-14 4차) 표창 데미지 200%~220%에서 분배당 최소·최대 각 +4%p(마스터 276%~296%), MP 30.
				-- ⚠ 이 카탈로그 위치는 I(1차) 탭이지만 **나이트로드에게는 2차 스킬**이다(GetJobSkillNames[9]["2"]).
				--   SP도 2차 풀을 쓴다 - HeroSkillTable의 reqLevel이 30(2차 대역)이어야 한다.
				{ ruid = "6e463376315c4a4eb8f632bea7b4cd3b", name = "암행",           maxLevel = 20, spendable = true, level = 0, desc = "잠시 그림자와 하나가 된다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초).\n지속 중 한 대상을 때린 타수마다\n확률로 주변의 적 하나에게 그림자가\n나타나 표창을 던진다.\n발동 확률 1레벨 4%, 10레벨 6%,\n20레벨 8%.\n표창 하나당 전투력의 200%~220%에서\n분배 1포인트당 최소·최대가 4%p씩\n오른다(마스터 276%~296%).\nMP 30 소모." },
				-- 다크사이트(1차, 2026-07-30 신설): 어둠에 몸을 숨기는 은신 버프.
				-- 아이콘은 원본 팩 skill/400.img/skill/4001003(다크사이트)의 icon,
				-- 시전 이펙트/전용 BGM은 요청받은 RUID를 그대로 쓴다.
				-- (2026-08-06 스펙 개편) 마스터 20 spendable. 재사용 대기시간 1레벨 30초에서 분배 1포인트당
				-- -1초(마스터 11초), 은신 중 이동 속도 1레벨 30%에서 분배 1포인트당 +1%p(마스터 49%).
				-- 공식 한 곳: GetDarkSightCooldown / GetDarkSightSpeedMult.
				{ ruid = "0946f69d84464df29b24b94c744c868d", name = "다크사이트",     maxLevel = 20, spendable = true, level = 0, desc = "어둠에 몸을 숨긴다.\n주변이 어두워지고 몸이 반투명해지며\n이동 속도가 30%로 줄어든다\n(분배 1포인트당 +1%p, 마스터 49%).\n숨어 있다가 처음 하는 공격은\n피해가 2배가 되고 무조건 크리티컬이\n되지만, 그 공격으로 은신이 풀린다.\n최대 160초 유지.\n재사용 대기시간 30초에서 분배\n1포인트당 1초씩 줄어든다(마스터 11초).\nMP 10 소모.\n(한 번 더 누르면 그냥 풀린다 -\n이때는 재사용 대기시간도 MP도 들지 않는다.)" },
				-- 분신 소환(섀도어 1차, 2026-08-06 신설): 자신과 **똑같은 외형**의 아바타 NPC를 소환해
				-- 곁에서 함께 싸우게 한다(용사 소환과 같은 아바타 소환수 구조 - Skills/ShadowClone.mlua).
				-- 한 번 더 누르면 분신과 자리를 바꾼다(별도 쿨 5초, 퀵슬롯 표시 - 이쪽은 MP 무료).
				-- (요청 2026-08-14 4차) 소환 재사용 대기시간(5분)을 폐지하고 **MP 200**을 게이트로 삼았다.
				-- ⚠ 지속시간/데미지는 이 스킬 하나가 아니라 **분신 강화 3종(2·3·4차)과 합산**해서 정해진다 -
				--   공식은 GetShadowCloneDuration / GetShadowCloneDamagePercent 한 곳에 모아뒀다.
				{ ruid = "c6ce60523c954791af5632da796cca7c", name = "분신 소환",     maxLevel = 20, spendable = true, level = 0, desc = "자신과 똑같이 생긴 분신을 소환한다.\n분신은 곁에 머물며 스스로 적을 찾아\n싸운다.\n지속시간 30초, 분배 2포인트마다 +10초\n(마스터 20에서 2분 10초).\n분신의 데미지는 본체의 50%이며\n분배 2포인트마다 +1%p.\n분신은 1차 공격 스킬을 쓴다\n(분신 강화를 배우면 늘어난다).\n재사용 대기시간 없음. MP 200 소모.\n\n분신이 있을 때 한 번 더 사용하면\n분신과 자리를 바꾼다\n(재사용 대기시간 5초, MP 무료)." },
				-- 표창+ : 스킬 포인트를 분배해 올리는 스킬. spendable = true 인 스킬만 카드에 "+" 버튼이 붙는다.
				-- 시전하면 캐릭터 주변에 표창 종류가 뜨고 1~9번 키로 고른다(3초 안에 못 고르면 취소).
				-- 고른 표창은 럭키세븐과 아대 기본공격이 던지는 표창 모습이 되고, 게임을 꺼도 저장된다.
				-- 아이콘은 원본 팩 skill/800016.img/skill/80001657("표창 던지기")의 icon.
				-- ⚠ (요청 2026-08-14 5차) **차수별로 어떤 표창이 어떤 효과로 열리는지**는 아래 desc가 아니라
				--   GetSkillLevelEffectText가 ShurikenLibrary(GetShurikenIndicesForTier + GetEffect)에서
				--   실시간으로 만들어 [현재 레벨]/[다음 레벨] 줄에 표시한다 - 표창 표를 고쳐도 저절로 따라온다.
				{ ruid = "a66f7a4983444b888f3a713b3eded36f", name = "표창+",         level = 0, maxLevel = 20, spendable = true, desc = "스킬 포인트를 분배해 올리는 스킬.\n포인트 1당 공격력이 1 오른다.\n분배 1·10에서 표창이 1종씩 열린다\n(1번·2번 표창 / 마스터 20).\n\n사용하면 주변에 표창 종류가 뜨고\n표시된 번호키로 3초 안에 고른다.\n고른 표창은 럭키세븐·트리플/쿼드러플\n스로우·아대 기본공격이 던지는 표창이 되고\n표창마다 공격력·크리티컬·공격속도가 다르다.\n(각 표창의 효과는 아래 레벨 설명 참고)" },
			},
			["2"] = {
				{ ruid = "e453c21d3cdf4477a54045c8a25e22f4", name = "파이널어택", maxLevel = 20, spendable = true,     level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n일반 공격 시 확률적으로 추가 공격이 발동한다." },
				-- (비숍 개편 2026-08-08) 마스터 10 spendable. 성능은 그대로이고 **소모 MP**만 줄어든다 -
				-- 1레벨 10 MP에서 분배 1포인트당 -1(마스터 10에서 1 MP). MP 자원 자체는 이번 개편에서
				-- 신설했다(MpManager) - 텔레포트가 첫 소비자다.
				{ ruid = "fa1ce25dd5fb4f1ea0999086d26b38ce", name = "텔레포트",       maxLevel = 10, spendable = true, level = 0, desc = "짧은 거리를 순간이동한다.\n소모 MP 20에서 분배 1포인트당\n1씩 줄어든다(마스터 10에서 11)." },
				-- (썬콜 개편 2026-08-08) 마스터 20 spendable. 데미지는 **홀리 에로우와 완전히 같다** -
				-- 수치를 따로 두지 않고 GetThunderboltMin/MaxPercent가 홀리 에로우 헬퍼(= 아이언 에로우
				-- 곡선)를 그대로 호출한다(한쪽만 고치면 갈라지는 것 방지 - 홀리 에로우와 같은 관례).
				{ ruid = "5360e76224b14134b8bd00ede1d34e63", name = "썬더볼트",       maxLevel = 20, spendable = true, level = 0, desc = "번개를 떨어뜨려 앞뒤 주변의 적을\n최대 6명까지 동시에 공격한다.\n데미지는 홀리 에로우와 같다 -\n전투력의 150%~200%에서 분배\n1포인트당 최소·최대가 4%p씩\n오른다(마스터 20에서 226%~276%).\nMP 20 소모." },
				-- (불독 개편 2026-08-08) 마스터 20 spendable. 데미지는 **홀리 에로우와 완전히 같다** -
				-- 수치를 따로 두지 않고 GetFireArrowMin/MaxPercent가 홀리 에로우 헬퍼(= 아이언 에로우
				-- 곡선)를 그대로 호출한다(한쪽만 고치면 갈라지는 것 방지 - 썬더볼트와 같은 관례).
				-- 8방향 조준·관통 3명·화상 20%는 기존 사양 그대로다.
				{ ruid = "48f6c72aa48647e1b97b99afbc46ea17", name = "파이어에로우",   maxLevel = 20, spendable = true, level = 0, desc = "화염이 담긴 화살을 발사한다.\n방향키로 8방향 조준, 최대 3명 관통.\n맞은 적은 20% 확률로 4초간 화상.\n데미지·MP는 홀리 에로우와 같다 -\n전투력의 150%~200%에서 분배\n1포인트당 최소·최대가 4%p씩\n오른다(마스터 20에서 226%~276%).\nMP 20 소모." },
				-- (비숍 개편 2026-08-08) 마스터 30 spendable. 회복량 = **최대 HP × 1% × 분배 레벨**
				-- (1레벨 1% → 마스터 30에서 30%). 공식은 GetHealPercent 한 곳에만 있다.
				{ ruid = "44b70137422f425eb486eb7cc5a92aec", name = "힐",             maxLevel = 30, spendable = true, level = 0, desc = "대상의 HP를 회복시킨다.\n회복량은 분배 2포인트당 최대 HP의 1%\n(마스터 30에서 15%).\nMP 30 소모." },
				-- 리스토네이션(2차, 2026-07-28 신설): 원본 팩 skill/121.img/skill/1211010의 아이콘/사용음.
				-- 몸쪽 이펙트는 요청으로 2cdfa53899d2462cb051e958a70b4747(팩 effect0 대신).
				-- 자기 자신만 대상으로 최대 HP의 50%를 즉시 회복한다. 쿨타임 10초(퀵슬롯 표기).
				{ ruid = "d4438020aa5544759a178d4a3cbf9105", name = "리스토네이션",   maxLevel = 10, spendable = true, level = 0, desc = "몸에서 회복의 기운을 끌어올려\n5초 동안 1초마다 최대 HP를 회복한다.\n초당 회복량 = 분배 포인트 × 1%\n(마스터 시 초당 10%, 총 50%).\n재사용 대기시간 30초. MP 50 소모." },
				-- 에로우 봄(신궁·보우마스터 2차, 2026-08-07 구현): 강화 에로우 블로우와 같은 구조 -
				-- 날아가서 맞은 적에게서 폭발하고 주변 적까지 함께 때린다. 연출만 다르다
				-- (직격 = 폭발 프레임 0~8 / 주변 = sub1~4). 아트는 사용자 제공 원본을 WZ 원점 기준으로
				-- 패딩 정렬해 직접 업로드했다(msw-dev-tools/resources/에로우봄/RUID.md).
				{ ruid = "ba3dbc8acc1b44c888d2a44117bb2ccd", name = "에로우 봄",      maxLevel = 20, spendable = true, level = 0, desc = "폭발하는 화살을 쏜다.\n맞은 적에게서 폭탄이 터져\n주변의 적까지 최대 6명이 피해를 입는다.\n대상 하나당 전투력의 130%~140%에서\n분배 1포인트당 최소·최대가 4%p씩\n오른다(마스터 20에서 206%~216%).\nMP 20 소모." },
				-- 파이널 어택:궁수(신궁·보우마스터 공용 2차, 2026-08-07 신설). 전사 파이널어택의 궁수판 -
				-- 마스터 레벨(20)·발동 확률(5%~50%)·추가 데미지(15%~30%)가 **전사와 완전히 같고**,
				-- 발동 시 "직전에 쓴 활 스킬"을 shootf 모션으로 한 번 더 시전한다.
				-- 아이콘은 전사 파이널어택과 같은 RUID를 쓴다(전용 아이콘이 생기면 교체).
				{ ruid = "e453c21d3cdf4477a54045c8a25e22f4", name = "파이널 어택:궁수", maxLevel = 20, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n활 공격 스킬을 쓰면 확률적으로\n**그 스킬이 한 번 더** 발동한다.\n\n발동 확률은 분배 1포인트당 1%\n(마스터 20에서 20%).\n추가 발동은 전투력의 15%~30%만큼\n더 강하게 들어가고, 공격속도 40%\n빠른 shootf 동작으로 나간다.\n\n적용 대상: 더블샷 / 에로우 블로우 /\n에로우 봄 / 아이언 에로우 /\n스트레이프 / 아이스 샷 / 파이어 샷." },
				-- (신궁 개편 2026-08-06) spendable 편입. 1레벨 150%~200%에서 분배 1포인트당 최소·최대가 10%p씩.
			{ ruid = "0cfe777a9cd04df9bbb22a18a598e9b7", name = "아이언 에로우",  maxLevel = 20, spendable = true, level = 0, desc = "강한 관통력을 가진 화살을 발사해\n최대 6명을 관통한다.\n전투력의 150%~170%에서 분배\n1포인트당 최소·최대가 4%p씩\n오른다(마스터 20에서 226%~246%).\nMP 20 소모." },
				-- 홀리 에로우(2차, 2026-07-29 신설): 엔젤레이와 같은 구조(전방 고정 관통 화살)의 하위 버전.
				-- 아이콘/시전(effect0~6)/화살(ball0~2 애니메이션)/적중(hit0~2) 아트는 사용자 제공 클래식
				-- 원본을 직접 업로드했다(msw-dev-tools/resources/홀리에로우/RUID.md). 사용음/적중음은
				-- 라이브러리 팩 skill/230.img/skill/2301005 재사용.
				-- (비숍 개편 2026-08-08) 마스터 20 spendable. 데미지는 **아이언 에로우와 완전히 같다** -
				-- 수치를 따로 두지 않고 GetIronArrowMinPercent/MaxPercent를 그대로 재사용한다(한쪽만 고치면
				-- 갈라지므로 GetHolyArrowMinPercent가 아이언 에로우 헬퍼를 호출하는 형태로 묶어둠).
				{ ruid = "ded9f8d0b8ba42d6af429e1653dfd039", name = "홀리 에로우",    maxLevel = 20, spendable = true, level = 0, desc = "신성한 빛의 화살을 전방으로 발사한다.\n화살은 적을 최대 6명까지 관통한다.\n전투력의 150%~200%에서 분배\n1포인트당 최소·최대가 4%p씩\n오른다(아이언 에로우와 같은 상승폭 -\n마스터 20에서 226%~276%).\nMP 20 소모." },
				-- 속사(2차): 키를 누르고 있는 동안 0.25초마다 화살이 계속 나간다(요청으로 공격속도 2배).
				-- 방향키로 조준 각도를 바꾸면 각도가 곧바로 튀지 않고 초당 90도씩 서서히 회전해,
				-- 3시와 12시 사이의 중간 각도로도 발사된다.
				-- 화살/적중 이펙트는 더블샷과 같은 아트를 쓰고, 아이콘은 임시로 MSW 라이브러리의
				-- "해달 궁술: 속사" 아이콘을 쓴다(교체 가능).
				-- (보우마스터 개편 2026-08-07) spendable 편입. 1레벨 100%~150%에서 분배 1포인트당 최소·최대가 10%p씩.
				{ ruid = "98e897de7be7419d947521aa8b800b59", name = "속사",           maxLevel = 20, spendable = true, level = 0, desc = "키를 누르고 있는 동안 0.25초마다\n화살을 한 발씩 계속 발사한다.\n한 발당 전투력의 130%~140%에서\n분배 1포인트당 최소·최대가 4%p씩\n오른다(마스터 20에서 206%~216%).\n화살 한 발마다 MP 4를 소모하며,\nMP가 떨어지면 연사가 멈춘다.\n쏘는 도중 방향키로 조준 방향을 바꾸면\n각도가 서서히 돌아간다(연사 중 이동 불가)." },
				-- 체인샷(2차): 8방향으로 체인을 쏴서 지형에 박고, 3초 안에 다시 누르면 그 각도로 당겨져
				-- 날아간다(이동 거리 = 벽까지 거리의 4/3배). 아트/아이콘/사용음은 원본 팩
				-- skill/6400.img/skill/64001012의 special / icon / _audio/Use.
				{ ruid = "9fc2311b651b494da1488fbd5c8e5f1f", name = "체인샷",         level = 1, desc = "8방향으로 체인을 발사한다.\n체인이 지형에 박히면 5초간 유지되고,\n그 사이 다시 누르면 박힌 곳으로\n당겨져 날아간다(거리의 4/3배).\n날아가며 지나친 적 최대 6명에게\n전투력의 50%~70% 피해.\n재사용 대기시간은 **당겨져 날아간 뒤**\n5초부터 시작한다(체인을 쏜 시점이 아니다).\nMP 10 소모(체인을 쏠 때만 -\n박힌 체인을 당기는 건 무료)." },
				-- 섬광(2026-07-28 신설 / 2026-08-09 **섀도어 2차로 이관**): 체인샷과 같은 판정/데미지지만
				-- 연출이 다르다 - 모션 후 장착 무기와 같은 RUID의 단검이 **칼끝을 앞세워 일자로** 날아가
				-- 벽에 박히고, 한 번 더 누를 필요 없이 즉시 그 방향으로 돌진해 땅 위에 안착한다.
				-- 돌진 중 단검 위치를 지나면 회수한다.
				-- ⚠ 던지는 물건은 장착 무기(두손 우선, 없으면 한손)를 그대로 읽어 쓴다 - 섀도어는 단검을
				--   끼고 있으므로 별도 처리 없이 단검이 날아간다.
				{ ruid = "7cd06beb000a42b3af74ca9741aefb0e", name = "섬광", maxLevel = 5, spendable = true,           level = 0, desc = "장착한 단검을 칼끝 방향으로 던져\n지형에 박은 뒤, 즉시 그 방향으로\n돌진해 벽 위에 안착한다. 돌진 중\n단검을 회수하며, 지나친 적 최대 6명에게\n전투력의 50%~70% 피해를 입힌다.\n분배할수록 재사용 대기시간이\n10초에서 3초까지 줄어든다." },
						-- 드레인 샷(나이트로드 2차, 2026-08-05 신설): 아대 기본공격과 같은 구조로 표창을 하나 던지고
					-- 대상에게 꽂히면 최대 HP의 10%(+분배당 1%)를 회복한다. 표창 10개를 소모한다.
					-- 아이콘/이펙트는 사용자 제공 클래식 아트를 ori 정렬 패딩해 직접 업로드
					-- (msw-dev-tools/resources/드레인샷/RUID.md).
					{ ruid = "41d9fb7a803448d4ad0ca750e1698601", name = "드레인 샷",      level = 0, maxLevel = 20, spendable = true, desc = "표창에 적의 생기를 실어 되돌린다.\n표창을 하나 던져 적을 맞히면\n최대 HP의 10%를 회복한다\n(분배 1포인트당 +1%, 마스터 20에서 30%).\n표창을 10개 소모한다.\n재사용 대기시간 5초. MP 50 소모.\n가니어를 장착해야 사용할 수 있다." },
					-- 페이크(나이트로드·섀도어 2차 패시브, 2026-08-05 신설): 적에게 맞을 때 분배 1포인트당 1%
					-- 확률로 그 공격이 MISS가 된다(마스터 30 = 30%). 터진 자리에 잔상 이펙트 + 사용음 1회.
					-- 아이콘/이펙트/사용음 전부 원본 팩 skill/412.img/skill/4120002("페이크")의 RUID.
					{ ruid = "7b4617be86544e3da2c3b51f51bd64da", name = "페이크",         level = 0, maxLevel = 20, spendable = true, desc = "[패시브 - 퀵슬롯 배정 불가]\n허상을 남겨 공격을 흘린다.\n적에게 맞을 때 분배 1포인트당 1%\n확률로 그 공격이 MISS가 된다\n(마스터 20에서 20%).\n흘려낸 그 자리에 잔상이 1회 남는다." },
					-- 표창+ II(나이트로드 2차, 2026-08-05 신설): 표창 3·4번을 연다(분배 1·10). 마스터 30.
					{ ruid = "a66f7a4983444b888f3a713b3eded36f", name = "표창+ II",      level = 0, maxLevel = 30, spendable = true, desc = "표창을 다루는 솜씨를 더 갈고닦는다.\n포인트 1당 공격력이 1 오른다.\n분배 1·10에서 표창이 1종씩 열린다\n(3번·4번 표창 / 마스터 30)." },
				-- 헤이스트(2차, 2026-08-05 스펙 개편): 마스터 20 spendable.
					--   · (요청 2026-08-14 4차) 지속시간 1레벨 20초 + 분배 1포인트당 10초(마스터 20 = 3분 30초),
					--     MP 30 소모 신설. 종전엔 1분 → 5분 선형에 MP가 없었다.
					--   · 이동 속도 분배 1포인트당 +1%(마스터 +20%)
					--   · 기존의 "점프력 +20%"는 **점프 보정**으로 대체됐다 - 점프할 때 바로 위 발판까지의
					--     거리를 재서 그 발판보다 살짝 위까지만 뛰어오른다. 보정 사거리는 "점프력
					--     100+2×분배 %로 뛰었을 때 닿는 높이"(1레벨 102% ~ 마스터 140%)이고,
					--     그 안에 발판이 없으면 평소와 똑같은 점프력으로 뛴다.
					{ ruid = "e223bdc2a6cd46f98639e00b34083332", name = "헤이스트",       maxLevel = 20, spendable = true, level = 0, desc = "일정 시간 몸을 가볍게 만든다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초).\nMP 30 소모.\n이동 속도가 분배 1포인트당 1%\n상승한다(마스터 +20%).\n\n지속 중에는 점프에 보정이 걸린다 -\n바로 위에 발판이 있으면 그 발판보다\n살짝 위까지만 뛰어오른다.\n보정 사거리는 점프력 102%로 닿는\n높이에서 분배 1포인트당 +2%p\n(마스터 140%)이며, 사거리 안에\n발판이 없으면 평소대로 뛴다." },
				{ ruid = "03b1da381bf046c68488fae4690e4f6f", name = "부스터", maxLevel = 20, spendable = true,         level = 0, desc = "일정 시간 공격 속도가 10% 상승한다.\n1레벨 지속 20초, 9레벨까지 +10초씩,\n10레벨부터 공격 속도 20% 상승과\n함께 분배마다 지속시간이 20초씩\n늘어난다." },
				-- 새비지블로우: MSW 기본 리소스에 없어 직접 구해와 업로드한 아이콘이다
				-- (원본/RUID 대응표: msw-dev-tools/resources/새비지블로우/RUID.md).
				-- (2026-08-06 스펙 개편) 마스터 30 spendable.
				-- (요청 2026-08-14 4차) 트리플 스로우 파생을 끊고 자체 곡선 - 줄당 50%~60%에서 분배
				-- 1포인트당 최소·최대 각 +2%p(마스터 30 = 108%~118%), MP 20
				-- (공식 한 곳: GetSavageBlowMinPercent / GetSavageBlowMaxPercent).
				{ ruid = "e4e5bf026b7c4976a1842de4418326ab", name = "새비지블로우",   maxLevel = 30, spendable = true, level = 0, desc = "전방의 적 하나를 빠르게 6번 난도질한다.\n1레벨 한 타당 50%~60%,\n분배 1포인트당 최소·최대가 2%p씩\n오른다(마스터 30에서 108%~118%).\n6타 합계는 그 6배.\nMP 20 소모." },
				-- 분신 강화(섀도어 2차, 2026-08-06 신설): 1차 분신 소환의 강화 3종 중 첫 번째.
				-- 지속시간과 분신 데미지를 함께 올리고, 분신이 **2차 공격 스킬까지** 쓰게 한다.
				-- ⚠ 아이콘은 1차 분신 소환과 공유한다(표창+ 계열과 같은 관례 - 전용 아이콘이 생기면 교체).
				{ ruid = "c6ce60523c954791af5632da796cca7c", name = "분신 강화",     maxLevel = 20, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n[분신 소환의 강화]\n분신이 더 오래 남고 강해진다.\n지속시간이 분배 1포인트당 늘어난다\n(강화 3종을 모두 마스터하면 5분).\n분신의 데미지가 분배 2포인트마다\n본체의 +1%p씩 오른다(마스터 +10%p).\n분신이 2차 공격 스킬까지 쓴다." },
				-- 2차 버프 3종: 아이콘/이펙트는 직접 구해와 업로드했다(원본/RUID 대응표는
				-- msw-dev-tools/resources/{분노,파워가드,메디테이션}/RUID.md).
				{ ruid = "a45e3d7aaeee453d934a451ba3e5cba5", name = "분노", maxLevel = 20, spendable = true,           level = 0, desc = "일정 시간 전투력이 증가한다.\n분배마다 전투력 +1% (마스터 시 +20%),\n지속시간은 부스터와 동일하게 늘어난다." },
				-- 불의 영역(2차 버프): 10분간 공격 적중 시 10% 확률로 그 자리에 화염 지대(10초, 2초 틱).
				-- 아이콘은 임시로 시전 이펙트 클립 썸네일(전용 아이콘이 생기면 교체).
				-- (불독 개편 2026-08-08) 마스터 20 spendable. 장판 데미지가 **빙하지대와 완전히 같다** -
				-- 수치를 따로 두지 않고 GetFireZoneMin/MaxPercent가 빙하지대 헬퍼를 그대로 호출한다
				-- (한쪽만 고치면 갈라지는 것 방지). 구 사양은 고정 200~300%였다. 화상 10%는 그대로.
				{ ruid = "thumbnail://4a729e5b7b0f4759ba197dcbb1d25a8b", name = "불의 영역", maxLevel = 20, spendable = true, level = 0, desc = "일정 시간 공격 적중 시 10% 확률로\n그 자리에 화염 지대를 만든다.\n지속·MP는 빙하지대(얼음 영역)와 같다 -\n지속 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초).\n화염 지대는 10초간 유지되며\n2초마다 전투력의 50%~60% 피해를 주고\n10% 확률로 적을 불태운다(4초 화상).\n분배 1포인트당 최소 +5%p /\n최대 +10%p씩 오른다\n(마스터 20에서 145%~250%).\nMP 50 소모." },
				-- 빙하지대(2차 버프): 불의 영역의 얼음 판 - 같은 지속/확률 구조, 장판 비주얼은 눈결정 다수.
				-- 아이콘은 임시로 눈결정 클립 썸네일(전용 아이콘이 생기면 교체).
				-- (썬콜 개편 2026-08-08) 마스터 20 spendable. 장판 데미지가 불의 영역(고정 200~300%)과
				-- 갈라졌다 - 1레벨 50%~60%에서 분배 1포인트당 최소 +5%p / 최대 +10%p
				-- (마스터 20에서 145%~250%). 공식은 GetGlacierZone* 헬퍼 한 곳.
				{ ruid = "thumbnail://f69a8c62757a40c6bb0d5a8e6e903aab", name = "빙하지대", maxLevel = 20, spendable = true, level = 0, desc = "일정 시간 공격 적중 시 10% 확률로\n그 자리를 빙하 영역으로 만든다.\n지속 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초 - 블레스와 동일 곡선)\n빙하 영역은 10초간 유지되며\n2초마다 전투력의 50%~60% 피해를 주고\n30% 확률로 적을 얼린다.\n분배 1포인트당 최소 +5%p /\n최대 +10%p씩 오른다\n(마스터 20에서 145%~250%).\nMP 50 소모." },
				-- 서먼 다크드래곤(2차 버프, 2026-08-04 스펙 개편): 마스터 20 spendable. 지속 3분20초+분배당
				-- 20초(마스터 10분), 독립 쿨타임 10분. 3~7초 공격(전투력 200~300%), 버프는 소환 3~15초에
				-- 최초 1회 후 40~60초마다 - 가중 랜덤 7종(힐30/콤보20/아이언월20/블랙10/쉐도우10/메디10/분노10).
				-- 아이콘은 임시로 드래곤 idle 1프레임. 리소스: msw-dev-tools/resources/다크드래곤/RUID.md
				{ ruid = "7ac2730a18ac47e083a46dc5e879deac", name = "서먼 다크드래곤", maxLevel = 20, spendable = true, level = 0, desc = "다크드래곤을 소환한다.\n지속시간 10초, 분배마다 +5초\n(마스터 시 105초). 재사용 대기시간 없음.\nMP 50 소모.\n\n드래곤이 주변을 돌며 3~7초마다\n전투력의 93%~103%로 공격하고\n분배마다 최소/최대가 3%p씩 오른다\n(마스터 시 150%~160%).\n\n소환 후 3~15초에 첫 버프,\n이후 40~60초마다 버프를 걸어준다.\n버프: 힐/콤보 어택/아이언 월/\n서먼블랙드래곤/쉐도우 파트너/\n메디테이션/분노." },
				-- (썬콜 개편 2026-08-08) 마스터 20 spendable. 고정 +30/5분이던 것을 분배 비례로 바꿨다 -
				-- 마력 +2/분배(마스터 +40), 지속 30초에서 분배 1포인트당 +10초(마스터 220초).
				-- 지속 공식은 GetMeditationDuration 한 곳. 다크드래곤이 걸어주는 메디테이션 버프
				-- (ApplyDragonStatBuff, +30/30초)는 별개 사양으로 그대로 둔다.
				{ ruid = "0f17bf5d72934e91bc2c3f66505112a8", name = "메디테이션",     maxLevel = 20, spendable = true, level = 0, desc = "정신을 집중해 마력을 끌어올린다.\n분배 1포인트당 마력이 2 오른다\n(마스터 20에서 +40).\n오른 마력은 전투력에 그대로 반영되어\n스킬 데미지도 함께 오른다.\n지속 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초 - 블레스와 동일 곡선).\nMP 30 소모." },
				-- 블레스(2차 버프): 자신 + 힐 범위 안의 소환된 용사들 공마 +30. 아이콘/이펙트는 직접
				-- 구해와 업로드했다(원본/RUID 대응표: msw-dev-tools/resources/블레스/RUID.md).
				-- (비숍 개편 2026-08-08) 마스터 30 spendable. 고정 +30이던 것을 **분배 레벨 비례**로 바꿨다 -
				-- 1포인트당 공격력 +1 / 마력 +1 / STR·DEX·LUK·INT 각 +3 (마스터 30에서 공마 30, 4스탯 90).
				-- 공식은 GetBlessAttackBonus / GetBlessStatBonus 한 곳에만 있다.
				{ ruid = "476232fa1b5e4ce68268fb26a793eb7d", name = "블레스",         maxLevel = 30, spendable = true, level = 0, desc = "자신과 주변에 소환된 영웅들을\n축복한다.\n분배 1포인트당 공격력 +1, 마력 +1,\nSTR·DEX·LUK·INT가 각각 +3\n(마스터 30에서 공마 +30, 스탯 +90).\n오른 공격력·스탯은 전투력에 그대로\n반영되어 스킬 데미지도 함께 오른다.\n지속 20초, 분배 1포인트당 +10초\n(마스터 30에서 5분 10초).\nMP 30 소모.\n(범위는 힐과 동일하며, 한 번 받은\n버프는 거리와 무관하게 유지된다.)" },
				{ ruid = "130a612ff85c4eae9e9f52adb9d7d4a9", name = "파워가드", maxLevel = 20, spendable = true,       level = 0, desc = "일정 시간 받는 피해가 분배당 1%\n감소하고, 피격 후 3초마다 총 3회에\n걸쳐 입은 피해의 분배당 2%를\nHP로 회복한다.\n지속시간은 부스터와 동일하게 늘어난다." },
				-- 가드(2026-08-09 요청): 팔라딘 **1차 → 2차**로 이관(팔라딘 전용 유지 - 히어로에겐 주지 않는다).
				-- 빈 1차 자리는 히어로와 같은 "러시"가 채운다(팔라딘 1차도 히어로와 동일 구성).
				-- ⚠ 차수를 옮겼으므로 CSV reqLevel도 1차 대역(15) → 2차 대역(30)으로 함께 올렸다 -
				--   안 그러면 GetSkillTier가 여전히 1차로 판정해 **1차 SP를 깎아 쓴다**
				--   (암행·백스탭·피어싱이 같은 이유로 고쳐진 전례가 폴백 표 주석에 있다).
				{ ruid = "2ba15e204ac64214a8144b0b2deeaf79", name = "가드",           maxLevel = 10, spendable = true, level = 0, desc = "1.2초간 공격을 받아넘길 자세를 취한다.\n그 사이 공격을 받으면 피해를 무시하고\n2초 무적 + 10초간 받는 피해가\n분배 1포인트당 5%씩 감소한다(마스터 50%).\n재사용 대기시간 30초에서 분배마다 -1초.\nMP 20 소모.\n자동사냥 중엔 피격 타이밍에 25% 확률로\n자동 발동한다." },
				-- 패링(2차, 2026-07-28 개편): 시전 즉시 이펙트, 1.5초 안에 피격 시 가드 표시 + 피해 무시 +
				-- 3초 무적 + 0.5초 뒤 주변 최대 6명 반격. 쿨타임 10초, 가드 성공 시 쿨타임 초기화.
				{ ruid = "f7b8fd9fe52f43d78e25ef9695eeb046", name = "패링",           level = 1, desc = "즉시 검격을 내지르며 1.5초간 공격을\n받아넘길 자세를 취한다. 그 사이 공격을\n받으면 피해를 무시하고 3초간 무적이 되며,\n0.5초 뒤 주변의 적 최대 6명에게 전투력의\n500%~700% 피해를 입힌다.\n재사용 대기시간 10초(가드 성공 시 초기화)." },
				-- 백스탭(2차, 2026-07-30 신설): 몬스터가 바라보는 방향의 뒤쪽에서 때리면 데미지가 늘어난다.
				-- 표창+와 같은 spendable 스킬(카드 "+" 버튼으로 포인트 분배) - 20이 마스터이고 1포인트당
				-- 백스탭 추가 데미지가 5%p 늘어난다(마스터 = +100%, 즉 뒤에서 때리면 2배).
				-- (요청 2026-08-06) 테스트용 ON/OFF 토글 → **패시브**로 전환. 배우기만 하면 항상 발동하고
				-- 퀵슬롯에 올릴 수 없다(IsPassiveSkillName).
				-- 전용 아이콘 리소스가 없어 원본 팩 skill/422.img/skill/4221017("크루얼 스탭")의 icon을
				-- 임시로 쓴다(교체 가능).
				{ ruid = "9001cf69223440d0b3cec6bc73acf251", name = "백스탭",         level = 0, maxLevel = 20, spendable = true, desc = "[패시브 - 퀵슬롯 배정 불가]\n몬스터가 바라보는 방향의 뒤쪽에서\n공격하면 추가 데미지를 준다.\n포인트 1당 추가 데미지가 5% 오른다\n(20 마스터 = 뒤에서 때릴 때 2배).\n분신의 공격도 분신이 선 자리를\n기준으로 함께 적용된다." },
			},
			["3"] = {
				-- (불독 개편 2026-08-08) 마스터 20 spendable. 독 틱 데미지가 고정 40~60%에서
				-- 70%~80% + 분배 1포인트당 최소·최대 각 +5%p로 바뀌었다(마스터 165%~175%).
				-- 공식은 GetPoisonMist* 헬퍼 한 곳. 지속 40초/틱 1초/무크리는 기존 사양 그대로.
				{ ruid = "efb2d49b00ea433d80379fa679614920", name = "포이즌 미스트",     maxLevel = 20, spendable = true, level = 0, desc = "독 안개를 뿌려 40초간 유지한다.\n안개에 닿은 적은 1초마다\n전투력의 50%~60% 독 피해를 입고,\n분배 1포인트당 최소·최대가 3%p씩\n오른다(마스터 20에서 107%~117%).\n익스플로젼으로 안개를 터뜨리면\n그 자리에서 폭발 피해가 들어간다.\nMP 30 소모." },
				-- (불독 개편 2026-08-08) 마스터 20 spendable. 데미지가 고정 500~700%에서
				-- 300%~350% + 분배 1포인트당 최소·최대 각 +30%p로 바뀌었다(마스터 870%~920%).
				-- 공식은 GetExplosion* 헬퍼 한 곳. 주변 독안개 유폭(최대 6개)은 기존 사양 그대로.
				{ ruid = "ddbe74e1d9bb496dae8dc7ab111aa57b", name = "익스플로젼",         maxLevel = 20, spendable = true, level = 0, desc = "강력한 폭발을 일으켜 주변의 적\n최대 6명에게 전투력의 300%~320%\n피해를 주고, 분배 1포인트당\n최소·최대가 5%p씩 오른다\n(마스터 20에서 395%~415%).\n주변의 포이즌 미스트 독안개를\n최대 6개까지 함께 터뜨려\n같은 폭발 피해를 준다.\nMP 30 소모." },
				-- 드래곤 로어(다크나이트 3차, 2026-08-04 스펙 개편): 마스터 30 spendable.
				-- 데미지 1레벨 300% + 분배당 30%p(마스터 1170%), HP 소모 1레벨 최대HP 70%에서 분배당 -1%p(마스터 41%).
				{ ruid = "3f93e7fe6b244027ad09611ce4f60415", name = "드래곤 로어",         maxLevel = 30, spendable = true, level = 0, desc = "포효로 주변의 적 최대 20명을 강타한다.\n1레벨 전투력의 300%,\n분배 1포인트당 +30%p(마스터 1170%).\n사용 즉시 최대 HP를 소모한다 -\n1레벨 70%에서 분배 1포인트당 -1%p\n(마스터 41%).\n시전 후 2초간 스턴." },
				-- 스피어 버스터(다크나이트 3차, 2026-08-04 스펙 개편): 마스터 30 spendable.
				-- 줄당 100~150% + 분배당 최소 5%p / 최대 10%p, 동시 타격 1~9=4 / 10~19=6 / 20~29=8 / 30=10명.
				{ ruid = "948d8f877f1349a38ab7111df06fd9b5", name = "스피어 버스터",       maxLevel = 30, spendable = true, level = 0, desc = "창으로 전방의 적을 3번 찌른다.\n한 줄당 전투력의 100%~150%에서\n분배 1포인트당 최소 +5%p / 최대 +10%p\n(마스터 245%~440%).\n동시 타격 수는 1~9레벨 4명,\n10~19레벨 6명, 20~29레벨 8명,\n30레벨에 10명." },
				{ ruid = "73d6c63787a64b2c8d34373792b7e716", name = "디바인 스윙 강화",   maxLevel = 20, spendable = true, level = 0, desc = "차지 블로우의 속성을 불로 정한다.\n분배 1포인트당 불 속성 차지 블로우의\n데미지가 2% 상승한다(마스터 +40%).\n속성을 바꾸면 직전까지 쓰던 속성은\n20초간 다시 사용할 수 없다." },
				{ ruid = "28e3b85f945347fa8209ec18b4bb296c", name = "디바인 스티그마 강화", maxLevel = 20, spendable = true, level = 0, desc = "차지 블로우의 속성을 얼음으로 정한다.\n분배 1포인트당 얼음 속성 차지 블로우의\n데미지가 2% 상승한다(마스터 +40%).\n속성을 바꾸면 직전까지 쓰던 속성은\n20초간 다시 사용할 수 없다." },
				{ ruid = "8dbb1b41e92c4f8290402b9a7d51649d", name = "디바인 저지먼트 강화", maxLevel = 20, spendable = true, level = 0, desc = "차지 블로우의 속성을 전기로 정한다.\n분배 1포인트당 전기 속성 차지 블로우의\n데미지가 2% 상승한다(마스터 +40%).\n속성을 바꾸면 직전까지 쓰던 속성은\n20초간 다시 사용할 수 없다." },
				{ ruid = "d714c4d5a90a43a7b5a7bfb3b49c4628", name = "콤보 어택", maxLevel = 30, spendable = true,           level = 0, desc = "스킬 적중 시 확률로 콤보 구슬을 얻어\n구슬당 최종 데미지가 3% 증가한다.\n적중 획득 확률 분배마다 +1%(최대 40%).\n5레벨마다 최대 구슬 +1(최대 5개).\n지속시간 70초, 분배마다 +8초.\nMP 30 소모." },
				{ ruid = "540d17412269428899086a8e62ca5aee", name = "패닉", maxLevel = 20, spendable = true,               level = 0, desc = "콤보 구슬을 모두 소모해 대상 하나에게 강력한 피해를 입힌다.\n구슬이 없으면 사용할 수 없다." },
				{ ruid = "6a4b4c93ebf14ea1ad480a836c741205", name = "코마", maxLevel = 20, spendable = true,               level = 0, desc = "강한 일격으로 적을 기절시킨다." },
				-- 발도술(히어로 3차 버프, 2026-08-04 신설): 지속 동안 공속 +1단계, 지속 중 파워스트라이크/
				-- 슬래시블러스트/돌진/브랜디쉬로 적을 처치하면 3초간 중첩당 공격력 +10·크확 +3%.
				-- 아이콘은 시전 이펙트와 색을 맞춘 금빛 재색상 카타나(batto_icon_gold - 발도술/RUID.md).
				{ ruid = "400e3fc62cfe4860ad4385bec2dbf826", name = "발도술", maxLevel = 20, spendable = true,             level = 0, desc = "검기를 다스리는 발도의 자세를 취한다.\n지속시간 20초, 분배마다 +10초\n(10분배부터 +20초, 마스터 310초).\n지속 중 공격 속도가 10% 상승한다.\n\n지속 중 파워스트라이크/슬래시블러스트/\n돌진/브랜디쉬로 적을 공격하면 3초간\n중첩당 공격 속도 +3%,\n크리티컬 확률 +3%가 상승한다\n(중첩 수는 퀵슬롯 위에 표시).\n중첩 상한: 1~9분배 1중첩,\n10~19분배 2중첩, 20분배 3중첩." },
				-- 트리플 스로우(3차, 2026-07-30 신설): 럭키세븐(2발)의 상위 - 표창을 3발 던진다.
				-- 데미지 숫자도 3줄, 쉐도우 파트너 중에는 6줄. 아이콘/시전 이펙트/타격 이펙트는
				-- 원본 팩 skill/40004.img/skill/400041017의 icon / effect / hit/0.
				-- 사용음·타격음은 럭키세븐과 같다(요청). 럭키세븐처럼 가니어(아대) 장착이 필요하다.
				-- (2026-08-05 스펙 개편) 마스터 30 spendable.
				-- (요청 2026-08-14 6차) 줄당 **80%~90% + 분배 1포인트당 최소·최대 2%p**(마스터 30 = 138%~148%).
				-- 종전엔 "1레벨 = 럭키세븐 마스터의 표창 1개분"(16.7%~83.3%)에서 시작했는데, 08-14 5차에
				-- 럭키세븐이 더블샷 규격으로 옮겨가면서 파생을 끊었고 이번에 기준값을 새로 지정받았다.
				{ ruid = "f6ba1caf12374f0fab2dc6de85568fdb", name = "트리플 스로우",       maxLevel = 30, spendable = true, level = 0, desc = "표창을 연달아 3개 던진다.\n표창 1개당 1레벨 80%~90%,\n분배 1포인트당 최소·최대가 2%p씩\n오른다(마스터 30에서 138%~148%).\n데미지가 3줄로 표시되고\n쉐도우 파트너 중에는 6줄이 된다.\n표창 3개 소모, MP 20 소모.\n가니어를 장착해야 사용할 수 있다." },
					-- 트레이닝 II(나이트로드 3차 패시브, 2026-08-07 개편 - 옛 "마크 오브 어쌔신 II"의 자리).
					-- 1차 트레이닝의 상위판 - 분배 1포인트당 공격력 +4(1차의 2배)이고 1차와 **합산**된다.
					-- 아이콘은 1차와 같은 계열로 같은 RUID를 쓴다(전용 아이콘이 생기면 교체).
				{ ruid = "043f60b34b6f4e708b1e0dd914a7a5d1", name = "트레이닝 II", maxLevel = 20, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n[1차 트레이닝의 상위 수련]\n\n분배 1포인트당 공격력이 4씩 오른다\n(마스터 20에서 +80).\n\n1차 트레이닝의 공격력과 합산된다\n(양쪽 마스터 시 +120)." },
				-- 쉐도우 파트너(3차, 2026-08-05 스펙 개편): 마스터 30 spendable.
				-- (요청 2026-08-14 4차) 지속 20초 + 분배 1포인트당 +10초(마스터 30 = 310초), MP 100 소모 신설.
			-- 분신 데미지 = 본체의 50% + 분배당 1%p(마스터 79%) - 이쪽은 그대로다.
				{ ruid = "c6ce60523c954791af5632da796cca7c", name = "쉐도우 파트너",       maxLevel = 30, spendable = true, level = 0, desc = "분신을 소환해 함께 공격한다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 30에서 5분 10초).\nMP 100 소모.\n분신의 데미지는 본체의 50%이며\n분배 1포인트당 +1%p(마스터 79%).\n지속 중에는 모든 공격의 데미지가\n두 줄(본체 + 분신)로 표시된다." },
				-- 암행2(3차, 2026-07-30 신설): 암행1의 상위 - 표창을 던지는 대신 몬스터 **뒤쪽**에
				-- 그림자가 나타나 더블스탭이나 새비지블로우를 쓴다. 확률은 암행1과 같은 20%지만
				-- 완전히 독립적으로 굴린다(암행1이 터져도 암행2는 따로 판정).
				-- 아이콘은 임시로 암행1 아이콘을 쓴다(교체 가능).
				-- (2026-08-06 스펙 개편) 요청 - "암행1과 같은 성장 곡선 / 같은 마스터 레벨". 마스터 20
				-- spendable로 바꾸고 지속시간(20초 + 10초/pt)·발동 확률(4/6/8%)·한 타당 데미지
				-- (200%~220% + 분배당 4%p)·MP 30을 **암행1의 헬퍼(GetAmhaengDuration /
				-- GetAmhaengProcPercent / GetAmhaengMin·MaxPercent / GetAmhaengMpCost)를 그대로** 쓴다.
				-- (요청 추가) 시전 방식도 ON/OFF 토글 → **암행1과 같은 지속시간 버프**로 전환.
				{ ruid = "6e463376315c4a4eb8f632bea7b4cd3b", name = "암행2",               maxLevel = 20, spendable = true, level = 0, desc = "잠시 그림자와 하나가 된다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초).\n지속 중 한 대상을 때린 타수마다\n확률로 주변의 적 하나의 뒤쪽에\n그림자가 나타나 더블스탭이나\n새비지블로우를 쓴다.\n발동 확률 1레벨 4%, 10레벨 6%,\n20레벨 8%.\n한 타당 전투력의 200%~220%에서\n분배 1포인트당 최소·최대가 4%p씩\n오른다(마스터 276%~296%).\nMP 30 소모.\n(암행과는 확률을 따로 굴린다.)" },
				{ ruid = "5dea29ad262d4940b5ef47eacc280e90", name = "플래쉬 점프",         level = 1, desc = "공중에서 한 번 더 도약한다." },
				-- 표창+ III(나이트로드 3차, 2026-08-05 신설): 표창 5·6·7번을 연다(분배 1·10·20). 마스터 30.
				{ ruid = "a66f7a4983444b888f3a713b3eded36f", name = "표창+ III",     level = 0, maxLevel = 30, spendable = true, desc = "표창을 다루는 솜씨가 경지에 이른다.\n포인트 1당 공격력이 1 오른다.\n분배 1·10·20에서 표창이 1종씩 열린다\n(5번·6번·7번 표창 / 마스터 30)." },
				-- 어벤져(3차): 마스터 20 spendable.
				-- (요청 2026-08-14 5차) 전투력의 160%~180%에서 분배 1포인트당 최소·최대 각 +3%p
				-- (마스터 20 = 217%~237%), MP 30. 종전 100%~200% + 5%p/pt.
				{ ruid = "bf14a6c4355b4aa0b193cd77cf066215", name = "어벤져",             maxLevel = 20, spendable = true, level = 0, desc = "표창을 던져 전방의 적 최대 10명을\n관통하며 공격한다.\n전투력의 160%~180%에서 분배\n1포인트당 최소·최대가 3%p씩 오른다\n(마스터 20에서 217%~237%).\n표창 15개 소모, MP 30 소모." },
				-- 어썰터(섀도어 3차, 2026-08-06 스펙 개편): 마스터 30 spendable.
				-- 요청 사양 - "1회 차지 속도가 1레벨 10초, 10레벨 8초, 20레벨 6초, 30레벨 5초".
				-- (요청 2026-08-14 4차) 새비지블로우 6타 합계 파생을 끊고 자체 곡선 - 대상당 200%~220%에서
				-- 분배 1포인트당 최소·최대 각 +4%p(마스터 30 = 316%~336%), MP 30.
				-- 데미지 = GetAssaulterMin·MaxPercent, 충전 = GetAssaulterChargeSeconds.
				{ ruid = "07de3cf12cc44009940e7a6673d9ac5a", name = "어썰터",             maxLevel = 30, spendable = true, level = 0, desc = "대상에게 빠르게 돌진하여 공격한다.\n대상당 200%~220%, 분배 1포인트당\n최소·최대가 4%p씩 오른다\n(마스터 30에서 316%~336%).\nMP 30 소모.\n\n스택 1개를 소모해 사용하며\n최대 3개까지 쌓인다.\n1개가 차는 시간은 1레벨 10초에서\n10레벨 8초, 20레벨 6초,\n30레벨 5초로 줄어든다." },
				-- 분신 강화 II(섀도어 3차, 2026-08-06 신설): 강화 3종 중 두 번째. 2차 강화와 같은 폭으로
				-- 지속시간·데미지를 올리고, 분신이 **3차 공격 스킬까지** 쓰게 한다.
				{ ruid = "c6ce60523c954791af5632da796cca7c", name = "분신 강화 II",       maxLevel = 20, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n[분신 소환의 강화]\n분신이 더 오래 남고 강해진다.\n지속시간이 분배 1포인트당 늘어난다\n(강화 3종을 모두 마스터하면 5분).\n분신의 데미지가 분배 2포인트마다\n본체의 +1%p씩 오른다(마스터 +10%p).\n분신이 3차 공격 스킬까지 쓴다." },
				-- 스트레이프(3차): 화살/시전/적중 이펙트와 아이콘 전부 원본 팩
				-- skill/800032.img/skill/80003299의 ball/0, effect, hit/0, icon RUID를 그대로 쓴다.
				{ ruid = "c13bd2c76a98448b96b5152dc28f239f", name = "스트레이프",         maxLevel = 30, spendable = true, level = 0, desc = "전방으로 화살 네 발을 연속 발사해\n적 하나를 4번 공격한다.\n한 발당 전투력의 120%~130%에서\n분배 1포인트당 최소 5%p·최대 6%p씩\n오른다(마스터 30에서 265%~304%).\nMP 30 소모." },
				{ ruid = "7d3db33ced4149f8853b1abc0734b384", name = "에로우 레인",         level = 1, desc = "하늘에서 화살비를 퍼붓는다." },
				-- 파이어 샷(3차): 아이스 샷과 같은 구조. 아이콘/탄환/시전/히트/바닥불길/파편 전부
				-- 원본 팩 skill/800033.img/skill/80003324의 RUID를 그대로 쓴다.
				-- (보우마스터 개편 2026-08-07) spendable 편입. 마스터 레벨·분배별 데미지 전부 **아이스 샷과 동일**
				-- (수치는 GetFireShot*Percent가 GetIceShot*Percent에서 그대로 파생시킨다 - 한쪽만 고쳐도 어긋나지 않게).
				{ ruid = "a15173e4162a4a9eb5f92b9e5d73ff6d", name = "파이어 샷",           maxLevel = 30, spendable = true, level = 0, desc = "화염을 터뜨리며 범위 내 적 최대 10명에게\n화염 탄환을 날린다.\n한 명당 전투력의 200%~220%에서\n분배 1포인트당 최소·최대가 5%p씩\n오른다(마스터 30에서 345%~365%).\n(아이스 샷과 같은 규격)\n맞은 자리에 불길이 번진다." },
				{ ruid = "fbfbe956c35a4bb8a5bfd707010b63b2", name = "퍼펫",               level = 1, desc = "인형을 소환해 적의 시선을 끈다." },
				{ ruid = "06536fe0f8814a6ea4c4dd5bb6b7750a", name = "모탈 블로우",         level = 1, desc = "강한 일격으로 적에게 치명타를 입힌다." },
				{ ruid = "0638d6950da040f09dc0fb5bce4e6bed", name = "아이스 스트라이크",   level = 1, desc = "얼음의 힘으로 적을 강타한다." },
				-- 아이스 샷(3차): 아이콘/화살/시전/히트 이펙트 전부 구버전 원본 추출본을 직접 업로드했다
				-- (원본/RUID 대응표: msw-dev-tools/resources/아이스샷/RUID.md).
				-- 피어싱(신궁 4차, 2026-08-06 신설): 스나이핑과 같은 차지 구조지만 기를 모으는 속도가 10배
			-- 빠르고, 한 방은 가볍되 위아래 판정이 넓고 10명을 관통한다.
			-- 아이콘/화살/기 모으기·발사 이펙트/사운드 전부 원본 팩 skill/322.img/skill/3221017(피어싱).
			{ ruid = "8d9d46dcaa164c46a0b1da47db016c43", name = "피어싱",             maxLevel = 30, spendable = true, level = 0, desc = "키를 누르고 있으면 기가 모이고\n(완충 1초 - 스나이핑의 10배 속도),\n떼면 관통 화살 한 발로\n최대 10명을 꿰뚫는다.\n기본 데미지는 전투력의 30%~50%에서\n분배 1포인트당 최소·최대가 10%p씩\n오른다(마스터 30에서 320%~340%).\n\n여기에 모은 기가 배율로 곱해진다 -\n완충 시 5배.\n스나이핑보다 한 방은 가볍지만\n위아래 공격 범위가 넓다.\n차지 중 이동속도가 50% 줄어든다." },
			{ ruid = "3aeb13b82977470d85c9aac1a0732515", name = "아이스 샷",           maxLevel = 30, spendable = true, level = 0, desc = "빛을 터뜨리며 범위 내 적 최대 10명에게\n얼음 화살을 날린다.\n한 명당 전투력의 200%~220%에서\n분배 1포인트당 최소·최대가 5%p씩\n오른다(마스터 30에서 345%~365%).\n맞은 적은 3초간 얼어붙어 움직이지 못한다.\nMP 30 소모." },
				-- 궁병 지원(3차, 2026-07-28 신설): 30초 동안 유저 등 뒤 화면 밖에서 아이스 샷/파이어 샷 화살이
				-- 몬스터를 향해 총 30발(랜덤 간격, 얼음/불 교차) 날아와 착탄점 일대를 속성 공격한다. 쿨타임 2분.
				{ ruid = "9ea8dea2ef2e404595ef871d07ce089b", name = "궁병 지원",           maxLevel = 20, spendable = true, level = 0, desc = "30초 동안 먼 곳에서 지원 사격이\n날아온다. 화살이 꽂힌 자리 일대의 적\n최대 6명에게 속성 피해를 입힌다.\n화살당 전투력의 90%~120%에서\n분배마다 최소/최대가 4%p씩 오른다.\n(얼음은 빙결, 불은 화상)\n재사용 대기시간 2분." },
				-- 샤이닝 레이(3차, 2026-07-29 신설): 사용자 제공 클래식 아트(effect+sineffect 동시 시작) 44장
				-- 업로드(원본/RUID 대응표: msw-dev-tools/resources/샤이닝레이/RUID.md). 사용음/적중음은
				-- 라이브러리 원본 팩 skill/231.img/skill/2311004의 _audio/Use·Hit, 아이콘도 같은 팩의 icon.
				-- (비숍 개편 2026-08-08) 마스터 20 spendable. 1레벨 1000%~1500%에서 분배 1포인트당
				-- 최소·최대가 30%p씩 오르고(마스터 20에서 1570%~2070%), 쿨타임은 60초에서 1포인트당
				-- 1초씩 줄어든다(마스터 41초).
				{ ruid = "49bd6b2c5d22446c9f8079a50bcc67c0", name = "샤이닝 레이",         maxLevel = 20, spendable = true, level = 0, desc = "빛의 세례를 내려 주변의 적 최대 30명을\n공격한다.\n전투력의 1000%~1500%에서 분배\n1포인트당 최소·최대가 30%p씩\n오른다(마스터 20에서 1570%~2070%).\n(범위는 드래곤 로어의 절반)\n재사용 대기시간 1분에서\n분배 1포인트당 1초씩 줄어든다\n(마스터 41초).\nMP 100 소모." },
				-- 드래곤 라이딩(3차): 5분간 드래곤을 소환해 따라다니게 하고, 소환 중 다시 쓰면 그 드래곤에
				-- 탑승해 자유롭게 날아다닌다. 아이콘은 임시(드래고니카 라이딩 이용권) - 교체 가능.
				-- 소환 중에는 퀵슬롯 아이콘이 드래곤 라이딩 아이콘(77e0cbe8)으로 바뀐다.
				-- 차지 블로우(3차): 자체 쿨타임 없음. 디바인 4종(스티그마 강화 / 스윙 강화 / 저지먼트 강화 /
				-- 차지) 중 하나를 쓰면 그 속성이 차지 블로우에 실리고, 퀵슬롯 아이콘도 그 스킬 아이콘으로
				-- 바뀐다. 디바인 4종은 공용 0.5초 쿨타임을 쓰며, 이미 켜져 있는 속성은 연속 선택할 수 없다.
				-- (요청 2026-08-15) 전환하면 **직전까지 쓰던 속성**만 추가로 20초 잠긴다(불→얼음이면 불이 20초).
				-- 공격 자체는 파워스트라이크와 완전히 동일하고(모션/판정/데미지/파이널어택 공유),
				-- 검 궤적 이펙트만 속성별 전용 아트로 대체된다 - 스티그마=얼음 / 스윙=불 / 저지먼트=전기 /
				-- 차지=성. 속성이 없는 상태면 파워스트라이크 기본 궤적 그대로 나간다.
				{ ruid = "28e3b85f945347fa8209ec18b4bb296c", name = "차지 블로우",         maxLevel = 20, spendable = true, level = 0, desc = "디바인 4종으로 지정한 속성을 실어 공격한다.\n전투력의 180%~240% 피해를 주고\n분배마다 최소/최대가 3%p씩 오른다.\nMP 20 소모. 검 궤적이 속성별로 바뀐다\n(스티그마=얼음 / 스윙=불 /\n저지먼트=전기 / 차지=성)." },
				{ ruid = "1de1c87ae2ed443184844dc0ea1e831e", name = "속성필드", maxLevel = 20, spendable = true, level = 0, desc = "버프 지속 중 차지 블로우를 쓰면\n그 지역에 무기 속성의 필드가 생긴다.\n필드 위의 적은 그 속성 상태를 가진\n것으로 취급되고, 허공을 공격해도\n중첩 연계가 발동한다.\n버프 20초+분배당 10초\n(10레벨부터 +20초, 마스터 310초).\n필드 10초+2분배당 1초(마스터 20초).\nMP 50 소모." },
				{ ruid = "fd8d94ac1de548958b8467a4131659cb", name = "속성 증폭", maxLevel = 10, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n속성이 부딪힐 때 발동하는 연계 장판\n(20초 동안 2초마다 전투력의\n40%~80%)의 데미지가\n분배 1포인트당 10% 증가한다." },
				-- (2026-08-04 스펙 개편) 마스터 20 spendable. 데미지 150~200% + 분배당 최소 15%p / 최대 20%p.
				-- (요청 2026-08-05) 탑승 이동속도 1레벨 = 걷기의 **120%**(이전 1.0배 - 1레벨에서 오히려
				-- 평소보다 느리게 느껴진다는 신고), 분배당 +2%p(마스터 20 = 158%).
				{ ruid = "84190342335e44ad98519eb58753eea0", name = "드래곤 라이딩",       maxLevel = 20, spendable = true, level = 0, desc ="2분 30초 동안 드래곤을 소환한다.\n지속시간은 분배 1포인트당 +20초\n(마스터 8분 50초).\n드래곤이 따라다니며 5~7초마다 사거리 내의\n적을 공격한다 - 전투력의 150%~200%에서\n분배 1포인트당 최소 +15%p / 최대 +20%p\n(마스터 435%~580%).\n소환 중 다시 사용하면 드래곤에 탑승해\n자유롭게 날 수 있다. 탑승 이동속도는\n1레벨에 걷기의 120%이고 분배 1포인트당 +2%p\n(마스터 158%).\n(탑승 중에는 다른 스킬을 쓸 수 없다)\n재사용 대기시간 5분." },
				-- 용사 소환(3차): 전사 3계열(히어로/팔라딘/다크나이트) 중 랜덤 1명을 아바타 NPC로
				-- 소환한다. 레벨은 내 레벨의 2/3, 직업명은 레벨 구간(10/30/70/120)에 따라 플레이어와
				-- 동일하게 바뀌고 직업별 스킬(분노/파워가드/부스터/콤보어택+코마/스피어버스터+드래곤로어/
				-- 공속 버프)을 쓴다. 아이콘/소환 이펙트/사운드는 원본 팩 skill/000.img/skill/0001005
				-- (영웅의 메아리)의 icon / effect / _audio/Use를 그대로 쓴다.
				-- (비숍 개편 2026-08-08) "용사 소환"은 비숍의 **3차** 소환이다(CSV reqLevel 70).
				-- ⚠ 개편 도중 잠깐 2차(reqLevel 60)로 내렸다가 요청으로 되돌렸다 - 차수는 CSV 한 곳에서
				--   전역 결정되므로, 이 스킬을 가진 네 직업(비숍·신궁·보우마스터·아크메이지(썬콜))의
				--   표시 트리가 전부 같은 차수를 가리켜야 한다.
				{ ruid = "ec65789e35b34c90bdf883a51c76a720", name = "용사 소환",           maxLevel = 30, spendable = true, level = 0, desc = "전사 용사(히어로·팔라딘·다크나이트 계열 중\n랜덤 1명)를 5분간 소환한다.\n용사 레벨은 1레벨에 내 레벨의 50%이고\n분배 2포인트마다 +1%p(마스터 30에서 65%).\n용사의 전투력도 레벨에 맞춰 올라간다.\n몬스터를 추적해 직업에 맞는 스킬로 싸우고\n멀어지면 곁으로 순간이동한다.\n장비는 드롭 방어구+직업 무기, 외형은 랜덤.\n재사용 대기시간 없음 - 다시 사용하면\n기존 용사를 없애고 새로 소환한다.\nMP 200 소모." },
				-- 도적 소환(비숍 2차, 2026-08-08 신설) / 궁수 소환(비숍 4차, 2026-08-08 신설):
				-- **용사 소환과 완전히 같은 규격**이다(지속 5분 / 레벨 = 내 레벨의 50% + 2포인트당 1%p /
				-- HP·전투력·장비·순간이동 규칙 전부 동일). 다른 점은 딱 두 가지 -
				--   · 어떤 직업 풀에서 뽑는가: 용사=전사 3계열 / 궁수=보우마스터·신궁 / 도적=나이트로드·섀도어
				--   · 어떤 전투 스타일로 싸우는가: 각 직업의 **자동사냥 로테이션과 같은 스킬 구성**
				-- 구현은 HeroSummon.mlua 한 곳에서 summonClass로 갈린다(별도 파일을 만들지 않는다 -
				-- 세 소환이 규격을 공유하므로 파일이 갈리면 곧바로 드리프트한다).
				-- 아이콘은 각각 원본 팩의 궁수/도적 대표 스킬 아이콘을 임시로 쓴다(교체 가능).
				{ ruid = "0cfe777a9cd04df9bbb22a18a598e9b7", name = "궁수 소환",           maxLevel = 30, spendable = true, level = 0, desc = "[MP 200 소모]\n궁수 용사(보우마스터·신궁 중 랜덤 1명)를\n5분간 소환한다.\n소환수 레벨은 1레벨에 내 레벨의 50%이고\n분배 2포인트마다 +1%p(마스터 30에서 65%).\n활 스킬로 거리를 두고 싸우며,\n그 직업의 자동사냥과 같은 방식으로\n스킬을 돌려 쓴다.\n멀어지면 곁으로 순간이동한다.\n재사용 대기시간 없음 - 다시 사용하면\n기존 소환수를 없애고 새로 소환한다." },
				{ ruid = "92a5020c978c46bdabab910598118b86", name = "도적 소환",           maxLevel = 30, spendable = true, level = 0, desc = "[MP 200 소모]\n도적 용사(나이트로드·섀도어 중 랜덤 1명)를\n5분간 소환한다.\n소환수 레벨은 1레벨에 내 레벨의 50%이고\n분배 2포인트마다 +1%p(마스터 30에서 65%).\n표창과 단검으로 파고들며 싸우고,\n그 직업의 자동사냥과 같은 방식으로\n스킬을 돌려 쓴다.\n멀어지면 곁으로 순간이동한다.\n재사용 대기시간 없음 - 다시 사용하면\n기존 소환수를 없애고 새로 소환한다." },
				-- 힐러 소환(3차, 2026-07-28 신설): 용사 소환과 같은 아바타 NPC 규격이지만 직업은 비숍 고정이고
				-- 스킬은 힐/텔레포트 둘뿐이다. 공격을 하지 않고 제자리에 서서 힐을 주력으로 계속 쓰며,
				-- 이동은 (피드백) "데미지를 입었을 때"와 "주인이 주변에 없을 때"만 한다.
				-- 아이콘은 임시로 힐 스킬 아이콘 재사용 - 전용 아이콘이 생기면 교체 가능.
				-- (2026-08-04 스펙 개편) 마스터 30 spendable. 지속 60초 + 분배당 10초(마스터 350초),
				-- 재사용 대기 3분, 힐량 = 주인 최대HP의 5% + 3포인트당 1%p(마스터 15%),
				-- 힐러 HP = 주인 최대HP의 40% + 분배당 1%p(마스터 69%).
				{ ruid = "44b70137422f425eb486eb7cc5a92aec", name = "힐러 소환",           maxLevel = 30, spendable = true, level = 0, desc = "비숍 힐러를 소환한다.\n지속시간 1분, 분배 1포인트당 +10초\n(마스터 5분 50초).\n재사용 대기시간 3분.\n힐러 레벨은 내 레벨의 2/3이며,\n공격은 전혀 하지 않는다.\n힐 한 번에 내 최대 HP의 3%를 회복하고\n분배 5포인트당 +1%p(마스터 10%).\n힐러의 HP는 내 최대 HP의 40%이며\n분배 1포인트당 +1%p(마스터 69%).\n평소에는 제자리에 서서 힐만 쓰고,\n내가 멀어지거나 힐러가 몬스터에게 맞았을 때만\n텔레포트로 내 곁까지 이동한다." },
				-- 용 소환(3차, 2026-07-28 신설): 한 번 시전하면 서로 다른 용 6마리가 동시에 소환된다.
				-- 로직은 드래곤 라이딩과 비슷하지만 탑승은 불가. 각자 주인 주변 궤도를 날아다니며
				-- 5~7초마다 사거리 안의 적을 공격하고, 주인 최대 HP의 1/2짜리 HP를 가진다(힐로 회복 가능).
				-- 리소스는 몹 팩 6종(9300511 마뇽 / 9834307 심연의 마뇽 / 2600022 마뇽 /
				-- 2400575 레비아탄 / 9300516 레비아탄 / 8300002 플라잉 레드 와이번)의 클립을 그대로 쓴다.
				-- 아이콘은 임시로 드래곤 라이딩 아이콘 재사용 - 전용 아이콘이 생기면 교체 가능.
				-- (2026-08-04 스펙 개편) 마스터 30 spendable. 6마리 동시 소환 → **시전 즉시 랜덤 1마리 +
				-- 1분마다 1마리 추가**(전투가 한 번에 복잡해지지 않도록). 지속 1레벨 2분 → 마스터 10분,
				-- 만료 시 전부 소멸. 살아 있는 용 1마리당 공격력 +10. 데미지 150~200% + 분배당 15/20%p.
				{ ruid = "84190342335e44ad98519eb58753eea0", name = "용 소환",             maxLevel = 30, spendable = true, level = 0, desc = "용을 차례로 불러낸다.\n시전 즉시 6종 중 랜덤 1마리를 소환하고\n이후 1분마다 1마리씩 늘어난다(최대 6마리).\n지속시간 1레벨 2분 → 마스터 10분이며,\n지속시간이 끝나면 모두 사라진다.\n살아 있는 용 1마리당 공격력 +10.\n용의 공격은 전투력의 150%~200%에서\n분배 1포인트당 최소 +15%p / 최대 +20%p\n(마스터 585%~780%).\n각 용은 내 최대 HP의 절반만큼 체력을 가지며,\n힐 스킬로 회복시킬 수 있다.\n재사용 대기시간 10분.\n\n하이퍼 스킬 - 160레벨부터 쌓이는\nH 포인트로만 찍을 수 있다." },
				-- 매직 에로우 3종(3차 토글): 에로우 블로우 강화와 동일한 ON/OFF 토글 스킬. 켜면 1차 매직 미사일의
				-- 구체/이펙트 색이 속성색으로 바뀌고 데미지가 2배가 된다. 세 속성은 서로 배타적(하나를 켜면 나머지 OFF).
				-- 전용 아이콘 리소스가 없어 임시로 샤이닝 레이/아이스 스트라이크/파이어에로우 아이콘을 재사용한다(교체 가능).
				{ ruid = "49bd6b2c5d22446c9f8079a50bcc67c0", name = "매직 에로우(빛)",   level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 매직 미사일이 빛 속성이 되어\n구체와 이펙트가 노랑·하양으로 빛나고\n데미지가 2배가 된다.\n(얼음/불 속성과 동시에 켤 수 없다)\n(아이콘은 임시 - 교체 가능)" },
				{ ruid = "0638d6950da040f09dc0fb5bce4e6bed", name = "매직 에로우(얼음)", level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 매직 미사일이 얼음 속성이 되어\n구체와 이펙트가 파랗게 물들고\n데미지가 2배가 된다.\n(빛/불 속성과 동시에 켤 수 없다)\n(아이콘은 임시 - 교체 가능)" },
				{ ruid = "48f6c72aa48647e1b97b99afbc46ea17", name = "매직 에로우(불)",   level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 매직 미사일이 불 속성이 되어\n구체와 이펙트가 붉게 타오르고\n데미지가 2배가 된다.\n(빛/얼음 속성과 동시에 켤 수 없다)\n(아이콘은 임시 - 교체 가능)" },
				-- 플래시 점프(나이트로드·섀도어 3차, 2026-08-06 신설): 더블 점프와 **같은 구조**의 공중 도약이다
				-- (공중에 떠 있을 때 점프키를 한 번 더 → 바라보는 방향으로 포물선 도약). 다른 점은 두 가지 -
				--   · 마스터 10 spendable. 도약 힘이 분배 레벨로 커진다(GetFlashJumpForceUnit = 3,3,3,4,4,5,5,6,6,7).
				--     요청 사양대로 더블 점프의 도약 힘을 **5**로 놓은 상대 수치이고, unit/5 배율을 더블 점프의
				--     가로/세로 힘에 **함께** 곱해 "날아가는 힘과 거리"가 같이 강해진다.
				--   · (사용자 결정 2026-08-06) 재사용 대기시간 없음. 대신 더블 점프처럼 남발되지 않도록
				--     **한 번 뜬 동안 1회**만 쓸 수 있고, 발판에 착지해야 다시 찬다.
				-- 이펙트 5프레임은 사용자 제공 클래식 아트를 ori 정렬 패딩해 직접 업로드했고
				-- (msw-dev-tools/resources/플래시점프/RUID.md), 아이콘/사용음은 원본 팩
				-- skill/400.img/skill/4001014(플래시 점프)의 icon / _audio/Use를 그대로 쓴다.
				{ ruid = "5dea29ad262d4940b5ef47eacc280e90", name = "플래시 점프", maxLevel = 10, spendable = true, level = 0, desc = "공중에 떠 있을 때 점프키를 한 번 더\n누르면 바라보는 방향으로 도약한다.\n(방향키를 누르고 있으면 그쪽으로)\n\n재사용 대기시간은 없지만 한 번 뜬 동안\n한 번만 쓸 수 있고, 착지하면 다시 찬다.\n도약할 때마다 MP 20을 쓴다.\n\n도약하는 힘은 분배할수록 강해진다\n(더블 점프의 힘을 5로 볼 때\n1레벨 3 → 마스터 10에서 7).\n힘이 셀수록 더 높이, 더 멀리 날아간다." },
			},
			["4"] = {
				{ ruid = "8fce886b020349699cab77be0dafe5d7", name = "부메랑 스탭",         level = 1, desc = "회전하며 전방의 적을 베어낸다." },
				{ ruid = "97850763fe7241cda059cc1833df70d8", name = "어드밴스드 콤보", maxLevel = 30, spendable = true,     level = 0, desc = "콤보 어택의 확장판.\n1레벨 분배 시 최대 구슬이 6개가 되고\n(빨간 구슬), 5레벨마다 +1개씩\n최대 10개까지 늘어난다.\n분배마다 구슬 2개 동시 획득 확률 +1%\n(마스터 시 30%).\n\n1포인트라도 분배하면 콤보 어택의\n소모 MP가 100으로 늘어난다." },
				-- 어드밴스드 스피어 버스터(다크나이트 4차, 2026-08-05 스펙 개편): 마스터 30 spendable.
				-- (구 사양의 "보유 시 데미지 1.5배"는 폐지 - 이중 성장이라 레벨 스케일로 일원화했다.)
				--   · 데미지: 분배 1포인트당 스피어 버스터 줄당 최소 +5%p / 최대 +10%p (투자 레벨만으로 항상 적용)
				--   · 퀵슬롯에서 사용하면 **이펙트 아트만** ON/OFF 토글된다(데미지에는 영향 없음).
				--     OFF면 안 배운 것처럼 원래 스피어 버스터 이펙트로 나간다.
				-- 아이콘은 임시로 스피어 버스터 아이콘 재사용.
				{ ruid = "948d8f877f1349a38ab7111df06fd9b5", name = "어드밴스드 스피어 버스터", maxLevel = 30, spendable = true, level = 0, desc = "스피어 버스터를 강화한다.\n분배 1포인트당 스피어 버스터의\n한 줄당 데미지가 최소 +5%p /\n최대 +10%p 상승한다\n(마스터 30 = 최소 +150%p / 최대 +300%p).\n\n사용하면 강화 이펙트(검정·하양·빨강)를\n켜고 끌 수 있다. 꺼도 데미지 상승은\n그대로 유지되며, 이펙트만 원래\n스피어 버스터 이펙트로 돌아간다." },
				{ ruid = "185d0cd674bd44f388c8ccd265b59f43", name = "브랜디쉬", maxLevel = 30, spendable = true,           level = 0, desc = "검을 크게 휘둘러 전방의 적들을 벤다.\n첫 타 1회 + 연격 2타로 벤다.\n줄당 180%~240% 피해를 입히고\n분배마다 최소·최대 각 4%p 상승한다.\n1레벨 최대 4명 → 10레벨 6명 →\n20레벨 8명까지 동시 타격한다.\nMP 20 소모.\n파이널어택이 발동하면 연격 뒤에\n모션 없이 1줄이 추가로 들어간다." },
				-- 브랜디쉬2(임시명): 브랜디쉬 진행 절반~끝 사이에 브랜디쉬를 한 번 더 누르면 발동하는 콤보.
				-- 별도 키 없이 브랜디쉬 재입력으로만 나가며(UseSkillInSlot의 재입력 감지), 브랜디쉬 끝에 빠른 2줄을
				-- 추가로 넣는다. 아이콘은 임시로 브랜디쉬와 동일 RUID 사용.
				{ ruid = "185d0cd674bd44f388c8ccd265b59f43", name = "브랜디쉬2",          level = 1, desc = "브랜디쉬 진행 중(절반~끝)에 브랜디쉬를\n한 번 더 누르면 발동하는 콤보.\n브랜디쉬 끝에 빠른 2줄을 추가로 벤다." },
				-- 브랜디쉬 강화(4차 버프): 5분간 브랜디쉬 데미지 1.5배 + 공속 +1단계 + 이펙트/아이콘을 진한 빨강으로.
				-- 아이콘은 브랜디쉬 아이콘을 진한 빨강으로 재색상해 업로드(msw-dev-tools/resources/브랜디쉬강화).
				{ ruid = "3dd829f7a9ec45bb95e2cc3ed4a6aff3", name = "브랜디쉬 강화",      level = 1, desc = "5분간 브랜디쉬를 강화한다.\n브랜디쉬 데미지 1.5배, 공격속도 10% 상승,\n이펙트가 진한 빨강으로 바뀐다." },
				-- 돌진: 구버전 원본 아이콘/이펙트를 직접 구해와 업로드했다(MSW 라이브러리엔 현대 리메이크
				-- 아트만 있음). 원본/RUID 대응표: msw-dev-tools/resources/돌진/RUID.md
				{ ruid = "75c8dd4cdf774f4eaf64af0406fae864", name = "돌진", maxLevel = 20, spendable = true,               level = 0, desc = "앞으로 돌진하며 전방의 적을 최대 10명까지\n밀어낸다. 전투력의 90%~120% 피해를 입히고\n분배마다 최소·최대 각 3%p 상승한다.\n앞에 적이 없으면 제자리에서 시전된다.\n재사용 대기시간 1초." },
				{ ruid = "7ff10839eb5046eebb9cffc8f8828cfc", name = "생츄어리",           level = 1, desc = "성역을 소환해 범위 내 적에게 지속 피해를 입힌다." },
				{ ruid = "2ba15e204ac64214a8144b0b2deeaf79", name = "디바인 차지",         maxLevel = 20, spendable = true, level = 0, desc = "차지 블로우의 속성을 빛(성)으로 정한다.\n분배 1포인트당 빛 속성 차지 블로우의\n데미지가 3% 상승한다(마스터 +60%).\n속성을 바꾸면 직전까지 쓰던 속성은\n20초간 다시 사용할 수 없다." },
				-- 표창+ IV(나이트로드 4차, 2026-08-05 신설): 표창 8·9번을 연다(분배 1·10). 마스터 20.
				{ ruid = "a66f7a4983444b888f3a713b3eded36f", name = "표창+ IV",      level = 0, maxLevel = 20, spendable = true, desc = "표창술의 끝에 다다른다.\n포인트 1당 공격력이 1 오른다.\n분배 1·10에서 표창이 1종씩 열린다\n(8번·9번 표창 / 마스터 20)." },
				-- 쿼드러플 스로우(4차, 2026-07-30 신설): 트리플 스로우(3발)의 상위 - 표창을 4발 던진다.
				-- 데미지 숫자도 4줄, 쉐도우 파트너 중에는 8줄. 아이콘/시전 이펙트/타격 이펙트는
				-- 원본 팩 skill/1411.img/skill/14111005("쿼드러플 스로우 강화")의 icon / effect / hit/0.
				-- 사용음·타격음은 럭키세븐과 같다(요청). 가니어(아대) 장착이 필요하다.
				-- ⚠ 이 자리에는 원래 미구현 "트리플 스로우" 자리표시가 있었다 - 트리플 스로우는 3차로
				--   신설했으므로(이름이 겹치면 시전 분기가 깨진다) 여기를 쿼드러플 스로우로 교체했다.
				-- (2026-08-05 스펙 개편) 마스터 30 spendable.
				-- (요청 2026-08-14 6차) 줄당 **140%~150% + 분배 1포인트당 최소·최대 2%p**(마스터 30 = 198%~208%).
				-- ⚠ 종전엔 "1레벨 = 트리플 스로우 마스터의 표창 1개분"으로 트리플에서 **파생**시켰다.
				--   요청이 두 스킬의 기준값을 따로 지정했으므로 파생을 끊고 자체 곡선으로 바꿨다.
				{ ruid = "1a565ad1eb9c48fcafa50600db5e523a", name = "쿼드러플 스로우",     maxLevel = 30, spendable = true, level = 0, desc = "표창을 연달아 4개 던진다.\n표창 1개당 1레벨 140%~150%,\n분배 1포인트당 최소·최대가 2%p씩\n오른다(마스터 30에서 198%~208%).\n데미지가 4줄로 표시되고\n쉐도우 파트너 중에는 8줄이 된다.\n표창 4개 소모, MP 30 소모.\n가니어를 장착해야 사용할 수 있다." },
				-- 각성(나이트로드 4차, 2026-08-05 신설): 마스터 30 spendable / 재사용 대기시간 5분 고정.
				-- 연출은 다크사이트와 같다 - 화면이 어두워지고 전용 BGM이 깔린다(같은 dim/duck/BGM RUID 재사용).
				-- 효과 3종: ①공격속도 구간 상승(1~9분배 +5단계 / 10~19 +10단계 / 20~30 +15단계)
				--          ②럭키세븐·트리플 스로우·쿼드러플 스로우의 대상 탐색이 **드래곤 로어 범위**
				--            (가로 ±15.0 / 세로 ±7.5 전방위)로 넓어져 등 뒤·위아래의 적도 조준한다
				--          ③그 세 스킬의 표창이 전부 크리티컬로 들어간다(서버 RollStarThrowDamages).
				-- 아이콘은 원본 팩 skill/421.img/skill/4210015("어드밴스드 다크 사이트")의 icon.
				{ ruid = "c4d0b2dadd064a1c885896527b2e0f5f", name = "각성",               maxLevel = 30, spendable = true, level = 0, desc = "어둠의 힘을 끌어올려 각성한다.\n주변이 어두워지고 전용 선율이 흐른다.\n지속시간 10초, 분배 1포인트당 +1초\n(마스터 30에서 39초).\n\n공격 속도가 상승한다 -\n1~9분배 +50%, 10~19분배 +100%,\n20분배 이상 +150%.\n\n지속 중 럭키세븐 / 트리플 스로우 /\n쿼드러플 스로우가 드래곤 로어 범위 안의\n적을 방향에 관계없이 조준하며,\n표창이 전부 크리티컬로 들어간다.\n재사용 대기시간 5분(고정). MP 100 소모." },
				-- 제네시스(4차): 블리자드/메테오와 같은 규격의 빛 속성 버전. 리소스는 원본 팩
				-- skill/232.img/skill/2321008(기둥 tile/0~5·시전·사운드), 중간 추가 타격은
				-- skill/234.img/skill/2341001(엔젤레이 VI)의 공격모션 2종을 몬스터 측면에 소환해 쓴다.
				-- (비숍 개편 2026-08-08) 마스터 30 spendable. 1레벨 1000%~1300%에서 분배 1포인트당
				-- 최소·최대가 30%p씩(마스터 30에서 1870%~2170%), 쿨타임은 120초에서 1포인트당 1초씩
				-- 줄어든다(마스터 91초).
				-- ⚠ **키를 누르고 있으면 쿨타임 게이트를 통과할 때마다 자동으로 다시 나간다**(요청).
				--   평소에는 쿨타임이 길어 사실상 1회지만, 리커버리 오로라 안에서는 쿨타임이 통째로
				--   면제되므로 누르고 있는 동안 연사가 된다 - 이게 요청의 "연사하는 타임"이다.
				{ ruid = "187b564cb8dc429f9c35bffeeca875c5", name = "제네시스",           maxLevel = 30, spendable = true, level = 0, desc = "[MP 100 소모(재시전마다)]\n주변 발판 위에 빛 기둥 20개를 동시에\n내리꽂는다. 꽂힌 자리(반경 1.2)의 적을\n기둥당 최대 6명까지 때린다.\n전투력의 1000%~1300%에서 분배\n1포인트당 최소·최대가 30%p씩\n오른다(마스터 30에서 1870%~2170%).\n이후 15초 동안 범위 안 적의 곁에\n천사가 10번 나타나 공격한다.\n\n키를 누르고 있으면 대기시간이 끝날 때마다\n계속 다시 나간다(리커버리 오로라 안에서는\n대기시간이 없어 연사가 된다).\n재사용 대기시간 2분에서 분배\n1포인트당 1초씩 줄어든다(마스터 1분 31초)." },
				-- 홀리 매직쉘(4차 버프, 2026-07-29 신설): 자신과 HP를 가진 아군 소환수(용사/힐러/용 6마리)
			-- 전원에게 개체마다 각각 10회 방어 쉴드를 건다. 막을 때마다 그 개체에서 쉴드 이펙트 +
			-- "Guard" 표시 + 남은 개수가 뜬다. 아이콘은 임시로 시전 이펙트 클립 재사용 - 교체 가능.
			-- (비숍 개편 2026-08-08) 마스터 30 spendable. 쿨타임이 2분 → **1분**으로 내려가고
			-- 분배 1포인트당 1초씩 더 줄어든다(마스터 30에서 31초). 시전 모션도 stabO1로 교체.
			{ ruid = "c9af85359e644b568c8ba555f642e367", name = "홀리 매직쉘",       maxLevel = 30, spendable = true, level = 0, desc = "자신과 소환한 아군(용사·힐러·용) 전원에게\n보호막을 건다.\n각 대상은 몬스터의 공격을 10번까지\n완전히 막아낸다(개체마다 각각 10회).\n막을 때마다 남은 횟수가 머리 위에 표시된다.\n재사용 대기시간 1분에서 분배\n1포인트당 1초씩 줄어든다(마스터 31초).\nMP 100 소모." },
			-- 드래곤 블러드(4차 버프, 2026-07-28 신설): 사용자가 제공한 원본 20프레임 아트를 그대로 쓴다
			-- (RUID 표: msw-dev-tools/resources/드래곤블러드/RUID.md). 아이콘은 임시로 마지막 시전
			-- 프레임(17번)을 재사용 - 전용 아이콘이 생기면 교체 가능.
			-- (2026-08-05 스펙 개편) 마스터 30 spendable.
			--   · 지속시간 1레벨 3분 → 마스터 30에서 10분 (선형)
			--   · 공격력은 분배 1포인트당 +1 (마스터 30 = +30 - 구 사양의 고정 +30과 동일한 상한)
			--   · 소환 용 타격 시 회복량: 1~9레벨 최대HP 1% / 10~19레벨 2% / 20~30레벨 3%
			--   · 유지 비용(10초마다 최대HP 4%)과 HP 10% 이하 자동 해제는 레벨과 무관하게 동일
			{ ruid = "4bd903c41887458f9ccf1aa20aa46181", name = "드래곤 블러드",     maxLevel = 30, spendable = true, level = 0, desc = "용의 피를 끓인다.\n지속시간 3분, 분배 1포인트당 늘어나\n마스터 30에서 10분이 된다.\n공격력이 분배 1포인트당 1 상승한다\n(마스터 +30).\n10초마다 최대 HP의 4%를 소모하며,\nHP가 최대 HP의 10% 이하가 되면\n자동으로 해제된다.\n소환된 드래곤(용 소환·드래곤 라이딩)이\n공격할 때마다 최대 HP를 회복한다 -\n1~9레벨 1%, 10~19레벨 2%,\n20레벨 이상 3%.\n재사용 대기시간 없음." },
				-- 바하뮤트(4차 소환, 2026-07-29 신설): 프리져/피닉스와 달리 적에게 날아가지 않고
				-- 주인 곁(뒤 위)에 머물며 그 자리에서 브레스를 뿜어 최대 6마리를 동시에 때린다.
				-- 따라오는 방식은 임계감쇠 추종이라 주인이 갑자기 멀어져도 튀지 않는다.
				-- 아트는 구버전 클라 추출 클래식 바하뮤트 42프레임(라이브러리 것은 금갑옷 강화판이라 미사용).
				-- RUID 표: msw-dev-tools/resources/바하뮤트/RUID.md, 구현: Skills/BahamutSummon.mlua
				-- (비숍 개편 2026-08-08) 마스터 20 spendable. 지속시간이 10분 고정 → **1레벨 30초 +
				-- 분배 1포인트당 10초**(마스터 20에서 3분 40초)로 바뀌었고, 데미지는 500%~800%에서
				-- 1포인트당 최소·최대 30%p씩(마스터 1070%~1370%). 소환 중에는 버프바(우측 위)에
				-- 남은 지속시간이 뜬다.
				{ ruid = "4c9e769fed8f40a790ae6086785a822e", name = "바하뮤트",           maxLevel = 20, spendable = true, level = 0, desc = "용의 왕 바하뮤트를 소환한다.\n지속시간 30초, 분배 1포인트당 +10초\n(마스터 20에서 3분 40초).\n소환 중에는 우측 위에 남은 시간이 뜬다.\n주인 뒤 위를 지키며 자연스럽게 따라다니다가\n주변 6.5유닛 안에 적이 나타나면\n그 자리에서 브레스를 뿜는다.\n한 번에 최대 6마리를 동시에 때린다.\n데미지는 프리져와 완전히 같다 -\n대상당 전투력의 400%~420%에서 분배\n1포인트당 최소·최대가 5%p씩 오른다\n(마스터 20에서 495%~515%).\n재사용 대기시간 없음. MP 100 소모." },
					-- 리커버리 오로라(4차, 2026-07-29 신설): 사용자 제공 클래식 아트 20프레임을 동일 캔버스로
					-- origin 정렬 패딩해 직접 업로드했다(msw-dev-tools/resources/리커버리오로라/RUID.md).
					-- 발밑에 60초 오로라를 설치하고, 오로라 주변에서는 쿨타임 스킬을 대기시간 없이 바로
					-- 재사용할 수 있다(자기 자신의 쿨타임 3분만 예외). 장판 투명도 60%.
					-- (비숍 개편 2026-08-08) 마스터 30 spendable. 쿨타임 180초에서 분배 1포인트당 2초씩
					-- 줄어든다(마스터 30에서 122초). 지속시간(60초)과 범위는 그대로.
					{ ruid = "16d7498e26154b9393af469d1d82c7ca", name = "리커버리 오로라",   maxLevel = 30, spendable = true, level = 0, desc = "[MP 100 소모]\n발밑에 회복의 오로라를 설치한다.\n오로라는 1분간 유지되며, 그 주변에서는\n재사용 대기시간이 있는 스킬을\n대기시간 없이 바로 다시 쓸 수 있다.\n(리커버리 오로라 자신은 예외)\n재사용 대기시간 3분에서 분배\n1포인트당 2초씩 줄어든다(마스터 2분 2초)." },
				-- 엔젤레이(4차, 2026-07-29 신설): 아이언에로우와 같은 구조의 관통 투사체지만 8방향 조준 없이
				-- 전방으로만 발사하고, 관통 수는 10명이다. 아이콘/시전(effect0~14)/투사체(ball)/적중(hit0~6)
				-- 아트는 사용자 제공 클래식 원본을 직접 업로드했다(msw-dev-tools/resources/엔젤레이/RUID.md).
				-- (비숍 개편 2026-08-08) 마스터 30 spendable. 1레벨 700%~800%에서 분배 1포인트당
				-- 최소·최대가 30%p씩(마스터 30에서 1570%~1670%). 대신 후딜(시전 후 행동 제한)이
				-- 1초 늘어난다 - 강한 대신 무겁게 가라는 요청.
				{ ruid = "3f99493e69b64086b41945a3e5be08c2", name = "엔젤레이",           maxLevel = 30, spendable = true, level = 0, desc = "천사의 빛을 모아 전방으로 발사한다.\n빛줄기는 적을 최대 10명까지 관통한다.\n전투력의 700%~800%에서 분배\n1포인트당 최소·최대가 30%p씩\n오른다(마스터 30에서 1570%~1670%).\n\n한 방이 무거운 만큼 시전 후\n0.5초 동안 더 움직일 수 없다.\nMP 30 소모." },
				{ ruid = "b5178c975a694ec3a51106a448fd70dd", name = "빅뱅",               level = 1, desc = "강력한 폭발로 넓은 범위에 피해를 입힌다." },
				-- 체인 라이트닝(4차): 원본 팩 skill/222.img/skill/2221006의 기모으기/전격 조각/명중/사운드를
				-- 그대로 쓴다. swingO3 1프레임에서 0.5초 기를 모은 뒤 3프레임에 발사(요청 사양).
				-- (썬콜 개편 2026-08-08) 암살과 마스터 레벨(30)·분배 가능 레벨(120)·데미지 증가량
			-- (분배 1포인트당 최소 +10%p / 최대 +20%p)이 같다. 기본 500%~700%는 그대로.
			{ ruid = "f84bad609f3a47c29ed662abea683f2e", name = "체인라이트닝",       maxLevel = 30, spendable = true, level = 0, desc = "0.5초 기를 모은 뒤 전방의 가장 가까운\n적에게 전격을 날린다. 전격은 가까운 적으로\n최대 10명까지 연쇄되며 대상당 전투력의\n500%~700%에서 분배 1포인트당\n최소 +10%p / 최대 +20%p씩 오른다\n(마스터 30에서 790%~1280%).\n얼어붙은 적을 맞히면 2초간 기절시킨다.\n(블리자드 50%·빙하지대 30%·차지 블로우\n스티그마 등으로 적이 얼어붙는다)\nMP 50 소모." },
				-- (썬콜 개편 2026-08-08) 제네시스와 마스터 레벨(30)·분배 가능 레벨(120)·데미지 증가량
			-- (분배 1포인트당 최소·최대 각 +30%p)이 같다. 기본 3500%~5000%와 쿨타임 20초는 그대로.
			{ ruid = "7aa2a3683ff84a3ca809542b835ef68d", name = "블리자드",           maxLevel = 30, spendable = true, level = 0, desc = "주변 발판 위에 얼음 폭풍을 흩뿌린 뒤\n시전자 주위의 적을 때린다.\n데미지는 제네시스와 같다 -\n전투력의 1000%~1300%에서 분배\n1포인트당 최소·최대가 30%p씩 오른다\n(마스터 30에서 1870%~2170%).\n얼음 폭풍은 주변의 적을 먼저 노려 떨어진다.\n재사용 대기시간 2분에서 분배\n1포인트당 1초씩 줄어든다(마스터 1분 31초).\nMP 100 소모." },
				-- 암살(4차, 2026-07-30 신설): 체인 라이트닝과 같은 데미지 구조(대상당 500%~700%)로 최대
				-- 10명까지 옮겨붙는다. 시전 즉시 캐릭터가 사라지고 대상마다 랜덤한 방향에서 베어 들어간 뒤
				-- 마지막에 원래 자리에서 다시 나타난다.
				-- (2026-08-06) 아이콘: 임시로 쓰던 시전 이펙트 클립 썸네일이 화면에 안 나온다는 신고 -
				-- 원본 팩 skill/422.img/skill/4221016("암살")의 **icon 스프라이트**로 교체했다.
				-- (2026-08-06 스펙 개편) 마스터 30 spendable.
				-- (요청 2026-08-14 4차) 쿼드러플 스로우 총합의 1/2 파생을 끊고 **체인 라이트닝과 완전히 같은
				-- 데미지·MP**가 됐다(GetAssassinateMin·MaxPercent → GetChainLightning*Percent 위임, MP 50).
				{ ruid = "49603ec663a64f0fa8d3d9ae0b04e753", name = "암살",             maxLevel = 30, spendable = true, level = 0, desc = "몸을 감추고 적들 사이를 옮겨 다니며\n베어낸다. 가까운 적으로 최대 10명까지\n이어진다.\n대상당 데미지와 소모 MP가\n체인 라이트닝과 완전히 같다.\n1레벨 500%~700%, 분배 1포인트당\n최소 +10%p / 최대 +20%p\n(마스터 30에서 790%~1280%).\nMP 50 소모.\n마지막 대상을 베면 원래 자리에\n다시 나타난다." },
				-- 연막(4차, 2026-07-30 신설): 원본 팩 skill/422.img/skill/4221006("연막탄")의
				-- icon / special(연기 생성·소멸) / tile/0/8~16(바닥에 깔리는 연기) / _audio/Use를 쓴다.
				-- (2026-08-06 스펙 개편) **마스터 40** spendable(이 프로젝트 유일). 재사용 대기시간 3분 고정,
				-- 지속 1레벨 20초 + 분배 1포인트당 1초(마스터 40 = 59초 / GetSmokeScreenDuration).
				-- (요청 2026-08-14 4차) MP 100 소모 신설(GetSmokeScreenMpCost).
				-- 쿨타임은 퀵슬롯 오버레이(SmokeScreenCooldownUI), 남은 지속은 우측 상단 버프바
				-- (SmokeScreenBuffUI)에 표시된다 - 둘 다 이번 개편에서 신설했다(기존에는 표시가 없었다).
				{ ruid = "b944ae2274a04a1b96df2875368a8105", name = "연막",             maxLevel = 40, spendable = true, level = 0, desc = "연막탄을 터뜨려 맵 전체를\n뿌옇게 만든다.\n지속시간 20초, 분배 1포인트당 +1초\n(마스터 40에서 59초).\n연막 안에서는 받는 피해가 모두\nMISS가 되고, 내가 하는 공격은 전부\n백스탭으로 취급된다.\n재사용 대기시간 3분. MP 100 소모." },
				-- 분신 강화 III(섀도어 4차, 2026-08-06 신설): 강화 3종의 마지막. 셋을 모두 마스터하면
				-- 지속 5분 / 분신 데미지 본체의 90%가 되고, 분신이 **4차 공격 스킬까지** 쓴다.
				{ ruid = "c6ce60523c954791af5632da796cca7c", name = "분신 강화 III",      maxLevel = 20, spendable = true, level = 0, desc = "[패시브 - 퀵슬롯 배정 불가]\n[분신 소환의 강화]\n분신이 더 오래 남고 강해진다.\n지속시간이 분배 1포인트당 늘어난다\n(강화 3종을 모두 마스터하면 5분).\n분신의 데미지가 분배 2포인트마다\n본체의 +1%p씩 오른다\n(1차까지 모두 마스터하면 90%).\n분신이 4차 공격 스킬까지 쓴다." },
				-- 이프리트(4차 소환, 2026-07-30 구현): 엘퀴네스와 같은 개념 - 주인 곁을 지키며 그 자리에서
				-- 화염으로 최대 6마리를 동시에 때린다. 리소스는 사용자 지정 라이브러리 몹 팩
				-- mob/8610015.img("이프리트")의 stand/move/attack1/die1 클립과 타격 이펙트·사운드를
				-- 그대로 쓴다(별도 업로드 없음). 구현: Skills/IfritSummon.mlua
				-- (썬콜 개편 2026-08-08) 바하뮤트와 마스터 레벨(20)·분배 가능 레벨(120)·데미지 증가량
			-- (분배 1포인트당 최소·최대 각 +30%p)이 같다. 기본 200%~300%와 지속 10분은 그대로.
			{ ruid = "80add5d3f2364d01b7c5c973c884324e", name = "이프리트",           maxLevel = 20, spendable = true, level = 0, desc = "화염의 정령 이프리트를 소환한다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초 - 프리져와 동일).\n주인 뒤 위를 지키며 자연스럽게 따라다니다가\n주변 6.5유닛 안에 적이 나타나면\n그 자리에서 화염을 내뿜는다.\n한 번에 최대 6마리를 동시에 때리며\n데미지는 프리져와 같다 - 대상당 전투력의\n400%~420%에서 분배 1포인트당\n최소·최대가 5%p씩 오른다\n(마스터 20에서 495%~515%).\n재사용 대기시간 30초. MP 100 소모." },
				{ ruid = "e6144550c6084709bba1de715d677879", name = "아이스 데몬",         level = 1, desc = "얼음 악마를 소환해 적을 얼린다." },
				-- 메테오(4차): 블리자드/제네시스와 같은 규격의 화염 버전. 리소스는 원본 팩
				-- skill/1211.img/skill/12111003의 tile/0~8(운석) / effect(시전) / _audio/Use·Hit를 그대로 쓴다.
				-- (불독 개편 2026-08-08) 마스터 30 spendable + 블리자드/제네시스와 **같은 규격으로 통일**:
				--   · 초기 운석 15 → **20개**, 범위 좌우 10.4 → 12.5 / 상하 3.9 → 4.7
				--   · 자리 선정이 랜덤 발판 → **적 우선**(CollectAoeTileSpots - 블리자드/제네시스 공용)
				--   · 쿨타임 20초 고정 → **120초 - 분배 1포인트당 1초**(GetMeteorCooldown = 제네시스 위임)
				--   · 데미지 700%~1000%에서 분배 1포인트당 최소·최대 각 +30%p(형제들과 같은 증가량)
				{ ruid = "9f317ee0b97d44dba5f85fb352aee093", name = "메테오",             maxLevel = 30, spendable = true, level = 0, desc = "주변 발판 위에 운석 20개를 떨어뜨린다.\n운석은 주변의 적을 먼저 노려 떨어지고\n전부 동시에 착지하며, 닿은 자리\n(반경 1.2)의 적을 운석당 최대 6명까지\n데미지는 제네시스와 같다 -\n전투력의 1000%~1300%로 때리고\n분배 1포인트당 최소·최대가 30%p씩\n오른다(마스터 30에서 1870%~2170%).\n이후 15초 동안 범위 안 적의 위치에\n운석 10개가 추가로 떨어진다.\n재사용 대기시간 2분에서 분배\n1포인트당 1초씩 줄어든다(마스터 1분 31초).\nMP 100 소모(재시전마다)." },
				-- 엘퀴네스(4차 소환, 2026-07-30 구현): 바하뮤트와 같은 원리 - 적에게 날아가지 않고 주인 곁을
				-- 지키며 그 자리에서 얼음 브레스로 최대 6마리를 동시에 때린다. 아트는 사용자 제공 클래식
				-- 원본을 패딩 정렬해 직접 업로드했다(라이브러리 팩은 "강화판"이라 생김새가 다름).
				-- RUID 표: msw-dev-tools/resources/엘퀴네스/RUID.md, 구현: Skills/ElquinesSummon.mlua
				-- (불독 개편 2026-08-08) 마스터 20 spendable. 데미지와 스킬 레벨이 **이프리트와 완전히 같다** -
				-- 수치를 따로 두지 않고 GetElquinesMin/MaxPercent가 이프리트 헬퍼를 그대로 호출한다
				-- (한쪽만 고치면 갈라지는 것 방지 - 홀리 에로우/썬더볼트와 같은 관례).
				{ ruid = "13d9054e49b640f08abc2820f5ca8215", name = "엘퀴네스",           maxLevel = 20, spendable = true, level = 0, desc = "얼음의 정령 엘퀴네스를 소환한다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 20에서 3분 30초 - 프리져와 동일).\n주인 뒤 위를 지키며 자연스럽게 따라다니다가\n주변 6.5유닛 안에 적이 나타나면\n그 자리에서 얼음 브레스를 뿜는다.\n한 번에 최대 6마리를 동시에 때리며\n데미지는 프리져(=이프리트)와 같다 -\n대상당 전투력의 400%~420%에서 분배\n1포인트당 최소·최대가 5%p씩 오른다\n(마스터 20에서 495%~515%).\n재사용 대기시간 30초. MP 100 소모." },
				-- 리커버리 마나(불독 4차, 2026-08-08 신설): 리커버리 오로라의 불독판 - 같은 60초 오로라
				-- (범위 안 노쿨)를 설치하고, 설치하는 순간 자신의 MP를 가득 채운다(MpManager.FillMp).
				-- 서버/시전 파이프라인·쿨타임 상태·쿨타임 UI를 리커버리 오로라와 **공유**한다(시전 분기에서
				-- 이름만 갈라진다). 아이콘은 임시로 리커버리 오로라와 같은 RUID(전용 아이콘이 생기면 교체).
				{ ruid = "16d7498e26154b9393af469d1d82c7ca", name = "리커버리 마나",     maxLevel = 30, spendable = true, level = 0, desc = "발밑에 회복의 오로라를 설치하며\n자신의 MP를 가득 채운다.\n오로라는 1분간 유지되며, 그 주변에서는\n재사용 대기시간이 있는 스킬을\n대기시간 없이 바로 다시 쓸 수 있다.\n(리커버리 마나 자신은 예외)\n재사용 대기시간 3분에서 분배\n1포인트당 2초씩 줄어든다(마스터 2분 2초)." },
				{ ruid = "8d9d46dcaa164c46a0b1da47db016c43", name = "피어싱",             level = 1, desc = "화살이 적을 관통하며 피해를 입힌다." },
				-- 스나이핑(4차 차지): 게이지/차지·화살·슈팅 이펙트는 원본 팩
				-- skill/3241000·3221025·3241001 + ui/basic/keydownbar5의 RUID를 그대로 쓴다.
				{ ruid = "804c52c890234d69a6a937d7523bb9f8", name = "스나이핑",           maxLevel = 30, spendable = true, level = 0, desc = "키를 누르고 있으면 게이지가 차오르고\n(완충 10초), 떼면 관통 화살 한 발로\n최대 3명을 공격한다.\n기본 데미지는 전투력의 10%~15%에서\n분배 1포인트당 최소·최대가 5%p씩\n오른다(마스터 30에서 155%~160%).\n\n여기에 모은 게이지가 배율로 곱해진다 -\n10%면 10배, 100%(완충)면 100배.\n관통 수가 적어 HP가 높은 적에게 유용하다.\n차지 중 이동속도가 50% 줄어든다.\nMP 50 소모(차지를 시작할 때)." },
				-- 샤프 아이즈(4차 버프, 2026-08-06 신설): 아이콘/이펙트는 원본 팩 skill/15003.img/skill/150038002
				-- ("쓸만한 샤프 아이즈")의 icon 스프라이트 / affected 클립을 그대로 쓴다
				-- (별도 업로드 없이 MSW 라이브러리에 존재 - msw-dev-tools/msw-library-index/스킬요소_목록.tsv).
				{ ruid = "7a580dfd67ed4a679314449c722c2399", name = "샤프 아이즈",         maxLevel = 30, spendable = true, level = 0, desc = "매의 눈으로 적의 급소를 꿰뚫어 본다.\n지속시간 30초, 분배 1포인트당 +10초\n(마스터 30에서 5분 20초).\n\n지속 중 크리티컬 확률이 분배\n2포인트당 1%씩 오르고(마스터 +15%),\n크리티컬 데미지는 전 구간 공통으로\n8% 오른다." },
				-- 프리져(4차 소환): 소환수 클립/히트 이펙트/사운드는 몬스터판 원본 팩 mob/9830009.img,
				-- 아이콘은 skill/321.img/skill/3211005. 구현은 Skills/FreezerSummon.mlua.
				{ ruid = "2f7d59f5d91c41a18713732ab2003b04", name = "프리져",             maxLevel = 20, spendable = true, level = 0, desc = "얼음 새 프리져를 소환한다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 20에서 210초).\n평소엔 뒤 위에서 따라다니다가 주변 7유닛 안에\n적이 나타나면 날아가서 공격한다.\n꽂히는 지점 주변의 적 최대 6명이\n동시에 맞는 범위 공격이다.\n전투력의 400%~420%에서 분배 1포인트당\n최소·최대가 5%p씩 오른다\n(마스터 20에서 495%~515%).\n맞은 적은 80% 확률로 2초간 얼어붙는다.\n재사용 대기시간 없음. MP 100 소모." },
				-- 폭풍의 시(4차): 키를 누르고 있는 동안 0.2초마다 화살이 계속 나가는 홀드 연사 스킬.
				-- 아이콘/시전(prepare)/루프(keydown)/화살(ball)/적중(hit0)/사용음 전부 원본 팩
				-- skill/1311.img/skill/13111002의 RUID를 그대로 쓴다.
				-- (보우마스터 개편 2026-08-07) spendable 편입. 1레벨 200%~250%에서 분배 1포인트당 최소·최대가 5%p씩.
				{ ruid = "32fef5885e544e4bad99eeea14eb6e4d", name = "폭풍의 시",           maxLevel = 30, spendable = true, level = 0, desc = "키를 누르고 있는 동안 0.1초마다\n화살을 한 발씩 계속 발사한다.\n한 발당 전투력의 200%~250%에서\n분배 1포인트당 최소·최대가 5%p씩\n오른다(마스터 30에서 345%~395%).\n화살 한 발마다 MP 10을 소모하며,\nMP가 떨어지면 연사가 멈춘다.\n연사 중에도 이동속도 60%로\n걸어다니며 쏠 수 있다." },
				-- 피닉스(4차 소환): 프리져와 동일 구조, 리소스는 몬스터판 원본 팩 mob/9300089.img +
				-- 스턴 이펙트는 skill/311.img/skill/3111005의 hit/0. 구현은 Skills/PhoenixSummon.mlua.
				-- (보우마스터 개편 2026-08-07) spendable 편입. 마스터 레벨(20)과 **분배당 상승폭**(최소 +30%p /
				-- 최대 +40%p)은 프리져와 같고, 기준값만 피닉스 고유의 200%~300%다(마스터 20에서 770%~1060%).
				{ ruid = "fd051469cf104e0bb1597e6930619354", name = "피닉스",             maxLevel = 20, spendable = true, level = 0, desc = "불사조 피닉스를 소환한다.\n지속시간 20초, 분배 1포인트당 +10초\n(마스터 20에서 210초).\n평소엔 뒤 위에서 따라다니다가 주변 7유닛 안에\n적이 나타나면 날아가서 공격한다.\n꽂히는 지점 주변의 적 최대 6명이\n동시에 맞는 범위 공격이다.\n공격 피해는 전투력의 400%~420%에서\n분배 1포인트당 최소·최대가 5%p씩\n오른다(마스터 20에서 495%~515%).\n(데미지·지속시간·MP가 프리져와 같다)\n맞은 적은 2초간 기절해 움직이지 못한다.\n재사용 대기시간 없음. MP 100 소모." },
				-- 리저렉션(4차): 죽어 쓰러져 있는 소환 용사를 그 자리에서 HP 가득 찬 상태로 부활시킨다.
				-- 아이콘/시전·부활 이펙트/사용음 전부 원본 팩 skill/232.img/skill/2321006의 RUID.
				-- (비숍 개편 2026-08-08) 마스터 20 spendable + **재사용 대기시간 2분 신설**(구 사양은
				-- 연타 오발동만 막는 0.5초 게이트뿐이었다). 분배 1포인트당 2초씩 줄어든다(마스터 82초).
				-- 퀵슬롯 표시는 ResurrectionCooldownUI.
				{ ruid = "eedb96e2ddbd4ebe9a7fc6e67135ab0f", name = "리저렉션",           maxLevel = 20, spendable = true, level = 0, desc = "죽어 쓰러져 있는 소환 용사를\n그 자리에서 HP가 가득 찬 상태로\n부활시킨다.\n되살아난 소환수의 지속시간은\n처음 소환했을 때 값으로 되돌아간다.\n재사용 대기시간 2분에서 분배\n1포인트당 2초씩 줄어든다(마스터 1분 22초).\nMP 30 소모." },
			},
			["5"] = {},
			["6"] = {},
			["7"] = {},
		}

		-- 부스터 아이콘 최초 갱신(월드 시작 시점 - 아직 로그인 전이라 jobIdx는 기본값 1일 수 있음).
		-- 실제 캐릭터가 확정되는 시점(CharacterSlotButton:EnterLobby)에서 다시 한번 갱신된다.
		self:RefreshBoosterIcon()

		-- SkillBar 아이콘 전부 투명화
		self:InitBarIcons()

		-- 툴팁 기본 초기화
		local tipIcon = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Icon")
		if isvalid(tipIcon) then
			tipIcon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		end
		local tipTitle = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Title")
		if isvalid(tipTitle) then tipTitle.TextComponent.Text = "" end
		local tipInfo = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Info")
		if isvalid(tipInfo) then tipInfo.TextComponent.Text = "" end

		-- 키 이벤트
		_InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		_InputService:ConnectEvent(KeyUpEvent, self.OnKeyUp)

		-- 마우스 휠 (스킬창 위에서만 동작)
		_InputService:ConnectEvent(MouseScrollEvent, self.OnSkillMouseScroll)

		-- 닫기 버튼
		local closeBtn = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/CloseSkill")
		if isvalid(closeBtn) then
			closeBtn:ConnectEvent(UITouchDownEvent, self.OnCloseClick)
		end

		-- 타이틀바 드래그
		local titleBar = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/TitleBar")
		if isvalid(titleBar) then
			titleBar:ConnectEvent(UITouchDownEvent, self.OnTitleBarDown)
		end

		-- 탭/스킬행 클릭: UITouchDownEvent가 미작동하여 ScreenTouchEvent로 대체
		_InputService:ConnectEvent(ScreenTouchEvent, self.OnSkillWindowTouch)
		-- "+"(포인트 분배)는 **누름 1회당 정확히 1포인트**여야 한다.
		-- ⚠ 실측: 시뮬 클릭 3번에 레벨이 10 올랐다. ScreenTouchEvent가 한 번 누르는 동안 여러 번
		--   들어오기 때문이다(카드 선택처럼 여러 번 실행돼도 무해한 핸들러라 여태 드러나지 않았다).
		--   시간 디바운스는 연타를 막으므로, 뗄 때까지 잠그는 엣지 방식으로 처리한다.
		_InputService:ConnectEvent(ScreenTouchReleaseEvent, self.OnSkillWindowTouchRelease)

		-- 스킬 카드 호버 (2열×5행 = 10칸, UITouchEnterEvent/ExitEvent는 별도)
		for i = 1, 10 do
			local rowTouch = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillCard" .. i .. "/Touch")
			local capturedRow = i
			if isvalid(rowTouch) then
				rowTouch:ConnectEvent(UITouchEnterEvent, function(e)
					if not _UIClickArbiter:IsTopmostAt("/ui/DefaultGroup/SkillWindow", e.TouchPoint) then return end
					self:OnSkillRowHoverEnter(capturedRow)
				end)
				rowTouch:ConnectEvent(UITouchExitEvent, function(e)
					self:OnSkillRowHoverExit(capturedRow)
				end)
			end
		end

		-- 스크롤 썸 드래그
		local thumbTouch = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollThumbTouch")
		if isvalid(thumbTouch) then
			thumbTouch:ConnectEvent(UITouchDownEvent, self.OnSkillThumbDown)
		end

		-- 스크롤 트랙 홀드
		local trackTouch = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollTrackTouch")
		if isvalid(trackTouch) then
			trackTouch:ConnectEvent(UITouchDownEvent, self.OnSkillTrackDown)
		end

		-- SkillBar 슬롯 클릭/드래그 (slotPos = 고정 위치 접미사, 실제 키는 barKeys로 조회)
		for _, k in ipairs(allKeys) do
			local slotTouch = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar/Slot_" .. k .. "/Touch")
			local slotPos = k
			if isvalid(slotTouch) then
				slotTouch:ConnectEvent(UITouchDownEvent, function(e)
					if not _UIClickArbiter:IsTopmostAt("/ui/DefaultGroup/SkillBar", e.TouchPoint) then return end
					if e.TouchId == -1 then
						if _KeySettingManager:IsCarryingFunc() then
							-- 기능을 집은 상태로 퀵슬롯 클릭 → 그 슬롯에 놓는다 (자리에 있던 스킬/기능은 집힌다)
							_KeySettingManager:DropFuncOnBarKey(self:GetKeyForBarPos(slotPos))
						elseif _KeySettingManager:IsRemapMode() then
							-- 퀵슬롯 리매핑 모드: 이 슬롯에 연결할 키 입력을 대기시킨다
							_KeySettingManager:OnBarSlotPicked(slotPos)
						elseif self._T.skillClickMode then
							-- 클릭 배정 모드: 집은 스킬을 이 슬롯에 놓는다 (자리에 스킬이 있으면 스왑해 집는다)
							self:OnBarSlotAssign(slotPos)
						else
							-- 슬롯 키에 기능(창 단축키)이 올려져 있으면 기능을 집는다 (스킬과 동일한 이동 UX)
							-- 단, 같은 클릭의 화면 터치 핸들러가 방금 여기에 놓은 기능이면 다시 집지 않는다
							local barKey = self:GetKeyForBarPos(slotPos)
							local fid = _KeySettingManager:GetFuncOnKey(barKey)
							if fid ~= "" then
								if not _KeySettingManager:JustDroppedFunc() then
									_KeySettingManager:PickUpFunc(fid, barKey)
								end
							else
								self:OnBarSlotPickUp(slotPos)
							end
						end
					end
				end)
			end
		end

		-- 초기 UI 상태 반영
		self:UpdateSkillTabVisuals()
		self:UpdateSkillViewport()

		log("[SkillManager] ready")
	end

	-- 부스터 아이콘: 직업(jobIdx, UIMyInfoManager:GetJobStageNames 순서와 동일)마다 다른 아이콘을 쓴다.
	-- 검사 계열(1,2)/다크나이트(3)/마법사 계열(4,5,6)/신궁(7)/보우마스터(8)/나이트로드(9)/섀도어(10).
	@ExecSpace("ClientOnly")
	method string GetBoosterIconForJob(number jobIdx)
		if jobIdx == 1 or jobIdx == 2 then
			return "03b1da381bf046c68488fae4690e4f6f" -- 히어로, 팔라딘
		elseif jobIdx == 3 then
			return "0f444ef9b22944668a3bab6657e65e3b" -- 다크나이트
		elseif jobIdx == 4 or jobIdx == 5 or jobIdx == 6 then
			return "834961020d134b2bbaecd972693733fa" -- 비숍, 아크메이지(썬,콜)/(불,독)
		elseif jobIdx == 7 then
			return "8930c94be5f34ba09ed5f0ef80229415" -- 신궁
		elseif jobIdx == 8 then
			return "360acfc5aab24a019e1b32a514bb305f" -- 보우마스터
		elseif jobIdx == 9 then
			return "649da9106aaf40dfae9994d80ccba844" -- 나이트로드
		elseif jobIdx == 10 then
			return "d62e015f212a495c8009ff93fcd6b334" -- 섀도어
		end
		return "03b1da381bf046c68488fae4690e4f6f" -- 알 수 없는 jobIdx 기본값(히어로)
	end

	-- skillData(all/2 탭)의 "부스터" 항목 ruid를 현재 캐릭터의 jobIdx에 맞는 아이콘으로 덮어쓴다.
	-- 최초 호출(OnBeginPlay)은 로그인 전이라 jobIdx가 기본값(1)일 수 있으므로, 실제 캐릭터가 확정되는
	-- CharacterSlotButton:EnterLobby에서도 다시 호출해 정확한 아이콘으로 갱신한다.
	@ExecSpace("ClientOnly")
	method void RefreshBoosterIcon()
		local boosterIcon = self:GetBoosterIconForJob(_UIMyInfoManager:GetSelectedCharacterJobIdx())
		for _, tab in pairs(self._T.skillData) do
			for _, s in ipairs(tab) do
				if s.name == "부스터" then s.ruid = boosterIcon end
			end
		end
		-- 이미 렌더링되어 있던 스킬창 행이 있다면(예: 로그인 화면 뒤에서 미리 그려진 경우) 곧바로
		-- 다시 그려서, 아이콘이 잠깐 다른 스킬의 아이콘으로 보였다가 바뀌는 현상을 없앤다.
		self:UpdateSkillViewport()
		-- 캐릭터 확정 시점(EnterLobby)에 직업이 정해지므로 책 제목(전직명)도 함께 갱신한다.
		self:UpdateSkillBookTitle()
	end

	-- ── 직업별 스킬 목록 ──────────────────────────────────────────────
	-- 스킬창은 "카탈로그(skillData) 전부"가 아니라 **현재 캐릭터 직업이 배우는 스킬만** 보여준다.
	-- 목록은 이름으로 카탈로그를 찾아 **같은 테이블 참조**를 그대로 담으므로, 카드에서 올린 레벨
	-- (표창+ / 백스탭 같은 spendable 스킬)이 카탈로그와 계속 공유된다.
	--
	-- 규칙
	--   · 기본(●, 탭 "0") = 달팽이 세마리 - 전 직업 공통이라 거르지 않는다.
	--   · I~IV(탭 "1"~"4") = 아래 표의 직업/차수 목록 순서대로.
	--   · VI(탭 "7") = **테스트용으로 모든 스킬**(카탈로그 전체)을 그대로 보여준다.
	--   · H/V(탭 "5"/"6") = 아직 비어 있다.
	-- ⚠ 이름은 skillData의 name과 정확히 일치해야 한다(띄어쓰기 포함). 못 찾으면 로그로 알려준다.
	-- ⚠ 카탈로그에 저장된 차수 탭과 직업 목록의 차수가 달라도 된다(예: "궁병 지원"은 카탈로그상
	--    3차 탭에 있지만 팔라딘에게는 4차로 보인다) - 이름으로 찾아오기 때문.
	@ExecSpace("ClientOnly")
	method table GetJobSkillNames(number jobIdx)
		-- 직업 인덱스는 CharacterSettingComponent:GetJobItems() / UIMyInfoManager:GetJobStageNames()와 같은 순서.
		local jobs = {
			-- 1 히어로 ("대시"는 이 프로젝트에서 "러시"(질주)라는 이름으로 구현돼 있다)
			[1] = {
				["1"] = {"파워스트라이크", "러시", "슬래시블러스트"},
				-- (요청 2026-08-09) "섬광"을 히어로 2차 → **섀도어 2차**로 이관. 전사가 유일한 무기인 검을
				-- 던져버리는 개연성 문제가 있었고, 던지는 물건이 단검이면 소모품처럼 자연스러운 데다
				-- 이동속도가 빠른 도적 컨셉·사냥 능력이 낮은 섀도어 보완과도 맞물린다.
				["2"] = {"파이널어택", "부스터", "분노", "파워가드"},
				["3"] = {"콤보 어택", "패닉", "코마", "발도술"},
				["4"] = {"어드밴스드 콤보", "브랜디쉬", "돌진"},
			},
			-- 2 팔라딘
			[2] = {
				-- (요청 2026-08-09) 1차의 "가드"를 **팔라딘 2차**로 내리고, 그 자리에 히어로와 같은 "러시"를
				-- 넣었다(러시 = 히어로·팔라딘 1차 공용). 러시는 reqLevel 15로 이미 1차 대역이라 CSV 변경 없음.
				-- ⚠ 가드는 히어로에게 주지 않는다(요청) - 팔라딘 2차 전용이다.
				["1"] = {"파워스트라이크", "러시", "슬래시블러스트"},
				["2"] = {"파이널어택", "리스토네이션", "부스터", "파워가드", "가드", "아이언 월"},
				-- (요청 2026-08-12 2차) "디바인 차지"를 4차 → **3차**로 내렸다(CSV reqLevel 130 → 95).
				-- 데미지 상승률도 나머지 속성 변경 3종과 같은 +2%/pt로 통일(종전 4차 전용 +3%/pt).
				-- (요청 2026-08-12 3차) 반대로 "속성 증폭"은 3차 → **4차**로 올렸다(CSV reqLevel 95 → 130 -
				-- 디바인 차지가 비운 자리). 효과(연계 장판 데미지 +10%/pt)는 그대로다.
				["3"] = {"차지 블로우", "디바인 스윙 강화", "디바인 스티그마 강화", "디바인 저지먼트 강화", "디바인 차지", "속성필드"},
				["4"] = {"돌진", "궁병 지원", "속성 증폭"},
			},
			-- 3 다크나이트
			[3] = {
				["1"] = {"파워스트라이크", "슬래시블러스트"},
				["2"] = {"파이널어택", "부스터", "서먼 다크드래곤", "파워가드"},
				["3"] = {"스피어 버스터", "드래곤 로어", "드래곤 라이딩", "힐러 소환"},
				["4"] = {"어드밴스드 스피어 버스터", "돌진", "드래곤 블러드"},
				-- (요청 2026-08-12 5차) "용 소환"을 3차 → **하이퍼(H) 탭**으로 옮겼다(CSV reqLevel 80 → 160).
				-- H 포인트는 160~199 구간에서만 적립된다(GetTierBudget의 tier 5).
				["5"] = {"용 소환"},
			},
			-- 4 비숍
			-- (비숍 개편 2026-08-08) 소환 계열을 차수별 3단계로 갈랐다. 셋 다 HeroSummon과 같은 규격이고
			-- 다른 점은 "어떤 직업 풀에서 뽑아 어떤 자동사냥 스타일로 싸우는가"뿐이다.
			-- (요청 2026-08-08 재조정) 배치가 한 번 바뀌었다 - **2차 도적 / 3차 용사 / 4차 궁수**
			--   (처음엔 2차 용사 / 3차 궁수 / 4차 도적이었다).
			-- ⚠ 차수는 CSV reqLevel 한 곳에서 **전역**으로 결정된다(GetSkillTier). 그래서 "용사 소환"이
			--   3차로 돌아오면서 같은 스킬을 가진 신궁·보우마스터·아크메이지(썬콜)의 표시 트리도
			--   ["2"] → ["3"]으로 함께 되돌렸다. 한쪽만 옮기면 표시 차수와 SP를 깎는 차수가 어긋난다.
			[4] = {
				["1"] = {"매직클로", "매직 미사일"},
				["2"] = {"텔레포트", "힐", "홀리 에로우", "부스터", "블레스", "도적 소환"},
				["3"] = {"샤이닝 레이", "용사 소환", "홀리 매직쉘"},
				["4"] = {"바하뮤트", "제네시스", "리커버리 오로라", "리저렉션", "엔젤레이", "궁수 소환"},
			},
			-- 5 아크메이지(썬,콜)
			[5] = {
				["1"] = {"매직클로", "매직 미사일"},
				["2"] = {"텔레포트", "썬더볼트", "부스터", "빙하지대", "메디테이션"},
				["3"] = {"용사 소환"},
				["4"] = {"체인라이트닝", "이프리트", "블리자드", "리커버리 오로라"},
			},
			-- 6 아크메이지(불,독)
			-- (불독 개편 2026-08-08) 4차에 리커버리 마나 신설(리커버리 오로라의 불독판 - MP 회복 부가).
			[6] = {
				["1"] = {"매직클로", "매직 미사일"},
				["2"] = {"텔레포트", "파이어에로우", "부스터", "불의 영역", "메디테이션"},
				["3"] = {"포이즌 미스트", "익스플로젼"},
				["4"] = {"엘퀴네스", "메테오", "리커버리 마나"},
			},
			-- 7 신궁
			[7] = {
				["1"] = {"더블샷", "에로우 블로우", "에로우 블로우 강화"},
				["2"] = {"아이언 에로우", "체인샷", "부스터", "더블 점프", "파이널 어택:궁수"},
				["3"] = {"스트레이프", "아이스 샷", "용사 소환"},
				-- (요청 2026-08-07) "피어싱"은 **4차**다(신설 당시 3차로 넣었던 것을 정정).
				-- ⚠ 차수를 옮기면 reqLevel 대역도 같이 옮겨야 한다(3차 70~119 → 4차 120+) -
				--   안 그러면 GetSkillTier가 여전히 3차로 판정해 **3차 SP를 깎아 쓴다**
				--   (암행·백스탭이 같은 이유로 고쳐진 전례가 폴백 표 주석에 있다).
				["4"] = {"스나이핑", "프리져", "샤프 아이즈", "피어싱"},
			},
			-- 8 보우마스터
			[8] = {
				["1"] = {"더블샷", "에로우 블로우", "에로우 블로우 강화"},
				["2"] = {"속사", "체인샷", "부스터", "더블 점프", "에로우 봄", "파이널 어택:궁수"},
				["3"] = {"스트레이프", "파이어 샷", "용사 소환"},
				["4"] = {"폭풍의 시", "피닉스", "샤프 아이즈"},
			},
			-- 9 나이트로드
			[9] = {
				["1"] = {"럭키세븐", "표창+", "트레이닝", "표창 분산"},
				["2"] = {"암행", "헤이스트", "부스터", "표창+ II", "페이크", "드레인 샷"},
				-- (요청 2026-08-06) 나이트로드·섀도어 3차에 "플래시 점프" 신설(더블 점프와 같은 구조, 마스터 10).
				["3"] = {"쉐도우 파트너", "트리플 스로우", "어벤져", "표창+ III", "트레이닝 II", "플래시 점프"},
				["4"] = {"쿼드러플 스로우", "각성", "표창+ IV"},
			},
			-- 10 섀도어 (요청의 "백스탭2" = 3차 스킬 "암행2")
			-- (요청 2026-08-06) 1차에 "분신 소환" 신설 + 2·3·4차에 그 강화 3종. 강화는 지속시간·데미지와
			-- **분신이 쓸 수 있는 스킬 차수**를 함께 올린다. 또 나이트로드 2차 스킬인 "암행"을 섀도어
			-- 2차에도 넣는다 - 섀도어는 3차에 상위판 "암행2"만 있고 원본이 없었다.
			[10] = {
				["1"] = {"더블스탭", "다크사이트", "분신 소환"},
				-- (요청 2026-08-06) 백스탭을 2차 → **3차**로 옮기고, 빈 자리에 **부스터**를 넣는다.
				-- ⚠ 차수를 옮기면 reqLevel 대역도 같이 옮겨야 한다(2차 30~69 → 3차 70~119) -
				--   안 그러면 GetSkillTier가 여전히 2차로 판정해 **2차 SP를 깎아 쓴다**
				--   (암행·백스탭이 같은 이유로 두 번 고쳐진 전례가 있다 - 아래 폴백 표 주석 참고).
				-- (요청 2026-08-09) "섬광"은 **어느 직업 트리에도 넣지 않는다** - 히어로 2차에서 섀도어 2차로
				-- 옮겼다가, 던지는 물체가 화면에 보이지 않는 문제로 일단 내렸다(사용자 판단: 보류).
				-- ⚠ 스킬 자체는 카탈로그·시전 코드·전용 단검 스프라이트까지 그대로 살아 있다.
				--   되살리려면 여기(또는 다른 직업 차수 목록)에 "섬광" 한 줄만 다시 넣으면 된다.
				["2"] = {"헤이스트", "새비지블로우", "부스터", "페이크", "암행", "분신 강화"},
				["3"] = {"암행2", "쉐도우 파트너", "어썰터", "백스탭", "분신 강화 II", "플래시 점프"},
				["4"] = {"암살", "연막", "분신 강화 III"},
			},
		}
		return jobs[jobIdx]
	end

	@ExecSpace("ClientOnly")
	method void RebuildVisibleSkills(number jobIdx)
		-- 카탈로그(skillData)를 이름으로 찾을 수 있게 펼친 뒤, 직업 목록 순서대로 탭별 목록을 만든다.
		local byName = {}
		local all = {}
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		for _, tid in ipairs(tabIds) do
			for _, s in ipairs(self._T.skillData[tid] or {}) do
				if byName[s.name] == nil then byName[s.name] = s end
				table.insert(all, s)
			end
		end

		-- 기본 탭은 공통, VI 탭은 테스트용 전체 목록.
		local vis = {}
		vis["0"] = self._T.skillData["0"] or {}
		vis["1"] = {}
		vis["2"] = {}
		vis["3"] = {}
		vis["4"] = {}
		vis["5"] = {}
		vis["6"] = {}
		vis["7"] = all

		local names = self:GetJobSkillNames(jobIdx)
		if names ~= nil then
			local stageIds = {"1", "2", "3", "4", "5"}
			for _, tid in ipairs(stageIds) do
				for _, n in ipairs(names[tid] or {}) do
					local s = byName[n]
					if s == nil then
						log_warning("[SkillManager] 직업 스킬 목록에 없는 이름: " .. tostring(n)
							.. " (jobIdx=" .. tostring(jobIdx) .. ", " .. tid .. "차)")
					else
						table.insert(vis[tid], s)
					end
				end
			end
		else
			log_warning("[SkillManager] 알 수 없는 직업 인덱스: " .. tostring(jobIdx) .. " - 1~4차 탭이 비어 보인다")
		end

		self._T.visibleSkills    = vis
		self._T.visibleSkillsJob = jobIdx
		log("[SkillManager] 직업별 스킬 목록 구성 jobIdx=" .. tostring(jobIdx)
			.. " 1차=" .. tostring(#vis["1"]) .. " 2차=" .. tostring(#vis["2"])
			.. " 3차=" .. tostring(#vis["3"]) .. " 4차=" .. tostring(#vis["4"])
			.. " VI(전체)=" .. tostring(#vis["7"]))
	end

	@ExecSpace("ClientOnly")
	method table GetTabSkills(string tabId)
		-- 스킬창(카드/툴팁/드래그/스크롤)이 참조하는 "현재 보이는 목록". 직업이 바뀌면 다시 만든다.
		if tabId == nil then return {} end
		local jobIdx = _UIMyInfoManager:GetSelectedCharacterJobIdx()
		if self._T.visibleSkills == nil or self._T.visibleSkillsJob ~= jobIdx then
			self:RebuildVisibleSkills(jobIdx)
		end
		return self._T.visibleSkills[tabId] or {}
	end

	-- ── 스킬 뷰포트 (5행) 갱신 ────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void UpdateSkillViewport()
		-- 원작 스타일 2열×5행 카드 그리드. 스크롤 1행 = 카드 2칸(한 줄).
		local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
		local totalCount = #tabSkills
		local totalRows = math.ceil(totalCount / 2)
		local maxScrollRow = math.max(0, totalRows - 5)

		if self._T.skillScrollRow > maxScrollRow then
			self._T.skillScrollRow = maxScrollRow
		end

		-- ⚠ **성능**: 잔여 SP 조회는 8탭 전수 스캔을 여러 번 도는 무거운 경로다. 카드 10칸 루프 안에서
		--   칸마다 부르면 스캔이 수십~수백 회가 되어 갱신이 조용히 죽는다(UpdateStats 중첩 사망과 같은
		--   증상). 루프 **밖에서 한 번씩만** 구해 재사용한다 - 한 프레임 안에서는 값이 변하지 않는다.
		local availBeginner = self:GetRemainingBeginnerPoints()
		local availByTier = {}
		for t = 1, 5 do
			availByTier[t] = self:GetRemainingSkillPointsForTier(t)
		end

		for i = 1, 10 do
			local dataIdx = self._T.skillScrollRow * 2 + i
			local skill = tabSkills[dataIdx]
			local base = "/ui/DefaultGroup/SkillWindow/SkillCard" .. i
			local iconEnt  = _EntityService:GetEntityByPath(base .. "/Icon")
			local iconBox  = _EntityService:GetEntityByPath(base .. "/IconBox")
			local pillEnt  = _EntityService:GetEntityByPath(base .. "/NamePill")
			local nameEnt  = _EntityService:GetEntityByPath(base .. "/Name")
			local levelEnt = _EntityService:GetEntityByPath(base .. "/Level")
			local leafEnt  = _EntityService:GetEntityByPath(base .. "/Leaf")
			-- 포인트 분배 "+" 버튼 (spendable 스킬에만 붙는다)
			local plusBG   = _EntityService:GetEntityByPath(base .. "/PlusBG")
			local plusLbl  = _EntityService:GetEntityByPath(base .. "/PlusLabel")
			local showPlus = (skill ~= nil) and (skill.spendable == true)
			if isvalid(plusBG)  then plusBG.Enable  = showPlus end
			if isvalid(plusLbl) then plusLbl.Enable = showPlus end
			if showPlus then
				-- 포인트가 없거나 만렙이면 눌러도 오르지 않으므로 회색으로 죽여 표시한다.
				-- (요청 2026-08-14 9차) 초보자 스킬은 **0차 전용 + 1~5차 차용 총량**으로 판정한다.
				local availForCard = 0
				if self:IsBeginnerSkill(skill.name) then
					availForCard = availBeginner
				else
					availForCard = availByTier[self:GetSkillTier(skill.name)] or 0
				end
				local canSpend = (availForCard > 0) and (skill.level < (skill.maxLevel or 20))
				if isvalid(plusBG) then
					if canSpend then
						plusBG.SpriteGUIRendererComponent.Color = Color(0.20, 0.62, 0.83, 1.0)
					else
						plusBG.SpriteGUIRendererComponent.Color = Color(0.30, 0.33, 0.38, 1.0)
					end
				end
				if isvalid(plusLbl) then
					if canSpend then
						plusLbl.TextComponent.FontColor = Color(1, 1, 1, 1)
					else
						plusLbl.TextComponent.FontColor = Color(0.62, 0.65, 0.70, 1)
					end
				end
			end
			-- (요청) 포인트 회수 "-" 버튼 - 투자된 포인트가 있을 때만 붉게 활성 표시
			local minusBG  = _EntityService:GetEntityByPath(base .. "/MinusBG")
			local minusLbl = _EntityService:GetEntityByPath(base .. "/MinusLabel")
			if isvalid(minusBG)  then minusBG.Enable  = showPlus end
			if isvalid(minusLbl) then minusLbl.Enable = showPlus end
			if showPlus and isvalid(minusBG) then
				local canRefund = (math.floor(tonumber(skill.level) or 0) > 0)
				if canRefund then
					minusBG.SpriteGUIRendererComponent.Color = Color(0.83, 0.35, 0.30, 1.0)
				else
					minusBG.SpriteGUIRendererComponent.Color = Color(0.30, 0.33, 0.38, 1.0)
				end
				if isvalid(minusLbl) then
					if canRefund then
						minusLbl.TextComponent.FontColor = Color(1, 1, 1, 1)
					else
						minusLbl.TextComponent.FontColor = Color(0.62, 0.65, 0.70, 1)
					end
				end
			end
			if skill then
				-- (요청 2026-08-09) 분배하지 않은(0포인트) 스킬은 "쓸 수 없다"는 게 한눈에 보이도록
				-- 카드 전체를 회색으로 죽인다. 판정은 시전/배정과 **같은 함수**를 재사용해 어긋나지 않게 한다
				-- (spendable이 아닌 스킬 - 달팽이 세마리 등 - 은 항상 정상 색이다).
				local dimmed = not self:IsSkillUsableByInvestment(skill.name)
				if isvalid(iconEnt) then
					local spr = iconEnt.SpriteGUIRendererComponent
					spr.ImageRUID = skill.ruid
					if dimmed then
						spr.Color = Color(0.40, 0.40, 0.40, 1)
					else
						spr.Color = Color(1, 1, 1, 1)
					end
				end
				if isvalid(iconBox) then
					if dimmed then
						iconBox.SpriteGUIRendererComponent.Color = Color(0.55, 0.56, 0.58, 1)
					else
						iconBox.SpriteGUIRendererComponent.Color = Color(0.957, 0.961, 0.969, 1)
					end
				end
				if isvalid(pillEnt) then
					if dimmed then
						pillEnt.SpriteGUIRendererComponent.Color = Color(0.34, 0.35, 0.38, 0.95)
					else
						pillEnt.SpriteGUIRendererComponent.Color = Color(0.525, 0.553, 0.6, 0.95)
					end
				end
				if isvalid(nameEnt)  then
					nameEnt.TextComponent.Text = skill.name
					if dimmed then
						nameEnt.TextComponent.FontColor = Color(0.62, 0.65, 0.70, 1)
					else
						nameEnt.TextComponent.FontColor = Color(1, 1, 1, 1)
					end
				end
				if isvalid(levelEnt) then levelEnt.TextComponent.Text = "Lv." .. tostring(skill.level) end
				if isvalid(leafEnt)  then leafEnt.TextComponent.Text  = "" end
			else
				-- 빈 카드: 아이콘/캡슐 숨기고 단풍 문양 플레이스홀더만 표시 (원작 빈 슬롯 스타일)
				if isvalid(iconEnt)  then iconEnt.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0) end
				if isvalid(iconBox)  then iconBox.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0) end
				if isvalid(pillEnt)  then pillEnt.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0) end
				if isvalid(nameEnt)  then nameEnt.TextComponent.Text  = "" end
				if isvalid(levelEnt) then levelEnt.TextComponent.Text = "" end
				if isvalid(leafEnt)  then leafEnt.TextComponent.Text  = "✦" end
			end
		end

		-- 스크롤바 (트랙 + 썸) 가시성: 스크롤 불필요 시 전부 숨김
		local topLimit = 111
		local botLimit = -147
		local thumbEnt      = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollThumb")
		local trackEnt      = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollTrack")
		local thumbTouchEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollThumbTouch")
		local trackTouchEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollTrackTouch")
		if maxScrollRow <= 0 then
			if isvalid(thumbEnt)      then thumbEnt.Enable      = false end
			if isvalid(trackEnt)      then trackEnt.Enable      = false end
			if isvalid(thumbTouchEnt) then thumbTouchEnt.Enable = false end
			if isvalid(trackTouchEnt) then trackTouchEnt.Enable = false end
		else
			if isvalid(trackEnt)      then trackEnt.Enable      = true end
			if isvalid(thumbTouchEnt) then thumbTouchEnt.Enable = true end
			if isvalid(trackTouchEnt) then trackTouchEnt.Enable = true end
			if isvalid(thumbEnt) then
				thumbEnt.Enable = true
				local progress = self._T.skillScrollRow / maxScrollRow
				local thumbY = topLimit - progress * (topLimit - botLimit)
				thumbEnt.UITransformComponent.anchoredPosition = Vector2(268, thumbY)
			end
		end

		-- 스킬창이 다시 그려질 때마다 우측 위 SP 숫자도 함께 맞춘다(열기/탭전환/스크롤 공통 경로).
		self:UpdateSkillPointDisplay()
	end

	-- ── 스킬 포인트(SP) ───────────────────────────────────────────────
	-- 스킬창 우측 위(책 제목 행의 빈 오른쪽)에 "SKILL POINT + 숫자 상자"로 표시한다.

	-- (Phase 4) 전 카탈로그에서 spendable 스킬에 투자된 포인트 총합.
	@ExecSpace("ClientOnly")
	method integer GetTotalInvestedPoints()
		local total = 0
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		local seen = {}
		for _, tid in ipairs(tabIds) do
			for _, s in ipairs(self._T.skillData[tid] or {}) do
				if s.spendable == true and seen[s.name] == nil then
					seen[s.name] = true
					total += math.floor(tonumber(s.level) or 0)
				end
			end
		end
		return total
	end

	-- (요청 개편) 스킬 포인트는 차수(1~4차)별 독립 풀 - 1차 포인트는 2차에서 못 쓰고 반대도 불가.
	-- 차수 판정: 스킬 레벨 제한 대역 기준 (10~29=1차 / 30~69=2차 / 70~119=3차 / 120+=4차, 미등록=1차).
	@ExecSpace("ClientOnly")
	method integer GetSkillTier(string skillName)
		local req = self:GetSkillRequiredLevel(skillName)
		-- (요청 2026-08-12 5차) **하이퍼 스킬(H) = 5차** 신설 - reqLevel 160 이상.
		if req >= 160 then return 5
		elseif req >= 120 then return 4
		elseif req >= 70 then return 3
		elseif req >= 30 then return 2
		else return 1 end
	end

	-- 차수별 SP 총량 - 해당 차수 대역의 레벨에서만 적립된다.
	-- (요청 2026-08-14 7차) **초보자(0차) SP를 전용 풀로 분리**했다. 종전엔 초보자 스킬이 1~4차 SP를
	--   낮은 차수부터 빌려 쓰는 구조라, 그 몫을 태우려고 1차 예산을 1레벨부터 적립(3×min(L,29),
	--   Lv10=30 / Lv29=87)하도록 부풀려 뒀었다 - 그래서 **Lv10에서 1차 SP가 30으로 보였다**(신고).
	--   이제 두 풀이 완전히 독립이다:
	--     · 0차(초보자) = **1레벨 6 + 2레벨부터 레벨당 3, 9레벨에서 적립 종료**(= 3 + 3×min(L,9))
	--       → Lv1 6 / Lv9 **30** / Lv10 이후 30 고정. (요청 2026-08-14 8차 - 종전 3×min(L,120)은
	--         10레벨을 넘어서도 계속 쌓여 "초보자 포인트를 추가로 받는" 문제가 있었다.)
	--     · 1차         = 3×clamp(L-9,0,20) → Lv10 **3** / Lv29 60(= 1차 스킬 마스터 합계. 2026-08-12 이전 사양 복귀)
	-- 2차 = 3×clamp(L-29,0,40) / 3차 = 3×clamp(L-69,0,50) / 4차 = 3×clamp(L-119,0,40)
	-- 5차(하이퍼 H) = 3×clamp(L-159,0,40) → 160~199 레벨당 3(Lv160 3 / Lv199 120, 이후 적립 종료)
	-- ⚠ 스킬창 탭 V(6)·VI(7)에는 대응하는 SP 풀이 없다 - 항상 0으로 표시한다(UpdateSkillPointDisplay).
	-- ⚠ tier 0은 GetSkillTier가 절대 돌려주지 않는다(초보자는 reqLevel이 없어 1로 판정된다) -
	--   초보자 경로는 반드시 IsBeginnerSkill로 먼저 갈라 이 0차 예산을 쓰게 해야 한다.
	@ExecSpace("ClientOnly")
	method integer GetTierBudget(integer tier)
		local L = _CharInfoManager:GetDisplayLevel()
		if tier == 0 then
			if L < 1 then return 0 end
			return 3 + 3 * math.min(L, 9)
		elseif tier == 1 then
			return 3 * math.max(0, math.min(L - 9, 20))
		elseif tier == 2 then return 3 * math.max(0, math.min(L - 29, 40))
		elseif tier == 3 then return 3 * math.max(0, math.min(L - 69, 50))
		-- (요청 2026-08-12) 4차 SP는 **레벨 159까지만** 적립된다(120~159 = 40레벨분, 최대 120pt).
		-- 종전엔 상한이 없어 160+ 구간에서 무한히 늘었다. 다른 차수와 같은 clamp 꼴로 맞춘다.
		elseif tier == 4 then return 3 * math.max(0, math.min(L - 119, 40))
		-- (요청 2026-08-12 5차) **하이퍼(H) SP는 160~199에서만** 적립된다(40레벨분, 최대 120pt).
		else return 3 * math.max(0, math.min(L - 159, 40)) end
	end

	-- (요청 2026-08-12) 초보자(0차) 스킬 판정 - 초보자 탭(skillData["0"])에 있는 스킬은 차수가 없고
	-- **1~4차 SP를 공용으로** 쓴다(낮은 차수부터 소비). GetSkillTier는 레벨 제한이 없는 이 스킬들을
	-- 1차로 판정하므로, 차수별 집계에서 반드시 이 함수로 먼저 걸러내야 이중 계산이 안 생긴다.
	@ExecSpace("ClientOnly")
	method boolean IsBeginnerSkill(string skillName)
		for _, s in ipairs(self._T.skillData["0"] or {}) do
			if s.name == skillName then return true end
		end
		return false
	end

	-- 초보자 스킬에 투자된 포인트 총합(차수 무관).
	@ExecSpace("ClientOnly")
	method integer GetBeginnerInvestedPoints()
		local total = 0
		for _, s in ipairs(self._T.skillData["0"] or {}) do
			if s.spendable == true then
				total += math.floor(tonumber(s.level) or 0)
			end
		end
		return total
	end

	-- 해당 차수의 spendable 스킬에 투자된 포인트 총합. (초보자 스킬은 제외 - 아래에서 따로 흡수한다.)
	@ExecSpace("ClientOnly")
	method integer GetTierInvestedPoints(integer tier)
		local total = 0
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		local seen = {}
		for _, tid in ipairs(tabIds) do
			for _, s in ipairs(self._T.skillData[tid] or {}) do
				if s.spendable == true and seen[s.name] == nil then
					seen[s.name] = true
					if not self:IsBeginnerSkill(s.name) and self:GetSkillTier(s.name) == tier then
						total += math.floor(tonumber(s.level) or 0)
					end
				end
			end
		end
		return total
	end

	-- 초보자 투자분이 **0차 전용 풀을 넘겨 1~5차에서 빌려 간 몫**. (요청 2026-08-14 9차)
	-- 소비 순서가 "0차 전용 먼저 → 그 다음 낮은 차수부터"라 초과분만 아래 차수들이 나눠 낸다.
	@ExecSpace("ClientOnly")
	method integer GetBeginnerOverflowPoints()
		return math.max(0, self:GetBeginnerInvestedPoints() - self:GetTierBudget(0))
	end

	@ExecSpace("ClientOnly")
	method integer GetRemainingSkillPointsForTier(integer tier)
		-- (요청 2026-08-14 9차) 초보자는 **전용 0차 풀을 먼저 쓰고, 모자라면 낮은 차수부터 빌려 쓴다.**
		-- 그래서 이 차수의 잔여 = 자기 예산 − 자기 투자합 − (초보자 초과분이 여기서 가져간 몫)이다.
		-- 별도 장부를 저장하지 않고 매번 이 배분을 다시 계산하므로, 레벨 변동으로 예산이 줄어도
		-- 자동으로 재배분되어 어긋나지 않는다(세이브 포맷 무변경).
		-- 예) 0차 30을 다 쓰고 초보자에 35를 찍었다면 초과 5를 1차부터 메운다.
		local overflow = self:GetBeginnerOverflowPoints()
		local result = 0
		for t = 1, 5 do
			local avail = math.max(0, self:GetTierBudget(t) - self:GetTierInvestedPoints(t))
			local used = math.min(overflow, avail)
			overflow -= used
			if t == tier then
				result = avail - used
				break
			end
		end
		return math.max(0, result)
	end

	-- **초보자 스킬에 지금 쓸 수 있는 포인트 총량** = 0차 전용 잔여 + 1~5차 잔여 전부.
	-- (요청 2026-08-14 9차) 초보자는 다른 차수 포인트까지 끌어 쓸 수 있으므로, 스킬창 초보자 탭과
	-- 카드 "+" 판정·분배 게이트가 전부 이 값을 본다.
	--   예) 초보자 미투자 + 1차 잔여 5 + 2차 잔여 5 → 30 + 5 + 5 = **40**
	-- ⚠ 1~5차 잔여는 이미 초보자 초과분을 뺀 값이라(GetRemainingSkillPointsForTier) 이중 계산이 없다.
	-- ⚠ **성능**: GetRemainingSkillPointsForTier를 5번 부르지 않고 배분 루프를 한 번만 돈다.
	--   그 메서드는 t=1..tier까지 GetTierInvestedPoints(8탭 전수 스캔)를 부르므로, 5번 부르면
	--   전수 스캔이 15회가 되어 **스크립트가 조용히 죽는다**(실측 - UpdateStats 중첩 사망과 같은 증상).
	--   여기서는 스캔이 5회로 끝난다. 호출부에서도 루프 안에서 반복 호출하지 말 것.
	@ExecSpace("ClientOnly")
	method integer GetRemainingBeginnerPoints()
		local invested = self:GetBeginnerInvestedPoints()
		local own = math.max(0, self:GetTierBudget(0) - invested)
		local overflow = math.max(0, invested - self:GetTierBudget(0))
		local sum = 0
		for t = 1, 5 do
			local avail = math.max(0, self:GetTierBudget(t) - self:GetTierInvestedPoints(t))
			local used = math.min(overflow, avail)
			overflow -= used
			sum += (avail - used)
		end
		return own + sum
	end

	-- (표시용) 남은 포인트 합계. 초보자가 전 풀을 끌어 쓸 수 있으므로 그 총량과 같은 값이다.
	@ExecSpace("ClientOnly")
	method integer GetRemainingSkillPoints()
		return self:GetRemainingBeginnerPoints()
	end

	-- (Phase 4) 히어로 스킬 레벨 제한 테이블 (GDD §4.5 - 1차 10~29 / 2차 30~69 / 3차 70~119 / 4차 120+).
	-- 등록되지 않은 스킬은 제한 없음(0). 다른 직업은 M3+ 확장 시 CSV에 행을 추가한다.
	-- (Phase 5) Balance/HeroSkillTable.csv가 진실의 원천 - 없거나 손상이면 하드코딩 폴백.
	@ExecSpace("ClientOnly")
	method void LoadHeroSkillTable()
		-- CSV를 읽어 _T.heroSkillReq/_T.heroSkillMaster에 캐싱한다 (최초 1회).
		if self._T.heroSkillReq ~= nil then return end
		local req = nil
		local master = nil
		local ok, ds = pcall(function() return _DataService:GetTable("HeroSkillTable") end)
		if ok and ds ~= nil then
			local n = ds:GetRowCount()
			if n >= 3 then
				req = {}
				master = {}
				for i = 1, n do
					local nm = ds:GetCell(i, "name")
					if nm ~= nil and nm ~= "" then
						req[nm] = math.floor(tonumber(ds:GetCell(i, "reqLevel")) or 0)
						master[nm] = math.floor(tonumber(ds:GetCell(i, "master")) or 0)
					end
				end
				log("[SkillManager] HeroSkillTable CSV 로드 완료 (" .. tostring(n) .. "스킬)")
			end
		end
		if req == nil then
			req = {
				["파워스트라이크"] = 10, ["러시"] = 15, ["슬래시블러스트"] = 20,
				["부스터"] = 30, ["파이널어택"] = 35, ["분노"] = 40, ["파워가드"] = 50, ["섬광"] = 60,
				-- (요청 2026-08-09) 가드는 히어로·팔라딘 **2차 공용**이다 - 여기서 빠지면 CSV 폴백 시
				-- reqLevel=0 → GetSkillTier가 1차로 판정해 **1차 SP를 깎아 쓴다**. CSV(가드,30,10)와 같이 유지할 것.
				["가드"] = 30,
				["콤보 어택"] = 70, ["패닉"] = 85, ["코마"] = 100, ["발도술"] = 75,
				["브랜디쉬"] = 120, ["어드밴스드 콤보"] = 135, ["돌진"] = 150,
				-- (다크나이트 3차, 2026-08-04) 이 5종이 빠져 있으면 reqLevel=0 → GetSkillTier가 1차로
				-- 판정해 **1차 SP를 깎아 쓴다**(3차 SP는 그대로 남는다). 반드시 CSV와 같이 유지할 것.
				["스피어 버스터"] = 70, ["드래곤 로어"] = 70, ["힐러 소환"] = 75,
				["드래곤 라이딩"] = 85,
				-- (요청 2026-08-12 5차) 용 소환은 **하이퍼(H) 스킬** - reqLevel 160(CSV와 동일 유지).
				["용 소환"] = 160,
				-- (다크나이트 4차, 2026-08-05) 이 2종도 빠지면 reqLevel=0 → 1차 SP를 깎아 쓴다.
				["어드밴스드 스피어 버스터"] = 130, ["드래곤 블러드"] = 140,
				-- (나이트로드 개편, 2026-08-05) 럭키세븐은 1차, 암행·헤이스트는 2차 SP를 쓴다.
				-- ⚠ 헤이스트가 빠지면 reqLevel=0 → GetSkillTier가 1차로 판정해 1차 SP를 깎아 쓴다.
				-- ⚠ (버그 수정 2026-08-05) 암행은 나이트로드 **2차** 목록에 있는데 reqLevel이 10이라
				--   GetSkillTier가 1차로 판정해 1차 SP를 깎아 쓰고 있었다 - 2차 대역(30~69)으로 올린다.
				["럭키세븐"] = 10, ["암행"] = 30, ["헤이스트"] = 30,
				-- (나이트로드 3·4차 개편, 2026-08-05) 이 4종도 빠지면 reqLevel=0 → 1차 SP를 깎아 쓴다.
				["쉐도우 파트너"] = 70, ["트리플 스로우"] = 75, ["어벤져"] = 80,
				["쿼드러플 스로우"] = 125,
				-- (표창+ 4분할 2026-08-05) 차수별 SP를 쓰도록 각 대역에 넣는다(1차 10 / 2차 30 / 3차 70 / 4차 120).
				["표창+"] = 10, ["표창+ II"] = 30, ["표창+ III"] = 70, ["표창+ IV"] = 120,
				["페이크"] = 30, ["드레인 샷"] = 30,
				-- (나이트로드 4차, 2026-08-05) 각성도 빠지면 reqLevel=0 → 1차 SP를 깎아 쓴다.
				["각성"] = 135,
				-- (트레이닝 2026-08-07, 옛 마크 오브 어쌔신) 1차/3차 대역에 각각 - 빠지면 1차 SP를 깎아 쓴다.
				["트레이닝"] = 10, ["트레이닝 II"] = 70,
				-- (표창 분산 2026-08-07) SP를 쓰지 않는(비-spendable) 1차 스킬이지만, GetSkillTier가
				-- 1차로 판정하도록 대역만 맞춰둔다.
				["표창 분산"] = 10,
				-- (분신 소환 계열 2026-08-06, 섀도어) 1차 본체 + 강화 3종을 각 차수 대역에 넣는다.
				-- 빠지면 reqLevel=0 → GetSkillTier가 전부 1차로 판정해 1차 SP를 깎아 쓴다.
				["분신 소환"] = 10, ["분신 강화"] = 30,
				["분신 강화 II"] = 70, ["분신 강화 III"] = 120,
				-- (섀도어 스킬 개편 2026-08-06) 7종을 spendable로 바꿨다 - 여기서 빠지면 reqLevel=0 →
				-- GetSkillTier가 전부 1차로 판정해 1차 SP를 깎아 쓴다. CSV와 반드시 같이 유지할 것.
				["더블스탭"] = 10, ["다크사이트"] = 10, ["새비지블로우"] = 30,
				["암행2"] = 70, ["어썰터"] = 70, ["암살"] = 120, ["연막"] = 120,
				-- ⚠ (버그 수정 2026-08-06) 백스탭은 섀도어 **2차** 목록에 있는데 CSV·폴백 어디에도 없어
				--   reqLevel=0 → GetSkillTier가 1차로 판정해 **1차 SP를 깎아 쓰고 있었다**(신고).
				--   암행이 같은 이유로 고쳐진 전례가 바로 위에 있다 - 2차 대역(30~69)으로 넣는다.
				-- (요청 2026-08-06) 백스탭 2차 → 3차 이동에 맞춰 3차 대역(70~119)으로 올린다.
				["백스탭"] = 70,
				-- (플래시 점프 2026-08-06, 나이트로드·섀도어 3차) 빠지면 reqLevel=0 → GetSkillTier가
				-- 1차로 판정해 **1차 SP를 깎아 쓴다**. 3차 대역(70~119)에 넣는다.
				["플래시 점프"] = 70,
				-- (신궁 개편 2026-08-06) 11종을 spendable로 바꿨다 - 여기서 빠지면 reqLevel=0 →
				-- GetSkillTier가 전부 1차로 판정해 1차 SP를 깎아 쓴다. CSV와 반드시 같이 유지할 것.
				-- ⚠ 더블샷/에로우 블로우/에로우 블로우 강화/더블 점프/스트레이프/용사 소환/샤프 아이즈는
				--   보우마스터(8)와 공유하고, 용사 소환은 비숍(4)·아크메이지(5)의 3차이기도 하다 -
				--   차수 대역은 세 직업 모두 같으므로 한 행으로 충분하다.
				["더블샷"] = 10, ["에로우 블로우"] = 10, ["에로우 블로우 강화"] = 10,
				["아이언 에로우"] = 30, ["더블 점프"] = 30,
				["스트레이프"] = 70, ["아이스 샷"] = 75, ["용사 소환"] = 70,
				-- (요청 2026-08-07) 피어싱 3차 → **4차**. 대역도 70 → 135(4차 120+)로 함께 올린다.
				["피어싱"] = 135,
				["스나이핑"] = 120, ["프리져"] = 125, ["샤프 아이즈"] = 130,
				-- (보우마스터 개편 2026-08-07) 보우마스터 전용 4종을 spendable로 바꿨다 - 여기서 빠지면
				-- reqLevel=0 → GetSkillTier가 전부 1차로 판정해 1차 SP를 깎아 쓴다. CSV와 반드시 같이 유지할 것
				-- ([[feedback_msw_skill_tier_csv_missing]]의 암행·백스탭 전례).
				-- 차수 대역: 속사 = 2차(30~69) / 파이어 샷 = 3차(70~119, 아이스 샷과 같은 75) /
				--            폭풍의 시·피닉스 = 4차(120+, 피닉스는 쌍둥이인 프리져와 같은 125).
				["속사"] = 35, ["파이어 샷"] = 75, ["폭풍의 시"] = 120, ["피닉스"] = 125,
				-- (2026-08-07 신설) 에로우 봄 = 보우마스터 2차 / 파이널 어택:궁수 = 신궁·보우마스터 공용 2차.
				["에로우 봄"] = 40, ["파이널 어택:궁수"] = 45,
				-- (썬콜 개편 2026-08-08) 6종을 spendable로 바꿨다 - 여기서 빠지면 reqLevel=0 →
				-- GetSkillTier가 전부 1차로 판정해 1차 SP를 깎아 쓴다. CSV와 반드시 같이 유지할 것.
				-- 차수 대역: 썬더볼트(홀리 에로우와 같은 30)·빙하지대·메디테이션 = 2차(30~69) /
				--            이프리트(바하뮤트와 동일)·체인라이트닝(암살과 동일)·블리자드(제네시스와 동일) = 4차(120).
				["썬더볼트"] = 30, ["빙하지대"] = 40, ["메디테이션"] = 40,
				["이프리트"] = 120, ["체인라이트닝"] = 120, ["블리자드"] = 120,
				-- (불독 개편 2026-08-08) 6종을 spendable로 바꾸고 리커버리 마나를 신설했다 - 여기서 빠지면
				-- reqLevel=0 → GetSkillTier가 전부 1차로 판정해 1차 SP를 깎아 쓴다. CSV와 반드시 같이 유지할 것.
				-- 차수 대역: 파이어에로우(홀리 에로우와 같은 30)·불의 영역(빙하지대와 같은 40) = 2차 /
				--            포이즌 미스트·익스플로젼 = 3차(70) / 메테오(블리자드와 동일)·엘퀴네스(이프리트와
				--            동일) = 4차(120) / 리커버리 마나(리커버리 오로라와 동일) = 4차(125).
				["파이어에로우"] = 30, ["불의 영역"] = 40,
				["포이즌 미스트"] = 70, ["익스플로젼"] = 70,
				["메테오"] = 120, ["엘퀴네스"] = 120, ["리커버리 마나"] = 125,
			}
			master = {}
			log("[SkillManager] HeroSkillTable 폴백(하드코딩) 사용")
		end
		self._T.heroSkillReq = req
		self._T.heroSkillMaster = master
	end

	@ExecSpace("ClientOnly")
	method integer GetSkillRequiredLevel(string skillName)
		self:LoadHeroSkillTable()
		return self._T.heroSkillReq[skillName] or 0
	end

	-- (Phase 4) 스킬 투자 위력 배율 (spendable 스킬만 - 그 외는 1.0).
	-- ① 유효 pt = 투자 pt × min(1, 3×레벨/총투자)  - 레벨이 떨어져 SP 예산을 초과하면 비율 축소
	-- ② 배율 = 0.6 + 0.4 × min(1, 유효pt/마스터)   - 미투자 0.6배, 마스터 1.0배
	-- ③ 레벨 제한 미달 시 부족 레벨당 -5% (하한 30%)
	@ExecSpace("ClientOnly")
	method number GetSkillPowerMultiplier(string skillName)
		local skill = self:FindSkillByName(skillName)
		if skill == nil or skill.spendable ~= true then return 1.0 end
		-- (Phase 5) 마스터 pt는 CSV 우선, 없으면 카탈로그 maxLevel
		self:LoadHeroSkillTable()
		local csvMaster = self._T.heroSkillMaster[skillName]
		local master = math.max(1, math.floor(tonumber(csvMaster) or tonumber(skill.maxLevel) or 20))
		local invested = math.floor(tonumber(skill.level) or 0)
		local myLevel = _CharInfoManager:GetDisplayLevel()
		-- (차수별 SP 개편) 레벨 하락 시 위력 약화도 차수별 예산 기준으로 계산한다.
		-- (요청 2026-08-14 7차/9차) 초보자 스킬은 GetSkillTier가 1차로 판정하므로 따로 갈라 준다 -
		--   안 그러면 초보자 투자분이 1차 예산과 대조돼 엉뚱한 비율이 나온다. 초보자는 0차 전용 풀에
		--   더해 1~5차까지 끌어 쓸 수 있으므로, 예산은 **"지금 쓸 수 있는 총량 + 이미 쓴 양"**이다.
		local tier = self:GetSkillTier(skillName)
		local tierInvested = self:GetTierInvestedPoints(tier)
		local budget = self:GetTierBudget(tier)
		if self:IsBeginnerSkill(skillName) then
			tierInvested = self:GetBeginnerInvestedPoints()
			budget = tierInvested + self:GetRemainingBeginnerPoints()
		end
		local ratio = 1.0
		if tierInvested > 0 and tierInvested > budget then
			ratio = budget / tierInvested
		end
		local eff = math.floor(invested * ratio)
		local mult = 0.6 + 0.4 * math.min(1, eff / master)
		local reqLevel = self:GetSkillRequiredLevel(skillName)
		if reqLevel > 0 and myLevel < reqLevel then
			mult = mult * math.max(0.3, 1 - 0.05 * (reqLevel - myLevel))
		end
		return mult
	end

	-- (Phase 4) 이름으로 카탈로그 스킬 항목 찾기 (첫 매치).
	@ExecSpace("ClientOnly")
	method table FindSkillByName(string skillName)
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		for _, tid in ipairs(tabIds) do
			for _, s in ipairs(self._T.skillData[tid] or {}) do
				if s.name == skillName then return s end
			end
		end
		return nil
	end

	-- (Phase 4) 잠재 "스킬 재사용 대기시간 -N초" 실적용: 5초 이상 개별 쿨타임에만, 하한은 기본의 50%.
	@ExecSpace("ClientOnly")
	method number ApplyCooldownReduction(number baseSec)
		if baseSec < 5 then return baseSec end
		local cd = _CharInfoManager:GetCooldownReduction()
		if cd <= 0 then return baseSec end
		return math.max(baseSec * 0.5, baseSec - cd)
	end

	-- (Phase 4) 스킬 투자 상태 내보내기/복원 (CharacterPersistence 전용).
	@ExecSpace("ClientOnly")
	method table ExportSkillLevels()
		local out = {}
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		for _, tid in ipairs(tabIds) do
			for _, s in ipairs(self._T.skillData[tid] or {}) do
				if s.spendable == true and (tonumber(s.level) or 0) > 0 and out[s.name] == nil then
					out[s.name] = math.floor(tonumber(s.level) or 0)
				end
			end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void ImportSkillLevels(table levels)
		-- 저장된 투자 상태를 카탈로그에 반영한다 (같은 이름이 여러 탭에 있으면 전부 동기화).
		if levels == nil then return end
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		for _, tid in ipairs(tabIds) do
			for _, s in ipairs(self._T.skillData[tid] or {}) do
				local lv = levels[s.name]
				if lv ~= nil and s.spendable == true then
					s.level = math.min(math.floor(tonumber(lv) or 0), math.floor(tonumber(s.maxLevel) or 20))
				end
			end
		end
		-- 표창+/백스탭/암행 파생 효과 재적용
		self:ApplyShurikenAttackBonus()
		-- (요청 2026-08-12) 세이브 복원 시 초보자 공용 패시브 3종(드롭률·공마·공속)도 다시 반영한다 -
		-- 특히 드롭률은 서버로 밀어줘야 하는 값이라 복원 직후 한 번 더 보내야 한다.
		self:ApplyBeginnerPassives()
		local bs = self:FindSkillByName("백스탭")
		if bs ~= nil then
			-- (백스탭 패시브화 2026-08-06) 켜짐 여부 = "배웠는가"(투자 1 이상). 토글 상태는 더 이상 없다.
			local bsLv = math.floor(tonumber(bs.level) or 0)
			self:RequestSetBackstabState(bsLv >= 1, bsLv)
		end
		-- (나이트로드 개편) 암행의 발동 확률·표창 데미지는 서버가 투자 레벨로 계산한다 - 복원 직후에도
		-- 최신 레벨을 넘겨둔다(백스탭과 동일).
		local amh = self:FindSkillByName("암행")
		if amh ~= nil then
			self:RequestSetAmhaengState(_CharInfoManager:IsAmhaengActive(), math.floor(tonumber(amh.level) or 0))
		end
		-- (섀도어 개편 2026-08-06) 암행2도 발동 확률·데미지를 서버가 투자 레벨로 계산한다 - 암행1과 동일.
		local amh2 = self:FindSkillByName("암행2")
		if amh2 ~= nil then
			self:RequestSetAmhaeng2State(_CharInfoManager:IsAmhaeng2Active(), math.floor(tonumber(amh2.level) or 0))
		end
		-- (나이트로드 3차 개편) 쉐도우 파트너 분신 데미지 비율도 서버가 투자 레벨로 계산한다 -
		-- 복원 직후에도 최신 레벨을 넘겨둔다(백스탭/암행과 동일).
		local sp = self:FindSkillByName("쉐도우 파트너")
		if sp ~= nil then
			self:RequestSetShadowPartnerLevel(math.floor(tonumber(sp.level) or 0))
		end
		-- (페이크) 회피 확률 판정도 서버에 있다 - 복원 직후 최신 레벨을 넘겨둔다.
		local fk = self:FindSkillByName("페이크")
		if fk ~= nil then
			self:RequestSetFakeLevel(math.floor(tonumber(fk.level) or 0))
		end
		-- (트레이닝) 순수 공격력 패시브라 서버에 넘길 것이 없다 - 위 ApplyShurikenAttackBonus 한 번으로
		-- 표창+ 보너스와 함께 이미 반영된다.
		-- (요청 2026-08-08) 레벨 감시 기준점 재설정 - 복원 도중의 레벨 판독을 "하락"으로 오인해
		-- 방금 복원한 분배를 회수하는 사고 방지(캐릭터 전환 포함. 다음 폴에서 새로 기준을 잡는다).
		self._T.watchedLevel = nil
		self._T.pendingLevelDrop = nil
		self._T.pendingLevelDropTicks = 0
		-- (버그 수정 2026-08-16) 입장 직후 1회 정합성 검사를 다시 무장한다 - 아래 LevelWatchTick 주석 참고.
		self._T.initialReconcileDone = false
		self._T.settleLevel = nil
		self._T.settleTicks = 0
		self:UpdateSkillPointDisplay()
		-- (스킬 효과 개편) 서버 판정 스킬 레벨도 복원 직후 동기화
		self:SyncSkillEffectsToServer()
		-- (요청) 복원된 투자 기준으로 미투자 스킬을 퀵슬롯에서 내린다 (핫키 복원 순서와 무관하게 정합 보장)
		self:RemoveUninvestedSkillsFromBar()
		log("[SkillManager] 스킬 투자 복원 완료 (총투자 " .. tostring(self:GetTotalInvestedPoints()) .. "pt)")
	end

	@ExecSpace("ClientOnly")
	method void UpdateSkillPointDisplay()
		-- 탭마다 **그 탭이 쓰는 풀의 잔여**를 보여준다. 탭 라벨과 풀의 대응은 다음과 같다(실측 확인):
		--   "0" = ●(초보자) → 0차 전용 풀   /  "1"~"4" = I~IV → 1~4차
		--   "5" = **H(하이퍼)** → 5차 풀(160~199 레벨당 3)
		--   "6" = V, "7" = VI → 대응하는 풀이 없다 → **항상 0**
		-- (요청 2026-08-14 7차) 초보자 탭은 합계가 아니라 전용 0차 잔여를 보여준다.
		-- (요청 2026-08-14 8차) H 탭은 5차 잔여를, V·VI 탭은 0을 보여준다 - 종전엔 셋 다 else로 빠져
		--   **전 풀 합계**가 떠서 "V/VI에도 포인트가 있다"고 오해하게 만들었다.
		local e = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillPointValue")
		if not isvalid(e) then return end
		local tab = tostring(self._T.activeSkillTab or "")
		if tab == "0" then
			e.TextComponent.Text = tostring(self:GetRemainingBeginnerPoints())
		elseif tab == "1" or tab == "2" or tab == "3" or tab == "4" or tab == "5" then
			e.TextComponent.Text = tostring(self:GetRemainingSkillPointsForTier(math.floor(tonumber(tab) or 1)))
		else
			-- V(6) / VI(7): SP 풀이 없는 탭이라 0으로 고정한다(VI는 카탈로그 전체를 보여주는 테스트 탭).
			e.TextComponent.Text = "0"
		end
	end

	-- 현재 보이는 카드 i(1~10)의 "+"를 눌렀을 때 - 포인트 1개(Shift 클릭이면 가능한 만큼 전부)를
	-- 써서 그 스킬 레벨을 올린다.
	@ExecSpace("ClientOnly")
	method void SpendSkillPointOnCard(integer cardIdx)
		local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
		local skill = tabSkills[self._T.skillScrollRow * 2 + cardIdx]
		if skill == nil or skill.spendable ~= true then return end
		local maxLv = skill.maxLevel or 20
		if skill.level >= maxLv then
			log("[SkillManager] " .. skill.name .. " 이미 최대 레벨(" .. tostring(maxLv) .. ")")
			return
		end
		-- (차수별 SP 개편) 이 스킬이 속한 차수의 포인트만 쓸 수 있다.
		-- (요청 2026-08-14 9차) **초보자 스킬은 전용 0차 풀을 먼저 쓰고, 모자라면 1~5차를 낮은 차수부터
		--   빌려 쓴다.** GetRemainingBeginnerPoints가 그 총량(0차 잔여 + 전 차수 잔여)을 돌려준다.
		local isBeginner = self:IsBeginnerSkill(skill.name)
		local tier = self:GetSkillTier(skill.name)
		local remain = 0
		if isBeginner then
			remain = self:GetRemainingBeginnerPoints()
		else
			remain = self:GetRemainingSkillPointsForTier(tier)
		end
		if remain <= 0 then
			if isBeginner then
				log("[SkillManager] 초보자 스킬 포인트가 없다 (전용 0차 30 + 1~5차 잔여를 전부 소진)")
			else
				log("[SkillManager] " .. tostring(tier) .. "차 스킬 포인트가 없다 (차수별 독립 적립)")
			end
			return
		end
		-- (요청) Shift+클릭 = 남은 포인트/마스터까지 중 가능한 만큼 한 번에 분배
		local count = 1
		if _InputService:IsKeyPressed(KeyboardKey.LeftShift) or _InputService:IsKeyPressed(KeyboardKey.RightShift) then
			count = math.min(remain, maxLv - skill.level)
		end
		skill.level = skill.level + count
		if isBeginner then
			log("[SkillManager] " .. skill.name .. " Lv." .. tostring(skill.level) .. " (+" .. tostring(count)
				.. ", 초보자에 쓸 수 있는 SP " .. tostring(self:GetRemainingBeginnerPoints())
				.. " - 0차 전용 우선, 이후 낮은 차수부터 차용)")
		else
			log("[SkillManager] " .. skill.name .. " Lv." .. tostring(skill.level) .. " (+" .. tostring(count)
				.. ", 남은 " .. tostring(tier) .. "차 SP " .. tostring(self:GetRemainingSkillPointsForTier(tier)) .. ")")
		end
		_CharacterPersistence:MarkDirty("skill_point")
		self:UpdateSkillViewport()
		self:UpdateSkillPointDisplay()
		self:ApplySkillLevelSideEffects(skill)
	end

	-- (요청) 카드의 "-"를 눌렀을 때 - 투자한 포인트 1개(Shift 클릭이면 전부)를 회수해 그 차수의
	-- 풀로 되돌린다. 되돌린 포인트는 같은 차수의 다른 스킬에 다시 투자할 수 있다.
	@ExecSpace("ClientOnly")
	method void RefundSkillPointOnCard(integer cardIdx)
		local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
		local skill = tabSkills[self._T.skillScrollRow * 2 + cardIdx]
		if skill == nil or skill.spendable ~= true then return end
		local invested = math.floor(tonumber(skill.level) or 0)
		if invested <= 0 then
			log("[SkillManager] " .. skill.name .. " 회수할 포인트가 없다")
			return
		end
		local count = 1
		if _InputService:IsKeyPressed(KeyboardKey.LeftShift) or _InputService:IsKeyPressed(KeyboardKey.RightShift) then
			count = invested
		end
		skill.level = invested - count
		local tier = self:GetSkillTier(skill.name)
		log("[SkillManager] " .. skill.name .. " 포인트 회수 -" .. tostring(count) .. " → Lv." .. tostring(skill.level)
			.. " (남은 " .. tostring(tier) .. "차 SP " .. tostring(self:GetRemainingSkillPointsForTier(tier)) .. ")")
		_CharacterPersistence:MarkDirty("skill_point")
		self:UpdateSkillViewport()
		self:UpdateSkillPointDisplay()
		self:ApplySkillLevelSideEffects(skill)
		-- (요청) 포인트가 0이 된 스킬은 퀵슬롯에서도 내린다 (사용 불가 상태)
		if skill.level <= 0 then
			self:RemoveUninvestedSkillsFromBar()
		end
	end

	-- ── (요청 2026-08-08) 표시 레벨 변동 실시간 반영 ────────────────────────
	-- 표시 레벨은 장비 전투력 환산이라 장비 교체/강화 파괴로 수시로 오르내린다.
	--   · 오르면: 스킬창이 열려 있는 동안에도 SP 숫자와 카드("+" 활성색)가 즉시 갱신돼야 한다.
	--   · 내리면: 줄어든 예산만큼 즉시 회수한다 - 남은(미분배) SP부터 차감되고(남은 = 예산 - 분배합
	--     공식이 자동으로 처리), 그래도 분배합이 예산을 넘는 만큼만 분배된 스킬에서 골고루 걷는다.

	@ExecSpace("ClientOnly")
	method void LevelWatchTick(number delta)
		-- 0.5초 주기 폴링. 레벨 계산(CalcEquipCombatPower)이 가볍지 않아 매 프레임 돌리지 않는다.
		self._T.levelWatchAccum = (self._T.levelWatchAccum or 0) + delta
		if self._T.levelWatchAccum < 0.5 then return end
		self._T.levelWatchAccum = 0
		if not isvalid(_UserService.LocalPlayer) then return end
		local lv = _CharInfoManager:GetDisplayLevel()
		local prev = self._T.watchedLevel
		if prev == nil then
			self._T.watchedLevel = lv
			self._T.settleLevel = lv
			self._T.settleTicks = 0
			return
		end
		-- (버그 수정 2026-08-16, 신고 "레벨이 낮아졌는데 분배한 SP가 회수되지 않는다")
		-- 이 감시는 **레벨이 변하는 순간**만 회수를 돌린다. 그래서 이미 초과 분배된 상태로 들어오면
		-- (레벨이 낮아진 채 저장됐거나, 장비를 벗고 접속을 끊었거나, 캐릭터를 전환했거나)
		-- ImportSkillLevels가 기준점을 nil로 지운 뒤 **낮아진 레벨을 그대로 기준으로 채택**하고,
		-- 이후 변화가 없으니 회수가 영영 돌지 않았다. → 입장 후 레벨이 **10초(0.5초 폴 × 20회) 연속
		-- 같은 값으로 안정되면** 1회 정합성 검사를 돌린다. 복원 중간 프레임(장비가 잠깐 비어 보여
		-- 레벨이 낮게 읽히는 구간)에 과다 회수하지 않도록 "안정" 조건을 둔 것이고, 초과분이 없으면
		-- ReconcileSkillPointsToLevel은 아무것도 하지 않고 즉시 반환한다.
		-- (안전장치 강화 2026-08-16) 유예를 아래 하락 확정과 같은 10초로 맞췄다 - 입장 직후 장비/잠재
		-- 복원이 여러 단계로 들어오는 구간에서 3초는 짧았다.
		if not self._T.initialReconcileDone then
			if self._T.settleLevel == lv then
				self._T.settleTicks = (self._T.settleTicks or 0) + 1
				if self._T.settleTicks >= 20 then
					self._T.initialReconcileDone = true
					self:ReconcileSkillPointsToLevel()
					self:RefreshSkillWindowForLevelChange()
				end
			else
				self._T.settleLevel = lv
				self._T.settleTicks = 0
			end
		end
		if lv == prev then
			self._T.pendingLevelDrop = nil
			return
		end
		if lv > prev then
			-- 레벨 상승: 예산이 늘었으니 표시만 즉시 갱신하면 된다(남은 SP는 예산식이 알아서 커진다).
			self._T.watchedLevel = lv
			self._T.pendingLevelDrop = nil
			self:RefreshSkillWindowForLevelChange()
			return
		end
		-- 레벨 하락: 같은 하락 판독이 **10초(0.5초 폴 × 20회) 연속** 유지될 때만 확정한다.
		-- (안전장치 강화 2026-08-16) 종전 유예는 1초(2회 연속)뿐이라 **장비를 갈아입는 중**에도
		-- 회수가 돌았다 - 장비를 벗고 다른 장비를 끼우는 사이 3초만 지나도 SP가 걷혀 나갔고,
		-- 회수로 0이 된 스킬은 퀵슬롯에서도 내려가며 되돌릴 방법이 없다(실측 사고). 10초로 늘리면
		-- 장비 교체·강화·잠재 재설정 같은 일시적 하락은 전부 무시되고 진짜 하락만 남는다.
		-- ⚠ 중간에 레벨이 회복되면(lv == prev) 위 분기가 pendingLevelDrop을 지워 카운터가 리셋된다.
		--   다른 값으로 또 내려가면 아래 첫 분기가 그 값으로 카운터를 새로 시작한다.
		if self._T.pendingLevelDrop ~= lv then
			self._T.pendingLevelDrop = lv
			self._T.pendingLevelDropTicks = 1
			return
		end
		self._T.pendingLevelDropTicks = (self._T.pendingLevelDropTicks or 1) + 1
		if self._T.pendingLevelDropTicks < 20 then return end
		self._T.pendingLevelDrop = nil
		self._T.pendingLevelDropTicks = 0
		self._T.watchedLevel = lv
		self:ReconcileSkillPointsToLevel()
		self:RefreshSkillWindowForLevelChange()
	end

	@ExecSpace("ClientOnly")
	method void RefreshSkillWindowForLevelChange()
		-- 스킬창이 열려 있으면 카드 전체(레벨/"+" 활성색 포함)를, 닫혀 있으면 SP 숫자만 다시 그린다.
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if isvalid(w) and w.Enable then
			self:UpdateSkillViewport()
		else
			self:UpdateSkillPointDisplay()
		end
	end

	@ExecSpace("ClientOnly")
	method void ReconcileSkillPointsToLevel()
		-- 차수별 예산(GetTierBudget)을 초과한 분배분을 즉시 회수한다.
		-- 골고루: 회수할 때마다 그 시점 가장 높은 레벨의 스킬에서 1씩 - 결과적으로 고르게 낮아진다.
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		local removedTotal = 0
		local changed = {}          -- name → 대표 skill 항목(첫 매치)
		local anyZeroed = false
		for tier = 1, 5 do
			local over = self:GetTierInvestedPoints(tier) - self:GetTierBudget(tier)
			if over > 0 then
				-- 이 차수의 분배된 spendable 스킬 목록(이름 중복은 첫 항목만 - GetTierInvestedPoints와 같은 기준).
				local list = {}
				local seen = {}
				for _, tid in ipairs(tabIds) do
					for _, s in ipairs(self._T.skillData[tid] or {}) do
						if s.spendable == true and seen[s.name] == nil then
							seen[s.name] = true
							if self:GetSkillTier(s.name) == tier and (tonumber(s.level) or 0) > 0 then
								table.insert(list, s)
							end
						end
					end
				end
				while over > 0 do
					local best = nil
					for _, s in ipairs(list) do
						if (tonumber(s.level) or 0) > 0
							and (best == nil or (tonumber(s.level) or 0) > (tonumber(best.level) or 0)) then
							best = s
						end
					end
					if best == nil then break end
					best.level = math.floor(tonumber(best.level) or 0) - 1
					over -= 1
					removedTotal += 1
					changed[best.name] = best
					if best.level <= 0 then anyZeroed = true end
				end
			end
		end
		-- **초보자 스킬 회수.** (요청 2026-08-14 9차) 초보자는 전용 0차 풀을 먼저 쓰고 모자라면
		-- 1~5차에서 빌려 쓴다 - 그래서 회수 기준은 "0차 예산 + 차수별 남는 몫"을 넘는 만큼이다.
		-- ⚠ 차수별 회수를 끝낸 **뒤의** 여유분을 구해야 한다(순서 중요) - 차수 회수가 먼저 돌아야
		--   그만큼 여유분이 되살아나 초보자에서 과다 회수하는 것을 막는다.
		local slack = self:GetTierBudget(0)
		for t = 1, 5 do
			slack += math.max(0, self:GetTierBudget(t) - self:GetTierInvestedPoints(t))
		end
		local overBeginner = self:GetBeginnerInvestedPoints() - slack
		if overBeginner > 0 then
			local blist = {}
			for _, s in ipairs(self._T.skillData["0"] or {}) do
				if s.spendable == true and (tonumber(s.level) or 0) > 0 then
					table.insert(blist, s)
				end
			end
			while overBeginner > 0 do
				local bestB = nil
				for _, s in ipairs(blist) do
					if (tonumber(s.level) or 0) > 0
						and (bestB == nil or (tonumber(s.level) or 0) > (tonumber(bestB.level) or 0)) then
						bestB = s
					end
				end
				if bestB == nil then break end
				bestB.level = math.floor(tonumber(bestB.level) or 0) - 1
				overBeginner -= 1
				removedTotal += 1
				changed[bestB.name] = bestB
				if bestB.level <= 0 then anyZeroed = true end
			end
		end
		if removedTotal <= 0 then return end
		-- 같은 이름이 여러 탭에 복제돼 있으면 전부 같은 레벨로 맞춘다(ImportSkillLevels와 같은 동기화).
		for name, skill in pairs(changed) do
			local lvSync = math.floor(tonumber(skill.level) or 0)
			for _, tid in ipairs(tabIds) do
				for _, s in ipairs(self._T.skillData[tid] or {}) do
					if s.name == name and s.spendable == true then s.level = lvSync end
				end
			end
			self:ApplySkillLevelSideEffects(skill)
			log("[SkillManager] 레벨 하락 회수: " .. name .. " → Lv." .. tostring(lvSync))
		end
		if anyZeroed then
			self:RemoveUninvestedSkillsFromBar()
		end
		_CharacterPersistence:MarkDirty("skill_point")
		self:UpdateSkillViewport()
		self:UpdateSkillPointDisplay()
		_UIToast:ShowMessage("레벨 하락으로 분배한 스킬 포인트 " .. tostring(removedTotal) .. "개를 회수했습니다.")
		log("[SkillManager] 레벨 하락 - 분배 초과분 " .. tostring(removedTotal) .. "pt 회수 완료")
	end

	-- (요청 2026-08-10) 전직(테스트 /전직 명령 포함)으로 직업이 바뀌었을 때, **새 직업 스킬 목록에
	-- 없는** 스킬에 투자된 포인트를 전부 회수한다. 남은 SP = 예산(GetTierBudget) - 분배합 공식이라
	-- 레벨을 0으로 되돌리는 것만으로 포인트가 그 차수 풀로 돌아온다(RefundSkillPointOnCard와 같은
	-- 원리 - 별도 적립 불필요). 기본(●) 탭 스킬은 전 직업 공통이라 회수 대상이 아니다.
	-- 직업 공용 스킬(부스터/파워가드/용사 소환 등)은 새 직업 목록에도 있으면 그대로 남는다.
	-- (신고 2026-08-12) 직업 전용 버프/토글은 직업이 바뀌면 즉시 정리한다 - 지속시간이 있는 버프는
	-- 알아서 만료되지만 **무기한 토글**(표창 분산 등)은 아무도 끄지 않아 우측 상단 버프바에 남의 직업
	-- 아이콘이 계속 떠 있었다. 새 직업의 스킬 목록에 없으면 끈다.
	-- 전직(TestCommandManager.ApplyJobCommand)과 캐릭터 입장 양쪽에서 호출한다.
	@ExecSpace("ClientOnly")
	method void CleanupJobExclusiveBuffs(number jobIdx)
		local names = self:GetJobSkillNames(jobIdx)
		local has = {}
		if names ~= nil then
			for _, tid in ipairs({"1", "2", "3", "4", "5"}) do
				for _, n in ipairs(names[tid] or {}) do has[n] = true end
			end
		end
		-- 표창 분산(나이트로드 1차 전용 무기한 토글)
		if has["표창 분산"] ~= true then
			if self._T.starSpreadEnabled == true then
				self._T.starSpreadEnabled = false
				self:RequestSetStarSpread(false)
				log("[SkillManager] 직업 변경 - 표창 분산 토글 자동 해제")
			end
			-- 토글 장부가 이미 false여도 아이콘이 남아 있을 수 있으므로 표시는 항상 내린다.
			_StarSpreadBuffUI:HideBuff()
		end
	end

	-- (요청 2026-08-12) 지금 직업의 스킬 목록에 그 스킬이 들어 있는가.
	-- ⚠ 왜 필요한가: 직업이 바뀌어도 **스킬 투자 레벨과 퀵슬롯 배정은 데이터에 그대로 남는다**.
	--   그래서 이 확인 없이는 타 직업 전용 스킬이 계속 발동한다(신고: 히어로/다크나이트로 자동사냥
	--   중인데 표창 분산이 자동으로 켜져 버프바에 표창+ 계열 아이콘이 떴다).
	-- 목록을 못 구하면 **막지 않는다**(기존 동작 유지 - 직업 판정이 아직 안 선 로그인 직후 등).
	@ExecSpace("ClientOnly")
	method boolean IsSkillInCurrentJob(string skillName)
		-- 현재 직업이 쓸 수 있는 스킬인지.
		local names = self:GetJobSkillNames(_UIMyInfoManager:GetSelectedCharacterJobIdx())
		if names == nil then return true end
		for _, tid in ipairs({"1", "2", "3", "4", "5"}) do
			for _, n in ipairs(names[tid] or {}) do
				if n == skillName then return true end
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void RefundOtherJobSkillPoints(number jobIdx)
		local names = self:GetJobSkillNames(jobIdx)
		if names == nil then return end
		local allowed = {}
		local stageIds = {"1", "2", "3", "4", "5"}
		for _, tid in ipairs(stageIds) do
			for _, n in ipairs(names[tid] or {}) do allowed[n] = true end
		end
		for _, s in ipairs(self._T.skillData["0"] or {}) do allowed[s.name] = true end
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		local removedTotal = 0
		local changed = {}          -- name → 대표 skill 항목 (ReconcileSkillPointsToLevel과 같은 구조)
		local seen = {}
		for _, tid in ipairs(tabIds) do
			for _, s in ipairs(self._T.skillData[tid] or {}) do
				if s.spendable == true and seen[s.name] == nil then
					seen[s.name] = true
					local lv0 = math.floor(tonumber(s.level) or 0)
					if lv0 > 0 and allowed[s.name] ~= true then
						removedTotal += lv0
						s.level = 0
						changed[s.name] = s
					end
				end
			end
		end
		if removedTotal <= 0 then return end
		-- 같은 이름이 여러 탭에 복제돼 있으면 전부 0으로 동기화 + 파생 효과(표창+ 공격력 등) 원복.
		for name, skill in pairs(changed) do
			for _, tid in ipairs(tabIds) do
				for _, s in ipairs(self._T.skillData[tid] or {}) do
					if s.name == name and s.spendable == true then s.level = 0 end
				end
			end
			self:ApplySkillLevelSideEffects(skill)
			log("[SkillManager] 전직 회수: " .. name .. " → Lv.0")
		end
		-- 0포인트가 된 타 직업 스킬은 퀵슬롯에서도 내린다.
		self:RemoveUninvestedSkillsFromBar()
		_CharacterPersistence:MarkDirty("skill_point")
		self:UpdateSkillViewport()
		self:UpdateSkillPointDisplay()
		_UIToast:ShowMessage("전직으로 타 직업 스킬 포인트 " .. tostring(removedTotal) .. "개를 회수했습니다.")
		log("[SkillManager] 전직 - 타 직업 분배 " .. tostring(removedTotal) .. "pt 회수 완료")
	end

	-- 투자 레벨 변경 공통 후처리 - 파생 효과가 있는 스킬(표창+/백스탭)의 재적용.
	@ExecSpace("ClientOnly")
	method void ApplySkillLevelSideEffects(table skill)
		-- 표창+는 포인트 1당 공격력 +1 - 레벨이 바뀔 때마다 스탯에 반영한다.
		if self:IsShurikenPlusSkill(skill.name) then
			self:ApplyShurikenAttackBonus()
		end
		-- (요청 2026-08-12) 초보자 공용 패시브 3종 - 분배/회수 즉시 상시 효과를 다시 계산한다.
		if skill.name == "아이템 감각" or skill.name == "무기 숙련" or skill.name == "민첩 훈련"
			or skill.name == "HP 회복" or skill.name == "MP 회복" then
			self:ApplyBeginnerPassives()
		end
		-- (나이트로드 개편) 암행은 발동 확률·표창 데미지가 투자 레벨에 따라 달라지고 판정이 서버에
		-- 있으므로, 포인트를 찍을 때마다 최신 레벨을 서버로 다시 넘긴다(백스탭과 동일한 구조 -
		-- 켜져 있지 않아도 넘겨둔다. 나중에 켤 때 최신 레벨이 이미 반영돼 있다).
		if skill.name == "암행" then
			self:RequestSetAmhaengState(_CharInfoManager:IsAmhaengActive(), math.floor(skill.level or 0))
		end
		-- (분신 2026-08-06) 분신이 쓰는 4종 배율도 투자에 따라 달라진다 - 찍을 때마다 서버에 다시 올린다.
		if skill.name == "더블스탭" or skill.name == "새비지블로우"
			or skill.name == "어썰터" or skill.name == "암살" then
			self:SyncShadowCloneRatesToServer()
		end
		-- (섀도어 개편 2026-08-06) 암행2도 같은 이유로 포인트를 찍을 때마다 최신 레벨을 서버에 넘긴다.
		if skill.name == "암행2" then
			self:RequestSetAmhaeng2State(_CharInfoManager:IsAmhaeng2Active(), math.floor(skill.level or 0))
		end
		-- 백스탭은 포인트 1당 뒤통수 추가 데미지 +5%p - 판정이 서버에 있으므로 바뀐 레벨을 곧바로
		-- 서버로 다시 넘긴다(켜져 있지 않아도 넘겨둔다 - 나중에 켤 때 최신 레벨이 이미 반영돼 있다).
		if skill.name == "백스탭" then
			self:RequestSetBackstabState(math.floor(skill.level or 0) >= 1, skill.level)
		end
		-- (신궁 개편 2026-08-06) 더블 점프의 이동 속도(+1%/분배)는 **상시 패시브**라 시전 시점이 없다 -
		-- 서버 MovementComponent를 건드려야 하므로 포인트를 찍을 때마다 최신 레벨을 곧바로 넘긴다.
		if skill.name == "더블 점프" then
			self:RequestSyncArcherPassives(math.floor(skill.level or 0))
		end
		-- (나이트로드 3차 개편) 쉐도우 파트너는 분신 데미지 비율 계산이 서버에 있으므로, 포인트를
		-- 찍을 때마다 최신 레벨을 서버로 다시 넘긴다(버프가 꺼져 있어도 넘겨둔다).
		if skill.name == "쉐도우 파트너" then
			self:RequestSetShadowPartnerLevel(math.floor(skill.level or 0))
		end
		-- (페이크) 회피 확률 판정이 서버에 있으므로 포인트를 찍을 때마다 최신 레벨을 넘긴다.
		if skill.name == "페이크" then
			self:RequestSetFakeLevel(math.floor(skill.level or 0))
		end
		-- (트레이닝 2026-08-07) 순수 공격력 패시브 - 표창+와 같은 경로로 다시 계산한다.
		if skill.name == "트레이닝" or skill.name == "트레이닝 II" then
			self:ApplyShurikenAttackBonus()
		end
		-- (스킬 효과 개편) 서버 판정 스킬(파이널어택/콤보/어드콤/브랜디쉬) 레벨 동기화
		if skill.name == "파이널어택" or skill.name == "콤보 어택" or skill.name == "어드밴스드 콤보" or skill.name == "브랜디쉬" then
			self:SyncSkillEffectsToServer()
		end
		-- (팔라딘) 가드 레벨이 바뀌면 자동사냥 중일 때 서버 자동 가드 상태도 최신 레벨로 재동기화
		if skill.name == "가드" and _AutoHuntManager:IsActive() then
			self:RequestSetAutoHuntState(true, skill.level)
		end
	end

	-- ── 탭 전환 ───────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void SwitchSkillTab(string tabId)
		self._T.activeSkillTab  = tabId
		self._T.skillScrollRow  = 0
		self._T.skillWheelAccum = 0.0
		self:ClearSkillSelection()
		self:UpdateSkillTabVisuals()
		self:UpdateSkillBookTitle()
		self:UpdateSkillViewport()
		self:UpdateSkillPointDisplay()
		log("[SkillManager] 탭: " .. tabId)
	end

	@ExecSpace("ClientOnly")
	method void UpdateSkillTabVisuals()
		local tabIds = {"0", "1", "2", "3", "4", "5", "6", "7"}
		for _, tid in ipairs(tabIds) do
			local bg  = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/Tab_" .. tid .. "_BG")
			local lbl = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/Tab_" .. tid .. "_Label")
			if isvalid(bg) then
				-- 원작 스타일: 활성 탭 = 하늘색, 비활성 = 짙은 슬레이트
				if tid == self._T.activeSkillTab then
					bg.SpriteGUIRendererComponent.Color = Color(0.20, 0.62, 0.83, 1.0)
				else
					bg.SpriteGUIRendererComponent.Color = Color(0.141, 0.165, 0.22, 0.9)
				end
			end
			if isvalid(lbl) then
				if tid == self._T.activeSkillTab then
					lbl.TextComponent.FontColor = Color(1, 1, 1, 1)
				else
					lbl.TextComponent.FontColor = Color(0.58, 0.62, 0.68, 1)
				end
			end
		end
	end

	-- 스킬창 책 제목(원작의 "저격수의 길" 자리)을 임의 문자열로 직접 지정한다.
	@ExecSpace("ClientOnly")
	method void SetSkillBookTitle(string title)
		local e = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillBookTitle")
		if isvalid(e) then e.TextComponent.Text = title end
	end

	-- 스킬창 책 제목을 활성 탭(차수)에 맞는 전직명으로 갱신한다.
	-- 기본(●) 탭 = "초보자", I~IV 탭 = 해당 직업의 1~4차 전직명(예: 히어로 직업이면 검사/파이터/
	-- 크루세이더/히어로), H/V/VI 탭 = 4차 전직명 그대로(원작처럼 5·6차도 직업명이 유지됨).
	@ExecSpace("ClientOnly")
	method void UpdateSkillBookTitle()
		local e = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillBookTitle")
		if not isvalid(e) then return end
		local tab = self._T.activeSkillTab
		if tab == nil or tab == "0" then
			e.TextComponent.Text = "초보자"
			return
		end
		local jobIdx = _UIMyInfoManager:GetSelectedCharacterJobIdx()
		local names = _UIMyInfoManager:GetJobStageNames(jobIdx)
		if names == nil then
			e.TextComponent.Text = "초보자"
			return
		end
		local stage = tonumber(tab) or 1
		if stage > 4 then stage = 4 end
		e.TextComponent.Text = names[stage]
	end

	-- ── 스크롤: 썸 드래그 ─────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnSkillThumbDown(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/SkillWindow", e.TouchPoint) then return end
		local win = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if not isvalid(win) then return end
		local winPos  = win.UITransformComponent.anchoredPosition
		local cursor  = _InputService:GetCursorPosition()
		local ghostUI = Vector2(cursor.x - 960, cursor.y - 540)
		local localY  = ghostUI.y - winPos.y
		local th = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollThumb")
		local thumbY = 111.0
		if isvalid(th) then thumbY = th.UITransformComponent.anchoredPosition.y end
		self._T.isDraggingSkillThumb  = true
		self._T.isHoldingSkillTrack   = false
		self._T.skillThumbDragOffsetY = localY - thumbY
		log("[SkillManager] 썸 드래그 시작")
	end

	-- ── 스크롤: 트랙 홀드 ─────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnSkillTrackDown(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/SkillWindow", e.TouchPoint) then return end
		if self._T.isDraggingSkillThumb then return end
		self._T.isHoldingSkillTrack = true
		self._T.skillTrackTimer     = 0.0
		self:SkillScrollTrackStep()
		log("[SkillManager] 트랙 홀드 시작")
	end

	@ExecSpace("ClientOnly")
	method void SkillScrollTrackStep()
		local win = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if not isvalid(win) then return end
		local winPos  = win.UITransformComponent.anchoredPosition
		local cursor  = _InputService:GetCursorPosition()
		local ghostUI = Vector2(cursor.x - 960, cursor.y - 540)
		local localY  = ghostUI.y - winPos.y
		-- topLimit=111, range=258 (topLimit-botLimit = 111-(-147))
		local progress = (111 - localY) / 258
		progress = math.max(0.0, math.min(1.0, progress))
		local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
		local maxRow    = math.max(0, math.ceil(#tabSkills / 2) - 5)
		local targetRow = math.floor(progress * maxRow + 0.5)
		targetRow = math.max(0, math.min(maxRow, targetRow))
		if self._T.skillScrollRow < targetRow then
			self._T.skillScrollRow = self._T.skillScrollRow + 1
			self:UpdateSkillViewport()
		elseif self._T.skillScrollRow > targetRow then
			self._T.skillScrollRow = self._T.skillScrollRow - 1
			self:UpdateSkillViewport()
		end
	end

	-- ── 스크롤: 마우스 휠 ─────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnSkillMouseScroll(MouseScrollEvent e)
		local win = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if not isvalid(win) or not win.Enable then return end
		local winPos  = win.UITransformComponent.anchoredPosition
		local cursor  = _InputService:GetCursorPosition()
		local ghostUI = Vector2(cursor.x - 960, cursor.y - 540)
		local localX  = ghostUI.x - winPos.x
		local localY  = ghostUI.y - winPos.y
		-- 창 범위 바깥은 무시 (창 560×540)
		if localX < -280 or localX > 280 or localY < -270 or localY > 270 then return end
		if e.ScrollDelta > 0 then
			self._T.skillWheelAccum = self._T.skillWheelAccum + 0.2
			if self._T.skillWheelAccum >= 1.0 then
				self._T.skillWheelAccum = self._T.skillWheelAccum - 1.0
				if self._T.skillScrollRow > 0 then
					self._T.skillScrollRow = self._T.skillScrollRow - 1
					self:UpdateSkillViewport()
				end
			end
		elseif e.ScrollDelta < 0 then
			self._T.skillWheelAccum = self._T.skillWheelAccum - 0.2
			if self._T.skillWheelAccum <= -1.0 then
				self._T.skillWheelAccum = self._T.skillWheelAccum + 1.0
				local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
				local maxRow = math.max(0, math.ceil(#tabSkills / 2) - 5)
				if self._T.skillScrollRow < maxRow then
					self._T.skillScrollRow = self._T.skillScrollRow + 1
					self:UpdateSkillViewport()
				end
			end
		end
	end

	-- ── 스킬 행 호버 / 드래그 ─────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnSkillRowHoverEnter(integer rowIdx)
		-- rowIdx = 카드 번호(1~10). 스크롤 1행 = 카드 2칸이므로 *2 보정.
		local dataIdx   = self._T.skillScrollRow * 2 + rowIdx
		local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
		local skill     = tabSkills[dataIdx]
		if skill == nil then return end
		self._T.hovering     = true
		self._T.pendingShow  = true
		self._T.hoverTabId   = self._T.activeSkillTab
		self._T.hoverDataIdx = dataIdx
		self._T.hoverRowIdx  = rowIdx
	end

	@ExecSpace("ClientOnly")
	method void OnSkillRowHoverExit(integer rowIdx)
		if self._T.hovering then
			self._T.hovering    = false
			self._T.pendingShow = false
			self:HideSkillTooltip()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSkillRowDragStart(integer rowIdx)
		-- rowIdx = 카드 번호(1~10). 스크롤 1행 = 카드 2칸이므로 *2 보정.
		local dataIdx   = self._T.skillScrollRow * 2 + rowIdx
		local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
		local skill     = tabSkills[dataIdx]
		if skill == nil then return end
		-- (요청 2026-08-09) 분배하지 않은(0포인트) 스킬은 **집을 수조차 없게** 한다.
		-- 배정(AssignSkillToSlot)·시전(UseSkillInSlot) 쪽엔 이미 같은 게이트가 있었지만, 스킬창에서
		-- 집어서 슬롯을 누르는 "클릭-클릭" 경로는 여기서 시작하므로 막히지 않았다(고스트만 따라다니다
		-- 배정 단계에서야 거부되던 상태).
		if not self:IsSkillUsableByInvestment(skill.name) then
			_UIToast:ShowMessage("스킬 포인트를 투자해야 사용할 수 있습니다.")
			log("[SkillManager] 스킬 드래그 차단(포인트 미투자): " .. tostring(skill.name))
			return
		end
		self._T.isDraggingSkill = true
		self._T.dragSkillRUID   = skill.ruid
		self._T.dragSkillName   = skill.name
		self._T.dragSource      = "window"
		self._T.dragFromKey     = ""
		self._T.hovering        = false
		self._T.pendingShow     = false
		self:HideSkillTooltip()
		self:ShowDragGhost(skill.ruid)
		log("[SkillManager] 스킬 드래그 시작: " .. skill.name)
	end

	-- ── 공통 유틸리티 ──────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void InitBarIcons()
		-- 퀵슬롯 24칸 전체를 barKeys/slotData 기준으로 다시 그린다 (키 라벨/아이콘/기능 라벨)
		for _, p in ipairs(self._T.barPositions) do
			self:UpdateBarSlotVisual(p)
		end
	end

	-- ── 퀵슬롯 위치 ↔ 키 매핑 ──────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method string GetKeyForBarPos(string pos)
		-- 퀵슬롯 위치(엔티티 접미사)에 연결된 키 이름
		return self._T.barKeys[pos] or pos
	end

	@ExecSpace("ClientOnly")
	method string GetBarPosForKey(string key)
		-- 해당 키가 연결된 퀵슬롯 위치 (없으면 "")
		for _, p in ipairs(self._T.barPositions) do
			if self._T.barKeys[p] == key then return p end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void SetBarKey(string pos, string keyName)
		-- 퀵슬롯 리매핑: 위치 pos를 keyName 키에 연결한다. 다른 위치가 이미 그 키면 서로 교환한다.
		local prevKey = self._T.barKeys[pos]
		if prevKey == keyName then return end
		local other = self:GetBarPosForKey(keyName)
		if other ~= "" and other ~= pos then
			self._T.barKeys[other] = prevKey
			self:UpdateBarSlotVisual(other)
		end
		self._T.barKeys[pos] = keyName
		self:UpdateBarSlotVisual(pos)
		self:UpdateAssaulterStackUI()
		_CharacterPersistence:MarkDirty("hotkey")
		log("[SkillManager] 퀵슬롯 키 변경: 위치 " .. pos .. " → [" .. keyName .. "]")
	end

	@ExecSpace("ClientOnly")
	method table ExportBarKeys()
		-- 위치 → 키 매핑 내보내기 (영속 저장/프리셋용)
		local out = {}
		for _, p in ipairs(self._T.barPositions) do
			out[p] = self._T.barKeys[p] or p
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void ImportBarKeys(table t)
		-- 위치 → 키 매핑 복원. 항목이 없는 위치는 기본값(위치 접미사)으로 돌아간다.
		for _, p in ipairs(self._T.barPositions) do
			local v = (t ~= nil) and t[p] or nil
			self._T.barKeys[p] = (v ~= nil and v ~= "") and tostring(v) or p
			self:UpdateBarSlotVisual(p)
		end
		self:UpdateAssaulterStackUI()
	end

	@ExecSpace("ClientOnly")
	method void UpdateBarSlotVisual(string pos)
		-- 퀵슬롯 한 칸을 다시 그린다: 키 라벨 + (스킬 아이콘 | 기능 라벨 | 빈 칸)
		local base = "/ui/DefaultGroup/SkillBar/Slot_" .. pos
		local key = self:GetKeyForBarPos(pos)
		local labelEnt = _EntityService:GetEntityByPath(base .. "/KeyLabel")
		if isvalid(labelEnt) then labelEnt.TextComponent.Text = key end
		local iconEnt = _EntityService:GetEntityByPath(base .. "/Icon")
		local funcEnt = _EntityService:GetEntityByPath(base .. "/FuncLabel")
		local slot = self._T.slotData[key]
		if slot ~= nil and slot.ruid ~= "" then
			if isvalid(iconEnt) then
				local spr = iconEnt.SpriteGUIRendererComponent
				spr.ImageRUID = slot.ruid
				spr.Color = Color(1, 1, 1, 1)
			end
			if isvalid(funcEnt) then funcEnt.TextComponent.Text = "" end
		else
			if isvalid(iconEnt) then iconEnt.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0) end
			if isvalid(funcEnt) then funcEnt.TextComponent.Text = _KeySettingManager:GetFuncLabel(key) end
		end
		-- 차지 블로우는 아이콘 자체가 "현재 모드" 표시라서, 슬롯을 다시 그린 뒤 모드 아이콘으로 덮어쓴다
		-- (그냥 두면 여기서 slotData의 기본 아이콘으로 되돌아가 모드 표시가 사라진다).
		if slot ~= nil and slot.name == "차지 블로우" and self._T.chargeBlowMode ~= nil then
			self:RefreshChargeBlowSlotIcon()
		end
		-- (요청 2026-08-05) 표창+도 아이콘 자체가 "지금 던지는 표창" 표시다 - 차지 블로우와 같은 이유로
		-- 슬롯을 다시 그린 뒤 선택 표창 아이콘 + 보유 개수로 덮어쓴다.
		-- ⚠ 조건 없이 부른다. "이 칸이 표창+일 때만"으로 좁히면, 표창+를 슬롯에서 **내렸을 때**
		--   개수 표시가 그대로 남는다(내린 칸은 이름이 이미 비어 있어 분기에 걸리지 않는다).
		--   표창+가 어디에도 없으면 이 메서드가 표시를 끄고 곧바로 빠져나온다.
		self:RefreshShurikenSlotDisplay()
	end

	-- ── 클릭 배정 모드 접근자 (KeySettingManager 연동) ────────────────

	@ExecSpace("ClientOnly")
	method boolean IsClickMode()
		-- 클릭 배정 모드(스킬을 집은 상태) 여부
		return self._T.skillClickMode == true
	end

	@ExecSpace("ClientOnly")
	method table GetClickPayload()
		-- 클릭 배정 모드에서 집고 있는 스킬 정보
		return { ruid = self._T.clickModeRUID or "", name = self._T.clickModeName or "" }
	end

	@ExecSpace("ClientOnly")
	method void EnterClickMode(string ruid, string name, string origin)
		-- 스킬을 집은 상태(클릭 배정 모드)로 전환한다. origin: "window" | "keysetting" | "spare" | "bar"
		self._T.skillClickMode = true
		self._T.clickModeRUID  = ruid
		self._T.clickModeName  = name
		self._T.clickModeOrigin = origin
		self:ShowDragGhost(ruid)
	end

	@ExecSpace("ClientOnly")
	method void EnterClickModeFromBar(string ruid, string name, string fromKey)
		-- 퀵슬롯에서 집힌/밀려난 스킬을 클릭 배정 모드로 전환한다 (KeySettingManager 연동용).
		-- fromKey는 Esc 복귀용 원래 키 - ""이면 복귀할 자리가 없어 Esc 시 그냥 내려놓는다.
		self:EnterClickMode(ruid, name, "bar")
		self._T.clickModeFromKey = fromKey
	end

	@ExecSpace("ClientOnly")
	method table GetSkillOnKey(string key)
		-- 해당 키에 배정된 스킬 정보 (없으면 빈 문자열)
		local slot = self._T.slotData[key]
		if slot == nil then return { ruid = "", name = "" } end
		return { ruid = slot.ruid or "", name = slot.name or "" }
	end

	@ExecSpace("ClientOnly")
	method void RemoveSkillFromKey(string key)
		-- 키에서 스킬을 제거한다 (키세팅 창에서 집기/삭제용)
		self._T.slotData[key] = { ruid = "", name = "" }
		local pos = self:GetBarPosForKey(key)
		if pos ~= "" then self:UpdateBarSlotVisual(pos) end
		_CharacterPersistence:MarkDirty("hotkey")
		self:UpdateAssaulterStackUI()
	end

	@ExecSpace("ClientOnly")
	method string GetSkillKeyName(any keyEnum)
		-- KeyboardKey → 스킬 배정 가능 키 이름 (지원하지 않는 키면 ""). 키 목록은 KeySettingManager가 단일 관리.
		if self._T.keyDefs == nil then
			self._T.keyDefs = _KeySettingManager:GetBindKeyDefs()
		end
		for _, kd in ipairs(self._T.keyDefs) do
			if keyEnum == kd.keyEnum then return kd.name end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent e)
		-- 퀵슬롯 리매핑 키 캡처 중에는 스킬/창 단축키를 모두 무시한다 (KeySettingManager가 처리)
		if _KeySettingManager:IsCapturingKey() then return end
		local k = e.key
		-- (표창+) 표창 선택 중에는 숫자키가 표창 고르기 전용이다. 1~8번은 퀵슬롯 키이기도 해서
		-- 여기서 가로채지 않으면 표창을 고르는 동시에 그 칸의 스킬까지 발동해버린다.
		if self._T.shurikenSelecting == true then
			local pick = self:ShurikenKeyToIndex(k)
			if pick > 0 then
				self:ChooseShuriken(pick)
				return
			end
			if k == KeyboardKey.Escape then
				self:CloseShurikenSelect(false)
				log("[Shuriken] Esc - 표창 선택 취소")
				return
			end
			-- ⚠ 숫자키/Esc만 삼키고 나머지는 그대로 흘려보낸다.
			--   전부 막아버리면 표창+가 배정된 퀵슬롯 키도 막혀서 "한 번 더 눌러도 안 닫힌다"가 된다
			--   (실측 신고) - 흘려보내야 UseSkillInSlot → OpenShurikenSelect의 토글 닫기가 동작한다.
		end
		-- 퀵슬롯에서 클릭으로 집은 스킬은 Esc로 원래 슬롯에 되돌린다 (빈 곳 클릭 제거의 실수 방지용)
		if k == KeyboardKey.Escape and self._T.skillClickMode and self._T.clickModeOrigin == "bar" then
			local fromKey = self._T.clickModeFromKey or ""
			if fromKey ~= "" then
				local cur = self._T.slotData[fromKey]
				if (cur == nil or cur.ruid == "") and _KeySettingManager:GetFuncOnKey(fromKey) == "" then
					self:AssignSkillToSlot(fromKey, self._T.clickModeRUID, self._T.clickModeName)
				end
			end
			self:ClearSkillSelection()
			log("[SkillManager] 퀵슬롯 집기 취소 - 원래 슬롯으로 복귀")
			return
		end
		-- (질주) 좌/우 방향키 "더블탭"(0.5초 내 두 번) → 그 방향으로 질주 진입. 공격키(Ctrl) → 질주 해제.
		if k == KeyboardKey.LeftArrow or k == KeyboardKey.RightArrow then
			local dir = (k == KeyboardKey.LeftArrow) and "left" or "right"
			local now = _UtilLogic.ElapsedSeconds
			-- 이미 그 방향으로 질주 중이면 더블탭을 다시 잡지 않는다(홀드 중 반복 KeyDown으로 재발동 방지).
			if not (self._T.sprintActive == true and self._T.sprintDir == dir) then
				local lastT = (dir == "left") and (self._T.sprintLastLeft or -99.0) or (self._T.sprintLastRight or -99.0)
				if lastT + 0.5 >= now then
					self:EnterSprint(dir)
					-- 트리거 후 타이머를 비워 홀드 중 반복 입력이 좌/우를 번갈아 재발동시키지 않게 한다.
					self._T.sprintLastLeft = -99.0
					self._T.sprintLastRight = -99.0
				else
					if dir == "left" then self._T.sprintLastLeft = now else self._T.sprintLastRight = now end
				end
			end
		elseif k == KeyboardKey.LeftControl or k == KeyboardKey.RightControl then
			if self._T.sprintActive == true then self:EndSprint() end
			-- (요청) 아대를 끼면 기본공격을 **시스템 기본공격이 아니라 스킬처럼** 처리한다 -
			-- 여기서 공격 키를 직접 받아 클라이언트에서 곧바로 시전해야, 엔진이 자기 ATTACK 상태로
			-- 장착 무기 공격 동작을 재생하기 전에 컨트롤러를 끄고 럭키세븐 모션을 걸 수 있다.
			-- (서버 PlayerActionEvent를 기다리면 이미 엔진 동작이 재생된 뒤다 - 실측)
			if self:IsClawEquipped() then
				local player = _UserService.LocalPlayer
				if isvalid(player) then
					---@type PlayerAttack
					local pa = player:GetComponent(PlayerAttack)
					if isvalid(pa) then pa:CastClawBasicAttack() end
				end
			elseif self:IsArcherJob() then
				-- (요청 2026-08-13) 신궁·보우마스터는 기본공격이 무기 휘두르기가 아니라 **더블샷 화살 1발**이다.
				-- 아대와 같은 이유로 여기서 직접 시전한다 - 서버 PlayerActionEvent를 기다리면 엔진이 이미
				-- 자기 공격 동작을 재생한 뒤라 모션을 덮을 수 없다.
				self:DoArcherBasicAttack()
			end
			-- (다크사이트) 기본공격도 "공격 동작"이므로 적중 여부와 무관하게 은신을 푼다.
			-- 아대 기본공격(위 스킬 경로)과 엔진 기본공격(컨트롤러가 알아서 휘두르는 경우) 둘 다 여기를 지난다.
			self:BreakDarkSightByAttack()
		end
		-- 공격 키를 Ctrl이 아닌 다른 키로 옮겨둔 경우에도 기본공격으로 은신이 풀려야 한다.
		if _KeySettingManager:GetFuncForKeyEnum(k) == "attack" then
			self:BreakDarkSightByAttack()
		end
		-- (더블 점프) 점프 기능키를 공중에서 "한 번 더" 누르면 앞으로 날아간다.
		-- KeyDownEvent는 키를 누르고 있는 동안 반복 발생하므로, 반드시 상승 엣지(직전에 안 눌려있던
		-- 새 누름)에서만 처리한다 - 그냥 두면 지상에서 점프키를 누른 채로 떠오르는 순간 반복 KeyDown이
		-- 그대로 더블 점프까지 발동시켜 "한 번 더 누른다"는 조건이 무너진다.
		-- (플래시 점프) 나이트로드·섀도어 3차. 같은 "공중에서 점프키 한 번 더" 조작을 쓰므로 먼저 시도하고,
		-- 발동했으면(배웠고 조건이 맞으면) 더블 점프는 건너뛴다. 안 배웠으면 false라 기존과 동일하다.
		if _KeySettingManager:GetFuncForKeyEnum(k) == "jump" then
			local jumpWasHeld = self._T.jumpKeyHeld == true
			self._T.jumpKeyHeld = true
			if not jumpWasHeld then
				if not self:TryFlashJump() then
					self:TryDoubleJump()
				end
			end
		end
		-- 스킬창 열기 키 (기본 K - 키설정에서 다른 키로 옮겼으면 그 키)
		if _KeySettingManager:GetFuncForKeyEnum(k) == "skill" then
			self:ToggleWindow()
			return
		end
		if k == KeyboardKey.Tab then
			local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
			if isvalid(w) and w.Enable then
				local tabOrder = {"0", "1", "2", "3", "4", "5", "6", "7"}
				local nextIdx = 1
				for i, tid in ipairs(tabOrder) do
					if tid == self._T.activeSkillTab then
						nextIdx = (i % #tabOrder) + 1
						break
					end
				end
				self:SwitchSkillTab(tabOrder[nextIdx])
			end
			return
		end
		-- 단축키 세팅 창이 열려있는 동안에는 스킬 오발동을 막는다 (편집 중 보호)
		if _KeySettingManager:IsWindowOpen() then return end
		local keyName = self:GetSkillKeyName(k)
		if keyName ~= "" then
			-- (버그 수정) "강화 스킬을 재사용해도 안 풀린다" - KeyDownEvent가 키를 누르고 있는 동안 반복
			-- 발생하면 토글 스킬(어드밴스드 스피어 버스터)이 한 번 누름에 여러 번 토글돼 결국 상태가
			-- 안 바뀐다(짝수번 → 원위치). 토글 스킬은 "상승 엣지"(직전에 안 눌려있던 새 누름)에서만
			-- 실행한다. 다른 스킬은 기존대로 매 KeyDown 실행(쿨다운이 있어 반복 KeyDown이 문제 안 됨).
			local wasHeld = self._T.heldSkillKeys[keyName] == true
			self._T.heldSkillKeys[keyName] = true
			local slotForKey = self._T.slotData[keyName]
			-- 드래곤 라이딩도 토글 스킬(탑승 ↔ 해제)이라 같은 처리가 필요하다. 상승 엣지에서만 실행해야
			-- 키를 누르고 있는 동안 반복 KeyDown으로 탑승/해제가 초당 수십 번 뒤집히지 않고,
			-- "한 번 누를 때마다 탑승 → 해제 → 탑승"으로 또박또박 번갈아 동작한다.
			-- 드래곤 라이딩은 (요청) 키를 누르고 있으면 탑승 ↔ 해제가 계속 반복돼야 하므로 여기서
			-- 상승 엣지로 막지 않는다. 대신 UseSkillInSlot의 자체 쿨타임(1초)이 초당 수십 번 뒤집히는 걸 막는다.
			-- 다크사이트도 "누르면 켜지고 한 번 더 누르면 풀리는" 토글이라 같은 처리가 필요하다.
			-- (요청 2026-08-06) "에로우 블로우 강화"는 패시브가 되어 퀵슬롯에 올릴 수 없으므로 목록에서 뺐다.
			local isToggleSkill = slotForKey ~= nil and (slotForKey.name == "어드밴스드 스피어 버스터" or slotForKey.name == "암행" or slotForKey.name == "암행2" or slotForKey.name == "다크사이트" or slotForKey.name == "매직 에로우(빛)" or slotForKey.name == "매직 에로우(얼음)" or slotForKey.name == "매직 에로우(불)")
			if not (isToggleSkill and wasHeld) then
				self:UseSkillInSlot(keyName)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnKeyUp(KeyUpEvent e)
		-- (질주) 진행 방향 방향키를 떼면 질주 해제.
		if e.key == KeyboardKey.LeftArrow or e.key == KeyboardKey.RightArrow then
			if self._T.sprintActive == true then
				local upDir = (e.key == KeyboardKey.LeftArrow) and "left" or "right"
				if self._T.sprintDir == upDir then self:EndSprint() end
			end
		end
		-- (더블 점프) 점프키를 뗀 순간 홀드 상태를 해제한다 - 다음 누름이 다시 "상승 엣지"가 되어야
		-- "공중에서 한 번 더 누름"으로 인정된다.
		if _KeySettingManager:GetFuncForKeyEnum(e.key) == "jump" then
			self._T.jumpKeyHeld = false
		end
		-- 스킬키를 뗀 순간 홀드 상태를 해제한다 (OnUpdate의 홀드 지속 발동 루프가 멈추도록)
		local keyName = self:GetSkillKeyName(e.key)
		if keyName ~= "" then
			self._T.heldSkillKeys[keyName] = false
			-- (암살) 키를 떼면 서버에 알려 "숨은 상태 유지"를 끝낸다 - 홀드 중에는 연쇄가 짧게 끝나도
			-- 다시 나타나지 않고 이어지기 때문에, 실제 복귀 시점은 이 신호가 결정한다.
			local slotUp = self._T.slotData[keyName]
			if slotUp ~= nil and slotUp.name == "암살" then
				self:RequestSetAssassinateHold(false)
			end
			-- (체인샷, 신고 2026-08-13) 키를 뗀 시각을 남긴다 - 발사 뒤에 한 번 뗐다면 다음 누름은
			-- 자동 반복이 아닌 **새 누름**이므로 0.3초 유예 없이 곧바로 당기기로 넘어간다.
			if slotUp ~= nil and slotUp.name == "체인샷" then
				self._T.chainKeyUpAt = _UtilLogic.ElapsedSeconds
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void BlinkSlotReady(string slotPos)
		-- 쿨타임이 다 돌아 다시 사용할 수 있게 되면 그 슬롯 아이콘을 2번 깜빡여 알린다(모든 쿨타임 스킬 공통).
		-- 어둡게(알파 0.25) → 밝게 → 어둡게 → 밝게 순서로 0.15초 간격 토글 = 깜빡임 2회.
		if slotPos == nil or slotPos == "" then return end
		local icon = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar/Slot_" .. tostring(slotPos) .. "/Icon")
		if not isvalid(icon) then return end
		local spr = icon.SpriteGUIRendererComponent
		if not isvalid(spr) then return end
		local c = spr.Color
		local bright = Color(c.r, c.g, c.b, 1)
		local dim = Color(c.r, c.g, c.b, 0.25)
		spr.Color = dim
		_TimerService:SetTimerOnce(function() if isvalid(spr) then spr.Color = bright end end, 0.15)
		_TimerService:SetTimerOnce(function() if isvalid(spr) then spr.Color = dim end end, 0.3)
		_TimerService:SetTimerOnce(function() if isvalid(spr) then spr.Color = bright end end, 0.45)
	end

	-- 아대(가니어)를 장착 중인지. 인벤토리/장비는 클라이언트 전용 상태라 여기서만 판정할 수 있다.
	-- 럭키세븐 사용 가능 여부와 아대 기본공격(표창 투척) 분기가 같은 판정을 쓴다.
	@ExecSpace("ClientOnly")
	method boolean IsClawEquipped()
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) then return false end
		local costume = localPlayer.CostumeManagerComponent
		if not isvalid(costume) then return false end
		return costume:GetEquip(MapleAvatarItemCategory.TwoHandedWeapon) == "985e44451afc4730a46eb206716e7ecf"
	end

	-- 아대 장착 상태를 서버(PlayerAttack)에 보고한다. 기본공격은 엔진이 서버에서 띄우는데
	-- 장비는 클라이언트에만 있어서, 상태가 바뀔 때 서버 플래그를 갱신해줘야 한다.
	-- 전투력도 같이 내려보낸다 - 아대 기본공격 데미지가 전투력 기반이라, 스킬을 한 번도 쓰지 않아
	-- SyncCombatPower가 불린 적 없는 상태에서도 최신 값이어야 하기 때문이다.
	@ExecSpace("ClientOnly")
	method void ClawStateTick(number delta)
		self._T.clawCheckTimer = (self._T.clawCheckTimer or 0) + delta
		if self._T.clawCheckTimer < 0.5 then return end
		self._T.clawCheckTimer = 0

		local on = self:IsClawEquipped()
		local changed = (self._T.clawEquippedReported ~= on)

		-- 장착 중에는 전투력/크리 스탯도 서버에 맞춰둔다. 단 **값이 실제로 바뀐 경우에만** 보낸다 -
		-- 매 주기마다 무조건 보내면 SyncCritDamage의 수신 로그가 2초마다 계속 찍혀 로그를 덮어버린다(실측).
		local cp, cr, cd = 0, 0, 0
		local statChanged = false
		if on then
			-- ⚠ 여기는 "시전"이 아니라 0.5초마다 도는 상태 동기화라 **Peek**을 써야 한다.
			--   GetEffectiveCombatPower는 다크사이트를 푸는 부수효과가 있어(공격 동작 판정), 이 틱에서
			--   쓰면 아대를 낀 채 은신하는 순간 곧바로 풀려버린다.
			cp = self:PeekEffectiveCombatPower()
			cr = self:GetEffectiveCritRate()
			cd = _CharInfoManager:CalcCritDamage()
			statChanged = (self._T.clawSentCP ~= cp) or (self._T.clawSentCR ~= cr) or (self._T.clawSentCD ~= cd)
		end
		if not changed and not statChanged then return end

		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end

		if changed then
			self._T.clawEquippedReported = on
			pa:SetClawEquipped(on)
			-- (버그 수정 2026-08-12) 표창 효과(공격력/크확/공속)가 아대 장착 시에만 붙도록 바뀌었으므로,
			-- 장착 상태가 바뀌는 이 순간 상시 보너스를 다시 계산해야 한다(안 하면 아대를 껴도 다음
			-- 스킬 투자 때까지 표창 공격력이 반영되지 않는다).
			self:ApplyShurikenAttackBonus()
			log("[SkillManager] 아대 장착 상태 서버 반영: " .. (on and "ON(기본공격=표창)" or "OFF"))
		end
		if on and statChanged then
			self._T.clawSentCP = cp
			self._T.clawSentCR = cr
			self._T.clawSentCD = cd
			pa:SyncCritRate(cr)
			pa:SyncCritDamage(cd)
			pa:SyncCombatPower(cp)
		end
	end

	-- ── 표창+ (던질 표창 선택) ────────────────────────────────────────────
	-- 시전하면 캐릭터 주변에 고를 수 있는 표창들이 원형으로 뜨고, 아이콘 옆 번호키로 3초 안에 고른다.
	-- 고른 표창은 럭키세븐 / 아대 기본공격이 던지는 표창 모습이 되고 DataStorage에 저장된다.

	-- (표창+ 4분할) 지금 열려 있는 표창 개수. 차수별 표창+ 스킬의 투자 포인트가 각자의 해금 지점에
	-- 도달한 만큼 **1번부터 순서대로** 열린다(ShurikenLibrary.GetTiers 참고).
	@ExecSpace("ClientOnly")
	method integer GetUnlockedShurikenCount()
		local n = 0
		for _, tier in ipairs(_ShurikenLibrary:GetTiers()) do
			local lv = self:GetHeroSkillLevelByName(tier.name)
			for _, need in ipairs(tier.points) do
				if lv >= need then n = n + 1 end
			end
		end
		if n > _ShurikenLibrary:GetCount() then n = _ShurikenLibrary:GetCount() end
		return n
	end

	-- (표창+ 4분할) 이 이름이 표창+ 계열(4종 중 하나)인가 - 시전 분기/슬롯 표시가 함께 본다.
	@ExecSpace("ClientOnly")
	method boolean IsShurikenPlusSkill(string skillName)
		for _, tier in ipairs(_ShurikenLibrary:GetTiers()) do
			if tier.name == skillName then return true end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method integer GetShurikenSkillLevel()
		-- 스킬 목록에서 "표창+"에 투자된 포인트(=레벨)를 읽는다. 없으면 0.
		for _, tab in pairs(self._T.skillData or {}) do
			for _, s in ipairs(tab) do
				if s.name == "표창+" then return math.floor(s.level or 0) end
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method integer GetBackstabSkillLevel()
		-- 스킬 목록에서 "백스탭"에 투자된 포인트(=레벨)를 읽는다. 없으면 0.
		-- 포인트 1당 뒤통수 추가 데미지 5%p(서버 PlayerAttack.ApplyBackstabBonus가 계산).
		for _, tab in pairs(self._T.skillData or {}) do
			for _, s in ipairs(tab) do
				if s.name == "백스탭" then return math.floor(s.level or 0) end
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method integer GetSelectedShuriken()
		-- 현재 선택된 표창 번호(1~9). 기본 1번(원래 럭키세븐 표창).
		local i = self._T.shurikenIndex or 1
		if i < 1 or i > _ShurikenLibrary:GetCount() then return 1 end
		return i
	end

	@ExecSpace("ClientOnly")
	method integer ShurikenKeyToIndex(KeyboardKey k)
		-- 숫자키(1~9) → 표창 번호. 그 외 키는 0.
		if k == KeyboardKey.Alpha1 then return 1 end
		if k == KeyboardKey.Alpha2 then return 2 end
		if k == KeyboardKey.Alpha3 then return 3 end
		if k == KeyboardKey.Alpha4 then return 4 end
		if k == KeyboardKey.Alpha5 then return 5 end
		if k == KeyboardKey.Alpha6 then return 6 end
		if k == KeyboardKey.Alpha7 then return 7 end
		if k == KeyboardKey.Alpha8 then return 8 end
		if k == KeyboardKey.Alpha9 then return 9 end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void OpenShurikenSelect()
		-- 표창+ 시전: 열려 있는 표창들을 캐릭터 주변에 띄우고 3초 제한을 건다.
		local unlocked = self:GetUnlockedShurikenCount()
		if unlocked <= 0 then
			log("[Shuriken] 표창+ 계열에 투자한 포인트가 없어 고를 수 있는 표창이 없다")
			return
		end
		-- (요청) 선택 중에 표창+를 한 번 더 쓰면 **토글로 닫는다**(고르지 않고 취소).
		-- 몸속으로 거둬들이는 연출을 태워 닫으므로 시간 초과와 같은 모습이 된다.
		if self._T.shurikenSelecting == true then
			if self._T.shurikenClosing ~= true then
				self._T.shurikenClosing = true
				log("[Shuriken] 표창+ 재사용 - 선택 취소(닫는 중)")
			end
			return
		end

		local ring = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring")
		if not isvalid(ring) then
			log_warning("[Shuriken] 선택 UI(Ring)를 찾을 수 없다")
			return
		end

		local all = _ShurikenLibrary:GetAll()
		for i = 1, _ShurikenLibrary:GetCount() do
			local slot = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/Slot" .. tostring(i))
			if isvalid(slot) then
				slot.Enable = (i <= unlocked)
				if i <= unlocked then
					local icon = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/Slot" .. tostring(i) .. "/Icon")
					if isvalid(icon) then
						icon.SpriteGUIRendererComponent.ImageRUID = all[i].icon
					end
					-- 지금 쓰고 있는 표창은 뱃지를 노란색으로 표시해 구분한다.
					local badge = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/Slot" .. tostring(i) .. "/KeyBadge")
					if isvalid(badge) then
						if i == self:GetSelectedShuriken() then
							badge.SpriteGUIRendererComponent.Color = Color(0.95, 0.75, 0.20, 1.0)
						else
							badge.SpriteGUIRendererComponent.Color = Color(0.20, 0.62, 0.83, 1.0)
						end
					end
				end
			end
		end

		self._T.shurikenSelecting = true
		self._T.shurikenRemain = 3.0
		-- (요청) 표창들이 캐릭터 몸에서 **퍼져나갔다가**, 고르면 다시 **몸속으로 빨려들어가는** 연출.
		-- 0 = 몸속(중앙에 겹침), 1 = 원형으로 펼쳐진 상태.
		self._T.shurikenAnim = 0.0
		self._T.shurikenClosing = false
		ring.Enable = true
		self:UpdateShurikenRingPosition()
		self:ApplyShurikenSpread()
		log("[Shuriken] 표창 선택 시작 - " .. tostring(unlocked) .. "종 (레벨 " .. tostring(level) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void CloseShurikenSelect(boolean chosen)
		-- 선택 창을 닫는다(빨려듦 연출이 끝난 뒤 Tick이 호출한다).
		self._T.shurikenSelecting = false
		self._T.shurikenClosing = false
		local ring = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring")
		if isvalid(ring) then ring.Enable = false end
		-- 선택 이펙트도 함께 끈다(다음에 고를 때 다시 켜면서 재생된다).
		local fx = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/PickFx")
		if isvalid(fx) then fx.Enable = false end
	end

	-- 표창 하나가 펼쳐졌을 때 놓일 자리(링 반지름 128px 원 위, 12시부터 시계방향).
	-- (요청) 열린 표창 수가 적으면 그만큼 **각도를 벌려** 원을 고르게 채운다
	-- (9종이면 40도씩, 3종이면 120도씩). 펼침/빨려듦 연출에서 이 값에 진행도를 곱해 쓴다.
	@ExecSpace("ClientOnly")
	method Vector2 GetShurikenSlotPos(integer i, integer total)
		local n = total
		if n == nil or n < 1 then n = 1 end
		local ang = math.rad(90 - (i - 1) * (360 / n))
		return Vector2(128 * math.cos(ang), 128 * math.sin(ang))
	end

	@ExecSpace("ClientOnly")
	method void ApplyShurikenSpread()
		-- 진행도(0=몸속, 1=펼침)에 맞춰 표창들을 중앙↔제자리 사이에 배치한다.
		-- (요청) 퍼져나가는 중 / 몸쪽으로 들어오는 중에는 **네모 UI(아이콘 판때기·번호 뱃지)를 숨기고**
		-- 표창 그림만 날아다니게 한다. 다 펼쳐져 "고르는 상태"일 때만 판때기와 번호를 보여준다.
		local t = self._T.shurikenAnim or 0
		local settled = (t >= 1.0) and (self._T.shurikenClosing ~= true)
		local unlocked = self:GetUnlockedShurikenCount()
		for i = 1, unlocked do
			local base = "/ui/ShurikenSelectGroup/Ring/Slot" .. tostring(i)
			local slot = _EntityService:GetEntityByPath(base)
			if isvalid(slot) then
				local p = self:GetShurikenSlotPos(i, unlocked)
				slot.UITransformComponent.anchoredPosition = Vector2(p.x * t, p.y * t)
			end
			local frame = _EntityService:GetEntityByPath(base .. "/Frame")
			local badge = _EntityService:GetEntityByPath(base .. "/KeyBadge")
			local klbl  = _EntityService:GetEntityByPath(base .. "/KeyLabel")
			if isvalid(frame) then frame.Enable = settled end
			if isvalid(badge) then badge.Enable = settled end
			if isvalid(klbl)  then klbl.Enable  = settled end
		end
		-- 남은 시간 표시도 고르는 상태에서만 띄운다(연출 중에는 방해가 된다).
		local cd = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/Countdown")
		if isvalid(cd) then cd.Enable = settled end
	end

	@ExecSpace("ClientOnly")
	method void ChooseShuriken(integer idx)
		-- 번호키로 표창을 골랐을 때. 열려 있지 않은 번호는 무시한다.
		if self._T.shurikenClosing == true then return end
		local unlocked = self:GetUnlockedShurikenCount()
		if idx < 1 or idx > unlocked then
			log("[Shuriken] " .. tostring(idx) .. "번은 아직 열리지 않았다(현재 " .. tostring(unlocked) .. "종)")
			return
		end
		self._T.shurikenIndex = idx
		-- (표창+ 개편) 표창마다 공격력/크확/공속이 달라 고른 즉시 상시 효과를 다시 계산한다.
		self:ApplyShurikenAttackBonus()
		-- (요청) 퀵슬롯의 표창+ 칸도 방금 고른 표창 아이콘/개수로 바꾼다.
		self:RefreshShurikenSlotDisplay()
		-- (요청) 고른 표창 자리에서 선택 이펙트를 1회 재생한다.
		-- ⚠ Enable만 켜면 이미 끝난 클립이 다시 돌지 않을 수 있어, ImageRUID를 다시 넣어 재생을 되감는다.
		local fx = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/PickFx")
		if isvalid(fx) then
			local p = self:GetShurikenSlotPos(idx, unlocked)
			fx.UITransformComponent.anchoredPosition = p
			fx.Enable = true
			fx.SpriteGUIRendererComponent.ImageRUID = "0e35906499314071a510a886c92a1dde"
		end
		-- 바로 닫지 않고 "몸속으로 빨려들어가는" 연출을 먼저 재생한다(끝나면 Tick이 실제로 닫는다).
		self._T.shurikenClosing = true
		self:ReportShurikenToServer()
		-- 게임을 꺼도 유지되도록 캐릭터 세이브에 반영한다.
		_CharacterPersistence:MarkDirty("shuriken")
		local info = _ShurikenLibrary:Get(idx)
		log("[Shuriken] " .. tostring(idx) .. "번 " .. tostring(info.name) .. " 선택")
	end

	@ExecSpace("ClientOnly")
	method void AutoSelectShuriken(integer idx)
		-- (자동사냥, 요청 2026-08-06) 링 UI 연출 없이 표창을 조용히 갈아끼운다 -
		-- ChooseShuriken의 핵심 후처리(보정 재계산/표시/서버 보고/저장)만 그대로 수행한다.
		local unlocked = self:GetUnlockedShurikenCount()
		if idx < 1 or idx > unlocked then return end
		if self._T.shurikenIndex == idx then return end
		self._T.shurikenIndex = idx
		self:ApplyShurikenAttackBonus()
		self:RefreshShurikenSlotDisplay()
		self:RefreshShurikenCountLabels()
		self:ReportShurikenToServer()
		_CharacterPersistence:MarkDirty("shuriken")
		local info = _ShurikenLibrary:Get(idx)
		log("[Shuriken] 자동사냥 표창 교체 → " .. tostring(idx) .. "번 " .. tostring(info.name))
	end

	@ExecSpace("ClientOnly")
	method void UpdateShurikenRingPosition()
		-- 링을 캐릭터 화면 위치로 옮긴다("주변에 뜬다"는 요청 - 캐릭터를 따라다녀야 한다).
		local ring = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring")
		if not isvalid(ring) then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local wp = player.TransformComponent.WorldPosition
		local sp = _UILogic:WorldToScreenPosition(Vector2(wp.x, wp.y + 0.4))
		local up = _UILogic:ScreenToUIPosition(sp)
		ring.UITransformComponent.anchoredPosition = up
	end

	@ExecSpace("ClientOnly")
	method void ShurikenSelectTick(number delta)
		-- 선택 중 3초 카운트다운 + 링이 캐릭터를 따라가게 갱신. 시간이 다 되면 스킬이 취소된다.
		if self._T.shurikenSelecting ~= true then return end
		self:UpdateShurikenRingPosition()

		-- 펼침/빨려듦 연출(0.18초). 닫는 중이면 0으로, 아니면 1로 간다.
		local SPREAD_SEC = 0.18
		local t = self._T.shurikenAnim or 0
		if self._T.shurikenClosing == true then
			t = t - delta / SPREAD_SEC
			if t <= 0 then
				t = 0
				self._T.shurikenAnim = 0
				self:ApplyShurikenSpread()
				self:CloseShurikenSelect(true)
				return
			end
		else
			t = t + delta / SPREAD_SEC
			if t > 1 then t = 1 end
		end
		self._T.shurikenAnim = t
		self:ApplyShurikenSpread()

		-- 빨려들어가는 중에는 제한시간을 세지 않는다(이미 골랐다).
		if self._T.shurikenClosing == true then return end

		self._T.shurikenRemain = (self._T.shurikenRemain or 0) - delta
		local cd = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/Countdown")
		if isvalid(cd) then
			local r = self._T.shurikenRemain
			if r < 0 then r = 0 end
			cd.TextComponent.Text = string.format("%.1f", r)
		end
		if self._T.shurikenRemain <= 0 then
			-- 시간 초과도 같은 연출로 몸속에 거둬들이며 닫는다(고르지는 않았다).
			self._T.shurikenClosing = true
			log("[Shuriken] 3초 안에 고르지 않아 스킬 취소")
		end
	end

	@ExecSpace("ClientOnly")
	method void ReportShurikenToServer()
		-- 선택한 표창 번호를 서버로 보낸다 - 투사체를 스폰하는 쪽이 서버(PlayerAttack)라서 필요하다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SetShurikenIndex(self:GetSelectedShuriken())
	end

	-- (트레이닝 2026-08-07) 나이트로드 1차/3차 순수 공격력 패시브. 분배 1포인트당 1차 +2 / 3차 +4이고
	-- 두 스킬은 **합산**된다(양쪽 마스터 20 = +40 + +80 = +120).
	-- ⚠ 공식은 여기 한 곳에만 둔다 - 적용은 ApplyShurikenAttackBonus가 표창+ 보너스와 함께
	--   _CharInfoManager.skillAttackBonus에 통째로 대입한다(누적 아님).
	@ExecSpace("ClientOnly")
	method integer GetTrainingAttackBonus()
		-- 트레이닝 계열이 주는 총 공격력.
		return self:GetHeroSkillLevelByName("트레이닝") * 2
			+ self:GetHeroSkillLevelByName("트레이닝 II") * 4
	end

	-- ── 초보자 공용 패시브 3종 (요청 2026-08-12) ─────────────────────────────
	-- 전 직업 공통. 어느 쪽이 바뀌든(포인트 분배 / 세이브 복원 / 전직) 아래 Apply 한 곳만 다시 부르면 된다.
	@ExecSpace("ClientOnly")
	method number GetBeginnerDropRatePct()
		-- 아이템 감각: (요청 2026-08-15) 분배 1포인트당 **드롭률·메소 획득량 각 +0.5%**
		-- (마스터 200 = 각 +100% = 2배 - 상한은 구 사양 "1%/pt × 마스터 100"과 같다).
		-- 두 축이 같은 값이라 한 헬퍼를 공유한다(서버 SetDropRateBonusPct 하나로 둘 다 곱해진다).
		-- ⚠ 0.5 단위라 **정수가 아니다** - 반환형·RPC 인자형·서버 보관값이 전부 number여야 한다
		--   (integer로 두면 홀수 포인트에서 소수부가 잘려 절반이 조용히 증발한다).
		return 0.5 * math.max(0, self:GetHeroSkillLevelByName("아이템 감각"))
	end

	@ExecSpace("ClientOnly")
	method integer GetBeginnerWeaponAtk()
		-- 무기 숙련: 분배 1포인트당 공격력·마력 +1 (요청 2026-08-15 마스터 200 = +200).
		return math.max(0, self:GetHeroSkillLevelByName("무기 숙련"))
	end

	@ExecSpace("ClientOnly")
	method integer GetBeginnerAtkSpeedPct()
		-- 민첩 훈련: **5포인트당 공격 속도 +1%** (요청 2026-08-15 마스터 200 = +40%).
		return math.floor(math.max(0, self:GetHeroSkillLevelByName("민첩 훈련")) / 5)
	end

	-- (요청 2026-08-12 4차) HP/MP 자연 회복은 **더 이상 공짜가 아니다** - 초보자 스킬로 분리했다.
	-- 분배 1포인트당 1초에 최대치의 0.05%(요청 2026-08-15 마스터 200 = 초당 10%). 미분배면 **0% = 회복 없음**.
	-- ⚠ 종전에는 HP·MP 모두 초당 1% 고정이었다(PlayerHit.HpRegenPercentPerSecond /
	--   MpManager.regenPercentPerSecond의 기본값). 그 기본값을 0으로 내리고 여기서만 채워 넣는다.
	@ExecSpace("ClientOnly")
	method number GetBeginnerHpRegenPct()
		-- HP 회복: 초당 최대 HP의 몇 %를 채우는가.
		return 0.05 * math.max(0, self:GetHeroSkillLevelByName("HP 회복"))
	end

	@ExecSpace("ClientOnly")
	method number GetBeginnerMpRegenPct()
		-- MP 회복: 초당 최대 MP의 몇 %를 채우는가.
		return 0.05 * math.max(0, self:GetHeroSkillLevelByName("MP 회복"))
	end

	-- 초보자 패시브의 상시 효과를 한 번에 다시 계산해 반영한다(누적 아님 - 통째로 대입).
	@ExecSpace("ClientOnly")
	method void ApplyBeginnerPassives()
		_CharInfoManager.beginnerAtkSpdPct = self:GetBeginnerAtkSpeedPct()
		-- MP 회복은 클라 전용 자원(MpManager)이라 여기서 바로 대입한다.
		_MpManager.regenPercentPerSecond = self:GetBeginnerMpRegenPct()
		-- HP는 서버 권한(PlayerComponent.Hp)이라 서버 PlayerHit으로 밀어준다.
		self:RequestSyncHpRegen(self:GetBeginnerHpRegenPct())
		-- (요청 2026-08-12) 무기 숙련은 **공격력·마력 둘 다** 올리므로 공마 공용 축에 담는다
		-- (표창 계열이 들어가는 skillAttackBonus는 공격력 전용).
		_CharInfoManager.commonAttackBonus = self:GetBeginnerWeaponAtk()
		-- 공격력/마력은 표창+·트레이닝과 같은 skillAttackBonus 경로를 공유하므로, 그 재계산 함수를
		-- 그대로 다시 태워 두 축이 서로 덮어쓰지 않게 한다(ApplyShurikenAttackBonus가 통째 대입식이다).
		self:ApplyShurikenAttackBonus()
		-- 드롭률은 서버 판정(Monster.Dead)이라 서버로 밀어준다(0.5 단위 소수 - number RPC).
		self:RequestSyncDropRatePct(self:GetBeginnerDropRatePct())
		-- ⚠ 스탯창 갱신은 위 ApplyShurikenAttackBonus가 이미 한다 - 여기서 또 부르면 한 프레임에
		--   25슬롯 스캔이 두 번 돌아 UpdateStats가 조용히 중단되는 전례(2026-08-12 분노 버프 아이콘)를 밟는다.
	end

	@ExecSpace("Server")
	method void RequestSyncHpRegen(number hpRegenPct)
		-- (요청 2026-08-12 4차) "HP 회복" 스킬의 초당 회복률(%)을 서버 PlayerHit에 반영한다.
		-- HP는 서버 권한이라 클라 타이머로는 못 채운다(HpRegenTick이 이 값을 읽는다).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerHit
		local phHR = player:GetComponent(PlayerHit)
		if not isvalid(phHR) then return end
		-- 안전 범위로 clamp - 클라 계산값이 어긋나도 이상한 회복률이 잡히지 않게 한다.
		-- ⚠ (요청 2026-08-15) 상한을 **마스터 200 = 초당 10%**에 맞춰 1.5 → 10으로 올렸다.
		--   이 clamp를 안 올리면 마스터 레벨만 200으로 늘려 봐야 31포인트부터 전부 1.5%로 잘려
		--   "포인트를 부어도 회복이 안 늘어난다"가 된다(스킬창 툴팁은 정상 표시돼 원인 찾기가 어렵다).
		phHR.HpRegenPercentPerSecond = math.max(0, math.min(hpRegenPct or 0, 10))
	end

	-- (개명 2026-08-15) RequestSyncDropRate → RequestSyncDropRatePct: 인자형이 integer → number로
	-- 바뀌었다(아이템 감각이 0.5%/pt가 되면서 소수가 들어온다). 서버 메서드 시그니처 변경은 개명이
	-- 안전하다는 이 프로젝트 관례(LEA-1102 회피, `*Lv`/`*Pct` 접미사)를 따른다.
	@ExecSpace("Server")
	method void RequestSyncDropRatePct(number dropPct)
		-- (요청 2026-08-12) 아이템 감각의 드롭률 보너스를 서버 PlayerAttack에 반영한다
		-- (몬스터 사망 시 Monster.Dead가 킬러의 이 값을 읽어 드랍 확률에 곱한다).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local paDR = player:GetComponent(PlayerAttack)
		if not isvalid(paDR) then return end
		paDR:SetDropRateBonusPct(dropPct)
	end

	@ExecSpace("ClientOnly")
	method void ApplyShurikenAttackBonus()
		-- (표창+ 4분할 2026-08-05) 상시 효과를 한 곳에서 통째로 다시 계산해 대입한다(누적 아님).
		--   ① 표창+ 계열 4종의 **투자 포인트 합** × 1 = 공격력
		--   ② 지금 고른 표창 종류의 공격력/크리티컬/공격속도(ShurikenLibrary.GetEffect)
		--   ③ (트레이닝 2026-08-07) 1차 트레이닝 ×2 + 3차 트레이닝 II ×4 = 공격력
		-- 어느 쪽이 바뀌든(포인트 분배 / 표창 교체 / 세이브 복원) 이 메서드만 다시 부르면 된다.
		local pts = 0
		for _, tier in ipairs(_ShurikenLibrary:GetTiers()) do
			pts = pts + self:GetHeroSkillLevelByName(tier.name)
		end
		-- (버그 수정 2026-08-12) 표창 효과(공격력/크확/공속)는 **아대를 장착했을 때만** 적용한다.
		-- 종전엔 무조건 더해서, 표창을 쓰지 않는 히어로 등에게도 기본 표창(1번)의 공격력 15가 상시로
		-- 붙었다(신고: "히어로인데 마력이 16이다" - 마력 줄이 분리되면서 공용 몫 15가 드러난 것).
		-- 표창+ 투자 포인트(pts)는 스킬 투자분이라 그대로 유지한다.
		local eff = { atk = 0, crit = 0, speed = 0 }
		if self:IsClawEquipped() then
			eff = _ShurikenLibrary:GetEffect(self:GetSelectedShuriken())
		end
		-- (요청 2026-08-12) 표창 계열(표창+ 투자·표창 효과·트레이닝)은 **공격력 전용**이다 - 마력은 올리지 않는다.
		-- 초보자 "무기 숙련"은 공격력·마력 둘 다 올리는 사양이라 별도 축(commonAttackBonus)으로 분리했다.
		_CharInfoManager.skillAttackBonus = pts * 1 + eff.atk + self:GetTrainingAttackBonus()
		_CharInfoManager.shurikenCritBonus = eff.crit
		_CharInfoManager.shurikenAtkSpeedStage = eff.speed
		-- 기본공격은 서버가 동기화해둔 값만 보므로 즉시 재동기화한다(발도술 중첩 프록과 같은 이유).
		self:SyncDarkSightStats()
		-- (버그 수정 2026-08-12) 스탯창이 열려 있으면 즉시 다시 그린다. 종전엔 이 함수가 값만 바꾸고
		-- 화면을 갱신하지 않아, 아대를 끼고 표창을 바꿔도 공격력/전투력/크리티컬 표시가 그대로였다(신고).
		-- 콤보 감시 틱(ComboRowWatchTick)은 구슬 수가 바뀔 때만 도는 경량 경로라 여기를 대신해주지 못한다.
		-- ⚠ UpdateStats는 25슬롯을 훑는 무거운 경로다 - 창이 열려 있을 때만, 한 번만 부른다.
		local cwS = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwS) and cwS.Enable then _CharInfoManager:UpdateStats() end
	end

	@ExecSpace("ClientOnly")
	method integer ExportShuriken()
		-- 캐릭터 세이브용 - 선택된 표창 번호.
		return self:GetSelectedShuriken()
	end

	@ExecSpace("ClientOnly")
	method void ImportShuriken(integer idx)
		-- 캐릭터 세이브 복원 - 선택된 표창 번호를 되돌리고 서버에도 알린다.
		if idx == nil or idx < 1 or idx > _ShurikenLibrary:GetCount() then idx = 1 end
		self._T.shurikenIndex = idx
		self:ReportShurikenToServer()
		self:ApplyShurikenAttackBonus()
		self:RefreshShurikenSlotDisplay()
		log("[Shuriken] 저장된 표창 복원: " .. tostring(idx) .. "번")
	end

	-- ── 표창 보유 개수(재고) ──────────────────────────────────────────────
	-- (요청 2026-08-05) 표창 2~9번은 **종류마다 최대 1000개**를 들고 다니며, 몬스터를 처치할 때마다
	-- 종류마다 2개씩 보충된다. 1번 표창(기본 표창)만 **무제한**이라 재고가 바닥나도 계속 던질 수 있다.
	-- 소모량: 럭키세븐 2 / 트리플 스로우 3 / 쿼드러플 스로우 4 / 쉐도우 파트너 100 / 어벤져 15.
	-- 지금 고른 표창이 모자라면 **번호를 하나씩 내려가며** 낼 수 있는 표창을 찾는다(끝은 무제한인 1번).
	--
	-- ⚠ 재고는 표창 선택 번호(shurikenIndex)와 같은 클라 상태다 - 세이브에도 같이 실린다
	--   (CharacterPersistence의 "SC\t<번호>\t<개수>" 라인).

	@ExecSpace("ClientOnly")
	method integer GetShurikenMax()
		-- 표창 한 종류당 보유 상한.
		return 1000
	end

	@ExecSpace("ClientOnly")
	method integer GetShurikenRefillPerKill()
		-- 몬스터 1마리 처치당 종류별 보충량.
		return 2
	end

	@ExecSpace("ClientOnly")
	method integer GetShurikenCount(integer idx)
		-- 표창 번호의 보유 개수. **1번은 무제한이라 -1**을 돌려준다(호출부에서 특별 취급).
		if idx == nil or idx <= 1 then return -1 end
		if self._T.shurikenCounts == nil then self._T.shurikenCounts = {} end
		return math.floor(self._T.shurikenCounts[idx] or 0)
	end

	@ExecSpace("ClientOnly")
	method void SetShurikenCount(integer idx, integer n)
		-- 보유 개수 지정(0~상한으로 clamp). 1번은 무제한이라 무시한다.
		if idx == nil or idx <= 1 then return end
		if self._T.shurikenCounts == nil then self._T.shurikenCounts = {} end
		local v = math.floor(n or 0)
		if v < 0 then v = 0 end
		local mx = self:GetShurikenMax()
		if v > mx then v = mx end
		self._T.shurikenCounts[idx] = v
	end

	@ExecSpace("ClientOnly")
	method void OnMonsterKilledForShuriken()
		-- 몬스터 처치 통보(서버 PlayerAttack.NotifyMonsterKilled) - 2~9번을 각각 2개씩 채운다.
		-- 이미 상한(1000)인 종류는 그대로 둔다.
		local add = self:GetShurikenRefillPerKill()
		local mx = self:GetShurikenMax()
		for i = 2, _ShurikenLibrary:GetCount() do
			local cur = self:GetShurikenCount(i)
			if cur < mx then
				self:SetShurikenCount(i, cur + add)
			end
		end
		-- 개수 표시(표창 선택 링 + 퀵슬롯 칸)를 즉시 갱신한다.
		self:RefreshShurikenCountLabels()
		self:RefreshShurikenSlotDisplay()
	end

	@ExecSpace("ClientOnly")
	method boolean TryConsumeShuriken(integer need)
		-- 표창 need개를 소모한다. 지금 고른 번호가 모자라면 **번호를 하나씩 내려가며** 낼 수 있는
		-- 표창을 찾아 그 번호로 갈아탄 뒤 소모한다(1번은 무제한이라 항상 성공한다).
		-- 반환값은 언제나 true지만, 나중에 "1번도 소모"로 바뀔 수 있어 호출부는 반환값을 확인한다.
		if need == nil or need <= 0 then return true end
		local idx = self:GetSelectedShuriken()
		while idx > 1 do
			if self:GetShurikenCount(idx) >= need then break end
			idx = idx - 1
		end
		if idx <= 1 then
			-- 1번(무제한)까지 내려왔다 - 선택만 1번으로 내리고 소모는 없다.
			if self:GetSelectedShuriken() ~= 1 then
				self._T.shurikenIndex = 1
				self:OnShurikenStockChanged("표창이 떨어져 1번 표창으로 바꿉니다.")
			end
			return true
		end
		if self:GetSelectedShuriken() ~= idx then
			self._T.shurikenIndex = idx
			self:OnShurikenStockChanged("표창이 떨어져 " .. tostring(idx) .. "번 표창으로 바꿉니다.")
		end
		self:SetShurikenCount(idx, self:GetShurikenCount(idx) - need)
		self:RefreshShurikenCountLabels()
		self:RefreshShurikenSlotDisplay()
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnShurikenStockChanged(string message)
		-- 표창이 떨어져 번호가 내려간 순간의 공통 후처리: 안내 + 서버 동기화 + 표시 갱신.
		_UIToast:ShowMessage(message)
		self:ReportShurikenToServer()
		self:ApplyShurikenAttackBonus()
		self:RefreshShurikenCountLabels()
		self:RefreshShurikenSlotDisplay()
		_CharacterPersistence:MarkDirty("shuriken")
		log("[SkillManager] " .. tostring(message))
	end

	-- 스킬 이름 → 표창 소모량. 표에 없는 스킬은 0(소모 없음).
	@ExecSpace("ClientOnly")
	method integer GetShurikenCostForSkill(string skillName)
		local costs = {
			["럭키세븐"] = 2,
			["트리플 스로우"] = 3,
			["쿼드러플 스로우"] = 4,
			["쉐도우 파트너"] = 100,
			["어벤져"] = 15,
		}
		-- (2026-08-07) 옛 마크 오브 어쌔신이 켜져 있을 때의 "표창 3종 소모 2배" 규칙은 스킬이
		-- 트레이닝(순수 공격력 패시브)으로 바뀌면서 함께 폐기했다.
		return costs[skillName] or 0
	end

	@ExecSpace("ClientOnly")
	method void RefreshShurikenCountLabels()
		-- 표창 선택 링의 슬롯마다 보유 개수를 적는다(1번은 무제한이라 "∞"). 링이 닫혀 있으면
		-- 엔티티만 조용히 갱신되고 다음에 열 때 그대로 보인다.
		for i = 1, _ShurikenLibrary:GetCount() do
			local lbl = _EntityService:GetEntityByPath("/ui/ShurikenSelectGroup/Ring/Slot" .. tostring(i) .. "/CountLabel")
			if isvalid(lbl) then
				local tc = lbl.TextComponent
				if isvalid(tc) then
					if i <= 1 then
						tc.Text = "∞"
						tc.FontColor = Color(1, 1, 1, 1)
					else
						local c = self:GetShurikenCount(i)
						tc.Text = tostring(c)
						-- 바닥나면 빨갛게 - 지금 고른 표창이 곧 내려간다는 신호.
						if c <= 0 then
							tc.FontColor = Color(1, 0.35, 0.35, 1)
						else
							tc.FontColor = Color(1, 1, 1, 1)
						end
					end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method table ExportShurikenCounts()
		-- 세이브용: { [번호] = 개수 } (2~9번만, 0개는 생략).
		local out = {}
		for i = 2, _ShurikenLibrary:GetCount() do
			local c = self:GetShurikenCount(i)
			if c > 0 then out[i] = c end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void ImportShurikenCounts(table counts)
		-- 세이브 복원: 없는 번호는 0으로 둔다.
		self._T.shurikenCounts = {}
		for i = 2, _ShurikenLibrary:GetCount() do
			self:SetShurikenCount(i, math.floor(tonumber((counts or {})[i]) or 0))
		end
		self:RefreshShurikenCountLabels()
		self:RefreshShurikenSlotDisplay()
	end

	@ExecSpace("ClientOnly")
	method string GetWeaponMotionClass()
		-- 파워스트라이크/슬래쉬블래스트 모션 분기용 무기 분류를 돌려준다.
		--   "spear"   = 창/폴암 (장비 이름에 "창" 또는 "폴암" 포함)
		--   "twohand" = 두손검 등 TwoHandedWeapon 슬롯 장착 무기
		--   "onehand" = 한손검 등 그 외
		-- 인벤토리/장비는 클라이언트 전용 상태라 여기(클라이언트)서만 판정할 수 있다.
		local weaponStr = _UIEquipInventoryManager:GetEquip(6)
		local wname = (weaponStr ~= "") and _UIEquipInventoryManager:ParseName(weaponStr) or ""
		if string.find(wname, "창") ~= nil or string.find(wname, "폴암") ~= nil then
			return "spear"
		end
		-- (버그 수정) "카알대검(한손검)을 끼었는데 두손검 모션이 나온다" - 아바타 TwoHandedWeapon 슬롯
		-- 점유 여부로 판정했더니, 무기를 한손검으로 바꿔도 두손 슬롯에 이전 무기 값이 남아 있어 twohand로
		-- 오판했다. 장착 슬롯 결정(DecoWindowManager)과 동일한 "장비창 무기 이름" 기반 판정으로 통일한다.
		if wname ~= "" and _UIEquipInventoryManager:IsOneHandedJobWeapon(wname) then
			return "onehand"
		end
		return "twohand"
	end

	-- 지금 장착한 무기가 **한손검**인가(공격속도 +2단계 보너스 판정 전용).
	-- ⚠ GetWeaponMotionClass() == "onehand"와 헷갈리지 말 것 - 그건 **모션** 분류라 우드완드/나무 스태프/
	--   후르츠 대거도 onehand다. 예전엔 속도 보너스가 그 값을 그대로 읽어서 비숍 완드만 껴도 공속이
	--   2단계 올랐다(신고 2026-08-08). 보너스는 팔라딘의 한손검(카알대검)만 받는다.
	@ExecSpace("ClientOnly")
	method boolean IsOneHandedSwordEquipped()
		-- 장비/인벤토리는 클라 전용 상태라 여기(클라)서만 판정할 수 있다(GetWeaponMotionClass와 동일).
		local weaponStr = _UIEquipInventoryManager:GetEquip(6)
		if weaponStr == "" then return false end
		local wname = _UIEquipInventoryManager:ParseName(weaponStr)
		return _UIEquipInventoryManager:IsOneHandedSwordWeapon(wname)
	end

	@ExecSpace("ClientOnly")
	method string FindBarPosForSkillName(string skillName)
		-- 지정한 스킬이 배정된 퀵슬롯 위치 접미사(Slot_<위치>)를 돌려준다(없으면 "").
		-- slotData는 "실제 키 → 슬롯" 매핑이라, 키를 찾은 뒤 GetBarPosForKey로 위치를 역조회한다.
		for key, slot in pairs(self._T.slotData or {}) do
			if slot ~= nil and slot.name == skillName then
				return self:GetBarPosForKey(key)
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void TryEnterSprintFromSkill()
		-- 러시 스킬 발동 시: 좌/우 방향키를 누르고 있으면 그 방향으로 질주 진입(안 누르고 있으면 무반응).
		-- (M2 자동사냥) 방향키 입력이 없어도 자동사냥 중이면 대상 방향으로 질주한다(먼 대상 접근 가속).
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			self:EnterSprint("left")
		elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			self:EnterSprint("right")
		elseif _AutoHuntManager:IsActive() then
			self:EnterSprint((_AutoHuntManager:GetAimDirX() < 0) and "left" or "right")
		end
	end

	@ExecSpace("ClientOnly")
	method void EnterSprint(string dir)
		-- swingT3 대시 자세로 이동속도 2배 질주. 방향키를 떼거나 공격/스킬 시 해제(SprintTick/OnKeyUp/UseSkillInSlot).
		-- (요청) 쿨타임 3초 - 발동한 순간부터 3초 동안 재발동 불가, 퀵슬롯에 블리자드 방식으로 표시된다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		-- (요청) 드래곤 라이딩 탑승 중에는 질주(러시)가 절대 발동되면 안 된다 - 앞으로 두 번 누르면
		-- 더블탭 질주가 걸려 sit 자세와 질주 자세가 섞여 모션이 꼬였다. 스킬 시전 경로와 방향키
		-- 더블탭 경로가 모두 이 메서드를 지나므로 여기서 한 번에 막는다.
		if self._T.dragonRideMounted == true then return end
		if self._T.sprintActive == true and self._T.sprintDir == dir then return end
		-- (리커버리 오로라) 오로라 범위 안에서는 모든 스킬 쿨타임이 무시된다 - 이하 각 스킬 쿨타임
		-- 게이트에 동일하게 적용. (피드백 2026-07-29) 확인 우회만으로는 "쓴 스킬이 쿨타임 걸린 상태"로
		-- 남았다 - 오로라 안에서 사용하면 쿨타임을 아예 걸지 않는다(타임스탬프 기록/퀵슬롯 표시 모두 생략).
		local inAuraDash = self:IsInRecoveryAura()
		if (self._T.dashCooldownUntil or 0) >= _UtilLogic.ElapsedSeconds and not inAuraDash then return end
		-- (요청 2026-08-09) 러시 시전 MP 5. ⚠ 쿨타임 세팅보다 **먼저** 판정해야 "쿨타임만 먹고
		-- 질주는 안 나가는" 일이 없다(텔레포트/파워스트라이크와 같은 관례).
		-- ⚠ 방향키 더블탭 질주도 같은 러시라 이 메서드를 지난다 - 여기 한 곳에서 소모해야
		--   더블탭으로 MP 없이 쓰는 우회가 생기지 않는다.
		if not _MpManager:TryConsumeMp(self:GetRushMpCost()) then
			log("[SkillManager] 러시: MP 부족(필요 " .. tostring(self:GetRushMpCost()) .. ")")
			return
		end
		if self._T.sprintActive == true then self:EndSprint() end
		if not inAuraDash then
			-- (스킬 효과 개편) 러시 쿨타임 = 투자 레벨 비례 3초 → 1초 (마스터 15)
			local dashCd = self:GetRushCooldownForLevel(self:GetHeroSkillLevelByName("러시"))
			self._T.dashCooldownUntil = _UtilLogic.ElapsedSeconds + dashCd
			-- 러시가 배정된 퀵슬롯 위치를 찾아 쿨타임 오버레이/카운트다운을 띄운다(블리자드와 동일한 표시).
			local dashBarPos = self:FindBarPosForSkillName("러시")
			if dashBarPos ~= "" then
				_DashCooldownUI:ShowCooldown(dashCd, dashBarPos)
			end
		end
		self._T.sprintActive = true
		self._T.sprintDir = dir
		self._T.sprintKeyEnum = (dir == "left") and KeyboardKey.LeftArrow or KeyboardKey.RightArrow
		-- 이동속도 2배는 서버에서 설정한다(클라이언트에서 InputSpeed를 직접 바꾸면 서버가 덮어써 무효).
		self:RequestSetSprintSpeed(true)
		if self._T.sprintTimerId ~= nil then _TimerService:ClearTimer(self._T.sprintTimerId) end
		self._T.sprintTimerId = _TimerService:SetTimerRepeat(function()
			self:SprintTick()
		end, 0.08)
		-- (요청) 질주 지속시간 0.4초 - 방향키를 계속 눌러도 0.4초 뒤 자동 해제된다.
		if self._T.sprintDurTimerId ~= nil then _TimerService:ClearTimer(self._T.sprintDurTimerId) end
		self._T.sprintDurTimerId = _TimerService:SetTimerOnce(function()
			self:EndSprint()
		end, 0.4)
		self:PlaySprintPose()
		log("[SkillManager] 질주 시작 dir=" .. dir)
	end

	@ExecSpace("ClientOnly")
	method void SprintTick()
		-- 질주 자세만 유지한다. 해제는 OnKeyUp(방향키 릴리즈)/공격/스킬이 담당한다
		-- (IsKeyPressed 폴링은 홀드 중에도 false로 읽혀 질주가 깜빡거리는 문제가 있어 사용하지 않는다).
		if self._T.sprintActive ~= true then return end
		self:PlaySprintPose()
	end

	@ExecSpace("ClientOnly")
	method void PlaySprintPose()
		-- 걷기 애니메이션에 덮이지 않게 swingT3 대시 자세(프레임 0~1)를 계속 재전송한다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local ar = player.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		local ev = ActionStateChangedEvent("swingT3", "swingT3", 1.0, SpriteAnimClipPlayType.Loop, 0, 1)
		body:SendEvent(ev)
	end

	@ExecSpace("ClientOnly")
	method void EndSprint()
		if self._T.sprintActive ~= true then return end
		self._T.sprintActive = false
		if self._T.sprintTimerId ~= nil then
			_TimerService:ClearTimer(self._T.sprintTimerId)
			self._T.sprintTimerId = nil
		end
		if self._T.sprintDurTimerId ~= nil then
			_TimerService:ClearTimer(self._T.sprintDurTimerId)
			self._T.sprintDurTimerId = nil
		end
		self:RequestSetSprintSpeed(false)   -- 서버에서 원래 이동속도로 복구
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			-- 남은 질주 자세 클립을 걷기/서기로 되돌린다(StateChangeEvent 유발).
			local sc = player.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end
		log("[SkillManager] 질주 해제")
	end

	@ExecSpace("Server")
	method void RequestSetSprintSpeed(boolean active)
		-- 질주 이동속도(2배) 적용/해제를 서버에서 처리한다.
		-- ⚠ (버그 수정 2026-08-07) 예전에는 "지금 InputSpeed를 유저별로 저장해뒀다가 그대로 되돌리는"
		--   방식이었다. 폭풍의 시(연사 중 걷기 가능, 이속 60%)처럼 **동시에 이동속도를 건드리는 스킬**과
		--   겹치면 질주가 이미 깎인 값을 원본으로 저장하고 폭풍의 시가 옛 원본을 덮어써서
		--   **기본 이동속도가 영구히 밀렸다**(신고: 체인샷·폭풍의 시를 오가면 영구히 빨라지거나 느려짐).
		--   이제 PlayerAttack의 공용 배율 장부(SetMoveSpeedFactor)에 "sprint" 항만 걸고 내린다 -
		--   InputSpeed에 실제로 값을 쓰는 곳은 PlayerAttack.RecomputeMoveJumpBuffs 한 곳뿐이다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SetMoveSpeedFactor("sprint", active and 2.0 or 1.0)
		log("[SkillManager] RequestSetSprintSpeed active=" .. tostring(active))
	end

	@ExecSpace("ClientOnly")
	method void TryDoubleJump()
		-- 더블 점프(1차): 공중에 떠 있기만 하면(점프든, 발판에서 떨어지는 중이든) 점프키를 한 번 더
		-- 눌러 앞으로 한 번 도약한다. 쿨타임 5초는 러시/블리자드와 같은 방식으로 퀵슬롯에 표시한다.
		-- (신궁 개편 2026-08-06) spendable 편입 - 포인트를 투자해야 쓸 수 있다(플래시 점프와 같은 관례).
		if self:GetHeroSkillLevelByName("더블 점프") <= 0 then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		-- 드래곤 라이딩 탑승 중에는 비행 조작과 섞이므로 발동하지 않는다(러시와 같은 이유).
		if self._T.dragonRideMounted == true then return end
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "DEAD" then return end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) then return end
		-- 유일한 사용 조건: 지금 공중에 떠 있을 것(발판 위면 그냥 평범한 점프로 넘긴다).
		if rb:IsOnGround() then return end
		local now = _UtilLogic.ElapsedSeconds
		local inAuraDj = self:IsInRecoveryAura()
		if (self._T.doubleJumpCooldownUntil or 0) > now and not inAuraDj then return end
		-- (요청 2026-08-13) MP 10 소모. ⚠ 쿨타임 세팅보다 먼저 - MP가 모자라 도약하지 못했는데
		--   쿨타임만 5초 도는 사고를 막는다(파워스트라이크와 같은 관례).
		if not _MpManager:TryConsumeMp(self:GetDoubleJumpMpCost()) then
			log("[SkillManager] 더블 점프: MP 부족(필요 " .. tostring(self:GetDoubleJumpMpCost()) .. ")")
			return
		end

		-- barPos는 아래 로그에서도 쓰므로 반드시 블록 밖에 선언한다(안쪽 local로 두면 로그에서 nil 참조).
		local barPos = self:FindBarPosForSkillName("더블 점프")
		if not inAuraDj then
			self._T.doubleJumpCooldownUntil = now + self:ApplyCooldownReduction(5.0)
			-- 퀵슬롯에 배정돼 있으면 그 칸에 쿨타임을 그린다(배정은 사용 조건이 아니다 - 러시와 동일하게
			-- 스킬 자체는 배정 여부와 무관하게 동작하고, 표시할 슬롯이 있을 때만 표시한다).
			if barPos ~= "" then
				_DoubleJumpCooldownUI:ShowCooldown(5.0, barPos)
			end
		end

		-- 방향: 방향키를 누르고 있으면 그쪽, 아니면 지금 바라보는 방향(텔레포트의 방향 결정과 동일한 방식).
		local dirX = 1
		local ctrl = player.PlayerControllerComponent
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			dirX = -1
		elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			dirX = 1
		elseif isvalid(ctrl) then
			dirX = (ctrl.LookDirectionX >= 0) and 1 or -1
		end

		self:RunDoubleJumpMove(dirX)
		self:RequestFireDoubleJump(dirX)
		log("[SkillManager] 더블 점프 발동 dirX=" .. tostring(dirX) .. " slot=" .. barPos)
	end

	@ExecSpace("ClientOnly")
	method void RunDoubleJumpMove(number dirX)
		-- 더블 점프의 도약. **반드시 클라이언트에서** 돈다 - 서버에서 플레이어를 움직이는 수단은 전부
		-- 무효/불안정하다(PlayerAttack.AttackRush 주석 참고).
		-- (실측) 공중에서 쓸 수 있는 수단은 RigidbodyComponent:SetForce 하나뿐이다 -
		--   · MovementComponent:Jump() / rb:JustJump(...) → 공중에서는 false를 돌려주고 아무 일도 없음
		--   · rb.MoveVelocity 대입                        → 공중에서 무효(궤적 변화 없음)
		--   · 매 틱 SetWorldPosition(돌진 방식)            → 앞으로 직선으로만 밀려 포물선이 안 나옴
		-- SetForce는 기존 낙하 속도를 "덮어쓰는" 형태라, 상승 중이든 하강 중이든 같은 도약이 나온다.
		-- 이후 낙하는 엔진 중력이 그대로 처리하므로 자연스러운 포물선을 그리며 내려온다.
		-- (실측 보정값) SetForce(5, 7) = 상승 약 1.3유닛 + 착지까지 앞으로 약 4.6유닛.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) then return end

		local DJ_FORCE_X = 4.5      -- 앞으로 미는 힘(포물선의 가로 속도 - 착지까지 유지된다)
		-- (요청) 도약 높이를 기존의 1/3로. 도약 높이는 초기 속도의 제곱에 비례하므로(h = v²/2g)
		-- 높이를 1/3로 줄이려면 힘을 1/3이 아니라 1/√3배 해야 한다: 7.0 / 1.732 ≈ 4.04.
		-- (실측) 힘 7.0일 때 상승 약 1.2유닛 → 힘 4.04면 약 0.4유닛.
		local DJ_FORCE_Y = 4.04     -- 도약 힘(기존 7.0 → 높이 1/3)

		local ctrl = player.PlayerControllerComponent
		if isvalid(ctrl) then ctrl.LookDirectionX = dirX end
		rb:SetForce(Vector2(dirX * DJ_FORCE_X, DJ_FORCE_Y))
		self:WatchDoubleJumpLanding()
	end

	@ExecSpace("ClientOnly")
	method void WatchDoubleJumpLanding()
		-- (요청) 착지한 뒤에는 더블 점프로 인한 이동이 더 이상 없어야 한다.
		-- SetForce로 준 가로 속도는 발판에 닿은 뒤에도 남아 관성으로 주욱 미끄러지므로(실측: 착지 후
		-- 약 0.6유닛 더 밀림), 발판에 닿는 순간 힘을 0으로 덮어쓰고 이동도 멈춘다.
		-- 방향키를 누르고 있었다면 PlayerController가 다음 프레임에 바로 다시 걷게 하므로 조작감에는
		-- 영향이 없다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) then return end
		if self._T.doubleJumpLandTimerId ~= nil then
			_TimerService:ClearTimer(self._T.doubleJumpLandTimerId)
			self._T.doubleJumpLandTimerId = nil
		end
		local elapsed = 0
		self._T.doubleJumpLandTimerId = _TimerService:SetTimerRepeat(function()
			elapsed = elapsed + 1 / 60
			local done = false
			if not isvalid(player) or not isvalid(rb) then
				done = true
			elseif elapsed >= 0.05 and rb:IsOnGround() then
				-- 착지: 남아있는 도약 관성을 지운다.
				rb:SetForce(Vector2(0, 0))
				local mv = player.MovementComponent
				if isvalid(mv) then mv:Stop() end
				done = true
				log("[SkillManager] 더블 점프 착지 - 관성 제거 x=" .. string.format("%.2f", player.TransformComponent.WorldPosition.x))
			elseif elapsed > 5.0 then
				-- 안전장치: 어떤 이유로도 착지를 못 잡으면 감시를 끝낸다.
				done = true
				log_warning("[SkillManager] 더블 점프 착지 감시 타임아웃")
			end
			if done and self._T.doubleJumpLandTimerId ~= nil then
				_TimerService:ClearTimer(self._T.doubleJumpLandTimerId)
				self._T.doubleJumpLandTimerId = nil
			end
		end, 1 / 60)
	end

	-- ── 플래시 점프(나이트로드·섀도어 3차, 2026-08-06 신설) ─────────────
	-- 위 더블 점프와 **완전히 같은 구조**다(공중에서 점프키 한 번 더 → SetForce 도약 → 착지 시 관성 제거).
	-- 다른 점은 두 가지뿐 -
	--   · 도약 힘이 분배 레벨로 커진다(GetFlashJumpForceUnit / GetFlashJumpForceScale).
	--   · (사용자 결정) 재사용 대기시간이 없다. 대신 "한 번 뜬 동안 1회"로 제한해 무한 비행을 막는다.
	-- 나이트로드/섀도어는 더블 점프를 배우지 않으므로 두 스킬이 같은 키에서 겹치지 않지만, 만에 하나
	-- 둘 다 가진 상태여도 OnKeyDown에서 플래시 점프가 먼저 시도되고 발동하면 더블 점프는 건너뛴다.

	@ExecSpace("ClientOnly")
	method boolean TryFlashJump()
		-- 발동했으면 true를 돌려준다. 안 배웠거나 조건이 안 맞으면 false → 호출부가 더블 점프로 넘긴다.
		local lv = self:GetHeroSkillLevelByName("플래시 점프")
		if lv <= 0 then return false end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return false end
		-- 드래곤 라이딩 탑승 중에는 비행 조작과 섞이므로 발동하지 않는다(더블 점프와 같은 이유).
		if self._T.dragonRideMounted == true then return false end
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "DEAD" then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) then return false end
		if rb:IsOnGround() then
			-- 발판 위 = 그냥 평범한 점프. 이 참에 "공중 1회" 권리를 다시 채운다 - 아래 착지 감시가
			-- 어떤 이유로 실패해도 다음 지상 점프에서 자가 복구된다.
			self._T.flashJumpUsedInAir = false
			return false
		end
		-- 쿨타임은 없지만 뜬 동안 한 번만 쓸 수 있다(착지해야 다시 찬다).
		if self._T.flashJumpUsedInAir == true then return false end
		-- (요청 2026-08-14 4차) MP 20 소모. ⚠ "한 번 뜬 동안 1회" 권리를 소모하기 **전에** 뺀다 -
		--   MP가 모자라 도약하지 못했는데 권리만 날아가는 사고를 막는다(더블 점프와 같은 관례).
		if not _MpManager:TryConsumeMp(self:GetFlashJumpMpCost()) then
			log("[SkillManager] 플래시 점프: MP 부족(필요 " .. tostring(self:GetFlashJumpMpCost()) .. ")")
			return false
		end
		self._T.flashJumpUsedInAir = true

		-- 방향: 방향키를 누르고 있으면 그쪽, 아니면 지금 바라보는 방향(더블 점프와 동일).
		local dirX = 1
		local ctrl = player.PlayerControllerComponent
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			dirX = -1
		elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			dirX = 1
		elseif isvalid(ctrl) then
			dirX = (ctrl.LookDirectionX >= 0) and 1 or -1
		end

		self:RunFlashJumpMove(dirX, lv)
		self:RequestFireFlashJump(dirX)
		-- 배정돼 있으면 퀵슬롯 아이콘을 한 번 깜빡여 "발동했다"는 신호만 준다(쿨타임 표시는 없다).
		local barPos = self:FindBarPosForSkillName("플래시 점프")
		if barPos ~= "" then self:BlinkSlotReady(barPos) end
		log("[SkillManager] 플래시 점프 발동 lv=" .. tostring(lv) .. " dirX=" .. tostring(dirX)
			.. " 힘단위=" .. string.format("%.0f", self:GetFlashJumpForceUnit(lv)) .. " slot=" .. barPos)
		return true
	end

	@ExecSpace("ClientOnly")
	method void RunFlashJumpMove(number dirX, integer lv)
		-- 도약 자체는 더블 점프(RunDoubleJumpMove)와 같은 방식 - **반드시 클라이언트에서** SetForce로
		-- 기존 낙하 속도를 덮어쓴다(공중에서 통하는 수단이 이것뿐인 이유는 RunDoubleJumpMove 주석 참고).
		-- 여기서만 다른 것은 힘에 곱하는 레벨 배율이다. 가로·세로에 같은 배율을 곱하므로 도약 높이는
		-- 배율의 제곱, 착지까지의 거리도 (가로 속도 × 체공 시간)이라 배율의 제곱으로 늘어난다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) then return end

		-- 기준값은 더블 점프와 같은 수치(= 요청에서 말한 "힘 5")다.
		local FJ_BASE_X = 4.5
		local FJ_BASE_Y = 4.04
		local scale = self:GetFlashJumpForceScale(lv)

		local ctrl = player.PlayerControllerComponent
		if isvalid(ctrl) then ctrl.LookDirectionX = dirX end
		-- ⚠ 낙하 중(점프 정점을 지나 떨어지는 타이밍)에 쓰면 못 올라가던 버그 수정.
		--   SetForce는 "속도를 덮어쓰는" 게 아니라 **힘**을 설정하는 API라, 누적된 하강 관성이 그대로
		--   남아 위로 주는 힘을 상쇄한다(그래서 자동사냥은 굳이 세로 속도가 0인 정점에서만 쐈다).
		--   PositionReset()으로 현재 위치 기준 이동 계산을 새로 시작해 하강 속도를 먼저 0으로 지운 뒤
		--   SetForce를 주면, 상승·정점·하강 어느 타이밍에 눌러도 같은 도약이 나온다.
		rb:PositionReset()
		rb:SetForce(Vector2(dirX * FJ_BASE_X * scale, FJ_BASE_Y * scale))
		self:WatchFlashJumpLanding()
	end

	@ExecSpace("ClientOnly")
	method void WatchFlashJumpLanding()
		-- 더블 점프와 같은 착지 감시. SetForce로 준 가로 속도는 발판에 닿은 뒤에도 남아 미끄러지므로
		-- 착지하는 순간 힘을 0으로 덮고 이동을 멈춘다. 동시에 "공중 1회" 권리를 다시 채운다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) then return end
		if self._T.flashJumpLandTimerId ~= nil then
			_TimerService:ClearTimer(self._T.flashJumpLandTimerId)
			self._T.flashJumpLandTimerId = nil
		end
		local elapsed = 0
		self._T.flashJumpLandTimerId = _TimerService:SetTimerRepeat(function()
			elapsed = elapsed + 1 / 60
			local done = false
			if not isvalid(player) or not isvalid(rb) then
				done = true
			elseif elapsed >= 0.05 and rb:IsOnGround() then
				rb:SetForce(Vector2(0, 0))
				local mv = player.MovementComponent
				if isvalid(mv) then mv:Stop() end
				self._T.flashJumpUsedInAir = false
				done = true
				log("[SkillManager] 플래시 점프 착지 - 관성 제거 x=" .. string.format("%.2f", player.TransformComponent.WorldPosition.x))
			elseif elapsed > 5.0 then
				-- 안전장치: 착지를 못 잡아도 권리는 돌려준다(안 그러면 영영 못 쓴다).
				self._T.flashJumpUsedInAir = false
				done = true
				log_warning("[SkillManager] 플래시 점프 착지 감시 타임아웃")
			end
			if done and self._T.flashJumpLandTimerId ~= nil then
				_TimerService:ClearTimer(self._T.flashJumpLandTimerId)
				self._T.flashJumpLandTimerId = nil
			end
		end, 1 / 60)
	end

	-- ── 속사(2차) ────────────────────────────────────────────────────
	-- 키를 누르고 있는 동안 0.5초마다 화살 한 발. 방향키로 조준 각도를 바꾸면 곧바로 튀지 않고
	-- 초당 RAPIDFIRE_TURN_SPEED(60도)씩 최단 방향으로 돌아가므로, 3시 → 12시로 바꾸면 그 사이 각도로도
	-- 화살이 나간다(요청). 각도 보간/발사 간격은 전부 시전한 클라이언트가 관리하고, 서버에는 한 발씩
	-- "이 각도로 쏴라"만 요청한다.

	@ExecSpace("ClientOnly")
	method void StartRapidFire(string key)
		-- 연사 시작. 이미 연사 중이면 무시한다(KeyDown 자동 반복/홀드 루프가 매 프레임 들어온다).
		if self._T.rapidFireActive == true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then return end
		-- (요청 2026-08-13) 폭풍의 시와 같은 MP 게이트 - MP를 다 쓴 채로 키를 계속 누르고 있으면
		-- KeyDown 자동 반복이 "시작 → 첫 틱에서 MP 부족으로 즉시 종료 → 다시 시작"을 매 프레임 되풀이해
		-- 이동 잠금/조준 고정만 깜빡인다. 한 발치도 없으면 시작 자체를 막는다(로그는 1초 1회).
		if _MpManager:GetCurrentMp() < self:GetRapidFireMpCost() then
			local nowMp = _UtilLogic.ElapsedSeconds
			if nowMp >= (self._T.rapidFireMpWarnAt or 0) then
				self._T.rapidFireMpWarnAt = nowMp + 1.0
				log("[SkillManager] 속사: MP 부족(화살 1발당 " .. tostring(self:GetRapidFireMpCost()) .. ") - 시작 취소")
			end
			return
		end
		-- 폭풍의 시 연사/스나이핑·피어싱 차지 중이면 먼저 끝낸다(이동 속도/이펙트가 서로 엉키지 않게).
		if self._T.hurricaneActive == true then self:EndHurricane() end
		if self._T.snipingActive == true then self:CancelSniping() end
		if self._T.piercingActive == true then self:CancelPiercing() end

		self._T.rapidFireActive = true
		self._T.rapidFireKey = key
		-- 시작 각도는 지금 바라보는 방향 그대로 **수평**(0도 / 180도).
		-- ⚠ (신고 2026-08-07) 예전엔 15도 위(15.0 / 165.0)로 쐈다 - 화살에 중력이 있던 시절
		--   "수평으로 쏘면 첫 발부터 처져 보인다"를 보정하려던 값이다. 같은 날 **곡사를 폐지**하면서
		--   (RapidFireProjectile.Gravity = 0) 그 보정이 그대로 남아 "방향키를 안 눌렀는데 살짝 위로
		--   쏜다"가 됐다. 중력을 되살릴 일이 생기면 이 값도 함께 되돌릴 것.
		local ctrl = player.PlayerControllerComponent
		local facingRight = (not isvalid(ctrl)) or ctrl.LookDirectionX >= 0
		self._T.rapidFireAngle = facingRight and 0.0 or 180.0
		self._T.rapidFireNextShotAt = 0    -- 첫 발은 즉시

		-- (요청) 연사 중에는 방향키가 조준 전용이 되도록 제자리에 고정한다.
		-- (버그 수정) 예전엔 여기 클라이언트에서만 ctrl.Enable=false를 했는데, PlayerControllerComponent의
		-- Enable은 서버가 들고 있는 @Sync 프로퍼티라 클라 쪽 대입이 곧바로 되돌려진다(실측: 연사 중
		-- ctrlEnable=true). 그래서 ↓키가 그대로 엔진의 앉기/눕기(ActionCrouch)로 흘러들어가
		-- "아래로 조준하면 캐릭터가 눕는" 문제가 생겼다. 실제 잠금은 서버(PlayerAttack.AttackRapidFire)가
		-- 매 발마다 걸고, 연사가 끝나면 RequestEndRapidFire로 되돌린다. 여기서는 즉시 반응을 위해
		-- 이동만 멈춘다.
		if isvalid(player.MovementComponent) then player.MovementComponent:Stop() end
		log("[SkillManager] 속사 시작 key=" .. tostring(key) .. " 시작각도=" .. tostring(self._T.rapidFireAngle))
	end

	-- (신고 2026-08-11) 자동사냥용 속사 버스트: "seconds초 동안 키를 누르고 있었던 것처럼" 연사한다.
	-- 자동사냥은 실제 키 입력이 없어 RapidFireTick의 heldSkillKeys 판정에 걸려 시작 즉시 종료됐다 -
	-- 자동 홀드 창을 열어 그 동안 키 없이 연사를 유지한다(창이 닫히면 Tick이 평소처럼 종료한다).
	-- (요청 2026-08-11 2차) "한 번 쓸 때 위나 아래로 화살을 흩뿌리며 쏘는 느낌" - 버스트 동안
	-- 조준각을 수평에서 위 또는 아래(랜덤) 40도까지 천천히 쓸어내리는 스윕을 건다. 스윕 각도
	-- 보간은 RapidFireTick이 담당한다(방향키 입력이 있으면 그쪽이 우선 - 수동 개입 존중).
	@ExecSpace("ClientOnly")
	method void AutoRapidFireBurst(string key, number seconds)
		local dur = math.max(0.5, seconds)
		self._T.rapidFireAutoHoldUntil = _UtilLogic.ElapsedSeconds + dur
		self:StartRapidFire(key)
		-- StartRapidFire가 수평 시작각(0/180)을 잡은 다음에 스윕 목표를 계산한다.
		local base = self._T.rapidFireAngle or 0
		local facingRight = (base > -90.0 and base < 90.0)
		local sweepUp = _UtilLogic:RandomDouble() < 0.5
		local offset = sweepUp and 40.0 or -40.0
		if not facingRight then offset = -offset end
		self._T.rapidFireAutoSweepTarget = base + offset
		self._T.rapidFireAutoSweepSpeed = 40.0 / dur   -- 버스트 전체에 걸쳐 40도를 훑는다
	end

	@ExecSpace("ClientOnly")
	method void EndRapidFire()
		-- 연사 종료: 이동 잠금을 풀고 남아있는 활 쏘기 자세를 서기/걷기로 되돌린다(질주 해제와 동일).
		if self._T.rapidFireActive ~= true then return end
		self._T.rapidFireActive = false
		self._T.rapidFireKey = ""
		self._T.rapidFireAutoHoldUntil = 0
		self._T.rapidFireAutoSweepTarget = nil
		-- 이동 잠금은 서버가 걸어둔 것이라 서버에서 풀어야 한다(클라에서 Enable=true를 대입해도 @Sync가 덮는다).
		self:RequestEndRapidFire()
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local sc = player.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end
		log("[SkillManager] 속사 종료")
	end

	@ExecSpace("ClientOnly")
	method number GetRapidFireTargetAngle()
		-- 지금 눌린 방향키 조합이 가리키는 목표 각도(도). 아무 방향키도 안 눌렸으면 9999를 돌려주고,
		-- 호출부는 그때 현재 각도를 그대로 유지한다(= 마지막 조준 각도로 계속 쏜다).
		-- 부수적으로 self._T.rapidFireAimInstant에 "이번 입력이 좌/우 전용인지"를 함께 기록한다 -
		-- (요청) 좌/우 전환은 서서히 돌지 않고 즉시 그 방향을 봐야 하는데, 호출부에서 입력을 또 읽으면
		-- 같은 프레임에 두 번 읽게 되어 판정이 갈릴 수 있어 여기서 한 번에 정한다.
		local left  = _InputService:IsKeyPressed(KeyboardKey.LeftArrow)
		local right = _InputService:IsKeyPressed(KeyboardKey.RightArrow)
		local up    = _InputService:IsKeyPressed(KeyboardKey.UpArrow)
		local down  = _InputService:IsKeyPressed(KeyboardKey.DownArrow)
		local dx = 0
		local dy = 0
		if left  then dx = dx - 1 end
		if right then dx = dx + 1 end
		if up    then dy = dy + 1 end
		if down  then dy = dy - 1 end
		self._T.rapidFireAimInstant = (dy == 0)
		if dx == 0 and dy == 0 then return 9999 end
		if dx == 0 then
			-- 순수 위/아래 입력: 12시(90도) / 6시(-90도)를 목표로 한다. 최단 경로로 도는 아래 보간과
			-- 맞물려, 3시에서 누르면 각도가 올라가고 9시에서 누르면 반대쪽으로 올라간다.
			if dy > 0 then return 90.0 end
			return -90.0
		end
		if dy == 0 then
			-- 순수 좌/우 입력: (피드백) 중력 낙하 때문에 완전 수평으로 쏘면 처져 보여서,
			-- 시작 각도와 동일하게 15도 위를 목표로 한다.
			if dx > 0 then return 15.0 end
			return 165.0
		end
		return math.deg(math.atan(dy, dx))
	end

	@ExecSpace("ClientOnly")
	method number StepAngleToward(number current, number target, number maxStep)
		-- current를 target 쪽으로 최대 maxStep(도)만큼 최단 방향으로 돌린 각도를 돌려준다.
		local diff = target - current
		while diff > 180 do diff = diff - 360 end
		while diff < -180 do diff = diff + 360 end
		if math.abs(diff) <= maxStep then return target end
		if diff > 0 then return current + maxStep end
		return current - maxStep
	end

	@ExecSpace("ClientOnly")
	method void RapidFireTick(number delta)
		-- 연사 유지: 매 프레임 조준 각도를 목표로 조금씩 돌리고, 0.5초마다 한 발씩 쏜다.
		if self._T.rapidFireActive ~= true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then
			self:EndRapidFire()
			return
		end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then
			self:EndRapidFire()
			return
		end
		-- 키를 떼면 종료(OnKeyUp이 heldSkillKeys를 false로 내린다).
		-- (신고 2026-08-11, 자동사냥) 자동사냥은 실제 키를 누르지 않아 heldSkillKeys가 항상 false다 -
		-- 시작 즉시 여기서 종료돼 "이동만 잠기고 화살은 안 나가는" 멈춤이 반복됐다(보마 2차 신고의 원인).
		-- AutoRapidFireBurst가 열어둔 자동 홀드 창(rapidFireAutoHoldUntil) 동안은 키 없이도 연사를 유지한다.
		local key = self._T.rapidFireKey or ""
		local rfAutoHold = (self._T.rapidFireAutoHoldUntil or 0) > _UtilLogic.ElapsedSeconds
		if key == "" or (self._T.heldSkillKeys[key] ~= true and not rfAutoHold) then
			self:EndRapidFire()
			return
		end

		-- 조준 각도 갱신.
		--  · 좌/우 입력(위아래가 섞이지 않은 순수 좌우) → (요청) 즉시 그 방향으로 꺾는다. 반대쪽을
		--    볼 때 각도가 천천히 넘어가면 그 사이에 엉뚱한 방향으로 화살이 나가기 때문.
		--  · 위/아래가 섞인 입력 → 초당 RAPIDFIRE_TURN_SPEED도로 서서히 돌린다.
		--    그 사이 중간 각도로도 화살이 나간다.
		-- (피드백) 조준 각도 회전 속도를 더 천천히 - 135 → 60(도/초).
		-- (요청 2026-08-07) 다시 **1.5배** - 60 → 90(도/초). 3시→12시(90도)에 1.0초.
		local RAPIDFIRE_TURN_SPEED = 90.0
		local targetAngle = self:GetRapidFireTargetAngle()
		if targetAngle < 9000 then
			if self._T.rapidFireAimInstant == true then
				self._T.rapidFireAngle = targetAngle
			else
				self._T.rapidFireAngle = self:StepAngleToward(self._T.rapidFireAngle or 0, targetAngle, RAPIDFIRE_TURN_SPEED * delta)
			end
		elseif rfAutoHold and self._T.rapidFireAutoSweepTarget ~= nil then
			-- (요청 2026-08-11) 자동사냥 버스트 스윕: 방향키 입력이 없으면 수평에서 위/아래 40도로
			-- 버스트 내내 천천히 훑는다 - "위나 아래로 화살을 흩뿌리며 쏘는" 부채꼴 연사.
			self._T.rapidFireAngle = self:StepAngleToward(self._T.rapidFireAngle or 0,
				self._T.rapidFireAutoSweepTarget, (self._T.rapidFireAutoSweepSpeed or 16.0) * delta)
		end

		-- (요청) 공격속도 2배 - 발사 간격 0.5초 → 0.25초(초당 4발).
		-- (요청 2026-08-07) 여기서 다시 **1.5배** - 0.25 → 0.1667초(초당 6발).
		-- ⚠ 활 쏘는 모션 재생속도도 같이 올려야 한 발 주기 안에 동작이 끝난다
		--   (PlayerAttack.AttackRapidFireLv가 atkMultiplier / 3 을 넘겨 재생속도를 3배로 잡는다).
		local RAPIDFIRE_SHOT_INTERVAL = 0.25 / 1.5
		local now = _UtilLogic.ElapsedSeconds
		if now >= (self._T.rapidFireNextShotAt or 0) then
			self._T.rapidFireNextShotAt = now + RAPIDFIRE_SHOT_INTERVAL
			self:FireRapidFireShot()
		end
	end

	@ExecSpace("ClientOnly")
	method void FireRapidFireShot()
		-- 지금 조준 각도로 화살 한 발을 서버에 요청한다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		-- (요청 2026-08-13) 속사는 **화살 1발당 MP 4**를 쓴다 - 발사 틱마다 여기서 소모하고, 모자라면
		-- 그 자리에서 연사를 끝낸다(빈손으로 자세만 유지하지 않게).
		-- ⚠ 이 판정은 메서드 **맨 앞**에 둔다 - 아래 GetEffectiveCombatPower는 부르는 것만으로
		--   다크사이트를 풀고 전투분석에 시전을 1회 집계하므로, 실제로 나가지 않을 발에는 부르면 안 된다.
		if not _MpManager:TryConsumeMp(self:GetRapidFireMpCost()) then
			log("[SkillManager] 속사: MP 부족(화살 1발당 " .. tostring(self:GetRapidFireMpCost()) .. ") - 연사 종료")
			self:EndRapidFire()
			return
		end
		-- 크리티컬 확률/데미지는 장비 잠재능력까지 반영된 클라이언트 전용 값이라 발사 직전에 동기화한다
		-- (다른 스킬이 UseSkillInSlot 초반에 하는 것과 같은 처리 - 속사는 그 경로를 타지 않는다).
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if pa ~= nil then
			pa:SyncCritRate(self:GetEffectiveCritRate())
			pa:SyncCritDamage(_CharInfoManager:CalcCritDamage())
			pa:SyncCombatPower(self:GetEffectiveCombatPower())
		end
		local rad = math.rad(self._T.rapidFireAngle or 0)
		-- ⚠ (보우마스터 개편 2026-08-07) 투자 위력 배율(GetSkillPowerMultiplier)은 UseSkillInSlot이
		--   **1회성**으로 예약하고 GetEffectiveCombatPower가 읽으면서 소거한다 - 홀드 연사는 첫 발만
		--   배율을 먹고 이후 발은 1.0이 되어 "첫 발만 세다"가 된다. 매 발마다 다시 예약한다.
		self._T.pendingSkillPowerMult = self:GetSkillPowerMultiplier("속사")
		local combatPower = self:GetEffectiveCombatPower()
		local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
		-- (보우마스터 개편) 화살 1발당 배율을 투자 레벨로 계산해 넘긴다(GetRapidFire*Percent 한 곳에서).
		local rfLv = math.max(1, self:GetHeroSkillLevelByName("속사"))
		self:RequestFireRapidFireLv(combatPower, atkMult, math.cos(rad), math.sin(rad),
			self:GetRapidFireMinPercent(rfLv) / 100, self:GetRapidFireMaxPercent(rfLv) / 100)
		log("[SkillManager] 속사 발사 각도=" .. string.format("%.1f", self._T.rapidFireAngle or 0)
			.. " Lv." .. tostring(rfLv))
	end

	@ExecSpace("Server")
	method void RequestFireRapidFireLv(number combatPower, number atkMultiplier, number dirX, number dirY, number rateMin, number rateMax)
		-- 속사 화살 한 발. ⚠ (보우마스터 개편 2026-08-07) 기존 RequestFireRapidFire에 인자를 더하지 않고
		-- 이름을 바꿨다(LEA-1102 회피 - 아이스 샷/스트레이프와 같은 관례).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireRapidFireLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireRapidFireLv: PlayerAttack component not found")
			return
		end
		pa:AttackRapidFireLv(combatPower, atkMultiplier, dirX, dirY, rateMin, rateMax)
	end

	-- ── 폭풍의 시(4차) ───────────────────────────────────────────────
	-- 키를 누르고 있는 동안 0.1초마다 화살 한 발(전투력의 80%). 에로우 블로우를 연속으로 날리는
	-- 분위기의 홀드 연사 스킬. 발사 각도는 항상 수평(바라보는 방향)이고, (피드백) 연사 중에도
	-- 이동속도 60%로 걸어다닐 수 있다(걷는 방향 = 발사 방향). 시전(prepare)→루프(keydown)
	-- 이펙트와 반복 사용음은 서버(PlayerAttack.BeginHurricane)가 홀드 시작/종료/방향전환
	-- 시점에 멀티캐스트로 관리한다.

	@ExecSpace("ClientOnly")
	method void StartHurricane(string key)
		-- 연사 시작. 이미 연사 중이면 무시한다(KeyDown 자동 반복이 매 프레임 들어온다).
		if self._T.hurricaneActive == true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then return end
		-- (신고 2026-08-13) MP를 다 쓴 채로 키를 계속 누르고 있으면 활 쏘는 모션만 무한 반복되던 것 차단.
		-- KeyDown은 누르고 있는 동안 자동 반복되므로 "시작 → 첫 틱에서 MP 부족으로 즉시 종료 → 다시 시작"
		-- 이 매 프레임 되풀이되고, 그 사이 시전 이펙트/사운드/모션만 계속 재생됐다. **시작 자체를 막는다**
		-- (한 발치도 없으면 애초에 홀드가 성립하지 않는다). 로그는 1초에 한 번만 남긴다.
		if _MpManager:GetCurrentMp() < self:GetHurricaneMpCost() then
			local nowMp = _UtilLogic.ElapsedSeconds
			if nowMp >= (self._T.hurricaneMpWarnAt or 0) then
				self._T.hurricaneMpWarnAt = nowMp + 1.0
				log("[SkillManager] 폭풍의 시: MP 부족(화살 1발당 " .. tostring(self:GetHurricaneMpCost()) .. ") - 시작 취소")
			end
			return
		end
		-- 속사 연사/스나이핑·피어싱 차지 중이면 먼저 끝낸다(이동 속도가 서로 엉키지 않게).
		if self._T.rapidFireActive == true then self:EndRapidFire() end
		if self._T.snipingActive == true then self:CancelSniping() end
		if self._T.piercingActive == true then self:CancelPiercing() end

		self._T.hurricaneActive = true
		self._T.hurricaneKey = key
		local ctrl = player.PlayerControllerComponent
		self._T.hurricaneDirX = ((not isvalid(ctrl)) or ctrl.LookDirectionX >= 0) and 1 or -1
		self._T.hurricaneNextShotAt = 0    -- 첫 발은 즉시
		-- (피드백) 연사 중에도 걸어다닐 수 있다 - 이동을 막지 않고 서버(BeginHurricane)가
		-- 이동속도만 60%로 낮춘다.
		self:RequestBeginHurricane(self._T.hurricaneDirX)
		log("[SkillManager] 폭풍의 시 시작 key=" .. tostring(key) .. " dirX=" .. tostring(self._T.hurricaneDirX))
	end

	-- (신고 2026-08-11) 자동사냥용 폭풍의 시 버스트 - AutoRapidFireBurst와 같은 규칙.
	@ExecSpace("ClientOnly")
	method void AutoHurricaneBurst(string key, number seconds)
		self._T.hurricaneAutoHoldUntil = _UtilLogic.ElapsedSeconds + math.max(0.5, seconds)
		self:StartHurricane(key)
	end

	@ExecSpace("ClientOnly")
	method void EndHurricane()
		-- 연사 종료: 서버에 이동속도(60%) 복원 + 이펙트/사운드 정지를 요청하고 자세를 되돌린다.
		if self._T.hurricaneActive ~= true then return end
		self._T.hurricaneActive = false
		self._T.hurricaneKey = ""
		self._T.hurricaneAutoHoldUntil = 0
		self:RequestEndHurricane()
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local sc = player.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end
		log("[SkillManager] 폭풍의 시 종료")
	end

	@ExecSpace("ClientOnly")
	method void HurricaneTick(number delta)
		-- 연사 유지: 키가 눌려있는 동안 0.2초마다 한 발씩 쏘고, 좌/우 방향키로 방향을 즉시 뒤집는다.
		if self._T.hurricaneActive ~= true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then
			self:EndHurricane()
			return
		end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then
			self:EndHurricane()
			return
		end
		-- 키를 떼면 종료(OnKeyUp이 heldSkillKeys를 false로 내린다).
		-- (신고 2026-08-11, 자동사냥) 속사와 같은 함정 - 자동사냥은 키를 누르지 않으므로 자동 홀드 창
		-- (AutoHurricaneBurst) 동안은 키 없이도 연사를 유지한다.
		local key = self._T.hurricaneKey or ""
		local huAutoHold = (self._T.hurricaneAutoHoldUntil or 0) > _UtilLogic.ElapsedSeconds
		if key == "" or (self._T.heldSkillKeys[key] ~= true and not huAutoHold) then
			self:EndHurricane()
			return
		end

		-- 좌/우 방향키로 발사 방향 즉시 전환(걸으면서 쏘므로 걷는 방향이 곧 발사 방향이 된다).
		local newDir = self._T.hurricaneDirX or 1
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			newDir = -1
		elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			newDir = 1
		end
		if newDir ~= self._T.hurricaneDirX then
			self._T.hurricaneDirX = newDir
			self:RequestFlipHurricane(newDir)
			log("[SkillManager] 폭풍의 시 방향 전환 dirX=" .. tostring(newDir))
		end

		-- (피드백) 발사 간격 0.2초 → 0.1초(초당 10발).
		local HURRICANE_SHOT_INTERVAL = 0.1
		local now = _UtilLogic.ElapsedSeconds
		if now >= (self._T.hurricaneNextShotAt or 0) then
			self._T.hurricaneNextShotAt = now + HURRICANE_SHOT_INTERVAL
			self:FireHurricaneShot()
			-- 걷기 애니메이션에 덮이지 않게 발사 주기에 맞춰 활쏘기 모션을 다시 건다
			-- (질주 자세 유지와 같은 클라이언트 Loop 방식 - 서버 Onetime 모션은 걷기를 뿌리박는다).
			-- ⚠ (신고 2026-08-13) FireHurricaneShot이 MP 부족으로 연사를 끝냈을 수도 있다 - 그때도 여기서
			--   모션을 다시 걸면 "화살은 안 나가는데 활 쏘는 자세만 반복"이 된다. 살아있을 때만 건다.
			if self._T.hurricaneActive == true then
				self:PlayHurricanePose(newDir)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayHurricanePose(number dirX)
		-- 활쏘기(shoot2) 모션을 Loop 타입으로 재생해 유지한다. 발사 주기(0.1초)와 한 사이클이
		-- 맞도록 5배속으로 돌린다(원본 길이 약 0.5초). 좌/우 시선도 발사 방향으로 맞춘다.
		-- (요청 2026-08-06) 신궁·보우마스터 계열 활 모션을 shoot1 → shoot2로 통일.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local ctrl = player.PlayerControllerComponent
		if isvalid(ctrl) then ctrl.LookDirectionX = dirX end
		local ar = player.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		local bowAct = self:GetLocalBowCastMotion()
		local ev = ActionStateChangedEvent(bowAct, bowAct, 5.0, SpriteAnimClipPlayType.Loop)
		body:SendEvent(ev)
	end

	@ExecSpace("ClientOnly")
	method void FireHurricaneShot()
		-- 지금 바라보는 방향으로 화살 한 발을 서버에 요청한다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		-- (요청 2026-08-13) 폭풍의 시는 **화살 1발당 MP 10**을 쓴다(초당 10발 = 초당 100). 속사와 같은
		-- 자리·같은 이유로 메서드 맨 앞에서 소모하고, 모자라면 그 자리에서 연사를 끝낸다.
		if not _MpManager:TryConsumeMp(self:GetHurricaneMpCost()) then
			log("[SkillManager] 폭풍의 시: MP 부족(화살 1발당 " .. tostring(self:GetHurricaneMpCost()) .. ") - 연사 종료")
			self:EndHurricane()
			return
		end
		-- 크리티컬 확률/데미지는 장비 잠재능력까지 반영된 클라이언트 전용 값이라 발사 직전에 동기화한다
		-- (속사 FireRapidFireShot과 동일한 처리).
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if pa ~= nil then
			pa:SyncCritRate(self:GetEffectiveCritRate())
			pa:SyncCritDamage(_CharInfoManager:CalcCritDamage())
			pa:SyncCombatPower(self:GetEffectiveCombatPower())
		end
		-- ⚠ 속사와 같은 이유로 매 발마다 투자 위력 배율을 다시 예약한다(1회성 예약이라 첫 발만 먹는다).
		self._T.pendingSkillPowerMult = self:GetSkillPowerMultiplier("폭풍의 시")
		local combatPower = self:GetEffectiveCombatPower()
		local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
		-- (보우마스터 개편) 화살 1발당 배율을 투자 레벨로 계산해 넘긴다(GetHurricane*Percent 한 곳에서).
		local hrLv = math.max(1, self:GetHeroSkillLevelByName("폭풍의 시"))
		self:RequestFireHurricaneLv(combatPower, atkMult, self._T.hurricaneDirX or 1,
			self:GetHurricaneMinPercent(hrLv) / 100, self:GetHurricaneMaxPercent(hrLv) / 100)
		log("[SkillManager] 폭풍의 시 발사 dirX=" .. tostring(self._T.hurricaneDirX or 1)
			.. " Lv." .. tostring(hrLv))
	end

	@ExecSpace("Server")
	method void RequestBeginHurricane(number dirX)
		-- 홀드 시작 - 서버가 모든 클라이언트에 시전 이펙트/반복 사운드 시작을 알린다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:BeginHurricane(dirX)
	end

	@ExecSpace("Server")
	method void RequestFlipHurricane(number dirX)
		-- 연사 중 좌/우 방향 전환 - 루프 이펙트를 새 방향으로 다시 붙인다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:FlipHurricane(dirX)
	end

	@ExecSpace("Server")
	method void RequestFireHurricaneLv(number combatPower, number atkMultiplier, number dirX, number rateMin, number rateMax)
		-- 폭풍의 시 화살 한 발. ⚠ (보우마스터 개편 2026-08-07) 기존 RequestFireHurricane에 인자를 더하지 않고
		-- 이름을 바꿨다(LEA-1102 회피).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireHurricaneLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireHurricaneLv: PlayerAttack component not found")
			return
		end
		pa:AttackHurricaneLv(combatPower, atkMultiplier, dirX, rateMin, rateMax)
	end

	@ExecSpace("Server")
	method void RequestEndHurricane()
		-- 연사 종료를 서버에 알려 이동속도를 되돌리고 이펙트/사운드를 멈춘다.
		-- 이 요청이 유실돼도 서버가 마지막 발사 1초 뒤에 스스로 복구한다(AttackHurricane의 토큰 가드).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:EndHurricaneHold()
	end

	-- ── 피어싱(3차 차지, 2026-08-06 신설) ────────────────────────────
	-- 스나이핑과 **완전히 같은 흐름**(StartXxx → XxxTick → ReleaseXxx / CancelXxx)이고 다른 점은
	-- 완충 시간(1초 - 스나이핑의 1/10)과 차지 단계가 없다는 것뿐이다. 기를 모으는 자세/이펙트는
	-- 서버(PlayerAttack.BeginPiercing)가 원본 클립 5프레임 고정 루프로 보여준다.

	-- (자동사냥 전용) 차지형 스킬을 "키를 누르고 있는 것"으로 취급하는 스위치.
	-- 자동사냥은 실제 키 입력 없이 UseSkillInSlot으로 차지를 시작하고 자기 타이머로 릴리즈하므로,
	-- 이 플래그가 없으면 차지 틱이 "키를 뗐다"고 보고 즉시 charge=0으로 발사해 버린다.
	-- 릴리즈/취소 경로가 스스로 내려주므로 자동사냥은 켜기만 하면 된다.
	@ExecSpace("ClientOnly")
	method void SetChargeAutoHold(string which, boolean on)
		if which == "sniping" then
			self._T.snipingAutoHold = on
		elseif which == "piercing" then
			self._T.piercingAutoHold = on
		end
	end

	@ExecSpace("ClientOnly")
	method void StartPiercing(string key)
		-- 차지 시작. 이미 차지 중이면 무시한다(KeyDown 자동 반복이 매 프레임 들어온다).
		if self._T.piercingActive == true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then return end
		-- 다른 홀드류 스킬과 겹치지 않게 먼저 끝낸다.
		if self._T.rapidFireActive == true then self:EndRapidFire() end
		if self._T.hurricaneActive == true then self:EndHurricane() end
		if self._T.snipingActive == true then self:CancelSniping() end

		self._T.piercingActive = true
		self._T.piercingKey = key
		self._T.piercingCharge = 0
		self._T.piercingHeartbeatAt = 0
		local ctrl = player.PlayerControllerComponent
		self._T.piercingDirX = ((not isvalid(ctrl)) or ctrl.LookDirectionX >= 0) and 1 or -1
		self:RequestBeginPiercing(self._T.piercingDirX)
		log("[SkillManager] 피어싱 차지 시작 key=" .. tostring(key) .. " dirX=" .. tostring(self._T.piercingDirX))
	end

	@ExecSpace("ClientOnly")
	method void CancelPiercing()
		-- 발사 없이 차지를 종료한다(사망/사다리/다른 스킬 사용 등).
		if self._T.piercingActive ~= true then return end
		self._T.piercingActive = false
		self._T.piercingKey = ""
		self._T.piercingAutoHold = false
		self:RequestCancelPiercing()
		self:ResetSnipingPosture()   -- 시위 당김 자세 해제는 스나이핑과 같은 경로를 쓴다
		log("[SkillManager] 피어싱 차지 취소")
	end

	@ExecSpace("ClientOnly")
	method void ReleasePiercing()
		-- 키를 뗐다 - 지금까지 모은 기 비율만큼 데미지를 실어 한 발 발사한다.
		if self._T.piercingActive ~= true then return end
		self._T.piercingActive = false
		self._T.piercingKey = ""
		self._T.piercingAutoHold = false
		local full = self:GetPiercingFullChargeSeconds()
		local t = math.min(1.0, (self._T.piercingCharge or 0) / full)
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			---@type PlayerAttack
			local pa = player:GetComponent(PlayerAttack)
			if pa ~= nil then
				pa:SyncCritRate(self:GetEffectiveCritRate())
				pa:SyncCritDamage(_CharInfoManager:CalcCritDamage())
				pa:SyncCombatPower(self:GetEffectiveCombatPower())
			end
		end
		local pcLv = math.max(1, self:GetHeroSkillLevelByName("피어싱"))
		self:RequestFirePiercingLv(self:GetEffectiveCombatPower(), t, self._T.piercingDirX or 1,
			self:GetPiercingMinPercent(pcLv) / 100, self:GetPiercingMaxPercent(pcLv) / 100)
		-- (요청 2026-08-07) 발사 후 0.7초 행동불가(후딜). 이동은 클라 권한이므로 여기서 컨트롤러를 끈다.
		-- ⚠ 자세 복구(ResetSnipingPosture)를 이 잠금 **뒤로** 미룬 것이 중요하다 - 잠금이 없던 시절
		--   IDLE→MOVE→IDLE 상태 튕김이 방향키 입력과 겹치면서 "누르지도 않은 점프"가 나갔다(신고).
		--   0.7초 동안은 쏜 자세를 그대로 유지하고, 조작이 풀리는 시점에 한 번만 자세를 되돌린다.
		self:LockPiercingRecovery(0.7)
		log("[SkillManager] 피어싱 발사 charge=" .. string.format("%.2f", t) .. " Lv." .. tostring(pcLv)
			.. " 기본배율=" .. tostring(math.floor(self:GetPiercingMinPercent(pcLv))) .. "~"
			.. tostring(math.floor(self:GetPiercingMaxPercent(pcLv))) .. "% 기배율=" .. string.format("%.1f", self:GetPiercingChargeMult(t)) .. "배")
	end

	@ExecSpace("ClientOnly")
	method void LockPiercingRecovery(number seconds)
		-- 피어싱 발사 후 후딜: seconds 동안 이동/스킬을 모두 막고, 풀리는 순간 자세를 한 번만 되돌린다.
		-- 세대 번호로 잠금이 겹칠 때 옛 예약이 먼저 풀어버리는 것을 막는다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local pcc = player.PlayerControllerComponent
		if isvalid(pcc) and pcc.Enable then
			pcc.Enable = false
		end
		if isvalid(player.MovementComponent) then player.MovementComponent:Stop() end
		-- 다른 스킬도 같은 시간 동안 막는다(공용 쿨다운 플래그).
		self._T.skillOnCooldown = true
		self._T.piercingLockGen = (self._T.piercingLockGen or 0) + 1
		local lockGen = self._T.piercingLockGen
		_TimerService:SetTimerOnce(function()
			if self._T.piercingLockGen ~= lockGen then return end
			self._T.skillOnCooldown = false
			-- ⚠ 순서가 중요하다: 자세 복구(IDLE→MOVE→IDLE 상태 튕김)를 **컨트롤러가 아직 꺼져 있는
			--   동안** 끝내고, 그 다음에 조작을 돌려준다. 튕김이 살아 있는 방향키 입력과 겹치면
			--   컨트롤러가 상태를 다시 평가하면서 누르지도 않은 점프/낙하 자세가 나갔다(신고 2026-08-07).
			self:ResetSnipingPosture()
			local p = _UserService.LocalPlayer
			if isvalid(p) then
				local pcc2 = p.PlayerControllerComponent
				if isvalid(pcc2) then pcc2.Enable = true end
			end
		end, seconds)
	end

	@ExecSpace("ClientOnly")
	method void PiercingTick(number delta)
		-- 차지 유지: 게이지 누적(완충 1초), 좌/우 방향 전환, 키를 떼면 발사.
		if self._T.piercingActive ~= true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then
			self:CancelPiercing()
			return
		end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then
			self:CancelPiercing()
			return
		end
		local key = self._T.piercingKey or ""
		if key == "" then
			self:CancelPiercing()
			return
		end
		-- ⚠ 자동사냥 홀드 예외 - 스나이핑과 같은 이유(SnipingTick 주석 참고).
		if self._T.heldSkillKeys[key] ~= true and self._T.piercingAutoHold ~= true then
			self:ReleasePiercing()
			return
		end

		-- 좌/우 방향키로 발사 방향 즉시 전환(기 모으는 이펙트도 함께 뒤집힌다).
		local newDir = self._T.piercingDirX or 1
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			newDir = -1
		elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			newDir = 1
		end
		if newDir ~= self._T.piercingDirX then
			self._T.piercingDirX = newDir
			self:RequestPiercingDir(newDir)
		end

		local full = self:GetPiercingFullChargeSeconds()
		self._T.piercingCharge = math.min(full, (self._T.piercingCharge or 0) + delta)

		-- 시위를 당긴 자세 유지(스나이핑과 같은 Loop 재전송 방식).
		self:PlaySnipingPose(self._T.piercingDirX or 1)

		-- 0.1초마다 서버에 게이지를 알린다 - 완충이 1초라 스나이핑(0.5초)보다 촘촘해야 바가 안 끊긴다.
		local now = _UtilLogic.ElapsedSeconds
		if now >= (self._T.piercingHeartbeatAt or 0) then
			self._T.piercingHeartbeatAt = now + 0.1
			self:RequestPiercingHeartbeat(self._T.piercingCharge)
		end
	end

	@ExecSpace("Server")
	method void RequestBeginPiercing(number dirX)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then pa:BeginPiercing(dirX) end
	end

	@ExecSpace("Server")
	method void RequestPiercingDir(number dirX)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then pa:SetPiercingDir(dirX) end
	end

	@ExecSpace("Server")
	method void RequestPiercingHeartbeat(number charge)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then pa:PiercingHeartbeat(charge) end
	end

	@ExecSpace("Server")
	method void RequestCancelPiercing()
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then pa:CancelPiercingHold() end
	end

	@ExecSpace("Server")
	method void RequestFirePiercingLv(number combatPower, number chargeRatio, number dirX, number rateMin, number rateMax)
		-- 피어싱 발사 요청. rateMin/rateMax = 투자 레벨별 기본 배율(기 배율은 서버가 chargeRatio로 곱한다).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFirePiercingLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFirePiercingLv: PlayerAttack component not found")
			return
		end
		pa:AttackPiercingLv(combatPower, chargeRatio, dirX, rateMin, rateMax)
	end

	-- ── 스나이핑(4차 차지) ───────────────────────────────────────────
	-- 키를 누르고 있으면 게이지가 차오르고(완충 10초), 떼면 게이지만큼 데미지를 실어 관통 화살
	-- 한 발을 쏜다(최대 10명, 전투력 500~600% → 완충 5000~6000%). 차지 단계는 3단계
	-- (0~4초/4~7초/7~10초)로, 단계마다 차지 이펙트/화살/슈팅 이펙트가 바뀐다. 차지 중에는
	-- 이동속도 50%로 걸을 수 있고(걷는 방향 = 발사 방향), 게이지 바와 % 숫자는 서버
	-- (PlayerAttack.BeginSniping)가 표시를 관리한다.

	@ExecSpace("ClientOnly")
	method void StartSniping(string key)
		-- 차지 시작. 이미 차지 중이면 무시한다(KeyDown 자동 반복이 매 프레임 들어온다).
		if self._T.snipingActive == true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then return end
		-- (요청 2026-08-13) MP 50 소모. ⚠ 발사(ReleaseSniping)가 아니라 **차지를 시작하는 순간** 낸다 -
		--   완충 10초를 다 모으고 나서야 MP 부족으로 거부되면 그 시간이 통째로 날아간다.
		--   차지를 취소(사망/사다리/다른 스킬)하면 이미 낸 MP는 돌려주지 않는다.
		if not _MpManager:TryConsumeMp(self:GetSnipingMpCost()) then
			log("[SkillManager] 스나이핑: MP 부족(필요 " .. tostring(self:GetSnipingMpCost()) .. ")")
			return
		end
		-- 다른 홀드류 스킬과 겹치지 않게 먼저 끝낸다.
		if self._T.rapidFireActive == true then self:EndRapidFire() end
		if self._T.hurricaneActive == true then self:EndHurricane() end

		self._T.snipingActive = true
		self._T.snipingKey = key
		self._T.snipingCharge = 0
		self._T.snipingStage = 0
		self._T.snipingHeartbeatAt = 0
		local ctrl = player.PlayerControllerComponent
		self._T.snipingDirX = ((not isvalid(ctrl)) or ctrl.LookDirectionX >= 0) and 1 or -1
		self:RequestBeginSniping(self._T.snipingDirX)
		log("[SkillManager] 스나이핑 차지 시작 key=" .. tostring(key) .. " dirX=" .. tostring(self._T.snipingDirX))
	end

	@ExecSpace("ClientOnly")
	method void CancelSniping()
		-- 발사 없이 차지를 종료한다(사망/사다리/다른 스킬 사용 등). 게이지/이펙트/속도만 정리한다.
		if self._T.snipingActive ~= true then return end
		self._T.snipingActive = false
		self._T.snipingKey = ""
		self._T.snipingAutoHold = false
		self:RequestCancelSniping()
		self:ResetSnipingPosture()
		log("[SkillManager] 스나이핑 차지 취소")
	end

	@ExecSpace("ClientOnly")
	method void ReleaseSniping()
		-- 키를 뗐다 - 지금까지 찬 게이지 비율만큼 데미지를 실어 한 발 발사한다.
		if self._T.snipingActive ~= true then return end
		self._T.snipingActive = false
		self._T.snipingKey = ""
		self._T.snipingAutoHold = false
		local t = math.min(1.0, (self._T.snipingCharge or 0) / 10.0)
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			---@type PlayerAttack
			local pa = player:GetComponent(PlayerAttack)
			if pa ~= nil then
				pa:SyncCritRate(self:GetEffectiveCritRate())
				pa:SyncCritDamage(_CharInfoManager:CalcCritDamage())
				pa:SyncCombatPower(self:GetEffectiveCombatPower())
			end
		end
		-- (신궁 개편) 기본 배율은 투자 레벨이 정하고(GetSniping*Percent), 게이지는 그 위에 곱해지는
		-- 별도 배율(GetSnipingChargeMult)이다 - 서버는 두 값을 그대로 곱하기만 한다.
		local snLv = math.max(1, self:GetHeroSkillLevelByName("스나이핑"))
		self:RequestFireSnipingLv(self:GetEffectiveCombatPower(), t, self._T.snipingDirX or 1, self._T.snipingStage or 0,
			self:GetSnipingMinPercent(snLv) / 100, self:GetSnipingMaxPercent(snLv) / 100)
		self:ResetSnipingPosture()
		log("[SkillManager] 스나이핑 발사 charge=" .. string.format("%.2f", t) .. " stage=" .. tostring(self._T.snipingStage or 0)
			.. " Lv." .. tostring(snLv) .. " 기본배율=" .. tostring(math.floor(self:GetSnipingMinPercent(snLv))) .. "~"
			.. tostring(math.floor(self:GetSnipingMaxPercent(snLv))) .. "% 게이지배율=" .. string.format("%.1f", self:GetSnipingChargeMult(t)) .. "배")
	end

	@ExecSpace("ClientOnly")
	method void ResetSnipingPosture()
		-- 차지 자세(시위 당김 고정 루프)를 서기/걷기로 되돌린다(질주 해제와 동일).
		-- 같은 상태로 ChangeState하면 무시되므로 MOVE를 한 번 거쳐야 고정 루프가 풀린다.
		-- ⚠ (신고 2026-08-07) **공중에서는 이 튕김을 하지 않는다** - 공중인데 MOVE/IDLE로 못박으면
		--   컨트롤러가 다음 프레임에 상태를 다시 평가하면서 점프/낙하 자세가 튀어나온다.
		--   공중이면 컨트롤러가 알아서 FALL/JUMP를 유지하므로 건드릴 필요도 없다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local rbReset = player.RigidbodyComponent
		if isvalid(rbReset) and not rbReset:IsOnGround() then return end
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
			sc:ChangeState("IDLE")
			sc:ChangeState("MOVE")
			sc:ChangeState("IDLE")
		end
	end

	@ExecSpace("ClientOnly")
	method void SnipingTick(number delta)
		-- 차지 유지: 게이지 누적, 단계(4초/7초) 전환, 좌/우 방향 전환, 키를 떼면 발사.
		if self._T.snipingActive ~= true then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then
			self:CancelSniping()
			return
		end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then
			self:CancelSniping()
			return
		end
		local key = self._T.snipingKey or ""
		if key == "" then
			self:CancelSniping()
			return
		end
		-- ⚠ (버그 수정 2026-08-06) 자동사냥은 실제 키를 누르지 않고 UseSkillInSlot으로 차지만 시작한 뒤
		--   자기 타이머로 ReleaseSniping을 부른다 - 그런데 heldSkillKeys가 false라 첫 틱에서 곧바로
		--   릴리즈돼 **charge=0.00으로 발사**되고 있었다. 자동사냥 홀드 중에는 이 판정을 건너뛴다.
		if self._T.heldSkillKeys[key] ~= true and self._T.snipingAutoHold ~= true then
			self:ReleaseSniping()
			return
		end

		-- 좌/우 방향키로 발사 방향 즉시 전환(차지 이펙트도 함께 뒤집힌다).
		local newDir = self._T.snipingDirX or 1
		if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			newDir = -1
		elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			newDir = 1
		end
		if newDir ~= self._T.snipingDirX then
			self._T.snipingDirX = newDir
			self:RequestSnipingStage(self._T.snipingStage or 0, newDir)
			log("[SkillManager] 스나이핑 방향 전환 dirX=" .. tostring(newDir))
		end

		-- 게이지 누적(완충 10초에서 고정).
		local cur = math.min(10.0, (self._T.snipingCharge or 0) + delta)
		self._T.snipingCharge = cur

		-- 단계 전환: 4초에 2단계, 7초에 3단계 이펙트로 교체.
		local stage = 0
		if cur >= 7.0 then
			stage = 2
		elseif cur >= 4.0 then
			stage = 1
		end
		if stage ~= (self._T.snipingStage or 0) then
			self._T.snipingStage = stage
			self:RequestSnipingStage(stage, self._T.snipingDirX or 1)
			log("[SkillManager] 스나이핑 차지 단계 → " .. tostring(stage + 1) .. "단계")
		end

		-- 시위를 당긴 자세 유지(질주 자세와 같은 Loop 재전송 방식).
		self:PlaySnipingPose(self._T.snipingDirX or 1)

		-- 0.5초마다 서버에 게이지를 알린다 - % 숫자 표시 갱신 + 하트비트(유실 시 서버 자가복구).
		local now = _UtilLogic.ElapsedSeconds
		if now >= (self._T.snipingHeartbeatAt or 0) then
			self._T.snipingHeartbeatAt = now + 0.5
			self:RequestSnipingHeartbeat(cur)
		end
	end

	@ExecSpace("ClientOnly")
	method void PlaySnipingPose(number dirX)
		-- 시위를 당긴 채 유지하는 자세 - shoot2 앞 2프레임 고정 루프(질주 PlaySprintPose 방식).
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local ctrl = player.PlayerControllerComponent
		if isvalid(ctrl) then ctrl.LookDirectionX = dirX end
		local ar = player.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		local bowAct = self:GetLocalBowCastMotion()
		local ev = ActionStateChangedEvent(bowAct, bowAct, 1.0, SpriteAnimClipPlayType.Loop, 0, 1)
		body:SendEvent(ev)
	end

	@ExecSpace("Server")
	method void RequestBeginSniping(number dirX)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:BeginSniping(dirX)
	end

	@ExecSpace("Server")
	method void RequestSnipingStage(number stage, number dirX)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SetSnipingStage(stage, dirX)
	end

