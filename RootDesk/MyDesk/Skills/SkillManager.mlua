@Logic
script SkillManager extends Logic

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 창 드래그 상태
		self._T.isDragging    = false
		self._T.dragOffsetX   = 0
		self._T.dragOffsetY   = 0
		-- 툴팁 상태
		self._T.hovering      = false
		self._T.pendingShow   = false
		self._T.hoverTabId    = "0"
		self._T.hoverDataIdx  = 0
		self._T.hoverRowIdx   = 0
		-- 스킬 쿨다운
		self._T.skillOnCooldown = false
		-- 블리자드 전용 쿨다운(20초) - 공용 쿨다운과 별개로 관리하고 퀵슬롯에 남은 시간을 표시한다.
		self._T.blizzardOnCooldown = false
		-- 텔레포트 전용 쿨다운 - 다른 스킬들의 공용 쿨다운(skillOnCooldown)과 분리해서, 다른 스킬의
		-- 모션/딜레이 중에도 텔레포트를 쓸 수 있게 한다.
		self._T.teleportOnCooldown = false
		-- 어썰터 스택형 충전(3초당 1스택, 최대 3스택) - "쿨타임 동안 아예 못 쓰는" 방식에서 "스택이
		-- 1개 이상이면 언제든 쓸 수 있는" 충전형으로 변경 (요청사항). 시작은 풀스택(3개)이다.
		self._T.assaulterStacks = 3
		self._T.assaulterMaxStacks = 3
		self._T.assaulterRechargeTimerId = nil
		-- 시전 진행 중(사라짐~착지 사이) 재시전 잠금 - 착지 즉시(OnAssaulterChainReady) 풀려서
		-- 딜레이 없이 어썰터만은 연속 시전할 수 있다 (요청사항).
		self._T.assaulterCastActive = false
		self._T.assaulterCastGuardSerial = 0
		-- 스킬 키 홀드 상태 (키를 누르고 있는 동안 쿨다운이 끝나면 자동으로 이어서 발동)
		self._T.heldSkillKeys = {}

		-- 스킬 드래그 상태
		self._T.isDraggingSkill = false
		self._T.dragSkillRUID   = ""
		self._T.dragSkillName   = ""
		self._T.dragSource      = ""  -- "window" | "bar"
		self._T.dragFromKey     = ""

		-- 클릭 배정 모드 (클릭 후 슬롯 클릭으로 배정)
		self._T.skillClickMode = false
		self._T.clickModeRUID  = ""
		self._T.clickModeName  = ""
		self._T.clickModeOrigin = ""   -- "window"(스킬창) | "keysetting"(키세팅 키) | "spare"(여분 슬롯)

		-- 퀵슬롯 위치(엔티티 접미사, 고정) 목록. 각 위치는 barKeys를 통해 임의의 키에 연결된다.
		self._T.barPositions = {"Q","W","E","R","1","2","3","4","T","U","V","X","A","S","D","F","5","6","7","8","G","H","J","L"}
		-- 위치 → 연결된 키 이름 (기본값: 위치 접미사와 동일). 퀵슬롯 리매핑(키세팅 창)으로 변경 가능.
		self._T.barKeys = {}
		for _, p in ipairs(self._T.barPositions) do
			self._T.barKeys[p] = p
		end

		-- 슬롯 데이터: 키 이름 → {ruid, name}. 임의 키를 허용하므로 비어있는 키는 nil일 수 있다.
		self._T.slotData = {}
		local allKeys = self._T.barPositions

		-- 탭/스크롤 상태
		self._T.activeSkillTab        = "0"
		self._T.skillScrollRow        = 0
		self._T.isDraggingSkillThumb  = false
		self._T.skillThumbDragOffsetY = 0.0
		self._T.isHoldingSkillTrack   = false
		self._T.skillTrackTimer       = 0.0
		self._T.skillWheelAccum       = 0.0

		-- "+" 버튼이 이번 누름에서 이미 소비됐는지(뗄 때 풀린다). 누름 1회 = 1포인트 보장용.
		self._T.plusConsumed = false

		-- 표창+로 고른 표창 번호(1~9). 기본 1번 = 원래 럭키세븐 표창.
		-- 캐릭터 세이브에서 복원되면 ImportShuriken이 덮어쓴다.
		self._T.shurikenIndex = 1
		self._T.shurikenSelecting = false

		-- 스킬 포인트(SP). 스킬창 우측 위에 표시하고, spendable 스킬 카드의 "+" 버튼으로 분배한다.
		-- ⚠ 현재는 **테스트용으로 접속할 때마다 100개**를 지급한다(저장하지 않는다).
		--   레벨업/전직으로 지급하고 DataStorage에 저장하는 것은 이후 작업.
		self._T.skillPoint = 100

		-- 스킬 데이터 (탭별) — 원작처럼 "기본(0)/I/II/III/IV/H/V/VI" 8개 탭 구성.
		-- 기본(0) 탭 = 달팽이 세마리, I~IV 탭 = 1~4차 스킬(기존 목록 복원), H/V/VI 탭은 아직 비어있음.
		self._T.skillData = {
			["0"] = {
				{ ruid = "0e3a7c540e494b41b34c853eadab0d7e", name = "달팽이 세마리", level = 1, desc = "달팽이 3마리를 소환한다.\n일정 시간 후 사라진다." },
			},
			["1"] = {
				{ ruid = "5c61ff8df1544c05a200e598ea9164ce", name = "파워스트라이크", level = 1, desc = "무기로 적을 강하게 내려친다." },
				{ ruid = "362ae7fa63104016a89c5172d6c76efd", name = "러시",           level = 1, desc = "방향키를 누른 채 사용하거나 방향키를 두 번 눌러 질주한다.\n질주 자세로 이동속도가 2배가 되며,\n방향키를 떼거나 공격하면 풀린다.\n(아이콘은 임시 - 교체 가능)" },
			{ ruid = "2ba15e204ac64214a8144b0b2deeaf79", name = "가드",           level = 1, desc = "1초간 공격을 받아넘길 자세를 취한다.\n그 사이 공격을 받으면 피해를 무시하고\n2초간 무적이 된다.\n재사용 대기시간 20초(가드 성공 시 5초).\n(아이콘은 임시 - 교체 가능)" },
					{ ruid = "42e8d60e495a41bc94d4b3ac7ec022dc", name = "슬래시블러스트", level = 1, desc = "검을 휘둘러 전방의 적들을 베어낸다." },
					-- 더블샷: 화살/적중 이펙트는 직접 구해와 업로드했다(아이콘만 MSW 기본 리소스).
					-- 원본/RUID 대응표: msw-dev-tools/resources/더블샷/RUID.md
					{ ruid = "56144f55ece34e13b1aeeb6c102eb8b1", name = "더블샷",         level = 1, desc = "전방으로 화살 두 발을 동시에 발사한다.\n한 발당 전투력의 100%~150%\n피해를 입힌다." },
					-- 에로우 블로우: MSW 기본 리소스에 없어 직접 구해와 업로드한 아이콘/화살/적중 이펙트다
					-- (원본/RUID 대응표: msw-dev-tools/resources/에로우블로우/RUID.md).
					{ ruid = "444a92e6445241658af778f5e52cd770", name = "에로우 블로우", level = 1, desc = "전방으로 화살 한 발을 쏴서\n적 하나에게 전투력의 150%~200%\n피해를 입힌다." },
					-- 에로우 블로우 강화: 어드밴스드 스피어 버스터와 동일한 ON/OFF 토글 스킬이다.
					-- 전용 아이콘 리소스가 없어 임시로 에로우 블로우 아이콘을 그대로 쓴다(교체 가능).
					{ ruid = "444a92e6445241658af778f5e52cd770", name = "에로우 블로우 강화", level = 1, desc = "사용할 때마다 강화가 켜지고 꺼진다.\n강화 중에는 에로우 블로우가 적중 지점에서\n폭발해 적중 이펙트 3개가 시간차로 퍼지고,\n주변의 적을 최대 5명까지 시간차로 타격한다." },
					-- 더블 점프(1차): 공중(점프 상태)에서 점프키를 한 번 더 누르면 앞으로 한 번 날아간다.
					-- 아이콘/이펙트/사용음은 원본 팩 skill/3300.img/skill/33001102(더블 점프)의
					-- icon / effect / _audio/Use RUID를 그대로 쓴다(별도 업로드 없이 MSW 라이브러리에 존재).
					{ ruid = "e1d0cdbf977245e78b3381b106ac043c", name = "더블 점프",     level = 1, desc = "공중에서 점프키를 한 번 더 누르면\n바라보는 방향으로 한 번 더 도약해\n포물선을 그리며 날아간다.\n재사용 대기시간 5초." },
				{ ruid = "4e76419dd50a4ca99103118dd05e4628", name = "매직클로",       level = 1, desc = "마법의 힘을 담은 손톱으로 적을 할퀸다." },
					-- 매직 미사일(1차): 등 뒤 랜덤 위치에 마법 구체를 소환해 전방의 적을 조준한 뒤 발사하는
					-- 유도 미사일 스킬. 구체/발사 이펙트는 원본 팩 "와일드 발칸"(skill/3312.img/skill/33121214)의
					-- ball과 "트랜센던트: 빛"(skill/40000.img/skill/400001067)의 이펙트 클립을 사용하고,
					-- 아이콘은 와일드 발칸 아이콘을 임시로 쓴다(교체 가능).
					{ ruid = "8d8c512a0ff4466f8461ccffa67f3248", name = "매직 미사일",   level = 1, desc = "등 뒤에 마법 구체를 소환해\n전방의 적을 향해 발사한다.\n구체 하나당 전투력의 100%~150% 피해.\n20레벨에 구체 1개, 이후 10레벨마다\n1개씩 늘어난다(50레벨이면 4개).\n죽을 것으로 예측되는 적은 건너뛰고\n다음 적을 노린다.\n(아이콘은 임시 - 교체 가능)" },
				{ ruid = "92a5020c978c46bdabab910598118b86", name = "더블스탭",       level = 1, desc = "단검으로 적을 두 번 빠르게 찌른다." },
				{ ruid = "46b22e703399431d9ab0987233cac868", name = "럭키세븐",       level = 1, desc = "동전을 던져 여러 적을 공격한다." },
				-- 암행(1차 패시브): 스킬 1회 시전이 한 대상을 때리는 타수만큼 5% 확률을 굴려
				-- 적 주변에 그림자가 나타나 표창을 던진다(다수 대상으로 퍼진 같은 줄은 1번만 굴림).
				-- 그림자/스윙 모션은 원본 팩 skill/421.img/skill/4211008, 시작 이펙트는 skill/411.img/skill/4111002.
				-- 파이널어택과 같은 패시브 - 슬롯 배정 없이 항상 적용된다.
				-- (요청으로 상시 패시브 → ON/OFF 토글 전환. 기본 OFF - 슬롯에 배정해 쓰면 켜지고 꺼진다.)
				{ ruid = "6e463376315c4a4eb8f632bea7b4cd3b", name = "암행",           level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 한 대상을 때린 타수마다\n5% 확률로 주변의 적 하나에게 그림자가\n나타나 표창을 던진다.\n표창 하나당 전투력의 100%~200% 피해." },
				-- 다크사이트(1차, 2026-07-30 신설): 어둠에 몸을 숨기는 은신 버프.
				-- 아이콘은 원본 팩 skill/400.img/skill/4001003(다크사이트)의 icon,
				-- 시전 이펙트/전용 BGM은 요청받은 RUID를 그대로 쓴다.
				{ ruid = "0946f69d84464df29b24b94c744c868d", name = "다크사이트",     level = 1, desc = "어둠에 몸을 숨긴다.\n주변이 어두워지고 몸이 반투명해지며\n이동 속도가 50%로 줄어든다.\n숨어 있다가 처음 하는 공격은\n피해가 2배가 되고 무조건 크리티컬이\n되지만, 그 공격으로 은신이 풀린다.\n최대 160초 유지 / 재사용 대기시간 10초.\n(한 번 더 누르면 그냥 풀린다 -\n이때는 재사용 대기시간이 걸리지 않는다.)" },
				-- 표창+ : 스킬 포인트를 분배해 올리는 스킬. spendable = true 인 스킬만 카드에 "+" 버튼이 붙는다.
				-- 시전하면 캐릭터 주변에 표창 종류가 뜨고 1~9번 키로 고른다(3초 안에 못 고르면 취소).
				-- 고른 표창은 럭키세븐과 아대 기본공격이 던지는 표창 모습이 되고, 게임을 꺼도 저장된다.
				-- 아이콘은 원본 팩 skill/800016.img/skill/80001657("표창 던지기")의 icon.
				{ ruid = "a66f7a4983444b888f3a713b3eded36f", name = "표창+",         level = 0, maxLevel = 30, spendable = true, desc = "스킬 포인트를 분배해 올리는 스킬.\n포인트 1당 공격력이 2 오른다.\n3포인트마다 고를 수 있는 표창이\n1종씩 늘어난다(최대 9종 / 27포인트).\n\n사용하면 주변에 표창 종류가 뜨고\n표시된 번호키로 3초 안에 고른다.\n고른 표창은 럭키세븐과 아대 기본공격이\n던지는 표창이 되며 접속을 끊어도 유지된다.\n최대 30포인트." },
			},
			["2"] = {
				{ ruid = "e453c21d3cdf4477a54045c8a25e22f4", name = "파이널어택",     level = 1, desc = "일반 공격 시 확률적으로 추가 공격이 발동한다." },
				{ ruid = "fa1ce25dd5fb4f1ea0999086d26b38ce", name = "텔레포트",       level = 1, desc = "짧은 거리를 순간이동한다." },
				{ ruid = "5360e76224b14134b8bd00ede1d34e63", name = "썬더볼트",       level = 1, desc = "번개를 떨어뜨려 적을 공격한다." },
				{ ruid = "48f6c72aa48647e1b97b99afbc46ea17", name = "파이어에로우",   level = 1, desc = "화염이 담긴 화살을 발사한다." },
				{ ruid = "44b70137422f425eb486eb7cc5a92aec", name = "힐",             level = 1, desc = "대상의 HP를 회복시킨다." },
				-- 리스토네이션(2차, 2026-07-28 신설): 원본 팩 skill/121.img/skill/1211010의 아이콘/사용음.
				-- 몸쪽 이펙트는 요청으로 2cdfa53899d2462cb051e958a70b4747(팩 effect0 대신).
				-- 자기 자신만 대상으로 최대 HP의 50%를 즉시 회복한다. 쿨타임 10초(퀵슬롯 표기).
				{ ruid = "d4438020aa5544759a178d4a3cbf9105", name = "리스토네이션",   level = 1, desc = "몸에서 회복의 기운을 끌어올려\n5초 동안 1초마다 최대 HP의 10%씩,\n총 50%를 회복한다.\n재사용 대기시간 10초." },
				{ ruid = "5dc96ca0e6674dc1b301965cfed9f168", name = "에로우 봄",      level = 1, desc = "폭발하는 화살로 주변 적을 공격한다." },
				{ ruid = "0cfe777a9cd04df9bbb22a18a598e9b7", name = "아이언 에로우",  level = 1, desc = "강한 관통력을 가진 화살을 발사한다." },
				-- 홀리 에로우(2차, 2026-07-29 신설): 엔젤레이와 같은 구조(전방 고정 관통 화살)의 하위 버전.
				-- 아이콘/시전(effect0~6)/화살(ball0~2 애니메이션)/적중(hit0~2) 아트는 사용자 제공 클래식
				-- 원본을 직접 업로드했다(msw-dev-tools/resources/홀리에로우/RUID.md). 사용음/적중음은
				-- 라이브러리 팩 skill/230.img/skill/2301005 재사용.
				{ ruid = "ded9f8d0b8ba42d6af429e1653dfd039", name = "홀리 에로우",    level = 1, desc = "신성한 빛의 화살을 전방으로 발사한다.\n화살은 적을 최대 6명까지 관통하며\n대상당 전투력의 300%~400%\n피해를 입힌다." },
				-- 속사(2차): 키를 누르고 있는 동안 0.25초마다 화살이 계속 나간다(요청으로 공격속도 2배).
				-- 방향키로 조준 각도를 바꾸면 각도가 곧바로 튀지 않고 초당 90도씩 서서히 회전해,
				-- 3시와 12시 사이의 중간 각도로도 발사된다.
				-- 화살/적중 이펙트는 더블샷과 같은 아트를 쓰고, 아이콘은 임시로 MSW 라이브러리의
				-- "해달 궁술: 속사" 아이콘을 쓴다(교체 가능).
				{ ruid = "98e897de7be7419d947521aa8b800b59", name = "속사",           level = 1, desc = "키를 누르고 있는 동안 0.25초마다\n화살을 한 발씩 계속 발사한다.\n한 발당 전투력의 100%~150% 피해.\n쏘는 도중 방향키로 조준 방향을 바꾸면\n각도가 서서히 돌아간다(연사 중 이동 불가)." },
				-- 체인샷(2차): 8방향으로 체인을 쏴서 지형에 박고, 3초 안에 다시 누르면 그 각도로 당겨져
				-- 날아간다(이동 거리 = 벽까지 거리의 4/3배). 아트/아이콘/사용음은 원본 팩
				-- skill/6400.img/skill/64001012의 special / icon / _audio/Use.
				{ ruid = "9fc2311b651b494da1488fbd5c8e5f1f", name = "체인샷",         level = 1, desc = "8방향으로 체인을 발사한다.\n체인이 지형에 박히면 3초간 유지되고,\n그 사이 다시 누르면 박힌 곳으로\n당겨져 날아간다(거리의 4/3배).\n날아가며 지나친 적 최대 6명에게\n전투력의 50%~70% 피해.\n재사용 대기시간 2초." },
				-- 섬광(2차, 2026-07-28 신설): 체인샷과 같은 판정/데미지지만 연출이 다르다 - swingT2 모션 후
				-- 장착 무기와 같은 RUID의 검이 회전하며 날아가 벽에 박히고, 한 번 더 누를 필요 없이 즉시
				-- 그 방향으로 돌진해 땅 위에 안착한다. 돌진 중 검 위치를 지나면 검을 회수한다.
				{ ruid = "7cd06beb000a42b3af74ca9741aefb0e", name = "섬광",           level = 1, desc = "장착한 검을 회전시켜 던져 지형에\n박은 뒤, 즉시 그 방향으로 돌진해\n벽 위에 안착한다. 돌진 중 검을\n회수하며, 지나친 적 최대 6명에게\n전투력의 50%~70% 피해를 입힌다.\n재사용 대기시간 2초." },
				{ ruid = "e223bdc2a6cd46f98639e00b34083332", name = "헤이스트",       level = 1, desc = "5분간 이동 속도 40%, 점프력 20%를 증가시킨다." },
				{ ruid = "03b1da381bf046c68488fae4690e4f6f", name = "부스터",         level = 1, desc = "5분간 공격 속도가 1단계 상승한다." },
				-- 새비지블로우: MSW 기본 리소스에 없어 직접 구해와 업로드한 아이콘이다
				-- (원본/RUID 대응표: msw-dev-tools/resources/새비지블로우/RUID.md).
				{ ruid = "e4e5bf026b7c4976a1842de4418326ab", name = "새비지블로우",   level = 1, desc = "전방의 적 하나를 빠르게 6번 난도질한다.\n한 타당 전투력의 220%~300% 피해를 입힌다." },
				-- 2차 버프 3종: 아이콘/이펙트는 직접 구해와 업로드했다(원본/RUID 대응표는
				-- msw-dev-tools/resources/{분노,파워가드,메디테이션}/RUID.md).
				{ ruid = "a45e3d7aaeee453d934a451ba3e5cba5", name = "분노",           level = 1, desc = "5분간 공격력과 마력이 30 증가한다." },
				-- 불의 영역(2차 버프): 10분간 공격 적중 시 10% 확률로 그 자리에 화염 지대(10초, 2초당 전투력
				-- 200~300%). 아이콘은 임시로 시전 이펙트 클립 썸네일(전용 아이콘이 생기면 교체).
				{ ruid = "thumbnail://4a729e5b7b0f4759ba197dcbb1d25a8b", name = "불의 영역", level = 1, desc = "10분간 공격 적중 시 10% 확률로\n그 자리에 화염 지대를 만든다.\n화염 지대는 10초간 유지되며\n2초마다 전투력의 200%~300%\n피해를 준다." },
				-- 빙하지대(2차 버프): 불의 영역의 얼음 판 - 같은 지속/확률/데미지, 장판 비주얼은 눈결정 다수.
				-- 아이콘은 임시로 눈결정 클립 썸네일(전용 아이콘이 생기면 교체).
				{ ruid = "thumbnail://f69a8c62757a40c6bb0d5a8e6e903aab", name = "빙하지대", level = 1, desc = "10분간 공격 적중 시 10% 확률로\n그 자리를 빙하 영역으로 만든다.\n빙하 영역은 10초간 유지되며\n2초마다 전투력의 200%~300%\n피해를 준다." },
				-- 서먼 다크드래곤(2차 버프): 10분간 드래곤 소환수가 주변을 배회하며 2~4초마다 공격(전투력
				-- 200~300%), 20~30초마다 랜덤 버프(쿨타임 초기화/추가 소환/콤보어택/쉐도우파트너).
				-- 아이콘은 임시로 드래곤 idle 1프레임. 리소스: msw-dev-tools/resources/다크드래곤/RUID.md
				{ ruid = "7ac2730a18ac47e083a46dc5e879deac", name = "서먼 다크드래곤",  level = 1, desc = "10분간 다크드래곤을 소환한다.\n드래곤이 주변을 돌며 2~4초마다 공격하고\n20~30초마다 랜덤 버프를 걸어준다." },
				{ ruid = "0f17bf5d72934e91bc2c3f66505112a8", name = "메디테이션",     level = 1, desc = "5분간 공격력과 마력이 30 증가한다." },
				-- 블레스(2차 버프): 자신 + 힐 범위 안의 소환된 용사들 공마 +30. 아이콘/이펙트는 직접
				-- 구해와 업로드했다(원본/RUID 대응표: msw-dev-tools/resources/블레스/RUID.md).
				{ ruid = "476232fa1b5e4ce68268fb26a793eb7d", name = "블레스",         level = 1, desc = "5분간 자신과 주변에 소환된 영웅들의\n공격력과 마력이 30 증가한다.\n(범위는 힐과 동일하며, 한 번 받은\n버프는 거리와 무관하게 유지된다.)" },
				{ ruid = "130a612ff85c4eae9e9f52adb9d7d4a9", name = "파워가드",       level = 1, desc = "5분간 받는 피해의 30%를 HP로 회복하고\n공격력이 10 증가한다." },
				-- 패링(2차, 2026-07-28 개편): 시전 즉시 이펙트, 1.5초 안에 피격 시 가드 표시 + 피해 무시 +
				-- 3초 무적 + 0.5초 뒤 주변 최대 6명 반격. 쿨타임 10초, 가드 성공 시 쿨타임 초기화.
				{ ruid = "f7b8fd9fe52f43d78e25ef9695eeb046", name = "패링",           level = 1, desc = "즉시 검격을 내지르며 1.5초간 공격을\n받아넘길 자세를 취한다. 그 사이 공격을\n받으면 피해를 무시하고 3초간 무적이 되며,\n0.5초 뒤 주변의 적 최대 6명에게 전투력의\n500%~700% 피해를 입힌다.\n재사용 대기시간 10초(가드 성공 시 초기화)." },
				-- 백스탭(2차, 2026-07-30 신설): 몬스터가 바라보는 방향의 뒤쪽에서 때리면 데미지가 늘어난다.
				-- 표창+와 같은 spendable 스킬(카드 "+" 버튼으로 포인트 분배) - 20이 마스터이고 1포인트당
				-- 백스탭 추가 데미지가 5%p 늘어난다(마스터 = +100%, 즉 뒤에서 때리면 2배).
				-- (요청) 테스트 동안은 ON/OFF 토글이며, 나중에 "보유만 하면 항상 발동"으로 바꾼다.
				-- 전용 아이콘 리소스가 없어 원본 팩 skill/422.img/skill/4221017("크루얼 스탭")의 icon을
				-- 임시로 쓴다(교체 가능).
				{ ruid = "9001cf69223440d0b3cec6bc73acf251", name = "백스탭",         level = 0, maxLevel = 20, spendable = true, desc = "스킬 포인트를 분배해 올리는 스킬.\n몬스터가 바라보는 방향의 뒤쪽에서\n공격하면 추가 데미지를 준다.\n포인트 1당 추가 데미지가 5% 오른다\n(20 마스터 = 뒤에서 때릴 때 2배).\n\n테스트 중에는 사용할 때마다\n켜지고 꺼지는 토글 스킬이다." },
			},
			["3"] = {
				{ ruid = "efb2d49b00ea433d80379fa679614920", name = "포이즌 미스트",     level = 1, desc = "독 안개를 뿌려 범위 내 적에게 지속 피해를 입힌다." },
				{ ruid = "ddbe74e1d9bb496dae8dc7ab111aa57b", name = "익스플로젼",         level = 1, desc = "강력한 폭발을 일으켜 넓은 범위의 적에게 피해를 입힌다." },
				{ ruid = "3f93e7fe6b244027ad09611ce4f60415", name = "드래곤 로어",         level = 1, desc = "포효로 전방의 적을 밀쳐내며 피해를 입힌다." },
				{ ruid = "948d8f877f1349a38ab7111df06fd9b5", name = "스피어 버스터",       level = 1, desc = "창으로 넓은 범위의 적을 강타한다." },
				{ ruid = "73d6c63787a64b2c8d34373792b7e716", name = "디바인 스윙 강화",   level = 1, desc = "디바인 스윙의 위력을 강화한다." },
				{ ruid = "28e3b85f945347fa8209ec18b4bb296c", name = "디바인 스티그마 강화", level = 1, desc = "디바인 스티그마의 효과를 강화한다." },
				{ ruid = "8dbb1b41e92c4f8290402b9a7d51649d", name = "디바인 저지먼트 강화", level = 1, desc = "디바인 저지먼트의 효과를 강화한다." },
				{ ruid = "d714c4d5a90a43a7b5a7bfb3b49c4628", name = "콤보 어택",           level = 1, desc = "콤보 카운트를 쌓아 공격력을 증가시킨다." },
				{ ruid = "540d17412269428899086a8e62ca5aee", name = "패닉",               level = 1, desc = "콤보 구슬을 모두 소모해 대상 하나에게 강력한 피해를 입힌다.\n구슬이 없으면 사용할 수 없다." },
				{ ruid = "6a4b4c93ebf14ea1ad480a836c741205", name = "코마",               level = 1, desc = "강한 일격으로 적을 기절시킨다." },
				-- 트리플 스로우(3차, 2026-07-30 신설): 럭키세븐(2발)의 상위 - 표창을 3발 던진다.
				-- 데미지 숫자도 3줄, 쉐도우 파트너 중에는 6줄. 아이콘/시전 이펙트/타격 이펙트는
				-- 원본 팩 skill/40004.img/skill/400041017의 icon / effect / hit/0.
				-- 사용음·타격음은 럭키세븐과 같다(요청). 럭키세븐처럼 가니어(아대) 장착이 필요하다.
				{ ruid = "f6ba1caf12374f0fab2dc6de85568fdb", name = "트리플 스로우",       level = 1, desc = "표창을 연달아 3개 던진다.\n표창 하나당 전투력의 100%~150% 피해.\n데미지가 3줄로 표시되고\n쉐도우 파트너 중에는 6줄이 된다.\n가니어를 장착해야 사용할 수 있다." },
				{ ruid = "c6ce60523c954791af5632da796cca7c", name = "쉐도우 파트너",       level = 1, desc = "분신을 소환해 함께 공격한다." },
				-- 암행2(3차, 2026-07-30 신설): 암행1의 상위 - 표창을 던지는 대신 몬스터 **뒤쪽**에
				-- 그림자가 나타나 더블스탭이나 새비지블로우를 쓴다. 확률은 암행1과 같은 20%지만
				-- 완전히 독립적으로 굴린다(암행1이 터져도 암행2는 따로 판정).
				-- 암행1과 동일한 ON/OFF 토글이며, 아이콘은 임시로 암행1 아이콘을 쓴다(교체 가능).
				{ ruid = "6e463376315c4a4eb8f632bea7b4cd3b", name = "암행2",               level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 한 대상을 때린 타수마다\n5% 확률로 주변의 적 하나의 뒤쪽에\n그림자가 나타나 더블스탭이나\n새비지블로우를 쓴다.\n한 타당 전투력의 100%~200% 피해.\n(암행과는 확률을 따로 굴린다.)" },
				{ ruid = "5dea29ad262d4940b5ef47eacc280e90", name = "플래쉬 점프",         level = 1, desc = "공중에서 한 번 더 도약한다." },
				{ ruid = "bf14a6c4355b4aa0b193cd77cf066215", name = "어벤져",             level = 1, desc = "여러 적을 동시에 베어 공격한다." },
				{ ruid = "07de3cf12cc44009940e7a6673d9ac5a", name = "어썰터",             level = 1, desc = "대상에게 빠르게 돌진하여 공격한다." },
				-- 스트레이프(3차): 화살/시전/적중 이펙트와 아이콘 전부 원본 팩
				-- skill/800032.img/skill/80003299의 ball/0, effect, hit/0, icon RUID를 그대로 쓴다.
				{ ruid = "c13bd2c76a98448b96b5152dc28f239f", name = "스트레이프",         level = 1, desc = "전방으로 화살 네 발을 연속 발사해\n적 하나를 4번 공격한다.\n한 발당 전투력의 200%~250%\n피해를 입힌다." },
				{ ruid = "7d3db33ced4149f8853b1abc0734b384", name = "에로우 레인",         level = 1, desc = "하늘에서 화살비를 퍼붓는다." },
				-- 파이어 샷(3차): 아이스 샷과 같은 구조. 아이콘/탄환/시전/히트/바닥불길/파편 전부
				-- 원본 팩 skill/800033.img/skill/80003324의 RUID를 그대로 쓴다.
				{ ruid = "a15173e4162a4a9eb5f92b9e5d73ff6d", name = "파이어 샷",           level = 1, desc = "화염을 터뜨리며 범위 내 적 최대 10명에게\n화염 탄환을 날린다.\n한 명당 전투력의 500%~700% 피해를 입히고\n맞은 자리에 불길이 번진다." },
				{ ruid = "fbfbe956c35a4bb8a5bfd707010b63b2", name = "퍼펫",               level = 1, desc = "인형을 소환해 적의 시선을 끈다." },
				{ ruid = "06536fe0f8814a6ea4c4dd5bb6b7750a", name = "모탈 블로우",         level = 1, desc = "강한 일격으로 적에게 치명타를 입힌다." },
				{ ruid = "0638d6950da040f09dc0fb5bce4e6bed", name = "아이스 스트라이크",   level = 1, desc = "얼음의 힘으로 적을 강타한다." },
				-- 아이스 샷(3차): 아이콘/화살/시전/히트 이펙트 전부 구버전 원본 추출본을 직접 업로드했다
				-- (원본/RUID 대응표: msw-dev-tools/resources/아이스샷/RUID.md).
				{ ruid = "3aeb13b82977470d85c9aac1a0732515", name = "아이스 샷",           level = 1, desc = "빛을 터뜨리며 범위 내 적 최대 10명에게\n얼음 화살을 날린다.\n한 명당 전투력의 500%~700% 피해를 입히고\n맞은 적은 3초간 얼어붙어 움직이지 못한다." },
				-- 궁병 지원(3차, 2026-07-28 신설): 30초 동안 유저 등 뒤 화면 밖에서 아이스 샷/파이어 샷 화살이
				-- 몬스터를 향해 총 30발(랜덤 간격, 얼음/불 교차) 날아와 착탄점 일대를 속성 공격한다. 쿨타임 2분.
				{ ruid = "9ea8dea2ef2e404595ef871d07ce089b", name = "궁병 지원",           level = 1, desc = "30초 동안 먼 곳에서 지원 사격이\n날아온다. 아이스 샷과 파이어 샷의\n화살이 넓은 범위의 몬스터를 향해\n총 30발 날아와 꽂힌 자리 일대의 적\n최대 6명에게 각각 전투력의 200%~300%\n속성 피해를 입힌다.\n(얼음은 빙결, 불은 화상)\n재사용 대기시간 2분." },
				-- 샤이닝 레이(3차, 2026-07-29 신설): 사용자 제공 클래식 아트(effect+sineffect 동시 시작) 44장
				-- 업로드(원본/RUID 대응표: msw-dev-tools/resources/샤이닝레이/RUID.md). 사용음/적중음은
				-- 라이브러리 원본 팩 skill/231.img/skill/2311004의 _audio/Use·Hit, 아이콘도 같은 팩의 icon.
				{ ruid = "49bd6b2c5d22446c9f8079a50bcc67c0", name = "샤이닝 레이",         level = 1, desc = "빛의 세례를 내려 주변의 적 최대 30명에게\n전투력의 800%~1000% 피해를 입힌다.\n(범위는 드래곤 로어의 절반)\n재사용 대기시간 1분." },
				-- 드래곤 라이딩(3차): 5분간 드래곤을 소환해 따라다니게 하고, 소환 중 다시 쓰면 그 드래곤에
				-- 탑승해 자유롭게 날아다닌다. 아이콘은 임시(드래고니카 라이딩 이용권) - 교체 가능.
				-- 소환 중에는 퀵슬롯 아이콘이 드래곤 라이딩 아이콘(77e0cbe8)으로 바뀐다.
				-- 차지 블로우(3차): 자체 쿨타임 없음. 디바인 4종(스티그마 강화 / 스윙 강화 / 저지먼트 강화 /
				-- 차지) 중 하나를 쓰면 그 속성이 차지 블로우에 실리고, 퀵슬롯 아이콘도 그 스킬 아이콘으로
				-- 바뀐다. 디바인 4종은 공용 0.5초 쿨타임을 쓰며, 이미 켜져 있는 속성은 연속 선택할 수 없다.
				-- 공격 자체는 파워스트라이크와 완전히 동일하고(모션/판정/데미지/파이널어택 공유),
				-- 검 궤적 이펙트만 속성별 전용 아트로 대체된다 - 스티그마=얼음 / 스윙=불 / 저지먼트=전기 /
				-- 차지=성. 속성이 없는 상태면 파워스트라이크 기본 궤적 그대로 나간다.
				{ ruid = "28e3b85f945347fa8209ec18b4bb296c", name = "차지 블로우",         level = 1, desc = "디바인 4종으로 지정한 속성을 실어 공격한다.\n공격력은 파워스트라이크와 같고 검 궤적이\n속성별로 바뀐다(스티그마=얼음 / 스윙=불 /\n저지먼트=전기 / 차지=성).\n디바인 4종은 0.5초 공용 재사용 대기시간을 공유한다." },
				{ ruid = "84190342335e44ad98519eb58753eea0", name = "드래곤 라이딩",       level = 1, desc ="5분간 드래곤을 소환한다.\n드래곤이 따라다니며 5~7초마다 사거리 내의\n적을 공격한다(전투력의 200%~300%).\n소환 중 다시 사용하면 드래곤에 탑승해\n이동속도 +220%로 자유롭게 날 수 있다\n(탑승 중에는 다른 스킬을 쓸 수 없다).\n재사용 대기시간 10분." },
				-- 용사 소환(3차): 전사 3계열(히어로/팔라딘/다크나이트) 중 랜덤 1명을 아바타 NPC로
				-- 소환한다. 레벨은 내 레벨의 2/3, 직업명은 레벨 구간(10/30/70/120)에 따라 플레이어와
				-- 동일하게 바뀌고 직업별 스킬(분노/파워가드/부스터/콤보어택+코마/스피어버스터+드래곤로어/
				-- 공속 버프)을 쓴다. 아이콘/소환 이펙트/사운드는 원본 팩 skill/000.img/skill/0001005
				-- (영웅의 메아리)의 icon / effect / _audio/Use를 그대로 쓴다.
				{ ruid = "ec65789e35b34c90bdf883a51c76a720", name = "용사 소환",           level = 1, desc = "전사 용사(히어로·팔라딘·다크나이트 계열 중\n랜덤 1명)를 5분간 소환한다.\n용사 레벨은 내 레벨의 2/3이며, 몬스터를\n추적해 직업에 맞는 스킬로 싸우고\n멀어지면 곁으로 순간이동한다.\n장비는 드롭 방어구+직업 무기, 외형은 랜덤.\n재사용 대기시간 없음 - 다시 사용하면\n기존 용사를 없애고 새로 소환한다." },
				-- 힐러 소환(3차, 2026-07-28 신설): 용사 소환과 같은 아바타 NPC 규격이지만 직업은 비숍 고정이고
				-- 스킬은 힐/텔레포트 둘뿐이다. 공격을 하지 않고 제자리에 서서 힐을 주력으로 계속 쓰며,
				-- 이동은 (피드백) "데미지를 입었을 때"와 "주인이 주변에 없을 때"만 한다.
				-- 아이콘은 임시로 힐 스킬 아이콘 재사용 - 전용 아이콘이 생기면 교체 가능.
				{ ruid = "44b70137422f425eb486eb7cc5a92aec", name = "힐러 소환",           level = 1, desc = "비숍 힐러를 5분간 소환한다.\n힐러 레벨은 내 레벨의 2/3이며,\n공격은 전혀 하지 않는다.\n내 HP나 힐러 자신의 HP가 깎여 있으면\n곧바로 힐을 써서 둘 다 회복시킨다\n(전투력의 5%~15%, 재사용 1.5초).\n평소에는 제자리에 서서 힐만 쓰고,\n내가 멀어지거나 힐러가 몬스터에게 맞았을 때만\n텔레포트로 내 곁까지 이동한다.\n재사용 대기시간 없음 - 다시 사용하면\n기존 힐러를 없애고 새로 소환한다." },
				-- 용 소환(3차, 2026-07-28 신설): 한 번 시전하면 서로 다른 용 6마리가 동시에 소환된다.
				-- 로직은 드래곤 라이딩과 비슷하지만 탑승은 불가. 각자 주인 주변 궤도를 날아다니며
				-- 5~7초마다 사거리 안의 적을 공격하고, 주인 최대 HP의 1/2짜리 HP를 가진다(힐로 회복 가능).
				-- 리소스는 몹 팩 6종(9300511 마뇽 / 9834307 심연의 마뇽 / 2600022 마뇽 /
				-- 2400575 레비아탄 / 9300516 레비아탄 / 8300002 플라잉 레드 와이번)의 클립을 그대로 쓴다.
				-- 아이콘은 임시로 드래곤 라이딩 아이콘 재사용 - 전용 아이콘이 생기면 교체 가능.
				{ ruid = "84190342335e44ad98519eb58753eea0", name = "용 소환",             level = 1, desc = "서로 다른 용 6마리를 10분간 소환한다.\n용들은 내 주변을 날아다니며 5~7초마다\n사거리 내의 적에게 날아가 공격한다\n(마리당 전투력의 200%~300%).\n각 용은 내 최대 HP의 절반만큼 체력을 가지며,\n몬스터에게 맞으면 깎이고 0이 되면 사라진다.\n힐 스킬로 용의 체력을 회복시킬 수 있다.\n재사용 대기시간 10분." },
				-- 매직 에로우 3종(3차 토글): 에로우 블로우 강화와 동일한 ON/OFF 토글 스킬. 켜면 1차 매직 미사일의
				-- 구체/이펙트 색이 속성색으로 바뀌고 데미지가 2배가 된다. 세 속성은 서로 배타적(하나를 켜면 나머지 OFF).
				-- 전용 아이콘 리소스가 없어 임시로 샤이닝 레이/아이스 스트라이크/파이어에로우 아이콘을 재사용한다(교체 가능).
				{ ruid = "49bd6b2c5d22446c9f8079a50bcc67c0", name = "매직 에로우(빛)",   level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 매직 미사일이 빛 속성이 되어\n구체와 이펙트가 노랑·하양으로 빛나고\n데미지가 2배가 된다.\n(얼음/불 속성과 동시에 켤 수 없다)\n(아이콘은 임시 - 교체 가능)" },
				{ ruid = "0638d6950da040f09dc0fb5bce4e6bed", name = "매직 에로우(얼음)", level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 매직 미사일이 얼음 속성이 되어\n구체와 이펙트가 파랗게 물들고\n데미지가 2배가 된다.\n(빛/불 속성과 동시에 켤 수 없다)\n(아이콘은 임시 - 교체 가능)" },
				{ ruid = "48f6c72aa48647e1b97b99afbc46ea17", name = "매직 에로우(불)",   level = 1, desc = "사용할 때마다 켜지고 꺼지는 토글 스킬.\n켜져 있는 동안 매직 미사일이 불 속성이 되어\n구체와 이펙트가 붉게 타오르고\n데미지가 2배가 된다.\n(빛/얼음 속성과 동시에 켤 수 없다)\n(아이콘은 임시 - 교체 가능)" },
			},
			["4"] = {
				{ ruid = "8fce886b020349699cab77be0dafe5d7", name = "부메랑 스탭",         level = 1, desc = "회전하며 전방의 적을 베어낸다." },
				{ ruid = "97850763fe7241cda059cc1833df70d8", name = "어드밴스드 콤보",     level = 1, desc = "콤보 카운트를 더 빠르게 쌓는다." },
				-- 어드밴스드 스피어 버스터(4차 패시브): 보유 시 스피어 버스터 데미지 1.5배 + 이펙트 색이
				-- 검정/하양/빨강 조화로 바뀐다. 아이콘은 임시로 스피어 버스터 아이콘 재사용.
				{ ruid = "948d8f877f1349a38ab7111df06fd9b5", name = "어드밴스드 스피어 버스터", level = 1, desc = "스피어 버스터를 강화한다.\n스피어 버스터 데미지 1.5배,\n이펙트가 검정·하양·빨강 조화로 바뀐다." },
				{ ruid = "185d0cd674bd44f388c8ccd265b59f43", name = "브랜디쉬",           level = 1, desc = "검을 크게 휘둘러 전방의 적들을 벤다.\n한 번에 3타(첫 타 + 마지막 모션 2타)로\n타당 전투력의 400%~700% 피해를 입힌다." },
				-- 브랜디쉬2(임시명): 브랜디쉬 진행 절반~끝 사이에 브랜디쉬를 한 번 더 누르면 발동하는 콤보.
				-- 별도 키 없이 브랜디쉬 재입력으로만 나가며(UseSkillInSlot의 재입력 감지), 브랜디쉬 끝에 빠른 2줄을
				-- 추가로 넣는다. 아이콘은 임시로 브랜디쉬와 동일 RUID 사용.
				{ ruid = "185d0cd674bd44f388c8ccd265b59f43", name = "브랜디쉬2",          level = 1, desc = "브랜디쉬 진행 중(절반~끝)에 브랜디쉬를\n한 번 더 누르면 발동하는 콤보.\n브랜디쉬 끝에 빠른 2줄을 추가로 벤다." },
				-- 브랜디쉬 강화(4차 버프): 5분간 브랜디쉬 데미지 1.5배 + 공속 +1단계 + 이펙트/아이콘을 진한 빨강으로.
				-- 아이콘은 브랜디쉬 아이콘을 진한 빨강으로 재색상해 업로드(msw-dev-tools/resources/브랜디쉬강화).
				{ ruid = "3dd829f7a9ec45bb95e2cc3ed4a6aff3", name = "브랜디쉬 강화",      level = 1, desc = "5분간 브랜디쉬를 강화한다.\n브랜디쉬 데미지 1.5배, 공격속도 1단계 상승,\n이펙트가 진한 빨강으로 바뀐다." },
				-- 돌진: 구버전 원본 아이콘/이펙트를 직접 구해와 업로드했다(MSW 라이브러리엔 현대 리메이크
				-- 아트만 있음). 원본/RUID 대응표: msw-dev-tools/resources/돌진/RUID.md
				{ ruid = "75c8dd4cdf774f4eaf64af0406fae864", name = "돌진",               level = 1, desc = "앞으로 돌진하며 전방의 적을 최대 10명까지\n밀어낸다. 전투력의 300%~400% 피해를 입힌다.\n앞에 적이 없으면 제자리에서 시전된다.\n재사용 대기시간 1초." },
				{ ruid = "7ff10839eb5046eebb9cffc8f8828cfc", name = "생츄어리",           level = 1, desc = "성역을 소환해 범위 내 적에게 지속 피해를 입힌다." },
				{ ruid = "2ba15e204ac64214a8144b0b2deeaf79", name = "디바인 차지",         level = 1, desc = "무기에 신성한 힘을 부여한다." },
				-- 쿼드러플 스로우(4차, 2026-07-30 신설): 트리플 스로우(3발)의 상위 - 표창을 4발 던진다.
				-- 데미지 숫자도 4줄, 쉐도우 파트너 중에는 8줄. 아이콘/시전 이펙트/타격 이펙트는
				-- 원본 팩 skill/1411.img/skill/14111005("쿼드러플 스로우 강화")의 icon / effect / hit/0.
				-- 사용음·타격음은 럭키세븐과 같다(요청). 가니어(아대) 장착이 필요하다.
				-- ⚠ 이 자리에는 원래 미구현 "트리플 스로우" 자리표시가 있었다 - 트리플 스로우는 3차로
				--   신설했으므로(이름이 겹치면 시전 분기가 깨진다) 여기를 쿼드러플 스로우로 교체했다.
				{ ruid = "1a565ad1eb9c48fcafa50600db5e523a", name = "쿼드러플 스로우",     level = 1, desc = "표창을 연달아 4개 던진다.\n표창 하나당 전투력의 100%~150% 피해.\n데미지가 4줄로 표시되고\n쉐도우 파트너 중에는 8줄이 된다.\n가니어를 장착해야 사용할 수 있다." },
				-- 제네시스(4차): 블리자드/메테오와 같은 규격의 빛 속성 버전. 리소스는 원본 팩
				-- skill/232.img/skill/2321008(기둥 tile/0~5·시전·사운드), 중간 추가 타격은
				-- skill/234.img/skill/2341001(엔젤레이 VI)의 공격모션 2종을 몬스터 측면에 소환해 쓴다.
				{ ruid = "187b564cb8dc429f9c35bffeeca875c5", name = "제네시스",           level = 1, desc = "주변 발판 위에 빛 기둥 15개를 동시에\n내리꽂는다. 꽂힌 자리(반경 1.2)의 적을\n기둥당 최대 6명까지 전투력의\n700%~1000%로 때린다.\n이후 15초 동안 범위 안 적의 곁에\n천사가 10번 나타나 공격한다.\n재사용 대기시간 20초." },
				-- 홀리 매직쉘(4차 버프, 2026-07-29 신설): 자신과 HP를 가진 아군 소환수(용사/힐러/용 6마리)
			-- 전원에게 개체마다 각각 10회 방어 쉴드를 건다. 막을 때마다 그 개체에서 쉴드 이펙트 +
			-- "Guard" 표시 + 남은 개수가 뜬다. 아이콘은 임시로 시전 이펙트 클립 재사용 - 교체 가능.
			{ ruid = "c9af85359e644b568c8ba555f642e367", name = "홀리 매직쉘",       level = 1, desc = "자신과 소환한 아군(용사·힐러·용) 전원에게\n보호막을 건다.\n각 대상은 몬스터의 공격을 10번까지\n완전히 막아낸다(개체마다 각각 10회).\n막을 때마다 남은 횟수가 머리 위에 표시된다.\n재사용 대기시간 2분." },
			-- 드래곤 블러드(4차 버프, 2026-07-28 신설): 사용자가 제공한 원본 20프레임 아트를 그대로 쓴다
			-- (RUID 표: msw-dev-tools/resources/드래곤블러드/RUID.md). 아이콘은 임시로 마지막 시전
			-- 프레임(17번)을 재사용 - 전용 아이콘이 생기면 교체 가능.
			{ ruid = "4bd903c41887458f9ccf1aa20aa46181", name = "드래곤 블러드",     level = 1, desc = "10분 동안 용의 피를 끓인다.\n공격력이 30 상승한다.\n10초마다 최대 HP의 4%를 소모하며,\nHP가 최대 HP의 10% 이하가 되면\n자동으로 해제된다.\n소환된 드래곤(용 소환·드래곤 라이딩)이\n공격할 때마다 최대 HP의 3%를 회복한다.\n재사용 대기시간 없음." },
				-- 바하뮤트(4차 소환, 2026-07-29 신설): 프리져/피닉스와 달리 적에게 날아가지 않고
				-- 주인 곁(뒤 위)에 머물며 그 자리에서 브레스를 뿜어 최대 6마리를 동시에 때린다.
				-- 따라오는 방식은 임계감쇠 추종이라 주인이 갑자기 멀어져도 튀지 않는다.
				-- 아트는 구버전 클라 추출 클래식 바하뮤트 42프레임(라이브러리 것은 금갑옷 강화판이라 미사용).
				-- RUID 표: msw-dev-tools/resources/바하뮤트/RUID.md, 구현: Skills/BahamutSummon.mlua
				{ ruid = "4c9e769fed8f40a790ae6086785a822e", name = "바하뮤트",           level = 1, desc = "10분간 용의 왕 바하뮤트를 소환한다.\n주인 뒤 위를 지키며 자연스럽게 따라다니다가\n주변 6.5유닛 안에 적이 나타나면\n그 자리에서 브레스를 뿜는다.\n한 번에 최대 6마리를 동시에 때리며\n대상당 전투력의 200%~300% 피해를 입힌다.\n재사용 대기시간 30초." },
					-- 리커버리 오로라(4차, 2026-07-29 신설): 사용자 제공 클래식 아트 20프레임을 동일 캔버스로
					-- origin 정렬 패딩해 직접 업로드했다(msw-dev-tools/resources/리커버리오로라/RUID.md).
					-- 발밑에 60초 오로라를 설치하고, 오로라 주변에서는 쿨타임 스킬을 대기시간 없이 바로
					-- 재사용할 수 있다(자기 자신의 쿨타임 3분만 예외). 장판 투명도 60%.
					{ ruid = "16d7498e26154b9393af469d1d82c7ca", name = "리커버리 오로라",   level = 1, desc = "발밑에 회복의 오로라를 설치한다.\n오로라는 1분간 유지되며, 그 주변에서는\n재사용 대기시간이 있는 스킬을\n대기시간 없이 바로 다시 쓸 수 있다.\n(리커버리 오로라 자신은 예외)\n재사용 대기시간 3분." },
				-- 엔젤레이(4차, 2026-07-29 신설): 아이언에로우와 같은 구조의 관통 투사체지만 8방향 조준 없이
				-- 전방으로만 발사하고, 관통 수는 10명이다. 아이콘/시전(effect0~14)/투사체(ball)/적중(hit0~6)
				-- 아트는 사용자 제공 클래식 원본을 직접 업로드했다(msw-dev-tools/resources/엔젤레이/RUID.md).
				{ ruid = "3f99493e69b64086b41945a3e5be08c2", name = "엔젤레이",           level = 1, desc = "천사의 빛을 모아 전방으로 발사한다.\n빛줄기는 적을 최대 10명까지 관통하며\n대상당 전투력의 500%~700%\n피해를 입힌다." },
				{ ruid = "b5178c975a694ec3a51106a448fd70dd", name = "빅뱅",               level = 1, desc = "강력한 폭발로 넓은 범위에 피해를 입힌다." },
				-- 체인 라이트닝(4차): 원본 팩 skill/222.img/skill/2221006의 기모으기/전격 조각/명중/사운드를
				-- 그대로 쓴다. swingO3 1프레임에서 0.5초 기를 모은 뒤 3프레임에 발사(요청 사양).
				{ ruid = "f84bad609f3a47c29ed662abea683f2e", name = "체인라이트닝",       level = 1, desc = "0.5초 기를 모은 뒤 전방의 가장 가까운\n적에게 전격을 날린다. 전격은 가까운 적으로\n최대 10명까지 연쇄되며 대상당 전투력의\n500%~700% 피해를 입힌다.\n얼어붙은 적을 맞히면 2초간 기절시킨다.\n(블리자드 50%·빙하지대 30%·차지 블로우\n스티그마 등으로 적이 얼어붙는다)" },
				{ ruid = "7aa2a3683ff84a3ca809542b835ef68d", name = "블리자드",           level = 1, desc = "주변 발판 위에 얼음 폭풍을 흩뿌린 뒤\n시전자 주위의 적에게 전투력의\n3500%~5000% 피해를 입힌다.\n재사용 대기시간 20초." },
				-- 암살(4차, 2026-07-30 신설): 체인 라이트닝과 같은 데미지 구조(대상당 500%~700%)로 최대
				-- 10명까지 옮겨붙는다. 시전 즉시 캐릭터가 사라지고 대상마다 랜덤한 방향에서 베어 들어간 뒤
				-- 마지막에 원래 자리에서 다시 나타난다. 아이콘은 임시로 시전 이펙트 클립 썸네일을 쓴다.
				{ ruid = "thumbnail://1526c51ba3ea4a2795f1be1522d42b5d", name = "암살",             level = 1, desc = "몸을 감추고 적들 사이를 옮겨 다니며\n베어낸다. 가까운 적으로 최대 10명까지\n이어지며 대상당 전투력의 500%~700%\n피해를 입힌다.\n마지막 대상을 베면 원래 자리에\n다시 나타난다." },
				-- 연막(4차, 2026-07-30 신설): 원본 팩 skill/422.img/skill/4221006("연막탄")의
				-- icon / special(연기 생성·소멸) / tile/0/8~16(바닥에 깔리는 연기) / _audio/Use를 쓴다.
				{ ruid = "b944ae2274a04a1b96df2875368a8105", name = "연막",             level = 1, desc = "연막탄을 터뜨려 10초간 맵 전체를\n뿌옇게 만든다.\n연막 안에서는 받는 피해가 모두\nMISS가 되고, 내가 하는 공격은 전부\n백스탭으로 취급된다.\n재사용 대기시간 20초." },
				-- 이프리트(4차 소환, 2026-07-30 구현): 엘퀴네스와 같은 개념 - 주인 곁을 지키며 그 자리에서
				-- 화염으로 최대 6마리를 동시에 때린다. 리소스는 사용자 지정 라이브러리 몹 팩
				-- mob/8610015.img("이프리트")의 stand/move/attack1/die1 클립과 타격 이펙트·사운드를
				-- 그대로 쓴다(별도 업로드 없음). 구현: Skills/IfritSummon.mlua
				{ ruid = "80add5d3f2364d01b7c5c973c884324e", name = "이프리트",           level = 1, desc = "10분간 화염의 정령 이프리트를 소환한다.\n주인 뒤 위를 지키며 자연스럽게 따라다니다가\n주변 6.5유닛 안에 적이 나타나면\n그 자리에서 화염을 내뿜는다.\n한 번에 최대 6마리를 동시에 때리며\n대상당 전투력의 200%~300% 피해를 입힌다.\n재사용 대기시간 30초." },
				{ ruid = "e6144550c6084709bba1de715d677879", name = "아이스 데몬",         level = 1, desc = "얼음 악마를 소환해 적을 얼린다." },
				-- 메테오(4차): 블리자드와 같은 규격(운석 15+10개 / 운석당 최대 6명·반경 1.2 / 전투력 700~1000% /
				-- 쿨타임 20초 / 조작 잠금 3초)의 화염 버전. 리소스는 원본 팩 skill/1211.img/skill/12111003의
				-- tile/0~8(운석) / effect(시전) / _audio/Use·Hit를 그대로 쓴다.
				{ ruid = "9f317ee0b97d44dba5f85fb352aee093", name = "메테오",             level = 1, desc = "주변 발판 위에 운석 15개를 떨어뜨린다.\n운석은 전부 동시에 착지하며, 닿은 자리\n(반경 1.2)의 적을 운석당 최대 6명까지\n전투력의 700%~1000%로 때린다.\n이후 15초 동안 범위 안 적의 위치에\n운석 10개가 추가로 떨어진다.\n재사용 대기시간 20초." },
				-- 엘퀴네스(4차 소환, 2026-07-30 구현): 바하뮤트와 같은 원리 - 적에게 날아가지 않고 주인 곁을
				-- 지키며 그 자리에서 얼음 브레스로 최대 6마리를 동시에 때린다. 아트는 사용자 제공 클래식
				-- 원본을 패딩 정렬해 직접 업로드했다(라이브러리 팩은 "강화판"이라 생김새가 다름).
				-- RUID 표: msw-dev-tools/resources/엘퀴네스/RUID.md, 구현: Skills/ElquinesSummon.mlua
				{ ruid = "13d9054e49b640f08abc2820f5ca8215", name = "엘퀴네스",           level = 1, desc = "10분간 얼음의 정령 엘퀴네스를 소환한다.\n주인 뒤 위를 지키며 자연스럽게 따라다니다가\n주변 6.5유닛 안에 적이 나타나면\n그 자리에서 얼음 브레스를 뿜는다.\n한 번에 최대 6마리를 동시에 때리며\n대상당 전투력의 200%~300% 피해를 입힌다.\n재사용 대기시간 30초." },
				{ ruid = "8d9d46dcaa164c46a0b1da47db016c43", name = "피어싱",             level = 1, desc = "화살이 적을 관통하며 피해를 입힌다." },
				-- 스나이핑(4차 차지): 게이지/차지·화살·슈팅 이펙트는 원본 팩
				-- skill/3241000·3221025·3241001 + ui/basic/keydownbar5의 RUID를 그대로 쓴다.
				{ ruid = "804c52c890234d69a6a937d7523bb9f8", name = "스나이핑",           level = 1, desc = "키를 누르고 있으면 게이지가 차오르고\n(완충 10초), 떼면 관통 화살 한 발로\n최대 10명을 공격한다.\n게이지에 따라 전투력의 500%~600%에서\n최대 5000%~6000%까지 피해가 오른다.\n차지 중 이동속도가 50% 줄어든다." },
				{ ruid = "5a78b6fc281449d08794e132030e258d", name = "샤프 아이즈",         level = 1, desc = "파티원의 명중률과 크리티컬 확률을 높인다." },
				-- 프리져(4차 소환): 소환수 클립/히트 이펙트/사운드는 몬스터판 원본 팩 mob/9830009.img,
				-- 아이콘은 skill/321.img/skill/3211005. 구현은 Skills/FreezerSummon.mlua.
				{ ruid = "2f7d59f5d91c41a18713732ab2003b04", name = "프리져",             level = 1, desc = "10분간 얼음 새 프리져를 소환한다.\n평소엔 뒤 위에서 따라다니다가 주변 7유닛 안에\n적이 나타나면 날아가서 공격한다\n(전투력의 200%~300%).\n맞은 적은 80% 확률로 2초간 얼어붙는다.\n재사용 대기시간 30초." },
				-- 폭풍의 시(4차): 키를 누르고 있는 동안 0.2초마다 화살이 계속 나가는 홀드 연사 스킬.
				-- 아이콘/시전(prepare)/루프(keydown)/화살(ball)/적중(hit0)/사용음 전부 원본 팩
				-- skill/1311.img/skill/13111002의 RUID를 그대로 쓴다.
				{ ruid = "32fef5885e544e4bad99eeea14eb6e4d", name = "폭풍의 시",           level = 1, desc = "키를 누르고 있는 동안 0.1초마다\n화살을 한 발씩 계속 발사한다.\n한 발당 전투력의 80% 피해.\n연사 중에도 이동속도 60%로\n걸어다니며 쏠 수 있다." },
				-- 피닉스(4차 소환): 프리져와 동일 구조, 리소스는 몬스터판 원본 팩 mob/9300089.img +
				-- 스턴 이펙트는 skill/311.img/skill/3111005의 hit/0. 구현은 Skills/PhoenixSummon.mlua.
				{ ruid = "fd051469cf104e0bb1597e6930619354", name = "피닉스",             level = 1, desc = "10분간 불사조 피닉스를 소환한다.\n평소엔 뒤 위에서 따라다니다가 주변 7유닛 안에\n적이 나타나면 날아가서 공격한다\n(전투력의 200%~300%).\n맞은 적은 2초간 기절해 움직이지 못한다.\n재사용 대기시간 30초." },
				-- 리저렉션(4차): 죽어 쓰러져 있는 소환 용사를 그 자리에서 HP 가득 찬 상태로 부활시킨다.
				-- 아이콘/시전·부활 이펙트/사용음 전부 원본 팩 skill/232.img/skill/2321006의 RUID.
				{ ruid = "eedb96e2ddbd4ebe9a7fc6e67135ab0f", name = "리저렉션",           level = 1, desc = "죽어 쓰러져 있는 소환 용사를\n그 자리에서 HP가 가득 찬 상태로\n부활시킨다." },
			},
			["5"] = {},
