	method void RequestFireDoubleJump(number dirX)
		-- 더블 점프의 이펙트/사용음만 서버에 요청한다(이동은 위 RunDoubleJumpMove가 클라에서 처리).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireDoubleJump: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireDoubleJump: PlayerAttack component not found")
			return
		end
		pa:CastDoubleJump(dirX)
	end

	@ExecSpace("ClientOnly")
	method void UseSkillInSlot(string key)
		local slot = self._T.slotData[key]
		if slot == nil or slot.ruid == "" then return end
		-- (기능 추가) "사망했을 때 부활 전까지 다른 행동을 못하게 해달라"는 요청 - 사망(DEAD) 상태에서는
		-- 어떤 슬롯도 사용할 수 없다(HP포션 포함). 이동/점프/기본공격은 서버 쪽에서 조작 자체를 꺼서 막는다
		-- (PlayerAttack.HandleDeadLockStateEvent). 부활하면 자동으로 다시 풀린다.
		local localPlayerForDeath = _UserService.LocalPlayer
		local deathState = isvalid(localPlayerForDeath) and localPlayerForDeath.StateComponent or nil
		if isvalid(deathState) and deathState.CurrentStateName == "DEAD" then
			log("[SkillManager] 사망 상태 - 스킬 사용 불가 (부활 후 사용 가능)")
			return
		end
		-- (피드백) 리저렉션 시전 중에는 이동뿐 아니라 모든 스킬도 못 쓰는 행동 불가 상태여야 한다 -
		-- 시전 시 걸어둔 전역 행동잠금 동안에는 어떤 슬롯 입력도 받지 않는다(독립 쿨다운 스킬 포함).
		if (self._T.actionLockUntil or 0) > _UtilLogic.ElapsedSeconds then
			log("[SkillManager] 시전 중 - 행동 불가")
			return
		end
		-- (요청) 암살이 진행되는 동안(사라져 있는 내내)은 행동 불가 - 암살 자신(홀드 연속 시전)만 통과시킨다.
		-- 이동은 PlayerControllerComponent를 끄는 것으로 막지만, 스킬 입력은 _InputService를 직접 타므로
		-- 여기서 따로 막아야 한다(다크사이트가 암살 중에 써지던 문제).
		if self._T.assassinateActive == true and slot.name ~= "암살" then
			log("[SkillManager] 암살 중 - 다른 스킬 사용 불가 (" .. tostring(slot.name) .. ")")
			return
		end
		-- (요청) 드래곤 라이딩 탑승 중에는 "이동 외 다른 스킬 사용은 제한"된다.
		-- 드래곤 라이딩 자체(=내리기)만 허용한다. 이동/점프는 조작 자체를 막지 않으므로 그대로 된다.
		if self._T.dragonRideMounted == true and slot.name ~= "드래곤 라이딩" then
			log("[SkillManager] 드래곤 라이딩 탑승 중 - 다른 스킬 사용 불가")
			return
		end
		-- (요청) "어드밴스드 스피어 버스터"(스피어 버스터 강화) 스킬을 사용하면 강화를 ON/OFF 토글한다.
		-- 공격 스킬이 아니라 상태 토글이므로 쿨다운/전투 로직을 타지 않고 즉시 반환한다. 토글 후
		-- 그 슬롯 아이콘을 깜빡여 알린다. (다음 스피어 버스터 시전부터 강화 여부가 반영된다.)
		if slot.name == "어드밴스드 스피어 버스터" then
			local on = _CharInfoManager:ToggleAdvancedSpearBuster()
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] 스피어 버스터 강화 스킬 사용 → " .. (on and "ON" or "OFF"))
			return
		end
		-- (요청) "에로우 블로우 강화"도 동일한 ON/OFF 토글 스킬이다. 한 번 쓰면 켜지고 다시 쓰면 꺼진다.
		-- 공격 스킬이 아니라 상태 토글이므로 쿨다운/전투 로직을 타지 않고 즉시 반환한다.
		if slot.name == "에로우 블로우 강화" then
			local on = _CharInfoManager:ToggleArrowBlowEnhance()
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] 에로우 블로우 강화 스킬 사용 → " .. (on and "ON" or "OFF"))
			return
		end
		-- (요청) 암행(1차)도 동일한 ON/OFF 토글 스킬이다 - 원래 상시 패시브였으나 켜져 있는 동안만
		-- 온히트 그림자 표창이 발동하도록 변경. 발동 판정은 서버(PlayerAttack)라 RPC로 서버에도 반영한다.
		if slot.name == "암행" then
			local on = _CharInfoManager:ToggleAmhaeng()
			self:RequestSetAmhaengActive(on)
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] 암행 스킬 사용 → " .. (on and "ON" or "OFF"))
			return
		end
		-- (요청) 암행2(3차)도 암행1과 동일한 ON/OFF 토글이다. 발동 판정(독립 20% 굴림)은 서버
		-- PlayerAttack에서 일어나므로 토글 상태를 RPC로 서버에도 반영한다.
		if slot.name == "암행2" then
			local on2 = _CharInfoManager:ToggleAmhaeng2()
			self:RequestSetAmhaeng2Active(on2)
			local pos2 = self:GetBarPosForKey(key)
			if pos2 ~= "" then self:BlinkSlotReady(pos2) end
			log("[SkillManager] 암행2 스킬 사용 → " .. (on2 and "ON" or "OFF"))
			return
		end
		-- (요청) 백스탭(2차)도 테스트 동안은 동일한 ON/OFF 토글이다. 뒤통수 판정과 데미지 증가는
		-- 서버(PlayerAttack.CalcDamage)에서 하므로 토글 상태와 현재 투자 포인트를 함께 서버로 넘긴다.
		if slot.name == "백스탭" then
			local on = _CharInfoManager:ToggleBackstab()
			self:RequestSetBackstabState(on, self:GetBackstabSkillLevel())
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] 백스탭 스킬 사용 → " .. (on and "ON" or "OFF")
				.. " (Lv." .. tostring(self:GetBackstabSkillLevel()) .. ")")
			return
		end
		-- (요청) 다크사이트(1차): 은신 버프 토글.
		--   · 이미 켜져 있으면 → 그냥 풀린다. 이것은 "스킬을 사용한 것"이 아니므로 쿨타임 게이트를
		--     확인하지도 않고, 새 쿨타임을 걸지도 않는다(요청 사양).
		--   · 꺼져 있으면 → 쿨타임(10초) 확인 후 시전. 최대 160초 유지.
		if slot.name == "다크사이트" then
			local nowDS = _UtilLogic.ElapsedSeconds
			if self:IsDarkSightActive() then
				self:CancelDarkSightEarly()
				return
			end
			local inAuraDS = self:IsInRecoveryAura()
			if (self._T.darkSightCooldownUntil or 0) > nowDS and not inAuraDS then
				log("[SkillManager] 다크사이트: 쿨타임 중(" .. tostring(math.ceil(self._T.darkSightCooldownUntil - nowDS)) .. "초 남음)")
				return
			end
			if not inAuraDS then
				self._T.darkSightCooldownUntil = nowDS + 10.0
				local dsBarPos = self:GetBarPosForKey(key)
				if dsBarPos ~= "" then
					_DarkSightCooldownUI:ShowCooldown(10.0, dsBarPos)
				end
			end
			self:StartDarkSightLocal()
			self:RequestFireDarkSight()
			log("[SkillManager] 다크사이트 사용(최대 160초, 이동속도 50%, 공격 시 2배+크리티컬 후 해제, 쿨타임 10초)")
			return
		end
		-- (요청) 매직 에로우 3종(빛/얼음/불, 3차)도 동일한 ON/OFF 토글 스킬이다. 켜면 매직 미사일의
		-- 색이 속성색으로 바뀌고 데미지가 2배가 된다. 세 속성은 배타적 - 하나를 켜면 나머지는 꺼진다.
		if slot.name == "매직 에로우(빛)" or slot.name == "매직 에로우(얼음)" or slot.name == "매직 에로우(불)" then
			local element = "light"
			if slot.name == "매직 에로우(얼음)" then
				element = "ice"
			elseif slot.name == "매직 에로우(불)" then
				element = "fire"
			end
			local on = _CharInfoManager:ToggleMagicMissileElement(element)
			local pos = self:GetBarPosForKey(key)
			if pos ~= "" then self:BlinkSlotReady(pos) end
			log("[SkillManager] " .. slot.name .. " 스킬 사용 → " .. (on and "ON" or "OFF"))
			return
		end
		-- (새 대쉬=질주) 러시 스킬: 방향키(좌/우)를 누르고 있으면 질주 진입, 아니면 아무 일도 안 함. 쿨다운/RPC 없음.
		if slot.name == "러시" then
			self:TryEnterSprintFromSkill()
			return
		end
		-- (더블 점프) 주 조작은 "공중에서 점프키 한 번 더"(OnKeyDown)지만, 배정된 퀵슬롯 키로도
		-- 똑같이 쓸 수 있게 한다. 공중이 아니거나 쿨타임 중이면 TryDoubleJump가 알아서 무시한다.
		if slot.name == "더블 점프" then
			self:TryDoubleJump()
			return
		end
		-- (속사) 키를 누르고 있는 동안 계속 발사되는 지속 스킬. 여기서는 연사를 "시작"만 하고,
		-- 실제 발사 간격(0.5초)·조준 각도 보간·종료 판정은 OnUpdate의 RapidFireTick이 담당한다.
		-- 이미 연사 중이면 StartRapidFire가 그냥 무시하므로 KeyDown 반복이 들어와도 안전하다.
		if slot.name == "속사" then
			self:StartRapidFire(key)
			return
		end
		-- (폭풍의 시) 키를 누르고 있는 동안 0.1초마다 화살이 계속 나가는 홀드 연사 스킬. 속사와 같은
		-- 구조로 여기서는 연사를 "시작"만 하고, 발사 간격(0.1초)·종료 판정은 OnUpdate의 HurricaneTick이
		-- 담당한다. 이미 연사 중이면 StartHurricane이 그냥 무시하므로 KeyDown 반복이 들어와도 안전하다.
		if slot.name == "폭풍의 시" then
			self:StartHurricane(key)
			return
		end
		-- (스나이핑) 키를 누르고 있으면 게이지를 채우고 떼면 발사하는 차지 스킬. 여기서는 차지를
		-- "시작"만 하고, 게이지 누적·단계 전환·발사는 OnUpdate의 SnipingTick이 담당한다.
		if slot.name == "스나이핑" then
			self:StartSniping(key)
			return
		end
		-- (체인샷) 한 키가 상황에 따라 둘로 갈린다.
		--  ① 박혀 있는 체인이 있고 3초 창이 살아있으면 → 그 각도로 당겨져 날아간다
		--  ② 아니면 → 새 체인을 8방향으로 발사한다
		-- 키를 누르고 있으면 KeyDown이 반복되므로, 발사 직후 잠깐(0.3초)은 당기기로 넘어가지 않게 막는다.
		if slot.name == "체인샷" then
			local nowChain = _UtilLogic.ElapsedSeconds
			if (self._T.chainAnchoredUntil or 0) > nowChain and (self._T.chainPullReadyAt or 0) <= nowChain then
				self._T.chainAnchoredUntil = 0
				self:RequestChainShotPull(self:GetEffectiveCombatPower())
				log("[SkillManager] 체인샷 당기기")
				return
			end
			if (self._T.chainAnchoredUntil or 0) > nowChain then return end   -- 발사 직후 연타 무시
			if self._T.skillOnCooldown then return end
			-- (요청 2026-07-28) 체인샷 자체 쿨타임 2초(새 체인 발사 기준 - 박힌 체인 당기기는 예외).
			-- 쿨타임은 퀵슬롯에 표기한다(블리자드와 같은 방식 - ChainShotCooldownUI).
			local inAuraChain = self:IsInRecoveryAura()
			if (self._T.chainShotCooldownUntil or 0) > nowChain and not inAuraChain then
				log("[SkillManager] 체인샷: 쿨타임 중")
				return
			end
			if not inAuraChain then
				self._T.chainShotCooldownUntil = nowChain + 2.0
				local chainBarPos = self:GetBarPosForKey(key)
				if chainBarPos ~= "" then
					_ChainShotCooldownUI:ShowCooldown(2.0, chainBarPos)
				end
			end
			local atkMultChain = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.5 * atkMultChain)
			-- 8방향 조준(아이언 에로우와 동일한 입력 처리). 아무 방향키도 안 눌렸으면 바라보는 쪽.
			local cdx, cdy = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				cdx = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				cdx = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				cdy = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				cdy = -1
			end
			self:RequestFireChainShot(self:GetEffectiveCombatPower(), atkMultChain, cdx, cdy)
			log("[SkillManager] 체인샷 발사 dir=(" .. tostring(cdx) .. "," .. tostring(cdy) .. ")")
			return
		end
		-- (궁병 지원) 30초 지속 지원 사격. 자체 쿨타임 2분 + 퀵슬롯 표기.
		if slot.name == "궁병 지원" then
			local nowArcher = _UtilLogic.ElapsedSeconds
			local inAuraArcher = self:IsInRecoveryAura()
			if (self._T.archerSupportCooldownUntil or 0) > nowArcher and not inAuraArcher then
				log("[SkillManager] 궁병 지원: 쿨타임 중")
				return
			end
			if not inAuraArcher then
				self._T.archerSupportCooldownUntil = nowArcher + 120.0
				local archerBarPos = self:GetBarPosForKey(key)
				if archerBarPos ~= "" then
					_ArcherSupportCooldownUI:ShowCooldown(120.0, archerBarPos)
				end
			end
			self:RequestFireArcherSupport(self:GetEffectiveCombatPower())
			log("[SkillManager] 궁병 지원 사용(30초간 지원 사격 15발, 쿨타임 2분)")
			return
		end
		-- (샤이닝 레이) 주변 전방위(드래곤 로어의 절반 범위) 최대 30명 광역 공격. 자체 쿨타임 1분 + 퀵슬롯 표기.
		if slot.name == "샤이닝 레이" then
			local nowShining = _UtilLogic.ElapsedSeconds
			local inAuraShining = self:IsInRecoveryAura()
			if (self._T.shiningRayCooldownUntil or 0) > nowShining and not inAuraShining then
				log("[SkillManager] 샤이닝 레이: 쿨타임 중")
				return
			end
			if not inAuraShining then
				self._T.shiningRayCooldownUntil = nowShining + 60.0
				local shiningBarPos = self:GetBarPosForKey(key)
				if shiningBarPos ~= "" then
					_ShiningRayCooldownUI:ShowCooldown(60.0, shiningBarPos)
				end
			end
			local atkMultShining = _CharInfoManager:GetAttackSpeedMultiplier()
			self:RequestFireShiningRay(self:GetEffectiveCombatPower(), atkMultShining)
			log("[SkillManager] 샤이닝 레이 사용(주변 최대 30명, 800%~1000%, 쿨타임 1분)")
			return
		end
		-- (리스토네이션) 자기 자신 최대 HP 50% 회복. 자체 쿨타임 10초 + 퀵슬롯 표기(블리자드 방식).
		if slot.name == "리스토네이션" then
			local nowRestore = _UtilLogic.ElapsedSeconds
			local inAuraRestore = self:IsInRecoveryAura()
			if (self._T.restorationCooldownUntil or 0) > nowRestore and not inAuraRestore then
				log("[SkillManager] 리스토네이션: 쿨타임 중")
				return
			end
			if not inAuraRestore then
				self._T.restorationCooldownUntil = nowRestore + 10.0
				local restoreBarPos = self:GetBarPosForKey(key)
				if restoreBarPos ~= "" then
					_RestorationCooldownUI:ShowCooldown(10.0, restoreBarPos)
				end
			end
			self:RequestFireRestoration()
			log("[SkillManager] 리스토네이션 사용(5초간 초당 최대HP 10%씩 총 50% 회복, 쿨타임 10초)")
			return
		end
		-- (섬광) 체인샷과 같은 8방향 조준이지만 단발 - 검을 던지고 자동으로 돌진까지 이어진다.
		if slot.name == "섬광" then
			if self._T.skillOnCooldown then return end
			-- (요청 2026-07-28) 섬광 자체 쿨타임 2초. 퀵슬롯에 표기(블리자드 방식 - FlashCooldownUI).
			local nowFlash = _UtilLogic.ElapsedSeconds
			local inAuraFlash = self:IsInRecoveryAura()
			if (self._T.flashCooldownUntil or 0) > nowFlash and not inAuraFlash then
				log("[SkillManager] 섬광: 쿨타임 중")
				return
			end
			if not inAuraFlash then
				self._T.flashCooldownUntil = nowFlash + 2.0
				local flashBarPos = self:GetBarPosForKey(key)
				if flashBarPos ~= "" then
					_FlashCooldownUI:ShowCooldown(2.0, flashBarPos)
				end
			end
			local atkMultFlash = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.5 * atkMultFlash)
			local fdx, fdy = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				fdx = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				fdx = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				fdy = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				fdy = -1
			end
			-- 장착 무기 RUID는 클라이언트에서만 정확히 읽힌다(장비 적용이 클라 CostumeManager라 서버 GetEquip은
			-- 빈 문자열) - 시전 시점에 읽어 서버로 함께 넘긴다. 두손무기 우선, 없으면 한손무기.
			local weaponRuid = ""
			local lpForFlash = _UserService.LocalPlayer
			if isvalid(lpForFlash) then
				local costumeForFlash = lpForFlash.CostumeManagerComponent
				if isvalid(costumeForFlash) then
					weaponRuid = costumeForFlash:GetEquip(MapleAvatarItemCategory.TwoHandedWeapon) or ""
					if weaponRuid == "" then
						weaponRuid = costumeForFlash:GetEquip(MapleAvatarItemCategory.OneHandedWeapon) or ""
					end
				end
			end
			self:RequestFireFlash(self:GetEffectiveCombatPower(), atkMultFlash, fdx, fdy, weaponRuid)
			log("[SkillManager] 섬광 발사 dir=(" .. tostring(fdx) .. "," .. tostring(fdy) .. ") weapon=" .. tostring(weaponRuid))
			return
		end
		-- 속사 중에 다른 스킬을 누르면 연사를 먼저 끝낸다(질주와 같은 처리 - 이동 잠금이 남지 않게).
		if self._T.rapidFireActive == true then
			self:EndRapidFire()
		end
		-- 폭풍의 시 연사 중에 다른 스킬을 눌러도 같은 처리로 연사를 먼저 끝낸다.
		if self._T.hurricaneActive == true then
			self:EndHurricane()
		end
		-- 스나이핑 차지 중에 다른 스킬을 누르면 차지를 취소한다(발사 없이 정리).
		if self._T.snipingActive == true then
			self:CancelSniping()
		end
		-- (요청) 질주 중 다른 스킬을 누르면 제자리로 돌아가지 않고 즉시 그 스킬을 발동한다 - 먼저 질주만 해제한다.
		if self._T.sprintActive == true then
			self:EndSprint()
		end
		-- 캐릭터 정보창의 실제 크리티컬 확률(장비 잠재능력 반영)을 스킬 사용 시마다 서버로 동기화한다 -
		-- CalcCritical은 서버에서만 실행되고 장비/인벤토리는 클라이언트 전용 상태라, combatPower와
		-- 동일한 이유로 매 시전 직전에 최신값을 넘겨줘야 한다.
		local localPlayerForCrit = _UserService.LocalPlayer
		local paForCrit = isvalid(localPlayerForCrit) and localPlayerForCrit:GetComponent(PlayerAttack) or nil
		if paForCrit ~= nil then
			paForCrit:SyncCritRate(self:GetEffectiveCritRate())
			paForCrit:SyncCritDamage(_CharInfoManager:CalcCritDamage())
			paForCrit:SyncCombatPower(self:GetEffectiveCombatPower())
		end
		if slot.name == "HP포션" then
			_PotionShopManager:RequestUsePotion()
			self._T.slotData[key] = { ruid = "", name = "" }
			local potPos = self:GetBarPosForKey(key)
			if potPos ~= "" then self:UpdateBarSlotVisual(potPos) end
			_KeySettingManager:NotifyHotkeysChanged()
			log("[SkillManager] HP포션 사용 키=" .. key)
			-- 포션 사용으로 슬롯이 비워지는 것도 단축키 변경이므로 저장 예약
			_CharacterPersistence:MarkDirty("hotkey")
			return
		end
		if slot.name == "텔레포트" then
			-- 텔레포트는 다른 스킬들의 공용 쿨다운(skillOnCooldown)과 무관하게 독립된 쿨다운으로 동작한다 -
			-- 다른 스킬의 모션 재생/딜레이 중이라도 텔레포트는 사용할 수 있어야 한다는 요청 반영. 공용
			-- skillOnCooldown 게이트보다 먼저 확인/처리하고, 공용 플래그를 건드리지 않은 채 여기서 끝낸다.
			local inAuraTp = self:IsInRecoveryAura()
			if self._T.teleportOnCooldown and not inAuraTp then return end
			log("[SkillManager] 스킬 사용: " .. slot.name .. " (단축키: " .. key .. ")")
			-- 방향키 입력 상태는 클라이언트에서만 알 수 있다(_InputService:IsKeyPressed는 ClientOnly) - 여기서 확인해 서버로 전달한다.
			-- 위/아래를 좌우보다 우선한다: 위나 아래 화살표를 누르고 있으면 수직 텔레포트를, 아니면 좌/우(눌린 게 없으면 현재 바라보는 방향)로 이동한다.
			local dirKey = "right"
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirKey = "up"
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirKey = "down"
			elseif _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirKey = "left"
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirKey = "right"
			else
				local localPlayer = _UserService.LocalPlayer
				local ctrl = isvalid(localPlayer) and localPlayer.PlayerControllerComponent or nil
				if isvalid(ctrl) then
					dirKey = (ctrl.LookDirectionX >= 0) and "right" or "left"
				end
			end
			if not inAuraTp then
				self._T.teleportOnCooldown = true
				-- (피드백) "너무 연속해서 빠르게 사용된다" - 재사용 대기시간 1.2배(0.45 → 0.54초).
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.teleportCdGen = (self._T.teleportCdGen or 0) + 1
				local teleportGen = self._T.teleportCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.teleportCdGen ~= teleportGen then return end
					self._T.teleportOnCooldown = false
				end, 0.54)
			end
			self:RequestFireTeleport(dirKey)
			return
		end
		if slot.name == "어썰터" then
			-- (기능 변경) 어썰터는 스택형 충전 스킬 - 3초마다 스택이 1개씩 차고(최대 3개), 스택이 1개
			-- 이상이면 언제든 사용할 수 있다. 사용 시 스택 1개 소모 (요청사항).
			-- assaulterCastActive: 시전 진행 중(사라짐~착지 사이)에는 재시전 불가 - 착지 즉시
			-- (OnAssaulterChainReady) 풀려서 딜레이 없이 연속 시전된다.
			-- "사거리 내 타겟이 없으면 사용이 되지 않아야 한다"는 기존 동작 유지 - 서버가 대상 존재를
			-- 확인한 뒤(PlayerAttack.NotifyAssaulterResult) 성공시에만 스택을 소모한다.
			if self._T.assaulterStacks <= 0 or self._T.assaulterRequestPending or self._T.assaulterCastActive then return end
			log("[SkillManager] 스킬 사용 요청: " .. slot.name .. " (단축키: " .. key .. ")")
			self._T.assaulterRequestPending = true
			self._T.assaulterPendingKey = key
			-- 서버 응답이 비정상적으로 늦어지는 경우를 대비한 안전장치 - 최대 1초 뒤 자동으로 다시 시도 가능하게 한다.
			_TimerService:SetTimerOnce(function()
				self._T.assaulterRequestPending = false
			end, 1.0)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireAssaulter(combatPower)
			return
		end
		if slot.name == "가드" then
			-- 가드(패링): 공용 쿨다운과 무관한 독립 쿨타임 20초(패링 성공 시 5초로 단축 - NotifyGuardParrySuccess).
			-- 이펙트/모션 없이 서버에 1초 패링 창만 연다.
			local inAuraGuard = self:IsInRecoveryAura()
			if (self._T.guardCooldownUntil or 0) >= _UtilLogic.ElapsedSeconds and not inAuraGuard then return end
			self._T.guardUseAt = _UtilLogic.ElapsedSeconds
			if not inAuraGuard then
				self._T.guardCooldownUntil = self._T.guardUseAt + 20.0
				self._T.guardBarPos = self:GetBarPosForKey(key)
				if self._T.guardBarPos ~= "" then
					_GuardCooldownUI:ShowCooldown(20.0, self._T.guardBarPos)
				end
			end
			self:RequestFireGuard()
			log("[SkillManager] 가드 사용(패링 1초, 쿨타임 20초)")
			return
		end
		if slot.name == "패링" then
			-- 패링(요청 2026-07-28 개편): 시전 즉시 이펙트/모션이 나가고, 1.5초 안에 공격을 받으면
			-- 가드 표시와 함께 그 데미지를 무시 + 3초 무적. 기본 쿨타임 10초, 가드 성공 시 쿨타임 초기화
			-- (NotifyParrySuccess). 반격 데미지 계산에 쓸 전투력은 여기(클라이언트)에서만 정확히 알 수 있어
			-- 시전 시점에 서버로 넘긴다.
			local inAuraParry = self:IsInRecoveryAura()
			if (self._T.parryCooldownUntil or 0) >= _UtilLogic.ElapsedSeconds and not inAuraParry then return end
			self._T.parryUseAt = _UtilLogic.ElapsedSeconds
			if not inAuraParry then
				self._T.parryCooldownUntil = self._T.parryUseAt + 10.0
				self._T.parryBarPos = self:GetBarPosForKey(key)
				if self._T.parryBarPos ~= "" then
					_ParryCooldownUI:ShowCooldown(10.0, self._T.parryBarPos)
				end
			end
			self:RequestFireParry(self:GetEffectiveCombatPower())
			log("[SkillManager] 패링 사용(가드 창 1.5초, 쿨타임 10초)")
			return
		end
		if slot.name == "차지 블로우" then
			-- 차지 블로우(3차): 자체 쿨타임(퀵슬롯 표시 쿨타임) 없음. 공격 자체는 파워스트라이크와
			-- 완전히 동일하고(같은 모션/판정/데미지/파이널어택 경로를 그대로 태운다) 검 궤적 이펙트만
			-- 디바인 4종으로 정해둔 현재 속성의 전용 아트로 바뀐다.
			-- 연타 방지용 공용 게이트(skillOnCooldown)만 파워스트라이크와 같은 값으로 건다 - 이건
			-- 화면에 표시되는 재사용 대기시간이 아니라 모든 공격 스킬이 쓰는 공용 연타 제한이다.
			if self._T.skillOnCooldown then return end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- 속성을 아직 한 번도 안 골랐으면 기본 속성(GetEffectiveChargeBlowMode)으로 나간다.
			self:RequestFireChargeBlow(combatPower, atkMult, self:GetWeaponMotionClass(), self:GetEffectiveChargeBlowMode())
			log("[SkillManager] 차지 블로우(" .. self:GetChargeBlowModeName() .. " 상태) 사용")
			return
		end
		if self:IsChargeBlowModeSkill(slot.name) then
			-- 디바인 4종(스티그마 강화 / 스윙 강화 / 저지먼트 강화 / 차지): 차지 블로우의 속성을 정하는 스킬.
			-- ① 4개가 공용 0.5초 쿨타임을 함께 쓴다(하나를 쓰면 4개 전부 대기). 요청으로 2초 → 0.5초.
			-- ② 지금 켜져 있는 속성과 같은 스킬은 연속 사용 불가 - 눌러도 아무 반응이 없다.
			local newMode = self:GetChargeBlowModeIndex(slot.name)
			if newMode == (self._T.chargeBlowMode or 0) then
				log("[SkillManager] " .. slot.name .. ": 이미 적용된 속성 - 연속 사용 불가")
				return
			end
			local now = _UtilLogic.ElapsedSeconds
			local inAuraCb = self:IsInRecoveryAura()
			if (self._T.chargeBlowCooldownUntil or 0) > now and not inAuraCb then
				log("[SkillManager] " .. slot.name .. ": 전환 대기 중(" .. string.format("%.1f", self._T.chargeBlowCooldownUntil - now) .. "초 남음)")
				return
			end
			self._T.chargeBlowMode = newMode
			self:RefreshChargeBlowSlotIcon()
			if not inAuraCb then
				self._T.chargeBlowCooldownUntil = now + 0.5
				-- 4종이 각각 어느 퀵슬롯에 있든 그 칸들에 동시에 쿨타임을 그린다(배정 안 된 건 건너뜀).
				local slots = {}
				local names = { "디바인 스티그마 강화", "디바인 스윙 강화", "디바인 저지먼트 강화", "디바인 차지" }
				for _, n in ipairs(names) do
					table.insert(slots, self:FindBarPosForSkillName(n))
				end
				_ChargeBlowCooldownUI:ShowCooldownOnSlots(0.5, slots)
			end
			log("[SkillManager] 차지 블로우 속성 변경 → " .. self:GetChargeBlowModeName() .. " (디바인 4종 0.5초 쿨타임)")
			return
		end
		if slot.name == "드래곤 라이딩" then
			-- 드래곤 라이딩(3차): 공용 쿨다운과 무관한 독립 쿨타임 10분. 한 번의 키가 상황에 따라 3가지로 갈린다.
			--  ① 소환 중 + 탑승 중  → 내리기(하차)
			--  ② 소환 중 + 미탑승   → 탑승(쿨타임과 무관 - 쿨타임은 "재소환"에만 걸린다)
			--  ③ 미소환             → 소환(5분 지속) + 쿨타임 10분 시작
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.dragonRideActiveUntil or 0) > now then
				-- (요청) 키를 누르고 있으면 탑승 → 해제 → 탑승이 계속 반복된다. 다만 KeyDown 반복은
				-- 초당 수십 번이라 그대로 두면 워프 연출(0.5초)이 끝나기도 전에 뒤집혀 엉킨다.
				-- 한 번 전환하면 1초는 다음 전환을 막아, 연출이 끝난 뒤 또박또박 번갈아 돌게 한다.
				if (self._T.dragonRideToggleUntil or 0) > now then return end
				self._T.dragonRideToggleUntil = now + 1.0
				self:ToggleDragonRide()
				return
			end
			local inAuraRide = self:IsInRecoveryAura()
			if (self._T.dragonRideCooldownUntil or 0) > now and not inAuraRide then
				log("[SkillManager] 드래곤 라이딩: 쿨타임 중(" .. tostring(math.ceil(self._T.dragonRideCooldownUntil - now)) .. "초 남음)")
				return
			end
			self._T.dragonRideActiveUntil = now + 300.0     -- 소환 지속 5분
			self._T.dragonRideMounted = false
			if not inAuraRide then
				self._T.dragonRideCooldownUntil = now + 600.0   -- 재사용 대기 10분
				self._T.dragonRideBarPos = self:GetBarPosForKey(key)
				if self._T.dragonRideBarPos ~= "" then
					_DragonRidingCooldownUI:ShowCooldown(600.0, self._T.dragonRideBarPos)
				end
			end
			_DragonRidingBuffUI:ShowBuff(300.0)
			self:SetDragonRideSlotIcon(true)
			-- 소환 만료(5분) 처리 예약 - 탑승 중이면 강제로 내리고 퀵슬롯 아이콘을 되돌린다.
			if self._T.dragonRideExpireTimerId ~= nil then
				_TimerService:ClearTimer(self._T.dragonRideExpireTimerId)
			end
			self._T.dragonRideExpireTimerId = _TimerService:SetTimerOnce(function()
				self:OnDragonRideExpired()
			end, 300.0)
			self:RequestFireRidingDragon(_CharInfoManager:CalcCombatPower())
			log("[SkillManager] 드래곤 라이딩 소환! (지속 5분, 쿨타임 10분)")
			return
		end
		if slot.name == "프리져" then
			-- 프리져(4차 소환): 독립 쿨타임 30초. 소환 중 재시전하면 기존 프리져가 교체된다.
			local now = _UtilLogic.ElapsedSeconds
			local inAuraFreezer = self:IsInRecoveryAura()
			if (self._T.freezerCooldownUntil or 0) > now and not inAuraFreezer then
				log("[SkillManager] 프리져: 쿨타임 중(" .. tostring(math.ceil(self._T.freezerCooldownUntil - now)) .. "초 남음)")
				return
			end
			if not inAuraFreezer then
				self._T.freezerCooldownUntil = now + 30.0
			end
			self:RequestFireFreezer(_CharInfoManager:CalcCombatPower())
			log("[SkillManager] 프리져 소환! (지속 10분, 재사용 30초)")
			return
		end
		if slot.name == "피닉스" then
			-- 피닉스(4차 소환): 독립 쿨타임 30초. 소환 중 재시전하면 기존 피닉스가 교체된다.
			local now = _UtilLogic.ElapsedSeconds
			local inAuraPhoenix = self:IsInRecoveryAura()
			if (self._T.phoenixCooldownUntil or 0) > now and not inAuraPhoenix then
				log("[SkillManager] 피닉스: 쿨타임 중(" .. tostring(math.ceil(self._T.phoenixCooldownUntil - now)) .. "초 남음)")
				return
			end
			if not inAuraPhoenix then
				self._T.phoenixCooldownUntil = now + 30.0
			end
			self:RequestFirePhoenix(_CharInfoManager:CalcCombatPower())
			log("[SkillManager] 피닉스 소환! (지속 10분, 재사용 30초)")
			return
		end
		if slot.name == "바하뮤트" then
			-- 바하뮤트(4차 소환): 독립 쿨타임 30초. 소환 중 재시전하면 기존 바하뮤트가 교체된다.
			local now = _UtilLogic.ElapsedSeconds
			local inAuraBaha = self:IsInRecoveryAura()
			if (self._T.bahamutCooldownUntil or 0) > now and not inAuraBaha then
				log("[SkillManager] 바하뮤트: 쿨타임 중(" .. tostring(math.ceil(self._T.bahamutCooldownUntil - now)) .. "초 남음)")
				return
			end
			if not inAuraBaha then
				self._T.bahamutCooldownUntil = now + 30.0
			end
			self:RequestFireBahamut(_CharInfoManager:CalcCombatPower())
			log("[SkillManager] 바하뮤트 소환! (지속 10분, 재사용 30초)")
			return
		end
		if slot.name == "이프리트" then
			-- 이프리트(4차 소환): 엘퀴네스와 같은 규격 - 독립 쿨타임 30초, 재시전 시 교체.
			local now = _UtilLogic.ElapsedSeconds
			local inAuraIfrit = self:IsInRecoveryAura()
			if (self._T.ifritCooldownUntil or 0) > now and not inAuraIfrit then
				log("[SkillManager] 이프리트: 쿨타임 중(" .. tostring(math.ceil(self._T.ifritCooldownUntil - now)) .. "초 남음)")
				return
			end
			if not inAuraIfrit then
				self._T.ifritCooldownUntil = now + 30.0
			end
			self:RequestFireIfrit(_CharInfoManager:CalcCombatPower())
			log("[SkillManager] 이프리트 소환! (지속 10분, 재사용 30초)")
			return
		end
		if slot.name == "엘퀴네스" then
			-- 엘퀴네스(4차 소환): 바하뮤트와 같은 규격 - 독립 쿨타임 30초, 소환 중 재시전하면 교체된다.
			local now = _UtilLogic.ElapsedSeconds
			local inAuraElq = self:IsInRecoveryAura()
			if (self._T.elquinesCooldownUntil or 0) > now and not inAuraElq then
				log("[SkillManager] 엘퀴네스: 쿨타임 중(" .. tostring(math.ceil(self._T.elquinesCooldownUntil - now)) .. "초 남음)")
				return
			end
			if not inAuraElq then
				self._T.elquinesCooldownUntil = now + 30.0
			end
			self:RequestFireElquines(_CharInfoManager:CalcCombatPower())
			log("[SkillManager] 엘퀴네스 소환! (지속 10분, 재사용 30초)")
			return
		end
		if slot.name == "용사 소환" then
			-- 용사 소환(3차): (피드백) 재사용 대기시간 없음 - 언제든 다시 쓰면 기존 용사를 없애고
			-- 새 용사로 재소환한다(교체는 서버 PlayerAttack.SummonHero가 처리). 연타 오발동만 짧게(0.5초) 막는다.
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.heroSummonRecastGateUntil or 0) > now then return end
			self._T.heroSummonRecastGateUntil = now + 0.5
			-- 용사 레벨 산정용 내 레벨(전투력 10당 1레벨 - UIMyInfoManager와 동일 공식).
			local playerLevel = math.floor(_CharInfoManager:CalcCombatPower() / 10)
			self:RequestFireHeroSummon(playerLevel)
			-- 우측 상단 버프바에 소환 지속시간(5분)을 표시한다 - 재소환 시 타이머가 새로 갱신된다.
			_HeroSummonBuffUI:ShowBuff(300)
			log("[SkillManager] 용사 소환! (지속 5분, 쿨타임 없음 - 재사용 시 교체, 내 레벨=" .. tostring(playerLevel) .. ")")
			return
		end
		if slot.name == "홀리 매직쉘" then
			-- 홀리 매직쉘(4차): 공용 쿨다운과 무관한 독립 쿨타임 2분. 자신 + HP를 가진 아군 소환수
			-- 전원에게 10회 방어 쉴드를 건다(개체마다 각각 10회 - 서버 PlayerAttack.CastHolyMagicShell).
			local now = _UtilLogic.ElapsedSeconds
			local inAuraShell = self:IsInRecoveryAura()
			if (self._T.holyShellCooldownUntil or 0) > now and not inAuraShell then
				log("[SkillManager] 홀리 매직쉘: 쿨타임 중(" .. tostring(math.ceil(self._T.holyShellCooldownUntil - now)) .. "초 남음)")
				return
			end
			-- ⚠ (임시) 테스트용으로 쿨타임을 5초로 낮춘 상태다. 확정 값은 **120초(2분)** -
			--   테스트가 끝나면 아래 두 곳의 5.0을 120.0으로 되돌릴 것.
			local HOLY_SHELL_COOLDOWN = 5.0
			if not inAuraShell then
				self._T.holyShellCooldownUntil = now + HOLY_SHELL_COOLDOWN
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_HolyMagicShellCooldownUI:ShowCooldown(HOLY_SHELL_COOLDOWN, barPos)
				end
			end
			self:RequestFireHolyMagicShell()
			log("[SkillManager] 홀리 매직쉘! (개체별 10회 방어, 쿨타임 " .. tostring(HOLY_SHELL_COOLDOWN) .. "초 - 테스트용 임시값)")
			return
		end
		if slot.name == "리커버리 오로라" then
			-- 리커버리 오로라(4차): 발밑에 60초 오로라를 설치한다. 오로라 주변(가로 3.0 / 세로 2.5)에서는
			-- 쿨타임 스킬의 쿨타임 게이트가 전부 우회된다(각 게이트의 IsInRecoveryAura 확인).
			-- 자기 자신의 쿨타임(3분)만은 오로라 안에서도 그대로 적용된다 - 우회를 허용하면 무한 재설치로
			-- 영구 노쿨이 되기 때문(설계 의도상 예외).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.recoveryAuraCooldownUntil or 0) > now then
				log("[SkillManager] 리커버리 오로라: 쿨타임 중(" .. tostring(math.ceil(self._T.recoveryAuraCooldownUntil - now)) .. "초 남음)")
				return
			end
			self._T.recoveryAuraCooldownUntil = now + 180.0
			local barPos = self:GetBarPosForKey(key)
			if barPos ~= "" then
				_RecoveryAuraCooldownUI:ShowCooldown(180.0, barPos)
			end
			self:RequestFireRecoveryAura()
			log("[SkillManager] 리커버리 오로라 설치! (지속 1분, 주변 노쿨, 쿨타임 3분)")
			return
		end
		if slot.name == "드래곤 블러드" then
			-- 드래곤 블러드(4차 버프): 재사용 대기시간 없음(연타 오발동만 0.5초 차단).
			-- 지속 10분 / 공격력 +30 / 10초마다 최대HP 4% 소모 / HP 10% 이하면 서버가 자동 해제.
			-- 소환된 드래곤(용 소환 6마리 + 드래곤 라이딩)이 때릴 때마다 최대HP 3% 회복(서버 처리).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.dragonBloodGateUntil or 0) > now then return end
			self._T.dragonBloodGateUntil = now + 0.5
			-- 공격력 +30은 다른 공격 버프(분노/메디테이션)와 같은 경로로 스탯창에 반영된다.
			_CharInfoManager:ApplyAttackBuff("dragonblood", 30, 600.0)
			_DragonBloodBuffUI:ShowBuff(600.0)
			self:RequestFireDragonBlood()
			log("[SkillManager] 드래곤 블러드! (지속 10분, 공격력 +30, 10초마다 최대HP 4% 소모)")
			return
		end
		if slot.name == "용 소환" then
			-- 용 소환(3차): 공용 쿨다운과 무관한 독립 쿨타임 10분, 소환 지속 10분(요청 - 쿨타임과 동일하므로
			-- 지속시간이 끝나는 시점과 재사용 가능 시점이 맞물린다).
			-- 재사용 대기 중에는 다시 쓸 수 없다(라이딩과 달리 탑승/토글이 없어 분기가 하나뿐).
			local now = _UtilLogic.ElapsedSeconds
			local inAuraDragons = self:IsInRecoveryAura()
			if (self._T.sixDragonsCooldownUntil or 0) > now and not inAuraDragons then
				log("[SkillManager] 용 소환: 쿨타임 중(" .. tostring(math.ceil(self._T.sixDragonsCooldownUntil - now)) .. "초 남음)")
				return
			end
			if not inAuraDragons then
				self._T.sixDragonsCooldownUntil = now + 600.0
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_SixDragonsCooldownUI:ShowCooldown(600.0, barPos)
				end
			end
			_SixDragonsBuffUI:ShowBuff(600.0)
			self:RequestFireSixDragons(_CharInfoManager:CalcCombatPower())
			log("[SkillManager] 용 소환! 6마리 (지속 10분, 쿨타임 10분)")
			return
		end
		if slot.name == "표창+" then
			-- (요청) 표창+ 시전 = 던질 표창 고르기. 주변에 표창 종류가 뜨고 번호키로 3초 안에 고른다.
			-- 데미지를 주는 스킬이 아니라서 쿨타임/전투력 계산 없이 선택 UI만 연다.
			self:OpenShurikenSelect()
			return
		end
		if slot.name == "힐러 소환" then
			-- 힐러 소환(3차): 용사 소환과 같은 규격 - 재사용 대기시간 없음(연타 오발동만 0.5초 차단),
			-- 다시 쓰면 기존 힐러를 없애고 새로 소환한다(교체는 서버 PlayerAttack.SummonHealer가 처리).
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.healerSummonRecastGateUntil or 0) > now then return end
			self._T.healerSummonRecastGateUntil = now + 0.5
			-- 힐러 레벨 산정용 내 레벨(전투력 10당 1레벨 - UIMyInfoManager와 동일 공식).
			local playerLevel = math.floor(_CharInfoManager:CalcCombatPower() / 10)
			self:RequestFireHealerSummon(playerLevel)
			-- 우측 상단 버프바에 소환 지속시간(5분)을 표시한다 - 재소환 시 타이머가 새로 갱신된다.
			_HealerSummonBuffUI:ShowBuff(300)
			log("[SkillManager] 힐러 소환! (지속 5분, 쿨타임 없음 - 재사용 시 교체, 내 레벨=" .. tostring(playerLevel) .. ")")
			return
		end
		if slot.name == "리저렉션" then
			-- 리저렉션(4차): 죽어 쓰러져 있는 소환 용사를 부활시킨다. 연타 오발동만 짧게(0.5초) 막는다.
			local now = _UtilLogic.ElapsedSeconds
			if (self._T.resurrectionGateUntil or 0) > now then return end
			self._T.resurrectionGateUntil = now + 0.5
			-- 전역 행동잠금: (피드백) 시전 이펙트 전체 길이의 0.7배 ≈ 2.28초 -
			-- 이동은 서버(CastBuffMotion)가, 스킬 입력은 UseSkillInSlot 상단 게이트가 막는다.
			self._T.actionLockUntil = now + 19 * 0.12 / 0.7 * 0.7
			self:RequestFireResurrection()
			log("[SkillManager] 리저렉션 시전 요청")
			return
		end
		-- (브랜디쉬2 콤보) 브랜디쉬 진행 [절반~끝]에 브랜디쉬를 재입력하면, 공용 쿨다운 게이트에 막혀 그냥
		-- 버려지는 대신 브랜디쉬2를 예약한다(서버가 브랜디쉬 종료 시점에 빠른 2줄 추가타로 이어감). 창 밖의
		-- 재입력은 아래로 흘려보내 평소대로(쿨다운 중이면 무시 / 아니면 새 브랜디쉬) 처리한다.
		if slot.name == "브랜디쉬" then
			local st = self._T.brandishCastStartTime
			local dur = self._T.brandishCastDuration
			if st ~= nil and dur ~= nil then
				local elapsed = _UtilLogic.ElapsedSeconds - st
				if elapsed >= 0.5 * dur and elapsed <= dur and not self._T.brandish2Requested then
					self._T.brandish2Requested = true
					_TimerService:SetTimerOnce(function()
						self._T.brandish2Requested = false
					end, dur)
					local combatPower = self:GetEffectiveCombatPower()
					local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
					-- 브랜디쉬 강화 버프 활성 시 콤보(브랜디쉬2)도 데미지 1.5배 + 공속 +1단계로 이어진다.
					if _CharInfoManager:IsBrandishEnhanceActive() then
						combatPower = math.floor(combatPower * 1.5)
						atkMult = atkMult * 0.9
					end
					self:RequestQueueBrandish2(combatPower, atkMult)
					log("[SkillManager] 브랜디쉬2 콤보 예약(재입력) elapsed=" .. tostring(elapsed))
					return
				end
			end
		end
		if self._T.skillOnCooldown then return end
		log("[SkillManager] 스킬 사용: " .. slot.name .. " (단축키: " .. key .. ")")
		if slot.name == "달팽이 세마리" then
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75)
			_SoundService:PlaySound("06f080c8c42e431785a46e20ec9be5bb", 1.0)
			self:RequestFireSnailSkill()
		elseif slot.name == "파워스트라이크" then
			-- 공격속도 배율도 쿨다운(재사용 대기시간)에 함께 적용한다 - 공격속도가 빠를수록 다음 스킬을 더 빨리 다시 쓸 수 있어야 한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- 무기 분류(창·폴암/두손검/한손검) 모션 분기용 - 인벤토리/장비는 클라이언트 전용 상태라 여기서 확인해 전달한다.
			self:RequestFirePowerStrike(combatPower, atkMult, self:GetWeaponMotionClass())
		elseif slot.name == "슬래시블러스트" or slot.name == "슬래쉬블래스트" then
			-- (이름 변경) 새 이름 "슬래시블러스트" + 이미 퀵슬롯에 저장된 옛 이름("슬래쉬블래스트")도 호환.
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireSlashBlast(combatPower, atkMult, self:GetWeaponMotionClass())
		elseif slot.name == "럭키세븐" then
			-- 럭키세븐은 가니어를 장착한 상태에서만 사용 가능하다. 인벤토리/장비 상태는 클라이언트에만 존재하므로
			-- (서버는 CostumeManagerComponent의 실제 장착값을 알 수 없음) 여기 클라이언트 측에서 확인한다.
			if not self:IsClawEquipped() then
				log("[SkillManager] 럭키세븐: 가니어를 장착하지 않아 사용할 수 없습니다.")
				return
			end
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireLuckySeven(combatPower, atkMult)
		elseif slot.name == "트리플 스로우" or slot.name == "쿼드러플 스로우" then
			-- 럭키세븐의 상위 스킬(3발/4발). 가니어 장착 조건·쿨다운 구조가 럭키세븐과 같고,
			-- 표창이 늘어난 만큼(발당 0.1초) 재사용 대기시간만 더 길게 잡는다.
			if not self:IsClawEquipped() then
				log("[SkillManager] " .. tostring(slot.name) .. ": 가니어를 장착하지 않아 사용할 수 없습니다.")
				return
			end
			local shots = (slot.name == "쿼드러플 스로우") and 4 or 3
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			-- (요청) 후딜 축소 - PlayerAttack의 조작 복구 시점(0.4 + 0.07*(발수-1) + 0.06)에
			-- 아주 짧은 여유만 더한다. 트리플 0.63초 / 쿼드러플 0.70초 (기존 0.85 / 0.95초).
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, (0.4 + 0.07 * (shots - 1) + 0.09) * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			if shots == 4 then
				self:RequestFireQuadThrow(combatPower, atkMult)
			else
				self:RequestFireTripleThrow(combatPower, atkMult)
			end
		elseif slot.name == "더블스탭" then
			-- 더블스탭은 공격속도가 현재 단계보다 1단계 더 빠르게 고정 적용된다(0.9배 추가) -
			-- GetAttackSpeedMultiplier는 0.9^(stage-5)이므로, 한 단계 더 빠른 속도는 그 값에 0.9를 한 번 더 곱한 것과 같다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier() * 0.9
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireDoubleStab(combatPower, atkMult)
		elseif slot.name == "새비지블로우" then
			-- 새비지블로우: 전방 1명을 6번 때리는 단일 대상 스킬. 다른 스킬들과 동일하게 공격속도 배율을
			-- 재사용 대기시간에 함께 적용한다.
			-- 재사용 대기시간은 마지막 타격(0.12 + 7*0.09 = 0.75*배율)과 컨트롤 복구(0.77*배율) 직후로 잡는다 -
			-- "끝 딜레이를 더 줄여달라"는 피드백으로 0.90 → 0.82*배율까지 줄였다(키 홀드 연속 시전 포함).
			-- 8번 이미지는 전용 이펙트 엔티티가 자기 타이머로 끝까지 재생하므로 잘리지 않는다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.82 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireSavageBlow(combatPower, atkMult)
		elseif slot.name == "매직클로" then
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireMagicClaw(combatPower, atkMult)
		elseif slot.name == "매직 미사일" then
			-- 소환→조준(0.5초)→발사 플래시→발사로 이어지는 긴 시퀀스라 쿨다운은 1.0초*배율로 둔다.
			-- 레벨(전투력 10당 1 - 파이어에로우와 동일한 클라이언트 계산식)은 구체 개수 결정용으로 서버에 넘긴다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			local level = math.floor(combatPower / 10)
			-- (요청) 매직 에로우(빛/얼음/불) 토글이 켜져 있으면 데미지 2배 + 속성색. 데미지 2배는
			-- 브랜디쉬 강화와 동일하게 combatPower를 미리 2배로 올려 넘기는 방식(서버 데미지 공식은 그대로).
			-- 레벨(구체 개수)은 강화 전 전투력 기준으로 계산해 구체 수가 같이 2배로 뻥튀기되지 않게 한다.
			local element = _CharInfoManager:GetMagicMissileElement()
			if element ~= "" then
				combatPower = combatPower * 2
			end
			self:RequestFireMagicMissile(combatPower, atkMult, level, element)
		elseif slot.name == "체인라이트닝" then
			-- 체인 라이트닝(4차): 기모으기 0.5초 + 발사(≈0.7초)로 시전이 길어 쿨다운은 1.0초*배율.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireChainLightning(combatPower, atkMult)
		elseif slot.name == "암살" then
			-- 암살(4차): 연쇄 연출이 0.05초 간격 × 최대 10명(≈1.05초)이라 쿨다운은 1.2초*배율.
			-- (피드백) 홀드 연속 사용 시 "다시 보이기 전에 다시 사라져야" 하므로, 연쇄가 끝난 직후
			-- 바로 다음 시전이 들어오도록 쿨다운을 1.5 → 1.2초로 줄였다(서버 복귀 유예 0.35초보다
			-- 짧은 간격 = 복귀 연출이 취소되고 그대로 이어진다).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.2 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- 시전할 때마다 "아직 누르고 있다"를 서버에 갱신해준다(복귀 판단에 쓰인다).
			self:RequestSetAssassinateHold(true)
			self:RequestFireAssassinate(combatPower, atkMult)
		elseif slot.name == "연막" then
			-- 연막(4차): 지속 10초 / 재사용 대기시간 20초(다크사이트와 같은 전용 쿨다운 게이트 방식).
			local nowSmoke = _UtilLogic.ElapsedSeconds
			if (self._T.smokeScreenCooldownUntil or 0) > nowSmoke and not self:IsInRecoveryAura() then
				log("[SkillManager] 연막: 쿨타임 중(" .. tostring(math.ceil(self._T.smokeScreenCooldownUntil - nowSmoke)) .. "초 남음)")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			if not self:IsInRecoveryAura() then
				self._T.smokeScreenCooldownUntil = nowSmoke + 20.0
				local smokeBarPos = self:GetBarPosForKey(key)
				if smokeBarPos ~= "" then
					_TimerService:SetTimerOnce(function()
						self:BlinkSlotReady(smokeBarPos)
					end, 20.0)
				end
			end
			-- (요청) 시전 모션(swingOF ≈0.6초×공속) 동안은 행동 불가 - 이동은 서버(AttackSmokeScreen)가
			-- 컨트롤러를 꺼서 막고, 다른 스킬 입력은 이 전역 행동잠금이 UseSkillInSlot 상단에서 막는다.
			self._T.actionLockUntil = nowSmoke + 0.6 * atkMult
			self:RequestFireSmokeScreen(atkMult)
		elseif slot.name == "썬더볼트" then
			-- 다른 스킬들과 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireThunderbolt(combatPower, atkMult)
		elseif slot.name == "힐" then
			-- 힐은 다른 스킬과 달리 공격속도를 1단계 올린 속도로 사용한다(요청사항) - 기본 배율에
			-- 0.9를 추가로 곱해 "현재 공격속도 단계+1"에 해당하는 배율을 쿨다운/모션 재생시간 모두에 적용한다.
			local baseAtkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			local atkMult = baseAtkMult * 0.9
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = _CharInfoManager:CalcCombatPower()
			self:RequestFireHeal(combatPower, atkMult)
		elseif slot.name == "파이어에로우" then
			-- 방향키 입력 상태는 클라이언트에서만 알 수 있다(_InputService:IsKeyPressed는 ClientOnly) - 여기서 확인해 서버로 전달한다.
			-- 위/아래/좌/우를 동시에 조합해 대각선까지 지원하고, 아무 키도 없으면 서버에서 캐릭터가 바라보는 방향(전방)으로 처리한다.
			local dirX, dirY = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirX = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirX = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirY = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirY = -1
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- 레벨 50 이상 이펙트 분기용 - _UIMyInfoManager.CharLevel은 서버에서 갱신되지 않는 고정값(항상 1)이라
			-- 사용할 수 없음(UIMyInfoManager.UpdateBars가 실제 표시레벨은 DisplayLevel에만 client-only로 계산함).
			-- combatPower와 동일한 클라이언트 계산식(전투력 10당 1레벨)으로 직접 구해 서버로 전달한다.
			local level = math.floor(combatPower / 10)
			self:RequestFireFireArrow(combatPower, atkMult, dirX, dirY, level)
		elseif slot.name == "더블샷" then
			-- 더블샷도 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만 발사한다.
			-- 직업 인덱스(신궁 7 / 보우마스터 8)는 캐릭터 선택 슬롯 데이터에서 읽는 클라이언트 전용
			-- 값이라(GetSelectedCharacterJobIdx는 ClientOnly) combatPower와 동일하게 서버로 넘겨준다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			local jobIdx = math.floor(_UIMyInfoManager:GetSelectedCharacterJobIdx())
			self:RequestFireDoubleShot(combatPower, atkMult, jobIdx)
		elseif slot.name == "스트레이프" then
			-- 스트레이프(3차)도 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만 발사한다.
			-- 네 발이 0.2 + 0.09*3 = 0.47*배율까지 이어져 나가므로 쿨다운은 더블샷(0.75)보다 긴
			-- 0.9*배율로 잡는다(PlayerAttack.AttackStrafe의 컨트롤 복구 시점과 동일).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.9 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireStrafe(combatPower, atkMult)
		elseif slot.name == "아이스 샷" then
			-- 아이스 샷(3차): 방향 무관 범위 다중 대상 - 시전 이펙트(약 1초)와 화살 도착까지 감안해
			-- 쿨다운은 1.0*배율(PlayerAttack.AttackIceShot의 컨트롤 복구 시점과 동일)로 잡는다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireIceShot(combatPower, atkMult)
		elseif slot.name == "파이어 샷" then
			-- 파이어 샷(3차): 아이스 샷과 동일한 규격의 쿨다운(1.0*배율).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 1.0 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireFireShot(combatPower, atkMult)
		elseif slot.name == "에로우 블로우" then
			-- 에로우 블로우(1차)는 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만 발사한다 -
			-- 방향키 상태를 읽을 필요가 없어 combatPower/공격속도 배율만 서버로 넘긴다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			-- 강화 ON/OFF는 클라 전용 상태라 시전 시점에 읽어 서버로 넘긴다(combatPower와 동일 패턴).
			local enhanced = _CharInfoManager:IsArrowBlowEnhanceActive()
			self:RequestFireArrowBlow(combatPower, atkMult, enhanced)
		elseif slot.name == "아이언 에로우" then
			-- 파이어에로우와 동일한 8방향 입력 처리. 레벨에 따른 이펙트 분기는 없다(고정 1종).
			local dirX, dirY = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirX = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirX = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirY = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirY = -1
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireIronArrow(combatPower, atkMult, dirX, dirY)
		elseif slot.name == "엔젤레이" then
			-- 엔젤레이(4차): 아이언에로우와 같은 구조지만 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만
			-- 발사한다 - 방향키 상태를 읽을 필요가 없어 combatPower/공격속도 배율만 서버로 넘긴다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireAngelRay(combatPower, atkMult)
		elseif slot.name == "홀리 에로우" then
			-- 홀리 에로우(2차): 엔젤레이와 같은 전방 고정 발사 - combatPower/공격속도 배율만 서버로 넘긴다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireHolyArrow(combatPower, atkMult)
		elseif slot.name == "어벤져" then
			-- 파이어에로우/아이언에로우와 동일한 8방향 입력 처리.
			local dirX, dirY = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirX = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirX = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirY = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirY = -1
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			-- (기능 수정) 몸쪽 이펙트(0.6) + 0.2초 뒤 투사체 발사로 PlayerAttack.AttackAvenger의 실제
			-- 발동 주기가 0.85*mult로 늘어난 것에 맞춰 쿨다운도 동일하게 맞춘다(다른 화살류 스킬과 같은 이유).
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.85 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireAvenger(combatPower, atkMult, dirX, dirY)
		elseif slot.name == "헤이스트" then
			-- 헤이스트는 공격이 아니라 버프이므로 combatPower는 필요 없다. 다른 스킬과 동일하게
			-- 공격속도 배율만큼 짧은 재사용 대기시간만 두고(연타 스팸 방지), 5분 지속시간 자체는
			-- 재사용 가능 - 지속 중 다시 쓰면 서버 쪽에서 중첩 없이 지속시간만 갱신된다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			self:RequestFireHaste(atkMult)
		elseif slot.name == "쉐도우 파트너" then
			-- 쉐도우 파트너도 헤이스트와 동일하게 공격이 아니라 버프(30분)이므로 combatPower는 필요 없다.
			-- 연타 스팸 방지용 짧은 재사용 대기시간만 두고, 지속 중 다시 쓰면 서버에서 중첩 없이
			-- 지속시간만 갱신된다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			self:RequestFireShadowPartner(atkMult)
		elseif slot.name == "부스터" then
			-- 부스터: 5분간 공격속도 1단계 상승. 이 스탯(atkSpeedStage)은 CharInfoManager가 클라이언트
			-- 전용으로 들고 있어(서버에 대응 데이터 없음) 실제 효과는 이 클라이언트에서 즉시 적용하고,
			-- 서버로는 다른 플레이어에게 보이는 시전 이펙트/사운드 재생만 요청한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local jobIdx = _UIMyInfoManager:GetSelectedCharacterJobIdx()
			local isMage = (jobIdx == 4 or jobIdx == 5 or jobIdx == 6)
			_CharInfoManager:UseBooster()
			self:RequestFireBooster(isMage, atkMult)
			log("[SkillManager] 부스터 사용!")
		elseif slot.name == "브랜디쉬 강화" then
			-- 브랜디쉬 강화(4차 버프): 5분간 브랜디쉬 데미지 1.5배 + 브랜디쉬 공속 +1단계 + 붉은 이펙트.
			-- 부스터와 동일하게 클라 전용 상태(CharInfoManager)로 즉시 적용, 공용 쿨다운만 짧게 둔다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			_CharInfoManager:UseBrandishEnhance()
			log("[SkillManager] 브랜디쉬 강화 사용!")
		elseif slot.name == "서먼 다크드래곤" then
			-- 서먼 다크드래곤(2차 버프, 10분): 유저는 활성 중 재시전 불가(드래곤의 블랙드래곤 연쇄 소환은 서버
			-- 쪽에서 이 게이트를 거치지 않으므로 계속 가능). 만료 후 재사용 가능.
			if (self._T.darkDragonActiveUntil or 0) > _UtilLogic.ElapsedSeconds then
				log("[SkillManager] 서먼 다크드래곤: 이미 소환 중")
				return
			end
			self._T.darkDragonActiveUntil = _UtilLogic.ElapsedSeconds + 600
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = _CharInfoManager:CalcCombatPower()
			self:RequestFireDarkDragon(combatPower)
			log("[SkillManager] 서먼 다크드래곤 사용! (10분)")
		elseif slot.name == "분노" then
			-- 분노(2차 버프): 5분간 공마 +30. 부스터/헤이스트와 동일하게 공용 쿨다운만 짧게 두고
			-- 실제 효과는 클라이언트 전용 스탯이라 이 클라에서 즉시 적용, 서버로는 시전 연출만 요청.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			_CharInfoManager:UseRage()
			self:RequestFireRage(atkMult)
			log("[SkillManager] 분노 사용!")
		elseif slot.name == "불의 영역" then
			-- 불의 영역(2차 버프): 10분간 공격 적중 시 10% 확률로 화염 지대 생성(판정은 서버).
			-- 전투력은 시전 시점 값을 서버에 넘겨 화염 지대 데미지 기준으로 쓴다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			self:RequestFireFireZone(_CharInfoManager:CalcCombatPower())
			_FireZoneBuffUI:ShowBuff(600)
			log("[SkillManager] 불의 영역 사용! (10분)")
		elseif slot.name == "빙하지대" then
			-- 빙하지대(2차 버프): 불의 영역과 동일 구조의 얼음 판.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			self:RequestFireGlacierZone(_CharInfoManager:CalcCombatPower())
			_GlacierBuffUI:ShowBuff(600)
			log("[SkillManager] 빙하지대 사용! (10분)")
		elseif slot.name == "메디테이션" then
			-- 메디테이션(2차 버프): 5분간 공마 +30. 분노와 동일한 처리.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			_CharInfoManager:UseMeditation()
			self:RequestFireMeditation(atkMult)
			log("[SkillManager] 메디테이션 사용!")
		elseif slot.name == "블레스" then
			-- 블레스(2차 버프): 자신 공마 +30은 클라 전용 스탯이라 즉시 적용하고, 시전 연출과
			-- 힐 범위 안 소환 용사들의 버프/피버프 이펙트는 서버(PlayerAttack.AttackBless)가 처리.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			_CharInfoManager:UseBless()
			self:RequestFireBless(atkMult)
			log("[SkillManager] 블레스 사용!")
		elseif slot.name == "파워가드" then
			-- 파워가드(2차 버프): 5분간 공격력 +10(클라 스탯) + 받는 피해 30% 회복(서버 PlayerHit).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			_CharInfoManager:UsePowerGuard()
			self:RequestFirePowerGuard(atkMult)
			log("[SkillManager] 파워가드 사용!")
		elseif slot.name == "포이즌 미스트" then
			-- 포이즌 미스트: 독 데미지 자체는 공격속도 영향을 받지 않지만, 스킬 자체의 재사용 대기시간은
			-- 다른 스킬과 동일하게 공격속도 배율을 적용한다(연타 스팸 방지 목적일 뿐 독 틱과는 무관).
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFirePoisonMist(combatPower, atkMult)
		elseif slot.name == "익스플로젼" then
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireExplosion(combatPower, atkMult)
		elseif slot.name == "드래곤 로어" then
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireDragonRoar(combatPower, atkMult)
		elseif slot.name == "스피어 버스터" then
			-- (실측 확인) 클라이언트 쿨다운을 다른 스킬과 동일하게 0.75*atkMult로 두면, 서버 쪽
			-- isSpearBursting 잠금이 풀리는 시점(RestoreSpearBurstControl)보다 클라이언트가
			-- 먼저 재시전을 시도하게 돼, 홀드 지속 시전 시 요청의 절반 가까이가 "이미 진행 중"으로
			-- 차단되는 문제가 있었다(로그로 확인: 116번 시도 중 58번 차단). 서버 잠금 해제 시점과
			-- 동일하게 맞춰 홀드 시 매번 성공하도록 한다.
			-- (버그 수정) RestoreSpearBurstControl 자체가 PlayerAttack.mlua에서 반대 방향 모션 재생
			-- 버그를 막기 위해 0.95*atkMult에서 1.55*atkMult로 늦춰졌으므로, 여기 쿨다운도 동일하게
			-- 맞춘다 - 둘이 어긋나면 이 "이미 진행 중" 차단 문제가 다시 재현된다.
			-- (기능 추가) PlayerAttack.AttackSpearBurst에서 이펙트/데미지 공용이었던 hitStartDelay가
			-- "히트 속도는 0.7초 뒤, 찌르기 3종 이펙트 시점은 그보다 0.5초 앞당겨서" 요청으로
			-- damageStartDelay(0.7)/effectStartDelay(0.2)로 다시 분리됐다.
			-- (기능 추가) "스킬이 끝났는데도 못 움직이는 시간이 길게 느껴진다"는 피드백으로
			-- RestoreSpearBurstControl 호출 시점이 damageStartDelay + 1.0*atkMult(여유 과다)에서
			-- damageStartDelay + 0.2*atkMult + 0.05(3번째 실제 데미지 판정 직후 최소 여유)로 줄었다 -
			-- 이 쿨다운도 그와 반드시 동일해야 하므로 맞춘다.
			-- (기능 추가) "3종 찌르기 이펙트 간 시간 간격을 1.5배 늘려달라"는 피드백으로 PlayerAttack.mlua의
			-- 간격 상수가 0.2*mult→0.3*mult로 늘어난 것에 맞춰 이 쿨다운도 동일하게 0.3*atkMult로 맞춘다.
			-- (기능 추가) "데미지 시점을 0.2초 앞당겨달라"는 피드백으로 damageStartDelay가 0.7→0.5로
			-- 줄어든 것에 맞춰 이 쿨다운의 기준값도 0.7→0.5로 함께 맞춘다.
			-- (되돌림) "공격속도 단계를 올려도 스피어 버스터에 적용되지 않는다"는 피드백으로, 이전에
			-- 고정했던 하드코딩(0.9^3, 공격속도 3단계 고정)을 되돌리고 다른 스킬과 동일하게 플레이어의
			-- 실제 현재 공격속도 단계를 그대로 사용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- (버그 수정) PlayerAttack.AttackSpearBurst의 컨트롤 복구 시점과 반드시 동일한 공식으로
			-- 맞춘다(둘이 어긋나면 "이미 진행 중" 차단 문제가 재현된다).
			-- (버그 수정) "꾹 누르고 있으면 중간중간 1-2초씩 불규칙하게 멈춘다"는 피드백 - 로그로 실측한
			-- 결과, 서버 쪽 isSpearBursting 잠금 해제와 클라이언트 쿨다운 해제가 평균적으로는 같은
			-- 공식이라도 매 호출마다 클라이언트→서버 RPC 왕복 지연(네트워크 지터)이 조금씩 달라, 가끔
			-- 클라이언트가 서버보다 미세하게 먼저 재시전을 시도해 "이미 진행 중"으로 막힌다 - 이때
			-- 클라이언트는 이미 자기 쿨다운을 다 쓴 것으로 착각해 다음 재시전까지 꼬박 한 주기를 더
			-- 기다리게 되고, 그 결과 직전 성공 시점부터는 정상 간격의 약 2배로 보인다. 클라이언트
			-- 쿨다운에 지터 흡수용 여유(0.15초)를 추가로 얹어, 클라이언트가 항상 서버보다 확실히 늦게
			-- 재시전을 시도하도록 한다.
			-- (버그 수정) "공속을 올려도 공격 횟수가 거의 안 는다 - 파워스트라이크는 확실히 는다"는
			-- 피드백 - damageStartDelay(0.5)가 atkMult와 무관한 고정값이라 전체 주기가 공속에 비례해
			-- 줄지 않던 것이 원인이었다. PlayerAttack.AttackSpearBurst와 동일하게 damageStartDelay 자체를
			-- 0.5*atkMult로 스케일링했으므로, 여기 쿨다운 공식도 반드시 동일하게 맞춘다.
			-- (버그 수정) 이어서 "+0.05" 안전 여유도 atkMult와 무관한 고정값이라 공속이 빨라질수록 전체
			-- 주기에서 차지하는 비중이 커져 DPS 스케일링을 계속 깎아먹고 있었다 - 0.05*atkMult로 바꿔
			-- 파워스트라이크(0.75*atkMult)와 동일하게 순수 비례식(0.85*atkMult)이 되도록 한다. 지터
			-- 흡수용 여유(jitterMargin)만은 실제 네트워크 왕복 지연(공속과 무관한 고정 시간)을 막기
			-- 위한 것이므로 의도적으로 고정값(0.15초)을 유지한다.
			-- (기능 추가) "날개가 생기고 다음 공격까지의 시간을 단축해달라 - stabT1 frame2가 재생될
			-- 때여야 한다"는 피드백으로 PlayerAttack의 damageStartDelay가 0.5*atkMult에서 5단 조합
			-- 모션의 3번째 포즈 시점(2 * poseInterval = 0.288*atkMult)으로 당겨졌다. 이 쿨다운도
			-- 반드시 동일한 공식이어야 한다.
			-- (버그 수정) motionComboEnd가 (0.12+0.25+0.2)=0.57로 남아 있었는데, PlayerAttack 쪽은
			-- 이미 beat3Hold 0.2→0.35 수정으로 0.72였다(여기만 갱신이 누락돼 있었다). 지금은 5단
			-- 조합 포즈(5 * poseInterval = 0.72*atkMult)로 바뀌었으므로 그 값으로 맞춘다 - 이 값이
			-- 이제 아래 math.max의 승자라서, 어긋나면 곧바로 "이미 진행 중" 차단이 재현된다.
			local poseInterval = 0.144 * atkMult
			local damageStartDelay = 2 * poseInterval
			local motionComboEnd = 5 * poseInterval
			local jitterMargin = 0.15
			local spearBurstCooldownDuration = math.max(damageStartDelay + 0.3 * atkMult + 0.05 * atkMult, motionComboEnd + 0.05 * atkMult) + jitterMargin
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, spearBurstCooldownDuration)
			local combatPower = self:GetEffectiveCombatPower()
			-- (4차 패시브) 어드밴스드 스피어 버스터 보유 시 데미지 1.5배 + 이펙트 색(검정/하양/빨강).
			-- 브랜디쉬 강화와 동일 방식: 클라에서 combatPower를 1.5배로 올려 넘기고 enhanced 플래그도 전달.
			local enhanced = _CharInfoManager:IsAdvancedSpearBusterOwned()
			if enhanced then combatPower = math.floor(combatPower * 1.5) end
			self:RequestFireSpearBurst(combatPower, atkMult, enhanced)
		elseif slot.name == "콤보 어택" then
			-- 콤보 어택(3차, 버프 30분): 헤이스트와 동일하게 공격이 아니라 버프이므로 combatPower는
			-- 필요 없고, 짧은 재사용 대기시간만 둔다(연타 스팸 방지). 지속 중 다시 쓰면 서버 쪽에서
			-- 중첩 없이 지속시간만 갱신된다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			self:RequestFireComboAttack(atkMult)
			log("[SkillManager] 콤보 어택 사용!")
		elseif slot.name == "패닉" then
			-- 패닉: 콤보 어택으로 쌓은 콤보 구슬을 모두 소모해 단일 대상에게 강력한 피해를 입힌다.
			-- 구슬이 하나도 없으면 사용할 수 없다(요청사항) - 서버(PlayerAttack.AttackPanic)에서도
			-- 다시 확인하지만, 클라이언트에서 미리 걸러 헛되이 쿨다운이 걸리지 않게 한다(럭키세븐의
			-- 가니어 장착 확인과 동일한 패턴).
			local localPlayer = _UserService.LocalPlayer
			local paComp = isvalid(localPlayer) and localPlayer:GetComponent(PlayerAttack) or nil
			if paComp == nil or (paComp.ComboOrbCount or 0) <= 0 then
				log("[SkillManager] 패닉: 콤보 구슬이 없어 사용할 수 없습니다.")
				return
			end
			-- 파워스트라이크와 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFirePanic(combatPower, atkMult)
			log("[SkillManager] 패닉 사용!")
		elseif slot.name == "코마" then
			-- 코마: 패닉과 동일하게 콤보 어택으로 쌓은 콤보 구슬을 모두 소모한다(다만 다중 대상).
			-- 구슬이 하나도 없으면 사용할 수 없다 - 패닉과 동일한 클라이언트 사전 확인 패턴.
			local localPlayer = _UserService.LocalPlayer
			local paComp = isvalid(localPlayer) and localPlayer:GetComponent(PlayerAttack) or nil
			if paComp == nil or (paComp.ComboOrbCount or 0) <= 0 then
				log("[SkillManager] 코마: 콤보 구슬이 없어 사용할 수 없습니다.")
				return
			end
			-- 패닉과 동일하게 공격속도 배율을 쿨다운(재사용 대기시간)에 함께 적용한다.
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireComa(combatPower, atkMult)
			log("[SkillManager] 코마 사용!")
		elseif slot.name == "블리자드" then
			-- 블리자드(4차): 자체 쿨타임 20초. 어썰터와 동일하게 퀵슬롯 아이콘 위에 회색 오버레이 + 남은
			-- 초 숫자로 쿨타임을 표시한다(전용 오버레이 엔티티를 쓰므로 어썰터 표시와 서로 간섭하지 않는다).
			local inAuraBliz = self:IsInRecoveryAura()
			if self._T.blizzardOnCooldown and not inAuraBliz then
				log("[SkillManager] 블리자드: 쿨타임 중")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- 시전 모션/연타 방지용 공용 쿨다운은 다른 스킬과 동일하게 짧게만 건다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- 블리자드 전용 쿨타임 20초 (공격속도와 무관한 고정 값). 오로라 안에서는 걸지 않는다.
			if not inAuraBliz then
				self._T.blizzardOnCooldown = true
				-- 해제 타이머는 세대 번호로 보호한다 - 오로라 진입으로 쿨타임이 중간에 초기화되면 세대가
				-- 올라가므로, 뒤늦게 깨어난 옛 타이머가 그 뒤에 새로 건 쿨타임을 앞당겨 끄지 못한다.
				self._T.blizzardCdGen = (self._T.blizzardCdGen or 0) + 1
				local blizzardGen = self._T.blizzardCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.blizzardCdGen ~= blizzardGen then return end
					self._T.blizzardOnCooldown = false
					log("[SkillManager] 블리자드 쿨타임 종료")
				end, 20.0)
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_BlizzardCooldownUI:ShowCooldown(20.0, barPos)
				end
			end
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireBlizzard(combatPower, atkMult)
			log("[SkillManager] 블리자드 사용! (쿨타임 20초)")
		elseif slot.name == "메테오" then
			-- 메테오(4차): 블리자드와 같은 규격의 자체 쿨타임 20초. 퀵슬롯 아이콘 위에 회색 오버레이 +
			-- 남은 초 숫자로 쿨타임을 표시한다(전용 오버레이 엔티티라 블리자드 표시와 서로 간섭하지 않는다).
			local inAuraMeteor = self:IsInRecoveryAura()
			if self._T.meteorOnCooldown and not inAuraMeteor then
				log("[SkillManager] 메테오: 쿨타임 중")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- 시전 모션/연타 방지용 공용 쿨다운은 다른 스킬과 동일하게 짧게만 건다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- 메테오 전용 쿨타임 20초 (공격속도와 무관한 고정 값 - 블리자드와 동일). 오로라 안에서는 걸지 않는다.
			if not inAuraMeteor then
				self._T.meteorOnCooldown = true
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.meteorCdGen = (self._T.meteorCdGen or 0) + 1
				local meteorGen = self._T.meteorCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.meteorCdGen ~= meteorGen then return end
					self._T.meteorOnCooldown = false
					log("[SkillManager] 메테오 쿨타임 종료")
				end, 20.0)
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_MeteorCooldownUI:ShowCooldown(20.0, barPos)
				end
			end
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireMeteor(combatPower, atkMult)
			log("[SkillManager] 메테오 사용! (쿨타임 20초)")
		elseif slot.name == "제네시스" then
			-- 제네시스(4차): 블리자드/메테오와 같은 규격의 자체 쿨타임 20초 + 전용 오버레이 쿨타임 표시.
			local inAuraGen = self:IsInRecoveryAura()
			if self._T.genesisOnCooldown and not inAuraGen then
				log("[SkillManager] 제네시스: 쿨타임 중")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- 시전 모션/연타 방지용 공용 쿨다운은 다른 스킬과 동일하게 짧게만 건다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.75 * atkMult)
			-- 제네시스 전용 쿨타임 20초 (공격속도와 무관한 고정 값 - 블리자드/메테오와 동일). 오로라 안에서는 걸지 않는다.
			if not inAuraGen then
				self._T.genesisOnCooldown = true
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.genesisCdGen = (self._T.genesisCdGen or 0) + 1
				local genesisGen = self._T.genesisCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.genesisCdGen ~= genesisGen then return end
					self._T.genesisOnCooldown = false
					log("[SkillManager] 제네시스 쿨타임 종료")
				end, 20.0)
				local barPos = self:GetBarPosForKey(key)
				if barPos ~= "" then
					_GenesisCooldownUI:ShowCooldown(20.0, barPos)
				end
			end
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireGenesis(combatPower, atkMult)
			log("[SkillManager] 제네시스 사용! (쿨타임 20초)")
		elseif slot.name == "브랜디쉬" then
			-- 브랜디쉬(4차): 자체 쿨타임 없이 공용 쿨다운만 쓴다. 시전 시간은 PlayerAttack.AttackBrandish가
			-- 컨트롤을 돌려주는 시각(RestoreBrandishControl)과 같은 공식으로 구한다 - 한쪽을 바꾸면
			-- 반드시 양쪽을 같이 바꿔야 한다:
			--   motionMult   = 0.625 * 배율            (모션 속도 1.6배)
			--   finishMult   = motionMult + 0.2/0.65   (마지막 swingTF만 0.2초 더 길게)
			--   시전 시간    = 0.65*motionMult + 0.75*finishMult
			--
			-- (버그 수정) "꾹 누르고 있으면 2~4번 공격하고 1~2초 아무 반응 없다가 다시 공격한다"
			-- 원인: 이 쿨다운을 서버 시전 시간과 **정확히 같게** 두면, 클라 쿨다운 해제와 서버의
			-- isBrandishing 해제가 같은 시각이라 어느 쪽이 먼저인지가 RPC 지연에 따라 매번 뒤집힌다
			-- (동전던지기). 클라가 먼저면 서버가 "이미 진행 중"으로 요청을 버리는데, 클라는 이미
			-- 그 시전분의 쿨다운(1.1초)을 걸어버린 뒤라 아무 일도 안 일어난 채 한 텀을 통째로 날린다
			-- -> 운 좋게 몇 번 연속 성공하다가 한 번 걸리면 1~2초 정지. 클라 쿨다운을 서버보다
			-- 확실히 뒤에 두어(RPC 왕복 지연 흡수용 여유) 요청이 항상 서버 해제 뒤에 도착하게 한다.
			-- 여유값만큼만 연사 간격이 늘어난다(1.106 -> 1.186초, 약 7%).
			local BRANDISH_COOLDOWN_MARGIN = 0.08
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- (브랜디쉬 강화 버프) 활성 시 공속 +1단계(배율 ×0.9로 더 빠르게). 시전시간/쿨다운도 이 배율을
			-- 그대로 따라가므로 브랜디쉬가 통째로 빨라진다. 데미지 1.5배는 전투력에 곱하고, 붉은 이펙트는
			-- enhanced 플래그로 서버에 전달한다.
			local enhanced = _CharInfoManager:IsBrandishEnhanceActive()
			if enhanced then atkMult = atkMult * 0.9 end
			local brandishMotionMult = 0.625 * atkMult
			local brandishFinishMult = brandishMotionMult + 0.2 / 0.65
			local brandishCastTime = 0.65 * brandishMotionMult + 0.75 * brandishFinishMult
			-- (브랜디쉬2 콤보) 재입력이 "진행 절반~끝" 창에 들어오는지 판단하기 위해 시전 시작시각/길이를 기록한다.
			self._T.brandishCastStartTime = _UtilLogic.ElapsedSeconds
			self._T.brandishCastDuration = brandishCastTime
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, brandishCastTime + BRANDISH_COOLDOWN_MARGIN)
			local combatPower = self:GetEffectiveCombatPower()
			if enhanced then combatPower = math.floor(combatPower * 1.5) end
			self:RequestFireBrandish(combatPower, atkMult, self:GetWeaponMotionClass(), enhanced)
			log("[SkillManager] 브랜디쉬 사용! enhanced=" .. tostring(enhanced))
		elseif slot.name == "돌진" then
			-- 돌진(4차): 자체 쿨타임 1초(요청으로 3초에서 단축).
			local inAuraRush = self:IsInRecoveryAura()
			if self._T.rushOnCooldown and not inAuraRush then
				log("[SkillManager] 돌진: 쿨타임 중")
				return
			end
			local atkMult = _CharInfoManager:GetAttackSpeedMultiplier()
			-- (요청) 딜레이 0.27초 - 그 사이 다른 스킬로 캔슬되지 않게 공용 쿨다운을 건다.
			-- (요청) 공속이 오르면 딜레이도 그만큼 줄어야 한다 - PlayerAttack.AttackRush의 RUSH_DELAY가
			-- 0.27*배율이므로 여기도 같은 배율을 곱해 딜레이 종료와 쿨다운 해제 시점을 일치시킨다.
			self._T.skillOnCooldown = true
			_TimerService:SetTimerOnce(function()
				self._T.skillOnCooldown = false
			end, 0.27 * atkMult)
			-- (요청) "공속을 올려도 돌진의 재사용까지 후딜이 남아있다" - 자체 쿨타임 1초가 공속과 무관한
			-- 고정값이라, 모션/딜레이가 아무리 빨라져도 재사용은 항상 1초를 기다려야 했다. 이 쿨타임도
			-- 공속을 타게 해서 재사용 간격이 실제로 줄어들게 한다.
			if not inAuraRush then
				self._T.rushOnCooldown = true
				-- 해제 타이머 세대 보호(블리자드와 동일 - 오로라 초기화 뒤 옛 타이머 무효화).
				self._T.rushCdGen = (self._T.rushCdGen or 0) + 1
				local rushGen = self._T.rushCdGen
				_TimerService:SetTimerOnce(function()
					if self._T.rushCdGen ~= rushGen then return end
					self._T.rushOnCooldown = false
					log("[SkillManager] 돌진 쿨타임 종료")
				end, 1.0 * atkMult)
			end
			local combatPower = self:GetEffectiveCombatPower()
			self:RequestFireRush(combatPower, atkMult, self:GetWeaponMotionClass())
			log("[SkillManager] 돌진 사용! (쿨타임 1초)")
		end
	end

	@ExecSpace("Client")
	method void LockSkillUse(number duration)
		-- 파이널어택(PlayerAttack.TryTriggerFinalAttack)처럼 서버가 클라이언트 입력 없이 자체적으로 발동시키는
		-- 추가타 동안, 클라이언트의 스킬 공용 쿨다운(skillOnCooldown)을 그 지속시간만큼 다시 걸어준다 -
		-- 그렇지 않으면 원본 스킬의 쿨다운은 이미 끝나있어서 추가타 모션 중에도 다른 스킬을 딜레이 없이 쓸 수 있다.
		self._T.skillOnCooldown = true
		log("[SkillManager] LockSkillUse: 파이널어택 동안 스킬 쿨다운 재설정 duration=" .. tostring(duration))
		_TimerService:SetTimerOnce(function()
			self._T.skillOnCooldown = false
		end, duration)
	end

	@ExecSpace("Server")
	method void RequestFirePowerStrike(number combatPower, number atkMultiplier, string weaponClass)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFirePowerStrike: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFirePowerStrike: PlayerAttack component not found")
			return
		end
		pa:AttackPowerStrike(combatPower, atkMultiplier, weaponClass)
		log("[SkillManager] 파워스트라이크 발동! combatPower=" .. tostring(combatPower) .. " atkMultiplier=" .. tostring(atkMultiplier))
	end

	@ExecSpace("Server")
	method void RequestFireChargeBlow(number combatPower, number atkMultiplier, string weaponClass, integer chargeMode)
		-- 차지 블로우(3차): 파워스트라이크와 완전히 같은 공격을 태우되, 검 궤적만 chargeMode(속성)에
		-- 해당하는 전용 아트로 바꾼다. 속성 상태는 클라이언트에만 있으므로(디바인 4종 입력으로 결정)
		-- combatPower/공속과 마찬가지로 여기서 인자로 넘겨받는다. chargeMode 0이면 기본 궤적 그대로.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireChargeBlow: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireChargeBlow: PlayerAttack component not found")
			return
		end
		pa:AttackChargeBlow(combatPower, atkMultiplier, weaponClass, chargeMode)
		log("[SkillManager] 차지 블로우 발동! mode=" .. tostring(chargeMode) .. " combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("Server")
	method void RequestFireGuard()
		-- 가드(패링) 사용: 서버의 PlayerHit에 1초 패링 창을 연다. 실제 판정/무적/성공 통지는
		-- PlayerHit.CheckGuardBlock(공격자 MonsterAttack.IsAttackTarget에서 호출)이 처리한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		local hit = player.PlayerHit
		if isvalid(hit) then
			hit:StartGuardParry()
		end
	end

	@ExecSpace("Client")
	method void NotifyGuardParrySuccess()
		-- 가드 패링 성공(서버 PlayerHit.CheckGuardBlock에서 호출): 쿨타임을 5초로 단축하고
		-- 우측 상단에 무적(2초) 버프 아이콘을 띄운다.
		local now = _UtilLogic.ElapsedSeconds
		local shortened = (self._T.guardUseAt or now) + 5.0
		if shortened < (self._T.guardCooldownUntil or 0) then
			self._T.guardCooldownUntil = shortened
			local remaining = math.max(shortened - now, 0.1)
			if (self._T.guardBarPos or "") ~= "" then
				_GuardCooldownUI:ShowCooldown(remaining, self._T.guardBarPos)
			end
		end
		_GuardBuffUI:ShowBuff(2.0)
		log("[SkillManager] 가드 성공! 쿨타임 5초로 단축 + 2초 무적 버프")
	end

	@ExecSpace("Server")
	method void RequestFireParry(number combatPower)
		-- 패링 사용: 서버의 PlayerHit에 1.2초 패링 창을 연다(가드와 동일). 실제 판정/무적/성공 통지/반격은
		-- PlayerHit.CheckParryBlock(공격자 MonsterAttack.IsAttackTarget에서 호출)이 처리한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		local hit = player.PlayerHit
		if isvalid(hit) then
			hit:StartParryStance(combatPower)
		end
	end

	@ExecSpace("Client")
	method void NotifyParrySuccess()
		-- 패링 가드 성공(서버 PlayerHit.CheckParryBlock에서 호출): (요청 2026-07-28) 쿨타임을
		-- 완전히 초기화해 즉시 재사용 가능하게 하고, 우측 상단에 무적(3초) 버프 아이콘을 띄운다.
		self._T.parryCooldownUntil = 0
		_ParryCooldownUI:ResetCooldown()
		_ParryBuffUI:ShowBuff(3.0)
		log("[SkillManager] 패링 가드 성공! 쿨타임 초기화 + 3초 무적 버프")
	end

