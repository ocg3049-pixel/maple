	@ExecSpace("ClientOnly")
	method void SetAssassinateActive(boolean on)
		-- 암살로 사라져 있는 동안 true. PlayerAttack의 사라짐/복귀 연출(클라)이 **로컬 플레이어일 때만**
		-- 호출한다 - 다른 사람의 암살로 내 스킬이 잠기면 안 되기 때문이다.
		self._T.assassinateActive = on
	end

	@ExecSpace("ClientOnly")
	method boolean IsAssassinateActive()
		-- 지금 암살로 사라져 있는가(= 다른 스킬 입력이 전부 막히는 구간).
		-- (신고 2026-08-06) 자동사냥이 암살을 주력으로 쓰면 홀드가 계속 갱신돼 이 구간이 끊기지 않고,
		-- 분신 소환·연막·다크사이트 같은 **유틸 스킬이 영영 시전되지 않는다**(실측: 분신이 한 번도
		-- 소환되지 않음 = "분신이 공격을 안 한다"의 진짜 원인). 자동사냥이 이 값을 보고 잠깐 숨을 고른다.
		return self._T.assassinateActive == true
	end

	@ExecSpace("ClientOnly")
	method void ReleaseAssassinateHold()
		-- 홀드를 풀어 복귀(=암살 잠금 해제)를 앞당긴다. 자동사냥이 유틸 시전 창을 만들 때 쓴다.
		self:RequestSetAssassinateHold(false)
	end

	@ExecSpace("Server")
	method void RequestSetAssassinateHold(boolean on)
		-- 암살 키를 누르고 있는지(홀드) 서버에 알린다. 홀드 중에는 연쇄가 끝나도 계속 숨어 있고,
		-- 키를 떼는 이 신호를 받은 순간(또는 그 뒤 연쇄가 끝나는 순간) 다시 나타난다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SetAssassinateHold(on)
	end

	-- ⚠ 예전 이름은 RequestSetAmhaengActive(on)였다 - 투자 레벨 인자를 더하면서 **이름을 바꿨다**
	--   (기존 메서드에 인자를 추가하면 LEA-1102가 난다 - 드래곤 라이딩 SummonRidingDragonFor와 같은 이유).
	@ExecSpace("Server")
	method void RequestSetAmhaengState(boolean on, integer level)
		-- 암행 토글 상태 + 투자 레벨을 서버에 반영한다. 발동 판정(온히트 확률 굴림)과 표창 데미지는
		-- 서버 PlayerAttack에서 일어나므로, 클라 전용 상태(CharInfoManager.amhaengOn)를 토글할 때와
		-- 포인트를 찍을 때마다 함께 넘겨받는다(백스탭과 동일한 구조).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestSetAmhaengState: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestSetAmhaengState: PlayerAttack component not found")
			return
		end
		pa:SetAmhaengState(on, level)
		log("[SkillManager] 암행 서버 상태 반영: " .. (on and "ON" or "OFF") .. " Lv." .. tostring(level))
	end

	@ExecSpace("Server")
	method void RequestSetAmhaeng2State(boolean on, integer level)
		-- 암행2 토글 상태 + 투자 레벨을 서버에 반영한다(암행1의 RequestSetAmhaengState와 동일한 구조).
		-- ⚠ 기존 RequestSetAmhaeng2Active에 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestSetAmhaeng2State: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestSetAmhaeng2State: PlayerAttack component not found")
			return
		end
		pa:SetAmhaeng2State(on, level)
		log("[SkillManager] 암행2 서버 상태 반영: " .. (on and "ON" or "OFF") .. " Lv." .. tostring(level))
	end

	@ExecSpace("Server")
	method void RequestSetBackstabState(boolean on, integer level)
		-- 백스탭 토글 상태 + 투자 포인트(레벨)를 서버에 반영한다. 뒤통수 판정과 데미지 증가는
		-- 서버 PlayerAttack.CalcDamage에서 일어나므로(공격 대상이 바라보는 방향을 서버만 알고 있다),
		-- 클라 전용 상태를 토글할 때와 포인트를 찍을 때마다 함께 넘겨받는다(암행과 동일한 구조).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestSetBackstabState: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestSetBackstabState: PlayerAttack component not found")
			return
		end
		pa:SetBackstabState(on, level)
		log("[SkillManager] 백스탭 서버 상태 반영: " .. (on and "ON" or "OFF") .. " Lv." .. tostring(level))
	end

	@ExecSpace("Server")
	method void RequestCancelBuff(string kind)
		-- (요청) 버프 아이콘 우클릭 취소의 서버측 진입점. 서버에 상태가 있는 버프들을 종류별로 정리한다.
		-- 클라 표시(BuffUI.HideBuff)와 클라 전용 스탯 정리는 BuffBarManager가 클라에서 함께 수행한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestCancelBuff: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if kind == "powerguard" then
			-- 파워가드의 회복/피해 감소 창은 PlayerHit이 들고 있다 - 0초로 다시 열어 즉시 닫는다.
			---@type PlayerHit
			local hit = player:GetComponent("script.PlayerHit")
			if isvalid(hit) then hit:StartPowerGuardLv(0, 0, 0) end
			log("[SkillManager] 파워가드 회복 창 취소(우클릭)")
			return
		end
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestCancelBuff: PlayerAttack component not found")
			return
		end
		if kind == "haste" then
			pa:CancelHaste()
		elseif kind == "combo" then
			pa:CancelComboAttack()
		elseif kind == "shadowpartner" then
			pa:CancelShadowPartner()
		elseif kind == "firezone" then
			pa:CancelFireZoneBuff()
		elseif kind == "glacier" then
			pa:CancelGlacierBuff()
		elseif kind == "dragonride" then
			pa:DismissRidingDragon()
		elseif kind == "herosummon" then
			pa:DismissHero()
		elseif kind == "healersummon" then
			pa:DismissHealer()
		elseif kind == "sixdragons" then
			pa:DismissSixDragons()
		elseif kind == "darkdragon" then
			pa:DismissDarkDragons()
		elseif kind == "dragonblood" then
			pa:CancelDragonBloodBuff()
		elseif kind == "elemfield" then
			pa:CancelElementalField()
		elseif kind == "battojutsu" then
			pa:CancelBattojutsu()
		elseif kind == "awakening" then
			pa:CancelAwakening()
		elseif kind == "shadowclone" then
			-- (2026-08-06) 분신 버프 아이콘 우클릭 취소 - 분신을 즉시 없앤다(재사용 대기시간은 유지).
			pa:DismissShadowClone()
		elseif kind == "ironwall" then
			---@type PlayerHit
			local hitIW = player:GetComponent("script.PlayerHit")
			if isvalid(hitIW) then hitIW:CancelIronWall() end
		elseif kind == "guardshield" then
			---@type PlayerHit
			local hitGS = player:GetComponent("script.PlayerHit")
			if isvalid(hitGS) then hitGS:CancelGuardShield() end
		elseif kind == "bahamut" then
			-- (비숍 개편 2026-08-08) 바하뮤트 아이콘 우클릭 취소 - 소환수를 즉시 없앤다(재사용 30초는 유지).
			pa:DismissBahamut()
		elseif kind == "ifrit" then
			-- (요청 2026-08-11) 이프리트 아이콘 우클릭 취소 - 바하뮤트와 같은 규칙.
			pa:DismissIfrit()
		elseif kind == "elquines" then
			-- (요청 2026-08-11) 엘퀴네스 아이콘 우클릭 취소 - 바하뮤트와 같은 규칙.
			pa:DismissElquines()
		elseif kind == "archersummon" then
			-- 궁수 소환(비숍 4차) 취소 - 계통별 슬롯이라 전사/도적 소환수는 그대로 남는다.
			pa:DismissHeroClass("archer")
		elseif kind == "thiefsummon" then
			-- 도적 소환(비숍 2차) 취소.
			pa:DismissHeroClass("thief")
		else
			log_warning("[SkillManager] RequestCancelBuff: 알 수 없는 종류 " .. tostring(kind))
		end
	end

	@ExecSpace("Server")
	method void RequestFireBattojutsu(number duration, integer maxStacks, number atkMultiplier)
		-- 발도술: 서버 버프 창을 열고 공용 버프 시전(alert2 숨고르기 + 사용음) + 머리위/발아래 이펙트를 재생한다.
		-- 지속시간/중첩 상한은 클라(스킬 레벨)가 계산해 넘긴다(부스터/아이언 월과 같은 규칙). 안전 범위로 clamp.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireBattojutsu: player not found")
			return
		end
		---@type PlayerAttack
		local paBT = player:GetComponent(PlayerAttack)
		if not isvalid(paBT) then
			log_warning("[SkillManager] RequestFireBattojutsu: PlayerAttack component not found")
			return
		end
		local dur = math.max(1, math.min(duration or 30, 30 + 20 * 19))
		local stacks = math.max(1, math.min(math.floor(maxStacks or 1), 3))
		paBT:AttackBattojutsu(dur, stacks, atkMultiplier)
	end

	@ExecSpace("ClientOnly")
	method void ClearDarkDragonActive()
		-- (버프 아이콘 우클릭 취소) 소환 활성 창을 지운다 - 재사용 대기시간(10분)은 그대로 남는다.
		self._T.darkDragonActiveUntil = 0
	end

	@ExecSpace("ClientOnly")
	method void OnDarkDragonGone()
		-- (요청 2026-08-10) 서버의 주 다크드래곤 엔티티가 사라졌을 때 호출된다(PlayerAttack.NotifyDarkDragonGone).
		-- 활성 창을 닫고 버프바도 내린다 - 자동사냥 게이트(CanAutoSummonDarkDragon)가 "있는 줄 알고"
		-- 재소환을 미루지 않게. 재사용 대기시간(10분)은 그대로 남는다.
		self._T.darkDragonActiveUntil = 0
		_DarkDragonBuffUI:HideBuff()
		log("[SkillManager] 다크드래곤 소멸 - 활성 상태 정리")
	end

	@ExecSpace("ClientOnly")
	method boolean CanAutoSummonDarkDragon()
		-- (요청 2026-08-10) 자동사냥용 게이트: 활성이 아니면 참.
		-- 자동사냥은 고정 주기(구 605초) 대신 이 상태를 10초마다 조회한다 - 드래곤이 일찍 사라지면
		-- (소멸 통보로 활성 창이 닫힘) 곧장 재소환한다.
		-- (요청 2026-08-12 4차) **재사용 대기시간이 폐지되어 쿨 조건은 사라졌다** - MP만 있으면 다시 부른다
		-- (MP 부족 시의 시전 거부는 TryUtilityCast의 CanAffordSkillCost 게이트가 처리한다).
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.darkDragonActiveUntil or 0) > now then return false end
		return true
	end

	@ExecSpace("Client")
	method void ShowDragonIronWallBuff(number duration)
		-- 다크드래곤 버프판 아이언 월: 주인 클라 버프바 표시(피해 감소 자체는 서버 PlayerHit이 이미 적용).
		_IronWallBuffUI:ShowBuff(duration)
	end

	@ExecSpace("Server")
	method void RequestFireIronWall(number duration, integer reducePct, number atkMultiplier)
		-- 아이언 월: 서버 PlayerHit에 감소 창을 열고, 파워가드와 동일한 공용 버프 시전(alert2 모션 +
		-- 사운드) + 시전/아군 이펙트를 재생시킨다.
		-- (요청) 힐 범위(±3.6) 안의 소환수(용사/힐러/용)에게도 받는 피해 감소를 실제로 적용한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerHit
		local hitIW = player:GetComponent("script.PlayerHit")
		if isvalid(hitIW) then hitIW:StartIronWall(duration, reducePct) end
		---@type PlayerAttack
		local paIW = player:GetComponent(PlayerAttack)
		if isvalid(paIW) then paIW:AttackIronWall(atkMultiplier) end
		local map = player.CurrentMap
		if isvalid(map) then
			local myPos = player.TransformComponent.WorldPosition
			local applied = 0
			for _, typeName in ipairs({"script.HeroSummon", "script.HealerSummon", "script.SummonDragon"}) do
				local comps = map:GetChildComponentsByTypeName(typeName, true)
				for _, comp in ipairs(comps) do
					if isvalid(comp) and isvalid(comp.Entity) then
						local pos = comp.Entity.TransformComponent.WorldPosition
						if math.abs(pos.x - myPos.x) <= 3.6 and math.abs(pos.y - myPos.y) <= 3.6 then
							comp:ApplyIronWall(duration, reducePct)
							applied = applied + 1
						end
					end
				end
			end
			log("[SkillManager] 아이언 월 발동! (지속 " .. tostring(duration) .. "초, 피해 -" .. tostring(reducePct) .. "%, 소환수 " .. tostring(applied) .. "기 적용)")
		end
	end

	@ExecSpace("ClientOnly")
	method void CancelDragonRideEarly()
		-- (요청) 드래곤 라이딩 버프 아이콘 우클릭: 소환을 조기 종료한다. 탑승 해제/퀵슬롯 아이콘 복구/
		-- 버프바 정리는 만료 처리(OnDragonRideExpired)를 그대로 재사용하고, 서버의 드래곤 엔티티 제거만
		-- RequestCancelBuff("dragonride")로 추가 요청한다. 재사용 대기시간(10분)은 그대로 유지된다.
		if (self._T.dragonRideActiveUntil or 0) <= _UtilLogic.ElapsedSeconds then return end
		if self._T.dragonRideExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.dragonRideExpireTimerId)
		end
		self:OnDragonRideExpired()
		self:RequestCancelBuff("dragonride")
		log("[SkillManager] 드래곤 라이딩 조기 종료(우클릭)")
	end

	@ExecSpace("Server")
	method void RequestFireBrandish(number combatPower, number atkMultiplier, string weaponClass, boolean enhanced)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireBrandish: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireBrandish: PlayerAttack component not found")
			return
		end
		pa:AttackBrandish(combatPower, atkMultiplier, weaponClass, enhanced)
		log("[SkillManager] 브랜디쉬 발동! combatPower=" .. tostring(combatPower) .. " enhanced=" .. tostring(enhanced))
	end

	-- (요청 2026-08-12 3차) 데미지 배율을 인자로 받는다. ⚠ 기존 RequestFireDarkDragon에 인자를 더하지 않고
	-- **이름을 바꿨다**(LEA-1102 회피 - 패닉/코마·차지 블로우와 같은 관례).
	@ExecSpace("Server")
	method void RequestFireDarkDragonLv(number combatPower, number duration, number rateMin, number rateMax)
		-- 서먼 다크드래곤: 서버에서 드래곤 소환수 스폰(PlayerAttack.SummonDarkDragonLv).
		-- 지속시간·데미지 배율 모두 클라(투자 레벨)가 계산해 넘긴다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireDarkDragonLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireDarkDragonLv: PlayerAttack component not found")
			return
		end
		-- 안전 범위로 clamp(10~105초) - 클라 계산값이 어긋나도 서버가 이상한 수명을 잡지 않게 한다.
		local dur = math.max(10, math.min(duration or 10, 105))
		pa:SummonDarkDragonLv(combatPower, dur, rateMin or 0.9, rateMax or 1.0)
		log("[SkillManager] 다크드래곤 소환! combatPower=" .. tostring(combatPower) .. " 지속=" .. tostring(dur)
			.. "초 배율=" .. tostring(rateMin) .. "~" .. tostring(rateMax))
	end

	-- ── 드래곤 라이딩(3차) ────────────────────────────────────────────────

	@ExecSpace("Server")
	method void RequestFireRidingDragon(number combatPower, number multMin, number multMax, number duration)
		-- 드래곤 라이딩 소환: 서버에서 드래곤 소환수 스폰(PlayerAttack.SummonRidingDragonFor).
		-- (스펙 개편) multMin/multMax = 드래곤 1타 데미지 배율 범위(1.5 = 150%). 클라가 투자 레벨로 계산해 넘긴다.
		-- (요청 2026-08-05) duration = 소환 지속시간(초, 2분 30초 + 분배당 20초)도 클라가 계산해 넘긴다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireRidingDragon: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireRidingDragon: PlayerAttack component not found")
			return
		end
		-- 안전 범위로 clamp(2분 30초 ~ 8분 50초) - 클라 계산값이 어긋나도 서버가 이상한 수명을 잡지 않게 한다.
		local rdDur = math.max(150, math.min(duration or 150, 530))
		pa:SummonRidingDragonFor(combatPower, multMin, multMax, rdDur)
		log("[SkillManager] 드래곤 라이딩 소환! combatPower=" .. tostring(combatPower)
			.. " 배율=" .. tostring(multMin) .. "~" .. tostring(multMax) .. " 지속=" .. tostring(rdDur))
	end

	@ExecSpace("Server")
	method void RequestFireHeroSummonClass(number playerLevel, integer levelPercent, number heroCombatPower, string summonClass)
		-- 소환 용사: 서버에서 아바타 NPC 스폰(PlayerAttack.SummonHeroClass).
		-- ⚠ 기존 RequestFireHeroSummonCp에 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피).
		-- heroCombatPower = 레벨 곡선으로 환산한 소환수 전투력(클라만 장비/레벨 곡선을 읽을 수 있다).
		-- (비숍 개편 2026-08-08) summonClass = "warrior" / "archer" / "thief" - 세 소환이 이 RPC 하나를
		--   공유하고, 계통마다 독립 슬롯이라 동시에 셋을 데리고 다닐 수 있다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireHeroSummonClass: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireHeroSummonClass: PlayerAttack component not found")
			return
		end
		pa:SummonHeroClass(playerLevel, levelPercent, heroCombatPower, summonClass)
		log("[SkillManager] 소환 요청(" .. tostring(summonClass) .. ") playerLevel=" .. tostring(playerLevel)
			.. " levelPercent=" .. tostring(levelPercent)
			.. " heroCombatPower=" .. tostring(math.floor(heroCombatPower)))
	end

	@ExecSpace("Server")
	method void RequestFireHolyMagicShellLv(number atkMultiplier)
		-- 홀리 매직쉘: 서버에서 자신+소환수 전원에게 쉴드 부여(PlayerAttack.CastHolyMagicShell).
		-- (비숍 개편 2026-08-08) 시전 모션(stabO1) 재생속도를 맞추려고 공격속도 배율을 함께 넘긴다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireHolyMagicShellLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireHolyMagicShellLv: PlayerAttack component not found")
			return
		end
		pa:CastHolyMagicShell(10, atkMultiplier)
		log("[SkillManager] 홀리 매직쉘 요청")
	end

	@ExecSpace("Server")
	method void RequestFireDragonBlood(number duration, integer healPercent)
		-- 드래곤 블러드: 서버에서 버프 시작(HP 유지 비용/자동 해제/이펙트는 PlayerAttack이 담당).
		-- (스펙 개편 2026-08-05) 지속시간과 소환 용 타격 회복률은 클라가 투자 레벨로 계산해 넘긴 값을 그대로 쓴다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireDragonBlood: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireDragonBlood: PlayerAttack component not found")
			return
		end
		pa:AttackDragonBlood(duration, healPercent)
		log("[SkillManager] 드래곤 블러드 요청 (지속 " .. tostring(math.floor(duration)) .. "초, 용 타격 회복 "
			.. tostring(healPercent) .. "%)")
	end

	-- ── 다크사이트(1차 버프) ──────────────────────────────────────────────
	-- 이 스크립트가 담당하는 부분:
	--   ① 토글 상태/쿨타임 게이트/버프바·쿨타임 UI
	--   ② "데미지 2배 + 무조건 크리티컬" - 스킬이 서버로 넘기는 전투력/크리확률 값을 여기서 한 번만
	--      보정한다(GetEffectiveCombatPower / GetEffectiveCritRate). 직접 타격 스킬은 물론
	--      투사체 스킬(럭키세븐/스트레이프/화살 계열 등)까지 같은 값을 실어 나가므로 한 곳으로 덮인다.
	-- 연출(어두워짐/투명도/BGM)과 이동속도 50%, "공격하면 풀림" 판정은 서버 PlayerAttack이 담당한다.

	@ExecSpace("ClientOnly")
	method boolean IsDarkSightActive()
		-- 지금 다크사이트(은신)가 켜져 있는가.
		return (self._T.darkSightActiveUntil or 0) > _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ClientOnly")
	method number PeekEffectiveCombatPower()
		-- 다크사이트 보정만 얹은 전투력을 "조회"한다 - 은신을 풀지 않는다.
		-- 시전이 아닌 곳(아대 상태 주기 동기화 / SyncDarkSightStats)에서 쓴다.
		-- (요청 2026-08-12 2차) 분노(전투력 +1%/분배)는 CalcCombatPower의 "추가 전투력%" 배율에
		-- 포함되어 여기로 들어온다 - 별도 곱 없음(있으면 이중 적용).
		local cp = _CharInfoManager:CalcCombatPower()
		if self:IsDarkSightActive() then
			return cp * 2
		end
		return cp
	end

	-- (요청 2026-08-12 2차) 패닉/코마 전용 전투력 - 이 두 스킬은 데미지 공식이 `전투력 × 구슬수 × 배율`이라
	-- 구슬 수를 **직접** 곱한다. 그런데 전투력에도 콤보 배율(구슬당 2%)이 실려 있으므로 그대로 넘기면
	-- 구슬 수가 두 번 곱해진다. 여기서 그 배율만 되돌려 넘긴다.
	-- ⚠ GetEffectiveCombatPower를 경유하므로 다크사이트 해제·전투분석 집계 등 부수 효과는 그대로 유지된다.
	@ExecSpace("ClientOnly")
	method number GetEffectiveCombatPowerNoCombo()
		local cp = self:GetEffectiveCombatPower()
		local comboPct = _CharInfoManager:GetComboFinalDamagePct()
		if comboPct > 0 then
			cp = math.floor(cp / (1 + comboPct / 100))
		end
		return cp
	end

	@ExecSpace("ClientOnly")
	method number GetEffectiveCombatPower()
		-- 스킬 데미지 계산에 넘길 전투력. 다크사이트 중에는 2배다.
		-- ⚠ 캐릭터 정보창/HUD에 보이는 전투력 표시는 _CharInfoManager:CalcCombatPower()를 직접 쓰므로
		--   여기서 2배로 만들어도 표시 숫자는 그대로다(의도).
		-- ⚠ **의도적으로 이 보정을 쓰지 않는 스킬들**이 있다 - 시전 자체가 공격이 아니어서 다크사이트를
		--   풀지 않는 스킬들이다. 여기에 보정을 넣으면 "은신한 채로 소환/버프만 걸어 영구히 2배"가 되므로
		--   이 스킬들은 _CharInfoManager:CalcCombatPower()를 그대로 쓴다:
		--     · 지속 소환수 - 드래곤 라이딩 / 프리져 / 피닉스 / 바하뮤트 / 이프리트 / 엘퀴네스 /
		--       용 소환 / 서먼 다크드래곤, 그리고 전투력을 레벨 환산에만 쓰는 용사·힐러 소환
		--     · 온히트 프록 버프 - 불의 영역 / 빙하지대
		--     · 회복량 계산 - 힐
		-- ⚠ 이 메서드를 부른다 = "지금 공격 스킬을 시전한다"와 같은 뜻이다(위 제외 목록이 곧 비공격 스킬
		--   목록이므로). 그래서 여기서 다크사이트를 푼다 - **적중하지 않아도 공격 동작만으로 풀린다**
		--   (요청 2026-07-30 수정). 시전이 아닌 단순 조회는 PeekEffectiveCombatPower를 쓸 것.
		local cp = self:PeekEffectiveCombatPower()
		-- (전투분석) 실제 공격 시전이 확정되는 유일한 지점 - 예약된 스킬명을 1회 소비해 사용 횟수 집계.
		if self._T.castingSkillName ~= nil then
			-- (버그 수정 2026-08-14) 유효시간(0.5초)이 지난 예약은 **소비만 하고 집계하지 않는다** -
			-- 발동에 실패해 남은 낡은 이름이 나중 호출에 붙어 사용 횟수를 부풀리던 것을 막는다.
			local resAt = self._T.castingSkillNameAt or 0
			if _UtilLogic.ElapsedSeconds - resAt <= 0.5 then
				_BattleStatsManager:ReportCast(self._T.castingSkillName)
			end
			self._T.castingSkillName = nil
			self._T.castingSkillNameAt = nil
		end
		self:BreakDarkSightByAttack()
		-- (Phase 4) 스킬 투자 위력 배율 - UseSkillInSlot이 시전 직전에 예약한 값(1회성)을 곱한다.
		-- 미투자 0.6배 ~ 마스터 1.0배 + 레벨 제한 미달 페널티 (GetSkillPowerMultiplier 참고).
		local mult = self._T.pendingSkillPowerMult
		if mult ~= nil then
			self._T.pendingSkillPowerMult = nil
			if mult ~= 1.0 then
				cp = math.floor(cp * mult)
			end
		end
		return cp
	end

	@ExecSpace("ClientOnly")
	method void BreakDarkSightByAttack()
		-- 공격 "동작"이 나갔으므로 은신을 푼다(적중 여부와 무관 - 허공을 휘둘러도 풀린다).
		-- ⚠ 클라 스탯 원복(OnDarkSightEnded)을 여기서 곧바로 하면 안 된다. 이 호출은 시전 도중
		--   (전투력을 막 읽은 직후)에 들어오는데, 같은 시전이 이어서 GetEffectiveCritRate까지 읽는
		--   경로가 있어(속사/폭풍의 시/스나이핑) 즉시 원복하면 정작 그 공격이 크리티컬을 놓친다.
		--   서버에는 곧바로 알려 해제 연출과 1초 크리티컬 유예를 열고, 클라 원복만 한 프레임 미룬다.
		if not self:IsDarkSightActive() then return end
		if self._T.darkSightBreaking then return end
		self._T.darkSightBreaking = true
		self:RequestBreakDarkSight()
		_TimerService:SetTimerOnce(function()
			self._T.darkSightBreaking = false
			self:OnDarkSightEnded()
		end, 0.02)
		log("[SkillManager] 다크사이트 해제(공격 동작)")
	end

	-- ── 샤프 아이즈(신궁 4차 버프) 클라 상태 ─────────────────────────────
	-- 다크사이트와 같은 구조: 클라가 스탯 보정을 들고, 서버에는 크확/크뎀만 동기화해준다.

	@ExecSpace("ClientOnly")
	method void StartSharpEyesLocal(number duration, integer lv)
		-- 버프 시작/갱신 - 스탯 적용(CharInfoManager) + 버프바 표시 + 서버 동기화 + 만료 시 재동기화.
		_CharInfoManager:UseSharpEyes(duration, self:GetSharpEyesCritRate(lv), self:GetSharpEyesCritDamage())
		_SharpEyesBuffUI:ShowBuff(duration)
		self:SyncSharpEyesStats()
		-- 만료는 CharInfoManager의 토큰 타이머가 스탯을 원복한다 - 여기서는 그 직후 서버 값만 되돌린다.
		self._T.sharpEyesToken = (self._T.sharpEyesToken or 0) + 1
		local mySEToken = self._T.sharpEyesToken
		_TimerService:SetTimerOnce(function()
			if self._T.sharpEyesToken ~= mySEToken then return end
			self:SyncSharpEyesStats()
			log("[SkillManager] 샤프 아이즈 종료 - 크확/크뎀 서버 동기화 원복")
		end, duration + 0.05)
	end

	@ExecSpace("ClientOnly")
	method void CancelSharpEyesEarly()
		-- 버프 아이콘 우클릭 취소 - 스탯 원복 + 버프바 내리기 + 서버 값 되돌리기.
		self._T.sharpEyesToken = (self._T.sharpEyesToken or 0) + 1
		_CharInfoManager:CancelSharpEyes()
		_SharpEyesBuffUI:HideBuff()
		self:SyncSharpEyesStats()
		log("[SkillManager] 샤프 아이즈 해제(우클릭)")
	end

	@ExecSpace("ClientOnly")
	method void SyncSharpEyesStats()
		-- 크확/크뎀 보정을 서버에 즉시 반영한다. 스킬은 시전할 때마다 자기 값을 같이 넘기지만,
		-- 엔진이 서버에서 직접 띄우는 기본공격은 동기화해둔 값만 보기 때문에 이 갱신이 필요하다
		-- (다크사이트의 SyncDarkSightStats와 같은 이유).
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SyncCritRate(self:GetEffectiveCritRate())
		pa:SyncCritDamage(_CharInfoManager:CalcCritDamage())
	end

	@ExecSpace("Server")
	method void RequestFireSharpEyes(number atkMultiplier)
		-- 샤프 아이즈 시전 - 서버는 모션/사운드/이펙트만 담당한다(효과는 클라 스탯).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireSharpEyes: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then pa:AttackSharpEyes(atkMultiplier) end
		log("[SkillManager] 샤프 아이즈 시전 요청")
	end

	@ExecSpace("ClientOnly")
	method number GetEffectiveCritRate()
		-- 스킬에 넘길 크리티컬 확률(%). 다크사이트 중에는 100%(무조건 크리티컬)다.
		if self:IsDarkSightActive() then
			return 100
		end
		return _CharInfoManager:CalcCritRate()
	end

	@ExecSpace("ClientOnly")
	method void SyncDarkSightStats()
		-- 다크사이트가 켜지거나 풀리는 순간 전투력/크리확률 보정을 서버에 즉시 반영한다.
		-- 스킬은 시전할 때마다 자기 값을 같이 넘기지만, 엔진이 서버에서 직접 띄우는 기본공격은
		-- 동기화해둔 값(SyncCombatPower/SyncCritRate)만 보기 때문에 이 갱신이 필요하다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SyncCritRate(self:GetEffectiveCritRate())
		pa:SyncCritDamage(_CharInfoManager:CalcCritDamage())
		-- ⚠ 여기는 상태 동기화라 Peek을 쓴다(GetEffectiveCombatPower를 쓰면 은신을 켠 순간 스스로 풀린다).
		pa:SyncCombatPower(self:PeekEffectiveCombatPower())
	end

	@ExecSpace("ClientOnly")
	method void StartDarkSightLocal()
		-- 클라 상태 시작: 최대 지속 160초 + 버프바 표시 + 만료 예약 + 스탯 보정 동기화.
		local now = _UtilLogic.ElapsedSeconds
		self._T.darkSightActiveUntil = now + 160.0
		if self._T.darkSightExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.darkSightExpireTimerId)
		end
		self._T.darkSightExpireTimerId = _TimerService:SetTimerOnce(function()
			self:OnDarkSightEnded()
		end, 160.0)
		_DarkSightBuffUI:ShowBuff(160.0)
		self:SyncDarkSightStats()
	end

	@ExecSpace("ClientOnly")
	method void CancelDarkSightEarly()
		-- 스킬을 한 번 더 눌러(또는 버프 아이콘 우클릭) 은신만 푼다.
		-- "스킬을 사용한 것"이 아니므로 쿨타임(10초)은 새로 걸지 않는다(요청 사양).
		self:OnDarkSightEnded()
		self:RequestCancelDarkSight()
		log("[SkillManager] 다크사이트 해제(재사용/우클릭) - 쿨타임 없음")
	end

	@ExecSpace("ClientOnly")
	method void OnDarkSightEnded()
		-- 해제 공용 정리. 공격으로 서버가 풀었을 때는 PlayerAttack.NotifyDarkSightEnded가 이걸 부른다.
		-- 만료/재사용/우클릭 경로와 서버 통보가 겹쳐 두 번 들어와도 안전하도록 한 번만 처리한다.
		if (self._T.darkSightActiveUntil or 0) <= 0 then return end
		self._T.darkSightActiveUntil = 0
		if self._T.darkSightExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.darkSightExpireTimerId)
			self._T.darkSightExpireTimerId = nil
		end
		_DarkSightBuffUI:HideBuff()
		self:SyncDarkSightStats()
		log("[SkillManager] 다크사이트 종료 - 전투력/크리 보정 원복")
	end

	-- ── 자동사냥이 보는 섀도어 게이트 (2026-08-06) ────────────────────────
	-- 자동사냥(AutoHuntManager)은 클라 전용 `_T` 쿨다운 창을 직접 볼 수 없다 - 각 스킬의 "지금
	-- 쓸 수 있는가"를 여기 공개 헬퍼로 노출한다(각성의 CanAutoCastAwakening과 같은 관례).

	@ExecSpace("ClientOnly")
	method number GetDarkSightAutoCooldown()
		-- 자동사냥이 재시도 주기(쿨타임 ~ 쿨타임×4)를 계산할 때 쓰는 실제 재사용 대기시간.
		local lv = math.max(1, self:GetHeroSkillLevelByName("다크사이트"))
		return self:ApplyCooldownReduction(self:GetDarkSightCooldown(lv))
	end

	@ExecSpace("ClientOnly")
	method boolean CanAutoCastDarkSight()
		-- 지금 다크사이트를 새로 켤 수 있는가(이미 켜져 있으면 재시전 = 해제라 금지).
		if self:IsDarkSightActive() then return false end
		if self:IsInRecoveryAura() then return true end
		return (self._T.darkSightCooldownUntil or 0) <= _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ClientOnly")
	method boolean CanAutoCastSmokeScreen()
		-- 연막 재사용 대기시간(3분)이 끝났는가. 지속 중에는 다시 켤 이유가 없으므로 함께 막는다.
		if self:IsSmokeScreenActiveLocal() then return false end
		if self:IsInRecoveryAura() then return true end
		return (self._T.smokeScreenCooldownUntil or 0) <= _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ClientOnly")
	method boolean IsSmokeScreenActiveLocal()
		-- 지금 내 연막이 살아 있는가. 서버 `_T.smokeScreenUntil`은 클라에 없으므로, 시전할 때
		-- 서버와 **같은 값**으로 띄운 버프바 잔여 시간을 신호로 쓴다(SmokeScreenBuffUI 주석 참고).
		return _SmokeScreenBuffUI:GetRemaining() > 0
	end

	@ExecSpace("ClientOnly")
	method boolean CanAutoSummonShadowClone()
		-- 자동사냥이 분신을 "소환"해도 되는가. ⚠ 분신이 살아 있을 때 다시 누르면 **위치 교환**이라,
		-- 드래곤 라이딩과 같은 이유로 살아 있는 동안은 절대 재시전하지 않는다(자동사냥은 교환을 쓰지 않는다).
		-- (요청 2026-08-14 4차) 소환 재사용 대기시간이 폐지돼 shadowCloneCooldownUntil은 늘 0이지만,
		-- 옛 세션 상태가 남아 있을 수 있으므로 검사는 그대로 둔다(있어도 해가 없다).
		-- MP 200 게이트는 자동사냥이 CanAffordSkillCost("분신 소환")로 따로 확인한다.
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.shadowCloneEndAt or 0) > now then return false end
		if self:IsInRecoveryAura() then return true end
		return (self._T.shadowCloneCooldownUntil or 0) <= now
	end

	@ExecSpace("ClientOnly")
	method integer GetAssaulterStacks()
		-- 남은 어썰터 스택(0~3). 자동사냥이 "스택이 있을 때만, 그리고 몰아쓰지 않게" 판단하는 데 쓴다.
		return math.floor(self._T.assaulterStacks or 0)
	end

	-- (버그 수정 2026-08-06) 분신 데미지가 본체보다 훨씬 셌던 문제.
	-- 분신은 개편 전 관례(모든 스킬 한 타당 100%~200%)를 그대로 쓰고 있었는데, 본체 4종은 이번 개편으로
	-- 훨씬 낮은 배율(예: 새비지블로우 한 타 8%~71%)이 됐다 - 그래서 "분신 데미지 = 본체의 50~90%"라는
	-- 스킬 설명과 정반대로 분신이 2배 넘게 셌다.
	-- → 본체가 실제로 쓰는 배율을 그대로 서버에 올려 분신이 같은 값을 쓰게 한다.
	-- ⚠ spendable 위력 배율(0.6~1.0)까지 곱해서 보낸다 - 본체는 전투력에 이미 곱해 넘기지만
	--   분신은 소환 시점의 순수 전투력(CalcCombatPower)을 받으므로 배율 쪽에 실어야 총합이 맞는다.
	@ExecSpace("ClientOnly")
	method void SyncShadowCloneRatesToServer()
		local dsLv = math.max(1, self:GetHeroSkillLevelByName("더블스탭"))
		local sbLv = math.max(1, self:GetHeroSkillLevelByName("새비지블로우"))
		local asLv = math.max(1, self:GetHeroSkillLevelByName("어썰터"))
		local anLv = math.max(1, self:GetHeroSkillLevelByName("암살"))
		local dsM = self:GetSkillPowerMultiplier("더블스탭")
		local sbM = self:GetSkillPowerMultiplier("새비지블로우")
		local asM = self:GetSkillPowerMultiplier("어썰터")
		local anM = self:GetSkillPowerMultiplier("암살")
		self:RequestSetShadowCloneRates(
			self:GetDoubleStabRateMinLv(dsLv) * dsM, self:GetDoubleStabRateMaxLv(dsLv) * dsM,
			self:GetSavageBlowMinPercent(sbLv) / 100 * sbM, self:GetSavageBlowMaxPercent(sbLv) / 100 * sbM,
			self:GetAssaulterMinPercent(asLv) / 100 * asM, self:GetAssaulterMaxPercent(asLv) / 100 * asM,
			self:GetAssassinateMinPercent(anLv) / 100 * anM, self:GetAssassinateMaxPercent(anLv) / 100 * anM)
	end

	@ExecSpace("Server")
	method void RequestSetShadowCloneRates(number dsMin, number dsMax, number sbMin, number sbMax,
		number asMin, number asMax, number anMin, number anMax)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SetShadowCloneRates(dsMin, dsMax, sbMin, sbMax, asMin, asMax, anMin, anMax)
	end

	@ExecSpace("ClientOnly")
	method void CancelShadowCloneEarly()
		-- (2026-08-06) 분신 버프 아이콘 우클릭 취소: 버프바를 내리고 서버 분신을 없앤다.
		-- ⚠ 이미 걸린 재사용 대기시간(5분)은 그대로 남는다 - 다른 소환 버프의 우클릭 취소와 같은 규칙.
		self._T.shadowCloneEndAt = 0
		_ShadowCloneBuffUI:HideBuff()
		self:RequestCancelBuff("shadowclone")
		log("[SkillManager] 분신 조기 해제(우클릭) - 쿨타임은 그대로 유지")
	end

	-- ── 연막(섀도어 4차 버프) ─────────────────────────────────────────────
	-- (2026-08-06 신설) 지속시간을 우측 상단 버프바에 표시하게 되면서 조기 해제 경로도 함께 만들었다.
	-- 시작(ShowBuff)은 시전 분기가 직접 부르고, 여기서는 우클릭 취소만 다룬다.

	@ExecSpace("ClientOnly")
	method void CancelSmokeScreenEarly()
		-- 버프바 아이콘 우클릭 취소: 버프바를 내리고 서버 연막(효과 창 + 바닥 연기 + 화면)을 걷는다.
		-- ⚠ 이미 걸린 재사용 대기시간(3분)은 그대로 남는다 - 다른 버프의 우클릭 취소와 같은 규칙.
		_SmokeScreenBuffUI:HideBuff()
		self:RequestCancelSmokeScreen()
		log("[SkillManager] 연막 조기 해제(우클릭) - 쿨타임은 그대로 유지")
	end

	@ExecSpace("Server")
	method void RequestCancelSmokeScreen()
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:CancelSmokeScreen()
	end

	-- ── 암행(나이트로드 2차 버프) ─────────────────────────────────────────
	-- (요청 2026-08-05) ON/OFF 토글 → 지속시간 버프로 전환. 지속시간 관리·버프바 표시·서버 통보를
	-- 여기서 전부 맡고, CharInfoManager는 "지금 켜져 있는가"(amhaengOn)만 들고 있는다.

	@ExecSpace("ClientOnly")
	method void StartAmhaengLocal(number duration, integer level)
		-- 암행 시작/갱신. 지속 중 다시 써도 아이콘이 중첩되지 않고 지속시간만 갱신된다.
		if self._T.amhaengExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.amhaengExpireTimerId)
		end
		self._T.amhaengExpireTimerId = _TimerService:SetTimerOnce(function()
			self._T.amhaengExpireTimerId = nil
			self:OnAmhaengEnded()
		end, duration)
		_CharInfoManager:SetAmhaengActive(true)
		-- (나이트로드 개편) 발동 확률·표창 데미지가 투자 레벨에 따라 달라지므로 켤 때마다
		-- 최신 레벨도 함께 넘긴다(백스탭과 동일한 구조).
		self:RequestSetAmhaengState(true, level)
		_AmhaengBuffUI:ShowBuff(duration)
	end

	@ExecSpace("ClientOnly")
	method void OnAmhaengEnded()
		-- 해제 공용 정리(만료 / 우클릭 취소). 여러 경로가 겹쳐 들어와도 한 번만 처리한다.
		if not _CharInfoManager:IsAmhaengActive() then return end
		if self._T.amhaengExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.amhaengExpireTimerId)
			self._T.amhaengExpireTimerId = nil
		end
		_CharInfoManager:SetAmhaengActive(false)
		self:RequestSetAmhaengState(false, self:GetHeroSkillLevelByName("암행"))
		_AmhaengBuffUI:HideBuff()
		log("[SkillManager] 암행 종료 - 온히트 그림자 표창 중지")
	end

	@ExecSpace("ClientOnly")
	method void CancelAmhaengEarly()
		-- 버프 아이콘 우클릭 취소. 만료와 같은 정리를 그대로 태운다(암행은 재사용 대기시간이 없다).
		self:OnAmhaengEnded()
		log("[SkillManager] 암행 해제(우클릭)")
	end

	-- ── 암행2(섀도어 3차 버프) ────────────────────────────────────────────
	-- (요청 2026-08-06) ON/OFF 토글 → 암행1과 같은 지속시간 버프로 전환. 위 암행1 3종
	-- (StartAmhaengLocal / OnAmhaengEnded / CancelAmhaengEarly)의 정확한 복제이며, 다른 것은
	-- 상태 보관 위치(amhaeng2*)와 버프바 UI(_Amhaeng2BuffUI)뿐이다.
	-- ⚠ 지속시간 공식은 **암행1의 GetAmhaengDuration을 그대로** 쓴다 - "같은 성장 곡선" 요청이라
	--   공식을 복제하지 않고 한 곳(암행1 헬퍼)만 남긴다.

	@ExecSpace("ClientOnly")
	method void StartAmhaeng2Local(number duration, integer level)
		-- 암행2 시작/갱신. 지속 중 다시 써도 아이콘이 중첩되지 않고 지속시간만 갱신된다.
		if self._T.amhaeng2ExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.amhaeng2ExpireTimerId)
		end
		self._T.amhaeng2ExpireTimerId = _TimerService:SetTimerOnce(function()
			self._T.amhaeng2ExpireTimerId = nil
			self:OnAmhaeng2Ended()
		end, duration)
		_CharInfoManager:SetAmhaeng2Active(true)
		-- 발동 확률·한 타당 데미지가 투자 레벨에 따라 달라지므로 켤 때마다 최신 레벨도 함께 넘긴다.
		self:RequestSetAmhaeng2State(true, level)
		_Amhaeng2BuffUI:ShowBuff(duration)
	end

	@ExecSpace("ClientOnly")
	method void OnAmhaeng2Ended()
		-- 해제 공용 정리(만료 / 우클릭 취소). 여러 경로가 겹쳐 들어와도 한 번만 처리한다.
		if not _CharInfoManager:IsAmhaeng2Active() then return end
		if self._T.amhaeng2ExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.amhaeng2ExpireTimerId)
			self._T.amhaeng2ExpireTimerId = nil
		end
		_CharInfoManager:SetAmhaeng2Active(false)
		self:RequestSetAmhaeng2State(false, self:GetHeroSkillLevelByName("암행2"))
		_Amhaeng2BuffUI:HideBuff()
		log("[SkillManager] 암행2 종료 - 뒤쪽 그림자 발동 중지")
	end

	@ExecSpace("ClientOnly")
	method void CancelAmhaeng2Early()
		-- 버프 아이콘 우클릭 취소. 만료와 같은 정리를 그대로 태운다(암행2도 재사용 대기시간이 없다).
		self:OnAmhaeng2Ended()
		log("[SkillManager] 암행2 해제(우클릭)")
	end

	-- ── 각성(나이트로드 4차 버프) ─────────────────────────────────────────
	-- 이 스크립트가 담당하는 부분: 지속 상태/쿨타임 게이트/버프바·쿨타임 UI/공속 단계 적용.
	-- 연출(어두워짐·전용 BGM)과 표창 3종의 조준 범위 확장·크리티컬 확정은 서버 PlayerAttack이 담당한다.

	-- (자동사냥) 지금 각성을 쓸 수 있는가 - 재사용 대기시간(5분)이 끝났고 아직 켜져 있지 않을 때만 true.
	-- 자동사냥은 이 값이 true인 순간 바로 시전한다(요청: "쿨이 돌면 빨리 써주는 것이 좋다").
	@ExecSpace("ClientOnly")
	method boolean CanAutoCastAwakening()
		if self:IsAwakeningActive() then return false end
		if self:IsInRecoveryAura() then return true end
		return (self._T.awakeningCooldownUntil or 0) <= _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ClientOnly")
	method boolean IsAwakeningActive()
		-- 지금 각성이 켜져 있는가(다른 클라 판정에서 쓸 수 있게 공개 헬퍼로 둔다).
		return (self._T.awakeningActiveUntil or 0) > _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ClientOnly")
	method void StartAwakeningLocal(number duration, integer stages)
		-- 클라 상태 시작: 지속시간 예약 + 공속 단계 적용 + 버프바 표시.
		local now = _UtilLogic.ElapsedSeconds
		self._T.awakeningActiveUntil = now + duration
		if self._T.awakeningExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.awakeningExpireTimerId)
		end
		self._T.awakeningExpireTimerId = _TimerService:SetTimerOnce(function()
			self:OnAwakeningEnded()
		end, duration)
		-- 공속은 클라 전용 상태(atkSpeedStage)라 여기서 직접 올린다. 부스터/발도술과는 별도 토큰이라 겹친다.
		_CharInfoManager:UseAwakeningAtkSpeed(duration, stages)
		_AwakeningBuffUI:ShowBuff(duration)
	end

	@ExecSpace("ClientOnly")
	method void OnAwakeningEnded()
		-- 해제 공용 정리(만료 / 우클릭 취소 / 서버 통보). 여러 경로가 겹쳐 들어와도 한 번만 처리한다.
		if (self._T.awakeningActiveUntil or 0) <= 0 then return end
		self._T.awakeningActiveUntil = 0
		if self._T.awakeningExpireTimerId ~= nil then
			_TimerService:ClearTimer(self._T.awakeningExpireTimerId)
			self._T.awakeningExpireTimerId = nil
		end
		_CharInfoManager:CancelAwakeningAtkSpeed()
		_AwakeningBuffUI:HideBuff()
		log("[SkillManager] 각성 종료 - 공격속도 원복")
	end

	@ExecSpace("ClientOnly")
	method void CancelAwakeningEarly()
		-- 버프 아이콘 우클릭 취소. 클라 정리 + 서버 상태 종료를 한 곳으로 묶는다
		-- (이미 걸린 재사용 대기시간 5분은 그대로 남는다 - 취소는 "쓴 것을 되돌리는" 것이 아니다).
		self:OnAwakeningEnded()
		self:RequestCancelBuff("awakening")
		log("[SkillManager] 각성 해제(우클릭)")
	end

	-- ── 시전 기준 위치 보고 ───────────────────────────────────────────────
	-- ⚠ 플레이어 이동은 클라 권한이라 서버가 들고 있는 위치는 뒤늦게 따라온다. 실측(2026-08-05)으로
	--   같은 점프에서 클라 정점 +1.194유닛 / 서버 정점 +0.602유닛 - 절반밖에 안 올라온다.
	--   표창 3종(럭키세븐/트리플/쿼드러플)의 대상 탐색은 세로 폭이 ±1.0으로 좁아, 점프해서 위 발판의
	--   적을 노리면 서버 눈에는 사거리 밖이라 아무것도 안 나갔다(신고).
	-- → 시전 RPC **바로 앞에서** 클라 실제 위치를 먼저 보내둔다.
	-- ⚠ 반드시 시전 RPC와 **같은 수신자(SkillManager)** 로 보낸다 - 서로 다른 객체로 보내면 두 RPC의
	--   도착 순서가 보장되지 않는다(암살의 RequestSetAssassinateHold → RequestFireAssassinate와 같은 관례).
	@ExecSpace("ClientOnly")
	method void ReportCastOrigin()
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		self:RequestReportCastOrigin(player.TransformComponent.WorldPosition)
	end

	@ExecSpace("Server")
	method void RequestFireDrainShot(number combatPower, number atkMultiplier, number healPercent)
		-- 드레인 샷: 서버가 표창 투척 + 흡혈을 담당한다(PlayerAttack.AttackDrainShot).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local paDS = player:GetComponent(PlayerAttack)
		if not isvalid(paDS) then return end
		-- 안전 범위로 clamp(10~30%) - 클라 계산값이 어긋나도 서버가 이상한 회복량을 잡지 않게 한다.
		paDS:AttackDrainShot(combatPower, atkMultiplier, math.max(10, math.min(healPercent or 10, 30)))
	end

	@ExecSpace("Server")
	method void RequestSetFakeLevel(integer level)
		-- (페이크) 투자 레벨을 서버에 반영한다 - 피격 회피 확률(1%/포인트) 판정이 서버에 있다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local paFK = player:GetComponent(PlayerAttack)
		if not isvalid(paFK) then return end
		paFK:SetFakeSkillLevel(level)
	end

	-- ── 표창 분산 (나이트로드 1차 토글, 2026-08-07 신설) ─────────────────────
	-- 켜져 있으면 표창 3종의 표창이 발 수만큼 서로 다른 적에게 한 발씩 날아간다(한 줄 = 합산의 60%,
	-- 표적이 모자라 겹치는 줄은 10%). 판정 전부 서버(PlayerAttack) - 여기서는 토글 상태만 보낸다.
	-- 상태는 저장하지 않는다(접속할 때마다 OFF에서 시작).

	@ExecSpace("ClientOnly")
	method boolean IsStarSpreadEnabled()
		-- (표창 분산) 토글 상태 조회 - 자동사냥이 자동 ON 판단에 쓴다.
		return self._T.starSpreadEnabled == true
	end

	@ExecSpace("ClientOnly")
	method void SetStarSpreadEnabled(boolean spreadOn)
		-- (표창 분산) 토글 본체. 퀵슬롯 시전/자동사냥 자동 ON이 모두 이 한 곳을 지난다.
		-- 처음부터 마스터(1레벨)라 "배웠는가" 검사는 직업 카탈로그에 있는지로만 확인한다.
		if spreadOn and self:GetHeroSkillLevelByName("표창 분산") < 1 then return end
		if (self._T.starSpreadEnabled == true) == spreadOn then return end
		self._T.starSpreadEnabled = spreadOn
		self:RequestSetStarSpread(spreadOn)
		-- 우측 상단 버프바 아이콘(StarSpreadBuffUI) - 무기한 토글이라 카운트다운 없이 켜고 끄기만 한다.
		if spreadOn then
			_StarSpreadBuffUI:ShowBuff()
		else
			_StarSpreadBuffUI:HideBuff()
		end
		_UIToast:ShowMessage(spreadOn and "표창 분산 ON (표창이 적마다 하나씩)" or "표창 분산 OFF (한 적에게 집중)")
		log("[SkillManager] 표창 분산 토글: " .. (spreadOn and "ON" or "OFF"))
	end

	@ExecSpace("Server")
	method void RequestSetStarSpread(boolean spreadOn)
		-- (표창 분산) 토글 상태를 서버 PlayerAttack에 반영한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local paSS = player:GetComponent(PlayerAttack)
		if not isvalid(paSS) then return end
		paSS:SetStarSpreadEnabled(spreadOn == true)
	end

	@ExecSpace("Server")
	method void RequestReportCastOrigin(Vector3 pos)
		-- 클라가 보고한 시전 시점 위치를 서버 PlayerAttack에 새겨둔다(0.5초 유효 - GetCastOrigin).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local paCO = player:GetComponent(PlayerAttack)
		if not isvalid(paCO) then return end
		paCO:SetCastOrigin(pos)
	end

	@ExecSpace("Server")
	method void RequestFireAwakening(number duration, number atkMultiplier)
		-- 각성 시전: 서버에서 상태/연출/표창 조준·크리티컬 보정을 담당한다(PlayerAttack.AttackAwakening).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireAwakening: player not found")
			return
		end
		---@type PlayerAttack
		local paAW = player:GetComponent(PlayerAttack)
		if not isvalid(paAW) then
			log_warning("[SkillManager] RequestFireAwakening: PlayerAttack component not found")
			return
		end
		-- 안전 범위로 clamp(10~39초) - 클라 계산값이 어긋나도 서버가 이상한 지속시간을 잡지 않게 한다.
		local awDur = math.max(10, math.min(duration or 10, 39))
		paAW:AttackAwakening(awDur, atkMultiplier)
		log("[SkillManager] 각성 요청 지속=" .. tostring(awDur))
	end

	@ExecSpace("Server")
	method void RequestFireDarkSightLv(number speedMult)
		-- 다크사이트 시작: 서버에서 상태/이동속도/연출을 담당한다(PlayerAttack.AttackDarkSightLv).
		-- (2026-08-06 개편) 은신 중 이동 속도 배율을 투자 레벨로 계산해 넘긴다.
		-- ⚠ 기존 RequestFireDarkSight에 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireDarkSightLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireDarkSightLv: PlayerAttack component not found")
			return
		end
		pa:AttackDarkSightLv(speedMult)
		log("[SkillManager] 다크사이트 요청 (이동속도 배율 " .. string.format("%.2f", speedMult) .. ")")
	end

	@ExecSpace("Server")
	method void RequestCancelDarkSight()
		-- 다크사이트 조기 해제(재사용/우클릭)를 서버에 알린다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:CancelDarkSightBuff()
	end

	@ExecSpace("Server")
	method void RequestBreakDarkSight()
		-- 공격 동작으로 인한 해제를 서버에 알린다. 해제 사유를 "공격"으로 넘겨야 서버가
		-- 1초 크리티컬 유예를 열어, 이번 시전이 만드는 나머지 타격(투사체 도착/다단히트)까지
		-- 크리티컬로 들어간다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:BreakDarkSightByAttack()
	end

	@ExecSpace("Server")
	method void RequestFireSixDragons(number combatPower, number multMin, number multMax, number duration)
		-- 용 소환: 서버에서 용 순차 소환 시작(PlayerAttack.SummonSixDragons).
		-- (스펙 개편) multMin/multMax = 용 1타 데미지 배율 범위, duration = 소환 지속시간(초).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireSixDragons: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireSixDragons: PlayerAttack component not found")
			return
		end
		-- 안전 범위로 clamp(2분~10분) - 클라 계산값이 어긋나도 서버가 이상한 지속시간을 잡지 않게 한다.
		local sdDur = math.max(120, math.min(duration or 120, 600))
		pa:SummonSixDragons(combatPower, multMin, multMax, sdDur)
		log("[SkillManager] 용 소환 요청 combatPower=" .. tostring(combatPower) .. " 지속=" .. tostring(sdDur))
	end

	@ExecSpace("ClientOnly")
	method table BuildShadowCloneCostume()
		-- 분신에 입힐 **주인 장비 RUID 목록**. 서버는 CostumeManager의 실제 장착값을 읽을 수 없어
		-- (클라 전용 상태), 여기서 뽑아 RPC로 올린다 - DecoWindowManager.ApplyAppearanceServer와 같은 관례.
		-- ⚠ 엔진 enum은 RPC 인자로 넘길 수 없다(LEA-3036) - 정수 코드로 보내고 서버가
		--   PlayerAttack.ShadowCloneCatEnum으로 되돌린다. 두 매핑은 반드시 짝을 이뤄야 한다.
		local out = {}
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return out end
		local cm = player:GetComponent(CostumeManagerComponent)
		if not isvalid(cm) then return out end
		local cats = {
			{ 0, MapleAvatarItemCategory.Body },
			{ 1, MapleAvatarItemCategory.Face },
			{ 2, MapleAvatarItemCategory.Hair },
			{ 3, MapleAvatarItemCategory.Coat },
			{ 4, MapleAvatarItemCategory.Pants },
			{ 5, MapleAvatarItemCategory.Shoes },
			{ 6, MapleAvatarItemCategory.Cap },
			{ 7, MapleAvatarItemCategory.OneHandedWeapon },
			{ 8, MapleAvatarItemCategory.TwoHandedWeapon },
			{ 9, MapleAvatarItemCategory.Cape },
			{ 10, MapleAvatarItemCategory.Glove },
		}
		for _, c in ipairs(cats) do
			-- GetEquip은 미장착 슬롯에서 nil을 돌려줄 수 있으므로 항상 문자열로 만들어 걸러낸다.
			local r = cm:GetEquip(c[2])
			if r ~= nil and tostring(r) ~= "" then
				table.insert(out, { c[1], tostring(r) })
			end
		end
		return out
	end

	@ExecSpace("Server")
	method void RequestFireShadowCloneEx(table costume, number duration, number damagePercent, integer skillTier, number combatPower, number darkSightCooldown)
		-- 분신 소환: 서버에서 아바타 NPC 분신 스폰(PlayerAttack.SummonShadowCloneEx).
		-- ⚠ 기존 RequestFireShadowClone에 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피 관례).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireShadowCloneEx: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireShadowCloneEx: PlayerAttack component not found")
			return
		end
		-- 안전 범위로 clamp - 클라 계산값이 어긋나도 서버가 이상한 값을 잡지 않게 한다
		-- (지속 30~300초 / 데미지 50~90% / 스킬 1~4차 = 확정 사양의 상하한).
		local scDur = math.max(30, math.min(duration or 30, 300))
		local scDmg = math.max(50, math.min(damagePercent or 50, 90))
		local scTier = math.max(1, math.min(skillTier or 1, 4))
		local scCp = math.max(0, combatPower or 0)
		local scDsCd = math.max(0, math.min(darkSightCooldown or 0, 60))
		pa:SummonShadowCloneEx(costume, scDur, scDmg, scTier, scCp, scDsCd)
		log("[SkillManager] 분신 소환 요청 지속=" .. tostring(math.floor(scDur))
			.. " 데미지=" .. tostring(math.floor(scDmg)) .. "% " .. tostring(scTier) .. "차"
			.. " 전투력=" .. tostring(math.floor(scCp))
			.. " 다크사이트쿨=" .. tostring(math.floor(scDsCd)))
	end

	@ExecSpace("Server")
	method void RequestSwapShadowClone()
		-- 분신과 위치 교환. 분신이 이미 사라졌으면 서버가 조용히 무시한다(클라의 수명 추정이
		-- 서버 실제 소멸보다 늦을 수 있다 - 그 간극은 여기서 흡수한다).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SwapWithShadowClone()
	end

	@ExecSpace("Server")
	method void RequestFireHealerSummon(number playerLevel, number duration, integer healPercent, integer hpPercent)
		-- 힐러 소환: 서버에서 아바타 NPC 힐러 스폰(PlayerAttack.SummonHealer).
		-- (스펙 개편) duration = 소환 지속시간(초), healPercent = 힐 1회 회복량(주인 최대 HP의 %),
		-- hpPercent = 힐러 최대 HP(주인 최대 HP의 %). 셋 다 클라가 투자 레벨로 계산해 넘긴다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireHealerSummon: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireHealerSummon: PlayerAttack component not found")
			return
		end
		-- 안전 범위로 clamp - 클라 계산값이 어긋나도 서버가 이상한 값을 잡지 않게 한다.
		local hlDur = math.max(60, math.min(duration or 60, 350))
		-- (요청 2026-08-05 하향) 힐량 상한 15% → 10%.
		local hlHeal = math.max(1, math.min(healPercent or 3, 10))
		local hlHp = math.max(1, math.min(hpPercent or 40, 69))
		pa:SummonHealer(playerLevel, hlDur, hlHeal, hlHp)
		log("[SkillManager] 힐러 소환 요청 playerLevel=" .. tostring(playerLevel) .. " 지속=" .. tostring(hlDur)
			.. " 힐=" .. tostring(hlHeal) .. "% HP=" .. tostring(hlHp) .. "%")
	end

	@ExecSpace("Server")
	method void RequestFireFireZoneLvDur(number combatPower, number rateMin, number rateMax, number duration)
		-- 불의 영역(2차 버프): 서버에 버프 활성과 시전 연출을 요청한다.
		-- (불독 개편 2026-08-08) 장판 틱 데미지 배율(GetFireZone*Percent / 100 = 빙하지대와 같은 곡선)도
		-- 함께 넘어온다.
		-- (요청 2026-08-14 3차) duration = 버프 지속시간(초) - 클라 SkillManager.GetFireZoneDurationLv이
		-- 유일한 출처다(빙하지대와 같은 곡선). 종전엔 서버가 600(10분) 고정이었다.
		-- ⚠ 기존 RequestFireFireZone / RequestFireFireZoneLv에 인자를 더하지 않고 매번 이름을 바꿨다
		--   (LEA-1102 회피 - 빙하지대 전례).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireFireZoneLvDur: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireFireZoneLvDur: PlayerAttack component not found")
			return
		end
		pa:CastFireZoneBuffLvDur(combatPower, rateMin, rateMax, duration)
	end

