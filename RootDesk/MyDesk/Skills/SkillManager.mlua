	-- 용사 소환: 용사 레벨 = 내 레벨의 몇 %인가. 1레벨 50% + **2분배마다** 1%p (마스터 30 = 65%).
	-- ⚠ 용사의 전투력은 HeroSummon이 "레벨 × 10"으로 잡으므로 이 값 하나만 올리면 전투력도 따라 오른다.
	@ExecSpace("ClientOnly")
	method integer GetHeroSummonLevelPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 50 + math.floor(v / 2)
	end

	-- 스나이핑 기본 데미지 최소%: 10% + 분배 1포인트당 5%p (마스터 30 = 155%).
	-- ⚠ 여기에 **모은 게이지 배율**이 따로 곱해진다(GetSnipingChargeMult).
	-- (요청 2026-08-06 하향) 구 사양(100% + 50%p/pt)의 **1/10**. 게이지 배율은 그대로라 완충 데미지도
	-- 자동으로 1/10이 된다(마스터 완충 155000%~160000% → **15500%~16000%**).
	@ExecSpace("ClientOnly")
	method number GetSnipingMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 10 + 5 * (v - 1)
	end

	-- 스나이핑 기본 데미지 최대%: 15% + 분배 1포인트당 5%p (마스터 30 = 160%).
	@ExecSpace("ClientOnly")
	method number GetSnipingMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 15 + 5 * (v - 1)
	end

	-- 스나이핑 게이지 배율: 요청 사양 "기모은 %에 따라 100% = 100배 / 10% = 10배" 그대로.
	-- t는 0.0~1.0의 차지 비율이고, 배율은 t×100(하한 1배 - 거의 안 모으고 쏴도 기본 데미지는 나온다).
	@ExecSpace("ClientOnly")
	method number GetSnipingChargeMult(number t)
		local c = math.max(0, math.min(t or 0, 1))
		return math.max(1.0, c * 100.0)
	end

	-- 피어싱 기본 데미지 최소%: 30% + 분배 1포인트당 10%p (마스터 30 = 320%).
	-- (요청 2026-08-07) 기본 데미지 **10배 상향**(구 3% + 1%p/pt).
	-- ⚠ 여기에 **모은 기 배율**이 따로 곱해진다(GetPiercingChargeMult - 완충 5배).
	--   마스터 완충 = 1600%~1700%이고 10명 관통이다
	--   (스나이핑 마스터 완충 15500%~16000% / 관통 3명 / 완충 10초 ↔ 피어싱 완충 1초).
	@ExecSpace("ClientOnly")
	method number GetPiercingMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 30 + 10 * (v - 1)
	end

	-- 피어싱 기본 데미지 최대%: 50% + 분배 1포인트당 10%p (마스터 30 = 340%).
	@ExecSpace("ClientOnly")
	method number GetPiercingMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 50 + 10 * (v - 1)
	end

	-- 피어싱 기 배율: 완충(t=1.0)에서 **5배**(요청 2026-08-07 - 구 10배).
	-- 스나이핑(100배)과 달리 완충이 1초라 자주 쏘는 대신 한 발의 배율 폭이 작다.
	@ExecSpace("ClientOnly")
	method number GetPiercingChargeMult(number t)
		local c = math.max(0, math.min(t or 0, 1))
		return math.max(1.0, c * 5.0)
	end

	-- 피어싱 완충 시간(초). 스나이핑 10초의 **1/10**(요청: "기를 모으는 속도가 10배 빠르다").
	@ExecSpace("ClientOnly")
	method number GetPiercingFullChargeSeconds()
		return 1.0
	end

	-- 프리져 공격 데미지 최소%: (요청 2026-08-13) 400% + 분배 1포인트당 5%p (마스터 20 = 495%).
	-- ⚠ 종전엔 다크나이트 용 소환 데미지의 2배를 파생받았지만, 자체 수치가 지정되면서 **파생을 끊었다** -
	--   용 소환 수치를 고쳐도 이제 프리져는 따라 움직이지 않는다.
	@ExecSpace("ClientOnly")
	method number GetFreezerMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 400 + 5 * (v - 1)
	end

