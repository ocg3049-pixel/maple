		-- 리커버리 오로라 시전: 시전자 발밑에 60초 오로라 설치(PlayerAttack.CastRecoveryAura).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireRecoveryAura: player not found")
			return
		end
		---@type PlayerAttack
