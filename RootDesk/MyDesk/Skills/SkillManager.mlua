	@ExecSpace("Server")
	method void RequestSetDragonRideMount(boolean active, number fxX, number fxY)
		-- 탑승/하차를 서버에서 처리한다. 이동속도(140% = 1.4배, 요청으로 3.2배에서 하향)는
		-- 러시(RequestSetSprintSpeed)와 같은 이유로 반드시 서버에서 바꿔야 한다
		-- (클라에서 InputSpeed를 직접 바꾸면 서버가 덮어써 무효).
		-- KinematicMove=true면 리지드바디가 상하좌우 자유이동(탑다운) 모드로 바뀌어 "아무 방향이나 비행"이 된다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		local mv = player.MovementComponent
		if self._T.rideOrigSpeedByUser == nil then self._T.rideOrigSpeedByUser = {} end
		if isvalid(mv) then
			if active then
				if self._T.rideOrigSpeedByUser[senderUserId] == nil then
					self._T.rideOrigSpeedByUser[senderUserId] = mv.InputSpeed
				end
				mv.InputSpeed = self._T.rideOrigSpeedByUser[senderUserId] * 1.4
			else
				local orig = self._T.rideOrigSpeedByUser[senderUserId]
				if orig ~= nil then
					mv.InputSpeed = orig
					self._T.rideOrigSpeedByUser[senderUserId] = nil
				end
			end
		end
		-- (요청) 네임태그는 탑승 전 위치에 그대로 둔다 - 캐릭터가 0.8 떠오르면 태그도 같이 올라가
		-- 드래곤 몸통을 가려 부자연스러웠다. 올라간 만큼 OffsetY를 내려 화면상 높이를 유지한다.
		-- OffsetY는 @Sync라 서버에서 바꿔야 모든 클라에 반영된다. 원래 값은 유저별로 백업했다가 복구.
		local nt = player.NameTagComponent
		if isvalid(nt) then
			if self._T.rideNameTagBackup == nil then self._T.rideNameTagBackup = {} end
			if active then
				if self._T.rideNameTagBackup[senderUserId] == nil then
					self._T.rideNameTagBackup[senderUserId] = nt.OffsetY
				end
				-- 0.8 = ToggleDragonRide의 탑승 상승량(RIDE_LIFT). 두 값은 반드시 같이 움직여야 한다.
				-- (버그 수정) 즉시 적용하면 캐릭터가 아직 안 올라간 상태에서 태그만 0.8 내려가
				-- "태그가 한 번 쭉 내려갔다 제자리로 오는" 것처럼 보였다. 캐릭터가 실제로 올라가는
				-- 시점(워프 종료 = 0.5초)과 똑같이 맞춰 적용한다.
				local baseOffset = self._T.rideNameTagBackup[senderUserId]
				local ntEntity = player
				_TimerService:SetTimerOnce(function()
					if not isvalid(ntEntity) then return end
					local nt2 = ntEntity.NameTagComponent
					if not isvalid(nt2) then return end
					if self._T.rideNameTagBackup[senderUserId] == nil then return end   -- 그 사이 하차했으면 취소
					nt2.OffsetY = baseOffset - 0.8
				end, 0.5)
			else
				local origOffset = self._T.rideNameTagBackup[senderUserId]
				if origOffset ~= nil then
					nt.OffsetY = origOffset
					self._T.rideNameTagBackup[senderUserId] = nil
				end
			end
		end
		-- KinematicMove는 여기(서버)에서 건드리지 않는다 - 서버가 켜면 물리 위치 보정이 들어가
		-- 탑승 순간 캐릭터가 위로 튀었다가 내려오는 점멸이 생긴다. 클라(ToggleDragonRide)에서만 전환한다.
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then
			pa:SetRidingDragonMount(active)
			pa:PlayRidingMountEffectAt(player, fxX, fxY)
		end
		log("[SkillManager] RequestSetDragonRideMount active=" .. tostring(active)
			.. " InputSpeed=" .. tostring(isvalid(mv) and mv.InputSpeed or -1)
			.. " fx=(" .. string.format("%.2f", fxX) .. ", " .. string.format("%.2f", fxY) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void ToggleDragonRide()
		-- 소환된 드래곤에 탑승 / 하차를 토글한다. 이펙트(97f1637c)는 서버가 멀티캐스트로 재생한다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local mounted = not (self._T.dragonRideMounted == true)
		self._T.dragonRideMounted = mounted
		-- 탑승 이펙트는 "캐릭터가 dy만큼 올라가기 전" 자리에서 터져야 한다(요청). 지금 좌표를 그대로
		-- 서버에 넘겨, 부착이 아니라 그 월드 좌표에 고정해 재생한다.
		-- (요청) 내릴 때도 탈 때와 "같은 높이"에서 나와야 한다 - 하차 시점의 캐릭터는 아직 0.8 떠 있는
		-- 상태라 그대로 쓰면 이펙트만 0.8 위에서 터진다. 올렸던 만큼 빼서 착지할 자리(=탈 때 자리)에 맞춘다.
		local fxPos = player.TransformComponent.WorldPosition
		local fxY = fxPos.y
		if not mounted then fxY = fxY - 0.8 end
		self:RequestSetDragonRideMount(mounted, fxPos.x, fxY)
		-- 플레이어 이동은 클라 권한이므로 KinematicMove(자유 비행 모드)는 로컬에서만 켠다.
		-- (버그 수정) "캐릭터가 위로 한 번 점멸했다가 내려오는" 증상의 원인: KinematicMove를 켜는 순간
		-- 리지드바디가 누적 위치 계산을 그대로 들고 가면서 캐릭터를 y=0(맵 원점 높이)으로 튕겨 올린다.
		-- 실측: 지면 y=-1.249 → 켜자마자 y=0.000 고정. 예전엔 0.05초 뒤 SetWorldPosition으로 끌어내려
        -- 점멸이 보였고, 즉시 SetWorldPosition은 아예 먹지 않았다.
		-- 정답은 전환 직후 PositionReset() - "현재 위치 기준으로 위치 계산을 새로 시작"이라 튐 자체가 없다
		-- (실측: 전환 후 0.1초/0.6초 모두 y=-1.249 유지).
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			rb.KinematicMove = mounted
			rb:PositionReset()
			-- (요청) 탑승/해제 시 캐릭터를 0.8만큼 올렸다/내렸다 한다(네임태그가 드래곤을 가려 0.45 → 0.8로 상향). 올리는 타이밍은 "드래곤이 사라졌다가
			-- 다시 나타나는 사이"(워프 0.5초의 중간 지점 0.25초)라, 탑승 이펙트는 올라가기 전 자리에서 터지고
			-- 캐릭터는 그 뒤에 스르륵 올라간 자리에서 드래곤과 함께 나타난다.
			-- 해제할 때는 반대로 올렸던 만큼(0.8) 내린 자리에 나타나게 한다. 서버는 같은 값만큼 네임태그
			-- OffsetY를 내려 태그만 탑승 전 높이에 남긴다(RequestSetDragonRideMount).
			-- SetWorldPosition은 여러 번 나눠 호출하면 되돌아가는 버그가 있어 각 전환마다 1회만 호출한다.
			if mounted then
				_TimerService:SetTimerOnce(function()
					local p = _UserService.LocalPlayer
					if not isvalid(p) then return end
					if self._T.dragonRideMounted ~= true then return end   -- 그 사이 내렸으면 취소
					local body = p.RigidbodyComponent
					if not isvalid(body) then return end
					local w = p.TransformComponent.WorldPosition
					body:SetWorldPosition(Vector2(w.x, w.y + 0.8))
					body:PositionReset()
				end, 0.5)
			else
				-- (버그 수정) 하차 시 "네임태그가 한 번 쭉 내려갔다 오는" 증상 - 실측하니 캐릭터는 즉시
				-- 0.8 내려가는데 네임태그 OffsetY 복구(@Sync, 서버→클라)는 2프레임 뒤에 도착해서,
				-- 그 2프레임 동안 태그만 0.8 아래에 남아 있었다.
				-- 그래서 "태그가 복구된 것을 확인한 프레임"에 내려가도록 맞춘다(최대 0.5초까지 대기).
				self._T.rideDropWaitFrames = 0
				if self._T.rideDropTimerId ~= nil then _TimerService:ClearTimer(self._T.rideDropTimerId) end
				self._T.rideDropTimerId = _TimerService:SetTimerRepeat(function()
					local p2 = _UserService.LocalPlayer
					if not isvalid(p2) then
						_TimerService:ClearTimer(self._T.rideDropTimerId)
						self._T.rideDropTimerId = nil
						return
					end
					self._T.rideDropWaitFrames = (self._T.rideDropWaitFrames or 0) + 1
					local nt2 = p2.NameTagComponent
					local restored = (not isvalid(nt2)) or (nt2.OffsetY > -0.4)   -- -0.8이 아니면 복구된 것
					if restored or self._T.rideDropWaitFrames >= 30 then
						_TimerService:ClearTimer(self._T.rideDropTimerId)
						self._T.rideDropTimerId = nil
						local body2 = p2.RigidbodyComponent
						if isvalid(body2) then
							-- (버그 수정) "제자리에서 내렸는데 아래 발판으로 떨어진다" - 올린 0.8을 그대로 다시
							-- 내리면 순간이동 한 번에 발판 선을 지나쳐 버려서 발판이 캐릭터를 못 잡는다
							-- (MapleTile 발판은 연속 충돌 판정이 아니다). 0.6만 내려서 원래 서 있던 높이보다
							-- 0.2 위에 두고, 나머지는 중력이 자연스럽게 착지시킨다.
							local w2 = p2.TransformComponent.WorldPosition
							body2:SetWorldPosition(Vector2(w2.x, w2.y - 0.6))
							body2:PositionReset()
						end
					end
				end, 1 / 60)
			end
		end
		if mounted then
			self:StartRidePose()
			log("[SkillManager] 드래곤 라이딩 탑승 - 이동속도 140%, 자유 비행")
		else
			self:StopRidePose()
			log("[SkillManager] 드래곤 라이딩 하차")
		end
	end

	@ExecSpace("ClientOnly")
	method void StartRidePose()
		-- (요청) 탑승 중에는 캐릭터 모션을 sit(앉은 자세)으로 고정한다.
		-- PlayerControllerComponent가 입력/접지 상태에 따라 매 틱 상태를 다시 잡아 IDLE/MOVE/FALL 모션으로
		-- 덮어쓰기 때문에, 러시의 질주 자세(PlaySprintPose)와 동일하게 sit 액션을 짧은 주기로 재전송한다.
		-- 실제 sit 고정은 서버가 아바타 모션 시트(IDLE/MOVE/JUMP/FALL/CROUCH → sit)를 통째로 바꾸는 쪽에서
		-- 처리한다(PlayerAttack.SetRidingAvatarSheet). 시트만 바꾸면 "다음 상태 전환"부터 반영되므로,
		-- 여기서는 시트가 동기화될 즈음 상태를 한 번 튕겨(IDLE→MOVE→IDLE) 지금 재생 중인 클립을 갱신한다.
		self:BounceAvatarState()
		_TimerService:SetTimerOnce(function() self:BounceAvatarState() end, 0.25)
		_TimerService:SetTimerOnce(function() self:BounceAvatarState() end, 0.6)
		log("[SkillManager] 라이딩 자세(sit) 갱신 요청")
	end

	@ExecSpace("ClientOnly")
	method void BounceAvatarState()
		-- 아바타 상태를 한 바퀴 튕겨 StateChangeEvent를 강제로 발생시킨다(모션 시트 변경 즉시 반영용).
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local sc = player.StateComponent
		if not isvalid(sc) or sc.CurrentStateName == "DEAD" then return end
		sc:ChangeState("IDLE")
		sc:ChangeState("MOVE")
		sc:ChangeState("IDLE")
	end

	@ExecSpace("ClientOnly")
	method void StopRidePose()
		-- 하차: 서버가 시트를 기본값으로 되돌린 뒤, 같은 방식으로 상태를 튕겨 걷기/서기 모션을 되살린다.
		self:BounceAvatarState()
		_TimerService:SetTimerOnce(function() self:BounceAvatarState() end, 0.25)
	end

	@ExecSpace("ClientOnly")
	method void OnDragonRideExpired()
		-- 소환 5분 만료: 탑승 중이었다면 강제로 내리고, 퀵슬롯 아이콘을 원래 스킬 아이콘으로 되돌린다.
		self._T.dragonRideActiveUntil = 0
		self._T.dragonRideExpireTimerId = nil
		if self._T.dragonRideMounted == true then
			self:ToggleDragonRide()
		end
		self:SetDragonRideSlotIcon(false)
		-- 버프바 아이콘도 함께 내린다(정상 흐름에서는 버프 타이머도 같은 300초라 거의 동시에 끝나지만,
		-- 드래곤이 먼저 사라지는 등 어긋나는 경우에도 표시가 남지 않게 한다).
		_DragonRidingBuffUI:HideBuff()
		log("[SkillManager] 드래곤 라이딩 소환 종료(5분 경과)")
	end

	-- ── 차지 블로우(3차) 모드 전환 ────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method boolean IsChargeBlowModeSkill(string skillName)
		-- 차지 블로우의 속성을 정하는 디바인 4종인지.
		return skillName == "디바인 스티그마 강화" or skillName == "디바인 스윙 강화"
			or skillName == "디바인 저지먼트 강화" or skillName == "디바인 차지"
	end

	@ExecSpace("ClientOnly")
	method integer GetChargeBlowModeIndex(string skillName)
		-- 디바인 4종 이름 → 속성 인덱스(1 스티그마 / 2 스윙 / 3 저지먼트 / 4 차지). 아니면 0.
		if skillName == "디바인 스티그마 강화" then return 1 end
		if skillName == "디바인 스윙 강화" then return 2 end
		if skillName == "디바인 저지먼트 강화" then return 3 end
		if skillName == "디바인 차지" then return 4 end
		return 0
	end

	@ExecSpace("ClientOnly")
	method integer GetEffectiveChargeBlowMode()
		-- 실제로 차지 블로우에 실릴 속성. 디바인 4종을 아직 한 번도 쓰지 않았으면(모드 0) 요청대로
		-- 디바인 차지 → 디바인 스윙 강화 → 디바인 저지먼트 강화 → 디바인 스티그마 강화 순으로 기본값을
		-- 정한다. "아직 스킬을 보유하지 않았을 경우"를 건너뛰어야 하는데, 이 게임엔 스킬 학습 시스템이
		-- 따로 없어 보유 여부의 유일한 신호가 "퀵슬롯에 배정되어 있는가"다 - 그걸로 판단한다.
		-- (나중에 진짜 학습 시스템이 생기면 이 판정만 그쪽으로 갈아끼우면 된다.)
		local mode = self._T.chargeBlowMode or 0
		if mode > 0 then return mode end
		local order = { 4, 2, 3, 1 }   -- 차지 → 스윙 강화 → 저지먼트 강화 → 스티그마 강화
		local names = { "디바인 스티그마 강화", "디바인 스윙 강화", "디바인 저지먼트 강화", "디바인 차지" }
		for _, m in ipairs(order) do
			if self:FindBarPosForSkillName(names[m]) ~= "" then return m end
		end
		-- 넷 다 없으면 목록 첫 번째(디바인 차지)를 기본으로 쓴다.
		return 4
	end

	@ExecSpace("ClientOnly")
	method string GetChargeBlowModeRuid()
		-- 현재 실제 적용 속성의 아이콘 RUID. 아직 아무것도 안 골랐어도 기본 속성이 걸리므로
		-- 퀵슬롯 아이콘도 그 기본 속성 아이콘을 보여준다(실제로 나가는 속성과 화면 표시를 일치시킨다).
		local mode = self:GetEffectiveChargeBlowMode()
		if mode == 2 then return "73d6c63787a64b2c8d34373792b7e716" end       -- 디바인 스윙 강화
		if mode == 3 then return "8dbb1b41e92c4f8290402b9a7d51649d" end       -- 디바인 저지먼트 강화
		if mode == 4 then return "2ba15e204ac64214a8144b0b2deeaf79" end       -- 디바인 차지
		return "28e3b85f945347fa8209ec18b4bb296c"                             -- 디바인 스티그마 강화
	end

	@ExecSpace("ClientOnly")
	method string GetChargeBlowModeName()
		-- 현재 실제 적용 속성 이름. 아직 디바인 4종을 한 번도 안 썼으면 기본 속성 이름 뒤에 (기본)을 붙인다.
		local chosen = self._T.chargeBlowMode or 0
		local mode = self:GetEffectiveChargeBlowMode()
		local name = "디바인 스티그마 강화"
		if mode == 2 then name = "디바인 스윙 강화" end
		if mode == 3 then name = "디바인 저지먼트 강화" end
		if mode == 4 then name = "디바인 차지" end
		if chosen <= 0 then return name .. "(기본)" end
		return name
	end

	@ExecSpace("ClientOnly")
	method void RefreshChargeBlowSlotIcon()
		-- 차지 블로우가 배정된 퀵슬롯 아이콘을 현재 모드 아이콘으로 바꾼다.
		-- slotData의 ruid는 건드리지 않는다(스킬창/저장 데이터는 원래 아이콘 유지) - 대신
		-- UpdateBarSlotVisual이 슬롯을 다시 그릴 때마다 이 메서드가 다시 불려 모드 아이콘을 덮어쓴다.
		local pos = self:FindBarPosForSkillName("차지 블로우")
		if pos == "" then return end
		local iconEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar/Slot_" .. pos .. "/Icon")
		if not isvalid(iconEnt) then return end
		local spr = iconEnt.SpriteGUIRendererComponent
		spr.ImageRUID = self:GetChargeBlowModeRuid()
		spr.Color = Color(1, 1, 1, 1)
	end

	@ExecSpace("ClientOnly")
	method void SetDragonRideSlotIcon(boolean summoned)
		-- (요청) 소환 지속 시간 동안 퀵슬롯 아이콘을 드래곤 라이딩 아이콘으로 바꾼다.
		-- 해제할 때는 UpdateBarSlotVisual로 원래 스킬 아이콘을 다시 그린다.
		local pos = self:FindBarPosForSkillName("드래곤 라이딩")
		if pos == "" then return end
		if not summoned then
			self:UpdateBarSlotVisual(pos)
			return
		end
		local iconEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar/Slot_" .. pos .. "/Icon")
		if isvalid(iconEnt) then
			local spr = iconEnt.SpriteGUIRendererComponent
			spr.ImageRUID = "77e0cbe8c4fb438792fe01f768e7046f"
			spr.Color = Color(1, 1, 1, 1)
		end
	end

	@ExecSpace("Client")
	method void ResetAllCooldowns()
		-- 다크드래곤의 "쿨타임 전체 초기화" 버프. 클라 전용 쿨다운 상태를 전부 푼다
		-- (공용 스킬 쿨다운 / 돌진 / 텔레포트 / 가드). 서버가 대상 유저를 지정해 호출한다.
		self._T.skillOnCooldown = false
		self._T.rushOnCooldown = false
		self._T.teleportOnCooldown = false
		self._T.guardCooldownUntil = 0
		log("[SkillManager] 다크드래곤 버프: 쿨타임 전체 초기화!")
	end

	@ExecSpace("Server")
	method void RequestQueueBrandish2(number combatPower, number atkMultiplier)
		-- (브랜디쉬2 콤보) 브랜디쉬 진행 [절반~끝] 재입력 시 클라가 호출한다. 서버에서 PlayerAttack에
		-- 예약만 걸어두고(QueueBrandish2), 실제 발동은 브랜디쉬 조작복구 시점에 AttackBrandish2가 처리한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestQueueBrandish2: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestQueueBrandish2: PlayerAttack component not found")
			return
		end
		pa:QueueBrandish2(combatPower, atkMultiplier)
		log("[SkillManager] 브랜디쉬2 예약 요청 combatPower=" .. tostring(combatPower))
	end

