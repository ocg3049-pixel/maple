	@ExecSpace("ClientOnly")
	method void OnChainShotAnchored(boolean anchored, number holdSeconds)
		-- 서버(PlayerAttack.AttackChainShot)가 "지형에 박혔는지"를 알려준다. 박혔을 때만 다음 입력이
		-- 당기기가 되고, 빗나갔으면 다음 입력은 새 체인 발사가 된다.
		local now = _UtilLogic.ElapsedSeconds
		if anchored then
			self._T.chainAnchoredUntil = now + holdSeconds
			-- 키를 누르고 있을 때 반복 KeyDown이 곧바로 당기기로 이어지지 않게 짧은 유예를 둔다.
			self._T.chainPullReadyAt = now + 0.3
			log("[SkillManager] 체인샷 고정 - " .. tostring(holdSeconds) .. "초 안에 다시 누르면 당겨진다")
		else
			self._T.chainAnchoredUntil = 0
			log("[SkillManager] 체인샷 빗나감 - 지형에 박히지 않았다")
		end
	end

	@ExecSpace("Server")
	method void RequestEndRapidFire()
		-- 연사 종료를 서버에 알려 이동 잠금(PlayerControllerComponent.Enable)을 즉시 되돌린다.
		-- 이 요청이 유실돼도 서버가 마지막 발사 1초 뒤에 스스로 복구한다(AttackRapidFire의 토큰 가드).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:RestoreRapidFireControl()
	end

