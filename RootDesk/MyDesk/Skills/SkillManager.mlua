		-- 체인 라이트닝 시전 요청. 전투력/공격속도 배율은 클라 전용 상태라 RPC 인자로 넘겨받는다(공통 패턴).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireChainLightning: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireChainLightning: PlayerAttack component not found")
			return
		end
		pa:AttackChainLightning(combatPower, atkMultiplier)
		log("[SkillManager] 체인 라이트닝 발동! combatPower=" .. tostring(combatPower))
	end

