		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireSniping: PlayerAttack component not found")
			return
		end
		pa:AttackSniping(combatPower, chargeRatio, dirX, stage)
	end

	@ExecSpace("Server")
	method void RequestCancelSniping()
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:CancelSnipingHold()
	end

