		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireRage: PlayerAttack component not found")
			return
		end
		pa:AttackRage(atkMultiplier)
		log("[SkillManager] 분노 발동!")
	end

