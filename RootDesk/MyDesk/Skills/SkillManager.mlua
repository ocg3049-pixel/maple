	@ExecSpace("Server")
	method void RequestFireMagicClawLv(number combatPower, number atkMultiplier, number rateMin, number rateMax)
		-- rateMin/rateMax: 한 타당 데미지 배율(클라 GetMagicClawRate*Lv = 더블샷 화살 1발과 같은 곡선).
		-- 구 사양은 서버가 1.0~1.5로 고정 계산했다 - 지금은 클라가 넘겨준 값만 쓴다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireMagicClawLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireMagicClawLv: PlayerAttack component not found")
			return
		end
		pa:AttackMagicClaw(combatPower, atkMultiplier, rateMin, rateMax)
		log("[SkillManager] 매직클로 발동! combatPower=" .. tostring(combatPower) .. " atkMultiplier=" .. tostring(atkMultiplier)
			.. " rate=" .. tostring(rateMin) .. "~" .. tostring(rateMax))
	end

	@ExecSpace("Server")
	method void RequestFireMagicMissileLv(number combatPower, number atkMultiplier, number playerLevel, string element, number rateMin, number rateMax)
		-- 매직 미사일 시전 요청. 전투력/공격속도 배율/레벨은 전부 클라이언트 전용 상태(장비·인벤토리)로
		-- 계산되는 값이라 서버에서 재계산할 수 없어 RPC 인자로 함께 넘겨받는다(다른 스킬과 동일 패턴).
		-- element: 매직 에로우 토글 속성("" / "light" / "ice" / "fire") - 클라 전용 상태라 함께 넘겨받는다
		-- (combatPower에는 이미 속성 데미지 2배가 반영되어 있고, element는 색상 연출용이다).
		-- rateMin/rateMax: (요청 2026-08-13 2차) 구체 1개당 데미지 배율(클라 GetMagicMissile*Percent / 100
		-- = 슬래시블러스트와 같은 곡선). 구 사양은 서버가 1.0~1.5로 고정 계산했다.
		-- ⚠ 기존 RequestFireMagicMissile에 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피 관례).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireMagicMissileLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent("script.PlayerAttack")
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireMagicMissileLv: PlayerAttack component not found")
			return
		end
		pa:AttackMagicMissileLv(combatPower, atkMultiplier, playerLevel, element, rateMin, rateMax)
		log("[SkillManager] 매직 미사일 발동! combatPower=" .. tostring(combatPower) .. " level=" .. tostring(playerLevel)
			.. " element=" .. tostring(element) .. " rate=" .. tostring(rateMin) .. "~" .. tostring(rateMax))
	end

