		pa:CastRecoveryAura()
		log("[SkillManager] 리커버리 오로라 발동!")
	end

	@ExecSpace("Multicast")
	method void NotifyRecoveryAuraPlaced(number x, number y, number duration)
		-- 오로라 설치 알림(서버 → 모든 클라이언트): 이 좌표를 노쿨(쿨타임 무시) 영역으로 등록한다.
		-- 시전자 본인뿐 아니라 근처의 다른 플레이어도 오로라 혜택을 받도록 전 클라이언트에 뿌린다.
		if not self:IsClient() then return end
		if self._T.recoveryAuras == nil then self._T.recoveryAuras = {} end
		table.insert(self._T.recoveryAuras, { x = x, y = y, expireAt = _UtilLogic.ElapsedSeconds + duration })
		log("[SkillManager] 리커버리 오로라 영역 등록 x=" .. string.format("%.2f", x) .. " y=" .. string.format("%.2f", y) .. " (" .. tostring(duration) .. "초)")
		-- 새로 깔린 오로라 안에 내가 이미 서 있으면(직접 시전한 경우 포함) 폴링(0.2초)을 기다리지 않고
		-- 곧바로 쿨타임을 초기화한다. wasInRecoveryAura는 여기서 세우지 않는다 - 이 호출이 어떤 이유로든
		-- 무시되더라도 RecoveryAuraTick의 진입 감지(밖 → 안 엣지)가 0.2초 안에 반드시 한 번 더 처리한다.
		if self:IsInRecoveryAura() then
			self:ResetAllCooldownsForAura()
		end
	end

	@ExecSpace("ClientOnly")
	method void RecoveryAuraTick(number delta)
		-- 오로라 범위 진입을 0.2초마다 확인해, 밖 → 안으로 바뀌는 순간 한 번만 쿨타임을 초기화한다.
		-- (이동 속도상 0.2초 간격이면 충분해서 매 프레임 검사하지 않는다.)
		self._T.auraPollAccum = (self._T.auraPollAccum or 0) + delta
		if self._T.auraPollAccum < 0.2 then return end
		self._T.auraPollAccum = 0
		local inAura = self:IsInRecoveryAura()
		local wasInAura = self._T.wasInRecoveryAura or false
		self._T.wasInRecoveryAura = inAura
		if inAura and not wasInAura then
			self:ResetAllCooldownsForAura()
		end
	end

	@ExecSpace("ClientOnly")
	method void ResetAllCooldownsForAura()
		-- (요청 2026-07-29) 오로라 안으로 들어오는 순간, 이미 돌고 있던 쿨타임도 전부 즉시 초기화한다.
		-- 타임스탬프/플래그를 지우고 퀵슬롯의 쿨타임 표시도 각 UI의 ResetCooldown으로 끈다.
		-- 리커버리 오로라 자신(recoveryAuraCooldownUntil)만은 초기화하지 않는다 - 초기화하면 오로라를
		-- 무한히 다시 깔 수 있어 영구 노쿨이 되기 때문(설계상 예외).
		-- 어썰터는 쿨타임이 아니라 스택 충전 방식이라 대상에서 제외한다.
		if not self:IsClient() then return end

		-- (요청 2026-07-30) 초기화로 다시 쓸 수 있게 된 스킬은 쿨타임이 자연히 끝났을 때와 똑같이
		-- 퀵슬롯 아이콘을 2번 깜빡여 알린다. 쿨타임 UI가 있는 스킬은 각 UI의 ResetCooldown이
		-- (남은 시간 0 → UpdateCooldownDisplay) 그 경로로 BlinkSlotReady를 호출해 자동으로 깜빡이고,
		-- 아래 5종은 전용 쿨타임 UI가 없어 직접 깜빡여준다. "돌고 있던 것만" 깜빡이도록 지우기 전에 기억해 둔다.
		local nowReset = _UtilLogic.ElapsedSeconds
		-- (요청 2026-08-13) 프리져·피닉스는 재사용 대기시간 자체가 없어져 초기화 대상에서 빠졌다.
		local bahamutWasPending  = (self._T.bahamutCooldownUntil or 0) > nowReset
		local rushWasPending     = self._T.rushOnCooldown == true
		local teleportWasPending = self._T.teleportOnCooldown == true

		-- ① 타임스탬프형 쿨타임: 0으로 지운다.
		self._T.dashCooldownUntil = 0
		self._T.doubleJumpCooldownUntil = 0
		self._T.chainShotCooldownUntil = 0
		self._T.archerSupportCooldownUntil = 0
		self._T.shiningRayCooldownUntil = 0
		self._T.restorationCooldownUntil = 0
		self._T.flashCooldownUntil = 0
		self._T.guardCooldownUntil = 0
		self._T.parryCooldownUntil = 0
		self._T.chargeBlowCooldownUntil = 0
		self._T.dragonRideCooldownUntil = 0
		self._T.darkDragonCooldownUntil = 0
		self._T.bahamutCooldownUntil = 0
		self._T.holyShellCooldownUntil = 0
		self._T.sixDragonsCooldownUntil = 0
		self._T.healerSummonCooldownUntil = 0
		self._T.darkSightCooldownUntil = 0
		self._T.awakeningCooldownUntil = 0
		self._T.drainShotCooldownUntil = 0
		-- (연막 개편 2026-08-06) 쿨타임이 20초 → 3분이 되면서 오로라 초기화 대상에 넣는다.
		self._T.smokeScreenCooldownUntil = 0
		-- (분신 2026-08-06) 위치 교환 쿨타임(5초)도 함께 지운다.
		self._T.shadowCloneSwapUntil = 0
		-- (속성 전환 2026-08-15) 직전 속성에 걸린 20초 재사용 대기도 함께 푼다.
		self:ClearChargeBlowModeCooldowns()

		-- ② 플래그형 쿨타임: 세대 번호를 올려 예약된 해제 타이머를 무효화하고 곧바로 푼다.
		self._T.blizzardCdGen = (self._T.blizzardCdGen or 0) + 1
		self._T.blizzardOnCooldown = false
		self._T.meteorCdGen = (self._T.meteorCdGen or 0) + 1
		self._T.meteorOnCooldown = false
		self._T.genesisCdGen = (self._T.genesisCdGen or 0) + 1
		self._T.genesisOnCooldown = false
		self._T.rushCdGen = (self._T.rushCdGen or 0) + 1
		self._T.rushOnCooldown = false
		self._T.teleportCdGen = (self._T.teleportCdGen or 0) + 1
		self._T.teleportOnCooldown = false

		-- ③ 퀵슬롯 쿨타임 표시 제거. 각 UI의 ResetCooldown은 표시 중일 때만 반응하므로,
		--    돌고 있지 않던 UI를 호출해도 아무 일도 일어나지 않는다.
		_DashCooldownUI:ResetCooldown()
		_DoubleJumpCooldownUI:ResetCooldown()
		_ChainShotCooldownUI:ResetCooldown()
		_ArcherSupportCooldownUI:ResetCooldown()
		_ShiningRayCooldownUI:ResetCooldown()
		_RestorationCooldownUI:ResetCooldown()
		_FlashCooldownUI:ResetCooldown()
		_GuardCooldownUI:ResetCooldown()
		_ParryCooldownUI:ResetCooldown()
		_ChargeBlowCooldownUI:ResetCooldown()
		_DragonRidingCooldownUI:ResetCooldown()
		_DarkDragonCooldownUI:ResetCooldown()
		_HolyMagicShellCooldownUI:ResetCooldown()
		_SixDragonsCooldownUI:ResetCooldown()
		_HealerSummonCooldownUI:ResetCooldown()
		_DarkSightCooldownUI:ResetCooldown()
		_AwakeningCooldownUI:ResetCooldown()
		_DrainShotCooldownUI:ResetCooldown()
		_SmokeScreenCooldownUI:ResetCooldown()
		_ShadowCloneSwapCooldownUI:ResetCooldown()
		_BlizzardCooldownUI:ResetCooldown()
		_MeteorCooldownUI:ResetCooldown()
		_GenesisCooldownUI:ResetCooldown()
		-- (비숍 개편 2026-08-08) 새로 쿨타임이 생긴 두 스킬도 오로라 안에서 함께 초기화된다.
		_MagicMissileCooldownUI:ResetCooldown()
		_ResurrectionCooldownUI:ResetCooldown()

		-- ④ 전용 쿨타임 UI가 없는 5종은 여기서 직접 퀵슬롯을 2번 깜빡인다(위 UI 조들과 같은 연출).
		if bahamutWasPending  then self:BlinkSkillReadyByName("바하뮤트") end
		if rushWasPending     then self:BlinkSkillReadyByName("돌진") end
		if teleportWasPending then self:BlinkSkillReadyByName("텔레포트") end

		log("[SkillManager] 리커버리 오로라 진입 - 남아있던 쿨타임 전부 초기화")
	end

	@ExecSpace("ClientOnly")
	method void BlinkSkillReadyByName(string skillName)
		-- 스킬 이름으로 배정된 퀵슬롯 위치를 찾아 "재사용 가능" 2회 깜빡임을 낸다.
		-- 전용 쿨타임 UI가 없어 스스로 깜빡일 수단이 없는 스킬들이 쓴다. 배정돼 있지 않으면 아무 일도 없다.
		local pos = self:FindBarPosForSkillName(skillName)
		if pos ~= "" then
			self:BlinkSlotReady(pos)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsInRecoveryAura()
		-- 내 캐릭터가 살아있는 리커버리 오로라 범위(가로 ±3.0 / 세로 ±2.5) 안에 있는지 판정한다.
		-- 각 스킬의 쿨타임 게이트가 이 값으로 쿨타임 확인을 우회한다 - 쿨타임 타임스탬프 자체는 평소처럼
		-- 기록되므로, 오로라를 벗어나면 남아있는 쿨타임이 다시 그대로 적용된다.
		local auras = self._T.recoveryAuras
		if auras == nil or #auras == 0 then return false end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return false end
		local wp = player.TransformComponent.WorldPosition
		local now = _UtilLogic.ElapsedSeconds
		for i = #auras, 1, -1 do
			local aura = auras[i]
			if aura.expireAt <= now then
				table.remove(auras, i)
			elseif math.abs(wp.x - aura.x) <= 3.0 and math.abs(wp.y - aura.y) <= 2.5 then
				return true
			end
		end
		return false
	end

	-- ── (썬콜 자동사냥 2026-08-08) AutoHuntManager 전용 조회 ──────────────────
	-- 자동사냥이 "지금 눌러서 나가는가"를 시전 전에 알아야 헛클릭(쿨타임 로그만 쌓임)이 없다.

	@ExecSpace("ClientOnly")
	method boolean IsBlizzardReady()
		-- 블리자드 전용 쿨타임(20초) 기준. 리커버리 오로라 안에서는 쿨타임이 면제되므로 항상 참.
		return self._T.blizzardOnCooldown ~= true or self:IsInRecoveryAura()
	end

	@ExecSpace("ClientOnly")
	method boolean IsMagicMissileReady()
		-- 매직 미사일 전용 쿨타임(5초) 기준. 오로라 안에서는 면제.
		return (self._T.magicMissileCooldownUntil or 0) <= _UtilLogic.ElapsedSeconds or self:IsInRecoveryAura()
	end

	@ExecSpace("ClientOnly")
	method boolean IsMeteorReady()
		-- 메테오 전용 쿨타임(120초 - 분배당 1초) 기준. 오로라 안에서는 면제(블리자드와 동일 - 불독 자동사냥용).
		return self._T.meteorOnCooldown ~= true or self:IsInRecoveryAura()
	end

	@ExecSpace("ClientOnly")
	method boolean CanAutoCastRecoveryAura()
		-- 리커버리 오로라 자신의 재사용 대기시간이 끝났는가(오로라는 자기 쿨타임을 스스로 못 돌린다).
		return (self._T.recoveryAuraCooldownUntil or 0) <= _UtilLogic.ElapsedSeconds
	end

	@ExecSpace("ClientOnly")
	method boolean HasActiveRecoveryAura()
		-- 살아있는 오로라가 하나라도 있는가. 위치는 GetRecoveryAuraX/Y로 읽는다(가장 최근 것).
		local auras = self._T.recoveryAuras
		if auras == nil then return false end
		local now = _UtilLogic.ElapsedSeconds
		for i = #auras, 1, -1 do
			if auras[i].expireAt > now then return true end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method number GetRecoveryAuraX()
		-- 가장 최근에 깔린 살아있는 오로라의 x. 없으면 0(HasActiveRecoveryAura로 먼저 확인할 것).
		local auras = self._T.recoveryAuras
		local now = _UtilLogic.ElapsedSeconds
		if auras ~= nil then
			for i = #auras, 1, -1 do
				if auras[i].expireAt > now then return auras[i].x end
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method number GetRecoveryAuraY()
		-- 가장 최근에 깔린 살아있는 오로라의 y. 없으면 0.
		local auras = self._T.recoveryAuras
		local now = _UtilLogic.ElapsedSeconds
		if auras ~= nil then
			for i = #auras, 1, -1 do
				if auras[i].expireAt > now then return auras[i].y end
			end
		end
		return 0
	end

	@ExecSpace("Server")
	method void RequestFireSpearBurst(number combatPower, number atkMultiplier, boolean enhanced, number multMin, number multMax, integer targetCount)
		-- (스펙 개편) multMin/multMax = 줄당 데미지 배율 범위(1.0 = 100%), targetCount = 동시 타격 수.
		-- 셋 다 클라(투자 레벨)가 계산해 넘긴다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireSpearBurst: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireSpearBurst: PlayerAttack component not found")
			return
		end
		pa:AttackSpearBurst(combatPower, atkMultiplier, enhanced, multMin, multMax, targetCount)
		log("[SkillManager] 스피어 버스터 발동! combatPower=" .. tostring(combatPower) .. " enhanced=" .. tostring(enhanced)
			.. " 배율=" .. tostring(multMin) .. "~" .. tostring(multMax) .. " 대상=" .. tostring(targetCount))
	end

	@ExecSpace("ClientOnly")
	method void ToggleWindow()
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if not isvalid(w) then return end
		w.Enable = not w.Enable
		if not w.Enable then
			self:HideSkillTooltip()
			self:ClearSkillSelection()
		end
		log("[SkillManager] 스킬창 " .. (w.Enable and "열림" or "닫힘"))
	end

	-- ScreenTouchEvent로 탭/스킬행 클릭 감지 (UITouchDownEvent 대체)
	@ExecSpace("ClientOnly")
	method void OnSkillWindowTouch(ScreenTouchEvent e)
		if e.TouchId ~= 1 then return end
		local win = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if not isvalid(win) or not win.Enable then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/SkillWindow", e.TouchPoint) then return end
		local tp = e.TouchPoint
		local tux = tp.x - 960
		local tuy = tp.y - 540
		-- 단축키 세팅 창이 위에 겹쳐 있으면 그 영역의 클릭은 키세팅이 전담한다
		if _KeySettingManager:IsPointInWindow(tux, tuy) then return end
		local wp = win.UITransformComponent.anchoredPosition
		local lx = tux - wp.x
		local ly = tuy - wp.y

		-- 탭 클릭 체크 (탭 중앙 y=210, 폭 62·피치 66) - 원작 스타일 8탭(기본/I/II/III/IV/H/V/VI)
		for k = 0, 7 do
			local tx = -231 + 66 * k
			if math.abs(lx - tx) <= 31 and math.abs(ly - 210) <= 14 then
				local tid = tostring(k)
				log("[SkillManager] 탭클릭: " .. tid)
				self:SwitchSkillTab(tid)
				return
			end
		end

		-- "+"(분배)/"-"(회수) 버튼 체크 - 카드 클릭보다 **먼저** 본다.
		-- 버튼이 카드 위에 겹쳐 있어서, 카드 판정이 앞서면 +를 눌러도 카드 드래그가 시작돼 버린다.
		-- (요청) Shift를 누른 채 클릭하면 한 번에 가능한 만큼 전부 분배/회수한다.
		for i = 1, 10 do
			local col = (i - 1) % 2
			local row = math.floor((i - 1) / 2)
			local px = ((col == 0) and -132 or 132) + 112
			local py = (126 - 72 * row) - 14
			local plusBG = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillCard" .. i .. "/PlusBG")
			if isvalid(plusBG) and plusBG.Enable then
				if math.abs(lx - px) <= 11 and math.abs(ly - py) <= 11 then
					-- 뗄 때까지 한 번만 먹는다(같은 누름에서 이벤트가 여러 번 들어와도 1포인트).
					if not self._T.plusConsumed then
						self._T.plusConsumed = true
						self:SpendSkillPointOnCard(i)
					end
					return
				end
			end
			local minusBG = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillCard" .. i .. "/MinusBG")
			if isvalid(minusBG) and minusBG.Enable then
				if math.abs(lx - (px - 26)) <= 11 and math.abs(ly - py) <= 11 then
					if not self._T.plusConsumed then
						self._T.plusConsumed = true
						self:RefundSkillPointOnCard(i)
					end
					return
				end
			end
		end

		-- 스킬 카드 클릭 체크 (2열×5행, 카드 254×64, 좌측 x=-132/우측 x=+132, y=126에서 72씩 하강)
		for i = 1, 10 do
			local col = (i - 1) % 2
			local row = math.floor((i - 1) / 2)
			local cx = (col == 0) and -132 or 132
			local cy = 126 - 72 * row
			if math.abs(lx - cx) <= 127 and math.abs(ly - cy) <= 32 then
				log("[SkillManager] 카드클릭: " .. i)
				self:OnSkillRowDragStart(i)
				return
			end
		end
	end

	-- 손을 뗐다 = 다음 누름에서 "+"를 다시 한 번 먹을 수 있다.
	-- (시간 디바운스가 아니라 엣지 방식이라 연타 속도는 그대로다.)
	@ExecSpace("ClientOnly")
	method void OnSkillWindowTouchRelease(ScreenTouchReleaseEvent e)
		self._T.plusConsumed = false
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClick(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/SkillWindow", e.TouchPoint) then return end
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if isvalid(w) then w.Enable = false end
		self:HideSkillTooltip()
		self:ClearSkillSelection()
		log("[SkillManager] 닫기")
	end

	@ExecSpace("ClientOnly")
	method void OnTitleBarDown(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/SkillWindow", e.TouchPoint) then return end
		self:StartDrag()
	end

	@ExecSpace("ClientOnly")
	method void StartDrag()
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if not isvalid(w) then return end
		self._T.isDragging = true
		local cursor = _InputService:GetCursorPosition()
		local cursorUI = Vector2(cursor.x - 960, cursor.y - 540)
		local winPos = w.UITransformComponent.anchoredPosition
		self._T.dragOffsetX = cursorUI.x - winPos.x
		self._T.dragOffsetY = cursorUI.y - winPos.y
		self:BringWindowToFront()
	end

	@ExecSpace("ClientOnly")
	method void BringWindowToFront()
		local paths = {
			"/ui/DefaultGroup/InvenWindow",
			"/ui/DefaultGroup/EquipWindow",
			"/ui/DefaultGroup/EnhanceWindow",
			"/ui/DefaultGroup/SkillWindow",
			"/ui/DefaultGroup/KeySettingWindow",
			"/ui/DefaultGroup/BattleStatsWindow"
		}
		local maxIdx = 0
		for _, p in ipairs(paths) do
			local e = _EntityService:GetEntityByPath(p)
			if isvalid(e) then
				local idx = _UILogic:GetSiblingIndex(e.UITransformComponent)
				if idx > maxIdx then maxIdx = idx end
			end
		end
		local target = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if isvalid(target) then
			_UILogic:SetSiblingIndex(target.UITransformComponent, maxIdx)
		end
	end

	-- ── SkillBar 드래그 ────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnBarSlotAssign(string pos)
		-- 클릭 배정 모드에서 퀵슬롯 슬롯을 클릭했을 때: 집은 스킬을 이 슬롯 키에 놓는다.
		-- 자리에 이미 다른 스킬/기능이 있으면 밀려난 쪽을 곧바로 집어 계속 옮길 수 있다
		-- (키세팅 창 키 타일의 스왑과 동일한 UX).
		if not self._T.skillClickMode then return end
		local barKey = self:GetKeyForBarPos(pos)
		local fid = _KeySettingManager:GetFuncOnKey(barKey)
		if fid ~= "" then
			-- 기능이 있는 슬롯: 스킬을 놓고 밀려난 기능을 곧바로 집는다
			local carriedRuid = self._T.clickModeRUID
			local carriedName = self._T.clickModeName
			_KeySettingManager:TakeFuncOffKey(fid)
			self:AssignSkillToSlot(barKey, carriedRuid, carriedName)
			_KeySettingManager:PickUpFunc(fid, "")
			log("[SkillManager] 슬롯 [" .. barKey .. "] 스왑 - 스킬 놓고 기능 " .. fid .. " 집음")
			return
		end
		local old = self._T.slotData[barKey]
		local oldRuid = (old ~= nil) and (old.ruid or "") or ""
		local oldName = (old ~= nil) and (old.name or "") or ""
		local newRuid = self._T.clickModeRUID
		local newName = self._T.clickModeName
		self:AssignSkillToSlot(barKey, newRuid, newName)
		if oldRuid ~= "" and oldRuid ~= newRuid then
			self:EnterClickMode(oldRuid, oldName, "bar")
			self._T.clickModeFromKey = barKey
			log("[SkillManager] 슬롯 [" .. barKey .. "] 스왑 - " .. oldName .. " 집음")
		else
			self:ClearSkillSelection()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnBarSlotPickUp(string pos)
		-- 퀵슬롯 스킬을 클릭-클릭으로 집는다 (홀드 드래그 불필요 - 다음 클릭에서 놓는다).
		-- 다른 슬롯/키 타일 클릭 → 그곳에 배정, 빈 곳 클릭 → 퀵슬롯에서 제거, Esc → 원래 슬롯 복귀.
		-- pos = 퀵슬롯 위치 접미사. 실제 키는 barKeys로 조회한다.
		local key = self:GetKeyForBarPos(pos)
		local slot = self._T.slotData[key]
		if slot == nil or slot.ruid == "" then return end
		self._T.slotData[key] = { ruid = "", name = "" }
		self:UpdateBarSlotVisual(pos)
		_KeySettingManager:NotifyHotkeysChanged()
		self:EnterClickMode(slot.ruid, slot.name, "bar")
		self._T.clickModeFromKey = key
		log("[SkillManager] 퀵슬롯 [" .. key .. "] " .. slot.name .. " 집음 (클릭 배정)")
		-- 슬롯에서 스킬을 떼어내는 것도 단축키 변경이므로 저장 예약
		_CharacterPersistence:MarkDirty("hotkey")
		-- 어썰터를 슬롯에서 떼어냈다면 스택 수 표시를 숨기거나 갱신한다.
		self:UpdateAssaulterStackUI()
	end

	@ExecSpace("ClientOnly")
	method void ShowDragGhost(string ruid)
		local ghost = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillDragGhost")
		if not isvalid(ghost) then return end
		local spr = ghost.SpriteGUIRendererComponent
		spr.ImageRUID = ruid
		spr.Color = Color(1, 1, 1, 1)
		-- 기능 고스트(KeySettingManager)와 엔티티를 공유하므로 기능 라벨을 지운다
		local labelEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillDragGhost/Label")
		if isvalid(labelEnt) then labelEnt.TextComponent.Text = "" end
		local cursor = _InputService:GetCursorPosition()
		ghost.UITransformComponent.anchoredPosition = Vector2(cursor.x - 960, cursor.y - 540)
		ghost.Enable = true
		self:BringGhostToFront()
	end

	@ExecSpace("ClientOnly")
	method void BringGhostToFront()
		-- 고스트는 항상 최상단에 - 키세팅 창 등 나중에 만들어진 창이 고스트를 가리지 않게 한다.
		-- (BringWindowToFront와 동일하게 형제들 중 최대 인덱스로 이동)
		local ghost = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillDragGhost")
		if not isvalid(ghost) then return end
		local dg = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(dg) then
			local maxIdx = 0
			for _, child in ipairs(dg.Children:ToTable()) do
				if isvalid(child) then
					local idx = _UILogic:GetSiblingIndex(child.UITransformComponent)
					if idx > maxIdx then maxIdx = idx end
				end
			end
			_UILogic:SetSiblingIndex(ghost.UITransformComponent, maxIdx)
		end
	end

	@ExecSpace("ClientOnly")
	method void HideSkillTooltip()
		-- 좌표 폴링 호버 시그니처도 함께 초기화 - 외부(드래그 시작 등)에서 내려도 다음 폴링이 다시 판정한다.
		self._T.hoverSig = nil
		local tp = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel")
		if isvalid(tp) then tp.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void ClearSkillSelection()
		self._T.skillClickMode = false
		self._T.clickModeRUID  = ""
		self._T.clickModeName  = ""
		self._T.clickModeOrigin = ""
		self._T.clickModeFromKey = ""
		local ghost = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillDragGhost")
		if isvalid(ghost) then ghost.Enable = false end
		log("[SkillManager] 클릭 배정 모드 해제")
	end

	-- 좌표 폴링 호버 판정 - 스킬창이 열려 있는 동안 매 폴링마다 커서가 "+"/"-" 버튼 또는 스킬 카드
	-- 위에 있는지 확인해 해당 툴팁을 띄우고, 벗어나면 내린다. (클릭 판정과 동일한 좌표 체계)
	@ExecSpace("ClientOnly")
	method void UpdateSkillHover(number ux, number uy)
		local win = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		local shown = self._T.hoverSig ~= nil
		if not isvalid(win) or not win.Enable
			or self._T.isDraggingSkill or self._T.isDragging or self._T.skillClickMode then
			if shown then
				self._T.hoverSig = nil
				self:HideSkillTooltip()
			end
			return
		end
		-- 다른 창이 이 지점 위에 겹쳐 있으면 호버 없음
		if not _UIClickArbiter:IsTopmostAt("/ui/DefaultGroup/SkillWindow", Vector2(ux + 960, uy + 540)) then
			if shown then
				self._T.hoverSig = nil
				self:HideSkillTooltip()
			end
			return
		end
		local wp = win.UITransformComponent.anchoredPosition
		local lx = ux - wp.x
		local ly = uy - wp.y
		local kind = nil
		local rowIdx = 0
		for i = 1, 10 do
			local col = (i - 1) % 2
			local row = math.floor((i - 1) / 2)
			local cx = (col == 0) and -132 or 132
			local cy = 126 - 72 * row
			local px = cx + 112
			local py = cy - 14
			local plusBG = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillCard" .. i .. "/PlusBG")
			local minusBG = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillCard" .. i .. "/MinusBG")
			if isvalid(plusBG) and plusBG.Enable and math.abs(lx - px) <= 11 and math.abs(ly - py) <= 11 then
				kind = "plus"
				rowIdx = i
				break
			elseif isvalid(minusBG) and minusBG.Enable and math.abs(lx - (px - 26)) <= 11 and math.abs(ly - py) <= 11 then
				kind = "minus"
				rowIdx = i
				break
			elseif math.abs(lx - cx) <= 127 and math.abs(ly - cy) <= 32 then
				kind = "card"
				rowIdx = i
				break
			end
		end
		if kind == nil then
			if shown then
				self._T.hoverSig = nil
				self:HideSkillTooltip()
			end
			return
		end
		-- 같은 대상 위에 머무는 동안은 재렌더하지 않는다 (탭/스크롤이 바뀌면 시그니처가 달라져 갱신됨)
		local sig = kind .. ":" .. tostring(rowIdx) .. ":" .. tostring(self._T.activeSkillTab) .. ":" .. tostring(self._T.skillScrollRow)
		if self._T.hoverSig == sig then return end
		if kind == "card" then
			local dataIdx = self._T.skillScrollRow * 2 + rowIdx
			local skill = self:GetTabSkills(self._T.activeSkillTab)[dataIdx]
			if skill == nil then
				if shown then
					self._T.hoverSig = nil
					self:HideSkillTooltip()
				end
				return
			end
			self._T.hoverSig = sig
			self._T.hoverTabId = self._T.activeSkillTab
			self._T.hoverDataIdx = dataIdx
			self._T.hoverRowIdx = rowIdx
			self:ShowSkillTooltip()
		else
			self._T.hoverSig = sig
			self:ShowSkillButtonHint(kind, rowIdx)
		end
	end

	-- "+"/"-" 버튼 전용 미니 툴팁 - 조작법 안내 (아이템 설명창과 같은 패널 재사용).
	@ExecSpace("ClientOnly")
	method void ShowSkillButtonHint(string kind, integer rowIdx)
		local tp = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel")
		if not isvalid(tp) then return end
		-- 위치: 카드 툴팁과 동일 규칙 (해당 카드 행 기준, 창 오른쪽 - 밖으로 나가면 왼쪽)
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if isvalid(w) then
			local winPos = w.UITransformComponent.anchoredPosition
			local cardRow = math.floor((rowIdx - 1) / 2)
			local rowCenterY = 126 - cardRow * 72
			local ty = winPos.y + rowCenterY
			local tx = winPos.x + 395
			if tx + 110 > 940 then tx = winPos.x - 395 end
			tp.UITransformComponent.anchoredPosition = Vector2(tx, ty)
		end
		local tipIcon = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Icon")
		if isvalid(tipIcon) then
			tipIcon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)   -- 버튼 힌트에는 아이콘 없음
		end
		local tipTitle = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Title")
		if isvalid(tipTitle) then
			tipTitle.TextComponent.Text = (kind == "plus") and "포인트 분배" or "포인트 회수"
		end
		local hintBody = ""
		if kind == "plus" then
			hintBody = "좌클릭 : 1포인트 분배\nShift+좌클릭 : 최대 분배"
		else
			hintBody = "좌클릭 : 1포인트 회수\nShift+좌클릭 : 전부 회수"
		end
		self:LayoutSkillTooltip(hintBody, "")
		tp.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void ShowSkillTooltip()
		local tp = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel")
		if not isvalid(tp) then return end
		local tabSkills = self:GetTabSkills(self._T.hoverTabId)
		local skill     = tabSkills[self._T.hoverDataIdx]
		if skill == nil then return end

		-- 툴팁 위치: 스킬창 오른쪽 (창 밖으로 나가면 왼쪽)
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
		if isvalid(w) then
			local winPos = w.UITransformComponent.anchoredPosition
			-- 카드 그리드(2열×5행): 카드 행 중심 Y = 126 - 행번호*72
			local cardRow = math.floor((self._T.hoverRowIdx - 1) / 2)
			local rowCenterY = 126 - cardRow * 72
			local ty = winPos.y + rowCenterY
			local tx = winPos.x + 395
			if tx + 110 > 940 then tx = winPos.x - 395 end
			tp.UITransformComponent.anchoredPosition = Vector2(tx, ty)
		end

		-- 툴팁 내용
		local tipIcon = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Icon")
		if isvalid(tipIcon) then
			tipIcon.SpriteGUIRendererComponent.ImageRUID = skill.ruid
			tipIcon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
		local tipTitle = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Title")
		if isvalid(tipTitle) then tipTitle.TextComponent.Text = skill.name end
		-- (요청) 원작식 툴팁 구성: 제목 상단 → 아이콘 좌측 + [마스터 레벨]·설명이 아이콘 **우측** →
		-- 하단 전체 폭에 [현재 레벨 N] 효과 + 미마스터 시 [다음 레벨 N+1] 효과.
		self:LoadHeroSkillTable()
		local master = math.max(1, math.floor(tonumber(self._T.heroSkillMaster[skill.name]) or tonumber(skill.maxLevel) or 20))
		local upper = ""
		if skill.spendable == true then
			upper = "[마스터 레벨 : " .. tostring(master) .. "]\n"
		end
		upper = upper .. (skill.desc or "")
		local lower = ""
		if skill.spendable == true then
			local lv = math.floor(tonumber(skill.level) or 0)
			lower = "[현재 레벨 " .. tostring(lv) .. "]\n" .. self:GetSkillLevelEffectText(skill.name, lv, master)
			if lv < master then
				lower = lower .. "\n[다음 레벨 " .. tostring(lv + 1) .. "]\n" .. self:GetSkillLevelEffectText(skill.name, lv + 1, master)
			end
		end
		self:LayoutSkillTooltip(upper, lower)

		tp.Enable = true
	end

	-- 텍스트 블록의 (줄 수, 최장 줄 픽셀 폭) 추정 - 한글 등 멀티바이트 ≈ 13px, ASCII ≈ 7px @ FontSize 13
	@ExecSpace("ClientOnly")
	method table MeasureTooltipText(string body)
		local lines = 0
		local maxLineW = 0
		for line in string.gmatch(body .. "\n", "([^\n]*)\n") do
			lines = lines + 1
			local w = 0
			for ci = 1, string.len(line) do
				local byte = string.byte(line, ci)
				if byte < 0x80 then
					w = w + 7
				elseif byte >= 0xC0 then
					w = w + 13
				end
			end
			if w > maxLineW then maxLineW = w end
		end
		if lines < 1 then lines = 1 end
		return { lines = lines, maxW = maxLineW }
	end

	-- 툴팁 패널 레이아웃 (원작식·가로 폭 통일) - 제목 상단 전체 폭 → 아이콘 좌측 + 상단 본문(upper)이
	-- 아이콘 **우측** → 하단 본문(lower, [현재/다음 레벨])은 전체 폭. 높이는 내용에 맞춰 늘어난다.
	-- ⚠ 자식들은 전부 "상단 앵커 + 상단 피벗"(y=1) - y좌표는 패널 윗변에서 아래로 음수.
	@ExecSpace("ClientOnly")
	method void LayoutSkillTooltip(string upper, string lower)
		local tp = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel")
		if not isvalid(tp) then return end
		local W = 360      -- (요청) 모든 스킬 공통 고정 폭
		local up = self:MeasureTooltipText(upper)
		local upperH = up.lines * 19 + 4
		local headerH = math.max(60, upperH)   -- 아이콘(48+여백) vs 상단 본문 중 큰 쪽
		local lowerH = 0
		if lower ~= "" then
			local lo = self:MeasureTooltipText(lower)
			lowerH = lo.lines * 19 + 6
		end
		local H = 36 + headerH + (lower ~= "" and (10 + lowerH) or 0) + 14
		tp.UITransformComponent.RectSize = Vector2(W, H)
		-- 제목: 상단 전체 폭 (중앙 정렬)
		local title = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Title")
		if isvalid(title) then
			title.UITransformComponent.anchoredPosition = Vector2(0, -6)
			title.UITransformComponent.RectSize = Vector2(W - 24, 26)
			title.TextComponent.Alignment = 4     -- MiddleCenter
		end
		-- 아이콘: 제목 아래 좌측
		local icon = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Icon")
		if isvalid(icon) then
			icon.UITransformComponent.anchoredPosition = Vector2(-W / 2 + 38, -40)
		end
		-- 상단 본문: 아이콘 우측 (좌상단 정렬)
		local info = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Info")
		if isvalid(info) then
			local textW = W - 90 - 14              -- 좌측 아이콘 영역 90 + 우측 여백
			info.UITransformComponent.RectSize = Vector2(textW, upperH)
			info.UITransformComponent.anchoredPosition = Vector2((90 - 14) / 2, -40)
			info.TextComponent.Alignment = 0       -- UpperLeft
			info.TextComponent.Text = upper
		end
		-- 하단 본문: 전체 폭 (좌상단 정렬)
		local info2 = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillTooltipPanel/Info2")
		if isvalid(info2) then
			info2.UITransformComponent.RectSize = Vector2(W - 24, math.max(1, lowerH))
			info2.UITransformComponent.anchoredPosition = Vector2(0, -(36 + headerH + 10))
			info2.TextComponent.Alignment = 0
			info2.TextComponent.Text = lower
			info2.Enable = (lower ~= "")
		end
		-- (요청) 툴팁이 스킬창 등 다른 UI에 가려지지 않게 항상 최상위로 올린다
		_UILogic:SetSiblingIndex(tp.UITransformComponent, 9999)
		-- 패널이 화면 밖으로 나가지 않게 상하좌우 클램프
		local pos = tp.UITransformComponent.anchoredPosition
		local minY = -540 + H / 2 + 10
		local maxY = 540 - H / 2 - 10
		local minX = -960 + W / 2 + 10
		local maxX = 960 - W / 2 - 10
		local ny = pos.y
		local nx = pos.x
		if ny < minY then ny = minY elseif ny > maxY then ny = maxY end
		if nx < minX then nx = minX elseif nx > maxX then nx = maxX end
		if ny ~= pos.y or nx ~= pos.x then
			tp.UITransformComponent.anchoredPosition = Vector2(nx, ny)
		end
	end

	-- (요청) 기본공격 홀드 연사 - 공격 키(기능 "attack", 기본 Ctrl)를 누르고 있는 동안 0.45초 간격으로
	-- 기본공격을 반복한다. 첫 누름은 기존 경로(엔진/아대 키다운)가 처리하고, 여기서는 반복만 얹는다.
	@ExecSpace("ClientOnly")
	method void BasicAttackHoldTick()
		if _KeySettingManager:IsCapturingKey() then return end
		if not _KeySettingManager:IsFuncKeyPressed("attack") then
			self._T.basicAtkHolding = false
			return
		end
		local now = _UtilLogic.ElapsedSeconds
		if self._T.basicAtkHolding ~= true then
			-- 상승 엣지: 이번 프레임의 첫 공격은 기존 키다운 경로가 이미 처리했다 - 반복 예약만 건다.
			self._T.basicAtkHolding = true
			self._T.nextBasicAtk = now + 0.45
			return
		end
		if (self._T.nextBasicAtk or 0) > now then return end
		self._T.nextBasicAtk = now + 0.45
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "DEAD" or sc.CurrentStateName == "CLIMB" or sc.CurrentStateName == "LADDER") then return end
		if (self._T.actionLockUntil or 0) > now then return end
		if self:IsClawEquipped() then
			---@type PlayerAttack
			local pa = player:GetComponent(PlayerAttack)
			if isvalid(pa) then pa:CastClawBasicAttack() end
			self:BreakDarkSightByAttack()
		elseif self:IsArcherJob() then
			-- (요청 2026-08-13) 활 기본공격은 엔진 ActionAttack을 **부르지 않는다** - 부르면 엔진이
			-- 자기 ATTACK 상태로 무기 휘두르기를 재생해 활 모션과 섞인다(아대 기본공격과 같은 이유).
			self:DoArcherBasicAttack()
			self:BreakDarkSightByAttack()
		else
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) and pcc.Enable then
				pcc:ActionAttack()
				self:BreakDarkSightByAttack()
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsArcherJob()
		-- 지금 캐릭터가 신궁(7)/보우마스터(8)인가. 직업 인덱스는 캐릭터 선택 슬롯 데이터에서 읽는
		-- 클라이언트 전용 값이라(GetSelectedCharacterJobIdx는 ClientOnly) 여기서만 판정할 수 있다.
		local j = math.floor(_UIMyInfoManager:GetSelectedCharacterJobIdx())
		return j == 7 or j == 8
	end

	@ExecSpace("ClientOnly")
	method void DoArcherBasicAttack()
		-- (요청 2026-08-13) 신궁·보우마스터 기본공격 = 더블샷 화살 1발(데미지 전투력의 1%~100%).
		-- 모션/컨트롤러 잠금은 PlayerAttack의 클라 시전부가 전부 처리하고, 여기서는 직업 인덱스와
		-- 공격속도 배율만 넘긴다(둘 다 클라 전용 값이라 서버가 직접 읽을 수 없다).
		-- ⚠ 전투력은 넘기지 않는다 - 활 기본공격도 근접 기본공격과 **같은 서버 동기화 전투력**
		--   (PlayerAttack.GetServerCombatPower)을 쓰므로 두 기본공격의 기준이 어긋나지 않는다.
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:CastArcherBasicAttack(_CharInfoManager:GetAttackSpeedMultiplier(),
			math.floor(_UIMyInfoManager:GetSelectedCharacterJobIdx()))
	end

	-- ── 히어로 스킬 효과 공식 (투자 레벨 기반) ─────────────────────────

	-- (요청) 스킬 포인트 미투자(spendable && level 0) 스킬은 사용/퀵슬롯 배정 불가.
	-- spendable이 아닌 스킬(기능·타직업 비투자형)은 항상 허용.
	@ExecSpace("ClientOnly")
	method boolean IsSkillUsableByInvestment(string skillName)
		-- (요청 개편 2026-08-04) 디바인 4종도 이제 투자해야 사용/배정 가능 - "찍은 속성만 쓸 수 있다".
		-- (기존의 "토글이라 미투자여도 허용" 예외를 제거. 차지 블로우의 속성 요구는 UseSkillInSlot의
		-- 차지 블로우 분기에서 GetEffectiveChargeBlowMode()==0으로 별도 판정한다.)
		local s = self:FindSkillByName(skillName)
		-- (버그 수정 2026-08-07) 카탈로그에 **없는 이름**은 쓸 수 없다고 본다.
		-- ⚠ 예전엔 여기서 true를 돌려줘서, 스킬을 개명·삭제하면 저장된 퀵슬롯에 옛 이름이
		--   **유령으로 영구히 남았다**(실측: "마크 오브 어쌔신" → "트레이닝" 개명 후 R칸에 잔존).
		--   눌러도 아무 일이 없고 아이콘도 깨진 채 남으므로, 복원(ImportHotkeys→AssignSkillToSlot)과
		--   정리(RemoveUninvestedSkillsFromBar) 양쪽에서 함께 걸러지도록 이 한 곳에서 막는다.
		if s == nil then return false end
		if s.spendable ~= true then return true end
		return math.floor(tonumber(s.level) or 0) >= 1
	end

	-- 퀵슬롯 전체를 훑어 미투자 spendable 스킬을 내린다 - 포인트 회수로 0이 됐을 때/투자 복원 직후 호출.
	@ExecSpace("ClientOnly")
	method void RemoveUninvestedSkillsFromBar()
		-- 미투자(0pt) 스킬 + 패시브 스킬을 퀵슬롯에서 내린다 (로그인 복원 직후/포인트 회수 시 호출).
		local removed = false
		for key, slot in pairs(self._T.slotData) do
			if slot ~= nil and slot.name ~= nil and slot.name ~= "" then
				if not self:IsSkillUsableByInvestment(slot.name) then
					log("[SkillManager] 퀵슬롯 [" .. tostring(key) .. "] " .. tostring(slot.name) .. " 제거(스킬 포인트 0)")
					self._T.slotData[key] = { ruid = "", name = "" }
					removed = true
				elseif self:IsPassiveSkillName(slot.name) then
					log("[SkillManager] 퀵슬롯 [" .. tostring(key) .. "] " .. tostring(slot.name) .. " 제거(패시브)")
					self._T.slotData[key] = { ruid = "", name = "" }
					removed = true
				end
			end
		end
		if removed then
			self:InitBarIcons()
			_KeySettingManager:NotifyHotkeysChanged()
			_CharacterPersistence:MarkDirty("hotkey")
		end
	end

	-- (요청) 패시브 스킬: 보유만으로 항상 적용 - 퀵슬롯 배정/사용이 모두 불가.
	-- (요청 2026-08-07) 옛 마크 오브 어쌔신 1차 토글은 **트레이닝**(순수 공격력 패시브)으로 바뀌면서
	-- 1차·3차 둘 다 패시브가 됐다 - 시전할 것이 없으므로 퀵슬롯에 올릴 수 없다.
	@ExecSpace("ClientOnly")
	method boolean IsPassiveSkillName(string skillName)
		-- (요청 2026-08-06) 백스탭도 토글 → 패시브. 배우기만 하면 항상 발동하고 퀵슬롯에 못 올린다.
		-- (요청 2026-08-06) 분신 강화 3종(2·3·4차)도 **1차 분신 소환을 강화하는 패시브**다 -
		-- 시전할 것이 없으므로 퀵슬롯에 올릴 수 없다(효과는 소환 시 자동 합산 - GetShadowClone* 헬퍼).
		-- (요청 2026-08-06) 에로우 블로우 강화도 토글 → 패시브. 1포인트라도 투자하면 데미지 상승과
		-- 폭발이 항상 적용되고 퀵슬롯에는 올릴 수 없다.
		-- (요청 2026-08-07) 파이널 어택:궁수도 전사 파이널어택과 같은 패시브다.
		return skillName == "속성 증폭" or skillName == "파이널어택" or skillName == "페이크"
			or skillName == "트레이닝" or skillName == "트레이닝 II" or skillName == "백스탭"
			or skillName == "분신 강화" or skillName == "분신 강화 II" or skillName == "분신 강화 III"
			or skillName == "에로우 블로우 강화" or skillName == "파이널 어택:궁수"
	end

	-- 소환 3종(용사/궁수/도적) 공용 시전 본체. 세 소환의 규격이 완전히 같아 한 곳에 모아뒀다.
	-- 반환값: 실제로 소환 요청을 보냈으면 true(연타 게이트에 막히면 false) - 호출부가 그때만
	-- 버프바 아이콘을 띄운다.
	-- ⚠ 수치를 바꿀 곳은 여기 한 곳이다. 세 소환 중 하나만 다르게 하려면 skillName으로 갈라야 한다.
	@ExecSpace("ClientOnly")
	method boolean DoHeroClassSummon(string skillName, string summonClass)
		-- 재사용 대기시간 없음 - 언제든 다시 쓰면 같은 계통의 기존 소환수를 없애고 새로 소환한다
		-- (교체는 서버 PlayerAttack.SummonHeroClass가 처리). 연타 오발동만 짧게(0.5초) 막는다.
		-- 게이트는 계통별로 따로 둔다 - 용사를 부른 직후 궁수를 부르는 것까지 막으면 안 된다.
		local now = _UtilLogic.ElapsedSeconds
		local gateKey = "heroSummonRecastGate_" .. tostring(summonClass)
		if (self._T[gateKey] or 0) > now then return false end
		self._T[gateKey] = now + 0.5
		-- 소환수 레벨 산정용 내 레벨 (장비 전투력 환산 - 이 프로젝트에서 "레벨"의 단일 진입점).
		local playerLevel = _CharInfoManager:GetDisplayLevel()
		-- 소환수 레벨 = 내 레벨의 N%(1레벨 50% → 2분배마다 +1%p).
		local hsLv = math.max(1, self:GetHeroSkillLevelByName(skillName))
		local hsPct = self:GetHeroSummonLevelPercent(hsLv)
		-- 전투력은 **레벨 곡선으로 환산**한다: 내 전투력 × (소환수 레벨 요구 CP / 내 레벨 요구 CP).
		-- 소환수 레벨이 내 레벨과 같으면 내 전투력과 같아지고, 낮으면 곡선만큼 자연스럽게 낮아진다
		-- (구 사양의 `레벨 × 10`은 레벨 곡선과 무관해 고레벨에서 실제 전투력의 1/900 수준이었다).
		local hsHeroLv = math.max(1, math.floor(playerLevel * hsPct / 100))
		local hsMyCp = _CharInfoManager:GetEquipCPForLevel(playerLevel)
		local hsHeroCurveCp = _CharInfoManager:GetEquipCPForLevel(hsHeroLv)
		local hsRatio = (hsMyCp > 0) and (hsHeroCurveCp / hsMyCp) or 1.0
		local hsCombatPower = math.max(1, math.floor(_CharInfoManager:CalcCombatPower() * hsRatio))
		self:RequestFireHeroSummonClass(playerLevel, hsPct, hsCombatPower, summonClass)
		log("[SkillManager] " .. skillName .. "! (Lv." .. tostring(hsLv) .. ", 계통 " .. tostring(summonClass)
			.. ", 지속 5분, 쿨타임 없음 - 재사용 시 교체, 내 레벨=" .. tostring(playerLevel)
			.. " → 소환수 레벨 " .. tostring(hsPct) .. "% = " .. tostring(hsHeroLv)
			.. ", 전투력 " .. tostring(hsCombatPower) .. " (내 전투력의 " .. tostring(math.floor(hsRatio * 100 + 0.5)) .. "%))")
		return true
	end

	@ExecSpace("ClientOnly")
	method integer GetHeroSkillLevelByName(string skillName)
		local s = self:FindSkillByName(skillName)
		if s == nil then return 0 end
		return math.floor(tonumber(s.level) or 0)
	end

	-- 부스터/분노/파워가드 공용 지속시간: Lv1 20초 → 9레벨까지 +10초/분배, 10레벨부터 +20초/분배 (마스터 20 = 310초)
	@ExecSpace("ClientOnly")
	method number GetHeroBuffDuration(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 20 + 10 * (math.min(lv, 10) - 1) + 20 * math.max(0, lv - 10)
	end

	-- 섬광 쿨타임: 10초 → 3초 (마스터 5, 분배당 -1.75초)
	@ExecSpace("ClientOnly")
	method number GetFlashCooldownForLevel(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 5)
		return 10 - 1.75 * (lv - 1)
	end

	-- 러시 쿨타임: 3초 → 1초 (마스터 15)
	@ExecSpace("ClientOnly")
	method number GetRushCooldownForLevel(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 15)
		return 3 - 2 * (lv - 1) / 14
	end

	-- 파이널어택 발동 확률: 5% → 50% (마스터 20)
	@ExecSpace("ClientOnly")
	method number GetFinalAttackChanceForLevel(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 5 + 45 * (lv - 1) / 19
	end

	-- ── 파이널 어택:궁수(신궁·보우마스터 2차, 2026-08-07 신설) ───────────────
	-- 전사 파이널어택(PlayerAttack.TryTriggerFinalAttack)의 궁수판. 다른 점은 "무엇을 한 번 더
	-- 하는가"뿐이다 - 전사는 파워스트라이크/슬래쉬블래스트 전용 Final 메서드를 따로 두지만,
	-- 궁수는 **직전에 쓴 그 활 스킬을 그대로 한 번 더** 시전한다(요청).
	-- 공통점(요청): 마스터 20 / 추가 데미지 15%~30% / 속도감 = 현재 공격속도 +4단계(×0.9^4).
	-- 차이점(요청 2026-08-07): **발동 확률은 분배 1포인트당 1%**(마스터 20%)로 전사(5%~50%)와 갈라졌다 -
	--               GetArcherFinalAttackChanceForLevel 참고.
	-- ⚠ 홀드 연사(속사·폭풍의 시)와 차지(스나이핑·피어싱), 이동기(체인샷)는 대상에서 뺐다 -
	--   "한 번 더"의 의미가 없거나 홀드 루프와 충돌한다.

	-- (요청 2026-08-07) **보우마스터는 활(shoot1) / 신궁은 석궁(shoot2)**이다.
	-- 클라에서 직접 자세를 재생하는 경로(폭풍의 시 연사 자세 / 스나이핑·피어싱 차지 자세)가 쓴다.
	-- 서버 시전 분기는 같은 규칙을 PlayerAttack.GetBowCastMotion에서 쓴다 - 두 곳이 어긋나면 안 된다.
	@ExecSpace("ClientOnly")
	method string GetLocalBowCastMotion()
		if math.floor(_UIMyInfoManager:GetSelectedCharacterJobIdx()) == 7 then return "shoot2" end
		return "shoot1"
	end

	-- 파이널 어택:궁수 발동 확률: **분배 1포인트당 1%** (1레벨 1% → 마스터 20에서 20%).
	-- ⚠ (요청 2026-08-07) 전사 파이널어택(5%~50%, GetFinalAttackChanceForLevel)과 **다른 곡선**이다 -
	--   처음엔 같은 헬퍼를 공유했는데 이제 갈라졌으니 한쪽만 고치고 다른 쪽을 따라 고치지 말 것.
	--   추가 데미지(15%~30%)와 마스터 레벨(20)은 여전히 전사와 같다.
	--   (같은 날 2%/pt로 넣었다가 1%/pt로 재조정 - 수치는 이 메서드 한 곳에만 있다.)
	@ExecSpace("ClientOnly")
	method number GetArcherFinalAttackChanceForLevel(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 1 * lv
	end

	@ExecSpace("ClientOnly")
	method boolean IsArcherFinalAttackSource(string skillName)
		-- 파이널 어택:궁수가 다시 쏴줄 수 있는 활 공격 스킬인가.
		return skillName == "더블샷" or skillName == "에로우 블로우" or skillName == "에로우 봄"
			or skillName == "아이언 에로우" or skillName == "스트레이프"
			or skillName == "아이스 샷" or skillName == "파이어 샷"
	end

	@ExecSpace("ClientOnly")
	method void TryArcherFinalAttack(string skillName, number atkMultiplier)
		-- 활 스킬 시전 직후 호출된다. 확률을 굴려 통과하면 같은 스킬을 한 번 더 예약한다.
		if not self:IsArcherFinalAttackSource(skillName) then return end
		local faLv = self:GetHeroSkillLevelByName("파이널 어택:궁수")
		if faLv < 1 then return end
		-- ⚠ 재시전이 또 파이널을 굴리면 무한 연쇄가 된다 - 재시전 중에는 절대 굴리지 않는다.
		if self._T.archerFinalInProgress == true then return end
		local chance = self:GetArcherFinalAttackChanceForLevel(faLv) / 100
		if _UtilLogic:RandomDouble() >= chance then return end

		-- 속도감은 전사와 동일: 현재 배율에 0.9^4를 곱해 "현재 단계 + 4단계"의 배율을 만든다.
		local finalMult = atkMultiplier * (0.9 ^ 4)
		-- 추가 데미지 15%~30%는 위력 배율에 곱해 넘긴다(전사 CalcDamage의 ".final" 분기와 같은 폭).
		local bonus = 1.15 + _UtilLogic:RandomDouble() * 0.15
		self._T.archerFinalInProgress = true
		-- 원본 시전의 발사 시점(0.2*배율)이 지난 뒤에 이어서 나가도록 살짝 미룬다.
		_TimerService:SetTimerOnce(function()
			self:CastArcherSkillAsFinal(skillName, finalMult, bonus)
		end, 0.25 * atkMultiplier)
		log("[SkillManager] 파이널 어택:궁수 발동! skill=" .. tostring(skillName)
			.. " Lv." .. tostring(faLv) .. " 확률=" .. string.format("%.0f", chance * 100)
			.. "% 배율=" .. string.format("%.2f", finalMult) .. " 보너스=" .. string.format("%.2f", bonus))
	end

	@ExecSpace("ClientOnly")
	method void CastArcherSkillAsFinal(string skillName, number atkMult, number bonus)
		-- 파이널 어택:궁수의 재시전 본체. UseSkillInSlot의 해당 분기와 **같은 RPC**를 부르되
		-- 쿨다운 예약은 하지 않는다(원본 시전이 이미 걸어뒀고, 이 발은 서버가 자체 발동시킨 것이다).
		-- 위력 배율은 원본과 같은 값에 파이널 보너스(15%~30%)를 곱해 예약한다 -
		-- GetEffectiveCombatPower가 이 값을 읽어 서버로 넘어갈 전투력에 곱한다.
		self._T.pendingSkillPowerMult = self:GetSkillPowerMultiplier(skillName) * bonus
		local combatPower = self:GetEffectiveCombatPower()
		-- 이번 한 발만 활 모션을 shootf로 바꾼다(서버가 1회성 플래그로 소비한다).
		self:RequestArcherFinalMotionOnce()

		if skillName == "더블샷" then
			local jobIdx = math.floor(_UIMyInfoManager:GetSelectedCharacterJobIdx())
			-- (요청 2026-08-13) 배율은 원본 시전과 같은 헬퍼(투자 레벨별)에서 가져온다.
			-- ⚠ 파이널 어택으로 나가는 추가 발은 **MP를 다시 쓰지 않는다**(원본 시전이 이미 냈다).
			local dsLvF = math.max(1, self:GetHeroSkillLevelByName("더블샷"))
			self:RequestFireDoubleShotLv(combatPower, atkMult, jobIdx,
				self:GetDoubleShotRateMinLv(dsLvF), self:GetDoubleShotRateMaxLv(dsLvF))
		elseif skillName == "에로우 블로우" then
			local abLvF = math.max(1, self:GetHeroSkillLevelByName("에로우 블로우"))
			local abEnhLv = self:GetHeroSkillLevelByName("에로우 블로우 강화")
			self:RequestFireArrowBlowLv(combatPower, atkMult, abEnhLv >= 1,
				self:GetArrowBlowRateMinLv(abLvF, abEnhLv), self:GetArrowBlowRateMaxLv(abLvF, abEnhLv))
		elseif skillName == "에로우 봄" then
			local abLv = math.max(1, self:GetHeroSkillLevelByName("에로우 봄"))
			self:RequestFireArrowBombLv(combatPower, atkMult,
				self:GetArrowBombMinPercent(abLv) / 100, self:GetArrowBombMaxPercent(abLv) / 100)
		elseif skillName == "아이언 에로우" then
			-- 조준은 재시전 시점의 방향키를 다시 읽는다(원본과 같은 8방향 규칙).
			local dirX, dirY = 0, 0
			if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
				dirX = -1
			elseif _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
				dirX = 1
			end
			if _InputService:IsKeyPressed(KeyboardKey.UpArrow) then
				dirY = 1
			elseif _InputService:IsKeyPressed(KeyboardKey.DownArrow) then
				dirY = -1
			end
			if dirX == 0 and dirY == 0 and _AutoHuntManager:IsActive() then
				dirX = _AutoHuntManager:GetAimDirX()
				dirY = _AutoHuntManager:GetAimDirY()
			end
			local iaLv = math.max(1, self:GetHeroSkillLevelByName("아이언 에로우"))
			local iaPos2 = _UserService.LocalPlayer.TransformComponent.WorldPosition
			self:RequestFireIronArrowLvPos(combatPower, atkMult, dirX, dirY,
				self:GetIronArrowMinPercent(iaLv) / 100, self:GetIronArrowMaxPercent(iaLv) / 100, iaPos2.x, iaPos2.y)
		elseif skillName == "스트레이프" then
			local stLv = math.max(1, self:GetHeroSkillLevelByName("스트레이프"))
			self:RequestFireStrafeLv(combatPower, atkMult,
				self:GetStrafeMinPercent(stLv) / 100, self:GetStrafeMaxPercent(stLv) / 100)
		elseif skillName == "아이스 샷" then
			local isLv = math.max(1, self:GetHeroSkillLevelByName("아이스 샷"))
			self:RequestFireIceShotLv(combatPower, atkMult,
				self:GetIceShotMinPercent(isLv) / 100, self:GetIceShotMaxPercent(isLv) / 100)
		elseif skillName == "파이어 샷" then
			local fsLv = math.max(1, self:GetHeroSkillLevelByName("파이어 샷"))
			self:RequestFireFireShotLv(combatPower, atkMult,
				self:GetFireShotMinPercent(fsLv) / 100, self:GetFireShotMaxPercent(fsLv) / 100)
		end
		log("[SkillManager] 파이널 어택:궁수 재시전 - " .. tostring(skillName)
			.. " combatPower=" .. tostring(combatPower))
		-- 재시전이 끝났으므로 다음 원본 시전부터 다시 확률을 굴릴 수 있게 푼다.
		-- ⚠ 재시전의 이동 잠금(0.75*배율)이 끝나는 시점까지 유지해야, 그 사이에 들어온 원본 시전이
		--   파이널을 또 굴려 두 발이 겹치는 일이 없다.
		_TimerService:SetTimerOnce(function()
			self._T.archerFinalInProgress = false
		end, 0.75 * atkMult)
	end

	@ExecSpace("Server")
	method void RequestArcherFinalMotionOnce()
		-- 파이널 어택:궁수 재시전 1회분만 활 모션을 shootf로 바꾸도록 서버에 플래그를 세운다.
		-- (모든 활 스킬 RPC에 인자를 더하면 LEA-1102 위험이 커져서 별도 1회성 플래그로 분리했다.)
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SetArcherFinalMotionOnce()
	end

	-- 콤보 어택 지속시간: (요청 2026-08-12) 기본 70초 + **분배당 8초**. 1레벨부터 분배 1회로 치므로
	-- Lv1 = 78초, 마스터 30 = 310초(분노/부스터 곡선의 마스터값과 일치).
	-- ⚠ `(lv-1)`로 두면 1레벨이 70초가 되어 설계보다 8초 일찍 끝난다(신고).
	@ExecSpace("ClientOnly")
	method number GetComboDurationForLevel(integer lv)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 30)
		return 70 + 8 * lv
	end

	-- ── 다크나이트 3차 스킬 효과 공식 (2026-08-04 개편) ────────────────────
	-- 5종(스피어 버스터 / 드래곤 로어 / 용 소환 / 드래곤 라이딩 / 힐러 소환)이 모두 spendable로
	-- 바뀌면서, 각 스킬의 수치를 "투자 레벨 → 실제 값"으로 바꾸는 단일 진입점을 여기 모아둔다.
	-- ⚠ 시전 분기 / 툴팁(GetSkillLevelEffectText) / 서버 전달값이 전부 이 메서드들을 쓴다 -
	--   수치를 바꿀 때는 여기 한 곳만 고치면 세 곳이 함께 따라온다.

	-- 스피어 버스터 동시 타격 수: 1~9레벨 4명 / 10~19 6명 / 20~29 8명 / 30 10명.
	@ExecSpace("ClientOnly")
	method integer GetSpearBurstTargetCount(integer lv)
		-- 투자 레벨 구간별 동시 타격 대상 수(서버 AttackSpearBurst의 대상 탐색 상한으로 넘어간다).
		if lv >= 30 then return 10 end
		if lv >= 20 then return 8 end
		if lv >= 10 then return 6 end
		return 4
	end

	-- 스피어 버스터 줄당 데미지 최소%: 100% + 분배당 5%p (마스터 30 = 245%).
	@ExecSpace("ClientOnly")
	method number GetSpearBurstMinPercent(integer lv)
		-- (요청 2026-08-12 5차) 1레벨 104%에서 분배 1포인트당 +4%p (마스터 30 = 220%).
		-- 종전 100% + 5%p/pt. 최대%와 폭이 같아져 굴림 폭이 항상 20%p로 고정된다.
		local v = math.max(1, math.min(lv, 30))
		return 104 + 4 * (v - 1)
	end

	-- 스피어 버스터 줄당 데미지 최대%: 150% + 분배당 10%p (마스터 30 = 440%).
	@ExecSpace("ClientOnly")
	method number GetSpearBurstMaxPercent(integer lv)
		-- (요청 2026-08-12 5차) 1레벨 124%에서 분배 1포인트당 +4%p (마스터 30 = 240%). 종전 150% + 10%p/pt.
		local v = math.max(1, math.min(lv, 30))
		return 124 + 4 * (v - 1)
	end

	-- 드래곤 로어 데미지%: 300% + 분배당 30%p (마스터 30 = 1170%).
	@ExecSpace("ClientOnly")
	method number GetDragonRoarPercent(integer lv)
		-- (요청 2026-08-12 5차) 1레벨 **200%~220%**에서 분배 1포인트당 최소·최대 각 +5%p
		-- (마스터 30 = 345%~365%). 종전 단일 배율 300% + 30%p/pt.
		-- ⚠ 최소·최대가 같은 폭으로 오르므로 **굴림 폭은 항상 20%p 고정**이다 - 서버에는 최소값만
		--   넘기고(기존 RPC 인자 그대로 - LEA-1102 회피) RollDragonRoarMult가 +0.20 폭으로 굴린다.
		local v = math.max(1, math.min(lv, 30))
		return 200 + 5 * (v - 1)
	end

	-- 드래곤 로어 데미지 상한% - 최소 + 고정 20%p.
	@ExecSpace("ClientOnly")
	method number GetDragonRoarMaxPercent(integer lv)
		-- 표시/로그 전용(서버는 최소값 + 고정 폭으로 굴린다).
		return self:GetDragonRoarPercent(lv) + 20
	end

	-- 드래곤 로어 HP 소모(최대 HP %): 70% - 분배당 1%p (마스터 30 = 41%).
	@ExecSpace("ClientOnly")
	method number GetDragonRoarHpCostPercent(integer lv)
		-- 분배할수록 소모가 줄어드는 유일한 역방향 수치 - 하한 41%로 자연히 수렴한다.
		local v = math.max(1, math.min(lv, 30))
		return 70 - (v - 1)
	end

	-- 용 소환 지속시간: 2분 → 10분 (마스터 30, 콤보 어택과 동일한 선형 곡선).
	@ExecSpace("ClientOnly")
	method number GetSixDragonsDurationForLevel(integer lv)
		-- 지속시간이 끝나면 소환된 용이 전부 사라진다(서버 SummonSixDragons가 같은 값으로 예약).
		local v = math.max(1, math.min(lv, 30))
		return 120 + (480 / 29) * (v - 1)
	end

	-- 소환 용(용 소환 / 드래곤 라이딩) 데미지 최소%: 150% + 분배당 15%p.
	@ExecSpace("ClientOnly")
	method number GetDragonDamageMinPercent(integer lv)
		-- 두 스킬이 같은 공식을 쓰되 마스터 레벨이 달라(30 / 20) 상한만 달라진다.
		local v = math.max(1, lv)
		return 150 + 15 * (v - 1)
	end

	-- 소환 용(용 소환 / 드래곤 라이딩) 데미지 최대%: 200% + 분배당 20%p.
	@ExecSpace("ClientOnly")
	method number GetDragonDamageMaxPercent(integer lv)
		-- 최소%와 짝을 이루는 상한.
		local v = math.max(1, lv)
		return 200 + 20 * (v - 1)
	end

	-- 드래곤 라이딩 소환 지속시간: 2분 30초 + 분배당 20초 (마스터 20 = 8분 50초).
	-- (요청 2026-08-05) 고정 5분 → 투자 레벨 비례. 쿨타임은 레벨과 무관하게 5분 고정이라,
	-- 마스터에 가까워지면 지속시간이 쿨타임보다 길어져 사실상 상시 유지가 된다(의도된 성장 보상).
	@ExecSpace("ClientOnly")
	method number GetDragonRideDurationForLevel(integer lv)
		-- (요청 2026-08-12 5차) 1레벨 20초 + 분배당 10초(마스터 20 = 210초). 종전 150초 + 20초/pt.
		-- 버프바 표시 / 만료 예약 / 서버 소환수 Lifetime이 모두 이 값을 쓴다.
		local v = math.max(1, math.min(lv, 20))
		return 20 + 10 * (v - 1)
	end

	-- 드래곤 라이딩 탑승 이동속도 배율: 1레벨 = 걷기의 120%, 분배당 +2%p (마스터 20 = 1.58).
	@ExecSpace("ClientOnly")
	method number GetDragonRideSpeedMult(integer lv)
		-- 서버 RequestSetDragonRideMount가 이 배율을 원래 InputSpeed에 곱한다.
		-- (요청 2026-08-05) 기준값 1.0 → **1.2**. 1레벨에서 탑승하면 오히려 평소 걷기보다 느리게
		-- 느껴진다는 신고 - 비행 이동은 발판을 무시하는 대신 항상 걷기보다 빨라야 한다.
		local v = math.max(1, math.min(lv, 20))
		return 1.2 + 0.02 * (v - 1)
	end

	-- 힐러 소환 지속시간: 60초 + 분배당 10초 (마스터 30 = 350초).
	@ExecSpace("ClientOnly")
	method number GetHealerDurationForLevel(integer lv)
		-- (요청 2026-08-12 5차) 1레벨 20초 + 분배당 10초(마스터 30 = 310초). 종전 60초 + 10초/pt.
		-- 버프바 표시 / 서버 Lifetime이 같은 값을 쓴다.
		local v = math.max(1, math.min(lv, 30))
		return 20 + 10 * (v - 1)
	end

	-- 힐러 힐량(주인 최대 HP의 %): (요청 2026-08-05 하향) **1레벨 3% + 5레벨당 1%p, 마스터 30 = 10%**
	-- (구 사양 5% + 3포인트당 1%p = 마스터 15%는 "힐러가 너무 세다"는 피드백으로 폐기).
	@ExecSpace("ClientOnly")
	method integer GetHealerHealPercent(integer lv)
		-- ⚠ 3 + floor(lv/5)만 쓰면 30레벨이 9%라 사양(10%)과 1%p 어긋난다 - 마스터는 요청값으로 고정한다
		-- (용 소환/서먼 다크드래곤의 "마스터 값 우선" 처리와 같은 관례).
		local v = math.max(1, math.min(lv, 30))
		if v >= 30 then return 10 end
		return 3 + math.floor(v / 5)
	end

	-- 힐러 최대 HP(주인 최대 HP의 %): 40% + 분배당 1%p (마스터 30 = 69%).
	@ExecSpace("ClientOnly")
	method integer GetHealerHpPercent(integer lv)
		-- 서버 SummonHealer가 주인 MaxHp에 이 비율을 곱해 HealerMaxHp를 정한다.
		local v = math.max(1, math.min(lv, 30))
		return 40 + (v - 1)
	end

	-- ── 다크나이트 4차 스킬 효과 공식 (2026-08-05 개편) ────────────────────
	-- 3차와 같은 관례: 시전 분기 / 툴팁(GetSkillLevelEffectText) / 서버 전달값이 전부 아래 메서드를 쓴다.

	-- 어드밴스드 스피어 버스터가 스피어 버스터 줄당 최소%에 더하는 값: 분배 1포인트당 +5%p (마스터 30 = +150%p).
	@ExecSpace("ClientOnly")
	method number GetAdvSpearBurstMinBonus(integer lv)
		-- (요청 2026-08-12 5차) 분배 1포인트당 +4%p (마스터 30 = +120%p). 종전 +5%p/pt.
		-- 미투자(0)면 0 - 스피어 버스터가 3차 수치 그대로 나간다.
		local v = math.max(0, math.min(lv, 30))
		return 4 * v
	end

	-- 어드밴스드 스피어 버스터가 스피어 버스터 줄당 최대%에 더하는 값: 분배 1포인트당 +10%p (마스터 30 = +300%p).
	@ExecSpace("ClientOnly")
	method number GetAdvSpearBurstMaxBonus(integer lv)
		-- (요청 2026-08-12 5차) 최소와 **같은 +4%p/pt** - 굴림 폭(20%p)이 어드밴스드 투자와 무관하게 유지된다.
		-- 최소 보너스와 짝을 이루는 상한 - 서버는 합산된 최소/최대 사이에서 1회 굴린다.
		local v = math.max(0, math.min(lv, 30))
		return 4 * v
	end

	-- 드래곤 블러드 지속시간: 3분 → 10분 (마스터 30, 콤보 어택과 같은 선형 곡선).
	@ExecSpace("ClientOnly")
	method number GetDragonBloodDurationForLevel(integer lv)
		-- 버프바 표시 / 서버 만료 예약이 같은 값을 쓴다.
		local v = math.max(1, math.min(lv, 30))
		return 180 + (420 / 29) * (v - 1)
	end

	-- 드래곤 블러드 공격력 보너스: 분배 1포인트당 +1 (마스터 30 = +30).
	@ExecSpace("ClientOnly")
	method integer GetDragonBloodAttackBonus(integer lv)
		-- 분노/메디테이션과 같은 경로(ApplyAttackBuff)로 스탯창에 반영된다.
		return math.max(1, math.min(lv, 30))
	end

	-- 소환 용이 때릴 때 회복하는 최대 HP 비율(%): 1~9레벨 1% / 10~19레벨 2% / 20~30레벨 3%.
	@ExecSpace("ClientOnly")
	method integer GetDragonBloodHealPercent(integer lv)
		-- 스피어 버스터 동시 타격 수와 같은 "구간형" 수치 - 서버(PlayerAttack)가 이 값을 그대로 쓴다.
		-- (요청 2026-08-12 5차) 전 구간 **2배**: 1/2/3% → 2/4/6%.
		if lv >= 20 then return 6 end
		if lv >= 10 then return 4 end
		return 2
	end

	-- ── 전사 1차 스킬 효과 공식 (요청 2026-08-09) ──────────────────────
	-- 시전 분기 / 툴팁(GetSkillLevelEffectText) / 서버 전달값이 전부 아래 메서드들만 읽는다.
	-- 수치를 바꿀 때는 여기 한 곳만 고치면 세 곳이 함께 따라온다(다크나이트 3·4차와 같은 관례).
	-- ⚠ 이 두 스킬은 공용 위력 배율(GetSkillPowerMultiplier, 0.6~1.0)을 **쓰지 않는다** -
	--   레벨 성장이 아래 배율에 직접 들어가 있어 함께 곱하면 이중 적용이 된다.
	--   UseSkillInSlot의 해당 분기가 pendingSkillPowerMult를 1.0으로 고정해 이를 보장한다.

	-- 파워스트라이크 데미지 배율(%, 최소): 기본 100%에서 분배 1포인트당 +4%p.
	-- 1레벨 104% / 마스터 20 180%.
	@ExecSpace("ClientOnly")
	method number GetPowerStrikeMinPercent(integer lv)
		-- 미투자(0)도 계산은 되지만 실제 시전은 IsSkillUsableByInvestment가 막는다.
		local v = math.max(0, math.min(lv, 20))
		return 100 + 4 * v
	end

	-- 파워스트라이크 데미지 배율(%, 최대): 기본 120%에서 분배 1포인트당 +6%p.
	-- 1레벨 126% / 마스터 20 240%.
	@ExecSpace("ClientOnly")
	method number GetPowerStrikeMaxPercent(integer lv)
		-- 최소 배율과 짝을 이루는 상한 - 서버가 이 둘 사이에서 타격마다 1회 굴린다.
		local v = math.max(0, math.min(lv, 20))
		return 120 + 6 * v
	end

	-- 슬래시블러스트 데미지 배율(%, 최소): 기본 50%에서 분배 1포인트당 +2%p.
	-- 1레벨 52% / 마스터 20 90%.
	@ExecSpace("ClientOnly")
	method number GetSlashBlastMinPercent(integer lv)
		-- 최대 6명을 순차로 때리므로, 이 배율이 대상마다 각각 굴려진다.
		local v = math.max(0, math.min(lv, 20))
		return 50 + 2 * v
	end

	-- 슬래시블러스트 데미지 배율(%, 최대): 기본 60%에서 분배 1포인트당 +3%p.
	-- 1레벨 63% / 마스터 20 120%.
	@ExecSpace("ClientOnly")
	method number GetSlashBlastMaxPercent(integer lv)
		-- 최소 배율과 짝을 이루는 상한.
		local v = math.max(0, math.min(lv, 20))
		return 60 + 3 * v
	end

	-- 파워스트라이크 시전 MP 소모(고정 10). 레벨과 무관하다.
	@ExecSpace("ClientOnly")
	method integer GetPowerStrikeMpCost()
		-- 텔레포트(GetTeleportMpCost)와 같은 "스킬별 비용 헬퍼" 관례.
		return 10
	end

	-- 슬래시블러스트 시전 MP 소모(고정 5). HP 5는 서버(PlayerAttack)가 함께 깎는다.
	@ExecSpace("ClientOnly")
	method integer GetSlashBlastMpCost()
		-- HP 비용은 서버 권한이라 여기서 다루지 않는다 - 클라는 부족 여부만 미리 본다.
		return 5
	end

	-- 러시(질주) 시전 MP 소모(고정 5).
	@ExecSpace("ClientOnly")
	method integer GetRushMpCost()
		-- 방향키 더블탭 질주도 같은 러시라 EnterSprint 한 곳에서 함께 소모된다.
		return 5
	end

