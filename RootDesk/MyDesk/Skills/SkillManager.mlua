	-- ⚠ 종전엔 서버 FreezerSummon.Lifetime에 600(10분)이 하드코딩돼 있었다 - 이제 이 헬퍼가 유일한
	--   출처이고, 시전 시 RPC(RequestFireFreezerLvDur)로 서버에 실려 간다.
	@ExecSpace("ClientOnly")
	method number GetFreezerDuration(integer lv)
