	-- 빙하지대 장판 틱 데미지 최대%: 60% + 분배 1포인트당 10%p (마스터 20 = 250%).
	@ExecSpace("ClientOnly")
	method number GetGlacierZoneMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 60 + 10 * (v - 1)
	end

	-- 빙하지대 **버프 지속시간**(초 - 장판이 깔리는 10초가 아니라 "적중 시 프록"이 도는 시간).
	-- (요청 2026-08-14) **블레스와 같다**. 종전엔 서버 CastGlacierZoneBuff에 600(10분)이
	-- 하드코딩돼 있었다 - 이제 이 헬퍼가 유일한 출처이고 시전 RPC로 서버에 실려 간다.
	-- (요청 2026-08-14 2차) 블레스가 고정 5분 → **20초 + 분배당 10초**로 바뀌면서 함께 따라간다
	-- (빙하지대 마스터 20 = 210초). "블레스와 같게"가 사용자 지정 사양이라 위임을 그대로 유지한 결과다.
	-- ⚠ 인자 없던 GetGlacierZoneDuration에 레벨을 더하지 않고 이름을 새로 지었다(LEA-1102 회피 관례).
	-- ⚠ 쌍둥이인 불의 영역(불독)은 서버에 자기 600초 상수를 따로 갖고 있어 함께 움직이지 않는다(요청 범위 밖).
	@ExecSpace("ClientOnly")
	method number GetGlacierZoneDurationLv(integer lv)
		return self:GetBlessBuffDurationLv(lv)
	end

	-- 불의 영역 장판 틱 데미지 최소%: **빙하지대와 완전히 같다**(불독 개편 2026-08-08).
	@ExecSpace("ClientOnly")
	method number GetFireZoneMinPercent(integer lv)
		-- 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 빙하지대 헬퍼를 그대로 호출한다.
		return self:GetGlacierZoneMinPercent(lv)
	end

	-- 불의 영역 장판 틱 데미지 최대%: 빙하지대와 동일.
	@ExecSpace("ClientOnly")
	method number GetFireZoneMaxPercent(integer lv)
		-- 마스터 레벨(20)도 빙하지대와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetGlacierZoneMaxPercent(lv)
	end

	-- 불의 영역 **버프 지속시간**(초): (요청 2026-08-14 3차) **빙하지대와 같다**(= 블레스 곡선,
	-- 20초 + 분배 1포인트당 10초, 마스터 20 = 210초). 종전엔 서버 CastFireZoneBuffLv에 600(10분)이
	-- 하드코딩돼 있었다 - 이제 이 헬퍼가 유일한 출처이고 시전 RPC로 서버에 실려 간다(빙하지대와 같은 관례).
	@ExecSpace("ClientOnly")
	method number GetFireZoneDurationLv(integer lv)
		return self:GetGlacierZoneDurationLv(lv)
	end

	-- 포이즌 미스트 독 틱 데미지 최소%: (요청 2026-08-14 3차) 50% + 분배 1포인트당 3%p (마스터 20 = 107%).
	-- 종전은 70% + 분배당 5%p(마스터 165%)였다. 틱 1초/무크리/지속 40초는 그대로.
	@ExecSpace("ClientOnly")
	method number GetPoisonMistMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 50 + 3 * (v - 1)
	end

	-- 포이즌 미스트 독 틱 데미지 최대%: 60% + 분배 1포인트당 3%p (마스터 20 = 117%).
	@ExecSpace("ClientOnly")
	method number GetPoisonMistMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 60 + 3 * (v - 1)
	end

	-- 익스플로젼 폭발 데미지 최소%: (요청 2026-08-14 3차) 300% + 분배 1포인트당 5%p (마스터 20 = 395%).
	-- 종전은 분배당 30%p(마스터 870%)였다 - 기준값 300%는 그대로이고 상승폭만 크게 내려갔다.
	-- 본체 폭발/독안개 유폭이 같은 값을 쓴다(같은 태그).
	@ExecSpace("ClientOnly")
	method number GetExplosionMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 300 + 5 * (v - 1)
	end

	-- 익스플로젼 폭발 데미지 최대%: 320% + 분배 1포인트당 5%p (마스터 20 = 415%).
	@ExecSpace("ClientOnly")
	method number GetExplosionMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 320 + 5 * (v - 1)
	end

	-- 블레스 지속시간(초): (요청 2026-08-14 2차) **1레벨 20초 + 분배 1포인트당 10초**
	-- (블레스 마스터 30 = 310초). 종전은 레벨과 무관한 고정 5분이었다.
	-- 이 프로젝트의 "버프 지속" 기준 곡선이고, 메디테이션(마스터 20 = 210초)·빙하지대(마스터 20 = 210초)가
	-- 여기서 지속시간을 위임받는다 - 세 스킬의 마스터 레벨이 달라 같은 곡선이라도 상한이 다르다.
	-- ⚠ 인자 없던 GetBlessBuffDuration에 레벨을 더하지 않고 이름을 새로 지었다(LEA-1102 회피 관례).
	-- ⚠ 클램프 상한은 셋 중 가장 큰 마스터(30)로 둔다 - 각 스킬의 투자 레벨은 자기 마스터를 넘지 않으므로
	--   여기서 스킬별로 나눌 필요가 없다.
	@ExecSpace("ClientOnly")
	method number GetBlessBuffDurationLv(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 20 + 10 * (v - 1)
	end

	-- 블레스 시전 MP: (요청 2026-08-14 2차) **30**. 종전은 무료(0)였다.
	-- 메디테이션이 이 값을 위임받는다("메디테이션의 사용 MP를 블레스와 같이" - 요청 2026-08-14).
	@ExecSpace("ClientOnly")
	method integer GetBlessMpCost()
		return 30
	end

	-- 메디테이션 지속시간(초): **블레스와 같다**(요청 2026-08-14).
	-- (요청 2026-08-14 2차) 블레스가 고정 5분 → 20초 + 분배당 10초로 바뀌면서 함께 따라간다
	-- (메디테이션 마스터 20 = 210초). 그 전 자체 사양은 30초 + 분배당 10초(마스터 220초)였다.
	-- 마력 보너스(+2/분배)는 시전 분기와 툴팁이 같은 식(2 × lv)을 쓴다 - 그건 그대로다.
	-- ⚠ 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 블레스 헬퍼를 그대로 호출한다.
	@ExecSpace("ClientOnly")
	method number GetMeditationDuration(integer lv)
		return self:GetBlessBuffDurationLv(lv)
	end

	-- 메디테이션 시전 MP: **블레스와 같다**(요청 2026-08-14 2차 기준 30).
	@ExecSpace("ClientOnly")
	method integer GetMeditationMpCost()
		return self:GetBlessMpCost()
	end

	-- 힐 회복량(최대 HP의 %): (요청 2026-08-13 2차) **분배 2포인트당 1%**(마스터 30에서 15%).
	-- 종전은 분배 1포인트당 1%(마스터 30에서 30%)였다.
	-- ⚠ 하한 1% - 순수 ⌊레벨/2⌋면 1레벨에서 0%가 되어 "배웠는데 아무 일도 안 일어나는" 스킬이 된다.
	--   2레벨부터는 요청 공식 그대로다(2→1 / 4→2 / … / 30→15).
	@ExecSpace("ClientOnly")
	method number GetHealPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return math.max(1, math.floor(v / 2))
	end

	-- 블레스 공격력/마력 보너스: 분배 1포인트당 +1 (마스터 30에서 +30 - 구 고정값과 같은 상한).
	@ExecSpace("ClientOnly")
	method integer GetBlessAttackBonus(integer lv)
		-- 공격력과 마력에 같은 값이 들어간다(요청: 공격력1, 마력1).
		return math.max(1, math.min(lv, 30))
	end

	-- 블레스 STR/DEX/LUK/INT 보너스: 분배 1포인트당 +3 (마스터 30에서 각 +90).
	@ExecSpace("ClientOnly")
	method integer GetBlessStatBonus(integer lv)
		-- 네 스탯에 같은 값이 들어간다(요청: str3, dex3, luk3, int3).
		return 3 * math.max(1, math.min(lv, 30))
	end

	-- 텔레포트 소모 MP: (요청 2026-08-13 2차) **20**에서 분배 1포인트당 -1 (마스터 10에서 11).
	-- 종전은 10에서 시작해 마스터 10에서 1이었다.
	@ExecSpace("ClientOnly")
	method integer GetTeleportMpCost(integer lv)
		-- 미투자(0pt)여도 쓸 수 없는 spendable 스킬이라 하한은 1레벨 기준 20이다.
		local v = math.max(1, math.min(lv, 10))
		return 21 - v
	end

	-- 샤이닝 레이 데미지 최소%: 1000% + 분배 1포인트당 30%p (마스터 20 = 1570%).
	@ExecSpace("ClientOnly")
	method number GetShiningRayMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 1000 + 30 * (v - 1)
	end

	-- 샤이닝 레이 데미지 최대%: 1500% + 분배 1포인트당 30%p (마스터 20 = 2070%).
	@ExecSpace("ClientOnly")
	method number GetShiningRayMaxPercent(integer lv)
		-- 최소와 같은 폭으로 함께 밀려 올라간다(요청: "최소 최저 30%씩 상승").
		local v = math.max(1, math.min(lv, 20))
		return 1500 + 30 * (v - 1)
	end

	-- 샤이닝 레이 재사용 대기시간(초): 60초에서 분배 1포인트당 1초 감소 (마스터 20 = 41초).
	@ExecSpace("ClientOnly")
	method number GetShiningRayCooldown(integer lv)
		local v = math.max(1, math.min(lv, 20))
		return 60 - (v - 1)
	end

	-- 홀리 매직쉘 재사용 대기시간(초): 60초에서 분배 1포인트당 1초 감소 (마스터 30 = 31초).
	@ExecSpace("ClientOnly")
	method number GetHolyShellCooldown(integer lv)
		-- 구 사양은 레벨 무관 120초 고정이었다(HOLY_SHELL_COOLDOWN 상수) - 이제 이 헬퍼가 유일한 출처.
		local v = math.max(1, math.min(lv, 30))
		return 60 - (v - 1)
	end

	-- 바하뮤트 지속시간(초): 30초 + 분배 1포인트당 10초 (마스터 20 = 220초 = 3분 40초).
	@ExecSpace("ClientOnly")
	method number GetBahamutDuration(integer lv)
		-- 구 사양은 레벨 무관 10분 고정이었다.
		local v = math.max(1, math.min(lv, 20))
		return 30 + 10 * (v - 1)
	end

	-- 바하뮤트 브레스 데미지 최소%: (요청 2026-08-13 2차) **프리져와 완전히 같다** - 기준값도,
	-- 분배당 상승폭도(400% + 분배 1포인트당 5%p, 마스터 20 = 495%). 종전은 500%~800% + 분배당 30%p.
	-- ⚠ 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 프리져 헬퍼를 그대로 호출한다
	--   (피닉스 ← 프리져와 같은 위임 관례). MP 비용도 GetBahamutMpCost가 같은 방식으로 위임하고,
	--   재사용 대기시간은 프리져처럼 **아예 없다**(시전 분기의 0.5초 연타 게이트만 남는다).
	-- ⚠ 이프리트/엘퀴네스는 이 곡선과 무관하다(자체 200%~300% + 분배당 30%p) - 함께 움직이지 않는다.
	@ExecSpace("ClientOnly")
	method number GetBahamutMinPercent(integer lv)
		return self:GetFreezerMinPercent(lv)
	end

	-- 바하뮤트 브레스 데미지 최대%: 프리져와 동일(420% + 분배 1포인트당 5%p, 마스터 20 = 515%).
	@ExecSpace("ClientOnly")
	method number GetBahamutMaxPercent(integer lv)
		-- 마스터 레벨(20)도 프리져와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetFreezerMaxPercent(lv)
	end

	-- 이프리트 화염 데미지 최소%: (요청 2026-08-14) **프리져와 완전히 같다** - 기준값도, 분배당
	-- 상승폭도(400% + 분배 1포인트당 5%p, 마스터 20 = 495%). 종전은 200%~300% + 분배당 30%p.
	-- ⚠ 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 프리져 헬퍼를 그대로 호출한다
	--   (피닉스·바하뮤트 ← 프리져와 같은 위임 관례). 지속시간·MP도 아래에서 같은 방식으로 위임한다.
	-- ⚠ 엘퀴네스는 이 헬퍼를 위임받으므로 프리져 규격을 자동으로 함께 따라간다(요청 범위 안).
	@ExecSpace("ClientOnly")
	method number GetIfritMinPercent(integer lv)
		return self:GetFreezerMinPercent(lv)
	end

	-- 이프리트 화염 데미지 최대%: 프리져와 동일(420% + 분배 1포인트당 5%p, 마스터 20 = 515%).
	@ExecSpace("ClientOnly")
	method number GetIfritMaxPercent(integer lv)
		return self:GetFreezerMaxPercent(lv)
	end

	-- 이프리트 지속시간(초): (요청 2026-08-14) **프리져와 같다**(20초 + 분배 1포인트당 10초, 마스터 20 = 210초).
	-- ⚠ 종전엔 서버 IfritSummon.Lifetime에 600(10분)이 하드코딩돼 있었다 - 이제 이 헬퍼가 유일한
	--   출처이고, 시전 시 RPC(RequestFireIfritLvDur)로 서버에 실려 간다(프리져와 같은 관례).
	@ExecSpace("ClientOnly")
	method number GetIfritDuration(integer lv)
		return self:GetFreezerDuration(lv)
	end

	-- 이프리트 시전 MP: (요청 2026-08-14) **프리져와 같다**(100).
	@ExecSpace("ClientOnly")
	method integer GetIfritMpCost()
		return self:GetFreezerMpCost()
	end

	-- 엘퀴네스 얼음 데미지 최소%: **이프리트와 완전히 같다**(불독 개편 2026-08-08).
	@ExecSpace("ClientOnly")
	method number GetElquinesMinPercent(integer lv)
		-- 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 이프리트 헬퍼를 그대로 호출한다.
		return self:GetIfritMinPercent(lv)
	end

	-- 엘퀴네스 얼음 데미지 최대%: 이프리트와 동일.
	@ExecSpace("ClientOnly")
	method number GetElquinesMaxPercent(integer lv)
		-- 마스터 레벨(20)도 이프리트와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetIfritMaxPercent(lv)
	end

	-- 엘퀴네스 지속시간(초): 이프리트와 동일 = 프리져와 동일(요청 2026-08-14).
	@ExecSpace("ClientOnly")
	method number GetElquinesDuration(integer lv)
		return self:GetIfritDuration(lv)
	end

	-- 엘퀴네스 시전 MP: 이프리트와 동일 = 프리져와 동일(100).
	@ExecSpace("ClientOnly")
	method integer GetElquinesMpCost()
		return self:GetIfritMpCost()
	end

	-- 제네시스 기둥당 데미지 최소%: 1000% + 분배 1포인트당 30%p (마스터 30 = 1870%).
	@ExecSpace("ClientOnly")
	method number GetGenesisMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 1000 + 30 * (v - 1)
	end

	-- 제네시스 기둥당 데미지 최대%: 1300% + 분배 1포인트당 30%p (마스터 30 = 2170%).
	@ExecSpace("ClientOnly")
	method number GetGenesisMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 1300 + 30 * (v - 1)
	end

	-- 제네시스 재사용 대기시간(초): 120초에서 분배 1포인트당 1초 감소 (마스터 30 = 91초).
	-- ⚠ 구 사양은 20초 고정이었다. 홀드 재시전은 이 게이트를 통과할 때만 나가므로,
	--   평소에는 사실상 1회 시전이고 리커버리 오로라 안에서만 연사가 된다(요청).
	@ExecSpace("ClientOnly")
	method number GetGenesisCooldown(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 120 - (v - 1)
	end

	-- 블리자드 재사용 대기시간(초): 제네시스와 동일 - 120초에서 분배 1포인트당 1초 감소 (마스터 30 = 91초).
	-- (요청 2026-08-08) 구 사양은 20초 고정이었다. 리커버리 오로라 안에서는 게이트가 통째로 면제된다(기존과 동일).
	@ExecSpace("ClientOnly")
	method number GetBlizzardCooldown(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 120 - (v - 1)
	end

	-- 메테오 재사용 대기시간(초): **제네시스/블리자드와 완전히 같다**(불독 개편 2026-08-08).
	@ExecSpace("ClientOnly")
	method number GetMeteorCooldown(integer lv)
		-- 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 제네시스 헬퍼를 그대로 호출한다
		-- (마스터 30 클램프도 동일). 구 사양은 20초 고정이었다.
		return self:GetGenesisCooldown(lv)
	end

	-- 메테오 운석당 데미지 최소%: (요청 2026-08-14 3차) **제네시스와 완전히 같다** - 기준값도, 분배당
	-- 상승폭도(1000% + 분배 1포인트당 30%p, 마스터 30 = 1870%). 종전은 700%~1000%였다.
	-- 쿨타임은 2026-08-08부터 이미 제네시스 위임이었고, MP도 이번에 같아졌다(GetMeteorMpCost).
	-- ⚠ 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 제네시스 헬퍼를 그대로 호출한다
	--   (블리자드 ← 제네시스와 같은 위임 관례 - 이제 셋이 한 곡선을 쓴다).
	@ExecSpace("ClientOnly")
	method number GetMeteorMinPercent(integer lv)
		return self:GetGenesisMinPercent(lv)
	end

	-- 메테오 운석당 데미지 최대%: 제네시스와 동일(1300% + 분배 1포인트당 30%p, 마스터 30 = 2170%).
	@ExecSpace("ClientOnly")
	method number GetMeteorMaxPercent(integer lv)
		-- 마스터 레벨(30)도 제네시스와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetGenesisMaxPercent(lv)
	end

	-- 블리자드 주 데미지 최소%: (요청 2026-08-14) **제네시스와 완전히 같다** - 기준값도, 분배당
	-- 상승폭도(1000% + 분배 1포인트당 30%p, 마스터 30 = 1870%). 종전은 3500%~5000%.
	-- 쿨타임은 2026-08-08부터 이미 제네시스와 같은 공식이었고, MP도 이번에 같아졌다(GetBlizzardMpCost).
	-- ⚠ 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 제네시스 헬퍼를 그대로 호출한다.
	-- ⚠ 기둥(skill.blizzard.pillar ×7~10)·얼음조각(shard ×1~1.5)은 서버 고유 사양이라 그대로 둔다 -
	--   요청은 "블리자드의 데미지"(= 주 데미지)였다.
	@ExecSpace("ClientOnly")
	method number GetBlizzardMinPercent(integer lv)
		return self:GetGenesisMinPercent(lv)
	end

	-- 블리자드 주 데미지 최대%: 제네시스와 동일(1300% + 분배 1포인트당 30%p, 마스터 30 = 2170%).
	@ExecSpace("ClientOnly")
	method number GetBlizzardMaxPercent(integer lv)
		-- 마스터 레벨(30)도 제네시스와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetGenesisMaxPercent(lv)
	end

	-- 체인 라이트닝 대상당 데미지 최소%: 500% + 분배 1포인트당 10%p (마스터 30 = 790%).
	-- (요청 2026-08-08) 암살과 마스터 레벨(30)·분배 가능 레벨(120)·**증가량**(최소 +10%p /
	-- 최대 +20%p)이 같다 - 기본값(500~700%)은 체인 라이트닝 고유 사양 그대로다.
	@ExecSpace("ClientOnly")
	method number GetChainLightningMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 500 + 10 * (v - 1)
	end

	-- 체인 라이트닝 대상당 데미지 최대%: 700% + 분배 1포인트당 20%p (마스터 30 = 1280%).
	@ExecSpace("ClientOnly")
	method number GetChainLightningMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 700 + 20 * (v - 1)
	end

	-- 리커버리 오로라 재사용 대기시간(초): 180초에서 분배 1포인트당 2초 감소 (마스터 30 = 122초).
	@ExecSpace("ClientOnly")
	method number GetRecoveryAuraCooldown(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 180 - 2 * (v - 1)
	end

	-- 리저렉션 재사용 대기시간(초): 120초에서 분배 1포인트당 2초 감소 (마스터 20 = 82초).
	@ExecSpace("ClientOnly")
	method number GetResurrectionCooldown(integer lv)
		-- 구 사양은 쿨타임이 아예 없고 연타 오발동만 막는 0.5초 게이트뿐이었다.
		local v = math.max(1, math.min(lv, 20))
		return 120 - 2 * (v - 1)
	end

	-- 엔젤레이 데미지 최소%: 700% + 분배 1포인트당 30%p (마스터 30 = 1570%).
	@ExecSpace("ClientOnly")
	method number GetAngelRayMinPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 700 + 30 * (v - 1)
	end

	-- 엔젤레이 데미지 최대%: 800% + 분배 1포인트당 30%p (마스터 30 = 1670%).
	@ExecSpace("ClientOnly")
	method number GetAngelRayMaxPercent(integer lv)
		local v = math.max(1, math.min(lv, 30))
		return 800 + 30 * (v - 1)
	end

	-- 엔젤레이 추가 후딜(초): 레벨과 무관한 고정값. (요청 2026-08-08) 1.0 → **0.5초**로 단축.
	@ExecSpace("ClientOnly")
	method number GetAngelRayExtraRecovery()
		-- 시전 분기의 공용 쿨다운(skillOnCooldown) 해제 시각과 서버 이동 잠금 양쪽에 더해진다.
		return 0.5
	end

	-- 스킬 투자 레벨 lv에서의 효과 요약 - 툴팁 [현재 레벨]/[다음 레벨] 표시용.
	-- (스킬 효과 개편) 히어로 스킬별 실제 수치를 계산해 보여준다. 데미지 %는 위력 배율(0.6~1.0)을
	-- 기본 계수에 곱한 실효 값이다.
	@ExecSpace("ClientOnly")
	method string GetSkillLevelEffectText(string skillName, integer lv, integer master)
		local m = 0.6 + 0.4 * math.min(1, lv / math.max(1, master))
		local function dmg(base) return tostring(math.floor(base * m + 0.5)) end
		if self:IsShurikenPlusSkill(skillName) then
			-- (표창+ 4분할) 포인트 1당 공격력 +1 + 이 차수가 여는 표창들.
			-- (요청 2026-08-14 5차) "표창마다 효과를 표시" - 해금 지점·표창 이름·장착 효과를 한 줄씩 적는다.
			--   해금 지점(tier.points)과 번호 매핑(GetShurikenIndicesForTier)은 같은 표에서 나오므로
			--   표창을 추가하거나 해금 지점을 바꿔도 이 문구가 저절로 따라온다.
			local tierPoints = {}
			for _, tier in ipairs(_ShurikenLibrary:GetTiers()) do
				if tier.name == skillName then tierPoints = tier.points end
			end
			local idxs = _ShurikenLibrary:GetShurikenIndicesForTier(skillName)
			local opened = 0
			local lines = "공격력 +" .. tostring(lv)
			for i, idx in ipairs(idxs) do
				local need = tierPoints[i] or 1
				local info = _ShurikenLibrary:Get(idx)
				local eff = _ShurikenLibrary:GetEffect(idx)
				local mark = (lv >= need) and "○ " or "● "
				if lv >= need then opened = opened + 1 end
				-- 효과는 0이 아닌 항목만 적는다(대부분의 표창은 공격력만 있다).
				local effTxt = "공격력 +" .. tostring(eff.atk)
				if eff.crit > 0 then effTxt = effTxt .. ", 크리 +" .. tostring(eff.crit) .. "%" end
				if eff.speed > 0 then effTxt = effTxt .. ", 공속 +" .. tostring(eff.speed * 10) .. "%" end
				lines = lines .. "\n" .. mark .. tostring(need) .. "pt " .. tostring(idx) .. "번 "
					.. tostring(info.name) .. " - " .. effTxt
			end
			return lines .. "\n(열림 " .. tostring(opened) .. "/" .. tostring(#idxs)
				.. "종, 전체 선택 가능 " .. tostring(self:GetUnlockedShurikenCount()) .. "종)"
		elseif skillName == "럭키세븐" then
			-- (요청 2026-08-14 5차) 표창 1발당 = **더블샷 화살 1발과 같다**(레벨 비례 - 파워스트라이크 1/3 파생 해제).
			-- ⚠ dmg() 헬퍼를 쓰지 않는다 - 레벨 성장이 배율 자체(GetLuckySevenRate*Lv)에 들어갔다.
			local l7Min = math.floor(self:GetLuckySevenRateMinLv(lv) * 100 + 0.5)
			local l7Max = math.floor(self:GetLuckySevenRateMaxLv(lv) * 100 + 0.5)
			return "표창 1개당 " .. tostring(l7Min) .. "% ~ " .. tostring(l7Max)
				.. "%\n2줄 합 " .. tostring(l7Min * 2) .. "% ~ " .. tostring(l7Max * 2)
				.. "% (더블샷과 같다)\nMP " .. tostring(self:GetLuckySevenMpCost()) .. " 소모"
		elseif skillName == "더블스탭" then
			-- (요청 2026-08-14 4차) 한 타당 = **더블샷 화살 1발의 2배**(레벨 비례 - 럭키세븐 파생 해제).
			-- ⚠ dmg() 헬퍼를 쓰지 않는다 - 레벨 성장이 배율 자체(GetDoubleStabRate*Lv)에 들어갔다.
			local dstMinT = math.floor(self:GetDoubleStabRateMinLv(lv) * 100 + 0.5)
			local dstMaxT = math.floor(self:GetDoubleStabRateMaxLv(lv) * 100 + 0.5)
			return "한 타당 " .. tostring(dstMinT) .. "% ~ " .. tostring(dstMaxT)
				.. "%\n2줄 합 " .. tostring(dstMinT * 2) .. "% ~ " .. tostring(dstMaxT * 2)
				.. "% (더블샷의 2배)\nMP " .. tostring(self:GetDoubleStabMpCost()) .. " 소모"
		elseif skillName == "다크사이트" then
			-- 위력%가 아니라 쿨타임·이동 속도가 핵심인 버프 - 시전 분기와 같은 헬퍼 한 곳에서 계산한다.
			return "재사용 대기시간 " .. tostring(math.floor(self:GetDarkSightCooldown(lv))) .. "초\n은신 중 이동 속도 "
				.. tostring(math.floor(self:GetDarkSightSpeedMult(lv) * 100 + 0.5)) .. "%\n최대 160초 유지, 첫 공격 2배 + 무조건 크리티컬\nMP "
				.. tostring(self:GetDarkSightMpCost()) .. " 소모"
		elseif skillName == "새비지블로우" then
			-- (요청 2026-08-14 4차) 줄당 50%~60% + 분배 1포인트당 최소·최대 2%p(트리플 스로우 파생 해제).
			return "한 타당 " .. tostring(math.floor(self:GetSavageBlowMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetSavageBlowMaxPercent(lv)))
				.. "% (6타)\n6줄 합 " .. tostring(math.floor(self:GetSavageBlowMinPercent(lv) * 6)) .. "% ~ " .. tostring(math.floor(self:GetSavageBlowMaxPercent(lv) * 6))
				.. "%\nMP " .. tostring(self:GetSavageBlowMpCost()) .. " 소모"
		elseif skillName == "암행2" then
			-- 암행1과 완전히 같은 곡선(지속시간 포함)이라 툴팁도 같은 헬퍼만 읽는다.
			local am2Sec = math.floor(self:GetAmhaengDuration(lv))
			local am2Text = tostring(am2Sec) .. "초"
			if am2Sec >= 60 then
				local am2Min = math.floor(am2Sec / 60)
				local am2Rem = am2Sec % 60
				am2Text = tostring(am2Min) .. "분"
				if am2Rem > 0 then am2Text = am2Text .. " " .. tostring(am2Rem) .. "초" end
			end
			return "지속 " .. am2Text .. "\n타수마다 " .. tostring(math.floor(self:GetAmhaengProcPercent(lv))) .. "% 확률로 뒤쪽에 그림자 소환\n한 타당 "
				.. tostring(math.floor(self:GetAmhaengMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetAmhaengMaxPercent(lv)))
				.. "%\n(더블스탭 2타 또는 새비지블로우 6타)\nMP " .. tostring(self:GetAmhaengMpCost()) .. " 소모"
		elseif skillName == "어썰터" then
			return "대상당 " .. tostring(math.floor(self:GetAssaulterMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetAssaulterMaxPercent(lv)))
				.. "%\n스택 1개 충전 " .. string.format("%.1f", self:GetAssaulterChargeSeconds(lv)) .. "초 (최대 3개)\nMP "
				.. tostring(self:GetAssaulterMpCost()) .. " 소모"
		elseif skillName == "암살" then
			return "대상당 " .. tostring(math.floor(self:GetAssassinateMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetAssassinateMaxPercent(lv)))
				.. "%\n최대 10명 연쇄 (체인 라이트닝과 같은 데미지)\nMP " .. tostring(self:GetAssassinateMpCost()) .. " 소모"
		elseif skillName == "연막" then
			return "지속 " .. tostring(math.floor(self:GetSmokeScreenDuration(lv))) .. "초, 재사용 대기시간 3분\n받는 피해 전부 MISS + 내 공격 전부 백스탭\nMP "
				.. tostring(self:GetSmokeScreenMpCost()) .. " 소모"
		elseif skillName == "플래시 점프" then
			-- 위력%가 아니라 "날아가는 힘"이 핵심 - 시전 분기와 같은 헬퍼 한 곳에서 계산한다.
			-- 도약 높이/거리는 힘 배율의 제곱에 비례하므로 체감 배율도 같이 보여준다.
			local fjScale = self:GetFlashJumpForceScale(lv)
			return "날아가는 힘 " .. tostring(math.floor(self:GetFlashJumpForceUnit(lv)))
				.. " (더블 점프 = 5)\n도약 높이·거리 더블 점프의 " .. tostring(math.floor(fjScale * fjScale * 100 + 0.5))
				.. "%\n재사용 대기시간 없음 (뜬 동안 1회)\nMP " .. tostring(self:GetFlashJumpMpCost()) .. " 소모"
		elseif skillName == "암행" then
			-- 지속시간(버프) + 구간형 발동 확률 + 표창 데미지(시전 분기와 동일한 공식 - 헬퍼 한 곳에서 계산).
			local amSec = math.floor(self:GetAmhaengDuration(lv))
			local amText = tostring(amSec) .. "초"
			if amSec >= 60 then
				local amMin = math.floor(amSec / 60)
				local amRem = amSec % 60
				amText = tostring(amMin) .. "분"
				if amRem > 0 then amText = amText .. " " .. tostring(amRem) .. "초" end
			end
			return "지속 " .. amText .. "\n타수마다 " .. tostring(math.floor(self:GetAmhaengProcPercent(lv))) .. "% 확률로 그림자 소환\n표창 1개당 " .. tostring(math.floor(self:GetAmhaengMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetAmhaengMaxPercent(lv))) .. "%\nMP " .. tostring(self:GetAmhaengMpCost()) .. " 소모"
		elseif skillName == "헤이스트" then
			-- 지속시간은 "N분 M초" 꼴로(다른 버프와 같은 형식) + 이동속도/점프 보정 사거리.
			local hsSec = math.floor(self:GetHasteDurationForLevel(lv))
			return "지속 " .. tostring(math.floor(hsSec / 60)) .. "분 " .. tostring(hsSec % 60) .. "초\n이동 속도 +" .. tostring(math.floor(self:GetHasteSpeedMult(lv) * 100 + 0.5) - 100) .. "%\n점프 보정 사거리 " .. tostring(math.floor(self:GetHasteJumpRangeMult(lv) * 100 + 0.5)) .. "% 점프 높이까지\nMP " .. tostring(self:GetHasteMpCost()) .. " 소모"
		elseif skillName == "트리플 스로우" then
			-- 표창 3발 각각의 데미지(시전 분기와 동일한 공식 - 위 헬퍼 한 곳에서 계산).
			return "표창 1개당 " .. tostring(math.floor(self:GetTripleThrowMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetTripleThrowMaxPercent(lv)))
				.. "%\n3줄(쉐도우 파트너 중 6줄)\nMP " .. tostring(self:GetTripleThrowMpCost()) .. " 소모"
		elseif skillName == "쿼드러플 스로우" then
			return "표창 1개당 " .. tostring(math.floor(self:GetQuadThrowMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetQuadThrowMaxPercent(lv)))
				.. "%\n4줄(쉐도우 파트너 중 8줄)\nMP " .. tostring(self:GetQuadThrowMpCost()) .. " 소모"
		elseif skillName == "각성" then
			-- 위력%가 아니라 지속시간·공속이 핵심인 버프 - 시전 분기와 같은 헬퍼 한 곳에서 계산한다.
			-- (전투력 개편) 공속 표기는 단계 대신 % (1단계 = +10%p).
			return "지속 " .. tostring(math.floor(self:GetAwakeningDuration(lv))) .. "초, 재사용 대기시간 5분\n공격 속도 +"
				.. tostring(self:GetAwakeningAtkSpeedStages(lv) * 10) .. "%\n표창 3종 드래곤 로어 범위 조준 + 전부 크리티컬\nMP "
				.. tostring(self:GetAwakeningMpCost()) .. " 소모"
		elseif skillName == "드레인 샷" then
			return "적중 시 최대 HP의 " .. tostring(math.floor(self:GetDrainShotHealPercent(lv))) .. "% 회복\n표창 10개 소모, 재사용 대기시간 5초\nMP "
				.. tostring(self:GetDrainShotMpCost()) .. " 소모"
		elseif skillName == "페이크" then
			return "피격 시 " .. tostring(lv) .. "% 확률로 MISS"
		elseif skillName == "어벤져" then
			return "관통 최대 10명에게 " .. tostring(math.floor(self:GetAvengerMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetAvengerMaxPercent(lv)))
				.. "%\n표창 15개 소모, MP " .. tostring(self:GetAvengerMpCost()) .. " 소모"
		elseif skillName == "분신 소환" or skillName == "분신 강화"
			or skillName == "분신 강화 II" or skillName == "분신 강화 III" then
			-- (신고 2026-08-06) 분신 계열은 [현재 레벨]/[다음 레벨] 설명이 "스킬 위력 N%"로만 떴다.
			-- ⚠ 이 4종은 지속시간·데미지·사용 차수를 **함께** 정한다(GetShadowClone* 헬퍼) -
			--   지금 보고 있는 스킬만 lv로 바꾸고 나머지 셋은 현재 투자값으로 계산해야 실제 결과가 나온다.
			local l1 = self:GetHeroSkillLevelByName("분신 소환")
			local l2 = self:GetHeroSkillLevelByName("분신 강화")
			local l3 = self:GetHeroSkillLevelByName("분신 강화 II")
			local l4 = self:GetHeroSkillLevelByName("분신 강화 III")
			if skillName == "분신 소환" then l1 = lv
			elseif skillName == "분신 강화" then l2 = lv
			elseif skillName == "분신 강화 II" then l3 = lv
			else l4 = lv end
			local scSec = math.floor(self:GetShadowCloneDuration(l1, l2, l3, l4))
			local scDmgPct = math.floor(self:GetShadowCloneDamagePercent(l1, l2, l3, l4))
			local scTier = self:GetShadowCloneSkillTier(l2, l3, l4)
			-- (요청 2026-08-14 4차) 소환 재사용 대기시간 폐지 + MP 200. 강화 3종에도 같은 줄이 붙는다
			-- (넷이 하나의 스킬처럼 묶여 있어 툴팁 분기를 공유한다).
			return "지속 " .. tostring(math.floor(scSec / 60)) .. "분 " .. tostring(scSec % 60) .. "초\n분신 데미지 = 본체의 "
				.. tostring(scDmgPct) .. "%\n분신이 " .. tostring(scTier) .. "차 공격 스킬까지 사용\n재사용 대기시간 없음, MP "
				.. tostring(self:GetShadowCloneMpCost()) .. " 소모"
		elseif skillName == "쉐도우 파트너" then
			-- 지속시간은 "N분 M초" 꼴로(다른 버프와 같은 형식) + 분신 데미지 비율.
			local spSec = math.floor(self:GetShadowPartnerDurationForLevel(lv))
			return "지속 " .. tostring(math.floor(spSec / 60)) .. "분 " .. tostring(spSec % 60) .. "초\n분신 데미지 = 본체의 " .. tostring(math.floor(self:GetShadowPartnerDamagePercent(lv))) .. "%\nMP " .. tostring(self:GetShadowPartnerMpCost()) .. " 소모"
		elseif skillName == "백스탭" then
			return "뒤에서 공격 시 추가 데미지 +" .. tostring(lv * 5) .. "%"
		elseif skillName == "더블샷" then
			-- (요청 2026-08-13) 화살 1발당 40%~50% + 분배 1포인트당 최소·최대 3%p.
			-- ⚠ dmg() 헬퍼를 쓰지 않는다 - 레벨 성장이 배율 자체(GetDoubleShotRate*Lv)에 들어갔다.
			local dsMin = math.floor(self:GetDoubleShotRateMinLv(lv) * 100 + 0.5)
			local dsMax = math.floor(self:GetDoubleShotRateMaxLv(lv) * 100 + 0.5)
			return "화살 1개당 " .. tostring(dsMin) .. "% ~ " .. tostring(dsMax)
				.. "%\n2줄 합 " .. tostring(dsMin * 2) .. "% ~ " .. tostring(dsMax * 2) .. "%\nMP "
				.. tostring(self:GetDoubleShotMpCost()) .. " 소모"
		elseif skillName == "에로우 블로우" then
			-- (요청 2026-08-13) 50%~60% + 본체 분배당 2%p에 "에로우 블로우 강화" 투자분(+2%p씩)이 더해진 실효 수치.
			local abEnh = self:GetHeroSkillLevelByName("에로우 블로우 강화")
			return "화살 1발 " .. tostring(math.floor(self:GetArrowBlowRateMinLv(lv, abEnh) * 100 + 0.5)) .. "% ~ "
				.. tostring(math.floor(self:GetArrowBlowRateMaxLv(lv, abEnh) * 100 + 0.5))
				.. "%\n(강화 Lv." .. tostring(abEnh) .. " 포함)\nMP " .. tostring(self:GetArrowBlowMpCost()) .. " 소모"
		elseif skillName == "에로우 블로우 강화" then
			-- 자기 자신은 위력%가 없고 에로우 블로우에 더해지는 보너스만 있다 - 합산 결과까지 같이 보여준다.
			local abLvSelf = math.max(1, self:GetHeroSkillLevelByName("에로우 블로우"))
			return "에로우 블로우 최소·최대 각 +" .. tostring(2 * lv) .. "%p\n(현재 에로우 블로우 "
				.. tostring(math.floor(self:GetArrowBlowRateMinLv(abLvSelf, lv) * 100 + 0.5)) .. "% ~ "
				.. tostring(math.floor(self:GetArrowBlowRateMaxLv(abLvSelf, lv) * 100 + 0.5)) .. "%)\n적중 지점에서 항상 폭발 (주변 최대 5명)"
		elseif skillName == "에로우 봄" then
			return "폭발 대상 1명당 " .. tostring(math.floor(self:GetArrowBombMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetArrowBombMaxPercent(lv))) .. "%\n직격 + 주변 (최대 6명)\nMP "
				.. tostring(self:GetArrowBombMpCost()) .. " 소모"
		elseif skillName == "파이널 어택:궁수" then
			-- 전사 파이널어택과 같은 수치를 같은 헬퍼에서 읽는다(두 툴팁이 어긋나면 안 된다).
			return "발동 확률 " .. string.format("%.0f", self:GetArcherFinalAttackChanceForLevel(lv)) .. "%, 추가 데미지 " .. dmg(15) .. "~" .. dmg(30) .. "%\n활 공격 스킬이 한 번 더 발동"
		elseif skillName == "아이언 에로우" then
			return "관통 최대 6명에게 " .. tostring(math.floor(self:GetIronArrowMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetIronArrowMaxPercent(lv))) .. "%\nMP " .. tostring(self:GetIronArrowMpCost()) .. " 소모"
		elseif skillName == "더블 점프" then
			-- 위력%가 아니라 상시 이동 속도가 핵심 - 시전 분기(서버 동기화)와 같은 헬퍼 한 곳에서 계산한다.
			return "공중에서 한 번 더 도약, 재사용 대기시간 5초\nMP " .. tostring(self:GetDoubleJumpMpCost())
				.. " 소모\n[상시] 이동 속도 +"
				.. tostring(math.floor(self:GetDoubleJumpSpeedMult(lv) * 100 + 0.5) - 100) .. "%"
		elseif skillName == "스트레이프" then
			return "화살 1개당 " .. tostring(math.floor(self:GetStrafeMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetStrafeMaxPercent(lv))) .. "%\n4줄(적 하나를 4번 공격)\nMP "
				.. tostring(self:GetStrafeMpCost()) .. " 소모"
		elseif skillName == "아이스 샷" then
			return "최대 10명에게 " .. tostring(math.floor(self:GetIceShotMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetIceShotMaxPercent(lv))) .. "%\n맞은 적 3초간 빙결\nMP "
				.. tostring(self:GetIceShotMpCost()) .. " 소모"
		elseif skillName == "파이어 샷" then
			return "최대 10명에게 " .. tostring(math.floor(self:GetFireShotMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetFireShotMaxPercent(lv))) .. "%\n맞은 자리에 불길(화상)\n(아이스 샷과 같은 데미지·MP)\nMP "
				.. tostring(self:GetFireShotMpCost()) .. " 소모"
		elseif skillName == "속사" then
			return "화살 1발당 " .. tostring(math.floor(self:GetRapidFireMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetRapidFireMaxPercent(lv))) .. "%\n0.25초마다 연사 (연사 중 이동 불가)\n화살 1발당 MP "
				.. tostring(self:GetRapidFireMpCost()) .. " 소모"
		elseif skillName == "폭풍의 시" then
			return "화살 1발당 " .. tostring(math.floor(self:GetHurricaneMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetHurricaneMaxPercent(lv))) .. "%\n0.1초마다 연사 (이동속도 60%로 이동 가능)\n화살 1발당 MP "
				.. tostring(self:GetHurricaneMpCost()) .. " 소모"
		elseif skillName == "피닉스" then
			-- (요청 2026-08-13) 데미지·지속시간·MP·무쿨까지 **프리져와 완전히 같은 규격**이다.
			return "최대 6명에게 " .. tostring(math.floor(self:GetPhoenixMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetPhoenixMaxPercent(lv)))
				.. "%\n맞은 적 2초간 스턴\n지속 " .. tostring(math.floor(self:GetPhoenixDuration(lv)))
				.. "초, 재사용 대기시간 없음\nMP " .. tostring(self:GetPhoenixMpCost()) .. " 소모"
		elseif skillName == "용사 소환" or skillName == "궁수 소환" or skillName == "도적 소환" then
			-- (비숍 개편 2026-08-08) 세 소환은 규격이 완전히 같아 툴팁 계산도 한 분기로 묶는다.
			-- (요청 2026-08-13 2차) 셋 다 MP 200을 쓴다(종전엔 용사 소환만 100).
			return "소환수 레벨 = 내 레벨의 " .. tostring(self:GetHeroSummonLevelPercent(lv)) .. "%\n(전투력도 그에 맞춰 상승)\n지속 5분, 재사용 대기시간 없음\nMP "
				.. tostring(self:GetSkillMpCost(skillName)) .. " 소모"
		elseif skillName == "매직클로" then
			-- (요청 2026-08-13 2차) 한 타당 = **더블샷 화살 1발과 같은 배율**(레벨 비례).
			-- ⚠ dmg() 헬퍼를 쓰지 않는다 - 레벨 성장이 배율 자체(GetMagicClawRate*Lv)에 들어갔다.
			local mcMinT = math.floor(self:GetMagicClawRateMinLv(lv) * 100 + 0.5)
			local mcMaxT = math.floor(self:GetMagicClawRateMaxLv(lv) * 100 + 0.5)
			return "한 타당 " .. tostring(mcMinT) .. "% ~ " .. tostring(mcMaxT)
				.. "%\n2타 합 " .. tostring(mcMinT * 2) .. "% ~ " .. tostring(mcMaxT * 2) .. "% (더블샷과 같다)\nMP "
				.. tostring(self:GetMagicClawMpCost()) .. " 소모"
		elseif skillName == "매직 미사일" then
			-- (요청 2026-08-13 2차) 구체 1개당 = **슬래시블러스트와 같은 배율**(레벨 비례).
			return "구체 1개당 " .. tostring(math.floor(self:GetMagicMissileMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetMagicMissileMaxPercent(lv))) .. "% (슬래시블러스트와 같다)"
				.. "\n재사용 대기시간 " .. tostring(math.floor(self:GetMagicMissileCooldown())) .. "초\nMP "
				.. tostring(self:GetMagicMissileMpCost()) .. " 소모"
		elseif skillName == "썬더볼트" then
			return "주변 최대 6명에게 " .. tostring(math.floor(self:GetThunderboltMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetThunderboltMaxPercent(lv))) .. "%\n(홀리 에로우와 같은 데미지)\nMP "
				.. tostring(self:GetThunderboltMpCost()) .. " 소모"
		elseif skillName == "빙하지대" then
			return tostring(math.floor(self:GetGlacierZoneDurationLv(lv))) .. "초간 적중 시 10% 확률로 빙하 영역 생성\n2초마다 "
				.. tostring(math.floor(self:GetGlacierZoneMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetGlacierZoneMaxPercent(lv))) .. "% (10초 지속)\n맞은 적 30% 확률로 빙결\nMP "
				.. tostring(self:GetGlacierZoneMpCost()) .. " 소모"
		elseif skillName == "메디테이션" then
			-- 지속시간은 "N분 M초" 꼴로(다른 버프와 같은 형식). (요청 2026-08-14) 블레스와 같은 5분 고정.
			local mdSec = math.floor(self:GetMeditationDuration(lv))
			return "마력 +" .. tostring(2 * math.max(1, lv)) .. " (전투력 상승)\n지속 "
				.. tostring(math.floor(mdSec / 60)) .. "분 " .. tostring(mdSec % 60) .. "초\nMP "
				.. tostring(self:GetMeditationMpCost()) .. " 소모"
		elseif skillName == "체인라이트닝" then
			return "연쇄 최대 10명, 대상당 " .. tostring(math.floor(self:GetChainLightningMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetChainLightningMaxPercent(lv))) .. "%\n얼어붙은 적 적중 시 2초 기절\nMP "
				.. tostring(self:GetChainLightningMpCost()) .. " 소모"
		elseif skillName == "블리자드" then
			-- (표기 수정 2026-08-08) "20초"는 구 사양 잔재 - 실제 쿨타임 공식(GetBlizzardCooldown)을 읽는다.
			return "주위 적에게 " .. tostring(math.floor(self:GetBlizzardMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetBlizzardMaxPercent(lv))) .. "% (제네시스와 같다)\n재사용 대기시간 "
				.. tostring(math.floor(self:GetBlizzardCooldown(lv))) .. "초\nMP " .. tostring(self:GetBlizzardMpCost()) .. " 소모"
		elseif skillName == "파이어에로우" then
			return "관통 최대 3명, 대상당 " .. tostring(math.floor(self:GetFireArrowMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetFireArrowMaxPercent(lv))) .. "%\n(홀리 에로우와 같은 데미지)\n적중 시 20% 확률로 4초 화상\nMP "
				.. tostring(self:GetFireArrowMpCost()) .. " 소모"
		elseif skillName == "불의 영역" then
			return tostring(math.floor(self:GetFireZoneDurationLv(lv))) .. "초간 적중 시 10% 확률로 화염 지대 생성\n2초마다 "
				.. tostring(math.floor(self:GetFireZoneMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetFireZoneMaxPercent(lv))) .. "% (10초 지속)\n(빙하지대와 같은 데미지·지속·MP)\n틱마다 10% 확률로 4초 화상\nMP "
				.. tostring(self:GetFireZoneMpCost()) .. " 소모"
		elseif skillName == "포이즌 미스트" then
			return "독안개 40초 유지, 1초마다 " .. tostring(math.floor(self:GetPoisonMistMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetPoisonMistMaxPercent(lv))) .. "%\n(크리티컬 없음)\n익스플로젼으로 터뜨리면 폭발 피해\nMP "
				.. tostring(self:GetPoisonMistMpCost()) .. " 소모"
		elseif skillName == "익스플로젼" then
			return "주변 최대 6명에게 " .. tostring(math.floor(self:GetExplosionMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetExplosionMaxPercent(lv))) .. "%\n주변 독안개 최대 6개 유폭 (같은 데미지)\nMP "
				.. tostring(self:GetExplosionMpCost()) .. " 소모"
		elseif skillName == "메테오" then
			return "운석 20개 (주변 적 우선), 운석당 최대 6명\n" .. tostring(math.floor(self:GetMeteorMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetMeteorMaxPercent(lv))) .. "% (제네시스와 같다)\n재사용 대기시간 "
				.. tostring(math.floor(self:GetMeteorCooldown(lv))) .. "초\nMP " .. tostring(self:GetMeteorMpCost()) .. " 소모"
		elseif skillName == "엘퀴네스" then
			return "최대 6명에게 " .. tostring(math.floor(self:GetElquinesMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetElquinesMaxPercent(lv))) .. "% (프리져와 같다)\n지속 "
				.. tostring(math.floor(self:GetElquinesDuration(lv))) .. "초, 재사용 대기시간 30초\nMP "
				.. tostring(self:GetElquinesMpCost()) .. " 소모"
		elseif skillName == "리커버리 마나" then
			return "60초 오로라 설치 (범위 안 쿨타임 무시)\n설치하는 순간 MP 전량 회복\n재사용 대기시간 "
				.. tostring(math.floor(self:GetRecoveryAuraCooldown(lv))) .. "초"
		elseif skillName == "이프리트" then
			return "최대 6명에게 " .. tostring(math.floor(self:GetIfritMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetIfritMaxPercent(lv))) .. "% (프리져와 같다)\n지속 "
				.. tostring(math.floor(self:GetIfritDuration(lv))) .. "초, 재사용 대기시간 30초\nMP "
				.. tostring(self:GetIfritMpCost()) .. " 소모"
		elseif skillName == "홀리 에로우" then
			return "최대 6명 관통, 대상당 " .. tostring(math.floor(self:GetHolyArrowMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetHolyArrowMaxPercent(lv))) .. "%\n(분배당 상승폭은 아이언 에로우와 같다)\nMP "
				.. tostring(self:GetHolyArrowMpCost()) .. " 소모"
		elseif skillName == "힐" then
			return "회복량 = 최대 HP의 " .. tostring(math.floor(self:GetHealPercent(lv))) .. "%\nMP "
				.. tostring(self:GetHealMpCost()) .. " 소모"
		elseif skillName == "블레스" then
			-- (요청 2026-08-14 2차) 지속시간이 투자 레벨 비례가 되어 "N분 M초"로 보여준다(메디테이션과 같은 형식).
			local blSec = math.floor(self:GetBlessBuffDurationLv(lv))
			return "공격력 +" .. tostring(self:GetBlessAttackBonus(lv)) .. ", 마력 +" .. tostring(self:GetBlessAttackBonus(lv))
				.. "\nSTR·DEX·LUK·INT 각 +" .. tostring(self:GetBlessStatBonus(lv))
				.. "\n지속 " .. tostring(math.floor(blSec / 60)) .. "분 " .. tostring(blSec % 60)
				.. "초 (자신 + 힐 범위 안 소환 아군)\nMP " .. tostring(self:GetBlessMpCost()) .. " 소모"
		elseif skillName == "텔레포트" then
			return "소모 MP " .. tostring(self:GetTeleportMpCost(lv))
		elseif skillName == "샤이닝 레이" then
			return "최대 30명에게 " .. tostring(math.floor(self:GetShiningRayMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetShiningRayMaxPercent(lv))) .. "%\n재사용 대기시간 "
				.. tostring(math.floor(self:GetShiningRayCooldown(lv))) .. "초\nMP "
				.. tostring(self:GetShiningRayMpCost()) .. " 소모"
		elseif skillName == "홀리 매직쉘" then
			return "개체마다 10회 완전 방어\n재사용 대기시간 " .. tostring(math.floor(self:GetHolyShellCooldown(lv)))
				.. "초\nMP " .. tostring(self:GetHolyShellMpCost()) .. " 소모"
		elseif skillName == "바하뮤트" then
			-- (요청 2026-08-13 2차) 데미지·MP·무쿨까지 **프리져와 같은 규격**(지속시간만 바하뮤트 고유).
			return "최대 6명에게 " .. tostring(math.floor(self:GetBahamutMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetBahamutMaxPercent(lv))) .. "% (프리져와 같다)\n지속 "
				.. tostring(math.floor(self:GetBahamutDuration(lv))) .. "초, 재사용 대기시간 없음\nMP "
				.. tostring(self:GetBahamutMpCost()) .. " 소모"
		elseif skillName == "제네시스" then
			return "기둥당 최대 6명, " .. tostring(math.floor(self:GetGenesisMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetGenesisMaxPercent(lv))) .. "%\n재사용 대기시간 "
				.. tostring(math.floor(self:GetGenesisCooldown(lv))) .. "초 (누르고 있으면 대기시간마다 재시전)\nMP "
				.. tostring(self:GetGenesisMpCost()) .. " 소모"
		elseif skillName == "리커버리 오로라" then
			return "60초 오로라 설치 (범위 안 쿨타임 무시)\n재사용 대기시간 "
				.. tostring(math.floor(self:GetRecoveryAuraCooldown(lv))) .. "초\nMP "
				.. tostring(self:GetRecoveryAuraMpCost()) .. " 소모"
		elseif skillName == "리저렉션" then
			return "죽은 소환 용사 부활 (HP 가득 + 지속시간 초기화)\n재사용 대기시간 "
				.. tostring(math.floor(self:GetResurrectionCooldown(lv))) .. "초\nMP "
				.. tostring(self:GetResurrectionMpCost()) .. " 소모"
		elseif skillName == "엔젤레이" then
			return "최대 10명 관통, 대상당 " .. tostring(math.floor(self:GetAngelRayMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetAngelRayMaxPercent(lv))) .. "%\n시전 후 0.5초 추가 후딜\nMP "
				.. tostring(self:GetAngelRayMpCost()) .. " 소모"
		elseif skillName == "스나이핑" then
			-- 기본 데미지 + 게이지 배율(완충 100배)을 곱한 완충 실효값까지 같이 보여준다.
			local snMin = math.floor(self:GetSnipingMinPercent(lv))
			local snMax = math.floor(self:GetSnipingMaxPercent(lv))
			return "기본 " .. tostring(snMin) .. "% ~ " .. tostring(snMax) .. "%\n게이지 배율 최대 100배 (10%면 10배)\n완충 시 "
				.. tostring(snMin * 100) .. "% ~ " .. tostring(snMax * 100) .. "% (관통 최대 3명)\nMP "
				.. tostring(self:GetSnipingMpCost()) .. " 소모 (차지 시작 시)"
		elseif skillName == "피어싱" then
			-- 기본 데미지 + 기 배율(완충 10배)을 곱한 완충 실효값까지 같이 보여준다.
			local pcMin = math.floor(self:GetPiercingMinPercent(lv))
			local pcMax = math.floor(self:GetPiercingMaxPercent(lv))
			return "기본 " .. tostring(pcMin) .. "% ~ " .. tostring(pcMax) .. "%\n기 배율 최대 5배 (완충 "
				.. string.format("%.0f", self:GetPiercingFullChargeSeconds()) .. "초)\n완충 시 "
				.. tostring(pcMin * 5) .. "% ~ " .. tostring(pcMax * 5) .. "% (관통 최대 10명)"
		elseif skillName == "프리져" then
			-- (요청 2026-08-13) 데미지·지속시간 모두 투자 레벨이 정하고, 재사용 대기시간은 없어졌다.
			return "최대 6명에게 " .. tostring(math.floor(self:GetFreezerMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetFreezerMaxPercent(lv)))
				.. "%\n맞은 적 80% 확률 2초 빙결\n지속 " .. tostring(math.floor(self:GetFreezerDuration(lv)))
				.. "초, 재사용 대기시간 없음\nMP " .. tostring(self:GetFreezerMpCost()) .. " 소모"
		elseif skillName == "샤프 아이즈" then
			-- 위력%가 아니라 지속시간·크리티컬이 핵심인 버프 - 시전 분기와 같은 헬퍼 한 곳에서 계산한다.
			local seSec = math.floor(self:GetSharpEyesDuration(lv))
			return "지속 " .. tostring(math.floor(seSec / 60)) .. "분 " .. tostring(seSec % 60) .. "초\n크리티컬 확률 +"
				.. tostring(self:GetSharpEyesCritRate(lv)) .. "%\n크리티컬 데미지 +" .. tostring(self:GetSharpEyesCritDamage()) .. "% (전 구간 공통)"
		elseif skillName == "파워스트라이크" then
			-- (요청 2026-08-09) 기본 100%~120% + 분배 1포인트당 최소 +4%p / 최대 +6%p.
			-- ⚠ dmg() 헬퍼를 쓰면 안 된다 - 그건 공용 위력 배율(0.6~1.0)을 곱하는데, 이 스킬은
			--   레벨 성장이 배율 자체에 들어가 있어 그 배율을 쓰지 않는다(이중 적용 방지).
			return "검 데미지 " .. tostring(math.floor(self:GetPowerStrikeMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetPowerStrikeMaxPercent(lv))) .. "%\nMP " .. tostring(self:GetPowerStrikeMpCost()) .. " 소모"
		elseif skillName == "슬래시블러스트" then
			-- (요청 2026-08-09) 기본 50%~60% + 분배 1포인트당 최소 +2%p / 최대 +3%p.
			-- dmg()를 쓰지 않는 이유는 파워스트라이크와 동일.
			return "주변 최대 6명에게 " .. tostring(math.floor(self:GetSlashBlastMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetSlashBlastMaxPercent(lv))) .. "%\nHP " .. tostring(self:GetSlashBlastHpCost())
				.. ", MP " .. tostring(self:GetSlashBlastMpCost()) .. " 소모"
		elseif skillName == "러시" then
			return "질주, 재사용 대기시간 " .. string.format("%.1f", self:GetRushCooldownForLevel(lv)) .. "초"
		elseif skillName == "파이널어택" then
			return "발동 확률 " .. string.format("%.0f", self:GetFinalAttackChanceForLevel(lv)) .. "%, 추가 데미지 " .. dmg(15) .. "~" .. dmg(30) .. "%"
		elseif skillName == "부스터" then
			return "공격 속도 +" .. tostring((lv >= 10) and 20 or 10) .. "%, 지속 " .. tostring(math.floor(self:GetHeroBuffDuration(lv))) .. "초\nMP " .. tostring(self:GetSecondBuffMpCost()) .. " 소모"
		elseif skillName == "섬광" then
			return "재사용 대기시간 " .. string.format("%.2f", self:GetFlashCooldownForLevel(lv)) .. "초"
		elseif skillName == "분노" then
			return "전투력 +" .. tostring(math.max(1, lv)) .. "%, 지속 " .. tostring(math.floor(self:GetHeroBuffDuration(lv))) .. "초\nMP " .. tostring(self:GetSecondBuffMpCost()) .. " 소모"
		elseif skillName == "파워가드" then
			return "받는 피해 -" .. tostring(math.max(1, lv)) .. "%, 지속 " .. tostring(math.floor(self:GetHeroBuffDuration(lv))) .. "초\n피격 후 3초마다 총 3회, 입은 피해의 " .. tostring(2 * math.max(1, lv)) .. "% 회복\nMP " .. tostring(self:GetSecondBuffMpCost()) .. " 소모"
		elseif skillName == "콤보 어택" then
			-- (요청 2026-08-16) 구슬당 최종 데미지 2% → **3%** 고정, 레벨 성장은 지속시간(70초+분배당 8초)으로 이동.
			local cap = math.min(5, 1 + math.floor(math.max(1, lv) / 5))
			return "지속 " .. tostring(math.floor(self:GetComboDurationForLevel(lv) / 60)) .. "분 " .. tostring(math.floor(self:GetComboDurationForLevel(lv)) % 60) .. "초, 구슬당 최종 데미지 +3%\n최대 구슬 " .. tostring(cap) .. "개, 적중 획득 확률 " .. tostring(math.min(40, 10 + lv)) .. "%\nMP " .. tostring(self:GetComboAttackMpCost()) .. " 소모"
		elseif skillName == "패닉" then
			-- (요청 2026-08-12) 구슬당 1레벨 180~240% → 마스터(20) 360~480%. dmg()의 공용 위력 배율은
			-- 쓰지 않는다 - 레벨 성장이 배율 자체에 들어가 이중 적용이 되므로(파워스트라이크와 같은 사유).
			return "구슬 전량 소모 단일 일격\n구슬당 " .. tostring(math.floor(self:GetPanicMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetPanicMaxPercent(lv))) .. "%\nMP " .. tostring(self:GetOrbSkillMpCost()) .. " 소모"
		elseif skillName == "코마" then
			return "구슬 전량 소모 광역 일격(최대 15명)\n구슬당 " .. tostring(math.floor(self:GetComaMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetComaMaxPercent(lv))) .. "%\nMP " .. tostring(self:GetOrbSkillMpCost()) .. " 소모"
		elseif skillName == "아이템 감각" then
			-- (요청 2026-08-12) 초보자 패시브 3종 - 분배당 효과를 [현재/다음 레벨] 툴팁에 표시한다.
			-- (요청 2026-08-15) 분배당 1% → **0.5%** (마스터 200 = +100%). 0.5 단위라 소수 첫째 자리 고정.
			local isPct = string.format("%.1f", 0.5 * math.max(0, lv))
			return "아이템 드롭률 +" .. isPct .. "%\n메소 획득량 +" .. isPct .. "%"
		elseif skillName == "무기 숙련" then
			return "공격력 +" .. tostring(math.max(0, lv)) .. ", 마력 +" .. tostring(math.max(0, lv))
		elseif skillName == "민첩 훈련" then
			return "공격 속도 +" .. tostring(math.floor(math.max(0, lv) / 5)) .. "% (5포인트당 1%)"
		elseif skillName == "HP 회복" then
			-- (요청 2026-08-12 4차) 분배당 초당 0.05% - 완전 회복까지 걸리는 시간도 함께 보여준다.
			local hrPct = 0.05 * math.max(0, lv)
			if hrPct <= 0 then return "자연 회복 없음 (분배 1포인트당 초당 0.05%)" end
			return "1초에 최대 HP의 " .. string.format("%.2f", hrPct) .. "% 회복\n(가득 차기까지 "
				.. tostring(math.floor(100 / hrPct)) .. "초)"
		elseif skillName == "MP 회복" then
			local mrPct = 0.05 * math.max(0, lv)
			if mrPct <= 0 then return "자연 회복 없음 (분배 1포인트당 초당 0.05%)" end
			return "1초에 최대 MP의 " .. string.format("%.2f", mrPct) .. "% 회복\n(가득 차기까지 "
				.. tostring(math.floor(100 / mrPct)) .. "초)"
		elseif skillName == "어드밴스드 콤보" then
			-- (요청 2026-08-12) 구슬 상한은 콤보 어택과 같은 5레벨 주기(최대 10개), 2개 동시 획득은 분배당 1%.
			-- (요청 2026-08-12 2차) "구슬당 데미지 +2%/분배" 폐지 - 어드콤은 구슬 상한·2개 동시 획득만 담당.
			local ext = (lv >= 1) and math.min(5, 1 + math.floor(lv / 5)) or 0
			return "최대 구슬 " .. tostring(5 + ext) .. "개(빨간 구슬)\n구슬 2개 동시 획득 " .. tostring(math.max(0, lv)) .. "%\n콤보 어택 소모 MP 100"
		elseif skillName == "돌진" then
			-- (요청 2026-08-12) 90~120% + 분배당 최소·최대 각 +3%p. dmg()의 공용 위력 배율은 쓰지 않는다
			-- (레벨 성장이 배율에 직접 들어가 이중 적용이 되므로 - 파워스트라이크와 같은 사유).
			local rsLv = math.max(1, lv)
			return "돌진 데미지 " .. tostring(math.floor(90 + 3 * (rsLv - 1))) .. "% ~ " .. tostring(math.floor(120 + 3 * (rsLv - 1))) .. "%"
		elseif skillName == "브랜디쉬" then
			-- (요청 2026-08-12) 줄당 180~240% + 분배당 최소·최대 각 +4%p (마스터 30 = 296~356%).
			local targets = 4 + 2 * math.min(2, math.floor(lv / 10))
			local bdLv = math.max(1, lv)
			local bdMin = math.floor(180 + 4 * (bdLv - 1))
			local bdMax = math.floor(240 + 4 * (bdLv - 1))
			return "첫 타 " .. tostring(bdMin) .. "%~" .. tostring(bdMax) .. "%\n연격 2타 각 " .. tostring(bdMin) .. "%~" .. tostring(bdMax) .. "%\n최대 " .. tostring(targets) .. "명 동시 타격"
		elseif skillName == "아이언 월" then
			return "받는 피해 -" .. tostring(2 * math.max(1, lv)) .. "%, 지속 " .. tostring(math.floor(self:GetHeroBuffDuration(lv))) .. "초"
		elseif skillName == "속성필드" then
			return "버프 지속 " .. tostring(math.floor(self:GetHeroBuffDuration(lv))) .. "초\n차지 블로우 필드 지속 " .. tostring(10 + math.floor(lv / 2)) .. "초\nMP " .. tostring(self:GetElementalFieldMpCost()) .. " 소모"
		elseif skillName == "속성 증폭" then
			return "연계 장판(2초마다 " .. tostring(math.floor(200 * (1 + 0.1 * lv))) .. "%~" .. tostring(math.floor(400 * (1 + 0.1 * lv))) .. "%) 데미지 +" .. tostring(10 * lv) .. "%"
		elseif skillName == "리스토네이션" then
			return "5초 동안 1초마다 최대 HP " .. tostring(math.max(1, lv)) .. "% 회복\n(총 " .. tostring(math.max(1, lv) * 5) .. "%)\nMP " .. tostring(self:GetRestorationMpCost()) .. " 소모"
		elseif skillName == "차지 블로우" then
			-- (요청 2026-08-12 2차) 파워스트라이크 곡선에서 독립 - 180~240%에서 분배당 각 +4%p.
			return "속성 검격 " .. tostring(math.floor(self:GetChargeBlowMinPercent(lv))) .. "% ~ "
				.. tostring(math.floor(self:GetChargeBlowMaxPercent(lv))) .. "%\nMP " .. tostring(self:GetChargeBlowMpCost()) .. " 소모"
		elseif skillName == "디바인 스윙 강화" or skillName == "디바인 스티그마 강화" or skillName == "디바인 저지먼트 강화" then
			return "해당 속성 차지 블로우 데미지 +" .. tostring(2 * lv) .. "%"
		elseif skillName == "디바인 차지" then
			-- (2026-08-15) 디바인 차지만 +3%/pt - UseSkillInSlot의 enhBonus(0.03)와 같은 값이어야 한다.
			return "빛 속성 차지 블로우 데미지 +" .. tostring(3 * lv) .. "%"
		elseif skillName == "가드" then
			return "가드 성공 시 2초 무적 + 10초간 받는 피해 -" .. tostring(5 * math.max(1, lv)) .. "%\n재사용 대기시간 " .. tostring(30 - (math.max(1, lv) - 1)) .. "초\nMP " .. tostring(self:GetGuardMpCost()) .. " 소모"
		elseif skillName == "궁병 지원" then
			return "화살당 " .. tostring(math.floor(self:GetArcherSupportMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetArcherSupportMaxPercent(lv))) .. "%"
		elseif skillName == "스피어 버스터" then
			-- 줄당 데미지 + 구간별 동시 타격 수(시전 분기와 동일한 공식 - 위 헬퍼 한 곳에서 계산).
			return "한 줄당 " .. tostring(math.floor(self:GetSpearBurstMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetSpearBurstMaxPercent(lv))) .. "%\n최대 " .. tostring(self:GetSpearBurstTargetCount(lv)) .. "명 동시 타격 (3연타)\nMP " .. tostring(self:GetSpearBurstMpCost()) .. " 소모"
		elseif skillName == "어드밴스드 스피어 버스터" then
			-- 자기 자신은 위력%가 없고 스피어 버스터에 더해지는 보너스만 있다 - 합산 결과까지 같이 보여준다.
			local sbLvAdv = math.max(1, self:GetHeroSkillLevelByName("스피어 버스터"))
			local totalMin = self:GetSpearBurstMinPercent(sbLvAdv) + self:GetAdvSpearBurstMinBonus(lv)
			local totalMax = self:GetSpearBurstMaxPercent(sbLvAdv) + self:GetAdvSpearBurstMaxBonus(lv)
			return "스피어 버스터 한 줄당 최소 +" .. tostring(math.floor(self:GetAdvSpearBurstMinBonus(lv)))
				.. "%p / 최대 +" .. tostring(math.floor(self:GetAdvSpearBurstMaxBonus(lv))) .. "%p\n(현재 스피어 버스터 "
				.. tostring(math.floor(totalMin)) .. "% ~ " .. tostring(math.floor(totalMax)) .. "%)\n사용 시 강화 이펙트 ON/OFF (데미지는 그대로)"
		elseif skillName == "드래곤 블러드" then
			-- 지속시간은 "N분 M초" 꼴로 - 1레벨 3분에서 마스터 10분까지 늘어난다.
			local dbSec = math.floor(self:GetDragonBloodDurationForLevel(lv))
			return "지속 " .. tostring(math.floor(dbSec / 60)) .. "분 " .. tostring(dbSec % 60) .. "초, 공격력 +"
				.. tostring(self:GetDragonBloodAttackBonus(lv)) .. "\n10초마다 최대 HP 4% 소모 (10% 이하 자동 해제)\n소환 용 타격 시 최대 HP "
				.. tostring(self:GetDragonBloodHealPercent(lv)) .. "% 회복\nMP " .. tostring(self:GetDragonBloodMpCost()) .. " 소모"
		elseif skillName == "드래곤 로어" then
			return "주변 최대 20명에게 " .. tostring(math.floor(self:GetDragonRoarPercent(lv))) .. "%~"
				.. tostring(math.floor(self:GetDragonRoarMaxPercent(lv))) .. "%\n사용 시 최대 HP " .. tostring(math.floor(self:GetDragonRoarHpCostPercent(lv))) .. "% 소모"
		elseif skillName == "용 소환" then
			-- 지속시간은 "N분 M초" 꼴로 - 1레벨 2분에서 마스터 10분까지 늘어난다.
			local sdSec = math.floor(self:GetSixDragonsDurationForLevel(lv))
			return "지속 " .. tostring(math.floor(sdSec / 60)) .. "분 " .. tostring(sdSec % 60) .. "초 (1분마다 1마리 추가)\n마리당 " .. tostring(math.floor(self:GetDragonDamageMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetDragonDamageMaxPercent(lv))) .. "%\n생존 1마리당 공격력 +10"
		elseif skillName == "드래곤 라이딩" then
			-- 지속시간도 "N분 M초" 꼴로 표기한다(용 소환/힐러 소환과 같은 형식).
			local rdSec = math.floor(self:GetDragonRideDurationForLevel(lv))
			return "지속 " .. tostring(math.floor(rdSec / 60)) .. "분 " .. tostring(rdSec % 60) .. "초, 재사용 대기시간 5분\n드래곤 공격 " .. tostring(math.floor(self:GetDragonDamageMinPercent(lv))) .. "% ~ " .. tostring(math.floor(self:GetDragonDamageMaxPercent(lv))) .. "%\n탑승 이동속도 " .. tostring(math.floor(self:GetDragonRideSpeedMult(lv) * 100 + 0.5)) .. "%"
		elseif skillName == "힐러 소환" then
			local hlSec = math.floor(self:GetHealerDurationForLevel(lv))
			-- (요청 2026-08-10) 힐 성능 절반 하향 - 실제 적용은 HealerSummon.RollHealAmount(분모 200)이고,
		-- 표기도 같은 절반 값(GetHealerHealPercent/2 - 1.5%~5%)으로 맞춘다.
		return "지속 " .. tostring(math.floor(hlSec / 60)) .. "분 " .. tostring(hlSec % 60) .. "초, 재사용 대기시간 3분\n힐 1회당 내 최대 HP의 " .. tostring(self:GetHealerHealPercent(lv) / 2) .. "%\n힐러 HP = 내 최대 HP의 " .. tostring(self:GetHealerHpPercent(lv)) .. "%"
		elseif skillName == "발도술" then
			-- 위력%가 아니라 지속시간·중첩이 핵심인 버프 - 시전 분기와 같은 공식
			-- (요청 2026-08-12: 지속시간은 분노와 동일 곡선 GetHeroBuffDuration, 중첩 상한 1(1~9)/2(10~19)/3(20)).
			local btSec = math.floor(self:GetHeroBuffDuration(math.max(1, lv)))
			local btCap = 1
			if lv >= 20 then btCap = 3
			elseif lv >= 10 then btCap = 2 end
			local btText = tostring(btSec) .. "초"
			if btSec >= 60 then
				local btMin = math.floor(btSec / 60)
				local btRem = btSec % 60
				btText = tostring(btMin) .. "분"
				if btRem > 0 then btText = btText .. " " .. tostring(btRem) .. "초" end
			end
			return "지속 " .. btText .. ", 지속 중 공격 속도 +10%\n공격 시 3초간 중첩(최대 " .. tostring(btCap) .. "중첩)\n중첩당 공격 속도 +3%, 크리티컬 확률 +3%"
		elseif skillName == "서먼 다크드래곤" then
			-- (요청 2026-08-12 3차) 지속 10초 + 분배당 5초 / 공격 90~100% + 분배당 각 3%p - 시전 분기와 같은 헬퍼.
			local ddSec = math.floor(self:GetDarkDragonDurationForLevel(lv))
			local ddText = tostring(ddSec) .. "초"
			if ddSec >= 60 then
				local ddM = math.floor(ddSec / 60)
				local ddR = ddSec % 60
				ddText = tostring(ddM) .. "분"
				if ddR > 0 then ddText = ddText .. " " .. tostring(ddR) .. "초" end
			end
			return "지속 " .. ddText .. ", 재사용 대기시간 없음\n드래곤이 3~7초마다 "
				.. tostring(math.floor(self:GetDarkDragonMinPercent(lv))) .. "%~"
				.. tostring(math.floor(self:GetDarkDragonMaxPercent(lv))) .. "%로 공격\nMP "
				.. tostring(self:GetDarkDragonMpCost()) .. " 소모"
		end
		local pct = math.floor(m * 100 + 0.5)
		return "스킬 위력 " .. tostring(pct) .. "%"
	end

	-- (스킬 효과 개편) 서버 판정용 스킬 레벨 동기화 - 투자 변경/복원 시마다 호출된다.
	@ExecSpace("ClientOnly")
	method void SyncSkillEffectsToServer()
		self:RequestSyncSkillEffects(
			self:GetHeroSkillLevelByName("파이널어택"),
			self:GetHeroSkillLevelByName("콤보 어택"),
			self:GetHeroSkillLevelByName("어드밴스드 콤보"),
			self:GetHeroSkillLevelByName("브랜디쉬"),
			self:GetHeroSkillLevelByName("속성 증폭"))
		-- (신궁 개편 2026-08-06) 더블 점프의 상시 이동 속도(+1%/분배)는 서버 MovementComponent를
		-- 건드려야 해서 별도 RPC로 넘긴다. ⚠ 위 RequestSyncSkillEffects에 인자를 더하지 않는다(LEA-1102 회피).
		self:RequestSyncArcherPassives(self:GetHeroSkillLevelByName("더블 점프"))
		-- (요청 2026-08-12) 돌진 데미지가 레벨 비례(90~120% + 3%p/pt)로 바뀌어 레벨 동기화가 필요하다.
		-- 위 두 RPC와 같은 이유로 인자를 더하지 않고 전용 RPC로 보낸다(LEA-1102 회피).
		self:RequestSyncRushLevel(self:GetHeroSkillLevelByName("돌진"))
		-- (요청 2026-08-07) 활(보우마스터 shoot1) / 석궁(신궁 shoot2) 시전 모션을 서버가 고르려면
		-- 직업 인덱스가 필요하다 - GetSelectedCharacterJobIdx는 ClientOnly라 여기서 함께 넘긴다.
		self:SyncArcherJobIdxToServer()
	end

	@ExecSpace("ClientOnly")
	method void SyncArcherJobIdxToServer()
		-- 직업 인덱스를 서버 PlayerAttack에 밀어준다(활/석궁 시전 모션 선택용).
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if pa == nil then return end
		pa:SyncArcherJobIdx(math.floor(_UIMyInfoManager:GetSelectedCharacterJobIdx()))
	end

	@ExecSpace("Server")
	method void RequestSyncRushLevel(integer rushLv)
		-- (요청 2026-08-12) 돌진 투자 레벨을 서버 PlayerAttack에 반영한다(데미지 배율 계산용).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local paRL = player:GetComponent(PlayerAttack)
		if not isvalid(paRL) then return end
		paRL:SetRushLevel(rushLv)
	end

	@ExecSpace("Server")
	method void RequestSyncArcherPassives(integer doubleJumpLv)
		-- 신궁 상시 패시브(현재는 더블 점프의 이동 속도뿐)를 서버에 반영한다.
		-- 투자 변경/복원 시마다 SyncSkillEffectsToServer가 함께 호출한다.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if isvalid(pa) then
			pa:SetArcherPassiveLevels(doubleJumpLv)
		end
	end

	@ExecSpace("ClientOnly")
	method string FindSkillBarSlot(number cx, number cy)
		local bar = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar")
		if not isvalid(bar) then return "" end
		local barPos = bar.UITransformComponent.anchoredPosition
		local row1 = {"Q","W","E","R","1","2","3","4","T","U","V","X"}
		local row2 = {"A","S","D","F","5","6","7","8","G","H","J","L"}
		local xOff = {-224, -160, -96, -32, 32, 96, 160, 224, 288, 352, 416, 480}
		for i, k in ipairs(row1) do
			local sx = barPos.x + xOff[i]
			local sy = barPos.y + 36
			if math.abs(cx - sx) <= 30 and math.abs(cy - sy) <= 30 then return k end
		end
		for i, k in ipairs(row2) do
			local sx = barPos.x + xOff[i]
			local sy = barPos.y - 36
			if math.abs(cx - sx) <= 30 and math.abs(cy - sy) <= 30 then return k end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void OnAssaulterResult(boolean success)
		-- PlayerAttack.NotifyAssaulterResult가 서버 판정 결과를 알려주면 호출된다. 성공했을 때만 스택을
		-- 1개 소모하고 충전 사이클을 (돌고 있지 않다면) 시작한다 - 실패(사거리 내 대상 없음)면 아무것도
		-- 소모하지 않아 즉시 다시 시도할 수 있다.
		self._T.assaulterRequestPending = false
		if not success then
			log("[SkillManager] 어썰터 실패 - 사거리 내 대상 없음(스택 소모 안 함)")
			return
		end
		self._T.assaulterStacks = math.max(0, self._T.assaulterStacks - 1)
		log("[SkillManager] 어썰터 발동 성공 (남은 스택 " .. tostring(self._T.assaulterStacks) .. "/" .. tostring(self._T.assaulterMaxStacks) .. ")")
		-- 시전 진행 중 잠금 - 착지 알림(OnAssaulterChainReady)이 오면 즉시 풀린다. 알림이 유실되는
		-- 비정상 상황 대비 2초 뒤 자동 해제 안전장치(세대 번호로 다음 시전의 잠금을 건드리지 않게 한다).
		self._T.assaulterCastActive = true
		self._T.assaulterCastGuardSerial = self._T.assaulterCastGuardSerial + 1
		local guardSerial = self._T.assaulterCastGuardSerial
		_TimerService:SetTimerOnce(function()
			if self._T.assaulterCastGuardSerial == guardSerial then
				self._T.assaulterCastActive = false
			end
		end, 2.0)
		self:UpdateAssaulterStackUI()
		self:StartAssaulterRecharge()
	end

	@ExecSpace("ClientOnly")
	method void OnAssaulterChainReady()
		-- 서버(PlayerAttack.ReappearAssaulter)가 착지(순간이동 완료)를 알려주면 곧바로 재시전 가능
		-- 상태로 만든다 - "이동 즉시 딜레이 없이 어썰터만은 연속으로 사용" 요청의 핵심 신호.
		self._T.assaulterCastActive = false
		log("[SkillManager] 어썰터 착지 - 연속 시전 가능")
	end

	@ExecSpace("ClientOnly")
	method string FindAssaulterSlotKey()
		-- 어썰터가 현재 배정된 단축키를 찾는다(없으면 빈 문자열).
		for key, slot in pairs(self._T.slotData) do
			if slot ~= nil and slot.name == "어썰터" then return key end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void StartAssaulterRecharge()
		-- 스택이 최대 미만이고 충전 타이머가 없으면 충전 사이클을 시작한다. 사이클 완료 시 스택 +1,
		-- 아직 최대가 아니면 다음 사이클을 이어서 시작한다 - 그림자(회색 오버레이) 효과도 사이클마다
		-- 다시 차오르므로 풀스택까지 최대 3번 반복해서 차오른다 (요청사항).
		-- (섀도어 개편 2026-08-06) 1사이클 길이가 3초 고정 → **투자 레벨별**(1레벨 10초 / 10레벨 8초 /
		-- 20레벨 6초 / 30레벨 5초)로 바뀌었다. 공식은 GetAssaulterChargeSeconds 한 곳에 있다.
		if self._T.assaulterRechargeTimerId ~= nil then return end
		if self._T.assaulterStacks >= self._T.assaulterMaxStacks then return end
		local chargeSec = self:GetAssaulterChargeSeconds(math.max(1, self:GetHeroSkillLevelByName("어썰터")))
		local key = self:FindAssaulterSlotKey()
		local barPos = key ~= "" and self:GetBarPosForKey(key) or ""
		if barPos ~= "" then
			_AssaulterCooldownUI:ShowCooldownV2(chargeSec, barPos)
		end
		self._T.assaulterRechargeTimerId = _TimerService:SetTimerOnce(function()
			self._T.assaulterRechargeTimerId = nil
			self._T.assaulterStacks = math.min(self._T.assaulterMaxStacks, self._T.assaulterStacks + 1)
			log("[SkillManager] 어썰터 스택 충전 완료 (" .. tostring(self._T.assaulterStacks) .. "/" .. tostring(self._T.assaulterMaxStacks) .. ")")
			self:UpdateAssaulterStackUI()
			self:StartAssaulterRecharge()
		end, chargeSec)
	end

	@ExecSpace("ClientOnly")
	method void UpdateAssaulterStackUI()
		-- 스택 수 표시(단축키 아이콘 우측 아래)를 최신 상태로 갱신한다.
		-- AssaulterCooldownUI는 Slot_<위치> 경로를 쓰므로 키 이름을 퀵슬롯 위치로 변환해 넘긴다.
		local key = self:FindAssaulterSlotKey()
		local barPos = key ~= "" and self:GetBarPosForKey(key) or ""
		_AssaulterCooldownUI:UpdateStackDisplay(self._T.assaulterStacks, self._T.assaulterMaxStacks, barPos)
	end

	@ExecSpace("ClientOnly")
	method void AssignSkillToSlot(string key, string ruid, string name)
		-- key = 키 이름 (퀵슬롯 위치가 아님). 해당 키가 퀵슬롯에 연결되어 있으면 그 칸도 갱신된다.
		-- 한 키에는 스킬 또는 기능(장비/인벤/공격/점프...) 중 하나만 올 수 있다 - 기능 키는 거부한다.
		if _KeySettingManager:GetFuncOnKey(key) ~= "" then
			log("[SkillManager] 기능 키 [" .. key .. "] 에는 스킬을 배정할 수 없음: " .. tostring(name))
			return
		end
		-- (요청) 패시브 스킬은 퀵슬롯에 올릴 수 없다 - 보유만으로 항상 적용된다.
		if self:IsPassiveSkillName(name) then
			log("[SkillManager] [" .. tostring(name) .. "] 패시브 - 퀵슬롯 배정 불가")
			_UIToast:ShowMessage("패시브 스킬은 퀵슬롯에 올릴 수 없습니다.")
			return
		end
		-- (요청) 스킬 포인트 미투자 스킬은 퀵슬롯에 올릴 수 없다 (로그인 복원 ImportHotkeys도 이 경로라 함께 걸러짐)
		if not self:IsSkillUsableByInvestment(name) then
			log("[SkillManager] [" .. tostring(name) .. "] 스킬 포인트 미투자 - 퀵슬롯 배정 불가")
			_UIToast:ShowMessage("스킬 포인트를 투자해야 사용할 수 있습니다.")
			return
		end
		self._T.slotData[key] = { ruid = ruid, name = name }
		local pos = self:GetBarPosForKey(key)
		if pos ~= "" then self:UpdateBarSlotVisual(pos) end
		_KeySettingManager:NotifyHotkeysChanged()
		log("[SkillManager] 슬롯 배정: [" .. key .. "] = " .. name)
		-- 단축키 배정 변경 영속 저장 예약 (캐릭터별로 저장되어 재접속 시 복원됨)
		_CharacterPersistence:MarkDirty("hotkey")
		-- 어썰터 배정 위치가 바뀌었을 수 있으므로 스택 수 표시 위치/표시 여부를 갱신한다.
		self:UpdateAssaulterStackUI()
	end

	-- 현재 단축키 배정 상태를 저장용 테이블로 내보낸다 (CharacterPersistence 전용).
	@ExecSpace("ClientOnly")
	method table ExportHotkeys()
		local out = {}
		for key, slot in pairs(self._T.slotData) do
			if slot ~= nil and slot.ruid ~= nil and slot.ruid ~= "" then
				out[key] = { ruid = slot.ruid, name = tostring(slot.name or "") }
			end
		end
		return out
	end

	-- 저장된 단축키 배정을 복원한다 (CharacterPersistence/키세팅 프리셋 전용). 전체 초기화 후 저장된 항목만 배정.
	@ExecSpace("ClientOnly")
	method void ImportHotkeys(table hotkeys)
		self._T.slotData = {}
		self:InitBarIcons()
		if hotkeys == nil then return end
		for key, slot in pairs(hotkeys) do
			if slot ~= nil and slot.ruid ~= nil and slot.ruid ~= "" then
				local keyName = tostring(key)
				-- 과거 세이브 호환: 기능 키(E 등)에 배정돼 있던 스킬은 더 이상 발동하지 않으므로
				-- 첫 번째 빈 퀵슬롯 키로 옮겨준다.
				if _KeySettingManager:GetFuncLabel(keyName) ~= "" then
					local moved = ""
					for _, p in ipairs(self._T.barPositions) do
						local cand = self:GetKeyForBarPos(p)
						local existing = self._T.slotData[cand]
						if _KeySettingManager:GetFuncLabel(cand) == "" and (existing == nil or existing.ruid == "") and (hotkeys[cand] == nil or hotkeys[cand].ruid == nil or hotkeys[cand].ruid == "") then
							moved = cand
							break
						end
					end
					if moved ~= "" then
						log("[SkillManager] 기능 키 [" .. keyName .. "]의 스킬을 [" .. moved .. "]로 이동: " .. tostring(slot.name))
						keyName = moved
					end
				end
				-- (발도술 아이콘 교체 대응) 저장된 슬롯은 저장 당시의 ruid를 들고 있어, 카탈로그에서 스킬
				-- 아이콘을 바꿔도 복원 슬롯엔 옛 아이콘이 남는다 - 이름이 카탈로그에 있으면 카탈로그의
				-- 최신 ruid로 재해석한다(카탈로그에 없는 항목 - HP포션 등 - 은 저장값 그대로).
				local savedName = tostring(slot.name or "")
				local resolved = self:FindSkillByName(savedName)
				local useRuid = tostring(slot.ruid)
				if resolved ~= nil and resolved.ruid ~= nil and resolved.ruid ~= "" then
					useRuid = resolved.ruid
				end
				self:AssignSkillToSlot(keyName, useRuid, savedName)
			end
		end
	end

	-- ── OnUpdate ──────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- (리커버리 오로라) 오로라 범위에 들어오는 순간을 감지해 남아있던 쿨타임을 전부 초기화한다.
		self:RecoveryAuraTick(delta)

		-- (요청 2026-08-08) 표시 레벨 변동 감시 - 스킬창 SP 즉시 갱신 + 레벨 하락 시 분배 즉시 회수.
		self:LevelWatchTick(delta)

		-- (아대 기본공격) 장비는 클라이언트에만 있으므로 아대 장착 상태를 서버에 주기적으로 보고한다.
		self:ClawStateTick(delta)

		-- (표창+) 표창 선택 중이면 3초 카운트다운 + 링을 캐릭터 위치에 붙여 따라가게 한다.
		self:ShurikenSelectTick(delta)

		-- 속사 연사 유지(조준 각도 보간 + 0.5초 간격 발사). 연사 중이 아니면 즉시 반환한다.
		self:RapidFireTick(delta)

		-- 폭풍의 시 연사 유지(0.2초 간격 발사 + 좌/우 방향 전환). 연사 중이 아니면 즉시 반환한다.
		self:HurricaneTick(delta)

		-- 스나이핑 차지 유지(게이지 누적 + 단계 전환 + 릴리즈 발사). 차지 중이 아니면 즉시 반환한다.
		self:SnipingTick(delta)
		-- (피어싱 2026-08-06) 스나이핑과 같은 차지 틱 - 완충 1초라 매 프레임 누적이 필요하다.
		self:PiercingTick(delta)

		-- (요청) 기본공격 홀드 연사 - 공격 키를 누르고 있는 동안 일정 간격으로 기본공격을 반복한다.
		self:BasicAttackHoldTick()

		local cursor  = _InputService:GetCursorPosition()
		local ghostUI = Vector2(cursor.x - 960, cursor.y - 540)

		-- 1-frame 지연 툴팁 표시
		if self._T.pendingShow then
			self._T.pendingShow = false
			if self._T.hovering then self:ShowSkillTooltip() end
		end

		-- (버그 수정) 스킬 카드 호버 툴팁 - Touch 엔티티에 raycast 그래픽이 없어 UITouchEnter/Exit가
		-- 실제 마우스에서 오지 않는다. 클릭 판정과 동일한 좌표 폴링으로 카드 툴팁 + "+"/"-" 버튼
		-- 힌트("Shift+좌클릭 시 최대 분배/회수")를 함께 처리한다. (0.05초 스로틀)
		if (self._T.nextHoverPoll or 0) <= _UtilLogic.ElapsedSeconds then
			self._T.nextHoverPoll = _UtilLogic.ElapsedSeconds + 0.05
			self:UpdateSkillHover(ghostUI.x, ghostUI.y)
		end

		-- 창 드래그
		if self._T.isDragging then
			if not _InputService:IsKeyPressed(KeyboardKey.Mouse0) then
				self._T.isDragging = false
			else
				local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
				if isvalid(w) then
					local newX = ghostUI.x - self._T.dragOffsetX
					local newY = ghostUI.y - self._T.dragOffsetY
					if newX < -900 then newX = -900 elseif newX > 900 then newX = 900 end
					if newY < -500 then newY = -500 elseif newY > 500 then newY = 500 end
					w.UITransformComponent.anchoredPosition = Vector2(newX, newY)
				end
			end
		end

		-- 스크롤 썸 드래그
		if self._T.isDraggingSkillThumb then
			if not _InputService:IsKeyPressed(KeyboardKey.Mouse0) then
				self._T.isDraggingSkillThumb = false
			else
				local win = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
				if isvalid(win) then
					local winPos   = win.UITransformComponent.anchoredPosition
					local topLimit = 111
					local botLimit = -147
					local newThumbY = ghostUI.y - winPos.y - self._T.skillThumbDragOffsetY
					newThumbY = math.max(botLimit, math.min(topLimit, newThumbY))
					local tabSkills = self:GetTabSkills(self._T.activeSkillTab)
					local maxRow    = math.max(0, math.ceil(#tabSkills / 2) - 5)
					local progress  = (topLimit - newThumbY) / (topLimit - botLimit)
					local newRow    = math.floor(progress * maxRow + 0.5)
					newRow = math.max(0, math.min(maxRow, newRow))
					local rowChanged = newRow ~= self._T.skillScrollRow
					self._T.skillScrollRow = newRow
					local th = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow/SkillScrollThumb")
					if isvalid(th) then
						th.UITransformComponent.anchoredPosition = Vector2(268, newThumbY)
					end
					if rowChanged then self:UpdateSkillViewport() end
				end
			end
		end

		-- 스크롤 트랙 홀드
		if self._T.isHoldingSkillTrack and not self._T.isDraggingSkillThumb then
			if not _InputService:IsKeyPressed(KeyboardKey.Mouse0) then
				self._T.isHoldingSkillTrack = false
			else
				self._T.skillTrackTimer = self._T.skillTrackTimer + delta
				if self._T.skillTrackTimer >= 0.12 then
					self._T.skillTrackTimer = 0.0
					self:SkillScrollTrackStep()
				end
			end
		end

		-- 클릭 배정 모드: 고스트 커서 따라다님
		if self._T.skillClickMode then
			local ghost = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillDragGhost")
			if isvalid(ghost) then
				ghost.UITransformComponent.anchoredPosition = ghostUI
			end
			-- 스킬창/키세팅 창이 모두 닫히면 배정 모드도 취소
			-- (퀵슬롯에서 집은 스킬은 창 없이도 들고 다닐 수 있으므로 예외)
			local cWin = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
			local skillWinOpen = isvalid(cWin) and cWin.Enable
			local keySettingOpen = _KeySettingManager:IsWindowOpen()
			if not skillWinOpen and not keySettingOpen and self._T.clickModeOrigin ~= "bar" then
				self:ClearSkillSelection()
			else
				-- 새 클릭이 스킬바 슬롯/스킬창/키세팅 창 어디에도 해당하지 않으면(빈 곳 클릭) 배정 해제
				local mouseDown = _InputService:IsKeyPressed(KeyboardKey.Mouse0)
				if mouseDown and self._T.clickModePrevMouse ~= true then
					local slotKey = self:FindSkillBarSlot(ghostUI.x, ghostUI.y)
					local insideWin = false
					if skillWinOpen then
						local wp = cWin.UITransformComponent.anchoredPosition
						local ws = cWin.UITransformComponent.RectSize
						if math.abs(ghostUI.x - wp.x) <= ws.x / 2 and math.abs(ghostUI.y - wp.y) <= ws.y / 2 then
							insideWin = true
						end
					end
					local insideKeySetting = _KeySettingManager:IsPointInWindow(ghostUI.x, ghostUI.y)
					if slotKey == "" and not insideWin and not insideKeySetting then
						-- 스킬은 여분 슬롯에 보관하지 않는다 - 빈 곳에 놓으면 단축키에서 제거된다
						-- (스킬창에서 언제든 다시 가져올 수 있음. 스킬창 출신은 원본이 그대로라 취소일 뿐)
						if self._T.clickModeOrigin == "window" then
							log("[SkillManager] 빈 곳 클릭 — 클릭 배정 취소")
						else
							log("[SkillManager] 빈 곳 클릭 — 제거: " .. self._T.clickModeName)
						end
						self:ClearSkillSelection()
					end
				end
				self._T.clickModePrevMouse = mouseDown
			end
		else
			self._T.clickModePrevMouse = _InputService:IsKeyPressed(KeyboardKey.Mouse0)
		end

		-- 스킬 드래그 (고스트 이동 + 드롭)
		if self._T.isDraggingSkill then
			local ghost = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillDragGhost")
			if isvalid(ghost) then
				ghost.UITransformComponent.anchoredPosition = ghostUI
			end
			if not _InputService:IsKeyPressed(KeyboardKey.Mouse0) then
				self._T.isDraggingSkill = false
				local dropPos = self:FindSkillBarSlot(ghostUI.x, ghostUI.y)
				local ksKey = _KeySettingManager:FindBindKeyAt(ghostUI.x, ghostUI.y)
				local dropKey = ""
				if dropPos ~= "" then dropKey = self:GetKeyForBarPos(dropPos) elseif ksKey ~= "" then dropKey = ksKey end
				if dropKey ~= "" and _KeySettingManager:GetFuncOnKey(dropKey) ~= "" then
					-- 기능이 배정된 키 위에 드랍 → 배정 불가, 원래 자리로 되돌린다 (스킬이 사라지지 않게)
					if isvalid(ghost) then ghost.Enable = false end
					if self._T.dragSource == "bar" and self._T.dragFromKey ~= "" then
						self:AssignSkillToSlot(self._T.dragFromKey, self._T.dragSkillRUID, self._T.dragSkillName)
					end
					log("[SkillManager] 기능 키 [" .. dropKey .. "] 에는 스킬을 놓을 수 없음 — 되돌림")
					self._T.dragSkillRUID = ""
					self._T.dragSkillName = ""
					self._T.dragSource    = ""
					self._T.dragFromKey   = ""
				elseif dropPos ~= "" then
					-- 슬롯 위에서 릴리즈 → 그 슬롯에 연결된 키에 즉시 배정
					if isvalid(ghost) then ghost.Enable = false end
					self:AssignSkillToSlot(dropKey, self._T.dragSkillRUID, self._T.dragSkillName)
					self._T.dragSkillRUID = ""
					self._T.dragSkillName = ""
					self._T.dragSource    = ""
					self._T.dragFromKey   = ""
				elseif ksKey ~= "" then
					-- 키세팅 창의 키 타일 위에서 릴리즈 → 그 키에 즉시 배정
					if isvalid(ghost) then ghost.Enable = false end
					self:AssignSkillToSlot(ksKey, self._T.dragSkillRUID, self._T.dragSkillName)
					self._T.dragSkillRUID = ""
					self._T.dragSkillName = ""
					self._T.dragSource    = ""
					self._T.dragFromKey   = ""
				elseif self._T.dragSource == "window" then
					-- 스킬창에서 드래그 후 빈 곳 릴리즈 → 클릭 배정 모드 진입
					self._T.skillClickMode = true
					self._T.clickModeRUID  = self._T.dragSkillRUID
					self._T.clickModeName  = self._T.dragSkillName
					self._T.clickModeOrigin = "window"
					log("[SkillManager] 클릭 배정 모드 진입: " .. self._T.dragSkillName)
					self._T.dragSkillRUID = ""
					self._T.dragSkillName = ""
					self._T.dragSource    = ""
					self._T.dragFromKey   = ""
				else
					-- 바에서 드래그 후 빈 곳 릴리즈 → 슬롯 비워짐
					if isvalid(ghost) then ghost.Enable = false end
					log("[SkillManager] 허공에 드랍 — [" .. self._T.dragFromKey .. "] 슬롯 비워짐")
					self._T.dragSkillRUID = ""
					self._T.dragSkillName = ""
					self._T.dragSource    = ""
					self._T.dragFromKey   = ""
				end
			end
		end

		-- 스킬 키 홀드 지속 공격: 쿨다운(스킬 딜레이)이 끝난 시점에 키가 아직 눌려있으면
		-- 떼었다 다시 누르지 않아도 자동으로 이어서 재시전한다. HP포션/미구현 스킬 등
		-- 쿨다운을 사용하지 않는 슬롯은 대상에서 제외해 기존 동작을 그대로 유지한다.
		if not self._T.skillOnCooldown then
			for key, held in pairs(self._T.heldSkillKeys) do
				if held and not self._T.skillOnCooldown then
					local slot = self._T.slotData[key]
					if slot ~= nil and (slot.name == "달팽이 세마리" or slot.name == "파워스트라이크" or slot.name == "슬래시블러스트" or slot.name == "슬래쉬블래스트" or slot.name == "럭키세븐" or slot.name == "트리플 스로우" or slot.name == "쿼드러플 스로우" or slot.name == "더블스탭" or slot.name == "매직클로" or slot.name == "매직 미사일" or slot.name == "썬더볼트" or slot.name == "체인라이트닝" or slot.name == "힐" or slot.name == "파이어에로우" or slot.name == "아이언 에로우" or slot.name == "엔젤레이" or slot.name == "홀리 에로우" or slot.name == "에로우 블로우" or slot.name == "에로우 봄" or slot.name == "더블샷" or slot.name == "스트레이프" or slot.name == "아이스 샷" or slot.name == "파이어 샷" or slot.name == "헤이스트" or slot.name == "스피어 버스터" or slot.name == "어벤져" or slot.name == "드래곤 로어" or slot.name == "새비지블로우" or slot.name == "브랜디쉬" or slot.name == "차지 블로우" or slot.name == "암살") then
						self:UseSkillInSlot(key)
					end
				end
			end
		end

		-- 돌진 홀드 지속 사용(요청): 돌진은 공용 쿨다운 외에 자체 쿨타임(rushOnCooldown, 1초)도 있어서
		-- 위 공용 홀드 반복 블록에 그냥 얹으면 자체 쿨타임 중에도 매 프레임 UseSkillInSlot을 불러
		-- "돌진: 쿨타임 중" 로그만 초당 60줄씩 쌓인다. 두 쿨다운을 여기서 함께 확인해 실제로 쓸 수
		-- 있을 때만 재시전한다.
		if not self._T.skillOnCooldown and not self._T.rushOnCooldown then
			for key, held in pairs(self._T.heldSkillKeys) do
				if held and not self._T.skillOnCooldown and not self._T.rushOnCooldown then
					local slot = self._T.slotData[key]
					if slot ~= nil and slot.name == "돌진" then
						self:UseSkillInSlot(key)
					end
				end
			end
		end

		-- (비숍 개편 2026-08-08) 제네시스 홀드 지속 사용: "누르고 있으면 계속 나가야 한다"는 요청.
		-- 돌진과 같은 이유로 공용 홀드 블록에 얹지 않고 여기서 따로 처리한다 - 제네시스는 자체 쿨타임
		-- (genesisOnCooldown)이 있어서 그냥 얹으면 쿨타임 중에도 매 프레임 UseSkillInSlot을 불러
		-- "제네시스: 쿨타임 중" 로그만 초당 60줄씩 쌓인다. 두 쿨다운이 모두 풀렸을 때만 재시전한다.
		-- ⚠ 평소에는 쿨타임(1분 31초~2분)이 길어 사실상 1회 시전이고, 리커버리 오로라 안에서만
		--   쿨타임이 면제되어 실제 연사가 된다(요청의 "연사하는 타임").
		if not self._T.skillOnCooldown and not self._T.genesisOnCooldown then
			for key, held in pairs(self._T.heldSkillKeys) do
				if held and not self._T.skillOnCooldown and not self._T.genesisOnCooldown then
					local slot = self._T.slotData[key]
					if slot ~= nil and slot.name == "제네시스" then
						self:UseSkillInSlot(key)
					end
				end
			end
		end

		-- 텔레포트 홀드 지속 사용: 텔레포트는 공용 쿨다운(skillOnCooldown)과 무관한 독립 쿨다운
		-- (teleportOnCooldown)으로 동작하므로, 위 공용 홀드 반복 블록과 별도로 자신의 쿨다운만 확인해
		-- 키를 누르고 있으면 계속 이어서 사용되도록 한다.
		if not self._T.teleportOnCooldown then
			for key, held in pairs(self._T.heldSkillKeys) do
				if held then
					local slot = self._T.slotData[key]
					if slot ~= nil and slot.name == "텔레포트" then
						self:UseSkillInSlot(key)
					end
				end
			end
		end

		-- (요청) 드래곤 라이딩 홀드 지속 토글 - 키를 누르고 있으면 탑승 ↔ 해제가 1초 간격으로 반복된다.
		-- KeyDown 자동 반복이 안 오는 환경에서도 동작하도록 여기서도 같은 경로를 태운다
		-- (실제 간격 제어는 UseSkillInSlot의 dragonRideToggleUntil이 담당한다).
		for key, held in pairs(self._T.heldSkillKeys) do
			if held then
				local slot = self._T.slotData[key]
				if slot ~= nil and slot.name == "드래곤 라이딩" then
					self:UseSkillInSlot(key)
				end
			end
		end

		-- (기능 변경) 어썰터 홀드 지속 사용 - 스택형 충전으로 바뀌면서, 키를 누르고 있으면 스택이 있고
		-- 시전 중이 아닐 때(착지 즉시 잠금 해제) 계속 이어서 사용된다. 착지하자마자 다음 시전이 나가므로
		-- 스택이 남아있는 한 딜레이 없이 연속 발동된다.
		if self._T.assaulterStacks > 0 and not self._T.assaulterRequestPending and not self._T.assaulterCastActive then
			for key, held in pairs(self._T.heldSkillKeys) do
				if held then
					local slot = self._T.slotData[key]
					if slot ~= nil and slot.name == "어썰터" then
						self:UseSkillInSlot(key)
					end
				end
			end
		end
	end

end
