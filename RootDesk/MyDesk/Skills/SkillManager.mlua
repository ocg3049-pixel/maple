		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:SnipingHeartbeat(charge)
	end

	@ExecSpace("Server")
	method void RequestFireSnipingLv(number combatPower, number chargeRatio, number dirX, number stage, number rateMin, number rateMax)
		-- 스나이핑 시전 요청. ⚠ 기존 RequestFireSniping에 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피).
		-- rateMin/rateMax = 투자 레벨별 **기본** 배율(게이지 배율은 서버가 chargeRatio로 따로 곱한다).
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then
			log_warning("[SkillManager] RequestFireSnipingLv: player not found")
			return
		end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then
			log_warning("[SkillManager] RequestFireSnipingLv: PlayerAttack component not found")
			return
		end
		pa:AttackSnipingLv(combatPower, chargeRatio, dirX, stage, rateMin, rateMax)
	end

	@ExecSpace("Server")
	method void RequestCancelSniping()
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if not isvalid(player) then return end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return end
		pa:CancelSnipingHold()
	end

