@Logic
script ShurikenLibrary extends Logic

	-- 표창+ 스킬로 고를 수 있는 표창 9종의 리소스 표.
	-- 클라이언트(선택 UI 아이콘)와 서버(투사체 비행 모습) 양쪽에서 같은 표를 봐야 해서 @Logic으로 뺐다.
	--
	--   icon : 선택 UI에 뜨는 아이콘 sprite RUID
	--   fly  : 날아갈 때 재생하는 animationclip RUID (PlayEffectAttached)
	--   spin : true면 전용 비행 클립이 없어 **아이콘을 직접 회전시키며** 날린다(4번 토피/6번 일비).
	--   head : 비행 클립이 **회전값 0일 때 향하고 있는 방향(도)**. 0 = 오른쪽(+x), 180 = 왼쪽(-x).
	--          날아가는 각도는 (진행 방향 각도 - head)로 계산한다. 클립마다 원본 아트의 방향이 달라서
	--          추측하지 않고 화면으로 실측해 채웠다(회전 0으로 나란히 재생 → 스크린샷 대조).
	--          9종 전부 왼쪽(-x)을 보고 있었고, zRotation은 반시계 방향 양수다(렌더 방향 = head + zRotation).
	--   ox/oy: (spin 전용) 아이콘 스프라이트의 **중심이 엔티티 원점에서 얼마나 어긋나 있는지**(월드 유닛).
	--          이 아이콘들은 메이플 아이템 아이콘(0207xxxx)이라 피벗이 좌하단이다 - 그냥 ZRotation을 주면
	--          회전축이 왼쪽 아래 모서리라 "제자리 회전"이 아니라 원을 그리며 도는 것처럼 보인다(신고 내용).
	--          그래서 매 틱 엔티티 위치를 (표창 위치 - 회전시킨 ox/oy)로 보정해 중심이 제자리에 있게 한다.
	--          측정법: 알려진 월드 좌표에 회전 0으로 띄우고 WorldToScreenPosition과 실제 렌더 위치를 대조.
	--
	-- 1번은 원래 럭키세븐이 쓰던 표창 그대로다(fly = 551dec3d...).
	method table GetAll()
		-- 표창 9종의 (이름/아이콘/비행) 리소스 표를 돌려준다.
		return {
			[1] = { name = "표창",            icon = "5d2441df6e6f4446beb45b301cdba0f2", fly = "551dec3dbf5e4a9f8eae6c9933f41bf2", spin = false, head = 180, ox = 0,     oy = 0     },
			[2] = { name = "눈덩이",          icon = "68da7af5df33407bacd32057f54cef16", fly = "d496fde97610478397780d4c514e8093", spin = false, head = 180, ox = 0,     oy = 0     },
			[3] = { name = "고드름",          icon = "d660bfd2e6d44b9182f048e730db5b5f", fly = "db94dacc4a58427eb2cc8d8889371947", spin = false, head = 180, ox = 0,     oy = 0     },
			[4] = { name = "토피 표창",       icon = "7f8b5e3f0aa74eb89645d53b6d6fc710", fly = "",                                 spin = true,  head = 180, ox = 0.162, oy = 0.172 },
			[5] = { name = "뇌전 수리검",     icon = "f501c1cdba1f4b25b5a62449e504ab88", fly = "2fc1bc6b1de741458d3b83227097aa99", spin = false, head = 180, ox = 0,     oy = 0     },
			[6] = { name = "일비 표창",       icon = "598f25c8b05f4542a36f0ba339191246", fly = "",                                 spin = true,  head = 180, ox = 0.162, oy = 0.172 },
			[7] = { name = "무한의 수리검",   icon = "6108fb8918aa43f0b19cb11d9a6c4689", fly = "1ba8df0172be4ae7af632dec25459084", spin = false, head = 180, ox = 0,     oy = 0     },
			[8] = { name = "화이트 골드표창", icon = "6d6d7505e7ef458f9a269793844623d7", fly = "55db3f337d9f499fadfe3114206753d6", spin = false, head = 180, ox = 0,     oy = 0     },
			[9] = { name = "플레임 표창",     icon = "9314935c5bd447b5a11730565ff519f6", fly = "bde5998c85f842dfaec3d0b1a886b5b3", spin = false, head = 180, ox = 0,     oy = 0     },
		}
	end

	method integer GetCount()
		-- 표창 종류 수(9).
		return 9
	end

	-- (요청) "표창이 날아가기 시작한 점을 조금 낮추고 몬스터의 타격점을 시작점과 비슷한 높이로 올려달라."
	-- 캐릭터/몬스터의 TransformComponent 원점은 **발밑**이라, 대상 위치를 그대로 조준하면 표창이
	-- 몬스터 발 아래로 꺾여 어색하게 날아갔다. 던지는 높이와 조준 높이를 이 값 하나로 맞춘다.
	-- 같은 값을 쓰기 때문에 같은 지면에 선 몬스터는 표창이 **수평 직선**으로 날아가고,
	-- 대상이 없는 허공 투척도 자동으로 반듯한 직선이 된다.
	method number GetThrowHeight()
		-- 표창이 손을 떠나는 높이 = 대상을 조준하는 높이(발밑 기준 월드 유닛).
		return 0.3
	end

	method table Get(integer idx)
		-- 번호(1~9)로 표창 하나를 돌려준다. 범위를 벗어나면 1번으로 폴백한다.
		local all = self:GetAll()
		local t = all[idx]
		if t == nil then return all[1] end
		return t
	end

	-- ── 표창+ 4분할 (2026-08-05 개편) ────────────────────────────────────
	-- (요청) 표창+가 차수별 4개 스킬로 나뉘고, 각 스킬의 분배 포인트가 정해진 지점에 닿을 때마다
	-- 표창이 **1번부터 순서대로** 한 종씩 열린다. 네 스킬의 종류 수 합이 정확히 9종이다.
	--
	--   1차 표창+     마스터 20 - 포인트 1·10        → 1·2번
	--   2차 표창+ II  마스터 30 - 포인트 1·10        → 3·4번
	--   3차 표창+ III 마스터 30 - 포인트 1·10·20     → 5·6·7번
	--   4차 표창+ IV  마스터 20 - 포인트 1·10        → 8·9번
	--
	-- ⚠ 2차는 요청의 "1,10,20" 세 지점이 아니라 **1·10 두 지점**이다 - 요청서의 종류 수
	--   (1차 2종 / 2차 +2종 / 3차 +3종 / 4차 +2종 = 9종)를 만족시키려면 2차가 2종이어야 하고,
	--   표창은 9종뿐이라 종류 수 쪽을 기준으로 잡았다. 2차도 3종으로 하려면 표창 1종을 더 만들어야 한다.
	method table GetTiers()
		-- 차수별 표창+ 스킬 정보. points = 그 포인트에 도달하면 표창 1종이 열리는 지점(오름차순).
		return {
			[1] = { name = "표창+",     master = 20, points = {1, 10} },
			[2] = { name = "표창+ II",  master = 30, points = {1, 10} },
			[3] = { name = "표창+ III", master = 30, points = {1, 10, 20} },
			[4] = { name = "표창+ IV",  master = 20, points = {1, 10} },
		}
	end

	-- 이 차수의 표창+ 스킬이 여는 표창 번호들(1~9, 오름차순). 표창은 **1번부터 순서대로** 열리므로
	-- 앞 차수들이 여는 종류 수를 모두 더한 값이 이 차수의 시작 번호가 된다.
	-- (요청 2026-08-14 5차) 스킬 설명창이 "이 스킬로 열리는 표창마다 어떤 효과인지"를 보여주려면
	-- 번호 매핑이 필요해 신설했다 - GetTiers/GetEffect와 같은 표를 쓰므로 세 곳이 어긋나지 않는다.
	method table GetShurikenIndicesForTier(string tierName)
		local out = {}
		local start = 1
		for _, tier in ipairs(self:GetTiers()) do
			if tier.name == tierName then
				for i = 1, #tier.points do
					local idx = start + i - 1
					if idx <= self:GetCount() then table.insert(out, idx) end
				end
				return out
			end
			start = start + #tier.points
		end
		return out
	end

	-- 표창 종류별 장착 효과(그 표창을 "지금 던지는 표창"으로 고르고 있는 동안 상시 적용).
	--   atk   = 공격력(flatATK에 가산)
	--   crit  = 크리티컬 확률(%)
	--   speed = 공격속도 상승 단계
	method table GetEffect(integer idx)
		local eff = {
			[1] = { atk = 15, crit = 0,  speed = 0 },
			[2] = { atk = 17, crit = 0,  speed = 0 },
			[3] = { atk = 21, crit = 0,  speed = 0 },
			[4] = { atk = 23, crit = 0,  speed = 0 },
			[5] = { atk = 25, crit = 10, speed = 0 },
			[6] = { atk = 27, crit = 10, speed = 0 },
			[7] = { atk = 27, crit = 20, speed = 0 },
			[8] = { atk = 29, crit = 20, speed = 1 },
			[9] = { atk = 29, crit = 30, speed = 1 },
		}
		return eff[idx] or eff[1]
	end

end
