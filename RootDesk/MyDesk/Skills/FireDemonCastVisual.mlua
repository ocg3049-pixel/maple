@Component
script FireDemonCastVisual extends Component

	@ExecSpace("Client")
	method void Play(Vector3 anchor, number directionX)
		-- 한 SpriteRenderer에서 프레임만 교체한다. 각 위치는 WZ origin을
		-- ((width/2-originX)/100, (originY-height/2)/100)으로 환산한 값이다.
		local frames = {
			{ "de846b194b2e48b382e378d1406ea9e1", -0.990, 0.565 },
			{ "de879a5bfe3b4e34be15a8e2bef65d1a", -0.995, 0.470 },
			{ "3ec14781e2184dd4bc75adb8b11e14d9", -0.980, 0.435 },
			{ "f99d9b8c795b4683b0e9eb6cc9ccb31e", -0.965, 0.420 },
			{ "3700c7725df249c89af8932c58fdabde", -0.950, 0.410 },
			{ "095e28625d32436d80601a400c6ad6fd", -0.920, 0.360 },
			{ "ad7b59a2ebca419dbb9d9389ce524e0f", -0.905, 0.440 },
			{ "0808850e8a1e400c83f93bce6cece01d", -0.895, 0.440 },
			{ "4568c062f30d4101b2eb56dd12531c90", -0.890, 0.440 },
			{ "7bbd5c73828846ae82bdea25181b1adf", -1.005, 0.440 },
			{ "58a13b5f68f0467ea23c68c517597a6c", -1.135, 0.435 },
			{ "b733da98428047b2aa01d5248f3c8439", -1.280, 0.440 },
			{ "12a33362402a4ff5aa9ef9811cf171cb", -1.295, 0.435 },
			{ "be7e6432397b40719c41be3358d51019", -1.320, 0.370 },
			{ "a3c65f167acf4ed5a7ed70cca0bf4ac9", -1.195, 0.365 },
			{ "e55e0898534c4c68bea59fad8c8dfb36", -1.560, 0.380 },
			{ "b4d59e1ffa4a4b10a13696290445ef30", -1.560, 0.380 },
		}
		local sr = self.Entity.SpriteRendererComponent
		if not isvalid(sr) then return end
		local dir = directionX >= 0 and 1 or -1
		sr.SortingLayer = "MapLayer0"
		sr.OrderInLayer = 7
		sr.FlipX = dir < 0
		sr.Color = Color(1, 1, 1, 1)
		for i, frame in ipairs(frames) do
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) or not isvalid(sr) then return end
				sr.SpriteRUID = frame[1]
				-- origin X는 원본 좌향 기준 음수이므로 바라보는 방향의 앞쪽으로 부호를 뒤집는다.
				self.Entity.TransformComponent.WorldPosition = Vector3(anchor.x - frame[2] * dir, anchor.y + frame[3], anchor.z)
			end, (i - 1) * 0.1)
		end
		_TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self.Entity:Destroy() end end, #frames * 0.1 + 0.05)
		log("[FireDemonCastVisual] ori 정렬 17프레임 재생")
	end

end
