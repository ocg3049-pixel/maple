@Component
script HeroSummon extends Component

	-- 소환 용사 공용 컴포넌트. herosummon 모델(아바타 NPC: Rigidbody+Movement+AvatarRenderer+
	-- CostumeManager+NameTag)을 맵의 자식으로 스폰한 뒤 이 컴포넌트를 붙인다(PlayerAttack.SummonHeroClass).
	--
	-- (비숍 개편 2026-08-08) 소환 스킬이 **차수별 3종**으로 갈라지면서 이 컴포넌트가 셋을 모두 맡는다.
	--   · 용사 소환(2차) - 전사 3계열: hero / paladin / darkknight
	--   · 궁수 소환(3차) - 궁수 2계열: bowmaster / sniper
	--   · 도적 소환(4차) - 도적 2계열: nightlord / shadower
	-- 세 소환의 **규격은 완전히 같다**(지속 5분 / 레벨 = 주인 레벨의 N% / HP·전투력·장비·순간이동 규칙).
	-- 다른 것은 HeroLine이 정하는 두 가지뿐 - **무기·직업명·모션**과 **전투 스타일(스킬 풀)**이다.
	-- ⚠ 파일을 갈라 복제하지 않은 이유: 규격이 같은 셋을 세 파일로 두면 이동/HP/리저렉션/홀리매직쉘/
	--   블레스 같은 공통 경로가 곧바로 드리프트한다(리저렉션·홀리매직쉘은 script.HeroSummon 하나만
	--   훑어서 세 소환을 모두 처리한다).
	--
	-- 전사 계열은 레벨(플레이어의 N%)에 따라 직업명이 플레이어와 같은 구간(10/30/70/120)으로 바뀌며
	-- 직업별 스킬을 쓴다.
	--   검사(공통 1차): 파워스트라이크/슬래쉬블래스트 (공격 쿨타임 3~7초)
	--   파이터: +분노(30초) / 스피어맨: +파워가드(30초) / 페이지: +부스터(60초, 본인 것과 별개)
	--   크루세이더: +콤보어택(버프)+코마 / 용기사: +스피어버스터+드래곤로어(15~30초) / 나이트: +공속 2단계(60초)
	-- 이동은 서버 권한(몬스터와 동일): 발판 순찰/추적/점프/아랫점프, 주인과 10유닛 이상 멀어지면 순간이동.
	-- 아바타 모션은 상태머신 없이 클라이언트가 @Sync 값(LocoState/MotionCmd)을 보고 body 엔티티에
	-- ActionStateChangedEvent를 직접 보내 재생한다(컨트롤러가 없어 엔진 자동 재생과 충돌하지 않는다).

	property Entity OwnerEntity = nil            -- 서버 전용(소환한 플레이어)
	property number Lifetime = 300               -- 서버 전용 수명(초)
	property number HeroMaxHp = 100              -- 서버 전용: 최대 HP(주인 최대 HP의 2/3)
	property number HeroHp = 100                 -- 서버 전용: 현재 HP
	@Sync property number HeroLevel = 1          -- 용사 레벨(주인 레벨의 N% - 용사 소환 투자 레벨이 정한다: 1레벨 50% → 마스터 30에서 65%)
	-- 용사 레벨에 맞는 전투력. 소환 시점에 클라(SkillManager)가 레벨 곡선으로 환산해 서버로 넘긴다.
	-- 스킬 데미지는 전부 이 값 × 직업 스킬 배율(파워스트라이크 100~200% 등)로 계산된다.
	@Sync property number BaseCombatPower = 0
	-- 계열. 전사 hero/paladin/darkknight · 궁수 bowmaster/sniper · 도적 nightlord/shadower.
	@Sync property string HeroLine = "hero"
	@Sync property string LocoState = "stand"    -- stand / walk / jump (이동 모션)
	@Sync property string MotionCmd = ""         -- "seq|모션명|재생속도" - 1회성 스킬 모션 명령
	property integer HolyShell = 0                 -- 서버 전용: 홀리 매직쉘 잔여 방어 횟수(개체별)

	-- ── 셋업(서버) ────────────────────────────────────────────────
	-- SummonHero는 AddComponent 직후 프로퍼티(OwnerEntity/HeroLevel/HeroLine)만 대입한다
	-- (다크드래곤/라이딩드래곤과 동일 패턴). AddComponent와 같은 프레임에 메서드를 호출해
	-- self._T를 만지면 [LEA-2007] '_T' nil이 나거나 @Sync 대입이 유실될 수 있어(실측),
	-- 실제 초기화는 첫 ServerTick에서 지연 실행한다.

	@ExecSpace("ServerOnly")
	method void InitServer()
		-- 첫 서버 틱에서 1회 실행되는 지연 초기화(외형/네임태그/수명/버프 예약).
		self._T.dmgMult = 1.0
		self._T.atkCdMult = 1.0
		local now = _UtilLogic.ElapsedSeconds
		self._T.nextAttackAt = now + 1.0
		self._T.nextSpecialAt = now + 8.0 + _UtilLogic:RandomDouble() * 8.0
		-- (피드백) 소환 직후 발판 아래 몬스터를 향해 곧바로 떨어져 내려가지 않도록,
		-- 잠깐(1.5초)은 추적/점프 없이 주인 발판 위에 정착해 있다가 움직이기 시작한다.
		self._T.nextJumpAt = now + 1.5
		self._T.noChaseUntil = now + 1.5
		-- 외형: 고정 장비(드롭 아이템 방어구) + 직업별 무기 + 랜덤 헤어/성형 + 기본 바디
		self:ApplyCostume()
		-- 네임태그: 랜덤 한글 1~5글자 + "lv레벨" (예: 라라lv50)
		local ntc = self.Entity.NameTagComponent
		if isvalid(ntc) then
			ntc.Name = self:MakeRandomName() .. "lv" .. tostring(math.floor(self.HeroLevel))
		end
		-- 수명 만료 시 제거 (만료 시각은 리저렉션 부활 시 버프바 잔여시간 복원에도 쓴다)
		self._T.lifetimeEndAt = now + self.Lifetime
		_TimerService:SetTimerOnce(function()
			if isvalid(self.Entity) then
				log("[HeroSummon] 소환 종료(수명 " .. tostring(self.Lifetime) .. "초)")
				self.Entity:Destroy()
			end
		end, self.Lifetime)
		self:ScheduleBuff(true)
		self:SpawnHpBar()
		-- 몬스터 공격 피격(HitEvent) 수신 - 런타임 AddComponent라 정적 @EventSender 대신 명시 연결.
		self._T.hitEventHandler = self.Entity:ConnectEvent(HitEvent, self.OnHeroHit)
		self:PlaySummonFx()
		log("[HeroSummon] 소환 완료 line=" .. self.HeroLine .. " level=" .. tostring(math.floor(self.HeroLevel))
			.. " 직업=" .. self:GetJobName() .. " 전투력=" .. tostring(math.floor(self:GetCombatPower())))
	end

	@ExecSpace("ServerOnly")
	method void ApplyCostume()
		-- 드롭 아이템으로 나오는 방어구 셋 + 직업 계열별 무기 + 랜덤 헤어/성형.
		local cm = self.Entity.CostumeManagerComponent
		if not isvalid(cm) then return end
		local hairs = {
			"af5d7c460c314959b7062d9501d1aa90", "0018d872ea76464fa1c981d65753afe8",
			"00199c1161e843f8b1f3d3b92b039b8b",
		}
		local faces = {
			"fa3ba1e407a7476e938e60d6362b5a66", "002edb95ebe24b40856d19b9fc8ffe39",
			"003566cae02441718a5c0ed26b356f6f",
		}
		cm:SetEquip(MapleAvatarItemCategory.Body, "3cf4cb29ae344577b9eed37e531688a4")
		cm:SetEquip(MapleAvatarItemCategory.Hair, hairs[_UtilLogic:RandomIntegerRange(1, #hairs)])
		cm:SetEquip(MapleAvatarItemCategory.Face, faces[_UtilLogic:RandomIntegerRange(1, #faces)])
		cm:SetEquip(MapleAvatarItemCategory.Cap, "274b50c184c047d8abf1b520c958ce98")        -- 연두색 머리띠
		cm:SetEquip(MapleAvatarItemCategory.Cape, "aa8d1e49ff93486986fbb0f9b16d9565")       -- 엔틱 벨벳 망토
		cm:SetEquip(MapleAvatarItemCategory.Coat, "ae8d3590a96e48c3b7cd75d46ebd3f15")       -- 흰색 반팔티
		cm:SetEquip(MapleAvatarItemCategory.Pants, "61f10ef0a6204e0ab6593bdf36fed3e5")      -- 파란 청바지
		cm:SetEquip(MapleAvatarItemCategory.Glove, "2e58683f2f094f099a0813c36e278dd5")      -- 노가다 목장갑
		cm:SetEquip(MapleAvatarItemCategory.Shoes, "202544d7095c42c5bfb3046619ab58cc")      -- 가죽 샌들
		-- 무기: 계열별 직업 무기(RUID는 UIEquipInventoryManager.GetJobWeaponTable과 같은 값).
		--   히어로=목검(두손) / 팔라딘=카알대검(실측 한손 카테고리) / 다크나이트=창(두손)
		--   보우마스터=합금활(두손) / 신궁=석궁(두손) / 나이트로드=가니어(두손) / 섀도어=후르츠 대거(한손)
		-- ⚠ 카테고리를 잘못 넣으면 LEA-3005가 난다 - 후르츠 대거/카알대검만 OneHandedWeapon이다
		--   (IsOneHandedJobWeapon의 실측 결과와 같은 규칙).
		if self.HeroLine == "paladin" then
			cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "444f1da6365d4599a27bbfd207585856")
		elseif self.HeroLine == "darkknight" then
			cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "dcaddf14378045cdbc6f512fa1a29d39")
		elseif self.HeroLine == "bowmaster" then
			cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "33f389c9f73e45dc9c55a251b3cc2646")
		elseif self.HeroLine == "sniper" then
			cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "8601845b98014cec9b336041be103015")
		elseif self.HeroLine == "nightlord" then
			cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "985e44451afc4730a46eb206716e7ecf")
		elseif self.HeroLine == "shadower" then
			cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "1489702f013a4ba4a1ec080da4df17c3")
		else
			cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "43ad7bfeb9184252b24e6d60f76c17e5")
		end
	end

	-- 궁수 계열(보우마스터/신궁)인가. 무기·모션·스킬 풀이 여기서 갈린다.
	method boolean IsArcherLine()
		-- HeroLine 하나로 세 소환을 구분하므로, 계열 판정은 반드시 이 두 헬퍼만 쓴다.
		return self.HeroLine == "bowmaster" or self.HeroLine == "sniper"
	end

	-- 도적 계열(나이트로드/섀도어)인가.
	method boolean IsThiefLine()
		-- 나이트로드는 표창 투척, 섀도어는 단검 근접 - 같은 도적이어도 스킬 풀이 다르다.
		return self.HeroLine == "nightlord" or self.HeroLine == "shadower"
	end

	@ExecSpace("ServerOnly")
	method string MakeRandomName()
		-- 랜덤 한글 1~5글자 이름.
		local syl = {
			"라", "루", "리", "레", "로", "미", "나", "니", "도", "다", "한", "별", "솔", "윤", "채",
			"호", "은", "가", "온", "슬", "유", "진", "서", "아", "무", "백", "청", "강", "빛", "결",
		}
		local n = _UtilLogic:RandomIntegerRange(1, 5)
		local out = ""
		for i = 1, n do
			out = out .. syl[_UtilLogic:RandomIntegerRange(1, #syl)]
		end
		return out
	end

	-- ── 직업/스탯 계산 ────────────────────────────────────────────

	method number GetStage()
		-- 플레이어와 동일한 전직 구간: ~9 초보자(=1차 취급), 10~29 1차, 30~69 2차, 70~119 3차, 120+ 4차.
		local lv = self.HeroLevel
		if lv >= 120 then return 4 end
		if lv >= 70 then return 3 end
		if lv >= 30 then return 2 end
		return 1
	end

	method string GetJobName()
		-- 레벨에 따라 플레이어와 동일한 규칙으로 바뀌는 직업명.
		if self.HeroLevel <= 9 then return "초보자" end
		local names = { "검사", "파이터", "크루세이더", "히어로" }
		if self.HeroLine == "paladin" then names = { "검사", "페이지", "나이트", "팔라딘" }
		elseif self.HeroLine == "darkknight" then names = { "검사", "스피어맨", "용기사", "다크나이트" }
		elseif self.HeroLine == "bowmaster" then names = { "궁수", "헌터", "레인저", "보우마스터" }
		elseif self.HeroLine == "sniper" then names = { "궁수", "사수", "저격수", "신궁" }
		elseif self.HeroLine == "nightlord" then names = { "도적", "어쌔신", "허밋", "나이트로드" }
		elseif self.HeroLine == "shadower" then names = { "도적", "시프", "시프마스터", "섀도어" } end
		return names[self:GetStage()]
	end

	method number GetCombatPower()
		-- (신고 2026-08-07) "용사 데미지가 상당히 약하다."
		-- 구 공식 `HeroLevel × 10`은 **레벨 곡선과 무관한 선형값**이라, 레벨 137 주인(전투력 81만)
		-- 곁의 89레벨 용사가 890(주인의 1/900)이었다 - 직업 스킬 %를 제대로 곱해도 데미지가 안 나온다.
		-- 이제는 소환 시점에 클라가 레벨 곡선으로 환산해 넘긴 BaseCombatPower를 쓴다
		-- (= 주인 전투력 × 용사 레벨 요구 CP / 주인 레벨 요구 CP).
		-- ⚠ 0이면(구 세이브/미동기) 예전 공식으로 폴백해 최소한 0이 되지는 않게 한다.
		-- 블레스(주인 시전) 활성 중이면 그만큼 전투력이 더해진다(스킬 데미지가 전투력 비례라 공마 +30과 동치).
		local base = self.BaseCombatPower
		if base == nil or base <= 0 then base = self.HeroLevel * 10 end
		return base + (self._T.blessAtkBonus or 0)
	end

	@ExecSpace("ServerOnly")
	method void ApplyBlessBuff(integer atkBonus, number duration)
		-- 블레스(주인이 걸어주는 2차 버프): 지속시간 동안 전투력 +atkBonus. 재사용 시 중첩 없이
		-- 지속시간만 갱신한다(다른 버프들과 같은 토큰 패턴 - 이전 예약 만료를 무효화).
		if self._T.dying then return end
		self._T.blessToken = (self._T.blessToken or 0) + 1
		local tok = self._T.blessToken
		self._T.blessAtkBonus = atkBonus
		_TimerService:SetTimerOnce(function()
			if self._T.blessToken == tok then
				self._T.blessAtkBonus = 0
				log("[HeroSummon] 블레스 만료 - 전투력 원복")
			end
		end, duration)
		log("[HeroSummon] 블레스 수령 - 전투력 +" .. tostring(atkBonus) .. " (" .. tostring(duration) .. "초)")
	end

	---@type PlayerAttack
	method any GetOwnerAttack()
		-- 주인 플레이어의 PlayerAttack 컴포넌트(판정/데미지 파이프라인 재사용).
		if not isvalid(self.OwnerEntity) then return nil end
		return self.OwnerEntity:GetComponent("script.PlayerAttack")
	end

	-- ── 프레임 틱 ────────────────────────────────────────────────

	method void OnUpdate(number delta)
		-- 서버=이동/AI, 클라이언트=아바타 모션 반영.
		if self:IsServer() then
			self:ServerTick(delta)
		else
			self:ClientTick(delta)
		end
	end

	@ExecSpace("ServerOnly")
	method void ServerTick(number delta)
		if self._T.dying then return end
		local owner = self.OwnerEntity
		if not isvalid(owner) then
			-- SummonHero의 프로퍼티 대입이 아직 안 왔을 수 있어 2초까지는 기다렸다가 제거한다.
			self._T.noOwnerTime = (self._T.noOwnerTime or 0) + delta
			if self._T.noOwnerTime > 2.0 then
				self._T.dying = true
				self.Entity:Destroy()
			end
			return
		end
		-- 첫 틱 지연 초기화(AddComponent 동일 프레임 호출을 피한다 - 상단 주석 참고).
		if not self._T.inited then
			self._T.inited = true
			self:InitServer()
		end
		local tr = self.Entity.TransformComponent
		local mv = self.Entity.MovementComponent
		local rb = self.Entity.RigidbodyComponent
		if not isvalid(tr) or not isvalid(mv) or not isvalid(rb) then return end
		-- 주인이 다른 맵에 있으면 대기만 한다.
		if owner.CurrentMap ~= self.Entity.CurrentMap then
			mv:Stop()
			self._T.moving = false
			self:UpdateLoco(rb)
			return
		end
		local now = _UtilLogic.ElapsedSeconds
		local myPos = tr.WorldPosition
		-- (신고 2026-08-08 3차 "맵 좌우 끝을 넘어간다") 대시/비행/밀림이 플레이어 이동 한계 밖까지
		-- 밀어낼 수 있다 - 맵 경계(MapComponent:GetBound()) 안으로 되돌린다(1회성 rb 텔레포트).
		local mapB = self.Entity.CurrentMap
		if isvalid(mapB) and isvalid(mapB.MapComponent) then
			local bMin, bMax = mapB.MapComponent:GetBound()
			if bMin ~= nil and bMax ~= nil and bMax.x > bMin.x + 2.0 then
				-- 경계 밖 0.2유닛까지는 허용(GetBound가 실플레이 영역과 미세하게 다른 맵 오탐 방지).
				local clampedX = myPos.x
				if myPos.x < bMin.x - 0.2 then clampedX = bMin.x + 0.6
				elseif myPos.x > bMax.x + 0.2 then clampedX = bMax.x - 0.6 end
				if clampedX ~= myPos.x then
					rb:SetWorldPosition(Vector2(clampedX, myPos.y + 0.1))
					rb:PositionReset()
					self._T.rushingUntil = 0
					log("[HeroSummon] 맵 경계 밖 - 안쪽으로 복귀")
					myPos = tr.WorldPosition
				end
				-- (신고 2026-08-08 3차 "지형 없는 맵 아래로 떨어지면 안 돌아온다") 맵 세로 경계 아래로
				-- 벗어났으면 착지할 발판이 애초에 없다 - 장기 낙하 감시(4초)를 기다리지 않고 즉시
				-- 주인 곁으로 복귀한다. 착지 대기 중이던 하강 순환 상태도 함께 정리한다(이 경우 영영
				-- 안 끝난다).
				if myPos.y < bMin.y - 0.5 and bMax.y > bMin.y + 2.0 then
					local opNow = owner.TransformComponent.WorldPosition
					rb:SetWorldPosition(Vector2(opNow.x, opNow.y + 0.3))
					rb:PositionReset()
					self._T.droppingUntil = nil
					self._T.dropLastY = nil
					self._T.dropStallSince = nil
					self._T.fellBelowAt = nil
					self._T.airborneSince = nil
					self._T.target = nil
					self:PlayTeleportFx()
					log("[HeroSummon] 맵 아래 이탈 - 주인 곁으로 복귀 (y=" .. string.format("%.1f", myPos.y) .. ")")
					return
				end
			end
		end
		local ownerPos = owner.TransformComponent.WorldPosition
		-- 주인과 일정 거리(8유닛) 이상 멀어지면 주인 곁으로 순간이동.
		local odx = ownerPos.x - myPos.x
		local ody = ownerPos.y - myPos.y
		-- (신고 2026-08-08 3차 "지형 없는 맵 아래로 떨어지면 안 돌아온다 - 돌아올 때도 있다")
		-- 간헐 실패의 원인: 하강 순환(droppingUntil) 도중 발판 없는 허공으로 떨어지면 재배치가
		-- "착지 후에만" 실행되는데 착지가 영영 안 되고, droppingUntil≠nil이 수직 낙하 리쉬를
		-- inRecovery로 영구 차단했다(하강 순환 없이 떨어진 경우만 6.5초 폴백이 통해서 "가끔은" 복귀).
		-- → 어떤 상태였든 무조건 도는 **장기 낙하 감시**: 정상 낙하/점프는 2초를 넘지 않는다 -
		--   공중 4초면 발 디딜 발판이 없는 것이므로 하강 순환 상태를 정리하고 주인 곁으로 복귀한다.
		--   공중 텔레포트가 물리 예측에 밀려 되돌아올 수 있어 1.5초 간격으로 재시도한다(성공해
		--   착지하면 airborneSince가 풀려 시도가 멈춘다). 드래곤 비행(KinematicMove) 중은 제외.
		if rb:IsOnGround() then
			self._T.airborneSince = nil
		elseif self._T.flyDestX == nil then
			if self._T.airborneSince == nil then self._T.airborneSince = now end
			if now - self._T.airborneSince > 4.0 and (self._T.nextAirRescueAt or 0) <= now then
				self._T.nextAirRescueAt = now + 1.5
				rb:SetWorldPosition(Vector2(ownerPos.x, ownerPos.y + 0.3))
				rb:PositionReset()
				self._T.droppingUntil = nil
				self._T.dropLastY = nil
				self._T.dropStallSince = nil
				self._T.fellBelowAt = nil
				self._T.target = nil
				self:PlayTeleportFx()
				log("[HeroSummon] 장기 낙하 감지(발판 없음) - 주인 곁으로 복귀")
				return
			end
		end
		-- (요청 2026-08-08) 주인과 떨어질 수 있는 거리를 3배로(8 → 24유닛) - 넓은 맵에서 소환수가
		-- 자기 사냥터를 갖고 더 자유롭게 싸운다.
		-- ⚠ (신고 2026-08-08 "스폰 지점이 아니라 플레이어 위치로 나온다") 하강 재배치 중에는 이
		--   순간이동을 건너뛴다 - 떨어지는 동안 주인과의 거리가 벌어지면 재배치 목적지(SpawnLocation)에
		--   닿기 전에 이 경로가 먼저 주인 곁으로 데려가 버렸다.
		-- (신고 2026-08-08 "재배치 후에도 플레이어 위치에서 나타난다") 스폰 지역이 주인에게서 24유닛
		-- 이상 떨어져 있으면, 재배치 유예(2초)가 끝나는 순간 이 리쉬가 도로 주인 곁으로 끌고 갔다.
		-- **싸울 대상이 있는 동안에는 리쉬를 걸지 않는다** - 대상이 다 떨어졌을 때만 주인 곁으로 온다.
		-- (신고 2026-08-08 2차 "여전히 플레이어 위치로") 재배치 유예 5초가 끝나고 아직 대상을 못
		-- 찾았으면 이 리쉬가 즉시 주인 곁으로 끌고 갔다 - "대상 없음"이 **6초 이상 이어질 때만**
		-- 발동시켜, 스폰 지점에서 사냥감을 찾아 배회할 시간을 준다.
		if isvalid(self._T.target) then self._T.lastTargetAt = now end
		local isDropping = (self._T.droppingUntil or 0) > now or (self._T.leashGraceUntil or 0) > now
		if not isDropping and not isvalid(self._T.target) and (now - (self._T.lastTargetAt or now)) > 6.0
			and (odx * odx + ody * ody) > 576.0 and rb:IsOnGround() then
			rb:SetWorldPosition(Vector2(ownerPos.x, ownerPos.y + 0.3))
			rb:PositionReset()
			self._T.target = nil
			self:PlayTeleportFx()
			log("[HeroSummon] 주인과 멀어져 순간이동")
			return
		end
		-- (신고 2026-08-08 "소환수가 아래로 떨어지면 리스폰 없이 아래에 머문다") 수직 낙하 복귀 신설.
		-- 위 리쉬는 유클리드 24유닛 기준이라 아래층 낙하(수직 3~10유닛)로는 영영 발동하지 않고,
		-- 아래층에 사냥감이 있으면 lastTargetAt이 계속 갱신돼 더더욱 복귀하지 않았다. 사냥 수직 한계
		-- (PickTarget downLimit -3.0)보다 깊은 지대는 애초에 이 소환수의 사냥터가 아니다 - 주인보다
		-- fallLimit 이상 아래에 4초 넘게 머물면 **대상 유무와 무관하게** 주인 곁으로 순간이동한다.
		-- (하강 순환/재배치 유예/드래곤 비행 중에는 각자의 복귀 경로가 있어 제외. 텔레포트는 물리
		--  되돌림을 피해 착지 상태에서만, 주인이 공중(라이딩 비행 등)일 때는 허공 텔레포트가 되므로
		--  주인 착지도 함께 기다린다.)
		-- (신고 2026-08-08 2차 "여전히 저 아래에 머문다") 두 가지 구멍을 막는다.
		--   · 드래곤 보유 다크나이트의 한계 6.0이 실제 맵 층고(주인과 4~5유닛 차)보다 커서 발동하지
		--     않았다 - 전 직업 4.0으로 통일한다(아래로 깊이 내려가는 것 자체가 신고 대상).
		--   · 착지를 영영 못 하는 낙하(발판 없는 허공)는 IsOnGround 게이트에 걸려 복귀가 아예 안 됐다 -
		--     6.5초가 지나면 공중이어도 강제 복귀한다(PositionReset을 곁들이면 공중 텔레포트도 되돌림
		--     없이 먹는다 - 본체 ToggleDragonRide 실측과 동일 원리).
		local fallLimit = 4.0
		local inRecovery = self._T.droppingUntil ~= nil or (self._T.leashGraceUntil or 0) > now
			or self._T.flyDestX ~= nil
		if ody > fallLimit and not inRecovery then
			if self._T.fellBelowAt == nil then self._T.fellBelowAt = now end
			local ownerRb = owner.RigidbodyComponent
			local waited = now - self._T.fellBelowAt
			if (waited > 4.0 and rb:IsOnGround() or waited > 6.5)
				and (not isvalid(ownerRb) or ownerRb:IsOnGround()) then
				self._T.fellBelowAt = nil
				rb:SetWorldPosition(Vector2(ownerPos.x, ownerPos.y + 0.3))
				rb:PositionReset()
				self._T.target = nil
				self:PlayTeleportFx()
				log("[HeroSummon] 아래층 낙하 복귀 - 주인 곁으로 순간이동 (ody=" .. string.format("%.1f", ody) .. ")")
				return
			end
		elseif self._T.fellBelowAt ~= nil then
			self._T.fellBelowAt = nil
		end
		-- 소환 직후 정착 시간에는 추적하지 않고 제자리에 서 있는다.
		if (self._T.noChaseUntil or 0) > now then
			mv:Stop()
			self._T.moving = false
			self:UpdateLoco(rb)
			return
		end
		-- 대상 갱신: (피드백) 매번 랜덤 재선정하면 방향이 계속 뒤집히므로, 현재 대상이
		-- 살아있고 사거리(6.5) 안이면 그대로 유지하고, 죽거나 벗어났을 때만 새로 고른다.
		if (self._T.nextScanAt or 0) <= now then
			self._T.nextScanAt = now + 0.3
			local keep = false
			local cur = self._T.target
			if isvalid(cur) then
				---@type Monster
				local mc = cur:GetComponent("script.Monster")
				if isvalid(mc) and not mc.IsDead then
					local tp = cur.TransformComponent.WorldPosition
					local ddx = tp.x - myPos.x
					local ddy = tp.y - myPos.y
					-- 드래곤 보유 다크나이트는 비행으로 닿으므로 수직 유지 한계도 PickTarget과 같이
					-- **위쪽만** 연다(아래쪽을 열면 층층이 내려가는 원인 - PickTarget 주석 참고).
					local keepUp, keepDown = 2.2, -3.0
					if self.HeroLine == "darkknight" and isvalid(self._T.rideDragonEnt) then
						keepUp = 5.0
					end
					if (ddx * ddx + ddy * ddy) <= 42.25 and ddy <= keepUp and ddy >= keepDown then
						keep = true
					end
				end
			end
			if not keep then
				self._T.target = self:PickTarget(myPos)
			end
			-- (요청 2026-08-08) "공격할 방법이 마땅치 않을 때": 주변에 몬스터는 있는데(6유닛 스캔)
			-- 전부 사거리 밖 높이라 대상을 못 고르는 상태가 3초 이상 이어지면, 아랫점프로 맵 아래로
			-- 내려갔다가 스폰 지점에서 다시 나온다(자동사냥의 하강 순환과 같은 발상 - 몬스터가 있는
			-- 발판 라인으로 자연스럽게 재배치된다).
			if not isvalid(self._T.target) then
				---@type PlayerAttack
				local paS = self:GetOwnerAttack()
				local nearAny = false
				if isvalid(paS) then
					local anyList = paS:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 6.0, 1)
					nearAny = (anyList ~= nil and #anyList > 0)
				end
				if nearAny then
					if self._T.unreachableSince == nil then self._T.unreachableSince = now end
					if now - self._T.unreachableSince > 3.0 and (self._T.droppingUntil or 0) <= now then
						-- (요청 2026-08-08) 위층에만 적이 있으면 하강 대신 **올라가는 수단**을 먼저 쓴다 -
						-- 히어로는 섬광 도약, 드래곤을 가진 다크나이트는 탑승 비행. 그 외에만 하강 재배치.
						local above = nil
						local listAll = paS:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 6.0, 8)
						for _, tA in ipairs(listAll or {}) do
							if isvalid(tA) then
								local dyA = tA.TransformComponent.WorldPosition.y - myPos.y
								if dyA > 1.0 and dyA <= 5.0 then above = tA break end
							end
						end
						if above ~= nil and self.HeroLine == "hero" and self:GetStage() >= 2 then
							self._T.unreachableSince = nil
							self:CastFlashUpTo(above)
						elseif above ~= nil and self:IsArcherLine() and self:GetStage() >= 2 then
							-- (신고 2026-08-08 3차 "궁수가 위로 올라갈 때 체인샷을 안 쓴다")
							self._T.unreachableSince = nil
							self:CastChainShotUpTo(above)
						elseif above ~= nil and self.HeroLine == "darkknight" and isvalid(self._T.rideDragonEnt) then
							self._T.unreachableSince = nil
							self._T.target = above
							log("[HeroSummon] 위층 적 발견 - 드래곤 탑승 비행으로 접근")
						else
							-- (신고 2026-08-08 "맨 아래까지 안 떨어진다") 창 4초, 아랫점프 간격 0.4초.
							self._T.droppingUntil = now + 4.0
							log("[HeroSummon] 공격 가능한 대상 없음 - 하강 후 스폰 지점 재배치 시작")
						end
					end
				else
					self._T.unreachableSince = nil
				end
			else
				self._T.unreachableSince = nil
			end
		end
		-- (돌진/섬광/체인샷) 대시 틱: **대상 유무와 무관하게** 여기서 처리한다.
		-- (신고 2026-08-08 "돌진 중 방향이 바뀐다") 예전엔 ChaseTick 안에 있어서 대상이 죽으면
		-- RoamTick이 대신 돌며 증속 상태로 아무 방향으로나 걸었다 - 대시 동안은 다른 행동을 전부 막는다.
		if (self._T.rushingUntil or 0) > now then
			-- (신고 2026-08-08 "땅끝에서 안 끊기고 떨어진다") 공중 이탈 + **발판 끝 사전 감지**
			-- (PredictFootholdEnd) 양쪽에서 대시를 끝낸다. 세그먼트 경계 오탐으로 조금 일찍 멈출 수는
			-- 있지만(실측된 한계) 떨어지는 것보다 낫다 - 본체 돌진의 "발판 끝 정지"에 해당.
			-- (신고 2026-08-08 2차 "돌진을 제자리에서 쓴다") 시전 직후 0.12초는 이탈 검사를 면제한다 -
			-- 세그먼트 경계 오탐/시전 프레임의 공중 판정이 대시를 0틱 만에 끝내 제자리 돌진이 됐다.
			-- (신고 2026-08-08 4차 "체인샷으로 날아가는 도중 끊긴다") 체인샷 당김(rushIsChain)은 같은
			-- 층의 대상을 향하고 거리도 짧게 고정돼 있다 - 조각 발판 이음매의 PredictFootholdEnd 오탐과
			-- 순간 공중 판정으로 끊을 이유가 없다. 체인 당김은 **0.25초 연속 공중일 때만** 끊고 발판 끝
			-- 사전 감지는 건너뛴다(돌진/섬광 대시는 기존 규칙 유지). 중간에 끊겼으면 체인 줄도 함께
			-- 지우고 0.25초 숨을 골라, 줄이 남은 채 다른 행동으로 홱 넘어가는 부자연을 없앤다.
			local rdir = self._T.rushDir or -1
			local rushWarm = (now - (self._T.rushStartAt or 0)) > 0.12
			local isChain = self._T.rushIsChain == true
			local edge = rushWarm and (not isChain) and rb:PredictFootholdEnd(0.6, rdir > 0) or false
			local fell = not rb:IsOnGround()
			if isChain then
				if not fell then
					self._T.rushAirSince = nil
				elseif self._T.rushAirSince == nil then
					self._T.rushAirSince = now
				end
				fell = fell and (now - (self._T.rushAirSince or now)) > 0.25
			end
			if rushWarm and (fell or edge) then
				self._T.rushingUntil = 0
				self._T.rushAirSince = nil
				if self._T.rushRestoreSpeed ~= nil then
					mv.InputSpeed = self._T.rushRestoreSpeed
					self._T.rushRestoreSpeed = nil
				end
				if isChain then
					self._T.rushIsChain = nil
					if isvalid(self._T.chainVisEnt) then self._T.chainVisEnt:Destroy() end
					self._T.chainVisEnt = nil
					self._T.attackLockUntil = math.max(self._T.attackLockUntil or 0, now + 0.25)
				end
				mv:Stop()
				self._T.moving = false
				self:UpdateLoco(rb)
				return
			end
			mv:MoveToDirection(Vector2(rdir, 0), 0)
			self._T.moving = true
			self:UpdateLoco(rb)
			return
		end

		-- 하강 모드: 아랫점프를 반복해 발판을 뚫고 내려가고, 창이 끝나면 스폰 지점에서 점프하며 나온다.
		if (self._T.droppingUntil or 0) > now then
			-- (신고 2026-08-08 4차 "아랫점프 반복 → 꼭대기 리스폰 무한 반복") 내려가는 **도중에
			-- 사냥감을 만나면 하강을 멈추고 그 층에서 싸운다**(자동사냥 하강 순환과 같은 규칙).
			-- 궁수는 수직 탐지 폭(±1.2)이 좁아 층에 착지한 순간마다 직접 찾아봐야 한다.
			if rb:IsOnGround() and not isvalid(self._T.target) then
				self._T.target = self:PickTarget(myPos)
			end
			if isvalid(self._T.target) then
				self._T.droppingUntil = nil
				self._T.dropLastY = nil
				self._T.dropStallSince = nil
				self._T.unreachableSince = nil
				self._T.lastTargetAt = now
				log("[HeroSummon] 하강 중 사냥감 발견 - 이 층에서 전투")
			else
				-- (신고 2026-08-08 2차 "아래점프를 하지 않는다") 맨 아래층 발판 등 아랫점프가 안 먹는
				-- 지형에서는 DownJump가 조용히 무시돼 4초 내내 서 있었다 - 1.2초간 y가 안 내려가면
				-- 창을 즉시 닫아 다음 틱에 바로 스폰 재배치한다.
				if self._T.dropLastY == nil or myPos.y < self._T.dropLastY - 0.3 then
					self._T.dropLastY = myPos.y
					self._T.dropStallSince = now
				elseif now - (self._T.dropStallSince or now) > 1.2 then
					self._T.dropLastY = nil
					self._T.dropStallSince = nil
					self._T.droppingUntil = now
					log("[HeroSummon] 하강 정체(아랫점프 불가 발판) - 즉시 스폰 재배치")
					return
				end
				if rb:IsOnGround() and (self._T.nextDropJumpAt or 0) <= now then
					self._T.nextDropJumpAt = now + 0.4
					mv:DownJump()
				end
				self:UpdateLoco(rb)
				return
			end
		elseif self._T.droppingUntil ~= nil and self._T.droppingUntil > 0 then
			-- (신고 2026-08-08 3차 "떨어지면 어디론가 사라진다/플레이어 위치로") 공중에서 mv 순간이동을
			-- 하면 물리 예측이 되돌려 엉뚱한 곳에 남았다 - 자동사냥 ReturnToSpawn과 똑같이 **착지 후에만**,
			-- **rb:SetWorldPosition + PositionReset()**으로 이동한다(엔진이 맨아래 관통 낙하를 막으므로
			-- 곧 착지한다).
			if not rb:IsOnGround() then
				self:UpdateLoco(rb)
				return
			end
			self._T.droppingUntil = nil
			self._T.unreachableSince = nil
			local mapS = self.Entity.CurrentMap
			if isvalid(mapS) then
				-- (신고 2026-08-08 "플레이어 위치로 리스폰") 이 맵에 "SpawnLocation"이라는 이름의
				-- 엔티티가 없으면 재배치가 통째로 생략돼 리쉬가 주인 곁으로 데려갔다 - 이름 검색이
				-- 실패하면 **SpawnLocationComponent를 가진 아무 엔티티**(= 플레이어가 죽거나 처음
				-- 입장할 때 나오는 실제 스폰 지점)로 폴백한다.
				local spawnE = mapS:GetChildByName("SpawnLocation", true)
				if not isvalid(spawnE) then
					local slList = mapS:GetChildComponentsByTypeName("MOD.Core.SpawnLocationComponent", true)
					if slList ~= nil and #slList > 0 and isvalid(slList[1]) then
						spawnE = slList[1].Entity
					end
				end
				if isvalid(spawnE) then
					local spw = spawnE.TransformComponent.WorldPosition
					rb:SetWorldPosition(Vector2(spw.x, spw.y + 0.2))
					rb:PositionReset()
					self._T.target = nil
					self._T.dropLastY = nil
					self._T.dropStallSince = nil
					-- 재배치 직후 잠깐은 리쉬 순간이동을 계속 막고, "대상 없음" 시계도 새로 시작한다.
					self._T.leashGraceUntil = now + 5.0
					self._T.lastTargetAt = now
					self:PlayTeleportFx()
					-- "점프를 하며 나온다"(요청) - 도착 직후 가볍게 한 번 뛴다.
					_TimerService:SetTimerOnce(function()
						if not isvalid(self.Entity) then return end
						local mvJ = self.Entity.MovementComponent
						if isvalid(mvJ) then mvJ:Jump() end
					end, 0.15)
					log("[HeroSummon] 스폰 지점 재배치 완료 (" .. string.format("%.1f, %.1f", spw.x, spw.y) .. ")")
				else
					log_warning("[HeroSummon] SpawnLocation을 찾지 못해 재배치 생략(이 맵에 없음)")
				end
			end
		end
		-- (신고 2026-08-08 5차 "소환 다크나이트의 탑승 비행이 본체 자동사냥의 라이딩만큼 매끄럽지 않다")
		-- 비행을 본체 자동사냥(AutoHuntManager.RideFlightTick + SkillManager.ToggleDragonRide)과 같은
		-- 방식으로 전면 교체했다.
		--   ① 이동: 중력이 켜진 채 매 틱 mv:SetWorldPosition으로 끌던 방식(짧은 간격 반복 호출은 몇 틱
		--      뒤 원위치로 되돌아가는 실측 버그 + 매 틱 물리와 싸워 덜컹거림)을 폐기하고, 본체처럼
		--      **KinematicMove(자유 비행) + MoveToDirection(y성분 유효) + 3.2배 증속**으로 난다.
		--   ② 목적지: 움직이는 대상을 매 틱 재조준하며 탑승/하차 의사(wantRide)도 매 틱 다시 정하던
		--      것을 폐기하고 **탑승 순간 1회 고정**한다(본체 rideFlightX/Y와 동일) - 왕복 진동의 뿌리였다.
		--   ③ 하차: "착지 확인(IsOnGround)" 대기 대신 본체와 같은 3중 판정 - **도착(|dx|≤0.5 &
		--      목표 높이 도달) / 진척 감시(2초에 0.2 미만) / 거리 비례 타임아웃**. 착지점이 대상 발판
		--      위 +0.4라 하차(자유 비행 해제) 직후 중력이 자연스럽게 앉힌다.
		local rideEnt = self._T.rideDragonEnt
		local dcomp = nil
		if isvalid(rideEnt) then
			---@type RidingDragon
			dcomp = rideEnt:GetComponent("script.RidingDragon")
		end
		if not isvalid(dcomp) then
			-- 비행 도중 드래곤이 소멸(수명 만료 등)해도 자유 비행/증속 상태가 남지 않게 복구한다.
			if rideEnt ~= nil then self._T.rideDragonEnt = nil end
			if self._T.flyDestX ~= nil then
				self:EndDragonFlight(nil, mv, rb, "드래곤 소멸")
			end
		elseif dcomp.Riding then
			-- 비행 틱: 탑승 순간 고정해 둔 목적지로 직선 비행한다. 추적/배회/공격은 전부 건너뛴다.
			if self._T.flyPending == true then
				-- 탑승 워프(BeginMountWarp 0.5초) 완료 - 이제 실제 비행으로 전환한다. 본체
				-- ToggleDragonRide와 동일한 전환: 자유 비행 + 위치 계산 리셋 + 3.2배 증속 + 탑승 이펙트.
				self._T.flyPending = nil
				self._T.flyStartAt = now
				self._T.flyProgressDist = nil
				self._T.flyProgressAt = now + 2.0
				-- 대시(체인샷/섬광) 증속이 걸린 채 날지 않도록 먼저 정리한다(증속 이중 적용 방지).
				if self._T.rushRestoreSpeed ~= nil then
					mv.InputSpeed = self._T.rushRestoreSpeed
					self._T.rushRestoreSpeed = nil
				end
				self._T.rushingUntil = 0
				if self._T.baseInputSpeed == nil then self._T.baseInputSpeed = mv.InputSpeed end
				self._T.flyRestoreSpeed = mv.InputSpeed
				mv.InputSpeed = self._T.baseInputSpeed * 3.2
				rb.KinematicMove = true
				rb:PositionReset()
				-- (신고 2026-08-08 2차 "탑승 이펙트가 안 나온다") 본체와 같은 탑승 이펙트(97f1637c)를
				-- 소환수 자리에 재생한다(워프 이펙트는 BeginMountWarp가 드래곤 자리에서 이미 재생).
				---@type PlayerAttack
				local paFx = self:GetOwnerAttack()
				if isvalid(paFx) then paFx:PlayRidingMountEffectAt(self.Entity, myPos.x, myPos.y) end
			end
			local tx = self._T.flyDestX or myPos.x
			local ty = self._T.flyDestY or myPos.y
			local fdx = tx - myPos.x
			local fdy = ty - myPos.y
			local fdist = math.sqrt(fdx * fdx + fdy * fdy)
			-- 진척 감시(본체와 동일): 2초마다 거리가 0.2 이상 줄지 않았으면 막힌 것으로 본다.
			local stalled = false
			if (self._T.flyProgressAt or 0) <= now then
				local prev = self._T.flyProgressDist
				if prev ~= nil and (prev - fdist) < 0.2 then stalled = true end
				self._T.flyProgressDist = fdist
				self._T.flyProgressAt = now + 2.0
			end
			local elapsed = now - (self._T.flyStartAt or now)
			local limit = math.max(6.0, math.min(15.0, (self._T.flyStartDist or fdist) * 2.0 + 4.0))
			-- 도착: 수평으로 붙었고 목표 높이 근처(아래로 0.25 ~ 위로 0.9)에 실제로 왔을 때.
			-- (본체는 상승 비행만 해서 하한만 봤지만, 소환수는 아래층 목적지도 있어 상한도 함께 본다 -
			--  수평만 맞고 한참 위에서 내려버리면 공중 하차가 재발한다.)
			local arrived = (math.abs(fdx) <= 0.5 and myPos.y >= ty - 0.25 and myPos.y <= ty + 0.9)
			if arrived or stalled or elapsed > limit then
				local reason = "도착"
				if not arrived then
					if stalled then reason = "진척 없음" else reason = "시간 초과" end
				end
				self:EndDragonFlight(dcomp, mv, rb, reason)
			else
				-- 목표 바로 아래에서 수평 성분이 0에 가까우면 상승을 우선한다(본체와 동일 - 정규화
				-- 벡터가 흔들려 제자리를 맴도는 것 방지).
				local dirX = fdx
				local dirY = fdy
				if fdy > 0.3 and math.abs(fdx) < 0.3 then
					dirX = 0
					dirY = fdy
				end
				local dlen = math.sqrt(dirX * dirX + dirY * dirY)
				if dlen < 0.0001 then dlen = 1 end
				mv:MoveToDirection(Vector2(dirX / dlen, dirY / dlen), delta)
				self._T.moving = true
				if math.abs(fdx) > 0.05 then self:ApplyFacing((fdx > 0) and 1 or -1) end
			end
			self:UpdateLoco(rb)
			return
		elseif self._T.flyPending == true then
			-- 탑승 워프 중(드래곤이 사라졌다 나타나는 0.5초): 제자리에서 기다린다. 워프가 오래
			-- 안 끝나면(드래곤 이상 상태) 취소하고 평소 행동으로 돌아간다.
			if now - (self._T.flyPendingAt or now) > 1.5 then
				self._T.flyPending = nil
				self._T.flyDestX = nil
				self._T.flyDestY = nil
			else
				mv:Stop()
				self._T.moving = false
				self:UpdateLoco(rb)
				return
			end
		elseif (self._T.rideToggleAt or 0) <= now and (self._T.dismountAt or 0) + 2.5 <= now
			and (self._T.attackLockUntil or 0) + 0.4 <= now then
			-- 탑승 판단: 대상이 접근 곤란(멀거나 다른 층)하거나, 대상 없이 주인과 떨어져 있으면
			-- 목적지를 고정 기록하고 탑승한다. 방금 내렸다면 2.5초 재탑승 보류(왕복 진동 방지).
			-- (신고 2026-08-08 2차 "스킬을 쓰고 딜레이 없이 바로 탄다") 스킬 모션 잠금이 끝나고
			-- 0.4초 지나기 전에는 탑승하지 않는다 - 모션 → 한 박자 → 탑승 워프 순서가 자연스럽다.
			local dest = nil
			local tgt0 = self._T.target
			if isvalid(tgt0) then
				local tp0 = tgt0.TransformComponent.WorldPosition
				if math.abs(tp0.x - myPos.x) > 3.5 or math.abs(tp0.y - myPos.y) > 1.5 then
					-- 착지점: 대상이 서 있는 발판 위 옆자리(공격 사거리 안). 옆 1.2가 대상 발판
					-- **밖**(허공)이면 착지 실패 → 낙하 → 재상승 왕복이 되므로 발판 체인 안으로 클램프.
					local side = (tp0.x >= myPos.x) and -1 or 1
					local destX = tp0.x + side * 1.2
					local tRb0 = tgt0.RigidbodyComponent
					local tFh0 = isvalid(tRb0) and tRb0:GetCurrentFoothold() or nil
					local mapD = self.Entity.CurrentMap
					local fhD = isvalid(mapD) and mapD.FootholdComponent or nil
					if tFh0 ~= nil and fhD ~= nil then
						---@type PlayerAttack
						local paD = self:GetOwnerAttack()
						if isvalid(paD) then
							destX = paD:FindGroundEdgeX(fhD, tFh0, tp0.x, side, 1.2)
						end
					end
					dest = Vector2(destX, tp0.y + 0.4)
				end
			elseif math.abs(odx) > 2.0 or math.abs(ody) > 1.5 then
				-- 대상이 없으면 주인 곁으로 날아간다.
				dest = Vector2(ownerPos.x - 1.0, ownerPos.y + 0.4)
			end
			if dest ~= nil then
				self._T.rideToggleAt = now + 2.0
				self._T.flyDestX = dest.x
				self._T.flyDestY = dest.y
				local fdx0 = dest.x - myPos.x
				local fdy0 = dest.y - myPos.y
				self._T.flyStartDist = math.sqrt(fdx0 * fdx0 + fdy0 * fdy0)
				self._T.flyPending = true
				self._T.flyPendingAt = now
				-- (신고 2026-08-08 2차 "탑승 이펙트가 안 나온다 / 즉시 타서 부자연") 본체와 같은 탑승
				-- 워프 연출을 쓴다 - 드래곤 자리에서 워프 이펙트가 터지며 사라지고 0.5초 뒤 소환수
				-- 위치에 탑승한 채 나타난다(BeginMountWarp가 Riding을 켜면 그때부터 비행 틱 시작).
				dcomp:BeginMountWarp()
				mv:Stop()
				self._T.moving = false
				log("[HeroSummon] 드래곤 탑승 워프 시작 dist=" .. string.format("%.1f", self._T.flyStartDist))
				self:UpdateLoco(rb)
				return
			end
		end
		local target = self._T.target
		if isvalid(target) then
			self:ChaseTick(myPos, target, now, mv, rb)
		else
			self:RoamTick(myPos, now, mv, rb)
		end
		-- (피드백) 좌우 방향 반영: 아바타 NPC에는 플레이어의 LookAt 경로가 없어 MoveToDirection으로는
		-- 화면이 안 뒤집힌다(항상 왼쪽만 봄). 몬스터 관례대로 Scale.x 부호 반전으로 미러링한다
		-- (기본 아트가 왼쪽을 보므로 오른쪽 볼 때 -1).
		-- (피드백) 스킬 시전(잠금) 중에는 방향을 동결한다 - 시전 도중 방향이 홱홱 바뀌지 않게.
		if (self._T.attackLockUntil or 0) <= now then
			local face = self._T.faceDir or -1
			local wantScaleX = 1
			if face > 0 then wantScaleX = -1 end
			if self._T.lastScaleX ~= wantScaleX then
				self._T.lastScaleX = wantScaleX
				tr.Scale = Vector3(wantScaleX, 1, 1)
				self:SyncHpBarMirror(wantScaleX)
			end
		end
		self:UpdateLoco(rb)
	end

	@ExecSpace("ServerOnly")
	method Entity PickTarget(Vector3 myPos)
		-- 주변 몬스터 중 "y축으로 점프해도 공격할 수 없는"(2.2유닛 이상 위) 적은 건너뛴다.
		-- (피드백) 아래쪽도 한 번의 아랫점프로 닿을 만한 범위(-3.0)까지만 - 소환하자마자
		-- 한참 아래 몬스터 무리를 향해 발판에서 떨어져 내려가는 것을 막는다.
		-- (피드백) 항상 최근접 하나만 고르면 밀집 지역에서 제자리에 붙박이가 되므로,
		-- 닿을 수 있는 가까운 대상 최대 3마리 중 랜덤으로 골라 이리저리 움직이며 싸우게 한다.
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return nil end
		local cands = pa:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 6.0, 8)
		-- (신고 2026-08-08 "닿지도 않는 위쪽 적에게 점프 공격을 반복한다") 위쪽 허용 폭을 실제 점프
		-- 도달 높이(≈1.4)로 좁힌다. 활/표창은 수평으로만 나가므로 원거리 계열은 위아래를 더 좁게(±1.2).
		local upLimit = 1.4
		local downLimit = -3.0
		if self:IsArcherLine() or self.HeroLine == "nightlord" then
			upLimit = 1.2
			downLimit = -1.2
		end
		-- (요청 2026-08-08) 드래곤을 가진 다크나이트는 비행으로 위쪽 발판에 닿을 수 있으므로
		-- 위 한계를 크게 연다 - 위층 적도 정식 대상이 되어 하강 순환 전에 탑승 비행으로 올라간다.
		-- (신고 2026-08-08 2차 "저 아래로 내려가 머문다") 아래쪽은 넓히지 않는다 - 아래로 5유닛씩
		-- 층층이 내려가며 사냥터가 주인에게서 멀어지던 원인(수직 낙하 리쉬와 정면 충돌).
		if self.HeroLine == "darkknight" and isvalid(self._T.rideDragonEnt) then
			upLimit = 5.0
		end
		local avoid = nil
		if (self._T.avoidUntil or 0) > _UtilLogic.ElapsedSeconds and isvalid(self._T.avoidTarget) then
			avoid = self._T.avoidTarget
		end
		local reach = {}
		for _, t in ipairs(cands) do
			if isvalid(t) and t ~= avoid then
				local dy = t.TransformComponent.WorldPosition.y - myPos.y
				if dy <= upLimit and dy >= downLimit then
					table.insert(reach, { ent = t, ady = math.abs(dy) })
				end
			end
		end
		if #reach == 0 then return nil end
		-- (신고 2026-08-08 "지형/이동을 고려하지 않고 몬스터 위치만 보고 싸운다") **같은 발판 높이의
		-- 적을 우선**한다 - 위아래 발판의 적을 골라 계속 점프/아랫점프하며 허둥대는 것이 부자연스러움의
		-- 주 원인이었다. |dy| 오름차순 정렬 후 가장 가까운 높이의 후보 최대 3마리 중 랜덤으로 골라
		-- "이리저리 움직이며 싸우는" 기존 동작은 유지한다.
		table.sort(reach, function(a, b) return a.ady < b.ady end)
		local pickN = math.min(3, #reach)
		-- 같은 높이(±0.5) 후보가 있으면 그 안에서만 고른다.
		if reach[1].ady <= 0.5 then
			local sameH = 0
			for i = 1, pickN do
				if reach[i].ady <= 0.5 then sameH = i end
			end
			pickN = math.max(1, sameH)
		end
		return reach[_UtilLogic:RandomIntegerRange(1, pickN)].ent
	end

	@ExecSpace("ServerOnly")
	method void ChaseTick(Vector3 myPos, Entity target, number now, MovementComponent mv, RigidbodyComponent rb)
		-- 몬스터 추적: 접근 → 점프/아랫점프 → 사거리 안이면 스킬 사용(점프 공격 포함).
		local tp = target.TransformComponent.WorldPosition
		local dx = tp.x - myPos.x
		local dy = tp.y - myPos.y
		local adx = math.abs(dx)
		local dir = 1
		if dx < 0 then dir = -1 end

		-- 스킬 모션 중에는 제자리에 멈추고, 방향(faceDir)도 시전 시작 시점 값으로 동결한다.
		if (self._T.attackLockUntil or 0) > now then
			mv:Stop()
			self._T.moving = false
			return
		end
		self._T.faceDir = dir
		-- (피드백) 공격 사이 재배치 이동 - 밀집 지역에서도 붙박이가 되지 않고 활발히 움직인다.
		-- (주의) PredictFootholdEnd는 여러 조각으로 이어진 긴 지형에서 조각 경계마다 true를
		-- 반환해(실측) 엣지 감지로 쓸 수 없다 - 그냥 이동하고, 벽에 막히면 실제 이동량으로 감지한다.
		if (self._T.repositionUntil or 0) > now then
			local rdir = self._T.repositionDir or dir
			mv:MoveToDirection(Vector2(rdir, 0), 0)
			self._T.moving = true
			self._T.faceDir = rdir
			return
		end
		-- (비숍 개편 2026-08-08) 궁수 계열은 **거리를 두고 싸운다** - 접근을 멈추는 거리와 사거리가
		-- 전사/도적(근접)보다 훨씬 넓다. 나머지 추적/점프 규칙은 셋이 완전히 같다.
		local stopDist = 0.9
		local atkRange = 1.6
		if self:IsArcherLine() then
			stopDist = 3.6
			atkRange = 4.5
		elseif self.HeroLine == "nightlord" then
			-- (신고 2026-08-08 "럭키세븐 이펙트가 안 보인다") 나이트로드가 근접 거리(0.9)까지 붙어
			-- 표창을 던져 비행이 한 프레임 만에 끝났다 - 표창이 보이도록 거리를 두고 싸운다.
			stopDist = 2.6
			atkRange = 3.4
		end
		-- (요청 2026-08-08) 2차 이상 궁수는 먼 대상(같은 높이, 4.5유닛 초과)에게 **체인샷**으로
		-- 당겨간다 - 본체 체인샷 사운드 + 돌진 대시 틱을 재사용한 고속 접근(자체 쿨 6초).
		if self:IsArcherLine() and self:GetStage() >= 2 and adx > 4.5 and math.abs(dy) < 1.0
			and rb:IsOnGround() and (self._T.nextChainDashAt or 0) <= now then
			self._T.nextChainDashAt = now + 6.0
			---@type PlayerAttack
			local paCS = self:GetOwnerAttack()
			if isvalid(paCS) then paCS:PlayChainShotSound(self.Entity) end
			local pullDist = adx - stopDist
			local CHAIN_SPEED = 10.0
			local pullTime = math.max(0.1, math.min(0.7, pullDist / CHAIN_SPEED))
			-- (신고 2026-08-08 2차) 사운드만 나오고 체인 줄이 안 보였다 - 대상 가슴으로 줄을 쏘아
			-- 보여주고, 당겨가는 동안(pullTime) 유지 후 제거한다.
			self:SpawnChainVisual(tp.x, tp.y + 0.35, pullTime + 0.25)
			self._T.rushIsChain = true
			self._T.rushAirSince = nil
			self._T.rushDir = dir
			self._T.rushStartAt = now
			self._T.rushingUntil = now + pullTime
			if self._T.baseInputSpeed == nil then self._T.baseInputSpeed = mv.InputSpeed end
			self._T.rushRestoreSpeed = mv.InputSpeed
			mv.InputSpeed = CHAIN_SPEED
			_TimerService:SetTimerOnce(function()
				local mv2 = self.Entity.MovementComponent
				if isvalid(mv2) and self._T.rushRestoreSpeed ~= nil then
					mv2.InputSpeed = self._T.rushRestoreSpeed
					self._T.rushRestoreSpeed = nil
				end
			end, pullTime + 0.02)
			log("[HeroSummon] 체인샷 접근 dist=" .. string.format("%.1f", pullDist) .. " (" .. self:GetJobName() .. ")")
			return
		end
		if adx > stopDist then
			mv:MoveToDirection(Vector2(dir, 0), 0)
			self._T.moving = true
			-- (신고 2026-08-08 "벽에 부딪힌 채 제자리걸음") 0.5초마다 실제 전진량을 확인해,
			-- 1초간 제자리면 점프로 벽을 넘어보고, 2초가 지나도 못 가면 대상을 포기하고 새로 고른다.
			if (self._T.wallSampleAt or 0) <= now then
				self._T.wallSampleAt = now + 0.5
				local lastX = self._T.wallLastX
				self._T.wallLastX = myPos.x
				if lastX ~= nil and math.abs(myPos.x - lastX) < 0.12 then
					self._T.wallStuck = (self._T.wallStuck or 0) + 1
				else
					self._T.wallStuck = 0
				end
				if (self._T.wallStuck or 0) == 2 and rb:IsOnGround() then
					mv:Jump()
					log("[HeroSummon] 벽 감지 - 점프로 넘기 시도")
				elseif (self._T.wallStuck or 0) >= 4 then
					-- (신고 2026-08-08 "벽에서 계속 제자리걸음") 포기해도 다음 스캔이 같은 대상을 도로
					-- 골라 무한 반복됐다 - 포기한 대상을 5초간 블랙리스트해 다른 대상/배회로 전환시킨다.
					self._T.wallStuck = 0
					self._T.avoidTarget = target
					self._T.avoidUntil = now + 5.0
					self._T.target = nil
					log("[HeroSummon] 벽 통과 실패 - 대상 포기(5초 회피)")
					return
				end
			end
		else
			mv:Stop()
			self._T.moving = false
			self._T.wallStuck = 0
			self._T.wallLastX = nil
		end
		-- 점프(위쪽 발판의 적) / 아랫점프(아래쪽 발판의 적).
		-- ⚠ (신고 2026-08-08 "보우마스터가 사냥하다 갑자기 안 움직인다") 점프 게이트가 근접 기준
		--   (1.8 / 2.2)로 고정돼 있어서, 정지 거리를 3.6으로 넓힌 궁수는 위아래 발판의 적을 만나면
		--   **걸어갈 수도(이미 정지 거리) 점프할 수도(게이트 초과) 공격할 수도(dy 1.5 초과) 없는**
		--   교착에 빠졌다. 게이트를 정지 거리에 맞춰 함께 넓힌다(근접은 값이 그대로다).
		local jumpGate = math.max(1.8, stopDist + 0.4)
		local downGate = math.max(2.2, stopDist + 0.8)
		if rb:IsOnGround() and (self._T.nextJumpAt or 0) <= now then
			if dy > 0.6 and adx < jumpGate then
				self._T.nextJumpAt = now + 1.0
				mv:Jump()
			elseif dy < -0.8 and adx < downGate then
				self._T.nextJumpAt = now + 1.0
				mv:DownJump()
			end
		end
		-- (피드백) 추적 이동 중 가끔 깡총 점프 - 더 활발해 보이게.
		if self._T.moving and rb:IsOnGround() and (self._T.nextHopAt or 0) <= now then
			self._T.nextHopAt = now + 2.5 + _UtilLogic:RandomDouble() * 2.5
			if _UtilLogic:RandomDouble() < 0.5 then
				mv:Jump()
			end
		end
		-- (신고 2026-08-08 2차 "라이딩 상태로 공격한다") 탑승 중에는 공격하지 않는다 -
		-- 본체와 같은 규칙. 착지해 하차한 다음에야 싸운다.
		local ridingNow = false
		do
			local rEnt = self._T.rideDragonEnt
			if isvalid(rEnt) then
				---@type RidingDragon
				local rdc = rEnt:GetComponent("script.RidingDragon")
				if isvalid(rdc) and rdc.Riding then ridingNow = true end
			end
		end
		-- 공격 스킬(쿨타임 3~7초, 공중에서도 사거리 안이면 시전 = 점프 공격).
		if not ridingNow and adx < atkRange and math.abs(dy) < 1.5 and (self._T.nextAttackAt or 0) <= now then
			self:UseAttackSkill(target, dir, now)
		end
		-- 특수기(크루세이더 코마 / 용기사 드래곤로어, 15~30초).
		-- (버그 수정) 같은 틱에 위 일반기(UseAttackSkill)가 방금 잠금을 걸었으면 특수기는 다음 기회로
		-- 미룬다 - 스피어버스터 선딜 중에 드래곤로어가 겹쳐 시전되는 문제 방지.
		if not ridingNow and adx < 3.5 and (self._T.nextSpecialAt or 0) <= now and (self._T.attackLockUntil or 0) <= now then
			self:UseSpecialSkill(dir, now)
		end
	end

	@ExecSpace("ServerOnly")
	method void RoamTick(Vector3 myPos, number now, MovementComponent mv, RigidbodyComponent rb)
		-- 대상이 없으면 발판 위를 돌아다닌다(끝에서 반전, 가끔 멈춰 쉬거나 방향 전환).
		if (self._T.attackLockUntil or 0) > now then
			mv:Stop()
			self._T.moving = false
			return
		end
		-- (피드백) 더 활발하게: 멈춰 쉬는 확률을 낮추고(35%→10%) 방향 전환 주기도 짧게.
		if self._T.roamDir == nil then self._T.roamDir = 1 end
		if (self._T.roamToggleAt or 0) <= now then
			self._T.roamToggleAt = now + 1.5 + _UtilLogic:RandomDouble() * 1.5
			self._T.roamPaused = _UtilLogic:RandomDouble() < 0.1
			if _UtilLogic:RandomDouble() < 0.5 then self._T.roamDir = -self._T.roamDir end
		end
		if self._T.roamPaused then
			mv:Stop()
			self._T.moving = false
			return
		end
		-- 벽/막힘 감지: PredictFootholdEnd는 조각 발판 경계마다 true라 못 쓴다(실측).
		-- 0.5초마다 실제 x 이동량을 재서, 걷는데도 거의 못 움직였으면 방향을 뒤집는다.
		if (self._T.stuckCheckAt or 0) <= now then
			if self._T.stuckLastX ~= nil and self._T.wasRoamMoving and math.abs(myPos.x - self._T.stuckLastX) < 0.05 then
				self._T.roamDir = -self._T.roamDir
			end
			self._T.stuckCheckAt = now + 0.5
			self._T.stuckLastX = myPos.x
		end
		self._T.wasRoamMoving = true
		mv:MoveToDirection(Vector2(self._T.roamDir, 0), 0)
		self._T.moving = true
		self._T.faceDir = self._T.roamDir
		-- 배회 중에도 가끔 깡총 점프.
		if rb:IsOnGround() and (self._T.nextHopAt or 0) <= now then
			self._T.nextHopAt = now + 3.0 + _UtilLogic:RandomDouble() * 3.0
			if _UtilLogic:RandomDouble() < 0.4 then
				mv:Jump()
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void EndDragonFlight(any dcomp, MovementComponent mv, RigidbodyComponent rb, string reason)
		-- 탑승 비행 종료 공용 경로: 자유 비행(KinematicMove) 해제 + 증속 복원 + 하차.
		-- 착지점이 발판 위 +0.4라 해제 직후 중력이 자연스럽게 앉힌다(본체 하차와 같은 원리).
		-- 드래곤이 이미 소멸한 경우(dcomp=nil)에도 비행/증속 상태만은 반드시 복구한다.
		if self._T.flyRestoreSpeed ~= nil and isvalid(mv) then
			mv.InputSpeed = self._T.flyRestoreSpeed
		end
		self._T.flyRestoreSpeed = nil
		if isvalid(rb) then
			rb.KinematicMove = false
			rb:PositionReset()
		end
		if isvalid(mv) then mv:Stop() end
		self._T.moving = false
		if isvalid(dcomp) then dcomp.Riding = false end
		self._T.dismountAt = _UtilLogic.ElapsedSeconds
		self._T.flyPending = nil
		self._T.flyDestX = nil
		self._T.flyDestY = nil
		self._T.flyStartAt = nil
		self._T.flyStartDist = nil
		self._T.flyProgressDist = nil
		-- (신고 2026-08-08 2차 "하차 이펙트가 안 나온다") 본체 하차와 같은 이펙트(97f1637c)를
		-- 하차 지점에 재생한다.
		if isvalid(self.Entity) then
			---@type PlayerAttack
			local paFx = self:GetOwnerAttack()
			if isvalid(paFx) then
				local wp = self.Entity.TransformComponent.WorldPosition
				paFx:PlayRidingMountEffectAt(self.Entity, wp.x, wp.y)
			end
		end
		log("[HeroSummon] 드래곤 하차(" .. reason .. ")")
	end

	@ExecSpace("ServerOnly")
	method void UpdateLoco(RigidbodyComponent rb)
		-- 이동 모션 상태를 @Sync로 클라이언트에 알린다(변할 때만 대입).
		-- (신고 2026-08-08 3차 "탑승 중 sit 모션이 아니다") 드래곤 탑승 중에는 본체처럼 앉은 자세.
		local want = "stand"
		local rEntL = self._T.rideDragonEnt
		if isvalid(rEntL) then
			---@type RidingDragon
			local rdcL = rEntL:GetComponent("script.RidingDragon")
			if isvalid(rdcL) and rdcL.Riding then want = "sit" end
		end
		if want ~= "sit" then
			if not rb:IsOnGround() then want = "jump"
			elseif self._T.moving then want = "walk" end
		end
		if self.LocoState ~= want then
			self.LocoState = want
		end
	end

	-- ── 머리 위 HP바(서버) ───────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void SpawnHpBar()
		-- 머리 위 HP바: 스나이핑 게이지와 같은 snipinggaugetext 모델(Bg/Fill/Pct)을 용사 자식으로
		-- 스폰해 재사용한다. Pct 텍스트는 대입하지 않아 빈 문자열(수치 숫자 미표시 - 요청 사항).
		-- Color/Transform이 @Sync라 서버 대입만으로 모든 클라이언트에 표시된다.
		local bar = _SpawnService:SpawnByModelId("snipinggaugetext", "HeroHpBar", Vector3(0, 1.05, 0), self.Entity)
		if not isvalid(bar) then
			log_warning("[HeroSummon] HP바 스폰 실패")
			return
		end
		-- (피드백) 바 아트(keydownbar full 클립)는 애니메이션 클립이라 그대로 두면 프레임이 계속 돌며
		-- 반짝인다 - PlayRate=0으로 정지시켜 평소에는 반짝이지 않게 한다(피격 플래시는 FlashHpBar가 담당).
		local bg = bar:GetChildByName("Bg", false)
		if isvalid(bg) and isvalid(bg.SpriteRendererComponent) then
			bg.SpriteRendererComponent.Color = Color(0.25, 0.25, 0.25, 0.8)
			bg.SpriteRendererComponent.PlayRate = 0
		end
		local fill = bar:GetChildByName("Fill", false)
		if isvalid(fill) and isvalid(fill.SpriteRendererComponent) then
			-- 차지 게이지가 아니라 HP로 읽히도록 붉게 틴트한다.
			fill.SpriteRendererComponent.Color = Color(1, 0.3, 0.3, 1)
			fill.SpriteRendererComponent.PlayRate = 0
		end
		self._T.hpBar = bar
		self:UpdateHpBar()
		log("[HeroSummon] HP바 표시 " .. tostring(math.floor(self.HeroHp)) .. "/" .. tostring(math.floor(self.HeroMaxHp)))
	end

	@ExecSpace("ServerOnly")
	method void UpdateHpBar()
		-- 채움 바 갱신: 스나이핑 게이지와 동일하게 왼쪽 끝 고정 + 가로 스케일 = HP 비율.
		local bar = self._T.hpBar
		if not isvalid(bar) then return end
		local fill = bar:GetChildByName("Fill", false)
		if not isvalid(fill) then return end
		local ratio = 0
		if self.HeroMaxHp > 0 then
			ratio = math.max(0, math.min(1, self.HeroHp / self.HeroMaxHp))
		end
		fill.TransformComponent.Scale = Vector3(0.5 * ratio, 0.5, 1)
		fill.TransformComponent.Position = Vector3(-0.35 * (1 - ratio), 0, 0)
	end

	@ExecSpace("ServerOnly")
	method void FlashHpBar()
		-- 피격 순간 2회 깜빡임: 밝음(흰 틴트)↔평소(붉은 틴트)를 두 번 반복한다.
		-- 타임라인: 0=밝음 → 0.12=복원 → 0.20=밝음 → 0.32=복원(최종). 토큰으로 연속 피격 시
		-- 이전 깜빡임 타이머를 무시하고 새 시퀀스가 이어받는다. Color는 @Sync라 서버 대입 OK.
		local bar = self._T.hpBar
		if not isvalid(bar) then return end
		self._T.hpFlashToken = (self._T.hpFlashToken or 0) + 1
		local tok = self._T.hpFlashToken
		local bright = Color(1, 1, 1, 1)
		local normal = Color(1, 0.3, 0.3, 1)
		local function setFillColor(c)
			-- 우클릭 취소(DismissHero)로 즉시 파괴되면 이 타이머가 지워진 컴포넌트에서 돌아
			-- [LEA-2007] '_T' nil이 날 수 있다(용 소환수에서 실측) - _T를 만지기 전에 생존 확인.
			if not isvalid(self.Entity) then return end
			if self._T == nil then return end
			if self._T.hpFlashToken ~= tok then return end
			if not isvalid(bar) then return end
			local fill = bar:GetChildByName("Fill", false)
			if isvalid(fill) and isvalid(fill.SpriteRendererComponent) then
				fill.SpriteRendererComponent.Color = c
			end
		end
		setFillColor(bright)
		local steps = {
			{ at = 0.12, color = normal },
			{ at = 0.20, color = bright },
			{ at = 0.32, color = normal },
		}
		for _, s in ipairs(steps) do
			local stepColor = s.color
			_TimerService:SetTimerOnce(function()
				setFillColor(stepColor)
			end, s.at)
		end
	end

	method void OnHeroHit(HitEvent event)
		-- 몬스터에게 맞음(서버에서 ConnectEvent로 연결됨): 0.5초 무적 게이트 후 HP 차감,
		-- 0이 되면 소환 해제. 플레이어(PlayerHit)와 달리 자체 HP 프로퍼티를 직접 깎는다.
		if self._T.dying then return end
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.hitImmuneUntil or 0) > now then return end
		self._T.hitImmuneUntil = now + 0.5
		-- (팔라딘 가드) 패링 창 안에 맞으면 이 공격을 통째로 막고 2초 무적 + 10초 피해 30% 감소.
		if (self._T.guardWindowUntil or 0) > now then
			self._T.guardWindowUntil = 0
			self._T.hitImmuneUntil = now + 2.0
			self._T.guardCutUntil = now + 10.0
			_DamageSkinService:PlayTextDamage(self.Entity, "02c22d93421b4038b3c413b3e40b57ec", DamageSkinTextType.Guard, DamageSkinTweenType.Default)
			log("[HeroSummon] 가드 성공! (2초 무적 + 10초 피해 30% 감소)")
			return
		end
		-- (팔라딘 아이언 월) 소환수도 받는 피해 감소를 실제로 적용한다
		local dmg = event.TotalDamage
		if (self._T.ironWallUntil or 0) >= now and (self._T.ironWallPct or 0) > 0 then
			dmg = math.max(1, math.floor(dmg * (1 - self._T.ironWallPct / 100)))
		end
		-- (팔라딘 가드) 가드 성공 후 10초 감소 창.
		if (self._T.guardCutUntil or 0) >= now then
			dmg = math.max(1, math.floor(dmg * 0.7))
		end
		self.HeroHp = math.max(0, self.HeroHp - dmg)
		self:UpdateHpBar()
		self:FlashHpBar()
		log("[HeroSummon] 피격 -" .. tostring(event.TotalDamage) .. " → HP " .. tostring(math.floor(self.HeroHp)) .. "/" .. tostring(math.floor(self.HeroMaxHp)))
		if self.HeroHp <= 0 then
			self:UnsummonByDeath()
		end
	end

	-- (팔라딘 아이언 월) duration초간 이 소환수가 받는 피해를 reducePct% 감소시킨다.
	@ExecSpace("ServerOnly")
	method void ApplyIronWall(number duration, integer reducePct)
		self._T.ironWallUntil = _UtilLogic.ElapsedSeconds + duration
		self._T.ironWallPct = reducePct
		log("[HeroSummon] 아이언 월 적용 " .. tostring(duration) .. "초 -" .. tostring(reducePct) .. "%")
	end

	@ExecSpace("ServerOnly")
	method void UnsummonByDeath()
		-- HP 0: (피드백 - 묘비 낙하 대신) 사망 모션으로 바꾸고 움직이지 않고 있다가 2초 후 사라진다.
		-- 사망 시 플레이어가 죽을 때와 같은 느낌의 사망 사운드를 함께 재생한다.
		-- 사망 상태 동안은 아무 행동도 하지 않는다(dying 가드 - ServerTick/DealHit/CastBuff 전부 차단).
		if self._T.dying then return end
		self._T.dying = true
		log("[HeroSummon] HP 0 - 사망 상태 진입(20초 후 소멸)")
		local mv = self.Entity.MovementComponent
		if isvalid(mv) then mv:Stop() end
		-- (피드백) 플레이어 사망과 동일한 움직임: 엔진의 플레이어 Dead 해석(Core="dead"+Parts="stand1",
		-- **Loop**, 배속 1)을 그대로 재현한다. Loop라 재생이 끝나 서기 자세로 되돌아가는 일이 없고
		-- (기존 Onetime=끝나면 복귀 / 포즈 고정=1프레임 정지 문제 모두 해소), 5초 내내 애니메이션이 유지된다.
		-- 클라 모션 잠금도 dead 특례로 사망 상태 내내 걸린다(OnSyncProperty 참고).
		self:PlayMotion("dead", 1.0)
		self:PlaySoundFx("6e462a4ae44b4a518ea68fde456ea5c3")
		-- (요청 2026-08-08) 다크나이트가 죽으면 데리고 있던 라이딩 드래곤도 소멸 연출과 함께 사라진다.
		local deadDragon = self._T.rideDragonEnt
		if isvalid(deadDragon) then
			---@type RidingDragon
			local ddc = deadDragon:GetComponent("script.RidingDragon")
			if isvalid(ddc) then ddc:PlayVanishEffect() end
			_TimerService:SetTimerOnce(function()
				if isvalid(deadDragon) then deadDragon:Destroy() end
			end, 0.4)
			self._T.rideDragonEnt = nil
		end
		if isvalid(self.OwnerEntity) and isvalid(self.OwnerEntity.PlayerComponent) then
			self:NotifyUnsummoned(self.OwnerEntity.PlayerComponent.UserId)
		end
		-- 소멸 타이머는 리저렉션 부활 시 취소할 수 있게 id를 남긴다.
		self._T.deathTimerId = _TimerService:SetTimerOnce(function()
			self._T.deathTimerId = nil
			if isvalid(self.Entity) then
				log("[HeroSummon] 사망 상태 종료 - 소환 해제")
				self:PlayUnsummonFx()
				self.Entity:Destroy(0.2)
			end
		end, 20.0)
	end

	@ExecSpace("ServerOnly")
	method void PrepareResurrect()
		-- 리저렉션 시전 확정: 사망 소멸 타이머를 멈춰 부활 연출 도중 파괴되지 않게 한다.
		if self._T.deathTimerId then
			_TimerService:ClearTimer(self._T.deathTimerId)
			self._T.deathTimerId = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void Resurrect()
		-- 리저렉션(4차): 죽어 쓰러져 있던 용사를 그 자리에서 HP 가득 찬 상태로 부활시킨다.
		if not self._T.dying then return end
		self:PrepareResurrect()
		self._T.dying = false
		self.HeroHp = self.HeroMaxHp
		self:UpdateHpBar()
		local now = _UtilLogic.ElapsedSeconds
		self._T.hitImmuneUntil = now + 1.0     -- 부활 직후 1초 피격 무시
		self._T.attackLockUntil = 0
		self._T.nextAttackAt = now + 1.0
		self._T.noChaseUntil = now + 1.0       -- 부활 직후 잠깐 제자리 정착
		-- 클라이언트: 사망 스핀 중지 + 아바타 원복 + 이동 클립 재개(MotionCmd "revive" 특례).
		self:PlayMotion("revive", 1.0)
		-- 주인 버프바를 남은 소환 시간으로 복원한다.
		local remaining = math.max(0, (self._T.lifetimeEndAt or now) - now)
		if remaining > 0 and isvalid(self.OwnerEntity) and isvalid(self.OwnerEntity.PlayerComponent) then
			self:NotifyResurrected(remaining, self.OwnerEntity.PlayerComponent.UserId)
		end
		log("[HeroSummon] 리저렉션 부활 - HP " .. tostring(math.floor(self.HeroMaxHp)) .. "/" .. tostring(math.floor(self.HeroMaxHp)) .. " 잔여수명 " .. tostring(math.floor(remaining)) .. "초")
	end

	@ExecSpace("Client")
	method void NotifyResurrected(number remaining)
		-- 주인 클라이언트: 우측 상단 소환 버프바를 남은 시간으로 다시 띄운다.
		-- (비숍 개편 2026-08-08) 계통마다 아이콘이 달라 HeroLine으로 갈라준다(@Sync라 클라도 안다).
		if self:IsArcherLine() then
			_ArcherSummonBuffUI:ShowBuff(remaining)
		elseif self:IsThiefLine() then
			_ThiefSummonBuffUI:ShowBuff(remaining)
		else
			_HeroSummonBuffUI:ShowBuff(remaining)
		end
	end

	@ExecSpace("Multicast")
	method void PlayUnsummonFx()
		-- 사라짐 연출: 순간이동과 같은 이펙트를 현재 위치에 비부착으로 재생한다
		-- (부착 재생하면 0.25초 뒤 엔티티 제거와 함께 이펙트가 끊긴다).
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		_EffectService:PlayEffect("21d3191f10984059bf84b16fe406698e", self.Entity, Vector3(pos.x, pos.y + 0.3, 0), 0, Vector3(0.7, 0.7, 1), false, nil)
	end

	@ExecSpace("Client")
	method void NotifyUnsummoned()
		-- 주인 클라이언트: 우측 상단 소환 버프바를 즉시 내린다(계통별 아이콘).
		if self:IsArcherLine() then
			_ArcherSummonBuffUI:HideBuff()
		elseif self:IsThiefLine() then
			_ThiefSummonBuffUI:HideBuff()
		else
			_HeroSummonBuffUI:HideBuff()
		end
	end

	-- ── 홀리 매직쉘(4차 버프) 쉴드 ───────────────────────────────
	-- 주인이 홀리 매직쉘을 시전하면 이 소환수에게도 10회짜리 쉴드가 걸린다(개체마다 각각 10회).
	-- 실제 차단은 공격자 쪽 MonsterAttack.IsAttackTarget에서 ConsumeHolyShell()을 불러 처리한다
	-- (방어자 IsHitTarget은 이 프로젝트의 몬스터 공격 경로에서 호출되지 않는다 - 가드/패링과 같은 이유).

	@ExecSpace("ServerOnly")
	method void GrantHolyShell(integer count)
		-- 재시전하면 남은 개수와 무관하게 새로 count개로 채운다.
		self.HolyShell = count
	end

	@ExecSpace("ServerOnly")
	method boolean ConsumeHolyShell()
		-- 쉴드가 남아 있으면 1개 소모하고 true(이번 공격 무시). 사망 상태면 쓰지 않는다.
		-- (요청) 막아낸 뒤 **1.5초 무적** - 그 동안 들어오는 공격은 쉴드를 더 쓰지 않고 그냥 무시한다
		-- (밀집 지역에서 한 번에 여러 대 맞아 쉴드가 순식간에 증발하는 것을 막는다).
		if self._T.dying then return false end
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.holyShellInvulnUntil or 0) >= now then return true end
		if self.HolyShell <= 0 then return false end
		self.HolyShell = self.HolyShell - 1
		self._T.holyShellInvulnUntil = now + 1.5
		self:PlayHolyShellFx(self.HolyShell)
		log("[HolyShell] 용사 소환수 방어! 남은 쉴드 " .. tostring(self.HolyShell))
		return true
	end

	@ExecSpace("Multicast")
	method void PlayHolyShellFx(integer remain)
		-- 쉴드 성공 연출: 막은 개체 몸에서 쉴드 이펙트 + "Guard" 표시 + 머리 위 남은 개수 숫자.
		-- (피드백) 막을 때 사운드는 재생하지 않는다. 이펙트 높이도 0.2 → -0.1로 더 내렸다.
		-- (플레이어 쪽 PlayerHit.PlayHolyShellBlockEffects와 같은 규격).
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local serial = _EffectService:PlayEffectAttached("ec0acf34d59043f695f43c55222a7b0e", self.Entity, Vector3(0, -0.1, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8, ["Alpha"] = 0.5 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.2)
		_DamageSkinService:PlayTextDamage(self.Entity, "02c22d93421b4038b3c413b3e40b57ec", DamageSkinTextType.Guard, DamageSkinTweenType.Default)
		_DamageSkinService:Play(
			self.Entity, "d58b67cf0f3a4eaf9fe1ad87c0ffac8a", 0,
			{ remain }, DamageSkinTweenType.Default, false,
			Vector2(0, 0.35), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 서버에서 연결한 피격 이벤트 해제.
		if self._T.hitEventHandler then
			self.Entity:DisconnectEvent(HitEvent, self._T.hitEventHandler)
			self._T.hitEventHandler = nil
		end
		-- 어떤 경로로 사라져도(수명 만료/재소환 교체/우클릭 취소) 라이딩 드래곤을 함께 정리한다.
		local dEnt = self._T.rideDragonEnt
		if isvalid(dEnt) then dEnt:Destroy() end
		self._T.rideDragonEnt = nil
	end

	@ExecSpace("ServerOnly")
	method void SyncHpBarMirror(number scaleX)
		-- 용사는 좌우를 루트 Scale.x(-1)로 뒤집으므로(ApplyFacing), HP바가 함께 뒤집혀 채움 기준이
		-- 좌우로 널뛰지 않게 바 로컬 Scale.x를 같은 부호로 맞춰 상쇄한다(부모 -1 × 로컬 -1 = +1).
		local bar = self._T.hpBar
		if not isvalid(bar) then return end
		bar.TransformComponent.Scale = Vector3(scaleX, 1, 1)
	end

	-- ── 공격 스킬(서버) ──────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void UseAttackSkill(Entity target, number dir, number now)
		-- (피드백) 공격 주기는 스킬 시전 딜레이(약 0.85초, 부스터/나이트 버프로 단축)만 지나면
		-- 바로 다음 스킬을 알아서 쓴다. 스킬은 직업별 풀을 순환한다.
		local cdMult = self._T.atkCdMult or 1.0
		self._T.nextAttackAt = now + 0.85 * cdMult
		-- (피드백) 스킬 딜레이(시전 모션) 중에는 절대 움직이지 않는다 - 잠금을 모션 전체(0.85초)로.
		self._T.attackLockUntil = now + 0.85
		-- 시전 시작 방향을 즉시 반영(잠금 동안 이 방향으로 동결).
		self:ApplyFacing(dir)
		-- (피드백) 시전이 완전히 끝난 뒤에만 잠깐 좌우로 재배치 이동(50%) - 제자리 붙박이 방지.
		-- 재배치가 예약되면 그 시간만큼 다음 공격 시점도 함께 늦춘다(시전 0.85초 → 이동 0.35~0.7초 → 다음 공격).
		if _UtilLogic:RandomDouble() < 0.5 then
			local rdir = 1
			if _UtilLogic:RandomDouble() < 0.5 then rdir = -1 end
			local dur = 0.35 + _UtilLogic:RandomDouble() * 0.35
			self._T.repositionDir = rdir
			self._T.repositionUntil = now + 0.85 + dur
			self._T.nextAttackAt = now + 0.85 + dur + 0.05
		end
		local stage = self:GetStage()
		local pool = { "powerstrike", "slashblast" }
		if self.HeroLine == "hero" and stage >= 4 then
			-- (요청 2026-08-08) 4차 히어로 = 브랜디쉬 주력 + **돌진/섬광**(1차기는 가끔만).
			pool = { "brandish", "brandish", "brandish", "rush", "flash" }
		elseif self.HeroLine == "hero" and stage >= 2 then
			-- (요청 2026-08-08) 히어로는 2차부터 **섬광**(자동 돌진기)을 섞어 쓴다.
			pool = { "powerstrike", "slashblast", "flash" }
		elseif self.HeroLine == "darkknight" and stage >= 4 then
			-- (요청 2026-08-08) 4차 다크나이트 = 어드밴스드 스피어버스터 주력 + **돌진**.
			pool = { "spearburst", "spearburst", "spearburst", "rush", "powerstrike" }
		elseif self.HeroLine == "darkknight" and stage >= 3 then
			pool = { "powerstrike", "slashblast", "spearburst" }
		elseif self.HeroLine == "paladin" and stage >= 4 then
			-- (요청 2026-08-08) 4차 팔라딘 = 차지 블로우 주력 + **돌진**.
			pool = { "chargeblow", "chargeblow", "chargeblow", "rush" }
		elseif self.HeroLine == "paladin" and stage >= 3 then
			-- (피드백) 레벨 70 이상 팔라딘 계열(나이트/팔라딘)은 차지 블로우가 주력기 -
			-- 디바인 4속성을 주기적으로 바꿔가며 시전한다(CastChargeBlow가 전환을 관리).
			pool = { "chargeblow" }
		elseif self.HeroLine == "sniper" then
			-- (신고 2026-08-08 수정) 궁수 두 계열은 **배우는 스킬이 서로 다르다**.
			-- 신궁(석궁): 더블샷(1차) → 아이언 에로우(2차) → 스트레이프·아이스 샷(3차).
			-- ⚠ 3차부터는 **1차 더블샷을 빼서** 3차 주력기만 돌린다(요청: "3차 궁수는 3차 스킬을 써야 한다").
			pool = { "doubleshot" }
			if stage == 2 then pool = { "doubleshot", "ironarrow" } end
			if stage == 3 then pool = { "ironarrow", "strafe", "iceshot" } end
			-- (요청 2026-08-08) 4차 신궁 = 스나이핑/피어싱 주력.
			if stage >= 4 then pool = { "sniping", "piercing", "strafe" } end
		elseif self.HeroLine == "bowmaster" then
			-- 보우마스터(활): 더블샷(1차) → **에로우 봄·속사**(2차) → 스트레이프·파이어 샷(3차).
			-- ⚠ 아이언 에로우는 신궁 전용이라 여기 넣지 말 것(반대도 마찬가지).
			pool = { "doubleshot" }
			if stage == 2 then pool = { "arrowbomb", "rapidfire" } end
			if stage == 3 then pool = { "arrowbomb", "strafe", "fireshot" } end
			-- (요청 2026-08-08) 4차 보우마스터 = 폭풍의 시 주력(6연발 버스트로 흉내).
			if stage >= 4 then pool = { "hurricane", "strafe" } end
		elseif self.HeroLine == "nightlord" then
			-- 나이트로드 - 표창 투척. 1~2차 럭키세븐 / 3차부터 트리플 스로우 / 4차부터 어벤져(관통 광역).
			-- ⚠ 3차부터는 **트리플 스로우가 주력**이라 1차 럭키세븐을 뺀다(요청).
			-- (신고 2026-08-08) 4차는 트리플이 아니라 **쿼드러플 스로우**다.
			pool = { "luckyseven" }
			if stage >= 3 then pool = { "triplethrow" } end
			if stage >= 4 then pool = { "quadthrow", "avenger" } end
		elseif self.HeroLine == "shadower" then
			-- 섀도어 - 단검 근접.
			-- (요청 2026-08-08) **2차부터 새비지블로우**가 주력이다 - 예전엔 3차부터라 2차 소환수가
			-- 계속 더블스탭만 썼다(신고). 더블스탭은 1차 전용으로 내린다.
			pool = { "doublestab" }
			if stage >= 2 then pool = { "savageblow" } end
			if stage >= 4 then pool = { "savageblow", "assassinate" } end
		end
		-- (요청 2026-08-08) 3차 다크나이트는 스피어 버스터가 주력 - 1차기는 가끔만(4차는 위에서 별도).
		if self.HeroLine == "darkknight" and stage == 3 then
			pool = { "spearburst", "spearburst", "spearburst", "powerstrike", "slashblast" }
		end
		-- (요청 2026-08-08) 나이트로드 1차 표창 분산: 대상 주변에 적이 3마리 이상 몰려 있으면
		-- 로테이션 대신 분산 투척(적마다 표창 1개씩)을 쓴다 - 본체 표창 분산 토글과 같은 성격.
		if self.HeroLine == "nightlord" and isvalid(target) then
			---@type PlayerAttack
			local paC = self:GetOwnerAttack()
			if isvalid(paC) then
				local tp0 = target.TransformComponent.WorldPosition
				local crowd = paC:FindMonstersInRadius(Vector2(tp0.x, tp0.y), 2.5, 6)
				-- 35% 확률로만 분산 - 매번 분산하면 주력기(럭키세븐/트리플)가 아예 안 보인다(신고).
				if crowd ~= nil and #crowd >= 3 and _UtilLogic:RandomDouble() < 0.35 then
					self:AddHeroOrb()
					self:CastStarSpread(crowd, dir)
					return
				end
			end
		end
		self._T.atkIdx = ((self._T.atkIdx or 0) % #pool) + 1
		local skillName = pool[self._T.atkIdx]
		-- (피드백) 콤보 어택 버프 중에는 스킬을 쓸 때마다 콤보 구슬이 +1씩 다시 차오른다
		-- (코마가 전부 소모한 뒤 채워지는 모습).
		self:AddHeroOrb()
		if skillName == "powerstrike" then
			self:CastPowerStrike(target, dir)
		elseif skillName == "slashblast" then
			self:CastSlashBlast(dir)
		elseif skillName == "chargeblow" then
			self:CastChargeBlow(target, dir)
		elseif skillName == "spearburst" then
			self:CastSpearBurst(dir)
		-- ── (비숍 개편 2026-08-08) 궁수 소환 ─────────────────────────────
		elseif skillName == "doubleshot" then
			-- 화살 2발 동시(본체와 같은 벌어짐/2줄 표시는 투사체가 스스로 처리).
			self:CastArrowVolley(target, dir, "doubleshot", 2, 0, 0.5 / 3.0, 2.5 / 3.0, 0.05)
		elseif skillName == "ironarrow" then
			self:CastArrowVolley(target, dir, "ironarrow", 1, 0, 1.5, 2.0, 0.0)
		elseif skillName == "strafe" then
			-- 스트레이프: 4발이 적 하나에 줄 번호대로 꽂힌다(x좌표 교차 확정 히트 - 본체와 동일).
			self:CastArrowVolley(target, dir, "strafe", 4, 0, 3.0, 3.5, 0.1)
		elseif skillName == "rapidfire" then
			-- 속사(보우마스터 2차): 소환수는 한 번에 5발 버스트로 쏜다.
			self:CastArrowVolley(target, dir, "rapidfire", 5, 0, 1.0, 1.5, 0.15)
		elseif skillName == "arrowbomb" then
			self:CastArrowVolley(target, dir, "arrowbomb", 1, 0, 1.5, 1.7, 0.0)
		elseif skillName == "hurricane" then
			-- 폭풍의 시(보우마스터 4차): 홀드 연사를 6연발 버스트로 흉내낸다.
			self:CastArrowVolley(target, dir, "hurricane", 6, 0, 2.0, 2.5, 0.12)
		elseif skillName == "sniping" then
			-- 스나이핑(신궁 4차): 완충 상태 한 방.
			self:CastArrowVolley(target, dir, "sniping", 1, 0, 1.0, 1.5, 0.0)
		elseif skillName == "piercing" then
			-- 피어싱(신궁 4차): 완충 관통 한 방(배율은 투사체의 차지 공식이 곱한다).
			self:CastArrowVolley(target, dir, "piercing", 1, 0, 0.30, 0.50, 0.0)
		elseif skillName == "rush" then
			self:CastRushLite(target, dir)
		elseif skillName == "brandish" then
			-- 브랜디쉬(히어로 4차): 근접 2연격 - 1타 1줄 + 마무리 2줄(본체와 같은 3줄 구성).
			self:CastBrandishLite(target, dir)
		elseif skillName == "fireshot" or skillName == "iceshot" then
			self:CastElementalShot(target, dir, skillName)
		-- ── (비숍 개편 2026-08-08) 도적 소환 ─────────────────────────────
		elseif skillName == "luckyseven" then
			self:CastStarVolley(target, dir, "luckyseven", 2, 0.5 / 3.0, 2.5 / 3.0)
		elseif skillName == "triplethrow" then
			self:CastStarVolley(target, dir, "triple", 3, 0.5 / 3.0, 2.5 / 3.0)
		elseif skillName == "quadthrow" then
			-- 쿼드러플 스로우(나이트로드 4차): 표창 4발 - 트리플과 같은 규격으로 1발 더.
			self:CastStarVolley(target, dir, "quad", 4, 0.5 / 3.0, 2.5 / 3.0)
		elseif skillName == "flash" then
			self:CastFlashLite(target, dir)
		elseif skillName == "avenger" then
			self:CastAvengerVolley(target, dir)
		elseif skillName == "doublestab" then
			self:CastShadowerSkill(target, dir, "doublestab", 2, 1.3, 2.6, 0.15)
		elseif skillName == "savageblow" then
			self:CastShadowerSkill(target, dir, "savageblow", 6, 1.0, 2.0, 0.09)
		elseif skillName == "assassinate" then
			self:CastShadowerSkill(target, dir, "assassinate", 1, 2.5, 3.5, 0.1)
		else
			self:CastPowerStrike(target, dir)
		end
	end

	-- ══════ 궁수 소환(보우마스터/신궁) 전투 ══════════════════════════════
	-- 데미지는 다른 용사 스킬과 똑같이 DealHit(= 주인 PlayerAttack의 skill.herosummon 파이프라인)으로
	-- 준다. 날아가는 화살/표창은 **시각 전용 투사체**(VisualOnly)라 판정을 두 번 하지 않는다 -
	-- 실제 판정 투사체를 쓰면 데미지 스킨/크리티컬 표시가 용사 규격에서 벗어난다.

	@ExecSpace("ServerOnly")
	method void CastArrowVolley(Entity target, number dir, string variant, integer arrows, integer pierce, number multMin, number multMax, number gap)
		-- (재작업 2026-08-08) 화살류 공용 발사기. 예전엔 시각 전용 화살 + 별도 데미지 검색이었는데
		-- 아트가 전부 아이언 에로우로 보이고("만들지 않은 스킬" 신고) 줄 수도 틀렸다 - 이제
		-- **본체와 같은 진짜 투사체**를 쏜다(PlayerAttack.FireSummonProjectileShot). 판정/줄 표시/
		-- 크리티컬/폭발·빙결 같은 부가 효과는 각 투사체가 본체 스킬과 똑같이 스스로 처리한다.
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		-- (신고 2026-08-08 "몸쪽 이펙트가 안 보인다 / 차징이 보여야 한다") 본체의 시전·차지 이펙트를
		-- 그대로 재생한다(전부 Multicast + 엔티티 인자 - 용사 부착 공용 관례로 항상 왼쪽 기준 -1).
		--   · 스트레이프: 시전 링(즉시)
		--   · 스나이핑/피어싱: **차지 이펙트 1초 유지 → 릴리즈 연출과 함께 발사**(본체의 완충 흐름)
		--   · 폭풍의 시: 연사 내내 몸쪽 keydown 이펙트 유지 → 마지막 발사 뒤 종료
		local windup = 0.3
		---@type PlayerAttack
		local paCast = self:GetOwnerAttack()
		if isvalid(paCast) then
			if variant == "strafe" then
				paCast:PlayStrafeCastEffect(self.Entity, -1)
			elseif variant == "sniping" then
				windup = 1.0
				paCast:StartSnipingVisuals(self.Entity, -1)
			elseif variant == "piercing" then
				windup = 1.0
				paCast:StartPiercingVisuals(self.Entity, -1)
			elseif variant == "hurricane" then
				paCast:StartHurricaneVisuals(self.Entity, -1)
			end
		end
		-- 차지 스킬은 시전이 길어 잠금/다음 공격 시점도 그만큼 늦춘다(UseAttackSkill 기본 0.85초).
		if windup > 0.5 then
			local nowC = _UtilLogic.ElapsedSeconds
			self._T.attackLockUntil = nowC + windup + 0.4
			self._T.nextAttackAt = math.max(self._T.nextAttackAt or 0, nowC + windup + 0.5)
		end
		local dm = self._T.dmgMult or 1.0
		local extra = (self.HeroLine == "sniper") and 7 or 8
		for i = 1, arrows do
			local idx = i
			local tt = target
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				if self._T.dying then return end
				---@type PlayerAttack
				local pa = self:GetOwnerAttack()
				if not isvalid(pa) then return end
				-- 차지 스킬: 발사 순간 차지를 끄고 릴리즈 연출을 낸다(본체의 릴리즈 흐름).
				if idx == 1 then
					if variant == "sniping" then
						pa:StopSnipingVisuals(self.Entity)
						pa:PlaySnipingReleaseVisuals(self.Entity, 3, -1)
					elseif variant == "piercing" then
						pa:StopPiercingVisuals(self.Entity)
						pa:PlayPiercingReleaseVisuals(self.Entity, -1)
					end
				end
				pa:FireSummonProjectileShot(self.Entity, variant, tt, self:GetCombatPower(),
					multMin * dm, multMax * dm, idx, arrows, extra)
				-- 폭풍의 시: 마지막 발사 뒤 몸쪽 이펙트를 끈다.
				if variant == "hurricane" and idx == arrows then
					_TimerService:SetTimerOnce(function()
						if not isvalid(self.Entity) then return end
						---@type PlayerAttack
						local paEnd = self:GetOwnerAttack()
						if isvalid(paEnd) then paEnd:StopHurricaneVisuals(self.Entity) end
					end, 0.25)
				end
			end, windup + (idx - 1) * gap)
		end
		log("[HeroSummon] " .. variant .. " x" .. tostring(arrows) .. " (" .. self:GetJobName() .. ")")
	end

	-- 활 스킬별 적중 이펙트 RUID. 본체 스킬이 쓰는 것과 같은 클립을 골라 쓴다
	-- (예전엔 전 스킬이 파워스트라이크 적중 이펙트를 써서 전사 스킬처럼 보였다).
	method string GetArrowHitFx(string variant)
		-- 스트레이프는 전용 클립, 나머지 활 스킬은 아이언 에로우 적중 클립을 공유한다.
		if variant == "strafe" then return "2d66c100851845ec902a98ede7c88b78" end
		return "f6658089b9774f4bb0026efe2757e375"
	end

	@ExecSpace("ServerOnly")
	method void SpawnVisualArrow(number dir)
		-- 눈에 보이는 화살 한 발(판정 없음 - IronArrowProjectile.VisualOnly). 데미지는 CastArrowVolley가 준다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.arrowSeq = (self._T.arrowSeq or 0) + 1
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("ironarrowprojectile",
			"heroArrow_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.arrowSeq),
			Vector3(myPos.x + dir * 0.25, myPos.y + 0.35, 0), map)
		if not isvalid(proj) then return end
		---@type IronArrowProjectile
		local comp = proj:GetComponent("script.IronArrowProjectile")
		if isvalid(comp) then
			comp.VisualOnly = true
			comp.CombatPower = 0
			comp:Fire(dir, 0)
		end
	end

	@ExecSpace("ServerOnly")
	method void CastElementalShot(Entity target, number dir, string kind)
		-- 아이스 샷(신궁)/파이어 샷(보우마스터): **본체와 같은 진짜 화살** - 도착 지점 광역과
		-- 빙결/화상까지 본체 경로(DealIceShotHit/DealFireShotHit)가 그대로 처리한다.
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		local dm = self._T.dmgMult or 1.0
		local tt = target
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or self._T.dying then return end
			---@type PlayerAttack
			local pa = self:GetOwnerAttack()
			if not isvalid(pa) then return end
			pa:FireSummonProjectileShot(self.Entity, kind, tt, self:GetCombatPower(), 2.0 * dm, 2.5 * dm, 1, 1, 1)
			log("[HeroSummon] " .. kind .. " (" .. self:GetJobName() .. ")")
		end, 0.3)
	end

	-- ══════ 도적 소환(나이트로드/섀도어) 전투 ════════════════════════════

	@ExecSpace("ServerOnly")
	method void CastStarVolley(Entity target, number dir, string variant, integer stars, number multMin, number multMax)
		-- 럭키세븐(2발)/트리플 스로우(3발): **본체와 같은 진짜 표창**을 쓴다 - 유도/사망 유예/
		-- 2·3줄 표시/표창+ 스킨이 전부 투사체(luckysevenprojectile)에 내장돼 있다.
		-- (요청) 표창+ 유동 교체: 시전마다 표창 종류를 무작위로 갈아 끼운다.
		local skinCount = _ShurikenLibrary:GetCount()
		self._T.starSkin = _UtilLogic:RandomIntegerRange(1, math.max(1, skinCount))
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		local dm = self._T.dmgMult or 1.0
		for i = 1, stars do
			local idx = i
			local tt = target
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) or self._T.dying then return end
				---@type PlayerAttack
				local pa = self:GetOwnerAttack()
				if not isvalid(pa) then return end
				pa:FireSummonProjectileShot(self.Entity, "star", tt, self:GetCombatPower(),
					multMin * dm, multMax * dm, idx, stars, self._T.starSkin or 1)
			end, 0.25 + (idx - 1) * 0.1)
		end
		log("[HeroSummon] " .. variant .. " x" .. tostring(stars) .. " 표창=" .. tostring(self._T.starSkin) .. " (" .. self:GetJobName() .. ")")
	end

	@ExecSpace("ServerOnly")
	method void SpawnVisualStar(Entity target, number dir, string hitRuid, integer idx, integer total)
		-- 눈에 보이는 표창 한 개(판정 없음 - LuckySevenProjectile.VisualOnly). 대상을 향해 유도된다.
		-- ⚠ Entity 파라미터에 nil을 넘기면 본문이 한 줄도 실행되지 않고 로그도 남지 않는다(프로젝트
		--   공통 함정) - 대상이 없는 직선 발사는 반드시 SpawnVisualStarForward를 쓸 것.
		local comp = self:SpawnVisualStarEntity(dir)
		if comp == nil then return end
		-- 본체와 같은 적중 클립/줄 배치를 새겨준다(안 새기면 꽂혀도 아무 이펙트가 안 뜬다).
		comp.HitEffectRUID = hitRuid
		comp.HitIndex = idx
		comp.TotalShots = total
		-- ⚠ (신고 2026-08-08 "표창이 유도가 안 돼서 자주 빗나간다") fallback은 **대상의 현재 위치**여야 한다.
		--   예전엔 "전방 6유닛 허공"을 줬는데, 데미지(DealHit)가 먼저 들어가 대상이 곧바로 죽으면
		--   표창이 유도를 잃고 그 먼 허공까지 계속 날아가 완전히 빗나간 것처럼 보였다
		--   (본체 럭키세븐도 같은 이유로 대상의 마지막 위치를 fallback으로 쓴다).
		local myPos = self.Entity.TransformComponent.WorldPosition
		local fallback = Vector3(myPos.x + dir * 3.0, myPos.y + 0.35, 0)
		if isvalid(target) then
			local tp = target.TransformComponent.WorldPosition
			fallback = Vector3(tp.x, tp.y + 0.2, 0)
		end
		comp:Fire(target, fallback)
	end

	@ExecSpace("ServerOnly")
	method void SpawnVisualStarForward(number dir)
		-- 대상 없이 전방으로 직선 발사하는 시각 표창(어벤져 관통 연출용).
		local comp = self:SpawnVisualStarEntity(dir)
		if comp == nil then return end
		local myPos = self.Entity.TransformComponent.WorldPosition
		comp:FireNoTarget(Vector3(myPos.x + dir * 6.0, myPos.y + 0.35, 0))
	end

	@ExecSpace("ServerOnly")
	method any SpawnVisualStarEntity(number dir)
		-- 시각 전용 표창 엔티티를 스폰해 컴포넌트를 돌려준다(발사는 호출부가 한다). 실패 시 nil.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return nil end
		self._T.starSeq = (self._T.starSeq or 0) + 1
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("luckysevenprojectile",
			"heroStar_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.starSeq),
			Vector3(myPos.x + dir * 0.25, myPos.y + 0.35, 0), map)
		if not isvalid(proj) then return nil end
		---@type LuckySevenProjectile
		local comp = proj:GetComponent("script.LuckySevenProjectile")
		if not isvalid(comp) then return nil end
		comp.VisualOnly = true
		comp.CombatPower = 0
		-- 표창+ 유동 교체: 이번 시전에 고른 표창 모습으로 날아간다(기본 1번).
		comp.SkinIndex = self._T.starSkin or 1
		return comp
	end

	@ExecSpace("ServerOnly")
	method void CastAvengerVolley(Entity target, number dir)
		-- 어벤져(나이트로드 4차): **본체와 같은 진짜 관통 표창** - 큰 표창 하나가 전방을 꿰뚫으며
		-- 지나는 적을 전부 때린다(판정/표시 전부 avengerprojectile 내장).
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		-- (신고 2026-08-08) 본체 어벤져의 몸쪽 차지 이펙트(954896b2)를 함께 재생한다.
		---@type PlayerAttack
		local paC = self:GetOwnerAttack()
		if isvalid(paC) then
			paC:PlayAvengerCastEffect(self.Entity, "954896b2b40a4d8085586ea0ec2f0e19", -1)
		end
		local dm = self._T.dmgMult or 1.0
		local tt = target
		-- 본체와 같은 흐름: 차지 이펙트가 끝날 즈음(0.6초) 발사.
		local nowAv = _UtilLogic.ElapsedSeconds
		self._T.attackLockUntil = nowAv + 0.9
		self._T.nextAttackAt = math.max(self._T.nextAttackAt or 0, nowAv + 1.0)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or self._T.dying then return end
			---@type PlayerAttack
			local pa = self:GetOwnerAttack()
			if not isvalid(pa) then return end
			pa:FireSummonProjectileShot(self.Entity, "avenger", tt, self:GetCombatPower(),
				1.0 * dm, 2.0 * dm, 1, 1, 1)
			log("[HeroSummon] 어벤져 (" .. self:GetJobName() .. ")")
		end, 0.6)
	end

	-- (요청 2026-08-08) 표창 분산(나이트로드 1차): 몰려 있는 적마다 표창을 하나씩 나눠 던진다.
	-- 본체 표창 분산과 같은 규격 - 표창당 한 줄, 배율은 럭키세븐 표창 1발의 60%.
	@ExecSpace("ServerOnly")
	method void CastStarSpread(table crowd, number dir)
		-- 표창 분산(나이트로드 1차): 몰려 있는 적마다 진짜 표창을 하나씩 나눠 던진다
		-- (표창당 한 줄, 배율은 럭키세븐 표창 1발의 60% - 본체 분산과 같은 규격).
		local skinCount = _ShurikenLibrary:GetCount()
		self._T.starSkin = _UtilLogic:RandomIntegerRange(1, math.max(1, skinCount))
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		local dm = self._T.dmgMult or 1.0
		local thrown = 0
		for i, t in ipairs(crowd) do
			if isvalid(t) and thrown < 6 then
				thrown = thrown + 1
				local tt = t
				local ti = thrown
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) or self._T.dying then return end
					---@type PlayerAttack
					local pa = self:GetOwnerAttack()
					if not isvalid(pa) then return end
					pa:FireSummonProjectileShot(self.Entity, "star", tt, self:GetCombatPower(),
						(0.5 / 3.0) * 0.6 * dm, (2.5 / 3.0) * 0.6 * dm, 1, 1, self._T.starSkin or 1)
				end, 0.25 + (ti - 1) * 0.07)
			end
		end
		log("[HeroSummon] 표창 분산 targets=" .. tostring(thrown) .. " (" .. self:GetJobName() .. ")")
	end

	-- 섬광(히어로 2차): 본체 섬광의 소환수판 - 대상 곁으로 번쩍 이동해 베고, 본체와 같은
	-- 바닥/파편 이펙트(PlayFlashGroundEffect/PlayFlashShatterEffect - 엔티티·좌표 인자)를 쓴다.
	-- (본체는 클라 권한 자동 돌진 + 장착무기 투척이라 이동/무기 연출은 공유할 수 없다 -
	-- 소환수는 서버 권한이라 1회 순간이동으로 대신한다.)
	@ExecSpace("ServerOnly")
	method void CastFlashLite(Entity target, number dir)
		-- (신고 2026-08-08 2차 "본체 섬광과 로직이 다르다") 본체 섬광과 같은 3단계로 재작성:
		-- ① swingT2 모션 + 장착 무기(목검) 썸네일 검을 회전시키며 투척(14유닛/초, 900도/초 스핀)
		-- ② 대상 지점에 박히는 순간 바닥 파쇄 이펙트
		-- ③ 그 지점까지 자동 돌진(대시 틱)해 베기 - 데미지는 기존과 같은 300~400%.
		if not isvalid(target) then return end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		local tp = target.TransformComponent.WorldPosition
		local myPos = self.Entity.TransformComponent.WorldPosition
		self:PlayMotion("swingT2", 1.0)
		pa:PlayChainShotSound(self.Entity)
		pa:PlayFlashGroundEffect(self.Entity)
		local reach = math.abs(tp.x - myPos.x) + 0.5
		local throwDur = reach / 14.0
		local slideTime = math.max(0.08, math.min(0.6, reach / 12.0))
		local now2 = _UtilLogic.ElapsedSeconds
		self._T.attackLockUntil = now2 + throwDur + slideTime + 0.3
		local dm = self._T.dmgMult or 1.0
		local tt = target
		-- 검이 박힌 순간(투척 도착 콜백) 자동 돌진 시작 - 본체 FlashDash에 해당.
		self._T.flashArrive = function()
			if not isvalid(self.Entity) or self._T.dying then return end
			local nowD = _UtilLogic.ElapsedSeconds
			self._T.rushDir = dir
			self._T.rushStartAt = nowD
			self._T.rushIsChain = nil   -- 섬광 대시는 발판 끝 감지 규칙을 그대로 쓴다
			self._T.rushingUntil = nowD + slideTime
			local mvF = self.Entity.MovementComponent
			if isvalid(mvF) then
				if self._T.baseInputSpeed == nil then self._T.baseInputSpeed = mvF.InputSpeed end
				self._T.rushRestoreSpeed = mvF.InputSpeed
				mvF.InputSpeed = 12.0
				_TimerService:SetTimerOnce(function()
					local mv2 = self.Entity.MovementComponent
					if isvalid(mv2) and self._T.rushRestoreSpeed ~= nil then
						mv2.InputSpeed = self._T.rushRestoreSpeed
						self._T.rushRestoreSpeed = nil
					end
				end, slideTime + 0.02)
			end
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) or self._T.dying or not isvalid(tt) then return end
				self:DealHit(tt, 3.0 * dm, 4.0 * dm)
			end, math.max(0.05, slideTime * 0.6))
		end
		self:ThrowFlashSword(Vector2(myPos.x, myPos.y + 0.3), Vector2(tp.x, tp.y + 0.3))
		log("[HeroSummon] 섬광(검 투척→돌진) reach=" .. string.format("%.1f", reach) .. " (" .. self:GetJobName() .. ")")
	end

	-- 섬광 검 투척(공용): 본체 섬광 1단계와 같은 회전 검 투척 연출. 검 아트는 소환수 장착 무기
	-- (히어로=목검) 썸네일. 도착하면 파쇄 이펙트를 재생하고 _T.flashArrive 콜백을 1회 부른다.
	@ExecSpace("ServerOnly")
	method void ThrowFlashSword(Vector2 from, Vector2 to)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local dxs = to.x - from.x
		local dys = to.y - from.y
		local reach = math.sqrt(dxs * dxs + dys * dys)
		if reach < 0.2 then reach = 0.2 end
		local ndx = dxs / reach
		local ndy = dys / reach
		self._T.flashSeq = (self._T.flashSeq or 0) + 1
		local sword = _SpawnService:SpawnByModelId("spearburstfadingeffect", "SummonFlashSword" .. tostring(self._T.flashSeq), Vector3(from.x, from.y, 0), map)
		if isvalid(sword) then
			local spr = sword.SpriteRendererComponent
			if isvalid(spr) then
				spr.SpriteRUID = "thumbnail://43ad7bfeb9184252b24e6d60f76c17e5"   -- 히어로 목검(장착 무기와 동일)
				spr.OrderInLayer = 6
			end
			sword.TransformComponent.Scale = Vector3(2.0 / 3.0, 2.0 / 3.0, 1)
		end
		local SPEED = 14.0
		local SPIN = 900.0
		local dur = reach / SPEED
		local t0 = _UtilLogic.ElapsedSeconds
		local timerId = nil
		timerId = _TimerService:SetTimerRepeat(function()
			local el = _UtilLogic.ElapsedSeconds - t0
			local t = math.min(el / math.max(dur, 0.001), 1.0)
			if isvalid(sword) then
				sword.TransformComponent.Position = Vector3(from.x + ndx * reach * t, from.y + ndy * reach * t, 0)
				sword.TransformComponent.ZRotation = ((ndx >= 0) and -1 or 1) * SPIN * el
			end
			if t >= 1.0 then
				if timerId ~= nil then _TimerService:ClearTimer(timerId) end
				if isvalid(sword) then sword:Destroy() end
				if not isvalid(self.Entity) or self._T.dying then return end
				---@type PlayerAttack
				local pa2 = self:GetOwnerAttack()
				if isvalid(pa2) then
					-- 본체와 같은 규칙: 파쇄 분출 방향 = 표면 노멀(진행각 + 90도).
					pa2:PlayFlashShatterEffect(self.Entity, to.x, to.y, math.deg(math.atan(ndy, ndx)) + 90.0)
				end
				local cb = self._T.flashArrive
				self._T.flashArrive = nil
				if cb ~= nil then cb() end
			end
		end, 1 / 60)
	end

	@ExecSpace("ServerOnly")
	method void SpawnChainVisual(number anchorX, number anchorY, number life)
		-- (신고 2026-08-08 2차 "체인샷 리소스가 안 보인다") 본체 체인샷의 체인 줄(chainshotchain
		-- 모델)을 소환수에도 붙인다. 소환수 루트는 Scale.x 부호로 방향을 표현해 자식으로 스폰하면
		-- 줄이 미러링되므로, **맵 자식 + SourceEntity 추적**(ChainShotChain 확장)으로 스폰한다.
		local mapE = self.Entity.CurrentMap
		if not isvalid(mapE) then return end
		self._T.chainVisSeq = (self._T.chainVisSeq or 0) + 1
		local myP = self.Entity.TransformComponent.WorldPosition
		local chain = _SpawnService:SpawnByModelId("chainshotchain",
			"herochain_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.chainVisSeq),
			Vector3(myP.x, myP.y + 0.35, 0), mapE)
		if not isvalid(chain) then
			log_warning("[HeroSummon] 체인 줄 스폰 실패(chainshotchain)")
			return
		end
		---@type ChainShotChain
		local cc = chain:GetComponent("script.ChainShotChain")
		if isvalid(cc) then
			cc.SourceEntity = self.Entity
			cc.AnchorPos = Vector2(anchorX, anchorY)
			cc.Anchored = true
		end
		self._T.chainVisEnt = chain
		local ch = chain
		_TimerService:SetTimerOnce(function()
			if isvalid(ch) then ch:Destroy() end
		end, math.max(0.2, life))
	end

	-- 체인샷 상승(궁수 2차+): 위층에만 적이 있을 때 본체 체인샷처럼 사운드와 함께 그 발판 위로
	-- 당겨 올라간다(수평 체인샷 접근의 수직판). 착지 x는 대상 발판 안으로 클램프.
	@ExecSpace("ServerOnly")
	method void CastChainShotUpTo(Entity target)
		if not isvalid(target) then return end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		pa:PlayChainShotSound(self.Entity)
		local tp = target.TransformComponent.WorldPosition
		local myPos = self.Entity.TransformComponent.WorldPosition
		local side = (tp.x >= myPos.x) and -1 or 1
		local destX = tp.x + side * 2.0
		local tRb = target.RigidbodyComponent
		local tFh = isvalid(tRb) and tRb:GetCurrentFoothold() or nil
		local mapC = self.Entity.CurrentMap
		local fhC = isvalid(mapC) and mapC.FootholdComponent or nil
		if tFh ~= nil and fhC ~= nil then
			destX = pa:FindGroundEdgeX(fhC, tFh, tp.x, side, 2.0)
		end
		-- (신고 2026-08-08 2차 "체인샷 리소스가 안 보인다") 즉시 순간이동만 하던 것을 본체처럼
		-- "줄을 쏘아 보여주고(0.25초) → 당겨 올라감" 순서로 바꾼다.
		self:SpawnChainVisual(destX, tp.y + 0.4, 0.5)
		self:ApplyFacing((tp.x >= myPos.x) and 1 or -1)
		self._T.attackLockUntil = _UtilLogic.ElapsedSeconds + 0.65
		local ttU = target
		local destXU = destX
		local destYU = tp.y + 0.15
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or self._T.dying then return end
			local rbC = self.Entity.RigidbodyComponent
			if isvalid(rbC) then
				rbC:SetWorldPosition(Vector2(destXU, destYU))
				rbC:PositionReset()
			end
			self:PlayTeleportFx()
			if isvalid(ttU) then self._T.target = ttU end
		end, 0.25)
		log("[HeroSummon] 체인샷 상승(위층) (" .. self:GetJobName() .. ")")
	end

	-- 섬광 도약(히어로): 위층에만 적이 있을 때 그 곁으로 올라가 벤다 - 본체 섬광과 같은
	-- "검 투척 → 박힘+파쇄 → 이동" 순서를 수직으로 태운 판. 착지점은 대상 발판 높이 바로 위.
	@ExecSpace("ServerOnly")
	method void CastFlashUpTo(Entity target)
		if not isvalid(target) then return end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		local tp = target.TransformComponent.WorldPosition
		local myPos = self.Entity.TransformComponent.WorldPosition
		self:PlayMotion("swingT2", 1.0)
		pa:PlayChainShotSound(self.Entity)
		pa:PlayFlashGroundEffect(self.Entity)
		local side = (tp.x >= myPos.x) and -1 or 1
		local dxs = tp.x - myPos.x
		local dys = (tp.y + 0.3) - (myPos.y + 0.3)
		local throwDur = math.sqrt(dxs * dxs + dys * dys) / 14.0
		local nowF = _UtilLogic.ElapsedSeconds
		self._T.attackLockUntil = nowF + throwDur + 0.4
		local dm = self._T.dmgMult or 1.0
		local tt = target
		self._T.flashArrive = function()
			if not isvalid(self.Entity) or self._T.dying then return end
			local rbF = self.Entity.RigidbodyComponent
			if isvalid(rbF) and isvalid(tt) then
				local tp2 = tt.TransformComponent.WorldPosition
				rbF:SetWorldPosition(Vector2(tp2.x + side * 1.0, tp2.y + 0.15))
				rbF:PositionReset()
			end
			self._T.target = tt
			self:ApplyFacing((tp.x >= myPos.x) and 1 or -1)
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) or self._T.dying or not isvalid(tt) then return end
				self:DealHit(tt, 3.0 * dm, 4.0 * dm)
			end, 0.15)
		end
		self:ThrowFlashSword(Vector2(myPos.x, myPos.y + 0.3), Vector2(tp.x, tp.y + 0.3))
		log("[HeroSummon] 섬광 도약(위층, 검 투척) (" .. self:GetJobName() .. ")")
	end

	-- 돌진(전사 4차): 본체 AttackRush와 같은 로직의 소환수판.
	-- ① 전방의 적을 찾고(없으면 제자리 시전만 - 이동 없음) ② 발판 끝(FindGroundEdgeX 체인워크)
	-- 까지만 2.33유닛을 0.25초에 전진 ③ 몸 앞 1.0 "제설판"으로 경로의 적을 밀어 한 자리에 모으고
	-- ④ 데미지는 시전 1회분(전투력 300~400%). 본체는 클라 권한이라 클라가 움직이지만 소환수는
	-- 서버 권한이라 서버 틱 SetWorldPosition으로 자신과 몬스터를 함께 민다(본체 RushTick과 동일).
	@ExecSpace("ServerOnly")
	method void CastRushLite(Entity target, number dir)
		local now = _UtilLogic.ElapsedSeconds
		---@type PlayerAttack
		local paR = self:GetOwnerAttack()
		if not isvalid(paR) then return end
		paR:PlayRushUseSound(self.Entity)
		-- 본체와 같은 자세: stabO1의 2번째 프레임으로 고정한 채 전진.
		self:PlayPose("stabO1", 1)
		self._T.attackLockUntil = math.max(self._T.attackLockUntil or 0, now + 0.45)
		-- 본체 돌진의 노란 빔 5프레임 + 흰 섬광 6프레임(PlayRushCastEffect의 RUID 표 - 앵커판).
		local beam = {
			"c3dabaa7cf6543aaae6e12a8f7450755", "e329cbdd2402405f8a4ffa09dd73369f",
			"35e3a144e09c4f0db5ea3ddf9f8e6a21", "e01b24a0d0b14a919cce57e5a8e54c4c",
			"598fa2d4779049b9be5d9c4e62194d0c",
		}
		local white = {
			"5e115329cbbf43b481c144ae34190357", "4700271227d84b589e384262c3ace071",
			"560dc982d20745b391af3911ed148700", "ba976729a84a4003939e1d14c12b581d",
			"917b8bff6c5044f4a1bea90b7606609c", "639c7632196842e08b5a1a31a5f296f8",
		}
		paR:SpawnRushFrameEffectAt(beam, -1, -0.45, 0.35, 6, self.Entity)
		paR:SpawnRushFrameEffectAt(white, -1, -0.35, 0.45, 7, self.Entity)

		local myPos = self.Entity.TransformComponent.WorldPosition
		local RUSH_DIST = 2.33
		local PUSH_FRONT = 1.0
		-- ① 전방의 적만(본체 FindRushTargets - 뒤쪽 적은 밀 수 없다). 없으면 제자리 시전.
		local targets = paR:FindRushTargets(Vector2(myPos.x, myPos.y), dir, 6, RUSH_DIST + PUSH_FRONT)
		if targets == nil or #targets == 0 then
			log("[HeroSummon] 돌진 제자리 시전(전방에 적 없음) (" .. self:GetJobName() .. ")")
			return
		end
		-- ② 발판 끝 정지선(본체와 같은 체인워크).
		local mapR = self.Entity.CurrentMap
		local fhR = isvalid(mapR) and mapR.FootholdComponent or nil
		local rbR = self.Entity.RigidbodyComponent
		local startFh = isvalid(rbR) and rbR:GetCurrentFoothold() or nil
		local stopX = paR:FindGroundEdgeX(fhR, startFh, myPos.x, dir, RUSH_DIST)
		-- ③ 밀 대상별 "자기 발판 끝" 한계(본체 pushInfos와 동일).
		local pushInfos = {}
		for _, t in ipairs(targets) do
			if isvalid(t) then
				local tp = t.TransformComponent.WorldPosition
				local tRb = t.RigidbodyComponent
				local tFh = isvalid(tRb) and tRb:GetCurrentFoothold() or nil
				table.insert(pushInfos, { entity = t, limitX = paR:FindGroundEdgeX(fhR, tFh, tp.x, dir, RUSH_DIST + 2.0) })
			end
		end
		-- ④ 데미지는 시전 1회분(밀리는 동안 중복 타격 없음 - 본체와 동일).
		local dm = self._T.dmgMult or 1.0
		for i, t in ipairs(targets) do
			if isvalid(t) then
				local tt = t
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) or self._T.dying or not isvalid(tt) then return end
					self:DealHit(tt, 3.0 * dm, 4.0 * dm)
				end, 0.1 + (i - 1) * 0.05)
			end
		end
		-- 이동+밀기 틱(0.25초, 본체 RUSH_MOVE_DURATION과 동일).
		local startX = myPos.x
		local DUR = 0.25
		local timerId = nil
		timerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self.Entity) or self._T.dying then
				if timerId ~= nil then _TimerService:ClearTimer(timerId) end
				return
			end
			local q = math.min((_UtilLogic.ElapsedSeconds - now) / DUR, 1.0)
			local wantX = startX + dir * RUSH_DIST * q
			if (dir > 0 and wantX > stopX) or (dir < 0 and wantX < stopX) then wantX = stopX end
			local curP = self.Entity.TransformComponent.WorldPosition
			local mvR = self.Entity.MovementComponent
			if isvalid(mvR) then mvR:SetWorldPosition(Vector2(wantX, curP.y)) end
			-- 제설판: 몸 앞(plowX)보다 뒤에 있는 놈만 그 앞으로 - 결국 다 같은 자리에 모인다.
			local plowX = wantX + dir * PUSH_FRONT
			for _, info in ipairs(pushInfos) do
				local tE = info.entity
				if isvalid(tE) then
					local tp2 = tE.TransformComponent.WorldPosition
					local behindPlow = (dir > 0 and tp2.x < plowX) or (dir < 0 and tp2.x > plowX)
					if behindPlow then
						local px = plowX
						if (dir > 0 and px > info.limitX) or (dir < 0 and px < info.limitX) then px = info.limitX end
						if (dir > 0 and px > tp2.x) or (dir < 0 and px < tp2.x) then
							local tMv = tE.MovementComponent
							if isvalid(tMv) then tMv:SetWorldPosition(Vector2(px, tp2.y)) end
						end
					end
				end
			end
			if q >= 1.0 and timerId ~= nil then
				_TimerService:ClearTimer(timerId)
				timerId = nil
			end
		end, 1 / 60)
		log("[HeroSummon] 돌진(본체 로직) targets=" .. tostring(#targets) .. " stopX=" .. string.format("%.2f", stopX) .. " (" .. self:GetJobName() .. ")")
	end

	-- 브랜디쉬(히어로 4차): 본체와 같은 구성 - 1타 1줄 + 마무리 2줄(총 3줄), 두손검 스윙.
	-- (신고 2026-08-08) 이펙트가 원본과 달랐다 - 슬래시블러스트 타격 이펙트를 쓰고 있어서다.
	-- 본체 브랜디쉬의 사용음/시전 궤적/히트 이펙트(전부 엔티티를 받는 메서드)를 그대로 태운다.
	@ExecSpace("ServerOnly")
	method void CastBrandishLite(Entity target, number dir)
		self:PlayMotion("swingT2", 1.0)
		local dm = self._T.dmgMult or 1.0
		local tt = target
		---@type PlayerAttack
		local paB = self:GetOwnerAttack()
		if isvalid(paB) then
			paB:PlayBrandishUseSound(self.Entity)
			-- 용사 부착 이펙트는 부모 Scale.x 미러를 타므로 항상 왼쪽 기준(-1)을 넘긴다(공용 관례).
			paB:PlayBrandishCastEffect(self.Entity, -1, false)
		end
		-- 1타(1줄).
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or self._T.dying or not isvalid(tt) then return end
			self:DealHitLine(tt, 1.2 * dm, 2.2 * dm, 1, 3)
			---@type PlayerAttack
			local pa1 = self:GetOwnerAttack()
			if isvalid(pa1) then pa1:PlayBrandishHitEffect(tt) end
		end, 0.25)
		-- 마무리(swingTF) 2줄.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or self._T.dying then return end
			self:PlayMotion("swingTF", 1.0)
		end, 0.4)
		for i = 2, 3 do
			local li = i
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) or self._T.dying or not isvalid(tt) then return end
				self:DealHitLine(tt, 1.2 * dm, 2.2 * dm, li, 3)
				if li == 2 then
					---@type PlayerAttack
					local pa2 = self:GetOwnerAttack()
					if isvalid(pa2) then pa2:PlayBrandishHitEffect(tt) end
				end
			end, 0.55 + (li - 2) * 0.1)
		end
		log("[HeroSummon] 브랜디쉬 (" .. self:GetJobName() .. ")")
	end

	-- ══════ 섀도어 소환수 전투 ═══════════════════════════════════════════
	-- ⚠ 연출은 **분신(ShadowClone)이 쓰는 것과 같은 경로**를 그대로 태운다 -
	--   PlayerAttack.PlayShadowCloneCastFx / PlayShadowCloneHitFx는 임의 엔티티를 받으므로
	--   소환수에도 그대로 쓸 수 있고, 본체 섀도어 스킬과 같은 클립/사운드/알파가 나온다.
	-- (신고 2026-08-08) 예전엔 전사용 PlaySlashHitFx(슬래쉬블러스트 타격 이펙트)를 쓰고 있어
	--   "섀도어가 전사 1차 스킬을 쓴다"고 보였다 - 그게 이 교체의 이유다.
	@ExecSpace("ServerOnly")
	method void CastShadowerSkill(Entity target, number dir, string variant, integer hits, number multMin, number multMax, number step)
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		local frameInterval = 0.09

		-- 모션: 새비지블로우만 본체와 같은 포즈 조합(분신과 동일한 프레임/간격), 나머지는 순환 스윙.
		if variant == "savageblow" then
			local poses = {
				{ action = "stabO1",    frame = 0 },
				{ action = "swingOF",   frame = 3 },
				{ action = "proneStab", frame = 0 },
				{ action = "swingOF",   frame = 3 },
				{ action = "swingO2",   frame = 0 },
				{ action = "stabO1",    frame = 1 },
				{ action = "alert",     frame = 1 },
			}
			for i = 1, #poses do
				local pi = i
				local pa2 = poses[pi]
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) then return end
					self:PlayPose(pa2.action, pa2.frame)
				end, (pi - 1) * frameInterval)
			end
		else
			self:PlayMotion(self:NextSwingMotion(), 1.0)
		end

		-- 시전 연출(본체/분신과 같은 클립·사운드).
		pa:PlayShadowCloneCastFx(self.Entity, variant, dir, frameInterval)

		-- 대상 목록: 암살은 본체와 같은 연쇄 규칙(직전 대상에서 가장 가까운 적으로, 최대 10명).
		local targets = { target }
		if variant == "assassinate" then
			local chain = pa:BuildShadowCloneAssassinateChain(self.Entity, 10)
			if chain ~= nil and #chain > 0 then targets = chain end
			-- 사라졌다 나타나는 연출이라 마지막 타격 뒤 알파를 되돌린다(분신과 동일).
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				---@type PlayerAttack
				local paBack = self:GetOwnerAttack()
				if isvalid(paBack) then paBack:PlayShadowCloneReappear(self.Entity) end
			end, 0.45)
		end

		-- 새비지블로우 히트 이펙트 3종은 본체와 같이 **시전당 1개**를 골라 전 타격에 같은 것을 쓴다.
		local hitRuid = ""
		if variant == "savageblow" then hitRuid = pa:RollSavageBlowHitRuid() end

		-- 암살은 대상마다 시간차를 두고 옮겨 붙는다(한 프레임에 몰아치면 숫자가 겹쳐 한 줄로 보인다).
		local hopStep = 0.0
		if variant == "assassinate" then hopStep = 0.1 end
		for i = 1, hits do
			local idx = i
			for ti = 1, #targets do
				local tIdx = ti
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) then return end
					local t = targets[tIdx]
					if not isvalid(t) then return end
					---@type PlayerAttack
					local paHit = self:GetOwnerAttack()
					if isvalid(paHit) then
						paHit:PlayShadowCloneHitFx(self.Entity, t, variant, dir, hitRuid)
					end
					-- (신고 2026-08-08) 더블스탭 2줄/새비지블로우 6줄이 겹쳐 1줄로 보이던 것 -
					-- 줄 번호에 따라 세로로 쌓는 수동 표시 경로로 보낸다(암살은 대상당 1줄 그대로).
					if hits > 1 then
						self:DealHitLine(t, multMin, multMax, idx, hits)
					else
						self:DealHit(t, multMin, multMax)
					end
				end, 0.2 + (idx - 1) * step + (tIdx - 1) * hopStep)
			end
		end
		log("[HeroSummon] " .. variant .. " targets=" .. tostring(#targets) .. " (" .. self:GetJobName() .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ApplyFacing(number dir)
		-- 시전 시작 시점의 방향을 즉시 화면에 반영하고(faceDir+Scale), 이후 시전 잠금 동안 동결된다.
		self._T.faceDir = dir
		local wantScaleX = 1
		if dir > 0 then wantScaleX = -1 end
		if self._T.lastScaleX ~= wantScaleX then
			self._T.lastScaleX = wantScaleX
			local tr = self.Entity.TransformComponent
			if isvalid(tr) then tr.Scale = Vector3(wantScaleX, 1, 1) end
			self:SyncHpBarMirror(wantScaleX)
		end
	end

	@ExecSpace("ServerOnly")
	method string NextSwingMotion()
		-- 무기 계열별 공격 모션 순환: 목검(두손)=swingT, 카알대검(한손)=swingO, 창=swingP/stabT.
		-- (비숍 개편 2026-08-08)
		--   · 궁수는 활/석궁 발사 자세 하나만 쓴다 - 보우마스터=shoot1(활) / 신궁=shoot2(석궁).
		--     이 규칙은 플레이어 쪽(SkillManager.GetLocalBowCastMotion / PlayerAttack.GetBowCastMotion)과
		--     같아야 한다 - 한쪽만 바꾸면 소환수와 본인의 자세가 어긋난다.
		--   · 가니어(나이트로드)는 실측상 **한손무기 계열 모션(swingO1~O3)**이 맞다.
		--   · 후르츠 대거(섀도어)는 분신(ShadowClone)과 같은 찌르기 계열을 쓴다.
		local swings = { "swingT1", "swingT2", "swingT3" }
		if self.HeroLine == "paladin" then swings = { "swingO1", "swingO2", "swingO3" }
		elseif self.HeroLine == "darkknight" then swings = { "swingP1", "swingP2", "stabT1", "stabT2" }
		elseif self.HeroLine == "bowmaster" then swings = { "shoot1" }
		elseif self.HeroLine == "sniper" then swings = { "shoot2" }
		elseif self.HeroLine == "nightlord" then swings = { "swingO1", "swingO2", "swingO3" }
		elseif self.HeroLine == "shadower" then swings = { "stabO1", "swingO1", "swingO2" } end
		self._T.swingIdx = ((self._T.swingIdx or 0) % #swings) + 1
		return swings[self._T.swingIdx]
	end

	@ExecSpace("ServerOnly")
	method void PlayMotion(string motionName, number rate)
		-- 1회성 스킬 모션을 클라이언트에 명령(단일 @Sync 문자열이라 필드 간 도착 순서 문제가 없다).
		self._T.motionSeq = (self._T.motionSeq or 0) + 1
		self.MotionCmd = tostring(self._T.motionSeq) .. "|" .. motionName .. "|" .. tostring(rate)
	end

	@ExecSpace("ServerOnly")
	method void PlayPose(string motionName, number frameIdx)
		-- 지정한 액션의 한 프레임에 정지하는 포즈 명령(스피어버스터 5단 조합 모션용 -
		-- PlayerAttack.ApplySpearBurstPose와 같은 원리). MotionCmd 4번째 칸에 프레임 번호를 실어 보낸다.
		self._T.motionSeq = (self._T.motionSeq or 0) + 1
		self.MotionCmd = tostring(self._T.motionSeq) .. "|" .. motionName .. "|0.001|" .. tostring(frameIdx)
	end

	-- 다중 타격 스킬의 1줄(hitIndex/totalHits): 자동 표시가 겹쳐 "여러 줄이 1줄"로 보이는 문제를
	-- 피하려고 주인 PlayerAttack의 수동 다중 줄 경로(DealHeroSummonHitLine)로 보낸다.
	@ExecSpace("ServerOnly")
	method void DealHitLine(Entity target, number multMin, number multMax, integer hitIndex, integer totalHits)
		if self._T.dying then return end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) or not isvalid(target) then return end
		local dm = self._T.dmgMult or 1.0
		pa:DealHeroSummonHitLine(target, self:GetCombatPower(), multMin * dm, multMax * dm, hitIndex, totalHits)
	end

	@ExecSpace("ServerOnly")
	method void DealHit(Entity target, number multMin, number multMax)
		-- 주인 PlayerAttack의 skill.herosummon 파이프라인으로 1타(데미지 스킨/크리티컬 자동).
		-- 묘지 상태에서는 죽기 전에 예약된 공격 타이머가 뒤늦게 발동해도 무시한다.
		if self._T.dying then return end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) or not isvalid(target) then return end
		local dm = self._T.dmgMult or 1.0
		pa:DealHeroSummonHit(target, self:GetCombatPower(), multMin * dm, multMax * dm)
	end

	@ExecSpace("ServerOnly")
	method void CastPowerStrike(Entity target, number dir)
		-- 파워스트라이크: 단일 대상, 전투력 100%~200%.
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		self:PlayFxAttachedAt("522793cef4ff4b79bdf73b9eda9386f8", self.Entity, dir, 0)
		local tt = target
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or not isvalid(tt) then return end
			self:DealHit(tt, 1.0, 2.0)
			self:PlayFxAttachedAt("dad03b3a528348bf98295b01edd621a4", tt, dir, 0)
		end, 0.35)
		log("[HeroSummon] 파워스트라이크 (" .. self:GetJobName() .. ")")
	end

	@ExecSpace("ServerOnly")
	method void CastSlashBlast(number dir)
		-- 슬래쉬블래스트: 주변 최대 6명 순차 타격, 전투력 50%~150%.
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		self:PlayFxAttachedAt("44c1d14578e24c639e480f54b156a8a2", self.Entity, dir, 0)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			---@type PlayerAttack
			local pa = self:GetOwnerAttack()
			if not isvalid(pa) then return end
			local myPos = self.Entity.TransformComponent.WorldPosition
			local targets = pa:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 2.4, 6)
			for i, t in ipairs(targets) do
				local tt = t
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) or not isvalid(tt) then return end
					self:DealHit(tt, 0.5, 1.5)
					self:PlaySlashHitFx(tt, dir)
				end, (i - 1) * 0.1)
			end
		end, 0.35)
		log("[HeroSummon] 슬래쉬블래스트 (" .. self:GetJobName() .. ")")
	end

	@ExecSpace("ServerOnly")
	method void CastSpearBurst(number dir)
		-- 스피어버스터(용기사): 원본(PlayerAttack.AttackSpearBurst)과 동일한 타임라인을 용사 기준으로
		-- 재생한다(원본 코드의 시점 상수를 그대로 사용 - 원본이 바뀌면 여기도 함께 맞출 것).
		--   (피드백) 사용 전 1초 제자리 → [원본 시퀀스] 날개(c7051cc2)+5단 조합 포즈 모션 시작 /
		--   +0.35초 마법진+용머리(split growth) / +0.288초부터 0.15초 간격으로 찌르기 이펙트 3종
		--   (852883a5→3c2ee6e6→521bf9f6, 각각 공격 사운드 포함)과 3줄 데미지+피격 이펙트
		--   → 사용 후 1.5초 제자리.
		local now = _UtilLogic.ElapsedSeconds
		self._T.attackLockUntil = now + 3.3       -- 선딜 1.0 + 모션 콤보 0.72 + 후딜 1.5(+여유)
		self._T.nextAttackAt = math.max(self._T.nextAttackAt or 0, now + 3.4)
		self._T.repositionUntil = 0
		-- 대상은 원본처럼 시전 시작 시점에 고정한다(3타 도중 죽어도 3줄이 다 나가도록).
		local myPos = self.Entity.TransformComponent.WorldPosition
		---@type PlayerAttack
		local pa0 = self:GetOwnerAttack()
		if not isvalid(pa0) then return end
		local lockedTargets = pa0:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 2.6, 6)

		-- t=1.0(선딜 끝): 날개 + 5단 조합 포즈 모션 시작 + 마법진/용머리(+0.35).
		-- ⚠ 날개/마법진은 용사 자식 엔티티로 붙는데 용사는 좌우를 루트 Scale.x(-1)로 뒤집으므로
		--   (ApplyFacing), 차지 블로우 궤적과 동일하게 항상 왼쪽 기준(-1)으로 붙여 이중 반전을 피한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			---@type PlayerAttack
			local pa = self:GetOwnerAttack()
			if not isvalid(pa) then return end
			-- 날개(원본과 같은 좌표/트윈: 등 뒤 -0.1, 0.45+0.45초 페이드).
			-- (신고 2026-08-08) 4차는 본체 어드밴스드와 같은 전용 날개 아트(8da209f3)로 교체한다.
			-- 강화 아트는 중심피벗이라 원본(WZ 피벗)과 어긋난다 - 본체 실측 보정(오른쪽 0.253/위 1.005,
			-- 왼쪽 기준 고정이라 x 부호 반전 불필요)을 그대로 얹는다.
			local wingAdv = (self:GetStage() >= 4)
			local wingRuid = wingAdv and "8da209f377f249f292e1d0c50c928683" or "c7051cc242c54208a7c22df2b4bcc28e"
			local wingX = -0.1 * -1 + (wingAdv and 0.253 or 0)
			local wingY = 0.0 + (wingAdv and 1.005 or 0)
			pa:SpawnSpearBurstFadingEffectAt(
				wingRuid, Vector2(wingX, wingY), false,
				1.0, 1.0, 1.0, 0.0, 0.45, 0.45, -1, false, "", 0, 0, 0, 0, self.Entity
			)
			-- 5단 조합 포즈: stabT1 0/1/2 → stabTF 1 → stabT2 2 (원본 poseInterval 0.144초).
			local poses = {
				{ action = "stabT1", frame = 0 },
				{ action = "stabT1", frame = 1 },
				{ action = "stabT1", frame = 2 },
				{ action = "stabTF", frame = 1 },
				{ action = "stabT2", frame = 2 },
			}
			for i, p in ipairs(poses) do
				local pose = p
				_TimerService:SetTimerOnce(function()
					if not isvalid(self.Entity) then return end
					self:PlayPose(pose.action, pose.frame)
				end, (i - 1) * 0.144)
			end
			-- 마법진+용머리(split growth) - 원본과 같은 +0.35초, 몸통 앞(0.2)/높이 0.35.
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				---@type PlayerAttack
				local pa2 = self:GetOwnerAttack()
				if not isvalid(pa2) then return end
				-- (신고 2026-08-08) 4차 = 본체 어드밴스드와 같은 전용 마법진/용머리 아트.
				-- 강화 아트는 중심피벗이라 원본 클립의 pivotOffset 보정(-0.20/0.39, -0.21/0.37)이 필요 없다.
				local circAdv = (self:GetStage() >= 4)
				local circRuid = circAdv and "5b1685eba9af484cbcde8015ca7398f6" or "d757a7ca9e3b417fb2d0d5b725baa12c"
				local headRuid = circAdv and "3e2d1d048bb74bec8b9bd8966cde41ad" or "7d52e3968f954e2dabc8f5a050adcd40"
				local cPx = circAdv and 0 or -0.20
				local cPy = circAdv and 0 or 0.39
				local hPx = circAdv and 0 or -0.21
				local hPy = circAdv and 0 or 0.37
				pa2:SpawnSpearBurstFadingEffectAt(
					circRuid, Vector2(0.2 * -1, 0.35), false,
					0.75, 1.76, 0.6, 0.6, 0.0, 0.8 / 1.5 * 1.05, 10, true, headRuid,
					cPx, cPy, hPx, hPy, self.Entity
				)
			end, 0.35)
		end, 1.0)

		-- 찌르기 이펙트 3종 + 3줄 데미지: 원본과 같은 시점(0.288 + 0.15 간격), 선딜 1초만큼 뒤로.
		for hitIndex = 1, 3 do
			local hi = hitIndex
			local at = 1.0 + 0.288 + (hi - 1) * 0.15
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				if self._T.dying then return end
				---@type PlayerAttack
				local pa = self:GetOwnerAttack()
				if not isvalid(pa) then return end
				-- 찌르기 이펙트(공격 사운드 포함 - 원본과 동일하게 1타=마법진 찌르기/2타/3타 순).
				-- (버그 수정) 용사에 부착되는 이펙트는 용사의 루트 Scale.x(-1) 미러를 함께 타므로,
				-- 실제 방향(dir)을 넘기면 오른쪽을 볼 때 위치/방향이 이중 반전되어 반대쪽에서 재생됐다.
				-- 차지 블로우 궤적과 같은 관례로 항상 왼쪽 기준(-1)을 넘긴다(오른쪽은 부모 미러가 뒤집는다).
				-- (요청 2026-08-08) 4차 = 어드밴스드: 본체와 같은 규격으로 원본 파랑 찌르기 클립 대신
				-- **재색(파랑→검정) 용머리 스프라이트**를 쓴다. enhanced=true는 파랑 클립만 끄고 공격
				-- 사운드는 그대로 낸다(본체 PlaySpearBurst*Effect의 동작과 동일).
				local advStage = (self:GetStage() >= 4)
				if hi == 1 then
					pa:PlaySpearBurstCircleEffect(self.Entity, -1, advStage)
				elseif hi == 2 then
					pa:PlaySpearBurstBuildupEffect1(self.Entity, -1, advStage)
				else
					pa:PlaySpearBurstBuildupEffect2(self.Entity, -1, advStage)
				end
				if advStage then
					-- 본체 SpawnAdvSpearStabEffect와 같은 아트/오프셋 - 앵커만 용사로(항상 왼쪽 기준,
					-- 오른쪽은 부모 미러가 뒤집는다).
					local advRuids = {
						{ r = "9229298b79a64868b7cee06dc198edec", ox = 1.08, oy = 0.28 },
						{ r = "38361a0c587544dc8b6074920475db82", ox = 1.19, oy = 0.01 },
						{ r = "38922d3cb17f44bcaddf7d6269e5d6d2", ox = 1.17, oy = 0.37 },
					}
					local a = advRuids[hi]
					pa:SpawnSpearBurstFadingEffectAt(
						a.r, Vector2(a.ox * -1, a.oy), false,
						1.0, 1.0, 1.0, 0.0, 0.12, 0.14, 11, false, "", 0, 0, 0, 0, self.Entity
					)
				end
				-- 고정해둔 대상 전원에게 hi번째 줄 데미지 + 원본 피격 이펙트.
				-- (피드백) 자동 표시로는 3타가 같은 자리에 떠 "한 줄로 3번"처럼 보였다 -
				-- 원본과 동일한 위/중간/아래 3줄 수동 배치(DealHeroSummonStabHit)로 표시한다.
				local hitCount = 0
				local dm = self._T.dmgMult or 1.0
				-- (요청 2026-08-08) 4차 용사는 **어드밴스드 스피어 버스터** - 본체와 같은 규격으로
				-- 데미지 1.5배 + 강화(검붉은) 히트 이펙트를 쓴다.
				local advM = 1.0
				local advOn = false
				if self:GetStage() >= 4 then advM = 1.5 advOn = true end
				for _, t in ipairs(lockedTargets) do
					if isvalid(t) then
						local m = pa:RollSpearBurstMult()
						pa:DealHeroSummonStabHit(t, self:GetCombatPower(), m * dm * advM, hi)
						if advOn then
							-- 본체 어드밴스드와 같은 재작화 히트 아트(투명도 70%도 동일).
							pa:SpawnAdvSpearHitFrames(t, dir, 0.7, 0)
						else
							pa:PlaySpearBurstHitEffect(t, dir, hi, false)
						end
						hitCount = hitCount + 1
					end
				end
				if hi == 3 then
					log("[HeroSummon] 스피어버스터 3타 완료 targets=" .. tostring(hitCount))
				end
			end, at)
		end
		log("[HeroSummon] 스피어버스터 시전(선딜 1초/후딜 1.5초, 원본 타임라인) (" .. self:GetJobName() .. ")")
	end

	method integer GetElemAmpLv()
		-- (요청 2026-08-07) 3차(70) 이상 팔라딘 용사의 **속성 증폭** 레벨. 주인처럼 포인트를 찍는 게
		-- 아니라 자기 레벨로 환산한다 - 70=1, 5레벨당 +1, 115 이상이면 마스터 10.
		if self.HeroLine ~= "paladin" or self:GetStage() < 3 then return 0 end
		return math.max(1, math.min(10, math.floor((self.HeroLevel - 70) / 5) + 1))
	end

	method number GetElemAmpFactor()
		-- 중첩 연계 데미지 배율. 계산식은 주인 PlayerAttack.GetElementalAmpFactor와 동일(1 + 0.1×lv).
		local lv = self:GetElemAmpLv()
		if lv <= 0 then return 1.0 end
		return 1 + 0.1 * lv
	end

	method boolean CanUseElemField()
		-- **속성필드** 사용 가능 여부. 속성 증폭과 같은 3차(70) 게이트.
		return self.HeroLine == "paladin" and self:GetStage() >= 3
	end

	@ExecSpace("ServerOnly")
	method void CastChargeBlow(Entity target, number dir)
		-- 차지 블로우(70+ 팔라딘 주력기): 파워스트라이크급 공격에 현재 디바인 속성의 검 궤적과
		-- 상태이상(얼음=빙결 / 불=화상 / 전기=빙결 대상 2배+장판 / 성=+30%+스턴)을 싣는다.
		local now = _UtilLogic.ElapsedSeconds
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		-- (요청) 속성필드: 3차 이상이면 용사가 스스로 버프를 켠다. 꺼져 있으면 이번 턴은 공격 대신
		-- 시전 모션 1회로 갱신한다(주인 AttackElementalField와 같은 swingO2 + 시전 이펙트).
		if self:CanUseElemField() and (self._T.elemFieldUntil or 0) <= now then
			self._T.elemFieldUntil = now + 60.0
			self:PlayMotion("swingO2", 0.7)
			pa:PlayElementalFieldCastFx(self.Entity)
			log("[HeroSummon] 속성필드 버프 시전(60초) (" .. self:GetJobName() .. ")")
			return
		end
		-- (요청) 팔라딘 자동사냥의 속성 콤보(AutoHuntManager.ElementComboTick)와 **같은 사슬 순서**로
		-- 고정한다: 불(2) → 얼음(1) → 전기(3) → 성(4, 복귀). 연계 쌍은
		--   "불 화상/불 필드 + 얼음 차지 블로우 → 화상 저주 장판"
		--   "얼음 빙결/얼음 필드 + 전기 차지 블로우 → 2배 + 감전 장판"
		-- 둘뿐이라 이 순서로 **연속** 시전해야 앞 스텝의 결과가 다음 스텝에 소모된다.
		-- 구 구현("2~10초마다 임의 속성으로 전환")은 전기→불처럼 연계 불가 조합이 자주 나와
		-- 상태이상만 걸고 아무것도 안 터지는 헛시전이 됐다.
		local seq = { 2, 1, 3, 4 }
		self._T.divineIdx = ((self._T.divineIdx or 0) % #seq) + 1
		local mode = seq[self._T.divineIdx]
		self._T.divineMode = mode
		local motion = self:NextSwingMotion()
		self:PlayMotion(motion, 1.0)
		local myMode = mode
		local myMotion = motion
		local myAmp = self:GetElemAmpFactor()
		local myField = self:CanUseElemField()
		-- (피드백) 검 궤적이 시전 즉시 나와 모션과 안 맞았다 - 원본(파워스트라이크 판정 시점과 동일한
		-- 0.45초 뒤)에 맞춰 궤적과 판정을 함께 지연한다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			---@type PlayerAttack
			local pa2 = self:GetOwnerAttack()
			if not isvalid(pa2) then return end
			-- 속성 검 궤적: 플레이어 차지 블로우와 같은 프레임 표/행 배정(팔라딘 모션이 같은 한손검 swingO 계열).
			-- 용사는 좌우를 루트 Scale.x(-1)로 뒤집으므로(ApplyFacing), 자식으로 붙는 궤적 이펙트가
			-- 부모 미러와 이중으로 뒤집히지 않게 항상 왼쪽 기준(-1)으로 붙인다 - 오른쪽을 볼 땐
			-- 부모 미러가 위치/방향을 함께 뒤집어 준다.
			local frames = pa2:GetChargeBlowTrailFrames(myMode, myMotion)
			if frames ~= nil then
				local row = pa2:GetChargeBlowTrailRow(myMotion)
				pa2:SpawnChargeBlowTrailFramesAt(frames, -1, 0.75, 0.35, 1.0,
					pa2:IsChargeBlowTrailMirrored(myMode, row), pa2:IsChargeBlowTrailFlippedY(myMotion),
					pa2:GetChargeBlowTrailScaleY(myMotion), self.Entity)
			end
			local myPos = self.Entity.TransformComponent.WorldPosition
			local myCp = self:GetCombatPower()
			local targets = pa2:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 2.0, 3)
			-- 필드는 한 번 연계에 쓰이면 사라진다 - 이번 시전에서 한 장만 소모하도록 잠근다.
			local linked = false
			-- (실측 보정) 필드를 용사 발밑에 깔았더니 8사이클에 1번밖에 연계가 안 붙었다 - 용사는
			-- 시전 사이에 재배치(0.35~0.7초 이동)를 하고 다음 스텝은 다른 자리에서 나가는데,
			-- 필드 판정 범위가 ±1.6/±1.2로 좁아 자기가 깐 필드를 스스로 벗어난다. 몬스터는 그 자리에
			-- 남으므로 **때린 대상 자리**에 깔면 다음 스텝(다음 속성)이 같은 몬스터를 때릴 때 그대로 소모된다.
			local fieldPos = myPos
			for _, t in ipairs(targets) do
				if isvalid(t) then
					if fieldPos == myPos then fieldPos = t.TransformComponent.WorldPosition end
					local factor = 1.0
					if myMode == 4 then
						factor = 1.3
					elseif myMode == 3 and pa2:IsTargetFrozen(t) then
						-- (요청) 속성 증폭은 빙결 2배 보정에도 곱해진다(주인 GetChargeBlowDamageFactor와 동일).
						factor = 2.0 * myAmp
					end
					self:DealHit(t, 1.0 * factor, 2.0 * factor)
					if myMode == 1 then
						-- (피드백) 속성 중복 타격: 화상 중인 적을 얼음으로 때리면 원본과 동일하게
						-- "화상 저주" 장판(20초, 3초마다 전투력 100%)을 남긴다. 빙결(50%)과는 별개로 항상 발동.
						-- (요청) 장판 위력은 **용사 자기 전투력 × 속성 증폭** 기준 - 구 SpawnChargeBlowCurseZone은
						-- 주인이 마지막에 시전한 차지 블로우의 위력을 그대로 썼다.
						if pa2:IsTargetBurning(t) then
							pa2:SpawnChargeBlowCurseZoneFor(t, myCp * myAmp)
							if not linked then
								linked = pa2:ConsumeElemFieldAt(t.TransformComponent.WorldPosition, 2)
							end
						end
						-- (요청) 빙결 지속시간 통일: 3초 → 4초.
					if _UtilLogic:RandomDouble() < 0.5 then pa2:ApplyChargeBlowFreeze(t, 4.0) end
					elseif myMode == 2 then
						if _UtilLogic:RandomDouble() < 0.5 then pa2:ApplyChargeBlowBurn(t) end
					elseif myMode == 3 then
						-- 속성 중복 타격: 빙결된 적을 전기로 때리면 2배 + 전용 히트 이펙트 + 10초 장판(원본과 동일).
						if factor >= 2.0 then
							pa2:PlayChargeBlowShockHitEffect(t)
							pa2:SpawnChargeBlowShockZoneFor(t, myCp * myAmp)
							if not linked then
								linked = pa2:ConsumeElemFieldAt(t.TransformComponent.WorldPosition, 1)
							end
						end
					else
						pa2:ApplyChargeBlowStun(t)
					end
				end
			end
			-- (주인과 동일) 허공 연계: 판정에 아무도 안 맞았어도 용사가 상반 속성 필드 위에 서 있으면
			-- 중첩 결과물을 남긴다 - 몹이 죽거나 흩어져도 사슬이 끊기지 않는다.
			if #targets == 0 then
				if myMode == 1 and pa2:IsPosInElemField(myPos, 2) then
					pa2:SpawnChargeBlowCurseZoneFor(self.Entity, myCp * myAmp)
					pa2:ConsumeElemFieldAt(myPos, 2)
					log("[HeroSummon] 허공 연계: 불 필드 + 얼음 → 화상 저주")
				elseif myMode == 3 and pa2:IsPosInElemField(myPos, 1) then
					pa2:PlayChargeBlowShockHitEffect(self.Entity)
					pa2:SpawnChargeBlowShockZoneFor(self.Entity, myCp * myAmp)
					pa2:ConsumeElemFieldAt(myPos, 1)
					log("[HeroSummon] 허공 연계: 얼음 필드 + 전기 → 감전 장판")
				end
			end
			-- (요청) 속성필드: 시전한 속성(1~3)의 필드를 남긴다. 다음 사슬 스텝이 이 필드를 소모하므로
			-- 몬스터의 상태이상(화상/빙결)이 확률에 걸리지 않아도 연계가 이어진다. 자리는 때린 대상
			-- (없으면 발밑). 소모 판정을 **먼저** 끝낸 뒤 깔아야 방금 깐 필드를 스스로 먹지 않는다.
			if myField and myMode >= 1 and myMode <= 3 then
				pa2:SpawnElemFieldAtPos(fieldPos, myMode, 12.0)
			end
		end, 0.45)
		log("[HeroSummon] 차지 블로우 mode=" .. tostring(mode) .. " (" .. self:GetJobName() .. ")")
	end

	@ExecSpace("ServerOnly")
	method void UseSpecialSkill(number dir, number now)
		-- 특수기: 크루세이더 이상=코마, 용기사 이상=드래곤로어. 쿨타임 15~30초.
		local stage = self:GetStage()
		local kind = nil
		if self.HeroLine == "hero" and stage >= 3 then kind = "coma"
		elseif self.HeroLine == "darkknight" and stage >= 3 then kind = "dragonroar" end
		-- (비숍 개편 2026-08-08) 궁수/도적 계열은 별도 특수기를 두지 않는다 - 주력기(아이언 에로우·
		-- 파이어/아이스 샷 / 트리플 스로우·어벤져·암살)가 이미 광역이라 특수기까지 얹으면
		-- 전사 계열보다 과해진다. 다음 판정만 뒤로 미뤄 매 틱 재확인하지 않게 한다.
		if self:IsArcherLine() or self:IsThiefLine() then kind = nil end
		if kind == nil then
			self._T.nextSpecialAt = now + 60.0
			return
		end
		self._T.nextSpecialAt = now + 15.0 + _UtilLogic:RandomDouble() * 15.0
		self:ApplyFacing(dir)
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		if kind == "dragonroar" then
			self:CastDragonRoar(dir, now)
			return
		end
		-- 코마(크루세이더 이상): 기존 규격 유지. (피드백) 시전과 함께 떠 있던 콤보 구슬을 전부
		-- 소모한다 - 이후 스킬을 쓸 때마다 다시 하나씩 차오른다(AddHeroOrb).
		self._T.attackLockUntil = now + 1.0
		self:ClearHeroOrbs()
		self:PlayMotion(self:NextSwingMotion(), 1.0)
		pa:PlayComaUseSound(self.Entity)
		pa:PlayComaCastEffect(self.Entity, dir, 5)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			---@type PlayerAttack
			local pa2 = self:GetOwnerAttack()
			if not isvalid(pa2) then return end
			local myPos = self.Entity.TransformComponent.WorldPosition
			local targets = pa2:FindMonstersInRadius(Vector2(myPos.x, myPos.y), 4.0, 8)
			for _, t in ipairs(targets) do
				if isvalid(t) then
					self:DealHit(t, 2.0, 3.0)
					pa2:PlayComaHitEffect(t, 5)
				end
			end
			log("[HeroSummon] coma 발동 targets=" .. tostring(#targets))
		end, 0.5)
		log("[HeroSummon] 특수기 coma (" .. self:GetJobName() .. ")")
	end

	@ExecSpace("ServerOnly")
	method void CastDragonRoar(number dir, number now)
		-- (요청 2026-08-08) 본체 드래곤 로어와 같이 **HP를 대가로 쓴다** - 소환수 최대 HP의 30%.
		-- (요청 2026-08-08 2차) 남은 HP가 **50% 미만이면 시전하지 않는다** - 본체 자동사냥의 로어
		-- HP 게이트와 같은 발상(자해기라 저체력에 쓰면 위험). 50%가 시전 비용(30%)보다 넉넉하므로
		-- 이 게이트 하나로 "비용 부족" 취소까지 겸한다.
		local roarCost = math.floor(self.HeroMaxHp * 0.30)
		if self.HeroHp < self.HeroMaxHp * 0.5 then
			self._T.nextSpecialAt = now + 15.0
			log("[HeroSummon] 드래곤로어 취소 - HP 50% 미만 (" .. tostring(math.floor(self.HeroHp)) .. "/" .. tostring(math.floor(self.HeroMaxHp)) .. ")")
			return
		end
		self.HeroHp = self.HeroHp - roarCost
		self:UpdateHpBar()
		self:FlashHpBar()
		log("[HeroSummon] 드래곤로어 HP 소모 " .. tostring(roarCost) .. " → " .. tostring(math.floor(self.HeroHp)) .. "/" .. tostring(math.floor(self.HeroMaxHp)))
		-- 드래곤로어(용기사 이상): (피드백) 원본 규격으로 재작업.
		--   사용 전 1초 제자리 → 시전(alert 모션 + 원본 시전 이펙트/사운드/화면흔들림 + 2초 자기 스턴 표시)
		--   → 1.5초 뒤 폭발(전방위 최대 20명, 전투력 1000%~1300% + 원본 히트 이펙트) → 사용 후 3초 제자리.
		self._T.attackLockUntil = now + 5.5    -- 선딜 1.0 + 폭발까지 1.5 + 후딜 3.0
		self._T.nextAttackAt = math.max(self._T.nextAttackAt or 0, now + 5.6)
		self._T.repositionUntil = 0
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			---@type PlayerAttack
			local pa = self:GetOwnerAttack()
			if not isvalid(pa) then return end
			self:PlayMotion("alert", 1.0)
			pa:PlayDragonRoarCastEffect(self.Entity)
			pa:PlayDragonRoarStunEffect(self.Entity)
		end, 1.0)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			---@type PlayerAttack
			local pa = self:GetOwnerAttack()
			if not isvalid(pa) then return end
			local myPos = self.Entity.TransformComponent.WorldPosition
			local targets = pa:FindDragonRoarTargets(Vector2(myPos.x, myPos.y), 20)
			for _, t in ipairs(targets) do
				if isvalid(t) then
					-- 배율은 원본과 같은 공식(RollDragonRoarMult)을 읽는다 - 원본이 바뀌면 자동 반영.
					local m = pa:RollDragonRoarMult()
					self:DealHit(t, m, m)
					pa:PlayDragonRoarHitEffect(t)
				end
			end
			log("[HeroSummon] 드래곤로어 폭발 targets=" .. tostring(#targets))
		end, 2.5)
		log("[HeroSummon] 드래곤로어 시전(선딜 1초/후딜 3초) (" .. self:GetJobName() .. ")")
	end

	-- ── 버프(서버) ───────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method string GetBuffKind()
		-- 현재 직업의 버프 종류. 없으면 "".
		local stage = self:GetStage()
		if self.HeroLine == "hero" then
			if stage >= 3 then return "comboattack" end     -- 크루세이더/히어로
			if stage == 2 then return "rage" end            -- 파이터(분노 30초)
		elseif self.HeroLine == "paladin" then
			-- (요청 2026-08-08) 팔라딘은 본체 자동사냥처럼 **가드**(패링 창)도 쓴다 - 자체 쿨(30초)이
			-- 돌았으면 가드를 우선하고, 아니면 기존 공속/부스터 버프를 유지한다.
			local nowP = _UtilLogic.ElapsedSeconds
			if (self._T.guardReadyAt or 0) <= nowP then return "guard" end
			if stage >= 3 then return "knight" end          -- 나이트/팔라딘(공속 2단계 1분)
			if stage == 2 then return "booster" end         -- 페이지(부스터 1분, 본인 것과 별개)
		elseif self.HeroLine == "darkknight" then
			-- (요청 2026-08-08) 3차 이상은 **드래곤 라이딩**(드래곤 소환 - 곁을 날며 자동 공격)을 유지한다.
			-- 드래곤이 아직 살아 있으면 CastBuff가 재소환을 건너뛴다.
			if stage >= 3 then return "dragonride" end
			if stage == 2 then return "powerguard" end      -- 스피어맨(파워가드 30초)
		elseif self:IsArcherLine() then
			-- (비숍 개편 2026-08-08) 궁수는 2차부터 부스터(공격속도)를 유지한다 - 자동사냥의 궁수
			-- 버프 유지와 같은 성격이고, 이미 구현돼 있는 booster 연출을 그대로 쓴다.
			if stage >= 2 then return "booster" end
		elseif self:IsThiefLine() then
			-- (요청 2026-08-08 재조정) 도적류(나이트로드·섀도어 공통)는 2차부터 **헤이스트가 최우선** -
			-- 자기 헤이스트가 꺼져 있으면 빠르게 다시 걸고(파티 전파 포함), 걸려 있는 동안에는
			-- 3차부터 쉐도우 파트너를 유지한다. 우선순위 방식이라 두 버프가 대부분 함께 걸려 있게 된다.
			local nowB = _UtilLogic.ElapsedSeconds
			if stage >= 2 and (self._T.selfHasteUntil or 0) <= nowB then return "haste" end
			if stage >= 3 then return "shadowpartner" end
			if stage >= 2 then return "booster" end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void ScheduleBuff(boolean isFirst)
		-- 버프 직업이면 지속시간이 끝날 즈음마다 재시전한다.
		local kind = self:GetBuffKind()
		if kind == "" then return end
		local delay = 35.0 + _UtilLogic:RandomDouble() * 10.0
		if kind == "booster" or kind == "knight" then
			delay = 65.0 + _UtilLogic:RandomDouble() * 10.0
		end
		if isFirst then delay = 2.0 + _UtilLogic:RandomDouble() * 3.0 end
		-- (요청 2026-08-08) 도적류는 헤이스트를 "빠르게" 걸어야 한다 - 첫 버프를 1~2초로 앞당긴다.
		if isFirst and self:IsThiefLine() then delay = 1.0 + _UtilLogic:RandomDouble() * 1.0 end
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			self:CastBuff(kind)
			self:ScheduleBuff(false)
		end, delay)
	end

	@ExecSpace("ServerOnly")
	method void CastBuff(string kind)
		-- 버프 시전: 이펙트는 용사 자신에게(PlayerAttack의 공용 프레임 이펙트 재사용), 효과는 _T에 토큰으로.
		-- 묘지 상태에서는 재시전 예약이 발동해도 무시한다.
		if self._T.dying then return end
		-- (신고 2026-08-08 4차 "체인샷으로 날아가는 도중 다른 행동을 해서 끊긴다") 버프 재시전은 순수
		-- 타이머라 대시(체인샷/돌진/섬광)·스킬 모션·드래곤 비행 한가운데서도 발동해 동작을 끊었다 -
		-- 그동안은 1.2초 뒤로 미룬다(끝날 때까지 반복 지연).
		local nowB = _UtilLogic.ElapsedSeconds
		if (self._T.rushingUntil or 0) > nowB or (self._T.attackLockUntil or 0) > nowB
			or self._T.flyDestX ~= nil then
			local deferredKind = kind
			_TimerService:SetTimerOnce(function()
				if isvalid(self.Entity) then self:CastBuff(deferredKind) end
			end, 1.2)
			return
		end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		local dir = self._T.faceDir or 1
		local now = _UtilLogic.ElapsedSeconds
		self._T.attackLockUntil = now + 1.0
		self._T.buffToken = (self._T.buffToken or 0) + 1
		local tok = self._T.buffToken
		if kind == "rage" then
			-- 분노(30초): 데미지 1.3배 + 분노 프레임 이펙트/사운드.
			self._T.dmgMult = 1.3
			pa:SpawnBuffFrameEffectEx(pa:BuildRageFrames(), dir, 0.1, 0.25, self.Entity, 1.0, 1.0, 1.0)
			pa:PlayBuffSound("267c7840593c419098060eb07e2b4dbb")
			_TimerService:SetTimerOnce(function()
				if self._T.buffToken == tok then self._T.dmgMult = 1.0 end
			end, 30.0)
			log("[HeroSummon] 버프: 분노(30초, 데미지 1.3배)")
		elseif kind == "comboattack" then
			-- 콤보어택(30초): 데미지 1.2배 + 시전 마법진/사운드 + (피드백) 플레이어와 같은
			-- 궤도를 도는 콤보 구슬 연출. 버프 중 스킬을 쓸 때마다 +1(최대 5), 코마가 전부 소모한다.
			self._T.dmgMult = 1.2
			self._T.comboBuffActive = true
			self:PlayComboFx()
			self:AddHeroOrb()
			_TimerService:SetTimerOnce(function()
				if self._T.buffToken == tok then
					self._T.dmgMult = 1.0
					self._T.comboBuffActive = false
					self:ClearHeroOrbs()
				end
			end, 30.0)
			log("[HeroSummon] 버프: 콤보 어택(30초, 데미지 1.2배 + 콤보 구슬)")
		elseif kind == "powerguard" then
			-- 파워가드(30초): 시각 효과(좌우 합쳐짐 + 본체 실드) 재현. 몬스터가 용사를 공격하지
			-- 않으므로 반사 효과는 표현만 한다.
			self:CastPowerGuardFx(pa, dir)
			pa:PlayBuffSound("a83d56a314fd449cad236fd7d9b2fa63")
			log("[HeroSummon] 버프: 파워가드(30초)")
		elseif kind == "booster" then
			-- 부스터(1분, 본인의 부스터와 별개): 공격 쿨타임 0.9배.
			self._T.atkCdMult = 0.9
			self:CastBoosterFx(pa, dir)
			pa:PlayBuffSound("a83d56a314fd449cad236fd7d9b2fa63")
			_TimerService:SetTimerOnce(function()
				if self._T.buffToken == tok then self._T.atkCdMult = 1.0 end
			end, 60.0)
			log("[HeroSummon] 버프: 부스터(60초, 공격 쿨타임 0.9배)")
		elseif kind == "knight" then
			-- 나이트 공속 버프(1분): 공속 +2단계 = 쿨타임 0.81배(0.9^2).
			self._T.atkCdMult = 0.81
			self:CastBoosterFx(pa, dir)
			pa:PlayBuffSound("a83d56a314fd449cad236fd7d9b2fa63")
			_TimerService:SetTimerOnce(function()
				if self._T.buffToken == tok then self._T.atkCdMult = 1.0 end
			end, 60.0)
			log("[HeroSummon] 버프: 공격속도 +20%(60초, 쿨타임 0.81배)")
		elseif kind == "guard" then
			-- 가드(팔라딘): 본체와 같은 규격 - 1.2초 패링 창을 열고, 그 안에 맞으면 피해를 통째로
			-- 막고(가드 표시) 2초 무적 + 10초간 받는 피해 30% 감소를 얻는다. 자체 쿨 30초.
			local nowG = _UtilLogic.ElapsedSeconds
			self._T.guardReadyAt = nowG + 30.0
			self._T.guardWindowUntil = nowG + 1.2
			log("[HeroSummon] 버프: 가드(1.2초 패링 창)")
		elseif kind == "dragonride" then
			-- 드래곤 라이딩(다크나이트 3차+): 드래곤이 살아 있으면 재소환하지 않는다(중복 방지).
			local nowD = _UtilLogic.ElapsedSeconds
			if (self._T.summonDragonUntil or 0) > nowD then
				log("[HeroSummon] 드래곤 라이딩 - 이미 소환 중(건너뜀)")
			else
				local DRAGON_DUR = 150.0
				self._T.summonDragonUntil = nowD + DRAGON_DUR
				self._T.rideDragonEnt = pa:SpawnSummonRideDragon(self.Entity, self:GetCombatPower(), DRAGON_DUR)
				log("[HeroSummon] 버프: 드래곤 라이딩(" .. tostring(DRAGON_DUR) .. "초)")
			end
		elseif kind == "shadowpartner" then
			-- (요청 2026-08-08) 쉐도우 파트너(도적 3차, 60초): 본체와 같은 성격 - **타수 2배**다.
			-- 소환수는 타수를 그대로 늘리는 대신 같은 값이 되도록 데미지 배율을 2배로 준다
			-- (줄 수까지 늘리면 이 파일의 모든 스킬에 hits 분기를 넣어야 해 유지가 어렵다).
			self._T.dmgMult = 2.0
			self:CastBoosterFx(pa, dir)
			pa:PlayBuffSound("a83d56a314fd449cad236fd7d9b2fa63")
			_TimerService:SetTimerOnce(function()
				if self._T.buffToken == tok then self._T.dmgMult = 1.0 end
			end, 60.0)
			log("[HeroSummon] 버프: 쉐도우 파트너(60초, 데미지 2배)")
		elseif kind == "haste" then
			-- (요청 2026-08-08) 헤이스트(도적류, 60초): 자신의 이동/공격/점프가 빨라지고,
			-- **곁의 파티원(다른 소환수 + 주인)에게 버프가 없으면 함께 걸어준다**.
			-- (신고 2026-08-08) 이펙트가 뒤바뀌어 있었다 - **시전자인 소환수가 사용(시전) 이펙트**,
			-- 받는 쪽(주인/다른 소환수)이 받는 이펙트여야 한다.
			self._T.atkCdMult = 0.9
			self:ReceiveHaste(60.0, false)
			pa:PlayHasteCastEffect(self.Entity)
			pa:PlayBuffSound("a83d56a314fd449cad236fd7d9b2fa63")
			_TimerService:SetTimerOnce(function()
				if self._T.buffToken == tok then self._T.atkCdMult = 1.0 end
			end, 60.0)
			-- 자기 헤이스트 창 기록 - GetBuffKind가 "꺼져 있으면 헤이스트 최우선" 판단에 쓴다.
			self._T.selfHasteUntil = now + 60.0
			self:SpreadHasteToParty()
			log("[HeroSummon] 버프: 헤이스트(60초) - 파티원에게도 전파")
		end
	end

	-- (요청 2026-08-08) 헤이스트 파티 전파: 곁의 **다른 소환수 + 주인 플레이어** 중
	-- 아직 헤이스트가 없는 대상에게만 걸어준다(이미 있는 대상은 건너뛴다).
	-- 받는 쪽은 헤이스트 이펙트가 뜨고 이동속도 +20% / 점프 보정을 받는다.
	@ExecSpace("ServerOnly")
	method void SpreadHasteToParty()
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		local myPos = self.Entity.TransformComponent.WorldPosition
		local spread = 0
		-- ① 다른 소환수(용사/궁수/도적) - 같은 주인이 부른 것만.
		for _, comp in ipairs(map:GetChildComponentsByTypeName("script.HeroSummon", true)) do
			---@type HeroSummon
			local hs = comp
			if isvalid(hs) and isvalid(hs.Entity) and hs.Entity ~= self.Entity
				and hs.OwnerEntity == self.OwnerEntity and hs.HeroHp > 0 then
				local p = hs.Entity.TransformComponent.WorldPosition
				if math.abs(p.x - myPos.x) <= 6.0 and math.abs(p.y - myPos.y) <= 4.0 then
					if hs:ReceiveHaste(60.0, true) then spread = spread + 1 end
				end
			end
		end
		-- ② 주인 플레이어 - 헤이스트 버프가 없을 때만 걸어준다(서버 경로는 PlayerAttack이 들고 있다).
		if isvalid(pa) and isvalid(self.OwnerEntity) then
			local op = self.OwnerEntity.TransformComponent.WorldPosition
			if math.abs(op.x - myPos.x) <= 6.0 and math.abs(op.y - myPos.y) <= 4.0 then
				if pa:GrantHasteFromSummon(60.0) then spread = spread + 1 end
			end
		end
		log("[HeroSummon] 헤이스트 전파 - " .. tostring(spread) .. "명")
	end

	-- 다른 소환수에게서 헤이스트를 받는다. 이미 받고 있으면 false(중복 시전 방지).
	-- showFx: 받는 이펙트 재생 여부 - 시전자 자신은 사용 이펙트를 따로 재생하므로 false로 부른다.
	@ExecSpace("ServerOnly")
	method boolean ReceiveHaste(number duration, boolean showFx)
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.hasteUntil or 0) > now then return false end
		self._T.hasteUntil = now + duration
		-- 이동속도 +20% + **점프 보정 +20%**: 소환수 이동/점프는 MovementComponent가 정한다.
		-- (신고 2026-08-08) 이속만 올리고 점프를 안 올려서 "소환수는 점프 보정을 못 받는다"였다.
		local mv = self.Entity.MovementComponent
		if isvalid(mv) then
			if self._T.baseInputSpeed == nil then self._T.baseInputSpeed = mv.InputSpeed end
			if self._T.baseJumpForce == nil then self._T.baseJumpForce = mv.JumpForce end
			mv.InputSpeed = (self._T.baseInputSpeed or mv.InputSpeed) * 1.2
			mv.JumpForce = (self._T.baseJumpForce or mv.JumpForce) * 1.2
		end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if showFx and isvalid(pa) then
			-- 받는 쪽에만 헤이스트 **받는 이펙트**를 띄운다(분신이 쓰는 것과 같은 경로).
			pa:PlayShadowCloneHasteFx(self.Entity)
		end
		local myTok = (self._T.hasteToken or 0) + 1
		self._T.hasteToken = myTok
		_TimerService:SetTimerOnce(function()
			if self._T.hasteToken ~= myTok then return end
			local mv2 = self.Entity.MovementComponent
			if isvalid(mv2) then
				if self._T.baseInputSpeed ~= nil then mv2.InputSpeed = self._T.baseInputSpeed end
				if self._T.baseJumpForce ~= nil then mv2.JumpForce = self._T.baseJumpForce end
			end
		end, duration)
		log("[HeroSummon] 헤이스트 받음(" .. tostring(duration) .. "초, 이동속도/점프 +20%)")
		return true
	end

	@ExecSpace("ServerOnly")
	method void AddHeroOrb()
		-- 콤보 구슬 +1(최대 5): 플레이어 AddComboOrb와 같은 구성 - 첫 구슬에 중앙 큰 원도 함께.
		-- ComboOrb 컴포넌트는 부모가 플레이어가 아니어도 동작하는 범용 구조라 용사 자식으로 그대로 쓴다.
		if self._T.comboBuffActive ~= true then return end
		local count = self._T.heroOrbCount or 0
		if count >= 5 then return end
		---@type PlayerAttack
		local pa = self:GetOwnerAttack()
		if not isvalid(pa) then return end
		local idx = count + 1
		self._T.heroOrbCount = idx
		if idx == 1 then
			local center = _SpawnService:SpawnByModelId("spearburstfadingeffect", "HeroOrbCenter", Vector3(0, 0.35, 0), self.Entity)
			if isvalid(center) then
				center:AddComponent("script.ComboOrb")
				---@type ComboOrb
				local cc = center:GetComponent("script.ComboOrb")
				if isvalid(cc) then
					cc.IsCenterOrb = true
					cc.OrbSpriteRUID = "9cfc22d7db1842608b648d9d7b5d216e"
				end
				self._T.heroOrbCenter = center
			end
		end
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "HeroOrb" .. idx, Vector3(0, 0.35, 0), self.Entity)
		if isvalid(fx) then
			fx:AddComponent("script.ComboOrb")
			---@type ComboOrb
			local comp = fx:GetComponent("script.ComboOrb")
			if isvalid(comp) then
				comp.OrbIndex = idx
				comp.OrbSpriteRUID = pa:GetComboOrbSpriteRuid(idx)
			end
			self._T.heroOrbEntities = self._T.heroOrbEntities or {}
			table.insert(self._T.heroOrbEntities, fx)
		end
		log("[HeroSummon] 콤보 구슬 +1 → " .. tostring(idx) .. "/5")
	end

	@ExecSpace("ServerOnly")
	method void ClearHeroOrbs()
		-- 콤보 구슬 전부 + 중앙 큰 원 제거(코마 소모 / 버프 종료).
		self._T.heroOrbCount = 0
		local orbs = self._T.heroOrbEntities or {}
		for _, e in ipairs(orbs) do
			if isvalid(e) then e:Destroy() end
		end
		self._T.heroOrbEntities = {}
		if isvalid(self._T.heroOrbCenter) then
			self._T.heroOrbCenter:Destroy()
		end
		self._T.heroOrbCenter = nil
	end

	@ExecSpace("ServerOnly")
	method void CastPowerGuardFx(any paComp, number dir)
		-- 파워가드 프레임 이펙트(PlayerAttack.AttackPowerGuard와 동일한 구성: 좌/우 절반이 합쳐진 뒤
		-- 본체 실드 1회). 프레임 RUID 대응표: msw-dev-tools/resources/파워가드/RUID.md
		---@type PlayerAttack
		local pa = paComp
		if not isvalid(pa) then return end
		local leftRuids = {
			"3697356e16ba486cb9069c432d976235", "d3c16c82974b4933b03eeba3c2ec644c",
			"88b7df45f13e43f5acdb374b9d5286a8", "f12bdb312e404be5a58e7fb157ee9b8f",
		}
		local rightRuids = {
			"6fcc6e7183704cff9ec8a356ff477c64", "a49bed1bd7f04571b78a6507bcc5f2b2",
			"88175dd62ea3411faffee0446b5716f6", "5e9e7bdbc0624cd8b9aac4698f3ade58",
		}
		local shieldRuids = {
			"b68ea6ee3e0445a0898f02da53070dab", "8bac5a8b9fe04382a50afac0bc65a994",
			"04ab10c58c174b27b11be0beaf30f1b9", "23a03201d15f46dc8b7d34d9af562c04",
			"14d58140ffe94bb383d8ce4fb7fef2d5", "b3199ee4a4ec48fc84a6aab4a824cd74",
			"b1585d55ff8f4bb2af9e23d0fc4abe72", "a52d7487325540fea53e92d14b4e023f",
		}
		local leftFrames = {}
		for _, r in ipairs(leftRuids) do
			table.insert(leftFrames, { ruid = r, x = 0.185, y = 0.385, order = 10, sortingLayer = "" })
		end
		local rightFrames = {}
		for _, r in ipairs(rightRuids) do
			table.insert(rightFrames, { ruid = r, x = -0.245, y = 0.385, order = 3, sortingLayer = "MapLayer0" })
		end
		local shieldFrames = {}
		for _, r in ipairs(shieldRuids) do
			table.insert(shieldFrames, { ruid = r, x = 0.0, y = 0.395, order = 10, sortingLayer = "" })
		end
		pa:SpawnBuffFrameEffectEx(leftFrames, dir, 0.1, 0, self.Entity, 1.0, 1.0, 1.0)
		pa:SpawnBuffFrameEffectEx(rightFrames, dir, 0.1, 0, self.Entity, 1.0, 1.0, 1.0)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			---@type PlayerAttack
			local pa2 = self:GetOwnerAttack()
			if not isvalid(pa2) then return end
			pa2:SpawnBuffFrameEffectEx(shieldFrames, dir, 0.1, 0.2, self.Entity, 1.0, 1.0, 1.0)
		end, 0.4)
	end

	@ExecSpace("ServerOnly")
	method void CastBoosterFx(any paComp, number dir)
		-- 부스터 프레임 이펙트(PlayerAttack.AttackBooster와 동일 프레임을 용사에게 재생).
		---@type PlayerAttack
		local pa = paComp
		if not isvalid(pa) then return end
		local ruids = {
			"42514aa334774d0bb0fade61945e5970", "9d4e8b3b2eab441a8aa42ef883531704",
			"b7b99713c5ba4a55948ee31c7e213820", "c94fc0ca497c4ee2b2496bae4ded3259",
			"d5f5ceb4d0a04e25b3b978755d7a2f85", "3d84f51e0bc84c99b90e1e299338401f",
			"ea23c07eb82742709a0cad07d9614954", "c112602d64c84307b0438420d8d8a394",
			"85ed511773ff4ba1be37b92190c0cd50",
		}
		local xs = { -0.03, 0.025, 0.04, 0.11, 0.145, 0.145, 0.03, 0.105, 0.12 }
		local ys = { 0.06, 0.075, 0.165, 0.17, 0.17, 0.20, 0.225, 0.22, 0.22 }
		local frames = pa:MakeOriginFrames(ruids, xs, ys, 5)
		pa:SpawnBuffFrameEffectEx(frames, dir, 0.1, 0.2, self.Entity, 1.0, 1.0, 1.0)
	end

	-- ── 이펙트/사운드(멀티캐스트) ────────────────────────────────

	@ExecSpace("Multicast")
	method void PlayFxAttachedAt(string clipRuid, Entity anchor, number dirX, number offsetY)
		-- 범용 1회 이펙트(대상/용사에 부착). dirX>0이면 좌우 반전(프로젝트 관례).
		if not self:IsClient() then return end
		if not isvalid(anchor) then return end
		local options = { ["FlipX"] = dirX > 0, ["OrderInLayer"] = 6 }
		local serial = _EffectService:PlayEffectAttached(clipRuid, anchor, Vector3(0, offsetY, 0), 0, Vector3(1, 1, 1), false, options)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.0)
	end

	@ExecSpace("Multicast")
	method void PlaySlashHitFx(Entity target, number dirX)
		-- 슬래쉬블래스트 히트 이펙트(3종 랜덤) + 히트 사운드.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local hits = {
			"41e13add2ba746d9bbe624a31205a848", "880e540095704e30af6a554d51b8a3b3",
			"eed46092f65940a7a8e77a1bd8e2aa75",
		}
		local ruid = hits[math.floor(_UtilLogic:RandomDouble() * #hits) + 1]
		local serial = _EffectService:PlayEffectAttached(ruid, target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["FlipX"] = dirX > 0 })
		_SoundService:PlaySound("0f213b255ab34a0e8ed258c89f3b62fe", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.5)
	end

	@ExecSpace("Multicast")
	method void PlayComboFx()
		-- 콤보어택 시전 마법진 버스트 + 사용음(다크드래곤과 동일한 RUID)을 용사 위치에서 재생.
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		_EffectService:PlayEffectAttached("19e3ba3ab994431b81a3d4ee7a1b86e0", self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8 })
		_SoundService:PlaySound("4b254b65adbe4df4885acbe2e2fa3671", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlaySoundFx(string soundRuid)
		-- 범용 사운드 재생.
		if not self:IsClient() then return end
		if soundRuid == nil or soundRuid == "" then return end
		log("[HeroSummon] (클라) 사운드 재생 " .. soundRuid)
		_SoundService:PlaySound(soundRuid, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlaySummonFx()
		-- 소환 시 1회: 영웅의 메아리(효과+사운드)를 용사 위치에서 재생.
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local serial = _EffectService:PlayEffectAttached("21d3191f10984059bf84b16fe406698e", self.Entity, Vector3(0, 0.3, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8 })
		_SoundService:PlaySound("358e9f9bdc8c45e893c5a1f839bea8cf", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.5)
	end

	@ExecSpace("Multicast")
	method void PlayTeleportFx()
		-- 주인 곁으로 순간이동할 때 1회 재생.
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local serial = _EffectService:PlayEffectAttached("21d3191f10984059bf84b16fe406698e", self.Entity, Vector3(0, 0.3, 0), 0, Vector3(0.7, 0.7, 1), false, { ["OrderInLayer"] = 8 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.0)
	end

	-- ── 클라이언트 모션 반영 ─────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void ClientTick(number delta)
		-- 사망 사운드 프리로드: 로드 전 첫 PlaySound는 무음으로 스킵될 수 있어 미리 올려둔다.
		if not self._T.deathSndPreloaded then
			self._T.deathSndPreloaded = true
			_SoundService:LoadSound("6e462a4ae44b4a518ea68fde456ea5c3")
		end
		-- 사망 연출: 쓰러진 자세(각도 고정)가 작은 원(반경 0.048)을 그리며 150도/초로 맴돈다.
		-- 아바타 루트(body+얼굴+파츠)만 움직이므로 히어로 루트의 네임태그/HP바는 제자리.
		-- ⚠ 자세 자체를 회전(ZRotation)시키지는 않는다 - 원래 EulerAngles 오타(존재하지 않는 필드)로
		-- 회전이 조용히 무시되고 위치 궤도만 적용되던 것이 사용자가 실관찰로 튜닝·승인한 최종 연출이었고,
		-- ZRotation으로 실제 회전을 켜자 "각도가 바뀌면서 돈다"는 피드백을 받아 위치 궤도만 남긴다.
		if self._T.deadSpinBody ~= nil then
			local sb = self._T.deadSpinBody
			if isvalid(sb) then
				local t = _UtilLogic.ElapsedSeconds - (self._T.deadSpinStart or 0)
				local mirror = 1
				local rootTr = self.Entity.TransformComponent
				if isvalid(rootTr) and rootTr.Scale.x < 0 then mirror = -1 end
				local deg = ((t * 150) % 360) * mirror
				local rad = math.rad(deg)
				local tr = sb.TransformComponent
				tr.Position = Vector3(self._T.deadSpinBaseX + 0.048 * math.cos(rad), self._T.deadSpinBaseY + 0.048 * math.sin(rad), self._T.deadSpinBaseZ)
			end
			return
		end
		-- 스킬 모션 재생 중이 아니면 LocoState(stand/walk/jump)에 맞는 이동 클립을 body에 보낸다.
		local ar = self.Entity.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.motionLockUntil or 0) > now then return end
		local want = self.LocoState
		if self._T.lastLoco == want then return end
		local ev = ActionStateChangedEvent()
		if want == "walk" then
			ev.CoreActionName = "walk1"
			ev.PartsActionName = "walk1"
			ev.PlayType = SpriteAnimClipPlayType.Loop
		elseif want == "jump" then
			ev.CoreActionName = "jump"
			ev.PartsActionName = "jump"
			ev.PlayType = SpriteAnimClipPlayType.Loop
		elseif want == "sit" then
			-- 드래곤 탑승(본체 라이딩과 같은 앉은 자세).
			ev.CoreActionName = "sit"
			ev.PartsActionName = "sit"
			ev.PlayType = SpriteAnimClipPlayType.Loop
		else
			ev.CoreActionName = "stand1"
			ev.PartsActionName = "stand1"
			ev.PlayType = SpriteAnimClipPlayType.ZigzagLoop
		end
		body:SendEvent(ev)
		self._T.lastLoco = want
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 1회성 스킬 모션 명령 도착 시 body에 재생.
		--   "seq|모션명|재생속도"          → Onetime 전체 재생
		--   "seq|모션명|0.001|프레임번호"  → 그 프레임 하나에 정지(포즈 - 스피어버스터 조합 모션용.
		--   구간 길이 0이면 엔진이 무시하므로 End=Start+1, PlayRate 0.001로 사실상 정지시킨다)
		if name ~= "MotionCmd" then return end
		local s = tostring(value or "")
		if s == "" then return end
		local parts = {}
		for p in string.gmatch(s, "[^|]+") do
			table.insert(parts, p)
		end
		local motion = parts[2]
		if motion == nil or motion == "" then return end
		if motion == "revive" then
			-- 리저렉션 부활: 사망 스핀을 즉시 멈추고 아바타 루트를 원위치(원래 높이)/원회전으로 되돌린 뒤
			-- 잠금을 풀어 이동 클립(stand/walk)을 즉시 재개한다. 스핀 중지 플래그를 먼저 꺼서
			-- 같은 프레임의 ClientTick이 궤도 오프셋을 다시 쓰지 못하게 한다.
			self._T.deadSpinBody = nil
			-- 캐시가 아니라 현재 아바타 루트를 새로 조회해 원복한다(도중 교체됐어도 안전).
			local rar = self.Entity.AvatarRendererComponent
			if isvalid(rar) then
				local rroot = rar:GetAvatarRootEntity()
				if isvalid(rroot) then
					local tr = rroot.TransformComponent
					tr.Position = Vector3(self._T.deadSpinBaseX or 0, self._T.deadSpinBaseY or 0, self._T.deadSpinBaseZ or 0)
					tr.ZRotation = 0
				end
			end
			self._T.motionLockUntil = 0
			self._T.lastLoco = nil
			return
		end
		if motion == "dead" then
			-- (피드백) 플레이어 사망과 동일한 연출: 쓰러진(dead 0번 프레임 - 유일하게 보이는 프레임)
			-- 자세가 작은 원을 그리며 왼쪽(반시계)으로 돈다. 회전은 아바타 body 엔티티만 돌리므로
			-- 루트에 붙은 네임태그/HP바는 제자리에 있다. 실제 회전은 ClientTick이 매 프레임 수행.
			local dar = self.Entity.AvatarRendererComponent
			if not isvalid(dar) then return end
			local dbody = dar:GetBodyEntity()
			if not isvalid(dbody) then return end
			-- 사망 상태(20초) 내내 이동 클립이 덮지 않게 소멸 시점 너머까지 잠근다.
			self._T.motionLockUntil = _UtilLogic.ElapsedSeconds + 21.0
			self._T.lastLoco = nil
			local ev2 = ActionStateChangedEvent("dead", "stand1", 0.001, SpriteAnimClipPlayType.Onetime, 0, 1)
			dbody:SendEvent(ev2)
			-- (피드백) body만 돌리면 얼굴(눈)이 안 따라온다 - 얼굴은 별개 엔티티(GetFaceEntity)라서.
			-- body/얼굴/파츠 전체를 묶는 아바타 루트 엔티티를 돌린다(네임태그/HP바는 이 바깥이라 제자리).
			local spinRoot = dar:GetAvatarRootEntity()
			if not isvalid(spinRoot) then spinRoot = dbody end
			local btr = spinRoot.TransformComponent
			self._T.deadSpinBody = spinRoot
			self._T.deadSpinStart = _UtilLogic.ElapsedSeconds
			self._T.deadSpinBaseX = btr.Position.x
			self._T.deadSpinBaseY = btr.Position.y
			self._T.deadSpinBaseZ = btr.Position.z
			return
		end
		local ar = self.Entity.AvatarRendererComponent
		if not isvalid(ar) then return end
		local body = ar:GetBodyEntity()
		if not isvalid(body) then return end
		local rate = tonumber(parts[3]) or 1.0
		local frameIdx = tonumber(parts[4])
		local ev
		if frameIdx ~= nil then
			ev = ActionStateChangedEvent(motion, motion, 0.001, SpriteAnimClipPlayType.Onetime, frameIdx, frameIdx + 1)
			self._T.motionLockUntil = _UtilLogic.ElapsedSeconds + 0.6
		else
			ev = ActionStateChangedEvent()
			ev.CoreActionName = motion
			ev.PartsActionName = motion
			ev.PlayRate = rate
			ev.PlayType = SpriteAnimClipPlayType.Onetime
			self._T.motionLockUntil = _UtilLogic.ElapsedSeconds + 0.7 / math.max(rate, 0.001)
		end
		body:SendEvent(ev)
		self._T.lastLoco = nil   -- 모션이 끝나면 이동 클립을 다시 적용하게 강제
	end

end
