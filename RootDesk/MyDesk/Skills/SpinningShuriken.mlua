@Component
script SpinningShuriken extends Component

	-- (표창+) 전용 비행 클립이 없는 표창(토피/일비)을 "직접 회전시키며" 날리기 위한 동반 비주얼.
	-- LuckySevenProjectile이 표창 옆에 이 엔티티를 띄우고, 위치와 각도는 서버가 매 틱 갱신한다.
	--
	-- ⚠ 왜 이 스크립트가 필요한가: 표창 투사체 모델에는 SpriteRendererComponent가 아예 없고(실측),
	--   대신 쓰는 공용 이펙트 모델(spearburstfadingeffect)은 **서버에서 네이티브
	--   SpriteRendererComponent.SpriteRUID를 써도 클라이언트에 반영되지 않는다**(실측: 서버쪽
	--   RUID/레이어/알파가 전부 정상인데 화면에는 아무것도 안 그려졌다).
	--   그래서 RUID를 @Sync로 내려보내고 **클라이언트에서** 스프라이트를 입힌다
	--   (용 소환/이프리트 소환수가 쓰는 것과 같은 방식).
	--
	-- ⚠ 이 모델에는 script.SpearBurstFadingEffect가 기본으로 붙어 있지 않다(실측 - GetComponent가 nil).
	--   그쪽 컴포넌트를 쓰려던 시도는 실패했고, 이 방식이 실제로 화면에 잘 그려진다(확대 대조로 확인).
	@Sync property string IconRUID = ""

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 스폰 직후 이미 IconRUID가 들어와 있으면 여기서 바로 입힌다.
		self:ApplyIcon()
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- ⚠ AddComponent로 붙인 스크립트는 클라 OnBeginPlay가 @Sync 값보다 먼저 도는 경우가 있어
		--   (동기화 경쟁) 여기서 한 번 더 적용해야 한다.
		if name == "IconRUID" then
			self:ApplyIcon()
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyIcon()
		-- 표창 아이콘을 스프라이트로 입힌다. 아바타(MapLayer0 / OrderInLayer 4)보다 앞에 그린다.
		if self.IconRUID == "" then return end
		local sr = self.Entity.SpriteRendererComponent
		if not isvalid(sr) then return end
		sr.SpriteRUID = self.IconRUID
		sr.SortingLayer = "MapLayer0"
		sr.OrderInLayer = 6
	end

end
