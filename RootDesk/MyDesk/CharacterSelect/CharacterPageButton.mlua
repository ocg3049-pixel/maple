@Component
script CharacterPageButton extends Component

	-- 캐릭터 선택창 페이지 이동 버튼(이전/다음).
	-- 12칸을 한 페이지 3칸씩 4페이지로 보여주므로, 이 버튼이 현재 페이지를 바꾼다.
	-- 방향은 엔티티 이름으로 판별한다(PrevPageButton / NextPageButton) - CharacterSlotButton이
	-- 엔티티 이름 끝자리로 슬롯 번호를 읽는 것과 같은 방식.

	@EventSender("Self")
	handler HandleButtonClickEvent(ButtonClickEvent event)
		local selectBg = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharacterSelectGroup/SelectBackground")
		if not isvalid(selectBg) then return end
		local comp = selectBg:GetComponent(CharacterSelectComponent)
		if not isvalid(comp) then return end

		local delta = 1
		if string.find(self.Entity.Name, "Prev") ~= nil then delta = -1 end
		comp:MovePage(delta)
	end

end
