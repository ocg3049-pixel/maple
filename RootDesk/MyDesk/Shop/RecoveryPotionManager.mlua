@Logic
script RecoveryPotionManager extends Logic
    property integer hpTier = 0
    property integer mpTier = 0
    property number hpRemaining = 0
    property number mpRemaining = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        local panel=_EntityService:GetEntityByPath("/ui/RecoveryPotionUI/Modal/Panel")
        self._T.yes=panel:GetChildByName("Yes"):ConnectEvent(ButtonClickEvent,function() self:CloseConfirmation(true) end)
        self._T.no=panel:GetChildByName("No"):ConnectEvent(ButtonClickEvent,function() self:CloseConfirmation(false) end)
        self._T.key=_InputService:ConnectEvent(KeyDownEvent,function(event)
            if self._T.pending~=nil and event.key==KeyboardKey.Escape then self:CloseConfirmation(false) end
        end)
        self:CloseConfirmation(false)
    end

    @ExecSpace("ClientOnly")
    method void CloseConfirmation(boolean accept)
        local pending=self._T.pending
        self._T.pending=nil
        local modal=_EntityService:GetEntityByPath("/ui/RecoveryPotionUI/Modal")
        if isvalid(modal) then modal.Enable=false end
        if accept and pending~=nil then
            if pending.action=="cancel" then
                local tier=pending.kind=="hp" and self.hpTier or self.mpTier
                if pending.owner==self._T.characterId and pending.revision==self._T.buffRevision and tier==pending.tier then self:Cancel(pending.kind) end
            else self:Consume(pending.slot,pending.item) end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        self:CloseConfirmation(false)
        if self._T.key then _InputService:DisconnectEvent(KeyDownEvent,self._T.key) end
        local panel=_EntityService:GetEntityByPath("/ui/RecoveryPotionUI/Modal/Panel")
        if isvalid(panel) then
            if self._T.yes then panel:GetChildByName("Yes"):DisconnectEvent(ButtonClickEvent,self._T.yes) end
            if self._T.no then panel:GetChildByName("No"):DisconnectEvent(ButtonClickEvent,self._T.no) end
        end
    end

    method table Catalog()
        if self._T.catalog == nil then
            self._T.catalog = {
                {key="regen_hp1",kind="hp",tier=1,name="빨간 포션",ruid="234aca1a4ce946119b68e3717991e775",price=1000},
                {key="regen_hp2",kind="hp",tier=2,name="주황 포션",ruid="2debf574d6d04f7083e980dbc8f462d9",price=2000},
                {key="regen_hp3",kind="hp",tier=3,name="하얀 포션",ruid="289c7bdcbdc8484ab7bad688b2519ca7",price=5000},
                {key="regen_hp4",kind="hp",tier=4,name="장어구이",ruid="2d35e350465c47f39eff7596f5c01f22",price=10000},
                {key="regen_hp5",kind="hp",tier=5,name="순록의 우유",ruid="0acd1e8a12fa4d909cfa30cbf1597340",price=20000},
                {key="regen_mp1",kind="mp",tier=1,name="파란 포션",ruid="7e9b39b73f4945b1a8d77db6c99a6946",price=1000},
                {key="regen_mp2",kind="mp",tier=2,name="마나 엘릭서",ruid="3b778fe9d0b64a52a038b1c72cb58454",price=2000},
                {key="regen_mp3",kind="mp",tier=3,name="맑은 물",ruid="81217a4dc8b74af19a93c07a0fb72a5f",price=5000},
                {key="regen_mp4",kind="mp",tier=4,name="팥빙수",ruid="25f07795f9394ebdb446e78d8bfcdb5e",price=10000},
                {key="regen_mp5",kind="mp",tier=5,name="황혼의 이슬",ruid="7b4a813bfbf94649a832224f5624376c",price=20000},
            }
        end
        return self._T.catalog
    end

    method table Product(string key)
        for _, row in ipairs(self:Catalog()) do if row.key == key then return row end end
        return nil
    end

    method table ByName(string name)
        for _, row in ipairs(self:Catalog()) do if row.name == name then return row end end
        return nil
    end

    method boolean IsIcon(string ruid)
        for _, row in ipairs(self:Catalog()) do if row.ruid == ruid then return true end end
        return false
    end

    method string Item(string key, integer count)
        local row = self:Product(key)
        if row == nil or count < 1 or count > 999 then return "" end
        return row.name .. "|" .. row.ruid .. "|0|0|0|0|" .. tostring(count) .. "|" .. row.key
    end

    method string Description(string key)
        local row = self:Product(key)
        if row == nil then return "" end
        local stat = row.kind == "hp" and "HP" or "MP"
        return "1시간 동안 초당 최대 " .. stat .. "의 " .. tostring(row.tier) .. "% 추가 회복\n접속 종료 시 남은 시간 보존\n재접속 후 남은 시간부터 적용\n같은 종류 재사용: 효과 교체·1시간 갱신\nHP·MP 동시 사용 가능 / 더블클릭 사용\n보스전 사용 불가 / 기존 포션 효과도 보스전 중 적용되지 않음"
    end

    method boolean IsBossRestricted(Entity player)
        return isvalid(player) and isvalid(player.CurrentMap) and _BossStageManager:IsArena(player.CurrentMap.Name)
    end

    @ExecSpace("ClientOnly")
    method boolean BlockUse()
        if not self:IsBossRestricted(_UserService.LocalPlayer) then return false end
        _UIToast:ShowMessage("상점 포션은 보스전에서 사용할 수 없습니다.")
        return true
    end

    @ExecSpace("ClientOnly")
    method number RawBonus(string kind)
        if kind=="hp" then return self.hpRemaining>0 and self.hpTier or 0 end
        return self.mpRemaining>0 and self.mpTier or 0
    end

    @ExecSpace("ClientOnly")
    method number Bonus(string kind)
        if self:IsBossRestricted(_UserService.LocalPlayer) then return 0 end
        if kind == "hp" then return self.hpRemaining > 0 and self.hpTier or 0 end
        return self.mpRemaining > 0 and self.mpTier or 0
    end

    @ExecSpace("ClientOnly")
    method void FitIcon(Entity icon, string ruid, number width, number height)
        -- Never suspend a viewport refresh; only the current slot binding may apply loaded dimensions.
        if not isvalid(icon) then return end
        local renderer=icon.SpriteGUIRendererComponent
        local transform=icon.UITransformComponent
        self._T.iconSizes=self._T.iconSizes or {}
        self._T.iconRequests=self._T.iconRequests or {}
        local request={ruid=ruid,width=width,height=height}
        self._T.iconRequests[icon.Id]=request
        renderer.Type=ImageType.Simple
        renderer.PreserveSprite=PreserveSpriteType.AspectOnly
        renderer.LocalPosition=Vector2.zero renderer.LocalScale=Vector2.one
        transform.Pivot=Vector2(0.5,0.5) transform.UIScale=Vector3.one
        transform.RectSize=Vector2(width,height)
        if renderer.ImageRUID.DataId~=ruid then renderer.ImageRUID=DataRef(ruid) end
        if ruid=="" or string.sub(ruid,1,12)=="thumbnail://" then return end
        local size=self._T.iconSizes[ruid]
        if size~=nil then self:ApplyIconSize(icon,request,size) return end
        _ResourceService:PreloadAsync({ruid},function()
            if not isvalid(icon) or self._T.iconRequests[icon.Id].ruid~=request.ruid or renderer.ImageRUID.DataId~=ruid then return end
            local sprite=_ResourceService:LoadSpriteAndWait(ruid)
            if sprite==nil or not sprite.IsLoadComplete or sprite.Width<=0 or sprite.Height<=0 then return end
            local loaded=Vector2(sprite.Width,sprite.Height)
            self._T.iconSizes[ruid]=loaded
            self:ApplyIconSize(icon,self._T.iconRequests[icon.Id],loaded)
        end)
    end

    @ExecSpace("ClientOnly")
    method void ApplyIconSize(Entity icon, table request, Vector2 size)
        -- A delayed image load cannot resize a reused or cleared slot.
        if not isvalid(icon) or self._T.iconRequests[icon.Id].ruid~=request.ruid then return end
        local renderer=icon.SpriteGUIRendererComponent
        if renderer.ImageRUID.DataId~=request.ruid then return end
        local scale=math.min(request.width/size.x,request.height/size.y)
        icon.UITransformComponent.RectSize=Vector2(size.x*scale,size.y*scale)
        renderer.PreserveSprite=PreserveSpriteType.None
        renderer.LocalPosition=Vector2.zero renderer.LocalScale=Vector2.one
    end

    @ExecSpace("ClientOnly")
    method boolean Use(integer slot)
        if self:BlockUse() then return false end
        local inv=_UIEquipInventoryManager
        local item=inv:GetTabItem("consume",slot)
        local row=self:ByName(inv:ParseName(item))
        if row==nil or inv:ParseRUID(item)~=row.ruid or inv:ParseCount(item)<1 then return false end
        if self._T.pending~=nil or self._T.using then return false end
        if self:Bonus(row.kind)>0 then
            local tier=row.kind=="hp" and self.hpTier or self.mpTier
            local remaining=row.kind=="hp" and self.hpRemaining or self.mpRemaining
            local current=self:Product("regen_"..row.kind..tostring(tier))
            local pending={slot=slot,item=item}
            self._T.pending=pending
            inv:CancelInvenDrag() inv:HideTooltip()
            local panel=_EntityService:GetEntityByPath("/ui/RecoveryPotionUI/Modal/Panel")
            panel:GetChildByName("Title").TextGUIRendererComponent.Text="회복 효과 갱신"
            panel:GetChildByName("Message").TextGUIRendererComponent.Text=(current and current.name or string.upper(row.kind)).." 사용 중 ("..tostring(tier).."%, 남은 "..tostring(math.ceil(remaining/60)).."분)\n"..row.name.." ("..tostring(row.tier).."%)로 교체하고\n지속시간을 1시간으로 갱신할까요?"
            _EntityService:GetEntityByPath("/ui/RecoveryPotionUI/Modal").Enable=true
            if Environment:IsMakerPlay() then log("[RecoveryPotion] replacement confirmation "..row.kind) end
            return true
        end
        return self:Consume(slot,item)
    end

    @ExecSpace("ClientOnly")
    method boolean Consume(integer slot, string expected)
        if self:BlockUse() then return false end
        local inv = _UIEquipInventoryManager
        local item = inv:GetTabItem("consume", slot)
        if item~=expected then _UIToast:ShowMessage("아이템이 변경되어 사용을 취소했습니다.") return false end
        local row = self:ByName(inv:ParseName(item))
        if row == nil or inv:ParseRUID(item) ~= row.ruid or inv:ParseCount(item) < 1 then return false end
        if self._T.using then return false end
        self._T.using = true
        self._T.buffRevision=(self._T.buffRevision or 0)+1
        if row.kind == "hp" then self.hpTier = row.tier self.hpRemaining = 3600
        else self.mpTier = row.tier self.mpRemaining = 3600 end
        inv:SetTabItem("consume", slot, inv:WithStackCount(item, inv:ParseCount(item) - 1))
        self:Apply()
        _GameAudio:PlaySound("ad3fde2e53314fe29ec759886bc88e04",1)
        inv:CancelInvenDrag() inv:RefreshUI()
        _CharacterPersistence:MarkDirty("regen_potion_use")
        if Environment:IsMakerPlay() then log("[RecoveryPotion] used " .. row.key .. " duration=3600") end
        self._T.using = false
        return true
    end

    @ExecSpace("ClientOnly")
    method void Apply()
        _MpManager.regenPercentPerSecond = _SkillManager:GetBeginnerMpRegenPct()
        _SkillManager:SyncHpRegenSources()
        self:UpdateUI()
        local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
        if isvalid(w) and w.EnabledInHierarchy then _CharInfoManager:UpdateStats() end
    end

    @ExecSpace("ClientOnly")
    method void Cancel(string kind)
        -- 확인 후에만 호출하며 다른 종류의 포션은 유지한다.
        if kind~="hp" and kind~="mp" then return end
        self._T.buffRevision=(self._T.buffRevision or 0)+1
        if kind == "hp" then self.hpTier = 0 self.hpRemaining = 0
        else self.mpTier = 0 self.mpRemaining = 0 end
        self:Apply()
        _CharacterPersistence:MarkDirty("regen_potion_change")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        local restricted=self:IsBossRestricted(_UserService.LocalPlayer)
        if self._T.bossRestricted~=restricted then
            self._T.bossRestricted=restricted self:Apply()
            if Environment:IsMakerPlay() then log("[VRF] Shop potion boss suppression="..tostring(restricted)) end
        end
        if self._T.pending~=nil and _LoginFlow.phase~="ingame" then self:CloseConfirmation(false) end
        local cl = _CharacterPersistence._T.cl
        if cl == nil or not cl.entered or _LoginFlow.phase ~= "ingame" or self._T.characterId~=_FieldRecoveryDrops.characterId then return end
        local expired = false
        if self.hpRemaining > 0 then
            self.hpRemaining = math.max(0, self.hpRemaining - delta)
            if self.hpRemaining == 0 then self.hpTier = 0 expired = true end
        end
        if self.mpRemaining > 0 then
            self.mpRemaining = math.max(0, self.mpRemaining - delta)
            if self.mpRemaining == 0 then self.mpTier = 0 expired = true end
        end
        if expired then self:Apply() _CharacterPersistence:MarkDirty("regen_potion_change") if Environment:IsMakerPlay() then log("[RecoveryPotion] expired") end end
        self._T.uiTick = (self._T.uiTick or 0) + delta
        if self._T.uiTick >= 0.2 then self._T.uiTick = 0 self:UpdateUI() end
        self._T.autoTick=(self._T.autoTick or 0)+delta
        if self._T.autoTick>=1 then self._T.autoTick=0 self:RefreshQuickslotPotions() end
    end

    @ExecSpace("ClientOnly")
    method void UpdateUI()
        for _, kind in ipairs({"hp", "mp"}) do
            local remaining = kind == "hp" and self.hpRemaining or self.mpRemaining
            local tier = kind == "hp" and self.hpTier or self.mpTier
            local path = "/ui/DefaultGroup/BuffBar/RecoveryPotion_" .. kind
            local icon = _EntityService:GetEntityByPath(path)
            if isvalid(icon) then
                local row = self:Product("regen_" .. kind .. tostring(tier))
                icon.Enable = remaining > 0 and row ~= nil
                if icon.Enable then
                    local art=icon:GetChildByName("Icon")
                    self:FitIcon(art,row.ruid,32,32)
                    local text = _EntityService:GetEntityByPath(path .. "/Text")
                    text.TextGUIRendererComponent.Text = tostring(math.floor(math.ceil(remaining)/60)) .. ":" .. string.format("%02d", math.ceil(remaining)%60)
                    _EntityService:GetEntityByPath(path .. "/GrayOverlay").SpriteGUIRendererComponent.FillAmount = self:IsBossRestricted(_UserService.LocalPlayer) and 1 or 1 - remaining/3600
                end
            end
        end
    end

    method table ReadState(string raw)
        local line = string.match("\n" .. (raw or ""), "\n(REGEN\t[^\n]*)") or ""
        local f = {} for field in string.gmatch(line, "[^\t]+") do table.insert(f, field) end
        local result = {}
        for i, kind in ipairs({"hp", "mp"}) do
            local tier = math.floor(tonumber(f[i*2]) or 0)
            local left = math.max(0, math.min(3600, tonumber(f[i*2+1]) or 0))
            if tier < 1 or tier > 5 or left <= 0 then tier = 0 left = 0 end
            result[kind] = {tier=tier, left=left}
        end
        return result
    end

    method string StateLine(table state)
        return "REGEN\t" .. tostring(state.hp.tier) .. "\t" .. string.format("%.3f", state.hp.left) .. "\t" .. tostring(state.mp.tier) .. "\t" .. string.format("%.3f", state.mp.left)
    end

    method string WriteState(string raw, table state)
        local lines = {}
        for line in string.gmatch(raw or "", "[^\n]+") do
            if string.sub(line,1,6) ~= "REGEN\t" then table.insert(lines,line) end
        end
        table.insert(lines,self:StateLine(state))
        return table.concat(lines,"\n")
    end

    @ExecSpace("ClientOnly")
    method string Export()
        return self:StateLine({hp={tier=self.hpTier,left=self.hpRemaining},mp={tier=self.mpTier,left=self.mpRemaining}})
    end

    @ExecSpace("ClientOnly")
    method void Restore(string raw)
        self:CloseConfirmation(false)
        self._T.characterId=_FieldRecoveryDrops.characterId
        self._T.buffRevision=(self._T.buffRevision or 0)+1
        local s = self:ReadState(raw)
        self.hpTier = s.hp.tier self.hpRemaining = s.hp.left
        self.mpTier = s.mp.tier self.mpRemaining = s.mp.left
        self:Apply()
        if Environment:IsMakerPlay() then log("[RecoveryPotion] restored hp=" .. tostring(self.hpRemaining) .. " mp=" .. tostring(self.mpRemaining)) end
    end

    @ExecSpace("ServerOnly")
    method void AcceptSnapshot(table sv, string raw)
        -- In-memory clock only; disconnects preserve the final remaining duration.
        sv.recoveryPotion = {id=sv.activeId, state=self:ReadState(raw), at=_UtilLogic.ElapsedSeconds, checkpoint=_UtilLogic.ElapsedSeconds}
    end

    @ExecSpace("ServerOnly")
    method void CaptureRemaining(table sv, boolean final)
        local r = sv.recoveryPotion
        if r == nil or r.paused or sv.activeId == "" or r.id ~= sv.activeId then return end
        local now = _UtilLogic.ElapsedSeconds
        if not final and now - r.checkpoint < 60 then return end
        local elapsed = math.max(0, now - r.at)
        for _, kind in ipairs({"hp","mp"}) do
            local b = r.state[kind]
            b.left = math.max(0,b.left-elapsed)
            if b.left <= 0 then b.tier = 0 end
        end
        r.at = now r.checkpoint = now
        local old = sv.saves[r.id] or ""
        if old == "" then return end
        local updated = self:WriteState(old,r.state)
        if updated ~= old then sv.saves[r.id] = updated sv.dirtySaves[r.id] = true end
        if final then if Environment:IsMakerPlay() then log("[RecoveryPotion] logout remaining hp=" .. tostring(r.state.hp.left) .. " mp=" .. tostring(r.state.mp.left)) end end
    end

    @ExecSpace("ClientOnly")
    method boolean IsQuickslotPotion(string name)
        -- Recognize only supported inventory consumables, never arbitrary skill names.
        return self:ByName(name)~=nil or name=="공격 속도의 비약" or name=="공격력 물약" or name=="레벨 70 물약"
    end

    @ExecSpace("ClientOnly")
    method table QuickslotPotions()
        -- Aggregate owned stacks independently of the currently selected inventory tab.
        local entries={} local index={} local inv=_UIEquipInventoryManager
        for _,item in pairs(inv._T.tabData.consume or {}) do
            local name=inv:ParseName(item)
            if item~="" and self:IsQuickslotPotion(name) and inv:ParseCount(item)>0 then
                if index[name]==nil then local row={name=name,ruid=inv:ParseRUID(item),count=0} table.insert(entries,row) index[name]=row end
                index[name].count=index[name].count+inv:ParseCount(item)
            end
        end
        table.sort(entries,function(a,b) return a.name<b.name end)
        return entries
    end

    @ExecSpace("ClientOnly")
    method void UseQuickslot(string name, string ruid)
        if self:BlockUse() then return end
        -- Consume one matching stack without switching the visible inventory tab.
        local p=_UserService.LocalPlayer
        if not isvalid(p) or p.PlayerComponent:IsDead() or _GameSystemMenu:BlocksInput() then return end
        local now=_UtilLogic.ElapsedSeconds
        if now<(self._T.quickUseUntil or 0) then return end self._T.quickUseUntil=now+0.35
        local inv=_UIEquipInventoryManager
        for slot,item in pairs(inv._T.tabData.consume or {}) do
            if item~="" and inv:ParseName(item)==name and inv:ParseRUID(item)==ruid and inv:ParseCount(item)>0 then
                if self:ByName(name)~=nil then self:Use(slot) return end
                if name=="공격 속도의 비약" then _CharInfoManager:IncreaseAttackSpeedStage()
                elseif name=="공격력 물약" then _CharInfoManager:UseAttackPotion()
                elseif name=="레벨 70 물약" then _CharInfoManager:UseLevel70Potion()
                else return end
                local count=inv:ParseCount(item)
                if count<=1 then inv:SetTabItem("consume",slot,"")
                else local parts={} for part in string.gmatch(item,"[^|]+") do table.insert(parts,part) end while #parts<7 do table.insert(parts,"0") end parts[7]=tostring(count-1) inv:SetTabItem("consume",slot,table.concat(parts,"|")) end
                inv:RefreshUI() _CharacterPersistence:MarkDirty("inventory")
                if Environment:IsMakerPlay() then log("[QuickslotPotion] consumed "..name) end return
            end
        end
        _UIToast:ShowMessage("인벤토리에 "..name.."이(가) 없습니다.")
    end


    @ExecSpace("ClientOnly")
    method void RefreshQuickslotPotions()
        if self:IsBossRestricted(_UserService.LocalPlayer) then return end
        -- Renew only timed potions registered in the currently used quickslot layout.
        local player=_UserService.LocalPlayer
        if not isvalid(player) or player.PlayerComponent:IsDead() or self._T.pending~=nil then return end
        local slots=_MobileUIManager:IsMobile() and _MobileUIManager:ExportMobileSlots() or (_SkillManager._T.slotData or {})
        local best={} local owned={}
        for _,item in pairs((_UIEquipInventoryManager._T.tabData or {}).consume or {}) do
            if _UIEquipInventoryManager:ParseCount(item)>0 then owned[_UIEquipInventoryManager:ParseName(item)]=true end
        end
        for _,slot in pairs(slots) do
            local row=self:ByName(slot.name or "")
            if row and owned[row.name] and (best[row.kind]==nil or best[row.kind].tier<row.tier) then best[row.kind]=row end
            if slot.name=="공격 속도의 비약" and owned[slot.name] then best.speed={name=slot.name,ruid=slot.ruid} end
        end
        for _,kind in ipairs({"hp","mp","speed"}) do
            local row=best[kind]
            local remaining=kind=="hp" and self.hpRemaining or kind=="mp" and self.mpRemaining or _CharInfoManager.attackSpeedPotionRemaining
            if row and remaining<=0 then
                for _,item in pairs(_UIEquipInventoryManager._T.tabData.consume or {}) do
                    if _UIEquipInventoryManager:ParseName(item)==row.name and _UIEquipInventoryManager:ParseCount(item)>0 then self:UseQuickslot(row.name,row.ruid) return end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RequestCancel(string kind)
        -- 좌/우클릭과 모바일 탭 모두 같은 삭제 확인을 거친다.
        if self._T.pending~=nil or (kind~="hp" and kind~="mp") or self:RawBonus(kind)<=0 then return end
        local tier=kind=="hp" and self.hpTier or self.mpTier
        local remaining=kind=="hp" and self.hpRemaining or self.mpRemaining
        local row=self:Product("regen_"..kind..tostring(tier))
        self._T.pending={action="cancel",kind=kind,tier=tier,owner=self._T.characterId,revision=self._T.buffRevision}
        local panel=_EntityService:GetEntityByPath("/ui/RecoveryPotionUI/Modal/Panel")
        panel:GetChildByName("Title").TextGUIRendererComponent.Text="포션 효과 삭제"
        panel:GetChildByName("Message").TextGUIRendererComponent.Text=row.name.." 효과가 "..tostring(math.ceil(remaining/60)).."분 남아 있습니다.\n정말 해당 포션 버프를 삭제할까요?\n삭제한 효과와 남은 시간은 복구되지 않습니다."
        _EntityService:GetEntityByPath("/ui/RecoveryPotionUI/Modal").Enable=true
        _UIAudio:Play("DlgNotice")
        if Environment:IsMakerPlay() then log("[RecoveryPotion] cancel confirmation "..kind) end
    end

    @ExecSpace("ServerOnly")
    method void PauseSession(table sv)
        -- 퇴장 저장이 실패해 재시도하더라도 오프라인 시간은 차감하지 않는다.
        if sv==nil then return end
        self:CaptureRemaining(sv,true)
        if sv.recoveryPotion~=nil then sv.recoveryPotion.paused=true end
    end

end
