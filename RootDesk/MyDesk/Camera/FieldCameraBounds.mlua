@Logic
script FieldCameraBounds extends Logic

	property number BaseZoomRatio = 100

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 짧은 축의 시야를 고정하고 맵 이동/줌/화면 비율 변경 때 양축 경계를 다시 적용한다.
		self._T.tick = (self._T.tick or 0) + delta
		if self._T.tick < 0.25 then return end
		self._T.tick = 0
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then return end
		local camera = _CameraService:GetCurrentCameraComponent()
		if not isvalid(camera) or camera.Entity ~= player then return end
		-- 미니맵 촬영은 일시적으로 같은 카메라의 경계와 줌을 해제한다. 촬영 동안에는 건드리지 않는다.
		local mini = _EntityService:GetEntityByPath("/ui/MiniMapUI")
		if isvalid(mini) then
			local controller = mini:GetFirstChildComponentByTypeName("script.MiniMapUIManager", true)
			if isvalid(controller) and controller._T.capturing and not controller._T.restoringCamera then
				self._T.lastZoom = nil
				self._T.readyMap = nil
				self._T.height = nil
				return
			end
		end
		local map = player.CurrentMap
        if _BossStageManager:IsArena(map.Name) then
            local zoom=self:GetBaseZoom()
            if math.abs(camera.ZoomRatio-zoom)>0.01 then
                local allowed=camera.IsAllowZoomInOut camera.IsAllowZoomInOut=true
                camera.ZoomRatio=zoom _CameraService:ZoomTo(zoom,0) camera.IsAllowZoomInOut=allowed
            end
            camera.UseCustomBound=true camera.ConfineCameraArea=true
            local stage=_BossStageManager._T.stage or 1
            camera.LeftBottom=Vector2(stage==4 and -16.65 or -8.5,-1.76)
            camera.RightTop=Vector2(stage==4 and 15.95 or 7.8,stage==5 and 6.183 or 4.35)
            local regional=_RegionalBossCatalog:Stage(stage)
            if regional~=nil then
                local v=regional.camera
                camera.LeftBottom=Vector2(v[1],v[3]) camera.RightTop=Vector2(v[2],v[4])
            end
            if self._T.arena~=map then
                self._T.arena=map
                if Environment:IsMakerPlay() then log("[VRF] Boss camera map="..map.Name.." zoom="..tostring(zoom)) end
            end
            self._T.map=nil
            return
        end
        self._T.arena=nil
		local baseZoom = self:GetBaseZoom()
		if self._T.map ~= map or self._T.camera ~= camera or self._T.baseZoom ~= baseZoom then
			self._T.baseZoom = baseZoom
			self._T.readyMap = nil
			-- 맵마다 기본 시야에서 시작한다. 촬영/전환 중 관측한 배율은 기준으로 저장하지 않는다.
			local allowed = camera.IsAllowZoomInOut
			camera.IsAllowZoomInOut = true
			camera.ZoomRatio = baseZoom
			_CameraService:ZoomTo(baseZoom, 0)
			camera.IsAllowZoomInOut = allowed
			camera.UseCustomBound = false
			camera.ConfineCameraArea = true
			local lo, hi = camera:GetBound()
			local bounds = self:CameraView(map.Name)
			if bounds ~= nil then
				local b = bounds
				lo, hi = Vector2(b[1], b[3]), Vector2(b[2], b[4])
			end
			if hi.y <= lo.y or hi.x <= lo.x then
				lo, hi = map.MapComponent:GetBound()
			end
			if hi.y <= lo.y or hi.x <= lo.x then
				-- 발판/타일이 없는 맵도 카메라 준비를 완료해 전환 덮개에 갇히지 않는다.
				local origin = player.TransformComponent.WorldPosition
				local halfHeight = 3.6 * 100 / baseZoom
				local halfWidth = halfHeight * _UILogic.ScreenWidth / math.max(1, _UILogic.ScreenHeight)
				lo = Vector2(origin.x - halfWidth, origin.y - halfHeight)
				hi = Vector2(origin.x + halfWidth, origin.y + halfHeight)
				if Environment:IsMakerPlay() then log("[VRF] FieldCamera fallback bounds map=" .. map.Name) end
			end
			self._T.map = map
			self._T.camera = camera
			self._T.lo = lo
			self._T.hi = hi
			self._T.height = nil
			return -- 렌더 카메라가 새 배율을 적용한 다음 경계를 계산한다.
		end
		-- 촬영 배율이 남거나 복원 중이면 축소된 시야로 맵 경계를 계산하지 않는다.
		if math.abs(camera.ZoomRatio - baseZoom) > 0.01 then
			self._T.readyMap = nil
			local allowed = camera.IsAllowZoomInOut
			camera.IsAllowZoomInOut = true
			camera.ZoomRatio = baseZoom
			_CameraService:ZoomTo(baseZoom, 0)
			camera.IsAllowZoomInOut = allowed
			self._T.height = nil
			if Environment:IsMakerPlay() then log("[FieldCamera] 기본 시야 복원 zoom=" .. tostring(baseZoom)) end
			return
		end
		if math.abs(_CameraService.currentZoomRatio - camera.ZoomRatio) > 0.01 then return end
		-- 실제 렌더링까지 같은 배율로 한 주기 정착한 뒤에만 시야 높이를 사용한다.
		if self._T.lastZoom ~= camera.ZoomRatio then
			self._T.lastZoom = camera.ZoomRatio
			self._T.height = nil
			return
		end
		local a = _UILogic:ScreenToWorldPosition(Vector2.zero)
		local b = _UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth, _UILogic.ScreenHeight))
		local height = math.abs(b.y - a.y)
		local width = math.abs(b.x - a.x)
		if height <= 0 or width <= 0 then return end
		local lo, hi = self._T.lo, self._T.hi
		local mapHeight, mapWidth = hi.y - lo.y, hi.x - lo.x
		-- 필드 크기에 따른 자동 확대를 금지한다. 짧은 축의 위치만 고정한다.
		local left, right, bottom, top = lo.x, hi.x, lo.y, hi.y
		local lockX, lockY = mapWidth <= width + 0.02, mapHeight <= height + 0.02
		if lockX then
			local center, half = (lo.x + hi.x) * 0.5, width * 0.5
			left, right = center - half, center + half
		end
		if lockY then
			local center, half = (lo.y + hi.y) * 0.5, height * 0.5
			bottom, top = center - half, center + half
		end
		-- 촬영 복원이나 다른 카메라 설정 이후에도 제한을 재적용한다.
		camera.ConfineCameraArea = true
		camera.UseCustomBound = true
		camera.LeftBottom = Vector2(left, bottom)
		camera.RightTop = Vector2(right, top)
		local changed = self._T.readyMap ~= map or self._T.height == nil or math.abs(self._T.height - height) > 0.02 or math.abs((self._T.width or 0) - width) > 0.02
		self._T.height, self._T.width = height, width
		self._T.readyMap = map
		self._T.appliedLo, self._T.appliedHi = camera.LeftBottom, camera.RightTop
		if changed then
			self._T.readyAt = _UtilLogic.ElapsedSeconds + 0.1
			if Environment:IsMakerPlay() then log("[VRF] FieldCamera fixed-scale map=" .. map.Name .. " lockX=" .. tostring(lockX) .. " lockY=" .. tostring(lockY) .. " zoom=" .. tostring(camera.ZoomRatio)) end
		end
	end




	@ExecSpace("ClientOnly")
	method boolean IsReady(Entity map)
		-- 전환 덮개는 맵 등록 여부가 아닌 실제 배율/경계 적용 완료를 기다린다.
		local player = _UserService.LocalPlayer
		local camera = _CameraService:GetCurrentCameraComponent()
		if not isvalid(map) or not isvalid(player) or player.CurrentMap ~= map or not isvalid(camera) or camera.Entity ~= player then return false end
		if math.abs(camera.ZoomRatio - self:GetBaseZoom()) > 0.01 or math.abs(_CameraService.currentZoomRatio - self:GetBaseZoom()) > 0.01 then return false end
		if _BossStageManager:IsArena(map.Name) then return self._T.arena == map and camera.UseCustomBound end
		if self._T.readyMap ~= map or self._T.camera ~= camera or _UtilLogic.ElapsedSeconds < (self._T.readyAt or math.huge) then return false end
		return camera.UseCustomBound and camera.ConfineCameraArea and camera.LeftBottom == self._T.appliedLo and camera.RightTop == self._T.appliedHi
	end

	-- 원본 VR 경계가 있는 긴 필드: 장식용 발판이나 외곽 오브젝트로 경계가 넓어지는 것을 방지한다.
