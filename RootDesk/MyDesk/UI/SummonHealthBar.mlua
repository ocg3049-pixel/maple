@Component
script SummonHealthBar extends Component
    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Draw solid rectangles at the summon origin; cancel inherited scale and facing.
        local parent=self.Entity.Parent
        if not isvalid(parent) or not isvalid(parent.TransformComponent) then return end
        local scale=parent.TransformComponent.Scale
        if math.abs(scale.x)<0.001 or math.abs(scale.y)<0.001 then return end
        if self._T.sx~=scale.x or self._T.sy~=scale.y then
            self.Entity.TransformComponent.Position=Vector3(0,1.05/scale.y,0)
            self.Entity.TransformComponent.Scale=Vector3(1/scale.x,1/scale.y,1)
            self._T.sx=scale.x self._T.sy=scale.y
        end
        if self._T.parts==nil then
            local bg=self.Entity:GetChildByName("Bg") local fill=self.Entity:GetChildByName("Fill")
            if not isvalid(bg) or not isvalid(fill) then return end
            if not isvalid(bg.PixelRendererComponent) or not isvalid(fill.PixelRendererComponent) then return end
            self._T.parts={bg,fill}
            for _,part in ipairs(self._T.parts) do
                local pixel=part.PixelRendererComponent
                pixel:ResetWithColor(16,2,part.SpriteRendererComponent.Color)
                pixel.SortingLayer="MapLayer7" pixel.OrderInLayer=part==fill and 102 or 101
                part.SpriteRendererComponent.Enable=false
            end
            local pct=self.Entity:GetChildByName("Pct") if isvalid(pct) then pct.Enable=false end
            if Environment:IsMakerPlay() then log("[VRF][SummonHealthBar] rectangle attached parent="..parent.Name) end
        end
        for _,part in ipairs(self._T.parts) do
            local c=part.SpriteRendererComponent.Color
            local key=part.Name
            if self._T[key]~=c then part.PixelRendererComponent:FillColor(c) self._T[key]=c end
        end
    end
end
