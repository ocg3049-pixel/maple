    @ExecSpace("ClientOnly")
    method void UpdateLevelRecommendations(number delta)
        -- 레벨이 바뀔 때만 추천 목록을 계산하고 점의 기존 애니메이션으로 강조한다.
        local group = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if not isvalid(group) or not group.Enable then return end
        self._T.recommendElapsed = (self._T.recommendElapsed or 0) + delta
        if self._T.recommendElapsed < 0.2 then return end
        self._T.recommendElapsed = 0
        local level = math.max(1, _UIMyInfoManager.DisplayLevel)
        for _, entry in ipairs(self._T.regionPointEntries or {}) do
            if entry.recommendLevel ~= level then
                entry.recommendLevel = level
                entry.recommended = false
                for _, mapId in ipairs(entry.maps or {}) do
                    for _, mob in ipairs(self:GetMapMonsters(mapId)) do
                        if math.abs(mob.level - level) <= 5 then entry.recommended = true break end
                    end
                    if entry.recommended then break end
                end
            end
            local dot = entry.entity
            if isvalid(dot) then
                local sprite = dot.SpriteGUIRendererComponent
                local animate = dot == self._T.activeRegionDot or (self._T.recommendEnabled and entry.recommended)
                local ruid = animate and entry.animationRUID or entry.idleRUID
                if sprite.ImageRUID.DataId ~= ruid then sprite.ImageRUID = DataRef(ruid) end
                local last = animate and 2147483647 or 0
                if sprite.EndFrameIndex ~= last or sprite.PlayRate ~= (animate and 1 or 0) then
                    sprite.StartFrameIndex = 0
                    sprite.EndFrameIndex = last
                    sprite.PlayRate = animate and 1 or 0
                    sprite.AnimClipPlayType = SpriteAnimClipPlayType.Loop
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void LayoutLevelFilter()
        local group = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        local filter = isvalid(group) and group:GetChildByName("LevelFilter") or nil
        local panelName = self:GetMapPanels()[self._T.mapPage or "world"]
        local panel = isvalid(group) and group:GetChildByName(panelName) or nil
        if not isvalid(filter) or not isvalid(panel) then return end
        local edge = panel:GetChildByName("Destinations")
        if not isvalid(edge) then edge = panel end
        local pt = panel.UITransformComponent
        local et = edge.UITransformComponent
        local right = pt.anchoredPosition.x + (1-pt.Pivot.x)*pt.RectSize.x
        local bottom = pt.anchoredPosition.y - pt.Pivot.y*pt.RectSize.y
        if edge ~= panel then
            right = pt.anchoredPosition.x + et.anchoredPosition.x + (1-et.Pivot.x)*et.RectSize.x
            bottom = math.min(bottom, pt.anchoredPosition.y+et.anchoredPosition.y-et.Pivot.y*et.RectSize.y)
        end
        local size = filter.UITransformComponent.RectSize
        filter.UITransformComponent.anchoredPosition = Vector2(right-size.x/2,bottom-size.y/2-36)
    end

    @ExecSpace("ClientOnly")
    method void PrepareRegionDot(Entity dot)
        local sprite = dot.SpriteGUIRendererComponent
        if not isvalid(sprite) then return end
        self._T.regionDotOriginal = self._T.regionDotOriginal or {}
        self._T.regionDotIdle = self._T.regionDotIdle or {}
        self._T.regionDotFrames = self._T.regionDotFrames or {}
        local original = self._T.regionDotOriginal[dot.Id] or string.gsub(sprite.ImageRUID.DataId,"^thumbnail://","")
        local idle = self._T.regionDotFrames[original]
        if idle == nil then
            idle = original
            local ok, clip = pcall(function() return _ResourceService:LoadAnimationClipAndWait(original) end)
            if ok and clip ~= nil and clip.IsLoadComplete then
                local smallest = math.huge
                for _, frame in ipairs(clip.Frames:ToTable()) do
                    local image = frame.FrameSprite
                    if image ~= nil and image.Width >= 5 and image.Height >= 5 then
                        local area = image.Width*image.Height
                        if area < smallest then smallest = area idle = image.RUID end
                    end
                end
            end
            self._T.regionDotFrames[original] = idle
            log("[WorldMap] normal dot sprite " .. original .. " -> " .. idle)
        end
        self._T.regionDotOriginal[dot.Id] = original
        self._T.regionDotIdle[dot.Id] = idle
        sprite.ImageRUID = DataRef(idle)
        sprite.StartFrameIndex = 0
        sprite.EndFrameIndex = 0
        sprite.PlayRate = 0
        sprite.Enable = true
    end

    @ExecSpace("ClientOnly")
    method void RefreshLevelFilterMark()
        local filter = _EntityService:GetEntityByPath("/ui/WorldMapGroup/LevelFilter")
        if not isvalid(filter) then return end
        local surface = filter:GetChildByName("Surface")
        local label = filter:GetChildByName("Label")
        local box = filter:GetChildByName("Box")
        if isvalid(surface) then _UILogic:SetSiblingIndex(surface.UITransformComponent,1) end
        if isvalid(label) then _UILogic:SetSiblingIndex(label.UITransformComponent,2) end
        if not isvalid(box) then return end
        box.Enable = true
        _UILogic:SetSiblingIndex(box.UITransformComponent,3)
        local mark = box:GetChildByName("Mark")
        if isvalid(mark) then
            _UILogic:SetSiblingIndex(mark.UITransformComponent,100)
            mark.Enable = self._T.recommendEnabled == true
        end
    end
end
