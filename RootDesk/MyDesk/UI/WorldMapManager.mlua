@Logic
script WorldMapManager extends Logic

    property boolean prevMPressed   = false
    property boolean prevEscPressed = false
    property any touchEnterHandler  = nil
    property any touchExitHandler   = nil
    property any touchDownHandler   = nil

    method void OnBeginPlay()
        if self:IsClient() then
            self:WireVictoriaTouch()
            self:WireSleepywoodTouch()
            self:WireRegionTouches()
            self:WireRegionDestinations()
            self._T.recommendEnabled = false
            local check = _EntityService:GetEntityByPath("/ui/WorldMapGroup/LevelFilter")
            if isvalid(check) then
                self._T.filterButton = check
                self._T.filterClick = check:ConnectEvent(ButtonClickEvent, function()
                    self._T.recommendEnabled = not self._T.recommendEnabled
                    local mark = _EntityService:GetEntityByPath("/ui/WorldMapGroup/LevelFilter/Box/Mark")
                    if isvalid(mark) then mark.Enable = self._T.recommendEnabled end
                    self:RefreshLevelFilterMark()
                    self._T.recommendElapsed = 1
                    _UIAudio:Play("BtMouseClick")
                    log("[WorldMap] level filter=" .. tostring(self._T.recommendEnabled))
                end)
            end
            log("[WorldMap] 초기화 완료")
        end
    end

    method void OnEndPlay()
        if self:IsClient() then
            if isvalid(self._T.filterButton) and self._T.filterClick then self._T.filterButton:DisconnectEvent(ButtonClickEvent, self._T.filterClick) end
            self:UnwireVictoriaTouch()
            self:UnwireSleepywoodTouch()
            self:UnwireRegionTouches()
            self:UnwireRegionDestinations()
        end
    end

    @ExecSpace("ClientOnly")
    method void WireVictoriaTouch()
        local touch = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/VictoriaTouch")
        if not isvalid(touch) then
            log("[WorldMap] VictoriaTouch 없음")
            return
        end
        self.touchEnterHandler = touch:ConnectEvent(UITouchEnterEvent, self.OnVictoriaEnter)
        self.touchExitHandler  = touch:ConnectEvent(UITouchExitEvent,  self.OnVictoriaExit)
        self.touchDownHandler  = touch:ConnectEvent(UITouchDownEvent,  self.OnVictoriaDown)
        log("[WorldMap] VictoriaTouch 이벤트 연결 완료")
    end

    @ExecSpace("ClientOnly")
    method void UnwireVictoriaTouch()
        local touch = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/VictoriaTouch")
        if isvalid(touch) then
            if self.touchEnterHandler ~= nil then touch:DisconnectEvent(UITouchEnterEvent, self.touchEnterHandler) end
            if self.touchExitHandler  ~= nil then touch:DisconnectEvent(UITouchExitEvent,  self.touchExitHandler)  end
            if self.touchDownHandler  ~= nil then touch:DisconnectEvent(UITouchDownEvent,  self.touchDownHandler)  end
        end
        self.touchEnterHandler = nil
        self.touchExitHandler  = nil
        self.touchDownHandler  = nil
    end





    @ExecSpace("ClientOnly")
    method void FadeAndTeleport(string mapId)
        if self._T.isFading then return end
        self._T.isFading = true
        _ScreenTransitionService:SetFadeInOutEnable(true)
        _ScreenTransitionService:SetFadeOutTime(1.0)
        _ScreenTransitionService:SetFadeInTime(1.0)
        self:CloseAll()
        self:RequestMoveToMap(mapId)
        self._T.isFading = false
    end



    @ExecSpace("ClientOnly")
    method void ResetDots()
        -- 페이지 종료 시 선택 프레임과 호버를 함께 원상복구한다.
        self:ClearRegionSelection()
        self:HideMapTooltip()
        self:ClearSubregionGlows()
        self._T.lastClickDot = nil
        self._T.lastClickTime = -99
        if self._T.activeDotComp ~= nil and isvalid(self._T.activeDotComp) then
            self._T.activeDotComp.PlayRate = 0
            self._T.activeDotComp.Color = self._T.activeDotBaseColor or Color(1, 1, 1, 1)
            self._T.activeDotComp = nil
            self._T.activeDotBaseColor = nil
        end
        if self._T.activeArrowComp ~= nil and isvalid(self._T.activeArrowComp) then
            self._T.activeArrowComp.PlayRate = 0
            self._T.activeArrowComp.Color = Color(0, 0, 0, 0)
            self._T.activeArrowComp = nil
        end
    end

    method void OnUpdate(number delta)
        if not self:IsClient() then return end
        self:FollowMapTooltip(delta)
        self:UpdateLevelRecommendations(delta)
        local filter = _EntityService:GetEntityByPath("/ui/WorldMapGroup/LevelFilter")
        if isvalid(filter) then
            self:LayoutLevelFilter()
        end

        -- 단축키 세팅의 퀵슬롯 리매핑 키 캡처 중에는 월드맵/Esc 폴링을 무시한다 (눌림 상태만 갱신)
        -- 월드맵 키는 키설정(])에서 옮길 수 있으므로 하드코딩(M) 대신 기능 매핑으로 눌림을 확인한다
        if _KeySettingManager:IsCapturingKey() then
            self.prevMPressed = _KeySettingManager:IsFuncKeyPressed("worldmap")
            self.prevEscPressed = _InputService:IsKeyPressed(KeyboardKey.Escape)
            return
        end

        local mNow = _KeySettingManager:IsFuncKeyPressed("worldmap")
        if mNow and not self.prevMPressed then self:OnMKey() end
        self.prevMPressed = mNow

        local escNow = _InputService:IsKeyPressed(KeyboardKey.Escape)
        if escNow and not self.prevEscPressed then self:OnEscKey() end
        self.prevEscPressed = escNow

    end

    @ExecSpace("ClientOnly")
    method void OnVictoriaEnter(UITouchEnterEvent event)
        self:ShowGlow()
        log("[WorldMap] 빅토리아 호버")
    end

    @ExecSpace("ClientOnly")
    method void OnVictoriaExit(UITouchExitEvent event)
        self:HideGlow()
    end

    @ExecSpace("ClientOnly")
    method void OnVictoriaDown(UITouchDownEvent event)
        self:OnVictoriaClick()
    end

    @ExecSpace("ClientOnly")
    method void OnMKey()
        -- M으로 열 때마다 플레이어가 있는 가장 상세한 지역 지도를 선택한다.
        local mapGroup = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if not isvalid(mapGroup) then return end
        if mapGroup.Enable then
            self:CloseAll()
            return
        end
        local player = _UserService.LocalPlayer
        local mapName = ""
        if isvalid(player) and isvalid(player.CurrentMap) then mapName = _ChannelManager:BaseName(player.CurrentMap.Name) end
        self:ShowMapPage(self:GetPageForMap(mapName))
    end

    @ExecSpace("ClientOnly")
    method void OnEscKey()
        -- 상세 지도에서 한 단계씩 상위 지도로 돌아가고 전체 지도에서만 닫는다.
        local mapGroup = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if not isvalid(mapGroup) or not mapGroup.Enable then return end
        if self._T.mapPage ~= "world" then
            self:ShowMapPage(self:GetParentPage(self._T.mapPage or "world"))
        else
            self:CloseAll()
        end
    end

    @ExecSpace("ClientOnly")
    method void CloseAll()
        self:ResetDots()
        self:SetSleepywoodGlow(false)
        self:ClearRegionGlows()
        self._T.mapPage = nil
        local mapGroup = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if isvalid(mapGroup) then mapGroup.Enable = false end
        self:HideGlow()
        log("[WorldMap] 닫힘")
    end

    @ExecSpace("ClientOnly")
    method void ShowGlow()
        local glow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/VictoriaGlow")
        if isvalid(glow) then glow.Enable = true end
    end

    @ExecSpace("ClientOnly")
    method void HideGlow()
        local glow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/VictoriaGlow")
        if isvalid(glow) then glow.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void OnVictoriaClick()
        -- 전체 지도에서 빅토리아 상세 지도로 내려간다.
        self:ShowMapPage("victoria")
    end

    @ExecSpace("ClientOnly")
    method string GetPageForMap(string mapName)
        -- 구현된 상세 지도 ID를 먼저 조회하고 빅토리아 기본 맵을 처리한다.
        if self._T.mapPages ~= nil and self._T.mapPages[mapName] ~= nil then return self._T.mapPages[mapName] end
        if string.match(mapName, "^105%d%d%d%d%d%d$") then return "sleepywood" end
        if string.match(mapName, "^0%d%d%d%d%d%d%d%d$") then return "victoria" end
        if mapName == "map01" or string.match(mapName, "^10%d%d%d%d%d%d%d$") then return "victoria" end
        return "world"
    end

    @ExecSpace("ClientOnly")
    method void ShowMapPage(string page)
        -- 한 번에 지도 하나만 표시하고 이전 페이지의 선택/호버 상태를 초기화한다.
        local group = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if not isvalid(group) then return end
        local panels = self:GetMapPanels()
        local name = panels[page]
        if name == nil or not isvalid(group:GetChildByName(name)) then return end
        self:ResetDots()
        self:HideGlow()
        self:SetSleepywoodGlow(false)
        self:ClearRegionGlows()
        for key, panelName in pairs(panels) do
            local panel = group:GetChildByName(panelName)
            if isvalid(panel) then panel.Enable = key == page end
        end
        self._T.mapPage = page
        self._T.regionListPage = 1
        self._T.regionMapFilter = nil
        self._T.lastRegionDot = nil
        self:ClearRegionSelection()
        self:RefreshRegionDestinations()
        self:LayoutLevelFilter()
        self:RefreshLevelFilterMark()
        self._T.recommendElapsed = 1
        self:UpdateLevelRecommendations(0)
        group.Enable = true
        _MapleIslandTutorial:Notify("worldmap")
        log("[WorldMap] 페이지 열림: " .. page)
    end

    @ExecSpace("ClientOnly")
    method void WireSleepywoodTouch()
        -- 기존 마을 이동점보다 뒤에 놓인 영역과 이동점 양쪽에서 호버를 표시한다.
        self._T.sleepywoodHandlers = {}
        for _, name in ipairs({"SleepywoodTouch", "RegionDot60"}) do
            local touch = _EntityService:GetEntityByPath("/ui/WorldMapGroup/VictoriaPanel/" .. name)
            if isvalid(touch) then
                local enter = touch:ConnectEvent(UITouchEnterEvent, self.OnSleepywoodEnter)
                local leave = touch:ConnectEvent(UITouchExitEvent, self.OnSleepywoodExit)
                local down = nil
                if name == "SleepywoodTouch" then down = touch:ConnectEvent(UITouchDownEvent, self.OnSleepywoodDown) end
                table.insert(self._T.sleepywoodHandlers, {entity = touch, enter = enter, leave = leave, down = down})
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void UnwireSleepywoodTouch()
        -- 플레이 종료 시 추가한 호버/클릭 연결을 해제한다.
        for _, entry in ipairs(self._T.sleepywoodHandlers or {}) do
            if isvalid(entry.entity) then
                entry.entity:DisconnectEvent(UITouchEnterEvent, entry.enter)
                entry.entity:DisconnectEvent(UITouchExitEvent, entry.leave)
                if entry.down ~= nil then entry.entity:DisconnectEvent(UITouchDownEvent, entry.down) end
            end
        end
        self._T.sleepywoodHandlers = nil
    end

    @ExecSpace("ClientOnly")
    method void SetSleepywoodGlow(boolean show)
        -- 지정된 슬리피우드 강조 이미지만 토글한다.
        local glow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/VictoriaPanel/SleepywoodGlow")
        if isvalid(glow) then glow.Enable = show end
    end

    @ExecSpace("ClientOnly")
    method void OnSleepywoodEnter(UITouchEnterEvent event)
        -- 슬리피우드 입구를 가리키면 원본 호버 이미지를 표시한다.
        self:SetSleepywoodGlow(true)
        log("[WorldMap] 슬리피우드 호버")
    end

    @ExecSpace("ClientOnly")
    method void OnSleepywoodExit(UITouchExitEvent event)
        -- 입구에서 포인터가 벗어나면 강조를 해제한다.
        self:SetSleepywoodGlow(false)
    end

    @ExecSpace("ClientOnly")
    method void OnSleepywoodDown(UITouchDownEvent event)
        -- 지역 영역 클릭은 지도 탐색이며 플레이어를 이동시키지 않는다.
        self:ShowMapPage("sleepywood")
    end

    @ExecSpace("Server")
    method void RequestMoveToMap(string mapId)
        local userId = senderUserId
        local player = self:FindPlayerByUserId(userId)
        if not isvalid(player) then
            log("[WorldMap] 플레이어 없음: " .. userId)
            return
        end
        local destination = _EntityService:GetEntityByPath("/maps/" .. mapId)
        if not isvalid(destination) then return end
        local position = Vector3(0, 0, 0)
        local spawn = destination:GetFirstChildComponentByTypeName("MOD.Core.SpawnLocationComponent", true)
        if isvalid(spawn) and isvalid(spawn.Entity.TransformComponent) then
            local point = spawn.Entity.TransformComponent.WorldPosition
            position = Vector3(point.x, point.y + 0.1, 0)
        end
        _MapPortalSystem:NotifyMapTravel(mapId, userId)
        local channelMap = _ChannelManager:EnsureMap(mapId, userId)
        if channelMap == "" then return end
        _TeleportService:TeleportToMapPosition(player, position, channelMap)
        log("[WorldMap] 맵 이동: " .. userId .. " → " .. mapId)
    end

    @ExecSpace("ServerOnly")
    method Entity FindPlayerByUserId(string userId)
        local mapsEnt = _EntityService:GetEntityByPath("/maps")
        if not isvalid(mapsEnt) then return nil end
        for _, map in ipairs(mapsEnt.Children:ToTable()) do
            if not isvalid(map) then continue end
            for _, child in ipairs(map.Children:ToTable()) do
                if isvalid(child) and isvalid(child.PlayerComponent) then
                    if tostring(child.PlayerComponent.UserId) == userId then
                        return child
                    end
                end
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method void WireRegionTouches()
        -- 전체 지도에서 각 지역의 호버와 상세 지도 열기를 연결한다.
        self._T.regionHandlers = {}
        for _, key in ipairs({"elnath", "minar", "ludus"}) do
            local touch = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/" .. key .. "Touch")
            if isvalid(touch) then
                local enter = touch:ConnectEvent(UITouchEnterEvent, self.OnRegionEnter)
                local leave = touch:ConnectEvent(UITouchExitEvent, self.OnRegionExit)
                local down = touch:ConnectEvent(UITouchDownEvent, self.OnRegionDown)
                table.insert(self._T.regionHandlers, {entity = touch, enter = enter, leave = leave, down = down})
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void UnwireRegionTouches()
        -- 세션 종료 시 지역 지도 이벤트를 모두 해제한다.
        for _, entry in ipairs(self._T.regionHandlers or {}) do
            if isvalid(entry.entity) then
                entry.entity:DisconnectEvent(UITouchEnterEvent, entry.enter)
                entry.entity:DisconnectEvent(UITouchExitEvent, entry.leave)
                entry.entity:DisconnectEvent(UITouchDownEvent, entry.down)
            end
        end
        self._T.regionHandlers = nil
    end

    @ExecSpace("ClientOnly")
    method void ClearRegionGlows()
        -- 페이지 변경 시 남아 있는 지역 강조를 숨긴다.
        for _, key in ipairs({"elnath", "minar", "ludus"}) do
            local glow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/" .. key .. "Glow")
            if isvalid(glow) then glow.Enable = false end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnRegionEnter(UITouchEnterEvent event)
        -- 원본 지역 강조 이미지를 표시한다.
        self:ClearRegionGlows()
        local key = string.sub(event.Entity.Name, 1, -6)
        local glow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/" .. key .. "Glow")
        if isvalid(glow) then glow.Enable = true end
    end

    @ExecSpace("ClientOnly")
    method void OnRegionExit(UITouchExitEvent event)
        -- 벗어난 지역의 강조만 해제한다.
        local key = string.sub(event.Entity.Name, 1, -6)
        local glow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/FullMapPanel/" .. key .. "Glow")
        if isvalid(glow) then glow.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void OnRegionDown(UITouchDownEvent event)
        -- 클릭한 지역의 상세 지도를 연다.
        self:ShowMapPage(string.sub(event.Entity.Name, 1, -6))
    end

