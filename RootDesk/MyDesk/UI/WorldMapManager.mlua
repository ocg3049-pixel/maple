            {page = "ludus", panel = "LudusPanel", name = "RegionDot32", maps = {"221022300", "221022400", "221022500", "221022600", "221022700", "221022800", "221022900", "221023000", "221023100"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot33", maps = {"221022200"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot34", maps = {"220010300"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot35", maps = {"221021700", "221021800", "221021900", "221022000", "221022100"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot36", maps = {"221021600"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot37", maps = {"221021100", "221021200", "221021300", "221021400", "221021500"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot38", maps = {"221020000", "221020100", "221021000", "221020200", "221020300", "221020400", "221020500", "221020600", "221020700", "221020800", "221020900"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot39", maps = {"220000300", "220000301", "220000302", "220000303", "220000304", "220000305", "220000306", "220000307"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot40", maps = {"220000400"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot41", maps = {"220000500"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot42", maps = {"220000100", "220000110", "220000111"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot45", maps = {"220010400"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot49", maps = {"220010500"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot50", maps = {"220010600"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot51", maps = {"220010700"}},
            {page = "ludus", panel = "LudusPanel", name = "RegionDot52", maps = {"220010800"}},
        }
        self:ConfigureSubregions()
        for _, panelName in pairs(self:GetMapPanels()) do
            local panel = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. panelName)
            if isvalid(panel) then
                for _, dot in ipairs(panel.Children:ToTable()) do
                    if string.match(dot.Name, "^RegionDot%d+$") then self:PrepareRegionDot(dot) end
                end
            end
        end
        self._T.regionPointByEntity = {}
        self._T.regionHoverPages = {}
        for _, entry in ipairs(self._T.regionPointEntries) do
            local dot = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. entry.panel .. "/" .. entry.name)
            if isvalid(dot) then
                entry.animationRUID = self._T.regionDotOriginal[dot.Id]
                entry.idleRUID = self._T.regionDotIdle[dot.Id]
                dot.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.NativeSize
                dot.SpriteGUIRendererComponent.StartFrameIndex = 0
                dot.SpriteGUIRendererComponent.EndFrameIndex = 0
                dot.SpriteGUIRendererComponent.PlayRate = 0
                self._T.regionPointByEntity[dot.Id] = entry
                entry.entity = dot
                self._T.regionHoverPages[entry.page] = self._T.regionHoverPages[entry.page] or {}
                table.insert(self._T.regionHoverPages[entry.page], entry)
                local down = dot:ConnectEvent(UITouchDownEvent, self.OnRegionDotDown)
                local enter = dot:ConnectEvent(UITouchEnterEvent, self.OnRegionDotEnter)
                local leave = dot:ConnectEvent(UITouchExitEvent, self.OnRegionDotExit)
                table.insert(self._T.destinationHandlers, {entity = dot, down = down, enter = enter, leave = leave})
            end
        end
        for _, panelName in pairs(self:GetMapPanels()) do
            local panel = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. panelName .. "/Destinations")
            if isvalid(panel) then
                for _, child in ipairs(panel.Children:ToTable()) do
                    if string.match(child.Name, "^Row%d+$") or child.Name == "Previous" or child.Name == "Next" or child.Name == "Title" then
                        local down = child:ConnectEvent(UITouchDownEvent, self.OnDestinationDown)
                        table.insert(self._T.destinationHandlers, {entity = child, down = down})
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void UnwireRegionDestinations()
        -- 이동 목록의 이벤트 참조를 정리한다.
        for _, entry in ipairs(self._T.destinationHandlers or {}) do
            if isvalid(entry.entity) then
                if entry.down ~= nil then entry.entity:DisconnectEvent(UITouchDownEvent, entry.down) end
                if entry.enter ~= nil then entry.entity:DisconnectEvent(UITouchEnterEvent, entry.enter) end
                if entry.leave ~= nil then entry.entity:DisconnectEvent(UITouchExitEvent, entry.leave) end
            end
        end
        self._T.destinationHandlers = nil
    end

    @ExecSpace("ClientOnly")
    method string GetMapDisplayName(string mapId)
        -- 지역 지도와 미니맵이 같은 한글 맵 이름을 사용한다.
        for _, entry in ipairs(self._T.regionDestinations or {}) do
            if entry.id == mapId then return entry.title end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method void RefreshRegionDestinations()
        -- 현재 지역의 맵을 20개씩 표시한다.
        local panels = self:GetMapPanels()
        local panelName = panels[self._T.mapPage or ""]
        if panelName == nil then return end
        local panel = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. panelName .. "/Destinations")
        if not isvalid(panel) then return end
        local entries = {}
        for _, entry in ipairs(self._T.regionDestinations or {}) do
            if self:IsPageWithin(entry.page, self._T.mapPage or "") and (self._T.regionMapFilter == nil or self._T.regionMapFilter[entry.id]) then table.insert(entries, entry) end
        end
        self._T.visibleDestinations = entries
        self._T.destinationEntryByRow = {}
        local total = math.max(1, math.ceil(#entries / 20))
        local index = math.max(1, math.min(total, self._T.regionListPage or 1))
        self._T.regionListPage = index
        self._T.destinationPageCount = total
        self._T.lastDestination = nil
        self:HideMapTooltip()
        self._T.tooltipRowMap = nil
        for rowIndex = 1, 20 do
            local row = panel:GetChildByName("Row" .. tostring(rowIndex))
            local entry = entries[(index - 1) * 20 + rowIndex]
            if isvalid(row) then
                row.Enable = entry ~= nil
                self._T.destinationEntryByRow[row.Id] = entry
                if entry ~= nil then row.TextGUIRendererComponent.Text = entry.title end
                row.SpriteGUIRendererComponent.Color = rowIndex % 2 == 1 and Color(0.91, 0.84, 0.68, 0.8) or Color(0.97, 0.94, 0.85, 0.8)
            end
        end
        panel:GetChildByName("Page").TextGUIRendererComponent.Text = tostring(index) .. " / " .. tostring(total)
    end

    @ExecSpace("ClientOnly")
    method void OnDestinationDown(UITouchDownEvent event)
        -- 페이지 버튼은 목록을 넘기고 같은 행의 더블클릭은 해당 맵으로 이동한다.
        local row = event.Entity
        if row.Name == "Title" then
            self._T.lastRegionDot = nil
            self._T.regionMapFilter = nil
            self._T.regionListPage = 1
            self:ClearRegionSelection()
            self:RefreshRegionDestinations()
            return
        end
        if row.Name == "Previous" or row.Name == "Next" then
            local step = row.Name == "Next" and 1 or -1
            self._T.regionListPage = (self._T.regionListPage or 1) + step
            self:RefreshRegionDestinations()
            return
        end
        local rowIndex = tonumber(string.match(row.Name, "^Row(%d+)$"))
        if rowIndex == nil then return end
        local entry = self._T.destinationEntryByRow and self._T.destinationEntryByRow[row.Id]
        if entry == nil then return end
        local now = _UtilLogic.ElapsedSeconds
        if self._T.lastDestination == entry.id and now - (self._T.lastDestinationTime or -99) < 0.4 then
            self:FadeAndTeleport(entry.id)
            return
        end
        self:RefreshRegionDestinations()
        self._T.lastDestination = entry.id
        self._T.lastDestinationTime = now
        row.SpriteGUIRendererComponent.Color = Color(1, 0.8, 0.35, 1)
    end

    @ExecSpace("ClientOnly")
    method void ClearRegionSelection()
        -- 지역 지도마다 선택 화살표와 점 재생 상태를 초기화한다.
        for _, panelName in pairs(self:GetMapPanels()) do
            local arrow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. panelName .. "/RegionSelection")
            if isvalid(arrow) then arrow.Enable = false end
        end
        if isvalid(self._T.activeRegionDot) then
            local sprite = self._T.activeRegionDot.SpriteGUIRendererComponent
            local entry = self._T.regionPointByEntity[self._T.activeRegionDot.Id]
            if entry ~= nil then sprite.ImageRUID = DataRef(entry.idleRUID) end
            sprite.StartFrameIndex = 0
            sprite.EndFrameIndex = 0
            sprite.PlayRate = 0
        end
        self._T.activeRegionDot = nil
    end

    @ExecSpace("ClientOnly")
    method void OnRegionDotDown(UITouchDownEvent event)
        -- 원본 이동점의 맵 묶음을 표시하고 더블클릭하면 대표 맵으로 이동한다.
        local dot = event.Entity
        local entry = self._T.regionPointByEntity and self._T.regionPointByEntity[dot.Id]
        if entry == nil then return end
        if entry.targetPage ~= nil then
            self:ShowMapPage(entry.targetPage)
            return
        end
        local now = _UtilLogic.ElapsedSeconds
        if self._T.lastRegionDot == dot.Id and now - (self._T.lastRegionDotTime or -99) < 0.4 then
            self:FadeAndTeleport(entry.maps[1])
            return
        end
        self._T.lastRegionDot = dot.Id
        self._T.lastRegionDotTime = now
        self._T.regionMapFilter = {}
        for _, mapId in ipairs(entry.maps) do self._T.regionMapFilter[mapId] = true end
        self._T.regionListPage = 1
        self:ClearRegionSelection()
        self._T.activeRegionDot = dot
        dot.SpriteGUIRendererComponent.ImageRUID = DataRef(entry.animationRUID)
        dot.SpriteGUIRendererComponent.EndFrameIndex = 2147483647
        dot.SpriteGUIRendererComponent.PlayRate = 1
        dot.SpriteGUIRendererComponent.AnimClipPlayType = SpriteAnimClipPlayType.Loop
        local arrow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. entry.panel .. "/RegionSelection")
        if isvalid(arrow) then
            arrow.Enable = true
            arrow.UITransformComponent.anchoredPosition = dot.UITransformComponent.anchoredPosition
            arrow.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.NativeSize
            arrow.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
            arrow.SpriteGUIRendererComponent.PlayRate = 1
            arrow.SpriteGUIRendererComponent.AnimClipPlayType = SpriteAnimClipPlayType.Loop
        end
        self:RefreshRegionDestinations()
    end


    @ExecSpace("ClientOnly")
    method table GetMapPanels()
        -- 전체 지도와 모든 하위 페이지의 패널을 한 곳에서 관리한다.
        return {world = "FullMapPanel", victoria = "VictoriaPanel", sleepywood = "SleepywoodPanel", elnath = "ElNathPanel", minar = "MinarPanel", ludus = "LudusPanel", nautilus = "nautilusPanel", ellinel = "ellinelPanel", goldbeach = "goldbeachPanel", mushroom = "mushroomPanel", kerningtower = "kerningtowerPanel", ellodin = "ellodinPanel", deadmine = "deadminePanel"}
    end

    @ExecSpace("ClientOnly")
    method string GetParentPage(string page)
        -- 상세 지역은 소속 대륙으로, 대륙은 전체 지도로 돌아간다.
        if page == "sleepywood" then return "victoria" end
        for _, sub in ipairs(self._T.subregions or {}) do
            if sub.key == page then return sub.parent end
        end
        return "world"
    end

    @ExecSpace("ClientOnly")
    method boolean IsPageWithin(string page, string ancestor)
        -- 상위 지도 목록에서도 소속 상세 지역의 목적지를 볼 수 있다.
        for depth = 1, 4 do
            if page == ancestor then return true end
            if page == "world" then return false end
            page = self:GetParentPage(page)
        end
        return false
    end

