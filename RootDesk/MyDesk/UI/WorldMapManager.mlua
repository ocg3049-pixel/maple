{page="deadmine", panel="deadminePanel", name="RegionDot24", maps={"211041200"}}}) do table.insert(self._T.regionPointEntries, entry) end
        for _, sub in ipairs(self._T.subregions) do
            local mapMembership = {}
            for _, mapId in ipairs(sub.maps) do mapMembership[mapId] = true; self._T.mapPages[mapId] = sub.key end
            for _, entry in ipairs(self._T.regionDestinations) do
                if mapMembership[entry.id] then entry.page = sub.key end
            end
            for _, entry in ipairs(self._T.regionPointEntries) do
                if entry.page == sub.parent and entry.name == sub.dot then entry.targetPage = sub.key end
            end
            local captured = sub
            local touch = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. sub.parentPanel .. "/" .. sub.key .. "Touch")
            if isvalid(touch) then
                local enter = touch:ConnectEvent(UITouchEnterEvent, function()
                    self:ClearSubregionGlows()
                    self:SetSubregionGlow(captured.key, true)
                    self:ShowMapTooltip(captured.maps, captured.title, touch)
                end)
                local leave = touch:ConnectEvent(UITouchExitEvent, function()
                    self:SetSubregionGlow(captured.key, false)
                    -- 툴팁 종료는 공통 커서 판정에서 처리한다.
                end)
                local down = touch:ConnectEvent(UITouchDownEvent, function() self:ShowMapPage(captured.key) end)
                table.insert(self._T.destinationHandlers, {entity=touch, enter=enter, leave=leave, down=down})
            end
        end
        log("[WorldMap] 상세 지도 7개 연결 완료")
    end

    @ExecSpace("ClientOnly")
    method void SetSubregionGlow(string key, boolean show)
        -- 해당 부모 지도 위의 원본 호버 이미지를 표시한다.
        for _, sub in ipairs(self._T.subregions or {}) do
            if sub.key == key then
                local glow = _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. sub.parentPanel .. "/" .. key .. "Glow")
                if isvalid(glow) then glow.Enable = show end
                return
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ClearSubregionGlows()
        -- 페이지 변경 또는 닫기 때 모든 하위 지역 강조를 지운다.
        for _, sub in ipairs(self._T.subregions or {}) do self:SetSubregionGlow(sub.key, false) end
    end

    @ExecSpace("ClientOnly")
    method void OnRegionDotEnter(UITouchEnterEvent event)
        -- 이벤트 순서 대신 커서 위치로 가장 가까운 점을 선택한다.
        self:UpdateMapTooltipHover(_InputService:GetCursorPosition(), 0)
    end

    @ExecSpace("ClientOnly")
    method void ShowRegionDotTooltip(Entity dot)
        -- 이동점에 연결된 실제 맵들의 몬스터 목록을 표시한다.
        local entry = self._T.regionPointByEntity and self._T.regionPointByEntity[dot.Id]
        if entry == nil then return end
        local title = self:GetMapDisplayName(entry.maps[1])
        if entry.targetPage ~= nil then
            self:ClearSubregionGlows()
            self:SetSubregionGlow(entry.targetPage, true)
            for _, sub in ipairs(self._T.subregions or {}) do
                if sub.key == entry.targetPage then title = sub.title end
            end
        end
        self:ShowMapTooltip(entry.maps, title, dot)
    end

    @ExecSpace("ClientOnly")
    method void OnRegionDotExit(UITouchExitEvent event)
        -- 겹친 영역에서 발생하는 Exit는 무시하고 공통 위치 판정으로 종료한다.
    end

    @ExecSpace("ClientOnly")
    method void HideMapTooltip()
        -- 모든 종료 경로에서 설명창과 참조를 해제한다.
        local tip = _EntityService:GetEntityByPath("/ui/WorldMapGroup/MapTooltip")
        if isvalid(tip) then tip.Enable = false end
        self._T.tooltipTarget = nil
        self._T.tooltipOutsideTime = 0
    end

    @ExecSpace("ClientOnly")
    method void ShowMapTooltip(table maps, string title, Entity target)
        -- 제작 데이터에서 추출한 몬스터를 중복 제거하여 레벨 순으로 표시한다.
        local tip = _EntityService:GetEntityByPath("/ui/WorldMapGroup/MapTooltip")
        if not isvalid(tip) then return end
        local seen = {}
        local monsters = {}
        for _, mapId in ipairs(maps) do
            for _, mob in ipairs(self:GetMapMonsters(mapId)) do
                local key = mob.name .. ":" .. tostring(mob.level)
                if not seen[key] then seen[key] = true; table.insert(monsters, mob) end
            end
        end
        table.sort(monsters, function(a,b) if a.level == b.level then return a.name < b.name end; return a.level < b.level end)
        local columns = math.min(3, math.max(1, math.ceil(#monsters / 24)))
        local rows = math.max(1, math.ceil(#monsters / columns))
        local width = columns * 310 + 32
        local height = rows * 24 + 78
        self._T.tooltipWidth = width
        self._T.tooltipHeight = height
        tip.UITransformComponent.RectSize = Vector2(width, height)
        local heading = tip:GetChildByName("Title")
        heading.UITransformComponent.RectSize = Vector2(width-32, 32)
        heading.UITransformComponent.anchoredPosition = Vector2(0,height/2-29)
        heading.TextGUIRendererComponent.Text = title .. (#maps > 1 and " (" .. tostring(#maps) .. "개 맵 통합)" or "")
        for col = 1, 3 do
            local body = tip:GetChildByName("Body" .. tostring(col))
            body.Enable = col <= columns
            if col <= columns then
                local lines = {}
                for row = 1, rows do
                    local mob = monsters[(col-1)*rows+row]
                    if mob ~= nil then
                        local difference = mob.level - math.max(1, _UIMyInfoManager.DisplayLevel)
                        local color = difference > 10 and "#FF3333" or (difference > 5 and "#FF8C1A" or (difference < -5 and "#FFE633" or "#FFFFFF"))
                        table.insert(lines, "<color=" .. color .. ">Lv." .. tostring(mob.level) .. "  " .. mob.name .. "</color>")
                    end
                end
                if #monsters == 0 then lines = {"출현 몬스터 없음"} end
                body.TextGUIRendererComponent.IsRichText = true
                body.TextGUIRendererComponent.Text = table.concat(lines,"\n")
                body.UITransformComponent.RectSize = Vector2(300,rows*24+4)
                body.UITransformComponent.anchoredPosition = Vector2(-width/2+16+(col-0.5)*310,-22)
            end
        end
        self._T.tooltipTarget = target
        self._T.tooltipOutsideTime = 0
        tip.Enable = true
        _UILogic:SetSiblingIndex(tip.UITransformComponent,1000000)
        self:PositionMapTooltip()
        log("[WorldMap] 몬스터 툴팁: " .. title .. " / " .. tostring(#monsters) .. "종")
    end

    @ExecSpace("ClientOnly")
    method void PositionMapTooltip()
        -- 아이템 툴팁처럼 커서 옆을 따라가며 화면 경계를 넘지 않게 배치한다.
        local tip = _EntityService:GetEntityByPath("/ui/WorldMapGroup/MapTooltip")
        if not isvalid(tip) or not tip.Enable then return end
        local pos = _UILogic:ScreenToUIPosition(_InputService:GetCursorPosition())
        local width = self._T.tooltipWidth or 342
        local height = self._T.tooltipHeight or 102
        local left = pos.x + 18
        if left + width > 950 then left = pos.x - 18 - width end
        left = math.max(-950,math.min(950-width,left))
        local top = math.max(-530+height,math.min(530,pos.y-18))
        tip.UITransformComponent.anchoredPosition = Vector2(left+width/2,top-height/2)
    end

    @ExecSpace("ClientOnly")
    method void FollowMapTooltip(number delta)
        self:UpdateMapTooltipHover(_InputService:GetCursorPosition(), delta)
    end

    @ExecSpace("ClientOnly")
    method void UpdateMapTooltipHover(Vector2 cursor, number delta)
        -- 표시와 유지에 동일한 영역을 사용하며, 겹친 점은 중심이 가까운 쪽을 선택한다.
        local group = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if not isvalid(group) or not group.EnabledInHierarchy then
            if isvalid(self._T.tooltipTarget) then self:HideMapTooltip() end
            return
        end
        local panelNameForRows = self:GetMapPanels()[self._T.mapPage or ""]
        local rowPanel = panelNameForRows and group:GetChildByName(panelNameForRows)
        local list = isvalid(rowPanel) and rowPanel:GetChildByName("Destinations") or nil
        if isvalid(list) and list.EnabledInHierarchy then
            local hoveredRow = nil
            local hoveredEntry = nil
            local closest = math.huge
            for i = 1, 20 do
                local row = list:GetChildByName("Row" .. tostring(i))
                local entry = isvalid(row) and self._T.destinationEntryByRow and self._T.destinationEntryByRow[row.Id]
                if isvalid(row) and row.EnabledInHierarchy and row.VisibleInHierarchy and entry ~= nil then
                    local tr = row.UITransformComponent
                    local pos = _UILogic:ScreenToLocalUIPosition(cursor, tr)
                    local size, pivot = tr.RectSize, tr.Pivot
                    local dx = pos.x - (0.5-pivot.x)*size.x
                    local dy = pos.y - (0.5-pivot.y)*size.y
                    -- 세로 확장은 인접 행과 겹치지 않게 하고 가로 여유는 유지한다.
                    if math.abs(dx) <= size.x/2+10 and math.abs(dy) <= size.y/2 and math.abs(dy) < closest then
                        hoveredRow, hoveredEntry, closest = row, entry, math.abs(dy)
                    end
                end
            end
            if isvalid(hoveredRow) then
                self._T.tooltipOutsideTime = 0
                if self._T.tooltipTarget ~= hoveredRow or self._T.tooltipRowMap ~= hoveredEntry.id then
                    self:ShowMapTooltip({hoveredEntry.id}, hoveredEntry.title, hoveredRow)
                    self._T.tooltipRowMap = hoveredEntry.id
                    log("[WorldMapRowTooltip] " .. hoveredRow.Name .. " map=" .. hoveredEntry.id .. " title=" .. hoveredEntry.title)
                end
                self:PositionMapTooltip()
                return
            end
        end
        local nearest = nil
        local best = math.huge
        local page = self._T.mapPage
        local points = self._T.regionHoverPages and self._T.regionHoverPages[page]
        local panelName = self:GetMapPanels()[page]
        local panel = panelName and group:GetChildByName(panelName)
        if points ~= nil and isvalid(panel) and panel.EnabledInHierarchy then
            local pos = _UILogic:ScreenToLocalUIPosition(cursor, panel.UITransformComponent)
            for _, entry in ipairs(points) do
                local dot = entry.entity
                if isvalid(dot) and dot.EnabledInHierarchy then
                    local tr = dot.UITransformComponent
                    local dx = pos.x - tr.anchoredPosition.x
                    local dy = pos.y - tr.anchoredPosition.y
                    local padding = self._T.tooltipTarget == dot and 6 or 0
                    local halfX = math.max(18, tr.RectSize.x / 2) + padding
                    local halfY = math.max(18, tr.RectSize.y / 2) + padding
                    local distance = dx*dx + dy*dy
                    if math.abs(dx) <= halfX and math.abs(dy) <= halfY and distance < best then
                        nearest = dot
                        best = distance
                    end
                end
            end
        end
        if isvalid(nearest) then
            self._T.tooltipOutsideTime = 0
            if self._T.tooltipTarget ~= nearest then self:ShowRegionDotTooltip(nearest) end
            self:PositionMapTooltip()
            return
        end
        local target = self._T.tooltipTarget
        if not isvalid(target) then return end
        if not target.EnabledInHierarchy then self:HideMapTooltip(); return end
        local dotEntry = self._T.regionPointByEntity and self._T.regionPointByEntity[target.Id]
        if dotEntry == nil and _UICursorManager:Hit(target, cursor) then
            self._T.tooltipOutsideTime = 0
        else
            self._T.tooltipOutsideTime = (self._T.tooltipOutsideTime or 0) + delta
            if self._T.tooltipOutsideTime >= 0.15 then self:HideMapTooltip(); return end
        end
        self:PositionMapTooltip()
    end

