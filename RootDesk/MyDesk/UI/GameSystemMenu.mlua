@Logic
script GameSystemMenu extends Logic
    property boolean lowSpecMode = false
    property boolean hideOtherWorldCostumes = false
    property boolean skillNoticeCollapsed = false
    property boolean goalNoticeCollapsed = false
    property boolean tutorialNoticeCollapsed = false
    property boolean opened = false
    property integer selected = 1
    property string page = "menu"
    property number chatSize = 20
    property integer chatColor = 1
    property string chatColorMode = "map"
    property table chatColors = {map=1,friend=6,party=7,whisper=4}
    property number chatOpacity = 45

    @ExecSpace("ClientOnly")
    method Entity UI(string path)
        return _EntityService:GetEntityByPath("/ui/GameSystem/" .. path)
    end

    @ExecSpace("ClientOnly")
    method boolean BlocksInput()
        return _UIPopup:BlocksInput() or _WorldMapManager:IsSearchTyping() or _AuctionHouse:BlocksInput() or _KeySettingManager:BlocksCloseConfirmation() or _OfflineRestRewards:BlocksInput() or _LoginFlow._T.fullScreenFade~=nil or _MapleIslandTutorial:IsTyping() or _CosmeticExchange:BlocksInput() or _SocialManager:BlocksInput() or _AppearanceColorPicker:BlocksInput() or (_RewardCenter:BlocksInput() or _EventRewards:BlocksInput() or _BossStageManager:BlocksInput()) or self.opened or self._T.busy == true or _UtilLogic.ElapsedSeconds < (self._T.inputUntil or 0)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.links = {}
        self._T.settingsSection="display"
        for _,section in ipairs({"display","sound","controls"}) do
            local selected=section
            self:Bind("Overlay/Settings/Section_"..section,function() self:SelectSettingsSection(selected) end)
        end
        for i, name in ipairs({"Paper", "Header", "PreviewFrame"}) do
            local e = self:UI("Overlay/ChatSettings/" .. name)
            _UILogic:SetSiblingIndex(e.UITransformComponent, i)
        end
        self._T.key = _InputService:ConnectEvent(KeyDownEvent, self.OnKey)
        for i = 1, 5 do
            local index = i
            self:Bind("Overlay/Menu/Choice" .. tostring(i), function() self.selected = index self:Activate() end)
        end
        for i = 1, 10 do
            local channel = i
            self:Bind("Overlay/Channels/Channel" .. tostring(i), function()
                if self._T.busy then return end
                self._T.channelSelected = channel
                self:DrawChannels()
            end)
        end
        self:Bind("Overlay/Channels/Confirm", function() self:ChangeChannel() end)
        self:Bind("Overlay/Channels/Back", function() if not self._T.busy then self:ShowPage("menu") end end)
        self:Bind("Overlay/Menu/Close", function() if not self._T.busy then self:Close() end end)
        self:Bind("Overlay/ChatSettings/Close", function() self:Close() end)
        self:Bind("Overlay/Settings/LowSpec",function() self.lowSpecMode=not self.lowSpecMode self:DrawSettings() self:SavePreferences() if Environment:IsMakerPlay() then log("[Performance] lowSpec="..tostring(self.lowSpecMode)) end end)
        self:Bind("Overlay/Settings/Mute", function() self:ToggleMute() end)
        self:Bind("Overlay/Settings/HideWorldCostumes", function()
            self.hideOtherWorldCostumes = not self.hideOtherWorldCostumes
            _AvatarTicketManager:RefreshViewers()
            self:DrawSettings()
            self:SavePreferences()
        end)
        self:Bind("Overlay/Settings/UIModePC", function() _MobileUIManager:SelectMode("pc") self:DrawSettings() end)
        self:Bind("Overlay/Settings/UIModeMobile", function() _MobileUIManager:SelectMode("mobile") self:DrawSettings() end)
        self:Bind("Overlay/Settings/MobileLayout",function() _MobileUIManager:OpenLayoutEditor() end)
        self:Bind("Overlay/Settings/Back", function() if _MobileUIManager:IsMobile() then self:Close() else self:ShowPage("menu") end end)
        self:Bind("Overlay/ChatSettings/Back", function() self:Close() end)
        for _, name in ipairs({"Bgm", "Sfx"}) do
            local key = name
            local e = self:UI("Overlay/Settings/" .. name)
            local link = e:ConnectEvent(SliderValueChangedEvent, function(event)
                if self._T.drawing then return end
                local bgm = key == "Bgm" and event.Value / 100 or _GameAudio.bgmVolume
                local sfx = key == "Sfx" and event.Value / 100 or _GameAudio.sfxVolume
                _GameAudio:SetVolumes(bgm, sfx)
                self:DrawSettings()
                self:SavePreferences()
            end)
            table.insert(self._T.links, {entity=e, listener=link, eventType=SliderValueChangedEvent})
        end
        for _, name in ipairs({"Size", "Opacity"}) do
            local key = name
            local e = self:UI("Overlay/ChatSettings/" .. name)
            local link = e:ConnectEvent(SliderValueChangedEvent, function(event)
                if self._T.drawing then return end
                if key == "Size" then self.chatSize = event.Value else self.chatOpacity = event.Value end
                self:ApplyChat()
                self:DrawSettings()
                self:SavePreferences()
            end)
            table.insert(self._T.links, {entity=e, listener=link, eventType=SliderValueChangedEvent})
        end
        for i = 1, 8 do
            local index = i
            self:Bind("Overlay/ChatSettings/Color" .. tostring(i), function()
                self.chatColor = index self.chatColors[self.chatColorMode] = index self:ApplyChat() self:DrawSettings() self:SavePreferences()
            end)
        end
        for _, mode in ipairs({"map","friend","party","whisper"}) do
            local selected = mode
            self:Bind("Overlay/ChatSettings/Mode_" .. mode,function()
                self.chatColorMode=selected self.chatColor=self.chatColors[selected] or 1 self:DrawSettings()
            end)
        end
        local chatButton = _EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/ChatBox/BtnSettings")
        if isvalid(chatButton) then
            local listener = chatButton:ConnectEvent(ButtonClickEvent, function() self:Open("chat") end)
            table.insert(self._T.links, {entity=chatButton, listener=listener})
        end
        if Environment:IsMakerPlay() then log("[GameMenu] ready") end
    end

    @ExecSpace("ClientOnly")
    method void Bind(string path, any callback)
        local e = self:UI(path)
        if not isvalid(e) then return end
        local listener = e:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self._T.links, {entity=e, listener=listener})
    end

    @ExecSpace("ClientOnly")
    method void Open(string page)
        if _LoginFlow.phase ~= "ingame" or self._T.busy then return end
        _MobileUIManager:ReleaseControls()
        self.opened = true
        self.selected = 1
        local p = _UserService.LocalPlayer
        if isvalid(p) then
            self._T.controllerEnabled = p.PlayerControllerComponent.Enable
            p.PlayerControllerComponent.Enable = false
            p.MovementComponent:Stop()
        end
        self:UI("Overlay").Enable = true
        self:ShowPage(page)
        if Environment:IsMakerPlay() then log("[GameMenu] open=" .. page) end
    end

    @ExecSpace("ClientOnly")
    method void ShowPage(string page)
        self.page = page
        local mobile=_MobileUIManager:IsMobile()
        self:UI("Overlay/Menu").Enable = page == "menu"
        self:UI("Overlay/Menu").UITransformComponent.anchoredPosition=Vector2.zero
        self:UI("Overlay/Settings").UITransformComponent.anchoredPosition=Vector2.zero
        self:UI("Overlay/Settings").Enable = page == "settings"
        self:UI("Overlay/ChatSettings").Enable = page == "chat"
        self:UI("Overlay/Channels").Enable = page == "channels"
        if page == "channels" then
            self._T.channelSelected = _LoginFlow.selectedChannel
            self._T.channelCurrent = _LoginFlow.selectedChannel
            self._T.channelCounts = nil
            self:DrawChannels()
            _ChannelManager:RequestInGameList()
        end
        self:DrawSelection()
        self:DrawSettings()
    end

    @ExecSpace("ClientOnly")
    method void Close()
        self.opened = false
        self:UI("Overlay").Enable = false
        self._T.inputUntil = _UtilLogic.ElapsedSeconds + 0.15
        local p = _UserService.LocalPlayer
        if isvalid(p) and self._T.controllerEnabled ~= nil and _LoginFlow.phase == "ingame" then
            p.PlayerControllerComponent.Enable = self._T.controllerEnabled
        end
        self._T.controllerEnabled = nil
        if Environment:IsMakerPlay() then log("[GameMenu] close") end
    end

    @ExecSpace("ClientOnly")
    method void OnKey(KeyDownEvent event)
        if _UIPopup:BlocksInput() then return end
        if _AuctionHouse:BlocksInput() or _OfflineRestRewards:BlocksInput() then return end
        if _MobileNumberPad:BlocksInput() then return end
        if _CosmeticExchange:BlocksInput() or _AppearanceColorPicker:BlocksInput() or (_RewardCenter:BlocksInput() or _EventRewards:BlocksInput() or _BossStageManager:BlocksInput()) then return end
        if _LoginFlow.phase ~= "ingame" or self._T.busy then return end
        local key = event.key
        local menuKey=_KeySettingManager:GetFuncForKeyEnum(key)=="menu"
        if not self.opened and key==KeyboardKey.Escape and _MobileUIManager:IsMobile() and (_MobileUIManager._T.layoutEditing or _MobileUIManager:UI("SkillBook").Enable or _MobileUIManager:UI("QuickslotPicker").Enable) then _MobileUIManager:CloseWindow() self._T.inputUntil=_UtilLogic.ElapsedSeconds+0.2 return end
        if _KeySettingManager:GetFuncForKeyEnum(key) == "mute" and not _KeySettingManager:IsWindowOpen() and not _SocialManager:BlocksInput() and not _UIItemDiscardManager:BlocksInput() then
            local uiRoot = _EntityService:GetEntityByPath("/ui")
            if isvalid(uiRoot) then
                for _, input in ipairs(uiRoot:GetChildComponentsByTypeName("MOD.Core.TextGUIRendererInputComponent", true)) do
                    if input.IsFocused then return end
                end
            end
            self:ToggleMute()
            return
        end
        if not self.opened and (_SocialManager:IsOpen() or _UtilLogic.ElapsedSeconds < (self._T.inputUntil or 0)) then return end
        if not self.opened then
            if not menuKey then return end
            if _MapleHUDManager:IsChatTyping() or _UIItemDiscardManager:BlocksInput() then return end
            if _KeySettingManager._T.dialogOpen or (_KeySettingManager._T.remapPos or "") ~= "" then return end
            local map = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
            if isvalid(map) and map.Enable then return end
            if self._T.hadOtherWindow or self:HasOtherWindow() then return end
            self:Open("menu")
            return
        end
        if key == KeyboardKey.Escape or menuKey then
            if self.page == "settings" or self.page == "channels" then self:ShowPage("menu") else self:Close() end
            return
        end
        if self.page == "channels" then
            local n = self._T.channelSelected or 1
            if key == KeyboardKey.LeftArrow then n = (n + 8) % 10 + 1
            elseif key == KeyboardKey.RightArrow then n = n % 10 + 1
            elseif key == KeyboardKey.UpArrow or key == KeyboardKey.DownArrow then n = (n + 4) % 10 + 1
            elseif key == KeyboardKey.Return or key == KeyboardKey.KeypadEnter then self:ChangeChannel() return
            else return end
            self._T.channelSelected = n self:DrawChannels() return
        end
        if self.page ~= "menu" then return end
        if key == KeyboardKey.UpArrow then self.selected = (self.selected + 3) % 5 + 1 self:DrawSelection()
        elseif key == KeyboardKey.DownArrow then self.selected = self.selected % 5 + 1 self:DrawSelection()
        elseif key == KeyboardKey.Return or key == KeyboardKey.KeypadEnter then self:Activate() end
    end

    @ExecSpace("ClientOnly")
    method boolean HasOtherWindow()
        if _CarnivalUI.opened then return true end
        local rest=_EntityService:GetEntityByPath("/ui/OfflineRestGroup/Modal")
        if isvalid(rest) and rest.EnabledInHierarchy then return true end
        if _MobileUIManager:UI("WorldMap").Enable then return true end
        -- Include dialogs outside the inventory window stack.
        if _SocialManager:IsOpen() then return true end
        if _UIClickArbiter:GetKeyboardWindow() ~= "" or _InformationBook:IsOpen() then return true end
        if _MapleHUDManager:IsChatTyping() or _UIItemDiscardManager:BlocksInput() then return true end
        for _, path in ipairs({"/ui/WorldMapGroup", "/ui/PopupGroup/PopupBack", "/ui/DefaultGroup/QuickSlotDialog"}) do
            local w = _EntityService:GetEntityByPath(path)
            if isvalid(w) and w.EnabledInHierarchy then return true end
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Keep the pre-Esc state even if another key listener closes its window first.
        self._T.hadOtherWindow = self:HasOtherWindow()
    end

    @ExecSpace("ClientOnly")
    method void DrawSelection()
        for i = 1, 5 do
            local b = self:UI("Overlay/Menu/Choice" .. tostring(i))
            _UITheme:Button(b, i == self.selected and Color(.24,.26,.28,1) or Color(.13,.14,.15,1))
            b.TextGUIRendererComponent.Text = ({"채널 이동", "캐릭터 변경", "휴식 보상", "게임 설정", "게임 끝내기"})[i]
            self:UI("Overlay/Menu/Choice" .. tostring(i) .. "/SelectionArrow").Enable = i == self.selected
        end
    end

    @ExecSpace("ClientOnly")
    method void Activate()
        if self.selected == 1 then self:ShowPage("channels") return end
        if self.selected == 3 then self:Close() _OfflineRestRewards:Open() return end
        if self.selected == 4 then self:ShowPage("settings") return end
        local mode = self.selected == 1 and "channel" or (self.selected == 2 and "character" or "quit")
        if _AutoHuntManager.autoOn then _AutoHuntManager:Toggle() end
        self._T.busy = true
        self:UI("Overlay/Menu/Hint").TextGUIRendererComponent.Text = "캐릭터를 저장하고 있습니다..."
        local snapshot = ""
        if _CharacterPersistence._T.cl.entered then snapshot = _CharacterPersistence:BuildSaveString() end
        if mode~="quit" then _LoginFlow:BeginSelectionReturn() end
        _CharacterPersistence:RequestSessionExit(mode, snapshot)
        if Environment:IsMakerPlay() then log("[GameMenu] request=" .. mode) end
    end

    @ExecSpace("Client")
    method void ExitResult(boolean ok, string mode, string reason)
        _LoginFlow:CompleteSelectionReturn(ok)
        self._T.busy = false
        self:UI("Overlay/Menu/Hint").TextGUIRendererComponent.Text = "↑ ↓ 선택   Enter 실행   Esc 게임 재개"
        if not ok then _UIToast:ShowMessage(reason) return end
        self:Close()
        _CharacterPersistence._T.cl.entered = false
        _CharacterPersistence._T.cl.dirty = false
        _CharacterPersistence._T.cl.lastSentStr = ""
        if mode == "quit" then return end
        _LoginFlow.busy = false
        _LoginFlow._T.entryApproved = false
        _LoginFlow._T.entryFadeElapsed = nil
        _LoginFlow._T.entryTransition = false
        _LoginFlow._T.entryFadeReady = false
        _LoginFlow._T.entryArrivalElapsed = 0
        _LoginFlow._T.restored = false
        local root = _EntityService:GetEntityByPath("/ui/LoginScene")
        root.Enable = true
        _LoginFlow:EnableUI("EntryFade", false)
        if mode == "channel" then
            _LoginFlow:ShowPhase("channel", false)
            _LoginFlow:RequestChannels()
        else
            _LoginFlow:ShowCharacters()
        end
    end


    @ExecSpace("Client")
    method void ReceiveChannels(integer current, table counts)
        -- Ignore late list responses after closing the picker.
        if not self.opened or self.page ~= "channels" then return end
        self._T.channelCurrent = current
        self._T.channelCounts = counts
        self:DrawChannels()
    end

    @ExecSpace("ClientOnly")
    method void DrawChannels()
        -- Keep current, selected and full channels visibly distinct.
        local current = self._T.channelCurrent or _LoginFlow.selectedChannel
        local selected = self._T.channelSelected or current
        self:UI("Overlay/Channels/Current").TextGUIRendererComponent.Text = "현재 채널  CH." .. tostring(current)
        for i = 1, 10 do
            local b = self:UI("Overlay/Channels/Channel" .. tostring(i))
            local count = self._T.channelCounts and (self._T.channelCounts[i] or 0) or nil
            local status = i == current and "접속 중" or (count == nil and "확인 중" or (count >= 5 and "혼잡" or "이동 가능"))
            b.TextGUIRendererComponent.Text = "CH." .. tostring(i) .. "\n" .. status
            b.SpriteGUIRendererComponent.Color = i == selected and Color(0.12,0.12,0.12,1) or (i == current and Color(0.8,0.8,0.8,1) or Color.white)
            b.TextGUIRendererComponent.FontColor = i == selected and Color.white or Color(0.12,0.12,0.12,1)
        end
        local canMove = self._T.channelCounts ~= nil and selected ~= current and (self._T.channelCounts[selected] or 0) < 5 and not self._T.busy
        self:UI("Overlay/Channels/Confirm").ButtonComponent.Enable = canMove
        self:UI("Overlay/Channels/Hint").TextGUIRendererComponent.Text = self._T.busy and "채널로 이동하고 있습니다..." or "방향키로 선택 · Enter 이동 · Esc 뒤로"
    end

    @ExecSpace("ClientOnly")
    method void ChangeChannel()
        -- A single in-game request preserves the loaded character and map position.
        if self._T.busy or self.page ~= "channels" or self._T.channelCounts == nil then return end
        local selected = self._T.channelSelected or 1
        if selected == self._T.channelCurrent then return end
        if (self._T.channelCounts[selected] or 0) >= 5 then _UIToast:ShowMessage("해당 채널이 가득 찼습니다.") return end
        if _AutoHuntManager.autoOn then _AutoHuntManager:Toggle() end
        self._T.busy = true
        self:DrawChannels()
        _ChannelManager:RequestSwitch(selected)
    end

    @ExecSpace("Client")
    method void ChannelResult(boolean ok, integer channel, string reason)
        -- Server confirms the destination map before input is restored.
        self._T.busy = false
        if not ok then
            _UIToast:ShowMessage(reason)
            if self.opened and self.page == "channels" then
                self:DrawChannels()
                _ChannelManager:RequestInGameList()
            end
            return
        end
        _LoginFlow.selectedChannel = channel
        self:Close()
        _GameAudio:PlayCue("Portal")
        _UIToast:ShowMessage("CH." .. tostring(channel) .. "로 이동했습니다.")
        if Environment:IsMakerPlay() then log("[GameMenu] channel changed=" .. tostring(channel)) end
    end

    @ExecSpace("ClientOnly")
    method Color GetChatColor()
        local colors = {Color(1,1,1,1),Color(1,0.88,0.48,1),Color(0.6,0.9,1,1),Color(0.35,1,0.45,1),Color(1,0.72,0.87,1),Color(1,0.62,0.22,1),Color(0.76,0.5,1,1),Color(1,0.35,0.35,1)}
        return colors[self.chatColors[self.chatColorMode] or 1] or Color.white
    end

    @ExecSpace("ClientOnly")
    method string GetChatHex(string mode)
        local colors={"#FFFFFF","#FFE07A","#99E6FF","#59FF73","#FFB8DE","#FF9E38","#C280FF","#FF5959"}
        return colors[self.chatColors[mode] or 1] or "#FFFFFF"
    end

    @ExecSpace("ClientOnly")
    method void ApplyChat()
        _MapleHUDManager:RenderSimpleChatMessages()
    end

    @ExecSpace("ClientOnly")
    method void SelectSettingsSection(string section)
        self._T.settingsSection=section
        local sections={display={"Resolution","ResolutionHelp","HideWorldCostumes","LowSpec","LowSpecHint"},sound={"Bgm","BgmLabel","BgmValue","Sfx","SfxLabel","SfxValue","Mute"},controls={"UIModeTitle","UIModePC","UIModeMobile","UIModeStatus","MobileLayout"}}
        for name,children in pairs(sections) do
            for _,child in ipairs(children) do self:UI("Overlay/Settings/"..child).Enable=name==section end
            local button=self:UI("Overlay/Settings/Section_"..name)
            _UITheme:Button(button,name==section and Color(.24,.40,.52,1) or Color(.13,.14,.15,1))
            button.TextGUIRendererComponent.FontColor=Color.white
        end
    end

    @ExecSpace("ClientOnly")
    method void DrawSettings()
        self:SelectSettingsSection(self._T.settingsSection or "display")
        self:UI("Overlay/Settings/LowSpec").TextGUIRendererComponent.Text=self.lowSpecMode and "저사양 모드  켜짐" or "저사양 모드  꺼짐"
        _MobileUIManager:DrawSettings()
        local costumeCheck = self:UI("Overlay/Settings/HideWorldCostumes/Check")
        if isvalid(costumeCheck) then costumeCheck.Enable = not self.hideOtherWorldCostumes end
        local check = self:UI("Overlay/Settings/Mute/Check")
        if isvalid(check) then check.Enable = _GameAudio.muted end
        local muteLabel = self:UI("Overlay/Settings/Mute/Label")
        if isvalid(muteLabel) then
            local binding = _KeySettingManager:GetKeyForFunc("mute")
            muteLabel.TextGUIRendererComponent.Text = "전체 음소거" .. (binding ~= "" and ("  (" .. binding .. ")") or "")
        end
        self._T.drawing = true
        self:UI("Overlay/Settings/Resolution").TextGUIRendererComponent.Text = "현재 해상도  " .. tostring(_UILogic.ScreenWidth) .. " × " .. tostring(_UILogic.ScreenHeight)
        for _, name in ipairs({"Bgm", "Sfx"}) do
            local value = math.floor((name == "Bgm" and _GameAudio.bgmVolume or _GameAudio.sfxVolume) * 100 + 0.5)
            self:UI("Overlay/Settings/" .. name).SliderComponent.Value = value
            self:UI("Overlay/Settings/" .. name .. "Value").TextGUIRendererComponent.Text = tostring(value) .. "%"
        end
        self:UI("Overlay/ChatSettings/Size").SliderComponent.Value = self.chatSize
        self:UI("Overlay/ChatSettings/SizeValue").TextGUIRendererComponent.Text = tostring(math.floor(self.chatSize))
        self:UI("Overlay/ChatSettings/Opacity").SliderComponent.Value = self.chatOpacity
        self:UI("Overlay/ChatSettings/OpacityValue").TextGUIRendererComponent.Text = tostring(math.floor(self.chatOpacity)) .. "%"
        for i = 1, 5 do
            self:UI("Overlay/ChatSettings/Color" .. tostring(i) .. "/Selected").Enable = i == (self.chatColors[self.chatColorMode] or 1)
        end
        for _, mode in ipairs({"map","friend","party","whisper"}) do
            _UITheme:Button(self:UI("Overlay/ChatSettings/Mode_" .. mode), mode == self.chatColorMode and Color(.24,.26,.28,1) or Color(.13,.14,.15,1))
        end
        local preview = self:UI("Overlay/ChatSettings/Preview")
        preview.TextGUIRendererComponent.FontSize = self.chatSize
        preview.TextGUIRendererComponent.FontColor = self:GetChatColor()
        preview.SpriteGUIRendererComponent.Color = Color(0,0,0,self.chatOpacity / 100)
        self._T.drawing = false
    end

    @ExecSpace("ClientOnly")
    method void ToggleMute()
        _GameAudio:SetMuted(not _GameAudio.muted)
        self:DrawSettings()
        self:SavePreferences()
    end

    @ExecSpace("ClientOnly")
    method void SavePreferences()
        _CharacterPersistence:MarkDirty("preferences")
        _CharacterPersistence:FlushToServer()
    end

    @ExecSpace("ClientOnly")
    method string ExportPreferences()
        return "NOTICEFOLD\t"..(self.skillNoticeCollapsed and "1" or "0").."\t"..(self.goalNoticeCollapsed and "1" or "0").."\t"..(self.tutorialNoticeCollapsed and "1" or "0").."\nLOWSPEC\t"..(self.lowSpecMode and "1" or "0").."\nWORLDCOSTUME\t" .. (self.hideOtherWorldCostumes and "1" or "0") .. "\nPREF\t" .. tostring(self.chatSize) .. "\t" .. tostring(self.chatColor) .. "\t" .. tostring(self.chatOpacity) .. "\t" .. tostring(_GameAudio.bgmVolume) .. "\t" .. tostring(_GameAudio.sfxVolume) .. "\nMUTE\t" .. (_GameAudio.muted and "1" or "0") .. "\nCHATCOLOR\t" .. tostring(self.chatColors.map) .. "\t" .. tostring(self.chatColors.friend) .. "\t" .. tostring(self.chatColors.party) .. "\t" .. tostring(self.chatColors.whisper)
    end

    @ExecSpace("ClientOnly")
    method void RestorePreferences(string raw)
        local sp,goal=string.match("\n"..raw,"\nNOTICEFOLD\t([01])\t([01])")
        self.skillNoticeCollapsed=sp=="1" self.goalNoticeCollapsed=goal=="1"
        self.tutorialNoticeCollapsed=string.match("\n"..raw,"\nNOTICEFOLD\t[01]\t[01]\t([01])")=="1"
        self.lowSpecMode=string.match("\n"..raw,"\nLOWSPEC\t([01])")=="1"
        self.hideOtherWorldCostumes = string.match("\n" .. raw, "\nWORLDCOSTUME\t([01])") == "1"
        _AvatarTicketManager:RefreshViewers()
        local size, color, opacity, bgm, sfx = string.match("\n" .. raw, "\nPREF\t([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\n]+)")
        self.chatSize = math.max(14, math.min(32, tonumber(size) or 20))
        self.chatColor = math.max(1, math.min(5, math.floor(tonumber(color) or 1)))
        self.chatOpacity = math.max(0, math.min(100, tonumber(opacity) or 45))
        _GameAudio:SetVolumes(tonumber(bgm) or 0.20, tonumber(sfx) or 0.40)
        _GameAudio:SetMuted(string.match("\n" .. raw, "\nMUTE\t([01])") == "1")
        local map,friend,party,whisper = string.match("\n" .. raw,"\nCHATCOLOR\t(%d+)\t(%d+)\t(%d+)\t(%d+)")
        local function valid(value, fallback) return math.max(1,math.min(8,tonumber(value) or fallback)) end
        self.chatColors={map=valid(map,self.chatColor),friend=valid(friend,6),party=valid(party,7),whisper=valid(whisper,4)}
        self.chatColorMode="map"
        self:ApplyChat()
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self._T.key then _InputService:DisconnectEvent(KeyDownEvent, self._T.key) end
        for _, link in ipairs(self._T.links or {}) do
            if isvalid(link.entity) then link.entity:DisconnectEvent(link.eventType or ButtonClickEvent, link.listener) end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean AllowHitVisual()
        if _AutoHuntPowerSave.active then return false end
        -- Limit only cosmetic hit effects; callers have already resolved damage and targets.
        if not self.lowSpecMode then return true end
        local now=_UtilLogic.ElapsedSeconds
        if now>=(self._T.hitVisualWindow or 0) then self._T.hitVisualWindow=now+0.1 self._T.hitVisualCount=0 end
        if (self._T.hitVisualCount or 0)>=6 then return false end
        self._T.hitVisualCount=(self._T.hitVisualCount or 0)+1
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean BlocksGameplayInput()
        return _WorldMapManager:IsSearchTyping() or _AuctionHouse:BlocksInput() or _KeySettingManager:BlocksCloseConfirmation() or _OfflineRestRewards:BlocksInput() or _LoginFlow._T.fullScreenFade~=nil or _MapleIslandTutorial:IsTyping() or _CosmeticExchange:BlocksInput() or _SocialManager:BlocksInput() or _AppearanceColorPicker:BlocksInput() or (_RewardCenter:BlocksInput() or (_EventRewards.opened or _UtilLogic.ElapsedSeconds<(_EventRewards._T.closedUntil or 0)) or _BossStageManager:BlocksInput()) or self.opened or self._T.busy == true or _UtilLogic.ElapsedSeconds < (self._T.inputUntil or 0)
    end
end
