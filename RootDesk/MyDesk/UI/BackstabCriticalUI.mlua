@Logic
@ExecSpace("ClientOnly")
script BackstabCriticalUI extends Logic

	-- (요청) 백스탭 + 다크사이트 딜이 동시에 들어간 순간 화면 왼쪽에 "CRITICAL" 배너를 한 번 띄운다.
	-- 위치는 화면 왼쪽 끝에서 40px, 높이는 화면 높이의 65%(아래에서 위로) - UI 캔버스 1920x1080의
	-- 중심 기준으로 y = 0.65 * 1080 - 540 = +162.
	-- 흔들림(PlayerAttack.PlayBackstabDarkSightShake)과 같은 지점에서 함께 호출된다.
	--
	-- (기능 수정) "화면 흔들림 때문에 확인이 어렵다" 피드백 - 재생 시점과 순서를 바꿨다.
	--   · 흔들림이 **끝난 뒤에** 시작한다(PlaySequence의 startDelay).
	--   · 1~4프레임을 재생해 글자가 나타나고, 그 상태로 1초 더 머문다.
	--   · 그 뒤 5~7프레임을 재생하며 사라진다.
	-- 원본 애니메이션클립(111ccc76...)을 ImageRUID에 통째로 넣으면 재생 구간을 이렇게 끊어 쓸 수 없고
	-- 루프가 돌아버리므로, 클립의 프레임 스프라이트 7장을 순서대로 갈아끼워 직접 재생한다
	-- (이 프로젝트의 다른 프레임 교체 재생과 같은 방식). 7장 모두 높이 16px이고 렌더 박스가
	-- (PreserveSprite=AspectOnly) 158.4x28.8이라 폭이 다른 프레임도 전부 같은 배율(1.8배)로 그려진다.
	-- (크기는 처음 264x48 = 3배였고, "60%로 줄여달라"는 요청으로 1.8배가 되었다 - ui/BackstabCriticalGroup.ui)

	property SpriteGUIRendererComponent markSprite = "493599b7-0281-49f1-8ff7-838b15ded485"

	method void OnBeginPlay()
		-- 시작할 때는 감춰둔다. .ui에도 enable=false로 저장하지만, 다른 경로로 켜진 채 남아 있을
		-- 가능성을 없애기 위해 여기서 한 번 더 확실히 끈다.
		if not self:IsClient() then return end
		local ent = self:GetMarkEntity()
		if not isvalid(ent) then
			log_warning("[BackstabCriticalUI] 배너 엔티티를 찾지 못했다 - .ui 바인딩 확인 필요")
			return
		end
		ent.Enable = false
		self._T.showToken = 0
	end

	method Entity GetMarkEntity()
		if not isvalid(self.markSprite) then return nil end
		return self.markSprite.Entity
	end

	method table GetMarkFrames()
		-- 애니메이션클립 111ccc76614e43fdab33ae1e5080f6a1의 프레임 스프라이트 7장(재생 순서).
		-- 1~4 = 글자가 나타나는 구간, 5~7 = 사라지는 구간.
		return {
			"f9f272776c8d4314b8beec38a847f4a9",   -- 1 (88x16)
			"f17b9e9d7f4d463a9e3a2aa46fb4d82a",   -- 2 (84x16)
			"29a6fc5bda984cc68ad4e16d154b9840",   -- 3 (68x16)
			"a6c54bf45df04a269fd34cab28e2cc49",   -- 4 (68x16)
			"30dcb2887589490d8653b0fe0db243ca",   -- 5 (68x16)
			"9076b474eae349d29f903a3f2b875975",   -- 6 (88x16)
			"4d4598b1092c466690f6c516a49407ed",   -- 7 (88x16)
		}
	end

	method void ApplyMarkFrame(integer frameNo)
		-- frameNo 1~7 = 그 프레임을 띄운다. 0 = 숨긴다.
		local ent = self:GetMarkEntity()
		if not isvalid(ent) then return end
		if frameNo <= 0 then
			ent.Enable = false
			return
		end
		local frames = self:GetMarkFrames()
		local ruid = frames[frameNo]
		if ruid == nil then return end
		self.markSprite.ImageRUID = DataRef(ruid)
		ent.Enable = true
	end

	method void PlaySequence(number startDelay)
		-- startDelay초 뒤부터 1~4프레임 재생 → 1초 유지 → 5~7프레임 재생 → 사라짐.
		-- 표시 중에 다시 호출되면 토큰이 갱신되어 이전 예약은 모두 무효화되고 처음부터 다시 시작한다.
		if not self:IsClient() then return end
		local ent = self:GetMarkEntity()
		if not isvalid(ent) then return end

		local FRAME_SEC = 0.15   -- 원본 클립의 프레임 간격(실측 150ms)
		local HOLD_SEC = 1.0     -- 글자가 완성된 4프레임에서 더 머무는 시간

		self._T.showToken = (self._T.showToken or 0) + 1
		local tok = self._T.showToken
		-- 흔들림이 끝나기 전에는 아무것도 보이지 않게 확실히 꺼둔다.
		ent.Enable = false

		-- {지연, 프레임번호} 스케줄. 4프레임 뒤에 HOLD_SEC를 끼워 넣어 "1초 뒤 나머지 재생"을 만든다.
		local plan = {
			{ t = startDelay + 0.0 * FRAME_SEC, f = 1 },
			{ t = startDelay + 1.0 * FRAME_SEC, f = 2 },
			{ t = startDelay + 2.0 * FRAME_SEC, f = 3 },
			{ t = startDelay + 3.0 * FRAME_SEC, f = 4 },
			{ t = startDelay + 4.0 * FRAME_SEC + HOLD_SEC, f = 5 },
			{ t = startDelay + 5.0 * FRAME_SEC + HOLD_SEC, f = 6 },
			{ t = startDelay + 6.0 * FRAME_SEC + HOLD_SEC, f = 7 },
			{ t = startDelay + 7.0 * FRAME_SEC + HOLD_SEC, f = 0 },
		}
		for _, entry in ipairs(plan) do
			local step = entry
			_TimerService:SetTimerOnce(function()
				if self._T.showToken ~= tok then return end
				self:ApplyMarkFrame(step.f)
			end, step.t)
		end
		log("[BackstabCriticalUI] CRITICAL 배너 재생 예약 - 시작 " .. tostring(startDelay)
			.. "초 후 1~4프레임, " .. tostring(HOLD_SEC) .. "초 유지 후 5~7프레임")
	end

end
