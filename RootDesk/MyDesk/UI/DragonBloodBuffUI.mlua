@Logic
@ExecSpace("ClientOnly")
script DragonBloodBuffUI extends Logic

	-- 드래곤 블러드(4차 버프) 버프바 아이콘. SixDragonsBuffUI 복제 - UUID는 UIBuilder가 write bind로 주입한다.
	-- 지속 10분이지만 HP가 최대 HP의 10% 이하가 되면 서버가 조기 해제하므로(PlayerAttack.EndDragonBlood
	-- → NotifyDragonBloodEnded), 남은 시간이 남아 있어도 HideBuff로 즉시 내려갈 수 있다.
	property Entity buffIconGroup = "5a2cff15-277c-4a40-91f4-a67ee0fcde06"
	property SpriteGUIRendererComponent grayOverlay = "f567dd8d-e97c-43fa-a010-fe508c5ed775"
	property TextComponent countdownText = "286f6732-03a0-41fd-b64a-767b714f3097"

	method void ShowBuff(number duration)
		-- 드래곤 블러드 지속시간(10분) 표시/갱신.
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.dbTotalDuration = duration
		self._T.dbRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.dbTimerId then
			_TimerService:ClearTimer(self._T.dbTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.dbTimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.dbRemaining = self._T.dbRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
	end

	method void UpdateBuffDisplay()
		-- 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃 갱신.
		local remaining = self._T.dbRemaining
		local total = self._T.dbTotalDuration

		if remaining <= 0 then
			if self._T.dbTimerId then
				_TimerService:ClearTimer(self._T.dbTimerId)
				self._T.dbTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(1, 1, 1, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(1, 1, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	method void HideBuff()
		-- 서버가 조기 해제(HP 10% 이하 / 사망 / 우클릭 취소)했을 때 즉시 내린다.
		if not self:IsClient() then return end
		if self._T.dbRemaining == nil then return end
		self._T.dbRemaining = 0
		self:UpdateBuffDisplay()
	end

	method void OnEndPlay()
		if self._T.dbTimerId then
			_TimerService:ClearTimer(self._T.dbTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	method number GetRemaining()
		return self._T.dbRemaining or 0
	end

end
