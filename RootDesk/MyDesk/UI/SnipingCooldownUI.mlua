@Logic
script SnipingCooldownUI extends Logic

	-- 스나이핑(4차) 발사 후 10초 쿨타임. 블리자드와 같은 퀵슬롯 오버레이 표현을 사용한다.
	property SpriteGUIRendererComponent grayOverlay = "f183feb8-ae8d-4c75-97db-a1b225f96baf"
	property TextGUIRendererComponent countdownText = "0a956d2c-362b-417b-9c86-020498257ed2"

	@ExecSpace("ClientOnly")
	method void ShowCooldown(number duration, string slotKey)
		-- 스나이핑이 배치된 퀵슬롯 위에서 오버레이와 남은 초 숫자를 시작한다.
		if not self:IsClient() or duration <= 0 or slotKey == "" then return end
		self._T.totalDuration = duration
		self._T.remaining = duration
		self._T.slotKey = slotKey
		if isvalid(self.grayOverlay) then
			self.grayOverlay.Type = ImageType.Filled
			self.grayOverlay.FillMethod = FillMethodType.Vertical
		end
		local slot = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar/Slot_" .. tostring(slotKey))
		if isvalid(slot) then
			local pos = slot.UITransformComponent.anchoredPosition
			if isvalid(self.grayOverlay) then self.grayOverlay.Entity.UITransformComponent.anchoredPosition = Vector2(pos.x, pos.y + 4) end
			if isvalid(self.countdownText) then self.countdownText.Entity.UITransformComponent.anchoredPosition = Vector2(pos.x, pos.y + 4) end
		end
		if isvalid(self.grayOverlay) then self.grayOverlay.Entity.Enable = true end
		if isvalid(self.countdownText) then self.countdownText.Entity.Enable = true end
		if self._T.timerId then _TimerService:ClearTimer(self._T.timerId) end
		local previous = _UtilLogic.ElapsedSeconds
		self._T.timerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			self._T.remaining = self._T.remaining - (now - previous)
			previous = now
			self:UpdateCooldownDisplay()
		end, 1 / 60)
		self:UpdateCooldownDisplay()
		log("[SnipingCooldownUI] 쿨타임 표시 시작 duration=" .. tostring(duration) .. " slot=" .. tostring(slotKey))
	end

	@ExecSpace("ClientOnly")
	method void UpdateCooldownDisplay()
		-- 남은 초를 올림 정수로 표시하고 시간이 끝나면 슬롯을 다시 활성화한다.
		local remaining = self._T.remaining or 0
		if remaining <= 0 then
			if self._T.timerId then _TimerService:ClearTimer(self._T.timerId); self._T.timerId = nil end
			if isvalid(self.grayOverlay) then self.grayOverlay.Entity.Enable = false end
			if isvalid(self.countdownText) then self.countdownText.Entity.Enable = false end
			_SkillManager:BlinkSlotReady(self._T.slotKey or "")
			return
		end
		if isvalid(self.grayOverlay) then self.grayOverlay.FillAmount = math.max(0, math.min(1, remaining / self._T.totalDuration)) end
		if isvalid(self.countdownText) then
			self.countdownText.FontColor = Color(1, 1, 1, 1)
			self.countdownText.Text = tostring(math.ceil(remaining))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 월드 종료 시 반복 타이머를 정리한다.
		if self._T.timerId then _TimerService:ClearTimer(self._T.timerId) end
	end
end
