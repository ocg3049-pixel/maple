@Logic
script MapleHUDManager extends Logic

    -- 원작 스타일 하단 HUD(HP/MP 바, 메뉴 아이콘, 레벨/이름, 채팅) 관리
    property Entity hudRoot = "c8a4004e-0198-458b-99f9-89104c549867"
    property SpriteGUIRendererComponent hpFill = "9a8ada51-6a71-4a0d-8c13-b5838a6c2942"
    property TextComponent hpText = "ce1cb4ad-ea67-47a8-b476-b79b8af34db2"
    property SpriteGUIRendererComponent mpFill = "d9bd1fb9-e25a-474d-9a29-3be7e1eae1e8"
    property TextComponent mpText = "64519d7e-641b-4fe0-8fff-6bdb2e0ded35"
    property TextGUIRendererComponent levelText = "35fc53d7-e296-4358-825a-c65c915b6ea7"
    property TextGUIRendererComponent nameText = "4cdaa49d-6a30-408b-acd2-6e7cd68df892"
    property ButtonComponent btnEquip = "8c75fac1-af72-4025-b06f-9905fb2316e7"
    property ButtonComponent btnEnhance = "152a8836-ad06-4ed3-b85a-f3544467385b"
    property ButtonComponent btnMap = "e3eeb78b-4375-4e90-9e9f-eb57ad3b6aec"
    property ButtonComponent btnInven = "c0bf9547-1e34-4f32-b20c-488c6b3b365d"
    property ButtonComponent btnSkill = "483fb007-2a85-44c4-b91a-5d88fbbc67b1"
    property ButtonComponent btnCharInfo = "92265a6a-993d-4593-b7f6-3aa31102c493"
    property Entity chatBox = "7133c9ab-4d94-4db3-94cd-fce80acaa63f"

    -- MP는 표시 전용 (실제 MP 시스템 없음)
    property integer displayMaxMp = 50
    property integer updateTimer = 0
    property integer barTimer = 0        -- HP/MP 바 전용(UpdateHUD가 죽어도 살아남는 독립 타이머)

    method void OnBeginPlay()
        -- 클라이언트에서만 HUD 갱신 타이머와 버튼 이벤트를 연결한다
        if not self:IsClient() then return end

        self._T.buttonHandlers = {}
        self._T.dragHandlers = {}
        self:ConnectMenuButton(self.btnEquip, function()
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/EquipWindow")
        end)
        self:ConnectMenuButton(self.btnEnhance, function()
            _EnhancementManager:ToggleWindow()
        end)
        self:ConnectMenuButton(self.btnMap, function()
            _WorldMapManager:OnMKey()
        end)
        self:ConnectMenuButton(self.btnInven, function()
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/InvenWindow")
        end)
        self:ConnectMenuButton(self.btnSkill, function()
            _SkillManager:ToggleWindow()
        end)
        self:ConnectMenuButton(self.btnCharInfo, function()
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/CharInfoWindow")
        end)
        local keys = _EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/BtnKeySetting")
        if isvalid(keys) then
            self:ConnectMenuButton(keys.ButtonComponent, function() _KeySettingManager:ToggleWindow() end)
        end

        local shop = _EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/BtnShop")
        if isvalid(shop) then
            self:ConnectMenuButton(shop.ButtonComponent, function()
                _CosmeticExchange:Open()
            end)
        end

        local codex = _EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/BtnCodex")
        if isvalid(codex) then
            self:ConnectMenuButton(codex.ButtonComponent, function() _MonsterCodex:Toggle() end)
        end
        local autoHunt = _EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/BtnAutoHunt")
        if isvalid(autoHunt) then
            self:ConnectMenuButton(autoHunt.ButtonComponent, function()
                _AutoHuntManager:Toggle()
                self:RefreshAutoHuntButton()
            end)
        end
        self:WireChatWindow()
        self:WireSimpleChatMessages()
        self:SendLevelFadeBehindText()
        self:RefreshChatLayout()

        self.updateTimer = _TimerService:SetTimerRepeat(self.UpdateHUD, 0.25)
        -- (버그 수정 2026-08-15, 신고 "HP UI가 안 움직이는데 MP는 정상") HP/MP 바만 갱신하는 **독립 타이머**.
        -- UpdateHUD 하나가 HP·MP·레벨·이름·HUD 표시여부를 전부 처리하는데, 그 안의 어느 한 줄이라도
        -- 한 번 예외를 내면 반복 타이머가 통째로 죽어 **그 세션 내내 HP 표시가 멈춘다.** MP만 멀쩡해
        -- 보이는 이유는 MpManager가 소모/회복 때마다 UpdateMpBar를 직접 밀어주기 때문이다(HP엔 그런
        -- 푸시 경로가 없다). 바 갱신은 실패 위험이 없는 최소 경로만 담아 따로 돌린다.
        self.barTimer = _TimerService:SetTimerRepeat(self.RefreshBars, 0.25)
        self:UpdateHUD()
        if Environment:IsMakerPlay() then log("[MapleHUD] OnBeginPlay - 버튼 연결 및 타이머 시작(HUD 0.25s + 바 전용 0.25s)") end
    end

    @ExecSpace("ClientOnly")
    method void RefreshAutoHuntButton()
        -- Reflect both hotkey and HUD toggles using the existing auto-hunt state.
        local button = _EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/BtnAutoHunt")
        if not isvalid(button) then return end
        local active = _AutoHuntManager:IsActive()
        local label = button:GetChildByName("Label")
        local icon = button:GetChildByName("Icon")
        if isvalid(label) then label.TextGUIRendererComponent.Text = active and "사냥중지" or "자동사냥" end
        if isvalid(icon) then icon.SpriteGUIRendererComponent.Color = active and Color(0.55,1,0.55,1) or Color.white end
    end

    @ExecSpace("ClientOnly")
    method void RefreshBars()
        if _AutoHuntPowerSave.active then return end
        self:RefreshAutoHuntButton()
        -- HP/MP 바 전용 최소 갱신. UpdateHUD와 **독립**으로 돌아 한쪽이 죽어도 수치 표시는 살아남는다.
        -- HUD가 숨겨진 상태(로그인/캐릭터선택)에서는 건드릴 것이 없으므로 건너뛴다.
        if not isvalid(self.hudRoot) or not self.hudRoot.Enable then return end
        local playerEntity = self:FindLocalPlayerEntity()
        if not isvalid(playerEntity) then return end
        local pc = playerEntity.PlayerComponent
        if not isvalid(pc) then return end
        local hp = math.max(0, math.floor(pc.Hp or 0))
        local maxHp = math.floor(pc.MaxHp or 0)
        if isvalid(self.hpFill) then
            if maxHp > 0 then
                self.hpFill.FillAmount = math.max(0, math.min(1, hp / maxHp))
            else
                self.hpFill.FillAmount = 1
            end
        end
        if isvalid(self.hpText) then
            self.hpText.Text = tostring(hp) .. " / " .. tostring(maxHp)
        end
        self:UpdateMpBar()
    end

    method void OnEndPlay()
		if self:IsClient() then
            _UICursorManager:ReleaseForcedCursor()
            self:StopRecoveryFlash("hp") self:StopRecoveryFlash("mp")
        end
        -- 타이머/이벤트 해제
        if self.updateTimer ~= 0 then
            _TimerService:ClearTimer(self.updateTimer)
            self.updateTimer = 0
        end
        if self.barTimer ~= 0 then
            _TimerService:ClearTimer(self.barTimer)
            self.barTimer = 0
        end
        if self._T.buttonHandlers ~= nil then
            for _, rec in ipairs(self._T.buttonHandlers) do
                if isvalid(rec.entity) then
                    rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
                end
            end
            self._T.buttonHandlers = {}
        end
        if self._T.dragHandlers ~= nil then
            for _, rec in ipairs(self._T.dragHandlers) do
                if isvalid(rec.entity) then
                    rec.entity:DisconnectEvent(rec.eventType, rec.eventHandler)
                end
            end
            self._T.dragHandlers = {}
        end
        if self._T.chatHandler ~= nil and isvalid(self.chatBox) then
            self.chatBox:DisconnectEvent(ChatEvent, self._T.chatHandler)
            self._T.chatHandler = nil
        end
        if self._T.chatKeyHandler ~= nil then
            _InputService:DisconnectEvent(KeyDownEvent, self._T.chatKeyHandler)
            self._T.chatKeyHandler = nil
        end
        if self._T.chatFocusTimer ~= nil then _TimerService:ClearTimer(self._T.chatFocusTimer) end
        if self._T.chatResetTimer ~= nil then _TimerService:ClearTimer(self._T.chatResetTimer) end
        self._T.chatFocusTimer, self._T.chatResetTimer = nil, nil
        self._T.chatTyping = false
        self._T.chatClosing = false
        self._T.chatSendTimes = nil
    end

	@ExecSpace("ClientOnly")
	method void UpdateLoginWorldTransition()
		local world = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/WorldGroup")
		if not isvalid(world) then return end
		local select = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CharacterSelectGroup")
		local create = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CreateCharacter")
		local nonWorld = (isvalid(select) and select.Enable) or (isvalid(create) and create.Enable)
		local paths = {
			"Step", "StepShadow", "StepCustom", "Title", "Subtitle",
			"WorldLabel", "WorldShadow", "WorldValue"
		}
		local baseX = { -334.5, -333.5, -336, -336, -336, -334.5, -333.5, -312 }
		local baseY = { 234.5, 227.5, 234, 239, 219, 169.5, 162.5, 170 }
		local navRoot = "/ui/LoginScene/Stage/Navigation/"

		if self._T.loginSignPhase == nil then
			self._T.loginSignPhase = nonWorld and "out" or "in"
			self._T.loginSignTargetNonWorld = nonWorld
		end

		if self._T.loginSignTargetNonWorld ~= nonWorld then
			self._T.loginSignTargetNonWorld = nonWorld
			self._T.loginSignPhase = nonWorld and "leaving" or "entering"
			self._T.loginSignStart = _UtilLogic.ElapsedSeconds
			if Environment:IsMakerPlay() then log(nonWorld and "[LoginTransition] 두 푯말 왼쪽 퇴장 시작" or "[LoginTransition] 두 푯말 왼쪽 진입 시작") end
		end

		local phase = self._T.loginSignPhase
		local t = 1
		if phase == "leaving" or phase == "entering" then
			t = math.min(1, (_UtilLogic.ElapsedSeconds - self._T.loginSignStart) / 0.36)
		end
		local ease = t * t * (3 - 2 * t)
		local offset = 0
		if phase == "leaving" then offset = -190 * ease
		elseif phase == "entering" then offset = -190 * (1 - ease)
		elseif phase == "out" then offset = -190 end

		for i = 1, #paths do
			local e = _EntityService:GetEntityByPath(navRoot .. paths[i])
			if isvalid(e) then
				e.UITransformComponent.anchoredPosition = Vector2(baseX[i] + offset, baseY[i])
			end
		end

		if t >= 1 and phase == "leaving" then
			self._T.loginSignPhase = "out"
			if Environment:IsMakerPlay() then log("[LoginTransition] 두 푯말 왼쪽 퇴장 완료") end
		elseif t >= 1 and phase == "entering" then
			self._T.loginSignPhase = "in"
			if Environment:IsMakerPlay() then log("[LoginTransition] 두 푯말 왼쪽 진입 완료") end
		end
	end

    @ExecSpace("ClientOnly")
    method void WireChatWindow()
        -- 채팅 제목줄 이동과 위쪽 가장자리 높이 조절을 연결한다.
        if not isvalid(self.chatBox) then return end
        local resizeGrip = self.chatBox:GetChildByName("ResizeGrip", false)
        local moveGrip = self.chatBox:GetChildByName("MoveGrip", false)

        if isvalid(resizeGrip) then
			local hd = resizeGrip:ConnectEvent(UITouchDownEvent, function() _UICursorManager:ForceCursor("chat-resize") end)
			local hu = resizeGrip:ConnectEvent(UITouchUpEvent, function() _UICursorManager:ReleaseForcedCursor() end)
			table.insert(self._T.dragHandlers, { entity = resizeGrip, eventType = UITouchDownEvent, eventHandler = hd })
			table.insert(self._T.dragHandlers, { entity = resizeGrip, eventType = UITouchUpEvent, eventHandler = hu })
            local h = resizeGrip:ConnectEvent(UITouchDragEvent, function(evt)
                if self._T.chatCollapsed then return end
                ---@type UITouchDragEvent
                local e = evt
                local tf = self.chatBox.UITransformComponent
                local point = _UILogic:ScreenToLocalUIPosition(e.TouchPoint, tf)
                local previous = _UILogic:ScreenToLocalUIPosition(e.TouchPoint-e.TouchDelta, tf)
                local nextHeight = math.max(120, math.min(520, tf.RectSize.y + point.y-previous.y))
                tf.RectSize = Vector2(tf.RectSize.x, nextHeight)
                if _MobileUIManager:IsMobile() then self._T.mobileChatHeight=nextHeight else self._T.chatExpandedHeight=nextHeight end
                self:RefreshChatGripWidth()
				self:RefreshChatLayout()
            end)
            table.insert(self._T.dragHandlers, { entity = resizeGrip, eventType = UITouchDragEvent, eventHandler = h })
        end

        if isvalid(moveGrip) then
			local hd = moveGrip:ConnectEvent(UITouchDownEvent, function() _UICursorManager:ForceCursor("chat-move") end)
			local hu = moveGrip:ConnectEvent(UITouchUpEvent, function() _UICursorManager:ReleaseForcedCursor() end)
			table.insert(self._T.dragHandlers, { entity = moveGrip, eventType = UITouchDownEvent, eventHandler = hd })
			table.insert(self._T.dragHandlers, { entity = moveGrip, eventType = UITouchUpEvent, eventHandler = hu })
            local h = moveGrip:ConnectEvent(UITouchDragEvent, function(evt)
                ---@type UITouchDragEvent
                local e = evt
                local tf = self.chatBox.UITransformComponent
                local p = tf.anchoredPosition
                -- 왼쪽/위쪽은 여백 없이, 아래쪽은 기존 HUD 보호 영역을 유지한다.
                if _MobileUIManager:IsMobile() then
                    local current=_UILogic:ScreenToLocalUIPosition(e.TouchPoint,self.chatBox.Parent.UITransformComponent)
                    local previous=_UILogic:ScreenToLocalUIPosition(e.TouchPoint-e.TouchDelta,self.chatBox.Parent.UITransformComponent)
                    self._T.mobileChatX=math.max(0,math.min(1920-tf.RectSize.x*1.2,p.x+current.x-previous.x))
                    self._T.mobileChatY=math.max(52,math.min(1080-tf.RectSize.y*1.2,p.y+current.y-previous.y))
                    self:RefreshChatLayout() return
                end
                local maxX = math.max(0, 1920 - tf.RectSize.x - 8)
                local maxY = math.max(52, 1080 - tf.RectSize.y)
                tf.anchoredPosition = Vector2(
                    math.max(0, math.min(maxX, p.x + e.TouchDelta.x)),
                    math.max(52, math.min(maxY, p.y + e.TouchDelta.y)))
            end)
            table.insert(self._T.dragHandlers, { entity = moveGrip, eventType = UITouchDragEvent, eventHandler = h })
        end
        local sideGrip=self.chatBox:GetChildByName("WidthGrip",false)
        if isvalid(sideGrip) then
            local resize=sideGrip:ConnectEvent(UITouchDragEvent,function(evt)
                local tf=self.chatBox.UITransformComponent
                local point=_UILogic:ScreenToLocalUIPosition(evt.TouchPoint,tf)
                local previous=_UILogic:ScreenToLocalUIPosition(evt.TouchPoint-evt.TouchDelta,tf)
                local width=math.max(_MobileUIManager:IsMobile() and 280 or 380,math.min(_MobileUIManager:IsMobile() and 1200 or 1500,tf.RectSize.x+point.x-previous.x))
                tf.RectSize=Vector2(width,tf.RectSize.y)
                if _MobileUIManager:IsMobile() then self._T.mobileChatWidth=width end
                self:RefreshChatLayout()
            end)
            table.insert(self._T.dragHandlers,{entity=sideGrip,eventType=UITouchDragEvent,eventHandler=resize})
        end
        local area=self.chatBox:GetChildByName("MobileDragArea",false)
        if isvalid(area) then
            local drag=area:ConnectEvent(UITouchDragEvent,function(e)
                if not _MobileUIManager:IsMobile() then return end
                local tf=self.chatBox.UITransformComponent
                local parent=self.chatBox.Parent.UITransformComponent
                local current=_UILogic:ScreenToLocalUIPosition(e.TouchPoint,parent)
                local previous=_UILogic:ScreenToLocalUIPosition(e.TouchPoint-e.TouchDelta,parent)
                self._T.mobileChatX=tf.anchoredPosition.x+current.x-previous.x
                self._T.mobileChatY=tf.anchoredPosition.y+current.y-previous.y
                self:RefreshChatLayout()
                self._T.mobileChatX=tf.anchoredPosition.x self._T.mobileChatY=tf.anchoredPosition.y
            end)
            table.insert(self._T.dragHandlers,{entity=area,eventType=UITouchDragEvent,eventHandler=drag})
        end
        if Environment:IsMakerPlay() then log("[MapleHUD] 채팅창 이동/가로·세로 리사이즈 핸들 연결") end
    end

    @ExecSpace("ClientOnly")
    method void RefreshChatGripWidth()
        -- 접기 버튼과 이동 영역이 겹치지 않도록 제목줄의 오른쪽 여백을 둔다.
        if not isvalid(self.chatBox) then return end
        local width = self.chatBox.UITransformComponent.RectSize.x
        local mobile=_MobileUIManager:IsMobile()
        local resizeGrip = self.chatBox:GetChildByName("ResizeGrip", false)
        local moveGrip = self.chatBox:GetChildByName("MoveGrip", false)
        if isvalid(resizeGrip) then resizeGrip.UITransformComponent.RectSize = Vector2(width - (mobile and 60 or 36), mobile and 24 or 8) end
        if isvalid(moveGrip) then moveGrip.UITransformComponent.RectSize = Vector2(width - 48, 24) end
    end

	@ExecSpace("ClientOnly")
	method void RefreshChatLayout()
		-- 한 줄 접기 / 최소 두 줄 펼치기와 사용자 지정 높이를 같은 레이아웃으로 처리한다.
		if not isvalid(self.chatBox) then return end
		local box = self.chatBox
        local mobile=_MobileUIManager:IsMobile()
        if mobile then
            _MobileUIManager:Remember(box)
            box.UITransformComponent.RectSize=Vector2(self._T.mobileChatWidth or 520,self._T.mobileChatHeight or 150)
            box.UITransformComponent.UIScale=Vector3(1.2,1.2,1)
            box.UITransformComponent.anchoredPosition=Vector2(self._T.mobileChatX or (1920-box.UITransformComponent.RectSize.x*1.2)/2,self._T.mobileChatY or (1080-box.UITransformComponent.RectSize.y*1.2))
        end
		local reading = mobile and self._T.chatTyping ~= true
        local collapsed = self._T.chatCollapsed == true and not mobile
		local size = box.UITransformComponent.RectSize
		-- Default 20px 폰트의 한글 한 줄은 약 30px이다. 32px를 확보해 잘림을 막는다.
		local height = mobile and (self._T.mobileChatHeight or 150) or (collapsed and 68 or math.max(120, self._T.chatExpandedHeight or size.y))
		box.UITransformComponent.RectSize = Vector2(size.x, height)
		local pos = box.UITransformComponent.anchoredPosition
		box.UITransformComponent.anchoredPosition = Vector2(
			mobile and math.max(0,math.min(1920-size.x*1.2,pos.x)) or math.max(0, math.min(1920 - size.x - 8, pos.x)),
			math.max(52, math.min(1080 - height * (mobile and 1.2 or 1), pos.y)))
		local bg = box:GetChildByName("SimpleChatBG", false)
		if isvalid(bg) then
			bg.Enable = true
			bg.UITransformComponent.RectSize = Vector2(size.x, height)
			bg.SpriteGUIRendererComponent.Color = Color(0.08, 0.09, 0.11, _GameSystemMenu.chatOpacity / 100)
		end
		local toggle = box:GetChildByName("BtnCollapse", false)
		if isvalid(toggle) then toggle.TextGUIRendererComponent.Text = collapsed and "+" or "-" end
		local grip = box:GetChildByName("ResizeGrip", false)
		if isvalid(grip) then grip.Enable = not collapsed end
		local title = box:GetChildByName("Title", false)
		if isvalid(title) then title.Enable = not collapsed end
		local input = self._T.chatInput
		if isvalid(input) then
			-- 포커스 해제 중에도 입력란 배경은 계속 남겨 깜빡이지 않게 한다.
			input.Enable = not reading
			input.UITransformComponent.RectSize = Vector2(size.x - 164, mobile and 44 or 26)
            input.UITransformComponent.anchoredPosition = Vector2(124, 3)
		end
		local view = box:GetChildByName("Messages", false)
		if isvalid(view) then
			view.Enable = true
			view.UITransformComponent.RectSize = Vector2(size.x - (collapsed and 52 or 48), collapsed and 32 or height - (reading and 24 or (mobile and 84 or 56)))
			view.UITransformComponent.anchoredPosition = Vector2(12, reading and 12 or (mobile and 60 or 32))
		end
        local area=box:GetChildByName("MobileDragArea",false)
        if isvalid(area) then
            area.Enable=mobile
            if mobile and isvalid(view) then
                area.UITransformComponent.RectSize=view.UITransformComponent.RectSize
                area.UITransformComponent.anchoredPosition=view.UITransformComponent.anchoredPosition
            end
        end
        self:RefreshChatGripWidth()
        for _,name in ipairs({"Title","MoveGrip","ResizeGrip","WidthGrip","BtnSettings","BtnCollapse","Recipient"}) do
            local control=box:GetChildByName(name,false)
            if isvalid(control) then control.Enable=(mobile and name=="MoveGrip") or (not reading and (not collapsed or name=="BtnCollapse" or name=="BtnSettings" or name=="Recipient")) end
        end
		self:RenderSimpleChatMessages()
	end

    @ExecSpace("ClientOnly")
    method void WireSimpleChatMessages()
        -- 기본 말풍선 버튼을 끄고 포커스 가능한 입력란과 금칙어 필터가 설정된 텍스트 로그를 연결한다.
        if not isvalid(self.chatBox) then return end
        self._T.chatCollapsed = false
        self._T.chatExpandedHeight = math.max(120, self.chatBox.UITransformComponent.RectSize.y)
        self._T.chatMessages = {}
        self._T.chatTyping = false
        self._T.chatClosing = false
        self._T.chatInput = self.chatBox:GetChildByName("Input", false)
        if isvalid(self.chatBox.ChatComponent) then self.chatBox.ChatComponent.Enable = false end
        local input = self._T.chatInput
        if isvalid(input) then
            local submit = input:ConnectEvent(TextInputSubmitEvent, function(evt)
                ---@type TextInputSubmitEvent
                local event = evt
                self:SubmitChat(event.Text)
            end)
            table.insert(self._T.dragHandlers, {entity=input, eventType=TextInputSubmitEvent, eventHandler=submit})
            local finish = input:ConnectEvent(TextInputEndEditEvent, function()
                if self._T.chatRefocusPending and not self._T.chatClosing then return end
                if _MobileUIManager:IsMobile() and not self._T.chatClosing then return end
                self._T.chatTyping = false
                self:RefreshChatLayout()
            end)
            table.insert(self._T.dragHandlers, {entity=input, eventType=TextInputEndEditEvent, eventHandler=finish})
        end
        local toggle = self.chatBox:GetChildByName("BtnCollapse", false)
        if isvalid(toggle) then
            local click = toggle:ConnectEvent(ButtonClickEvent, function() self:ToggleChatCollapsed() end)
            table.insert(self._T.buttonHandlers, {entity=toggle, eventHandler=click})
        end
        self._T.chatKeyHandler = _InputService:ConnectEvent(KeyDownEvent, function(evt)
            ---@type KeyDownEvent
            local event = evt
            if self:IsChatTyping() and self:IsChatExitKey(event.key) then self:FinishChatInput() return end
            if _CarnivalUI.focused or _CarnivalView:BlockedKey(event.key) then return end
            if not self:IsChatTyping() and not self:HasOpenChatBlockingWindow() then
                local action=_KeySettingManager:GetFuncForKeyEnum(event.key)
                local mode=({chat_all="map",chat_friend="friend",chat_party="party"})[action]
                if mode~=nil then
                    _SocialManager:SelectChat(mode)
                    self:FocusChat()
                    return
                end
            end
            if _SkillManager:BlocksAmountInput() then return end
            if event.key == KeyboardKey.Return or event.key == KeyboardKey.KeypadEnter then
                if not self:IsChatTyping() and not self:HasOpenChatBlockingWindow() then self:FocusChat() end
            elseif event.key == KeyboardKey.Escape and self:IsChatTyping() then
                self:FinishChatInput()
            end
        end)
        if Environment:IsMakerPlay() then log("[MapleHUD] plain chat ready; Enter focus and collapse enabled") end
    end

    @ExecSpace("ClientOnly")
    method void RenderSimpleChatMessages()
        -- 메시지를 분리해 색상 태그와 이전 대화가 한꺼번에 필터링되지 않게 한다.
        if not isvalid(self.chatBox) then return end
        for i=1,18 do
            local old=self.chatBox:GetChildByName("SimpleLine"..tostring(i),false)
            if isvalid(old) then old.Enable=false end
        end
        local view=self.chatBox:GetChildByName("Messages",false)
        if not isvalid(view) then return end
        local oldLog=view:GetChildByName("Log",false)
        if isvalid(oldLog) then oldLog.Enable=false end
        local messages=self._T.chatMessages or {}
        local collapsed=self._T.chatCollapsed and not _MobileUIManager:IsMobile()
        local width=view.UITransformComponent.RectSize.x
        local bottom=0
        for i=1,80 do
            local label=view:GetChildByName("Message"..tostring(i),false)
            if isvalid(label) then
                local message=messages[#messages-i+1]
                label.Enable=message~=nil and (not collapsed or i==1)
                if label.Enable then
                    local body=self:FormatChatMessage(message)
                    local mode=type(message)=="table" and message.mode or "map"
                    local tc=label.TextGUIRendererComponent
                    tc.IsRichText=false tc.BestFit=false tc.FontSize=_GameSystemMenu.chatSize
                    tc.FontColor=Color.FromHexCode(mode=="notice" and "#FF785A" or _GameSystemMenu:GetChatHex(mode))
                    if tc.Text~=body then tc.Text=body end
                    local height=math.max(32,math.ceil(tc:GetPreferredHeight(body,width))+2)
                    label.UITransformComponent.RectSize=Vector2(width,height)
                    label.UITransformComponent.anchoredPosition=Vector2(0,bottom)
                    bottom=bottom+height
                end
            end
        end
    end

    method string FormatChatMessage(any message)
        -- Direction is stamped by the server; only the counterpart's name is shown.
        if type(message)~="table" then return tostring(message) end
        if message.mode=="notice" then return message.text end
        if message.mode=="whisper" then
            return (message.sent and message.target or message.name)..(message.sent and " << " or " >> ")..message.text
        end
        return message.name.." : "..message.text
    end

    @ExecSpace("ClientOnly")
    method boolean IsChatTyping()
        -- 게임 단축키가 채팅 입력을 가로채지 않도록 현재 포커스 상태를 공유한다.
        local input = self._T.chatInput
        local typing=self._T.chatTyping==true or (isvalid(input) and input.EnabledInHierarchy and input.TextGUIRendererInputComponent.IsFocused)
        if typing then
            for _,key in ipairs({KeyboardKey.LeftArrow,KeyboardKey.RightArrow,KeyboardKey.UpArrow,KeyboardKey.DownArrow,KeyboardKey.LeftControl,KeyboardKey.RightControl,KeyboardKey.LeftAlt,KeyboardKey.RightAlt,KeyboardKey.Tab,KeyboardKey.F1,KeyboardKey.F2,KeyboardKey.F3,KeyboardKey.F4,KeyboardKey.F5,KeyboardKey.F6,KeyboardKey.F7,KeyboardKey.F8,KeyboardKey.F9,KeyboardKey.F10}) do
                if _InputService:IsKeyPressed(key) then self:FinishChatInput() return false end
            end
        end
        return typing and not self._T.chatClosing
    end

    @ExecSpace("ClientOnly")
    method boolean HasOpenChatBlockingWindow()
        return _UIPopup:BlocksInput() or not _LoginFlow:IsInGame()
    end

    @ExecSpace("ClientOnly")
    method void FocusChat()
        -- Enter 처리 프레임 뒤에 포커스를 줘서 여는 Enter가 빈 메시지를 제출하지 않게 한다.
        if not isvalid(self._T.chatInput) or not _LoginFlow:IsInGame() or self._T.chatClosing then return end
        if _UtilLogic.ElapsedSeconds - (self._T.chatClosedAt or -10) < 0.2 then return end
        self._T.chatWindowSnapshot=self:CaptureChatWindows()
        self._T.chatTyping = true
        self:RefreshChatLayout()
        if self._T.chatFocusTimer ~= nil then _TimerService:ClearTimer(self._T.chatFocusTimer) end
        self._T.chatFocusTimer = _TimerService:SetTimerOnce(function()
            self._T.chatFocusTimer = nil
            if isvalid(self._T.chatInput) and self._T.chatTyping then
                self._T.chatInput.TextGUIRendererInputComponent:ActivateInputField()
                self._T.chatRefocusPending=false
                if Environment:IsMakerPlay() then log("[MapleHUD] Enter requested chat focus") end
            end
        end, 0.05)
    end

    @ExecSpace("ClientOnly")
    method void FinishChatInput()
        -- 입력을 마치면 게임 키보드 제어를 돌려주고 접힌 상태를 유지한다.
        self._T.chatTyping = false
        self._T.chatClosing = true
        self._T.chatRefocusPending = false
        self._T.chatClosedAt = _UtilLogic.ElapsedSeconds
        if self._T.chatFocusTimer ~= nil then
            _TimerService:ClearTimer(self._T.chatFocusTimer)
            self._T.chatFocusTimer = nil
        end
        local input = self._T.chatInput
        if isvalid(input) then
            input.TextGUIRendererInputComponent.Text = ""
            input.TextGUIRendererInputComponent.Enable = false
        end
        self:RefreshChatLayout()
        -- 입력 컴포넌트만 재설정한다. 배경/글자 엔티티를 껐다 켜지 않는다.
        if self._T.chatResetTimer ~= nil then _TimerService:ClearTimer(self._T.chatResetTimer) end
        self._T.chatResetTimer = _TimerService:SetTimerOnce(function()
            self._T.chatResetTimer = nil
            self._T.chatClosing = false
            if isvalid(input) then input.TextGUIRendererInputComponent.Enable = true end
            self:RefreshChatLayout()
        end, 0.08)
    end

    @ExecSpace("ClientOnly")
    method void SubmitChat(string text)
        text = (string.gsub(text or "", "[%c]", " "))
        text = string.match(text, "^%s*(.-)%s*$") or ""
        -- 빈 입력의 Enter는 채팅을 종료하고, 내용이 있으면 전송 후 계속 입력한다.
        if text == "" then
            self:FinishChatInput()
            return
        end
        self:RequestChat(text, _SocialManager.chatMode, _SocialManager.whisperName)
        if self._T.chatClosing or not isvalid(self._T.chatInput) then return end
        self._T.chatInput.TextGUIRendererInputComponent.Text=""
        self._T.chatRefocusPending=true
        self._T.chatTyping=true
        self:FocusChat()
    end

    @ExecSpace("Server")
    method void RequestChat(string text, string mode, string target)
        -- 이름을 클라이언트에서 받지 않는다. 접속 중인 요청자만 인스턴스 채팅에 참여할 수 있다.
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        if #text > 840 then return end
        text = (string.gsub(text, "[%c]", " "))
        text = string.match(text, "^%s*(.-)%s*$") or ""
        if text == "" then return end
        self._T.chatSendTimes = self._T.chatSendTimes or {}
        local now = _UtilLogic.ElapsedSeconds
        if now - (self._T.chatSendTimes[senderUserId] or -10) < 0.7 then return end
        self._T.chatSendTimes[senderUserId] = now
        if _TestCommandManager:HandleCommand(senderUserId, text) then return end
        if _RecoveryManager:HandleCommand(senderUserId, text) then return end
        _SocialManager:RouteChat(senderUserId, mode, target, text)
    end

    @ExecSpace("Client")
    method void ReceiveChat(string nickname, string text, string mode, string target, boolean sent)
        -- TextGUIRendererComponent의 Maker 금칙어 필터를 거쳐 표시하고 리치 텍스트는 해석하지 않는다.
        self._T.chatMessages = self._T.chatMessages or {}
        table.insert(self._T.chatMessages, {name=nickname, text=text, mode=mode or "map", target=target or "",sent=sent})
        if mode=="whisper" and not sent then _SocialManager.lastWhisperName=nickname end
        if #self._T.chatMessages > 80 then table.remove(self._T.chatMessages, 1) end
        self:RenderSimpleChatMessages()
        if Environment:IsMakerPlay() then log("[MapleHUD] chat line rendered count=" .. tostring(#self._T.chatMessages)) end
    end

    @ExecSpace("ClientOnly")
    method void ToggleChatCollapsed()
        -- 펼친 높이를 기억해서 다시 +를 누르면 사용자가 조절한 높이를 복원한다.
        self._T.chatCollapsed = not self._T.chatCollapsed
        self:RefreshChatLayout()
        if Environment:IsMakerPlay() then log("[MapleHUD] chat collapsed=" .. tostring(self._T.chatCollapsed) .. " height=" .. tostring(self.chatBox.UITransformComponent.RectSize.y)) end
    end

    @ExecSpace("ClientOnly")
    method void SendLevelFadeBehindText()
        -- 잘게 겹치던 페이드 조각은 숨기고 단일 이미지 위에 글자만 표시한다.
        local plate = _EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/LevelPlate")
        if not isvalid(plate) then return end
        for i = 1, 12 do
            local fade = plate:GetChildByName("Fade" .. tostring(i), false)
            if isvalid(fade) then fade.Enable = false end
        end
        if isvalid(self.levelText) then
            self.levelText.FontColor = Color(1, 1, 1, 1)
			_UILogic:SetSiblingIndex(self.levelText.Entity.UITransformComponent, 100)
		end
		if isvalid(self.nameText) then _UILogic:SetSiblingIndex(self.nameText.Entity.UITransformComponent, 101) end
    end

    @ExecSpace("ClientOnly")
    method void ConnectMenuButton(ButtonComponent btn, any callback)
        -- 메뉴 아이콘 버튼 하나에 클릭 콜백을 연결하고 해제용으로 기록한다
        if not isvalid(btn) then return end
        local h = btn.Entity:ConnectEvent(ButtonClickEvent, function()
            if _SkillManager:BlocksAmountInput() then return end
            callback()
        end)
        table.insert(self._T.buttonHandlers, { entity = btn.Entity, eventHandler = h })
    end

    @ExecSpace("ClientOnly")
    method Entity FindLocalPlayerEntity()
        -- **이 클라이언트의 플레이어**를 돌려준다.
        -- (버그 수정 2026-08-15, 신고 "다른 아이디가 맞으면 내 HP바가 줄어든다") 종전엔 맵 트리에서
        -- PlayerComponent가 붙은 **첫 엔티티**를 집었다. 접속자가 한 명일 땐 우연히 맞았지만, 둘 이상이면
        -- 맵에 먼저 들어온 **남의 캐릭터**를 잡아 그 사람의 HP를 내 HUD에 그린다(내가 맞아도 안 줄고,
        -- 남이 맞으면 내 바가 줄어드는 증상의 정체). LocalPlayer는 클라마다 자기 자신을 가리킨다.
        local lp = _UserService.LocalPlayer
        if isvalid(lp) and isvalid(lp.PlayerComponent) then return lp end
        return nil
    end

    @ExecSpace("ClientOnly")
    method void UpdateHUD()
        if _AutoHuntPowerSave.active then
            local now = _UtilLogic.ElapsedSeconds
            if now < (self._T.powerRefresh or 0) then return end
            self._T.powerRefresh = now + 2
        end
        -- 로그인/캐릭터선택/생성 화면에서는 HUD 전체 숨김, 인게임에서는 표시 + 수치 갱신
        if not isvalid(self.hudRoot) then return end

        local inMenu = not _LoginFlow:IsInGame()
        local countdown = _EntityService:GetEntityByPath("/ui/DefaultGroup/RespawnWindow")

        local playerEntity = self:FindLocalPlayerEntity()

        if inMenu or not isvalid(playerEntity) then
            if isvalid(countdown) and countdown.Enable then countdown.Enable = false end
            if self.hudRoot.Enable then self.hudRoot.Enable = false end
            return
        end

        if not self.hudRoot.Enable then
            self.hudRoot.Enable = true
            if Environment:IsMakerPlay() then log("[MapleHUD] HUD 표시 시작") end
        end

        -- 기존 좌상단 UIMyInfo 박스는 원작 디자인에 없으므로 숨긴다
        local oldInfo = _EntityService:GetEntityByPath("/ui/ToastGroup/UIMyInfo")
        if isvalid(oldInfo) and oldInfo.Enable then
            oldInfo.Enable = false
        end

        -- HP
        local pc = playerEntity.PlayerComponent
        local dead = pc:IsDead()
        if isvalid(countdown) then
            -- 매 갱신마다 창을 껐다 켜면 다른 UI의 호버와 입력 상태도 흔들린다.
            local showCountdown = dead and not _BossStageManager:HidesFieldNotices() and not (isvalid(playerEntity.CurrentMap) and _CarnivalRules:IsArena(playerEntity.CurrentMap.Name))
            if showCountdown then
                local remaining = math.max(0, math.ceil(pc.RespawnTime - _UtilLogic.ServerElapsedSeconds))
                local label = countdown:GetChildByName("Time")
                local message = "부활까지 " .. tostring(remaining) .. "초"
                if isvalid(label) and label.TextGUIRendererComponent.Text ~= message then
                    label.TextGUIRendererComponent.Text = message
                end
            end
            if countdown.Enable ~= showCountdown then
                countdown.Enable = showCountdown
                -- Re-enabling a hidden notice during mobile layout changes must not steal focus.
                if Environment:IsMakerPlay() then log("[MapleHUD] respawn countdown visible=" .. tostring(showCountdown)) end
            end
            if showCountdown and not self._T.countdownShown then
                _UIEquipInventoryManager:BringWindowToFront(countdown.Path)
            end
            self._T.countdownShown=showCountdown
        end
        if not dead and not _BossStageManager:HidesFieldNotices() then
            pc.RespawnDuration = math.max(1, _CharInfoManager:GetDisplayLevel())
        end
        local hp = math.max(0, math.floor(pc.Hp or 0))
        local maxHp = math.floor(pc.MaxHp or 0)
        if isvalid(self.hpFill) then
            if maxHp > 0 then
                self.hpFill.FillAmount = math.max(0, math.min(1, hp / maxHp))
            else
                self.hpFill.FillAmount = 1
            end
        end
        if isvalid(self.hpText) then
            self.hpText.Text = tostring(hp) .. " / " .. tostring(maxHp)
        end

        -- MP (2026-08-08부터 실제 자원 - MpManager)
        self:UpdateMpBar()

        -- 레벨 / 이름 - UIMyInfoManager와 동일하게 장비 전투력의 CP(L) 테이블 환산을 쓴다.
        -- (구버전 "전투력 ÷ 10" 선형 환산 잔재가 여기 남아 Lv756 같은 기괴한 표시를 냈었다)
        local displayLevel = _CharInfoManager:GetDisplayLevel()
        if isvalid(self.levelText) then
			self.levelText.FontColor = Color(1, 1, 1, 1)
            self.levelText.Text = "Lv." .. tostring(displayLevel)
        end
        if isvalid(self.nameText) then
			local nickname = playerEntity.PlayerComponent.Nickname
			if nickname == nil or nickname == "" then nickname = _CharInfoManager:GetCurrentCharName() end
			self.nameText.Text = nickname
        end
    end

    -- MP 게이지/숫자 갱신. UpdateHUD의 0.25초 주기 갱신과, MP를 쓰거나 회복한 직후
    -- MpManager가 직접 호출하는 즉시 갱신 두 경로가 이 메서드 하나를 공유한다.
    @ExecSpace("ClientOnly")
    method void UpdateMpBar()
        if _AutoHuntPowerSave.active then return end
        -- ⚠ MpManager는 클라 전용 Logic이라 서버에서는 호출되지 않는다(HUD 자체가 클라 전용).
        local maxMp = _MpManager:GetMaxMp()
        local curMp = _MpManager:GetCurrentMp()
        if isvalid(self.mpFill) then
            if maxMp > 0 then
                self.mpFill.FillAmount = math.max(0, math.min(1, curMp / maxMp))
            else
                self.mpFill.FillAmount = 1
            end
        end
        if isvalid(self.mpText) then
            self.mpText.Text = tostring(curMp) .. " / " .. tostring(maxMp)
        end
    end

    @ExecSpace("ClientOnly")
    method void StopRecoveryFlash(string resource)
        -- Cancel a previous pulse and restore the complete gauge group.
        local flashes=self._T.recoveryFlashes
        local rec=flashes and flashes[resource] or nil
        if rec==nil then return end
        if rec.timer~=nil then _TimerService:ClearTimer(rec.timer) end
        if isvalid(rec.group) then rec.group.GroupAlpha=rec.alpha end
        flashes[resource]=nil
    end

    @ExecSpace("ClientOnly")
    method void FlashRecoveryBar(string resource)
        -- Pulse only the recovered resource twice; concurrent HP and MP pulses are independent.
        if resource~="hp" and resource~="mp" then return end
        self:StopRecoveryFlash(resource)
        local bar=_EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/"..(resource=="hp" and "HpBar" or "MpBar"))
        if not isvalid(bar) or not isvalid(bar.CanvasGroupComponent) then return end
        self._T.recoveryFlashes=self._T.recoveryFlashes or {}
        local rec={group=bar.CanvasGroupComponent,alpha=bar.CanvasGroupComponent.GroupAlpha,step=0}
        self._T.recoveryFlashes[resource]=rec
        rec.group.GroupAlpha=rec.alpha*0.25
        rec.timer=_TimerService:SetTimerRepeat(function()
            if not isvalid(rec.group) then self:StopRecoveryFlash(resource) return end
            rec.step=rec.step+1
            if rec.step>=3 then
                self:StopRecoveryFlash(resource)
                if Environment:IsMakerPlay() then log("[BossStage] "..resource.." recovery UI blink completed twice") end
                return
            end
            rec.group.GroupAlpha=rec.step==1 and rec.alpha or rec.alpha*0.25
        end,0.18,0.18)
        if Environment:IsMakerPlay() then log("[BossStage] "..resource.." recovery UI blink started") end
    end


    @ExecSpace("ClientOnly")
    method boolean IsChatExitKey(any key)
        -- Text entry ends when gameplay-only keys are used; printable text remains chat.
        for _,exitKey in ipairs({KeyboardKey.Escape,KeyboardKey.LeftArrow,KeyboardKey.RightArrow,KeyboardKey.UpArrow,KeyboardKey.DownArrow,KeyboardKey.LeftControl,KeyboardKey.RightControl,KeyboardKey.LeftAlt,KeyboardKey.RightAlt,KeyboardKey.Tab,KeyboardKey.F1,KeyboardKey.F2,KeyboardKey.F3,KeyboardKey.F4,KeyboardKey.F5,KeyboardKey.F6,KeyboardKey.F7,KeyboardKey.F8,KeyboardKey.F9,KeyboardKey.F10}) do
            if key==exitKey then return true end
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method void CancelChatOutside(Vector2 point)
        -- Clicking outside the chat panel commits focus back to the clicked game UI.
        if not self:IsChatTyping() then return end
        if not _UIClickArbiter:ContainsScreenPoint(self.chatBox,point) then self:FinishChatInput() end
    end

    @ExecSpace("ClientOnly")
    method table CaptureChatWindows()
        local paths=_UIClickArbiter:GetWindowPaths()
        for _,path in ipairs({"/ui/DefaultGroup/QuickSlotDialog","/ui/DefaultGroup/MapSelectGroup","/ui/WorldMapGroup","/ui/ShopGroup/ShopPopup","/ui/PopupGroup/PopupBack","/ui/SkillPointDialog/Modal","/ui/KeySaveConfirm/Modal","/ui/RewardCenter/Modal","/ui/EventGroup/Modal","/ui/ItemDiscardGroup/Modal","/ui/MobileNumberPad/Modal"}) do table.insert(paths,path) end
        local result={}
        for _,path in ipairs(paths) do
            local window=_EntityService:GetEntityByPath(path)
            if path~="/ui/DefaultGroup/Board" and isvalid(window) and window.EnabledInHierarchy and window.Visible then result[path]=true end
        end
        return result
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        if not self._T.chatTyping then return end
        local now=_UtilLogic.ElapsedSeconds
        if now<(self._T.chatWindowCheckAt or 0) then return end
        self._T.chatWindowCheckAt=now+0.1
        local windows=self:CaptureChatWindows()
        local previous=self._T.chatWindowSnapshot or windows
        self._T.chatWindowSnapshot=windows
        for path,_ in pairs(windows) do
            if previous[path] then continue end
            local input=self._T.chatInput
            local draft=isvalid(input) and input.TextGUIRendererInputComponent.Text or ""
            self:FinishChatInput()
            if isvalid(input) then input.TextGUIRendererInputComponent.Text=draft end
            if Environment:IsMakerPlay() then log("[VRF] Chat focus released for newly opened window "..path) end
            return
        end
    end
end
