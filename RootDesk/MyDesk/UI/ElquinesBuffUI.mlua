@Logic
@ExecSpace("ClientOnly")
script ElquinesBuffUI extends Logic

	-- (요청 2026-08-11) 엘퀴네스(썬콜 4차 소환) 버프바 아이콘. BahamutBuffUI 복제 -
	-- UUID는 UIBuilder가 write bind로 주입한다. 지속 10분(600초), 재소환 시 타이머 교체.
	property Entity buffIconGroup = "d80250d1-f960-43b6-a9c8-4af412490091"
	property SpriteGUIRendererComponent grayOverlay = "13a3daac-f530-4101-8f45-b9a53958a294"
	property TextGUIRendererComponent countdownText = "1ec286fb-326f-4cff-b83a-a20d7c869f30"

	@ExecSpace("ClientOnly")
	method void ShowBuff(number duration)
		-- 엘퀴네스 지속시간 표시/갱신. 재소환하면 새 타이머로 교체된다.
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.elquinesTotalDuration = duration
		self._T.elquinesRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.elquinesTimerId then
			_UIFrameTicker:Unsubscribe(self._T.elquinesTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.elquinesTimerId = _UIFrameTicker:Subscribe(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.elquinesRemaining = self._T.elquinesRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void UpdateBuffDisplay()
		-- 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃 갱신.
		local remaining = self._T.elquinesRemaining
		local total = self._T.elquinesTotalDuration

		if remaining <= 0 then
			if self._T.elquinesTimerId then
				_UIFrameTicker:Unsubscribe(self._T.elquinesTimerId)
				self._T.elquinesTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideBuff()
		-- 엘퀴네스가 지속시간 전에 사라질 때(우클릭 취소/재소환 교체) 버프바를 즉시 내린다.
		if not self:IsClient() then return end
		if self._T.elquinesRemaining == nil then return end
		self._T.elquinesRemaining = 0
		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.elquinesTimerId then
			_UIFrameTicker:Unsubscribe(self._T.elquinesTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	@ExecSpace("ClientOnly")
	method number GetRemaining()
		return self._T.elquinesRemaining or 0
	end

end
