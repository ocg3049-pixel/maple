@Logic
script UITheme extends Logic

    @ExecSpace("ClientOnly")
    method void ShadedTab(Entity entity, boolean selected)
        if not isvalid(entity) then return end
        local sprite = entity.SpriteGUIRendererComponent
        local transform = entity.UITransformComponent
        if not isvalid(sprite) or not isvalid(transform) then return end
        local gradient = entity.PixelGUIRendererComponent
        if not selected then
            if isvalid(gradient) then gradient.Enable = false end
            sprite.Color = Color(.13,.14,.15,1)
            return
        end
        if not isvalid(gradient) then gradient = entity:AddComponent("PixelGUIRendererComponent") end
        if not isvalid(gradient) then return end
        local width = math.max(1, math.floor(transform.RectSize.x + .5))
        local height = math.max(1, math.floor(transform.RectSize.y + .5))
        -- Cache at the actual tab size so compact/expanded tabs keep round corners.
        if gradient.Width ~= width or gradient.Height ~= height then
            local pixels = {}
            local radius = math.min(5, width / 2, height / 2)
            for y = 1, height do
                local fromTop = 1 - (y - 1) / math.max(1, height - 1)
                -- Upper sky blue fades into 82% black at the bottom edge.
                local shade = 1 - .82 * fromTop * fromTop
                local rowColor = Color(.48 * shade, .80 * shade, shade, 1)
                for x = 1, width do
                    local dx = math.max(radius - (x - .5), (x - .5) - (width - radius), 0)
                    local dy = math.max(radius - (y - .5), (y - .5) - (height - radius), 0)
                    local alpha = math.min(1, math.max(0, radius + .5 - math.sqrt(dx * dx + dy * dy)))
                    if alpha >= 1 then
                        pixels[#pixels + 1] = rowColor
                    else
                        pixels[#pixels + 1] = Color(.48 * shade, .80 * shade, shade, alpha)
                    end
                end
            end
            gradient:ResetWithColors(width, height, pixels)
        end
        gradient.RaycastTarget = false
        gradient.Enable = true
        -- Keep the existing sprite hit target; only its visual is replaced.
        sprite.Color = Color(1,1,1,0)
    end

    @ExecSpace("ClientOnly")
    method void Button(Entity entity, Color background)
        -- Rounded surfaces use tint and readable labels without a second outline.
        if not isvalid(entity) then return end
        if isvalid(entity.SpriteGUIRendererComponent) then
            entity.SpriteGUIRendererComponent.Color = background
            entity.SpriteGUIRendererComponent.Outline = false
            entity.SpriteGUIRendererComponent.OutlineWidth = 1
            entity.SpriteGUIRendererComponent.OutlineColor = background.r >= .2 and Color(.82,.96,.31,1) or Color(.32,.35,.38,1)
        end
        local foreground = background.r >= .2 and Color(.82,.96,.31,1) or Color(.88,.9,.92,1)
        self:Label(entity, foreground)
        for _, child in ipairs(entity.Children:ToTable()) do
            self:Label(child, foreground)
        end
    end

    @ExecSpace("ClientOnly")
    method void LightItem(Entity entity, boolean selected)
        -- Keep equipment rows pearl-white after paging, refreshing and selecting.
        if not isvalid(entity) then return end
        local sprite = entity.SpriteGUIRendererComponent
        if isvalid(sprite) then
            sprite.Color = Color.white
            sprite.Outline = selected
            sprite.OutlineWidth = 2
            sprite.OutlineColor = Color(.48,.80,1,1)
        end
        local ink = Color(.12,.15,.18,1)
        self:Label(entity, ink)
        for _, child in ipairs(entity.Children:ToTable()) do self:Label(child, ink) end
    end

    @ExecSpace("ClientOnly")
    method void Label(Entity entity, Color foreground)
        -- Both legacy windows and newer mobile windows use the same palette.
        local legacy = entity:GetComponent("MOD.Core.TextComponent")
        local text = entity.TextGUIRendererComponent
        if isvalid(legacy) then legacy.FontColor = foreground end
        if isvalid(text) then text.FontColor = foreground end
    end

    @ExecSpace("ClientOnly")
    method void Appearance(Entity root, boolean ingame)
        -- The dye window is shared with character creation: restore its original colors there.
        if not isvalid(root) then return end
        if self._T.appearance == nil then
            self._T.appearance = {}
            self:CacheAppearance(root)
        end
        if self._T.appearanceIngame == ingame then return end
        for _, entry in ipairs(self._T.appearance) do
            local entity = entry.entity
            if isvalid(entity) then
                if entry.background ~= nil then
                    local c = entry.background
                    entity.SpriteGUIRendererComponent.Color = ingame and Color(.12,.13,.14,c.a) or c
                    if entity == root then
                        entity.SpriteGUIRendererComponent.ImageRUID = ingame and "94f5a064b40741b6947b644ebecaa28e" or entry.image
                        entity.SpriteGUIRendererComponent.Color = ingame and Color(1,1,1,c.a) or c
                    end
                    if not ingame then
                        entity.SpriteGUIRendererComponent.Outline = entry.outline
                        entity.SpriteGUIRendererComponent.OutlineWidth = entry.outlineWidth
                        entity.SpriteGUIRendererComponent.OutlineColor = entry.outlineColor
                    end
                end
                if entry.foreground ~= nil then
                    entity.TextGUIRendererComponent.FontColor = ingame and (entity.Name == "Title" and Color(.82,.96,.31,1) or Color(.88,.9,.92,entry.foreground.a)) or entry.foreground
                end
            end
        end
        self._T.appearanceIngame = ingame
        if Environment:IsMakerPlay() then log("[VRF] UITheme appearance ingame="..tostring(ingame)) end
    end

    @ExecSpace("ClientOnly")
    method void CacheAppearance(Entity entity)
        -- Cache only chrome colors, preserving swatches, spectrum and preview artwork.
        if entity.Name == "Swatch" or entity.Name == "Spectrum" or entity.Name == "Preview" or entity.Name == "Icon" then return end
        local entry = {entity=entity}
        local sprite = entity.SpriteGUIRendererComponent
        if isvalid(sprite) then
            local c = sprite.Color
            entry.image = sprite.ImageRUID
            entry.outline = sprite.Outline
            entry.outlineWidth = sprite.OutlineWidth
            entry.outlineColor = sprite.OutlineColor
            if (c.r > c.b+.025 and c.g > c.b+.012 and c.r >= c.g-.015) or (isvalid(entity.ButtonComponent) and c.g > c.r+.03) then entry.background = c end
        end
        local text = entity.TextGUIRendererComponent
        if isvalid(text) then
            local c = text.FontColor
            if c.r > c.b+.025 and c.g > c.b+.012 and c.r >= c.g-.015 then entry.foreground = c end
        end
        if entry.background ~= nil or entry.foreground ~= nil then table.insert(self._T.appearance,entry) end
        for _, child in ipairs(entity.Children:ToTable()) do self:CacheAppearance(child) end
    end
end
