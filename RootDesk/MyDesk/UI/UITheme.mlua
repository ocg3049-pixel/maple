@Logic
script UITheme extends Logic

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Upgrade older cached UI instances too; published UI already carries these renderers.
        local root=_EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
        self:UpgradeTextTree(root)
        for _,path in ipairs({"EquipWindow/TabEquip/Label","EquipWindow/TabPet/Label","EquipWindow/PetNotice","InvenWindow/MesoBar/EnhanceOpenBtn/BtnLabel"}) do
            self:UpgradeTextTree(_EntityService:GetEntityByPath("/ui/DefaultGroup/"..path))
        end
        for _,name in ipairs({"BtnReward","BtnAutoHunt","BtnSkill","BtnEnhance","BtnInven","BtnMap"}) do
            self:SharpHUDButton(_EntityService:GetEntityByPath("/ui/DefaultGroup/MapleHUD/"..name))
        end
        if Environment:IsMakerPlay() then log("[VRF] Sharp UI text renderers and six HUD buttons ready") end
    end

    @ExecSpace("ClientOnly")
    method void SharpHUDButton(Entity entity)
        if not isvalid(entity) then return end
        -- A separate surface avoids two GUI renderers sharing the button's transparent hit target.
        local surface=entity:GetChildByName("SharpSurface")
        if not isvalid(surface) then
            surface=_SpawnService:SpawnByModelId("uisprite","SharpSurface",Vector3.zero,entity)
            if not isvalid(surface) then return end
            surface:RemoveComponent("MOD.Core.SpriteGUIRendererComponent")
        end
        local size=entity.UITransformComponent.RectSize
        local tr=surface.UITransformComponent
        tr.AlignmentOption=AlignmentType.Center tr.AnchorsMin=Vector2(.5,.5) tr.AnchorsMax=Vector2(.5,.5)
        tr.Pivot=Vector2(.5,.5) tr.anchoredPosition=Vector2.zero tr.RectSize=size
        local pixel=surface.PixelGUIRendererComponent
        if not isvalid(pixel) then pixel=surface:AddComponent("MOD.Core.PixelGUIRendererComponent") end
        -- Supersample rounded corners at 2x; reuse the generated pixels across all six buttons.
        local width,height=math.floor(size.x*2),math.floor(size.y*2)
        local key=tostring(width)..":"..tostring(height)
        self._T.hudPixels=self._T.hudPixels or {}
        local pixels=self._T.hudPixels[key]
        if pixels==nil then
            pixels={}
            local r=16
            for y=1,height do
                local shade=.11+.07*(y-1)/math.max(1,height-1)
                local fill=Color(shade,shade+.01,shade+.02,.96)
                for x=1,width do
                    local dx=math.max(r-(x-.5),(x-.5)-(width-r),0)
                    local dy=math.max(r-(y-.5),(y-.5)-(height-r),0)
                    local edge=r-math.sqrt(dx*dx+dy*dy)
                    edge=math.min(edge,x-.5,width-x+.5,y-.5,height-y+.5)
                    if edge>=2 then pixels[#pixels+1]=fill
                    else pixels[#pixels+1]=Color(.34,.37,.40,math.max(0,math.min(1,edge+.5))*.96) end
                end
            end
            self._T.hudPixels[key]=pixels
        end
        pixel:ResetWithColors(width,height,pixels) pixel.RaycastTarget=false
        _UILogic:SetSiblingIndex(tr,0)
        local sprite=entity.SpriteGUIRendererComponent
        sprite.Color=Color(1,1,1,0) sprite.DropShadow=false
        entity.ButtonComponent.Transition=TransitionType.None
        if not isvalid(entity.UITouchReceiveComponent) then entity:AddComponent("MOD.Core.UITouchReceiveComponent") end
        self._T.sharpHUDHandlers=self._T.sharpHUDHandlers or {}
        table.insert(self._T.sharpHUDHandlers,{entity=entity,enter=entity:ConnectEvent(UITouchEnterEvent,function() pixel:SetAlpha(1) end),leave=entity:ConnectEvent(UITouchExitEvent,function() pixel:SetAlpha(.96) end)})
        local icon=entity:GetChildByName("Icon")
        if isvalid(icon) then
            icon.UITransformComponent.anchoredPosition=Vector2(0,17)
            _RecoveryPotionManager:FitIcon(icon,icon.SpriteGUIRendererComponent.ImageRUID.DataId,46,46)
        end
    end

    @ExecSpace("ClientOnly")
    method void UpgradeTextTree(Entity entity)
        -- Preserve all layout and text bindings while replacing bitmap glyph rendering with SDF text.
        if not isvalid(entity) then return end
        local old=entity.TextComponent
        local text=entity.TextGUIRendererComponent
        if isvalid(old) and not isvalid(text) then
            text=entity:AddComponent("MOD.Core.TextGUIRendererComponent")
            if isvalid(text) then
                text.Text=old.Text text.FontSize=old.FontSize text.FontColor=old.FontColor
                text.FontStyle=old.Bold and FontStyleType.Bold or FontStyleType.Normal
                text.BestFit=old.BestFit text.MinSize=old.MinSize text.MaxSize=old.MaxSize
                text.Padding=old.Padding text.SizeFit=old.SizeFit
                local a=tonumber(old.Alignment) or 4
                text.HorizontalAlignment=({TextHorizontalAlignmentOption.Left,TextHorizontalAlignmentOption.Center,TextHorizontalAlignmentOption.Right})[a%3+1]
                text.VerticalAlignment=({TextVerticalAlignmentOption.Top,TextVerticalAlignmentOption.Middle,TextVerticalAlignmentOption.Bottom})[math.floor(a/3)+1]
                old.Enable=false
            end
        end
        for _,child in ipairs(entity.Children:ToTable()) do self:UpgradeTextTree(child) end
    end

    @ExecSpace("ClientOnly")
    method void ShadedTab(Entity entity, boolean selected)
        if not isvalid(entity) then return end
        local sprite = entity.SpriteGUIRendererComponent
        local transform = entity.UITransformComponent
        if not isvalid(sprite) or not isvalid(transform) then return end
        local gradient = entity.PixelGUIRendererComponent
        if not selected then
            if isvalid(gradient) then gradient.Enable = false end
            sprite.Color = Color(.13,.14,.15,1)
            return
        end
        if not isvalid(gradient) then gradient = entity:AddComponent("PixelGUIRendererComponent") end
        if not isvalid(gradient) then return end
        local width = math.max(1, math.floor(transform.RectSize.x + .5))
        local height = math.max(1, math.floor(transform.RectSize.y + .5))
        -- Cache at the actual tab size so compact/expanded tabs keep round corners.
        if gradient.Width ~= width or gradient.Height ~= height then
            local pixels = {}
            local radius = math.min(5, width / 2, height / 2)
            for y = 1, height do
                local fromTop = 1 - (y - 1) / math.max(1, height - 1)
                -- Upper sky blue fades into 82% black at the bottom edge.
                local shade = 1 - .82 * fromTop * fromTop
                local rowColor = Color(.48 * shade, .80 * shade, shade, 1)
                for x = 1, width do
                    local dx = math.max(radius - (x - .5), (x - .5) - (width - radius), 0)
                    local dy = math.max(radius - (y - .5), (y - .5) - (height - radius), 0)
                    local alpha = math.min(1, math.max(0, radius + .5 - math.sqrt(dx * dx + dy * dy)))
                    if alpha >= 1 then
                        pixels[#pixels + 1] = rowColor
                    else
                        pixels[#pixels + 1] = Color(.48 * shade, .80 * shade, shade, alpha)
                    end
                end
            end
            gradient:ResetWithColors(width, height, pixels)
        end
        gradient.RaycastTarget = false
        gradient.Enable = true
        -- Keep the existing sprite hit target; only its visual is replaced.
        sprite.Color = Color(1,1,1,0)
    end

    @ExecSpace("ClientOnly")
    method void Button(Entity entity, Color background)
        -- Rounded surfaces use tint and readable labels without a second outline.
        if not isvalid(entity) then return end
        if isvalid(entity.SpriteGUIRendererComponent) then
            entity.SpriteGUIRendererComponent.Color = background
            local outlined=string.find(entity.Path,"/ui/BossStage/",1,true)==1 or string.find(entity.Path,"/ui/MapleTutorial/",1,true)==1
            if entity.Path=="/ui/MapleTutorial/FirstGoal/Collapsed"
                or entity.Path=="/ui/MapleTutorial/Guide/Collapsed" then outlined=false end
            entity.SpriteGUIRendererComponent.Outline = outlined
            entity.SpriteGUIRendererComponent.OutlineWidth = outlined and 2 or 1
            entity.SpriteGUIRendererComponent.OutlineColor = outlined and Color.white or (background.r >= .2 and Color(.82,.96,.31,1) or Color(.32,.35,.38,1))
        end
        local foreground = background.r >= .2 and Color(.82,.96,.31,1) or Color(.88,.9,.92,1)
        self:Label(entity, foreground)
        for _, child in ipairs(entity.Children:ToTable()) do
            self:Label(child, foreground)
        end
    end

    @ExecSpace("ClientOnly")
    method void LightItem(Entity entity, boolean selected)
        -- Keep equipment rows pearl-white after paging, refreshing and selecting.
        if not isvalid(entity) then return end
        local sprite = entity.SpriteGUIRendererComponent
        if isvalid(sprite) then
            sprite.Color = Color.white
            sprite.Outline = selected
            sprite.OutlineWidth = 2
            sprite.OutlineColor = Color(.48,.80,1,1)
        end
        local ink = Color(.12,.15,.18,1)
        self:Label(entity, ink)
        for _, child in ipairs(entity.Children:ToTable()) do self:Label(child, ink) end
    end

    @ExecSpace("ClientOnly")
    method void Label(Entity entity, Color foreground)
        -- Both legacy windows and newer mobile windows use the same palette.
        local legacy = entity:GetComponent("MOD.Core.TextComponent")
        local text = entity.TextGUIRendererComponent
        if isvalid(legacy) then legacy.FontColor = foreground end
        if isvalid(text) then text.FontColor = foreground end
    end

    @ExecSpace("ClientOnly")
    method void Appearance(Entity root, boolean ingame)
        -- The dye window is shared with character creation: restore its original colors there.
        if not isvalid(root) then return end
        if self._T.appearance == nil then
            self._T.appearance = {}
            self:CacheAppearance(root)
        end
        if self._T.appearanceIngame == ingame then return end
        for _, entry in ipairs(self._T.appearance) do
            local entity = entry.entity
            if isvalid(entity) then
                if entry.background ~= nil then
                    local c = entry.background
                    entity.SpriteGUIRendererComponent.Color = ingame and Color(.12,.13,.14,c.a) or c
                    if entity == root then
                        entity.SpriteGUIRendererComponent.ImageRUID = ingame and "94f5a064b40741b6947b644ebecaa28e" or entry.image
                        entity.SpriteGUIRendererComponent.Color = ingame and Color(1,1,1,c.a) or c
                    end
                    if not ingame then
                        entity.SpriteGUIRendererComponent.Outline = entry.outline
                        entity.SpriteGUIRendererComponent.OutlineWidth = entry.outlineWidth
                        entity.SpriteGUIRendererComponent.OutlineColor = entry.outlineColor
                    end
                end
                if entry.foreground ~= nil then
                    entity.TextGUIRendererComponent.FontColor = ingame and (entity.Name == "Title" and Color(.82,.96,.31,1) or Color(.88,.9,.92,entry.foreground.a)) or entry.foreground
                end
            end
        end
        self._T.appearanceIngame = ingame
        if Environment:IsMakerPlay() then log("[VRF] UITheme appearance ingame="..tostring(ingame)) end
    end

    @ExecSpace("ClientOnly")
    method void CacheAppearance(Entity entity)
        -- Cache only chrome colors, preserving swatches, spectrum and preview artwork.
        if entity.Name == "Swatch" or entity.Name == "Spectrum" or entity.Name == "Preview" or entity.Name == "Icon" then return end
        local entry = {entity=entity}
        local sprite = entity.SpriteGUIRendererComponent
        if isvalid(sprite) then
            local c = sprite.Color
            entry.image = sprite.ImageRUID
            entry.outline = sprite.Outline
            entry.outlineWidth = sprite.OutlineWidth
            entry.outlineColor = sprite.OutlineColor
            if (c.r > c.b+.025 and c.g > c.b+.012 and c.r >= c.g-.015) or (isvalid(entity.ButtonComponent) and c.g > c.r+.03) then entry.background = c end
        end
        local text = entity.TextGUIRendererComponent
        if isvalid(text) then
            local c = text.FontColor
            if c.r > c.b+.025 and c.g > c.b+.012 and c.r >= c.g-.015 then entry.foreground = c end
        end
        if entry.background ~= nil or entry.foreground ~= nil then table.insert(self._T.appearance,entry) end
        for _, child in ipairs(entity.Children:ToTable()) do self:CacheAppearance(child) end
    end
    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _,h in ipairs(self._T.sharpHUDHandlers or {}) do
            if isvalid(h.entity) then
                h.entity:DisconnectEvent(UITouchEnterEvent,h.enter)
                h.entity:DisconnectEvent(UITouchExitEvent,h.leave)
            end
        end
        self._T.sharpHUDHandlers=nil
    end

end
