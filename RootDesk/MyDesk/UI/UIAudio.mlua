@Logic
script UIAudio extends Logic
    property string EnchantSuccessRUID = "79fdb64c408345518e9d36aca6442271"
    property string EnchantFailureRUID = "89eab4f303d84f6cb459578fb48c7979"
    property string StarforceRUID = "569cf9d6398f4edcb365fb57d63cb053"
    property string BtMouseClickRUID = "bee470ada92e499e8427439d27af2cb1"
    property string BtMouseOverRUID = "89ffed1f53df4c35b251a05e96332f65"
    property string CharSelectRUID = "87dcf9a6a4eb4625b85d77ca39d73305"
    property string DlgNoticeRUID = "64417f4db58d45fe9b02e469c05ef5e3"
    property string DragEndRUID = "628a464e5e9c4a7898b738110811ac0c"
    property string DragStartRUID = "c3c8f63852b84afa98b112739cf4b040"
    property string MenuDownRUID = "78000d0322f543aaa76bbcf0c6634f25"
    property string MenuUpRUID = "31db4dafc6fc4ece88c335888141cc83"
    property string NxLogoRUID = "6d6b7d04c5d246f3b9a8165579b58b2f"
    property string RollDownRUID = "72cda6a8c5a64fc48da70115ce4114df"
    property string RollUpRUID = "130cb0e17125452fb988184e9455660a"
    property string ScrollUpRUID = "9074e2c6e92949b0a408b1efccf182f4"
    property string ShopBgmRUID = "1afe2d3a08e74abdb0e9fed81b86bf55"
    property string TabRUID = "f9eca351980a438a95c423c09c15c0a2"
    property string TitleRUID = "43c1251a518c472e9ff44f96d0ccce99"
    property string WorldSelectRUID = "014135a4dbcb4e59ba20f261c11e5209"
    property string WorldmapCloseRUID = "41a7b8a125874e72abbd9e35efb2d3f8"
    property string WorldmapOpenRUID = "9bd77894b15f4c10942916a074183aa2"
    property string WzLogoRUID = "79552dfa044c4932b2a5fb899799b9bc"

    @ExecSpace("ClientOnly")
    method table Clips()
        return {EnchantSuccess=self.EnchantSuccessRUID, EnchantFailure=self.EnchantFailureRUID, Starforce=self.StarforceRUID, BtMouseClick=self.BtMouseClickRUID, BtMouseOver=self.BtMouseOverRUID, CharSelect=self.CharSelectRUID, DlgNotice=self.DlgNoticeRUID, DragEnd=self.DragEndRUID, DragStart=self.DragStartRUID, MenuDown=self.MenuDownRUID, MenuUp=self.MenuUpRUID, NxLogo=self.NxLogoRUID, RollDown=self.RollDownRUID, RollUp=self.RollUpRUID, ScrollUp=self.ScrollUpRUID, ShopBgm=self.ShopBgmRUID, Tab=self.TabRUID, Title=self.TitleRUID, WorldSelect=self.WorldSelectRUID, WorldmapClose=self.WorldmapCloseRUID, WorldmapOpen=self.WorldmapOpenRUID, WzLogo=self.WzLogoRUID}
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.links = {}
        self._T.bound = {}
        self._T.windows = {}
        self._T.weights = {Title=0, ShopBgm=0}
        self._T.playing = {}
        self._T.mapGain = 1
        self._T.time = 0
        self._T.pending = self._T.pending or {}
        local preload = {}
        for name, id in pairs(self:Clips()) do
            local e = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
            if isvalid(e) and id ~= "" then
                e.SoundComponent.AudioClipRUID = "" e.SoundComponent.AudioClipRUID = id
                table.insert(preload, id)
            end
        end
        if #preload > 0 then _ResourceService:PreloadAsync(preload, function() log("[UIAudio] clips preloaded=" .. tostring(#preload)) end) end
        self._T.bindTimer = _TimerService:SetTimerOnce(self.BindButtons, 0.5)
        log("[UIAudio] initialized")
    end

    @ExecSpace("ClientOnly")
    method void Play(string name)
        local id = self:Clips()[name]
        if id == nil or id == "" then return end
        -- 여러 UI 콜백이 같은 클릭을 전달해도 한 번만 재생한다.
        self._T.lastCue = self._T.lastCue or {}
        local now = _UtilLogic.ElapsedSeconds
        if now - (self._T.lastCue[name] or -10) < 0.04 then return end
        self._T.lastCue[name] = now
        local entity = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
        if not isvalid(entity) then return end
        if entity.SoundComponent.AudioClipRUID ~= id then entity.SoundComponent.AudioClipRUID = "" entity.SoundComponent.AudioClipRUID = id end
        if not entity.SoundComponent:IsAudioClipLoaded() then
            self._T.pending = self._T.pending or {}
            self._T.pending[name] = now + 3
            return
        end
        _GameAudio:PlayCue(name)
    end

    @ExecSpace("ClientOnly")
    method void BindButtons()
        local root = _EntityService:GetEntityByPath("/ui")
        if not isvalid(root) then return end
        for _, button in ipairs(root:GetChildComponentsByTypeName("MOD.Core.ButtonComponent", true)) do
            local entity = button.Entity
            if not self._T.bound[entity] then
                self._T.bound[entity] = true
                local click = entity:ConnectEvent(ButtonClickEvent, function()
                    if button.EnableInHierarchy then self:Play("BtMouseClick") end
                end)
                local hovering = false
                local hover = entity:ConnectEvent(ButtonStateChangeEvent, function(event)
                    if event.state == ButtonState.Normal then hovering = false end
                    if event.state == ButtonState.Hover and not hovering and button.EnableInHierarchy then
                        hovering = true self:Play("BtMouseOver")
                    end
                end)
                table.insert(self._T.links, {entity=entity, click=click, hover=hover})
            end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean IsOpen(string path)
        local e = _EntityService:GetEntityByPath(path)
        return isvalid(e) and e.EnabledInHierarchy
    end

    @ExecSpace("ClientOnly")
    method void Watch(string path, string openCue, string closeCue, boolean audible)
        local value = self:IsOpen(path)
        local old = self._T.windows[path]
        self._T.windows[path] = value
        if old ~= nil and old ~= value then
            if value then self:BindButtons() end
            if audible then self:Play(value and openCue or closeCue) end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        if self._T.weights == nil then return end
        self._T.time = self._T.time + delta
        for name, deadline in pairs(self._T.pending or {}) do
            local e = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
            if isvalid(e) and e.SoundComponent:IsAudioClipLoaded() then
                self._T.pending[name] = nil _GameAudio:PlayCue(name)
            elseif _UtilLogic.ElapsedSeconds > deadline then self._T.pending[name] = nil end
        end
        local inGame = _LoginFlow.phase == "ingame"
        local equipPath, decoPath = "/ui/DefaultGroup/EquipWindow", "/ui/DefaultGroup/DecoWindow"
        local swappingEquip = (self._T.windows[equipPath] == true and not self:IsOpen(equipPath) and self:IsOpen(decoPath)) or (self._T.windows[decoPath] == true and not self:IsOpen(decoPath) and self:IsOpen(equipPath))
        if swappingEquip and inGame then self:Play("Tab") end
        for _, name in ipairs({"EquipWindow", "InvenWindow", "EnhanceWindow", "CharInfoWindow", "SkillWindow", "KeySettingWindow", "BattleStatsWindow", "DecoWindow", "CashShopWindow"}) do
            self:Watch("/ui/DefaultGroup/" .. name, "MenuUp", "MenuDown", inGame and not (swappingEquip and (name == "EquipWindow" or name == "DecoWindow")))
        end
        -- Confirmation dialogs previously bypassed the normal window sound hooks.
        for _, path in ipairs({
            "/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog",
            "/ui/DefaultGroup/BattleStatsWindow/ConfirmDialog",
            "/ui/DefaultGroup/QuickSlotDialog",
            "/ui/DefaultGroup/ItemTypeSelectPopup",
            "/ui/DefaultGroup/BoxQuantityPopup",
            "/ui/PopupGroup/PopupBack"
        }) do
            self:Watch(path, "DlgNotice", "", inGame)
        end
        self:Watch("/ui/InformationBook/Book", "MenuUp", "MenuDown", inGame)
        self:Watch("/ui/WorldMapGroup", "WorldmapOpen", "WorldmapClose", inGame)
        self:Watch("/ui/GameSystem/Overlay", "MenuUp", "MenuDown", inGame)
        local equip = _UIEquipInventoryManager
        local sk = _SkillManager._T
        local dragging = equip.isDragging or equip._T.isDraggingPotion == true or equip._T.isDraggingEquipToEnhance == true or equip._T.isDraggingInvenItem == true or sk.isDraggingSkill == true or sk.skillClickMode == true
        if self._T.dragging ~= nil and self._T.dragging ~= dragging and inGame then
            -- Dropping outside opens a confirmation; its release sound belongs to Confirm.
            if dragging then self:Play("DragStart")
            elseif not _UIItemDiscardManager.pending then self:Play("DragEnd") end
        end
        self._T.dragging = dragging
        local shop = inGame and self:IsOpen("/ui/DefaultGroup/CashShopWindow")
        local title = _LoginFlow.phase ~= "intro" and not inGame and not (_LoginFlow.phase == "character" and _LoginFlow.busy)
        local ids = self:Clips()
        local targets = {Title=(title and ids.Title ~= "") and 1 or 0, ShopBgm=(shop and ids.ShopBgm ~= "") and 1 or 0}
        for _, name in ipairs({"Title", "ShopBgm"}) do
            local weight = self._T.weights[name]
            local target = targets[name]
            local nextWeight = target > weight and math.min(target, weight + delta / 1.2) or math.max(target, weight - delta / 1.2)
            self._T.weights[name] = nextWeight
            local e = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
            if isvalid(e) then
                local sound = e.SoundComponent
                sound.Volume = nextWeight * _GameAudio.bgmVolume * (name == "Title" and 0.8 or 1)
                if nextWeight > 0 and not self._T.playing[name] and sound:IsAudioClipLoaded() then sound:Play() self._T.playing[name] = true end
                if nextWeight == 0 and self._T.playing[name] then sound:Stop() self._T.playing[name] = false end
            end
        end
        self._T.mapGain = math.max(0, 1 - self._T.weights.Title - self._T.weights.ShopBgm)
        local volume = self._T.mapGain * _GameAudio.bgmVolume * (_GameAudio._T.duck or 1)
        if self._T.musicVolume ~= volume then _SoundService:SetBGMVolume(volume) self._T.musicVolume = volume end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self._T.bindTimer then _TimerService:ClearTimer(self._T.bindTimer) end
        for _, link in ipairs(self._T.links or {}) do
            if isvalid(link.entity) then
                link.entity:DisconnectEvent(ButtonClickEvent, link.click)
                link.entity:DisconnectEvent(ButtonStateChangeEvent, link.hover)
            end
        end
    end
end
