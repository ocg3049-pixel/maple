@Logic
@ExecSpace("ClientOnly")
script BuffBarManager extends Logic

	-- 버프 아이콘을 우측 정렬하되, 남은 시간이 많은 버프일수록 더 우측(화면 가장자리)에 오도록 재배치한다.
	-- 새로 사용한 스킬의 남은 시간이 기존 버프보다 많으면, 기존 버프들은 왼쪽으로 밀려난다.

	method void OnBeginPlay()
		if not self:IsClient() then return end
		-- 등록된 버프 목록 - 새 버프 UI를 추가할 때 이 표에 한 줄만 추가하면 된다.
		-- cancel = (요청) 아이콘 우클릭 시 그 버프/스킬을 즉시 중단하는 처리. 클라 표시(HideBuff)와
		-- 클라 전용 스탯 정리(CharInfoManager)는 여기서, 서버 상태는 SkillManager.RequestCancelBuff로 정리한다.
		self._T.buffList = {
			{ path = "/ui/DefaultGroup/BuffBar/HasteIcon",       getRemaining = function() return _HasteBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("haste"); _HasteBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/BoosterIcon",     getRemaining = function() return _BoosterBuffUI:GetRemaining() end,
				cancel = function() _CharInfoManager:CancelBooster(); _BoosterBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/ComboAttackIcon", getRemaining = function() return _ComboBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("combo"); _ComboBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/ShadowPartnerIcon", getRemaining = function() return _ShadowPartnerBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("shadowpartner"); _ShadowPartnerBuffUI:HideBuff() end },
			-- 가드: (팔라딘 개편) 10초 피해 50% 감소 버프 - 취소 시 서버 감소 창도 닫는다.
			{ path = "/ui/DefaultGroup/BuffBar/GuardIcon",       getRemaining = function() return _GuardBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("guardshield"); _GuardBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/IronWallIcon",    getRemaining = function() return _IronWallBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("ironwall"); _IronWallBuffUI:HideBuff() end },
			-- 리스토네이션(요청 2026-08-12): 5초짜리 지속 회복 - 우클릭 취소는 **표시만** 내린다.
			-- 서버 회복 예약(PlayerAttack의 restorationToken)까지 끊을 만한 길이가 아니라 패링과 같은 처리다.
			{ path = "/ui/DefaultGroup/BuffBar/RestorationIcon", getRemaining = function() return _RestorationBuffUI:GetRemaining() end,
				cancel = function() _RestorationBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/ElemFieldIcon",   getRemaining = function() return _ElemFieldBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("elemfield"); _ElemFieldBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/ParryIcon",       getRemaining = function() return _ParryBuffUI:GetRemaining() end,
				cancel = function() _ParryBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/RageIcon",        getRemaining = function() return _RageBuffUI:GetRemaining() end,
				cancel = function() _CharInfoManager:CancelAttackBuff("rage"); _RageBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/MeditationIcon",  getRemaining = function() return _MeditationBuffUI:GetRemaining() end,
				-- (요청 2026-08-14) 메디테이션이 실효 버프 통으로 옮겨졌다 - 다만 다크드래곤이 걸어주는
				-- 메디테이션(+30/30초)은 여전히 공용 통에 있으므로 취소는 두 경로를 모두 불러야 완전히 꺼진다.
				cancel = function() _CharInfoManager:CancelRealBuff("meditation"); _CharInfoManager:CancelAttackBuff("meditation"); _MeditationBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/BlessIcon",       getRemaining = function() return _BlessBuffUI:GetRemaining() end,
				-- (신고 수정 2026-08-13) 블레스가 전용 통(blessAttackBonus/blessStatBonus)으로 옮겨지면서
				-- 취소도 전용 경로 하나(CancelBless)로 통일됐다 - 종전엔 공마/4스탯 두 경로를 함께 불렀다.
				cancel = function() _CharInfoManager:CancelBless(); _BlessBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/PowerGuardIcon",  getRemaining = function() return _PowerGuardBuffUI:GetRemaining() end,
				cancel = function() _CharInfoManager:CancelAttackBuff("powerguard"); _SkillManager:RequestCancelBuff("powerguard"); _PowerGuardBuffUI:HideBuff() end },
				{ path = "/ui/DefaultGroup/BuffBar/DragonRidingIcon", getRemaining = function() return _DragonRidingBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelDragonRideEarly() end },
			{ path = "/ui/DefaultGroup/BuffBar/HeroSummonIcon",  getRemaining = function() return _HeroSummonBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("herosummon"); _HeroSummonBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/DragonBloodIcon", getRemaining = function() return _DragonBloodBuffUI:GetRemaining() end,
				cancel = function() _CharInfoManager:CancelAttackBuff("dragonblood"); _SkillManager:RequestCancelBuff("dragonblood"); _DragonBloodBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/SixDragonsIcon",  getRemaining = function() return _SixDragonsBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("sixdragons"); _SixDragonsBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/HealerSummonIcon", getRemaining = function() return _HealerSummonBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("healersummon"); _HealerSummonBuffUI:HideBuff() end },
			-- 서먼 다크드래곤: 서버가 드래곤 개체를 전부 제거하고, 클라는 활성 창을 지워 재시전이 막히지
			-- 않게 한다(재사용 대기시간 10분은 그대로 남는다).
			{ path = "/ui/DefaultGroup/BuffBar/DarkDragonIcon", getRemaining = function() return _DarkDragonBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("darkdragon"); _SkillManager:ClearDarkDragonActive(); _DarkDragonBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/FireZoneIcon",    getRemaining = function() return _FireZoneBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("firezone"); _FireZoneBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/GlacierIcon",     getRemaining = function() return _GlacierBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("glacier"); _GlacierBuffUI:HideBuff() end },
			-- 발도술: 서버 버프 창 + 진행 중 중첩 프록 정리는 서버(CancelBattojutsu)가 하고(중첩 공격력/크확은
			-- NotifyBattoProcEnd로 원복), 기본 사용 효과인 공속 +1단계는 클라 전용이라 여기서 직접 되돌린다.
			{ path = "/ui/DefaultGroup/BuffBar/BattojutsuIcon", getRemaining = function() return _BattoBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("battojutsu"); _CharInfoManager:CancelBattoAtkSpeed(); _BattoBuffUI:HideBuff() end },
			-- 다크사이트: 해제 절차(버프바 내리기 + 스탯 보정 원복 + 서버 통보)가 스킬 재사용과 완전히
			-- 같으므로 SkillManager.CancelDarkSightEarly 하나로 위임한다(쿨타임은 걸리지 않는다).
			{ path = "/ui/DefaultGroup/BuffBar/DarkSightIcon", getRemaining = function() return _DarkSightBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelDarkSightEarly() end },
			-- 각성: 해제 절차(버프바 내리기 + 공속 원복 + 서버 상태 종료)가 SkillManager 한 곳에 모여 있다
			-- (이미 걸린 재사용 대기시간 5분은 취소해도 그대로 남는다).
			{ path = "/ui/DefaultGroup/BuffBar/AwakeningIcon", getRemaining = function() return _AwakeningBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelAwakeningEarly() end },
			-- 암행: 해제 절차(버프바 내리기 + 클라 상태 + 서버 스위치 끄기)가 SkillManager 한 곳에 모여 있다.
			{ path = "/ui/DefaultGroup/BuffBar/AmhaengIcon", getRemaining = function() return _AmhaengBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelAmhaengEarly() end },
			-- 암행2(3차): 암행1과 완전히 같은 구조의 지속시간 버프 - 서로 독립이라 아이콘도 따로 뜬다.
			{ path = "/ui/DefaultGroup/BuffBar/Amhaeng2Icon", getRemaining = function() return _Amhaeng2BuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelAmhaeng2Early() end },
			-- 분신 소환(1차): 지속 30초~5분 - 우클릭 취소하면 분신을 즉시 없앤다(재사용 대기시간은 유지).
			{ path = "/ui/DefaultGroup/BuffBar/ShadowCloneIcon", getRemaining = function() return _ShadowCloneBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelShadowCloneEarly() end },
			-- 연막(4차): 지속시간 표시 전용 - 우클릭 취소는 서버 연막까지 걷어야 하므로 SkillManager에 위임한다
			-- (이미 걸린 재사용 대기시간 3분은 취소해도 그대로 남는다).
			{ path = "/ui/DefaultGroup/BuffBar/SmokeScreenIcon", getRemaining = function() return _SmokeScreenBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelSmokeScreenEarly() end },
			-- 샤프 아이즈(신궁 4차): 지속 30초~5분 20초 - 해제 절차(스탯 원복 + 버프바 내리기 + 서버
			-- 크확/크뎀 재동기화)가 SkillManager 한 곳에 모여 있다.
			{ path = "/ui/DefaultGroup/BuffBar/SharpEyesIcon", getRemaining = function() return _SharpEyesBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:CancelSharpEyesEarly() end },
			-- (2026-08-07) 마크 오브 어쌔신 항목은 스킬이 "트레이닝"(순수 공격력 패시브)으로 바뀌면서
			-- 제거했다(MarkBuffUI / BuffBar/MarkIcon도 함께 삭제).
			-- 표창 분산: 무기한 토글 - 우클릭 취소 = 토글 OFF(SkillManager 공용 경로).
			{ path = "/ui/DefaultGroup/BuffBar/StarSpreadIcon", getRemaining = function() return _StarSpreadBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:SetStarSpreadEnabled(false) end },
			-- 바하뮤트(비숍 4차 소환, 2026-08-08): 지속시간이 투자 레벨로 정해지면서 남은 시간 표시가 생겼다.
			-- 우클릭 취소는 서버 소환수까지 걷어야 하므로 SkillManager에 위임한다(재사용 30초는 그대로 남는다).
			{ path = "/ui/DefaultGroup/BuffBar/BahamutIcon", getRemaining = function() return _BahamutBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("bahamut"); _BahamutBuffUI:HideBuff() end },
			-- 이프리트(불독 4차) / 엘퀴네스(썬콜 4차): 지속 10분 소환수 - 바하뮤트와 같은 규격의
			-- 아이콘/취소(우클릭 = 서버 소환수 해제, 재사용 30초는 그대로 남는다). (요청 2026-08-11)
			{ path = "/ui/DefaultGroup/BuffBar/IfritIcon", getRemaining = function() return _IfritBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("ifrit"); _IfritBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/ElquinesIcon", getRemaining = function() return _ElquinesBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("elquines"); _ElquinesBuffUI:HideBuff() end },
			-- 도적 소환(비숍 2차) / 궁수 소환(비숍 4차): 용사 소환과 완전히 같은 규격이라 아이콘도 같은 구조다.
			-- 셋은 독립 슬롯이라 동시에 세 개가 떠 있을 수 있고, 취소도 각자 자기 계통만 해제한다.
			{ path = "/ui/DefaultGroup/BuffBar/ArcherSummonIcon", getRemaining = function() return _ArcherSummonBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("archersummon"); _ArcherSummonBuffUI:HideBuff() end },
			{ path = "/ui/DefaultGroup/BuffBar/ThiefSummonIcon", getRemaining = function() return _ThiefSummonBuffUI:GetRemaining() end,
				cancel = function() _SkillManager:RequestCancelBuff("thiefsummon"); _ThiefSummonBuffUI:HideBuff() end },
		}
		self._T.timerId = _TimerService:SetTimerRepeat(self.Reorder, 0.1)
		-- (요청) 버프 아이콘 우클릭 취소. PC 우클릭은 ScreenTouchEvent(TouchId=2는 모바일 두 손가락)가
		-- 아니라 KeyDownEvent(KeyboardKey.Mouse1)로만 온다(프로젝트 공통 규칙).
		self._T.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent e)
		-- 우클릭이면 커서 위치를 UI 좌표(중앙 원점 1920×1080)로 바꿔 아이콘 판정에 넘긴다.
		if e.key ~= KeyboardKey.Mouse1 then return end
		local cursor = _InputService:GetCursorPosition()
		self:CancelBuffAt(cursor.x - 960, cursor.y - 540)
	end

	@ExecSpace("ClientOnly")
	method void CancelBuffAt(number cx, number cy)
		-- (cx, cy) = 중앙 원점 UI 좌표. 활성 버프 아이콘 위면 그 버프를 취소한다.
		-- 아이콘 절대 좌표: BuffBar는 우상단 앵커/피벗(1,1)에 오프셋 (-20,-20), 크기 120×56이라
		-- 중심이 (880, 492)다. 각 아이콘은 BuffBar 중앙 앵커 기준 anchoredPosition.x(Reorder가 재배치)에
		-- 놓이므로 아이콘 중심 = (880 + x, 492), 크기 56×56 → 반경 28로 판정한다.
		for _, b in ipairs(self._T.buffList) do
			if b.getRemaining() > 0 then
				local ent = _EntityService:GetEntityByPath(b.path)
				if isvalid(ent) then
					local iconX = 880 + ent.UITransformComponent.anchoredPosition.x
					local iconY = 492
					if math.abs(cx - iconX) <= 28 and math.abs(cy - iconY) <= 28 then
						log("[BuffBarManager] 버프 아이콘 우클릭 취소: " .. b.path)
						b.cancel()
						return
					end
				end
			end
		end
	end

	method void Reorder()
		local active = {}
		for _, b in ipairs(self._T.buffList) do
			local remaining = b.getRemaining()
			if remaining > 0 then
				table.insert(active, { path = b.path, remaining = remaining })
			end
		end

		table.sort(active, function(a, b) return a.remaining > b.remaining end)

		local slotWidth = 60
		for i, b in ipairs(active) do
			local ent = _EntityService:GetEntityByPath(b.path)
			if isvalid(ent) then
				local ut = ent.UITransformComponent
				local x = -(28 + (i - 1) * slotWidth)
				ut.anchoredPosition = Vector2(x, ut.anchoredPosition.y)
			end
		end
	end

	method void OnEndPlay()
		if self._T.timerId then
			_TimerService:ClearTimer(self._T.timerId)
		end
		if self._T.keyHandler then
			_InputService:DisconnectEvent(KeyDownEvent, self._T.keyHandler)
		end
	end

end
