@Logic
@ExecSpace("ClientOnly")
script Amhaeng2BuffUI extends Logic

	-- 암행2(섀도어 3차) 버프 지속시간 표시. AmhaengBuffUI(암행1)의 정확한 복제 - 버프바 아이콘 위에
	-- 회색 오버레이가 차오르고 남은 시간이 숫자로 뜬다. 최대 4분 10초짜리라 60초 이상이면 "분" 단위
	-- (노란색)로, 60초 미만이면 초 단위로 표시한다. UUID는 UIBuilder가 write bind로 주입한다.
	--
	-- ⚠ 암행1과 **별개의 아이콘**이다 - 두 버프는 서로 독립이라 동시에 켜져 있을 수 있고, 그때
	--   버프바에 두 칸이 따로 떠야 한다(BuffBarManager가 남은 시간 순으로 정렬한다).

	property Entity buffIconGroup = "1c6255a8-4c64-4293-9a18-ee50064a0585"
	property SpriteGUIRendererComponent grayOverlay = "5ae644fa-d371-4d64-9e8c-88bd67ce840c"
	property TextComponent countdownText = "80d2098b-3430-4924-a59f-ce0fbc7feb23"

	method void ShowBuff(number duration)
		-- 암행2 버프 타이머 표시/갱신. 이미 표시 중이어도 새 타이머로 교체되므로 지속시간만 갱신되고
		-- 아이콘이 중첩되지는 않는다(항상 하나의 아이콘/카운트다운만 존재).
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.am2TotalDuration = duration
		self._T.am2Remaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.am2TimerId then
			_TimerService:ClearTimer(self._T.am2TimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.am2TimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.am2Remaining = self._T.am2Remaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
		log("[Amhaeng2BuffUI] 버프 표시 시작 duration=" .. tostring(duration))
	end

	method void UpdateBuffDisplay()
		-- 매 프레임 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃을 갱신한다.
		local remaining = self._T.am2Remaining
		local total = self._T.am2TotalDuration

		if remaining <= 0 then
			if self._T.am2TimerId then
				_TimerService:ClearTimer(self._T.am2TimerId)
				self._T.am2TimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(1, 1, 1, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				-- 분 단위 표시일 때는 "분" 글자 없이 숫자만, 노란색으로 표시한다(다른 버프 UI와 같은 규칙).
				self.countdownText.FontColor = Color(1, 1, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	method void OnEndPlay()
		-- 타이머 정리 (연결 해제 필수 규칙).
		if self._T.am2TimerId then
			_TimerService:ClearTimer(self._T.am2TimerId)
		end
	end

	method number GetRemaining()
		-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
		return self._T.am2Remaining or 0
	end

	method void HideBuff()
		-- (버프 아이콘 우클릭 취소 / 만료) 표시를 즉시 정리한다 - 남은 시간 0으로 만들어 종료 경로를 태운다.
		self._T.am2Remaining = 0
		self:UpdateBuffDisplay()
	end

end
