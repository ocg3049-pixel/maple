@Logic
@ExecSpace("ClientOnly")
script BlizzardScreenDim extends Logic

	-- 블리자드 시전 시 "맵 전체가 서서히 조금 어두워졌다가 15초 뒤 서서히 밝아지는" 연출.
	-- 화면 전체를 덮는 검은 UI 스프라이트의 알파를 직접 트윈한다. UI 그룹의 형제들 중 맨 뒤(sibling 0)로
	-- 보내두어 HUD/퀵슬롯 같은 UI는 어두워지지 않고 월드(맵)만 어두워 보이게 한다.

	property SpriteGUIRendererComponent dimSprite = "ffdda413-5cf0-4545-8df5-d68661a37939"

	method void OnBeginPlay()
		if not self:IsClient() then return end
		local ent = self:GetDimEntity()
		if not isvalid(ent) then return end
		-- 다른 UI(HUD/스킬바/창)보다 뒤에 그려지도록 형제들 중 맨 앞 인덱스로 보낸다.
		_UILogic:SetSiblingIndex(ent.UITransformComponent, 0)
		self.dimSprite.Color = Color(0, 0, 0, 0)
		ent.Enable = false
		-- "timed"(블리자드/메테오/제네시스) ↔ "hold"(다크사이트) 두 사용 방식을 구분하는 모드.
		self._T.dimMode = "none"
	end

	method Entity GetDimEntity()
		if not isvalid(self.dimSprite) then return nil end
		return self.dimSprite.Entity
	end

	method void StartDim(number fadeInSeconds, number holdSeconds, number fadeOutSeconds, number maxAlpha)
		-- 어두워짐(fadeIn) → 유지(hold) → 밝아짐(fadeOut). 중복 시전 시 진행 중이던 트윈은 새 값으로 갱신된다.
		-- 기본은 순수 검정 오버레이(블리자드 원래 연출). 색을 입히려면 StartDimTinted를 쓴다.
		self:StartDimTinted(fadeInSeconds, holdSeconds, fadeOutSeconds, maxAlpha, 0, 0, 0)
	end

	method void StartDimTinted(number fadeInSeconds, number holdSeconds, number fadeOutSeconds, number maxAlpha, number r, number g, number b)
		-- (메테오 요청) 오버레이 색을 지정할 수 있는 버전 - 같은 트윈에 색만 다르게 쓴다.
		-- 예: 메테오는 미세하게 붉은 어두워짐(r=0.3, g/b≈0.03), 블리자드는 기존 그대로 검정(0,0,0).
		if not self:IsClient() then return end
		local ent = self:GetDimEntity()
		if not isvalid(ent) then return end

		-- 시간이 정해진 트윈(블리자드/메테오/제네시스)은 "유지 모드"(다크사이트)를 덮어쓴다.
		-- 이후 EndHoldDim이 들어와도 모드가 다르므로 아무 일도 하지 않아 이 트윈이 끝까지 재생된다.
		self._T.dimMode = "timed"
		self._T.fadeIn = math.max(fadeInSeconds, 0.01)
		self._T.hold = math.max(holdSeconds, 0.0)
		self._T.fadeOut = math.max(fadeOutSeconds, 0.01)
		self._T.maxAlpha = maxAlpha
		self._T.elapsed = 0.0
		self._T.dimR = r
		self._T.dimG = g
		self._T.dimB = b

		ent.Enable = true
		_UILogic:SetSiblingIndex(ent.UITransformComponent, 0)
		self.dimSprite.Color = Color(r, g, b, 0)

		if self._T.timerId then
			_TimerService:ClearTimer(self._T.timerId)
		end
		local preTime = _UtilLogic.ElapsedSeconds
		self._T.timerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self:Tick(delta)
		end, 1 / 60)
		log("[BlizzardScreenDim] 어두워짐 시작 hold=" .. tostring(holdSeconds) .. " maxAlpha=" .. tostring(maxAlpha))
	end

	method void StartHoldDim(number fadeInSeconds, number maxAlpha, number r, number g, number b)
		-- (다크사이트) 지속시간이 정해져 있지 않은 "유지 모드" - 서서히 어두워진 뒤 EndHoldDim이
		-- 불릴 때까지 그 밝기를 계속 유지한다. 시간이 정해진 StartDim/StartDimTinted와 같은
		-- 오버레이 스프라이트 하나를 공유하되, 모드 플래그로 서로를 침범하지 않게 구분한다.
		if not self:IsClient() then return end
		local ent = self:GetDimEntity()
		if not isvalid(ent) then return end

		self._T.dimMode = "hold"
		self._T.holdPhase = "in"
		self._T.fadeIn = math.max(fadeInSeconds, 0.01)
		self._T.maxAlpha = maxAlpha
		self._T.elapsed = 0.0
		self._T.dimR = r
		self._T.dimG = g
		self._T.dimB = b

		ent.Enable = true
		_UILogic:SetSiblingIndex(ent.UITransformComponent, 0)
		self.dimSprite.Color = Color(r, g, b, 0)

		if self._T.timerId then
			_TimerService:ClearTimer(self._T.timerId)
		end
		local preTime = _UtilLogic.ElapsedSeconds
		self._T.timerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self:Tick(delta)
		end, 1 / 60)
		log("[BlizzardScreenDim] 유지 모드 어두워짐 시작 maxAlpha=" .. tostring(maxAlpha))
	end

	method void EndHoldDim(number fadeOutSeconds)
		-- (다크사이트) 유지 모드를 끝내고 서서히 밝아진다. 그 사이 다른 스킬이 시간형 트윈을
		-- 시작해 오버레이를 가져갔으면(dimMode ~= "hold") 그 트윈을 끊지 않도록 아무 일도 하지 않는다.
		if not self:IsClient() then return end
		if self._T.dimMode ~= "hold" then return end
		local ent = self:GetDimEntity()
		if not isvalid(ent) then return end
		self._T.holdPhase = "out"
		self._T.fadeOut = math.max(fadeOutSeconds, 0.01)
		self._T.elapsed = 0.0
		-- 아직 다 어두워지지 않은 상태에서 풀릴 수도 있으므로, 지금 알파에서부터 밝아지게 한다.
		self._T.holdOutFrom = self.dimSprite.Color.a
		log("[BlizzardScreenDim] 유지 모드 밝아짐 시작 from=" .. tostring(self._T.holdOutFrom))
	end

	method void TickHold(number delta)
		-- 유지 모드 보간: 0 → maxAlpha(도달 후 계속 유지) → EndHoldDim 호출 시 0.
		local ent = self:GetDimEntity()
		if not isvalid(ent) then return end
		self._T.elapsed = self._T.elapsed + delta
		local e = self._T.elapsed
		local dr = self._T.dimR or 0
		local dg = self._T.dimG or 0
		local db = self._T.dimB or 0
		local maxA = self._T.maxAlpha or 0

		if self._T.holdPhase == "in" then
			local alpha = maxA
			if e < self._T.fadeIn then
				alpha = maxA * (e / self._T.fadeIn)
			else
				self._T.holdPhase = "hold"
			end
			self.dimSprite.Color = Color(dr, dg, db, alpha)
			return
		end
		if self._T.holdPhase == "hold" then
			self.dimSprite.Color = Color(dr, dg, db, maxA)
			return
		end
		-- "out": 밝아짐 완료 시 타이머 정리 후 오버레이를 끈다.
		local fadeOut = self._T.fadeOut or 0.01
		local from = self._T.holdOutFrom or maxA
		if e < fadeOut then
			self.dimSprite.Color = Color(dr, dg, db, from * (1.0 - e / fadeOut))
			return
		end
		if self._T.timerId then
			_TimerService:ClearTimer(self._T.timerId)
			self._T.timerId = nil
		end
		self._T.dimMode = "none"
		self.dimSprite.Color = Color(dr, dg, db, 0)
		ent.Enable = false
		log("[BlizzardScreenDim] 유지 모드 밝아짐 완료")
	end

	method void Tick(number delta)
		-- 경과 시간에 따라 알파를 0 → maxAlpha → 0 으로 보간한다.
		local ent = self:GetDimEntity()
		if not isvalid(ent) then return end
		if self._T.dimMode == "hold" then
			self:TickHold(delta)
			return
		end
		self._T.elapsed = self._T.elapsed + delta
		local e = self._T.elapsed
		local fadeIn = self._T.fadeIn
		local hold = self._T.hold
		local fadeOut = self._T.fadeOut
		local maxA = self._T.maxAlpha

		-- 오버레이 색(기본 검정, StartDimTinted로 지정 가능 - 메테오는 미세한 붉은색).
		local dr = self._T.dimR or 0
		local dg = self._T.dimG or 0
		local db = self._T.dimB or 0

		local alpha = 0.0
		if e < fadeIn then
			alpha = maxA * (e / fadeIn)
		elseif e < fadeIn + hold then
			alpha = maxA
		elseif e < fadeIn + hold + fadeOut then
			alpha = maxA * (1.0 - (e - fadeIn - hold) / fadeOut)
		else
			-- 끝: 타이머 정리 후 완전히 끈다.
			if self._T.timerId then
				_TimerService:ClearTimer(self._T.timerId)
				self._T.timerId = nil
			end
			self.dimSprite.Color = Color(dr, dg, db, 0)
			ent.Enable = false
			log("[BlizzardScreenDim] 밝아짐 완료")
			return
		end
		self.dimSprite.Color = Color(dr, dg, db, alpha)
	end

	method void OnEndPlay()
		if self._T.timerId then
			_TimerService:ClearTimer(self._T.timerId)
		end
	end

end
