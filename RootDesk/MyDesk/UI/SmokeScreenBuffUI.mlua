@Logic
@ExecSpace("ClientOnly")
script SmokeScreenBuffUI extends Logic

	-- 연막(4차 버프) 버프바 아이콘. DarkSightBuffUI 복제 - UUID는 UIBuilder가 write bind로 주입한다.
	-- (신고 2026-08-06) 개편 전에는 지속시간이 어디에도 표시되지 않아 "연막이 언제 걷히는지 모르겠다"는
	-- 지적이 있었다. 우측 상단 버프바에 남은 시간을 띄운다.
	--
	-- ⚠ 여기서 보여주는 시간은 **효과가 실제로 살아있는 시간**이다 - 서버(PlayerAttack.AttackSmokeScreenLv)가
	--   smokeScreenUntil을 "시전 모션(0.6×공속) + 생성 지연 0.5초 + 지속시간"으로 잡으므로 SkillManager도
	--   같은 값을 넘긴다(연기가 눈에 보이기 전부터 MISS/백스탭 효과는 이미 켜져 있다).
	property Entity buffIconGroup = "eee84f84-8162-4804-9f24-d1f43fb432d7"
	property SpriteGUIRendererComponent grayOverlay = "54248cd7-5831-4b05-bbee-b1a98cdbea32"
	property TextComponent countdownText = "786f37d6-b470-40d9-9145-b3144fa339d1"

	method void ShowBuff(number duration)
		-- 연막 지속시간 표시/갱신(재시전하면 새 지속시간으로 갱신된다 - 다른 버프와 같은 규칙).
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.ssTotalDuration = duration
		self._T.ssRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.ssTimerId then
			_TimerService:ClearTimer(self._T.ssTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.ssTimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.ssRemaining = self._T.ssRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
		log("[SmokeScreenBuffUI] 버프 표시 시작 duration=" .. tostring(duration))
	end

	method void UpdateBuffDisplay()
		-- 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃 갱신.
		local remaining = self._T.ssRemaining
		local total = self._T.ssTotalDuration

		if remaining <= 0 then
			if self._T.ssTimerId then
				_TimerService:ClearTimer(self._T.ssTimerId)
				self._T.ssTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(1, 1, 1, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(1, 1, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	method void HideBuff()
		-- 조기 해제(우클릭 취소 / 사망)했을 때 즉시 내린다.
		if not self:IsClient() then return end
		if self._T.ssRemaining == nil then return end
		self._T.ssRemaining = 0
		self:UpdateBuffDisplay()
	end

	method void OnEndPlay()
		if self._T.ssTimerId then
			_TimerService:ClearTimer(self._T.ssTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	method number GetRemaining()
		return self._T.ssRemaining or 0
	end

end
