@Logic
script DecoWindowManager extends Logic

    -- 장비창의 장비/펫 탭 전환, 치장창(DecoWindow) 열기/닫기, 치장 슬롯 장착/해제,
    -- 그리고 치장(외형 우선) + 장비(스탯) 상태를 합쳐 아바타 외형에 적용하는 관리자.
    -- 치장 아이템 문자열 포맷: "이름|ruid|deco|<catKey>"
    -- catKey: cap coat pants shoes glove cape weapon1 weapon2 subweapon faceacc eyeacc earacc

    property number lastDecoTime = 0
    property string lastDecoSlot = ""
    property number lastEquipWinTab = 0

    method void OnBeginPlay()
        -- 클라이언트에서 탭/버튼/슬롯 터치 이벤트를 연결한다
        if not self:IsClient() then return end
        self._T.handlers = {}
        self._T.decoData = {}
        for _, k in ipairs(self:AllSlotKeys()) do
            self._T.decoData[k] = ""
        end

        local eBase = "/ui/DefaultGroup/EquipWindow/"
        local dBase = "/ui/DefaultGroup/DecoWindow/"

        self:WireTouch(eBase .. "TabEquip/Touch", function() self:SetEquipTab("equip") end)
        self:WireTouch(eBase .. "TabPet/Touch", function() self:SetEquipTab("pet") end)
        self:WireTouch(eBase .. "BtnDeco/Touch", function() self:SwitchToDeco() end)

        self:WireTouch(dBase .. "CloseDeco/Touch", function() self:CloseDecoWindow() end)
        self:WireTouch(dBase .. "BtnEquipSwitch/Touch", function() self:SwitchToEquip() end)
        self:WireTouch(dBase .. "TabCoord/Touch", function() self:SetDecoTab("coord") end)
        self:WireTouch(dBase .. "TabAndroid/Touch", function() self:SetDecoTab("android") end)
        self:WireTouch(dBase .. "TabDamageSkin/Touch", function() self:SetDecoTab("damageskin") end)

        for _, k in ipairs(self:SlotUIKeys()) do
            local capturedKey = k
            self:WireTouch(dBase .. "DSlot_" .. k .. "/Touch", function() self:OnDecoSlotClick(capturedKey) end)
        end
        log("[DecoWin] ready")
    end

    method void OnEndPlay()
        -- 이벤트 해제
        if self._T.handlers ~= nil then
            for _, rec in ipairs(self._T.handlers) do
                if isvalid(rec.entity) then
                    rec.entity:DisconnectEvent(UITouchDownEvent, rec.eventHandler)
                end
            end
            self._T.handlers = {}
        end
    end

    @ExecSpace("ClientOnly")
    method table AllSlotKeys()
        -- decoData 저장 키 목록 (weapon 슬롯은 weapon1/weapon2 아이템을 모두 담는다)
        return {"cap","coat","pants","shoes","glove","cape","weapon","subweapon","faceacc","eyeacc","earacc","skin"}
    end

    @ExecSpace("ClientOnly")
    method table SlotUIKeys()
        -- DecoWindow의 DSlot_<key> UI 슬롯 키 목록 (AllSlotKeys와 동일)
        return self:AllSlotKeys()
    end

    @ExecSpace("ClientOnly")
    method string SlotKeyForCat(string cat)
        -- 아이템 catKey → decoData/UI 슬롯 키
        if cat == "weapon1" or cat == "weapon2" then return "weapon" end
        if cat=="longcoat" then return "coat" end
        return cat
    end

    @ExecSpace("ClientOnly")
    method void WireTouch(string path, any callback)
        -- UITouchDownEvent 좌클릭 연결 (프로젝트 표준: 스프라이트 엔티티는 ButtonClickEvent가 안 옴)
        local e = _EntityService:GetEntityByPath(path)
        if not isvalid(e) then
            log("[DecoWin] wire 실패: " .. path)
            return
        end
        local capturedPath = path
        local h = e:ConnectEvent(UITouchDownEvent, function(evt)
            ---@type UITouchDownEvent
            local te = evt
            if te.TouchId == -1 then
                -- 겹친 창 관통 방지: 이 요소가 속한 창이 클릭 지점의 최상단 창일 때만 실행한다.
                local winRoot = string.match(capturedPath, "^(/ui/DefaultGroup/[^/]+)")
                if winRoot ~= nil and not _UIClickArbiter:AcceptClickAt(winRoot, te.TouchPoint) then return end
                callback()
            end
        end)
        table.insert(self._T.handlers, { entity = e, eventHandler = h })
    end

    -- ── 장비창 장비/펫 탭 ─────────────────────────────────────────────

    @ExecSpace("ClientOnly")
    method void SetEquipTab(string tab)
        -- 장비 탭: 장비 콘텐츠 표시 / 펫 탭: "준비입니다"만 표시
        local base = "/ui/DefaultGroup/EquipWindow/"
        local isEquip = (tab == "equip")

        self:TintTab(base .. "TabEquip", isEquip)
        self:TintTab(base .. "TabPet", not isEquip)

        local content = {
            "HeaderLabel","BtnDeco","Preview","GreySlots","HintText",
            "SlotFace","SlotHair","SlotTop","SlotBottom","SlotShoes","SlotWeapon","SlotCap","SlotCape","SlotGlove","SlotEarring","SlotRing","SlotPendant","SlotFaceAccessory","SlotEyeAccessory","SlotTicket",
        }
        for _, n in ipairs(content) do
            local e = _EntityService:GetEntityByPath(base .. n)
            if isvalid(e) then e.Enable = isEquip end
        end
        local notice = _EntityService:GetEntityByPath(base .. "PetNotice")
        if isvalid(notice) then notice.Enable = not isEquip end
    end

    @ExecSpace("ClientOnly")
    method void SetDecoTab(string tab)
        -- 코디 탭: 치장 콘텐츠 표시 / 안드로이드·데미지스킨: "준비입니다"
        local base = "/ui/DefaultGroup/DecoWindow/"
        local isCoord = (tab == "coord")

        self:TintTab(base .. "TabCoord", isCoord)
        self:TintTab(base .. "TabAndroid", tab == "android")
        self:TintTab(base .. "TabDamageSkin", tab == "damageskin")

        local content = { "HeaderLabel", "BtnEquipSwitch", "Preview", "GreySlots", "HintText" }
        for _, n in ipairs(content) do
            local e = _EntityService:GetEntityByPath(base .. n)
            if isvalid(e) then e.Enable = isCoord end
        end
        for _, k in ipairs(self:SlotUIKeys()) do
            local e = _EntityService:GetEntityByPath(base .. "DSlot_" .. k)
            if isvalid(e) then e.Enable = isCoord end
        end
        local notice = _EntityService:GetEntityByPath(base .. "DecoNotice")
        if isvalid(notice) then notice.Enable = not isCoord end
    end

    @ExecSpace("ClientOnly")
    method void TintTab(string path, boolean active)
        -- 탭 배경/글자 색을 활성/비활성으로 전환
        local bg = _EntityService:GetEntityByPath(path .. "/TabBG")
        if isvalid(bg) and isvalid(bg.SpriteGUIRendererComponent) then
            if active then
                bg.SpriteGUIRendererComponent.Color = Color(0.18, 0.64, 0.78, 1)
            else
                bg.SpriteGUIRendererComponent.Color = Color(0.23, 0.24, 0.29, 1)
            end
        end
        local lb = _EntityService:GetEntityByPath(path .. "/Label")
        if isvalid(lb) and isvalid(lb.TextComponent) then
            if active then
                lb.TextComponent.FontColor = Color(1, 1, 1, 1)
            else
                lb.TextComponent.FontColor = Color(0.62, 0.64, 0.7, 1)
            end
        end
    end

    -- ── 창 전환 ──────────────────────────────────────────────────────

    @ExecSpace("ClientOnly")
    method void SwitchToDeco()
        -- 장비창 → 치장창 (치장창은 장비창이 있던 위치에서 그대로 열린다)
        local ew = _EntityService:GetEntityByPath("/ui/DefaultGroup/EquipWindow")
        local dw = _EntityService:GetEntityByPath("/ui/DefaultGroup/DecoWindow")
        local keepX, keepY = nil, nil
        if isvalid(ew) then
            local p = ew.UITransformComponent.anchoredPosition
            keepX, keepY = p.x, p.y
        end
        if isvalid(ew) and ew.Enable then
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/EquipWindow")
        end
        -- 위치를 먼저 옮긴 뒤 표시해야 이전 위치에서 한 프레임 깜빡이지 않는다
        if isvalid(dw) and keepX ~= nil then
            dw.UITransformComponent.anchoredPosition = Vector2(keepX, keepY)
        end
        if isvalid(dw) and not dw.Enable then
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/DecoWindow")
        end
        self:SetDecoTab("coord")
        self:RefreshDecoUI()
        self:ApplyAppearance()
    end

    @ExecSpace("ClientOnly")
    method void SwitchToEquip()
        -- 치장창 → 장비창 (장비창은 치장창이 있던 위치에서 그대로 열린다)
        local dw = _EntityService:GetEntityByPath("/ui/DefaultGroup/DecoWindow")
        local ew = _EntityService:GetEntityByPath("/ui/DefaultGroup/EquipWindow")
        local keepX, keepY = nil, nil
        if isvalid(dw) then
            local p = dw.UITransformComponent.anchoredPosition
            keepX, keepY = p.x, p.y
        end
        if isvalid(dw) and dw.Enable then
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/DecoWindow")
        end
        -- 위치를 먼저 옮긴 뒤 표시해야 이전 위치에서 한 프레임 깜빡이지 않는다
        if isvalid(ew) and keepX ~= nil then
            ew.UITransformComponent.anchoredPosition = Vector2(keepX, keepY)
        end
        if isvalid(ew) and not ew.Enable then
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/EquipWindow")
        end
        self:SetEquipTab("equip")
    end

    @ExecSpace("ClientOnly")
    method void CloseDecoWindow()
        -- 치장창 닫기
        local dw = _EntityService:GetEntityByPath("/ui/DefaultGroup/DecoWindow")
        if isvalid(dw) and dw.Enable then
            _UIEquipInventoryManager:ToggleWin("/ui/DefaultGroup/DecoWindow")
        end
    end

    -- ── 치장 장착/해제 ────────────────────────────────────────────────

    @ExecSpace("ClientOnly")
    method void OnDecoSlotClick(string slotKey)
        -- 치장 슬롯 더블클릭 → 해제
        local t = _UtilLogic.ElapsedSeconds
        if self.lastDecoSlot == slotKey and t - self.lastDecoTime < 0.5 then
            self:UnequipDeco(slotKey)
            self.lastDecoSlot = ""
        else
            self.lastDecoSlot = slotKey
            self.lastDecoTime = t
        end
    end

    @ExecSpace("ClientOnly")
    method void EquipDecoFromInven(number invenIdx)
        -- 인벤토리 치장 탭 아이템 더블클릭 → 해당 부위에 장착 (기존 아이템과 교체)
        local s = _UIEquipInventoryManager:GetTabItem("decorate", invenIdx)
        if s == "" then return end
        local marker = _UIEquipInventoryManager:GetField(s, 3)
        if marker ~= "deco" then
            log("[DecoWin] 치장 아이템이 아님: " .. s)
            return
        end
        local cat = _UIEquipInventoryManager:GetField(s, 4)
        local slotKey = self:SlotKeyForCat(cat)
        if self._T.decoData[slotKey] == nil then
            log("[DecoWin] 알 수 없는 치장 부위: " .. cat)
            return
        end

        if not _CosmeticBoxCatalog:CanEquipWeapon(s,_UIMyInfoManager:GetSelectedCharacterJobIdx()) then
            _UIToast:ShowMessage("현재 직업에 맞는 치장 무기만 착용할 수 있습니다.") return
        end
        local old = self._T.decoData[slotKey]
        local conflictKey=""
        if cat=="longcoat" and (self._T.decoData.pants or "")~="" then conflictKey="pants" end
        if cat=="pants" and _UIEquipInventoryManager:GetField(self._T.decoData.coat or "",4)=="longcoat" then conflictKey="coat" end
        if conflictKey~="" then
            local displaced=self._T.decoData[conflictKey]
            if old=="" then old=displaced
            else
                local empty=0
                for i=1,128 do if _UIEquipInventoryManager:GetTabItem("decorate",i)=="" then empty=i break end end
                if empty==0 then _UIToast:ShowMessage("교체할 치장 아이템을 보관할 빈칸이 필요합니다.") return end
                _UIEquipInventoryManager:SetTabItem("decorate",empty,displaced)
            end
            self._T.decoData[conflictKey]=""
        end
        self._T.decoData[slotKey] = s
        _UIEquipInventoryManager:SetTabItem("decorate", invenIdx, old)

        self:RefreshDecoUI()
        self:ApplyAppearance()
        _UIEquipInventoryManager:RefreshUI()
        _CharacterPersistence:MarkDirty("deco")
        log("[DecoWin] 장착: [" .. slotKey .. "] " .. _UIEquipInventoryManager:ParseName(s))
    end

    @ExecSpace("ClientOnly")
    method void UnequipDeco(string slotKey)
        -- 치장 슬롯 해제 → 인벤토리 치장 탭의 빈 칸으로
        local s = self._T.decoData[slotKey]
        if s == nil or s == "" then return end

        local emptyIdx = 0
        for i = 1, 128 do
            if _UIEquipInventoryManager:GetTabItem("decorate", i) == "" then
                emptyIdx = i
                break
            end
        end
        if emptyIdx == 0 then
            log("[DecoWin] 치장 인벤토리 가득 참")
            return
        end

        _UIEquipInventoryManager:SetTabItem("decorate", emptyIdx, s)
        self._T.decoData[slotKey] = ""

        self:RefreshDecoUI()
        self:ApplyAppearance()
        _UIEquipInventoryManager:RefreshUI()
        _CharacterPersistence:MarkDirty("deco")
        log("[DecoWin] 해제: [" .. slotKey .. "]")
    end

    @ExecSpace("ClientOnly")
    method void RefreshDecoUI()
        -- 치장 슬롯 아이콘 갱신
        local base = "/ui/DefaultGroup/DecoWindow/DSlot_"
        for _, k in ipairs(self:SlotUIKeys()) do
            local s = self._T.decoData[k] or ""
            local ruid = s ~= "" and _UIEquipInventoryManager:ParseRUID(s) or ""
            local bg = _EntityService:GetEntityByPath(base .. k .. "/SlotBG")
            if isvalid(bg) and isvalid(bg.SpriteGUIRendererComponent) then
                bg.SpriteGUIRendererComponent.Outline = _UIEquipInventoryManager:IsStarterCosmetic(s)
                bg.SpriteGUIRendererComponent.OutlineColor = Color(0,0,0,1)
            end
            local label = _EntityService:GetEntityByPath(base .. k .. "/Label")
            if isvalid(label) then label.Enable = s == "" end
            local icon = _EntityService:GetEntityByPath(base .. k .. "/Icon")
            if isvalid(icon) and isvalid(icon.SpriteGUIRendererComponent) then
                if ruid ~= "" then
                    icon.SpriteGUIRendererComponent.ImageRUID = "thumbnail://" .. ruid
                    icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
                else
                    icon.SpriteGUIRendererComponent.ImageRUID = ""
                    icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
                end
            end
        end
    end

    -- ── 외형 적용 (치장 우선, 없으면 장비) ─────────────────────────────

    @ExecSpace("ClientOnly")
    method string GetDecoItem(string slotKey)
        -- 치장 슬롯의 아이템 문자열 반환 ("" = 비어있음). 툴팁 비교 등 외부 접근자.
        local s = self._T.decoData[slotKey]
        if s == nil then return "" end
        return s
    end

    @ExecSpace("ClientOnly")
    method string DecoRuid(string slotKey)
        -- 치장 슬롯의 RUID ("" = 비어있음)
        local s = self._T.decoData[slotKey]
        if s == nil or s == "" then return "" end
        return _UIEquipInventoryManager:ParseRUID(s)
    end

    @ExecSpace("ClientOnly")
    method void ApplyAppearance()
        -- 장비 7슬롯에서 기본 외형을 얻고, 치장 장착 부위는 치장이 덮어쓴다.
        -- 플레이어 본체 + 장비창/치장창 미리보기 아바타에 동일하게 적용.
        local eq = {}
        for i = 1, 27 do
            local s = _UIEquipInventoryManager:GetEquip(i)
            eq[i] = { ruid = "", name = "" }
            if s ~= "" then
                eq[i].ruid = _UIEquipInventoryManager:ParseRUID(s)
                eq[i].name = _UIEquipInventoryManager:ParseName(s)
            end
        end

        local finals = self:ComposeAppearance(eq, self._T.decoData, _UIMyInfoManager:GetSelectedCharacterJobIdx())

        local player = _UserService.LocalPlayer
        local playerCM = nil
        if isvalid(player) then playerCM = player.CostumeManagerComponent end

        if isvalid(playerCM) then
            -- Remember the game body before applying a skin; never capture the cosmetic as the base.
            if self._T.baseSkinRuid == nil then
                local body = self:SafeEquip(playerCM, MapleAvatarItemCategory.Body)
                self._T.baseSkinRuid = body ~= "" and body or "3cf4cb29ae344577b9eed37e531688a4"
            end
            if self:DecoRuid("skin") == "" then table.insert(finals, {1, self._T.baseSkinRuid}) end
        end
        _AvatarTicketManager:ApplyLocal(finals)
        self:ApplyAppearanceServer(finals, _AvatarTicketManager:Equipped())
        log("[DecoWin] 외형 적용 완료 (모자=" .. tostring(self:DecoRuid("cap")) .. ")")
    end

    @ExecSpace("ClientOnly")
    method table ComposeAppearance(table eq, table deco, number job)
        local function decoRuid(key)
            return _UIEquipInventoryManager:ParseRUID(deco[key] or "")
        end
        -- 무기: 치장 무기 > 장비 무기 (한손/두손 슬롯 분리)
        -- (버그 수정) 치장 분기가 저장된 catKey("weapon2")만 믿고 카알대검(실제 카테고리 한손)을
        -- TwoHandedWeapon 슬롯에 넣어 로그인마다 LEA-3005 4건이 났다 - 이름 판정보다 확실한
        -- RUID 판정(IsOneHandedWeaponRuidDeco)을 두 분기 모두에 우선 적용한다.
        local oneHandR, twoHandR = "", ""
        local decoWeapon = deco["weapon"] or ""
        if not _CosmeticBoxCatalog:CanEquipWeapon(decoWeapon,job) then decoWeapon="" end
        if decoWeapon ~= "" then
            local r = _UIEquipInventoryManager:ParseRUID(decoWeapon)
            if self:IsOneHandedWeaponRuidDeco(r) then
                oneHandR = r
            else
                local cat = _UIEquipInventoryManager:GetField(decoWeapon, 4)
                if cat == "weapon2" then twoHandR = r else oneHandR = r end
            end
        elseif eq[6].ruid ~= "" then
            if _UIEquipInventoryManager:IsOneHandedJobWeapon(eq[6].name) or self:IsOneHandedWeaponRuidDeco(eq[6].ruid) then
                oneHandR = eq[6].ruid
            else
                twoHandR = eq[6].ruid
            end
        end

        local function pick(decoKey, equipRuid)
            if string.find(deco[decoKey] or "", "|transparent:1", 1, true) then return "" end
            local d = decoRuid(decoKey)
            if d ~= "" then return d end
            return equipRuid
        end

        -- 모자: 치장 모자 > 장착한 모자. 둘 다 없으면 아무 모자도 쓰지 않는다
        -- (기본 모자는 캐릭터 생성 시 모자 슬롯에 "아이템"으로 지급되며, 벗으면 맨머리가 된다).
        local capR = pick("cap", eq[7].ruid)

        -- (버그 수정) 카테고리를 "정수"로 담는다 - 아래에서 이 목록을 그대로 서버로 보내 다른 클라이언트에도
        -- 동기화하는데, 엔진 enum(MapleAvatarItemCategory)은 RPC로 넘길 수 없기 때문이다(넘기면 LEA-3036).
        -- 로컬 SetEquip 호출은 self:CatEnum(int)로 정수를 enum으로 되돌려 쓴다.
        local coatR, pantsR, longcoatR = pick("coat", eq[3].ruid), pick("pants", eq[4].ruid), ""
        if _UIEquipInventoryManager:AppearanceCategory(coatR) == "longcoat" then
            longcoatR, coatR = coatR, ""
            if decoRuid("pants") ~= "" and decoRuid("coat") == "" then
                longcoatR = ""
            else
                pantsR = ""
            end
        end
        if longcoatR == "" then
            if coatR == "" then coatR = "ae8d3590a96e48c3b7cd75d46ebd3f15" end
            if pantsR == "" then pantsR = "61f10ef0a6204e0ab6593bdf36fed3e5" end
        end
        local finals = {
            { 4,  eq[1].ruid },                        -- Face
            { 3,  eq[2].ruid },                        -- Hair
            { 9,  longcoatR },
            { 7,  coatR },          -- Coat
            { 10, pantsR },         -- Pants
            { 12, pick("shoes", eq[5].ruid) },         -- Shoes
            { 5,  capR },                              -- Cap
            { 8,  pick("glove", eq[9].ruid) },         -- Glove (치장 > 장비 슬롯9)
            { 6,  pick("cape", eq[8].ruid) },          -- Cape (치장 > 장비 슬롯8)
            { 15, decoRuid("subweapon") },        -- SubWeapon
            { 16, pick("faceacc", eq[26] and eq[26].ruid or "") },          -- FaceAccessory
            { 17, pick("eyeacc", eq[27] and eq[27].ruid or "") },           -- EyeAccessory
            { 18, pick("earacc", eq[14] and eq[14].ruid or "") },           -- EarAccessory
            { 13, oneHandR },                          -- OneHandedWeapon
            { 14, twoHandR },                          -- TwoHandedWeapon
        }


        if decoRuid("skin") ~= "" then table.insert(finals, {1, decoRuid("skin")}) end
        local keys={[1]="skin",[5]="cap",[6]="cape",[7]="coat",[9]="coat",[10]="pants",[8]="glove",[12]="shoes",[13]="weapon",[14]="weapon",[15]="subweapon",[16]="faceacc",[17]="eyeacc",[18]="earacc"}
        for _,f in ipairs(finals) do
            local item=deco[keys[f[1]] or ""] or ""
            f[3]=(_UIEquipInventoryManager:ParseRUID(item)==f[2]) and (string.match(item,"|dye:(%x%x%x%x%x%x)") or "FFFFFF") or "FFFFFF"
        end
        return finals
    end

    method boolean IsOneHandedWeaponRuidDeco(string ruid)
        if _UIEquipInventoryManager:AppearanceCategory(ruid) == "weapon" then return true end
        -- 아바타 리소스 카테고리가 onehandedweapon인 직업 지급 무기 RUID 목록
        -- (CharacterSelectComponent.IsOneHandedWeaponRuid와 동일 - TwoHandedWeapon 슬롯에
        -- SetEquip하면 LEA-3005가 나는 무기들. 이름 표기 변형에 흔들리지 않도록 RUID로 판정).
        if ruid == "444f1da6365d4599a27bbfd207585856" then return true end -- 카알대검
        if ruid == "1489702f013a4ba4a1ec080da4df17c3" then return true end -- 후르츠 대거
        if ruid == "7380b5e5754a4e338e65fa232a8a095b" then return true end -- 나무 스태프
        if ruid == "061712eadf7d4357a6c306dfd5368860" then return true end -- 우드완드
        return false
    end

    method any CatEnum(integer c)
        -- 정수 카테고리 코드를 MapleAvatarItemCategory enum 멤버로 되돌린다.
        -- (finals 목록은 RPC 호환을 위해 정수로 담고, SetEquip 호출 직전에만 enum으로 바꾼다.)
        if c == 1 then return MapleAvatarItemCategory.Body end
        if c == 3 then return MapleAvatarItemCategory.Hair end
        if c == 4 then return MapleAvatarItemCategory.Face end
        if c == 5 then return MapleAvatarItemCategory.Cap end
        if c == 6 then return MapleAvatarItemCategory.Cape end
        if c == 7 then return MapleAvatarItemCategory.Coat end
        if c == 8 then return MapleAvatarItemCategory.Glove end
        if c == 9 then return MapleAvatarItemCategory.Longcoat end
        if c == 10 then return MapleAvatarItemCategory.Pants end
        if c == 12 then return MapleAvatarItemCategory.Shoes end
        if c == 13 then return MapleAvatarItemCategory.OneHandedWeapon end
        if c == 14 then return MapleAvatarItemCategory.TwoHandedWeapon end
        if c == 15 then return MapleAvatarItemCategory.SubWeapon end
        if c == 16 then return MapleAvatarItemCategory.FaceAccessory end
        if c == 17 then return MapleAvatarItemCategory.EyeAccessory end
        if c == 18 then return MapleAvatarItemCategory.EarAccessory end
        if c == 19 then return MapleAvatarItemCategory.Ear end
        return MapleAvatarItemCategory.Invalid
    end

    method void ApplyCostumeSnapshot(any cm, table finals)
        -- Native ear shapes are catalogued with earrings, but require the Ear slot.
        local earShapes = {["de06c3d28f6047008264755f841f28a2"] = true, ["279b4de94cf8460a98ce25e86bbbb5df"] = true, ["f11aa974673f4722b6830fae9acc9041"] = true, ["40eac2af3a4b4799b6ca4fb871da5d26"] = true}
        local earShape = ""
        for _, f in ipairs(finals) do
            if f[1] == 18 and earShapes[f[2]] then earShape = f[2] end
        end
        cm:SetEquip(MapleAvatarItemCategory.Ear, earShape)
        for _, c in ipairs({ 7, 9, 10, 13, 14 }) do cm:SetEquip(self:CatEnum(c), "") end
        for _, f in ipairs(finals) do
            if f[1] == 18 and earShapes[f[2]] then
                cm:SetEquip(MapleAvatarItemCategory.EarAccessory, "")
            elseif f[2] ~= "" then
                cm:SetEquip(self:CatEnum(f[1]), f[2])
            elseif f[1] ~= 7 and f[1] ~= 9 and f[1] ~= 10 and f[1] ~= 13 and f[1] ~= 14 then
                cm:SetEquip(self:CatEnum(f[1]), "")
            end
        end
        if self:IsClient() then
            self:ApplyDyes(cm,finals)
            _TimerService:SetTimerOnce(function()
                if isvalid(cm) then self:ApplyDyes(cm,finals) end
            end,0.4)
        end

    end

    @ExecSpace("Server")
    method void ApplyAppearanceServer(table finals, boolean ticket)
        -- (버그 수정) 다른 플레이어에게 장비가 안 보이던 문제의 실제 해결부.
        -- 서버에서 이 플레이어(요청 보낸 클라)의 CostumeManager에 장비를 넣으면, Custom*Equip/
        -- UseCustomEquipOnly가 @Sync라 "모든" 클라이언트로 퍼진다 - 즉 다른 사람 화면에도 반영된다.
        -- (@Logic이라 서버 RPC 호스팅 가능. senderUserId는 요청 보낸 클라의 UserId다.)
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then return end
        local cm = player.CostumeManagerComponent
        if not isvalid(cm) then return end
        _AvatarTicketManager:Publish(player, finals, ticket)
        log("[DecoWin] (서버) 외형 동기화 완료 user=" .. tostring(senderUserId))
    end

    @ExecSpace("ClientOnly")
    method string SafeEquip(any costumeManager, any category)
        -- GetEquip은 미장착 슬롯에서 nil을 돌려줄 수 있으므로 항상 문자열로 만든다
        local r = costumeManager:GetEquip(category)
        if r == nil then return "" end
        return tostring(r)
    end

    -- ── 영속화 (CharacterPersistence 전용) ─────────────────────────────

    @ExecSpace("ClientOnly")
    method table ExportDeco()
        -- 치장 장착 상태를 저장용 테이블로 (slotKey → 아이템 문자열)
        local out = {}
        for _, k in ipairs(self:AllSlotKeys()) do
            local s = self._T.decoData[k]
            if s ~= nil and s ~= "" then out[k] = s end
        end
        return out
    end

    @ExecSpace("ClientOnly")
    method void ImportDeco(table deco)
        -- 저장된 치장 장착 상태 복원 (전체 초기화 후 유효 항목만)
        for _, k in ipairs(self:AllSlotKeys()) do
            self._T.decoData[k] = ""
        end
        if deco ~= nil then
            for k, s in pairs(deco) do
                if self._T.decoData[tostring(k)] ~= nil and s ~= nil and s ~= "" then
                    self._T.decoData[tostring(k)] = tostring(s)
                end
            end
        end
        self:RefreshDecoUI()
    end


    @ExecSpace("ClientOnly")
    method void ApplyDyes(any cm, table finals)
        self:ApplyDyeTint(cm,finals,1)
    end


    @ExecSpace("ClientOnly")
    method void ApplyDyeTint(any cm, table finals, number brightness)
        -- Set part colors after native avatar parts are rebuilt; reject stale snapshots.
        if not isvalid(cm) or not cm.UseCustomEquipOnly then return end
        local entity=cm.Entity
        local renderer=entity.AvatarGUIRendererComponent
        if not isvalid(renderer) then renderer=entity.AvatarRendererComponent end
        if not isvalid(renderer) then return end
        for _,f in ipairs(finals) do
            local category=self:CatEnum(f[1])
            if cm:GetEquip(category)==f[2] then
                local hex=tostring(f[3] or "FFFFFF")
                if not string.match(hex,"^%x%x%x%x%x%x$") then hex="FFFFFF" end
                local color=Color.FromHexCode("#"..hex)
                renderer:SetAvatarPartColor(category,color.r*brightness,color.g*brightness,color.b*brightness,1)
            end
        end
    end

end
