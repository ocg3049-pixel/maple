@Logic
script RegionUnlock extends Logic
    method table Rules()
        return {henesys={stage=1,name="헤네시스",boss="마노"},perion={stage=2,name="페리온",boss="스텀피"},ellinia={stage=3,name="엘리니아",boss="킹 슬라임"},kerning={stage=4,name="커닝시티",boss="커닝시티 도적단"},goldbeach={stage=5,name="골드비치",boss="세르프"},ellinel={stage=6,name="요정학원 엘리넬",boss="파우스트"}}
    end

    method string Region(string mapId)
        local id=string.match(mapId or "", "^(.-)__channel_%d+$") or mapId or ""
        -- Tutorial and private encounters are not field regions. Boss entry stays available.
        if id=="login" or id=="001010000" then return "service" end
        if not string.match(id,"^%d%d%d%d%d%d%d%d%d$") then
            if _BossStageManager:IsArena(id) or _CarnivalRules:IsArena(id) then return "service" end
            return "locked"
        end
        if string.sub(id,1,3)=="104" then return "lith" end
        if string.sub(id,1,5)=="10004" then return "golem" end
        if string.sub(id,1,5)=="10304" then return "kerningtower" end
        if string.sub(id,1,5)=="10107" then return "ellinel" end
        if string.sub(id,1,5)=="10108" then return "ellodin" end
        if string.sub(id,1,5)=="12004" then return "goldbeach" end
        if string.sub(id,1,3)=="100" then return "henesys" end
        if string.sub(id,1,3)=="101" then return "ellinia" end
        if string.sub(id,1,3)=="102" then return "perion" end
        if string.sub(id,1,3)=="103" then return "kerning" end
        return "locked"
    end

    method table Read(string snapshot)
        local opened={}
        for key in string.gmatch(string.match("\n"..(snapshot or ""),"\nREGIONS_V1\t([^\n]*)") or "","[a-z]+") do
            if self:Rules()[key]~=nil then opened[key]=true end
        end
        return opened
    end

    method string Write(string snapshot, table opened)
        local lines={} local keys={}
        for line in string.gmatch(snapshot or "","[^\r\n]+") do
            if string.sub(line,1,11)~="REGIONS_V1\t" then table.insert(lines,line) end
        end
        for key,_ in pairs(self:Rules()) do if opened[key] then table.insert(keys,key) end end
        table.sort(keys)
        table.insert(lines,"REGIONS_V1\t"..table.concat(keys,","))
        return table.concat(lines,"\n")
    end

    method boolean OpenIn(string mapId, table opened)
        local key=self:Region(mapId)
        return key=="lith" or key=="service" or (opened or {})[key]==true
    end

    @ExecSpace("ClientOnly")
    method boolean IsOpen(string mapId)
        return self:OpenIn(mapId,self._T.opened)
    end

    @ExecSpace("ServerOnly")
    method boolean CanEnter(string uid, string mapId)
        local sv=_CharacterPersistence._T.sv and _CharacterPersistence._T.sv[uid]
        return self:OpenIn(mapId,self:Read(sv and sv.activeId~="" and sv.saves[sv.activeId] or ""))
    end

    @ExecSpace("Client")
    method void Notice(string key)
        local rule=self:Rules()[key]
        local message="이 지역은 봉인되어 있습니다.\n해금 조건은 아직 공개되지 않았습니다."
        if rule~=nil then
            message=rule.name.." 봉인 해제\n"..rule.boss.." 처치 후 지도 위 사슬을 눌러 주세요."
            if (self._T.cleared or 0)>=rule.stage then message=message.."\n보스 처치 완료 · 사슬을 눌러 해금할 수 있습니다." end
            if key=="henesys" then message=message.."\n골렘사원은 별도 봉인 지역입니다." end
            if key=="kerning" then message=message.."\n커닝타워는 별도 봉인 지역입니다." end
        end
        if isvalid(_UIPopup.popupGroup) then _UIPopup.popupGroup.UIGroupComponent.GroupOrder=1000 end
        _UIPopup:Open(message,nil,nil)
    end

    @ExecSpace("ClientOnly")
    method boolean Check(string mapId)
        if self:IsOpen(mapId) then return true end
        self:Notice(self:Region(mapId))
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean CheckServer(string uid, string mapId)
        if self:CanEnter(uid,mapId) then return true end
        self:Notice(self:Region(mapId),uid)
        return false
    end

    @ExecSpace("ClientOnly")
    method void Restore(string id, string snapshot)
        self._T.character=id self._T.opened=self:Read(snapshot)
        self._T.cleared=_BossStageManager:ReadClear(snapshot)
        self._T.fades={} self._T.pending=nil
        self:Invalidate()
    end

    @ExecSpace("Server")
    method void RequestStatus()
        self:SendStatus(senderUserId,"")
    end

    @ExecSpace("ServerOnly")
    method void SendStatus(string uid, string unlocked)
        local sv=_CharacterPersistence._T.sv and _CharacterPersistence._T.sv[uid]
        if sv==nil or sv.activeId=="" then return end
        local snapshot=sv.saves[sv.activeId] or ""
        self:Receive(sv.activeId,self:Write("",self:Read(snapshot)),_BossStageManager:ReadClear(snapshot),unlocked,uid)
    end

    @ExecSpace("Server")
    method void RequestUnlock(string character, string key)
        local uid=senderUserId
        local sv=_CharacterPersistence._T.sv and _CharacterPersistence._T.sv[uid]
        if sv==nil or sv.activeId=="" or sv.activeId~=character then return end
        local rule=self:Rules()[key]
        local raw=sv.saves[character] or ""
        local opened=self:Read(raw)
        if opened[key] then self:SendStatus(uid,"") return end
        if rule==nil or _BossStageManager:ReadClear(raw)<rule.stage then
            self:SendStatus(uid,"") self:Notice(key,uid) return
        end
        opened[key]=true
        sv.saves[character]=self:Write(raw,opened)
        sv.dirtySaves[character]=true
        _CharacterPersistence:WriteCharacterSaves(sv,false)
        self:SendStatus(uid,key)
        if Environment:IsMakerPlay() then log("[VRF] region unlocked="..key.." character="..character) end
    end

    @ExecSpace("Client")
    method void Receive(string character, string record, integer cleared, string unlocked)
        if character~=self._T.character then return end
        self._T.opened=self:Read(record) self._T.cleared=cleared self._T.pending=nil
        if unlocked~="" then
            self._T.fades=self._T.fades or {} self._T.fades[unlocked]=_UtilLogic.ElapsedSeconds
            _UIAudio:Play("BtMouseClick")
            _UIToast:ShowMessage(self:Rules()[unlocked].name.."의 봉인이 해제되었습니다.")
        end
        self:Invalidate()
    end

    @ExecSpace("ClientOnly")
    method void Invalidate()
        self._T.allowed=nil self._T.pages=nil
        for _,entry in ipairs(_WorldMapManager._T.regionPointEntries or {}) do entry.recommendLevel=nil end
        local browser=_MobileUIManager:UI("WorldMap")
        if isvalid(browser) and browser.EnabledInHierarchy and _MobileUIManager._T.mobileRegions~=nil then _MobileUIManager:DrawMobileWorldMap() end
    end

    @ExecSpace("ClientOnly")
    method boolean CanBrowsePage(string page)
        if page=="world" then return true end
        if self._T.pages==nil then
            local pages={world=true}
            local allowed=self:AllowedMaps()
            for _,entry in ipairs(_WorldMapManager._T.regionDestinations or {}) do
                if allowed[entry.id] then
                    local ancestor=entry.page
                    for depth=1,8 do
                        if ancestor==nil or pages[ancestor] then break end
                        pages[ancestor]=true
                        if ancestor=="world" then break end
                        ancestor=_WorldMapManager:GetParentPage(ancestor)
                    end
                end
            end
            self._T.pages=pages
        end
        return self._T.pages[page]==true
    end

    @ExecSpace("ClientOnly")
    method boolean CheckPage(string page)
        if self:CanBrowsePage(page) then return true end
        if self:Rules()[page]~=nil then self:Notice(page) else
            local title=page
            for _,region in ipairs(_MobileUIManager._T.mobileRegions or {}) do
                if region[1]==page then title=region[2] break end
            end
            if isvalid(_UIPopup.popupGroup) then _UIPopup.popupGroup.UIGroupComponent.GroupOrder=1000 end
            _UIPopup:Open(title.." 지역은 봉인되어 있습니다.\n소속 지역을 하나 이상 해금하면 지도를 열 수 있습니다.\n해금 조건은 아직 공개되지 않았습니다.",nil,nil)
        end
        if Environment:IsMakerPlay() then log("[VRF] map page denied="..page) end
        return false
    end

    @ExecSpace("ClientOnly")
    method table AllowedMaps()
        -- Bulk filters use one snapshot of access, rather than repeated cross-logic calls per map.
        if self._T.allowed~=nil then return self._T.allowed end
        local allowed={} local opened=self._T.opened or {}
        local broad={["104"]="lith",["100"]="henesys",["101"]="ellinia",["102"]="perion",["103"]="kerning",["120"]="locked"}
        local narrow={["10004"]="golem",["10304"]="kerningtower",["10107"]="ellinel",["10108"]="ellodin",["12004"]="goldbeach"}
        for _,entry in ipairs(_WorldMapManager._T.regionDestinations or {}) do
            local key=broad[string.sub(entry.id,1,3)]
            if key~=nil then
                key=narrow[string.sub(entry.id,1,5)] or key
                if key=="lith" or opened[key] then allowed[entry.id]=true end
            end
        end
        self._T.allowed=allowed
        return allowed
    end

    @ExecSpace("ClientOnly")
    method void ClickSeal(string key)
        if _WorldMapManager:PageInputBlocked() then return end
        if _UIPopup:BlocksInput() then return end
        local rule=self:Rules()[key]
        -- The server owns boss progress; a stale client snapshot must not block an unlock.
        if rule==nil then self:Notice(key) return end
        if self._T.opened and self._T.opened[key] then return end
        if self._T.pending and _UtilLogic.ElapsedSeconds-self._T.pending<3 then return end
        self._T.pending=_UtilLogic.ElapsedSeconds
        if Environment:IsMakerPlay() then log("[VRF] seal click="..key.." cachedClear="..tostring(self._T.cleared)) end
        self:RequestUnlock(self._T.character or "",key)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.opened={} self._T.fades={} self._T.seals={}
        local group=_EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if not isvalid(group) then return end
        for _,panel in ipairs(group.Children:ToTable()) do
            local seals=panel:GetChildByName("Seals")
            if not isvalid(seals) then continue end
            for _,entity in ipairs(seals.Children:ToTable()) do
                local key=string.match(entity.Name,"^Seal_(.+)$")
                if key==nil then continue end
                local entry={entity=entity,key=key,hover=false,phase=#self._T.seals*0.73,parts={}}
                if panel.Name=="FullMapPanel" then entry.page=string.match(key,"^locked_(.+)$") end
                for _,part in ipairs(entity.Children:ToTable()) do
                    if string.match(part.Name,"^Shade%d+$") then continue end
                    if isvalid(part.SpriteGUIRendererComponent) or isvalid(part.PolygonGUIRendererComponent) or isvalid(part.LineGUIRendererComponent) then
                        local p=part.UITransformComponent.anchoredPosition
                        table.insert(entry.parts,{entity=part,name=part.Name,x=p.x,y=p.y})
                    end
                end
                entry.enter=entity:ConnectEvent(UITouchEnterEvent,function() entry.hover=true _UIAudio:Play("BtMouseOver") end)
                entry.exit=entity:ConnectEvent(UITouchExitEvent,function() entry.hover=false end)
                entry.down=entity:ConnectEvent(UITouchDownEvent,function(event) _WorldMapManager:HandleMapPointer(event.TouchPoint) end)
                table.insert(self._T.seals,entry)
            end
        end
        if Environment:IsMakerPlay() then log("[VRF] region seals bound="..tostring(#self._T.seals).." featheredContours=true") end
    end

    @ExecSpace("ClientOnly")
    method any SealAt(Vector2 cursor)
        local nearest=nil local best=math.huge
        for _,entry in ipairs(self._T.seals or {}) do
            local e=entry.entity
            if isvalid(e) and e.EnabledInHierarchy and _UICursorManager:Hit(e,cursor) then
                local p=_UICursorManager:ScreenToElementPoint(e,cursor)
                local tr=e.UITransformComponent
                local dx=(p.x-(0.5-tr.Pivot.x)*tr.RectSize.x)/tr.RectSize.x
                local dy=(p.y-(0.5-tr.Pivot.y)*tr.RectSize.y)/tr.RectSize.y
                local distance=dx*dx+dy*dy
                if distance<best then nearest=entry best=distance end
            end
        end
        return nearest
    end

    @ExecSpace("ClientOnly")
    method boolean HandlePointer(Vector2 cursor)
        local entry=self:SealAt(cursor)
        if entry==nil then return false end
        if entry.page~=nil then _WorldMapManager:ShowMapPage(entry.page) else self:ClickSeal(entry.key) end
        return true
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        local now=_UtilLogic.ElapsedSeconds
        local hovered=self:SealAt(_InputService:GetCursorPosition())
        for _,entry in ipairs(self._T.seals or {}) do
            local e=entry.entity
            if not isvalid(e) then continue end
            local began=self._T.fades[entry.key]
            local progress=began and math.min(1,(now-began)/1.2) or 0
            local locked=not (self._T.opened or {})[entry.key]
            if entry.page~=nil then locked=not self:CanBrowsePage(entry.page) end
            e.Enable=locked or (began~=nil and progress<1)
            if not e.EnabledInHierarchy then continue end
            self:DrawSeal(entry,hovered==entry,progress)
        end
    end

    @ExecSpace("ClientOnly")
    method void DrawSeal(table entry, boolean hover, number progress)
        -- A quiet geographic shade carries the area; short chains only mark the seal.
        entry.hover=hover
        entry.entity.CanvasGroupComponent.GroupAlpha=1-progress*progress*(3-2*progress)
        local pulse=hover and (0.5+0.5*math.sin(_UtilLogic.ElapsedSeconds*3)) or 0
        for index,part in ipairs(entry.parts) do
            local child=part.entity
            if not isvalid(child) then continue end
            local sprite=child.SpriteGUIRendererComponent
            if part.name=="Outline" then
                child.Enable=hover and progress==0
                if isvalid(sprite) then sprite.Color=Color(0.55,0.30,0.82,0.12+0.04*pulse) end
            elseif isvalid(sprite) then
                local alpha=(hover and 0.94 or 0.68)*math.max(0,1-progress*3)
                sprite.Color=Color(hover and 0.94 or 0.70,hover and 0.86 or 0.66,hover and 1 or 0.80,alpha)
                local side=index%2==0 and 1 or -1
                child.UITransformComponent.anchoredPosition=Vector2(part.x+progress*side*12,part.y-progress*8)
            end
        end
    end
    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _,entry in ipairs(self._T.seals or {}) do
            if isvalid(entry.entity) then
                entry.entity:DisconnectEvent(UITouchEnterEvent,entry.enter)
                entry.entity:DisconnectEvent(UITouchExitEvent,entry.exit)
                entry.entity:DisconnectEvent(UITouchDownEvent,entry.down)
            end
        end
    end
end
