@Logic
script AppearanceColorPicker extends Logic
    property boolean opened = false

    @ExecSpace("ClientOnly")
    method Entity UI(string child)
        -- The popup has its own canvas above inventory windows.
        return _EntityService:GetEntityByPath("/ui/AppearanceColorGroup/Modal/Panel/" .. child)
    end

    @ExecSpace("ClientOnly")
    method boolean BlocksInput()
        -- Keep the closing ESC from reaching another window in the same frame.
        return self.opened or _UtilLogic.ElapsedSeconds < (self._T.closedUntil or 0)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Subscribe once per session and keep every connection for cleanup.
        self._T.links = {}
        self._T.key = _InputService:ConnectEvent(KeyDownEvent, self.OnKey)
        for i = 1, 12 do
            local index = i
            self:Bind("Color" .. tostring(i), function() self:SelectColor(index) end)
        end
        self:Bind("Confirm", function() self:Confirm() end)
        self:Bind("Advanced/Reset",function() self:SetHSV("FFFFFF") self:DrawAdvanced() end)
        self._T.sliderLinks={}
        for _, side in ipairs({"Base", "Mix"}) do
            local selectedSide = side
            for i = 1, 8 do
                local colorIndex = i
                self:Bind("HairMix/" .. side .. "/Color" .. tostring(i), function() self:SelectHairColor(selectedSide, colorIndex) end)
            end
        end
        self:Bind("HairMix/Less", function() self:SetHairRatio((self._T.hairRatio or 0) - 1) end)
        self:Bind("HairMix/More", function() self:SetHairRatio((self._T.hairRatio or 0) + 1) end)
        local mixSlider = self:UI("HairMix/Ratio")
        local mixListener = mixSlider:ConnectEvent(SliderValueChangedEvent, function(event)
            if self.opened and self._T.hair and not self._T.settingHair then self:SetHairRatio(event.Value) end
        end)
        table.insert(self._T.sliderLinks, {e=mixSlider,h=mixListener})
        self._T.numberLinks={}
        for _,key in ipairs({"Hue","Saturation","Value"}) do
            local field=key
            local e=self:UI("Advanced/"..field)
            local h=e:ConnectEvent(SliderValueChangedEvent,function(event)
                if self.opened and self._T.dye and not self._T.settingHSV then self:DrawAdvanced() end
            end)
            table.insert(self._T.sliderLinks,{e=e,h=h})
            local input=self:UI("Advanced/"..field.."Value")
            local finish=input:ConnectEvent(TextInputEndEditEvent,function(event) self:CommitNumber(field,event.text) end)
            local submit=input:ConnectEvent(TextInputSubmitEvent,function(event) self:CommitNumber(field,event.Text) end)
            table.insert(self._T.numberLinks,{e=input,finish=finish,submit=submit})
        end
        self:Bind("Cancel", function() self:Close() end)
        self:Bind("Previous", function() self:ChangePage(-1) end)
        self:Bind("Next", function() self:ChangePage(1) end)
    end

    @ExecSpace("ClientOnly")
    method void Bind(string child, any callback)
        -- Button ownership belongs to this modal.
        local e = self:UI(child)
        if not isvalid(e) then return end
        local h = e:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self._T.links, {entity=e, listener=h})
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Do not leave UI callbacks alive between play sessions.
        if self._T.key then _InputService:DisconnectEvent(KeyDownEvent, self._T.key) end
        for _, link in ipairs(self._T.links or {}) do
            if isvalid(link.entity) then link.entity:DisconnectEvent(ButtonClickEvent, link.listener) end
        end
        for _,link in ipairs(self._T.sliderLinks or {}) do if isvalid(link.e) then link.e:DisconnectEvent(SliderValueChangedEvent,link.h) end end
        for _,link in ipairs(self._T.numberLinks or {}) do
            if isvalid(link.e) then
                link.e:DisconnectEvent(TextInputEndEditEvent,link.finish)
                link.e:DisconnectEvent(TextInputSubmitEvent,link.submit)
            end
        end
        self._T.numberLinks=nil
        self._T.links = nil
    end

    @ExecSpace("ClientOnly")
    method void OnKey(KeyDownEvent event)
        -- Right mouse is Mouse1 on PC; TouchId is not a mouse button.
        if self.opened then
            if event.key == KeyboardKey.Escape then self:Close() end
            return
        end
        if event.key ~= KeyboardKey.Mouse1 or _LoginFlow.phase ~= "ingame" then return end
        if self:BlocksInput() or _GameSystemMenu:BlocksInput() or _UIItemDiscardManager:BlocksInput() then return end
        local target = _UICursorManager:TargetAt(_InputService:GetCursorPosition())
        if target == nil then return end
        if target.kind == "deco" then self:Open("deco",target.index,"")
        elseif target.kind == "equip" then self:Open("equip", target.index, "")
        elseif target.kind == "inven" then
            self:Open("inven", _UIEquipInventoryManager:VisualToDataIdx(target.index), _UIEquipInventoryManager._T.activeTab)
        end
    end

    @ExecSpace("ClientOnly")
    method string GetSourceItem()
        -- Keep the original tab/index so changing the active tab cannot recolor another item.
        if self._T.source == "creation" then
            local setting=self:CreationSetting()
            if setting==nil or _LoginFlow.phase~="create" then return "" end
            return setting:AppearanceItem(self._T.index)
        end
        if self._T.source == "deco" then return _DecoWindowManager:GetDecoItem(_DecoWindowManager:SlotUIKeys()[self._T.index]) end
        if self._T.source == "equip" then return _UIEquipInventoryManager:GetEquip(self._T.index) end
        return _UIEquipInventoryManager:GetTabItem(self._T.tab, self._T.index)
    end

    @ExecSpace("ClientOnly")
    method void Open(string source, integer index, string tab)
        -- Hair/face use native variants; other cosmetics use continuous HSV tint.
        if index < 1 or index > 128 or self.opened then return end
        if source ~= "creation" and _EnhancementManager:RequireCubeChoice() then return end
        self._T.source, self._T.index, self._T.tab = source, index, tab
        local item = self:GetSourceItem()
        self._T.dye = _UIEquipInventoryManager:GetField(item,3) == "deco"
        self._T.hair = _UIEquipInventoryManager:ParseSlotIdx(item) == 2 or _UIEquipInventoryManager:GetField(item,4) == "hair"
        if _UIEquipInventoryManager:IsHairOrFaceItem(item) then self._T.dye = false end
        if not self._T.dye and not _UIEquipInventoryManager:IsHairOrFaceItem(item) then return end
        self._T.original = item
        self._T.dyePreviewFinals=nil
        self._T.colors = self._T.dye and {} or _AppearanceColorCatalog:GetColors(_UIEquipInventoryManager:ParseRUID(item))
        if #self._T.colors == 1 and self._T.colors[1][1] == "기본 색상" then
            self._T.colors = {{_UIEquipInventoryManager:ParseName(item), _UIEquipInventoryManager:ParseRUID(item), "기본", true}}
        end
        
        if self._T.dye then
            self._T.colors = {}
            for _,color in ipairs({{"원본","FFFFFF"},{"빨강","FF7777"},{"주황","FFB16E"},{"노랑","FFF078"},{"초록","95D889"},{"청록","7EDACB"},{"파랑","829EFF"},{"보라","C48CFF"},{"분홍","FF9BD5"},{"갈색","BD9778"},{"회색","B0B0B0"},{"검정","656565"}}) do
                table.insert(self._T.colors,{_UIEquipInventoryManager:ParseName(item),_UIEquipInventoryManager:ParseRUID(item),color[1],true,color[2]})
            end
        end
        self._T.selected, self._T.page = 1, 1
        for i, row in ipairs(self._T.colors) do
            if self._T.dye then
                if row[5] == (string.match(item,"|dye:(%x%x%x%x%x%x)") or "FFFFFF") then self._T.selected=i end
            elseif row[2] == _UIEquipInventoryManager:ParseRUID(item) then self._T.selected = i end
        end
        self._T.page = math.floor((self._T.selected - 1) / 12) + 1
        if self._T.hair then
            self:PrepareHairMix(item)
            if self._T.hairBase==0 then self._T.hair=false end
        end
        _UIEquipInventoryManager:CancelEquipDrag()
        _UIEquipInventoryManager:ConsumeEnhancePick()
        _UIEquipInventoryManager:HideTooltip()
        self.opened = true
        _EntityService:GetEntityByPath("/ui/AppearanceColorGroup/Modal").Enable = true
        if self._T.dye then self:SetHSV(item) end
        self:Draw()
        _UIAudio:Play("MenuUp")
        if Environment:IsMakerPlay() then log("[AppearanceColor] open=" .. source .. ":" .. tostring(index) .. " colors=" .. tostring(#self._T.colors)) end
    end

    @ExecSpace("ClientOnly")
    method void SelectColor(integer visualIndex)
        -- Selecting is a preview; the item is changed only on Confirm.
        local index = (self._T.page - 1) * 12 + visualIndex
        if not self.opened or self._T.colors[index] == nil then return end
        self._T.selected = index
        self:Draw()
        _UIAudio:Play("BtMouseClick")
    end

    @ExecSpace("ClientOnly")
    method void ChangePage(integer delta)
        -- Wrap pages for styles with more than twelve registered variants.
        if not self.opened then return end
        local pages = math.ceil(#self._T.colors / 12)
        self._T.page = ((self._T.page - 1 + delta) % pages) + 1
        self:Draw()
    end

    @ExecSpace("ClientOnly")
    method void Draw()
        -- Switch between native hair/face variants and a continuous tint editor.
        _UITheme:Appearance(_EntityService:GetEntityByPath("/ui/AppearanceColorGroup/Modal/Panel"), self._T.source ~= "creation")
        self:LayoutColorMode()
        if self._T.hair then self:DrawHairMix() return end
        if self._T.dye then self:DrawAdvanced() return end
        _DecoWindowManager:ConfigureDyeMaterial(self:UI("Preview").SpriteGUIRendererComponent,false)
        local colors = self._T.colors
        local row = colors[self._T.selected]
        self:UI("Name").TextGUIRendererComponent.Text = row[1]
        self:UI("Preview").SpriteGUIRendererComponent.ImageRUID = "thumbnail://" .. row[2]
        self:UI("Preview").SpriteGUIRendererComponent.Color = Color.FromHexCode("#"..(row[5] or "FFFFFF"))
        self:UI("Hint").TextGUIRendererComponent.Text = #colors > 1 and "색상을 고른 뒤 적용하기를 눌러주세요." or "이 스타일에 등록된 색상은 한 가지입니다."
        if self._T.dye then self:UI("Hint").TextGUIRendererComponent.Text="치장의 원래 색에 선택한 색을 입힙니다. 원본으로 되돌릴 수 있습니다." end
        for i = 1, 12 do
            local index = (self._T.page - 1) * 12 + i
            local choice = colors[index]
            local button = self:UI("Color" .. tostring(i))
            button.Enable = choice ~= nil
            if choice ~= nil then
                local icon = self:UI("Color" .. tostring(i) .. "/Icon")
                icon.SpriteGUIRendererComponent.ImageRUID = "thumbnail://" .. choice[2]
                icon.SpriteGUIRendererComponent.Color = Color.FromHexCode("#"..(choice[5] or "FFFFFF"))
                self:UI("Color" .. tostring(i) .. "/Label").TextGUIRendererComponent.Text = choice[3]
                button.SpriteGUIRendererComponent.Outline = index == self._T.selected
                button.SpriteGUIRendererComponent.OutlineColor = self._T.source == "creation" and Color(0.92, 0.55, 0.16, 1) or Color(.82,.96,.31,1)
            end
        end
        local pages = math.ceil(#colors / 12)
        self:UI("Previous").Enable = pages > 1
        self:UI("Next").Enable = pages > 1
        self:UI("Page").Enable = pages > 1
        self:UI("Page").TextGUIRendererComponent.Text = tostring(self._T.page) .. " / " .. tostring(pages)
    end

    @ExecSpace("ClientOnly")
    method string BuildSelectedItem()
        -- Continuous dyes have no variant row; validate and build the two modes separately.
        local original = self._T.original or ""
        local suffix = string.match(original, "^[^|]*|[^|]*(|.*)$")
        if suffix == nil then return "" end
        if self._T.hair then return self:BuildHairItem() end
        if self._T.dye then return self:BuildDyeItem() end
        local colors = self._T.colors or {}
        local row = colors[self._T.selected or 0]
        if row == nil or row[1] == nil or row[2] == nil then return "" end
        return row[1] .. "|" .. row[2] .. suffix
    end

    @ExecSpace("ClientOnly")
    method void Confirm()
        -- Reject stale targets and preserve every field except display name and appearance RUID.
        if not self.opened then return end
        if self:GetSourceItem() ~= self._T.original then self:Close() return end
        local updated = self:BuildSelectedItem()
        if updated == "" then self:Close() return end
        if self._T.source == "creation" then
            local setting=self:CreationSetting()
            if setting~=nil then setting:SetAppearanceColor(self._T.index,updated) end
            self:Close()
            return
        end
        if self._T.source == "deco" then
            local data=_DecoWindowManager:ExportDeco()
            data[_DecoWindowManager:SlotUIKeys()[self._T.index]]=updated
            _DecoWindowManager:ImportDeco(data)
        elseif self._T.source == "equip" then _UIEquipInventoryManager:SetEquipStr(self._T.index, updated)
        else _UIEquipInventoryManager:SetTabItem(self._T.tab, self._T.index, updated) end
        _UIEquipInventoryManager:RefreshUI()
        _DecoWindowManager:ApplyAppearance()
        _CharacterPersistence:MarkDirty("appearance_color")
        _CharacterPersistence:FlushToServer()
        if Environment:IsMakerPlay() then log("[AppearanceColor] applied=" .. _UIEquipInventoryManager:ParseRUID(updated)) end
        self:Close()
    end

    @ExecSpace("ClientOnly")
    method void Close()
        -- Cancel discards the preview and leaves the original item intact.
        if not self.opened then return end
        self.opened = false
        self._T.closedUntil = _UtilLogic.ElapsedSeconds + 0.2
        _EntityService:GetEntityByPath("/ui/AppearanceColorGroup/Modal").Enable = false
        _UIEquipInventoryManager:HideTooltip()
        _UIAudio:Play("MenuDown")
    end
    @ExecSpace("ClientOnly")
    method void LayoutColorMode()
        -- Match the creation book with a cream page, brown type and gold selection.
        local dye=self._T.dye
        local panel=_EntityService:GetEntityByPath("/ui/AppearanceColorGroup/Modal/Panel")
        panel.UITransformComponent.RectSize=dye and Vector2(660,660) or Vector2(560,470)
        self:UI("Advanced").Enable=dye
        for i=1,12 do self:UI("Color"..tostring(i)).Enable=not dye end
        self:UI("Title").UITransformComponent.anchoredPosition=dye and Vector2(-55,299) or Vector2(0,202)
        self:UI("Title").TextGUIRendererComponent.FontColor=self._T.source=="creation" and Color(.31,.22,.16,1) or Color(.82,.96,.31,1)
        self:UI("Title").TextGUIRendererComponent.Text=dye and "치장 색상 조절" or "성형 색상 고르기"
        self:UI("Name").UITransformComponent.anchoredPosition=dye and Vector2(49,248) or Vector2(49,149)
        self:UI("Preview").UITransformComponent.anchoredPosition=dye and Vector2(-240,247) or Vector2(-200,132)
        self:UI("Hint").Enable=not dye
        self:UI("Confirm").UITransformComponent.anchoredPosition=dye and Vector2(90,-289) or Vector2(78,-195)
        self:UI("Cancel").UITransformComponent.anchoredPosition=dye and Vector2(222,-289) or Vector2(202,-195)
        if dye then self:UI("Previous").Enable=false self:UI("Next").Enable=false self:UI("Page").Enable=false end
        self:UI("HairMix").Enable = self._T.hair == true
        self:UI("Preview").Enable = not self._T.hair
        self:UI("Name").Enable = not self._T.hair
        if self._T.hair then
            panel.UITransformComponent.RectSize = Vector2(760,650)
            self:UI("Title").UITransformComponent.anchoredPosition = Vector2(0,285)
            self:UI("Title").TextGUIRendererComponent.Text = "헤어 믹스염색"
            self:UI("Title").TextGUIRendererComponent.FontColor = self._T.source=="creation" and Color(.31,.22,.16,1) or Color(.82,.96,.31,1)
            self:UI("Hint").Enable = false
            self:UI("Confirm").UITransformComponent.anchoredPosition = Vector2(175,-280)
            self:UI("Cancel").UITransformComponent.anchoredPosition = Vector2(299,-280)
            for i=1,12 do self:UI("Color"..tostring(i)).Enable=false end
            self:UI("Previous").Enable=false self:UI("Next").Enable=false self:UI("Page").Enable=false
        end
        local size=panel.UITransformComponent.RectSize
        self:UI("Paper").UITransformComponent.RectSize=Vector2(size.x-16,size.y-16)
        self:UI("HeaderRule").UITransformComponent.RectSize=Vector2(size.x-64,2)
        self:UI("HeaderRule").UITransformComponent.anchoredPosition=Vector2(0,size.y/2-64)
        -- Keep the paper behind every color control after Maker loads the tree.
        _UILogic:SetSiblingIndex(self:UI("HeaderRule").UITransformComponent,1)
        _UILogic:SetSiblingIndex(self:UI("Paper").UITransformComponent,1)
    end

    @ExecSpace("ClientOnly")
    method void SyncNumber(string field, number value)
        local input=self:UI("Advanced/"..field.."Value").TextGUIRendererInputComponent
        if not input.IsFocused then input.Text=string.format("%.2f",value) end
    end

    method table HairPalette()
        -- Stable eight-color order matches the two palettes in the dye window.
        return {{"노란색","E8CC67"},{"주황색","DC9255"},{"빨간색","C76764"},{"초록색","83A96C"},{"보라색","9A80BB"},{"파란색","718DBB"},{"검은색","494650"},{"갈색","99775E"}}
    end

    @ExecSpace("ClientOnly")
    method void PrepareHairMix(string item)
        -- Resolve only variants belonging to this hairstyle; missing colors remain disabled.
        self._T.hairChoices = {}
        local baseRuid, mixRuid, ratio = string.match(item,"|hairMix:(%x+),(%x+),(%d+)")
        baseRuid = baseRuid or _UIEquipInventoryManager:ParseRUID(item)
        self._T.hairBase, self._T.hairMix = 0, 0
        local english={"Yellow","Orange","Red","Green","Purple","Blue","Black","Brown"}
        for i, color in ipairs(self:HairPalette()) do
            for _, row in ipairs(self._T.colors) do
                if row[3] == color[1] or row[3] == english[i] or string.sub(row[1],1,#color[1]) == color[1] then
                    if self._T.hairChoices[i] == nil or row[2] == baseRuid or row[2] == mixRuid then self._T.hairChoices[i] = row end
                end
            end
            local row = self._T.hairChoices[i]
            if row ~= nil then
                if row[2] == baseRuid then self._T.hairBase=i end
                if row[2] == mixRuid then self._T.hairMix=i end
            end
        end
        if self._T.hairBase == 0 then
            -- Unclassified custom hair must remain unchanged instead of becoming another style.
            self._T.hairChoices = {}
        end
        if self._T.hairMix == 0 then
            for i=1,8 do if self._T.hairChoices[i] ~= nil and i ~= self._T.hairBase then self._T.hairMix=i break end end
        end
        if self._T.hairMix == 0 then self._T.hairMix=self._T.hairBase end
        self._T.hairRatio = math.max(0,math.min(100,tonumber(ratio) or 50))
        self._T.hairPreviewKey = nil
        local equips = {}
        for i=1,27 do
            local value = _UIEquipInventoryManager:GetEquip(i)
            equips[i]={name=_UIEquipInventoryManager:ParseName(value),ruid=_UIEquipInventoryManager:ParseRUID(value),item=value}
        end
        self._T.hairPreviewEquips=equips
    end

    @ExecSpace("ClientOnly")
    method void SelectHairColor(string side, integer index)
        -- Palette clicks affect the pending preview only.
        if not self.opened or not self._T.hair or self._T.hairChoices[index] == nil then return end
        if side == "Mix" and index == self._T.hairBase then return end
        if side == "Base" then
            local previous=self._T.hairBase
            self._T.hairBase=index
            if self._T.hairMix==index then self._T.hairMix=previous end
        else self._T.hairMix=index end
        self:DrawHairMix()
        _UIAudio:Play("BtMouseClick")
    end

    @ExecSpace("ClientOnly")
    method void SetHairRatio(number value)
        -- Clamp and round to one-percent steps for slider and arrow buttons.
        if not self.opened or not self._T.hair then return end
        self._T.hairRatio=math.max(0,math.min(100,math.floor(value+0.5)))
        self:DrawHairMix()
    end

    @ExecSpace("ClientOnly")
    method string BuildHairItem()
        -- Persist selection and tint in the item so moves, saves and outfit sync retain it.
        local original=self._T.original or ""
        local base=self._T.hairChoices[self._T.hairBase]
        local mix=self._T.hairChoices[self._T.hairMix]
        if base == nil or mix == nil then return original end
        local ratio=self._T.hairRatio or 0
        local row=ratio==100 and mix or base
        local suffix=string.match(original,"^[^|]*|[^|]*(|.*)$")
        if suffix==nil then return "" end
        suffix=string.gsub(suffix,"|hairMix:[^|]*","")
        suffix=string.gsub(suffix,"|dye:[^|]*","")
        suffix=string.gsub(suffix,"|dyePower:[^|]*","")
        suffix=string.gsub(suffix,"|dyeHSV:[^|]*","")
        local item=row[1].."|"..row[2]..suffix
        if ratio>0 and ratio<100 and base[2]~=mix[2] then
            -- MSW exposes part tint, not native two-texture hair blending. Approximate
            -- the target palette relative to the base while preserving its shading.
            local palette=self:HairPalette()
            local a=Color.FromHexCode("#"..palette[self._T.hairBase][2])
            local b=Color.FromHexCode("#"..palette[self._T.hairMix][2])
            local t=ratio/100
            local r=math.min(2,((1-t)*a.r+t*b.r)/a.r)
            local g=math.min(2,((1-t)*a.g+t*b.g)/a.g)
            local blue=math.min(2,((1-t)*a.b+t*b.b)/a.b)
            local power=math.max(1,r,g,blue)
            local hex=string.format("%02X%02X%02X",math.floor(r/power*255+0.5),math.floor(g/power*255+0.5),math.floor(blue/power*255+0.5))
            item=item.."|dye:"..hex.."|dyePower:"..tostring(math.floor(power*100+0.5))
        end
        return item.."|hairMix:"..base[2]..","..mix[2]..","..tostring(ratio)
    end

    @ExecSpace("ClientOnly")
    method void DrawHairMix()
        -- The preview shares the same costume/tint path as the equipped character.
        local palette=self:HairPalette()
        for _,side in ipairs({"Base","Mix"}) do
            local selected=side=="Base" and self._T.hairBase or self._T.hairMix
            for i,color in ipairs(palette) do
                local button=self:UI("HairMix/"..side.."/Color"..tostring(i))
                local available=self._T.hairChoices[i]~=nil
                button.ButtonComponent.Enable=available and not (side=="Mix" and i==self._T.hairBase)
                if self._T.source == "creation" then
                    button.SpriteGUIRendererComponent.Color=available and (selected==i and Color(.88,.65,.32,1) or Color(.96,.85,.65,1)) or Color(.8,.76,.67,.6)
                else
                    _UITheme:Button(button, available and (selected==i and Color(.24,.26,.28,1) or Color(.13,.14,.15,1)) or Color(.085,.09,.095,0.6))
                end
                button:GetChildByName("Selected").Enable=available and selected==i
                button:GetChildByName("Label").TextGUIRendererComponent.Text=available and color[1] or color[1].."\n미지원"
            end
        end
        local ratio=self._T.hairRatio or 0
        self._T.settingHair=true
        self:UI("HairMix/Ratio").SliderComponent.Value=ratio
        self._T.settingHair=false
        local a=palette[self._T.hairBase]
        local b=palette[self._T.hairMix]
        self:UI("HairMix/BaseValue").TextGUIRendererComponent.Text=(a and a[1] or "원본").." "..tostring(100-ratio).."%"
        self:UI("HairMix/MixValue").TextGUIRendererComponent.Text=(b and b[1] or "원본").." "..tostring(ratio).."%"
        self:UI("HairMix/Note").TextGUIRendererComponent.Text=a and "두 색과 비율을 선택한 뒤 적용하기를 눌러주세요." or "이 헤어에는 기본 8색 변형이 등록되어 있지 않습니다."
        self:UI("HairMix/Ratio").SliderComponent.Enable=a~=nil
        local item=self:BuildHairItem()
        self:UI("HairMix/Name").TextGUIRendererComponent.Text=_UIEquipInventoryManager:ParseName(item)
        if self._T.hairPreviewKey==item then return end
        self._T.hairPreviewKey=item
        local equips=self._T.hairPreviewEquips
        equips[2]={name=_UIEquipInventoryManager:ParseName(item),ruid=_UIEquipInventoryManager:ParseRUID(item),item=item}
        local finals=_DecoWindowManager:ComposeAppearance(equips,_DecoWindowManager:ExportDeco(),_UIMyInfoManager:GetSelectedCharacterJobIdx())
        -- Uncover the hair in the dye preview even if the character wears a hat.
        for _,f in ipairs(finals) do if f[1]==5 then f[2]="" end end
        if _DecoWindowManager:DecoRuid("skin")=="" then table.insert(finals,{1,"3cf4cb29ae344577b9eed37e531688a4"}) end
        if self._T.source=="creation" then
            local setting=self:CreationSetting()
            if setting~=nil then finals=setting:CreationAppearance(item) end
        end
        local cm=self:UI("HairMix/Avatar").CostumeManagerComponent
        cm.UseCustomEquipOnly=true
        _DecoWindowManager:ApplyCostumeSnapshot(cm,finals)
        if Environment:IsMakerPlay() then log("[HairMix] preview base="..tostring(self._T.hairBase).." mix="..tostring(self._T.hairMix).." ratio="..tostring(ratio)) end
    end

    @ExecSpace("ClientOnly")
    method void CommitNumber(string field, string text)
        if not self.opened or not self._T.dye or self._T.settingHSV then return end
        if field~="Hue" and field~="Saturation" and field~="Value" then return end
        local slider=self:UI("Advanced/"..field).SliderComponent
        local value=tonumber(text)
        if value==nil or value~=value then value=slider.Value end
        value=math.floor(math.max(slider.MinValue,math.min(slider.MaxValue,value))*100+0.5)/100
        self._T.settingHSV=true
        slider.Value=value
        self:UI("Advanced/"..field.."Value").TextGUIRendererInputComponent.Text=string.format("%.2f",value)
        self._T.settingHSV=false
        self:DrawAdvanced()
    end

    @ExecSpace("ClientOnly")
    method void SetHSV(string item)
        -- Original brightness is centered at 50%; old RGB-only dyes retain their brightness.
        local hex=string.match(item,"^%x%x%x%x%x%x$") or string.match(item,"|dye:(%x%x%x%x%x%x)") or "FFFFFF"
        local h,s,v=Color.RGBToHSV(Color.FromHexCode("#"..hex))
        local savedH,savedS,savedV=string.match(item,"|dyeHSV:([%d.]+),([%d.]+),([%d.]+)")
        self._T.settingHSV=true
        self:UI("Advanced/Hue").SliderComponent.Value=math.max(0,math.min(359,tonumber(savedH) or h*360))
        self:UI("Advanced/Saturation").SliderComponent.Value=math.max(0,math.min(100,tonumber(savedS) or s*100))
        self:UI("Advanced/Value").SliderComponent.Value=math.max(0,math.min(100,tonumber(savedV) or v*_DecoWindowManager:DyePower(item)*50))
        self._T.settingHSV=false
    end

    @ExecSpace("ClientOnly")
    method string BuildDyeItem()
        -- Keep unrelated item flags, and store extra brightness separately from RGB.
        local item=string.gsub(self._T.original,"|dye:%x%x%x%x%x%x","")
        item=string.gsub(item,"|dyePower:%d+","")
        item=string.gsub(item,"|dyeHSV:[^|]*","")
        local hex=self._T.dyeHex or "FFFFFF"
        local power=self._T.dyePower or 100
        if hex~="FFFFFF" then item=item.."|dye:"..hex end
        if power~=100 then item=item.."|dyePower:"..tostring(power) end
        item=item..string.format("|dyeHSV:%.2f,%.2f,%.2f",self:UI("Advanced/Hue").SliderComponent.Value,self:UI("Advanced/Saturation").SliderComponent.Value,self:UI("Advanced/Value").SliderComponent.Value)
        return item
    end

    @ExecSpace("ClientOnly")
    method void DrawAdvanced()
        -- Live preview only; Confirm commits to the original item.
        local h=self:UI("Advanced/Hue").SliderComponent.Value
        local s=self:UI("Advanced/Saturation").SliderComponent.Value
        local v=self:UI("Advanced/Value").SliderComponent.Value
        local power=math.max(1,v/50)
        local tint=Color.HSVToRGB(h/360,s/100,math.min(1,v/50))
        local hex=string.format("%02X%02X%02X",math.floor(tint.r*255+0.5),math.floor(tint.g*255+0.5),math.floor(tint.b*255+0.5))
        self._T.dyeHex=hex
        self._T.dyePower=math.floor(power*100+0.5)
        self:SyncNumber("Hue",h)
        self:SyncNumber("Saturation",s)
        self:SyncNumber("Value",v)
        -- 선택한 색조를 기준으로 채도/명도 막대의 예상 색을 표시한다.
        for i=0,47 do
            local ratio=i/47
            self:UI("Advanced/Saturation/Spectrum/Band"..tostring(i)).SpriteGUIRendererComponent.Color=Color.HSVToRGB(h/360,ratio,1)
            self:UI("Advanced/Value/Spectrum/Band"..tostring(i)).SpriteGUIRendererComponent.Color=Color.HSVToRGB(h/360,s/100,ratio*2,true)
        end
        local item=self:BuildDyeItem()
        self:UI("Name").TextGUIRendererComponent.Text=_UIEquipInventoryManager:ParseName(item)
        self:UI("Preview").SpriteGUIRendererComponent.ImageRUID="thumbnail://".._UIEquipInventoryManager:ParseRUID(item)
        _DecoWindowManager:ApplyDyeIcon(self:UI("Preview").SpriteGUIRendererComponent,hex,self._T.dyePower)
        local cached=self._T.dyePreviewFinals
        if cached~=nil then
            local ruid=_UIEquipInventoryManager:ParseRUID(item)
            for _,entry in ipairs(cached) do if entry[2]==ruid then entry[3]=hex entry[4]=self._T.dyePower end end
            _DecoWindowManager:ApplyDyes(self:UI("Advanced/Avatar").CostumeManagerComponent,cached)
            return
        end
        local equips={}
        for i=1,27 do
            local e=_UIEquipInventoryManager:GetEquip(i)
            equips[i]={name=_UIEquipInventoryManager:ParseName(e),ruid=_UIEquipInventoryManager:ParseRUID(e),item=e}
        end
        local deco={}
        for key,value in pairs(_DecoWindowManager:ExportDeco()) do deco[key]=value end
        local key=_DecoWindowManager:SlotKeyForCat(_UIEquipInventoryManager:GetField(item,4))
        deco[key]=item
        if _UIEquipInventoryManager:GetField(item,4)=="longcoat" then deco.pants="" end
        local finals=_DecoWindowManager:ComposeAppearance(equips,deco,_UIMyInfoManager:GetSelectedCharacterJobIdx())
        table.insert(finals,{1,"3cf4cb29ae344577b9eed37e531688a4"})
        self._T.dyePreviewFinals=finals
        _DecoWindowManager:ApplyCostumeSnapshot(self:UI("Advanced/Avatar").CostumeManagerComponent,finals)
    end

    @ExecSpace("ClientOnly")
    method any CreationSetting()
        local e=_EntityService:GetEntityByPath("/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/CharacterSettingPanel")
        if isvalid(e) then return e.CharacterSettingComponent end
        return nil
    end

end
