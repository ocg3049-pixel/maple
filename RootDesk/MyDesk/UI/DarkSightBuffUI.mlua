@Logic
@ExecSpace("ClientOnly")
script DarkSightBuffUI extends Logic

	-- 다크사이트(1차 버프) 버프바 아이콘. DragonBloodBuffUI 복제 - UUID는 UIBuilder가 write bind로 주입한다.
	-- 최대 지속 160초지만 (1) 공격하면 즉시 풀리고 (2) 스킬을 한 번 더 눌러도 풀리므로,
	-- 남은 시간이 남아 있어도 HideBuff로 곧바로 내려갈 수 있다(서버 PlayerAttack.EndDarkSight
	-- → NotifyDarkSightEnded → SkillManager.OnDarkSightEnded 경로).
	property Entity buffIconGroup = "27e49239-4d97-4bc1-b0e0-1d5a829f2c84"
	property SpriteGUIRendererComponent grayOverlay = "a0d5df13-94fa-45f0-aee7-04ee20650156"
	property TextComponent countdownText = "2edea67a-8cc7-477e-a384-5dba18b28820"

	@ExecSpace("ClientOnly")
	method void ShowBuff(number duration)
		-- 다크사이트 지속시간(최대 160초) 표시/갱신.
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.dsTotalDuration = duration
		self._T.dsRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.dsTimerId then
			_UIFrameTicker:Unsubscribe(self._T.dsTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.dsTimerId = _UIFrameTicker:Subscribe(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.dsRemaining = self._T.dsRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
		if Environment:IsMakerPlay() then log("[DarkSightBuffUI] 버프 표시 시작 duration=" .. tostring(duration)) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateBuffDisplay()
		-- 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃 갱신.
		local remaining = self._T.dsRemaining
		local total = self._T.dsTotalDuration

		if remaining <= 0 then
			if self._T.dsTimerId then
				_UIFrameTicker:Unsubscribe(self._T.dsTimerId)
				self._T.dsTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideBuff()
		-- 조기 해제(공격 / 재사용 / 우클릭 취소 / 사망)했을 때 즉시 내린다.
		if not self:IsClient() then return end
		if self._T.dsRemaining == nil then return end
		self._T.dsRemaining = 0
		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.dsTimerId then
			_UIFrameTicker:Unsubscribe(self._T.dsTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	@ExecSpace("ClientOnly")
	method number GetRemaining()
		return self._T.dsRemaining or 0
	end

end
