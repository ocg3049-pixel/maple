	@ExecSpace("ClientOnly")
	method void AddGroup(table rows)
		-- All aliases point to the same selectable native colors.
		local choices = {}
		for _, row in ipairs(rows) do if row[4] then table.insert(choices, row) end end
		for _, row in ipairs(rows) do self._T.byRuid[row[2]] = choices; self._T.names[row[2]] = row[1] end
		table.insert(self._T.groups, choices)
	end

	@ExecSpace("ClientOnly")
	method table GetColors(string ruid)
		-- Unknown resources remain their original style instead of changing to a different hair or face.
		self:EnsureCatalog()
		return self._T.byRuid[ruid] or _CosmeticBoxCatalog:Colors(ruid) or {{"기본 색상", ruid, "기본", true}}
	end

	@ExecSpace("ClientOnly")
	method table GetCreationItems(string kind, integer colorIndex)
		-- Creation and in-game recoloring use the identical variant table.
		self:EnsureCatalog()
		local result = {}
		local first, last = 1, 17
		if kind == "face" then first, last = 18, 26 end
		for i = first, last do
			local colors = self._T.groups[i]
			local row = colors[((colorIndex - 1) % #colors) + 1]
			table.insert(result, row)
		end
		return result
	end

