@Logic
script AppearanceColorCatalog extends Logic

	@ExecSpace("ClientOnly")
	method void EnsureCatalog()
		-- Registered color variants for creation and currently available appearance items.
		if self._T.byRuid ~= nil then return end
		self._T.byRuid = {}
		self._T.names = {}
