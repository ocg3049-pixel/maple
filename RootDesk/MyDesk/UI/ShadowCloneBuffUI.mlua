@Logic
@ExecSpace("ClientOnly")
script ShadowCloneBuffUI extends Logic

	-- 분신 소환(섀도어 1차) 지속시간 표시. AmhaengBuffUI 복제 - 버프바 아이콘 위에 회색 오버레이가
	-- 차오르고 남은 시간이 숫자로 뜬다. 최대 5분짜리라 60초 이상은 "분" 단위(노란색)로 표시한다.
	-- UUID는 UIBuilder가 write bind로 주입한다.
	--
	-- (신고 2026-08-06) 분신은 지속시간이 30초~5분으로 길게 바뀌었는데 남은 시간이 어디에도 표시되지
	-- 않아 "언제 사라지는지 모르겠다"는 지적이 있었다. 다른 소환 버프(용사/힐러/용)와 같은 규격으로 띄운다.

	property Entity buffIconGroup = "b85bc40a-d916-418f-a7cf-ad261301b5fa"
	property SpriteGUIRendererComponent grayOverlay = "f30686c1-668b-4e6d-bb1c-a1eef1e5ce85"
	property TextComponent countdownText = "694f9c6d-bb38-430b-a09d-ada81ded0b7e"

	method void ShowBuff(number duration)
		-- 분신 지속시간 표시/갱신. 재소환하면 새 지속시간으로 교체된다(아이콘이 중첩되지 않는다).
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.scTotalDuration = duration
		self._T.scRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.scTimerId then
			_TimerService:ClearTimer(self._T.scTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.scTimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.scRemaining = self._T.scRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
		log("[ShadowCloneBuffUI] 버프 표시 시작 duration=" .. tostring(duration))
	end

	method void UpdateBuffDisplay()
		-- 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃을 갱신한다.
		local remaining = self._T.scRemaining
		local total = self._T.scTotalDuration

		if remaining <= 0 then
			if self._T.scTimerId then
				_TimerService:ClearTimer(self._T.scTimerId)
				self._T.scTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(1, 1, 1, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(1, 1, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	method void HideBuff()
		-- (우클릭 취소 / 만료) 표시를 즉시 정리한다.
		if not self:IsClient() then return end
		if self._T.scRemaining == nil then return end
		self._T.scRemaining = 0
		self:UpdateBuffDisplay()
	end

	method void OnEndPlay()
		if self._T.scTimerId then
			_TimerService:ClearTimer(self._T.scTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	method number GetRemaining()
		return self._T.scRemaining or 0
	end

end
