@Logic
script SkillPointNotice extends Logic
    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        local e=_EntityService:GetEntityByPath("/ui/SkillPointNotice/Notice")
        self._T.button=e self._T.links={}
        local body=e:GetChildByName("Open")
        table.insert(self._T.links,{e=body,h=body:ConnectEvent(ButtonClickEvent,function()
            if not _UIClickArbiter:CanUseNoticeButton(body) then return end
            if _MobileUIManager:IsMobile() then _MobileUIManager:ToggleSkillBook()
            else
                local w=_EntityService:GetEntityByPath("/ui/DefaultGroup/SkillWindow")
                w.Enable=true _UIEquipInventoryManager:BringWindowToFront(w.Path)
                _SkillManager:SwitchSkillTab(_SkillManager:DefaultSkillTab())
                _SkillManager:RefreshSkillWindowForLevelChange()
            end
        end)})
        local icon=e:GetChildByName("Collapsed")
        table.insert(self._T.links,{e=icon,h=icon:ConnectEvent(ButtonClickEvent,function()
            if not _UIClickArbiter:CanUseNoticeButton(icon) then return end
            _GameSystemMenu.skillNoticeCollapsed=false _GameSystemMenu:SavePreferences() self:Draw()
        end)})
        local fold=e:GetChildByName("Collapse")
        table.insert(self._T.links,{e=fold,h=fold:ConnectEvent(ButtonClickEvent,function()
            if not _UIClickArbiter:CanUseNoticeButton(fold) then return end
            _GameSystemMenu.skillNoticeCollapsed=not _GameSystemMenu.skillNoticeCollapsed
            _GameSystemMenu:SavePreferences() self:Draw()
            log("[NoticeFold] skill="..tostring(_GameSystemMenu.skillNoticeCollapsed))
        end)})
    end

    @ExecSpace("ClientOnly")
    method void Draw()
        local e=self._T.button if not isvalid(e) then return end
        local count=math.max(0,_SkillManager:GetRemainingSkillPoints())
        e.Enable=_LoginFlow:IsInGame() and not _BossStageManager:HidesFieldNotices() and count>0
        local folded=_GameSystemMenu.skillNoticeCollapsed
        local mobile=_MobileUIManager:IsMobile()
        e.UITransformComponent.RectSize=folded and Vector2(88,88) or Vector2(mobile and 300 or 244,mobile and 88 or 86)
        e:GetChildByName("Collapse").UITransformComponent.RectSize=mobile and Vector2(88,88) or Vector2(44,44)
        e.SpriteGUIRendererComponent.Enable=not folded
        e:GetChildByName("Collapse").Enable=not folded
        e:GetChildByName("Collapsed").Enable=folded
        e:GetChildByName("Collapsed"):GetChildByName("Badge").TextGUIRendererComponent.Text="SP +"..tostring(count)
        local body=e:GetChildByName("Open")
        body.Enable=not folded
        body.UITransformComponent.RectSize=Vector2(196,mobile and 88 or 86)
        body.TextGUIRendererComponent.Text=folded and "스킬 포인트 +"..tostring(count) or "스킬 포인트 +"..tostring(count).."\n눌러서 분배하기"
        e:GetChildByName("Collapse").TextGUIRendererComponent.Text=folded and "+" or "−"
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        self._T.tick=(self._T.tick or 0)+delta if self._T.tick<0.5 then return end self._T.tick=0
        self:Draw()
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _,link in ipairs(self._T.links or {}) do if isvalid(link.e) then link.e:DisconnectEvent(ButtonClickEvent,link.h) end end
    end
end
