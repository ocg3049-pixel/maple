@Logic
@ExecSpace("ClientOnly")
script AssassinateCooldownUI extends Logic

	-- 암살(4차) 기본 10초, 연막 중 2초 쿨타임을 퀵슬롯 위에 표시한다.
	property SpriteGUIRendererComponent grayOverlay = "eaa79617-10a6-433e-b58a-9895ace2a37c"
	property TextComponent countdownText = "f1b1cd7d-f6c2-47c9-aec3-9a40cd5ee0f8"

	method void ShowCooldown(number duration, string slotKey)
		if not self:IsClient() or duration <= 0 then return end
		self._T.totalDuration = duration
		self._T.remaining = duration
		self._T.slotKey = slotKey
		if isvalid(self.grayOverlay) then
			self.grayOverlay.Type = ImageType.Filled
			self.grayOverlay.FillMethod = FillMethodType.Vertical
		end
		local slotEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar/Slot_" .. tostring(slotKey))
		if isvalid(slotEnt) then
			local slotPos = slotEnt.UITransformComponent.anchoredPosition
			if isvalid(self.grayOverlay) then self.grayOverlay.Entity.UITransformComponent.anchoredPosition = Vector2(slotPos.x, slotPos.y + 4) end
			if isvalid(self.countdownText) then self.countdownText.Entity.UITransformComponent.anchoredPosition = Vector2(slotPos.x, slotPos.y + 4) end
		end
		if isvalid(self.grayOverlay) then self.grayOverlay.Entity.Enable = true end
		if isvalid(self.countdownText) then self.countdownText.Entity.Enable = true end
		if self._T.timerId then _TimerService:ClearTimer(self._T.timerId) end
		local preTime = _UtilLogic.ElapsedSeconds
		self._T.timerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			self._T.remaining = self._T.remaining - (now - preTime)
			preTime = now
			self:UpdateCooldownDisplay()
		end, 1 / 60)
		self:UpdateCooldownDisplay()
		log("[AssassinateCooldownUI] 쿨타임 표시 시작 duration=" .. tostring(duration) .. " slot=" .. tostring(slotKey))
	end

	method void UpdateCooldownDisplay()
		local remaining = self._T.remaining or 0
		local total = self._T.totalDuration or 1
		if remaining <= 0 then
			if self._T.timerId then _TimerService:ClearTimer(self._T.timerId); self._T.timerId = nil end
			if isvalid(self.grayOverlay) then self.grayOverlay.Entity.Enable = false end
			if isvalid(self.countdownText) then self.countdownText.Entity.Enable = false end
			_SkillManager:BlinkSlotReady(self._T.slotKey or "")
			return
		end
		if isvalid(self.grayOverlay) then self.grayOverlay.FillAmount = math.max(0, math.min(1, remaining / total)) end
		if isvalid(self.countdownText) then
			self.countdownText.FontColor = Color(1, 1, 1, 1)
			self.countdownText.Text = tostring(math.ceil(remaining))
		end
	end

	method void ResetCooldown()
		if not self:IsClient() then return end
		if self._T.timerId then self._T.remaining = 0; self:UpdateCooldownDisplay() end
	end

	method void OnEndPlay()
		if self._T.timerId then _TimerService:ClearTimer(self._T.timerId) end
	end

end
