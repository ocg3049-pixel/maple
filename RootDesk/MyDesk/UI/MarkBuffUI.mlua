@Logic
@ExecSpace("ClientOnly")
script MarkBuffUI extends Logic

	-- 마크 오브 어쌔신(나이트로드 1차 토글) 활성 표시. 지속시간이 없는 무기한 토글이라
	-- 카운트다운/오버레이 없이 아이콘만 켜고 끈다(우측 상단 버프바 - BuffBarManager가 정렬).
	-- UUID는 UIBuilder가 write bind로 주입한다.

	property Entity buffIconGroup = "ae1bb217-0927-416a-b5a6-a8e65d6242f5"

	method void ShowBuff()
		-- 토글 ON: 버프바에 아이콘을 띄운다.
		if not self:IsClient() then return end
		self._T.markOn = true
		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end
	end

	method void HideBuff()
		-- 토글 OFF(수동/우클릭 취소 공용): 아이콘을 내린다.
		self._T.markOn = false
		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = false
		end
	end

	method number GetRemaining()
		-- 버프 아이콘 정렬(BuffBarManager)용. 무기한 토글이라 켜져 있으면 큰 값을 돌려준다.
		if self._T.markOn == true then return 999999 end
		return 0
	end

end
