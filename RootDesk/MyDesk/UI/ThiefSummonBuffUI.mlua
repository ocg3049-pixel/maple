@Logic
@ExecSpace("ClientOnly")
script ThiefSummonBuffUI extends Logic

	-- 도적 소환 버프바 아이콘. RageBuffUI 복제 - UUID는 UIBuilder가 write bind로 주입한다.
	property Entity buffIconGroup = "18a1f976-c664-4e80-b85c-5813d7d2b76b"
	property SpriteGUIRendererComponent grayOverlay = "a943a830-0132-4303-9948-4a45a892de5c"
	property TextComponent countdownText = "ced79184-fcae-4bdf-9410-89cf19c21673"

	@ExecSpace("ClientOnly")
	method void ShowBuff(number duration)
		-- 도적 소환 지속시간 표시/갱신(분노와 동일한 매커니즘). 재소환하면 새 타이머로 교체된다.
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.summonTotalDuration = duration
		self._T.summonRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.summonTimerId then
			_UIFrameTicker:Unsubscribe(self._T.summonTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.summonTimerId = _UIFrameTicker:Subscribe(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.summonRemaining = self._T.summonRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void UpdateBuffDisplay()
		-- 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃 갱신.
		local remaining = self._T.summonRemaining
		local total = self._T.summonTotalDuration

		if remaining <= 0 then
			if self._T.summonTimerId then
				_UIFrameTicker:Unsubscribe(self._T.summonTimerId)
				self._T.summonTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideBuff()
		-- 소환수가 도중에 죽거나(HP 0) 해제될 때 버프바를 즉시 내린다.
		if not self:IsClient() then return end
		if self._T.summonRemaining == nil then return end
		self._T.summonRemaining = 0
		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.summonTimerId then
			_UIFrameTicker:Unsubscribe(self._T.summonTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	@ExecSpace("ClientOnly")
	method number GetRemaining()
		return self._T.summonRemaining or 0
	end

end
