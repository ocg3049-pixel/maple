@Logic
script RegionExpansionCatalog extends Logic
    -- Shared catalog for the nine field regions. Monster entries mirror placed models.
    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Report the region catalog imported into this session.
        if Environment:IsMakerPlay() then log("[RegionExpansion] regions=" .. tostring(#self:Regions()) .. " maps=" .. tostring(#self:Destinations()) .. " monsterKinds=" .. tostring(#self:Codex())) end
    end

