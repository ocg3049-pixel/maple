@Logic
script GameAudio extends Logic
    property number bgmVolume = 0.6
    property number sfxVolume = 0.8

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.loops = {}
        for name, id in pairs({Portal="952bafe2e6ca4c3e8522d1ca839bd234", Quest="9ac61b9e20934031a749e240174041a2"}) do
            local e = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
            if isvalid(e) then e.SoundComponent.AudioClipRUID = "" e.SoundComponent.AudioClipRUID = id end
        end
        self._T.duck = 1
        _ResourceService:PreloadAsync({"952bafe2e6ca4c3e8522d1ca839bd234", "9ac61b9e20934031a749e240174041a2"}, function(results)
            for i, result in ipairs(results) do log("[GameAudio] preload " .. tostring(i) .. "=" .. tostring(result)) end
        end)
    end

    @ExecSpace("Client")
    method void PlaySound(string id, number volume)
        if self.sfxVolume > 0 then _SoundService:PlaySound(id, volume * self.sfxVolume) end
    end

    @ExecSpace("Client")
    method void PlaySoundAtPos(string id, Vector3 pos, Entity listener, number volume)
        if self.sfxVolume > 0 then _SoundService:PlaySoundAtPos(id, pos, listener, volume * self.sfxVolume) end
    end

    @ExecSpace("Client")
    method void PlayLoopSound(string id, number volume)
        self._T.loops = self._T.loops or {}
        self._T.loops[id] = volume
        if self.sfxVolume > 0 then _SoundService:PlayLoopSound(id, volume * self.sfxVolume) end
    end

    @ExecSpace("Client")
    method void StopSound(string id)
        if self._T.loops then self._T.loops[id] = nil end
        _SoundService:StopSound(id)
    end

    @ExecSpace("ClientOnly")
    method void SetBGMVolume(number volume)
        self._T.duck = volume
        _SoundService:SetBGMVolume(volume * self.bgmVolume * (_UIAudio._T.mapGain or 1))
    end

    @ExecSpace("ClientOnly")
    method void SetVolumes(number bgm, number sfx)
        self.bgmVolume = math.max(0, math.min(1, bgm))
        self.sfxVolume = math.max(0, math.min(1, sfx))
        _SoundService:SetBGMVolume(self.bgmVolume * (self._T.duck or 1) * (_UIAudio._T.mapGain or 1))
        for id, volume in pairs(self._T.loops or {}) do
            _SoundService:StopSound(id)
            if self.sfxVolume > 0 then _SoundService:PlayLoopSound(id, volume * self.sfxVolume) end
        end
        for _, name in ipairs({"Portal", "Quest"}) do
            local entity = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
            if isvalid(entity) then entity.SoundComponent.Volume = self.sfxVolume end
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayCue(string name)
        local entity = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
        if not isvalid(entity) or self.sfxVolume <= 0 then return end
        local sound = entity.SoundComponent
        sound.Volume = self.sfxVolume
        sound.Mute = false
        sound:Stop()
        sound:Play()
        log("[GameAudio] cue=" .. name .. " loaded=" .. tostring(sound:IsAudioClipLoaded()))
    end

    @ExecSpace("ClientOnly")
    method void QueueTravel(string destination)
        -- 이동 전에 시작한 소리가 전환 중 끊기지 않도록 도착 맵 반영 후 재생한다.
        self._T.travelDestination = destination
        self._T.travelAge = 0
        self._T.arrivalAge = 0
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        local p = _UserService.LocalPlayer
        if not isvalid(p) or not isvalid(p.CurrentMap) then return end
        if self._T.map ~= p.CurrentMap then
            self._T.map = p.CurrentMap
            self._T.restoreBgm = 0.5
        end
        if self._T.restoreBgm ~= nil then
            self._T.restoreBgm = self._T.restoreBgm - delta
            if self._T.restoreBgm <= 0 then
                _SoundService:SetBGMVolume(self.bgmVolume * (self._T.duck or 1) * (_UIAudio._T.mapGain or 1))
                self._T.restoreBgm = nil
            end
        end
        if self._T.travelDestination ~= nil then
            self._T.travelAge = self._T.travelAge + delta
            if _ChannelManager:BaseName(p.CurrentMap.Name) == self._T.travelDestination then self._T.arrivalAge = self._T.arrivalAge + delta else self._T.arrivalAge = 0 end
            if self._T.arrivalAge >= 1.2 then
                self._T.travelDestination = nil
                self:PlayCue("Portal")
            elseif self._T.travelAge > 10 then self._T.travelDestination = nil end
        end
    end
end
