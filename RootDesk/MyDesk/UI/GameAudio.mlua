@Logic
script GameAudio extends Logic
    property number bgmVolume = 0.20
    property number sfxVolume = 0.40
    property boolean muted = false
    property number bossSfxGain = 1.5

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _ResourceService:PreloadAsync({"9c379f5ea86b4a698cd8191c4eb42411"}, function(results) if Environment:IsMakerPlay() then log("[LevelUpAudio] preload="..tostring(results[1])) end end)
        self._T.loops = {}
        for name, id in pairs({Portal="952bafe2e6ca4c3e8522d1ca839bd234", Quest="2eb4855233f041b19aaac1bcd4fd82e9"}) do
            local e = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
            if isvalid(e) then e.SoundComponent.AudioClipRUID = "" e.SoundComponent.AudioClipRUID = id end
        end
        self._T.duck = 1
        _ResourceService:PreloadAsync({"952bafe2e6ca4c3e8522d1ca839bd234", "2eb4855233f041b19aaac1bcd4fd82e9"}, function(results)
            for i, result in ipairs(results) do if Environment:IsMakerPlay() then log("[GameAudio] preload " .. tostring(i) .. "=" .. tostring(result)) end end
        end)
    end

    @ExecSpace("Client")
    method void PlaySound(string id, number volume)
        if not self.muted and self.sfxVolume > 0 then self:TrackSound(id) _SoundService:PlaySound(id, volume * self.sfxVolume) end
    end

    @ExecSpace("ClientOnly")
    method number GetBossSfxVolume(number baseVolume)
        -- Boss cues share the user's effect volume and stay inside the native 0..1 range.
        if self.muted then return 0 end
        return math.max(0,math.min(1,baseVolume*self.bossSfxGain*self.sfxVolume))
    end

    @ExecSpace("Client")
    method void PlayBossSound(string id, number baseVolume)
        -- Boost boss skills, parries and received-hit cues once, without changing field combat audio.
        local volume=self:GetBossSfxVolume(baseVolume)
        if id=="" or volume<=0 then return end
        self:TrackSound(id)
        _SoundService:PlaySound(id,volume)
        self._T.bossSoundVerified=self._T.bossSoundVerified or {}
        if not self._T.bossSoundVerified[id] then
            self._T.bossSoundVerified[id]=true
            if Environment:IsMakerPlay() then log("[BossAudio] ruid="..id.." gain="..tostring(self.bossSfxGain).." volume="..tostring(volume)) end
        end
    end

    @ExecSpace("Client")
    method void PlaySoundAtPos(string id, Vector3 pos, Entity listener, number volume)
        if not self.muted and self.sfxVolume > 0 then self:TrackSound(id) _SoundService:PlaySoundAtPos(id, pos, listener, volume * self.sfxVolume) end
    end

    @ExecSpace("Client")
    method void PlayLoopSound(string id, number volume)
        self._T.loops = self._T.loops or {}
        self._T.loops[id] = volume
        if not self.muted and self.sfxVolume > 0 then _SoundService:PlayLoopSound(id, volume * self.sfxVolume) end
    end

    @ExecSpace("Client")
    method void StopSound(string id)
        if self._T.loops then self._T.loops[id] = nil end
        _SoundService:StopSound(id)
    end

    @ExecSpace("ClientOnly")
    method void SetBGMVolume(number volume)
        self._T.duck = volume
        _SoundService:SetBGMVolume(volume * self:GetBgmGain() * (_UIAudio._T.mapGain or 1))
    end

    @ExecSpace("ClientOnly")
    method void SetVolumes(number bgm, number sfx)
        self.bgmVolume = math.max(0, math.min(1, bgm))
        self.sfxVolume = math.max(0, math.min(1, sfx))
        self:ApplyNativeMute(self.muted or self.sfxVolume <= 0)
        _SoundService:SetBGMVolume(self:GetBgmGain() * (self._T.duck or 1) * (_UIAudio._T.mapGain or 1))
        for id, volume in pairs(self._T.loops or {}) do
            _SoundService:StopSound(id)
            if not self.muted and self.sfxVolume > 0 then _SoundService:PlayLoopSound(id, volume * self.sfxVolume) end
        end
        for _, name in ipairs({"Portal", "Quest"}) do
            local entity = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
            if isvalid(entity) then entity.SoundComponent.Volume = self.muted and 0 or self.sfxVolume end
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayCue(string name)
        local entity = _EntityService:GetEntityByPath("/ui/GameSystem/Audio/" .. name)
        if not isvalid(entity) or self.muted or self.sfxVolume <= 0 then return end
        local sound = entity.SoundComponent
        sound.Volume = self.sfxVolume
        sound.Mute = false
        sound:Stop()
        sound:Play()
        if Environment:IsMakerPlay() then log("[GameAudio] cue=" .. name .. " loaded=" .. tostring(sound:IsAudioClipLoaded())) end
    end

    @ExecSpace("ClientOnly")
    method number GetBgmGain()
        return self.muted and 0 or self.bgmVolume
    end

    @ExecSpace("ClientOnly")
    method void TrackSound(string id)
        self._T.playedSounds = self._T.playedSounds or {}
        self._T.playedSounds[id] = true
    end

    @ExecSpace("ClientOnly")
    method void SetMuted(boolean value)
        self.muted = value
        if value then
            for id, _ in pairs(self._T.playedSounds or {}) do _SoundService:StopSound(id) end
            self._T.playedSounds = {}
            _UIAudio._T.pending = {}
        end
        local audioRoot = _EntityService:GetEntityByPath("/ui/GameSystem/Audio")
        if isvalid(audioRoot) then
            for _, sound in ipairs(audioRoot:GetChildComponentsByTypeName("MOD.Core.SoundComponent", true)) do
                sound.Mute = value
            end
        end
        self:SetVolumes(self.bgmVolume, self.sfxVolume)
        if Environment:IsMakerPlay() then log("[GameAudio] mute=" .. tostring(value) .. " bgm=" .. tostring(self.bgmVolume) .. " sfx=" .. tostring(self.sfxVolume)) end
    end

    @ExecSpace("ClientOnly")
    method void QueueTravel(string destination)
        -- 이동 전에 시작한 소리가 전환 중 끊기지 않도록 도착 맵 반영 후 재생한다.
        self._T.travelDestination = destination
        self._T.travelAge = 0
        self._T.arrivalAge = 0
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        local p = _UserService.LocalPlayer
        if not isvalid(p) or not isvalid(p.CurrentMap) then return end
        if self._T.map ~= p.CurrentMap then
            self._T.map = p.CurrentMap
            self._T.restoreBgm = 0.5
        end
        if self._T.restoreBgm ~= nil then
            self._T.restoreBgm = self._T.restoreBgm - delta
            if self._T.restoreBgm <= 0 then
                _SoundService:SetBGMVolume(self:GetBgmGain() * (self._T.duck or 1) * (_UIAudio._T.mapGain or 1))
                self._T.restoreBgm = nil
            end
        end
        if self._T.travelDestination ~= nil then
            self._T.travelAge = self._T.travelAge + delta
            if _ChannelManager:BaseName(p.CurrentMap.Name) == self._T.travelDestination then self._T.arrivalAge = self._T.arrivalAge + delta else self._T.arrivalAge = 0 end
            if self._T.arrivalAge >= 1.2 then
                self._T.travelDestination = nil
                self:PlayCue("Portal")
            elseif self._T.travelAge > 10 then self._T.travelDestination = nil end
        end
    end
    @ExecSpace("ClientOnly")
    method void ApplyNativeMute(boolean silent)
        -- Engine jump/melee audio bypasses PlaySound; override only this client's native preferences.
        self._T.nativeSounds = self._T.nativeSounds or {}
        for _, key in ipairs({"DeathSound","JumpSound","WeaponBowSound","WeaponCaneSound","WeaponCannonSound","WeaponCrossBowSound","WeaponDualBowSound","WeaponGunSound","WeaponKnuckleSound","WeaponMaceSound","WeaponPoleArmSound","WeaponSpearSound","WeaponSwordBSound","WeaponSwordKSound","WeaponSwordLSound","WeaponSwordSSound","WeaponSwordZBSound","WeaponSwordZLSound","WeaponTGloveSound"}) do
            if silent then
                if self._T.nativeSounds[key] == nil then self._T.nativeSounds[key] = _MaplePreferencesLogic[key] end
                local original = self._T.nativeSounds[key]
                if original ~= "" and original ~= "UNSET" then _SoundService:StopSound(original) end
                _MaplePreferencesLogic[key] = ""
            elseif self._T.nativeSounds[key] ~= nil then
                _MaplePreferencesLogic[key] = self._T.nativeSounds[key]
                self._T.nativeSounds[key] = nil
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Restore engine preferences when this play session ends.
        self:ApplyNativeMute(false)
    end

    @ExecSpace("ClientOnly")
    method void ObserveLevel(integer level)
        local state=_CharacterPersistence._T.cl
        local id=_FieldRecoveryDrops.characterId
        if _LoginFlow.phase~="ingame" or state==nil or not state.entered or id=="" then
            self._T.levelCharacter=nil self._T.lastLevel=nil return
        end
        local previous=self._T.lastLevel
        local same=self._T.levelCharacter==id
        self._T.levelCharacter=id self._T.lastLevel=level
        if same and previous~=nil and level>previous then _EnhancementManager:PlayEquipmentLevelUp(previous,level) end
    end

end
