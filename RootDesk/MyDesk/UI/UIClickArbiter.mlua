@Logic
script UIClickArbiter extends Logic

	-- 겹친 창 클릭 관통 방지 공용 판정.
	-- 여러 창이 같은 화면 지점을 덮고 있을 때 UITouchDownEvent/ScreenTouchEvent는 겹친 모든
	-- 핸들러에 전달되므로("클릭이 뒤 창까지 발동" 버그), 각 창의 클릭 핸들러가 실행 전에
	-- IsTopmostAt(자기 창 경로, 터치 좌표)로 "내 창이 이 지점의 최상단인가"를 물어보게 한다.

	property any screenTouchHandler = nil

	@ExecSpace("ClientOnly")
	method boolean BlocksWorldClick(Vector2 touchPoint)
        if _SkillManager:BlocksAmountInput() then return true end
        if _MobileUIManager:BlocksPoint(touchPoint) then return true end
		-- NPC의 TouchEvent는 UI 클릭과 함께 발생하므로 월드 동작 전에 차단한다.
		if _UIItemDiscardManager:BlocksInput() then return true end
		if self:GetTopmostWindowAt(touchPoint) ~= "" then return true end
		-- 목록 밖의 상점/HUD/입력창 등도 네이티브 UI 판정으로 보호한다.
		return _InputService:IsPointerOverUI()
	end

	@ExecSpace("ClientOnly")
	method table GetWindowPaths()
		-- 겹침 판정 대상 창/팝업 목록 - UIEquipInventoryManager.BringWindowToFront의 형제 순서
		-- 체계와 같은 세트. TooltipPanel은 클릭을 받지 않는 표시 전용이라 제외한다
		-- (툴팁 아래를 클릭하면 그 밑의 창으로 통과되어야 한다).
		return {
			"/ui/DefaultGroup/ItemActionPopup",
            "/ui/DefaultGroup/Board",
            "/ui/DefaultGroup/Book",
            "/ui/DefaultGroup/MonsterCodexWindow",
            "/ui/DefaultGroup/PlayerContext",
            "/ui/SocialWindow/Window",
            "/ui/SocialWindow/PlayerContext",
            "/ui/DefaultGroup/PlayerInspect",
			"/ui/DefaultGroup/InvenWindow",
			"/ui/DefaultGroup/CashShopWindow",
			"/ui/DefaultGroup/EquipWindow",
			"/ui/DefaultGroup/DecoWindow",
			"/ui/DefaultGroup/EnhanceWindow",
			"/ui/DefaultGroup/SkillWindow",
			"/ui/DefaultGroup/CharInfoWindow",
			"/ui/DefaultGroup/ItemTypeSelectPopup",
			"/ui/DefaultGroup/BoxQuantityPopup",
			"/ui/DefaultGroup/KeySettingWindow",
			"/ui/DefaultGroup/BattleStatsWindow",
			-- (요청 2026-08-14) 전투분석 상세 창은 **전용 .ui 그룹**(GroupOrder 8)이라 DefaultGroup
			-- 형제 순서 체계 밖에 있다. 목록에는 넣되 순위는 GetTopmostWindowAt이 따로 올려 준다 -
			-- 안 넣으면 상세 창을 클릭해도 그 아래 DefaultGroup 창이 "최상단"으로 잡혀 클릭이 관통한다.
			"/ui/BattleStatsDetailWindow/Window",
		}
	end

	@ExecSpace("ClientOnly")
	method boolean ContainsUIPoint(Entity win, number ux, number uy)
		-- 창 루트가 "중앙 앵커 + anchoredPosition + 명시적 RectSize"라는 프로젝트 창 공통 규격을
		-- 전제로 한 사각형 검사 (KeySettingManager.HitRect / SkillManager.OnSkillWindowTouch와
		-- 같은 좌표 규약: UI 좌표 = 화면 중앙 원점, y 위쪽).
		local tr = win.UITransformComponent
		if not isvalid(tr) then return false end
		local pos = tr.anchoredPosition
		-- 미니맵은 화면 좌상단 앵커를 사용한다(다른 창은 중앙 앵커).
		if win.Name == "Board" and win.Parent.Name == "DefaultGroup" then
			pos = Vector2(pos.x - 960, pos.y + 540)
		end
		local sz = Vector2(tr.RectSize.x * math.abs(tr.UIScale.x), tr.RectSize.y * math.abs(tr.UIScale.y))
		local pv = tr.Pivot
		local left = pos.x - pv.x * sz.x
		local right = pos.x + (1 - pv.x) * sz.x
		local bottom = pos.y - pv.y * sz.y
		local top = pos.y + (1 - pv.y) * sz.y
		if ux >= left and ux <= right and uy >= bottom and uy <= top then return true end
        -- The docked automatic panel belongs to the enhancement window even outside its main rectangle.
        if win.Name == "EnhanceWindow" and not _StarforceMini.minimized then
            local panel = win:GetChildByName("AutoPanel")
            if isvalid(panel) and panel.EnabledInHierarchy and panel.Visible and tr.UIScale.x ~= 0 and tr.UIScale.y ~= 0 then
                return self:ContainsUIPoint(panel, (ux - pos.x) / tr.UIScale.x, (uy - pos.y) / tr.UIScale.y)
            end
        end
        return false
	end

	@ExecSpace("ClientOnly")
	method boolean ContainsScreenPoint(Entity win, Vector2 point)
		-- Use the actual screen transform, including resolution, anchors and parent scale.
		if not isvalid(win) or not win.EnabledInHierarchy or not win.VisibleInHierarchy then return false end
		local tr = win.UITransformComponent
		if not isvalid(tr) then return false end
		local p = _UICursorManager:ScreenToElementPoint(win, point)
		local sz, pv = tr.RectSize, tr.Pivot
		if p.x >= -pv.x * sz.x and p.x <= (1 - pv.x) * sz.x
			and p.y >= -pv.y * sz.y and p.y <= (1 - pv.y) * sz.y then return true end
		if win.Name == "EnhanceWindow" and not _StarforceMini.minimized then
			return self:ContainsScreenPoint(win:GetChildByName("AutoPanel"), point) or self:ContainsScreenPoint(win:GetChildByName("EquipmentPicker"), point)
		end
		return false
	end

    @ExecSpace("ClientOnly")
    method boolean CanUseNoticeButton(Entity button)
        -- Native touch clicks must not depend on the desktop cursor position.
        if not isvalid(button) or not button.EnabledInHierarchy then return false end
        local point=_InputService:GetCursorPosition()
        if _MobileUIManager:IsMobile() then
            local tr=button.UITransformComponent
            local center=Vector2((0.5-tr.Pivot.x)*tr.RectSize.x,(0.5-tr.Pivot.y)*tr.RectSize.y)
            point=_UILogic:WorldToScreenPosition(_UILogic:LocalUIToWorldPosition(center,tr))
            for _,path in ipairs({"MenuPanel","SkillBook","WorldMap","QuickslotPicker"}) do
                if self:ContainsScreenPoint(_MobileUIManager:UI(path),point) then return false end
            end
        end
        if self:GetTopmostWindowAt(point)~=button.Parent.Path then return false end
        _MobileUIManager:EndChatForAction(button)
        return true
    end

	@ExecSpace("ClientOnly")
	method string GetTopmostWindowAt(Vector2 touchPoint)
        if _SkillManager:BlocksAmountInput() then return "/ui/SkillPointDialog/Modal" end
        if _SpecialEquipment._T.replacement~=nil then return "/ui/AccessoryChoice/Modal" end
        if _MobileNumberPad:BlocksInput() then return "/ui/MobileNumberPad/Modal" end
		if _CosmeticExchange:BlocksInput() then return "/ui/CosmeticExchangeGroup/Modal" end
        if _AppearanceColorPicker:BlocksInput() then return "/ui/AppearanceColorGroup/Modal" end
        if _BossStageManager:BlocksInput() then return _BossStageManager._T.result and "/ui/BossStage/Result" or _BossStageManager._T.destination and "/ui/BossStage/Cover" or "/ui/BossStage/Modal" end
        if _RewardCenter:BlocksInput() then return "/ui/RewardCenter/Modal" end
        if _EventRewards:BlocksInput() then return "/ui/EventGroup/Modal" end
		if _UIItemDiscardManager.pending then return "/ui/ItemDiscardGroup/Modal" end
		-- 실제 화면 픽셀 좌표(UITouchDownEvent/ScreenTouchEvent 공통)를
		-- 덮고 있는 "표시 중" 창들 중 형제 순서가 가장 높은(가장 앞에 그려지는) 창 경로를 반환한다.
		-- 어떤 창도 덮지 않으면 빈 문자열.
		local bestPath = ""
		local bestIdx = -1
		for _, p in ipairs(self:GetWindowPaths()) do
			local w = _EntityService:GetEntityByPath(p)
            local picker=p=="/ui/DefaultGroup/EnhanceWindow" and _MobileUIManager:UI("EquipmentPicker") or nil
            local pickerHit=isvalid(picker) and picker.EnabledInHierarchy and self:ContainsScreenPoint(picker,touchPoint)
			if isvalid(w) and w.EnabledInHierarchy and w.Visible and (self:ContainsScreenPoint(w, touchPoint) or pickerHit) then
				local idx = _UILogic:GetSiblingIndex(w.UITransformComponent)
				-- (요청 2026-08-14) DefaultGroup 밖의 창은 전용 그룹(양수 GroupOrder)이라 **항상 위**에
				-- 그려진다. 형제 인덱스는 자기 그룹 안에서만 의미가 있어(보통 0) 그대로 비교하면
				-- 뒤쪽으로 잡히므로, 화면에 보이는 그대로 최상단이 되게 큰 값을 얹는다.
				if string.sub(p, 1, 17) ~= "/ui/DefaultGroup/" then
					idx = idx + 100000
				end
				if idx > bestIdx then
					bestIdx = idx
					bestPath = p
				end
			end
		end
        if bestPath=="" then
            for _,path in ipairs({"/ui/MapleTutorial/FirstGoal","/ui/MapleTutorial/Guide","/ui/SkillPointNotice/Notice"}) do
                local notice=_EntityService:GetEntityByPath(path)
                if self:ContainsScreenPoint(notice,touchPoint) then return path end
            end
        end
		return bestPath
	end

	@ExecSpace("ClientOnly")
	method string GetKeyboardWindow()
        if _SkillManager:BlocksAmountInput() then return "/ui/SkillPointDialog/Modal" end
        if _SpecialEquipment._T.replacement~=nil then return "/ui/AccessoryChoice/Modal" end
        if _MobileNumberPad:BlocksInput() then return "/ui/MobileNumberPad/Modal" end
		if _CosmeticExchange:BlocksInput() then return "/ui/CosmeticExchangeGroup/Modal" end
        if _AppearanceColorPicker:BlocksInput() then return "/ui/AppearanceColorGroup/Modal" end
        if _BossStageManager:BlocksInput() then return _BossStageManager._T.result and "/ui/BossStage/Result" or _BossStageManager._T.destination and "/ui/BossStage/Cover" or "/ui/BossStage/Modal" end
        if _RewardCenter:BlocksInput() then return "/ui/RewardCenter/Modal" end
        if _EventRewards:BlocksInput() then return "/ui/EventGroup/Modal" end
		-- 좌표가 없는 Tab/Space 입력도 실제로 맨 앞에 표시되는 창 하나만 처리한다.
		if _UIItemDiscardManager:BlocksInput() then return "/ui/ItemDiscardGroup/Modal" end
		local bestPath = ""
		local bestIdx = -1
		for _, path in ipairs(self:GetWindowPaths()) do
			local win = _EntityService:GetEntityByPath(path)
			if path ~= "/ui/DefaultGroup/Board" and isvalid(win) and win.EnabledInHierarchy and win.Visible then
				local idx = _UILogic:GetSiblingIndex(win.UITransformComponent)
				if string.sub(path, 1, 17) ~= "/ui/DefaultGroup/" then idx = idx + 100000 end
				if idx > bestIdx then bestIdx = idx; bestPath = path end
			end
		end
		return bestPath
	end

	@ExecSpace("ClientOnly")
	method boolean IsTopmostAt(string winPath, Vector2 touchPoint)
        if _SkillManager:BlocksAmountInput() then return winPath=="/ui/SkillPointDialog/Modal" end
		-- 클릭 지점의 최상단 창이 winPath일 때만 true. 어떤 창도 그 지점을 덮지 않으면
		-- true(차단할 겹침이 없음) - 그래서 목록에 없는 대상(SkillBar 등 HUD)도 자기 경로를
		-- 넘기면 "창에 가려졌는가"만 검사된다.
		local bestPath = self:GetTopmostWindowAt(touchPoint)
		if bestPath == "" then return true end
		if bestPath ~= winPath then
			log("[UIClickArbiter] 클릭 차단: " .. tostring(winPath) .. " (최상단=" .. bestPath .. ")")
			return false
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 창의 "빈 배경"(슬롯/버튼 핸들러가 없는 영역)을 클릭해도 그 창이 맨 앞으로 오도록,
		-- 전역 화면 터치에서 클릭 지점의 최상단 창을 올려준다. 요소 클릭은 AcceptClickAt이
		-- 이미 올려주지만 같은 창을 다시 올리는 것은 무해하다.
		self.screenTouchHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnGlobalScreenTouch)
        self:WatchWindowChanges()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
        for _,link in ipairs(self._T.windowLinks or {}) do
            if isvalid(link.entity) then link.entity:DisconnectEvent(EntityEnabledInHierarchyChangedEvent,link.callbackId) end
        end
        self._T.windowLinks={}
		if self.screenTouchHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchEvent, self.screenTouchHandler)
			self.screenTouchHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnGlobalScreenTouch(ScreenTouchEvent e)
		-- PC 좌클릭(ScreenTouchEvent TouchId==1)이 어떤 창 위(빈 배경 포함)에서 일어나면
		-- 그 지점의 최상단 창을 맨 앞으로 올린다.
		if e.TouchId ~= 1 then return end
		if not _UICursorManager:AcceptPointerDown(e.TouchPoint) then return end
		local top = self:GetTopmostWindowAt(e.TouchPoint)
		if top ~= "" then
			_UIEquipInventoryManager:BringWindowToFront(top)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean AcceptClickAt(string winPath, Vector2 touchPoint)
		-- 클릭 전용 게이트: 최상단 판정에 더해, 허용된 클릭이 판정 대상 창에 속하면 그 창을
		-- 맨 앞으로 올린다("겹치지 않은 뒤쪽 창을 클릭하면 그 창이 제일 앞으로" 요청).
		-- 호버(툴팁 표시)는 창 순서를 바꾸면 안 되므로 IsTopmostAt을 그대로 쓸 것.
		if not _UICursorManager:AcceptPointerDown(touchPoint) then return false end
		if not self:IsTopmostAt(winPath, touchPoint) then return false end
		for _, p in ipairs(self:GetWindowPaths()) do
			if p == winPath then
				_UIEquipInventoryManager:BringWindowToFront(winPath)
				break
			end
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void DebugDumpWindows()
		-- 검증용: 각 창의 표시 상태/위치/크기/형제 순서를 로그로 출력한다.
		for _, p in ipairs(self:GetWindowPaths()) do
			local w = _EntityService:GetEntityByPath(p)
			if isvalid(w) then
				local tr = w.UITransformComponent
				log("[UIClickArbiter] " .. p .. " enable=" .. tostring(w.Enable)
					.. " pos=(" .. tostring(tr.anchoredPosition.x) .. "," .. tostring(tr.anchoredPosition.y)
					.. ") size=(" .. tostring(tr.RectSize.x) .. "," .. tostring(tr.RectSize.y)
					.. ") pivot=(" .. tostring(tr.Pivot.x) .. "," .. tostring(tr.Pivot.y)
					.. ") sibling=" .. tostring(_UILogic:GetSiblingIndex(tr)))
			else
				log("[UIClickArbiter] " .. p .. " (없음)")
			end
		end
	end

    @ExecSpace("ClientOnly")
    method void ClearTransientOverlays()
        if self._T.clearingOverlays then return end
        self._T.clearingOverlays=true
        _UIEquipInventoryManager:HideTooltip()
        _SkillManager:HideSkillTooltip()
        _UIEquipInventoryManager:CancelInvenDrag()
        _UIEquipInventoryManager:CancelEquipDrag()
        _UIEquipInventoryManager:ConsumeEnhancePick()
        for _,path in ipairs({"/ui/DefaultGroup/DragGhost","/ui/DefaultGroup/SkillDragGhost"}) do
            local entity=_EntityService:GetEntityByPath(path)
            if isvalid(entity) then entity.Enable=false end
        end
        self._T.clearingOverlays=false
    end

    @ExecSpace("ClientOnly")
    method void WatchWindowChanges()
        self._T.windowLinks={}
        local ui=_EntityService:GetEntityByPath("/ui")
        if not isvalid(ui) then return end
        for _,transform in ipairs(ui:GetChildComponentsByTypeName("MOD.Core.UITransformComponent",true)) do
            local entity=transform.Entity
            local name=string.lower(entity.Name)
            if string.find(name,"window",1,true) or string.find(name,"popup",1,true) or name=="modal" or name=="worldmapgroup" or name=="book" then
                local callbackId=entity:ConnectEvent(EntityEnabledInHierarchyChangedEvent,function() self:ClearTransientOverlays() end)
                table.insert(self._T.windowLinks,{entity=entity,callbackId=callbackId})
            end
        end
    end

end
