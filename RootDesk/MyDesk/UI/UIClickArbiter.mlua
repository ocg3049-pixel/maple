@Logic
script UIClickArbiter extends Logic

	-- 겹친 창 클릭 관통 방지 공용 판정.
	-- 여러 창이 같은 화면 지점을 덮고 있을 때 UITouchDownEvent/ScreenTouchEvent는 겹친 모든
	-- 핸들러에 전달되므로("클릭이 뒤 창까지 발동" 버그), 각 창의 클릭 핸들러가 실행 전에
	-- IsTopmostAt(자기 창 경로, 터치 좌표)로 "내 창이 이 지점의 최상단인가"를 물어보게 한다.

	property any screenTouchHandler = nil

	@ExecSpace("ClientOnly")
	method table GetWindowPaths()
		-- 겹침 판정 대상 창/팝업 목록 - UIEquipInventoryManager.BringWindowToFront의 형제 순서
		-- 체계와 같은 세트. TooltipPanel은 클릭을 받지 않는 표시 전용이라 제외한다
		-- (툴팁 아래를 클릭하면 그 밑의 창으로 통과되어야 한다).
		return {
			"/ui/DefaultGroup/InvenWindow",
			"/ui/DefaultGroup/EquipWindow",
			"/ui/DefaultGroup/DecoWindow",
			"/ui/DefaultGroup/EnhanceWindow",
			"/ui/DefaultGroup/SkillWindow",
			"/ui/DefaultGroup/CharInfoWindow",
			"/ui/DefaultGroup/ItemTypeSelectPopup",
			"/ui/DefaultGroup/BoxQuantityPopup",
			"/ui/DefaultGroup/KeySettingWindow",
			"/ui/DefaultGroup/BattleStatsWindow",
			-- (요청 2026-08-14) 전투분석 상세 창은 **전용 .ui 그룹**(GroupOrder 8)이라 DefaultGroup
			-- 형제 순서 체계 밖에 있다. 목록에는 넣되 순위는 GetTopmostWindowAt이 따로 올려 준다 -
			-- 안 넣으면 상세 창을 클릭해도 그 아래 DefaultGroup 창이 "최상단"으로 잡혀 클릭이 관통한다.
			"/ui/BattleStatsDetailWindow/Window",
		}
	end

	@ExecSpace("ClientOnly")
	method boolean ContainsUIPoint(Entity win, number ux, number uy)
		-- 창 루트가 "중앙 앵커 + anchoredPosition + 명시적 RectSize"라는 프로젝트 창 공통 규격을
		-- 전제로 한 사각형 검사 (KeySettingManager.HitRect / SkillManager.OnSkillWindowTouch와
		-- 같은 좌표 규약: UI 좌표 = 화면 중앙 원점, y 위쪽).
		local tr = win.UITransformComponent
		if not isvalid(tr) then return false end
		local pos = tr.anchoredPosition
		local sz = tr.RectSize
		local pv = tr.Pivot
		local left = pos.x - pv.x * sz.x
		local right = pos.x + (1 - pv.x) * sz.x
		local bottom = pos.y - pv.y * sz.y
		local top = pos.y + (1 - pv.y) * sz.y
		return ux >= left and ux <= right and uy >= bottom and uy <= top
	end

	@ExecSpace("ClientOnly")
	method string GetTopmostWindowAt(Vector2 touchPoint)
		-- touchPoint(1920×1080 좌하단 원점 스크린 좌표 - UITouchDownEvent/ScreenTouchEvent 공통)를
		-- 덮고 있는 "표시 중" 창들 중 형제 순서가 가장 높은(가장 앞에 그려지는) 창 경로를 반환한다.
		-- 어떤 창도 덮지 않으면 빈 문자열.
		local ux = touchPoint.x - 960
		local uy = touchPoint.y - 540
		local bestPath = ""
		local bestIdx = -1
		for _, p in ipairs(self:GetWindowPaths()) do
			local w = _EntityService:GetEntityByPath(p)
			if isvalid(w) and w.Enable and self:ContainsUIPoint(w, ux, uy) then
				local idx = _UILogic:GetSiblingIndex(w.UITransformComponent)
				-- (요청 2026-08-14) DefaultGroup 밖의 창은 전용 그룹(양수 GroupOrder)이라 **항상 위**에
				-- 그려진다. 형제 인덱스는 자기 그룹 안에서만 의미가 있어(보통 0) 그대로 비교하면
				-- 뒤쪽으로 잡히므로, 화면에 보이는 그대로 최상단이 되게 큰 값을 얹는다.
				if string.sub(p, 1, 17) ~= "/ui/DefaultGroup/" then
					idx = idx + 100000
				end
				if idx > bestIdx then
					bestIdx = idx
					bestPath = p
				end
			end
		end
		return bestPath
	end

	@ExecSpace("ClientOnly")
	method boolean IsTopmostAt(string winPath, Vector2 touchPoint)
		-- 클릭 지점의 최상단 창이 winPath일 때만 true. 어떤 창도 그 지점을 덮지 않으면
		-- true(차단할 겹침이 없음) - 그래서 목록에 없는 대상(SkillBar 등 HUD)도 자기 경로를
		-- 넘기면 "창에 가려졌는가"만 검사된다.
		local bestPath = self:GetTopmostWindowAt(touchPoint)
		if bestPath == "" then return true end
		if bestPath ~= winPath then
			log("[UIClickArbiter] 클릭 차단: " .. tostring(winPath) .. " (최상단=" .. bestPath .. ")")
			return false
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 창의 "빈 배경"(슬롯/버튼 핸들러가 없는 영역)을 클릭해도 그 창이 맨 앞으로 오도록,
		-- 전역 화면 터치에서 클릭 지점의 최상단 창을 올려준다. 요소 클릭은 AcceptClickAt이
		-- 이미 올려주지만 같은 창을 다시 올리는 것은 무해하다.
		self.screenTouchHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnGlobalScreenTouch)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.screenTouchHandler ~= nil then
			_InputService:DisconnectEvent(ScreenTouchEvent, self.screenTouchHandler)
			self.screenTouchHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnGlobalScreenTouch(ScreenTouchEvent e)
		-- PC 좌클릭(ScreenTouchEvent TouchId==1)이 어떤 창 위(빈 배경 포함)에서 일어나면
		-- 그 지점의 최상단 창을 맨 앞으로 올린다.
		if e.TouchId ~= 1 then return end
		local top = self:GetTopmostWindowAt(e.TouchPoint)
		if top ~= "" then
			_UIEquipInventoryManager:BringWindowToFront(top)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean AcceptClickAt(string winPath, Vector2 touchPoint)
		-- 클릭 전용 게이트: 최상단 판정에 더해, 허용된 클릭이 판정 대상 창에 속하면 그 창을
		-- 맨 앞으로 올린다("겹치지 않은 뒤쪽 창을 클릭하면 그 창이 제일 앞으로" 요청).
		-- 호버(툴팁 표시)는 창 순서를 바꾸면 안 되므로 IsTopmostAt을 그대로 쓸 것.
		if not self:IsTopmostAt(winPath, touchPoint) then return false end
		for _, p in ipairs(self:GetWindowPaths()) do
			if p == winPath then
				_UIEquipInventoryManager:BringWindowToFront(winPath)
				break
			end
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method void DebugDumpWindows()
		-- 검증용: 각 창의 표시 상태/위치/크기/형제 순서를 로그로 출력한다.
		for _, p in ipairs(self:GetWindowPaths()) do
			local w = _EntityService:GetEntityByPath(p)
			if isvalid(w) then
				local tr = w.UITransformComponent
				log("[UIClickArbiter] " .. p .. " enable=" .. tostring(w.Enable)
					.. " pos=(" .. tostring(tr.anchoredPosition.x) .. "," .. tostring(tr.anchoredPosition.y)
					.. ") size=(" .. tostring(tr.RectSize.x) .. "," .. tostring(tr.RectSize.y)
					.. ") pivot=(" .. tostring(tr.Pivot.x) .. "," .. tostring(tr.Pivot.y)
					.. ") sibling=" .. tostring(_UILogic:GetSiblingIndex(tr)))
			else
				log("[UIClickArbiter] " .. p .. " (없음)")
			end
		end
	end

end
