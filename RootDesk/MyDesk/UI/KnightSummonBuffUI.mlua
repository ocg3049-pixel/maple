@Logic
@ExecSpace("ClientOnly")
script KnightSummonBuffUI extends Logic

	-- 기사 소환의 60초 지속시간을 우측 상단 버프바에 분노와 같은 방식으로 표시한다.
	property Entity buffIconGroup = "36259cd2-7bb1-4c5a-a063-eb2d169f5752"
	property SpriteGUIRendererComponent grayOverlay = "358ef001-6c58-480b-9c4f-23fcf8cfa620"
	property TextComponent countdownText = "4c50c602-e904-46de-a51e-fee60563b428"

	@ExecSpace("ClientOnly")
	method void ShowBuff(number duration)
		-- 버프 아이콘을 켜고 기사 편대의 남은 지속시간을 새로 시작한다.
		if not self:IsClient() or duration <= 0 then return end
		self._T.totalDuration = duration
		self._T.remaining = duration
		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local cg = self.buffIconGroup.CanvasGroupComponent
			if isvalid(cg) then cg.GroupAlpha = 1 end
		end
		if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) end
		local preTime = _UtilLogic.ElapsedSeconds
		self._T.timerId = _UIFrameTicker:Subscribe(function()
			local now = _UtilLogic.ElapsedSeconds
			self._T.remaining = self._T.remaining - (now - preTime)
			preTime = now
			self:UpdateBuffDisplay()
		end, 1 / 60)
		self:UpdateBuffDisplay()
		if Environment:IsMakerPlay() then log("[KnightSummonBuffUI] 지속시간 표시 시작 duration=" .. tostring(duration)) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateBuffDisplay()
		-- 분노와 같은 오버레이·숫자·마지막 5초 페이드 규칙을 적용한다.
		local remaining = self._T.remaining or 0
		local total = self._T.totalDuration or 60
		if remaining <= 0 then
			if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) self._T.timerId = nil end
			if isvalid(self.buffIconGroup) then self.buffIconGroup.Enable = false end
			return
		end
		if isvalid(self.grayOverlay) then self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total)) end
		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end
		if remaining < 5 and isvalid(self.buffIconGroup) then
			local cg = self.buffIconGroup.CanvasGroupComponent
			if isvalid(cg) then cg.GroupAlpha = remaining / 5 end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideBuff()
		-- 기사 편대가 시간 만료 또는 우클릭으로 해제되면 표시를 즉시 내린다.
		self._T.remaining = 0
		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method number GetRemaining()
		-- BuffBarManager가 활성 아이콘을 정렬할 때 사용할 남은 시간을 반환한다.
		return self._T.remaining or 0
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 플레이 종료 시 반복 타이머를 정리한다.
		if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) end
	end

end
