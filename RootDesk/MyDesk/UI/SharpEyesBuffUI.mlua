@Logic
@ExecSpace("ClientOnly")
script SharpEyesBuffUI extends Logic

	-- 샤프 아이즈(신궁 4차) 버프바 아이콘. BattoBuffUI/HasteBuffUI를 그대로 복제한 구조다
	-- (중첩 표시가 없어 stackText만 빠졌다).
	property Entity buffIconGroup = "b580a2ba-133e-403f-b059-0559a3d05062"
	property SpriteGUIRendererComponent grayOverlay = "97c50e2a-dee3-4052-90bc-6f81d8e107b0"
	property TextComponent countdownText = "668bf38b-8e20-4d77-8cab-2c0f718459b0"

	method void ShowBuff(number duration)
		-- 샤프 아이즈 버프 타이머 표시/갱신. 이미 표시 중이어도 새 타이머로 교체되므로 지속시간만
		-- 갱신되고 아이콘이 중첩되지는 않는다(항상 하나의 아이콘/카운트다운만 존재).
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.sharpEyesTotalDuration = duration
		self._T.sharpEyesRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.sharpEyesTimerId then
			_TimerService:ClearTimer(self._T.sharpEyesTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.sharpEyesTimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.sharpEyesRemaining = self._T.sharpEyesRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
	end

	method void UpdateBuffDisplay()
		-- 매 프레임 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃을 갱신한다.
		local remaining = self._T.sharpEyesRemaining
		local total = self._T.sharpEyesTotalDuration

		if remaining <= 0 then
			if self._T.sharpEyesTimerId then
				_TimerService:ClearTimer(self._T.sharpEyesTimerId)
				self._T.sharpEyesTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(1, 1, 1, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				-- 분 단위 표시일 때는 "분" 글자 없이 숫자만, 노란색으로 표시한다.
				self.countdownText.FontColor = Color(1, 1, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	method void OnEndPlay()
		-- 타이머 정리 (연결 해제 필수 규칙).
		if self._T.sharpEyesTimerId then
			_TimerService:ClearTimer(self._T.sharpEyesTimerId)
		end
	end

	method number GetRemaining()
		-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
		return self._T.sharpEyesRemaining or 0
	end

	method void HideBuff()
		-- (버프 아이콘 우클릭 취소) 표시를 즉시 정리한다 - 남은 시간 0으로 만들어 종료 경로를 태운다.
		self._T.sharpEyesRemaining = 0
		self:UpdateBuffDisplay()
	end

end
