@Logic
@ExecSpace("ClientOnly")
script FreezerBuffUI extends Logic

	property Entity buffIconGroup = "436d602b-4f52-4fbc-b3ec-2e167ff5d2f8"
	property SpriteGUIRendererComponent grayOverlay = "5b41269d-7e63-41eb-86d3-2ede7e7bd729"
	property TextGUIRendererComponent countdownText = "439a95df-21d3-4518-8f48-4309db05591d"

	@ExecSpace("ClientOnly")
	method void ShowBuff(number duration)
		if not self:IsClient() or duration <= 0 then return end
		self._T.totalDuration = duration
		self._T.remaining = duration
		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvas = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvas) then canvas.GroupAlpha = 1 end
		end
		if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) end
		local previous = _UtilLogic.ElapsedSeconds
		self._T.timerId = _UIFrameTicker:Subscribe(function()
			local now = _UtilLogic.ElapsedSeconds
			self._T.remaining = self._T.remaining - (now - previous)
			previous = now
			self:UpdateBuffDisplay()
		end, 1 / 60)
		self:UpdateBuffDisplay()
		if Environment:IsMakerPlay() then log("[FreezerBuffUI] 지속시간 표시 시작 " .. tostring(duration) .. "초") end
	end

	@ExecSpace("ClientOnly")
	method void UpdateBuffDisplay()
		local remaining = self._T.remaining or 0
		local total = self._T.totalDuration or 1
		if remaining <= 0 then
			if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId); self._T.timerId = nil end
			if isvalid(self.buffIconGroup) then self.buffIconGroup.Enable = false end
			return
		end
		if isvalid(self.grayOverlay) then self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total)) end
		if isvalid(self.countdownText) then
			if remaining < 5 then self.countdownText.Text = ""
			elseif remaining < 60 then self.countdownText.FontColor = Color(0, 0, 0, 1); self.countdownText.Text = tostring(math.ceil(remaining))
			else self.countdownText.FontColor = Color(0, 0, 0, 1); self.countdownText.Text = tostring(math.floor(remaining / 60)) end
		end
		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvas = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvas) then canvas.GroupAlpha = remaining / 5 end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideBuff()
		if not self:IsClient() then return end
		self._T.remaining = 0
		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) end
	end

	@ExecSpace("ClientOnly")
	method number GetRemaining()
		return self._T.remaining or 0
	end
end
