@Logic
@ExecSpace("ClientOnly")
script HealerSummonBuffUI extends Logic

	-- 힐러 소환(3차) 버프바 아이콘. HeroSummonBuffUI 복제 - UUID는 UIBuilder가 write bind로 주입한다.
	property Entity buffIconGroup = "23606daf-f3d7-4de3-96ad-036d00d71062"
	property SpriteGUIRendererComponent grayOverlay = "b53ece65-a43e-48b0-bfb2-701d7d467e6a"
	property TextComponent countdownText = "10842959-b1e6-4803-8bde-6d1a1a6eaa03"

	method void ShowBuff(number duration)
		-- 힐러 소환 지속시간 표시/갱신. 재소환하면 새 타이머로 교체된다.
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.healerTotalDuration = duration
		self._T.healerRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.healerTimerId then
			_TimerService:ClearTimer(self._T.healerTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.healerTimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.healerRemaining = self._T.healerRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
	end

	method void UpdateBuffDisplay()
		-- 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃 갱신.
		local remaining = self._T.healerRemaining
		local total = self._T.healerTotalDuration

		if remaining <= 0 then
			if self._T.healerTimerId then
				_TimerService:ClearTimer(self._T.healerTimerId)
				self._T.healerTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(1, 1, 1, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(1, 1, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	method void HideBuff()
		-- 힐러가 도중에 죽어(HP 0) 소환 해제되거나 우클릭으로 취소될 때 버프바를 즉시 내린다.
		if not self:IsClient() then return end
		if self._T.healerRemaining == nil then return end
		self._T.healerRemaining = 0
		self:UpdateBuffDisplay()
	end

	method void OnEndPlay()
		if self._T.healerTimerId then
			_TimerService:ClearTimer(self._T.healerTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	method number GetRemaining()
		return self._T.healerRemaining or 0
	end

end
