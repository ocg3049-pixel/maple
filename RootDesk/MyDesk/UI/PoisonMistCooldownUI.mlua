@Logic
@ExecSpace("ClientOnly")
script PoisonMistCooldownUI extends Logic

	property SpriteGUIRendererComponent grayOverlay = "d7c4ec4a-6f8d-442d-8f05-d05cedb197ff"
	property TextGUIRendererComponent countdownText = "cf6652bf-7337-4fe7-bcd1-410e75666246"

	@ExecSpace("ClientOnly")
	method void ShowCooldown(number duration, string slotKey)
		if not self:IsClient() or duration <= 0 then return end
		if not isvalid(self.grayOverlay) or not isvalid(self.countdownText) then
			log_warning("[PoisonMistCooldownUI] 쿨타임 UI 컴포넌트 참조가 유효하지 않습니다.")
			return
		end
		self._T.totalDuration = duration
		self._T.remaining = duration
		self._T.slotKey = slotKey
		self.grayOverlay.Type = ImageType.Filled
		self.grayOverlay.FillMethod = FillMethodType.Vertical
		local slotEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar/Slot_" .. tostring(slotKey))
		if isvalid(slotEnt) then
			local pos = slotEnt.UITransformComponent.anchoredPosition
			self.grayOverlay.Entity.UITransformComponent.anchoredPosition = Vector2(pos.x, pos.y + 4)
			self.countdownText.Entity.UITransformComponent.anchoredPosition = Vector2(pos.x, pos.y + 4)
		end
		self.grayOverlay.Entity.Enable = true
		self.countdownText.Entity.Enable = true
		if self._T.timerId then _TimerService:ClearTimer(self._T.timerId) end
		local preTime = _UtilLogic.ElapsedSeconds
		self._T.timerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			self._T.remaining -= now - preTime
			preTime = now
			self:UpdateCooldownDisplay()
		end, 1 / 60)
		self:UpdateCooldownDisplay()
		log("[PoisonMistCooldownUI] 쿨타임 표시 시작 duration=" .. tostring(duration) .. " slot=" .. tostring(slotKey))
	end

	@ExecSpace("ClientOnly")
	method void UpdateCooldownDisplay()
		local remaining = self._T.remaining or 0
		if remaining <= 0 then
			if self._T.timerId then
				_TimerService:ClearTimer(self._T.timerId)
				self._T.timerId = nil
			end
			if isvalid(self.grayOverlay) then self.grayOverlay.Entity.Enable = false end
			if isvalid(self.countdownText) then self.countdownText.Entity.Enable = false end
			_SkillManager:BlinkSlotReady(self._T.slotKey or "")
			return
		end
		self.grayOverlay.FillAmount = math.max(0, math.min(1, remaining / self._T.totalDuration))
		self.countdownText.Text = tostring(math.ceil(remaining))
	end

	@ExecSpace("ClientOnly")
	method void ResetCooldown()
		if self._T.timerId then
			self._T.remaining = 0
			self:UpdateCooldownDisplay()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.timerId then _TimerService:ClearTimer(self._T.timerId) end
	end
end
