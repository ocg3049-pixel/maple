@Logic
@ExecSpace("ClientOnly")
script MagicBoosterBuffUI extends Logic

	property Entity buffIconGroup = "cdc97fa4-ce7b-40e0-818e-2bd58ac6c02b"
	property SpriteGUIRendererComponent grayOverlay = "c84a65a3-a74e-48f4-b654-98ed82c8b28c"
	property TextComponent countdownText = "b7c6b3fa-b8f6-433e-bc64-39cfb353ca53"

	@ExecSpace("ClientOnly")
	method void ShowBuff(number duration)
		if not self:IsClient() or duration <= 0 then return end
		self._T.totalDuration = duration
		self._T.remaining = duration
		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvas = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvas) then canvas.GroupAlpha = 1 end
		end
		if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) end
		local previous = _UtilLogic.ElapsedSeconds
		self._T.timerId = _UIFrameTicker:Subscribe(function()
			local now = _UtilLogic.ElapsedSeconds
			self._T.remaining -= now - previous
			previous = now
			self:UpdateBuffDisplay()
		end, 1 / 60)
		self:UpdateBuffDisplay()
		if Environment:IsMakerPlay() then log("[MagicBoosterBuffUI] 표시 시작 duration=" .. tostring(duration)) end
	end

	@ExecSpace("ClientOnly")
	method void UpdateBuffDisplay()
		local remaining = self._T.remaining or 0
		local total = self._T.totalDuration or 1
		if remaining <= 0 then
			if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) self._T.timerId = nil end
			if isvalid(self.buffIconGroup) then self.buffIconGroup.Enable = false end
			return
		end
		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end
		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end
		if isvalid(self.buffIconGroup) then
			local canvas = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvas) then canvas.GroupAlpha = remaining < 5 and remaining / 5 or 1 end
		end
	end

	@ExecSpace("ClientOnly")
	method number GetRemaining()
		return self._T.remaining or 0
	end

	@ExecSpace("ClientOnly")
	method void HideBuff()
		self._T.remaining = 0
		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.timerId then _UIFrameTicker:Unsubscribe(self._T.timerId) end
	end

end
