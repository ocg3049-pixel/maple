@Logic
@ExecSpace("ClientOnly")
script AwakeningBuffUI extends Logic

	-- 각성(나이트로드 4차) 버프 지속시간 표시. BattoBuffUI 복제(중첩 표시만 없음) - 버프바 아이콘 위에
	-- 회색 오버레이가 차오르고 남은 시간이 숫자로 뜬다. UUID는 UIBuilder가 write bind로 주입한다.

	property Entity buffIconGroup = "40f0a079-21b3-4477-962c-18fc4559508c"
	property SpriteGUIRendererComponent grayOverlay = "78b0c086-c150-4a01-a7cd-c13e053e99ff"
	property TextComponent countdownText = "1db91a68-ab1c-46fe-a5a2-e42da6835264"

	method void ShowBuff(number duration)
		-- 각성 버프 타이머 표시/갱신. 이미 표시 중이어도 새 타이머로 교체되므로 지속시간만 갱신되고
		-- 아이콘이 중첩되지는 않는다(항상 하나의 아이콘/카운트다운만 존재).
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.awTotalDuration = duration
		self._T.awRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.awTimerId then
			_TimerService:ClearTimer(self._T.awTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.awTimerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.awRemaining = self._T.awRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
	end

	method void UpdateBuffDisplay()
		-- 매 프레임 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃을 갱신한다.
		local remaining = self._T.awRemaining
		local total = self._T.awTotalDuration

		if remaining <= 0 then
			if self._T.awTimerId then
				_TimerService:ClearTimer(self._T.awTimerId)
				self._T.awTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			-- 각성은 최대 39초짜리 짧은 버프라 언제나 초 단위로 보여준다(분 단위 표기 없음).
			-- 마지막 5초는 아이콘이 페이드아웃하므로 숫자를 지운다(다른 버프 UI와 같은 규칙).
			if remaining < 5 then
				self.countdownText.Text = ""
			else
				self.countdownText.FontColor = Color(1, 1, 1, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	method void OnEndPlay()
		-- 타이머 정리 (연결 해제 필수 규칙).
		if self._T.awTimerId then
			_TimerService:ClearTimer(self._T.awTimerId)
		end
	end

	method number GetRemaining()
		-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
		return self._T.awRemaining or 0
	end

	method void HideBuff()
		-- (버프 아이콘 우클릭 취소 / 스킬 해제) 표시를 즉시 정리한다 - 남은 시간 0으로 만들어 종료 경로를 태운다.
		self._T.awRemaining = 0
		self:UpdateBuffDisplay()
	end

end
