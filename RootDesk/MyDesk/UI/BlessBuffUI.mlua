@Logic
@ExecSpace("ClientOnly")
script BlessBuffUI extends Logic

	-- 블레스(2차 버프) 버프바 아이콘. RageBuffUI 복제 - UUID는 UIBuilder가 write bind로 주입한다.
	property Entity buffIconGroup = "4fef33fb-c13f-4d12-8289-ca7a5eaefa4e"
	property SpriteGUIRendererComponent grayOverlay = "0079b4ce-d484-4872-8a6d-12515d4432a6"
	property TextComponent countdownText = "1b091ede-269d-4eac-ba39-0956e47afaf8"

	@ExecSpace("ClientOnly")
	method void ShowBuff(number duration)
		-- 블레스 버프 타이머 표시/갱신(분노와 동일한 매커니즘). 이미 표시 중이어도 새 타이머로
		-- 교체되므로 지속시간만 갱신되고 아이콘이 중첩되지는 않는다.
		if not self:IsClient() then return end
		if duration <= 0 then return end
		self._T.blessTotalDuration = duration
		self._T.blessRemaining = duration

		if isvalid(self.buffIconGroup) then
			self.buffIconGroup.Enable = true
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then canvasGroup.GroupAlpha = 1 end
		end

		if self._T.blessTimerId then
			_UIFrameTicker:Unsubscribe(self._T.blessTimerId)
		end

		local preTime = _UtilLogic.ElapsedSeconds
		self._T.blessTimerId = _UIFrameTicker:Subscribe(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - preTime
			preTime = now
			self._T.blessRemaining = self._T.blessRemaining - delta
			self:UpdateBuffDisplay()
		end, 1 / 60)

		self:UpdateBuffDisplay()
	end

	@ExecSpace("ClientOnly")
	method void UpdateBuffDisplay()
		-- 매 프레임 남은 시간에 따라 회색 오버레이(FillAmount)/카운트다운 텍스트/마지막 5초 페이드아웃을 갱신한다.
		local remaining = self._T.blessRemaining
		local total = self._T.blessTotalDuration

		if remaining <= 0 then
			if self._T.blessTimerId then
				_UIFrameTicker:Unsubscribe(self._T.blessTimerId)
				self._T.blessTimerId = nil
			end
			if isvalid(self.buffIconGroup) then
				self.buffIconGroup.Enable = false
			end
			return
		end

		if isvalid(self.grayOverlay) then
			self.grayOverlay.FillAmount = math.max(0, math.min(1, (total - remaining) / total))
		end

		if isvalid(self.countdownText) then
			if remaining < 5 then
				self.countdownText.Text = ""
			elseif remaining < 60 then
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.ceil(remaining))
			else
				self.countdownText.FontColor = Color(0, 0, 0, 1)
				self.countdownText.Text = tostring(math.floor(remaining / 60))
			end
		end

		if remaining < 5 and isvalid(self.buffIconGroup) then
			local canvasGroup = self.buffIconGroup.CanvasGroupComponent
			if isvalid(canvasGroup) then
				canvasGroup.GroupAlpha = remaining / 5
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self._T.blessTimerId then
			_UIFrameTicker:Unsubscribe(self._T.blessTimerId)
		end
	end

	-- 버프 아이콘 정렬(BuffBarManager)이 남은 시간을 조회하기 위한 getter. 비활성 상태면 0.
	@ExecSpace("ClientOnly")
	method number GetRemaining()
		return self._T.blessRemaining or 0
	end

	@ExecSpace("ClientOnly")
	method void HideBuff()
		-- (버프 아이콘 우클릭 취소) 표시를 즉시 정리한다 - 남은 시간 0으로 만들어 종료 경로를 태운다.
		self._T.blessRemaining = 0
		self:UpdateBuffDisplay()
	end

end
