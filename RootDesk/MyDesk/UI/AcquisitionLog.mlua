@Logic
script AcquisitionLog extends Logic
    property EntityRef logRoot = "be686784-eaeb-43d4-abb6-5761942d0213"
    property EntityRef rowTemplate = "23bc1af4-3a42-4228-a8cd-632bc65d00d9"
    property number holdSeconds = 1
    property number fadeSeconds = 2
    property number lineHeight = 34

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 획득 로그는 캐릭터별 클라이언트에서만 표시하며 각 줄의 시간을 독립적으로 관리한다.
        self._T.rows = {}
        self._T.pool = {}
        self._T.serial = 0
        if isvalid(self.logRoot) then
            self.logRoot.UIGroupComponent.GroupType=UIGroupType.DefaultType
            self.logRoot.UIGroupComponent.GroupOrder=-100
            _UILogic:SetSiblingIndex(self.logRoot.UITransformComponent,0)
        end
        if isvalid(self.rowTemplate) then self.rowTemplate.Enable = false end
        if Environment:IsMakerPlay() then log("[AcquisitionLog] ready hold=1 fade=2 backgroundAlpha=0 font=26 align=right") end
    end

    @ExecSpace("ClientOnly")
    method void Push(string message, boolean isMeso)
        -- 새 줄은 아래에 추가하고 기존 줄은 위로 한 칸씩 이동한다. 기존 줄의 수명은 초기화하지 않는다.
        if message == "" or not isvalid(self.rowTemplate) or not isvalid(self.logRoot) then return end
        if self._T.rows == nil then self._T.rows = {} self._T.pool = {} end
        local row = table.remove(self._T.pool)
        if not isvalid(row) then
            self._T.serial = (self._T.serial or 0) + 1
            row = self.rowTemplate:Clone("Acquired_" .. tostring(self._T.serial))
        end
        row.TextGUIRendererComponent.Text = message
        row.TextGUIRendererComponent.HorizontalAlignment = TextHorizontalAlignmentOption.Right
        row.TextGUIRendererComponent.FontSize = 26
        row.SpriteGUIRendererComponent.Color = Color(1,1,1,0)
        row.TextGUIRendererComponent.BestFit = false
        row.TextGUIRendererComponent.FontColor = Color(1, 1, 1, 1)
        row.CanvasGroupComponent.GroupAlpha = 1
        row.Enable = true
        self.logRoot.Enable = true
        table.insert(self._T.rows, {entity = row, age = 0})
        self:LayoutRows()
        if Environment:IsMakerPlay() then log("[AcquisitionLog] add " .. message) end
    end

    @ExecSpace("ClientOnly")
    method void LayoutRows()
        -- 높이만 퀵슬롯을 따르고, 오른쪽 끝은 화면 가장자리에 고정한다.
        if not isvalid(self.rowTemplate) or not isvalid(self.logRoot) then return end
        local rows = self._T.rows or {}
        local rootTransform = self.logRoot.UITransformComponent
        if _UILogic:GetSiblingIndex(rootTransform)>0 then _UILogic:SetSiblingIndex(rootTransform,0) end
        local height = rootTransform.RectSize.y
        local rootWidth = rootTransform.RectSize.x
        local width = math.min(680, math.max(280, rootWidth - 44))
        local bar = _EntityService:GetEntityByPath("/ui/DefaultGroup/SkillBar")
        if _MobileUIManager:IsMobile() then bar = _MobileUIManager:UI("Skills") end
                local bottom = 156
        if isvalid(bar) then
            local topY = -99999
            for _, corner in ipairs(bar.UITransformComponent:GetWorldCorners()) do
                local point = rootTransform:ToLocalPoint(Vector3(corner.x, corner.y, 0))
                topY = math.max(topY, point.y + height * rootTransform.Pivot.y)
            end
            bottom = topY + 12
        end
        local visibleCount = math.max(1, math.floor((height - 12 - bottom) / self.lineHeight))
        local lines = self.rowTemplate.Parent
        lines.UITransformComponent.AlignmentOption=AlignmentType.BottomRight
        lines.UITransformComponent.Pivot=Vector2(1,0)
        lines.UITransformComponent.anchoredPosition=Vector2(-8,0)
        lines.UITransformComponent.RectSize = Vector2(width, self.lineHeight)
        for i, row in ipairs(rows) do
            if isvalid(row.entity) then
                local offset = #rows - i
                row.entity.Enable = offset < visibleCount
                row.entity.UITransformComponent.RectSize = Vector2(width, self.lineHeight)
                row.entity.UITransformComponent.anchoredPosition = Vector2(0, bottom + offset * self.lineHeight)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 1초 동안 불투명하게 유지하고 이후 2초 동안 선형으로 페이드한다.
        local rows = self._T.rows
        if rows == nil or #rows == 0 then return end
        if _LoginFlow.phase ~= "ingame" then self:ClearRows() return end
        local removed = false
        for i = #rows, 1, -1 do
            local row = rows[i]
            row.age = row.age + delta
            if row.age >= self.holdSeconds + self.fadeSeconds or not isvalid(row.entity) then
                if isvalid(row.entity) then
                    row.entity.Enable = false
                    row.entity.CanvasGroupComponent.GroupAlpha = 0
                    table.insert(self._T.pool, row.entity)
                end
                table.remove(rows, i)
                removed = true
                if Environment:IsMakerPlay() then log("[AcquisitionLog] expire") end
            else
                row.entity.CanvasGroupComponent.GroupAlpha = math.max(0, math.min(1, 1 - (row.age - self.holdSeconds) / self.fadeSeconds))
            end
        end
        self._T.layoutAge = (self._T.layoutAge or 0) + delta
        if removed or self._T.layoutAge >= 0.1 then
            self._T.layoutAge = 0
            self:LayoutRows()
        end
    end

    @ExecSpace("ClientOnly")
    method void ClearRows()
        -- 캐릭터 선택 화면으로 나갈 때 이전 캐릭터의 로그가 남지 않도록 비운다.
        for _, row in ipairs(self._T.rows or {}) do
            if isvalid(row.entity) then row.entity.Enable = false table.insert(self._T.pool, row.entity) end
        end
        self._T.rows = {}
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 생성한 UI 복제본을 정리한다.
        self:ClearRows()
        for _, row in ipairs(self._T.pool or {}) do if isvalid(row) then row:Destroy() end end
        self._T.pool = {}
    end
end
