@Logic
script AvatarTicketManager extends Logic
    @Sync
    property SyncTable<string, string> outfits
    property boolean showOriginal = false

    method boolean IsTicket(string item)
        -- Identity comes from the registered pass icon, never the display name.
        local r = string.match(item or "", "^[^|]*|([^|]*)") or ""
        return r == "6c5302dc93154d7794435d927c5317ec" or r == "e16410b7209f44c1970cb6ebdff75604"
    end

    method string BuildItem(integer days)
        -- Tickets occupy the equipment inventory and have no enhancement stats.
        local r = days == 180 and "e16410b7209f44c1970cb6ebdff75604" or "6c5302dc93154d7794435d927c5317ec"
        return "MSW 아바타 코디 이용권 (" .. tostring(days == 180 and 180 or 30) .. "일)|" .. r .. "|28|0|0|0|ticket_until:" .. tostring(DateTime.UtcNow.Elapsed + (days == 180 and 180 or 30) * 86400000)
    end

    method number ExpiresAt(string item)
        -- Expiry is stored in the item itself and survives equipment moves and reconnects.
        return tonumber(string.match(item or "","|ticket_until:(%d+)")) or 0
    end

    method boolean IsExpired(string item)
        -- Legacy tickets have no deadline until their one-time migration is saved.
        local untilTime=self:ExpiresAt(item)
        return untilTime>0 and DateTime.UtcNow.Elapsed>=untilTime
    end

    method string ExpiryText(string item)
        -- Display Korean local time explicitly rather than the client's arbitrary time zone.
        local untilTime=self:ExpiresAt(item)
        if untilTime<=0 then return "종료일: 다음 접속 시 등록" end
        return "종료일: "..DateTime(math.floor(untilTime+9*3600000)):ToFormattedString("yyyy-MM-dd HH:mm").." (한국시간)"
    end

    @ExecSpace("ClientOnly")
    method string PurchaseBlockReason()
        -- Both durations represent the same entitlement, including an equipped ticket.
        local m=_UIEquipInventoryManager
        if self:IsTicket(m:GetEquip(28)) and not self:IsExpired(m:GetEquip(28)) then return "이미 보유중인 아이템입니다. (티켓 슬롯에 장착 중)" end
        for i=1,128 do
            local item=m:GetTabItem("equip",i)
            if self:IsTicket(item) and not self:IsExpired(item) then return "이미 보유중인 아이템입니다. (장비 인벤토리에 보유 중)" end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method void CheckExpirations()
        -- Expiry removes the item with an immediate audited save and restores the game outfit.
        local m=_UIEquipInventoryManager
        local changed=false
        local expired=false
        for i=0,128 do
            local item=i==0 and m:GetEquip(28) or m:GetTabItem("equip",i)
            if self:IsTicket(item) then
                local replacement=item
                if self:ExpiresAt(item)<=0 then
                    local days=string.find(item,"180일",1,true) and 180 or 30
                    replacement=item.."|ticket_until:"..tostring(DateTime.UtcNow.Elapsed+days*86400000)
                elseif self:IsExpired(item) then replacement="" expired=true end
                if replacement~=item then
                    if i==0 then m:SetEquipStr(28,replacement) else m:SetTabItem("equip",i,replacement) end
                    changed=true
                end
            end
        end
        if changed then
            _CharacterPersistence:MarkDirty(expired and "ticket_expired" or "ticket_expiry_migration")
            m:RefreshUI()
            _DecoWindowManager:ApplyAppearance()
            if expired then _UIToast:ShowMessage("MSW 아바타 코디 이용권의 사용 기간이 종료되었습니다.") end
        end
    end

    method void Apply(any cm, string uid, table finals, boolean worldOutfit)
        -- Clear every custom override before displaying the account's own avatar.
        if not isvalid(cm) then return end
        cm.UseCustomEquipOnly = not worldOutfit
        cm.DefaultEquipUserId = worldOutfit and uid or ""
        
        if worldOutfit then
            if self:IsClient() then
                local renderer=cm.Entity.AvatarGUIRendererComponent
                if not isvalid(renderer) then renderer=cm.Entity.AvatarRendererComponent end
                if isvalid(renderer) then
                    for _,cat in ipairs({3,4,5,6,7,8,9,10,12,13,14,15,16,17,18,19}) do renderer:SetAvatarPartColor(_DecoWindowManager:CatEnum(cat),1,1,1,1) end
                end
            end
            for _, c in ipairs({1,3,4,5,6,7,8,9,10,12,13,14,15,16,17,18,19}) do
                cm:SetEquip(_DecoWindowManager:CatEnum(c), "")
            end
        else
            _DecoWindowManager:ApplyCostumeSnapshot(cm, finals)
        end
    end

    @ExecSpace("ClientOnly")
    method boolean Equipped()
        -- Equipment remains the source of truth for the local character.
        local item=_UIEquipInventoryManager:GetEquip(28)
        return self:IsTicket(item) and not self:IsExpired(item)
    end

    @ExecSpace("ClientOnly")
    method boolean ShouldShowWorld(string uid, boolean equipped, boolean original)
        -- Viewer preferences affect other players only; never change their equipment.
        local me = _UserService.LocalPlayer
        local own = isvalid(me) and me.PlayerComponent.UserId == uid
        return equipped and not original and (own or not _GameSystemMenu.hideOtherWorldCostumes)
    end

    @ExecSpace("ClientOnly")
    method void ApplyLocal(table finals)
        -- Preserve the game's outfit even while the ticket covers it visually.
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return end
        local uid = me.PlayerComponent.UserId
        self._T.localFinals = finals
        local enabled = self:Equipped()
        self:Apply(me.CostumeManagerComponent, uid, finals, enabled)
        for _, path in ipairs({"/ui/DefaultGroup/EquipWindow/Preview/Avatar", "/ui/DefaultGroup/DecoWindow/Preview/Avatar"}) do
            local avatar = _EntityService:GetEntityByPath(path)
            if isvalid(avatar) then self:Apply(avatar.CostumeManagerComponent, uid, finals, enabled) end
        end
        if not enabled then self.showOriginal = false end
        self:UpdateOwnInfo()
    end

    @ExecSpace("ServerOnly")
    method void Publish(Entity player, table finals, boolean enabled)
        -- The original outfit is synchronized separately from the account avatar.
        local uid = player.PlayerComponent.UserId
        local raw = _HttpService:JSONEncode({finals=finals,ticket=enabled})
        self.outfits[uid] = raw
        self:Apply(player.CostumeManagerComponent, uid, finals, enabled)
        log("[AvatarTicket] synchronized enabled=" .. tostring(enabled))
    end

    @ExecSpace("ClientOnly")
    method void UpdateOwnInfo()
        -- The badge toggles only this information-window preview.
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return end
        local equipped = self:Equipped()
        local badge = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/AvatarTicket")
        if isvalid(badge) then
            badge.Enable = equipped
            badge.TextGUIRendererComponent.Text = self.showOriginal and "게임 코디" or "MSW 티켓"
        end
        local avatar = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/AvatarImage")
        if isvalid(avatar) and self._T.localFinals ~= nil then
            self:Apply(avatar.CostumeManagerComponent, me.PlayerComponent.UserId, self._T.localFinals, equipped and not self.showOriginal)
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshViewers()
        -- Invalidate cached rendering after changing the viewer's preference.
        self._T.applied = {}
        if _PlayerContextMenu:IsOpen() then _PlayerContextMenu:Draw() end
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Keep event connections scoped to this play session.
        self._T.links = {}
        self._T.applied = {}
        self._T.clock = 0
        local slot = _EntityService:GetEntityByPath("/ui/DefaultGroup/EquipWindow/SlotTicket")
        local badge = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/AvatarTicket")
        if isvalid(slot) then
            local conn = slot:ConnectEvent(ButtonClickEvent, function()
                if _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EquipWindow", _InputService:GetCursorPosition()) then
                    _UIAudio:Play("BtMouseClick")
                    _UIEquipInventoryManager:OnSlotClick("equip", 28)
                end
            end)
            table.insert(self._T.links, {entity=slot, connection=conn})
        end
        if isvalid(badge) then
            badge.Enable = false
            local conn = badge:ConnectEvent(ButtonClickEvent, function()
                if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/CharInfoWindow", _InputService:GetCursorPosition()) then return end
                self.showOriginal = not self.showOriginal
                self:UpdateOwnInfo()
                _UIAudio:Play("Tab")
            end)
            table.insert(self._T.links, {entity=badge, connection=conn})
        end
        log("[AvatarTicket] ticket slot and outfit preview ready")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- A map-entry or server costume sync invalidates the entity/signature cache.
        if not _LoginFlow:IsInGame() then self._T.applied = {} return end
        self._T.clock = (self._T.clock or 0) + delta
        if self._T.clock < 0.2 then return end
        self._T.clock = 0
        if _UtilLogic.ElapsedSeconds >= (self._T.expiryCheckAt or 0) then
            self._T.expiryCheckAt=_UtilLogic.ElapsedSeconds+1
            self:CheckExpirations()
        end
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return end
        local seen = {}
        for _, player in ipairs(_UserService.UserEntities.Values) do
            if isvalid(player) and player ~= me and player.CurrentMap == me.CurrentMap then
                local uid = player.PlayerComponent.UserId
                seen[uid] = true
                local raw = self.outfits[uid]
                if raw ~= nil and raw ~= "" then
                    local key = raw .. tostring(_GameSystemMenu.hideOtherWorldCostumes) .. player.Id .. tostring(player.CurrentMap.Id)
                    local cm = player.CostumeManagerComponent
                    local renderer = player.AvatarRendererComponent
                    if isvalid(cm) and isvalid(renderer) then
                        local now = _UtilLogic.ElapsedSeconds
                        local entry = self._T.applied[uid]
                        if entry == nil or entry.key ~= key then
                            entry = {key=key, nextAt=0, passes=0}
                            self._T.applied[uid] = entry
                        end
                        local body = renderer:GetBodyEntity()
                        local face = renderer:GetFaceEntity()
                        local data = _HttpService:JSONDecode(raw)
                        local world = self:ShouldShowWorld(uid, data.ticket == true, false)
                        local ready = isvalid(body) and isvalid(face)
                        -- Costume sync and avatar construction finish independently. Reconcile again
                        -- after the first application, and recover if the avatar is rebuilt later.
                        local changedBody = ready and entry.body ~= body.Id
                        if now >= entry.nextAt and (entry.passes < 2 or not ready or changedBody or cm.UseCustomEquipOnly == world) then
                            self:Apply(cm, uid, data.finals or {}, world)
                            entry.passes = entry.passes + 1
                            entry.nextAt = now + (entry.passes < 3 and 1 or 3)
                            entry.body = ready and body.Id or nil
                            log("[AvatarTicket] viewer reconcile pass=" .. tostring(entry.passes) .. " ready=" .. tostring(ready))
                        end
                    end
                end
            end
        end
        for uid, _ in pairs(self._T.applied) do
            if not seen[uid] then self._T.applied[uid] = nil end
        end
        local slot = _EntityService:GetEntityByPath("/ui/DefaultGroup/EquipWindow/SlotTicket")
        if isvalid(slot) then
            local item = _UIEquipInventoryManager:GetEquip(28)
            local icon = slot:GetChildByName("Icon")
            icon.Enable = item ~= ""
            slot.TextGUIRendererComponent.Text = item == "" and "티켓" or ""
            if item ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = DataRef(_UIEquipInventoryManager:ParseRUID(item)) end

        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release listeners when Maker stops or the session ends.
        for _, link in ipairs(self._T.links or {}) do
            if isvalid(link.entity) then link.entity:DisconnectEvent(ButtonClickEvent, link.connection) end
        end
    end
    @ExecSpace("Server")
    method void RequestOwnedTicket()
        -- Only platform-confirmed passes can create an account ticket on login.
        local sv=_CharacterPersistence._T.sv[senderUserId]
        if sv==nil or sv.activeId=="" then return end
        local id=sv.activeId
        local days=0
        if _WorldShopService:UserHasPassAndWait(senderUserId,"EFTHGP8UC") then days=180
        elseif _WorldShopService:UserHasPassAndWait(senderUserId,"5THAJEBGH") then days=30 end
        if days>0 then self:ReceiveOwnedTicket(id,days,senderUserId) end
    end

    @ExecSpace("Client")
    method void ReceiveOwnedTicket(string characterId, integer days)
        -- Discard a late answer after switching character; never duplicate a ticket.
        local cl=_CharacterPersistence._T.cl
        if cl==nil or not cl.entered then return end
        local ch=cl.chars[cl.enteredIndex]
        if ch==nil or ch.id~=characterId then return end
        local m=_UIEquipInventoryManager
        if self:IsTicket(m:GetEquip(28)) then return end
        local free=0
        for i=1,128 do
            local item=m:GetTabItem("equip",i)
            if self:IsTicket(item) then return end
            if item=="" and free==0 then free=i end
        end
        if free==0 then _UIToast:ShowMessage("코디 이용권을 받으려면 장비 인벤토리에 빈칸이 필요합니다.") return end
        m:SetTabItem("equip",free,self:BuildItem(days))
        m:RefreshUI()
        _CharacterPersistence:MarkDirty("avatar_ticket")
        log("[AvatarTicket] platform-owned pass delivered")
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleTicketUserLeave(UserLeaveEvent event)
        -- Remove public outfit snapshots when their owner leaves.
        self.outfits[tostring(event.UserId)]=nil
    end


    @ExecSpace("ClientOnly")
    method table PlayerDyeFinals(Entity player)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return {} end
        if player == _UserService.LocalPlayer then return self._T.localFinals or {} end
        local raw = self.outfits[player.PlayerComponent.UserId]
        if raw == nil or raw == "" then return {} end
        local data = _HttpService:JSONDecode(raw)
        return data.finals or {}
    end

    @ExecSpace("ClientOnly")
    method void ApplyPlayerTint(Entity player, number brightness)
        if not isvalid(player) or not isvalid(player.AvatarRendererComponent) then return end
        player.AvatarRendererComponent:SetColor(brightness, brightness, brightness, 1)
        _DecoWindowManager:ApplyDyeTint(player.CostumeManagerComponent, self:PlayerDyeFinals(player), brightness)
    end

    @ExecSpace("ClientOnly")
    method void SetWeaponAlpha(Entity player, number alpha)
        if not isvalid(player) or not isvalid(player.AvatarRendererComponent) then return end
        local finals = self:PlayerDyeFinals(player)
        for _, cat in ipairs({13,14}) do
            local color = Color.white
            if isvalid(player.CostumeManagerComponent) and player.CostumeManagerComponent.UseCustomEquipOnly then
                for _, f in ipairs(finals) do
                    if f[1] == cat and player.CostumeManagerComponent:GetEquip(_DecoWindowManager:CatEnum(cat)) == f[2] then
                        local hex = tostring(f[3] or "FFFFFF")
                        color = _DecoWindowManager:DyeColor(hex,tonumber(f[4]) or 100)
                    end
                end
            end
            player.AvatarRendererComponent:SetAvatarPartColor(_DecoWindowManager:CatEnum(cat),color.r,color.g,color.b,alpha)
        end
    end

end
