@Logic
script MapPortalSystem extends Logic

    property string travelSoundRUID = "952bafe2e6ca4c3e8522d1ca839bd234"

    property any portalKeyListener = nil

    method void OnBeginPlay()
        -- 기존 티어 조회를 유지하며, 목적지가 명시된 지역별 왕복 경로를 양쪽에 캐시한다.
        self._T.mapRegion = {}
        self._T.mapIdx = {}
        self._T.cooldown = {}
        local regions = {
            {
                lobby = "hunting01",
                maps  = {
                    "000010000","000040000","000050000",
                    "001000000","001000001","001000002","001000003",
                    "001010000","001010100","001010200","001010300","001010400",
                    "001020000","002000000","002000100"
                }
            },
            {
                lobby = "hunting02",
                maps  = {
                    "100000000","100010001","100010100",
                    "100020000","100020100","100020200","100020300","100020400","100020500",
                    "100040000","100040100","100040200","100040300","100040400","100040500",
                    "101000000","101010000","101010100",
                    "101020100","101020200","101020300",
                    "101030000","101030100","101030300","101030400","101030500",
                    "102000000","102010000",
                    "102020000","102020100","102020200","102020300","102020400","102020500",
                    "102030000","102030100","102030200",
                    "103000000","103010000","103010100",
                    "103030000","103030100","103030200","103030300","103030400",
                    "104000000","104010000","104010100","104010200","104020000"
                }
            },
            {
                lobby = "hunting03",
                maps  = {
                    "105000000","105000010","105000011","105000012",
                    "105010000","105010200","105010300","105010301",
                    "105020000","105020100","105020200","105020300","105020400","105020500",
                    "105030000","105030200","105030300","105030400","105030500",
                    "105100000","105100100","105100101","105100300","105100301"
                }
            }
        }

        self._T.regions = regions

        for ri, region in ipairs(regions) do
            for mi, mapId in ipairs(region.maps) do
                self._T.mapRegion[mapId] = ri
                self._T.mapIdx[mapId]    = mi
            end
        end


        self._T.routes = {}
        local count = 0
        for line in string.gmatch(self:TravelRouteText(), "[^\n]+") do
            local fields = {}
            for value in string.gmatch(line, "[^|]+") do table.insert(fields, value) end
            if #fields == 4 then
                local mapId = fields[1]
                if self._T.routes[mapId] == nil then self._T.routes[mapId] = {} end
                self._T.routes[mapId][fields[2]] = {map = fields[3], portal = fields[4]}
                count = count + 1
            end
        end
        if self:IsClient() then
            self.portalKeyListener = _InputService:ConnectEvent(KeyDownEvent, self.OnPortalKey)
        else
            log("[MapPortalSystem] 왕복 이동 포탈 준비: " .. tostring(count) .. "개")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnPortalKey(KeyDownEvent event)
        -- 스쳐 지나가거나 도착 직후 되돌아가지 않도록 새 위 방향키 입력만 처리한다.
        if _GameSystemMenu:BlocksInput() then return end
        if event.key ~= KeyboardKey.UpArrow or _LoginFlow.phase ~= "ingame" then return end
        if _KeySettingManager:IsCapturingKey() then return end
        local worldMap = _EntityService:GetEntityByPath("/ui/WorldMapGroup")
        if isvalid(worldMap) and worldMap.Enable then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) then return end
        local routes = self._T.routes[_ChannelManager:BaseName(player.CurrentMap.Name)]
        if routes == nil then return end
        local pos = player.TransformComponent.WorldPosition
        local bestName = ""
        local bestDistance = 99
        for portalName, _ in pairs(routes) do
            local portal = player.CurrentMap:GetChildByName(portalName)
            if isvalid(portal) and portal.EnabledInHierarchy then
                local p = portal.TransformComponent.WorldPosition
                local dx, dy = math.abs(pos.x - p.x), math.abs(pos.y - p.y)
                if dx <= 0.65 and dy <= 1.0 and dx + dy < bestDistance then
                    bestName = portalName
                    bestDistance = dx + dy
                end
            end
        end
        if bestName ~= "" then self:RequestTravel(bestName) end
    end

    @ExecSpace("Server")
    method void RequestTravel(string portalName)
        -- 클라이언트는 포탈 이름만 보낸다. 서버가 현재 맵·거리·목적지·연타 제한을 검증한다.
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) or not isvalid(player.CurrentMap) then return end
        local fromMap = player.CurrentMap
        local routes = self._T.routes[_ChannelManager:BaseName(fromMap.Name)]
        local route = routes ~= nil and routes[portalName] or nil
        if route == nil then return end
        local portal = fromMap:GetChildByName(portalName)
        if not isvalid(portal) or not portal.EnabledInHierarchy then return end
        local pos = player.TransformComponent.WorldPosition
        local origin = portal.TransformComponent.WorldPosition
        if math.abs(pos.x - origin.x) > 0.9 or math.abs(pos.y - origin.y) > 1.3 then return end
        local now = _UtilLogic.ServerElapsedSeconds
        if now - (self._T.cooldown[senderUserId] or -10) < 1.0 then return end
        local channelMap = _ChannelManager:EnsureMap(route.map, senderUserId)
        if channelMap == "" then return end
        local destination = _EntityService:GetEntityByPath("/maps/" .. channelMap .. "/" .. route.portal)
        if not isvalid(destination) or not destination.EnabledInHierarchy then return end
        self._T.cooldown[senderUserId] = now
        local p = destination.TransformComponent.WorldPosition
        self:NotifyMapTravel(route.map, senderUserId)
        _TeleportService:TeleportToMapPosition(player, Vector3(p.x, p.y + 0.1, 0), channelMap)
        log("[MapPortalSystem] 이동 " .. fromMap.Name .. "/" .. portalName .. " -> " .. route.map .. "/" .. route.portal)
    end

    @ExecSpace("Client")
    method void NotifyMapTravel(string destination)
        -- 이동을 승인받은 사용자에게만 호출한다. 맵 엔티티 수명과 무관하게 끝까지 재생한다.
        _GameAudio:QueueTravel(destination)
        log("[MapTravelSound] 재생 " .. self.travelSoundRUID)
    end

    @ExecSpace("ServerOnly")
    method integer GetMapRegion(string mapId)
        -- 기존 지역 티어 로직의 조회 계약을 유지한다.
        if self._T.mapRegion == nil then return 0 end
        return self._T.mapRegion[_ChannelManager:BaseName(mapId)] or 0
    end

    @ExecSpace("ServerOnly")
    method integer GetMapChainIndex(string mapId)
        -- 기존 지역 티어 로직의 맵 순서 조회 계약을 유지한다.
        if self._T.mapIdx == nil then return 0 end
        return self._T.mapIdx[_ChannelManager:BaseName(mapId)] or 0
    end

    method void OnEndPlay()
        -- 다음 플레이 세션에 키 리스너가 중복되지 않도록 해제한다.
        if self:IsClient() and self.portalKeyListener then
            _InputService:DisconnectEvent(KeyDownEvent, self.portalKeyListener)
        end
        self.portalKeyListener = nil
    end


    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) then return end
        local map = player.CurrentMap
        if self._T.frontMap == map then return end
        self._T.frontMap = map
        for name, _ in pairs(self._T.routes[_ChannelManager:BaseName(map.Name)] or {}) do
            local portal = map:GetChildByName(name)
            if isvalid(portal) and isvalid(portal.SpriteRendererComponent) then
                portal.SpriteRendererComponent.IgnoreMapLayerCheck = true
                portal.SpriteRendererComponent.SortingLayer = "MapLayer7"
                portal.SpriteRendererComponent.OrderInLayer = 20
            end
        end
    end

