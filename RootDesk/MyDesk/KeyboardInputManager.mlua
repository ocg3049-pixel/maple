@Logic
script KeyboardInputManager extends Logic

    property any keyDownHandler = nil

    method void OnBeginPlay()
        if not self:IsClient() then return end
        self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
    end

    method void OnEndPlay()
        if not self:IsClient() then return end
        if self.keyDownHandler then
            _InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
        end
        self.keyDownHandler = nil
    end

    method void OnKeyDown(KeyDownEvent e)
        -- 로그인 입력은 게임 입력 차단보다 먼저 전용 컨트롤러로 전달한다.
        if _LoginFlow:IsInGame() then return end
        if _LoginFlow.phase == "intro" then
            _LoginFlow:SkipIntro()
            return
        end
        local modal = _LoginFlow:UI("Modal")
        if isvalid(modal) and modal.Enable then
            if e.key == KeyboardKey.Return or e.key == KeyboardKey.KeypadEnter then
                _LoginFlow:Action("noticeYes")
            elseif e.key == KeyboardKey.Escape then
                _LoginFlow:Action("noticeNo")
            end
            return
        end
        if e.key == KeyboardKey.Escape then _LoginFlow:Action("previous") return end
        if e.key == KeyboardKey.Return or e.key == KeyboardKey.KeypadEnter then
            local phase = _LoginFlow.phase
            if phase == "login" then _LoginFlow:Action("login")
            elseif phase == "world" then _LoginFlow:Action("world")
            elseif phase == "channel" then _LoginFlow:Action("channelEnter")
            elseif phase == "character" then _LoginFlow:Action("enter") end
        elseif _LoginFlow.phase == "channel" then
            if e.key == KeyboardKey.LeftArrow then _LoginFlow:NavigateChannel(-1)
            elseif e.key == KeyboardKey.RightArrow then _LoginFlow:NavigateChannel(1)
            elseif e.key == KeyboardKey.UpArrow then _LoginFlow:NavigateChannel(-4)
            elseif e.key == KeyboardKey.DownArrow then _LoginFlow:NavigateChannel(4) end
        elseif _LoginFlow.phase == "character" and not _LoginFlow.busy then
            if e.key == KeyboardKey.LeftArrow then self:DoNavigate(-1)
            elseif e.key == KeyboardKey.RightArrow then self:DoNavigate(1)
            elseif e.key == KeyboardKey.UpArrow then self:DoPage(-1)
            elseif e.key == KeyboardKey.DownArrow then self:DoPage(1) end
        end
    end

    method void DoLogin()
        -- 기존 호출자도 월드 선택 단계를 거친다.
        _LoginFlow:Action("login")
    end

    method void ResetCharSelectPositions()
        -- 새 UI는 빌더 좌표가 기준이며 실행 시 위치를 덮어쓰지 않는다.
    end

    method void DoEnterGame()
        local selectBg = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CharacterSelectGroup/SelectBackground")
        if not isvalid(selectBg) then return end
        local charSelectComp = selectBg:GetComponent(CharacterSelectComponent)
        if not isvalid(charSelectComp) then return end

        local slot = math.floor(charSelectComp.selectedSlot)
        if slot < 1 or slot > charSelectComp:MaxSlot() then return end
        local slotData = charSelectComp:GetSlotData(slot)
        if slotData == "" then return end

        -- 화면 슬롯 엔티티는 3개뿐이다 - 선택된 캐릭터(1~12)가 놓인 현재 페이지의 칸을 찾아 입장시킨다.
        local slotPath = charSelectComp:UISlotPath(charSelectComp:UISlotOfIndex(slot))
        local slotEntity = _EntityService:GetEntityByPath(slotPath)
        if isvalid(slotEntity) then
            local slotBtn = slotEntity:GetComponent(CharacterSlotButton)
            if isvalid(slotBtn) then
                slotBtn:EnterLobby(slot)
            end
        end
    end

    method void DoAutoCreateCharacter()
        -- 단축키로 생성 절차를 우회하지 않는다.
        _LoginFlow:Action("create")
    end

    method void DoNavigate(integer delta)
        local selectBg = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CharacterSelectGroup/SelectBackground")
        if not isvalid(selectBg) then return end
        local charSelectComp = selectBg:GetComponent(CharacterSelectComponent)
        if not isvalid(charSelectComp) then return end

        local current = math.floor(charSelectComp.selectedSlot)
        if current < 1 then current = delta > 0 and 0 or charSelectComp:MaxSlot() + 1 end
        local nextSlot = current + delta
        while nextSlot >= 1 and nextSlot <= charSelectComp:MaxSlot() do
            if charSelectComp:GetSlotData(nextSlot) ~= "" then
                charSelectComp:SelectSlot(nextSlot)
                return
            end
            nextSlot = nextSlot + delta
        end
    end

    method void DoPage(integer delta)
        -- ↑/↓ 로 캐릭터 슬롯 페이지(3칸씩 4페이지) 이동.
        local selectBg = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CharacterSelectGroup/SelectBackground")
        if not isvalid(selectBg) then return end
        local charSelectComp = selectBg:GetComponent(CharacterSelectComponent)
        if not isvalid(charSelectComp) then return end
        charSelectComp:MovePage(delta)
    end

    @ExecSpace("Server")
    method void RequestSetNickname(Entity player, string name)
        -- PlayerComponent.Nickname과 NameTagComponent.Name은 둘 다 @Sync라 클라이언트에서 직접 대입해도 서버에 반영되지 않음 - 서버 RPC로 설정해야 함.
        -- CharacterSlotButton은 UI 부착 컴포넌트(ClientOnly)라 Server 메서드를 호스팅할 수 없어 이 Logic으로 옮김.
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        if player.PlayerComponent.UserId ~= senderUserId then return end
        player.PlayerComponent.Nickname = name
        if isvalid(player.NameTagComponent) then
            player.NameTagComponent.Name = name
        end
    end

end
