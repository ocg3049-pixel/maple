@Logic
script MonsterStatusLedger extends Logic
    @ExecSpace("ServerOnly")
    method void ApplySlow(Entity target, number duration)
        -- One baseline per entity life; repeated slows extend only the deadline.
        if not isvalid(target) or duration<=0 then return end
        local monster=target:GetComponent("script.Monster")
        if not isvalid(monster) or monster.IsDead then return end
        local snail=target:GetComponent("script.ManoSnail")
        if isvalid(snail) and snail.Special and snail.Phase=="flight" then return end
        local movement=target.MovementComponent
        if not isvalid(movement) then return end
        self._T.slow=self._T.slow or {}
        local key=target.Id local now=_UtilLogic.ServerElapsedSeconds
        local record=self._T.slow[key]
        if record~=nil and record.life~=monster.LifeSerial then self:Clear(target) record=nil end
        if record~=nil then record.untilTime=math.max(record.untilTime,now+duration) return end
        record={base=movement.InputSpeed,untilTime=now+duration,life=monster.LifeSerial}
        self._T.slow[key]=record
        movement.InputSpeed=record.base*0.5
        self:ScheduleSlowRestore(key,target,duration,0)
    end

    @ExecSpace("ServerOnly")
    method void ScheduleSlowRestore(string key, Entity target, number delay, integer retriesLeft)
        -- An expired callback cannot restore a newer application or a reused spawn.
        local expected=self._T.slow and self._T.slow[key] or nil
        _TimerService:SetTimerOnce(function()
            if self._T.slow~=nil and self._T.slow[key]==expected then self:TrySlowRestore(key,target,0) end
        end,math.max(0.01,delay))
    end

    @ExecSpace("ServerOnly")
    method void TrySlowRestore(string key, Entity target, integer retriesLeft)
        -- Restore on expiry; lifecycle cleanup handles death and respawn immediately.
        local record=self._T.slow and self._T.slow[key] or nil
        if record==nil then return end
        if not isvalid(target) then self._T.slow[key]=nil return end
        local monster=target:GetComponent("script.Monster")
        if not isvalid(monster) or monster.LifeSerial~=record.life then self:Clear(target) return end
        local remaining=record.untilTime-_UtilLogic.ServerElapsedSeconds
        if remaining>0 then self:ScheduleSlowRestore(key,target,remaining+0.01,0) return end
        if isvalid(target.MovementComponent) then target.MovementComponent.InputSpeed=record.base end
        self._T.slow[key]=nil
    end

    @ExecSpace("ServerOnly")
    method void ApplyStun(Entity target, number duration)
        -- Hit reactions and skill stuns share Monster's original movement snapshot.
        if not isvalid(target) or duration<=0 then return end
        local monster=target:GetComponent("script.Monster")
        if not isvalid(monster) or monster.IsDead then return end
        local snail=target:GetComponent("script.ManoSnail")
        if isvalid(snail) and snail.Special and snail.Phase=="flight" then return end
        self._T.stun=self._T.stun or {}
        local key=target.Id local now=_UtilLogic.ServerElapsedSeconds
        local record=self._T.stun[key]
        if record~=nil and record.life~=monster.LifeSerial then self:Clear(target) record=nil end
        if record~=nil then record.untilTime=math.max(record.untilTime,now+duration) return end
        self._T.stun[key]={untilTime=now+duration,life=monster.LifeSerial}
        monster:PauseMovement("stun")
        self:ScheduleStunRestore(key,target,duration,0)
    end

    @ExecSpace("ServerOnly")
    method void ScheduleStunRestore(string key, Entity target, number delay, integer retriesLeft)
        -- Capture the record identity, not just a reusable entity path.
        local expected=self._T.stun and self._T.stun[key] or nil
        _TimerService:SetTimerOnce(function()
            if self._T.stun~=nil and self._T.stun[key]==expected then self:TryStunRestore(key,target,0) end
        end,math.max(0.01,delay))
    end

    @ExecSpace("ServerOnly")
    method void TryStunRestore(string key, Entity target, integer retriesLeft)
        -- The last overlapping stun expires without releasing a concurrent hit lock.
        local record=self._T.stun and self._T.stun[key] or nil
        if record==nil then return end
        if not isvalid(target) then self._T.stun[key]=nil return end
        local monster=target:GetComponent("script.Monster")
        if not isvalid(monster) or monster.LifeSerial~=record.life then self:Clear(target) return end
        local remaining=record.untilTime-_UtilLogic.ServerElapsedSeconds
        if remaining>0 then self:ScheduleStunRestore(key,target,remaining+0.01,0) return end
        self._T.stun[key]=nil
        monster:ResumeMovement("stun")
    end

    @ExecSpace("ServerOnly")
    method void Clear(Entity target)
        -- Death/respawn discard old timers and restore the original speed and movement.
        if not isvalid(target) then return end
        local key=target.Id
        local slow=self._T.slow and self._T.slow[key] or nil
        if slow~=nil and isvalid(target.MovementComponent) then target.MovementComponent.InputSpeed=slow.base end
        if self._T.slow~=nil then self._T.slow[key]=nil end
        if self._T.stun~=nil then self._T.stun[key]=nil end
        local monster=target:GetComponent("script.Monster")
        if isvalid(monster) then monster:ResumeMovement("stun") end
    end
end
