@Component
script Monster extends Component

    -- (요청) 필드 달팽이 몬스터 체력을 1000으로. 배치된 몬스터들이 .map/.model에서 MaxHp를 따로
    -- 지정하지 않고 이 기본값을 그대로 쓰는 것을 실측 확인했다(map01의 50마리 전부 MaxHp=100).
    -- 그래서 이 기본값만 올리면 배치 몬스터 전체에 반영된다.
    @Sync property integer MaxHp = 3000
    @Sync property integer Hp = 0
    @Sync property integer IncomingHitDamage = 0
    @Sync property number IncomingHitExpires = 0
    @Sync property integer LifeSerial = 0
    @Sync property boolean RespawnOn = false
    @Sync property boolean IsDead = false
    @Sync property number HealthBarUntil = 0
    property number HealthBarOffsetY = 0
    @Sync property integer NameTagLevel = 0
    @Sync property string NameTagText = ""
    property boolean GroupRespawn = false
    property number RespawnDelay = 5.0
    property number DestroyDelay = 0.6
    property integer MonsterLevel = 15
    property string MonsterDisplayName = ""
    property boolean Stationary = false

    -- (요청 2026-08-09) 어그로 지속시간(초). 마지막으로 맞은 시점부터 이만큼 공격자를 쫓고,
    -- 만료되면 추적을 풀고 다시 혼자 배회한다.
    property number AggroDurationSeconds = 10.0
    -- 힐 스킬이 "언데드 몬스터에게는 데미지를 입힌다" 판정에 쓰는 플래그. 기본값 false라 기존 몬스터는 영향 없음.
    property boolean IsUndead = false
    -- (전투분석 허수아비) 절대 죽지 않는 샌드백 - HP가 바닥나면 만피로 리필하고 사망 분기를 타지 않는다.
    -- 기본값 false라 기존 몬스터는 영향 없음.
    @Sync property boolean NeverDie = false
    -- 명시한 전용 소리가 우선한다. 비어 있으면 애니메이션에 대응하는 공식 몬스터 팩에서 선택한다.
    property string HitSoundRUID = ""
    property string DeathSoundRUID = ""

    -- (요청 2026-08-11) 리젠 자리(최초 배치 좌표). 리젠은 항상 이 좌표에서 일어난다(_T.spawnX/Y와
    -- 같은 값). @Sync로 공개하는 이유: 자동사냥(클라)이 "죽어서 리젠 대기 중인 몬스터의 리젠 자리"에
    -- 포이즌 미스트를 선설치하려면 클라에서 이 좌표를 읽어야 한다(_T는 서버 전용이라 못 읽는다).
    @Sync property number SpawnX = 0
    @Sync property number SpawnY = 0

    -- ── 상태이상 표시 이펙트 장부 (클라 전용, 2026-08-06 신설) ────────────────
    -- (신고) "어썰터에 죽은 몬스터가 리젠될 때 스턴 리소스를 들고 태어난다."
    -- 원인: 스턴 표시(b0bd80f4 등)는 **isLoop=true로 몬스터에 붙여 놓고 N초 뒤 타이머로 지우는**
    -- 방식인데, 그 사이 몬스터가 죽으면 엔티티가 꺼지면서 제거 타이머가 실효를 잃는다. 리젠으로
    -- 엔티티를 다시 켜면 붙어 있던 루프 이펙트가 그대로 살아난다.
    -- → 몬스터가 죽는 순간 **붙어 있던 표시 이펙트를 전부 지운다**. 스턴/빙결처럼 대상에 붙는
    --   루프 이펙트는 전부 여기에 등록해야 한다(PlayerAttack의 Play*StunEffect 참고).

    @ExecSpace("ClientOnly")
    method void RegisterStatusEffect(integer serial)
        if serial == nil or serial == 0 then return end
        if self._T.statusEffects == nil then self._T.statusEffects = {} end
        self._T.statusEffects[serial] = true
    end

    @ExecSpace("ClientOnly")
    method void UnregisterStatusEffect(integer serial)
        -- 정상 만료(타이머)로 지운 경우 - 장부에서만 빼고 실제 제거는 호출자가 한다.
        if serial == nil or self._T.statusEffects == nil then return end
        self._T.statusEffects[serial] = nil
    end

    @ExecSpace("ClientOnly")
    method void ClearStatusEffects()
        if self._T.statusEffects == nil then return end
        local n = 0
        for serial, _ in pairs(self._T.statusEffects) do
            _EffectService:RemoveEffect(serial)
            n = n + 1
        end
        self._T.statusEffects = {}
        if n > 0 then
            log("[Monster] 사망 - 붙어 있던 상태이상 표시 이펙트 " .. tostring(n) .. "개 제거(리젠 시 잔존 방지)")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- IsDead가 true로 넘어오는 순간이 클라이언트가 아는 유일한 "죽었다" 신호다
        -- (Dead()는 ServerOnly라 클라 쪽 이펙트 장부를 직접 못 지운다).
        if name == "Hp" or name == "MaxHp" then
            self._T.healthBarDirty = true
        end
        if name ~= "IsDead" then return end
        if value == true then
            if isvalid(self._T.nameTag) then self._T.nameTag.Enable = false end
            self:HideHealthBar()
            self:ClearStatusEffects()
			self:ClearIceDemonMarkEffect()
        end
    end

    @ExecSpace("ServerOnly")
    method void SetupMonsterNameTag()
        -- 배치 번호를 제외한 몬스터 종류로 표시 문구를 찾고 플레이어와 같은 기본 이름표를 붙인다.
        local labels = {
            ["monster-2634"] = "Lv.2 파란 달팽이",
            ["monster-1143"] = "Lv.4 빨간 달팽이",
            ["monster-2416"] = "Lv.15 초록 버섯",
            ["monster-1957"] = "Lv.8 시니컬한 주황버섯",
            ["monster-2218"] = "Lv.8 주황버섯",
            ["monster-545"] = "Lv.2 스포아",
            ["monster-805"] = "Lv.20 파란버섯",
            ["monster-1419"] = "Lv.20 우는 파란버섯",
            ["monster-1224"] = "Lv.1 달팽이",
            ["monster-1366"] = "Lv.22 뿔버섯",
            ["monster-2053"] = "Lv.22 화난 뿔버섯",
            ["monster-undead-healtest"] = "Lv.24 좀비버섯",
            ["monster-665"] = "Lv.24 좀비버섯",
            ["monster-1037"] = "Lv.27 이블아이",
            ["monster-2119"] = "Lv.35 커즈아이",
            ["monster-2143"] = "Lv.29 서전아이",
            ["monster-621"] = "Lv.4 스텀프",
            ["monster-506"] = "Lv.17 엑스텀프",
            ["monster-1290"] = "Lv.10 다크 스텀프",
            ["monster-1914"] = "Lv.22 다크 엑스텀프",
            ["monster-4733"] = "Lv.19 고스텀프",
            ["monster-1217"] = "Lv.19 히죽대는 고스텀프",
            ["monster-664"] = "Lv.52 크로코",
            ["monster-757"] = "Lv.32 리게이터",
            ["monster-2586"] = "Lv.49 늪진흙괴물",
            ["monster-2270"] = "Lv.55 스톤골렘",
            ["monster-316"] = "Lv.62 아이스 믹스골렘",
            ["monster-2150"] = "Lv.59 믹스골렘",
            ["monster-3240"] = "Lv.58 다크 스톤골렘",
            ["monster-2095"] = "Lv.65 파이어 믹스골렘",
            ["monster-2302"] = "Lv.12 옥토퍼스",
            ["monster-1550"] = "Lv.21 주니어 네키",
            ["monster-3223"] = "Lv.15 버블링",
            ["monster-1806"] = "Lv.6 슬라임",
            ["monster-2056"] = "Lv.30 페어리",
            ["monster-957"] = "Lv.33 아이스 페어리",
            ["monster-1844"] = "Lv.25 와일드보어",
            ["monster-3246"] = "Lv.28 겁먹은 와일드보어",
            ["monster-499"] = "Lv.42 아이언호그",
            ["monster-2511"] = "Lv.45 아이언보어",
        }
        local kind = (string.gsub(self.Entity.Name, "_%d+$", ""))
        local label = labels[kind]
        if self.MonsterDisplayName ~= "" then
            label = "Lv." .. tostring(self.MonsterLevel) .. " " .. self.MonsterDisplayName
        end
        if label == nil then return end
        local tag = self.Entity.NameTagComponent
        if not isvalid(tag) then
            self.Entity:AddComponent("MOD.Core.NameTagComponent")
            tag = self.Entity.NameTagComponent
        end
        if not isvalid(tag) then return end
        local separator = (string.find(label, " "))
        if separator == nil then return end
        local level = string.sub(label, 1, separator - 1)
        local monsterName = string.sub(label, separator + 1)
        self.NameTagLevel = tonumber(string.sub(level, 4)) or 0
        label = level .. ". " .. monsterName
        tag.Name = label
        tag.FontSize = 1
        tag.FontColor = Color(1, 1, 1, 1)
        tag.Bold = false
        tag.FontOffset = Vector2(0, 0)
        tag.OffsetY = 0
        self.NameTagText = "<mark=#00000080> <size=85%>" .. level .. ".</size> " .. monsterName .. " </mark>"
        tag.Enable = false
        log("[MonsterNameTag] " .. self.Entity.Name .. " -> " .. label)
    end

    @ExecSpace("ClientOnly")
    method void UpdateMonsterNameTag()
        -- 몬스터의 음수 스케일을 상속하지 않는 로컬 이름표를 만들고 발밑을 따라가게 한다.
        local nameEntity = self._T.nameTag
        if self.IsDead or self.Hp <= 0 or not self.Entity.VisibleInHierarchy or self.NameTagText == "" then
            if isvalid(nameEntity) then nameEntity.Enable = false end
            return
        end
        if not isvalid(nameEntity) then
            if (self._T.nameTagRetryAt or 0) > _UtilLogic.ElapsedSeconds then return end
            self._T.nameTagRetryAt = _UtilLogic.ElapsedSeconds + 1
            if not isvalid(self.Entity.CurrentMap) then return end
            nameEntity = _SpawnService:SpawnByModelId("monsternametag", "Name_" .. self.Entity.Id, Vector3(0, 0, 0), self.Entity.CurrentMap)
            if not isvalid(nameEntity) then return end
            self._T.nameTag = nameEntity
            self._T.nameTagColorBand = nil
            local text = nameEntity.TextRendererComponent
            text.FontSize = 1.2
            text.FontColor = Color(1, 1, 1, 1)
            text.IsRichText = true
            text.BestFit = false
            text.Wrapping = false
            text.SizeFit = true
            text.HorizontalAlignment = TextHorizontalAlignmentOption.Center
            text.VerticalAlignment = TextVerticalAlignmentOption.Middle
            text.RectOffset = Vector2(0, -0.12)
            text.SortingLayer = self:GetMonsterOverlayLayer()
            text.OrderInLayer = 32767
            text.Text = self.NameTagText
            text.Enable = true
            log("[MonsterNameTag] client created " .. self.Entity.Name)
            self:UpdateMonsterNameTagColor(math.max(1, _UIMyInfoManager.DisplayLevel))
        end
        local pos = self.Entity.TransformComponent.WorldPosition
        nameEntity.TransformComponent.WorldPosition = Vector3(pos.x, pos.y, pos.z - 0.01)
        nameEntity.Enable = true
    end

    @ExecSpace("ClientOnly")
    method string GetMonsterOverlayLayer()
        -- 표시용 레이어 이름은 엔진이 해당 맵의 MapLayerN으로 변환한다.
        -- 몬스터 본체 레이어를 따라가면 앞쪽 지형에 이름표와 HP바가 가려진다.
        local currentMap = self.Entity.CurrentMap
        if not isvalid(currentMap) then return "MapLayer0" end
        if self._T.overlayMap == currentMap and self._T.overlayLayer ~= nil then
            return self._T.overlayLayer
        end
        local layerName = "MapLayer0"
        local highestOrder = -2147483648
        for _, layer in ipairs(currentMap:GetChildComponentsByTypeName("MOD.Core.MapLayerComponent", true)) do
            if layer.LayerSortOrder > highestOrder then
                highestOrder = layer.LayerSortOrder
                layerName = layer.MapLayerName
            end
        end
        self._T.overlayMap = currentMap
        self._T.overlayLayer = layerName
        return layerName
    end

    @ExecSpace("ClientOnly")
    method void UpdateMonsterNameTagColor(integer playerLevel)
        -- 자신의 HUD 레벨과 표시용 몬스터 레벨을 비교한다. 클라이언트에서만 바꿔 다른 유저와 색이 섞이지 않는다.
        if not isvalid(self._T.nameTag) then return end
        local text = self._T.nameTag.TextRendererComponent
        if not isvalid(text) or self.NameTagLevel <= 0 then return end
        local difference = self.NameTagLevel - playerLevel
        local band = 0
        if difference > 10 then
            band = 2
        elseif difference > 5 then
            band = 1
        elseif difference < -5 then
            band = -1
        end
        if self._T.nameTagColorBand == band then return end
        self._T.nameTagColorBand = band
        if band == 2 then
            text.FontColor = Color(1, 0.2, 0.2, 1)
        elseif band == 1 then
            text.FontColor = Color(1, 0.55, 0.1, 1)
        elseif band == -1 then
            text.FontColor = Color(1, 0.9, 0.2, 1)
        else
            text.FontColor = Color(1, 1, 1, 1)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 수동 MISS/숫자 표시와 엔진 자동 숫자의 중복을 차단한다.
        local spawner = self.Entity.DamageSkinSpawnerComponent
        if isvalid(spawner) then spawner.Enable = false end
        -- 필드 모델의 EndFrameIndex=0은 첫 프레임만 재생한다.
        -- 상태별 ActionSheet는 유지하고 모든 동작의 전체 프레임을 허용한다.
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) and sprite.StartFrameIndex == 0 and sprite.EndFrameIndex == 0 then
            sprite.EndFrameIndex = 2147483647
            log("[MonsterAnimation] full frames enabled " .. self.Entity.Name)
        end
        -- (밸런스 2026-08-09) MaxHp를 명시하지 않은 몬스터(= 기본값 3000 그대로)는 MonsterLevel로
        -- 동일 레벨 히어로의 주력기·버프·SP 기준 피해 ×1.9를 적용한다.
        -- 3000을 센티널로 쓰므로, 특정 몬스터에 정확히 3000을 주고 싶으면 .map/.model에 2999나
        -- 3001처럼 다른 값을 명시할 것. 허수아비(1억)처럼 명시된 값은 그대로 존중된다.
        self:SetupMonsterNameTag()
        self.HealthBarUntil = 0
        if self.MaxHp == 3000 then
            self.MaxHp = _RegionTierLogic:GetMonsterHpForLevel(self.NameTagLevel > 0 and self.NameTagLevel or self.MonsterLevel)
        end
        self.Hp = self.MaxHp
        -- (버그 수정) 배치된 최초 위치를 기억해 둔다 - 리젠은 죽은 자리가 아니라 항상 이 자리에서 이뤄진다.
        -- AI가 플레이어를 쫓아다니다 엉뚱한 곳에서 죽으면 그 자리가 새 리젠 위치가 돼버렸다.
        local spawnPos = self.Entity.TransformComponent.WorldPosition
        self._T.spawnX = spawnPos.x
        self._T.spawnY = spawnPos.y
        -- 클라(자동사냥 미스트 선설치)용 공개 사본 - 리젠 판정 자체는 계속 _T를 쓴다.
        self.SpawnX = spawnPos.x
        self.SpawnY = spawnPos.y
        -- (요청 2026-08-09) 처음엔 아무도 쫓지 않고 혼자 배회한다 - 맞아야만 그 공격자를 쫓는다.
        -- ⚠ AddComponent 직후 같은 프레임에 Enable을 만지면 반영이 어긋난다(실측) - 한 틱 미뤄 적용한다.
        self:EnsureWanderAI()
        local entInit = self.Entity
        _TimerService:SetTimerOnce(function()
            if not isvalid(entInit) then return end
            self:ApplyAggroState(false, nil)
        end, 0.2)
        log("Monster: OnBeginPlay, MaxHp=" .. tostring(self.MaxHp) .. " spawnPos=" .. tostring(spawnPos.x) .. "," .. tostring(spawnPos.y))
        if self.GroupRespawn then
            _MonsterZoneRespawn:Register(self)
        end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        if self.IsDead then return end
        self.Hp = self.Hp - event.TotalDamage
        -- 예약 데미지(ReserveDamage)로 미리 잡아둔 몫이 실제로 들어왔으므로 그만큼 덜어낸다.
        -- 안 덜면 "Hp는 이미 줄었는데 예약은 그대로" 상태가 되어 아직 여유가 있는 몬스터까지
        -- 치사 예약으로 오판해 대상 선정에서 빠진다.
        local incomingProjectile = isvalid(event.AttackerEntity) and event.AttackerEntity:GetComponent("script.LuckySevenProjectile") or nil
        if incomingProjectile == nil or not incomingProjectile.GuaranteedHit then self:ConsumeReservedDamage(event.TotalDamage) end
        -- (표창 재고) 마지막으로 때린 **플레이어**를 기억해 둔다 - 처치 시 그 플레이어에게만
        -- 표창 보충을 준다(Dead 참고). 직접 타격은 공격자가 플레이어지만, 투사체 스킬은 공격자가
        -- 투사체 엔티티라 판정 컴포넌트의 시전자 참조(OwnerEntity)로 주인을 되짚는다.
        local directAttack = isvalid(event.AttackerEntity) and event.AttackerEntity:GetComponent("script.PlayerAttack") or nil
        if isvalid(directAttack) and directAttack:GetExpectedDamageLineCount(event.Extra or "") > 0 then
            directAttack:ShowResolvedDamage(self.Entity, event.TotalDamage, event.IsCritical, directAttack:GetHitDamageSkinId())
        end
        self:RememberLastAttacker(event.AttackerEntity)
        -- (요청 2026-08-09) 맞았으니 이제부터 **그 공격자만** 쫓는다.
        -- ⚠ 공격자 해석은 _T.lastKiller(RememberLastAttacker)가 아니라 BattleStatsManager.ResolveOwner를
        --   쓴다 - 전자는 표창/어벤져 투사체만 되짚도록 만들어져 있어서, 그것만 믿으면 궁수·마법사의
        --   다른 투사체로 때렸을 때 어그로가 안 걸린다. ResolveOwner는 OwnerComponentNames 목록으로
        --   모든 투사체/소환수를 커버한다(새 투사체는 그 목록에 등록하면 여기도 자동으로 따라온다).
        local aggroOwner = _BattleStatsManager:ResolveOwner(event.AttackerEntity)
        local ownerAttack = isvalid(aggroOwner) and aggroOwner:GetComponent("script.PlayerAttack") or nil
        if isvalid(ownerAttack) then ownerAttack:RecordAutoHuntContact(self.Entity, self.LifeSerial) end
        if event.TotalDamage > 0 and isvalid(aggroOwner) then
            self.HealthBarUntil = _UtilLogic.ServerElapsedSeconds + 5.0
        end
        if isvalid(aggroOwner) then
            -- 어그로는 마지막 피격으로부터 AggroDurationSeconds(10초) 유지되고, 만료되면 배회로 돌아간다.
            local nowSrv = _UtilLogic.ServerElapsedSeconds
            local wasAggro = (self._T.aggroUntil or 0) > nowSrv
            self._T.aggroUntil = nowSrv + self.AggroDurationSeconds
            self:ApplyAggroState(true, aggroOwner)
            -- 만료 감시는 어그로가 **처음 걸릴 때만** 건다(타격마다 걸면 타이머가 쌓인다).
            if not wasAggro then
                self:ScheduleAggroExpiry()
            end
        end
        -- (전투분석) 실제 적용 데미지를 시전자 플레이어에게 귀속 - 모든 스킬/투사체/소환수가
        -- 이 HitEvent 한 곳으로 수렴하므로 여기 한 줄이면 전 직업을 커버한다.
        -- event.Extra = Attack() 호출의 attackInfo 태그(스킬 식별용, 기본공격은 nil).
        _BattleStatsManager:ReportHitTagged(self.Entity, event.AttackerEntity, event.TotalDamage, event.Extra)
        log("Monster: Hit! TotalDamage=" .. tostring(event.TotalDamage) .. " Hp=" .. tostring(self.Hp))
        self:PlayHitSound()
        -- (전투분석 허수아비) 불사 몬스터는 HP가 바닥나면 만피로 리필 - 데미지 표시/집계(위에서 완료)는
        -- 그대로 두고 사망 경로만 차단한다.
        if self.NeverDie then
            if self.Hp <= 0 then self.Hp = self.MaxHp end
            return
        end
        if self.Hp <= 0 then
            -- (요청) 럭키세븐/트리플/쿼드러플 스로우처럼 표창을 여러 발 던지는 스킬은 **마지막 발에만**
            -- 죽어야 한다("hit 사운드를 온전히 다 들려주고 죽는 모션을 늦추기 위함").
            -- 유예 창이 열려 있는 동안은 HP가 0 이하로 떨어져도 죽지 않고 1로 버틴다 - 그래서
            -- 남은 표창들도 정상 피격으로 처리되어 타격음/타격 이펙트/데미지 숫자가 전부 나온다.
            -- 마지막 표창이 유예를 해제한 뒤 때리므로 그 타격에 죽는다.
            if self._T.deathDeferUntil ~= nil and _UtilLogic.ServerElapsedSeconds < self._T.deathDeferUntil then
                self.Hp = 1
                -- 이미 치명타를 받았다는 표시. 다음 공격의 대상 선정에서 제외해야, 곧 죽을 몬스터
                -- 자리에 또 공격이 날아가 빈 자리에 데미지가 뜨는 일이 없다(IsDeathPending 참고).
                self._T.pendingDeath = true
                log("Monster: 사망 유예 중 - HP 1로 버팀 (남은 타격까지 대기)")
                return
            end
            self.Hp = 0
            self:Dead()
        end
    end

    -- 사망 유예: 지정 시간 동안은 HP가 0 이하가 되어도 죽지 않고 1로 버틴다.
    -- 다중 타격 스킬이 "마지막 타에만 죽이기"를 구현할 때 쓴다. 마지막 타 직전에 ClearDeathDefer를
    -- 호출해 유예를 풀어야 하며, 마지막 타가 유실되더라도 이 시간이 지나면 자동으로 풀린다(영구 무적 방지).
    @ExecSpace("ServerOnly")
    method void DeferDeath(number seconds)
        -- 사망 유예 창을 지금부터 seconds 동안 연다(이미 열려 있으면 더 늦은 쪽으로 갱신).
        local until_ = _UtilLogic.ServerElapsedSeconds + seconds
        if self._T.deathDeferUntil == nil or self._T.deathDeferUntil < until_ then
            self._T.deathDeferUntil = until_
        end
    end

    -- 이미 치명타를 받아 "마지막 타에 죽기"만 기다리는 상태인지.
    -- ⚠ 왜 필요한가: 스킬 쿨다운이 마지막 표창이 도달하기 전에 끝나서, 다음 시전이 이 몬스터를
    --   여전히 살아있는(HP 1) 대상으로 잡아버렸다. 그 직후 몬스터가 죽으면 다음 시전의 표창들이
    --   빈 자리로 날아가 데미지 숫자만 뜬다(신고: "죽은 몬스터 자리에 다음 공격을 하며 데미지가 뜬다").
    --   → 대상 선정에서 이 상태를 죽은 것으로 취급한다.
    --   유예 창이 만료되면(마지막 타 유실) 다시 정상 대상이 되어 영구 무적이 되지 않는다.
    -- 기본공격의 예약은 개별 토큰으로 관리한다. 다른 공격의 피해로 예약을 잘못 차감하지 않는다.
    @ExecSpace("ServerOnly")
    method integer ReserveIncomingHit(integer damage, number duration)
        if self.IsDead or damage <= 0 then return 0 end
        self._T.incomingHits = self._T.incomingHits or {}
        self._T.incomingHitSerial = (self._T.incomingHitSerial or 0) + 1
        local token = self._T.incomingHitSerial
        self._T.incomingHits[token] = {damage=damage, expires=_UtilLogic.ServerElapsedSeconds + duration}
        self:RefreshIncomingHits()
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) then self:ReleaseIncomingHit(token) end
        end, duration)
        return token
    end

    @ExecSpace("ServerOnly")
    method void ReleaseIncomingHit(integer token)
        if self._T.incomingHits ~= nil then self._T.incomingHits[token] = nil end
        self:RefreshIncomingHits()
    end

    @ExecSpace("ServerOnly")
    method void RefreshIncomingHits()
        local sum, expiry = 0, 0
        for token, hit in pairs(self._T.incomingHits or {}) do
            if hit.expires <= _UtilLogic.ServerElapsedSeconds then
                self._T.incomingHits[token] = nil
            else
                sum = sum + hit.damage
                expiry = math.max(expiry, hit.expires)
            end
        end
        self.IncomingHitDamage = sum
        self.IncomingHitExpires = expiry
    end

    method boolean IsDeathPending()
        -- 치명타를 받고 사망 유예 창 안에서 대기 중인지, 또는 **아직 도달하지 않은 공격의 예약
        -- 데미지만으로 이미 죽는 것이 확정**됐는지(ReserveDamage 참고).
        if self.NeverDie then return false end
        if self.IncomingHitExpires > _UtilLogic.ServerElapsedSeconds and self.IncomingHitDamage >= self.Hp and self.IncomingHitDamage > 0 then return true end
        if self:IsClient() then return false end
        if self:IsLethalReserved() then return true end
        if self._T.pendingDeath ~= true then return false end
        if self._T.deathDeferUntil == nil then return false end
        return _UtilLogic.ServerElapsedSeconds < self._T.deathDeferUntil
    end

    -- ── 예약 데미지(선고 데미지) ─────────────────────────────────────────────
    -- (요청) 럭키세븐/트리플 스로우/쿼드러플 스로우처럼 **시전 시점에 대상 하나를 찍어놓고**
    -- 표창을 날리는 단일 표적 스킬은, 표창이 도착하기 전에 다음 시전이 같은 몬스터를 다시 찍어
    -- "이전 공격으로 이미 죽는 몬스터의 빈 자리"로 표창을 날리는 문제가 있었다.
    --
    -- ⚠ 기존 IsDeathPending(사망 유예)만으로는 못 막는다: 유예는 **첫 표창이 실제로 맞은 뒤**에야
    --   열리는데, 시전~첫 표창 도달까지 0.4초 + 비행 시간의 공백이 있어 그 사이에 들어온 다음
    --   시전은 몬스터를 여전히 멀쩡한 대상으로 본다.
    -- → 시전하는 쪽(PlayerAttack.AttackStarThrow)이 이번 공격의 총 데미지를 **미리 굴려** 여기에
    --   적어두고, `Hp - 예약 <= 0`이면 이 몬스터는 죽은 것으로 취급해 대상 선정에서 제외한다.
    --
    -- 예약은 (1) 실제 피격으로 그만큼 소진되거나(ConsumeReservedDamage), (2) 표창이 유실돼
    -- 시간이 지나면 자동 만료된다 - 그래서 영구히 대상에서 빠지는 일이 없다.
    @ExecSpace("ServerOnly")
    method void ReserveDamage(integer amount, number seconds)
        -- 아직 도달하지 않은 공격의 데미지를 예약해둔다(누적).
        if self.IsDead then return end
        if amount == nil or amount <= 0 then return end
        local cur = self:GetReservedDamage()
        self._T.reservedDamage = cur + amount
        local until_ = _UtilLogic.ServerElapsedSeconds + ((seconds ~= nil and seconds > 0) and seconds or 3.0)
        if self._T.reservedUntil == nil or self._T.reservedUntil < until_ then
            self._T.reservedUntil = until_
        end
        log("Monster: 예약 데미지 " .. tostring(amount) .. " 등록 (누적=" .. tostring(self._T.reservedDamage)
            .. " Hp=" .. tostring(self.Hp) .. " 치사예약=" .. tostring(self.Hp - self._T.reservedDamage <= 0) .. ")")
    end

    @ExecSpace("ServerOnly")
    method integer GetReservedDamage()
        -- 지금 유효한 예약 데미지 총량. 만료됐으면 0으로 정리하고 돌려준다.
        if self._T.reservedDamage == nil then return 0 end
        if self._T.reservedUntil == nil or _UtilLogic.ServerElapsedSeconds >= self._T.reservedUntil then
            self._T.reservedDamage = nil
            self._T.reservedUntil = nil
            return 0
        end
        return self._T.reservedDamage
    end

    @ExecSpace("ServerOnly")
    method void ConsumeReservedDamage(integer amount)
        -- 실제로 들어온 데미지만큼 예약을 덜어낸다.
        local cur = self:GetReservedDamage()
        if cur <= 0 then return end
        local left = cur - ((amount ~= nil) and amount or 0)
        if left <= 0 then
            self._T.reservedDamage = nil
            self._T.reservedUntil = nil
        else
            self._T.reservedDamage = left
        end
    end

    @ExecSpace("ServerOnly")
    method boolean IsLethalReserved()
        -- 예약 데미지만으로 이번에 죽는 것이 확정된 상태인지.
        local r = self:GetReservedDamage()
        if r <= 0 then return false end
        return (self.Hp - r) <= 0
    end

    @ExecSpace("ServerOnly")
    method void ClearDeathDefer()
        -- 사망 유예를 즉시 해제한다(마지막 타가 들어가기 직전에 호출).
        self._T.deathDeferUntil = nil
    end

    @ExecSpace("ClientOnly")
    method string ResolveMonsterSound(boolean isDeath)
        -- 현재 배치의 stand 클립으로 공식 팩의 Damage/Die를 찾는다. 이름 변경과 리젠에도 같은 소리를 사용한다.
        local overrideRuid = self.HitSoundRUID
        if isDeath then overrideRuid = self.DeathSoundRUID end
        if overrideRuid ~= "" then return overrideRuid end
        if self._T.monsterSoundProfile == nil then
            -- MSW 리소스 API 확인: 2026-09-22. 빈 값은 해당 팩에 소리가 등록되지 않은 경우다.
            local profiles = {
            ["96e955c1bf27415e84f96deea200a8f1"] = {"6eb2ef8a783c4393bd7ee6a2c199bda7", "c49646f7299e4c6e81e953c96e20b294"}, -- 주황버섯 / mob/1210102.img
            ["cf2a470436cd4b2aa265648e15198c45"] = {"b5430bb5b1da4095a3033a408bdbffe3", "5a1056a232dd422d933f7e9714c24de5"}, -- 스텀프 / mob/0130100.img
            ["0c69164656d24f64bd1a1f6ee4019dff"] = {"892c25924e3f49f4a42dcb9a39525800", "e704d4ea59f4457ca1833423aef36340"}, -- 파란 달팽이 / mob/0100101.img
            ["1371f44b1ce643e185ebf5396bddaaf7"] = {"bbec511b4ba4460ea0e2f03c71695053", "c1e92a26ba3444e8a4a7c414995267be"}, -- 빨간 달팽이 / mob/0130101.img
            ["f84d50d06d1c45308d8497e8bf226308"] = {"30401595b3734c6e9d00ddd299d2a459", "8fb5827f7c0b48c29d9dace900d7fe75"}, -- 스포아 / mob/0120100.img
            ["74dd2989723d49fea80943f3c8e5fc82"] = {"597cdcc11c6a470697fbe4dbcd0ab1e2", "bbb71a7d0c2d401d897643ff037c647a"}, -- 시니컬한 주황버섯 / mob/2300102.img
            ["f4915ad47dbf4682a56fcac6b893a597"] = {"876c6bd9ed0a4606a184ff1c9ade7049", "de99395544a84b3095e60e7e020c05d3"}, -- 뿔버섯 / mob/2110200.img
            ["50faf654ee5d479cb2958edce9feaef0"] = {"4623a7a5a7de4e09891c3f0a70f6fb39", "79c80c07bf104fedada12695846b09c4"}, -- 슬라임 / mob/0210100.img
            ["f86992ba9c41487c8480fcb893fcbda6"] = {"0909185a3a4245e184e9f33d6fd4d718", "9d6373709f0e413aa563464c7be583e5"}, -- 초록버섯 / mob/1110100.img
            ["1a176a7afb114fe7aef2bc58ef2d945b"] = {"200b85bd0ce54b65abce48573540faf1", "096c50e7e8e048539fd3be0ca229b3fa"}, -- 우는 파란버섯 / mob/2220110.img
            ["6a98e7ec155643c4a53ff7a81965a6d9"] = {"869aea67272b44b7a2b12e9249432f87", "6783b7baa93d49eba29b4d56332f0a7f"}, -- 파란버섯 / mob/2220100.img
            ["df12e31426a944469a763b36e264fde2"] = {"918eee0db98e4c1ba39030cf029f94c1", "731cc3a78a4242759082970dd35457c0"}, -- 분노한 뿔버섯 / mob/2300101.img
            ["8941cb581adb4d70b49ecfe7a2648efe"] = {"10038a014c684fe88bc8550a8b60ecf8", ""}, -- 스톤골렘 / mob/5130101.img
            ["3faa2c0a65754f14b4de57c76bffde8b"] = {"ea4285f9a1ce43bf94d504b1bd1daa4b", "a7b34f58947943c588380258e282c467"}, -- 아이스 믹스골렘 / mob/5150002.img
            ["803ef7a19f244dd39737cdf15960c733"] = {"2d7d750260204873bd8e0f1f8d6c946b", "5f543a3840b04e08a701a9957f02cd09"}, -- 다크 스톤골렘 / mob/5130102.img
            ["c2a3c3ba031440c9bb41884706d71ebc"] = {"5801bccf76ff4842a511e75fb4959460", "fe5f3e390dd649588a011466cadd9d64"}, -- 파이어 믹스골렘 / mob/5150003.img
            ["90ae76c7837d48bbbbfa6704520425d0"] = {"2965518287be4e528f7a3e46ed13ca85", "cc0c897de50243b4918e26338ff7ce51"}, -- 믹스골렘 / mob/5150000.img
            ["1ed0265245594bf0904ceb88ecaf16ba"] = {"64efffa44609420ab59e4f0dd9a6d9ef", "d90855a724004b4f8a6f7a3753b90e8b"}, -- 페어리 / mob/3000001.img
            ["7765add816404731a1b9cf615ecab042"] = {"0230435a9ffb45c382b1c5fb8acc12c2", "a18ad389cdbc4e53aebf55c12e35ea28"}, -- 버블링 / mob/1210103.img
            ["4b3afc87ca3e49b0aba5c21de8fe3fca"] = {"e2bee88b9f8a4a4caca5287165424af3", "2078190a014e4509a2cc1ae4ee411c13"}, -- 로얄 페어리 / mob/3000007.img
            ["4e03ed5336034bc793eb287e875ee5c0"] = {"ba58289ca17a4b469673f6be1adda40d", "1b56d2ac97464de7bbefa792366ec1e5"}, -- 이블아이 / mob/2230100.img
            ["2166e8eff2fc4321a276c816a69871b3"] = {"bd517ccd5d074dfa988b9615088c2d19", "cd02ae7dfd5d423cba5bd0d1a00e6cb5"}, -- 커즈아이 / mob/3230100.img
            ["aa79081a0ddb47fa99c686c72ad6913d"] = {"5b164a884dc74a20b4288233ec97d316", "47a46f3e2e8d44638f2d00eaf82b7fee"}, -- 서전아이 / mob/2230113.img
            ["ed3908e24d694bb786023fc1ed073489"] = {"0d7e09281e0047318ba7832299328f77", "0eddcb1bca304e7197cf1449dcedf463"}, -- 다크 스텀프 / mob/1110101.img
            ["c7c3133cbaeb45fc913c8d6638096b9d"] = {"bcc1777320e547d092985fea3ebff559", "21d2706d79c04c8e97a65bb4cebb9006"}, -- 엑스텀프 / mob/1130100.img
            ["4d6afe038613457c84a8b4e2525a12e0"] = {"288954a3875748fcbd2ea0063bafd1d7", "0182687638eb42cf9802ea29a2026b27"}, -- 다크 엑스텀프 / mob/2130100.img
            ["af64c62c1dcf427998c3c52f0a060fec"] = {"99a644b128b347e892a23011eca61cde", "d0dc707313934804b4c2c50942154382"}, -- 와일드보어 / mob/2230102.img
            ["84a47945d8734a8a9e9317eaed427ca9"] = {"b5794d2885614ef4bc482ea6ea1ee75b", "f2dfb743f9f84037a74c904bc9ba34a0"}, -- 아이언 호그 / mob/4090000.img
            ["52fc9a75b6174bfa96af66c49dbb3369"] = {"fc9be19cb20c4804b9dca70a7de140d9", "c450be552dba47c88cf1e55ca1e7f109"}, -- 고스텀프 / mob/1140100.img
            ["4286356e1f6a4c03a6ef125123a49bbe"] = {"216d4e07d636406e8343aa90861f3363", "fd7ea34f2ea14e5bb14e440292abfa85"}, -- 히죽대는 고스텀프 / mob/1140130.img
            ["d8f014043ce8418f96700c2b6c9ebf6c"] = {"590b667674334ad1aa86eb17e509fbdd", "5deff8b7062042b0a0f87da58c43fba5"}, -- 옥토퍼스 / mob/1120100.img
            ["d8316fab961249cd9e1740c7fe5b3632"] = {"f60e21e0f80a4f14845514ea1e4dbdd5", "277360414e3b42ed86a6c12f36cd7d8e"}, -- 겁먹은 와일드보어 / mob/2230112.img
            ["e6c2fd7213d44cd3a5dd5eed2e8fb1ce"] = {"576159ab8c50436684aabce36a4ea8ff", "eaec67e7c7ea4f59a580476e170a614f"}, -- 아이언 보어 / mob/4230400.img
            ["48c10437ae8344a9b2a1d3f36185728f"] = {"fe85652078c143c69255af4edddad33a", "53e057d84eb143e4a2cf517b7ccc52d7"}, -- 주니어 네키 / mob/2130103.img
            ["ea1cb448952a4e469b3ee39946a7617a"] = {"5ac7f36bb57a47ae98c43b25c3697692", "d0f86660ef254fb3b8ccf71d943d1699"}, -- 리게이터 / mob/3110100.img
            ["c6b23cd8cb044b2181e4466e86052704"] = {"1037731cc0034d2f897a80a6abd38aca", "8a24e94aee1742308a6bf3faf87db144"}, -- 크로코 / mob/5130103.img
            ["17b55730c26f4fd6b8fcfa288da388de"] = {"0f213b255ab34a0e8ed258c89f3b62fe", "30e5a789e9204111924cafc1bc1ce33f"}, -- 달팽이 / mob/0100100.img
            ["096e9a374aa74156976f83f25a3f49b4"] = {"f8705d174c7f4d3da3abb1f7658fa9c9", "2993f17999f94c44a3862d1b6594fde5"}, -- 늪진흙괴물 / mob/2230114.img
            ["1d71a3b269544d85a94f38feecdd2b89"] = {"d372ec233f8f4628b633092a2c81d473", "7dfabece349c4f7482bea41ab7af7acb"}, -- 짜증내는 좀비버섯 / mob/2230131.img
            }
            local key = ""
            local animation = self.Entity.StateAnimationComponent
            if isvalid(animation) then key = animation.ActionSheet["stand"] or "" end
            if key == "" and isvalid(self.Entity.SpriteRendererComponent) then
                key = self.Entity.SpriteRendererComponent.SpriteRUID
            end
            self._T.monsterSoundProfile = profiles[key] or {"", ""}
            if profiles[key] == nil then
                log_warning("[MonsterSound] unmapped " .. self.Entity.Name .. " clip=" .. key)
            end
        end
        if isDeath then return self._T.monsterSoundProfile[2] end
        return self._T.monsterSoundProfile[1]
    end

    @ExecSpace("Multicast")
    method void PlayHitSound()
        -- 모든 관전자에게 이 몬스터의 피격음을 재생한다. 공용 임의 효과음으로 대체하지 않는다.
        if not self:IsClient() then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMap ~= self.Entity.CurrentMap then return end
        local ruid = self:ResolveMonsterSound(false)
        if ruid == "" then return end
        _GameAudio:PlaySound(ruid, 1.0)
        if not self._T.hitSoundVerified then
            self._T.hitSoundVerified = true
            log("[MonsterSound] hit " .. self.Entity.Name .. " ruid=" .. ruid)
        end
    end

    @ExecSpace("Multicast")
    method void PlayDeathSound()
        -- 실제 Dead() 진입 때만 1회 전파한다. 맵 입장이나 IsDead 동기화로 사망음을 다시 재생하지 않는다.
        if not self:IsClient() then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMap ~= self.Entity.CurrentMap then return end
        local ruid = self:ResolveMonsterSound(true)
        if ruid == "" then return end
        _GameAudio:PlaySound(ruid, 1.0)
        if not self._T.deathSoundVerified then
            self._T.deathSoundVerified = true
            log("[MonsterSound] die " .. self.Entity.Name .. " ruid=" .. ruid)
        end
    end

    -- (표창 재고) 이 몬스터를 마지막으로 때린 플레이어 엔티티를 기억한다.
    -- ⚠ 투사체 공격의 AttackerEntity는 **투사체 엔티티**다 - 표창(럭키세븐/트리플/쿼드러플/아대
    --   기본공격)과 어벤져는 판정 컴포넌트가 시전자(OwnerEntity)를 들고 있어 그걸로 되짚는다.
    --   그 외 투사체는 주인을 못 찾으면 그냥 기록하지 않는다(보충 없음 - 오지급보다 낫다).
    -- (요청 2026-08-09) **맞은 몬스터만, 그것도 10초 동안만 쫓아온다. 그 외에는 혼자 배회한다.**
    -- AIChaseComponent.IsChaseNearPlayer가 true면 사거리 안의 플레이어를 무조건 자동 추적한다 -
    -- 지나가기만 해도 무리 전체가 따라붙어 정신없다는 신고.
    -- ⚠ 실측(2026-08-09): 이 맵의 몬스터 105마리는 **AIChase 28 / AIWander 77로 상호 배타적**이다
    --   (둘 다 가진 개체 0). 그래서 추적만 꺼두면 AIChase 몬스터는 배회 수단이 없어 제자리에 굳는다 -
    --   런타임으로 AIWanderComponent를 붙여준다(AddComponent 후 정상 배회 실측 확인).
    -- ⚠ 두 AI를 동시에 켜면 서로 이동을 다투므로 **항상 정확히 하나만** 켠다.

    @ExecSpace("ServerOnly")
    method void EnsureWanderAI()
        -- 추적형도 하나의 BT 안에서 배회한다. 두 네이티브 AI를 동시에 붙이지 않는다.
        local ai = self.Entity.AIChaseComponent
        if self.NeverDie or not isvalid(ai) or self._T.fieldPatrolReady then return end
        if ai.BehaviourTreeId ~= "" then return end
        local movement = self.Entity.MovementComponent
        local body = self.Entity.RigidbodyComponent
        if not isvalid(movement) or not isvalid(body) then return end
        self._T.fieldPatrolReady = true
        self._T.patrolDirection = _UtilLogic:RandomDouble() < 0.5 and -1 or 1
        self._T.patrolRemaining = 2 + _UtilLogic:RandomDouble() * 2
        self._T.patrolResting = false
        self._T.patrolTarget = nil
        ai.IsChaseNearPlayer = false
        local root = ai:CreateLeafNode("FieldPatrolAndAggro", function(delta)
            self:TickFieldPatrol(delta)
            return BehaviourTreeStatus.Running
        end)
        ai:SetRootNode(root)
        ai.Enable = true
        log("[MonsterPatrol] single-tree patrol ready " .. self.Entity.Name)
    end

    @ExecSpace("ServerOnly")
    method void TickFieldPatrol(number delta)
        -- AI 트리만 이동을 소유하며 피격·빙결·사망 중의 모션을 덮어쓰지 않는다.
        local movement = self.Entity.MovementComponent
        local body = self.Entity.RigidbodyComponent
        local state = self.Entity.StateComponent
        if not isvalid(movement) or not isvalid(body) or not isvalid(state) then return end
        if self.IsDead or self.Hp <= 0 or not movement.Enable or not body.Enable then return end
        if state.CurrentStateName == "HIT" or state.CurrentStateName == "DEAD" then
            movement:Stop()
            return
        end
        if self.Stationary then
            movement:Stop()
            if state.CurrentStateName ~= "IDLE" then state:ChangeState("IDLE") end
            return
        end
        local position = self.Entity.TransformComponent.WorldPosition
        local target = self._T.patrolTarget
        local direction = self._T.patrolDirection or 1
        local chasing = isvalid(target) and target.CurrentMap == self.Entity.CurrentMap
        if chasing and isvalid(target.PlayerComponent) and target.PlayerComponent:IsDead() then chasing = false end
        if chasing then
            local targetPos = target.TransformComponent.WorldPosition
            local detection = self.Entity.AIChaseComponent.DetectionRange
            if math.abs(targetPos.x - position.x) > detection or math.abs(targetPos.y - position.y) > 2.5 then
                direction = 0
            elseif math.abs(targetPos.x - position.x) < 0.25 then
                direction = 0
            else
                direction = targetPos.x > position.x and 1 or -1
            end
        else
            self._T.patrolRemaining = (self._T.patrolRemaining or 0) - delta
            if self._T.patrolRemaining <= 0 then
                self._T.patrolResting = not self._T.patrolResting
                self._T.patrolRemaining = self._T.patrolResting and (0.6 + _UtilLogic:RandomDouble()) or (2 + _UtilLogic:RandomDouble() * 2)
                if not self._T.patrolResting then
                    direction = _UtilLogic:RandomDouble() < 0.5 and -1 or 1
                    self._T.patrolDirection = direction
                end
            end
            if self._T.patrolResting then direction = 0 end
            if direction ~= 0 and math.abs(position.x - self.SpawnX) > 4 then
                direction = position.x > self.SpawnX and -1 or 1
                self._T.patrolDirection = direction
            end
        end
        -- 네이티브 반환값 true는 해당 거리까지 걸을 수 있다는 뜻이다.
        -- 비행형은 발판이 없어도 이동하므로 지상용 가장자리 검사를 생략한다.
        if direction ~= 0 and not body.KinematicMove and body:IsOnGround() and not body:PredictFootholdEnd(0.2, direction > 0) then
            if chasing then
                direction = 0
            else
                direction = -direction
                if not body:PredictFootholdEnd(0.2, direction > 0) then direction = 0 end
                if direction ~= 0 then self._T.patrolDirection = direction end
            end
        end
        if direction == 0 then
            movement:Stop()
            if state.CurrentStateName ~= "IDLE" then state:ChangeState("IDLE") end
        else
            local scale = self.Entity.TransformComponent.Scale
            self.Entity.TransformComponent.Scale = Vector3(math.abs(scale.x) * -direction, scale.y, scale.z)
            movement:MoveToDirection(Vector2(direction, 0), 0)
            if state.CurrentStateName ~= "MOVE" then state:ChangeState("MOVE") end
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyAggroState(boolean aggro, Entity target)
        -- aggro=true면 target만 쫓고, false면 추적을 끄고 배회로 되돌린다.
        -- ⚠ SetTarget은 호출 시 IsChaseNearPlayer를 자동으로 끈다(엔진 사양) - 지정 대상만 쫓는다.
        local ai = self.Entity.AIChaseComponent
        local aw = self.Entity.AIWanderComponent
        if self._T.fieldPatrolReady and isvalid(ai) then
            self._T.patrolTarget = (aggro and isvalid(target)) and target or nil
            ai:SetTarget(self._T.patrolTarget)
            ai.IsChaseNearPlayer = false
            return
        end
        if aggro and isvalid(ai) and isvalid(target) then
            if isvalid(aw) and aw.Enable then aw.Enable = false end
            if not ai.Enable then ai.Enable = true end
            ai:SetTarget(target)
        else
            if isvalid(ai) then
                ai:SetTarget(nil)
                ai.IsChaseNearPlayer = false
                if ai.Enable then ai.Enable = false end
            end
            if isvalid(aw) and not aw.Enable then aw.Enable = true end
        end
    end

    @ExecSpace("ServerOnly")
    method void ScheduleAggroExpiry()
        -- 어그로 만료 감시. 맞을 때마다 타이머를 새로 걸면 타격 수만큼 타이머가 쌓이므로,
        -- **어그로가 시작될 때 한 번만** 걸고 만료 시점에 갱신 여부를 확인해 필요하면 다시 건다.
        local ent = self.Entity
        _TimerService:SetTimerOnce(function()
            if not isvalid(ent) then return end
            local remain = (self._T.aggroUntil or 0) - _UtilLogic.ServerElapsedSeconds
            if remain > 0.05 then
                -- 그 사이 또 맞아 연장됐다 - 남은 시간만큼 다시 건다.
                self:ScheduleAggroExpiry()
                return
            end
            self._T.aggroUntil = nil
            self:ApplyAggroState(false, nil)
        end, math.max(0.1, (self._T.aggroUntil or 0) - _UtilLogic.ServerElapsedSeconds + 0.05))
    end

    @ExecSpace("ServerOnly")
    method void RememberLastAttacker(Entity attacker)
        if not isvalid(attacker) then return end
        local owner = _BattleStatsManager:ResolveOwner(attacker)
        if owner == nil or not isvalid(owner) then return end
        if not isvalid(owner:GetComponent("script.PlayerAttack")) then return end
        self._T.lastKiller = owner
    end

	@ExecSpace("ServerOnly")
	method void ApplyIceDemonMark(Entity owner, integer skillLv)
		-- 표식은 마지막 적중부터 10초 동안 유효하다. 토큰으로 재적중 전 타이머가 새 표식을 지우지 않게 한다.
		if self.IsDead or not isvalid(owner) then return end
		self._T.iceDemonMarkOwner = owner
		self._T.iceDemonMarkLevel = math.max(0, math.min(skillLv, 30))
		self._T.iceDemonMarkExpiresAt = _UtilLogic.ServerElapsedSeconds + 10.0
		self._T.iceDemonMarkToken = (self._T.iceDemonMarkToken or 0) + 1
		local token = self._T.iceDemonMarkToken
		self:ShowIceDemonMark()
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or self.IsDead then return end
			if self._T.iceDemonMarkToken ~= token then return end
			self._T.iceDemonMarkOwner = nil
			self._T.iceDemonMarkLevel = nil
			self._T.iceDemonMarkExpiresAt = nil
		end, 10.0)
		log("[Monster] 아이스 데몬 표식 lv=" .. tostring(self._T.iceDemonMarkLevel))
	end

	method boolean HasIceDemonMarkFrom(Entity owner)
		-- 살아 있는 현재 개체에 같은 주인이 남긴 유효한 아이스 데몬 표식이 있는지 반환한다.
		return not self.IsDead and isvalid(owner) and self._T.iceDemonMarkOwner == owner
			and (self._T.iceDemonMarkLevel or 0) > 0
			and (_UtilLogic.ServerElapsedSeconds or 0) < (self._T.iceDemonMarkExpiresAt or 0)
	end

	@ExecSpace("ServerOnly")
	method void ApplyFireDemonMark(Entity owner, integer skillLv)
		if self.IsDead or not isvalid(owner) then return end
		self._T.fireDemonMarkOwner=owner self._T.fireDemonMarkLevel=math.max(0,math.min(skillLv,30))
		self._T.fireDemonMarkExpiresAt=_UtilLogic.ServerElapsedSeconds+5.0
		self._T.fireDemonMarkToken=(self._T.fireDemonMarkToken or 0)+1
		local token=self._T.fireDemonMarkToken self:ShowFireDemonMark()
		_TimerService:SetTimerOnce(function() if isvalid(self.Entity) and self._T.fireDemonMarkToken==token then self._T.fireDemonMarkOwner=nil self._T.fireDemonMarkLevel=nil self._T.fireDemonMarkExpiresAt=nil end end,5.0)
	end

	method boolean HasFireDemonMarkFrom(Entity owner)
		return not self.IsDead and isvalid(owner) and self._T.fireDemonMarkOwner==owner and (self._T.fireDemonMarkLevel or 0)>0 and (_UtilLogic.ServerElapsedSeconds or 0)<(self._T.fireDemonMarkExpiresAt or 0)
	end

	@ExecSpace("Multicast")
	method void ShowFireDemonMark()
		if not self:IsClient() then return end
		if self._T.fireDemonMarkEffect~=nil then _EffectService:RemoveEffect(self._T.fireDemonMarkEffect) end
		local serial=_EffectService:PlayEffectAttached("0e670196706243d9a482148499c7816f",self.Entity,Vector3(0,0.6,0),0,Vector3(0.3,0.3,0.3),true,{["Color"]=Color(1,0.15,0.05,1)})
		self._T.fireDemonMarkEffect=serial
		_TimerService:SetTimerOnce(function() if self._T.fireDemonMarkEffect==serial then _EffectService:RemoveEffect(serial) self._T.fireDemonMarkEffect=nil end end,5.0)
	end

	@ExecSpace("Multicast")
	method void ShowIceDemonMark()
		-- 반복 이펙트 serial을 반드시 제거해 사망·리젠 뒤 잔상이 남지 않게 한다.
		if not self:IsClient() then return end
		if self._T.iceDemonMarkEffect ~= nil then _EffectService:RemoveEffect(self._T.iceDemonMarkEffect) end
		local serial = _EffectService:PlayEffectAttached("0e670196706243d9a482148499c7816f", self.Entity, Vector3(0, 0.6, 0), 0, Vector3(0.3, 0.3, 0.3), true)
		self._T.iceDemonMarkEffect = serial
		_TimerService:SetTimerOnce(function()
			if self._T.iceDemonMarkEffect == serial then
				_EffectService:RemoveEffect(serial)
				self._T.iceDemonMarkEffect = nil
			end
		end, 10.0)
	end

	@ExecSpace("Multicast")
	method void ClearIceDemonMarkEffect()
		-- 사망/리젠 시 10초 타이머를 기다리지 않고 반복 표식 엔티티를 즉시 제거한다.
		if not self:IsClient() then return end
		if self._T.iceDemonMarkEffect ~= nil then
			_EffectService:RemoveEffect(self._T.iceDemonMarkEffect)
			self._T.iceDemonMarkEffect = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void Dead()
        if self.IsDead then return end
        self.IsDead = true
        self:PlayDeathSound()
        self.HealthBarUntil = 0
        -- (표창 재고) 처치 통보 - 모든 처치가 지나는 유일한 길목이라 여기 한 곳이면 충분하다.
        local killer = self._T.lastKiller
        if isvalid(killer) then
            ---@type PlayerAttack
            local kpa = killer:GetComponent("script.PlayerAttack")
            if isvalid(kpa) then kpa:OnMonsterKilled() end
        end
        -- (전투분석) 처치 귀속 - ReportHit이 기억해 둔 "마지막으로 때린 플레이어"에게 마릿수 +1
        _BattleStatsManager:ReportKill(self.Entity)
        self._T.lastKiller = nil
        self._T.pendingDeath = nil
        self._T.deathDeferUntil = nil
        self._T.reservedDamage = nil
        self._T.reservedUntil = nil
        self._T.incomingHits = nil
        self.IncomingHitDamage = 0
        self.IncomingHitExpires = 0
        self.LifeSerial = self.LifeSerial + 1
        local sc = self.Entity.StateComponent
        if isvalid(sc) then
            sc:ChangeState("DEAD")
        end
        log("Monster: Dead()")

		local deathPos = self.Entity.TransformComponent.WorldPosition
		local fireMarkOwner = self._T.fireDemonMarkOwner
		local fireMarkLevel = self._T.fireDemonMarkLevel or 0
		self._T.fireDemonMarkOwner=nil self._T.fireDemonMarkLevel=nil self._T.fireDemonMarkExpiresAt=nil self._T.fireDemonMarkToken=(self._T.fireDemonMarkToken or 0)+1
		local markOwner = self._T.iceDemonMarkOwner
		local markLevel = self._T.iceDemonMarkLevel or 0
		self._T.iceDemonMarkOwner = nil
		self._T.iceDemonMarkLevel = nil
		self._T.iceDemonMarkExpiresAt = nil
		self._T.iceDemonMarkToken = (self._T.iceDemonMarkToken or 0) + 1
		self:ClearIceDemonMarkEffect()
		if isvalid(markOwner) and markLevel > 0 then
			---@type PlayerAttack
			local markAttack = markOwner:GetComponent("script.PlayerAttack")
			if isvalid(markAttack) then markAttack:TrySummonIceDemonMinion(deathPos, markLevel) end
		end
		if isvalid(fireMarkOwner) and fireMarkLevel>0 then
			local pa=fireMarkOwner:GetComponent("script.PlayerAttack")
			if isvalid(pa) then pa:TrySummonFireDemonMinion(deathPos,fireMarkLevel) end
		end
        _MonsterDropRules:Drop(self.Entity, killer, self.NameTagLevel > 0 and self.NameTagLevel or self.MonsterLevel)

        local entity = self.Entity
        local me = self
        _TimerService:SetTimerOnce(function()
            if not isvalid(entity) then return end
            entity.Enable = false
            entity.Visible = false
            if me.GroupRespawn then
                -- 배치 리젠: MonsterZoneRespawn Logic이 일괄 처리
            elseif me.RespawnOn then
                _TimerService:SetTimerOnce(function()
                    if isvalid(entity) then
                        me:Respawn()
                    end
                end, me.RespawnDelay)
            else
                _EntityService:Destroy(entity)
            end
        end, self.DestroyDelay)
    end

    @ExecSpace("ServerOnly")
    method void Respawn()
		-- 재사용되는 동일 몬스터 엔티티에 이전 생명의 아이스 데몬 표식이 남지 않게 먼저 정리한다.
		self._T.iceDemonMarkOwner = nil
		self._T.iceDemonMarkLevel = nil
		self._T.iceDemonMarkExpiresAt = nil
		self._T.iceDemonMarkToken = (self._T.iceDemonMarkToken or 0) + 1
		self._T.fireDemonMarkOwner=nil self._T.fireDemonMarkLevel=nil self._T.fireDemonMarkExpiresAt=nil self._T.fireDemonMarkToken=(self._T.fireDemonMarkToken or 0)+1
		self:ClearIceDemonMarkEffect()
        self.IsDead = false
        self.HealthBarUntil = 0
        self.Hp = self.MaxHp
        self._T.pendingDeath = nil
        self._T.deathDeferUntil = nil
        self._T.reservedDamage = nil
        self._T.reservedUntil = nil
        self._T.incomingHits = nil
        self.IncomingHitDamage = 0
        self.IncomingHitExpires = 0
        self.LifeSerial = self.LifeSerial + 1
        -- (요청 2026-08-09) 리젠하면 원한도 초기화 - 다시 맞기 전까지는 아무도 쫓지 않고 배회한다.
        self._T.lastKiller = nil
        self._T.aggroUntil = nil
        self:EnsureWanderAI()
        self:ApplyAggroState(false, nil)
        self.Entity.Enable = true
        self.Entity.Visible = true
        -- (버그 수정) 최초 배치 위치로 되돌린다. Body가 붙어 있으면 TransformComponent.Position 대입은
        -- 물리 엔진이 다음 프레임에 덮어쓰므로, Body의 순간이동 API(SetWorldPosition)를 써야 한다.
        -- 엔티티를 다시 켠 뒤 한 번만 호출한다(짧은 간격 반복 호출은 몇 초 뒤 원위치로 되돌아가는 실측 버그가 있다).
        if self._T.spawnX ~= nil then
            local rb = self.Entity.RigidbodyComponent
            if isvalid(rb) then
                rb:SetWorldPosition(Vector2(self._T.spawnX, self._T.spawnY))
            else
                self.Entity.TransformComponent.WorldPosition = Vector3(self._T.spawnX, self._T.spawnY, 0)
            end
        end
        local sc = self.Entity.StateComponent
        if isvalid(sc) then
            sc:ChangeState("IDLE")
        end
        -- (버그 수정) 차지 블로우 빙결/화상으로 스프라이트가 물들거나 정지(PlayRate=0)된 채로 죽으면
        -- 그 상태가 리스폰까지 따라 나온다. 살아날 때 렌더 상태를 항상 기본값으로 초기화한다.
        self:ResetTint()
        log("Monster: Respawn(), Hp=" .. tostring(self.Hp) .. " pos=" .. tostring(self._T.spawnX) .. "," .. tostring(self._T.spawnY))
    end

    @ExecSpace("ClientOnly")
    method void HideHealthBar()
        -- 몬스터 본체는 유지하고 이 클라이언트의 HP바만 숨긴다.
        local bar = self._T.healthBar
        if isvalid(bar) then bar.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void PaintHealthBar()
        -- HP가 바뀔 때만 흰 테두리, 검정 여백, 왼쪽부터 차는 게이지를 다시 그린다.
        local bar = self._T.healthBar
        if not isvalid(bar) then return end
        local pixel = bar.PixelRendererComponent
        if not isvalid(pixel) then return end
        local ratio = 0
        if self.MaxHp > 0 then ratio = math.max(0, math.min(1, self.Hp / self.MaxHp)) end
        local fill = math.floor(46 * ratio)
        if ratio > 0 then fill = math.max(1, fill) end
        local color = Color(0.3, 0.95, 0.1, 1)
        if ratio <= 0.1 then
            color = Color(1, 0.12, 0.08, 1)
        elseif ratio < 0.5 then
            color = Color(1, 0.55, 0.05, 1)
        end
        local black = Color(0, 0, 0, 1)
        local white = Color(1, 1, 1, 1)
        local pixels = {}
        for y = 1, 9 do
            for x = 1, 52 do
                local c = black
                if x >= 2 and x <= 51 and y >= 2 and y <= 8
                    and (x == 2 or x == 51 or y == 2 or y == 8) then
                    c = white
                elseif y >= 4 and y <= 6 and x >= 4 and x < 4 + fill then
                    c = color
                end
                pixels[#pixels + 1] = c
            end
        end
        pixel:SetPixels(pixels)
        self._T.healthBarDirty = false
        self._T.healthBarHp = self.Hp
        self._T.healthBarMaxHp = self.MaxHp
    end

    @ExecSpace("ClientOnly")
    method void SyncFieldAnimation()
        -- 일부 필드 모델은 AnimationClipEvent의 이름만 받고 실제 SpriteRUID를 바꾸지 않는다.
        -- 현재 상태를 처음 볼 때와 상태 전환 때만 실제 클립을 연결해 늦은 맵 입장도 처리한다.
        if self.NeverDie then return end
        if not isvalid(self.Entity.AIChaseComponent) and not isvalid(self.Entity.AIWanderComponent) then return end
        local sprite = self.Entity.SpriteRendererComponent
        local animation = self.Entity.StateAnimationComponent
        local state = self.Entity.StateComponent
        if not isvalid(sprite) or not isvalid(animation) or not isvalid(state) then return end
        if not sprite.Enable or not animation.Enable then
            self._T.fieldAnimationState = nil
            return
        end
        local stateName = state.CurrentStateName
        if self._T.fieldAnimationState == stateName and self._T.fieldAnimationRenderer == sprite then return end
        local key = animation:StateStringToAnimationKey(stateName)
        local ruid = animation.ActionSheet[key]
        if ruid == nil or ruid == "" then return end
        if sprite.StartFrameIndex == 0 and sprite.EndFrameIndex == 0 then sprite.EndFrameIndex = 2147483647 end
        sprite.SpriteRUID = ruid
        if self._T.fieldAnimationRenderer == nil then
            log("[MonsterAnimation] state clip connected " .. self.Entity.Name .. " state=" .. stateName)
        end
        self._T.fieldAnimationState = stateName
        self._T.fieldAnimationRenderer = sprite
        -- 빙결·히트스톱이 소유하는 PlayRate와 커스텀 스킬의 프레임 범위는 변경하지 않는다.
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 클라이언트 기본 스포너도 비활성화하여 MISS와 0이 겹치지 않게 한다.
        local spawner = self.Entity.DamageSkinSpawnerComponent
        if isvalid(spawner) and spawner.Enable then spawner.Enable = false end
        -- 서버가 승인한 마지막 플레이어 피격 시각을 기준으로 5초간 머리 위를 따라간다.
        self:SyncFieldAnimation()
        self:UpdateMonsterNameTag()
        self._T.nameTagColorElapsed = (self._T.nameTagColorElapsed or 0) + delta
        if self._T.nameTagColorElapsed >= 0.25 then
            self._T.nameTagColorElapsed = 0
            -- UIMyInfoManager가 현재 장비에서 환산해 갱신한 레벨을 재사용해 몬스터마다 장비를 재계산하지 않는다.
            self:UpdateMonsterNameTagColor(math.max(1, _UIMyInfoManager.DisplayLevel))
        end
        if self.IsDead or self.Hp <= 0 or self.HealthBarUntil <= _UtilLogic.ServerElapsedSeconds
            or not self.Entity.VisibleInHierarchy then
            self:HideHealthBar()
            return
        end
        local bar = self._T.healthBar
        if not isvalid(bar) then
            if (self._T.healthBarRetryAt or 0) > _UtilLogic.ElapsedSeconds then return end
            self._T.healthBarRetryAt = _UtilLogic.ElapsedSeconds + 1
            local currentMap = self.Entity.CurrentMap
            if not isvalid(currentMap) then return end
            bar = _SpawnService:SpawnByModelId("monsterhealthbar", "HP_" .. self.Entity.Id, Vector3(0, 0, 0), currentMap)
            if not isvalid(bar) then return end
            self._T.healthBar = bar
            bar.PixelRendererComponent.SortingLayer = self:GetMonsterOverlayLayer()
            bar.PixelRendererComponent.OrderInLayer = 32766
            bar.PixelRendererComponent:ResetWithColor(52, 9, Color(0, 0, 0, 0))
            self._T.healthBarDirty = true
            log("[MonsterHPBar] created " .. self.Entity.Name)
        end
        local pos = self.Entity.TransformComponent.WorldPosition
        local height = self.HealthBarOffsetY
        if height <= 0 then
            height = 1.2
            local hit = self.Entity.HitComponent
            if isvalid(hit) then
                local halfHeight = hit.BoxSize.y * 0.5
                if hit.ColliderType == ColliderType.Circle then halfHeight = hit.CircleRadius end
                local offset = hit.ColliderOffset
                if hit.IsLegacy then offset = hit.BoxOffset end
                height = math.max(0.5, (offset.y + halfHeight) * math.abs(self.Entity.TransformComponent.Scale.y) + 0.25)
            end
        end
        bar.TransformComponent.WorldPosition = Vector3(pos.x, pos.y + height, pos.z - 0.01)
        if self._T.healthBarDirty or self._T.healthBarHp ~= self.Hp or self._T.healthBarMaxHp ~= self.MaxHp then
            self:PaintHealthBar()
        end
        bar.Enable = true
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 맵 이탈이나 몬스터 제거 시 클라이언트 전용 HP바를 정리한다.
        if isvalid(self._T.nameTag) then self._T.nameTag:Destroy() end
        self._T.nameTag = nil
        if isvalid(self._T.healthBar) then self._T.healthBar:Destroy() end
        self._T.healthBar = nil
    end

    @ExecSpace("Multicast")
    method void ResetTint()
        -- 상태이상 연출(색 틴트 / 애니메이션 정지)을 원상복구한다. 어떤 스킬이 걸어놨든 무관하게 동작하도록
        -- 상태이상 쪽이 아니라 몬스터 본인의 부활 시점에서 한 번 더 확실히 되돌린다.
        if not self:IsClient() then return end
        local spr = self.Entity.SpriteRendererComponent
        if not isvalid(spr) then return end
        spr.Color = Color(1, 1, 1, spr.Color.a)
        spr.PlayRate = 1
    end

end
