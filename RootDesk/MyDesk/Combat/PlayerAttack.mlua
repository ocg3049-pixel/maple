	-- ── 드래곤 라이딩(3차) ────────────────────────────────────────────────
	-- 5분간 드래곤 소환수(RidingDragon)를 소환하고, 소환 중 재시전하면 그 드래곤에 탑승한다.
	-- 소환/탑승 판단과 쿨타임/버프 UI는 SkillManager(클라)가 담당하고, 여기서는 스폰/데미지/연출만 맡는다.

	@ExecSpace("ServerOnly")
	method void SummonRidingDragon(number combatPower)
		-- 드래곤 라이딩 소환: spearburstfadingeffect 모델(Sprite+Transform)을 **맵의 자식**으로
		-- 스폰한 뒤 script.RidingDragon을 붙인다(별도 모델 불필요).
		-- ⚠ 플레이어의 자식으로 두면 텔레포트로 주인이 워프할 때 드래곤도 같이 순간이동해 버린다.
		-- (탑승 중에는 클라가 매 프레임 플레이어 위치로 스냅하므로 탈것답게 그대로 따라붙는다.)
		self._T.pendingRidingDragonCombatPower = combatPower
		-- 이미 소환된 드래곤이 남아 있으면 정리한다(중복 소환 방지).
		local old = self._T.ridingDragonEntity
		if isvalid(old) then old:Destroy() end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_warning("[RidingDragon] 소환 실패 - CurrentMap 없음")
			return
		end
		self._T.ridingDragonSeq = (self._T.ridingDragonSeq or 0) + 1
		local myPos = self.Entity.TransformComponent.WorldPosition
		local rSpawn = Vector3(myPos.x, myPos.y + 1.0, 0)
		local dragon = _SpawnService:SpawnByModelId("spearburstfadingeffect", "RidingDragon" .. tostring(self._T.ridingDragonSeq), rSpawn, map)
		if not isvalid(dragon) then
			log_warning("[RidingDragon] 소환 실패(spawn nil)")
			return
		end
		dragon:AddComponent("script.RidingDragon")
		---@type RidingDragon
		local comp = dragon:GetComponent("script.RidingDragon")
		if isvalid(comp) then
			comp.OwnerEntity = self.Entity
			comp.Lifetime = 300
		end
		self._T.ridingDragonEntity = dragon
		self._T.ridingDragonMounted = false
		self:PlayRidingDragonSummonEffect(self.Entity)
		log("[RidingDragon] 소환 완료 seq=" .. tostring(self._T.ridingDragonSeq) .. " combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("ServerOnly")
	method void SetRidingDragonMount(boolean active)
		-- 탑승/하차 상태를 소환수에 전달한다(@Sync라 각 클라의 RidingDragon.OnUpdate가 즉시 반영).
		-- 탑승은 곧바로 Riding을 켜지 않고 "제자리 워프 연출"을 거친다(BeginMountWarp - 요청 연출).
		local dragon = self._T.ridingDragonEntity
		if not isvalid(dragon) then
			log_warning("[RidingDragon] 탑승 전환 실패 - 소환된 드래곤 없음")
			return
		end
		---@type RidingDragon
		local comp = dragon:GetComponent("script.RidingDragon")
		if isvalid(comp) then
			if active then
				comp:BeginMountWarp()
			else
				comp.Warping = false
				comp.Riding = false
			end
		end
		self._T.ridingDragonMounted = active
		-- (요청) 탑승 중에는 이동해도 걷기 모션으로 넘어가면 안 된다. 아바타 상태→바디모션 매핑 자체를
		-- 전부 sit으로 바꿔버리면(IDLE/MOVE/JUMP/FALL/CROUCH) 컨트롤러가 상태를 어떻게 바꾸든 sit이 나온다.
		-- StateToAvatarBodyActionSheet는 @Sync라 반드시 서버에서 고쳐야 모든 클라에 반영된다.
		self:SetRidingAvatarSheet(active)
		log("[RidingDragon] 탑승 상태 = " .. tostring(active))
	end

	@ExecSpace("ServerOnly")
	method void SetRidingAvatarSheet(boolean riding)
		-- 탑승 중에는 "하차할 때까지" 절대 sit이 풀리면 안 된다(요청). 그래서 DEAD를 뺀 모든 상태 키를
		-- sit으로 덮어쓴다 - 이동(MOVE)뿐 아니라 점프/낙하/웅크리기/사다리/로프/피격(HIT)/공격(ATTACK)까지
		-- 전부 포함해야, 날다가 몬스터에게 맞거나 Ctrl을 눌러도 자세가 안 풀린다.
		-- 복구는 하드코딩 기본값이 아니라 "탑승 직전 값을 그대로 백업했다가 되돌리는" 방식이라
		-- PlayRate(예: MOVE=1.68)나 프로젝트에서 커스터마이즈한 값이 있어도 정확히 원복된다.
		local asac = self.Entity.AvatarStateAnimationComponent
		if not isvalid(asac) then
			log_warning("[RidingDragon] AvatarStateAnimationComponent 없음 - sit 고정 불가")
			return
		end
		local sheet = asac.StateToAvatarBodyActionSheet
		local keys = { "IDLE", "MOVE", "JUMP", "FALL", "CROUCH", "CLIMB", "LADDER", "HIT", "ATTACK", "ATTACK_WAIT", "SIT" }
		if riding then
			-- 이미 백업이 있으면(중복 호출) 덮어쓰지 않는다 - sit으로 바뀐 값을 원본으로 저장해버리면 복구 불가.
			if self._T.ridingSheetBackup == nil then
				local backup = {}
				for _, k in ipairs(keys) do
					local e = sheet[k]
					if e ~= nil then
						backup[k] = { name = e.AvatarBodyActionStateName, rate = e.PlayRate }
					else
						backup[k] = false   -- 원래 없던 키 - 복구 시 제거한다
					end
				end
				self._T.ridingSheetBackup = backup
			end
			for _, k in ipairs(keys) do
				sheet[k] = AvatarBodyActionElement("sit", 1.0)
			end
		else
			local backup = self._T.ridingSheetBackup
			if backup ~= nil then
				for _, k in ipairs(keys) do
					local b = backup[k]
					if b == false then
						asac:RemoveActionSheet(k)
					elseif b ~= nil then
						sheet[k] = AvatarBodyActionElement(b.name, b.rate)
					end
				end
				self._T.ridingSheetBackup = nil
			end
		end
		log("[RidingDragon] 아바타 모션 시트 " .. (riding and "sit 고정(전 상태)" or "탑승 전 값으로 복구"))
	end

	@ExecSpace("ServerOnly")
	method void DealRidingDragonHit(Entity target)
		-- 드래곤 공격 1타: 단일 대상 포인터로 걸러 skill.ridingdragon(전투력 200~300%) 판정.
		if not isvalid(target) then return end
		self._T.ridingDragonCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.ridingdragon", target)
	end

	-- ── 홀리 매직쉘(4차 버프) ────────────────────────────────────────────
	-- 시전하면 **자신과 HP를 가진 아군 소환수 전원**에게 "10회 방어" 쉴드가 걸린다(개체마다 각각 10회).
	-- 실제 차단은 공격자 쪽 MonsterAttack.IsAttackTarget에서 각 개체의 쉴드를 소모해 처리한다
	-- (방어자 IsHitTarget은 이 프로젝트의 몬스터 공격 경로에서 호출되지 않는다 - 가드/패링과 같은 이유).
	-- 쉴드 성공 연출/남은 개수 표시는 각 개체가 담당한다(PlayerHit.PlayHolyShellBlockEffects 등).

	@ExecSpace("ServerOnly")
	method void CastHolyMagicShell(integer shieldCount)
		self:StopBreather()
		local granted = 0
		-- ① 시전자 본인
		---@type PlayerHit
		local hit = self.Entity.PlayerHit
		if isvalid(hit) then
			hit:GrantHolyShell(shieldCount)
			granted = granted + 1
		end
		-- ② HP를 가진 아군 소환수 전원(용사 / 힐러 / 용 6마리) - 내가 소환한 것만 대상으로 한다.
		local map = self.Entity.CurrentMap
		if isvalid(map) then
			---@type HeroSummon
			for _, c in ipairs(map:GetChildComponentsByTypeName("script.HeroSummon", true)) do
				if isvalid(c) and c.OwnerEntity == self.Entity and c.HeroHp > 0 then
					c:GrantHolyShell(shieldCount)
					granted = granted + 1
				end
			end
			---@type HealerSummon
			for _, c in ipairs(map:GetChildComponentsByTypeName("script.HealerSummon", true)) do
				if isvalid(c) and c.OwnerEntity == self.Entity and c.HealerHp > 0 then
					c:GrantHolyShell(shieldCount)
					granted = granted + 1
				end
			end
			---@type SummonDragon
			for _, c in ipairs(map:GetChildComponentsByTypeName("script.SummonDragon", true)) do
				if isvalid(c) and c.OwnerEntity == self.Entity and c.DragonHp > 0 then
					c:GrantHolyShell(shieldCount)
					granted = granted + 1
				end
			end
		end
		-- 시전 이펙트는 캐릭터가 바라보는 방향 앞쪽에 놓아야 해서 현재 방향을 함께 넘긴다.
		local ctrl = self.Entity.PlayerControllerComponent
		local dirX = 1
		if isvalid(ctrl) and ctrl.LookDirectionX < 0 then dirX = -1 end
		self:PlayHolyMagicShellCastFx(self.Entity, dirX)
		log("[HolyShell] 홀리 매직쉘 시전 - " .. tostring(granted) .. "개체에 각각 "
			.. tostring(shieldCount) .. "회 쉴드 부여")
	end

	@ExecSpace("Multicast")
	method void PlayHolyMagicShellCastFx(Entity attacker, number dirX)
		-- 시전 이펙트(요청 리소스 c9af8535 - 18프레임 클립)를 시전자 **바라보는 방향 앞쪽**에서 1회 재생.
		-- (피드백) 원본 클립은 왼쪽을 보는 기준으로 그려져 있어 그대로 두면 오른쪽을 볼 때 뒤에서 터진다 -
		--   FlipX로 좌우를 뒤집고 x 오프셋도 방향에 따라 부호를 뒤집는다.
		-- (피드백) "좀 더 캐릭터 몸쪽으로 당기고 아래로" - 앞쪽 오프셋 0.18, 높이 0.2 → -0.05.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local flip = (dirX > 0)
		local serial = _EffectService:PlayEffectAttached(
			"c9af85359e644b568c8ba555f642e367", attacker,
			Vector3(0.18 * dirX, -0.05, 0), 0, Vector3(1, 1, 1), false,
			{ ["OrderInLayer"] = 8, ["FlipX"] = flip }
		)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 3.0)
	end

	-- ── 드래곤 블러드(4차 버프) ──────────────────────────────────────────
	-- 10분 지속. 유지 비용으로 10초마다 최대 HP의 4%를 소모하고, 사용자의 HP가 최대 HP의 10% 이하로
	-- 떨어지면 자동으로 해제된다. 효과는 두 가지:
	--   ① 스탯창 공격력 +30 (클라 _CharInfoManager:ApplyAttackBuff - 분노/메디테이션과 같은 경로)
	--   ② 소환된 드래곤(용 소환 6마리 + 드래곤 라이딩)이 공격할 때마다 최대 HP의 3% 회복
	-- 연출(사용자 제공 원본 20프레임, RUID 표: msw-dev-tools/resources/드래곤블러드/RUID.md):
	--   시전  = 1~16번을 70ms 간격으로 재생 → 17번이 200ms 동안 커지면서 사라짐
	--   4% 소모 = 18~19번을 70ms 간격으로 재생 → 20번이 200ms 동안 커지면서 사라짐
	-- 프레임 x/y는 각 프레임의 WZ origin을 MakeOriginFrames 공식(dx=(W/2-ox)/100, dy=(oy-H/2)/100)으로
	-- 환산한 값이라 크기가 달라도 몸의 같은 지점에 붙는다.

	@ExecSpace("ServerOnly")
	method void AttackDragonBlood()
		-- 버프 시작(재시전하면 이전 것을 끄고 새로 건다 - 지속시간이 갱신된다).
		self:StopBreather()
		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) or pc:IsDead() then return end
		self._T.dragonBloodToken = (self._T.dragonBloodToken or 0) + 1
		local tok = self._T.dragonBloodToken
		if self._T.dragonBloodTimerId then
			_TimerService:ClearTimer(self._T.dragonBloodTimerId)
			self._T.dragonBloodTimerId = nil
		end
		self._T.dragonBloodActive = true
		self:PlayDragonBloodCastEffect()
		-- 유지 비용: 10초마다 최대 HP의 4% 소모(+ 소모 이펙트). 소모 후 10% 이하면 자동 해제.
		-- ⚠ SetTimerRepeat은 **즉시 1회 발동한다**(실측: 버프 발동 로그 직후 바로 첫 소모가 찍혔다).
		--   그 탓에 소모 이펙트(18~20번)가 시전 순간에 같이 터져 "사용 모션에 18~20이 섞인다"는
		--   신고를 받았다. SetTimerOnce 재예약 체인으로 바꿔 **첫 소모를 10초 뒤**로 미룬다.
		self:ScheduleDragonBloodDrain(tok)
		-- 10분 만료
		_TimerService:SetTimerOnce(function()
			if self._T.dragonBloodToken ~= tok then return end
			self:EndDragonBlood("지속시간 만료")
		end, 600.0)
		log("[DragonBlood] 발동 - 10분 지속, 10초마다 최대HP 4% 소모, 공격력 +30")
	end

	@ExecSpace("ServerOnly")
	method void ScheduleDragonBloodDrain(integer token)
		-- 10초 뒤 소모 1회 → 아직 버프가 살아있으면 다시 10초 예약(첫 발동이 즉시 나오지 않게 하는 체인).
		self._T.dragonBloodTimerId = _TimerService:SetTimerOnce(function()
			if self._T.dragonBloodToken ~= token then return end
			if not self._T.dragonBloodActive then return end
			self:DragonBloodDrainTick()
			if self._T.dragonBloodToken == token and self._T.dragonBloodActive then
				self:ScheduleDragonBloodDrain(token)
			end
		end, 10.0)
	end

	method number GetDragonBloodFacing()
		-- 시전자가 바라보는 방향(+1 오른쪽 / -1 왼쪽). 이펙트 x 보정에 쓴다.
		local ctrl = self.Entity.PlayerControllerComponent
		if isvalid(ctrl) and ctrl.LookDirectionX < 0 then return -1 end
		return 1
	end

	@ExecSpace("ServerOnly")
	method void DragonBloodDrainTick()
		-- 10초 주기 유지 비용. 소모 자체로 죽지는 않도록 최소 1은 남기고, 소모 뒤 HP가
		-- 최대 HP의 10% 이하면 버프를 자동 해제한다(요청 사양).
		if not self._T.dragonBloodActive then return end
		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) or pc:IsDead() then
			self:EndDragonBlood("사망")
			return
		end
		local cost = math.max(1, math.floor(pc.MaxHp * 0.04))
		pc.Hp = math.max(1, pc.Hp - cost)
		self:PlayDragonBloodDrainEffect()
		log("[DragonBlood] 유지 비용 -" .. tostring(cost) .. " → HP " .. tostring(math.floor(pc.Hp)) .. "/" .. tostring(math.floor(pc.MaxHp)))
		if pc.Hp <= pc.MaxHp * 0.10 then
			self:EndDragonBlood("HP 10% 이하")
		end
	end

	@ExecSpace("ServerOnly")
	method void EndDragonBlood(string reason)
		-- 버프 종료(만료/HP 10% 이하/사망/우클릭 취소 공용). 토큰을 올려 남은 타이머를 무효화한다.
		if not self._T.dragonBloodActive then return end
		self._T.dragonBloodActive = false
		self._T.dragonBloodToken = (self._T.dragonBloodToken or 0) + 1
		if self._T.dragonBloodTimerId then
			_TimerService:ClearTimer(self._T.dragonBloodTimerId)
			self._T.dragonBloodTimerId = nil
		end
		local pc = self.Entity.PlayerComponent
		if isvalid(pc) then
			self:NotifyDragonBloodEnded(pc.UserId)
		end
		log("[DragonBlood] 해제 - " .. tostring(reason))
	end

	@ExecSpace("ServerOnly")
	method void CancelDragonBloodBuff()
		-- 버프 아이콘 우클릭 취소.
		self:EndDragonBlood("우클릭 취소")
	end

	@ExecSpace("Client")
	method void NotifyDragonBloodEnded()
		-- 주인 클라이언트: 공격력 버프를 걷어내고 버프바 아이콘을 내린다.
		_CharInfoManager:CancelAttackBuff("dragonblood")
		_DragonBloodBuffUI:HideBuff()
	end

	@ExecSpace("ServerOnly")
	method void OnDragonAttackHeal()
		-- 소환된 드래곤(용 소환 6마리 / 드래곤 라이딩)이 한 번 공격할 때마다 호출된다.
		-- 드래곤 블러드가 켜져 있을 때만 최대 HP의 1%를 회복시킨다
		-- (요청 2026-07-28: 3% → 1%로 하향 - 용 6마리가 동시에 때리면 회복량이 과했다).
		if not self._T.dragonBloodActive then return end
		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) or pc:IsDead() then return end
		local amount = math.max(1, math.floor(pc.MaxHp * 0.01))
		local newHp = math.min(pc.Hp + amount, pc.MaxHp)
		local actual = math.floor(newHp - pc.Hp)
		if actual <= 0 then return end
		pc.Hp = newHp
		-- 회복량은 힐과 같은 파란 데미지 스킨으로 표시한다.
		self:ShowHealDamageSkin(self.Entity, actual)
	end

	-- ── 다크사이트(1차 버프) ──────────────────────────────────────────────
	-- 사양(요청 2026-07-30):
	--   · 시전 시 이펙트(c4442692) 1회 + 맵이 블리자드처럼 어두워짐 + 캐릭터 투명도 30%
	--   · 켜져 있는 동안 맵 BGM은 10%로 줄이고 다크사이트 전용 BGM(732c8aea)을 루프 재생
	--   · 이동속도 50%
	--   · 최대 지속 160초 / 쿨타임 10초
	--   · **공격 동작을 하면** 그 공격만 데미지 2배 + 무조건 크리티컬로 들어가고 곧바로 풀린다
	--     (2026-07-30 수정: 적중 여부와 무관 - 허공을 휘두르거나 빗나가도 풀린다)
	--   · 이미 켜져 있을 때 한 번 더 누르면 그냥 풀린다(시전이 아니므로 쿨타임을 새로 걸지 않는다)
	-- 역할 분담:
	--   · 데미지 2배 / 무조건 크리티컬 = 클라(SkillManager)가 전투력·크리확률을 두 배/100%로 넘겨주는
	--     방식(GetEffectiveCombatPower / GetEffectiveCritRate). 투사체 스킬까지 한 곳에서 덮인다.
	--   · "공격 동작" 판정도 클라다 - 기본공격 키 입력과 공격 스킬 시전(GetEffectiveCombatPower 호출)
	--     두 곳에서 BreakDarkSightByAttack → RequestBreakDarkSight로 서버에 알린다.
	--   · 여기(서버)는 상태 유지 · 이동속도 · 연출 · 해제 처리와 적중 기반 안전망(OnAttack)을 담당한다.

	@ExecSpace("ServerOnly")
	method void AttackDarkSight()
		-- 다크사이트 시작. 재시전 취소는 클라에서 먼저 거르므로 여기 오는 것은 항상 "새로 켜기"다.
		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) or pc:IsDead() then return end
		if self._T.darkSightActive then
			-- 방어적 처리: 어떤 이유로 이미 켜져 있으면 이전 것을 정리하고 새로 건다.
			self:EndDarkSight("재시전")
		end
		self._T.darkSightActive = true
		self._T.darkSightToken = (self._T.darkSightToken or 0) + 1
		local tok = self._T.darkSightToken

		-- 이동속도 50%. 되돌릴 기준값은 지금 값을 그대로 기억해둔다(헤이스트가 이미 걸려 있으면
		-- 그 올라간 값의 절반이 되고, 풀릴 때 그 값으로 돌아간다).
		local movement = self.Entity.MovementComponent
		if isvalid(movement) then
			self._T.darkSightBaseInputSpeed = movement.InputSpeed
			movement.InputSpeed = movement.InputSpeed * 0.5
		end

		self:PlayDarkSightBodyStart(self.Entity)
		self:PlayDarkSightOwnerStart(pc.UserId)

		-- 최대 지속 160초. 토큰으로 이전 예약을 무효화한다.
		_TimerService:SetTimerOnce(function()
			if self._T.darkSightToken ~= tok then return end
			self:EndDarkSight("지속시간 만료")
		end, 160.0)
		log("[DarkSight] 발동 - 최대 160초, 이동속도 50%, 공격 시 2배+크리티컬로 해제")
	end

	@ExecSpace("ServerOnly")
	method void EndDarkSight(string reason)
		-- 해제 공용 경로(공격 / 재사용 / 우클릭 취소 / 지속시간 만료 / 사망).
		if not self._T.darkSightActive then return end
		self._T.darkSightActive = false
		self._T.darkSightToken = (self._T.darkSightToken or 0) + 1

		-- 이동속도 원복. 해제 후 헤이스트 등이 다시 값을 잡아가도 되도록 기억해둔 값만 되돌린다.
		local movement = self.Entity.MovementComponent
		if isvalid(movement) and self._T.darkSightBaseInputSpeed ~= nil then
			movement.InputSpeed = self._T.darkSightBaseInputSpeed
			self._T.darkSightBaseInputSpeed = nil
		end

		-- (타이밍 보정) "공격으로 풀린 경우"에만, 그 한 번의 시전이 만드는 나머지 타격(더블스탭 2타 등)도
		-- 크리티컬로 들어가야 한다. 클라가 크리확률을 원래대로 되돌리는 RPC에는 왕복 지연이 있으므로,
		-- 해제 직후 1초는 서버가 직접 크리티컬을 보장한다(CalcCritical 참고).
		-- 재사용/우클릭/만료/사망으로 풀린 경우엔 이 유예를 주지 않는다(공짜 크리티컬 창이 되면 안 된다).
		if reason == "공격" then
			self._T.darkSightCritUntil = _UtilLogic.ElapsedSeconds + 1.0
			-- 같은 1초 동안은 전투력도 해제 직전 값(= 클라가 동기화해둔 2배)을 붙잡아 둔다.
			-- 기본공격처럼 동기화 값에 의존하는 판정이 "2배는 빠지고 크리티컬만 남는" 반쪽이 되지 않게 한다.
			self._T.darkSightCombatPowerHold = self._T.currentCombatPower
		else
			self._T.darkSightCombatPowerHold = nil
		end

		local pc = self.Entity.PlayerComponent
		self:PlayDarkSightBodyEnd(self.Entity)
		if isvalid(pc) then
			self:PlayDarkSightOwnerEnd(pc.UserId)
			self:NotifyDarkSightEnded(pc.UserId)
		end
		log("[DarkSight] 해제 - " .. tostring(reason))
	end

	@ExecSpace("ServerOnly")
	method void CancelDarkSightBuff()
		-- 스킬 재사용 / 버프 아이콘 우클릭 취소.
		self:EndDarkSight("재사용/우클릭 취소")
	end

	@ExecSpace("ServerOnly")
	method void BreakDarkSightByAttack()
		-- 공격 "동작"으로 해제(요청 2026-07-30 수정: 적중하지 않아도 휘두르기만 하면 풀린다).
		-- 클라(SkillManager.BreakDarkSightByAttack)가 기본공격 키 입력과 공격 스킬 시전에서 보내온다.
		-- 사유를 "공격"으로 넘겨 1초 크리티컬 유예를 열어둔다.
		self:EndDarkSight("공격")
	end

	method boolean IsDarkSightActive()
		-- 서버 상태 조회용. 몬스터 접촉 피해 무효화(MonsterAttack.IsAttackTarget)와 크리티컬 확정
		-- 판정이 이 값을 본다. ExecSpace 미지정 - 서버 히트 파이프라인에서만 불린다.
		return self._T.darkSightActive == true
	end

	@ExecSpace("Multicast")
	method void PlayDarkSightBodyStart(Entity attacker)
		-- 모든 클라이언트: 시전 이펙트 1회 + 캐릭터 투명도 30%(다른 사람 화면에서도 반투명해야 한다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		-- 아바타와 같은 SortingLayer에 올리고 OrderInLayer를 아바타(4)보다 작게 줘서
		-- "지형보다 앞, 캐릭터보다 뒤"에 깔린다(다른 시전 이펙트들과 동일한 레이어링).
		local backOption = { ["SortingLayer"] = "MapLayer0", ["OrderInLayer"] = 2 }
		-- y 오프셋 0.4 = "지면 퍼짐이 바닥에 걸치도록"(요청 2026-07-30).
		-- (0,0,0)은 발밑이지만 이 클립(map/obj/arc/direction/sand/1)은 프레임 중심으로 재생돼 아래 절반이
		-- 지면 밑으로 파묻혔다. 이펙트 없는 화면과의 픽셀 차분으로 실측하며 맞춘 값:
		--   0.0 → 밑동이 발밑보다 90px(≈0.64유닛) 아래 / 0.6 → 밑동이 발밑 선에 딱 붙지만 퍼짐이 떠 보임
		--   0.4 → 퍼짐이 바닥 풀·흙에 걸쳐 앉는다(채택). 더 올리려면 0.5, 더 내리려면 0.3.
		_EffectService:PlayEffectAttached("c4442692903d48f6aa3583ee83cfc521", attacker, Vector3(0, 0.4, 0), 0, Vector3(1, 1, 1), false, backOption)
		-- (버그 수정) "암살이 끝나자마자 다크사이트를 쓰면 투명해지지 않는다" - 암살 복귀 페이드
		-- (0.7→1.0, 0.3초)가 계속 알파를 덮어쓰고 있었기 때문. 아바타 알파를 건드리는 연출은
		-- 공용 세대 번호를 올려 **이전 연출의 알파 루프를 무효화**한 뒤 자기 값을 쓴다.
		self._T.avatarAlphaGen = (self._T.avatarAlphaGen or 0) + 1
		local avatarRenderer = attacker.AvatarRendererComponent
		if isvalid(avatarRenderer) then
			avatarRenderer:SetAlpha(0.3, nil)
		end
		log("[DarkSight] 시전 연출 재생 + 투명도 30%")
	end

	@ExecSpace("Multicast")
	method void PlayDarkSightBodyEnd(Entity attacker)
		-- 모든 클라이언트: 캐릭터 투명도 정상화.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		-- 다른 알파 연출(암살 복귀 페이드 등)이 뒤늦게 덮어쓰지 않도록 세대를 올린다.
		self._T.avatarAlphaGen = (self._T.avatarAlphaGen or 0) + 1
		local avatarRenderer = attacker.AvatarRendererComponent
		if isvalid(avatarRenderer) then
			avatarRenderer:SetAlpha(1, nil)
		end
		log("[DarkSight] 투명도 정상화")
	end

	@ExecSpace("Client")
	method void PlayDarkSightOwnerStart()
		-- 시전자 본인 클라이언트만: 화면 어두워짐(유지 모드) + 맵 BGM 10%로 줄이기 + 전용 BGM 루프.
		-- 다크사이트는 개인 상태라 다른 사람 화면/BGM까지 건드리면 안 되므로 Multicast가 아니다.
		if not self:IsClient() then return end
		-- 어두워짐 규격은 블리자드와 같다(페이드 1.5초 / 최대 알파 0.2 / 순수 검정) - "블리자드 때처럼"이라는 요청.
		_BlizzardScreenDim:StartHoldDim(1.5, 0.2, 0, 0, 0)
		_BlizzardBgmDucker:StartHoldDuck(1.5, 0.1)
		_SoundService:PlayLoopSound("732c8aeac0624d21bdcfc89bc6244105", 1.0)
		log("[DarkSight] 화면 어두워짐 + 전용 BGM 시작")
	end

	@ExecSpace("Client")
	method void PlayDarkSightOwnerEnd()
		-- 시전자 본인 클라이언트만: 서서히 밝아지고 맵 BGM으로 서서히 복귀한다.
		if not self:IsClient() then return end
		_SoundService:StopSound("732c8aeac0624d21bdcfc89bc6244105")
		-- (요청) 연막 안에서 다크사이트를 쓰고 풀렸을 때, 연막이 아직 남아 있으면 화면 효과를
		-- 연막 것으로 되돌린다. 두 스킬이 같은 "유지 모드" 오버레이 하나를 공유하기 때문에
		-- 그냥 EndHoldDim만 하면 연막이 남아 있는데도 화면이 말끔해진다.
		if self:IsSmokeScreenActive() then
			_BlizzardScreenDim:StartHoldDim(0.5, 0.55, 0.45, 0.45, 0.50)
			log("[DarkSight] 해제 - 연막이 아직 남아 있어 화면을 연막 효과로 되돌린다")
			return
		end
		_BlizzardScreenDim:EndHoldDim(2.0)
		_BlizzardBgmDucker:EndHoldDuck(2.5)
		log("[DarkSight] 화면 밝아짐 + 맵 BGM 복귀 시작")
	end

	@ExecSpace("Client")
	method void NotifyDarkSightEnded()
		-- 주인 클라이언트: 버프바 아이콘을 내리고 전투력/크리 보정을 원래대로 되돌린다.
		_SkillManager:OnDarkSightEnded()
	end

	@ExecSpace("ServerOnly")
	method void PlayDragonBloodCastEffect()
		-- 시전 연출: 1~16번을 70ms 간격으로 재생한 뒤, 17번을 200ms 동안 키우면서 페이드아웃한다
		-- ("스피어버스터 몸쪽 이펙트처럼 커지면서 사라진다" - 원본 영상 매칭).
		local ruids = {
			"17d4148acb0b4d67a1f3680778e9444b", "9e7588ff39d8486c912331b84020d583",
			"61f1012f9c6b403f90570c994088b26f", "f00e153032174ac496c58ac96ff14643",
			"a1c176033b9d4ecb9b4e774e954f5826", "fa0f0b8a618c4cabb1bd5d2a67cdde72",
			"6940317f79e641cba0379e42badeae1f", "ddb7f000fabe4ef4a73038965a146583",
			"7a7f27ef00d742ac8c0fb9060c37c60e", "f27543a0eb8e425c9e0725401b38ece7",
			"103919eff81f444e800c51b6737ecb9c", "113ef93caa1741d58a9deb555db0f582",
			"77da6025562145ff9b3bb5458371c6ba", "71f48142db364828b39e953dc63dcf50",
			"db8e4beca5bb4b9282433e5830449d42", "db260e0665cc44ce8f4261af3670c57a",
		}
		local xs = { 0.095, -0.04, -0.04, -0.025, -0.03, -0.035, -0.04, -0.04,
			-0.035, -0.035, -0.035, -0.04, -0.04, -0.04, -0.04, -0.04 }
		local ys = { 0.96, 0.32, 0.32, 0.31, 0.31, 0.305, 0.305, 0.30,
			0.305, 0.305, 0.305, 0.305, 0.305, 0.305, 0.305, 0.31 }
		-- (피드백) 왼쪽을 볼 때만 화면상 x를 0.05 왼쪽으로 당긴다(오른쪽을 볼 때는 그대로).
		-- ⚠ 두 이펙트의 x 적용 방향이 반대다: 프레임 이펙트는 화면 x = -(저장 x)라 저장값에서 빼야
		--   화면이 왼쪽으로 가고, 스피어버스터 페이딩은 넘긴 offset이 곧 화면 x라 그대로 더한다.
		local shift = 0
		if self:GetDragonBloodFacing() < 0 then shift = -0.05 end
		for i = 1, #xs do
			xs[i] = xs[i] - shift
		end
		local frames = self:MakeOriginFrames(ruids, xs, ys, 8)
		self:SpawnBuffFrameEffectEx(frames, 1, 0.07, 0, self.Entity, 1.0, 1.0, 1.0)
		-- 16프레임 × 70ms = 1.12초 뒤에 마지막 17번을 성장+페이드로 이어 붙인다.
		local lastX = -0.04 + shift
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			self:SpawnSpearBurstFadingEffectAt(
				"4bd903c41887458f9ccf1aa20aa46181", Vector2(lastX, 0.31), false,
				1.0, 1.6, 1.0, 0.0, 0.0, 0.2, 8, false, "", 0, 0, 0, 0, self.Entity
			)
		end, 1.12)
	end

	@ExecSpace("ServerOnly")
	method void PlayDragonBloodDrainEffect()
		-- HP를 4% 소모할 때마다: 18~19번을 70ms 간격으로 재생하고 20번을 200ms 동안 키우며 페이드아웃.
		local ruids = { "7984d07ac9d34320be87cf0744e37925", "e1d7aa4dedcc43cea11cfd879f216e3c" }
		local xs = { -0.055, -0.045 }
		local ys = { 0.325, 0.325 }
		-- (피드백) 오른쪽을 볼 때 이펙트가 등 뒤에서 터져 보인다 - 그때만 화면상 x를 0.05 오른쪽으로
		-- 민다(왼쪽을 볼 때는 그대로). 부호 규칙은 시전 이펙트 주석 참고(프레임 이펙트는 반대 부호).
		local shift = 0
		if self:GetDragonBloodFacing() > 0 then shift = 0.05 end
		for i = 1, #xs do
			xs[i] = xs[i] - shift
		end
		local frames = self:MakeOriginFrames(ruids, xs, ys, 8)
		self:SpawnBuffFrameEffectEx(frames, 1, 0.07, 0, self.Entity, 1.0, 1.0, 1.0)
		local lastX = -0.05 + shift
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			self:SpawnSpearBurstFadingEffectAt(
				"1f6dc4a446df4eaaa0fec17b455758b3", Vector2(lastX, 0.32), false,
				1.0, 1.6, 1.0, 0.0, 0.0, 0.2, 8, false, "", 0, 0, 0, 0, self.Entity
			)
		end, 0.14)
	end

	-- ── 용 소환(6마리) ───────────────────────────────────────────────────
	-- 한 번 시전하면 서로 다른 용 6마리가 동시에 소환된다. 비행/궤도/공격/HP는 script.SummonDragon이
	-- 담당하고, 여기서는 스폰·해제와 skill.summondragon 판정 파이프라인만 맡는다.

	@ExecSpace("ServerOnly")
	method void SummonSixDragons(number combatPower)
		-- 용 6마리를 맵의 자식으로 스폰한다(각자 DragonIndex 1~6). 기존 용이 남아 있으면 먼저 정리한다.
		self._T.pendingSummonDragonCombatPower = combatPower
		self:DismissSixDragons()
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_warning("[SummonDragon] 소환 실패 - CurrentMap 없음")
			return
		end
		local myPos = self.Entity.TransformComponent.WorldPosition
		-- 용 HP = 주인 최대 HP의 1/2(요청 스펙 - 2026-07-28 1/3에서 상향).
		local ownerMaxHp = 50
		if isvalid(self.Entity.PlayerComponent) then
			ownerMaxHp = self.Entity.PlayerComponent.MaxHp or 50
		end
		local dragonHp = math.max(1, math.floor(ownerMaxHp / 2))
		self._T.summonDragonSeq = (self._T.summonDragonSeq or 0) + 1
		local seq = self._T.summonDragonSeq
		local list = {}
		for i = 1, 6 do
			local idx = i
			-- 처음부터 궤도 위치 근처에 뜨도록 6방향으로 벌려 스폰한다.
			local ang = (idx - 1) * (math.pi * 2 / 6)
			local sx = myPos.x + math.cos(ang) * 2.4
			local sy = myPos.y + 1.0 + math.sin(ang) * 0.6
			local d = _SpawnService:SpawnByModelId("summondragon", "SummonDragon" .. tostring(seq) .. "_" .. tostring(idx), Vector3(sx, sy, 0), map)
			if isvalid(d) then
				d:AddComponent("script.SummonDragon")
				---@type SummonDragon
				local comp = d:GetComponent("script.SummonDragon")
				if isvalid(comp) then
					-- AddComponent 직후에는 프로퍼티 대입만(같은 프레임 메서드 호출은 LEA-2007 위험).
					comp.OwnerEntity = self.Entity
					comp.Lifetime = 600           -- 지속 10분(요청 스펙 - 2026-07-28 5분에서 상향)
					comp.DragonIndex = idx
					comp.DragonMaxHp = dragonHp
					comp.DragonHp = dragonHp
				end
				table.insert(list, d)
			else
				log_warning("[SummonDragon] " .. tostring(idx) .. "번 용 스폰 실패")
			end
		end
		self._T.summonDragonEntities = list
		log("[SummonDragon] 6마리 소환 완료 seq=" .. tostring(seq) .. " combatPower=" .. tostring(combatPower)
			.. " 용HP=" .. tostring(dragonHp) .. " 실제=" .. tostring(#list) .. "마리")
	end

	@ExecSpace("ServerOnly")
	method void DismissSixDragons()
		-- 소환된 용을 전부 제거한다(재소환 교체 / 버프 아이콘 우클릭 취소 공용).
		local list = self._T.summonDragonEntities or {}
		local removed = 0
		for _, d in ipairs(list) do
			if isvalid(d) then
				d:Destroy()
				removed = removed + 1
			end
		end
		self._T.summonDragonEntities = {}
		if removed > 0 then
			log("[SummonDragon] 소환 해제 - " .. tostring(removed) .. "마리 제거")
		end
	end

	@ExecSpace("ServerOnly")
	method void DealSummonDragonHit(Entity target)
		-- 용 공격 1타: 단일 대상 포인터로 걸러 skill.summondragon(전투력 200~300%) 판정.
		if not isvalid(target) then return end
		self._T.summonDragonCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.summondragon", target)
	end

	@ExecSpace("Server")
	method void ApplyHealToDragon(Entity dragonEntity, number combatPower)
		-- 소환된 용 회복: 용사/힐러와 같은 공식(전투력의 5%~15%)으로 DragonHp를 채운다.
		if not isvalid(dragonEntity) then return end
		---@type SummonDragon
		local sd = dragonEntity:GetComponent("script.SummonDragon")
		if not isvalid(sd) or sd.DragonHp <= 0 then return end
		local baseHeal = combatPower * 0.10
		local mult = 0.5 + _UtilLogic:RandomDouble() * 1.0
		local healAmount = math.floor(baseHeal * mult)
		if healAmount <= 0 then return end
		local newHp = math.min(sd.DragonHp + healAmount, sd.DragonMaxHp)
		local actualHealed = newHp - sd.DragonHp
		if actualHealed <= 0 then return end
		sd.DragonHp = newHp
		sd:UpdateHpBar()
		self:PlayHeroHealEffect(dragonEntity)
		self:ShowHealDamageSkin(dragonEntity, actualHealed)
		log("PlayerAttack: 용 회복 +" .. tostring(actualHealed) .. " → HP " .. tostring(math.floor(sd.DragonHp)) .. "/" .. tostring(math.floor(sd.DragonMaxHp)))
	end

	@ExecSpace("Multicast")
	method void PlayRidingDragonSummonEffect(Entity attacker)
		-- (요청) 소환 시 1회 재생하는 이펙트. y는 캐릭터 발끝 높이(-0.45) - 트랜스폼 원점이 몸 중앙이라
		-- 0으로 두면 배 높이에서 터진다(브랜디쉬 시전 이펙트 주석과 같은 기준).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local serial = _EffectService:PlayEffectAttached("7ae16a28558045e2903af41106d7ba47", attacker, Vector3(0, -0.45, 0), 0, Vector3(1.1, 1.1, 1), false, { ["OrderInLayer"] = 6 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.0)
	end

	@ExecSpace("Multicast")
	method void PlayRidingMountEffectAt(Entity attacker, number fxX, number fxY)
		-- (요청) 탑승할 때와 내릴 때 1회 재생하는 이펙트(같은 RUID를 공용으로 쓴다).
		-- 부착이 아니라 "전환 직전 캐릭터가 서 있던 월드 좌표"에 고정 재생한다 - 탑승하면 캐릭터가
		-- 0.45만큼 떠오르는데, 부착이면 이펙트도 같이 따라 올라가 버려서 "올라가기 전 자리에서 터지는"
		-- 연출이 안 된다. y는 캐릭터 몸 기준 -0.1(발끝 -0.45보다 조금 위 - 요청).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local serial = _EffectService:PlayEffect("97f1637cc68143cd979124499adcd75f", attacker, Vector3(fxX, fxY - 0.1, 0), 0, Vector3(1.1, 1.1, 1), false, { ["OrderInLayer"] = 6 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.5)
	end

	@ExecSpace("Multicast")
	method void PlayBrandishHitEffect(Entity target)
		-- 타격 이펙트(흰 폭발) - 같은 팩의 hit/0.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("ee451f0e79a944b7b5546636a674005a", target, Vector3(0, 0.4, 0), 0, Vector3(1, 1, 1), false, {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	-- ── 메테오 (4차) ────────────────────────────────────────────────────
	-- 리소스팩: skill/1211.img/skill/12111003 (메테오)
	--   effect = 47286e5fd6eb4a989792415aacf07f73 (시전자 몸쪽 이펙트)
	--   tile/0~8 = 하늘에서 떨어지는 운석 이펙트 9종 (아래 GetMeteorTileClips)
	--   _audio/Use = d906d21dc9bd4c8cb66861d423044a65 / _audio/Hit = 0500714fee8645bb9a4894535ea723b1
	-- 블리자드(AttackBlizzard)와 같은 규격(운석 개수 15+10 / 운석당 최대 6명·반경 1.2 / 전투력 700~1000% /
	-- 쿨타임 20초 / 조작 잠금 3초)을 그대로 미러링한 스킬이다. 눈/얼음 전용 연출(폭설/얼음 데미지 스킨/
	-- 반짝임/배경 이펙트)만 제외했고, 화면 어두워짐/BGM 덕킹은 범용 연출이라 그대로 재사용한다.

	method table GetMeteorTileClips()
		-- 메테오 팩의 운석 이펙트 9종(tile/0~8).
		--   frames   = 그 클립의 총 프레임 수 - MeteorTileVisual이 "지금 재생 중인 것이 정말 이 클립인지"를
		--              판별하는 데 쓴다(모델 기본 클립의 프레임 이벤트를 우리 것으로 오인하는 것 방지).
		--   hitFrame = 운석이 실제로 바닥에 도달하는 프레임(요청받은 값 - 14/16/18).
		--              이 프레임에 도달한 순간 그 자리에 데미지가 들어간다.
		return {
			{ ruid = "3d2d26d6025a451cb2ee86f81c3f5c67", frames = 23, hitFrame = 14 }, -- tile/0
			{ ruid = "7a06895b1964498a867682c9688492fb", frames = 23, hitFrame = 14 }, -- tile/1
			{ ruid = "f10a72f238fd4e629b8c5c0f5b177e0a", frames = 22, hitFrame = 14 }, -- tile/2
			{ ruid = "f0aa22db64814b95937dd9e10a106b74", frames = 25, hitFrame = 16 }, -- tile/3
			{ ruid = "6af9eb7233fe4d2aa4151981c5a212dc", frames = 25, hitFrame = 16 }, -- tile/4
			{ ruid = "6a13c3d0dc334cf7991f6751ee1eecfd", frames = 25, hitFrame = 16 }, -- tile/5
			{ ruid = "9ddeb5688a21456c8268748a0da5264c", frames = 27, hitFrame = 18 }, -- tile/6
			{ ruid = "4ff70cf57b1742d7aa9c0be30ea87881", frames = 27, hitFrame = 18 }, -- tile/7
			{ ruid = "dae60053f27744168340f70ae309dbc7", frames = 27, hitFrame = 18 }, -- tile/8
		}
	end

	@ExecSpace("ServerOnly")
	method void DealMeteorTileArea(Vector2 pos)
		-- 운석 하나가 바닥에 닿은 자리에 데미지를 준다. 운석 하나당 최대 6명까지만 때린다(블리자드 타일과 동일).
		-- 초기 운석 15개와 이후 운석 10개가 모두 이 경로를 쓴다 - 데미지 방식이 완전히 동일하다.
		if not isvalid(self.Entity) then return end
		-- FindBlizzardShardTargets는 "반경 안 살아있는 몬스터 목록"을 돌려주는 범용 탐색 헬퍼라 그대로 재사용한다
		-- (블리자드 시전 상태와는 무관하게 동작한다).
		local targets = self:FindBlizzardShardTargets(pos, 1.2)
		local hit = 0
		for _, t in ipairs(targets) do
			if hit >= 6 then break end
			self:DealMeteorHit(t)
			hit = hit + 1
		end
		-- 착지음(_audio/Hit): 초기 운석 15개가 동시에 닿으면 15번 겹쳐 터지므로 0.3초에 1번만 재생한다.
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.meteorLastHitSoundAt or -1) + 0.3 <= now then
			self._T.meteorLastHitSoundAt = now
			self:PlayMeteorHitSound(pos.x, pos.y)
		end
		log("PlayerAttack: 메테오 운석 피해 pos=(" .. tostring(pos.x) .. "," .. tostring(pos.y) .. ") 맞은 몬스터=" .. tostring(hit) .. "/" .. tostring(#targets) .. " (운석당 최대 6)")
	end

	@ExecSpace("ServerOnly")
	method void AttackMeteor(number combatPower, number atkMultiplier)
		-- 메테오 타임라인 (쿨타임 20초는 클라이언트 SkillManager가 관리/표시 - 블리자드와 동일 규격):
		--   0.0s      시전 이펙트(47286e5f) + 사용음(d906d21d)
		--             + 맵이 서서히 살짝 어두워짐 / 메인 BGM 덕킹(블리자드의 범용 연출 Logic 재사용)
		--             + 조작 잠금 3초
		--   ~0.5-0.9s 운석 15개 생성 - 클립마다 바닥에 도달하는 프레임(14/16/18)이 달라서, 생성 시점을
		--             그만큼 앞당겨 보정한다(모두 약 2.3초에 "동시에" 착지 = 동시 데미지, 요청사항)
		--   3~18s     범위 안 몬스터 위치에 운석 10개 추가 낙하
		--
		--   데미지는 오직 운석에서만 나온다 - 운석 하나가 자기 클립의 hitFrame(바닥에 도달하는 프레임)에
		--   도달한 순간, 그 자리(반경 1.2)의 몬스터를 운석당 최대 6명까지 전투력의 700~1000%로 때린다.
		--   → 초기 운석 15개와 이후 운석 10개가 완전히 같은 방식(SpawnOneMeteorTile).
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isMeteoring then
			log("PlayerAttack: AttackMeteor 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isMeteoring = true
		self._T.pendingMeteorCombatPower = combatPower

		-- 추가 운석은 캐릭터가 움직여도 "시전한 위치" 기준으로 떨어져야 하므로 시전 좌표를 고정해둔다.
		local castPos = self.Entity.TransformComponent.WorldPosition
		self._T.meteorCastX = castPos.x
		self._T.meteorCastY = castPos.y

		-- 시전 후 3초 동안은 이동/점프/공격 등 다른 행동을 할 수 없다(블리자드와 동일한 방식).
		-- 다른 이유로 이미 꺼져 있었다면(예: 사망 처리) 그 상태를 되살리지 않도록 이전 값을 기억해둔다.
		local playerCtrl = self.Entity.PlayerControllerComponent
		self._T.pendingMeteorWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		log("PlayerAttack: 메테오 조작 잠금 시작 (3초) Enable=" .. tostring(isvalid(playerCtrl) and playerCtrl.Enable))
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		_TimerService:SetTimerOnce(function()
			self:RestoreMeteorControl()
		end, 3.0)

		-- (요청) 블리자드가 데미지 스킨을 얼음 스킨으로 바꾸는 것과 같은 시간(19초) 동안
		-- 메테오 전용 스킨(7709d0a8)으로 교체한다.
		self:ApplyMeteorDamageSkin()

		self:PlayMeteorCastEffect(self.Entity)
		-- 화면 어두워짐: 블리자드와 같은 트윈이지만 (요청) 미세하게 붉은 느낌의 오버레이 색을 쓴다.
		-- BGM 덕킹은 블리자드의 범용 연출 Logic(BlizzardBgmDucker)을 그대로 재사용한다.
		self:PlayMeteorScreenDim()
		self:PlayBlizzardBgmDuck()

		-- 운석 15개는 클립별 보정 지연을 두고 하나씩 생성돼 전부 동시에 착지한다.
		self:SpawnMeteorTiles()

		-- 재시전 잠금은 블리자드와 같은 타이밍(4.5초)에 풀어준다(쿨타임 20초는 클라이언트가 따로 관리).
		_TimerService:SetTimerOnce(function()
			self._T.isMeteoring = false
		end, 4.5)

		-- 운석 10개를 3~18초 사이 각자 다른 랜덤 시점에 "범위 안 몬스터가 있는 위치"에 추가로 떨어뜨린다.
		for i = 1, 10 do
			local delay = 3.0 + _UtilLogic:RandomDouble() * 15.0
			_TimerService:SetTimerOnce(function()
				self:SpawnMeteorTileOnMonster()
			end, delay)
		end
	end

	@ExecSpace("ServerOnly")
	method void RestoreMeteorControl()
		-- 시전 3초 뒤 조작을 되돌린다. 시전 전에 이미 꺼져 있었다면(사망 등) 그대로 둔다.
		if not isvalid(self.Entity) then return end
		local playerCtrl = self.Entity.PlayerControllerComponent
		local wasLocked = isvalid(playerCtrl) and (not playerCtrl.Enable)
		if isvalid(playerCtrl) and self._T.pendingMeteorWasControllerEnabled then
			playerCtrl.Enable = true
		end
		log("PlayerAttack: 메테오 조작 잠금 해제 (3초 유지됨=" .. tostring(wasLocked) .. ")")
	end

	@ExecSpace("Multicast")
	method void PlayMeteorCastEffect(Entity attacker)
		-- 시전 즉시 캐릭터 몸쪽에서 1회 재생되는 이펙트 2종 + 사용음 + 배경 루프 사운드.
		-- 블리자드 시전 이펙트와 동일한 레이어링 - 아바타와 같은 SortingLayer(MapLayer0)에 올리고
		-- OrderInLayer를 아바타(4)보다 작게(2) 줘서 "지형보다 앞, 캐릭터보다 뒤"에 깔린다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local backOption = { ["SortingLayer"] = "MapLayer0", ["OrderInLayer"] = 2 }
		local castOffset = Vector3(0, 0, 0)
		_EffectService:PlayEffectAttached("47286e5fd6eb4a989792415aacf07f73", attacker, castOffset, 0, Vector3(1, 1, 1), false, backOption)
		-- (요청) 같은 팩의 effect0(2eb15c8e)도 사용자 몸쪽에서 함께 재생한다.
		_EffectService:PlayEffectAttached("2eb15c8e49f8492f948c5292cd31171f", attacker, castOffset, 0, Vector3(1, 1, 1), false, backOption)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("47286e5fd6eb4a989792415aacf07f73", attacker, castOffset, 0, Vector3(1, 1, 1), backOption, 0)
		self:EchoShadowSkillEffectAttached("2eb15c8e49f8492f948c5292cd31171f", attacker, castOffset, 0, Vector3(1, 1, 1), backOption, 0)
		_SoundService:PlaySound("d906d21dc9bd4c8cb66861d423044a65", 1.0)
		-- (요청) 블리자드의 배경 루프 사운드(c50b1e30, 20초)와 같은 방식으로 메테오 전용 사운드를 20초간 재생한다
		-- (클립이 20초보다 짧을 수 있어 반복 재생 후 20초에 정지 - 블리자드와 동일한 볼륨).
		-- (피드백 이력) 사운드 교체: 89da231b → af3acec8 → de5f1d1c. 볼륨 1.5배: 0.8 → 1.2.
		_SoundService:PlayLoopSound("de5f1d1c7ed644b9a31a31d5c078ed31", 1.2)
		_TimerService:SetTimerOnce(function()
			_SoundService:StopSound("de5f1d1c7ed644b9a31a31d5c078ed31")
		end, 20.0)
	end

	@ExecSpace("Multicast")
	method void PlayMeteorScreenDim()
		-- 맵 전체가 서서히 "약간만" 어두워졌다가 서서히 밝아진다 - 트윈 규격은 블리자드(1.5/13/2.5)와
		-- 동일하고, 오버레이 색만 미세하게 붉은 느낌(어두운 적색)으로 준다.
		-- (요청) 어두워지고 붉어지는 정도를 약하게 - 최대 알파 0.35 → 0.2(블리자드와 동일하게 낮춤).
		if not self:IsClient() then return end
		_BlizzardScreenDim:StartDimTinted(1.5, 13.0, 2.5, 0.2, 0.3, 0.03, 0.03)
	end

	@ExecSpace("ServerOnly")
	method void ApplyMeteorDamageSkin()
		-- (요청) 메테오 시전 후 19초 동안(블리자드의 스킨 교체와 같은 시간) 데미지 스킨(공격 숫자 모양)을
		-- 메테오 전용 스킨(7709d0a8)으로 바꿨다가 시간이 끝나면 원래 스킨으로 되돌린다.
		-- (버그 수정) 블리자드와 겹쳐 쓰면 기본 스킨으로 안 돌아오던 문제 - 저장/복구를 공용 관리
		-- (ApplySkillDamageSkinShared)로 옮겼다(블리자드 쪽 주석 참고).
		self:ApplySkillDamageSkinShared("meteor", "7709d0a8994d47528542989badf1c85d")
		_TimerService:SetTimerOnce(function()
			self:RestoreMeteorDamageSkin()
		end, 19.0)
	end

	@ExecSpace("ServerOnly")
	method void RestoreMeteorDamageSkin()
		-- 19초 뒤 복구 요청 - 실제 복구는 공용 관리가 "마지막 스킬 스킨이 끝났을 때"만 수행한다.
		self:RestoreSkillDamageSkinShared("meteor")
	end

	@ExecSpace("ServerOnly")
	method void SpawnMeteorTiles()
		-- 시전자 주변의 "발판이 있는 자리"를 골라 운석 15개를 생성한다(블리자드 초기 타일과 같은 규격).
		-- 서로 겹치지 않도록 이미 고른 자리들과 최소 거리(MIN_GAP) 이상 떨어진 후보만 채택하고,
		-- 후보 뽑기가 실패해도 무한 루프에 빠지지 않도록 시도 횟수를 제한한다.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local fh = map.FootholdComponent
		local myPos = self.Entity.TransformComponent.WorldPosition
		local clips = self:GetMeteorTileClips()

		local WANT = 15
		local MIN_GAP = 0.9      -- 이펙트 간 최소 거리(월드 유닛)
		local RANGE_X = 10.4     -- 시전자 기준 좌우 탐색 범위
		local RANGE_Y = 3.9      -- 시전자 기준 상하 탐색 범위(다른 층 발판도 포함)
		local MAX_TRIES = 2000

		local placed = {}
		local tries = 0
		while #placed < WANT and tries < MAX_TRIES do
			tries = tries + 1
			local x = myPos.x + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * RANGE_X
			local probeY = myPos.y + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * RANGE_Y
			local y = nil
			if isvalid(fh) then
				local hitFh = self:FindNearbyFootholdAtX(fh, x, probeY, 3.0)
				if hitFh ~= nil then
					y = hitFh:GetYByX(x) + 0.05
				end
			end
			if y ~= nil then
				local ok = true
				for _, p in ipairs(placed) do
					local dx = p.x - x
					local dy = p.y - y
					if math.sqrt(dx * dx + dy * dy) < MIN_GAP then
						ok = false
						break
					end
				end
				if ok then
					table.insert(placed, { x = x, y = y })
				end
			end
		end

		-- (요청사항) "처음에 동시에 떨어져야" - 운석마다 바닥에 도달하는 프레임(hitFrame: 14~18)이 달라서,
		-- 같은 시점에 생성하면 착지(=데미지) 시점이 최대 4프레임만큼 어긋난다. 그래서 생성 시점을 hitFrame만큼
		-- 앞당겨 보정한다:
		--     생성지연 = 기준지연 - hitFrame * 프레임당시간   (hitFrame이 큰 클립일수록 먼저 생성)
		-- 이렇게 하면 모든 초기 운석이 "기준지연" 시점에 동시에 착지한다. 데미지 자체는 여전히 실제 재생
		-- 프레임(FrameIndex) 이벤트로 들어가므로, 아래 프레임당시간 값이 조금 틀려도 착지 순간에는 정확히 맞는다
		-- (동시성만 그만큼 흐트러진다). 블리자드 초기 타일과 완전히 같은 방식이다.
		-- 프레임당 재생 시간: 첫 플레이테스트 실측으로 보정(0.1 → 0.147초. 착지 로그의 재생경과/hitFrame가
		-- 14프레임=2.05초 / 16프레임=2.38초 / 18프레임=2.64초로 전부 ≈0.147초/프레임).
		local FRAME_SEC = 0.147
		local MAX_HIT_FRAME = 18     -- 클립들 중 가장 늦게 닿는 프레임(tile/6~8)
		local LAND_AT = 0.5 + MAX_HIT_FRAME * FRAME_SEC   -- 모든 초기 운석이 착지하는 시점(≈3.15초)

		for i, p in ipairs(placed) do
			local clip = clips[_UtilLogic:RandomIntegerRange(1, #clips)]
			-- 착지 시점(LAND_AT)에서 이 클립이 바닥에 닿는 데 걸리는 시간을 빼면 이 운석의 생성 시점이 된다.
			local delay = LAND_AT - clip.hitFrame * FRAME_SEC
			if delay < 0.1 then
				delay = 0.1
			end
			local px, py = p.x, p.y
			local idx = i
			_TimerService:SetTimerOnce(function()
				self:SpawnOneMeteorTile(map, clip.ruid, clip.frames, clip.hitFrame, Vector3(px, py, 0), idx)
			end, delay)
		end
		log("PlayerAttack: 메테오 운석 생성 " .. tostring(#placed) .. "/" .. tostring(WANT) .. "개 (시도 " .. tostring(tries) .. "회, 착지 " .. tostring(LAND_AT) .. "초에 동시)")
	end

	@ExecSpace("ServerOnly")
	method void SpawnOneMeteorTile(Entity map, string clipRuid, integer clipFrames, integer hitFrame, Vector3 pos, integer index)
		-- 운석 이펙트 1개 생성. 클립을 처음부터 끝까지 한 번 재생하고 사라진다(클라이언트 MeteorTileVisual).
		-- 데미지는 클립이 hitFrame(운석이 바닥에 도달하는 프레임)에 도달한 순간 그 자리에 들어간다 -
		-- 시전자 클라이언트의 MeteorTileVisual이 프레임 이벤트를 보고 서버(DealMeteorTileArea)를 호출한다.
		local fxEntity = _SpawnService:SpawnByModelId("spearburstfadingeffect", "MeteorTile_" .. tostring(index), pos, map)
		if not isvalid(fxEntity) then
			log_warning("PlayerAttack: 메테오 운석 이펙트 스폰 실패 index=" .. tostring(index))
			return
		end
		fxEntity:AddComponent("script.MeteorTileVisual")
		local comp = fxEntity:GetComponent("script.MeteorTileVisual")
		if isvalid(comp) then
			comp.ExpectedFrames = clipFrames
			comp.HitFrameIndex = hitFrame
			comp.CasterEntity = self.Entity
			-- 운석 이펙트도 블리자드 타일과 동일하게 캐릭터(기본 4)보다 뒤로 가도록 음수 OrderInLayer를 준다.
			comp.OrderInLayerValue = -1
			comp.AlphaValue = 1.0
			comp.TintR = 1.0
			comp.TintG = 1.0
			comp.TintB = 1.0
			comp.IsFlipX = false
			-- ClipRUID는 마지막에 넣는다 - 클라이언트의 OnSyncProperty(ClipRUID)가 실제 적용을 트리거하므로,
			-- 그 시점엔 나머지 값들이 이미 도착해 있어야 한다.
			comp.ClipRUID = clipRuid
		end
		-- 클립 1회 재생분(길어야 3초 남짓)만큼만 살려두고 정리한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(fxEntity) then
				fxEntity:Destroy()
			end
		end, 6.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnMeteorTileOnMonster()
		-- 운석 팩 클립 9종 중 하나를 "범위 안 몬스터가 있는 자리"에 생성한다(블리자드 추가 타일과 같은 규격).
		-- 랜덤 발판에 뿌리면 몬스터가 없는 허공에 떨어지는 경우가 많아, 범위 안 살아있는 몬스터 중
		-- 하나를 골라 그 발밑(몬스터 위치)에 떨어뜨린다. 몬스터가 하나도 없으면 아무것도 하지 않는다.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local cx = self._T.meteorCastX or self.Entity.TransformComponent.WorldPosition.x
		local cy = self._T.meteorCastY or self.Entity.TransformComponent.WorldPosition.y
		-- 판정 범위(드래곤 로어와 동일: 가로 15.0 / 세로 7.5) 안의 살아있는 몬스터들(범용 탐색 헬퍼 재사용).
		local candidates = self:FindDragonRoarTargets(Vector2(cx, cy), 30)
		if #candidates == 0 then return end
		local target = candidates[_UtilLogic:RandomIntegerRange(1, #candidates)]
		if not isvalid(target) then return end
		local tpos = target.TransformComponent.WorldPosition

		local clips = self:GetMeteorTileClips()
		local clip = clips[_UtilLogic:RandomIntegerRange(1, #clips)]
		self._T.meteorExtraCount = (self._T.meteorExtraCount or 0) + 1
		local idx = 1000 + self._T.meteorExtraCount   -- 초기 운석(1~15)과 이름이 겹치지 않게
		self:SpawnOneMeteorTile(map, clip.ruid, clip.frames, clip.hitFrame, Vector3(tpos.x, tpos.y, 0), idx)
		log("PlayerAttack: 메테오 추가 운석 생성 (몬스터 위치) pos=(" .. tostring(tpos.x) .. "," .. tostring(tpos.y) .. ") hitFrame=" .. tostring(clip.hitFrame))
	end

	@ExecSpace("ServerOnly")
	method void DealMeteorHit(Entity target)
		-- 운석이 닿은 자리에 있던 몬스터 1마리에게 피해를 준다(이번 호출 전용 단일 대상 패턴 - 블리자드 기둥과 동일).
		if not isvalid(target) then return end
		self._T.meteorCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.meteor", target)
		-- (요청) 불 속성 스킬 화상 - 메테오는 30% 확률.
		if _UtilLogic:RandomDouble() < 0.3 then
			self:ApplyElementalBurn(target, self._T.pendingMeteorCombatPower or 0)
		end
	end

	@ExecSpace("Multicast")
	method void PlayMeteorHitSound(number px, number py)
		-- 운석 착지음(_audio/Hit). 착지 지점 기준 3D 재생.
		if not self:IsClient() then return end
		_SoundService:PlaySoundAtPos("0500714fee8645bb9a4894535ea723b1", Vector3(px, py, 0), self.Entity, 0.8)
	end

	-- ── 제네시스 (4차) ────────────────────────────────────────────────────
	-- 리소스팩: skill/232.img/skill/2321008 (제네시스)
	--   effect = f0035d3b / effect0 = 1c434f7c (시전자 몸쪽 이펙트 2종)
	--   tile/0~5 = 하늘에서 내리꽂히는 빛 기둥 6종 (아래 GetGenesisTileClips - 전부 11프레임에 판정)
	--   _audio/Use = d07011d8 / _audio/Hit = 039d09d0
	-- 중간중간 추가 타격은 운석 대신 엔젤레이 VI(skill/234.img/skill/2341001)의 공격모션 2종(effect/effect2)을
	-- 몬스터 좌/우측에 소환해(몬스터를 바라보게 FlipX) 12프레임에 판정한다(요청 사양).
	-- 블리자드/메테오와 같은 규격(15+10회 / 1회당 최대 6명·반경 1.2 / 전투력 700~1000% / 쿨타임 20초 /
	-- 조작 잠금 3초)을 미러링했고, 화면은 메테오의 붉은 틴트처럼 "하얀색을 약간 줘서 밝게" 만든다.

	method table GetGenesisTileClips()
		-- 제네시스 팩의 빛 기둥 6종(tile/0~5). frames = 총 프레임 수(TileVisual의 클립 판별용),
		-- hitFrame = 판정 프레임(요청받은 값 - 전부 11).
		return {
			{ ruid = "befa4d153d36410ba30ba5ec09c88611", frames = 18, hitFrame = 11 }, -- tile/0
			{ ruid = "236a5855f26a4cbeb405a2e6446bef4e", frames = 20, hitFrame = 11 }, -- tile/1
			{ ruid = "9bceda8956f74866b6fd65655c85f8d0", frames = 22, hitFrame = 11 }, -- tile/2
			{ ruid = "623d68d21e784ac9949fd7941ab53f67", frames = 18, hitFrame = 11 }, -- tile/3
			{ ruid = "3b377b037832404e9f2246b7f4bfa283", frames = 20, hitFrame = 11 }, -- tile/4
			{ ruid = "ef28fe5cc5de4cc7b79c6e358cef614c", frames = 22, hitFrame = 11 }, -- tile/5
		}
	end

	@ExecSpace("ServerOnly")
	method void DealGenesisTileArea(Vector2 pos)
		-- 기둥/엔젤레이 하나가 판정 프레임에 도달한 자리에 데미지를 준다. 1회당 최대 6명(블리자드/메테오와 동일).
		if not isvalid(self.Entity) then return end
		-- FindBlizzardShardTargets는 "반경 안 살아있는 몬스터 목록"을 돌려주는 범용 탐색 헬퍼라 그대로 재사용한다.
		local targets = self:FindBlizzardShardTargets(pos, 1.2)
		local hit = 0
		for _, t in ipairs(targets) do
			if hit >= 6 then break end
			self:DealGenesisHit(t)
			hit = hit + 1
		end
		-- 판정음(_audio/Hit): 초기 기둥 15개가 동시에 꽂히면 15번 겹쳐 터지므로 0.3초에 1번만 재생한다.
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.genesisLastHitSoundAt or -1) + 0.3 <= now then
			self._T.genesisLastHitSoundAt = now
			self:PlayGenesisHitSound(pos.x, pos.y)
		end
		log("PlayerAttack: 제네시스 판정 pos=(" .. tostring(pos.x) .. "," .. tostring(pos.y) .. ") 맞은 몬스터=" .. tostring(hit) .. "/" .. tostring(#targets) .. " (1회당 최대 6)")
	end

	@ExecSpace("ServerOnly")
	method void AttackGenesis(number combatPower, number atkMultiplier)
		-- 제네시스 타임라인 (쿨타임 20초는 클라이언트 SkillManager가 관리/표시 - 블리자드/메테오와 동일 규격):
		--   0.0s   시전 이펙트 2종(f0035d3b + 1c434f7c) + 사용음(d07011d8) + 전용 BGM(f0f6d14d, 20초 루프)
		--          + 맵이 서서히 살짝 "하얗게 밝아짐"(메테오의 붉은 틴트와 같은 트윈, 색만 흰색)
		--          + 메인 BGM 10% 덕킹 + 조작 잠금 3초
		--   0.5s   빛 기둥 15개 생성 - 전부 판정 프레임이 11로 같아서 같은 시점에 생성하면 자동으로 동시 판정
		--   3~18s  범위 안 몬스터 좌/우측에 엔젤레이(공격모션 2종 중 랜덤)를 10회 소환 - 몬스터를 바라보고
		--          12프레임에 그 몬스터 자리 판정
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isGenesising then
			log("PlayerAttack: AttackGenesis 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isGenesising = true
		self._T.pendingGenesisCombatPower = combatPower

		-- 엔젤레이는 캐릭터가 움직여도 "시전한 위치" 기준 범위의 몬스터에게 나가야 하므로 시전 좌표를 고정해둔다.
		local castPos = self.Entity.TransformComponent.WorldPosition
		self._T.genesisCastX = castPos.x
		self._T.genesisCastY = castPos.y

		-- 시전 후 3초 동안은 이동/점프/공격 등 다른 행동을 할 수 없다(블리자드/메테오와 동일한 방식).
		local playerCtrl = self.Entity.PlayerControllerComponent
		self._T.pendingGenesisWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		log("PlayerAttack: 제네시스 조작 잠금 시작 (3초) Enable=" .. tostring(isvalid(playerCtrl) and playerCtrl.Enable))
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		_TimerService:SetTimerOnce(function()
			self:RestoreGenesisControl()
		end, 3.0)

		self:PlayGenesisCastEffect(self.Entity)
		-- 화면 밝아짐: 메테오의 붉은 틴트와 같은 트윈(1.5/13/2.5, 알파 0.2)에 색만 흰색.
		-- 메인 BGM 덕킹은 블리자드의 범용 연출 Logic을 그대로 재사용한다(10%).
		self:PlayGenesisScreenDim()
		self:PlayBlizzardBgmDuck()

		-- 빛 기둥 15개 - 판정 프레임이 전부 11로 같아 생성 시점 보정 없이 동시에 생성하면 동시에 판정된다.
		self:SpawnGenesisTiles()

		-- 재시전 잠금은 블리자드/메테오와 같은 타이밍(4.5초)에 풀어준다.
		_TimerService:SetTimerOnce(function()
			self._T.isGenesising = false
		end, 4.5)

		-- 엔젤레이 10회를 3~18초 사이 각자 다른 랜덤 시점에 "범위 안 몬스터의 좌/우측"에 소환한다.
		for i = 1, 10 do
			local delay = 3.0 + _UtilLogic:RandomDouble() * 15.0
			_TimerService:SetTimerOnce(function()
				self:SpawnGenesisAngelOnMonster()
			end, delay)
		end
	end

	@ExecSpace("ServerOnly")
	method void RestoreGenesisControl()
		-- 시전 3초 뒤 조작을 되돌린다. 시전 전에 이미 꺼져 있었다면(사망 등) 그대로 둔다.
		if not isvalid(self.Entity) then return end
		local playerCtrl = self.Entity.PlayerControllerComponent
		local wasLocked = isvalid(playerCtrl) and (not playerCtrl.Enable)
		if isvalid(playerCtrl) and self._T.pendingGenesisWasControllerEnabled then
			playerCtrl.Enable = true
		end
		log("PlayerAttack: 제네시스 조작 잠금 해제 (3초 유지됨=" .. tostring(wasLocked) .. ")")
	end

	@ExecSpace("Multicast")
	method void PlayGenesisCastEffect(Entity attacker)
		-- 시전 즉시 캐릭터 몸쪽에서 1회 재생되는 이펙트 2종 + 사용음 + 전용 BGM.
		-- 블리자드/메테오 시전 이펙트와 동일한 레이어링(아바타와 같은 MapLayer0, OrderInLayer 2 = 캐릭터 뒤).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local backOption = { ["SortingLayer"] = "MapLayer0", ["OrderInLayer"] = 2 }
		local castOffset = Vector3(0, 0, 0)
		_EffectService:PlayEffectAttached("f0035d3b88da4c9a91689b9db9c6bf7a", attacker, castOffset, 0, Vector3(1, 1, 1), false, backOption)
		_EffectService:PlayEffectAttached("1c434f7cecf94e1cb16b68ee0079b01d", attacker, castOffset, 0, Vector3(1, 1, 1), false, backOption)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("f0035d3b88da4c9a91689b9db9c6bf7a", attacker, castOffset, 0, Vector3(1, 1, 1), backOption, 0)
		self:EchoShadowSkillEffectAttached("1c434f7cecf94e1cb16b68ee0079b01d", attacker, castOffset, 0, Vector3(1, 1, 1), backOption, 0)
		_SoundService:PlaySound("d07011d88da0400e8018379396e564b9", 1.0)
		-- 전용 BGM을 블리자드/메테오와 같은 방식(루프, 볼륨 1.2, 20초 뒤 정지)으로 재생한다.
		_SoundService:PlayLoopSound("f0f6d14dc2ab41e48289b9b08838c2e5", 1.2)
		_TimerService:SetTimerOnce(function()
			_SoundService:StopSound("f0f6d14dc2ab41e48289b9b08838c2e5")
		end, 20.0)
	end

	@ExecSpace("Multicast")
	method void PlayGenesisScreenDim()
		-- (요청) 메테오가 붉은 끼를 약간 줬듯이, 제네시스는 하얀색을 약간 줘서 맵을 밝게 만든다.
		-- 트윈 규격은 블리자드/메테오(1.5/13/2.5, 알파 0.2)와 동일하고 오버레이 색만 흰색.
		if not self:IsClient() then return end
		_BlizzardScreenDim:StartDimTinted(1.5, 13.0, 2.5, 0.2, 1.0, 1.0, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnGenesisTiles()
		-- 시전자 주변의 "발판이 있는 자리"를 골라 빛 기둥 15개를 생성한다(블리자드/메테오 초기 타일과 같은 규격).
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local fh = map.FootholdComponent
		local myPos = self.Entity.TransformComponent.WorldPosition
		local clips = self:GetGenesisTileClips()

		local WANT = 15
		local MIN_GAP = 0.9      -- 이펙트 간 최소 거리(월드 유닛)
		local RANGE_X = 10.4     -- 시전자 기준 좌우 탐색 범위
		local RANGE_Y = 3.9      -- 시전자 기준 상하 탐색 범위(다른 층 발판도 포함)
		local MAX_TRIES = 2000

		local placed = {}
		local tries = 0
		while #placed < WANT and tries < MAX_TRIES do
			tries = tries + 1
			local x = myPos.x + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * RANGE_X
			local probeY = myPos.y + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * RANGE_Y
			local y = nil
			if isvalid(fh) then
				local hitFh = self:FindNearbyFootholdAtX(fh, x, probeY, 3.0)
				if hitFh ~= nil then
					y = hitFh:GetYByX(x) + 0.05
				end
			end
			if y ~= nil then
				local ok = true
				for _, p in ipairs(placed) do
					local dx = p.x - x
					local dy = p.y - y
					if math.sqrt(dx * dx + dy * dy) < MIN_GAP then
						ok = false
						break
					end
				end
				if ok then
					table.insert(placed, { x = x, y = y })
				end
			end
		end

		-- (요청사양) 기둥은 전부 11프레임에 판정된다 - 판정 프레임이 같으므로 메테오처럼 생성 시점을
		-- 클립별로 보정할 필요 없이, 같은 시점(0.5초)에 일제히 생성하면 자동으로 동시에 판정된다.
		for i, p in ipairs(placed) do
			local clip = clips[_UtilLogic:RandomIntegerRange(1, #clips)]
			local px, py = p.x, p.y
			local idx = i
			_TimerService:SetTimerOnce(function()
				self:SpawnOneGenesisTile(map, clip.ruid, clip.frames, clip.hitFrame, Vector3(px, py, 0), idx, false, 1.0, px, py)
			end, 0.5)
		end
		log("PlayerAttack: 제네시스 빛 기둥 생성 " .. tostring(#placed) .. "/" .. tostring(WANT) .. "개 (시도 " .. tostring(tries) .. "회, 0.5초에 일제 생성 - 11프레임 동시 판정)")
	end

	@ExecSpace("ServerOnly")
	method void SpawnOneGenesisTile(Entity map, string clipRuid, integer clipFrames, integer hitFrame, Vector3 pos, integer index, boolean flipX, number scale, number hitX, number hitY)
		-- 판정 이펙트 1개 생성(기둥/엔젤레이 공용). 클립을 처음부터 끝까지 한 번 재생하고 사라진다.
		-- 판정은 클립이 hitFrame에 도달한 순간 (hitX, hitY) 자리에 들어간다 - 시전자 클라이언트의
		-- GenesisTileVisual이 프레임 이벤트를 보고 서버(DealGenesisTileArea)를 호출한다.
		local fxEntity = _SpawnService:SpawnByModelId("spearburstfadingeffect", "GenesisTile_" .. tostring(index), pos, map)
		if not isvalid(fxEntity) then
			log_warning("PlayerAttack: 제네시스 이펙트 스폰 실패 index=" .. tostring(index))
			return
		end
		-- 엔젤레이는 원본이 매우 커서(약 10유닛) 축소해서 쓴다. Body 없는 이펙트 엔티티라 Transform 직접 조정 OK.
		if scale ~= 1.0 then
			fxEntity.TransformComponent.Scale = Vector3(scale, scale, 1)
		end
		fxEntity:AddComponent("script.GenesisTileVisual")
		local comp = fxEntity:GetComponent("script.GenesisTileVisual")
		if isvalid(comp) then
			comp.ExpectedFrames = clipFrames
			comp.HitFrameIndex = hitFrame
			comp.CasterEntity = self.Entity
			comp.HitCenterX = hitX
			comp.HitCenterY = hitY
			-- 캐릭터(기본 4)보다 뒤로 가도록 음수 OrderInLayer(블리자드/메테오 타일과 동일).
			comp.OrderInLayerValue = -1
			comp.AlphaValue = 1.0
			comp.TintR = 1.0
			comp.TintG = 1.0
			comp.TintB = 1.0
			comp.IsFlipX = flipX
			-- ClipRUID는 마지막에 넣는다 - 클라이언트의 OnSyncProperty(ClipRUID)가 실제 적용을 트리거하므로,
			-- 그 시점엔 나머지 값들이 이미 도착해 있어야 한다.
			comp.ClipRUID = clipRuid
		end
		-- 엔젤레이(32프레임 ≈ 4.7초)까지 감안해 6초 뒤 정리한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(fxEntity) then
				fxEntity:Destroy()
			end
		end, 6.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnGenesisAngelOnMonster()
		-- (요청 사양) 엔젤레이 VI의 공격모션 2종(effect/effect2) 중 하나를 "범위 안 몬스터의 좌측이나
		-- 우측"에 소환한다. 원본 아트는 천사가 오른쪽에 서서 왼쪽으로 공격하는 구도(썸네일 실측)라,
		-- 몬스터 오른쪽에 소환하면 그대로(FlipX=false), 왼쪽에 소환하면 좌우 반전(FlipX=true)해서
		-- 항상 몬스터를 바라보게 한다. 판정은 두 모션 모두 12프레임에 "몬스터가 있던 자리"로 들어간다.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local cx = self._T.genesisCastX or self.Entity.TransformComponent.WorldPosition.x
		local cy = self._T.genesisCastY or self.Entity.TransformComponent.WorldPosition.y
		-- 판정 범위(드래곤 로어와 동일: 가로 15.0 / 세로 7.5) 안의 살아있는 몬스터들(범용 탐색 헬퍼 재사용).
		local candidates = self:FindDragonRoarTargets(Vector2(cx, cy), 30)
		if #candidates == 0 then return end
		local target = candidates[_UtilLogic:RandomIntegerRange(1, #candidates)]
		if not isvalid(target) then return end
		local tpos = target.TransformComponent.WorldPosition

		-- 공격모션 2종(둘 다 32프레임, 판정 12프레임) 중 랜덤.
		local angelClips = {
			{ ruid = "3c075a252a75471aa2afb46284a92b18", frames = 32, hitFrame = 12 }, -- effect
			{ ruid = "841bc14615dd48a49e247f7b3bd75ed8", frames = 32, hitFrame = 12 }, -- effect2
		}
		local clip = angelClips[_UtilLogic:RandomIntegerRange(1, #angelClips)]
		-- 좌/우측 랜덤. side=+1이면 몬스터 오른쪽(원본 방향 그대로), -1이면 왼쪽(반전).
		local side = 1
		if _UtilLogic:RandomDouble() < 0.5 then side = -1 end
		local fxX = tpos.x + side * 1.0
		-- (피드백) "몬스터 머리 위 허공을 공격하는 느낌" - 이펙트 높이를 +0.8 → -0.3으로 1.1유닛 내려
		-- 공격 궤적이 몬스터 몸통 높이에 오게 한다.
		local fxY = tpos.y - 0.3
		self._T.genesisAngelCount = (self._T.genesisAngelCount or 0) + 1
		local idx = 1000 + self._T.genesisAngelCount   -- 기둥(1~15)과 이름이 겹치지 않게
		self:SpawnOneGenesisTile(map, clip.ruid, clip.frames, clip.hitFrame, Vector3(fxX, fxY, 0), idx, side < 0, 0.6, tpos.x, tpos.y)
		log("PlayerAttack: 제네시스 엔젤레이 소환 side=" .. tostring(side) .. " pos=(" .. tostring(fxX) .. "," .. tostring(fxY) .. ") 판정대상 자리=(" .. tostring(tpos.x) .. "," .. tostring(tpos.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void DealGenesisHit(Entity target)
		-- 판정 자리에 있던 몬스터 1마리에게 피해를 준다(이번 호출 전용 단일 대상 패턴 - 블리자드/메테오와 동일).
		if not isvalid(target) then return end
		self._T.genesisCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.genesis", target)
	end

	@ExecSpace("Multicast")
	method void PlayGenesisHitSound(number px, number py)
		-- 판정음(_audio/Hit). 판정 지점 기준 3D 재생.
		if not self:IsClient() then return end
		_SoundService:PlaySoundAtPos("039d09d0013640b182a7588ac2d34553", Vector3(px, py, 0), self.Entity, 0.8)
	end

	-- ── 버프 아이콘 우클릭 취소 (서버측 정리) ─────────────────────────────
	-- 우측 상단 버프 아이콘을 우클릭하면 해당 버프/스킬을 즉시 중단한다(요청 사양).
	-- 클라 표시는 각 BuffUI.HideBuff가, 클라 전용 스탯(부스터/분노 등)은 CharInfoManager가 정리하고,
	-- 서버에 상태가 있는 버프는 SkillManager.RequestCancelBuff → 아래 메서드들이 정리한다.
	-- 각 메서드는 해당 버프의 "자연 만료 타이머 본문"과 동일한 정리를 지금 수행한다(토큰 무효화 포함).

	@ExecSpace("ServerOnly")
	method void CancelHaste()
		-- 헤이스트 취소: 이동/점프 배율을 원복하고 토큰을 올려 예약된 원복 타이머를 무효화한다.
		self._T.hasteToken = (self._T.hasteToken or 0) + 1
		if self._T.hasteBaseCaptured then
			local movement = self.Entity.MovementComponent
			if isvalid(movement) then
				movement.InputSpeed = self._T.hasteBaseInputSpeed
				movement.JumpForce = self._T.hasteBaseJumpForce
			end
		end
		log("PlayerAttack: 헤이스트 취소(우클릭) - 이동/점프 원복")
	end

	@ExecSpace("ServerOnly")
	method void CancelComboAttack()
		-- 콤보 어택 취소: 활성 플래그만 내린다(자연 만료 타이머도 같은 일을 하므로 늦게 와도 무해).
		self._T.comboAttackActive = false
		log("PlayerAttack: 콤보 어택 취소(우클릭)")
	end

	@ExecSpace("ServerOnly")
	method void CancelShadowPartner()
		-- 쉐도우 파트너 취소: 토큰을 올려 예약 만료를 무효화하고 활성 플래그를 내린다.
		self._T.shadowPartnerToken = (self._T.shadowPartnerToken or 0) + 1
		self._T.shadowPartnerActive = false
		log("PlayerAttack: 쉐도우 파트너 취소(우클릭)")
	end

	@ExecSpace("ServerOnly")
	method void CancelFireZoneBuff()
		-- 불의 영역 취소: 온히트 프록 창을 닫는다(이미 깔린 화염 지대는 남은 수명대로 사라진다).
		self._T.fireZoneBuffUntil = 0
		log("PlayerAttack: 불의 영역 버프 취소(우클릭)")
	end

	@ExecSpace("ServerOnly")
	method void CancelGlacierBuff()
		-- 빙하지대 취소: 온히트 프록 창을 닫는다(이미 깔린 빙하 영역은 남은 수명대로 사라진다).
		self._T.glacierBuffUntil = 0
		log("PlayerAttack: 빙하지대 버프 취소(우클릭)")
	end

	@ExecSpace("ServerOnly")
	method void DismissRidingDragon()
		-- 드래곤 라이딩 취소: 소환된 드래곤을 즉시 제거한다(탑승 해제는 클라 OnDragonRideExpired가 먼저 처리).
		local dragon = self._T.ridingDragonEntity
		if isvalid(dragon) then
			dragon:Destroy()
		end
		self._T.ridingDragonEntity = nil
		log("PlayerAttack: 드래곤 라이딩 취소(우클릭) - 드래곤 제거")
	end

	@ExecSpace("ServerOnly")
	method void DismissHero()
		-- 용사 소환 취소: 소환된 용사를 즉시 제거한다(재소환 시 교체 경로와 동일한 정리).
		local hero = self._T.heroSummonEntity
		if isvalid(hero) then
			hero:Destroy()
		end
		self._T.heroSummonEntity = nil
		log("PlayerAttack: 용사 소환 취소(우클릭) - 용사 제거")
	end

	-- ── 체인 라이트닝 (4차) ────────────────────────────────────────────────
	-- 리소스팩: skill/222.img/skill/2221006 (체인 라이트닝)
	--   effect = fa693d02 (기모으기 12프레임 - 요청으로 1~8프레임만 사용)
	--   ball/0~2 = 전격 연결 조각(6프레임, 52px) - 대상 사이를 잇는 타일링에 사용
	--   hit/0~4 = 일반 명중 클립 / hit/0/6~8 스프라이트(0d221895·3afe42b0·e541f867) = 빙결 대상 전용 명중
	--   _audio/Use = 3c837a89 / _audio/Hit = 36187759
	-- 타임라인(요청 사양): swingO3의 1프레임에서 0.5초 멈춘 채 기를 모으고(차지 이펙트 1~8프레임),
	-- 2프레임을 지나 3프레임 시점(≈0.68초)에 전방 가장 가까운 몬스터에게 전격을 날린다.
	-- 전격은 가까운 순으로 최대 6명까지 연쇄(연쇄 반경 4.0), 대상당 전투력의 500%~700%.
	-- 빙결 중(IsTargetFrozen - 아이스샷/차지블로우 스티그마/빙하지대/블리자드 공용) 대상 명중 시:
	-- 명중 이펙트를 빙결 전용 스프라이트 시퀀스로 바꾸고 2초 스턴(머리 위 이펙트 + 행동불능).

	@ExecSpace("ServerOnly")
	method void AttackChainLightning(number combatPower, number atkMultiplier)
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isChainLightning then
			return
		end
		self._T.isChainLightning = true
		self._T.pendingChainLightningCombatPower = combatPower

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1

		-- 시전 동안(1프레임 홀드 0.5초 + 2~3프레임) 조작을 잠근다.
		self._T.pendingChainLightningWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		-- (피드백) "공격속도를 올려도 변화가 없다" - 홀드/발사/복구/이펙트 등 전체 타임라인에
		-- 공격속도 배율(mult)을 적용한다(쿨다운은 SkillManager가 이미 1.0*배율로 적용 중).
		-- (피드백) "후딜이 길다" - 발사 직후(0.75*배율)에 조작을 돌려준다.
		_TimerService:SetTimerOnce(function()
			self:RestoreChainLightningControl()
		end, 0.75 * mult)

		self:PlayChainLightningMotion(self.Entity, dirX, mult)
		self:SpawnChainLightningChargeFx(dirX, mult)

		-- 발사 시점: 1프레임 홀드(0.5*배율) + 2프레임 뒤 = 3프레임 도달(0.68*배율).
		_TimerService:SetTimerOnce(function()
			self:FireChainLightning(dirX)
		end, 0.68 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isChainLightning = false
		end, 0.85 * mult)
		log("PlayerAttack: AttackChainLightning combatPower=" .. tostring(combatPower) .. " mult=" .. tostring(mult))
	end

	-- ── 연막(4차) ────────────────────────────────────────────────────────
	-- 사양(요청 2026-07-30): 원본 팩 skill/422.img/skill/4221006("연막탄") 사용.
	--   · 시전 모션은 swingOF, 전용 시전 이펙트는 없다(사용음만).
	--   · 연기 생성 = special 클립을 **역재생**(9→0 프레임)한다.
	--   · 바닥에 깔리는 연기 = tile/0의 8~16번째 스프라이트 9장을 순환 재생.
	--   · 맵 전체가 뿌옇게 된다(블리자드 화면 오버레이의 유지 모드를 흰 연기색으로 사용).
	--   · 사라질 때는 special을 (정방향으로) 재생하며 서서히 사라진다.
	--   · 연막 안에서는 받는 피해가 전부 MISS, 내 공격은 전부 백스탭 취급.
	--   · 지속 10초 / 재사용 대기시간 20초(쿨다운은 SkillManager가 관리).

	method boolean IsSmokeScreenActive()
		-- 연막 지속 중인지. 피격 무효(MonsterAttack.IsAttackTarget)와 백스탭 취급 판정이 이 값을 본다.
		return (self._T.smokeScreenUntil or 0) > _UtilLogic.ElapsedSeconds
	end

	method number GetSmokeScreenCenterOffsetY()
		-- (요청) 이펙트 크기를 4배로 키우고 **플레이어가 연막 한가운데** 오도록 아래로 내린다.
		-- 원본 아트의 피벗은 아래쪽에 있어(실측: special 클립 프레임들의 ny ≈ 0.256, 높이 ≈ 480px = 4.8유닛)
		-- 그림의 약 74%가 피벗보다 위에 그려진다. 그래서 그냥 키우면 연기가 위로 치우친다.
		-- 중심까지의 거리 = (0.5 - 0.256) × 4.8유닛 × 4배 ≈ 4.7유닛 → 그만큼 내려서 스폰한다.
		-- (연기가 위/아래로 치우쳐 보이면 이 값 하나만 조정하면 된다.)
		return -4.7
	end

	@ExecSpace("ServerOnly")
	method void AttackSmokeScreen(number atkMultiplier)
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		-- (피드백) 지속 10초 → **20초**. 연기는 **모션이 끝나고 0.5초 뒤**에 생기기 시작하고,
		-- 나타날 때/사라질 때 각각 **2초에 걸쳐 서서히** 진행된다.
		local DURATION = 20.0
		local MOTION_SEC = 0.6 * mult      -- swingOF 한 번의 대략적인 재생 길이
		local startDelay = MOTION_SEC + 0.5
		-- 스킬 효과(피격 MISS / 백스탭 취급)는 시전 순간부터 연기가 완전히 걷힐 때까지 유지한다.
		self._T.smokeScreenUntil = _UtilLogic.ElapsedSeconds + startDelay + DURATION
		self._T.smokeScreenToken = (self._T.smokeScreenToken or 0) + 1
		local tok = self._T.smokeScreenToken

		local worldPos = self.Entity.TransformComponent.WorldPosition
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1

		-- (요청) 움직이면서 쓰면 시전 모션이 캔슬되던 문제 - 모션이 재생되는 동안은 행동 불가로 만든다.
		-- 이동은 여기(서버)에서 컨트롤러를 꺼서, 다른 스킬 입력은 SkillManager의 actionLockUntil
		-- 게이트에서 막는다(스킬 입력은 _InputService를 직접 타므로 컨트롤러만으로는 안 막힌다).
		if not self._T.isSmokeScreenMovementLocked then
			self._T.pendingSmokeScreenWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isSmokeScreenMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.smokeScreenMoveLockToken = (self._T.smokeScreenMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.smokeScreenMoveLockToken
		_TimerService:SetTimerOnce(function()
			self:RestoreSmokeScreenControl(myMoveLockToken)
		end, MOTION_SEC)

		-- 시전 모션 + 사용음만 먼저(연기는 아래 startDelay 뒤에 생긴다).
		self:PlaySmokeScreenMotion(self.Entity, mult)

		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			if self._T.smokeScreenToken ~= tok then return end
			-- 연기 생성(2초에 걸쳐 서서히) + 화면 뿌옇게(2초 페이드인)
			self:PlaySmokeScreenAppear(worldPos.x, worldPos.y, DURATION)
			-- 바닥에 깔리는 연기(타일 스프라이트 순환)를 지속시간 동안 유지한다.
			self:SpawnSmokeScreenTile(worldPos.x, worldPos.y, DURATION)
		end, startDelay)

		-- 지속시간이 끝나면 소멸 연출 + 화면 원복(도중에 재시전되면 토큰이 달라 무시된다).
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			if self._T.smokeScreenToken ~= tok then return end
			self:PlaySmokeScreenEnd(worldPos.x, worldPos.y)
			log("[SmokeScreen] 연막 종료(2초에 걸쳐 소멸)")
		end, startDelay + DURATION - 2.0)
		log("[SmokeScreen] 연막 시전 - 모션 후 " .. string.format("%.2f", startDelay)
			.. "초 뒤 생성 / " .. tostring(DURATION) .. "초 지속")
	end

	@ExecSpace("ServerOnly")
	method void RestoreSmokeScreenControl(integer moveLockToken)
		-- 시전 모션이 끝나 조작을 되돌린다. 더 최근 시전이 이미 다시 잠가둔 상태라면(토큰 불일치) 건드리지 않는다.
		if self._T.smokeScreenMoveLockToken ~= moveLockToken then return end
		self._T.isSmokeScreenMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingSmokeScreenWasControllerEnabled then
			playerCtrl.Enable = true
		end
		log("[SmokeScreen] 시전 모션 종료 - 조작 복구")
	end

	@ExecSpace("Multicast")
	method void PlaySmokeScreenMotion(Entity attacker, number atkMultiplier)
		-- 시전 순간: swingOF 모션 + 사용음만. 연기는 모션이 끝나고 0.5초 뒤에 따로 생긴다(요청).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local avatarRenderer = attacker.AvatarRendererComponent
		if isvalid(avatarRenderer) then
			local body = avatarRenderer:GetBodyEntity()
			if isvalid(body) then
				-- (요청) 이동 중 시전하면 MOVE 상태가 모션을 덮어써 캔슬돼 보였다 - 다른 스킬(엔젤레이 등)과
				-- 같은 방식으로 모션 재생 구간 동안 방향/모션을 고정하고, 상태가 바뀌면 다시 씌운다.
				local playerCtrl = attacker.PlayerControllerComponent
				local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
				if isvalid(attacker.MovementComponent) then
					attacker.MovementComponent:Stop()
				end
				if isvalid(playerCtrl) then
					playerCtrl.LookDirectionX = dirX
				end
				local playRate = 1.0 / mult
				self._T.lockedSmokeScreenDirX = dirX
				self._T.lockedSmokeScreenMotionName = "swingOF"
				self._T.lockedSmokeScreenPlayRate = playRate
				self._T.isSmokeScreenMotionPlaying = true
				self._T.isSmokeScreenDirectionLocked = true
				self._T.smokeScreenMotionToken = (self._T.smokeScreenMotionToken or 0) + 1
				local myMotionToken = self._T.smokeScreenMotionToken

				local motionEvent = ActionStateChangedEvent("swingOF", "swingOF", playRate, SpriteAnimClipPlayType.Onetime)
				body:SendEvent(motionEvent)

				_TimerService:SetTimerOnce(function()
					if self._T.smokeScreenMotionToken ~= myMotionToken then return end
					self._T.isSmokeScreenMotionPlaying = false
					self._T.isSmokeScreenDirectionLocked = false
					local sc = attacker.StateComponent
					if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
						sc:ChangeState("IDLE")
					end
				end, 0.6 * mult)
			end
		end
		_SoundService:PlaySound("ad63f4c64f304b6c876fb68511addb87", 1.0)
		log("[SmokeScreen] 시전 모션(swingOF) + 사용음")
	end

	@ExecSpace("Multicast")
	method void PlaySmokeScreenAppear(number x, number y, number duration)
		-- 연기 생성: (피드백) special 클립을 프레임 단위로 나눠 재생했더니 매 프레임이 새로 생겼다
		-- 사라지며 **반짝거렸다** → special은 아예 쓰지 않고, 바닥 연기(tile) 스프라이트가
		-- 알파 0에서 시작해 2초에 걸쳐 서서히 진해지는 것으로만 표현한다(SpawnSmokeScreenTile).
		-- 여기서는 화면 뿌옇게(2초 페이드인)만 담당한다.
		if not self:IsClient() then return end
		-- (버그 수정) 연막 지속 여부(smokeScreenUntil)는 ServerOnly 시전 함수에서만 세팅돼 클라에서는
		-- 항상 false였다 - "다크사이트 해제 시 연막이 남아 있으면 화면 복구" 판정이 클라에서 돌아야 하므로
		-- 여기서 클라 쪽 창도 함께 기록한다.
		self._T.smokeScreenUntil = _UtilLogic.ElapsedSeconds + (duration or 20.0)

		-- 맵 전체가 뿌옇게 - 블리자드 오버레이의 "유지 모드"를 흰 연기색으로 쓴다(다크사이트와 같은 경로).
		-- 페이드인 2초(요청).
		-- (요청) 맵을 좀더 어둡게 - 밝은 회백색 0.35 → 어두운 회색 0.55.
		_BlizzardScreenDim:StartHoldDim(2.0, 0.55, 0.45, 0.45, 0.50)
		log("[SmokeScreen] 연기 생성(바닥 연기 알파 2초 페이드인 + 화면 2초 페이드인)")
	end

	@ExecSpace("ServerOnly")
	method void SpawnSmokeScreenTile(number x, number y, number duration)
		-- 바닥에 깔리는 연기: tile/0의 8~16번째 스프라이트를 순환시킨다(정지 스프라이트라 클립 재생 불가).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local tiles = {
			"bc1ba61e96e5474d92525cd20990aace",   -- tile/0/8
			"048e10628f134eca9bc0e9a46ce5e2cf",   -- tile/0/9
			"18312d09b99c45eebe6d5cfba1fdbddc",   -- tile/0/10
			"8cbe41f131c244c58ff6d1669bc6b8ef",   -- tile/0/11
			"8c99c7df2b73470cafd310c6fcb797b2",   -- tile/0/12
			"14c3bcf57c854f3291a02efde5becdc5",   -- tile/0/13
			"6a31da72eabb4efcac6ebb5dc09ce15a",   -- tile/0/14
			"5d7f5dfe794a4cdfabbafcc58601e625",   -- tile/0/15
			"fd820c75aaf9447093ec0191f3911bed",   -- tile/0/16
		}
		self._T.smokeTileSeq = (self._T.smokeTileSeq or 0) + 1
		-- (요청) 크기 4배 + 플레이어가 한가운데 오도록 아래로 내려 스폰(GetSmokeScreenCenterOffsetY 참고).
		local tile = _SpawnService:SpawnByModelId("amhaengshadow", "smoketile_" .. tostring(self._T.smokeTileSeq),
			Vector3(x, y + self:GetSmokeScreenCenterOffsetY(), 0), map)
		if not isvalid(tile) then
			log_warning("[SmokeScreen] 연기 타일 스폰 실패")
			return
		end
		tile.TransformComponent.Scale = Vector3(4, 4, 1)
		local spr = tile.SpriteRendererComponent
		if isvalid(spr) then
			spr.SpriteRUID = tiles[1]
			-- (요청) 나타날 때 2초에 걸쳐 서서히 - 완전 투명에서 시작한다.
			spr.Color = Color(1, 1, 1, 0)
			spr.OrderInLayer = 10
		end
		-- (요청) 8→16으로 갔다가 16→8로 되돌아오는 왕복(지그재그) 재생.
		-- 양 끝(8/16)에서는 방향만 뒤집고 같은 장을 한 번 더 보여준다(요청 예시의 "16,16").
		local idx = 1
		local dir = 1
		local elapsed = 0.0
		-- 연기 프레임 순환 간격(요청으로 0.24초까지 늦췄다가 원래 속도로 복귀).
		-- elapsed는 실제 경과 시간을 그대로 누적하므로 STEP을 바꿔도 아래 페이드(2초)는 영향이 없다.
		local STEP = 0.12
		local FADE = 2.0        -- 나타남/사라짐에 각각 쓰는 시간(요청)
		local MAX_ALPHA = 0.70  -- (요청) 바닥 연기 투명도 70%
		local cycle
		cycle = function()
			if not isvalid(tile) then return end
			elapsed = elapsed + STEP
			-- 왕복 재생: 끝에 닿으면 방향을 뒤집되 그 프레임을 한 번 더 보여준다(8..16,16,15..8,8,9..).
			local nextIdx = idx + dir
			if nextIdx > #tiles or nextIdx < 1 then
				dir = -dir
			else
				idx = nextIdx
			end
			local s = tile.SpriteRendererComponent
			if isvalid(s) then
				s.SpriteRUID = tiles[idx]
				-- 앞 2초는 서서히 진해지고, 마지막 2초는 서서히 옅어진다.
				local left = duration - elapsed
				local a = MAX_ALPHA
				if elapsed < FADE then
					a = MAX_ALPHA * (elapsed / FADE)
				elseif left < FADE then
					a = MAX_ALPHA * math.max(left, 0) / FADE
				end
				s.Color = Color(1, 1, 1, a)
			end
			if elapsed < duration then
				_TimerService:SetTimerOnce(cycle, STEP)
			else
				tile:Destroy(0.05)
			end
		end
		_TimerService:SetTimerOnce(cycle, STEP)
	end

	@ExecSpace("Multicast")
	method void PlaySmokeScreenEnd(number x, number y)
		-- 소멸: (피드백) special 재생은 반짝임의 원인이라 쓰지 않는다. 바닥 연기 스프라이트가 마지막
		-- 2초 동안 알파를 0까지 낮추며 사라지고(SpawnSmokeScreenTile), 화면도 2초에 걸쳐 걷힌다.
		if not self:IsClient() then return end
		-- 클라 쪽 지속 창은 소멸이 끝나는 시점(2초 뒤)까지로 맞춘다
		-- (다크사이트 해제 시의 화면 복구 판정이 이 값을 본다).
		self._T.smokeScreenUntil = _UtilLogic.ElapsedSeconds + 2.0
		_BlizzardScreenDim:EndHoldDim(2.0)
		log("[SmokeScreen] 소멸 연출(바닥 연기 알파 2초 페이드아웃 + 화면 2초 원복)")
	end

	@ExecSpace("Multicast")
	method void ShowSmokeMissText(Entity target)
		-- 연막으로 공격이 빗나갔을 때의 MISS 표시(다른 스킬의 수동 표시와 같은 DamageSkinService 경로).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		_DamageSkinService:PlayTextDamage(target, "02c22d93421b4038b3c413b3e40b57ec",
			DamageSkinTextType.Miss, DamageSkinTweenType.Default)
	end

	@ExecSpace("ServerOnly")
	method void NotifySmokeScreenMiss(Entity target)
		-- MonsterAttack이 연막으로 공격을 걸러낼 때 호출한다. 매 공격마다 표시가 쏟아지지 않게
		-- 0.3초 간격으로만 MISS를 띄운다.
		if not isvalid(target) then return end
		local now = _UtilLogic.ElapsedSeconds
		if (self._T.smokeMissTextUntil or 0) > now then return end
		self._T.smokeMissTextUntil = now + 0.3
		self:ShowSmokeMissText(target)
	end

	-- ── 암살(4차) ────────────────────────────────────────────────────────
	-- 사양(요청 2026-07-30):
	--   · 데미지 구조는 체인 라이트닝과 동일(대상당 전투력의 500%~700%), 최대 10명까지 옮겨붙는다.
	--   · 시전 즉시 플레이어가 사라지고 그 자리에 1526c51b 이펙트를 재생한다.
	--   · 대상마다 "랜덤한 방향에서" 166b0965 이펙트를 그 방향 각도로 재생 → 0.1초 뒤 그 적을 타격.
	--     타격 0.1초 뒤 그 적과 가장 가까운 다음 적으로 같은 것을 반복한다.
	--   · 주변에 더 이상 대상이 없거나 10명을 다 때리면 **원래 플레이어 자리**에서 다시 나타난다.
	--     (나타날 때는 투명도 70%에서 시작해 서서히 100%가 된다 - 요청)
	--   · 히트 이펙트 8e865611은 매번 다른 각도로 재생한다.
	-- 플레이어는 실제로 이동하지 않는다(연출만 옮겨 다닌다) - 이동 권한/발판 문제를 만들지 않기 위한 설계.

	@ExecSpace("ServerOnly")
	method void AttackAssassinate(number combatPower, number atkMultiplier)
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isAssassinating then
			return
		end
		self._T.isAssassinating = true
		self._T.pendingAssassinateCombatPower = combatPower
		-- (피드백) 누르고 연속 사용할 때 "다시 보이기 전에 다시 사라져서 이어져야" 한다.
		-- 시전마다 세대 번호를 올려두고, 직전 시전이 예약해둔 "다시 나타남"은 세대가 바뀌면 취소한다.
		self._T.assassinateGen = (self._T.assassinateGen or 0) + 1

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		local playerCtrl = self.Entity.PlayerControllerComponent
		-- 연출 동안 조작을 잠근다(마지막에 다시 나타날 때 함께 풀어준다).
		-- (버그 수정) 홀드 연속 시전에서는 이미 잠긴 상태(Enable=false)를 "원래 값"으로 덮어쓰면
		-- 복귀 때 조작을 영영 못 돌려준다(그림자/네임태그와 같은 함정). 기억값이 없을 때만 저장한다.
		if self._T.pendingAssassinateWasControllerEnabled == nil then
			self._T.pendingAssassinateWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 사라짐: 아바타를 완전히 감추고 그 자리에 시전 이펙트를 재생한다.
		local worldPos = self.Entity.TransformComponent.WorldPosition
		-- 복귀 지점/숨은 상태/마지막 시전 시각을 기억해둔다(복귀 판단은 TryAppearAssassinate 한 곳).
		self._T.assassinateHidden = true
		self._T.assassinateReturnX = worldPos.x
		self._T.assassinateReturnY = worldPos.y
		self._T.assassinateLastCastAt = _UtilLogic.ElapsedSeconds
		self:PlayAssassinateVanish(self.Entity, worldPos.x, worldPos.y)

		-- 첫 대상: 살아있는 몬스터 중 가장 가까운 1명(방향 무관 - 몸을 감추고 파고드는 스킬이라
		-- 전방 콘으로 제한하지 않는다). 사거리는 샤이닝 레이/암행과 같은 드래곤 로어 절반 범위.
		local first = self:FindNearestAssassinateTarget(Vector2(worldPos.x, worldPos.y), nil)
		if not isvalid(first) then
			log("PlayerAttack: 암살 - 주변에 대상 없음(즉시 복귀)")
			self:FinishAssassinate(worldPos.x, worldPos.y)
			return
		end
		self:PlayAssassinateSound()
		self:RunAssassinateHop(first, 1, worldPos.x, worldPos.y, mult)
		log("PlayerAttack: AttackAssassinate combatPower=" .. tostring(combatPower) .. " mult=" .. tostring(mult))
	end

	@ExecSpace("ServerOnly")
	method Entity FindNearestAssassinateTarget(Vector2 fromPos, Entity exclude)
		-- fromPos에서 가장 가까운(유클리드) 살아있는 몬스터. 이미 때린 대상(assassinateHitLog)은 건너뛴다.
		-- (피드백) "체인 라이트닝처럼 전방으로 갈 필요 없고 주변 가까운 적 위주로" - 방향 제한은 원래부터
		-- 없었고, 사거리를 넓은 사각(±7.5/±3.75)에서 **원형 4.5유닛**으로 좁혀 홉이 멀리 새지 않고
		-- 직전 대상 주변에서만 이어지게 한다(첫 대상도 플레이어 주변 4.5유닛).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return nil end
		-- (요청) 연막 안에서는 암살의 공격 범위가 2배가 된다.
		local RADIUS = 4.5
		if self:IsSmokeScreenActive() then RADIUS = RADIUS * 2.0 end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local best = nil
		local bestDist = 999
		local hitLog = self._T.assassinateHitLog or {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead and mc.Entity ~= exclude and hitLog[mc.Entity] ~= true then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				local d = math.sqrt(dx * dx + dy * dy)
				if d <= RADIUS and d < bestDist then
					best = mc.Entity
					bestDist = d
				end
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method void RunAssassinateHop(Entity target, integer hopIndex, number returnX, number returnY, number atkMultiplier)
		-- 한 홉: 랜덤 방향 진입 이펙트 → 0.1초 뒤 타격 → 0.1초 뒤 다음 대상으로 재귀.
		if not isvalid(self.Entity) then return end
		if hopIndex == 1 then
			self._T.assassinateHitLog = {}
		end
		if not isvalid(target) then
			self:FinishAssassinate(returnX, returnY)
			return
		end
		-- (피드백) "적 주변 이펙트는 없애주세요" - 대상 주변 진입 이펙트(166b0965…)는 재생하지 않는다.
		-- 되살리려면 PlayAssassinateApproachFx를 다시 호출하면 된다(메서드는 그대로 남겨둠).
		local hopTarget = target
		local myHop = hopIndex
		-- (요청) 연막 안에서는 암살이 **최대 20명**까지 이어지고 **퍼지는 속도가 1.5배**가 된다.
		-- (범위 2배는 FindNearestAssassinateTarget에서 처리한다.)
		local maxHops = 10
		local hopStep = 0.05
		if self:IsSmokeScreenActive() then
			maxHops = 20
			hopStep = 0.05 / 1.5
		end
		-- (피드백) "퍼지는 속도를 2배로" - 진입→타격, 타격→다음 대상 간격을 0.1초 → 0.05초로 줄였다.
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			if isvalid(hopTarget) then
				self._T.assassinateCurrentTarget = hopTarget
				local hitLog = self._T.assassinateHitLog or {}
				hitLog[hopTarget] = true
				self._T.assassinateHitLog = hitLog
				local pos = hopTarget.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.2, 1.8), 0)
				self:AttackShadowSafe(shape, "skill.assassinate", hopTarget)
				self._T.assassinateCurrentTarget = nil
				-- 히트 이펙트는 매번 다른 각도로.
				self:PlayAssassinateHitFx(pos.x, pos.y + 0.3, _UtilLogic:RandomDouble() * 360.0)
			end
			-- 0.05초 뒤 다음 대상(직전 대상과 가장 가까운 적)으로 이어간다. 10명이면 종료.
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				if myHop >= maxHops then
					log("PlayerAttack: 암살 - " .. tostring(maxHops) .. "명 타격 완료")
					self:FinishAssassinate(returnX, returnY)
					return
				end
				local fromPos = Vector2(returnX, returnY)
				if isvalid(hopTarget) then
					local hp = hopTarget.TransformComponent.WorldPosition
					fromPos = Vector2(hp.x, hp.y)
				end
				local nextTarget = self:FindNearestAssassinateTarget(fromPos, hopTarget)
				if not isvalid(nextTarget) then
					log("PlayerAttack: 암살 - 주변에 다음 대상 없음(" .. tostring(myHop) .. "명 타격)")
					self:FinishAssassinate(returnX, returnY)
					return
				end
				self:RunAssassinateHop(nextTarget, myHop + 1, returnX, returnY, atkMultiplier)
			end, hopStep * atkMultiplier)
		end, hopStep * atkMultiplier)
	end

	@ExecSpace("ServerOnly")
	method void FinishAssassinate(number returnX, number returnY)
		-- 연쇄가 끝났다. 조작은 바로 돌려주고, 복귀 연출은 TryAppearAssassinate가 판단한다
		-- (키를 누르고 있는 동안에는 계속 숨은 채로 다음 연쇄를 이어간다 - 피드백 사양).
		self._T.isAssassinating = false
		self._T.assassinateHitLog = {}
		-- (요청) "암살 중에는 행동 불가" - 연쇄가 끝나도 조작을 바로 돌려주지 않는다.
		-- 조작은 실제로 다시 나타나는 순간(TryAppearAssassinate)에 함께 복구된다. 숨어 있는 동안
		-- 이동이 가능하면 이동/상태 전환이 아바타 투명도를 되돌려 "사라짐이 캔슬된 것처럼" 보였다.
		-- 0.2초 뒤 1차 판단, 1.4초 뒤 2차 판단(키업 신호가 유실된 경우의 안전망).
		_TimerService:SetTimerOnce(function()
			self:TryAppearAssassinate()
		end, 0.2)
		_TimerService:SetTimerOnce(function()
			self:TryAppearAssassinate()
		end, 2.6)
	end

	@ExecSpace("ServerOnly")
	method void SetAssassinateHold(boolean on)
		-- 암살 키 홀드 상태(SkillManager가 시전할 때 true, 키를 뗄 때 false로 알려준다).
		self._T.assassinateHold = on
		if not on then
			-- 키를 뗐다 - 연쇄가 이미 끝나 있으면 곧바로 다시 나타난다.
			self:TryAppearAssassinate()
		end
	end

	@ExecSpace("ServerOnly")
	method void TryAppearAssassinate()
		-- 복귀 조건: 숨어 있고, 연쇄가 진행 중이 아니고, 키를 더 누르고 있지 않을 때.
		-- 홀드 중이라도 마지막 시전 후 오래 지났으면(키업 신호 유실 대비) 강제로 나타난다.
		-- (버그 수정) 이 안전망을 1.3초로 뒀더니 홀드 연속 시전의 실제 간격(쿨다운 1.2초 + 연쇄 길이에
		-- 따라 최대 2초 가까이)보다 짧아, 홀드 중인데도 중간에 한 번씩 다시 나타났다(실측).
		-- 정상 홀드 간격에는 절대 걸리지 않도록 2.5초로 넉넉히 잡는다(키업은 별도 신호로 즉시 복귀한다).
		if not isvalid(self.Entity) then return end
		if self._T.assassinateHidden ~= true then return end
		if self._T.isAssassinating == true then return end
		if self._T.assassinateHold == true
			and (_UtilLogic.ElapsedSeconds - (self._T.assassinateLastCastAt or 0)) < 2.5 then
			return
		end
		self._T.assassinateHidden = false
		self:PlayAssassinateAppear(self.Entity, self._T.assassinateReturnX or 0, self._T.assassinateReturnY or 0)
		-- 다시 나타나는 이 시점에 조작을 돌려준다(암살 중 = 행동 불가).
		local ctrl = self.Entity.PlayerControllerComponent
		if isvalid(ctrl) and self._T.pendingAssassinateWasControllerEnabled == true then
			ctrl.Enable = true
		end
		self._T.pendingAssassinateWasControllerEnabled = nil
		self:PlayBreather(self.Entity, isvalid(ctrl) and ctrl.LookDirectionX or 1)
	end

	@ExecSpace("Multicast")
	method void PlayAssassinateVanish(Entity attacker, number x, number y)
		-- 사라짐 연출: 아바타를 완전히 투명하게 만들고 그 자리에 시전 이펙트를 1회 재생한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if isvalid(avatarRenderer) then
			avatarRenderer:SetAlpha(0.0, nil)
		end
		-- (버그 수정) 쉐도우 파트너 그림자는 아바타가 아니라 **별도 자식 엔티티**(자기 SpriteRenderer)라
		-- 아바타 알파를 0으로 해도 그 자리에 그대로 남아 보였다. 함께 숨기고, 다시 나타날 때 되돌린다.
		self:SetShadowPartnerHidden(attacker, true)
		-- (요청) 네임태그도 같이 감춘다.
		self:SetPlayerNameTagHidden(attacker, true)
		-- (요청) 암살 중에는 다른 스킬도 못 쓴다 - 스킬 입력 게이트를 켠다.
		-- 이 Multicast는 모든 클라이언트에서 돌므로, **내 캐릭터일 때만** 내 SkillManager를 잠근다.
		if attacker == _UserService.LocalPlayer then
			_SkillManager:SetAssassinateActive(true)
		end
		-- (피드백) 캐릭터 주변 이펙트 크기를 1/3로 줄였다(원본 클립이 6유닛급으로 화면을 덮었다).
		_EffectService:PlayEffect("1526c51ba3ea4a2795f1be1522d42b5d", attacker, Vector3(x, y + 0.3, 0), 0,
			Vector3(0.3333, 0.3333, 1), false, { ["OrderInLayer"] = 8 })
		-- (버그 수정) "이동하면서 쓰면 사라짐이 캔슬되어 보인다" - 피격(HIT)/상태 전환 등으로 아바타가
		-- 다시 그려지면 알파가 되돌아온다. 숨어 있는 동안 0.15초마다 투명도(와 그림자/네임태그)를
		-- 다시 눌러 유지한다. 복귀(PlayAssassinateAppear)에서 토큰을 올려 이 루프를 끝낸다.
		self._T.assassinateHideToken = (self._T.assassinateHideToken or 0) + 1
		local tok = self._T.assassinateHideToken
		-- 아바타 알파 소유권도 이번 연출로 가져온다(다른 알파 연출이 시작되면 이 루프는 스스로 멈춘다).
		self._T.avatarAlphaGen = (self._T.avatarAlphaGen or 0) + 1
		local alphaGen = self._T.avatarAlphaGen
		local keepHidden
		keepHidden = function()
			if self._T.assassinateHideToken ~= tok then return end
			if self._T.avatarAlphaGen ~= alphaGen then return end
			if not isvalid(attacker) then return end
			local ar = attacker.AvatarRendererComponent
			if isvalid(ar) then ar:SetAlpha(0.0, nil) end
			self:SetShadowPartnerHidden(attacker, true)
			self:SetPlayerNameTagHidden(attacker, true)
			_TimerService:SetTimerOnce(keepHidden, 0.15)
		end
		_TimerService:SetTimerOnce(keepHidden, 0.15)
		log("[Assassinate] 사라짐 - 아바타 알파 0 + 네임태그 숨김 + 시전 이펙트 재생(크기 1/3)")
	end

	method void SetPlayerNameTagHidden(Entity attacker, boolean hidden)
		-- (요청) 암살로 사라질 때는 머리 위 네임태그도 함께 감춘다.
		-- 화면에 보이는 이름은 PlayerComponent.Nickname이 아니라 **NameTagComponent**가 그린다.
		-- 컴포넌트 Enable을 끄고, 혹시 Enable만으로 안 사라지는 환경을 대비해 글자색 알파까지 0으로 둔다.
		-- (연속 시전 때 원래 색을 덮어쓰지 않도록 기억값이 비어 있을 때만 저장한다 - 그림자와 같은 함정.)
		if not isvalid(attacker) then return end
		local tag = attacker.NameTagComponent
		if not isvalid(tag) then return end
		if hidden then
			if self._T.assassinateNameTagColor == nil then
				self._T.assassinateNameTagColor = tag.FontColor
			end
			tag.Enable = false
			local c = self._T.assassinateNameTagColor
			tag.FontColor = Color(c.r, c.g, c.b, 0)
		else
			tag.Enable = true
			if self._T.assassinateNameTagColor ~= nil then
				tag.FontColor = self._T.assassinateNameTagColor
				self._T.assassinateNameTagColor = nil
			end
		end
	end

	method void SetShadowPartnerHidden(Entity attacker, boolean hidden)
		-- 쉐도우 파트너 그림자(플레이어의 자식 엔티티)를 함께 숨기거나 되돌린다.
		-- 숨길 때 "원래 켜져 있었는지"를 기억해, 버프가 꺼져 있던 경우에는 복귀 때 켜지 않는다.
		if not isvalid(attacker) then return end
		local shadow = attacker:GetChildByName("ShadowPartnerShadow_" .. tostring(attacker.Name), true)
		if not isvalid(shadow) then return end
		if hidden then
			-- (버그 수정) 홀드로 연속 시전하면 이 메서드가 매 시전마다 불린다. 그때 이미 숨겨둔 상태
			-- (Enable=false)를 "원래 값"으로 덮어써서, 마지막에 복구 조건(== true)이 영원히 거짓이 되고
			-- 그림자가 사라진 채로 남았다(실측). 아직 기억해둔 값이 없을 때만 원래 값을 저장한다.
			if self._T.assassinateShadowWasEnabled == nil then
				self._T.assassinateShadowWasEnabled = shadow.Enable
			end
			shadow.Enable = false
		else
			if self._T.assassinateShadowWasEnabled == true then
				shadow.Enable = true
			end
			self._T.assassinateShadowWasEnabled = nil
		end
	end

	@ExecSpace("Multicast")
	method void PlayAssassinateApproachFx(number x, number y, number angle)
		-- 대상에게 파고드는 이펙트. 진입 방향에 따라 각도를 바꿔 재생한다(요청).
		-- (피드백) 몬스터 주변 이펙트 크기 100% → **50%**.
		if not self:IsClient() then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		_EffectService:PlayEffect("166b0965cf0e4827867a7581de618779", map, Vector3(x, y, 0), angle,
			Vector3(0.5, 0.5, 1), false, { ["OrderInLayer"] = 7 })
	end

	@ExecSpace("Multicast")
	method void PlayAssassinateHitFx(number x, number y, number angle)
		-- 히트 이펙트 - 매번 다른 각도로 재생한다(요청).
		-- (피드백) 크기 100% → **20%**(원본 클립이 5유닛급으로 너무 커서).
		if not self:IsClient() then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		_EffectService:PlayEffect("8e8656117ba5498aa4f8308cd53c59d9", map, Vector3(x, y, 0), angle,
			Vector3(0.2, 0.2, 1), false, { ["OrderInLayer"] = 9 })
	end

	@ExecSpace("Multicast")
	method void PlayAssassinateAppear(Entity attacker, number x, number y)
		-- (요청) 다시 나타날 때는 투명도 70%에서 시작해 서서히 100%가 된다.
		-- 아바타 알파는 클라 전용이라 여기서 계단식으로 올린다(0.7 → 1.0, 0.05초 × 6단계 = 0.3초).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		-- 숨김 유지 루프를 끝낸다(토큰 무효화) - 안 그러면 복귀 직후 다시 투명해진다.
		self._T.assassinateHideToken = (self._T.assassinateHideToken or 0) + 1
		-- 아바타 알파 소유권을 이 복귀 페이드가 가져온다. 페이드가 도는 0.3초 사이에 다른 알파 연출
		-- (다크사이트 등)이 시작되면 세대가 바뀌어 이 페이드는 즉시 멈춘다.
		-- (버그 수정) "암살이 끝나자마자 다크사이트를 쓰면 투명해지지 않는다" - 이 페이드가 다크사이트의
		-- 알파 0.3을 계속 1.0으로 덮어쓰고 있었다.
		self._T.avatarAlphaGen = (self._T.avatarAlphaGen or 0) + 1
		local alphaGen = self._T.avatarAlphaGen
		avatarRenderer:SetAlpha(0.7, nil)
		-- 함께 숨겼던 쉐도우 파트너 그림자와 네임태그도 되돌린다.
		self:SetShadowPartnerHidden(attacker, false)
		self:SetPlayerNameTagHidden(attacker, false)
		-- 다시 나타났으니 스킬 입력 게이트를 푼다(내 캐릭터일 때만).
		if attacker == _UserService.LocalPlayer then
			_SkillManager:SetAssassinateActive(false)
		end
		local steps = 6
		local stepIndex = 0
		local stepTime = 0.05
		local fadeIn
		fadeIn = function()
			stepIndex = stepIndex + 1
			if self._T.avatarAlphaGen ~= alphaGen then return end
			if not isvalid(attacker) then return end
			local ar = attacker.AvatarRendererComponent
			if not isvalid(ar) then return end
			local a = 0.7 + 0.3 * (stepIndex / steps)
			if a > 1.0 then a = 1.0 end
			ar:SetAlpha(a, nil)
			if stepIndex < steps then
				_TimerService:SetTimerOnce(fadeIn, stepTime)
			else
				log("[Assassinate] 복귀 페이드 완료 - 알파 " .. string.format("%.2f", a))
			end
		end
		log("[Assassinate] 복귀 - 알파 0.70에서 시작해 0.30초에 걸쳐 1.00으로")
		_TimerService:SetTimerOnce(fadeIn, stepTime)
	end

	@ExecSpace("Multicast")
	method void PlayAssassinateSound()
		-- 시전음: 체인 라이트닝과 같은 팩 사운드 규격이 없어 기존 암행 계열 표창 사용음을 재사용한다.
		if not self:IsClient() then return end
		_SoundService:PlaySound("0f213b255ab34a0e8ed258c89f3b62fe", 1.0)
	end

	@ExecSpace("Server")
	method void RestoreChainLightningControl()
		if not isvalid(self.Entity) then return end
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingChainLightningWasControllerEnabled then
			playerCtrl.Enable = true
		end
		self:PlayBreather(self.Entity, isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1)
	end

	@ExecSpace("Multicast")
	method void PlayChainLightningMotion(Entity attacker, number dirX, number atkMultiplier)
		-- (요청 사양) swingO3를 재생하되 아바타 재생 속도를 낮춰 1프레임에서 0.5초 머물게 했다가
		-- 0.5초 뒤 원래 속도로 되돌려 2~3프레임이 정상 속도로 이어지게 한다.
		-- 머무는 동안 기모으기 이펙트(fa693d02)의 1~8프레임을 몸쪽에 재생한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false
		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end

		-- (버그 수정) 이동 중 시전 시 MOVE→IDLE 상태 전환이 모션을 덮어써 진행이 멈추던 문제 -
		-- 재생 플래그를 세워 HandleStateChangeEvent가 상태 변화 때마다 swingO3를 다시 얹게 한다.
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		self._T.isChainLightningMotionPlaying = true
		self._T.lockedChainLightningDirX = dirX

		-- 1프레임(스윙 클립 프레임당 ≈0.18초)이 0.5초*배율이 되도록 재생 속도를 낮춘다(공격속도 반영).
		avatarRenderer.PlayRate = 0.36 / mult
		local motionEvent = ActionStateChangedEvent("swingO3", "swingO3", 1.0, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)

		-- 기모으기 이펙트는 (피드백) 위치 이동+페이드가 필요해서 PlayEffect 대신 서버가
		-- SpearBurstFadingEffect 엔티티로 스폰한다(SpawnChainLightningChargeFx). 여기서는 사운드만.
		_SoundService:PlaySound("3c837a89f39e4e038b0a3a378de9a377", 1.0)

		_TimerService:SetTimerOnce(function()
			-- 홀드 종료: 원래 속도로 2~3프레임 재생.
			if isvalid(avatarRenderer) then
				avatarRenderer.PlayRate = 1.0
			end
		end, 0.5 * mult)
		-- (피드백) "후딜이 길다" - 모션 정리는 0.8초*배율.
		_TimerService:SetTimerOnce(function()
			self._T.isChainLightningMotionPlaying = false
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
				avatarRenderer.PlayRate = 1.0
			end
			local sc = attacker.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.8 * mult)
	end

	@ExecSpace("ServerOnly")
	method void SpawnChainLightningChargeFx(number dirX, number atkMultiplier)
		-- 기모으기 이펙트(피드백 사양): 1프레임 홀드 동안 캐릭터 몸쪽 아래에 떠 있다가,
		-- 모션이 1→3프레임으로 연계되는 구간에 캐릭터 앞쪽으로 부드럽게 이동하면서
		-- 서서히(알파 1→0) 사라진다. PlayEffect는 재생 중 위치/알파를 못 움직이므로
		-- SpearBurstFadingEffect 엔티티(플레이어 자식 - 캐릭터를 따라다님)로 스폰해
		-- FrameLocalPos(@Sync)를 서버 타이머로 밀어 이동시키고 Hold+Tween 페이드를 쓴다.
		-- 홀드/프레임/페이드 시점은 공격속도 배율에 비례한다(슬라이드 이동 시간 자체는 순수 연출이라 고정).
		if not isvalid(self.Entity) then return end
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "ChainLightCharge", Vector3(0, 0, 0), self.Entity)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		---@type SpearBurstFadingEffect
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		-- (피드백) "좀더 아래·뒤로" - 시작 x 0.15 → -0.05(몸쪽으로), y +0.25 → +0.05로 내림.
		-- (피드백) "번개 시작이 너무 멀다" - 슬라이드 종점 0.9 → 0.5(번개 시작점과 동기화).
		-- (피드백 이력) 종점 x: 0.5 → 0.8 → 0.6 → "좀더 앞쪽으로" 0.8. 종점 y: +0.1 → -0.05 → "좀더 아래" -0.2.
		local startX = -0.05 * dirX
		local startY = 0.05
		local endX = 0.8 * dirX
		local endY = -0.2
		if isvalid(comp) then
			comp.IsFlipX = dirX > 0
			-- (피드백) 기모으기 크기 1.2배: 0.5 → 0.6.
			comp.StartScale = 0.6
			comp.EndScale = 0.6
			comp.StartAlpha = 1.0
			comp.EndAlpha = 0.0
			-- (피드백) "번개가 날아가는 것을 보고 사라졌으면" + "사라지기 시작을 조금 더 앞으로" -
			-- 발사 직전(0.65*배율)부터 0.25초에 걸쳐 서서히 사라진다.
			comp.HoldDuration = 0.65 * mult
			comp.TweenDuration = 0.25
			comp.OrderInLayerValue = 5
			comp.UseFrameLocalPos = true
			comp.FrameLocalPos = Vector2(startX, startY)
		end
		-- (피드백) "9~12프레임은 사용하지 않는 리소스라 아예 빼달라" - 클립(12프레임)을 재생하면
		-- 프레임 범위 잠금이 클립 적용 시 리셋되는 경쟁으로 뒷프레임이 새어 나온다(실측 2회).
		-- → 클립 대신 1~8프레임의 "개별 스프라이트"를 0.09초 간격으로 직접 교체 재생한다.
		--   뒷프레임 리소스는 아예 참조하지 않으므로 원천적으로 나올 수 없다(암행 사라짐 연출과 동일 기법).
		local chargeFrames = {
			"d5cf4af358ad4b968b0098482b8e4f01",
			"5acc3586c88744a4a317017949deaeac",
			"bda2f30b3f2e4f7797923dfa6d67a2ad",
			"80ef1189a2bb4c62b6d38e9acf49646e",
			"434499f4207643e6b15b1bc486038ab9",
			"efdb69589210447da328503a7919ae41",
			"3d3c65d7fd3b4ca5a0b9f04b5f2e7491",
			"d815226fbe56432fb67affffdbd33836",
		}
		if isvalid(comp) then
			comp.ClipRUID = chargeFrames[1]
		end
		for fi = 2, #chargeFrames do
			local frameRuid = chargeFrames[fi]
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then
					comp.ClipRUID = frameRuid
				end
			end, (fi - 1) * 0.09 * mult)
		end
		-- 홀드가 끝나는 0.5*배율 시점부터 앞+아래로 슬라이드. (피드백) "이동 후 사라지는 것처럼 보인다" -
		-- 이동 시간을 절반으로 늦춘 0.052초(순수 연출이라 배율 미적용).
		local steps = 5
		for i = 1, steps do
			local f = i / steps
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then
					comp.FrameLocalPos = Vector2(startX + (endX - startX) * f, startY + (endY - startY) * f)
				end
			end, 0.5 * mult + 0.052 * f)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 0.95 * mult + 0.3)
	end

	@ExecSpace("ServerOnly")
	method void FireChainLightning(number dirX)
		-- 3프레임 시점: 전방 가장 가까운 몬스터를 첫 대상으로, 가까운 순으로 최대 6명까지 연쇄 판정.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local worldPos = self.Entity.TransformComponent.WorldPosition

		-- 첫 대상: 전방의 살아있는 몬스터 중 가장 가까운 1명.
		-- (피드백) "바로 위/아래를 때리면 이상하다" - 최소 전방 거리(0.5)를 두고, 위아래 허용 폭이
		-- 거리에 비례해 넓어지는 콘 모양(가까울수록 ±0.8, 최대 사거리 6에서 ±3.5)으로 찾는다.
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local first = nil
		local firstDist = 999
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = (pos.x - worldPos.x) * dirX
				local dy = pos.y - worldPos.y
				if dx >= 0.5 and dx <= 6.0 and math.abs(dy) <= 0.8 + dx * 0.45 and dx < firstDist then
					first = mc.Entity
					firstDist = dx
				end
			end
		end
		if first == nil then
			log("PlayerAttack: 체인 라이트닝 - 전방에 대상 없음")
			return
		end

		-- 연쇄(피드백 사양): 첫 대상 기준 "바라보는 전방으로만" 퍼진다. 첫 대상의 위아래 ±3.0 안에서
		-- x축 거리가 가까운 순으로 최대 9명을 이어 총 10명까지 때린다(뒤쪽으로는 퍼지지 않음 - "10번까지" 피드백).
		local targets = { first }
		local firstPos = first.TransformComponent.WorldPosition
		local chainCands = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead and mc.Entity ~= first then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = (pos.x - firstPos.x) * dirX
				local dy = pos.y - firstPos.y
				if dx >= 0 and dx <= 8.0 and math.abs(dy) <= 3.0 then
					table.insert(chainCands, { entity = mc.Entity, dist = dx })
				end
			end
		end
		table.sort(chainCands, function(a, b) return a.dist < b.dist end)
		for i = 1, math.min(#chainCands, 9) do
			table.insert(targets, chainCands[i].entity)
		end

		-- 전격 연결 연출 + 판정: 플레이어 → 1번 대상 → 2번 → ... (ball/0~2 조각 타일링).
		-- (피드백) 번개 시작점은 캐릭터 몸쪽으로 더 당기고(0.6 → 0.45) 좀더 위로(0.0 → +0.15) -
		-- 기모으기 슬라이드 종점과는 분리 운영(기모으기는 더 앞·아래까지 가고, 번개는 몸쪽 위에서 시작).
		-- (피드백) "한 번에 쫙"이 아니라 미세하게 전달되는 느낌 - 홉(대상)마다 0.06초 간격으로
		-- 세그먼트 연출과 판정을 순차 진행한다(연쇄 좌표는 발사 시점에 스냅샷).
		local prevX, prevY = worldPos.x + 0.45 * dirX, worldPos.y + 0.25
		self:PlayChainLightningHitSound()
		for i, t in ipairs(targets) do
			local tp = t.TransformComponent.WorldPosition
			local segX1, segY1 = prevX, prevY
			local segX2, segY2 = tp.x, tp.y + 0.3
			prevX, prevY = segX2, segY2
			local hopTarget = t
			local hopDelay = 0.01 + (i - 1) * 0.06
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				self:PlayChainLightningSegment(segX1, segY1, segX2, segY2)
				if isvalid(hopTarget) then
					local wasFrozen = self:IsTargetFrozen(hopTarget)
					self._T.chainLightningCurrentTarget = hopTarget
					local pos = hopTarget.TransformComponent.WorldPosition
					local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
					self:AttackShadowSafe(shape, "skill.chainlightning", hopTarget)
					if wasFrozen then
						self:PlayChainLightningFrozenHit(hopTarget, dirX)
						self:ApplyChainLightningStun(hopTarget, 2.0)
					else
						self:PlayChainLightningHitEffect(hopTarget)
					end
				end
			end, hopDelay)
		end
		log("PlayerAttack: 체인 라이트닝 발사 - 연쇄 " .. tostring(#targets) .. "명 (0.06초 간격 순차)")
	end

	@ExecSpace("Multicast")
	method void PlayChainLightningSegment(number x1, number y1, number x2, number y2)
		-- 두 지점을 잇는 전격: ball/0~2 조각(약 0.5유닛)을 0.45유닛 간격으로 타일링하고 진행 각도로 회전.
		if not self:IsClient() then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local ballClips = {
			"fde245aeb0eb49baa3b0bd64fbc05f7a",
			"fdfe96a01f704ede9882f5e324c70118",
			"a83eaccf55764d269aec652f27fe1944",
		}
		local dx = x2 - x1
		local dy = y2 - y1
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < 0.05 then return end
		local angle = math.deg(math.atan(dy, dx))
		-- (피드백) 조각 크기 0.5 → 1.3배(0.65) - 커버 길이에 맞춰 간격도 0.25 → 0.33으로.
		local count = math.max(1, math.floor(dist / 0.33 + 0.5))
		for k = 1, count do
			local f = (k - 0.5) / count
			local px = x1 + dx * f
			local py = y1 + dy * f
			local clip = ballClips[_UtilLogic:RandomIntegerRange(1, #ballClips)]
			_EffectService:PlayEffect(clip, map, Vector3(px, py, 0), angle, Vector3(0.65, 0.65, 1), false, { ["OrderInLayer"] = 6 })
		end
	end

	@ExecSpace("Multicast")
	method void PlayChainLightningHitEffect(Entity target)
		-- 일반 명중: 팩 hit/0~4 중 랜덤 클립을 대상 몸에서 재생.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local hitClips = {
			"b499aa0ce95647ceb592198e0ce0d97c",
			"1361b140f2e848128ed69676647e27cf",
			"4c5c48d9597048a38f85d0f6cb32c575",
			"43aa8b75f719400ab4c077832442e260",
			"715c8da82db44087b06a507b37ea7bba",
		}
		local clip = hitClips[_UtilLogic:RandomIntegerRange(1, #hitClips)]
		-- (피드백) 명중 이펙트 크기 0.5 → 1.3배(0.65).
		_EffectService:PlayEffectAttached(clip, target, Vector3(0, 0.2, 0), 0, Vector3(0.65, 0.65, 1), false, {})
	end

	@ExecSpace("ServerOnly")
	method void PlayChainLightningFrozenHit(Entity target, number dirX)
		-- (요청 사양) 빙결 중이던 대상의 명중 이펙트는 기존 hit 대신 hit/0/6~8 스프라이트
		-- 시퀀스(0d221895 →3afe42b0→e541f867)로 바꿔 재생한다(프레임 교체 헬퍼 재사용, 대상 부착).
		if not isvalid(target) then return end
		local frames = {
			{ ruid = "0d221895ece44d45aacfbbf6fe6d76bc", x = 0, y = 0.3, order = 6 },
			{ ruid = "3afe42b0abe2406b90bc58dc6c8e278d", x = 0, y = 0.3, order = 6 },
			{ ruid = "e541f867148947a8bde68bb0f73eefa0", x = 0, y = 0.3, order = 6 },
		}
		self:SpawnBuffFrameEffectEx(frames, dirX, 0.12, 0.25, target, 1.0, 1.0, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void ApplyChainLightningStun(Entity target, number duration)
		-- 빙결 대상 명중 시 2초 스턴: 차지 블로우 스턴과 동일한 방식(AI/이동 정지 + 머리 위 스턴 이펙트)
		-- 이되 지속시간을 인자로 받는다.
		if not isvalid(target) then return end
		local aiChase = target.AIChaseComponent
		local wasChaseEnabled = isvalid(aiChase) and aiChase.Enable
		if isvalid(aiChase) then aiChase.Enable = false end
		local aiWander = target.AIWanderComponent
		local wasWanderEnabled = isvalid(aiWander) and aiWander.Enable
		if isvalid(aiWander) then aiWander.Enable = false end
		local movement = target.MovementComponent
		local wasMovementEnabled = isvalid(movement) and movement.Enable
		if isvalid(movement) then
			movement:Stop()
			movement.Enable = false
		end
		self:PlayChargeBlowStunEffect(target, duration)
		_TimerService:SetTimerOnce(function()
			if isvalid(target) then
				if isvalid(aiChase) and wasChaseEnabled then aiChase.Enable = true end
				if isvalid(aiWander) and wasWanderEnabled then aiWander.Enable = true end
				if isvalid(movement) and wasMovementEnabled then movement.Enable = true end
			end
		end, duration)
		log("PlayerAttack: 체인 라이트닝 빙결 대상 스턴 " .. tostring(duration) .. "초 - " .. tostring(target.Name))
	end

	@ExecSpace("Multicast")
	method void PlayChainLightningHitSound()
		-- 명중음(_audio/Hit). 연쇄가 한 번에 최대 6명이라 1회만 재생한다.
		if not self:IsClient() then return end
		_SoundService:PlaySound("36187759ab2f4bc293aeb035e4ea8d73", 1.0)
	end

end