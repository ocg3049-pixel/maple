	@ExecSpace("ServerOnly")
	method void DealIfritHit(Entity target)
		-- 이프리트 화염 1타(대상 1마리). IfritSummon이 최대 6마리에 대해 각각 한 번씩 부른다.
		if not isvalid(target) then return end
