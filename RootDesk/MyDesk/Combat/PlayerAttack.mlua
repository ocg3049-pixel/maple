		            return
		        end
		        if self._T.isHolyArrowDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedHolyArrowDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[HolyArrow] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 더블샷 전용 처리 (다른 화살 스킬과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isDoubleShotMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedDoubleShotDirX
		            end
		            local motionName = self._T.lockedDoubleShotMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedDoubleShotPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[DoubleShot] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isDoubleShotDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedDoubleShotDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[DoubleShot] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 파이어 샷 전용 처리 (다른 화살 스킬과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isFireShotMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedFireShotDirX
		            end
		            local motionName = self._T.lockedFireShotMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedFireShotPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[FireShot] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isFireShotDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedFireShotDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[FireShot] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 아이스 샷 전용 처리 (다른 화살 스킬과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isIceShotMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedIceShotDirX
		            end
		            local motionName = self._T.lockedIceShotMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedIceShotPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[IceShot] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isIceShotDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedIceShotDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[IceShot] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 스트레이프 전용 처리 (다른 화살 스킬과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isStrafeMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedStrafeDirX
		            end
		            local motionName = self._T.lockedStrafeMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedStrafePlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[Strafe] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isStrafeDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedStrafeDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[Strafe] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 에로우 블로우 전용 처리 (아이언에로우와 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isArrowBlowMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedArrowBlowDirX
		            end
		            local motionName = self._T.lockedArrowBlowMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedArrowBlowPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[ArrowBlow] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isArrowBlowDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedArrowBlowDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[ArrowBlow] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 포이즌 미스트 전용 처리 (힐과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isPoisonMistMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedPoisonMistDirX
		            end
		            local motionName = self._T.lockedPoisonMistMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedPoisonMistPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[PoisonMist] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isPoisonMistDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedPoisonMistDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[PoisonMist] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 익스플로젼 전용 처리 (힐과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isExplosionMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedExplosionDirX
		            end
		            local motionName = self._T.lockedExplosionMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedExplosionPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[Explosion] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isExplosionDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedExplosionDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[Explosion] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 드래곤 로어 전용 처리 (익스플로젼과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isDragonRoarMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedDragonRoarDirX
		            end
		            local motionName = self._T.lockedDragonRoarMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedDragonRoarPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[DragonRoar] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isDragonRoarDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedDragonRoarDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[DragonRoar] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 스피어 버스터 전용 처리 (익스플로젼과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isSpearBurstMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedSpearBurstDirX
		            end
		            -- (기능 변경) 단일 액션(stabT2) 전체 재생 → 5단 조합 포즈로 바뀌면서, 지금 잡고 있어야
		            -- 할 포즈를 (액션 + 프레임) 그대로 다시 적용한다(새비지블로우 8단 조합과 동일한 패턴).
		            local action = self._T.lockedSpearBurstAction
		            if not action then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local frameIdx = self._T.lockedSpearBurstFrameIdx or 0
		            local motionEvent = ActionStateChangedEvent(action, action, 0.001, SpriteAnimClipPlayType.Onetime, frameIdx, frameIdx + 1)
		            body:SendEvent(motionEvent)
		            log("[SpearBurst] HandleStateChangeEvent re-applied pose over " .. tostring(event.CurrentStateName) .. ": " .. tostring(action) .. " frame=" .. tostring(frameIdx))
		            return
		        end
		        if self._T.isSpearBurstDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedSpearBurstDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[SpearBurst] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end
		        -- (버그 수정) "여러 스킬 사용 후 숨고르기가 발동하지 않는다"는 신고 - 원인은 여기 있던
		        -- StateChangeEvent 즉시-반응 방식이 각 스킬의 모션 정리용 IDLE→MOVE→IDLE 강제 토글(같은
		        -- 서버 호출 안에서 즉시 IDLE로 돌아가는 내부 정리 동작)까지 "실제 이동"으로 오인해, 숨고르기가
		        -- 시작되기도 전에 항상 취소해버리던 것이었다. 이동 감지는 OnUpdate에서 여러 프레임에 걸쳐
		        -- 지속되는 MOVE 상태만 진짜 이동으로 보는 폴링 방식으로 옮겼다(내부 토글은 한 프레임도 안 돼
		        -- 되돌아가므로 폴링에는 걸리지 않는다). 스킬 재사용으로 인한 중단은 각 Attack* 메서드 시작 시
		        -- StopBreather() 호출이 그대로 담당한다.


		        -- 헤이스트 전용 처리 (힐과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isHasteMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedHasteDirX
		            end
		            local motionName = self._T.lockedHasteMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedHastePlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[Haste] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isHasteDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedHasteDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[Haste] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end

		        -- 부스터 전용 처리 (힐과 동일한 패턴이지만 별도의 플래그를 사용 - 서로 간섭하지 않는다)
		        if self._T.isBoosterMotionPlaying then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedBoosterDirX
		            end
		            local motionName = self._T.lockedBoosterMotionName
		            if not motionName then return end
		            local avatarRenderer = self.Entity.AvatarRendererComponent
		            if not isvalid(avatarRenderer) then return end
		            local body = avatarRenderer:GetBodyEntity()
		            if not isvalid(body) then return end
		            local motionEvent = ActionStateChangedEvent(motionName, motionName, self._T.lockedBoosterPlayRate or 1.0, SpriteAnimClipPlayType.Onetime)
		            body:SendEvent(motionEvent)
		            log("[Booster] HandleStateChangeEvent re-applied motion over " .. tostring(event.CurrentStateName) .. ": " .. tostring(motionName))
		            return
		        end
		        if self._T.isBoosterDirectionLocked and event.CurrentStateName ~= "IDLE" then
		            local playerCtrl = self.Entity.PlayerControllerComponent
		            if isvalid(playerCtrl) then
		                playerCtrl.LookDirectionX = self._T.lockedBoosterDirX
		            end
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) then
		                sc:ChangeState("IDLE")
		                log("[Booster] HandleStateChangeEvent forced back to IDLE from " .. tostring(event.CurrentStateName))
		            end
		        end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		        -- Fire attack on "Attack" action
		        if event.ActionName == "Attack" then
		            self:AttackNormal()
		        end
	end

	@ExecSpace("ServerOnly")
	method void AttackDoubleStab(number combatPower, number atkMultiplier)
		        -- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		        self:StopBreather()
		        -- 더블스탭 발동: 파워스트라이크와 동일한 전방 박스 판정 구조를 재사용하되, 공격범위는 2/3로 좁히고
		        -- 럭키세븐처럼 같은 대상을 두 번 연속 찔러(2줄 스택 데미지 스킨) 단일 대상에게 타격한다.
		        -- 사다리/로프/사망 상태에서는 사용 불가 (다른 스킬과 동일 가드).
		        local currentState = self.Entity.StateComponent.CurrentStateName
		        if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
		            return
		        end
		        if self._T.isDoubleStabbing then
		            return
		        end
		        self._T.isDoubleStabbing = true

		        local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		        self._T.pendingDoubleStabCombatPower = combatPower

		        local playerCtrl = self.Entity.PlayerControllerComponent
		        local worldPos = self.Entity.TransformComponent.WorldPosition
		        local dirX = playerCtrl.LookDirectionX
		        self._T.pendingDoubleStabDirX = dirX

		        -- 단일 고정 표적: 방향(dirX)을 고려하는 전용 탐색(FindDoubleStabTarget)을 사용한다.
		        -- (파워스트라이크가 쓰는 FindNearestMonster는 방향을 보지 않아, 밀집 몬스터 구역에서 등 뒤의
		        -- 몬스터를 고르면 좁아진 전방 판정 박스가 빗나가는 문제가 있었다 - 럭키세븐과 동일한 방식으로 해결.)
		        self._T.doubleStabTarget = self:FindDoubleStabTarget(Vector2(worldPos.x, worldPos.y), dirX)

		        self._T.pendingDoubleStabWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		        if isvalid(playerCtrl) then
		            playerCtrl.Enable = false
		        end
		        if isvalid(self.Entity.MovementComponent) then
		            self.Entity.MovementComponent:Stop()
		        end

		        -- 스킬 사용 사운드 (더블 스탭 리소스팩 skill/400.img/skill/4001334의 "_audio/Use")
		        self:PlayDoubleStabUseSound(self.Entity)

		        -- 캐릭터 모션: 더블스탭은 단검으로 "찌르는" 모션이 맞아야 하므로, 알려진 찌르기(stab) 계열
		        -- 후보를 전부 모아 매 시전마다 순차 순환한다(GetDoubleStabStab) - 사용자가 실제 화면과
		        -- 로그(PlayDoubleStabMotion sent: <이름>)를 대조해 맞는 이름을 확인한다.
		        local swing = self:GetDoubleStabStab()
		        self:PlayDoubleStabMotion(self.Entity, swing.name, dirX, mult)

		        -- 1번째 찌르기는 파워스트라이크와 동일하게 0.45초 뒤, 2번째는 그 직후(0.15초 뒤, 공격속도 배율 적용)에 판정한다.
		        _TimerService:SetTimerOnce(function()
		            self:DealDoubleStabHit(1, mult)
		        end, 0.45 * mult)
		        _TimerService:SetTimerOnce(function()
		            self:DealDoubleStabHit(2, mult)
		        end, 0.60 * mult)

		        -- 컨트롤 잠금 해제: 파워스트라이크와 동일한 고정 여유분(0.65초 * 배율).
		        _TimerService:SetTimerOnce(function()
		            self:RestoreDoubleStabControl()
		        end, 0.65 * mult)
	end

	@ExecSpace("ServerOnly")
	method Entity FindDoubleStabTarget(Vector2 fromPos, number dirX)
		        -- 더블스탭 전용 대상 탐색: 럭키세븐(FindLuckySevenTarget)과 동일하게 바라보는 방향(dirX) 앞쪽에
		        -- 있는 몬스터만 후보로 삼는다. 파워스트라이크가 쓰는 FindNearestMonster는 방향과 무관하게 그냥
		        -- 가장 가까운 몬스터를 고르는데, 밀집 몬스터 구역에서 등 뒤의 몬스터를 고르면 좁아진(2/3) 전방
		        -- 판정 박스가 그 대상을 빗나가는 문제가 실제로 재현되어(테스트로 확인) 방향 필터가 필요했다.
		        local map = self.Entity.CurrentMap
		        if not isvalid(map) then return nil end
		        local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		        local boxSize = 2.0 * (2.0 / 3.0)
		        local nearest = nil
		        local nearestDist = boxSize
		        for _, comp in ipairs(monsterComps) do
		            ---@type Monster
		            local mc = comp
		            if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
		                local pos = mc.Entity.TransformComponent.WorldPosition
		                local dx = pos.x - fromPos.x
		                local dy = pos.y - fromPos.y
		                if dx * dirX >= 0 and math.abs(dx) <= boxSize and math.abs(dy) <= (boxSize / 2.0) then
		                    local dist = math.abs(dx)
		                    if dist <= nearestDist then
		                        nearest = mc.Entity
		                        nearestDist = dist
		                    end
		                end
		            end
		        end
		        return nearest
	end

	method table GetDoubleStabStab()
		        -- 더블스탭 전용 찌르기(stab) 모션 - 사용자가 실제 화면으로 재확인해 stabO1/stabO2 2개로 최종 확정.
		        -- 매 시전마다 이 둘 중 하나를 무작위로 골라 재생한다(파워스트라이크의 GetPowerStrikeSwing과 동일한 랜덤 방식).
		        local candidates = {
		            { name = "stabO1" },
		            { name = "stabO2" },
		        }
		        local index = _UtilLogic:RandomIntegerRange(1, #candidates)
		        return candidates[index]
	end

	@ExecSpace("Server")
	method void RestoreDoubleStabControl()
		        self._T.isDoubleStabbing = false
		        local playerCtrl = self.Entity.PlayerControllerComponent
		        if isvalid(playerCtrl) and self._T.pendingDoubleStabWasControllerEnabled then
		            playerCtrl.Enable = true
		        end
		        -- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		        -- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		        self:PlayBreather(self.Entity, self._T.pendingDoubleStabDirX or 1)
	end

	@ExecSpace("Server")
	method void DealDoubleStabHit(integer idx, number atkMultiplier)
		        -- 예약된 딜레이(0.45초/0.60초 * 배율) 뒤 호출되어 같은 단일 대상을 향해 전방 박스 판정을 1회 실행한다.
		        -- 대상이 1타에 이미 죽었더라도 2타 판정은 그대로 진행한다 - 럭키세븐과 동일하게, 1타가 오버킬이어도
		        -- 2줄 모두 표시되는 것이 의도된 동작이다(Monster.HandleHitEvent가 IsDead면 실제 Hp 적용만 막고,
		        -- 판정 자체는 DestroyDelay(0.6초) 전까지 유효해 정상적으로 명중 처리된다).
		        if not isvalid(self.Entity) then return end
		        local target = self._T.doubleStabTarget
		        if not isvalid(target) then return end

		        local dirX = self._T.pendingDoubleStabDirX or 1
		        local curWorldPos = self.Entity.TransformComponent.WorldPosition
		        -- 파워스트라이크 판정 박스(2x2, 오프셋 1.0*dirX)의 2/3 크기로 좁힌다. 오프셋도 박스 크기의 절반(=boxSize/2)으로
		        -- 동일한 비율을 유지해, 캐릭터 바로 앞에서 시작해 앞으로 boxSize만큼 뻗는 판정 형태를 그대로 보존한다.
		        local boxSize = 2.0 * (2.0 / 3.0)
		        local attackOffset = Vector2(
		            curWorldPos.x + (boxSize / 2.0) * dirX,
		            curWorldPos.y
		        )

		        -- PlayerAttack이 직접 판정한다 (전용 DoubleStabAttack 컴포넌트에 위임하던 방식은 제거됨 - 플레이어
		        -- 엔티티에 AttackComponent 상속 컴포넌트가 2개(PlayerAttack + DoubleStabAttack) 붙어 있으면
		        -- 엔진이 [LWA-3048] DuplicateComponent로 취급해 자동 데미지 스킨이 우리 수동 표시와 별개로
		        -- 추가 발동되어 "2줄이 2번(총 4줄)" 뜨는 문제가 실측됨. IsAttackTarget/CalcDamage/CalcCritical/
		        -- GetDisplayHitCount를 전부 attackInfo 분기로 PlayerAttack 하나에 합쳐서 이 충돌을 없앤다.)
		        local shape = BoxShape(attackOffset, Vector2(boxSize, boxSize), 0)
		        -- 대상의 DamageSkinSpawnerComponent를 판정 직전 잠깐 떼었다가 붙인다 - 이 컴포넌트가 붙어있는 채로
		        -- 같은 AttackComponent 인스턴스가 같은 대상에게 두 번 연속 Attack()을 걸면(더블스탭 1타/2타),
		        -- GetDisplayHitCount=0을 반환해도 엔진이 히트마다 자동 데미지 숫자를 하나씩 추가로 띄워
		        -- "2줄이 2번(총 4줄)" 뜨는 문제가 있었다(럭키세븐은 매 타격마다 별도 투사체 엔티티를 새로 스폰해
		        -- 이 문제가 없었음 - 동일 컴포넌트 인스턴스 재사용이 근본 원인으로 추정).
		        local targetSkinSpawner = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		        if isvalid(targetSkinSpawner) then target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent") end
		        local hitComps = self:Attack(shape, "skill.doublestab", CollisionGroups.HitBox)
		        if not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then target:AddComponent("MOD.Core.DamageSkinSpawnerComponent") end
		        local actuallyHit = false
		        for _, hc in ipairs(hitComps) do
		            if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
		                actuallyHit = true
		                break
		            end
		        end
		        local damage = self._T.lastDoubleStabDamage or 0
		        local baseCrit = self._T.lastDoubleStabIsCritical or false
		        local bonus = self._T.shadowEchoBonus or 0
		        local bonusCrit = self._T.shadowEchoBonusIsCritical or false
		        if not actuallyHit then
		            -- 대상이 1타에 이미 죽어 판정 자체가 실패해도(코르프스가 더 이상 충돌 판정에 걸리지 않음),
		            -- 럭키세븐과 동일하게 표시용 데미지를 동일 공식으로 새로 굴려 2줄이 항상 뜨도록 한다
		            -- (실제 Hp에는 영향 없는 표시 전용 값 - 이미 죽은 대상이므로 실제 데미지 적용은 불필요).
		            -- (버그 수정) "1타가 대상을 처치하면 2타는 항상 이 표시 전용 경로로 빠지는데, 크리티컬을
		            -- 통째로 꺼둬서 2번째 줄만 크리티컬이 거의 안 뜨는 것처럼 보였다"는 신고(럭키세븐에서
		            -- 동일 증상 실측) - 이 경로도 실제 히트와 동일하게 크리티컬을 독립적으로 굴린다. 또한
		            -- CalcDamage가 이번 호출에서 실행되지 않아 self._T.shadowEchoBonus가 이전 타격의 값을
		            -- 그대로 들고 있을 수 있어(stale), 쉐도우 파트너 보너스도 여기서 새로 굴린다.
		            local critRate = self:GetServerCritRatePercent() / 100
		            local critMult = (self._T.currentCritDamagePercent or 125) / 100
		            local mult = 1.0 + _UtilLogic:RandomDouble() * (2.6 - 1.0)
		            damage = math.floor((self._T.pendingDoubleStabCombatPower or 0) * mult)
		            -- 백스탭도 실제 히트와 같은 시전 판정으로 얹는다 - 이 표시 전용 경로에 안 얹으면 앞선 타격에
		            -- 대상이 죽은 뒤의 줄만 보너스가 빠져 "6줄 중 일부만 백스탭이 걸린 것처럼" 보인다.
		            damage = self:ApplyBackstabBonus(damage, self.Entity, target, "skill.doublestab")
		            baseCrit = _UtilLogic:RandomDouble() < critRate
		            if baseCrit then damage = math.floor(damage * critMult) end
		            bonus = 0
		            bonusCrit = false
		            if self._T.shadowPartnerActive then
		                bonus = math.floor(damage * (0.55 + _UtilLogic:RandomDouble() * 0.10))
		                bonusCrit = _UtilLogic:RandomDouble() < critRate
		                if bonusCrit then bonus = math.floor(bonus * critMult) end
		            end
		        end
		        self:ShowDoubleStabDamageSkin(target, damage, idx, bonus, baseCrit, bonusCrit)
		        if bonus > 0 then
		            self:PlayShadowEchoHitSound(target)
		        end
		        self:PlayDoubleStabHitEffect(target, dirX)
		        log("PlayerAttack: AttackDoubleStab hit idx=" .. tostring(idx) .. " actuallyHit=" .. tostring(actuallyHit) .. " damage=" .. tostring(damage))
	end

	@ExecSpace("Multicast")
	method void PlayDoubleStabUseSound(Entity attacker)
		        -- 더블 스탭 리소스팩(skill/400.img/skill/4001334)의 "_audio/Use" 사운드.
		        -- Multicast는 서버 자신도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
		        if not self:IsClient() then return end
		        if not isvalid(attacker) then return end
		        _SoundService:PlaySound("ca4f802052184c0ba47f6971fde80bd0", 1.0)
	end

	@ExecSpace("Client")
	method void ShowDoubleStabDamageSkin(Entity target, integer damage, integer hitIndex, integer bonus, boolean baseIsCritical, boolean bonusIsCritical)
		        -- 다른 스킬과 동일한 기본 히트 데미지 스킨(RUID)을 사용해 룩앤필을 통일한다.
		        -- 럭키세븐과 동일한 간격(±0.2)으로 1번째/2번째 찌르기가 위아래로 나뉘어 2줄로 쌓인 것처럼 보이게 한다.
		        if not isvalid(target) then return end
		        local offsetY = -0.2
		        -- (버그 수정) "원래 2줄 뜨던 스킬이 한 줄에 겹쳐 뜬다" - hitIndex==2일 때 offsetY를 아래로
		        -- 내리는 분기가 누락되어 1타/2타가 항상 같은 위치(-0.2)에서 겹쳐 떴다. 쉐도우 파트너 보너스가
		        -- 없을 때는 기존 ±0.2 배치를 그대로 복원한다.
		        if hitIndex == 2 then offsetY = 0.2 end
		        local bonusGap = 0.15
		        if bonus > 0 then
		            -- (기능 수정) "1줄->2줄"로 늘어난 스킬들의 간격(0.3)은 적절하지만, 원래 2줄이던 스킬이
		            -- 쉐도우 파트너로 4줄이 될 때는 기존 간격(±0.2, 보너스는 +0.15)이 좁아 보인다는 피드백.
		            -- 버프가 없을 때의 2줄 배치(-0.2/0.2)는 그대로 두고, 버프로 4줄이 될 때만 "1->2줄" 간격과
		            -- 동일한 0.3 단위로 전체를 -0.45/-0.15/0.15/0.45로 재배치해 4줄 모두 균등하게 벌린다.
		            offsetY = (hitIndex == 2) and 0.15 or -0.45
		            bonusGap = 0.3
		        end
		        -- (버그 수정) 쉐도우 파트너 보너스를 damages 배열에 같이 묶어 한 번에 Play()하면 두 숫자가
		        -- 같은 위치에서 시간차로만 분리돼(DelayPerAttack) "2줄이 겹쳐 보인다"는 문제가 있었다(스피어
		        -- 버스터에서 동일 증상 실측). 원본과 보너스를 서로 다른 offsetY를 가진 별도의 Play() 호출로
		        -- 나눠, 항상 공간적으로도 분리된 줄로 보이게 한다.
		        -- (버그 수정) "각자 크리티컬 여부를 독립적으로 판단해야 한다" - 하드코딩된 false 대신 각 줄에
		        -- 대해 CalcDamage에서 독립적으로 굴린 크리티컬 결과를 그대로 전달해 강조 표시가 실제와 맞게 한다.
		        _DamageSkinService:Play(
		            target, self:GetHitDamageSkinId(), 0,
		            { damage }, DamageSkinTweenType.Default, baseIsCritical,
		            Vector2(0, offsetY), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		        )
		        if bonus > 0 then
		            _DamageSkinService:Play(
		                target, self:GetHitDamageSkinId(), 0,
		                { bonus }, DamageSkinTweenType.Default, bonusIsCritical,
		                Vector2(0, offsetY + bonusGap), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		            )
		        end
		        log("[DoubleStab] ShowDoubleStabDamageSkin hitIndex=" .. tostring(hitIndex) .. " damage=" .. tostring(damage) .. " offsetY=" .. tostring(offsetY) .. " baseCrit=" .. tostring(baseIsCritical) .. " bonusCrit=" .. tostring(bonusIsCritical))
	end

	@ExecSpace("Client")
	method void PlayDoubleStabHitEffect(Entity target, number dirX)
		        -- 몬스터 몸에서 나타나는 타격 이펙트 (더블 스탭 리소스팩의 CharLevel/20/hit/0)
		        if not isvalid(target) then return end
		        local flipBack = dirX > 0
		        local hitOptions = { ["FlipX"] = flipBack }
		        local serial = _EffectService:PlayEffectAttached("8de01c7022964b1b9d6cf96070073446", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, hitOptions)
		        -- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
		        self:EchoShadowHitEffect("8de01c7022964b1b9d6cf96070073446", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), hitOptions)
		        -- 몬스터에 어태치된 이펙트가 자연 종료 전에 몬스터가 죽고(Enable=false) 다시 리젠(Enable=true)되면
		        -- 재생이 멈췄다가 리젠 순간 다시 보이는 문제가 있었다 - 짧은 타이머로 명시적으로 제거해 방지한다.
		        _TimerService:SetTimerOnce(function()
		            _EffectService:RemoveEffect(serial)
		        end, 0.5)
	end

	@ExecSpace("Multicast")
	method void PlayDoubleStabMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		        -- 더블스탭 전용 세부 모션 재생. 파워스트라이크(PlayAttackMotion)와 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		        if not self:IsClient() then return end
		        if not isvalid(attacker) then return end
		        local avatarRenderer = attacker.AvatarRendererComponent
		        if not isvalid(avatarRenderer) then return end
		        local body = avatarRenderer:GetBodyEntity()
		        if not isvalid(body) then return end

		        avatarRenderer.ShowDefaultWeaponEffects = false

		        local playerCtrl = attacker.PlayerControllerComponent
		        if isvalid(attacker.MovementComponent) then
		            attacker.MovementComponent:Stop()
		        end
		        if isvalid(playerCtrl) then
		            playerCtrl.LookDirectionX = dirX
		        end
		        self._T.isDoubleStabDirectionLocked = true
		        self._T.lockedDoubleStabDirX = dirX
		        self._T.lockedDoubleStabMotionName = motionName
		        self._T.isDoubleStabMotionPlaying = true

		        local mult = math.max(atkMultiplier or 1.0, 0.001)
		        local playRate = 1.0 / mult
		        self._T.lockedDoubleStabPlayRate = playRate

		        local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		        body:SendEvent(motionEvent)
		        log("[DoubleStab] PlayDoubleStabMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		        _TimerService:SetTimerOnce(function()
		            if isvalid(avatarRenderer) then
		                avatarRenderer.ShowDefaultWeaponEffects = true
		            end
		            self._T.isDoubleStabMotionPlaying = false
		        end, 0.60 * mult)

		        _TimerService:SetTimerOnce(function()
		            self._T.isDoubleStabDirectionLocked = false
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
		                sc:ChangeState("IDLE")
		                sc:ChangeState("MOVE")
		                sc:ChangeState("IDLE")
		            end
		        end, 0.80 * mult)
	end

	@ExecSpace("ServerOnly")
	method void AttackMagicClaw(number combatPower, number atkMultiplier)
		        -- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		        self:StopBreather()
		        -- 매직클로 발동: 럭키세븐과 같은 단일 대상·2타·2줄 스택 데미지 스킨이지만, 표창을 던지지 않고
		        -- 더블스탭처럼 그 자리에서 즉시 전방 판정으로 데미지를 준다(리소스/이펙트만 다름).
		        -- 사다리/로프/사망 상태에서는 사용 불가 (다른 스킬과 동일 가드).
		        local currentState = self.Entity.StateComponent.CurrentStateName
		        if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
		            return
		        end
		        if self._T.isMagicClawing then
		            return
		        end
		        self._T.isMagicClawing = true

		        local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		        self._T.pendingMagicClawCombatPower = combatPower

		        local playerCtrl = self.Entity.PlayerControllerComponent
		        local worldPos = self.Entity.TransformComponent.WorldPosition
		        local dirX = playerCtrl.LookDirectionX
		        self._T.pendingMagicClawDirX = dirX

		        -- (재피드백) 매직클로는 "바라보는 방향 전방의 타겟만" 공격한다 - 등 뒤 적으로 자동 방향
		        -- 전환하던 동작을 제거하고, 전방 범위 안에서 가장 가까운 적을 고르는 원래 방식으로 복원.
		        self._T.magicClawTarget = self:FindMagicClawTarget(Vector2(worldPos.x, worldPos.y), dirX)

		        self._T.pendingMagicClawWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		        if isvalid(playerCtrl) then
		            playerCtrl.Enable = false
		        end
		        if isvalid(self.Entity.MovementComponent) then
		            self.Entity.MovementComponent:Stop()
		        end

		        -- 스킬 사용 사운드 (즉시)
		        self:PlayMagicClawUseSound(self.Entity)
		        -- 스킬 시전 시작 이펙트 (사용자 몸에서 발현)
		        self:PlayMagicClawStartEffect(self.Entity, dirX)

		        local swing = self:GetMagicClawSwing()
		        self:PlayMagicClawMotion(self.Entity, swing.name, dirX, mult)

		        -- 1번째 할큄은 파워스트라이크와 동일하게 0.45초 뒤, 2번째는 0.1초 텀을 두고 0.55초 뒤에 판정한다.
		        _TimerService:SetTimerOnce(function()
		            self:DealMagicClawHit(1, mult)
		        end, 0.45 * mult)
		        _TimerService:SetTimerOnce(function()
		            self:DealMagicClawHit(2, mult)
		        end, 0.55 * mult)

		        -- 컨트롤 잠금 해제: 2번째 타격 직후(0.60초 * 배율).
		        _TimerService:SetTimerOnce(function()
		            self:RestoreMagicClawControl()
		        end, 0.60 * mult)
	end

	@ExecSpace("ServerOnly")
	method Entity FindMagicClawTarget(Vector2 fromPos, number dirX)
		        -- 매직클로 전용 대상 탐색: 바라보는 방향 전방(dx*dirX >= 0)의 살아있는 몬스터 중
		        -- 가장 가까운 하나를 고른다. (재피드백으로 "앞뒤 무관 최근접" 방식에서 전방 전용으로 복원 -
		        -- 등 뒤 적으로 자동 방향 전환하는 문제 제거.)
		        -- 사거리는 파워스트라이크 기준 박스(2칸) 대비 x축(전방) 2.5배·y축(위아래) 1.5배.
		        local map = self.Entity.CurrentMap
		        if not isvalid(map) then return nil end
		        local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		        local forwardSize = 2.0 * 2.5
		        local verticalSize = 2.0 * 1.5
		        local nearest = nil
		        local nearestDist = forwardSize
		        for _, comp in ipairs(monsterComps) do
		            ---@type Monster
		            local mc = comp
		            if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
		                local pos = mc.Entity.TransformComponent.WorldPosition
		                local dx = pos.x - fromPos.x
		                local dy = pos.y - fromPos.y
		                if dx * dirX >= 0 and math.abs(dx) <= forwardSize and math.abs(dy) <= (verticalSize / 2.0) then
		                    local dist = math.abs(dx)
		                    if dist <= nearestDist then
		                        nearest = mc.Entity
		                        nearestDist = dist
		                    end
		                end
		            end
		        end
		        return nearest
	end

	method table GetMagicClawSwing()
		        -- 매직클로 전용 모션 - 우선 럭키세븐과 동일한 swingO1/O2/O3(한손무기 계열, "아대"로 확인됐던 것과
		        -- 동일 계열)을 순차 순환시켜 사용자가 화면으로 확인 후 확정할 수 있게 한다.
		        local candidates = {
		            { name = "swingO1" },
		            { name = "swingO2" },
		            { name = "swingO3" },
		        }
		        self._T.magicClawSwingIndex = (self._T.magicClawSwingIndex or 0) % #candidates + 1
		        return candidates[self._T.magicClawSwingIndex]
	end

	@ExecSpace("Server")
	method void RestoreMagicClawControl()
		        self._T.isMagicClawing = false
		        local playerCtrl = self.Entity.PlayerControllerComponent
		        if isvalid(playerCtrl) and self._T.pendingMagicClawWasControllerEnabled then
		            playerCtrl.Enable = true
		        end
		        -- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		        -- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		        self:PlayBreather(self.Entity, self._T.pendingMagicClawDirX or 1)
	end

	@ExecSpace("Server")
	method void DealMagicClawHit(integer idx, number atkMultiplier)
		        -- 예약된 딜레이(0.45초/0.55초 * 배율) 뒤 호출되어 같은 단일 대상을 향해 전방 박스 판정을 1회 실행한다.
		        -- 더블스탭과 동일하게, 대상이 1타에 이미 죽었더라도 2타 판정은 그대로 진행해 럭키세븐과 같이
		        -- 1타가 오버킬이어도 2줄 모두 표시되도록 한다.
		        if not isvalid(self.Entity) then return end
		        local target = self._T.magicClawTarget
		        if not isvalid(target) then return end

		        local dirX = self._T.pendingMagicClawDirX or 1
		        local curWorldPos = self.Entity.TransformComponent.WorldPosition
		        -- FindMagicClawTarget과 동일한 사거리(x축 2.5배·y축 1.5배 확장)를 실제 판정 박스에도 적용한다.
		        local forwardSize = 2.0 * 2.5
		        local verticalSize = 2.0 * 1.5
		        local attackOffset = Vector2(
		            curWorldPos.x + (forwardSize / 2.0) * dirX,
		            curWorldPos.y
		        )

		        -- PlayerAttack이 직접 판정한다 (전용 MagicClawAttack 컴포넌트에 위임하던 방식은 제거됨 - 더블스탭과
		        -- 동일하게, 플레이어 엔티티에 AttackComponent 상속 컴포넌트가 2개 붙어 있으면 엔진이
		        -- [LWA-3048] DuplicateComponent로 취급해 자동 데미지 스킨이 추가로 발동되는 문제가 있었다.)
		        -- 대상의 DamageSkinSpawnerComponent도 판정 직전 잠깐 떼었다가 붙인다 - 더블스탭과 동일한 이유
		        -- (같은 AttackComponent 인스턴스로 같은 대상에게 두 번 연속 Attack()을 걸면 GetDisplayHitCount=0을
		        -- 반환해도 히트마다 자동 데미지 숫자가 추가로 뜨는 문제가 있었음 - 럭키세븐은 타격마다 별도
		        -- 투사체 엔티티를 새로 스폰해 이 문제가 없었던 것에서 착안).
		        local shape = BoxShape(attackOffset, Vector2(forwardSize, verticalSize), 0)
		        local targetSkinSpawner = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		        if isvalid(targetSkinSpawner) then target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent") end
		        local hitComps = self:Attack(shape, "skill.magicclaw", CollisionGroups.HitBox)
		        if not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then target:AddComponent("MOD.Core.DamageSkinSpawnerComponent") end
		        local actuallyHit = false
		        for _, hc in ipairs(hitComps) do
		            if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
		                actuallyHit = true
		                break
		            end
		        end
		        local damage = self._T.lastMagicClawDamage or 0
		        local magicClawBaseCrit = self._T.lastMagicClawIsCritical or false
		        local bonus = self._T.shadowEchoBonus or 0
		        local bonusCrit = self._T.shadowEchoBonusIsCritical or false
		        if not actuallyHit then
		            -- 대상이 1타에 이미 죽어 판정 자체가 실패해도, 럭키세븐과 동일하게 표시용 데미지를
		            -- 동일 공식으로 새로 굴려 2줄이 항상 뜨도록 한다(실제 Hp에는 영향 없는 표시 전용 값).
		            -- (버그 수정) 더블스탭과 동일한 이유로, 이 경로도 크리티컬을 독립적으로 굴리고
		            -- self._T.shadowEchoBonus의 stale 값 대신 쉐도우 파트너 보너스도 여기서 새로 굴린다.
		            local critRate = self:GetServerCritRatePercent() / 100
		            local critMult = (self._T.currentCritDamagePercent or 125) / 100
		            local mult = 1.0 + _UtilLogic:RandomDouble() * (1.5 - 1.0)
		            damage = math.floor((self._T.pendingMagicClawCombatPower or 0) * mult)
		            -- 백스탭도 실제 히트와 같은 시전 판정으로 얹는다 - 이 표시 전용 경로에 안 얹으면 앞선 타격에
		            -- 대상이 죽은 뒤의 줄만 보너스가 빠져 "6줄 중 일부만 백스탭이 걸린 것처럼" 보인다.
		            damage = self:ApplyBackstabBonus(damage, self.Entity, target, "skill.magicclaw")
		            magicClawBaseCrit = _UtilLogic:RandomDouble() < critRate
		            if magicClawBaseCrit then damage = math.floor(damage * critMult) end
		            bonus = 0
		            bonusCrit = false
		            if self._T.shadowPartnerActive then
		                bonus = math.floor(damage * (0.55 + _UtilLogic:RandomDouble() * 0.10))
		                bonusCrit = _UtilLogic:RandomDouble() < critRate
		                if bonusCrit then bonus = math.floor(bonus * critMult) end
		            end
		        end
		        self:ShowMagicClawDamageSkin(target, damage, idx, bonus, magicClawBaseCrit, bonusCrit)
		        if bonus > 0 then
		            self:PlayShadowEchoHitSound(target)
		        end
		        self:PlayMagicClawHitEffect(target, dirX)
		        log("PlayerAttack: AttackMagicClaw hit idx=" .. tostring(idx) .. " actuallyHit=" .. tostring(actuallyHit) .. " damage=" .. tostring(damage))
	end

	@ExecSpace("Multicast")
	method void PlayMagicClawUseSound(Entity attacker)
		        -- 매직클로 리소스팩(skill/800032.img/skill/80003294)의 사용 사운드. 사용 즉시 재생.
		        if not self:IsClient() then return end
		        if not isvalid(attacker) then return end
		        _SoundService:PlaySound("96edfa618f6a4fe4a4620a5c56eb93b6", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayMagicClawStartEffect(Entity attacker, number dirX)
		        -- 스킬 사용과 동시에 캐릭터 몸에서 발현되는 시작 이펙트
		        if not self:IsClient() then return end
		        if not isvalid(attacker) then return end
		        local startOptions = { ["FlipX"] = dirX > 0 }
		        _EffectService:PlayEffectAttached("2a0d72e836fb4862aae83087035f3d2a", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, startOptions)
		        -- 쉐도우 파트너: 같은 시작 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		        self:EchoShadowSkillEffectAttached("2a0d72e836fb4862aae83087035f3d2a", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), startOptions, dirX)
	end

	@ExecSpace("Client")
	method void ShowMagicClawDamageSkin(Entity target, integer damage, integer hitIndex, integer bonus, boolean baseIsCritical, boolean bonusIsCritical)
		        -- 다른 스킬과 동일한 기본 히트 데미지 스킨(RUID)을 사용해 룩앤필을 통일한다.
		        -- 럭키세븐/더블스탭과 동일한 간격(±0.2)으로 1번째/2번째 타격이 위아래로 나뉘어 2줄로 쌓인 것처럼 보이게 한다.
		        if not isvalid(target) then return end
		        local offsetY = -0.2
		        -- (버그 수정) 더블스탭과 동일한 원인 - hitIndex==2일 때 아래로 내리는 분기가 누락되어 1타/2타가
		        -- 항상 같은 위치(-0.2)에서 겹쳐 떴다. 쉐도우 파트너 보너스가 없을 때의 기존 ±0.2 배치를 복원한다.
		        if hitIndex == 2 then offsetY = 0.2 end
		        local bonusGap = 0.15
		        if bonus > 0 then
		            -- (기능 수정) 더블스탭과 동일한 이유 - 버프로 4줄이 될 때만 "1->2줄" 간격(0.3)과 동일한
		            -- 단위로 -0.45/-0.15/0.15/0.45로 재배치한다(버프가 없을 때의 2줄 배치는 그대로 유지).
		            offsetY = (hitIndex == 2) and 0.15 or -0.45
		            bonusGap = 0.3
		        end
		        -- (버그 수정) 더블스탭과 동일한 이유로 원본/보너스를 하나의 Play() 배열로 묶지 않고, 서로 다른
		        -- offsetY를 가진 별도의 Play() 호출로 나눠 겹쳐 보이지 않게 한다. 또한 각 줄의 크리티컬 여부도
		        -- 하드코딩된 false 대신 CalcDamage가 독립적으로 굴린 결과를 그대로 전달한다.
		        _DamageSkinService:Play(
		            target, self:GetHitDamageSkinId(), 0,
		            { damage }, DamageSkinTweenType.Default, baseIsCritical,
		            Vector2(0, offsetY), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		        )
		        if bonus > 0 then
		            _DamageSkinService:Play(
		                target, self:GetHitDamageSkinId(), 0,
		                { bonus }, DamageSkinTweenType.Default, bonusIsCritical,
		                Vector2(0, offsetY + bonusGap), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		            )
		        end
	end

	@ExecSpace("Client")
	method void PlayMagicClawHitEffect(Entity target, number dirX)
		        -- 맞는 몬스터 몸에서 나타나는 타격 이펙트 + 타격 사운드 (0.1초 텀을 두고 2번 재생됨 - 각 히트마다 1번씩)
		        if not isvalid(target) then return end
		        local flipBack = dirX > 0
		        local hitOptions = { ["FlipX"] = flipBack }
		        local serial = _EffectService:PlayEffectAttached("598d2d1859e84eaab18ae460a0a1e0a4", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, hitOptions)
		        -- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
		        self:EchoShadowHitEffect("598d2d1859e84eaab18ae460a0a1e0a4", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), hitOptions)
		        _SoundService:PlaySound("5f0c2e9b04ee4a3a9d493a863b8a1379", 1.0)
		        -- 몬스터에 어태치된 이펙트가 자연 종료 전에 몬스터가 죽고(Enable=false) 다시 리젠(Enable=true)되면
		        -- 재생이 멈췄다가 리젠 순간 다시 보이는 문제가 있었다 - 짧은 타이머로 명시적으로 제거해 방지한다.
		        _TimerService:SetTimerOnce(function()
		            _EffectService:RemoveEffect(serial)
		        end, 0.5)
	end

	@ExecSpace("Multicast")
	method void PlayMagicClawMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		        -- 매직클로 전용 모션 재생. 다른 스킬과 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		        if not self:IsClient() then return end
		        if not isvalid(attacker) then return end
		        local avatarRenderer = attacker.AvatarRendererComponent
		        if not isvalid(avatarRenderer) then return end
		        local body = avatarRenderer:GetBodyEntity()
		        if not isvalid(body) then return end

		        avatarRenderer.ShowDefaultWeaponEffects = false

		        local playerCtrl = attacker.PlayerControllerComponent
		        if isvalid(attacker.MovementComponent) then
		            attacker.MovementComponent:Stop()
		        end
		        if isvalid(playerCtrl) then
		            playerCtrl.LookDirectionX = dirX
		        end
		        self._T.isMagicClawDirectionLocked = true
		        self._T.lockedMagicClawDirX = dirX
		        self._T.lockedMagicClawMotionName = motionName
		        self._T.isMagicClawMotionPlaying = true
		        -- 홀드 지속발동 중 다음 시전이 쿨다운(0.75*mult)만큼 뒤에 시작될 수 있는데, 이 잠금 해제 타이머는
		        -- 그보다 늦은 0.80*mult 뒤에 실행된다. 새 시전이 이미 방향을 다시 잠근 뒤에 이전 시전의 해제
		        -- 타이머가 뒤늦게 실행되며 새 시전의 잠금을 잘못 풀어버려, 그 틈에 방향이 갑자기 바뀌는 문제가
		        -- 있었다(파워스트라이크에서 동일하게 발견·수정한 것과 같은 원인). 시전마다 토큰을 발급해
		        -- "그 사이 더 최근 시전이 없었을 때만" 해제한다.
		        self._T.magicClawLockToken = (self._T.magicClawLockToken or 0) + 1
		        local myMagicClawLockToken = self._T.magicClawLockToken

		        local mult = math.max(atkMultiplier or 1.0, 0.001)
		        local playRate = 1.0 / mult
		        self._T.lockedMagicClawPlayRate = playRate

		        local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		        body:SendEvent(motionEvent)
		        log("[MagicClaw] PlayMagicClawMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		        _TimerService:SetTimerOnce(function()
		            if isvalid(avatarRenderer) then
		                avatarRenderer.ShowDefaultWeaponEffects = true
		            end
		            self._T.isMagicClawMotionPlaying = false
		        end, 0.55 * mult)

		        _TimerService:SetTimerOnce(function()
		            if self._T.magicClawLockToken ~= myMagicClawLockToken then return end
		            self._T.isMagicClawDirectionLocked = false
		            local sc = self.Entity.StateComponent
		            if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
		                sc:ChangeState("IDLE")
		                sc:ChangeState("MOVE")
		                sc:ChangeState("IDLE")
		            end
		        end, 0.80 * mult)
	end

	@ExecSpace("ServerOnly")
	method void AttackTeleport(string direction)
		        -- 텔레포트: 즉시 순간이동 스킬 - 판정/데미지가 없고 모션 재생 딜레이도 없어 다른 스킬처럼 컨트롤러를 잠그지 않는다.
		        if not isvalid(self.Entity) then return end
		        local rb = self.Entity.RigidbodyComponent
		        if not isvalid(rb) then return end
		        local map = self.Entity.CurrentMap
		        if not isvalid(map) then return end
		        local fh = map.FootholdComponent
		        if not isvalid(fh) then return end

		        -- "짧은 거리를 순간이동한다"는 스킬 설명에 맞춰 다른 스킬 사거리(2.0~5.0)와 비슷한 수준으로 고정.
		        -- 기존 3.0 → 30% 감소로 2.1 → 사용자 요청으로 다시 10% 증가해 2.31로 조정.
		        local TELEPORT_DISTANCE = 2.31
		        -- 도착지점에 발판이 없을 때 위/아래로 이 거리 이내에 있는 발판을 대신 찾는다.
		        -- 기존 1.2에서 사용자 요청으로 절반(0.6)으로 축소 - 너무 높은/낮은 발판까지 끌어당겨지는 문제 완화.
		        local VERTICAL_TOLERANCE = 0.6
		        -- 발판 가장자리/벽에 딱 붙어 착지하지 않도록 살짝 여유를 둔다.
		        local EDGE_MARGIN = 0.15
		        -- 발판 표면에 살짝 파묻히지 않도록 위로 띄우는 높이 (다음 프레임에 중력이 바로 붙잡아준다).
		        local LAND_OFFSET = 0.05

		        local curPos3 = self.Entity.TransformComponent.WorldPosition
		        local curPos = Vector2(curPos3.x, curPos3.y)
		        local landing = nil

		        if direction == "up" or direction == "down" then
		            local dirY = (direction == "up") and 1 or -1
		            -- 현재 밟고 있는 발판 표면에서 그대로 위쪽으로 레이캐스트하면 자기 자신(현재 서있는 발판)을
		            -- 거리 0에서 다시 주워버리는 문제가 있다(한쪽면 충돌 판정) - 이동 방향으로 살짝 띄운 지점에서 시작한다.
		            local rayEpsilon = 0.05
		            local rayStart = Vector2(curPos.x, curPos.y + dirY * rayEpsilon)
		            -- 사거리 안에 발판이 여러 겹 있으면(예: 층층이 쌓인 발판) 가장 가까운 것이 아니라
		            -- 갈 수 있는 가장 먼 발판을 우선한다 - RaycastAll로 사거리 내 전부 찾아 거리가 최대인 것을 채택.
		            local hits = fh:RaycastAll(rayStart, Vector2(0, dirY), TELEPORT_DISTANCE - rayEpsilon)
		            local hit = nil
		            local farthestDist = -1
		            for _, h in ipairs(hits) do
		                local d = math.abs(h:GetYByX(curPos.x) - curPos.y)
		                if d > farthestDist then
		                    farthestDist = d
		                    hit = h
		                end
		            end
		            if hit ~= nil then
		                landing = Vector2(curPos.x, hit:GetYByX(curPos.x) + LAND_OFFSET)
		            end
		            -- 조건3: 거리 안에 발판이 없으면 사용 자체가 무효 - 사운드/이펙트도 재생하지 않는다.
		            if landing == nil then
		                log("[PlayerAttack] AttackTeleport 실패: " .. direction .. " 방향 " .. tostring(TELEPORT_DISTANCE) .. " 이내에 발판 없음")
		                return
		            end
		        else
		            local dirX = (direction == "left") and -1 or 1
		            local desiredX = curPos.x + dirX * TELEPORT_DISTANCE

		            -- 경로상에 진짜 벽(IsBlockVerticalLine=true)이 있으면 그 앞에서 멈추도록 목표 X를 앞당긴다.
		            -- 단순히 서로 다른 높이의 발판을 잇는 수직 연결선(절벽 가장자리, IsBlockVerticalLine=false)은
		            -- 실제로 이동을 막지 않으므로 벽으로 취급하지 않는다.
		            local wallHit = fh:Raycast(curPos, Vector2(dirX, 0), TELEPORT_DISTANCE)
		            if wallHit ~= nil and wallHit:IsVertical() and wallHit.IsBlockVerticalLine then
		                local wallX = wallHit:GetCenter().x
		                local clampedByWall = wallX - dirX * EDGE_MARGIN
		                if (dirX > 0 and clampedByWall < desiredX) or (dirX < 0 and clampedByWall > desiredX) then
		                    desiredX = clampedByWall
		                end
		            end

		            -- 조건1: 도착지점에 발판이 없으면 위아래 근접 발판을 찾는다.
		            local nearFh = self:FindNearbyFootholdAtX(fh, desiredX, curPos.y, VERTICAL_TOLERANCE)
		            if nearFh ~= nil then
		                landing = Vector2(desiredX, nearFh:GetYByX(desiredX) + LAND_OFFSET)
		            else
		                -- 조건2: 지금 서있는 발판이 목표 거리보다 먼저 끝나면 끝나는 지점까지만 이동한다.
		                local curFh = rb:GetCurrentFoothold()
		                if curFh ~= nil then
		                    -- 같은 지면이 여러 조각(발판 ID)으로 나뉘어 있을 수 있으므로, 지금 밟은 조각의
		                    -- StartPoint/EndPoint만 보지 않고 이동 방향으로 NextFootholdId/PreviousFootholdId
		                    -- 체인을 바라가며 실제로 지면이 끊기는 진짜 가장자리를 찾는다.
		                    local chainFh = curFh
		                    local farEdgeX = (dirX > 0) and math.max(curFh.StartPoint.x, curFh.EndPoint.x) or math.min(curFh.StartPoint.x, curFh.EndPoint.x)
		                    for _ = 1, 50 do
		                        if (dirX > 0 and farEdgeX >= desiredX) or (dirX < 0 and farEdgeX <= desiredX) then break end
		                        local nextId = (dirX > 0) and chainFh.NextFootholdId or chainFh.PreviousFootholdId
		                        if nextId == nil or nextId == 0 then break end
		                        local nextFh = fh:GetFoothold(nextId)
		                        if nextFh == nil then break end
		                        chainFh = nextFh
		                        farEdgeX = (dirX > 0) and math.max(nextFh.StartPoint.x, nextFh.EndPoint.x) or math.min(nextFh.StartPoint.x, nextFh.EndPoint.x)
		                    end
		                    local clampedX = farEdgeX - dirX * EDGE_MARGIN
		                    local reachesFullDistance = (dirX > 0 and clampedX >= desiredX) or (dirX < 0 and clampedX <= desiredX)
		                    if not reachesFullDistance then
		                        -- 축소된 지점에서도 위아래 발판을 다시 확인한다 (조건2의 "그 지점에서도 위아래 발판 구분" 요구사항).
		                        local nearFh2 = self:FindNearbyFootholdAtX(fh, clampedX, curPos.y, VERTICAL_TOLERANCE)
		                        if nearFh2 ~= nil then
		                            landing = Vector2(clampedX, nearFh2:GetYByX(clampedX) + LAND_OFFSET)
		                        else
		                            landing = Vector2(clampedX, curFh:GetYByX(clampedX) + LAND_OFFSET)
		                        end
		                    end
		                end
		            end

		            if landing == nil then
		                log("[PlayerAttack] AttackTeleport 실패: " .. direction .. " 방향에 착지 가능한 발판 없음")
		                return
		            end
		        end

		        if isvalid(self.Entity.MovementComponent) then
		            self.Entity.MovementComponent:Stop()
		        end
		        -- 실측 결과: SetWorldPosition을 짧은 시간 동안 여러 프레임에 걸쳐 나눠 호출하는 "대시" 방식을 시도했으나,
		        -- 몇 틱 뒤 위치가 원래 자리로 되돌아가는 현상이 재현됨(엔진의 물리/동기화 쪽에서 반복적인 위치
		        -- 갱신을 되돌리는 것으로 추정 - 정확한 내부 매커니즘은 불명). 한 번만 호출하는 방식은 이 세션
		        -- 내내 안정적으로 확인되었으므로, 검증된 단일 호출 방식을 유지한다.
		        rb:SetWorldPosition(landing)
		        self:PlayTeleportEffects(self.Entity, curPos)
		        log("[PlayerAttack] AttackTeleport 성공! direction=" .. direction .. " from=(" .. tostring(curPos.x) .. "," .. tostring(curPos.y) .. ") to=(" .. tostring(landing.x) .. "," .. tostring(landing.y) .. ")")
	end

	method Foothold FindNearbyFootholdAtX(FootholdComponent fh, number x, number y, number tolerance)
		        -- 지정한 x좌표에서 위/아래로 tolerance 거리 이내에 있는 가장 가까운 발판을 찾는다 (없으면 nil).
		        -- 이 지점이 마침 어떤 발판과 정확히 겹쳐 거리 0으로 찾아지는 것은 정상(그 발판 위에 착지)이므로,
		        -- AttackTeleport의 위/아래 이동 분기와 달리 여기서는 시작점을 띄우지 않는다.
		        local upHit = fh:Raycast(Vector2(x, y), Vector2(0, 1), tolerance)
		        local downHit = fh:Raycast(Vector2(x, y), Vector2(0, -1), tolerance)
		        if upHit ~= nil and downHit ~= nil then
		            local upDist = math.abs(upHit:GetYByX(x) - y)
		            local downDist = math.abs(downHit:GetYByX(x) - y)
		            if upDist <= downDist then return upHit end
		            return downHit
		        elseif upHit ~= nil then
		            return upHit
		        elseif downHit ~= nil then
		            return downHit
		        end
		        return nil
	end
	@ExecSpace("Multicast")
	method void PlayTeleportEffects(Entity attacker, Vector2 originPos)
		        -- 텔레포트 사용 사운드 + 이동 전 위치에 잠깐 나타나는 잔상 이펙트. Multicast는 서버도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
		        if not self:IsClient() then return end
		        if not isvalid(attacker) then return end
		        _SoundService:PlaySound("4c1eb6001e9c47eda239cc58443b79cd", 1.0)
		        local serial = _EffectService:PlayEffect("b34e818d784f4a3891c2d50e48ca559d", attacker, Vector3(originPos.x, originPos.y, 0), 0, Vector3(1, 1, 1), false, {})
		        -- 쉐도우 파트너: 텔레포트 잔상 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫)
		        local echoSerial = self:EchoShadowSkillEffect("b34e818d784f4a3891c2d50e48ca559d", Vector3(originPos.x, originPos.y, 0), 0, Vector3(1, 1, 1), {}, 0)
		        _TimerService:SetTimerOnce(function()
		            _EffectService:RemoveEffect(serial)
		            if echoSerial ~= 0 then
		                _EffectService:RemoveEffect(echoSerial)
		            end
		        end, 0.1)
		        -- 텔레포트 전용 카메라 제어(Damping 임시 조정)는 사용자 요청으로 제거함 - 기본 카메라 동작만 남긴다.
	end

	@ExecSpace("ServerOnly")
	method void AttackThunderbolt(number combatPower, number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 썬더볼트 발동: 방향(앞/뒤) 무관하게 캐릭터 주변의 몬스터 최대 6명을 동시에 타격한다.
		-- 사다리/로프/사망 상태에서는 사용 불가 (다른 스킬과 동일 가드).
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isThunderbolting then
			return
		end
		self._T.isThunderbolting = true

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingThunderboltCombatPower = combatPower

		local playerCtrl = self.Entity.PlayerControllerComponent
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = playerCtrl.LookDirectionX
		self._T.pendingThunderboltDirX = dirX

		-- 방향과 무관하게 앞뒤 모두에서 가까운 순으로 최대 6명을 미리 골라둔다 (실제 Attack 판정 없이 위치만으로 탐색).
		local targets = self:FindThunderboltTargets(Vector2(worldPos.x, worldPos.y), 6)
		self._T.thunderboltTargets = targets

		self._T.pendingThunderboltWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 스킬 사용 사운드 + 몸쪽 시전 이펙트 (즉시, 1회) + 캐릭터 모션(매직클로와 동일한 후보군/재생 방식)
		self:PlayThunderboltUseSound(self.Entity)
		self:PlayThunderboltStartEffect(self.Entity, dirX)
		local swing = self:GetThunderboltSwing()
		self:PlayThunderboltMotion(self.Entity, swing.name, dirX, mult)

		-- 딜레이 후 미리 골라둔 대상 전원에게 동시에 타격 판정 + 이펙트를 발생시킨다
		-- (슬래쉬블래스트처럼 대상마다 나눠서 순차 타격하는 것이 아니라, 같은 프레임 안에서 한꺼번에 처리).
		_TimerService:SetTimerOnce(function()
			self:DealThunderboltHits(targets)
		end, 0.4 * mult)

		-- 컨트롤 잠금 해제: 타격 판정 직후 여유(0.2초)를 두고, 배율을 적용한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreThunderboltControl()
		end, 0.6 * mult)
	end

	@ExecSpace("ServerOnly")
	method table FindThunderboltTargets(Vector2 fromPos, integer maxCount)
		-- 썬더볼트 대상 선정: 다른 스킬과 달리 방향(dirX) 무관 - 앞뒤 판정 범위(가로 6칸, 세로 1칸) 안의
		-- 살아있는 script.Monster를 가까운 순으로 정렬해 최대 maxCount명까지 후보로 반환한다
		-- (실제 Attack 판정 없이 위치만으로 탐색). 좌우(가로) 범위는 기존 2.0에서 사용자 요청으로 1.5배인 3.0으로 확대.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 3.0 and math.abs(dy) <= 1.0 then
					table.insert(candidates, { entity = mc.Entity, dist = math.abs(dx) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	@ExecSpace("Server")
	method void RestoreThunderboltControl()
		self._T.isThunderbolting = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingThunderboltWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingThunderboltDirX or 1)
	end

	@ExecSpace("Server")
	method void DealThunderboltHits(table targets)
		-- 예약된 딜레이 뒤 호출되어, 미리 골라둔 대상 전원에게 같은 프레임 안에서 동시에 타격 판정과
		-- 이펙트를 발생시킨다 (슬래쉬블래스트처럼 대상마다 나눠서 순차 타격하지 않음).
		if not isvalid(self.Entity) then return end
		local hitIndex = 0
		for _, target in ipairs(targets) do
			if isvalid(target) then
				-- 이번 Attack() 호출은 이 대상 하나만 통과하도록 지정 (몬스터 밀집 지역에서 이웃까지
				-- 겹쳐 중복 피해가 들어가는 것을 방지 - IsAttackTarget의 thunderboltCurrentTarget 체크 참고).
				self._T.thunderboltCurrentTarget = target
				local targetPos = target.TransformComponent.WorldPosition
				local shape = CircleShape(Vector2(targetPos.x, targetPos.y), 0.6)
				local hitComps = self:AttackShadowSafe(shape, "skill.thunderbolt", target)
				local actuallyHit = false
				for _, hc in ipairs(hitComps) do
					if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
						actuallyHit = true
						break
					end
				end
				if actuallyHit then
					-- 피격 이펙트/데미지는 동시에 처리하되, 타격음만 맞은 순서대로 0.04초 간격으로 재생한다
					-- (예: 6마리가 맞으면 0.04초 간격으로 6번 소리가 들림).
					self:PlayThunderboltHitEffect(target)
					local soundDelay = hitIndex * 0.04
					_TimerService:SetTimerOnce(function()
						self:PlayThunderboltHitSound()
					end, soundDelay)
					hitIndex = hitIndex + 1
				end
			end
		end
		log("PlayerAttack: AttackThunderbolt " .. tostring(#targets) .. "명 동시 타격, 실제 명중 " .. tostring(hitIndex) .. "명")
	end

	@ExecSpace("Multicast")
	method void PlayThunderboltUseSound(Entity attacker)
		-- 스킬 사용 즉시 재생되는 사운드. Multicast는 서버 자신도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("3a8cf5d7d10f47f79f7bc9bdad81a746", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayThunderboltStartEffect(Entity attacker, number dirX)
		-- 스킬 사용과 동시에 캐릭터 몸에서 발현되는 시작 이펙트 (1회).
		-- 오프셋: 캐릭터 살짝 앞쪽 위에 있던 것을 사용자 요청으로 살짝 아래·몸쪽으로 이동 -
		-- x는 0.2*dirX(앞쪽으로 치우침) → 0.08*dirX(몸에 더 가깝게), y는 0.15 → 0.0으로 낮춤.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local startOptions = { ["FlipX"] = dirX > 0 }
		_EffectService:PlayEffectAttached("7b1fbc817b9a478e9f5c384dfc1a7176", attacker, Vector3(0.08 * dirX, 0.0, 0), 0, Vector3(1, 1, 1), false, startOptions)
		-- 쉐도우 파트너: 같은 시작 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("7b1fbc817b9a478e9f5c384dfc1a7176", attacker, Vector3(0.08 * dirX, 0.0, 0), 0, Vector3(1, 1, 1), startOptions, dirX)
	end

	method table GetThunderboltSwing()
		-- 매직클로와 동일한 모션 후보군(swingO1/O2/O3, 한손무기 계열)을 그대로 사용해 매 시전마다 순환 재생한다.
		local candidates = {
			{ name = "swingO1" },
			{ name = "swingO2" },
			{ name = "swingO3" },
		}
		self._T.thunderboltSwingIndex = (self._T.thunderboltSwingIndex or 0) % #candidates + 1
		return candidates[self._T.thunderboltSwingIndex]
	end

	@ExecSpace("Multicast")
	method void PlayThunderboltMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 썬더볼트 전용 모션 재생. 매직클로(PlayMagicClawMotion)와 완전히 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isThunderboltDirectionLocked = true
		self._T.lockedThunderboltDirX = dirX
		self._T.lockedThunderboltMotionName = motionName
		self._T.isThunderboltMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedThunderboltPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[Thunderbolt] PlayThunderboltMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isThunderboltMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isThunderboltDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Multicast")
	method void PlayThunderboltHitEffect(Entity target)
		-- 타격받는 몬스터 머리 위에 나타나는 이펙트 (대상마다 1회, 전원 동시에 재생됨).
		-- 높이 오프셋은 기존 0.6에서 사용자 요청으로 조금 낮춰 0.3으로 조정.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("bb8d0c3c8b9940dfa5e4678bc642fa8d", target, Vector3(0, 0.3, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
		self:EchoShadowHitEffect("bb8d0c3c8b9940dfa5e4678bc642fa8d", target, Vector3(0, 0.3, 0), 0, Vector3(1, 1, 1), {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayThunderboltHitSound()
		-- 몬스터 타격음. 맞은 몬스터 수만큼, 0.04초 간격으로 순서대로 재생된다
		-- (호출 시점 자체가 DealThunderboltHits에서 인덱스*0.04초 딜레이로 예약되어 있음).
		if not self:IsClient() then return end
		_SoundService:PlaySound("d3205fdd08e34b68bc01292a997531ed", 1.0)
	end

	-- ── 샤이닝 레이 (3차) ────────────────────────────────────────────────
	-- 사용자 제공 클래식 아트(패딩 정렬본) - RUID 대응표: msw-dev-tools/resources/샤이닝레이/RUID.md
	-- effect(시전자 광휘 16장)와 sineffect(하늘 광선 20장)를 같은 서버 프레임에 스폰해 "동시에 시작"시킨다(사용자 요구).
	-- 판정은 드래곤 로어의 절반 범위(가로 ±7.5 / 세로 ±3.75) 안 최대 30명, 전투력의 800%~1000%(CalcDamageBase 참고), 쿨타임 1분(SkillManager).

	method table BuildShiningRayEffectFrames()
		-- 시전자 광휘(effect) 16장 - 패딩 정렬(240x274, origin(126,126))이라 단일 위치 (x=-0.06, y=-0.11)로 재생(프레임별 이동 0).
		local ruids = {
			"c67a743ca1934626ad2f7744062ec14f",
			"69042e2218c6446db879e9be6db7ef3b",
			"9139599c677b405490757c9ae77bbd93",
			"d34afae34a3c4a3abe2bacbad32edc43",
			"151d9a3a646e4099882a988b4d0a5aba",
			"49aeecc1218f4a40a0ffbc7e6277451c",
			"c7b9c30f7bc14979af7eef57e86d0023",
			"1eb118d660d440659ca819c6e19a37c8",
			"4da33ae59d2746cd9d4ded4809f0d504",
			"bbfb9ff38749410b8c4fb04bbe518e55",
			"4248fdf44677473ebd33434b7434dc4e",
			"d508da81ddb447928ea3aca807b6aa17",
			"2cdc5bd1aee34c4c8d7458f4673f418a",
			"fcdd9956f4784311a2655dcfb121994e",
			"45d4dfdffe0b4281b95781967a03bd11",
			"79b47a455b5944b5a79bf9e4259647b7",
		}
		return self:MakeConstantFrames(ruids, -0.06, -0.11, 6)
	end

	method table BuildShiningRaySineffectFrames()
		-- 하늘 광선(sineffect) 20장 - 패딩 정렬(752x532, origin(380,375)) → 단일 위치 (x=-0.04, y=1.09).
		-- 시전자 광휘(order 6)보다 뒤(order 5)에 깔린다.
		local ruids = {
			"0a9e7d58c1cf4116bb2baa56c1bbff3a",
			"b1dcbc8511314d458f57f5bad122ee3e",
			"c6c35c45c07f45a294119279dc310c5f",
			"00ff7680a5174ed795595a940fcade2f",
			"ae477b7187524ecfb23ce79aea4c1574",
			"6e63529a524e4626a1036d7851758178",
			"b45a268669e946f0afa8f917d100c6c8",
			"c1e0f9d495354586bbeb6e31809a22d5",
			"f4acad30463f431d9be8a1c0540ea525",
			"ba7adc4c48a343ec8b23b33a2110c360",
			"3c2a7fc354a848e69a61b73bce57fd95",
			"e6b5c3d0076c47fcb2dfd46ccd855998",
			"e9084f7b6c7f4bb28b32fe5ee0aa3475",
			"d21d62a474464af49955fbb05564d94a",
			"32b7809b396e4ec1a4dc32d68ed4befc",
			"075e01d0741c4dd1a066669adfced6bc",
			"693d8428b7754d1c87458e7c6ae0e809",
			"117e9e94c6984f438af8faf6d74d52ee",
			"a96d3c814ac0425481332c9ff87e2ba0",
			"245de9ba93a446ec85fab3ba817fc5a5",
		}
		return self:MakeConstantFrames(ruids, -0.04, 1.09, 5)
	end

	method table BuildShiningRayHitFrames()
		-- 피격(hit) 8장 - 패딩 정렬(222x216, origin(108,106)) ≈ 중앙. 대상 몸통 높이(y≈0.4)에 얹는다.
		local ruids = {
			"6648e74d13164cde9df9f5278d547002",
			"cfee3131ed4546a2920de5e240f6a054",
			"e5a3e22eb0b14b56afe18b28f15c7151",
			"d24b9dd8082b4b23a5085d0125461846",
			"c197b42c5d9f4affbd49354555f9e4e5",
			"e2b6a3e05fe0430e8b8beb44aca514bc",
			"961ac75e651048e5a62f209c40355199",
			"ae3393a5eb7c48cea2cc4bc216334a49",
		}
		return self:MakeConstantFrames(ruids, 0.03, 0.38, 6)
	end

	method table GetShiningRaySwing()
		-- 매직클로/썬더볼트와 동일한 모션 후보군(swingO1/O2/O3)을 자체 인덱스로 순환 재생한다.
		local candidates = {
			{ name = "swingO1" },
			{ name = "swingO2" },
			{ name = "swingO3" },
		}
		self._T.shiningRaySwingIndex = (self._T.shiningRaySwingIndex or 0) % #candidates + 1
		return candidates[self._T.shiningRaySwingIndex]
	end

	@ExecSpace("ServerOnly")
	method void AttackShiningRay(number combatPower, number atkMultiplier)
		-- 샤이닝 레이(3차): 주변 전방위(드래곤 로어의 절반 범위) 최대 30명에게 전투력의 800%~1000% 피해.
		-- effect+sineffect를 같은 서버 프레임에 스폰해 동시에 시작시키고, 광선이 완전히 형성되는 시점(0.5초)에 동시 타격한다.
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 다른 스킬과 동일하게 정리.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isShiningRaying then
			log("PlayerAttack: AttackShiningRay 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isShiningRaying = true

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingShiningRayCombatPower = combatPower

		local playerCtrl = self.Entity.PlayerControllerComponent
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingShiningRayDirX = dirX

		-- 방향과 무관하게 전방위에서 가까운 순으로 최대 30명을 미리 골라둔다 (실제 Attack 판정 없이 위치만으로 탐색).
		local targets = self:FindShiningRayTargets(Vector2(worldPos.x, worldPos.y), 30)

		self._T.pendingShiningRayWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		self:PlayShiningRayUseSound()
		self:PlayShiningRayCastEffect(dirX)
		local swing = self:GetShiningRaySwing()
		-- (요청 2026-07-29) 사용속도 1/2: 모션도 절반 속도로 재생되도록 배율을 2배로 넘긴다(playRate = 1/(2*mult)).
		self:PlayShiningRayMotion(self.Entity, swing.name, dirX, mult * 2.0)

		-- 광선(sineffect)이 완전히 형성되는 시점에 미리 골라둔 대상 전원에게 동시에 타격 판정을 넣는다.
		-- (요청 2026-07-29) 사용속도 1/2: 이펙트가 절반 속도(프레임당 120ms)가 되면서 타격 시점도 0.5→1.0초로 늦춘다.
		_TimerService:SetTimerOnce(function()
			self:DealShiningRayHits(targets)
		end, 1.0 * mult)

		-- 컨트롤 잠금 해제: 시전 연출이 대부분 끝난 뒤 풀어준다. (사용속도 1/2에 맞춰 0.9→1.8초)
		_TimerService:SetTimerOnce(function()
			self:RestoreShiningRayControl()
		end, 1.8 * mult)

		log("PlayerAttack: AttackShiningRay 시전! targets=" .. tostring(#targets))
	end

	@ExecSpace("ServerOnly")
	method table FindShiningRayTargets(Vector2 fromPos, integer maxCount)
		-- 샤이닝 레이 전용 판정 범위(전방위 - 방향 무관) 안의 살아있는 script.Monster를 가까운 순으로
		-- 최대 maxCount명까지 반환한다. FindDragonRoarTargets와 같은 구조이지만 범위가 절반
		-- (가로 15.0→7.5, 세로 7.5→3.75)이라 별도 함수로 분리한다(드래곤 로어 쪽 범위는 그대로 유지).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 7.5 and math.abs(dy) <= 3.75 then
					-- 몬스터가 많을 때 진짜 가까운 순으로 뽑히도록 실제 유클리드 거리로 정렬한다.
					table.insert(candidates, { entity = mc.Entity, dist = math.sqrt(dx * dx + dy * dy) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	@ExecSpace("Server")
	method void RestoreShiningRayControl()
		self._T.isShiningRaying = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingShiningRayWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingShiningRayDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void DealShiningRayHits(table targets)
		-- 광선 형성 시점에 호출되어, 미리 골라둔 대상 전원에게 같은 프레임 안에서 동시에 타격 판정과
		-- 피격 이펙트를 발생시킨다 (썬더볼트와 동일 - 대상마다 나눠 순차 타격하지 않음).
		if not isvalid(self.Entity) then return end
		local hitIndex = 0
		local hitCount = 0
		for _, target in ipairs(targets) do
			if isvalid(target) then
				-- 이번 Attack() 호출은 이 대상 하나만 통과하도록 지정 (밀집 지역에서 이웃까지
				-- 겹쳐 중복 피해가 들어가는 것을 방지 - IsAttackTarget의 shiningRayCurrentTarget 체크 참고).
				self._T.shiningRayCurrentTarget = target
				local targetPos = target.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(targetPos.x, targetPos.y), Vector2(1.0, 1.6), 0)
				local hitComps = self:AttackShadowSafe(shape, "skill.shiningray", target)
				local actuallyHit = false
				for _, hc in ipairs(hitComps) do
					if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
						actuallyHit = true
						break
					end
				end
				if actuallyHit then
					hitCount = hitCount + 1
					self:PlayShiningRayHitEffect(target)
					-- 타격음은 맞은 순서대로 0.04초 간격으로 재생하되, 30명이 다 맞으면 너무 시끄러우므로 최대 10회까지만.
					if hitIndex < 10 then
						local soundDelay = hitIndex * 0.04
						_TimerService:SetTimerOnce(function()
							self:PlayShiningRayHitSound()
						end, soundDelay)
					end
					hitIndex = hitIndex + 1
				end
			end
		end
		log("PlayerAttack: AttackShiningRay 발동! 적중=" .. tostring(hitCount) .. "/" .. tostring(#targets))
	end

	@ExecSpace("ServerOnly")
	method void PlayShiningRayCastEffect(number dirX)
		-- effect(시전자 광휘)와 sineffect(하늘 광선)를 같은 서버 프레임에 스폰 → 두 시퀀스가 동시에 시작된다(사용자 요구).
		-- (요청 2026-07-29) 사용속도 1/2: ori.txt 실측 60ms의 2배인 프레임당 120ms로 재생. 끝나면 마지막 프레임에서 0.15초 페이드아웃.
		self:SpawnBuffFrameEffectEx(self:BuildShiningRaySineffectFrames(), dirX, 0.12, 0.15, self.Entity, 1.0, 1.0, 1.0)
		self:SpawnBuffFrameEffectEx(self:BuildShiningRayEffectFrames(), dirX, 0.12, 0.15, self.Entity, 1.0, 1.0, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void PlayShiningRayHitEffect(Entity target)
		-- 샤이닝 레이에 맞은 몬스터 몸통 위치에 hit 8장을 프레임 교체로 재생한다(패딩 정렬본 - 흔들림 없음).
		-- (요청 2026-07-29) 사용속도 1/2: 피격 이펙트도 시전과 동일하게 절반 속도(프레임당 120ms)로 맞춘다.
		-- (요청 2026-07-29) 투명도 70%: SpawnBuffFrameEffectEx는 재생 중 알파가 1.0으로 고정이라,
		-- 같은 spearburstfadingeffect를 직접 스폰해 StartAlpha=0.7을 준다(궤적 이펙트들의 기존 패턴).
		if not isvalid(target) then return end
		local frames = self:BuildShiningRayHitFrames()
		local f0 = frames[1]
		if f0 == nil then return end
		local interval = 0.12
		local playTime = #frames * interval
		self._T.shiningRayHitFxSeq = (self._T.shiningRayHitFxSeq or 0) + 1
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "ShiningRayHitFx" .. tostring(self._T.shiningRayHitFxSeq), Vector3(0, 0, 0), target)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.StartAlpha = 0.7          -- (요청) 피격 이펙트 투명도 70%
			comp.EndAlpha = 0.0
			comp.HoldDuration = playTime   -- 재생 동안 알파 0.7 유지
			comp.TweenDuration = 0.1       -- 재생 후 짧은 페이드아웃
			comp.OrderInLayerValue = f0.order or 6
			comp.UseFrameLocalPos = true
			comp.FrameLocalPos = Vector2(f0.x or 0, f0.y or 0)
			comp.ClipRUID = f0.ruid
		end
		for i = 2, #frames do
			local fr = frames[i]
			_TimerService:SetTimerOnce(function()
				if not isvalid(comp) then return end
				comp.ClipRUID = fr.ruid
			end, (i - 1) * interval)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, playTime + 0.2)
	end

	@ExecSpace("Multicast")
	method void PlayShiningRayUseSound()
		-- 사용음: 라이브러리 원본 팩 skill/231.img/skill/2311004의 _audio/Use.
		if not self:IsClient() then return end
		_SoundService:PlaySound("6f972ab4e14841398281f3fc2a8f376e", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayShiningRayHitSound()
		-- 적중음: 같은 팩(2311004)의 _audio/Hit. 맞은 순서대로 0.04초 간격(최대 10회)으로 재생된다.
		if not self:IsClient() then return end
		_SoundService:PlaySound("01cd44c5de6d45cfbf47938e26243452", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayShiningRayMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 샤이닝 레이 전용 모션 재생. 썬더볼트(PlayThunderboltMotion)와 완전히 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isShiningRayDirectionLocked = true
		self._T.lockedShiningRayDirX = dirX
		self._T.lockedShiningRayMotionName = motionName
		self._T.isShiningRayMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedShiningRayPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[ShiningRay] PlayShiningRayMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isShiningRayMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isShiningRayDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	method Color GetMagicMissileElementColor(string element)
		-- 매직 에로우(3차 토글) 속성별 틴트 색. 빛=노랑·하양, 얼음=파랑, 불=붉은색.
		-- 무속성(빈 문자열)은 흰색(틴트 없음 = 원본색 그대로)을 돌려준다. 구체 스프라이트와
		-- 생성/발사 이펙트에 곱셈 틴트로 공통 적용된다(서버/클라 양쪽에서 호출 - ExecSpace 미지정).
		-- (피드백: "색이 탁하다" → "색변화가 잘 안 보인다") 원본 구체 아트가 흰색-파랑 계열이라
		-- 채도 낮은 틴트는 모든 채널이 1.0 이상으로 클램프돼 화면에서 그냥 흰색으로 보인다.
		-- 채도를 높이고(낮은 채널을 1.0 아래로 확실히 내림) 밝기는 HDR로 약간만 올려(1.4~1.5)
		-- 흰 코어 + 선명한 속성색이 되도록 조정 - 루프 재생 스크린샷으로 4색 비교 검증 완료.
		if element == "light" then
			return Color.HSVToRGB(0.13, 0.8, 1.4, true)
		elseif element == "ice" then
			return Color.HSVToRGB(0.58, 0.85, 1.4, true)
		elseif element == "fire" then
			return Color.HSVToRGB(0.015, 0.85, 1.5, true)
		end
		return Color(1.0, 1.0, 1.0, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackMagicMissile(number combatPower, number atkMultiplier, number playerLevel, string element)
		-- 매직 미사일(1차): 등 뒤 랜덤 위치에 마법 구체(레벨 비례 개수)를 소환하고, 각 구체가
		-- 전방의 타겟을 향해 서서히 조준 회전한 뒤 발사 플래시와 함께 유도 비행해 명중 시
		-- 전투력의 100%~150% 피해를 준다. element는 매직 에로우 토글 속성(""/"light"/"ice"/"fire") -
		-- 켜져 있으면 구체/이펙트가 속성색으로 물든다(데미지 2배는 combatPower에 이미 반영되어 넘어온다).
		-- 구체 시퀀스 자체는 MagicMissileBall 엔티티가 진행하고,
		-- 여기서는 소환/타겟 분배/시전 모션/판정(DealMagicMissileHit)만 담당한다.
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 다른 스킬과 동일하게 정리.
		self:StopBreather()
		-- 사다리/로프/사망 상태에서는 사용 불가 (다른 스킬과 동일 가드).
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isMagicMissiling then
			return
		end
		self._T.isMagicMissiling = true

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingMagicMissileCombatPower = combatPower
		-- (요청) 매직 에로우(불) 토글일 때 명중 시 화상을 걸어야 한다. 구체가 도착한 뒤 판정하는
		-- DealMagicMissileHit은 element를 인자로 받지 않으므로 시전 시점의 속성을 서버에 기억해둔다.
		self._T.pendingMagicMissileElement = element

		local playerCtrl = self.Entity.PlayerControllerComponent
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = playerCtrl.LookDirectionX
		self._T.pendingMagicMissileDirX = dirX

		-- 구체 개수: 20레벨에 1개, 이후 10레벨마다 1개 추가(30→2, 40→3, 50→4 ...) - 피드백으로 30→10레벨 단위로 변경.
		-- 상한은 요청으로 8→20개(210레벨 도달). 20레벨 미만도 최소 1개는 소환한다.
		local ballCount = 1
		if playerLevel >= 20 then
			ballCount = 1 + math.floor((playerLevel - 20) / 10)
		end
		if ballCount > 20 then ballCount = 20 end

		-- (피드백) HP 예측 기반 분배: 전방의 몬스터를 가까운 순으로 골라두고, 구체마다 데미지를
		-- "시전 시점에 미리 확정"한 뒤 타겟의 남은 HP에서 차감해 나간다. 예측상 이미 죽는 몬스터에는
		-- 다음 구체를 배정하지 않아, 한 방 데미지 구체 5개 + 몬스터 5마리면 5마리가 전부 한 번에 죽는다.
		local targets = self:FindMagicMissileTargets(Vector2(worldPos.x, worldPos.y), dirX, ballCount)

		self._T.pendingMagicMissileWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 스킬 사용 사운드 + 캐릭터 모션(매직클로/썬더볼트와 동일한 후보군/재생 방식)
		self:PlayMagicMissileUseSound(self.Entity)
		local swing = self:GetMagicMissileSwing()
		self:PlayMagicMissileMotion(self.Entity, swing.name, dirX, mult)

		-- 타겟별 "예측 남은 HP" 테이블 - 시전 시점의 실제 몬스터 HP에서 시작한다.
		local remainingHp = {}
		for idx, targetEnt in ipairs(targets) do
			---@type Monster
			local mc = targetEnt:GetComponent("script.Monster")
			if isvalid(mc) then
				remainingHp[idx] = mc.Hp
			else
				remainingHp[idx] = 999999
			end
		end

		-- 구체별 소환: 등 뒤 일정 범위 안 랜덤 위치에 생성 이펙트(dcac 클립 1~7프레임)를 먼저 재생하고,
		-- 구체 본체(정지 프레임)는 생성 이펙트 마지막 프레임쯤(0.9초 뒤)에 나타난다(요청 사양 - 이펙트가
		-- 서서히 사라지며 구체가 남는 연출).
		for i = 1, ballCount do
			local offX = -dirX * (0.5 + _UtilLogic:RandomDouble() * 0.8)
			local offY = 0.35 + _UtilLogic:RandomDouble() * 0.85
			local bx = worldPos.x + offX
			local by = worldPos.y + offY
			local bz = worldPos.z

			-- 이 구체의 데미지를 미리 확정(전투력 100%~150%)하고, 예측상 아직 살아있는 가장 가까운
			-- 몬스터에 배정한 뒤 그 몬스터의 예측 HP에서 차감한다. 전부 죽을 예정이면 기존처럼 순환 분배
			-- (남는 구체가 허공에 안 뜨게 이미 죽을 몬스터 위치로라도 날린다).
			local presetDamage = math.floor(combatPower * (1.0 + _UtilLogic:RandomDouble() * 0.5))
			local target = nil
			local chosenIdx = nil
			for idx = 1, #targets do
				if remainingHp[idx] > 0 then
					chosenIdx = idx
					break
				end
			end
			if chosenIdx == nil and #targets > 0 then
				chosenIdx = ((i - 1) % #targets) + 1
			end
			if chosenIdx ~= nil then
				target = targets[chosenIdx]
				remainingHp[chosenIdx] = remainingHp[chosenIdx] - presetDamage
				log("PlayerAttack: MagicMissile ball " .. tostring(i) .. " -> " .. tostring(target.Name) .. " preset=" .. tostring(presetDamage) .. " 남은예측HP=" .. tostring(remainingHp[chosenIdx]))
			end

			self:PlayMagicMissileSpawnEffect(bx, by, bz, dirX, element)
			local capturedTarget = target
			local capturedPreset = presetDamage
			-- (피드백) 생성 이펙트가 PlayRate 2배로 절반 시간에 끝나므로 구체 등장도 0.9→0.45초로 앞당긴다.
			_TimerService:SetTimerOnce(function()
				self:SpawnMagicMissileBall(bx, by, bz, capturedTarget, dirX, capturedPreset, element)
			end, 0.45)
		end

		-- 컨트롤 잠금 해제: 썬더볼트와 동일한 규격(0.6초*배율). 구체 시퀀스는 이와 독립적으로 계속 진행된다.
		_TimerService:SetTimerOnce(function()
			self:RestoreMagicMissileControl()
		end, 0.6 * mult)

		log("PlayerAttack: AttackMagicMissile level=" .. tostring(playerLevel) .. " balls=" .. tostring(ballCount) .. " targets=" .. tostring(#targets))
	end

	@ExecSpace("ServerOnly")
	method table FindMagicMissileTargets(Vector2 fromPos, number dirX, integer maxCount)
		-- 매직 미사일 대상 선정: 캐릭터가 바라보는 전방(가로 6칸, 세로 위아래 3칸)의 살아있는
		-- script.Monster를 가까운 순으로 정렬해 최대 maxCount명까지 반환한다(실제 판정 없이 위치 탐색만).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if dx * dirX >= 0 and math.abs(dx) <= 6.0 and math.abs(dy) <= 3.0 then
					table.insert(candidates, { entity = mc.Entity, dist = math.abs(dx) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void SpawnMagicMissileBall(number px, number py, number pz, Entity target, number dirX, number presetDamage, string element)
		-- 생성 이펙트 마지막 프레임 시점에 호출되어 구체 엔티티를 실제로 소환한다.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		if self._T.magicMissileCount == nil then self._T.magicMissileCount = 0 end
		self._T.magicMissileCount = self._T.magicMissileCount + 1
		local name = "magicmissile_" .. tostring(self._T.magicMissileCount)
		local ball = _SpawnService:SpawnByModelId("magicmissileball", name, Vector3(px, py, pz), map)
		if ball == nil then
			log_warning("PlayerAttack: SpawnMagicMissileBall - spawn failed (model 'magicmissileball')")
			return
		end
		-- (요청) 매직 에로우 속성이 켜져 있으면 구체 스프라이트를 속성색으로 틴트한다.
		-- SpriteRendererComponent.Color는 @Sync라 서버에서 쓰면 클라에 전파되고,
		-- 발사 시 SpriteRUID를 루프 클립으로 교체해도 Color는 별도 프로퍼티라 그대로 유지된다.
		if element ~= "" and isvalid(ball.SpriteRendererComponent) then
			ball.SpriteRendererComponent.Color = self:GetMagicMissileElementColor(element)
		end
		---@type MagicMissileBall
		local bc = ball:GetComponent("script.MagicMissileBall")
		if not isvalid(bc) then
			log_warning("PlayerAttack: SpawnMagicMissileBall - MagicMissileBall component not found")
			return
		end
		bc:Setup(target, self.Entity, dirX, presetDamage, element)
		log("PlayerAttack: SpawnMagicMissileBall " .. name .. " target=" .. (isvalid(target) and tostring(target.Name) or "none") .. " preset=" .. tostring(presetDamage))
	end

	@ExecSpace("Server")
	method void RestoreMagicMissileControl()
		self._T.isMagicMissiling = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingMagicMissileWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) 다른 스킬과 동일하게 컨트롤 복구 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingMagicMissileDirX or 1)
	end

	@ExecSpace("Server")
	method void DealMagicMissileHit(Entity target, number presetDamage)
		-- 구체(MagicMissileBall)가 타겟에 도달한 순간 호출되어 그 대상 하나에게만 판정을 실행한다
		-- (썬더볼트의 대상별 판정과 동일한 단일 대상 게이트 - 밀집 지역에서 이웃까지 겹쳐 맞는 것 방지).
		-- presetDamage: 시전 시점에 미리 확정해 HP 예측 분배에 쓴 값 - CalcDamageBase가 그대로 돌려준다.
		if not isvalid(self.Entity) then return end
		if not isvalid(target) then return end
		self._T.magicMissileCurrentTarget = target
		self._T.magicMissileHitPreset = presetDamage
		local targetPos = target.TransformComponent.WorldPosition
		local shape = CircleShape(Vector2(targetPos.x, targetPos.y), 0.6)
		local hitComps = self:AttackShadowSafe(shape, "skill.magicmissile", target)
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		if actuallyHit then
			self:PlayMagicMissileHitEffect(target)
			-- (요청) 매직 에로우(불) 토글이 켜진 매직 미사일은 20% 확률로 화상을 입힌다.
			if (self._T.pendingMagicMissileElement or "") == "fire" and _UtilLogic:RandomDouble() < 0.2 then
				self:ApplyElementalBurn(target, self._T.pendingMagicMissileCombatPower or 0)
			end
		end
		log("PlayerAttack: DealMagicMissileHit target=" .. tostring(target.Name) .. " actuallyHit=" .. tostring(actuallyHit))
	end

	method table GetMagicMissileSwing()
		-- 매직클로/썬더볼트와 동일한 모션 후보군(swingO1/O2/O3)을 순차 순환 재생한다.
		local candidates = {
			{ name = "swingO1" },
			{ name = "swingO2" },
			{ name = "swingO3" },
		}
		self._T.magicMissileSwingIndex = (self._T.magicMissileSwingIndex or 0) % #candidates + 1
		return candidates[self._T.magicMissileSwingIndex]
	end

	@ExecSpace("Multicast")
	method void PlayMagicMissileMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 매직 미사일 전용 모션 재생. 썬더볼트(PlayThunderboltMotion)와 완전히 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isMagicMissileDirectionLocked = true
		self._T.lockedMagicMissileDirX = dirX
		self._T.lockedMagicMissileMotionName = motionName
		self._T.isMagicMissileMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedMagicMissilePlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[MagicMissile] PlayMagicMissileMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isMagicMissileMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isMagicMissileDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Multicast")
	method void PlayMagicMissileUseSound(Entity attacker)
		-- 스킬 사용 즉시 재생되는 사운드 (피드백으로 교체된 전용 사용음).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("a2ade2fb109b490cb95814c0622b4f4f", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayMagicMissileSpawnEffect(number px, number py, number pz, number dirX, string element)
		-- 구체 생성 이펙트: dcac510901fe451282ad7b93abc3032d의 1~7프레임(0-base 0~6)만 재생한다(피드백 사양).
		-- 아트 속 미사일 머리가 -x(왼쪽) 기준이라 오른쪽을 볼 때 FlipX.
		-- (피드백) 구체(화살) 위치/크기와 안 맞아 조금 뒤(-0.2*dirX)·아래(-0.15)로 내리고 크기를 30% 키움(0.6→0.78).
		-- element: 매직 에로우 토글 속성 - Multicast는 서버 _T를 못 읽으므로 파라미터로 받아 색을 입힌다(강화 스킬 공통 패턴).
		if not self:IsClient() then return end
		-- (피드백) 생성 이펙트 재생 속도 2배(PlayRate=2) - 구체 등장 타이머(0.45초)와 짝을 이룬다.
		local options = { ["StartFrameIndex"] = 0, ["EndFrameIndex"] = 6, ["FlipX"] = dirX > 0, ["PlayRate"] = 2.0 }
		if element ~= "" then
			options["Color"] = self:GetMagicMissileElementColor(element)
		end
		_EffectService:PlayEffect("dcac510901fe451282ad7b93abc3032d", self.Entity, Vector3(px - 0.2 * dirX, py - 0.15, pz), 0, Vector3(0.78, 0.78, 1), false, options)
	end

	@ExecSpace("Multicast")
	method void PlayMagicMissileLaunchEffect(number px, number py, number pz, number zRot, string element)
		-- 발사 이펙트: 6df269a10323437c8acf7c7937fff4c1를 구체가 날아가기 시작한 위치에서
		-- 비행 각도로 재생한다(피드백 사양). zRot에는 구체와 같은 +180 보정(원본 궤적 -x 기준)이 포함되어 넘어온다.
		-- element가 있으면 속성색 틴트(원본이 순백 클립이라 곱셈 틴트가 그대로 속성색이 된다).
		if not self:IsClient() then return end
		local options = {}
		if element ~= "" then
			options["Color"] = self:GetMagicMissileElementColor(element)
		end
		_EffectService:PlayEffect("6df269a10323437c8acf7c7937fff4c1", self.Entity, Vector3(px, py, pz), zRot, Vector3(0.7, 0.7, 1), false, options)
	end

	@ExecSpace("Multicast")
	method void PlayMagicMissileHitEffect(Entity target)
		-- 명중 이펙트 + 타격음: 피드백으로 지정된 hit 클립을 대상 몸에서 재생.
		-- (피드백) 매직 에로우 속성이 켜져 있어도 명중 이펙트는 틴트하지 않고 원본 색 그대로 둔다
		-- (속성색은 구체/생성/발사 이펙트에만 적용).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		_EffectService:PlayEffectAttached("37667e283b994c4a94880227dbe4d387", target, Vector3(0, 0.2, 0), 0, Vector3(1, 1, 1), false, {})
		_SoundService:PlaySound("5b622d47e7e4412b8217bcfcef140946", 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackHeal(number combatPower, number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 힐 발동: 항상 자기 자신을 회복시키고, 주변(썬더볼트와 동일한 탐색 범위/최대 6명, 방향 무관)의
		-- 다른 플레이어는 함께 회복시키며, 그 범위 안의 언데드 몬스터(script.Monster.IsUndead=true)는 대신 피해를 입힌다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isHealing then
			return
		end
		self._T.isHealing = true

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingHealCombatPower = combatPower

		local playerCtrl = self.Entity.PlayerControllerComponent
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = playerCtrl.LookDirectionX
		self._T.pendingHealDirX = dirX

		-- 자신을 제외한 범위 내 대상(다른 플레이어 + 언데드 몬스터)을 미리 골라둔다 (썬더볼트와 동일한 탐색 범위/최대 6명).
		local targets = self:FindHealTargets(Vector2(worldPos.x, worldPos.y), 6)
		self._T.healTargets = targets

		self._T.pendingHealWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 스킬 사용 사운드 + 몸쪽 시전 이펙트 (즉시, 1회) + 캐릭터 모션(버프/숨고르기 계열 후보 - 사용자가 화면으로 확인 후 확정 예정)
		self:PlayHealUseSound(self.Entity)
		self:PlayHealStartEffect(self.Entity)
		local motion = self:GetHealMotion()
		self:PlayHealMotion(self.Entity, motion.name, dirX, mult)

		-- 딜레이 후 자신을 무조건 회복시키고, 미리 골라둔 대상 전원에게 동시에 회복/피해를 적용한다.
		_TimerService:SetTimerOnce(function()
			self:DealHealEffects(targets)
		end, 0.4 * mult)

		-- 컨트롤 잠금 해제: 처리 직후 여유(0.2초)를 두고, 배율을 적용한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreHealControl()
		end, 0.6 * mult)
	end

	@ExecSpace("ServerOnly")
	method table FindHealTargets(Vector2 fromPos, integer maxCount)
		-- 힐 대상 선정: 방향 무관, 좌우 ±3.6·위아래 ±3.6(피드백: 좌우 1.2배 확대 + 위아래를 좌우와 동일하게)에서 자신을 제외한
		-- 다른 플레이어(회복 대상)와 언데드 몬스터(script.Monster.IsUndead=true, 피해 대상)를 함께 찾아
		-- 가까운 순으로 정렬해 최대 maxCount명까지 후보로 반환한다. 각 항목은 { entity, kind = "player"|"undead" }.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local candidates = {}

		local mapComp = map.MapComponent
		if isvalid(mapComp) then
			local users = _UserService:GetUsersByMapComponent(mapComp)
			if users ~= nil then
				for _, userEntity in ipairs(users) do
					if isvalid(userEntity) and userEntity ~= self.Entity then
						local pc = userEntity.PlayerComponent
						if isvalid(pc) and not pc:IsDead() then
							local pos = userEntity.TransformComponent.WorldPosition
							local dx = pos.x - fromPos.x
							local dy = pos.y - fromPos.y
							-- (피드백) 좌우 3.0→3.6(1.2배), 위아래도 좌우와 같은 3.6으로 확대.
							if math.abs(dx) <= 3.6 and math.abs(dy) <= 3.6 then
								table.insert(candidates, { entity = userEntity, dist = math.abs(dx), kind = "player" })
							end
						end
					end
				end
			end
		end

		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead and mc.IsUndead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 3.6 and math.abs(dy) <= 3.6 then
					table.insert(candidates, { entity = mc.Entity, dist = math.abs(dx), kind = "undead" })
				end
			end
		end

		-- 소환된 용사(HeroSummon)도 회복 대상이다 - HP가 남아 있는(묘지 상태가 아닌) 경우만.
		local heroComps = map:GetChildComponentsByTypeName("script.HeroSummon", true)
		for _, comp in ipairs(heroComps) do
			---@type HeroSummon
			local hs = comp
			if isvalid(hs) and isvalid(hs.Entity) and hs.HeroHp > 0 then
				local pos = hs.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 3.6 and math.abs(dy) <= 3.6 then
					table.insert(candidates, { entity = hs.Entity, dist = math.abs(dx), kind = "hero" })
				end
			end
		end

		-- 소환된 힐러(HealerSummon)도 회복 대상이다 - HP가 남아 있는(사망 상태가 아닌) 경우만.
		local healerComps = map:GetChildComponentsByTypeName("script.HealerSummon", true)
		for _, comp in ipairs(healerComps) do
			---@type HealerSummon
			local hlc = comp
			if isvalid(hlc) and isvalid(hlc.Entity) and hlc.HealerHp > 0 then
				local pos = hlc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 3.6 and math.abs(dy) <= 3.6 then
					table.insert(candidates, { entity = hlc.Entity, dist = math.abs(dx), kind = "healer" })
				end
			end
		end

		-- 소환된 용(SummonDragon)도 회복 대상이다 - 격추되지 않고 HP가 남아 있는 경우만.
		local dragonComps = map:GetChildComponentsByTypeName("script.SummonDragon", true)
		for _, comp in ipairs(dragonComps) do
			---@type SummonDragon
			local sd = comp
			if isvalid(sd) and isvalid(sd.Entity) and sd.DragonHp > 0 then
				local pos = sd.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 3.6 and math.abs(dy) <= 3.6 then
					table.insert(candidates, { entity = sd.Entity, dist = math.abs(dx), kind = "dragon" })
				end
			end
		end

		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i])
		end
		return result
	end

	@ExecSpace("Server")
	method void RestoreHealControl()
		self._T.isHealing = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingHealWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingHealDirX or 1)
	end

	@ExecSpace("Server")
	method void DealHealEffects(table targets)
		-- 예약된 딜레이 뒤 호출된다. 자신은 무조건 회복시키고(대상 목록과 무관), 목록의 각 대상은
		-- 종류(kind)에 따라 회복 또는 언데드 피해를 동시에 처리한다 (썬더볼트처럼 순차 딜레이 없음).
		if not isvalid(self.Entity) then return end

		self:ApplyHealToPlayer(self.Entity, self._T.pendingHealCombatPower or 0)

		for _, t in ipairs(targets) do
			if isvalid(t.entity) then
				if t.kind == "player" then
					self:ApplyHealToPlayer(t.entity, self._T.pendingHealCombatPower or 0)
				elseif t.kind == "hero" then
					self:ApplyHealToHero(t.entity, self._T.pendingHealCombatPower or 0)
				elseif t.kind == "healer" then
					self:ApplyHealToHealer(t.entity, self._T.pendingHealCombatPower or 0)
				elseif t.kind == "dragon" then
					self:ApplyHealToDragon(t.entity, self._T.pendingHealCombatPower or 0)
				elseif t.kind == "undead" then
					-- 이번 Attack() 호출은 이 대상 하나만 통과하도록 지정 (썬더볼트와 동일한 교차 히트 방지 패턴).
					self._T.healCurrentUndeadTarget = t.entity
					local targetPos = t.entity.TransformComponent.WorldPosition
					local shape = CircleShape(Vector2(targetPos.x, targetPos.y), 0.6)
					local hitComps = self:AttackShadowSafe(shape, "skill.heal", t.entity)
					local actuallyHit = false
					for _, hc in ipairs(hitComps) do
						if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == t.entity then
							actuallyHit = true
							break
						end
					end
					if actuallyHit then
						self:PlayHealUndeadHitSound()
						self:PlayHealUndeadHitEffect(t.entity)
					end
				end
			end
		end
		log("PlayerAttack: AttackHeal 처리 완료 대상=" .. tostring(#targets))
	end

	@ExecSpace("ServerOnly")
	method void AttackRestoration()
		-- 리스토네이션(2차, 2026-07-28 신설, 원본 팩 skill/121.img/skill/1211010):
		-- 캐릭터 몸에서 회복 이펙트를 1회 재생하고, (요청) 최대 HP의 10%씩 1초 간격으로 5회 =
		-- 5초에 걸쳐 총 50%를 회복한다. 회복량은 힐과 같은 파란 데미지 스킨으로 매 초 표시된다.
		-- 대상은 시전자 본인뿐이라 힐과 달리 범위 탐색이 없다. 쿨타임(10초)은 SkillManager가 관리한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then
			return
		end
		local pc = self.Entity.PlayerComponent
		if not isvalid(pc) then return end

		self:PlayRestorationEffect(self.Entity)

		-- 재시전하면 이전 회복 예약은 무효화한다(쿨타임 10초 > 지속 5초라 겹칠 일은 없지만 안전장치).
		self._T.restorationToken = (self._T.restorationToken or 0) + 1
		local myToken = self._T.restorationToken
		local TICKS = 5
		local perTick = math.floor(pc.MaxHp * 0.1)
		for i = 1, TICKS do
			local idx = i
			_TimerService:SetTimerOnce(function()
				if self._T.restorationToken ~= myToken then return end
				if not isvalid(self.Entity) then return end
				local pcNow = self.Entity.PlayerComponent
				if not isvalid(pcNow) or pcNow:IsDead() then return end
				local newHp = math.min(pcNow.Hp + perTick, pcNow.MaxHp)
				local actualHealed = newHp - pcNow.Hp
				if actualHealed <= 0 then return end
				pcNow.Hp = newHp
				-- 회복량 표시는 힐과 같은 파란 데미지 스킨을 쓴다.
				self:ShowHealDamageSkin(self.Entity, actualHealed)
				log("PlayerAttack: 리스토네이션 " .. tostring(idx) .. "/" .. tostring(TICKS) .. "회 +"
					.. tostring(actualHealed) .. " HP " .. tostring(math.floor(pcNow.Hp)) .. "/" .. tostring(math.floor(pcNow.MaxHp)))
			end, (idx - 1) * 1.0)
		end
		log("PlayerAttack: 리스토네이션 시전 - 최대HP 10%(" .. tostring(perTick) .. ")씩 5초간 5회 회복 시작")
	end

	@ExecSpace("Multicast")
	method void PlayRestorationEffect(Entity attacker)
		-- 리스토네이션 시전 연출: 회복 이펙트를 캐릭터 몸(0,0,0)에 붙여 1회 재생 + 원본 팩 사용음.
		-- (요청 2026-07-28) 이펙트 RUID 교체: 8d48b1dc(effect0) → 2cdfa538.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("0dd3dfd6b97c4a689deac7f3fde133dc", 1.0)
		local serial = _EffectService:PlayEffectAttached("2cdfa53899d2462cb051e958a70b4747", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.0)
	end

	@ExecSpace("Server")
	method void ApplyHealToPlayer(Entity target, number combatPower)
		-- 전투력의 10%를 기준으로 ±50% 범위(즉 전투력의 5%~15%) 내에서 랜덤한 양만큼 HP를 회복시킨다
		-- (보유 중인 최대 HP를 넘지 않도록 클램프). 실제로 회복된 양만큼만 데미지스킨으로 숫자 표시 + 대상 머리 위 이펙트 재생.
		if not isvalid(target) then return end
		local pc = target.PlayerComponent
		if not isvalid(pc) then return end
		local baseHeal = combatPower * 0.10
		local mult = 0.5 + _UtilLogic:RandomDouble() * 1.0
		local healAmount = math.floor(baseHeal * mult)
		if healAmount <= 0 then return end
		local newHp = math.min(pc.Hp + healAmount, pc.MaxHp)
		local actualHealed = newHp - pc.Hp
		if actualHealed <= 0 then return end
		pc.Hp = newHp
		-- (버그 수정) "피를 채울 때만 머리 위에 이펙트가 하나 더 뜬다" - 시전자 본인은 시전과 동시에
		-- PlayHealStartEffect가 **같은 RUID**의 이펙트를 몸(0,0,0)에서 이미 재생하는데, 여기서 머리
		-- 위(0,0.6)에 한 번 더 재생해 두 개가 겹쳤다. HP가 꽉 차 있으면 위의 actualHealed <= 0에서
		-- 일찍 빠져나가 이 줄을 타지 않으므로 "피가 안 찰 때만 정상"으로 보였던 것.
		-- 본인은 시작 이펙트로 충분하니 머리 위 이펙트는 다른 대상에게만 재생한다(회복 숫자 표시는
		-- 본인도 그대로 - 그건 겹치는 게 아니다).
		if target ~= self.Entity then
			self:PlayHealTargetEffect(target)
		end
		self:ShowHealDamageSkin(target, actualHealed)
	end

	@ExecSpace("Server")
	method void ApplyHealToHero(Entity heroEntity, number combatPower)
		-- 소환된 용사 회복: 플레이어와 같은 공식(전투력의 5%~15% 랜덤)으로 HeroHp를 채우고 HP바를
		-- 갱신하며, 실제 회복량만큼 파란(힐) 데미지스킨 표시 + 전용 이펙트를 머리 위에 1회 재생한다.
		if not isvalid(heroEntity) then return end
		---@type HeroSummon
		local hs = heroEntity:GetComponent("script.HeroSummon")
		if not isvalid(hs) or hs.HeroHp <= 0 then return end
		local baseHeal = combatPower * 0.10
		local mult = 0.5 + _UtilLogic:RandomDouble() * 1.0
		local healAmount = math.floor(baseHeal * mult)
		if healAmount <= 0 then return end
		local newHp = math.min(hs.HeroHp + healAmount, hs.HeroMaxHp)
		local actualHealed = newHp - hs.HeroHp
		if actualHealed <= 0 then return end
		hs.HeroHp = newHp
		hs:UpdateHpBar()
		self:PlayHeroHealEffect(heroEntity)
		self:ShowHealDamageSkin(heroEntity, actualHealed)
		log("PlayerAttack: 용사 회복 +" .. tostring(actualHealed) .. " → HP " .. tostring(math.floor(hs.HeroHp)) .. "/" .. tostring(math.floor(hs.HeroMaxHp)))
	end

	@ExecSpace("Server")
	method void ApplyHealToHealer(Entity healerEntity, number combatPower)
		-- 소환된 힐러 회복: 용사(ApplyHealToHero)와 완전히 같은 공식/표현으로 HealerHp를 채운다.
		if not isvalid(healerEntity) then return end
		---@type HealerSummon
		local hs = healerEntity:GetComponent("script.HealerSummon")
		if not isvalid(hs) or hs.HealerHp <= 0 then return end
		local baseHeal = combatPower * 0.10
		local mult = 0.5 + _UtilLogic:RandomDouble() * 1.0
		local healAmount = math.floor(baseHeal * mult)
		if healAmount <= 0 then return end
		local newHp = math.min(hs.HealerHp + healAmount, hs.HealerMaxHp)
		local actualHealed = newHp - hs.HealerHp
		if actualHealed <= 0 then return end
		hs.HealerHp = newHp
		hs:UpdateHpBar()
		self:PlayHeroHealEffect(healerEntity)
		self:ShowHealDamageSkin(healerEntity, actualHealed)
		log("PlayerAttack: 힐러 회복 +" .. tostring(actualHealed) .. " → HP " .. tostring(math.floor(hs.HealerHp)) .. "/" .. tostring(math.floor(hs.HealerMaxHp)))
	end

	@ExecSpace("Multicast")
	method void PlayHeroHealEffect(Entity target)
		-- 힐을 받은 용사 머리 위에 재생되는 전용 이펙트(1회).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("2ea4ea3b4d4a492e981d3536b14d7da6", target, Vector3(0, 0.7, 0), 0, Vector3(1, 1, 1), false, {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.5)
	end

	@ExecSpace("Multicast")
	method void PlayHealUseSound(Entity attacker)
		-- 스킬 사용 즉시 재생되는 사운드. Multicast는 서버 자신도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("a1a425ae3c1c49afa068ee212676c5dc", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayHealStartEffect(Entity attacker)
		-- 스킬 사용과 동시에 캐릭터 몸에서 발현되는 시작 이펙트 (1회).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_EffectService:PlayEffectAttached("26a8af1751324d2c9f14b1719a28d3c8", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 시작 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("26a8af1751324d2c9f14b1719a28d3c8", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {}, 0)
	end

	@ExecSpace("Multicast")
	method void PlayHealTargetEffect(Entity target)
		-- 힐을 받은 대상(자신 포함) 머리 위에 나타나는 이펙트 (1회).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("26a8af1751324d2c9f14b1719a28d3c8", target, Vector3(0, 0.6, 0), 0, Vector3(1, 1, 1), false, {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayHealUndeadHitSound()
		-- 언데드 몬스터가 힐로 피해를 입을 때 재생되는 사운드.
		if not self:IsClient() then return end
		_SoundService:PlaySound("38052d3003a941759a340ae28611d4dd", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayHealUndeadHitEffect(Entity target)
		-- 언데드 몬스터가 힐로 피해를 입을 때만 머리 위에 나타나는 이펙트 (1회). 다른 공격에는 재생되지 않는다.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local headY = 0.5
		local hit = target.HitComponent
		if isvalid(hit) then
			headY = hit.ColliderOffset.y + hit.BoxSize.y / 2
		end
		local serial = _EffectService:PlayEffectAttached("e81f0ba3f2b545d7895b98b1cf9be879", target, Vector3(0, headY, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
		self:EchoShadowHitEffect("e81f0ba3f2b545d7895b98b1cf9be879", target, Vector3(0, headY, 0), 0, Vector3(1, 1, 1), {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	@ExecSpace("Client")
	method void ShowHealDamageSkin(Entity target, integer healAmount)
		-- 회복된 양을 데미지처럼 숫자로 표시한다 (전용 데미지스킨 RUID 사용).
		if not isvalid(target) then return end
		_DamageSkinService:Play(
			target, "d58b67cf0f3a4eaf9fe1ad87c0ffac8a", 0,
			{ healAmount }, DamageSkinTweenType.Default, false,
			Vector2(0, 0), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		)
	end

	method table GetHealMotion()
		-- 사용자가 실제 화면으로 비교한 뒤 "alert" 동작으로 최종 확정.
		return { name = "alert" }
	end

	@ExecSpace("Multicast")
	method void PlayHealMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 힐 전용 모션 재생. 썬더볼트/매직클로와 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isHealDirectionLocked = true
		self._T.lockedHealDirX = dirX
		self._T.lockedHealMotionName = motionName
		self._T.isHealMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedHealPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[Heal] PlayHealMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isHealMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isHealDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("ServerOnly")
	method void AttackHaste(number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 헤이스트: 이동속도 40%, 점프력 20% 증가(5분). 최초 사용 시 원본 값을 한 번만 캡처해두고
		-- 이후에는 항상 그 원본 값 기준으로 배율을 재계산하므로, 지속 중 다시 사용해도 중첩되지 않고
		-- 지속시간만 갱신된다(토큰 비교로 먼저 걸린 타이머의 원복을 무시).
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then
			return
		end

		local movement = self.Entity.MovementComponent
		if not isvalid(movement) then
			return
		end

		-- 힐과 동일한 모션(alert)을 재생하고, 그동안 다른 행동을 제한한다.
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingHasteDirX = dirX
		self._T.pendingHasteWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		movement:Stop()
		self:PlayHasteMotion(self.Entity, "alert", dirX, mult)
		_TimerService:SetTimerOnce(function()
			self:RestoreHasteControl()
		end, 0.6 * mult)

		if not self._T.hasteBaseCaptured then
			self._T.hasteBaseInputSpeed = movement.InputSpeed
			self._T.hasteBaseJumpForce = movement.JumpForce
			self._T.hasteBaseCaptured = true
		end

		movement.InputSpeed = self._T.hasteBaseInputSpeed * 1.4
		movement.JumpForce = self._T.hasteBaseJumpForce * 1.2

		self._T.hasteToken = (self._T.hasteToken or 0) + 1
		local myHasteToken = self._T.hasteToken
		local duration = 300

		self:PlayHasteCastEffect(self.Entity)

		local userId = self.Entity.PlayerComponent.UserId
		self:NotifyHasteStart(duration, userId)

		_TimerService:SetTimerOnce(function()
			if self._T.hasteToken ~= myHasteToken then return end
			if isvalid(movement) then
				movement.InputSpeed = self._T.hasteBaseInputSpeed
				movement.JumpForce = self._T.hasteBaseJumpForce
			end
		end, duration)
	end

	@ExecSpace("Multicast")
	method void PlayHasteCastEffect(Entity attacker)
		-- 헤이스트 시전 이펙트: 캐릭터 몸쪽에서 1회 재생 + 사용 사운드.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local serial = _EffectService:PlayEffectAttached("410e6a09f8ec471f87bd8d55c34cc48d", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫)
		local echoSerial = self:EchoShadowSkillEffectAttached("410e6a09f8ec471f87bd8d55c34cc48d", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {}, 0)
		_SoundService:PlaySound("64795afda95e4b7dbdbdfe731e7d405a", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
			if echoSerial ~= 0 then
				_EffectService:RemoveEffect(echoSerial)
			end
		end, 1.5)
	end

	@ExecSpace("Client")
	method void NotifyHasteStart(number duration)
		-- 헤이스트 버프 타이머 UI 표시(본인 클라이언트에게만 - 호출부에서 UserId를 마지막 인자로 추가해 타겟팅).
		_HasteBuffUI:ShowBuff(duration)
	end

	@ExecSpace("Multicast")
	method void PlayHasteMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 헤이스트 전용 모션 재생 (힐과 동일한 방식/모션 - 별도 플래그로 서로 간섭하지 않는다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isHasteDirectionLocked = true
		self._T.lockedHasteDirX = dirX
		self._T.lockedHasteMotionName = motionName
		self._T.isHasteMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedHastePlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[Haste] PlayHasteMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isHasteMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isHasteDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Server")
	method void RestoreHasteControl()
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingHasteWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingHasteDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void AttackComboAttack(number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 콤보 어택(3차 버프, 30분): 시전 이펙트(skill/1111.img/skill/11111001의 effect 클립) +
		-- 사용 사운드(_audio/Use)를 1회 재생하고, 버프 지속 중 적을 hit할 때마다(OnAttack) 콤보
		-- 구슬이 1개씩(최대 10개, 물리적 구슬 엔티티는 5개까지만 스폰되고 6~10번째는 색 전환으로 표시)
		-- 몸 주위를 공전하며 쌓인다. 구슬 1개당 데미지 +20%(10개 = +200%,
		-- CalcDamage의 ApplyComboAttackBonus에서 일괄 적용). 헤이스트와 동일하게 시전 중에는
		-- 컨트롤을 잠그고(딜레이), 지속 중 재사용하면 중첩 없이 지속시간만 갱신된다(토큰 비교).
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then
			return
		end

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingComboDirX = dirX
		self._T.pendingComboWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 시전 모션: 정확한 전용 자세를 아직 실측 확정하지 못해 사용할 때마다 후보를 순서대로
		-- 하나씩 바꿔가며 재생하고 로그로 남긴다 - 화면과 로그를 대조해 마음에 드는 이름을
		-- 알려주면 그걸로 고정한다(스피어 버스터의 stabT2 확정 때와 동일한 절차).
		local motionName = self:GetComboAttackMotionName()
		self:PlayComboAttackMotion(self.Entity, dirX, mult, motionName)
		_TimerService:SetTimerOnce(function()
			self:RestoreComboAttackControl()
		end, 0.6 * mult)

		self:PlayComboAttackCastEffect(self.Entity, dirX)

		self._T.comboAttackToken = (self._T.comboAttackToken or 0) + 1
		local myToken = self._T.comboAttackToken
		local duration = 1800 -- 30분
		self._T.comboAttackActive = true

		local userId = self.Entity.PlayerComponent.UserId
		self:NotifyComboAttackStart(duration, userId)

		_TimerService:SetTimerOnce(function()
			if self._T.comboAttackToken ~= myToken then return end
			self._T.comboAttackActive = false
			self:ClearComboOrbs()
			log("[ComboAttack] 버프 종료(30분 경과)")
		end, duration)
		log("[ComboAttack] 버프 시작 duration=" .. tostring(duration))
	end

	method string GetComboAttackMotionName()
		-- 시전 자세 모션. 후보 순환 테스트 결과 첫 번째 후보(alert)로 확정했다 - 고정 재생.
		return "alert"
	end

	@ExecSpace("Multicast")
	method void PlayComboAttackMotion(Entity attacker, number dirX, number atkMultiplier, string motionName)
		-- 시전 모션을 1회 재생한다(헤이스트의 PlayHasteMotion과 동일한 방식 - 별도 플래그 없이
		-- 컨트롤 잠금(0.6*mult) 구간 동안만 재생되는 짧은 자세라 상태 재적용 훅은 두지 않는다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[ComboAttack] PlayComboAttackMotion sent " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			local sc = attacker.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Multicast")
	method void PlayComboAttackCastEffect(Entity attacker, number dirX)
		-- 시전 이펙트(마법진 버스트, 참고 영상 '콤보어택 사용시') 1회 + 사용 사운드.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local flipX = dirX > 0
		_EffectService:PlayEffectAttached("19e3ba3ab994431b81a3d4ee7a1b86e0", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["FlipX"] = flipX })
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫)
		self:EchoShadowSkillEffectAttached("19e3ba3ab994431b81a3d4ee7a1b86e0", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), { ["FlipX"] = flipX }, dirX)
		_SoundService:PlaySound("4b254b65adbe4df4885acbe2e2fa3671", 1.0)
		log("[ComboAttack] 시전 이펙트/사운드 재생")
	end

	@ExecSpace("Client")
	method void NotifyComboAttackStart(number duration)
		-- 콤보 어택 버프 타이머 UI 표시(본인 클라이언트에게만 - 호출부에서 UserId를 마지막 인자로 타겟팅).
		_ComboBuffUI:ShowBuff(duration)
	end

	@ExecSpace("Server")
	method void RestoreComboAttackControl()
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingComboWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingComboDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void AttackShadowPartner(number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 쉐도우 파트너(버프, 30분): 헤이스트/콤보어택과 동일한 패턴 - 지속 중 재사용하면 중첩 없이
		-- 지속시간만 갱신된다(토큰 비교). 그림자 시각 표현(등뒤에 붙어 본체 모션을 따라하는 실루엣)은
		-- ShadowPartnerVisual 컴포넌트가 전담하고, 여기서는 그 엔티티를 최초 1회만 스폰해 재사용한다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then
			return
		end

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingShadowPartnerDirX = dirX
		self._T.pendingShadowPartnerWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		self:PlayShadowPartnerMotion(self.Entity, "alert", dirX, mult)
		_TimerService:SetTimerOnce(function()
			self:RestoreShadowPartnerControl()
		end, 0.6 * mult)

		self:PlayShadowPartnerCastEffect(self.Entity, dirX)
		self:SpawnOrShowShadowEntity()

		self._T.shadowPartnerToken = (self._T.shadowPartnerToken or 0) + 1
		local myToken = self._T.shadowPartnerToken
		local duration = 1800 -- 30분
		self._T.shadowPartnerActive = true
		self.ShadowPartnerOn = true

		local userId = self.Entity.PlayerComponent.UserId
		self:NotifyShadowPartnerStart(duration, userId)

		_TimerService:SetTimerOnce(function()
			if self._T.shadowPartnerToken ~= myToken then return end
			self._T.shadowPartnerActive = false
			self.ShadowPartnerOn = false
			if isvalid(self._T.shadowPartnerEntity) then
				self._T.shadowPartnerEntity.Enable = false
			end
			log("[ShadowPartner] 버프 종료(30분 경과)")
		end, duration)
		log("[ShadowPartner] 버프 시작 duration=" .. tostring(duration))
	end

	@ExecSpace("ServerOnly")
	method void SpawnOrShowShadowEntity()
		-- 그림자 엔티티는 최초 1회만 스폰하고(플레이어의 자식 - SpearBurstFadingEffect/ComboOrb와 동일한
		-- 부모-자식 스폰 패턴), 이후 재사용 시에는 Enable만 다시 켠다. ShadowPartnerVisual 스크립트는
		-- .model 자체에 포함돼 있어(런타임 AddComponent는 클라이언트로 복제되지 않아 OnBeginPlay의
		-- ClientOnly 분기가 실행되지 않는 문제가 실측됨) 스폰과 동시에 모든 클라이언트에 정상 복제된다.
		if isvalid(self._T.shadowPartnerEntity) then
			self._T.shadowPartnerEntity.Enable = true
			return
		end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local shadow = _SpawnService:SpawnByModelId("shadowpartnershadow", "ShadowPartnerShadow_" .. self.Entity.Name, Vector3(-0.22, -0.02, 0), self.Entity)
		if not isvalid(shadow) then
			log_warning("[ShadowPartner] 그림자 엔티티 스폰 실패")
			return
		end
		shadow.Enable = true
		self._T.shadowPartnerEntity = shadow
		log("[ShadowPartner] 그림자 엔티티 스폰 완료")
	end

	@ExecSpace("Multicast")
	method void PlayShadowPartnerMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 쉐도우 파트너 시전 모션(헤이스트/콤보어택과 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isShadowPartnerDirectionLocked = true
		self._T.lockedShadowPartnerDirX = dirX
		self._T.lockedShadowPartnerMotionName = motionName
		self._T.isShadowPartnerMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedShadowPartnerPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[ShadowPartner] PlayShadowPartnerMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isShadowPartnerMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isShadowPartnerDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Multicast")
	method void PlayShadowPartnerCastEffect(Entity attacker, number dirX)
		-- 시전 이펙트: 캐릭터 몸쪽에서 1회 재생되는 이펙트 2종 + 사용 사운드.
		-- (사용자 확정) 8ef08d99...(effect, 큰 이미지)가 앞, 6db426f9...(effect0, 작은 이미지)가 뒤(zorder).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local flipX = dirX > 0
		local backSerial = _EffectService:PlayEffectAttached("6db426f91ed54b83beddb7837d96fb4c", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["FlipX"] = flipX, ["OrderInLayer"] = 5 })
		local frontSerial = _EffectService:PlayEffectAttached("8ef08d990aeb452bad114479f6bc76fd", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["FlipX"] = flipX, ["OrderInLayer"] = 10 })
		_SoundService:PlaySound("6c7c28167b9049419435cc53001cef0c", 1.0)
		log("[ShadowPartner] 시전 이펙트/사운드 재생")
	end

	@ExecSpace("Client")
	method void NotifyShadowPartnerStart(number duration)
		-- 쉐도우 파트너 버프 타이머 UI 표시(본인 클라이언트에게만 - 호출부에서 UserId를 마지막 인자로 타겟팅).
		_ShadowPartnerBuffUI:ShowBuff(duration)
	end

	@ExecSpace("Server")
	method void RestoreShadowPartnerControl()
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingShadowPartnerWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingShadowPartnerDirX or 1)
	end

	-- 쉐도우 파트너 활성 중 self:Attack()으로 단일 대상을 판정할 때 공용으로 쓰는 래퍼. 대상의
	-- MOD.Core.DamageSkinSpawnerComponent를 판정 직전 잠깐 떼었다가 붙인다 - 이 컴포넌트가 붙어있는 채로
	-- 같은 AttackComponent 인스턴스가 같은 대상을 짧은 간격으로(예: 기본공격 연타) 반복 타격하면
	-- GetDisplayHitCount=0을 반환해도 엔진이 히트마다 자동 데미지 숫자를 하나씩 추가로 띄우는 문제가
	-- DoubleStab/MagicClaw/SpearBurst에서 실측 확인됐다(DealDoubleStabHit 등 참고) - 이 래퍼로 모든
	-- 일반 스킬(기본공격/파워스트라이크/슬래쉬블래스트/썬더볼트/힐/익스플로젼/드래곤로어/패닉/코마)의
	-- Attack() 호출에도 동일하게 적용해 "1줄이던 스킬이 3번 뜨는" 버그를 없앤다. 버프가 꺼져있으면
	-- 평소와 동일하게 그냥 self:Attack()만 호출한다(불필요한 컴포넌트 탈부착 방지).
	-- shape는 BoxShape/CircleShape 등 여러 Shape 하위 타입을 그대로 받아 넘기기 위해 any로 선언한다
	-- (커스텀 스크립트 메서드 파라미터에 추상 타입 Shape을 직접 쓰면 LEA-4002 컴파일 에러가 난다).
	method table AttackShadowSafe(any shape, string attackInfo, Entity target)
		if not self._T.shadowPartnerActive or not isvalid(target) then
			return self:Attack(shape, attackInfo, CollisionGroups.HitBox)
		end
		local skin = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		local stripped = isvalid(skin)
		if stripped then
			target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent")
		end
		local hitComps = self:Attack(shape, attackInfo, CollisionGroups.HitBox)
		if stripped and isvalid(target) and not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then
			target:AddComponent("MOD.Core.DamageSkinSpawnerComponent")
		end
		return hitComps
	end

	-- AttackShadowSafe의 AttackFast 버전(기본공격 전용 - AttackFast는 히트 목록을 만들지 않아 반환값이 없다).
	method void AttackFastShadowSafe(any shape, string attackInfo, Entity target)
		if not self._T.shadowPartnerActive or not isvalid(target) then
			self:AttackFast(shape, attackInfo, CollisionGroups.HitBox)
			return
		end
		local skin = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		local stripped = isvalid(skin)
		if stripped then
			target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent")
		end
		self:AttackFast(shape, attackInfo, CollisionGroups.HitBox)
		if stripped and isvalid(target) and not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then
			target:AddComponent("MOD.Core.DamageSkinSpawnerComponent")
		end
	end

	-- 쉐도우 파트너 - 투척류가 아닌 스킬(모션만 그림자가 따라하는 스킬)은 실제 히트가 여전히 1번뿐이므로,
	-- 타격음도 함께 2배로 들리도록 몬스터의 기본 피격음을 한 번 더 재생해준다("타격음이 2배로 많이
	-- 들리고" 요청). 던지는 스킬(파이어에로우/아이언에로우/럭키세븐)은 그림자가 실제로 투사체를 하나
	-- 더 쏴서 자연스럽게 히트음도 2번 나므로 이 메서드를 호출하지 않는다.
	@ExecSpace("Server")
	method void PlayShadowEchoHitSound(Entity defender)
		if not isvalid(defender) then return end
		---@type Monster
		local monsterComp = defender:GetComponent("script.Monster")
		if isvalid(monsterComp) then
			monsterComp:PlayHitSound()
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnShadowEchoArrowProjectile(string modelId, string projScriptType, string arrowRuid, Vector3 spawnPos, number dirX, number dirY, number combatPower)
		-- 쉐도우 파트너 - 그림자가 화살을 하나 더 쏴서 2개가 날아가는 것처럼 보이는 연출.
		-- (기능 변경) 그림자 화살은 "시각 전용"이다 - 그림자 스킬 이펙트는 몬스터에게 직접적인 데미지를
		-- 주지 않는다는 요청. 타수 2배는 원본 화살의 히트 하나에 원본+보너스(55~65%)를 합산하고 데미지
		-- 숫자를 2줄로 나눠 표시하는 방식(각 *ProjectileAttack.CalcDamage)으로 처리한다.
		-- 화살 자체는 발사 방향의 반대쪽(x축 뒤쪽)에서 원본과 같은 모습, 투명도 70%로 날아간다.
		if not self._T.shadowPartnerActive then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.shadowEchoProjCount = (self._T.shadowEchoProjCount or 0) + 1
		local name = "shadowecho_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.shadowEchoProjCount)
		local echoPos = Vector3(spawnPos.x - 0.45 * dirX, spawnPos.y - 0.45 * dirY, spawnPos.z)
		local proj = _SpawnService:SpawnByModelId(modelId, name, echoPos, map)
		if not isvalid(proj) then return end
		local sprite = proj.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.SpriteRUID = arrowRuid
			sprite.Color = Color(1, 1, 1, 0.7)
		end
		local projComp = proj:GetComponent(projScriptType)
		if isvalid(projComp) then
			projComp.VisualOnly = true
			projComp:Fire(dirX, dirY)
		end
	end

	@ExecSpace("Multicast")
	method void ShowShadowEchoDamageSkin(Entity defender, integer original, integer bonus, boolean originalIsCritical, boolean bonusIsCritical)
		-- 쉐도우 파트너 - 이번 진짜 히트 하나(원본+보너스가 이미 합산된 실제 적용 데미지)를 화면에는
		-- 더블스탭과 동일한 방식으로 [원본, 보너스] 두 줄을 한 번에 묶어서 표시한다("공격도 개별로
		-- 공격하면 안되고 묶어서 2줄로 떠야 한다"는 요청). 대상이 이 히트로 즉시 죽어도 실제 적용된
		-- 데미지는 CalcDamage가 이미 합산해 반환했으므로 표시만 여기서 그리는 것 - 별도의 재진입
		-- Attack() 호출이 없어 "죽는 순간엔 에코가 안 붙는다"는 문제가 구조적으로 사라진다.
		if not self:IsClient() then return end
		if not isvalid(defender) then return end
		local skinRuid = self:GetHitDamageSkinId()
		-- (버그 수정) 원본/보너스를 하나의 Play() 배열로 묶으면 두 숫자가 같은 위치에서 시간차로만
		-- 분리돼 겹쳐 보인다(더블스탭/스피어버스터에서 실측된 것과 동일한 증상) - "데미지가 겹치지 않게"
		-- 요청에 따라 서로 다른 offsetY를 가진 별도의 Play() 호출 2번으로 나눠 항상 2줄로 분리해 띄운다.
		-- (버그 수정) "2줄 중 하나만 뜨는 경우 없이 항상 같이 뜬다" - 원본/보너스가 CalcCritical의 결과
		-- 하나(isCritical)를 공유해서 생긴 문제였다. CalcDamage에서 각 줄에 대해 독립적으로 굴린 결과를
		-- 각각 별도 파라미터(originalIsCritical/bonusIsCritical)로 받아 그대로 전달한다.
		_DamageSkinService:Play(defender, skinRuid, 0, { original }, DamageSkinTweenType.Default, originalIsCritical, Vector2(0, 0), Vector2(1, 1), 1.0, 1.0, LitMode.Default)
		_DamageSkinService:Play(defender, skinRuid, 0, { bonus }, DamageSkinTweenType.Default, bonusIsCritical, Vector2(0, 0.3), Vector2(1, 1), 1.0, 1.0, LitMode.Default)
		log("[ShadowPartner] 데미지 2줄 표시 original=" .. tostring(original) .. " bonus=" .. tostring(bonus) .. " originalCrit=" .. tostring(originalIsCritical) .. " bonusCrit=" .. tostring(bonusIsCritical))
	end

	-- ===== 쉐도우 파트너 그림자 이펙트 헬퍼 =====
	-- 아래 4개 헬퍼는 전부 클라이언트에서 실행 중인 이펙트 메서드(Multicast/Client) 안에서 호출된다.
	-- ShadowPartnerOn(@Sync)이 꺼져 있으면 아무것도 하지 않으므로, 버프가 없을 때 기존 동작은 그대로다.

	method table BuildShadowEffectOptions(table options)
		-- 그림자 몫 이펙트 옵션: 원본 옵션을 복사하고 투명도 70%(Alpha=0.7)를 얹는다.
		-- 원본에 이미 Alpha가 있으면(예: 파워스트라이크 스윙 0.8) 그 값에 70%를 곱한다.
		local copy = {}
		if options ~= nil then
			for k, v in pairs(options) do
				copy[k] = v
			end
		end
		local baseAlpha = copy["Alpha"] or 1.0
		copy["Alpha"] = baseAlpha * 0.7
		return copy
	end

	method number ResolveShadowDirX(number dirX)
		-- 그림자 이펙트를 띄울 "뒤쪽" 방향 계산용. dirX가 0(미지정/수직 발사)이면 현재 바라보는 방향을 쓴다.
		local d = dirX or 0
		if d == 0 then
			local pc = self.Entity.PlayerControllerComponent
			d = isvalid(pc) and pc.LookDirectionX or 1
			if d == 0 then d = 1 end
		end
		return d
	end

	method integer EchoShadowSkillEffectAttached(string ruid, Entity parent, Vector3 localPos, number zRot, Vector3 scale, table options, number dirX)
		-- 그림자 스킬 이펙트(시전/궤적): 버프 중이면 같은 이펙트를 x축 뒤쪽(-0.45 * 바라보는 방향)에서
		-- 투명도 70%로 1회 더 재생한다. 반환값은 이펙트 시리얼(재생 안 했으면 0) - 원본이 RemoveEffect
		-- 타이머로 정리되는 호출부는 이 시리얼도 같이 정리한다.
		if not self.ShadowPartnerOn then return 0 end
		if not isvalid(parent) then return 0 end
		local d = self:ResolveShadowDirX(dirX)
		log("[ShadowPartner] 그림자 스킬이펙트(부착) 재생 ruid=" .. tostring(ruid) .. " dirX=" .. tostring(d))
		return _EffectService:PlayEffectAttached(ruid, parent, Vector3(localPos.x - 0.45 * d, localPos.y, localPos.z), zRot, scale, false, self:BuildShadowEffectOptions(options))
	end

	method integer EchoShadowSkillEffect(string ruid, Vector3 pos, number zRot, Vector3 scale, table options, number dirX)
		-- 그림자 스킬 이펙트의 고정 좌표(맵 기준) 버전 - 텔레포트 잔상/독구름 파열처럼 월드 좌표에
		-- 직접 재생되는 이펙트용. x축 뒤쪽 오프셋 + 투명도 70%는 부착형과 동일하다.
		if not self.ShadowPartnerOn then return 0 end
		local mapEntity = self.Entity.CurrentMap
		if not isvalid(mapEntity) then return 0 end
		local d = self:ResolveShadowDirX(dirX)
		log("[ShadowPartner] 그림자 스킬이펙트(고정) 재생 ruid=" .. tostring(ruid) .. " dirX=" .. tostring(d))
		return _EffectService:PlayEffect(ruid, mapEntity, Vector3(pos.x - 0.45 * d, pos.y, pos.z), zRot, scale, false, self:BuildShadowEffectOptions(options))
	end

	method void EchoShadowHitEffectAtPos(string ruid, Vector3 pos, number zRot, Vector3 scale, table options)
		-- 히트 이펙트 2배(고정 좌표 버전): 지금 좌표를 그대로 캡처해 0.25초 뒤 한 번 더(투명도 70%) 재생한다.
		-- 고정 좌표(PlayEffect)라서 그 사이 대상이 죽어 사라져도 항상 그 자리(허공)에서 발동한다.
		if not self.ShadowPartnerOn then return end
		local mapEntity = self.Entity.CurrentMap
		if not isvalid(mapEntity) then return end
		local px, py, pz = pos.x, pos.y, pos.z
		local shadowOptions = self:BuildShadowEffectOptions(options)
		_TimerService:SetTimerOnce(function()
			if not isvalid(mapEntity) then return end
			_EffectService:PlayEffect(ruid, mapEntity, Vector3(px, py, pz), zRot, scale, false, shadowOptions)
			log("[ShadowPartner] 그림자 히트이펙트 발동(0.25초 지연, 고정좌표) ruid=" .. tostring(ruid) .. " pos=(" .. tostring(px) .. "," .. tostring(py) .. ")")
		end, 0.25)
	end

	method void EchoShadowHitEffect(string ruid, Entity target, Vector3 localOffset, number zRot, Vector3 scale, table options)
		-- 히트 이펙트 2배(대상 부착형 원본용): 대상의 현재 월드 위치 + 원본의 로컬 오프셋을 즉시 스냅샷해
		-- 시간차(0.25초)를 두고 고정 좌표로 한 번 더 재생한다 - "플레이어가 몬스터를 바로 죽였어도
		-- 그자리에 허공에서라도 발동해야 한다"는 요청을 고정 좌표 재생으로 보장한다.
		if not self.ShadowPartnerOn then return end
		if not isvalid(target) then return end
		local wp = target.TransformComponent.WorldPosition
		self:EchoShadowHitEffectAtPos(ruid, Vector3(wp.x + localOffset.x, wp.y + localOffset.y, wp.z + localOffset.z), zRot, scale, options)
	end

	method void OnAttack(Entity defender)
		-- 콤보 어택 버프 지속 중 적을 실제로 적중시킬 때마다 콤보 구슬 +1(최대 10).
		-- 부모 AttackComponent.OnAttack은 ExecSpace 미지정(All)이라 어노테이션 없이 오버라이드해야
		-- 한다(LEA-3014 방지). 실제 히트 파이프라인은 서버에서만 돌지만 안전하게 한 번 더 거른다.
		-- 스피어 버스터(3연타)/더블스탭(2연타)/썬더볼트(최대 6대상 동시)처럼 스킬 1회 사용이 여러 번
		-- OnAttack을 호출하는 경우에도 스택은 1회만 쌓여야 한다 - 같은 사용(cast) 안의 모든 히트는
		-- 0.4초 이내에 몰려서 들어오고(가장 느린 스피어버스터도 히트 간격 최대 ~0.3초), 다음 재사용은
		-- 쿨다운(0.7초 이상)이 지난 뒤라 서로 겹치지 않는다는 실측 타이밍에 기반한 시간창 방식.
		if not self:IsServer() then return end
		-- (다크사이트) 안전망 - 원래는 클라가 "공격 동작"을 보내는 순간(SkillManager.BreakDarkSightByAttack)
		-- 이미 풀리지만, 그 경로를 타지 않고 서버에서 곧바로 발생한 타격(스킬 후속 판정 등)이 있으면
		-- 여기서 푼다. 이 히트의 데미지/크리티컬 계산은 OnAttack 이전에 끝나므로 그 공격은 2배+크리티컬을
		-- 온전히 받는다. 이미 풀려 있으면 EndDarkSight가 곧바로 빠져나온다.
		if self._T.darkSightActive then
			self:EndDarkSight("공격")
		end
		-- (불의 영역/빙하지대) 버프 지속 중 공격 적중 시 확률 프록 - 투사체/독안개 등 별도
		-- AttackComponent를 쓰는 스킬과 판정을 공유하도록 공용 메서드로 분리했다(TryProcElementalZones).
		self:TryProcElementalZones(defender)
		-- (기능 추가) 쉐도우 파트너 - 더블스탭/매직클로/스피어버스터(수동 표시 스킬)는 각자 전용
		-- Show*DamageSkin에서 직접 보너스를 묶어 표시하므로 여기서는 건너뛴다(shadowEchoIsManualSkin).
		if self._T.shadowEchoBonus ~= nil and not self._T.shadowEchoIsManualSkin and isvalid(defender) then
			self:ShowShadowEchoDamageSkin(defender, self._T.shadowEchoOriginal, self._T.shadowEchoBonus, self._T.shadowEchoOriginalIsCritical or false, self._T.shadowEchoBonusIsCritical or false)
			-- (기능 추가) "타격음이 2배로 많이 들리게 해달라" 요청 - 실제 히트는 1번뿐이므로 몬스터 기본
			-- 피격음을 한 번 더 재생해 청각적으로도 2배처럼 느껴지게 한다.
			self:PlayShadowEchoHitSound(defender)
		end
		-- (기능 추가) "패닉 공격으로는 콤보 어택이 차면 안 된다"는 요청 - 패닉은 구슬을 모두 소모하는
		-- 스킬이라, 그 판정 자체가 다시 구슬을 채워버리면 소모한 의미가 없어진다. 패닉 판정(Attack)이
		-- 진행 중인 구간(AttackPanic~RestorePanicControl 사이, isPanicking=true)에는 구슬 획득을 건너뛴다.
		if self._T.isPanicking then return end
		if not self._T.comboAttackActive then return end
		if not isvalid(defender) then return end
		local now = _UtilLogic.ElapsedSeconds
		if self._T.lastComboStackTime and (now - self._T.lastComboStackTime) < 0.4 then
			return
		end
		self._T.lastComboStackTime = now
		-- (기능 추가) "히트 시 50% 확률로 구슬이 생기게 해달라"는 요청 - 매 히트마다 확정 지급하던 것을
		-- 절반 확률로 바꾼다. math.random() 대신 _UtilLogic:RandomDouble()을 쓴다 - 이 파일에서 이미
		-- 실측 확인된 버그(스피어 버스터 등 여러 히트가 0.1~0.2초 간격으로 잇따라 호출되면 math.random()이
		-- 같은 값을 두 번 반환)를 피하기 위해서다.
		if _UtilLogic:RandomDouble() >= 0.5 then return end
		-- (기능 추가) "어드밴스드 콤보(4차 패시브)가 있으면 여기서 다시 확률로 구슬 1개가 아니라
		-- 2개가 한번에 찬다"는 요청. (버그 수정) 패시브 스킬은 파이널어택(2차 패시브 - TryTriggerFinalAttack
		-- 참고)과 동일하게 스킬바 슬롯 배정과 무관하게 항상 적용되는 효과다 - "패시브는 클릭-클릭으로
		-- 슬롯에 옮길 수 없다"는 피드백으로, 슬롯 배정 여부를 확인하던 이전 방식(HasAdvancedCombo +
		-- SkillManager 동기화)은 실제 플레이에서 조건이 절대 참이 될 수 없어 항상 적용되지 않던 원인이었다 -
		-- 제거하고 파이널어택과 같은 방식(무조건 적용)으로 되돌린다.
		-- (기능 추가) "콤보어택이 차는 속도가 너무 빠르다"는 피드백으로 2개 동시 지급 확률을 50%→20%로 낮춘다.
		-- (구슬 10개 상한은 AddComboOrb 자체가 개별 호출마다 다시 확인하므로, 9개 상태에서 두 번째
		-- AddComboOrb 호출은 자동으로 무시되어 10개를 넘지 않는다 - 아래에서 실제로 몇 개가 늘었는지
		-- 확인해 로그도 그 실제 증가량만 "2개 동시 지급"으로 표시한다.)
		local before = self.ComboOrbCount
		if _UtilLogic:RandomDouble() < 0.2 then
			self:AddComboOrb()
			self:AddComboOrb()
		else
			self:AddComboOrb()
		end
		if self.ComboOrbCount - before >= 2 then
			log("[ComboAttack] 어드밴스드 콤보 발동 - 구슬 2개 동시 지급")
		end
	end

	method string GetComboOrbSpriteRuid(integer idx)
		-- state 클립(8c563f54...)의 프레임 1~5가 룬 문양 구슬 스프라이트다(msw-search 실측). 기본(파란) 색상.
		local ruids = {
			"594f34c4103145a28951780047e71e42",
			"eefe86c8b370407aa16c9fe34f12c98d",
			"dfb6702ddc994b8b8b24acf3c695020b",
			"18b94fa75cc54db0a806f522564ba449",
			"1c603235dffd468f8b28b36aa8cb3df2",
		}
		return ruids[math.max(1, math.min(idx, #ruids))]
	end

	method string GetComboOrbPinkSpriteRuid(integer idx)
		-- (기능 추가) "6콤보 이상일 때 구슬 색을 분홍색으로 바꿔달라"는 요청 - 파란 룬 클립과 동일한
		-- 6프레임 구조를 가진 분홍 버전 클립(113a68a27b50432eb00a82e131c2dd72, msw-search 실측)의
		-- 프레임 1~5.
		local ruids = {
			"4711c880fffd4da694871cf1fe331e7d",
			"8abd73b1954e42f5af565af4426ae582",
			"eaede9190e7f48e5a78123777220ebbf",
			"6360c35bf2ad47b0b68235182c063f80",
			"45c5effa123f463296b9c861fe017215",
		}
		return ruids[math.max(1, math.min(idx, #ruids))]
	end

	@ExecSpace("ServerOnly")
	method void AddComboOrb()
		-- 콤보 구슬 1개를 추가한다: 카운트(@Sync) 증가 + 플레이어의 자식으로 구슬 엔티티 스폰.
		-- 공전/크기 연출은 ComboOrb 컴포넌트가 클라이언트에서 담당한다. 첫 구슬이 생길 때 캐릭터
		-- 중심에 고정되는 큰 원(8c563f54... 클립 프레임0)도 함께 스폰한다.
		-- (기능 추가) "최대 10콤보까지 쌓을 수 있게 해달라"는 요청으로 상한을 5→10으로 올린다.
		-- 다만 궤도 슬롯은 ComboOrb.mlua에 5칸(2π/5 간격)으로 고정되어 있어 구슬 엔티티 자체는
		-- 여전히 최대 5개만 스폰한다 - 6번째부터는 새 구슬을 만들지 않고, 기존 구슬 중 하나(그리고
		-- 6번째가 되는 순간 가운데 큰 원)를 분홍색으로 전환해 6~10콤보를 표시한다.
		if self.ComboOrbCount >= 10 then return end
		local idx = self.ComboOrbCount + 1
		self.ComboOrbCount = idx

		if idx == 1 then
			self:SpawnComboOrbCenter()
		end

		if idx <= 5 then
			local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "ComboOrb" .. idx, Vector3(0, 0.35, 0), self.Entity)
			if isvalid(fx) then
				fx:AddComponent("script.ComboOrb")
				local comp = fx:GetComponent("script.ComboOrb")
				if isvalid(comp) then
					comp.OrbIndex = idx
					comp.OrbSpriteRUID = self:GetComboOrbSpriteRuid(idx)
				end
				self._T.comboOrbEntities = self._T.comboOrbEntities or {}
				table.insert(self._T.comboOrbEntities, fx)
			end
			log("[ComboAttack] 콤보 구슬 +1 → " .. tostring(idx) .. "/10 (데미지 +" .. tostring(idx * 20) .. "%)")
		else
			-- 6번째부터는 새 구슬 엔티티 없이, (idx-5)번째 기존 구슬을 분홍으로 전환한다.
			-- 6번째가 되는 순간(처음 분홍이 등장하는 시점) 가운데 큰 원도 함께 분홍으로 바뀐다.
			if idx == 6 then
				self:SetComboOrbCenterPink()
			end
			self:UpgradeComboOrbToPink(idx - 5)
			log("[ComboAttack] 콤보 구슬 +1 → " .. tostring(idx) .. "/10 (분홍 전환 " .. tostring(idx - 5) .. "/5, 데미지 +" .. tostring(idx * 20) .. "%)")
		end
	end

	@ExecSpace("ServerOnly")
	method void UpgradeComboOrbToPink(integer orbIndex)
		-- 기존에 떠 있는 구슬 중 슬롯 번호가 orbIndex인 것을 찾아 분홍 스프라이트로 바꾼다.
		-- OrbSpriteRUID는 @Sync라 값이 바뀌면 ComboOrb.OnSyncProperty가 재적용을 감지하고,
		-- 거기서 생성 연출(커졌다 작아지는 이펙트) 타이머도 함께 리셋해 색이 바뀌는 순간 다시 재생된다.
		local orbs = self._T.comboOrbEntities or {}
		for _, e in ipairs(orbs) do
			if isvalid(e) then
				---@type ComboOrb
				local comp = e:GetComponent("script.ComboOrb")
				if isvalid(comp) and comp.OrbIndex == orbIndex then
					comp.OrbSpriteRUID = self:GetComboOrbPinkSpriteRuid(orbIndex)
					log("[ComboAttack] 구슬 " .. tostring(orbIndex) .. "번 분홍 전환")
					break
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void SetComboOrbCenterPink()
		-- 가운데 큰 원을 분홍 버전(분홍 클립 프레임0)으로 전환한다.
		if isvalid(self._T.comboOrbCenterEntity) then
			---@type ComboOrb
			local comp = self._T.comboOrbCenterEntity:GetComponent("script.ComboOrb")
			if isvalid(comp) then
				comp.OrbSpriteRUID = "5f5348ebeb2345f0869d1682828a848d"
				log("[ComboAttack] 가운데 원 분홍 전환")
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnComboOrbCenter()
		-- 구슬들 한가운데(캐릭터 중심)에 고정되는 큰 원. state 클립 프레임0 스프라이트(72x76,
		-- 작은 구슬보다 큼)를 사용하고 IsCenterOrb=true라 공전하지 않는다.
		local center = _SpawnService:SpawnByModelId("spearburstfadingeffect", "ComboOrbCenter", Vector3(0, 0.35, 0), self.Entity)
		if isvalid(center) then
			center:AddComponent("script.ComboOrb")
			local comp = center:GetComponent("script.ComboOrb")
			if isvalid(comp) then
				comp.IsCenterOrb = true
				comp.OrbSpriteRUID = "9cfc22d7db1842608b648d9d7b5d216e"
			end
			self._T.comboOrbCenterEntity = center
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearComboOrbs()
		-- 버프 종료 시 구슬 전부 + 중앙 큰 원 제거, 카운트 초기화.
		self.ComboOrbCount = 0
		local orbs = self._T.comboOrbEntities or {}
		for _, e in ipairs(orbs) do
			if isvalid(e) then
				e:Destroy()
			end
		end
		self._T.comboOrbEntities = {}
		if isvalid(self._T.comboOrbCenterEntity) then
			self._T.comboOrbCenterEntity:Destroy()
		end
		self._T.comboOrbCenterEntity = nil
	end

	method integer ApplyComboAttackBonus(integer damage)
		-- 콤보 어택 버프 보너스: 구슬 1개당 +20%(최대 10개 = +200%). CalcDamage의 모든 분기 반환값에
		-- 일괄 적용된다. 부모 훅(CalcDamage)에서 호출되므로 ExecSpace 어노테이션 없이 선언한다.
		if not self._T.comboAttackActive then return damage end
		local count = self.ComboOrbCount or 0
		if count <= 0 then return damage end
		return math.floor(damage * (1 + 0.2 * count))
	end

	@ExecSpace("ServerOnly")
	method void AttackPanic(number combatPower, number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 패닉: 콤보 어택 버프로 쌓인 콤보 구슬을 전부 소모해 단일 대상에게 강력한 피해를 입힌다.
		-- 구슬이 하나도 없으면 사용할 수 없다(요청사항). 모션/히트 타이밍은 파워스트라이크와 동일하게
		-- GetPowerStrikeSwing + PlayAttackMotion을 그대로 재사용하고, 판정도 동일한 고정 딜레이(0.45초 * 배율)
		-- 뒤에 진행한다. 재시전 방지 게이트(isPanicking)/컨트롤 잠금 관련 필드는 다른 스킬들과 동일한 관례대로
		-- 패닉 전용 필드로 완전히 분리해, 클라이언트 공용 쿨다운(SkillManager.skillOnCooldown)이 스킬 간
		-- 사용을 이미 직렬화하는 것과 별개로 서버 쪽에서도 안전하게 독립적으로 동작하게 한다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isPanicking then
			log("PlayerAttack: AttackPanic 요청 차단됨(이미 진행 중)")
			return
		end
		-- 콤보 구슬이 하나도 없으면 사용 불가 - 클라이언트(SkillManager)도 미리 확인하지만 서버가 최종 판정한다.
		local orbCount = self.ComboOrbCount
		if orbCount <= 0 then
			log("PlayerAttack: AttackPanic 요청 차단됨(콤보 구슬 없음)")
			return
		end
		self._T.isPanicking = true
		self._T.panicMotionEndHandled = false

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingPanicCombatPower = combatPower
		-- 소모할 구슬 개수(1~10)를 시전 시점 값으로 스냅샷해둔다 - 바로 아래에서 ClearComboOrbs로
		-- ComboOrbCount를 0으로 되돌리기 때문에, 데미지 공식/이펙트 선택은 반드시 이 스냅샷 값을 써야 한다.
		self._T.pendingPanicOrbCount = orbCount

		local playerCtrl = self.Entity.PlayerControllerComponent
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = playerCtrl.LookDirectionX
		self._T.pendingPanicDirX = dirX

		-- 단일 대상 스킬: 판정 전에 가장 가까운 몬스터 하나만 골라 IsAttackTarget에서 그 대상만 통과시킨다(파워스트라이크와 동일).
		-- (기능 추가) "데미지를 입히는 범위를 전방·위아래로 2배 늘려달라"는 요청으로, 판정 박스가
		-- 넓어진 것과 함께 탐색 반경도 2.0→4.0으로 늘려 더 먼 대상도 실제로 판정 박스 안에 들어오게 한다.
		self._T.panicTarget = self:FindNearestMonster(Vector2(worldPos.x, worldPos.y), 4.0)

		self._T.pendingPanicWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 구슬은 시전 즉시(모션 시작과 동시에) 전부 소모한다 - ApplyComboAttackBonus가 CalcDamage 반환값에
		-- 자동으로 얹는 구슬 보너스(+20%/개)보다 먼저 ComboOrbCount를 0으로 비워둬야, 패닉 자체 공식
		-- (구슬 1개당 1000~1200%)에 그 보너스가 중복으로 얹히지 않는다.
		self:ClearComboOrbs()

		-- (기능 추가) "패닉 전용 사운드로 바꿔달라"는 요청 - 파워스트라이크와 공유하던
		-- PlaySkillUseSound 대신 패닉 전용 PlayPanicUseSound(d01b135e62a74129b1515c8e0250a2f5)를 재생한다.
		self:PlayPanicUseSound(self.Entity)
		self:PlayPanicCastEffect(self.Entity, dirX, orbCount)

		-- 캐릭터 모션은 파워스트라이크와 동일한 후보군(GetPowerStrikeSwing)에서 하나를 골라 재생한다.
		local swing = self:GetPowerStrikeSwing("twohand")
		self._T.pendingPanicSwing = swing
		self:PlayAttackMotion(self.Entity, swing.name, dirX, mult)

		-- 타격 판정 타이밍은 파워스트라이크와 동일하게 고정 딜레이(0.45초 * 배율) 뒤에 진행한다.
		_TimerService:SetTimerOnce(function()
			self:NotifyPanicMotionEnded()
		end, 0.45 * mult)

		-- 컨트롤 잠금 해제도 파워스트라이크와 동일한 총 딜레이(0.65초 * 배율).
		_TimerService:SetTimerOnce(function()
			self:RestorePanicControl()
		end, 0.65 * mult)

		log("[Panic] 발동 orbCount=" .. tostring(orbCount))
	end

	@ExecSpace("Server")
	method void RestorePanicControl()
		-- AttackPanic에서 예약한 고정 딜레이(0.65초 = 모션 0.25초 + 추가 이동 봉인 0.4초, 파워스트라이크와 동일) 뒤 호출된다.
		self._T.isPanicking = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingPanicWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingPanicDirX or 1)
	end

	method void NotifyPanicMotionEnded()
		-- AttackPanic에서 예약한 고정 딜레이(0.25초 * 배율, 파워스트라이크와 동일) 타이머로 호출된다.
		if self._T.panicMotionEndHandled then return end
		self._T.panicMotionEndHandled = true

		if not isvalid(self.Entity) then return end
		local dirX = self._T.pendingPanicDirX or 1
		local curWorldPos = self.Entity.TransformComponent.WorldPosition
		-- 판정 범위: 원래 파워스트라이크와 동일(전방 가로 2칸·세로 2칸)했으나, "전방·위아래로 2배
		-- 늘려달라"는 요청으로 전방 오프셋과 박스 가로/세로 크기를 모두 2배로 늘렸다(가로 4칸·세로 4칸,
		-- 전방 오프셋 1.0→2.0 - 뒤쪽 경계는 그대로 캐릭터 위치에 걸쳐 있고 앞/위/아래로만 넓어진다).
		local attackOffset = Vector2(
			curWorldPos.x + 2.0 * dirX,
			curWorldPos.y
		)
		local shape = BoxShape(attackOffset, Vector2(4, 4), 0)
		local hitComps = self:AttackShadowSafe(shape, "skill.panic", self._T.panicTarget)
		local targets = {}
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) then
				table.insert(targets, hc.Entity)
			end
		end

		local swing = self._T.pendingPanicSwing or { ruid = "", name = "?" }
		self:PlayPanicEffects(self.Entity, dirX, targets, self._T.pendingPanicOrbCount or 0, swing.ruid)
		log("PlayerAttack: AttackPanic dir=" .. tostring(dirX) .. " targets=" .. tostring(#targets))
	end

	method string GetPanicEffectRuid(integer orbCount)
		-- 소모한 콤보 구슬 개수(1~10)별 캐릭터 이펙트(시전 시 재생).
		local ruids = {
			"73ca2da2e4174b88b79b2f53aec7d231",
			"59220240d7004a439c16329b829a6900",
			"e150a53e0a61454b9fde4e53380cd9ab",
			"3e7aef83235b4e8ebd28ba9462d9b8c0",
			"1be23b85b0b44b84bc6e88a2caf986de",
			"8cbbf339d9de40b09d933cc9d4e8b803",
			"9c267e7da01c4c34992cfbfd02132a5f",
			"4561e55a44f74a3086d4e88a4c2c8f01",
			"aab1604317524fc78ab79e23416d6947",
			"aab1604317524fc78ab79e23416d6947",
		}
		return ruids[math.max(1, math.min(orbCount, #ruids))]
	end

	@ExecSpace("Multicast")
	method void PlayPanicUseSound(Entity attacker)
		-- 패닉 전용 사용 사운드. Multicast는 서버 자신도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local panicSoundRUID = "d01b135e62a74129b1515c8e0250a2f5"
		_SoundService:PlaySound(panicSoundRUID, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayPanicCastEffect(Entity attacker, number dirX, integer orbCount)
		-- 소모한 구슬 개수에 맞는 캐릭터 이펙트를 시전 즉시 1회 재생한다. Multicast는 서버 자신도
		-- 함께 실행하므로 클라이언트에서만 실행되게 막는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local effectRuid = self:GetPanicEffectRuid(orbCount)
		local options = { ["FlipX"] = dirX > 0 }
		-- (기능 추가) "캐릭터 이펙트 크기를 10% 상승시키고 y축을 약간 위로 올려달라"는 요청 -
		-- 기본 스케일(1,1,1)을 10% 키운다(1.1,1.1,1.1).
		-- (기능 추가) "패닉 이펙트의 전체적인 위치를 조금 아래로 내려달라"는 요청 - 이전에 위로
		-- 올렸던 y오프셋(0.15)을 다시 낮춰 원래 높이(0)로 되돌린다.
		_EffectService:PlayEffectAttached(effectRuid, attacker, Vector3(0, 0, 0), 0, Vector3(1.1, 1.1, 1.1), false, options)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached(effectRuid, attacker, Vector3(0, 0, 0), 0, Vector3(1.1, 1.1, 1.1), options, dirX)
		log("[Panic] 시전 이펙트 재생 orbCount=" .. tostring(orbCount) .. " ruid=" .. tostring(effectRuid))
	end

	@ExecSpace("Multicast")
	method void PlayPanicEffects(Entity attacker, number dirX, table targets, integer orbCount, string swingEffectRUID)
		-- 파워스트라이크와 동일한 스윙 궤적 이펙트를 재생하고(모션 재사용), 실제로 맞은 대상에게는
		-- 패닉 전용 몬스터 히트 이펙트를 재생한다. Multicast는 서버 자신도 함께 실행하므로
		-- 클라이언트에서만 실행되게 막는다 - 안 그러면 서버 쪽 실행이 이펙트를 한 번 더 재생해 겹쳐 보인다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local hitEffectRUID  = "4b8e5b7b21f74a26a54cf3a17d91930c"
		local swingSoundRUID = "d3205fdd08e34b68bc01292a997531ed"

		if swingEffectRUID ~= "" then
			local swingOptions = { ["FlipX"] = dirX > 0, ["Alpha"] = 0.8 }
			_EffectService:PlayEffectAttached(swingEffectRUID, attacker, Vector3(0.1 * dirX, 0, 0), 0, Vector3(1, 1, 1), false, swingOptions)
			-- 쉐도우 파트너: 스윙 궤적 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
			self:EchoShadowSkillEffectAttached(swingEffectRUID, attacker, Vector3(0.1 * dirX, 0, 0), 0, Vector3(1, 1, 1), swingOptions, dirX)
		end

		-- (기능 추가) "히트 이펙트 크기를 소모한 구슬 개수에 따라 1.1배씩 크게 하고 y축을 약간 위로
		-- 올려달라"는 요청 - 구슬 1개당 1.1배씩 복리로 커진다(1개=1.1배, 2개=1.21배, 3개=1.331배 ...).
		-- (기능 추가) "패닉 이펙트의 전체적인 위치를 조금 아래로 내려달라"는 요청 - 이전에 위로
		-- 올렸던 y오프셋(0.15)을 다시 낮춰 원래 높이(0)로 되돌렸었다.
		-- (기능 추가) "히트 이펙트는 y를 0.1로 올려달라"는 요청으로 다시 0.1로 조정.
		local hitScale = 1.1 ^ math.max(orbCount, 0)
		for _, target in ipairs(targets) do
			if isvalid(target) then
				local hitOptions = { ["FlipX"] = dirX > 0 }
				_EffectService:PlayEffectAttached(hitEffectRUID, target, Vector3(0, 0.1, 0), 0, Vector3(hitScale, hitScale, hitScale), false, hitOptions)
				-- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
				self:EchoShadowHitEffect(hitEffectRUID, target, Vector3(0, 0.1, 0), 0, Vector3(hitScale, hitScale, hitScale), hitOptions)
				_SoundService:PlaySound(swingSoundRUID, 1.0)
			end
		end
		log("[Panic] 히트 이펙트 스케일 orbCount=" .. tostring(orbCount) .. " scale=" .. tostring(hitScale))
		log("[Panic] 히트 이펙트 재생 orbCount=" .. tostring(orbCount) .. " targets=" .. tostring(#targets))
	end

	@ExecSpace("ServerOnly")
	method void AttackComa(number combatPower, number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 코마: 패닉과 구조가 비슷하다 - 콤보 어택 버프로 쌓은 콤보 구슬을 전부 소모해서 발동하고,
		-- 구슬이 하나도 없으면 사용할 수 없다. 다만 패닉(단일 대상)과 달리 코마는 드래곤로어와 동일한
		-- 범위(FindDragonRoarTargets 재사용)에서 가까운 대상부터 최대 15명을 동시에 타격하는 다중 대상
		-- 스킬이다. 캐릭터 모션/시전 타이밍은 패닉과 동일하게 GetPowerStrikeSwing + PlayAttackMotion을
		-- 그대로 재사용하고, 판정도 동일한 고정 딜레이(0.45초 * 배율) 뒤에 진행한다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isComaAttacking then
			log("PlayerAttack: AttackComa 요청 차단됨(이미 진행 중)")
			return
		end
		-- 콤보 구슬이 하나도 없으면 사용 불가 - 클라이언트(SkillManager)도 미리 확인하지만 서버가 최종 판정한다.
		local orbCount = self.ComboOrbCount
		if orbCount <= 0 then
			log("PlayerAttack: AttackComa 요청 차단됨(콤보 구슬 없음)")
			return
		end
		self._T.isComaAttacking = true
		self._T.comaMotionEndHandled = false

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingComaCombatPower = combatPower
		-- 소모할 구슬 개수(1~10)를 시전 시점 값으로 스냅샷해둔다 - 바로 아래에서 ClearComboOrbs로
		-- ComboOrbCount를 0으로 되돌리기 때문에, 데미지 공식/이펙트 선택은 반드시 이 스냅샷 값을 써야 한다.
		self._T.pendingComaOrbCount = orbCount

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = playerCtrl.LookDirectionX
		self._T.pendingComaDirX = dirX

		self._T.pendingComaWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 구슬은 시전 즉시(모션 시작과 동시에) 전부 소모한다 - 패닉과 동일한 이유(콤보 어택 버프의
		-- +20%/개 보너스가 코마 자체 공식에 중복으로 얹히지 않도록).
		self:ClearComboOrbs()

		self:PlayComaUseSound(self.Entity)
		self:PlayComaCastEffect(self.Entity, dirX, orbCount)

		-- 캐릭터 모션은 패닉과 동일한 후보군(GetPowerStrikeSwing)에서 하나를 골라 재생한다.
		local swing = self:GetPowerStrikeSwing("twohand")
		self._T.pendingComaSwing = swing
		self:PlayAttackMotion(self.Entity, swing.name, dirX, mult)

		-- 타격 판정 타이밍은 패닉과 동일하게 고정 딜레이(0.45초 * 배율) 뒤에 진행한다.
		_TimerService:SetTimerOnce(function()
			self:NotifyComaMotionEnded()
		end, 0.45 * mult)

		-- 컨트롤 잠금 해제도 패닉과 동일한 총 딜레이(0.65초 * 배율).
		_TimerService:SetTimerOnce(function()
			self:RestoreComaControl()
		end, 0.65 * mult)

		log("[Coma] 발동 orbCount=" .. tostring(orbCount))
	end

	@ExecSpace("Server")
	method void RestoreComaControl()
		-- AttackComa에서 예약한 고정 딜레이(0.65초 = 모션 0.25초 + 추가 이동 봉인 0.4초, 패닉과 동일) 뒤 호출된다.
		self._T.isComaAttacking = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingComaWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingComaDirX or 1)
	end

	method void NotifyComaMotionEnded()
		-- AttackComa에서 예약한 고정 딜레이(0.25초 * 배율, 패닉과 동일) 타이머로 호출된다.
		if self._T.comaMotionEndHandled then return end
		self._T.comaMotionEndHandled = true

		if not isvalid(self.Entity) then return end
		local worldPos = self.Entity.TransformComponent.WorldPosition
		-- 사용범위는 드래곤로어와 동일(FindDragonRoarTargets 재사용) - 전방위, 가까운 대상부터 정렬,
		-- 최대 15명까지.
		local targets = self:FindDragonRoarTargets(Vector2(worldPos.x, worldPos.y), 15)
		for _, t in ipairs(targets) do
			self:DealComaHit(t)
		end
		log("PlayerAttack: AttackComa targets=" .. tostring(#targets))
	end

	-- 대상 하나에게만 코마 데미지를 적중시킨다(드래곤로어/익스플로젼과 동일한 단일 대상 패턴 - 밀집
	-- 지역에서 판정 박스가 이웃까지 겹쳐 맞히는 것을 막는다).
	@ExecSpace("ServerOnly")
	method void DealComaHit(Entity target)
		if not isvalid(target) then return end
		self._T.comaCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local hitComps = self:AttackShadowSafe(shape, "skill.coma", target)
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		if actuallyHit then
			self:PlayComaHitEffect(target, self._T.pendingComaOrbCount or 0)
			self:PlayComaStunEffect(target)
			self:ApplyComaStun(target)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyComaStun(Entity target)
		-- (기능 추가) "코마에 맞은 적은 3초간 이동이 제한된다"는 요청 - 몬스터 전용 AI 추적 컴포넌트
		-- (AIChaseComponent)를 3초간 꺼서 새로운 이동 결정을 못 내리게 하고, 이미 진행 중이던 이동도
		-- 즉시 멈춘다. 별도의 커스텀 상태이상 시스템 없이 기존 컴포넌트만으로 최소한의 스턴을 구현한다.
		-- (버그 수정) "스턴이 걸렸는데도 이동한다"는 신고 - AIChaseComponent.Enable=false + 최초 1회
		-- MovementComponent:Stop()만으로는 부족했다(AIChase가 이미 내려둔 이동 명령이 몇 프레임 더
		-- 이어지거나, 다른 경로로 다시 이동이 걸릴 수 있음). MovementComponent 자체도 3초간 완전히
		-- 꺼서(Enable=false) 그 사이엔 어떤 경로로도 이동 로직이 아예 실행되지 않게 한다.
		if not isvalid(target) then return end
		local aiChase = target.AIChaseComponent
		local wasAIEnabled = isvalid(aiChase) and aiChase.Enable
		if isvalid(aiChase) then
			aiChase.Enable = false
		end
		local movement = target.MovementComponent
		local wasMovementEnabled = isvalid(movement) and movement.Enable
		if isvalid(movement) then
			movement:Stop()
			movement.Enable = false
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(target) and isvalid(aiChase) and wasAIEnabled then
				aiChase.Enable = true
			end
			if isvalid(target) and isvalid(movement) and wasMovementEnabled then
				movement.Enable = true
			end
		end, 3.0)
	end

	method string GetComaEffectRuid(integer orbCount)
		-- 소모한 콤보 구슬 개수(1~10)별 캐릭터 시전 이펙트 (skill/1111.img/skill/11111003의 finish/1~10).
		local ruids = {
			"8f260fa8eb49460691544a8806e80342",
			"e6eefdb13ca4452ba51437f1bca9d165",
			"7b5b0596abbd4f44afaa332f11943ebf",
			"6c60534394bf4fba8a2553528f3f9ec3",
			"8d638b1a7d5a4fac9de02f4c875ab956",
			"7805bdc3c28b471fb90fc27b51801d1b",
			"1e5b27a588564f44ab0ffc30040c1308",
			"895a0c9854634b88af00e658e2fb5327",
			"2672e793d7274cb5b8e4daa716671832",
			"3f6088e8a7134c5aaa65b4f5ac12e374",
		}
		return ruids[math.max(1, math.min(orbCount, #ruids))]
	end

	@ExecSpace("Multicast")
	method void PlayComaUseSound(Entity attacker)
		-- 코마 전용 사용 사운드. Multicast는 서버 자신도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("15cbdb9c56db4e87a379ba631e06a3d1", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayComaCastEffect(Entity attacker, number dirX, integer orbCount)
		-- 소모한 구슬 개수에 맞는 캐릭터 이펙트를 시전 즉시 1회 재생한다. 위치는 패닉의 몸쪽 이펙트와
		-- 동일(캐릭터 중심, Y오프셋 없음). Multicast는 서버 자신도 함께 실행하므로 클라이언트에서만
		-- 실행되게 막는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local effectRuid = self:GetComaEffectRuid(orbCount)
		local options = { ["FlipX"] = dirX > 0 }
		_EffectService:PlayEffectAttached(effectRuid, attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, options)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached(effectRuid, attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), options, dirX)
		log("[Coma] 시전 이펙트 재생 orbCount=" .. tostring(orbCount) .. " ruid=" .. tostring(effectRuid))
	end

	@ExecSpace("Multicast")
	method void PlayComaHitEffect(Entity target, integer orbCount)
		-- 코마에 맞은 몬스터 전용 히트 이펙트. 소모한 구슬 개수에 따라 두 종류 중 하나를 재생한다
		-- (5콤보 이하 / 6~10콤보).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local hitEffectRUID = (orbCount <= 5) and "df55af646a634f62a9a167a1380a147e" or "17b87afe9f03458cbaf63c0194d699ae"
		_EffectService:PlayEffectAttached(hitEffectRUID, target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
		self:EchoShadowHitEffect(hitEffectRUID, target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {})
	end

	@ExecSpace("Multicast")
	method void PlayComaStunEffect(Entity target)
		-- 코마에 맞은 대상 머리 위에 3초간 뜨는 스턴 표시 이펙트. 몬스터마다 크기가 달라도 항상 머리
		-- 바로 위에 뜨도록, 파이널어택 히트 이펙트와 동일하게 HitComponent의 콜라이더 크기로 머리
		-- 높이를 계산한다.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local headY = 0.5
		local hit = target.HitComponent
		if isvalid(hit) then
			headY = hit.ColliderOffset.y + hit.BoxSize.y / 2
		end
		local serial = _EffectService:PlayEffectAttached("b798d9bdc19e4bfab33ccc906f4ccd2a", target, Vector3(0, headY, 0), 0, Vector3(1, 1, 1), true, {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 3.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackBooster(boolean isMage, number atkMultiplier)
		-- 부스터(2차 버프): 실제 공격속도 상승 효과는 CharInfoManager가 클라에서 이미 적용했다.
		-- (요청) 모션 alert2 + 구버전 WZ 프레임 이펙트. isMage는 더 이상 쓰지 않는다.
		-- RUID 대응표: msw-dev-tools/resources/부스터/RUID.md
		-- (요청) 각 프레임의 눈에 보이는 바닥을 발과 네임태그 사이(BUFF_ANCHOR_Y)에 고정.
		self:CastBuffMotion("a83d56a314fd449cad236fd7d9b2fa63", atkMultiplier, nil)
		local dirX = self._T.pendingBoosterDirX or 1
		local ruids = {
			"42514aa334774d0bb0fade61945e5970", "9d4e8b3b2eab441a8aa42ef883531704",
			"b7b99713c5ba4a55948ee31c7e213820", "c94fc0ca497c4ee2b2496bae4ded3259",
			"d5f5ceb4d0a04e25b3b978755d7a2f85", "3d84f51e0bc84c99b90e1e299338401f",
			"ea23c07eb82742709a0cad07d9614954", "c112602d64c84307b0438420d8d8a394",
			"85ed511773ff4ba1be37b92190c0cd50",
		}
		-- (요청) 코드 보정(무게중심/x=0)이 아니라 원본 WZ origin(ox,oy)에 따라 각 프레임을 배치한다.
		-- 각 프레임의 origin 점을 캐릭터 부착점(발끝)에 맞춘다: xs=-(ox-W/2)/100, ys=(oy-H/2)/100.
		-- (centerX가 좌우반전 시 origin이 계속 부착점에 오도록 처리.) ox={25,20,20,20,25,25,25,15,12},
		-- oy={12,15,33,34,34,33,33,32,32}, W={44,45,48,62,79,79,56,51,48}, H={12,15,33,34,34,26,21,20,20}.
		local xs = { -0.03, 0.025, 0.04, 0.11, 0.145, 0.145, 0.03, 0.105, 0.12 }
		local ys = { 0.06, 0.075, 0.165, 0.17, 0.17, 0.20, 0.225, 0.22, 0.22 }
		-- 부스터: 9프레임 90ms 재생 후 0.2s 페이드아웃(영상은 작은 발끝 반짝임이 흩어지며 사라짐).
		self:SpawnBuffFrameEffect(self:MakeOriginFrames(ruids, xs, ys, 5), dirX, 0.1, 0.2)
	end

	@ExecSpace("ServerOnly")
	method void AttackRage(number atkMultiplier)
		-- 분노(2차 버프): 모션 alert2 + 이펙트/사운드. RUID: msw-dev-tools/resources/분노/RUID.md
		-- (요청) 각 프레임의 눈에 보이는 바닥을 발과 네임태그 사이(0.1)에 고정, 위로만 성장.
		-- (요청) 이펙트가 다 끝나기 전에 움직여지지 않도록 분노는 조작잠금을 이펙트 길이에 맞게 길게(1.2s).
		self:CastBuffMotion("267c7840593c419098060eb07e2b4dbb", atkMultiplier, 1.2)
		local dirX = self._T.pendingBoosterDirX or 1
		self:SpawnBuffFrameEffect(self:BuildRageFrames(), dirX, 0.1, 0.25)
	end

	method table BuildRageFrames()
		-- 분노 프레임 디스크립터(플레이어/드래곤 공용). AttackRage와 드래곤 검은색 버전이 함께 쓴다.
		-- (요청) 1~6번(흰 스파클 상승)은 빼고 7~19번만 이어서 재생한다(7_ 보라/흰 폭발 → 파란 오라 → 스파크).
		-- (강제이동 근본 수정 + 원작 정합) 프레임마다 크기가 달라 하단 고정 시 매 프레임 y를 바꿔 순간이동처럼
		-- 보였고, 하단 정렬은 원작의 스파크 분출 방향/높이도 없앴다. 그래서 7~19를 동일 캔버스(130×182)로
		-- 패딩하되 각 프레임의 원본 WZ origin(ox,oy)을 한 점(canvas 65,124)에 정렬해 재업로드했다
		-- (msw-dev-tools/resources/분노/padded_origin). 이제 모든 프레임 origin이 같은 캔버스 위치라 단일 고정
		-- 위치로 놓아도 강제이동이 없고, 폭발·오라·스파크가 원작처럼 각자 위치에 배치된다(스파크는 위/옆으로
		-- 분출). origin이 canvas y=124(center 91 기준 +33px)이므로 y=0.33에서 origin이 world 0(발끝)에 온다.
		-- (요청/영상 정합) 7~12번(폭발+오라 빌드업)은 캐릭터에 고정돼야 하는데, origin 정렬본은 프레임마다
		-- origin이 내용 중심과 달라(cx 58~65 들쭉날쭉) 가로로 밀려 보였다. 원작 영상은 7~12가 "가로 중심 +
		-- 내용 하단이 발끝"으로 캐릭터에 고정이라, 7~12를 내용중심(col65)·내용하단(row124) 기준으로 재패딩해
		-- 재업로드했다(padded_fix78). 13~19(스파크 분출)는 밖으로 퍼지는 게 의도라 origin 정렬본 유지.
		-- 전부 같은 130×182 캔버스라 단일 위치(y=0.33)에서 정렬된다.
		local ruids = {
			"c2a6680d91c84a98a42151cc5b47299a", "451ad9c3daf242c2bcc0ca704c171231",   -- 7,8 (내용정렬)
			"1b63db8e85e543738c3172c669651a62", "a02b80f5599f481f9818166f4e3abe9d",   -- 9,10 (내용정렬)
			"36faa085b70f4dceb681b13c5e507aec", "b0eac942e50d42e58cf37ba082fb7a6e",   -- 11,12 (내용정렬)
			"efad481e5db5447bbcff52debe1c15e3", "e6828bdf4c8147739b60285a680558a4",   -- 13,14
			"526568bad72b4dd4a516415c26d1110c", "d54c705fb1dc4a0ca06efa00d4148d0d",   -- 15,16
			"3f38641f56ab4c988966952ed951f723", "1c44ed375d9d477bb12dc29fdbbe2880",   -- 17,18
			"bbc5c210f9ef4fb6b83fccf2a9e41d4b",                                       -- 19
		}
		-- (요청) 전체 높이: 단일 y=0.33(origin=발끝). 이 값 하나만 올리고/내리면 전체가 동일 이동.
		-- (요청) 프레임당 기본 100ms, 단 12→13, 13→14 구간(프레임12·13)만 80ms로 빠르게.
		local rageFrames = self:MakeConstantFrames(ruids, 0, 0.33, 5)
		rageFrames[6].interval = 0.08   -- 프레임12(12→13)
		rageFrames[7].interval = 0.08   -- 프레임13(13→14)
		return rageFrames
	end

	@ExecSpace("ServerOnly")
	method void AttackMeditation(number atkMultiplier)
		-- 메디테이션(2차 버프): 모션 alert2 + 이펙트/사운드. RUID: msw-dev-tools/resources/메디테이션/RUID.md
		-- (요청) 각 프레임의 눈에 보이는 바닥을 발과 네임태그 사이(0.1)에 고정, 위로만 성장(분노와 동일).
		self:CastBuffMotion("3fa020cfd70f495c89c39fd3a3dd480a", atkMultiplier, nil)
		local dirX = self._T.pendingBoosterDirX or 1
		self:SpawnBuffFrameEffect(self:BuildMeditationFrames(), dirX, 0.1, 0.3)
	end

	method table BuildMeditationFrames()
		-- 메디테이션 프레임 디스크립터(플레이어/드래곤 공용).
		-- (요청/영상 실측) 메디테이션 이펙트는 "나무가 발밑에서 위로 자라남" 시퀀스(프레임 1~9)뿐이다.
		-- 원본 팩의 _10~_17은 나무가 아니라 별도의 작은 "나뭇잎+반짝임" 표식(버프 지속 표시)이라
		-- 시전 이펙트로 붙이면 큰 나무가 갑자기 작은 잎으로 튀어 부자연스러웠다 - 1~9만 사용한다.
		-- 영상 길이 0.76s / 9프레임 ≈ 45ms(기존 90ms는 2배 느렸음). 다 자란 뒤 0.3s 페이드아웃.
		-- (강제이동 근본 수정) 기존 소스 PNG는 프레임마다 크기가 달라(H 15~156), 중앙 피벗 특성상 밑동을
		-- 발끝에 고정하려면 코드가 매 프레임 위치(FrameLocalPos)를 다시 세팅해야 했다 - 이 프레임별 강제이동이
		-- 느린 재생에서 "튐"으로 보였다. 그래서 9장을 동일 캔버스(158×156)로 패딩하고 각 프레임의 밑동
		-- (가로=하단밴드 중심, 세로=origin oy)을 같은 캔버스 위치에 정렬해 재업로드했다(msw-dev-tools/
		-- resources/메디테이션/padded). 이제 모든 프레임이 같은 크기·같은 밑동위치라 단일 고정 위치로 놓으면
		-- 프레임별 이동이 전혀 없다. 위치: 밑동이 canvas y=147(center 78 기준 +69px)이므로 y=0.69에서 밑동이
		-- world 0(발끝)에 온다. x=0(캔버스 중심=밑동). RUID: msw-dev-tools/resources/메디테이션/RUID.md
		local ruids = {
			"fbf3efdbb65a471296d3b6932faaaccb", "b36a872cc61f401fa248d9483c7baa48",
			"587f1c0fdc254cabad1701395814498c", "1b78e68cd9c14ddfb8b5b1dd5ef51f30",
			"e868faf607ce4698a538053515026e2d", "5b4258569fd447ba952faf18383a7e49",
			"d790809da58249a9bffe6fec4c684587", "8ddd66f6b9844b23aa789859bcac064b",
			"03128f23618849e98d401d05b944bd28",
		}
		-- (끝프레임 미세 이동 보정) 패딩 정렬 잔차로 후반 프레임(7~9)의 밑동이 캔버스 중심에서 좌측으로
		-- ~0.6~1.9px 치우쳐(캔버스 고정밴드 y130-150 실측) 끝쪽에서 캐릭터 앞으로 살짝 이동해 보였다.
		-- 각 프레임 밑동을 정확히 world 0(중심=캐릭터)에 오도록 미세 x보정: xs=-(밑동offset px)/100
		-- (centerX로 좌우반전 대응). 대부분 0에 가깝고 7~9만 유효 보정. ys는 0.69 고정(밑동=발끝).
		-- baseXs = 밑동을 캐릭터 중심에 정렬하는 보정값(끝프레임 미세 이동 방지).
		local baseXs = { -0.003, -0.002, -0.001, -0.001, -0.005, -0.002, 0.006, 0.014, 0.019 }
		local ys = { 0.69, 0.69, 0.69, 0.69, 0.69, 0.69, 0.69, 0.69, 0.69 }
		-- (요청) 다시 캐릭터를 가리도록 앞에 그린다(order 5, 기본 SortingLayer) - 뒤로보내기(MapLayer0) 제거.
		-- (요청) 이펙트 전체를 바라보는 방향(앞)으로 당긴다. centerX는 FrameLocalPos.x=-xs*dirX라, 앞으로
		-- +forwardX*dirX 만큼 옮기려면 각 xs에서 forwardX를 빼면 된다(더/덜 당기려면 forwardX만 조정).
		local forwardX = 0.1
		local xs = {}
		for i, v in ipairs(baseXs) do xs[i] = v - forwardX end
		return self:MakeOriginFrames(ruids, xs, ys, 5)
	end

	@ExecSpace("ServerOnly")
	method void AttackBless(number atkMultiplier)
		-- 블레스(2차 버프): 자신 공마 +30(클라 CharInfoManager가 이미 적용)에 더해, 힐과 같은 범위
		-- (좌우/위아래 ±3.6)의 소환된 용사들에게도 전투력 +30(5분)을 걸어준다. 버프를 받은 뒤에는
		-- 거리와 무관하게 유지된다(만료 타이머 방식). 시전 이펙트(effect0~10)는 본인에게,
		-- 피버프 이펙트(affected0~10)는 버프받은 용사에게 재생해 적용을 시각적으로 보여준다.
		-- 모션/사운드는 2차 버프 공용 시전(alert 루프) 재사용. RUID: msw-dev-tools/resources/블레스/RUID.md
		self:CastBuffMotion("693e8550871b4a0db0e6970f08e26add", atkMultiplier, nil)
		local dirX = self._T.pendingBoosterDirX or 1
		self:SpawnBuffFrameEffect(self:BuildBlessFrames(), dirX, 0.1, 0.25)

		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local myPos = self.Entity.TransformComponent.WorldPosition
		local heroComps = map:GetChildComponentsByTypeName("script.HeroSummon", true)
		local buffed = 0
		for _, comp in ipairs(heroComps) do
			---@type HeroSummon
			local hs = comp
			if isvalid(hs) and isvalid(hs.Entity) and hs.HeroHp > 0 then
				local pos = hs.Entity.TransformComponent.WorldPosition
				if math.abs(pos.x - myPos.x) <= 3.6 and math.abs(pos.y - myPos.y) <= 3.6 then
					hs:ApplyBlessBuff(30, 300.0)
					self:SpawnBuffFrameEffectEx(self:BuildBlessAffectedFrames(), 1, 0.08, 0.25, hs.Entity, 1.0, 1.0, 1.0)
					buffed = buffed + 1
				end
			end
		end
		-- 소환된 힐러(HealerSummon)도 같은 범위에서 블레스를 받는다 - 전투력 +30이 힐 회복량 강화로 반영.
		local healerComps = map:GetChildComponentsByTypeName("script.HealerSummon", true)
		for _, comp in ipairs(healerComps) do
			---@type HealerSummon
			local hlc = comp
			if isvalid(hlc) and isvalid(hlc.Entity) and hlc.HealerHp > 0 then
				local pos = hlc.Entity.TransformComponent.WorldPosition
				if math.abs(pos.x - myPos.x) <= 3.6 and math.abs(pos.y - myPos.y) <= 3.6 then
					hlc:ApplyBlessBuff(30, 300.0)
					self:SpawnBuffFrameEffectEx(self:BuildBlessAffectedFrames(), 1, 0.08, 0.25, hlc.Entity, 1.0, 1.0, 1.0)
					buffed = buffed + 1
				end
			end
		end
		log("[PlayerAttack] 블레스 발동 - 버프받은 소환수 " .. tostring(buffed) .. "명")
	end

	method table BuildBlessFrames()
		-- 블레스 시전자 이펙트(effect0~10): 발밑 반짝임(0~3)에서 큰 빛기둥(4~10)으로 자라는 시퀀스.
		-- (흔들림 근본 수정) 프레임마다 크기/origin이 달라 프레임별 오프셋(MakeOriginFrames)을 주면
		-- 매 프레임 위치가 바뀌어 지진처럼 보였다 - 분노(padded_origin)와 동일하게 11장을 같은 캔버스
		-- (93x380)로 패딩하고 각 프레임의 WZ origin(ori.txt)을 캔버스 한 점(46,366)에 정렬해 재업로드했다
		-- (msw-dev-tools/resources/블레스/padded). 모든 프레임이 같은 크기·같은 origin 위치라 단일 고정
		-- 위치로 놓으면 프레임별 이동이 전혀 없다. origin이 canvas y=366(center 190 기준 +176px)이므로
		-- y=1.76에서 origin이 world 0(발끝)에 온다. 프레임당 100ms.
		local ruids = {
			"3f2ba57ceb724b3aba1c9205292fe6c1", "8c47758b2cc143469be1bf9148fbb345",
			"981b537715ca420e85bad99c0b09886a", "c873a59b360746d5afb7b6a6f801b940",
			"434275d7979f4339bddb232d3e90f9ad", "933e9d7f0dca40a19c2cc58f2298a9b1",
			"745690c5baf34bd48bd8fa2e1e8543f8", "99bc646420bd4d8e86f7ea89e3bbf02a",
			"d1915346d12b47feab9fef9427312172", "e3fdc90505e44322a9cf1609eb1640bf",
			"1af5a3dc8713417480b08537cf882079",
		}
		return self:MakeConstantFrames(ruids, 0, 1.76, 5)
	end

	method table BuildBlessAffectedFrames()
		-- 블레스 피버프자 이펙트(affected0~10): 버프를 받은 대상의 상체 주위에 도는 빛 고리.
		-- 시전자 이펙트와 같은 이유로 패딩 정렬본(91x130 캔버스, origin(47,130) 정렬) 사용 - 단일 고정
		-- 위치라 프레임별 이동 없음. origin이 canvas y=130(center 65 기준 +65px)이므로 y=0.65에서
		-- origin이 발끝에 온다(내용은 상체 높이에 배치됨). ori.txt 실측 딜레이 - 0~9번은 80ms
		-- (frameInterval 0.08), 마지막 10번만 300ms(프레임별 interval 필드로 개별 지정).
		local ruids = {
			"1c5ceb5b21af4e9c9a73bb371d8609e8", "5b52635496af427882cfdfd1962b8143",
			"033d6254dc1340ff8757482266bc7770", "5a0c60a200644c7ca5af8aa120d1adf8",
			"d2f9e539b9d04662be1bb3933673f2cf", "10c49d0b8ac34f2382ef97c48c7ba522",
			"867e8f5003e34eb781dc8a7d762850a8", "97c816f3cf0c47efb45f2ecbd1c2f2a6",
			"ae32c0d6ffe04774ba24ef9c251f37d3", "eb7aefeee82b4e48b281bcd584344e38",
			"0544be7da91a4aa38b2d5fd59f7aad7e",
		}
		local frames = self:MakeConstantFrames(ruids, 0, 0.65, 5)
		frames[11].interval = 0.3
		return frames
	end

	-- ===== 다크드래곤이 걸어주는 버프 전용(캐릭터 시전모션 없음, 시전 이펙트는 드래곤 위치) =====

	@ExecSpace("ServerOnly")
	method void ActivateComboAttackSilent(number duration)
		-- (다크드래곤) 콤보 어택 버프를 캐릭터 모션/시전이펙트 없이 활성화만 한다. 구슬(원) 회전은 기존대로
		-- 캐릭터가 적을 때릴 때 OnAttack에서 캐릭터 몸 주위에 쌓인다(= 캐릭터에게 나타남).
		if not isvalid(self.Entity.PlayerComponent) then return end
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then return end
		self._T.comboAttackToken = (self._T.comboAttackToken or 0) + 1
		local myToken = self._T.comboAttackToken
		self._T.comboAttackActive = true
		local userId = self.Entity.PlayerComponent.UserId
		self:NotifyComboAttackStart(duration, userId)
		_TimerService:SetTimerOnce(function()
			if self._T.comboAttackToken ~= myToken then return end
			self._T.comboAttackActive = false
			self:ClearComboOrbs()
			log("[ComboAttack] 드래곤 버프 종료(" .. tostring(duration) .. "초)")
		end, duration)
		log("[ComboAttack] 드래곤 버프 시작 duration=" .. tostring(duration))
	end

	@ExecSpace("ServerOnly")
	method void ActivateShadowPartnerSilent(number duration)
		-- (다크드래곤) 쉐도우 파트너 버프를 캐릭터 모션/시전이펙트 없이 활성화만 한다. 그림자(등뒤 실루엣)는
		-- 기존대로 캐릭터의 자식으로 스폰돼 캐릭터에게 나타난다.
		if not isvalid(self.Entity.PlayerComponent) then return end
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then return end
		self:SpawnOrShowShadowEntity()
		self._T.shadowPartnerToken = (self._T.shadowPartnerToken or 0) + 1
		local myToken = self._T.shadowPartnerToken
		self._T.shadowPartnerActive = true
		self.ShadowPartnerOn = true
		local userId = self.Entity.PlayerComponent.UserId
		self:NotifyShadowPartnerStart(duration, userId)
		_TimerService:SetTimerOnce(function()
			if self._T.shadowPartnerToken ~= myToken then return end
			self._T.shadowPartnerActive = false
			self.ShadowPartnerOn = false
			if isvalid(self._T.shadowPartnerEntity) then
				self._T.shadowPartnerEntity.Enable = false
			end
			log("[ShadowPartner] 드래곤 버프 종료(" .. tostring(duration) .. "초)")
		end, duration)
		log("[ShadowPartner] 드래곤 버프 시작 duration=" .. tostring(duration))
	end

	@ExecSpace("ServerOnly")
	method void CastDragonRageEffect(Entity anchor, number dirX)
		-- (다크드래곤) 분노 이펙트를 드래곤(anchor) 위치에서 검은색(틴트 0,0,0)으로 재생. 스탯 버프는
		-- CharInfoManager가 소유주 클라에서 별도 적용한다.
		self:SpawnBuffFrameEffectEx(self:BuildRageFrames(), dirX, 0.1, 0.25, anchor, 0.0, 0.0, 0.0)
	end

	@ExecSpace("ServerOnly")
	method void CastDragonMeditationEffect(Entity anchor, number dirX)
		-- (다크드래곤) 메디테이션 이펙트를 드래곤(anchor) 위치에서 검은색으로 재생.
		self:SpawnBuffFrameEffectEx(self:BuildMeditationFrames(), dirX, 0.1, 0.3, anchor, 0.0, 0.0, 0.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackPowerGuard(number atkMultiplier)
		-- 파워가드(2차 버프): 모션 alert2 + 이펙트/사운드. 30% 회복은 PlayerHit(서버) 담당.
		-- 파워가드 팩엔 사운드가 없어 기존 버프음 재사용. RUID: msw-dev-tools/resources/파워가드/RUID.md
		-- (요청/WZ origin 실측) 업로드 PNG는 중앙 피벗이므로, 각 프레임을 원본 origin(ox,oy)이 한 점
		-- (캐릭터 부착점)에 오도록 중앙 오프셋 dx=-(ox-W/2)/100, dy=(oy-H/2)/100 만큼 옮겨 배치한다.
		-- 그러면 프레임 안에 그려진 "좌/우에서 합쳐짐" 모션이 그대로 살아난다(별도 슬라이드 불필요).
		-- 구성(요청): 좌측 절반 1~4 + 우측 절반 13~16 이 동시에 좌우에서 생성돼 합쳐지고(각 100ms),
		-- 그 뒤 본체 실드 5~12 가 캐릭터에서 1회 재생(100ms). 부착점 세로 = anchorY.
		-- dx,dy 는 PIL 실측(각 PNG 크기 + 사용자가 준 origin). y = anchorY + dy.
		self:CastBuffMotion("a83d56a314fd449cad236fd7d9b2fa63", atkMultiplier, nil)
		local dirX = self._T.pendingBoosterDirX or 1
		local anchorY = 0
		-- (요청) 파워가드 이펙트 전체를 캐릭터 정면 쪽으로 이동하는 공통 오프셋. build에서 모든 프레임
		-- x에 더한다(dirX가 곱해지므로 +면 항상 바라보는 정면 쪽). 더 앞/뒤로는 이 값만 조정.
		local forwardX = 0.0
		-- { ruid, dx, dy }
		-- (요청) 앞/뒤 order는 그대로 두고 1~4와 13~16의 가로 위치만 맞바꿈(dx 스왑).
		local leftHalf = {   -- 1~4 (앞, order 6): 위치를 우측(+0.185)으로 스왑
			{ "3697356e16ba486cb9069c432d976235", 0.185, 0.385 },
			{ "d3c16c82974b4933b03eeba3c2ec644c", 0.185, 0.385 },
			{ "88b7df45f13e43f5acdb374b9d5286a8", 0.185, 0.385 },
			{ "f12bdb312e404be5a58e7fb157ee9b8f", 0.185, 0.385 },
		}
		local rightHalf = {  -- 13~16 (뒤): 위치는 -0.245 그대로, 가려짐은 z-order(캐릭터보다 뒤)로 처리
			{ "6fcc6e7183704cff9ec8a356ff477c64", -0.245, 0.385 },
			{ "a49bed1bd7f04571b78a6507bcc5f2b2", -0.245, 0.385 },
			{ "88175dd62ea3411faffee0446b5716f6", -0.245, 0.385 },
			{ "5e9e7bdbc0624cd8b9aac4698f3ade58", -0.245, 0.385 },
		}
		-- 본체 실드 5~12: 한 덩어리 실드가 제자리에 서 있어야 하므로 전 프레임 위치를 (0.00, 0.425)로
		-- 통일한다(프레임별 크기/origin 차이로 인한 8~9번 근처 미세 떨림 제거).
		local mainShield = {
			{ "b68ea6ee3e0445a0898f02da53070dab", 0.00, 0.395 },
			{ "8bac5a8b9fe04382a50afac0bc65a994", 0.00, 0.395 },
			{ "04ab10c58c174b27b11be0beaf30f1b9", 0.00, 0.395 },
			{ "23a03201d15f46dc8b7d34d9af562c04", 0.00, 0.395 },
			{ "14d58140ffe94bb383d8ce4fb7fef2d5", 0.00, 0.395 },
			{ "b3199ee4a4ec48fc84a6aab4a824cd74", 0.00, 0.395 },
			{ "b1585d55ff8f4bb2af9e23d0fc4abe72", 0.00, 0.395 },
			{ "a52d7487325540fea53e92d14b4e023f", 0.00, 0.395 },
		}
		local function build(list, order, sortingLayer)
			local frames = {}
			for _, e in ipairs(list) do
				table.insert(frames, { ruid = e[1], x = e[2] + forwardX, y = anchorY + e[3], order = order, sortingLayer = sortingLayer })
			end
			return frames
		end
		-- 좌/우 절반 동시 생성 → 합쳐짐(각 4프레임 × 100ms = 0.4s, 페이드 없이 본체로 전환).
		-- 좌측 1~4/본체 실드는 캐릭터 앞(order 10, 기본 SortingLayer).
		-- (요청) 우측 13~16만 캐릭터 뒤로: OrderInLayer는 같은 SortingLayer 안에서만 비교되는데 이 이펙트의
		-- 기본 SortingLayer가 아바타(MapLayer0)보다 통째로 앞이라 order를 아무리 내려도 소용없다 - 아바타와
		-- 같은 SortingLayer("MapLayer0")로 올리고 OrderInLayer를 아바타(4)보다 작게(3, 지형 타일 1보다는 앞) 준다.
		self:SpawnBuffFrameEffect(build(leftHalf, 10, ""), dirX, 0.1, 0)
		self:SpawnBuffFrameEffect(build(rightHalf, 3, "MapLayer0"), dirX, 0.1, 0)
		-- 본체 실드는 합쳐짐이 끝난 뒤(0.4s) 캐릭터에서 1회 재생 + 0.2s 페이드아웃(앞, order 10)
		_TimerService:SetTimerOnce(function()
			self:SpawnBuffFrameEffect(build(mainShield, 10, ""), dirX, 0.1, 0.2)
		end, 0.4)
	end

	@ExecSpace("ServerOnly")
	method void CastRecoveryAura()
		-- 리커버리 오로라(4차): 시전자 발밑에 60초간 유지되는 오로라 장판을 설치한다.
		-- 오로라 주변에서는 쿨타임 스킬을 대기시간 없이 바로 재사용할 수 있다 - 실제 쿨타임 우회 판정은
		-- 각 클라이언트 SkillManager(IsInRecoveryAura)가 하고, 여기서는 (1) 시전 모션, (2) 장판 엔티티
		-- 스폰(빈 스프라이트 모델 + RecoveryAuraVisual이 클라에서 20프레임 순환 재생), (3) 모든 클라에
		-- 노쿨 영역 등록(NotifyRecoveryAuraPlaced), (4) 60초 뒤 엔티티 정리를 담당한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local wp = self.Entity.TransformComponent.WorldPosition
		-- 시전 모션(숨고르기) + 사용음(임시 - 블레스 사용음 재사용, 전용 사운드가 생기면 교체).
		self:CastBuffMotion("693e8550871b4a0db0e6970f08e26add", 1.0, nil)
		-- padded 캔버스(412x150)의 origin 정렬점(216,140)이 시전자 발끝(wp)에 오도록 중심피벗 오프셋을
		-- 적용한다: 엔티티 위치 = (P.x - 0.10, P.y + 0.65) (RUID.md 배치 공식).
		local AURA_DURATION = 60.0
		self._T.recoveryAuraSeq = (self._T.recoveryAuraSeq or 0) + 1
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "RecoveryAura_" .. tostring(self._T.recoveryAuraSeq), Vector3(wp.x - 0.10, wp.y + 0.65, 0), map)
		if not isvalid(fx) then
			log_warning("PlayerAttack: 리커버리 오로라 스폰 실패")
			return
		end
		fx:AddComponent("script.RecoveryAuraVisual")
		_SkillManager:NotifyRecoveryAuraPlaced(wp.x, wp.y, AURA_DURATION)
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then
				fx:Destroy()
			end
		end, AURA_DURATION)
		log("PlayerAttack: 리커버리 오로라 설치 x=" .. string.format("%.2f", wp.x) .. " y=" .. string.format("%.2f", wp.y) .. " (지속 " .. tostring(AURA_DURATION) .. "초)")
	end

	@ExecSpace("ServerOnly")
	method void CastBuffMotion(string soundRuid, number atkMultiplier, number lockDuration)
		-- 4종 버프 공용 시전의 모션/조작잠금/사운드 부분(이펙트는 각 Attack* 메서드가 직접 스폰).
		-- (요청) 사용 즉시 "숨고르기"(breather = alert 루프) 모션을 재생한다. 예전엔 PlayBoosterMotion에
		-- "alert2"를 넘겼는데 유효 클립이 아니라 아무 모션도 안 나왔다 - PlayBreatherImmediate로 즉시 재생.
		-- 스탯 효과는 CharInfoManager가 클라에서 이미 적용했다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then return end
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingBoosterDirX = dirX
		self._T.pendingBoosterWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then playerCtrl.Enable = false end
		if isvalid(self.Entity.MovementComponent) then self.Entity.MovementComponent:Stop() end
		-- 즉시 숨고르기(alert 루프) 재생. 컨트롤 복구(RestoreBoosterControl) 시점의 PlayBreather가
		-- 복구 직후 컨트롤러의 IDLE 스냅을 잡아 숨고르기를 이어가므로 끊기지 않는다.
		self:PlayBreatherImmediate(self.Entity, dirX)
		-- (요청) 조작잠금 시간: lockDuration이 주어지면 그 절대값(초), 없으면 기존 0.6*mult. 분노는 이펙트가
		-- 끝나기 전에 못 움직이도록 길게(1.2s) 넘긴다. 나머지 버프는 nil로 넘겨 기존 동작 유지.
		local lock = lockDuration or (0.6 * mult)
		_TimerService:SetTimerOnce(function()
			self:RestoreBoosterControl()
		end, lock)
		self:PlayBuffSound(soundRuid)
	end

	method table MakeConstantFrames(table ruids, number x, number y, integer order)
		-- 모든 프레임을 같은 x/y/order에 두는 디스크립터 목록을 만든다(부스터/파워가드 B레이어용).
		local out = {}
		for _, ruid in ipairs(ruids) do
			table.insert(out, { ruid = ruid, x = x, y = y, order = order })
		end
		return out
	end

	method table MakeOriginFrames(table ruids, table xs, table ys, integer order)
		-- (요청/원본 origin 실측) 각 프레임의 WZ origin(ox,oy)을 캐릭터 부착점에 맞추기 위한 중앙피벗
		-- 오프셋을 미리 계산해 넘긴다: x=dx=-(ox-W/2)/100, y=dy=(oy-H/2)/100 (world 단위, 100px=1unit).
		-- SpawnBuffFrameEffect에서 x는 dirX가 곱해져 좌우 반전되고, y는 그대로 적용된다.
		-- centerX=true: x는 origin 중앙피벗 보정값이라 좌우반전(IsFlipX) 시 부호가 뒤집혀야 origin이
		-- 한 점에 고정된다(SpawnBuffFrameEffect에서 -x*dirX로 적용). 프레임마다 dx가 달라도 안 밀린다.
		local out = {}
		for i, ruid in ipairs(ruids) do
			table.insert(out, { ruid = ruid, x = xs[i] or 0, y = ys[i] or 0, order = order, centerX = true })
		end
		return out
	end

	method table MakeAnchoredFrames(table ruids, table offsets, number anchorY, integer order)
		-- (요청) 각 프레임의 "눈에 보이는 실제 바닥"(투명 여백 제외 마지막 불투명 픽셀)을 anchorY 한
		-- 지점(발과 네임태그 사이)에 고정하고 위로만 자라게 한다. offsets[i] = 스프라이트 중심에서
		-- 내용 하단까지의 거리(px, 아래로 +, PIL로 실측). 중앙 피벗이라 내용 하단 world = Position.y -
		-- offset/100 이므로, y = anchorY + offset/100 로 주면 크기가 달라도 모든 프레임의 내용 하단이
		-- anchorY에 정렬된다. 위치는 FrameLocalPos로 클라가 직접 적용해 프레임마다 y가 바뀌어도
		-- 떨리지 않는다(SpawnBuffFrameEffect 참고). (100px = 1 world unit)
		local out = {}
		for i, ruid in ipairs(ruids) do
			table.insert(out, { ruid = ruid, x = 0, y = anchorY + (offsets[i] or 0) / 100, order = order })
		end
		return out
	end

	@ExecSpace("ServerOnly")
	method void SpawnBuffFrameEffect(table frames, number dirX, number frameInterval, number fadeDuration)
		-- 기존 호출부(부스터/분노/메디테이션/파워가드)용 래퍼: 캐릭터(self.Entity)에 원본색(틴트 1,1,1)으로.
		self:SpawnBuffFrameEffectEx(frames, dirX, frameInterval, fadeDuration, self.Entity, 1.0, 1.0, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnBuffFrameEffectEx(table frames, number dirX, number frameInterval, number fadeDuration, Entity anchor, number tr, number tg, number tb)
		-- 프레임 교체 방식 이펙트. 각 프레임 디스크립터 { ruid, x, y, order }를 frameInterval 간격으로 재생.
		-- (다크드래곤) anchor에 부착(캐릭터 대신 드래곤 가능) + tint(tr,tg,tb) 색 적용(검은색 버프용).
		-- (요청 - 영상 매칭) frameInterval을 스킬별로 받아 재생속도를 영상에 맞춘다(메디테이션 45ms 등).
		-- 재생 동안 solid(alpha 1)로 유지하고, 다 재생한 뒤 fadeDuration>0이면 마지막 프레임에서 알파를
		-- 1→0으로 페이드아웃한다(영상처럼 "다 자란 뒤 사라짐"). fadeDuration=0이면 그냥 컷.
		-- (요청 - 지진 제거) 위치는 서버가 TransformComponent.Position을 옮기지 않고 FrameLocalPos(@Sync)만
		-- 갱신 - 클라가 OnUpdate에서 보간 없이 직접 적용해 프레임마다 위치가 바뀌어도 떨리지 않는다.
		self._T.buffFxSeq = (self._T.buffFxSeq or 0) + 1
		local f0 = frames[1]
		if f0 == nil then return end
		-- (요청) 프레임별 개별 딜레이 지원: 각 프레임에 interval 필드가 있으면 그 값을, 없으면 기본
		-- frameInterval을 그 프레임의 표시 시간으로 쓴다(분노 8·9번만 80ms). 시작 시각을 누적 계산한다.
		-- interval 필드가 하나도 없으면 결과는 기존 (#frames * frameInterval)과 동일하다(하위호환).
		local starts = {}
		local acc = 0
		for i = 1, #frames do
			starts[i] = acc
			acc = acc + (frames[i].interval or frameInterval)
		end
		local playTime = acc
		local parentEntity = isvalid(anchor) and anchor or self.Entity
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "BuffFx" .. tostring(self._T.buffFxSeq), Vector3(0, 0, 0), parentEntity)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.TintR = tr
			comp.TintG = tg
			comp.TintB = tb
			comp.IsFlipX = dirX > 0
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.StartAlpha = 1.0
			if fadeDuration > 0 then
				comp.EndAlpha = 0.0
				comp.HoldDuration = playTime           -- 재생 동안 solid
				comp.TweenDuration = fadeDuration       -- 재생 후 페이드아웃
			else
				comp.EndAlpha = 1.0
				comp.HoldDuration = 5.0
				comp.TweenDuration = 0.0
			end
			comp.OrderInLayerValue = f0.order or 5
			-- (버그 수정) 캐릭터 뒤로 보내려면 OrderInLayer만으론 부족하고 SortingLayer를 아바타와 같은
			-- 레이어("MapLayer0")로 맞춰야 한다(파워가드 13~16 가림 원인). 프레임 디스크립터에 sortingLayer가
			-- 있으면 적용, 없으면 기본 SortingLayer 그대로(부스터/분노/메디테이션 등 기존 사용처 영향 없음).
			comp.SortingLayerName = f0.sortingLayer or ""
			comp.UseFrameLocalPos = true
			-- centerX 프레임(origin 중앙보정)은 반전 시 부호 반전(-x*dirX), 그 외(위치성 offset)는 x*dirX.
			local f0x = f0.centerX and (-(f0.x or 0) * dirX) or ((f0.x or 0) * dirX)
			comp.FrameLocalPos = Vector2(f0x, f0.y or 0)
			comp.ClipRUID = f0.ruid
		end
		for i = 2, #frames do
			local fr = frames[i]
			local prev = frames[i - 1]
			local orderChanged = (fr.order ~= prev.order)
			_TimerService:SetTimerOnce(function()
				if not isvalid(comp) then return end
				comp.ClipRUID = fr.ruid
				if orderChanged then comp.OrderInLayerValue = fr.order or 5 end
				local frx = fr.centerX and (-(fr.x or 0) * dirX) or ((fr.x or 0) * dirX)
				comp.FrameLocalPos = Vector2(frx, fr.y or 0)
			end, starts[i])
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, playTime + fadeDuration + 0.05)
	end

	@ExecSpace("Multicast")
	method void PlayBuffSound(string soundRuid)
		-- 버프 사용음(클라이언트에서만 재생).
		if not self:IsClient() then return end
		if soundRuid == nil or soundRuid == "" then return end
		_SoundService:PlaySound(soundRuid, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayBoosterMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 부스터 전용 모션 재생 (힐과 동일한 방식/모션 - 별도 플래그로 서로 간섭하지 않는다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isBoosterDirectionLocked = true
		self._T.lockedBoosterDirX = dirX
		self._T.lockedBoosterMotionName = motionName
		self._T.isBoosterMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedBoosterPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[Booster] PlayBoosterMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isBoosterMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isBoosterDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Server")
	method void RestoreBoosterControl()
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingBoosterWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingBoosterDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void AttackPoisonMist(number combatPower, number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 포이즌 미스트: 시전 위치에 독안개(PoisonMist)를 소환한다. 실제 독 데미지는 안개가
		-- 대상에게 부착하는 PoisonDebuffComponent가 독립적인 1초 틱으로 처리한다(공격속도 영향 없음,
		-- 헤이스트/부스터처럼 여기서는 시전 이펙트/사운드 재생과 소환만 담당한다).
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then
			return
		end

		-- 힐과 동일한 모션(alert)을 재생하고, 그동안 다른 행동을 제한한다.
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingPoisonMistDirX = dirX
		self._T.pendingPoisonMistWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self:PlayPoisonMistMotion(self.Entity, "alert", dirX, mult)
		_TimerService:SetTimerOnce(function()
			self:RestorePoisonMistControl()
		end, 0.6 * mult)

		self:PlayPoisonMistCastEffect(self.Entity)

		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.poisonMistCount = (self._T.poisonMistCount or 0) + 1
		local name = "poisonmist_" .. tostring(self._T.poisonMistCount)
		local pos = self.Entity.TransformComponent.WorldPosition
		local mist = _SpawnService:SpawnByModelId("poisonmist", name, Vector3(pos.x, pos.y, pos.z), map)
		if not isvalid(mist) then
			log_warning("[PoisonMist] 스폰 실패")
			return
		end
		local zone = mist:GetComponent("script.PoisonMistZone")
		if zone ~= nil then
			zone:Init(combatPower)
		end
		-- 불의 영역/빙하지대 프록용 시전자 참조를 독안개 판정 컴포넌트에 새겨준다.
		---@type PoisonMistAttack
		local mistAtk = mist:GetComponent("script.PoisonMistAttack")
		if mistAtk ~= nil then mistAtk.OwnerEntity = self.Entity end
		log("[PoisonMist] 소환 x=" .. tostring(pos.x) .. " y=" .. tostring(pos.y))
	end

	@ExecSpace("Multicast")
	method void PlayPoisonMistCastEffect(Entity attacker)
		-- 사용 시 캐릭터 몸쪽 이펙트 + 사용 사운드 (skill/211.img/skill/2111003 리소스팩의 "effect"/"_audio/Use" 노드)
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local serial = _EffectService:PlayEffectAttached("b0d47a8948314a5ea04a00690d921fc3", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫)
		local echoSerial = self:EchoShadowSkillEffectAttached("b0d47a8948314a5ea04a00690d921fc3", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {}, 0)
		_SoundService:PlaySound("eb7f504670a14802a48cc94f4eb66848", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
			if echoSerial ~= 0 then
				_EffectService:RemoveEffect(echoSerial)
			end
		end, 1.5)
	end

	@ExecSpace("Multicast")
	method void PlayPoisonMistMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 포이즌 미스트 전용 모션 재생 (힐과 동일한 방식/모션 - 별도 플래그로 서로 간섭하지 않는다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isPoisonMistDirectionLocked = true
		self._T.lockedPoisonMistDirX = dirX
		self._T.lockedPoisonMistMotionName = motionName
		self._T.isPoisonMistMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedPoisonMistPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[PoisonMist] PlayPoisonMistMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isPoisonMistMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isPoisonMistDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Server")
	method void RestorePoisonMistControl()
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingPoisonMistWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingPoisonMistDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void AttackExplosion(number combatPower, number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 익스플로젼: 시전 이펙트 재생 후 1초 뒤 실제로 터진다(몸쪽 스페셜 이펙트 + 전방 무관 최대 6명 500~700%
		-- 데미지). 폭발 시점에 주변(독구름의 확대된 시각적 크기의 1.0배)에 있는 독구름을 최대 6개까지 0.1초
		-- 간격으로 하나씩 터뜨리며, 터진 자리마다 이펙트/사운드와 함께 500~700% 추가 데미지를 준다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isExploding then
			log("PlayerAttack: AttackExplosion 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isExploding = true
		self._T.pendingExplosionCombatPower = combatPower

		-- 힐과 동일한 모션(alert)을 재생하고, 그동안 다른 행동을 제한한다.
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingExplosionDirX = dirX
		self._T.pendingExplosionWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self:PlayExplosionMotion(self.Entity, "alert", dirX, mult)
		_TimerService:SetTimerOnce(function()
			self:RestoreExplosionControl()
		end, 0.6 * mult)

		self:PlayExplosionCastEffect(self.Entity)

		_TimerService:SetTimerOnce(function()
			self:DetonateExplosion()
		end, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayExplosionMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 익스플로젼 전용 모션 재생 (힐과 동일한 방식/모션 - 별도 플래그로 서로 간섭하지 않는다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isExplosionDirectionLocked = true
		self._T.lockedExplosionDirX = dirX
		self._T.lockedExplosionMotionName = motionName
		self._T.isExplosionMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedExplosionPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[Explosion] PlayExplosionMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isExplosionMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isExplosionDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Server")
	method void RestoreExplosionControl()
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingExplosionWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingExplosionDirX or 1)
	end

	@ExecSpace("Multicast")
	method void PlayExplosionCastEffect(Entity attacker)
		-- 시전 즉시 캐릭터 몸쪽에서 1회 재생되는 준비 이펙트 (skill/211.img/skill/2111002 리소스팩의 "prepare" 노드)
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_EffectService:PlayEffectAttached("419e26654a5e470fa386a8a4e92e9eb3", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 준비 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("419e26654a5e470fa386a8a4e92e9eb3", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {}, 0)
	end

	@ExecSpace("ServerOnly")
	method void DetonateExplosion()
		-- 시전 2초 뒤 호출되어 실제 폭발 판정을 진행한다.
		self._T.isExploding = false
		if not isvalid(self.Entity) then return end

		self:PlayExplosionMainEffect(self.Entity)

		local worldPos = self.Entity.TransformComponent.WorldPosition
		local targets = self:FindExplosionTargets(Vector2(worldPos.x, worldPos.y), 6)
		for _, t in ipairs(targets) do
			self:DealExplosionHit(t)
		end
		log("PlayerAttack: AttackExplosion 폭발! targets=" .. tostring(#targets))

		self:PopNearbyPoisonMists(worldPos)
	end

	@ExecSpace("Multicast")
	method void PlayExplosionMainEffect(Entity attacker)
		-- 몸쪽 이펙트(38f9aa42...) 재생 후, 같은 리소스팩의 special 3종 중 하나를 이어서 재생한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_EffectService:PlayEffectAttached("38f9aa42ec39406987a9fd92ba2c14ad", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 몸쪽/스페셜 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("38f9aa42ec39406987a9fd92ba2c14ad", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {}, 0)
		local specials = {
			"154a7b585c474b07ae77d96a465756e6",
			"ff046ea8281f4ed48430594340ddf6af",
			"49621e22bbab410d87318e2f8cd57899",
		}
		local index = _UtilLogic:RandomIntegerRange(1, #specials)
		_EffectService:PlayEffectAttached(specials[index], attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		self:EchoShadowSkillEffectAttached(specials[index], attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {}, 0)
	end

	-- 익스플로젼 판정 범위(전방위 - 방향 무관) 안의 살아있는 script.Monster를 가까운 순으로 최대 maxCount명까지 반환한다.
	@ExecSpace("ServerOnly")
	method table FindExplosionTargets(Vector2 fromPos, integer maxCount)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 3.0 and math.abs(dy) <= 1.5 then
					table.insert(candidates, { entity = mc.Entity, dist = math.abs(dx) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	-- 드래곤 로어 전용 판정 범위(전방위 - 방향 무관) 안의 살아있는 script.Monster를 가까운 순으로
	-- 최대 maxCount명까지 반환한다. 익스플로젼의 FindExplosionTargets와 같은 구조이지만, 범위가
	-- 5배(가로 3.0→15.0, 세로 1.5→7.5)라 별도 함수로 분리한다(익스플로젼 쪽 범위는 그대로 유지).
	@ExecSpace("ServerOnly")
	method table FindDragonRoarTargets(Vector2 fromPos, integer maxCount)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 15.0 and math.abs(dy) <= 7.5 then
					-- 몬스터가 많을 때 진짜 가까운 순으로 뽑히도록 dx만이 아니라 실제 유클리드 거리로 정렬한다.
					table.insert(candidates, { entity = mc.Entity, dist = math.sqrt(dx * dx + dy * dy) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	-- 대상 하나에게만 익스플로젼 데미지를 적중시킨다(썬더볼트와 동일한 단일 대상 패턴 - 밀집 지역에서
	-- 판정 박스가 이웃까지 겹쳐 맞히는 것을 막는다).
	@ExecSpace("ServerOnly")
	method void DealExplosionHit(Entity target)
		if not isvalid(target) then return end
		self._T.explosionCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.explosion", target)
	end

	-- 폭발 지점 주변(독구름의 확대된 시각적 크기의 1.0배 - 1.5배의 2/3로 축소) 안에 있는 독구름을 최대 6개까지 찾아 0.1초 간격으로 하나씩 터뜨린다.
	@ExecSpace("ServerOnly")
	method void PopNearbyPoisonMists(Vector3 fromPos)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local children = map.Children:ToTable()
		local found = {}
		for _, c in ipairs(children) do
			if isvalid(c) then
				local mz = c:GetComponent("script.PoisonMistZone")
				if isvalid(mz) then
					-- Visual 자식의 실제 Scale을 읽어 "확대된 시각적 크기"를 구한다 - 하드코딩된 배율을 쓰면
					-- 나중에 독구름 크기를 또 조절할 때마다 여기도 같이 고쳐야 하는 문제가 생긴다.
					local visualScale = 1.0
					local visual = c:GetChildByName("Visual")
					if isvalid(visual) then
						visualScale = visual.TransformComponent.Scale.x
					end
					local pos = c.TransformComponent.WorldPosition
					local dx = math.abs(pos.x - fromPos.x)
					local dy = math.abs(pos.y - fromPos.y)
					-- 독구름의 확대된 시각적 크기(가로 mz.Radius, 세로 1.5를 visualScale배 한 값)의 1.0배(=1.5배의 2/3)를 탐지 범위로 쓴다.
					if dx <= mz.Radius * visualScale * 1.0 and dy <= 1.5 * visualScale * 1.0 then
						table.insert(found, c)
						if #found >= 6 then break end
					end
				end
			end
		end
		log("PlayerAttack: PopNearbyPoisonMists 탐지된 독구름 수=" .. tostring(#found))
		for i, mistEntity in ipairs(found) do
			local delay = (i - 1) * 0.1
			_TimerService:SetTimerOnce(function()
				self:PopOnePoisonMist(mistEntity)
			end, delay)
		end
	end

	@ExecSpace("ServerOnly")
	method void PopOnePoisonMist(Entity mistEntity)
		if not isvalid(mistEntity) then return end
		local pos = mistEntity.TransformComponent.WorldPosition
		local mz = mistEntity:GetComponent("script.PoisonMistZone")
		-- 폭발이펙트를 흩뿌릴 범위 - "확대된 시각적 크기" 전체(탐지범위와 동일한 크기)로 흩뿌리면 눈에 보이는
		-- 독구름 그림보다 훨씬 멀리 떨어진 곳에서 이펙트가 터지는 것처럼 보여서(실측 확인됨), 30%로 줄여
		-- 실제 구름 그림 주변에만 모여서 터지도록 한다.
		local visualScale = 1.0
		local visual = mistEntity:GetChildByName("Visual")
		if isvalid(visual) then
			visualScale = visual.TransformComponent.Scale.x
		end
		local radiusX = 1.8
		if mz ~= nil then radiusX = mz.Radius end
		self:PlayPoisonPopBursts(pos.x, pos.y, pos.z, radiusX * visualScale * 0.3, 1.5 * visualScale * 0.3)
		local targets = self:FindExplosionTargets(Vector2(pos.x, pos.y), 6)
		for _, t in ipairs(targets) do
			self:DealExplosionHit(t)
		end
		if mz ~= nil then
			mz:Pop()
		end
		log("PlayerAttack: PopOnePoisonMist 독구름 파열! pos=(" .. tostring(pos.x) .. "," .. tostring(pos.y) .. ") targets=" .. tostring(#targets))
	end

	-- 독구름 하나가 터질 때 주변 랜덤 위치에서 폭발이펙트를 0.3초 간격으로 3번 재생한다.
	@ExecSpace("ServerOnly")
	method void PlayPoisonPopBursts(number cx, number cy, number cz, number rangeX, number rangeY)
		for i = 1, 3 do
			local delay = (i - 1) * 0.3
			_TimerService:SetTimerOnce(function()
				local offsetX = (_UtilLogic:RandomDouble() * 2.0 - 1.0) * rangeX
				local offsetY = (_UtilLogic:RandomDouble() * 2.0 - 1.0) * rangeY
				self:PlayPoisonPopEffect(cx + offsetX, cy + offsetY, cz)
				log("PlayerAttack: PlayPoisonPopBursts 폭발 " .. tostring(i) .. "/3 offset=(" .. tostring(offsetX) .. "," .. tostring(offsetY) .. ")")
			end, delay)
		end
	end

	@ExecSpace("Multicast")
	method void PlayPoisonPopEffect(number px, number py, number pz)
		-- 독구름이 터질 때 그 주변 랜덤 위치에서 재생되는 폭발 이펙트(skill/211.img/skill/2111002의 special 3종
		-- 중 랜덤 하나) + 사운드.
		if not self:IsClient() then return end
		local mapEntity = self.Entity.CurrentMap
		if not isvalid(mapEntity) then return end
		local specials = {
			"154a7b585c474b07ae77d96a465756e6",
			"ff046ea8281f4ed48430594340ddf6af",
			"49621e22bbab410d87318e2f8cd57899",
		}
		local index = _UtilLogic:RandomIntegerRange(1, #specials)
		_EffectService:PlayEffect(specials[index], mapEntity, Vector3(px, py, pz), 0, Vector3(1, 1, 1), false)
		-- 쉐도우 파트너: 독구름 파열 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffect(specials[index], Vector3(px, py, pz), 0, Vector3(1, 1, 1), {}, 0)
		_SoundService:PlaySound("3edd6d189b9b4bf1ac48162339848e36", 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackDragonRoar(number combatPower, number atkMultiplier)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 드래곤 로어: 전방위 최대 20명(범위는 익스플로젼의 5배), 시전 뒤 1.5초 지연 폭발, 데미지 배율(1000~1300%).
		-- 추가로 시전 즉시 2초짜리 스턴에 걸린다(모션 자체의 짧은 잠금과는 별개의 독립된 고정 길이 잠금 -
		-- 공격속도 영향을 받지 않는다). 사용 즉시 최대 HP의 25%를 소모한다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isDragonRoaring then
			log("PlayerAttack: AttackDragonRoar 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isDragonRoaring = true
		self._T.pendingDragonRoarCombatPower = combatPower

		-- (요청 2026-07-28) 소모량 기준 변경: 현재 HP의 40% → **최대 HP의 25%**
		-- (스킬 사용 자체로 죽지 않도록 최소 1은 남긴다 - 최대 HP 기준이라 현재 HP보다 많이 깎일 수 있다).
		local pc = self.Entity.PlayerComponent
		if isvalid(pc) then
			local hpCost = math.floor(pc.MaxHp * 0.25)
			pc.Hp = math.max(pc.Hp - hpCost, 1)
			log("PlayerAttack: AttackDragonRoar HP 소모=" .. tostring(hpCost) .. " 남은Hp=" .. tostring(pc.Hp))
		end

		-- 익스플로젼과 동일한 모션(alert) 재생 - 별도 플래그 사용.
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingDragonRoarDirX = dirX
		self._T.pendingDragonRoarWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self:PlayDragonRoarMotion(self.Entity, "alert", dirX, mult)

		-- 스턴 잠금: 익스플로젼의 짧은 모션 잠금(0.6*mult)과 달리, 공격속도와 무관하게 항상 고정 2초.
		_TimerService:SetTimerOnce(function()
			self:RestoreDragonRoarControl()
		end, 2.0)

		self:PlayDragonRoarCastEffect(self.Entity)
		self:PlayDragonRoarStunEffect(self.Entity)

		_TimerService:SetTimerOnce(function()
			self:DetonateDragonRoar()
		end, 1.5)
	end

	@ExecSpace("Multicast")
	method void PlayDragonRoarMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 드래곤 로어 전용 모션 재생 (익스플로젼과 동일한 방식/모션 - 별도 플래그로 서로 간섭하지 않는다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isDragonRoarDirectionLocked = true
		self._T.lockedDragonRoarDirX = dirX
		self._T.lockedDragonRoarMotionName = motionName
		self._T.isDragonRoarMotionPlaying = true

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedDragonRoarPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[DragonRoar] PlayDragonRoarMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isDragonRoarMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			self._T.isDragonRoarDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.80 * mult)
	end

	@ExecSpace("Server")
	method void RestoreDragonRoarControl()
		self._T.isDragonRoaring = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingDragonRoarWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingDragonRoarDirX or 1)
	end

	@ExecSpace("Multicast")
	method void PlayDragonRoarCastEffect(Entity attacker)
		-- 시전 즉시 캐릭터 몸쪽에서 1회 재생되는 이펙트 + 사운드 + 화면 흔들림.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_EffectService:PlayEffectAttached("5468cadd2f60428e925bc368968e1a1e", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("5468cadd2f60428e925bc368968e1a1e", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {}, 0)
		_SoundService:PlaySound("7dd03981265b4d9a8c638bf0b18649cc", 1.0)
		local cam = _CameraService:GetCurrentCameraComponent()
		if isvalid(cam) then
			cam:ShakeCamera(0.3, 0.4)
		end
	end

	@ExecSpace("Multicast")
	method void PlayDragonRoarStunEffect(Entity attacker)
		-- 스턴 표시 이펙트 - 사용 즉시 캐릭터에게 2초간 뜬다(고정 길이 - 공격속도 영향 없음).
		-- 발밑(0,0,0)이 아니라 머리 높이(y=0.7)에 뜨도록 위로 올린다(1.0은 너무 높다는 피드백으로 낮춤).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local serial = _EffectService:PlayEffectAttached("6337b66c57a947e7b2cda8bbf8697094", attacker, Vector3(0, 0.7, 0), 0, Vector3(1, 1, 1), true, {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.0)
	end

	method number RollDragonRoarMult()
		-- 드래곤로어 데미지 배율(전투력의 1000%~1300%)을 1회 굴린다.
		-- 본체(CalcDamageBase의 skill.dragonroar 분기)와 용사 소환(HeroSummon.CastDragonRoar)이
		-- 공유하는 단일 공식 - 여기 한 곳만 바꾸면 둘 다 함께 바뀐다.
		return 10.0 + _UtilLogic:RandomDouble() * (13.0 - 10.0)
	end

	method number RollSpearBurstMult()
		-- 스피어버스터 데미지 배율을 1회 굴린다. 본체(CalcDamageBase의 skill.spearburst 분기)와
		-- 용사 소환(HeroSummon.CastSpearBurst)이 공유하는 단일 공식.
		-- (임시) 히트 사운드 테스트용으로 전투력의 10%~20%로 낮춘 상태 - 몬스터가 한방에 죽지 않아야
		-- 피격음/사망음을 구분해서 확인하기 쉽다는 요청. 원래 값(240%~390%)은 아래 주석으로 보존.
		-- return 2.4 + _UtilLogic:RandomDouble() * (3.9 - 2.4)
		return 0.1 + _UtilLogic:RandomDouble() * (0.2 - 0.1)
	end

	@ExecSpace("ServerOnly")
	method void DetonateDragonRoar()
		-- 시전 1.5초 뒤 호출되어 실제 판정을 진행한다(전방위 최대 20명, 범위는 익스플로젼의 5배 - FindDragonRoarTargets 참고).
		if not isvalid(self.Entity) then return end
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local targets = self:FindDragonRoarTargets(Vector2(worldPos.x, worldPos.y), 20)
		for _, t in ipairs(targets) do
			self:DealDragonRoarHit(t)
		end
		log("PlayerAttack: AttackDragonRoar 발동! targets=" .. tostring(#targets))
	end

	-- 대상 하나에게만 드래곤 로어 데미지를 적중시킨다(익스플로젼/썬더볼트와 동일한 단일 대상 패턴).
	@ExecSpace("ServerOnly")
	method void DealDragonRoarHit(Entity target)
		if not isvalid(target) then return end
		self._T.dragonRoarCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local hitComps = self:AttackShadowSafe(shape, "skill.dragonroar", target)
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		if actuallyHit then
			self:PlayDragonRoarHitEffect(target)
		end
	end

	@ExecSpace("Multicast")
	method void PlayDragonRoarHitEffect(Entity target)
		-- 드래곤 로어에 맞은 몬스터 전용 히트 이펙트.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("01c803531e2c4e5aa3c3ef66f14711b8", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		-- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
		self:EchoShadowHitEffect("01c803531e2c4e5aa3c3ef66f14711b8", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	-- ── 블리자드 (4차) ────────────────────────────────────────────────────
	-- 리소스팩: skill/800033.img/skill/80003323 (블리자드)
	--   effect  = 96b261657b0c4aa792bd6f3e7d6c6681 (시전자 몸쪽 이펙트)
	--   tile/0~8 + hit/0 = 바닥에 흩뿌려지는 이펙트 10종 (아래 GetBlizzardTileClips)

	method table GetBlizzardTileClips()
		-- 블리자드 팩의 바닥 이펙트 10종(tile/0~8, hit/0).
		--   frames   = 그 클립의 총 프레임 수 - BlizzardTileVisual이 "지금 재생 중인 것이 정말 이 클립인지"를
		--              판별하는 데 쓴다(모델 기본 클립의 프레임 이벤트를 우리 것으로 오인하는 것 방지).
		--   hitFrame = 하늘에서 내려온 고드름이 실제로 바닥에 꽂히는 프레임(요청받은 값).
		--              이 프레임에 도달한 순간 그 자리에 데미지가 들어간다.
		--
		-- (기능 수정) 예전처럼 "생성 후 2.4초" 같은 고정 지연을 쓰지 않는다 - 클립마다 길이도, 고드름이
		-- 닿는 시점도 달라서 어떤 타일은 이르고 어떤 타일은 늦었다. 클립의 실제 재생 프레임(FrameIndex)을
		-- 보고 때리므로 재생 속도/프레임레이트를 몰라도 항상 "꽂히는 순간"에 정확히 맞는다.
		return {
			{ ruid = "d9d44fb072ec4ccfacad6fe43959c7c9", frames = 25, hitFrame = 18 }, -- tile/0
			{ ruid = "0806f2b09d904519bb5c4b136109268d", frames = 25, hitFrame = 18 }, -- tile/1
			{ ruid = "50249344d7ed4203ac6f00a46c31fc9c", frames = 25, hitFrame = 18 }, -- tile/2
			{ ruid = "43e522b840ce4529aed13a8911f906b4", frames = 20, hitFrame = 16 }, -- tile/3
			{ ruid = "25791d83eda1436a9de855d4c5441e51", frames = 23, hitFrame = 16 }, -- tile/4
			{ ruid = "1889792ff11046859a0a08f171f4feff", frames = 23, hitFrame = 16 }, -- tile/5
			{ ruid = "12299cffd6244ffa81e117d65205f4f1", frames = 21, hitFrame = 14 }, -- tile/6
			{ ruid = "53e7e89799844616b82d85d81decc54f", frames = 20, hitFrame = 14 }, -- tile/7
			{ ruid = "b52555b494544c46a99cbb238802f939", frames = 21, hitFrame = 14 }, -- tile/8
			{ ruid = "735ad75ae1f64d88a9444cf9832f4abc", frames = 21, hitFrame = 15 }, -- hit/0
		}
	end

	@ExecSpace("ServerOnly")
	method void DealBlizzardTileArea(Vector2 pos)
		-- 타일 하나가 "꽂힌" 자리에 데미지를 준다. 타일 하나당 최대 6명까지만 때린다(요청사항).
		-- 초기 타일 15개와 이후 타일 10개가 모두 이 경로를 쓴다 - 데미지 방식이 완전히 동일하다.
		if not isvalid(self.Entity) then return end
		local targets = self:FindBlizzardShardTargets(pos, 1.2)
		local hit = 0
		for _, t in ipairs(targets) do
			if hit >= 6 then break end
			self:DealBlizzardPillarHit(t)
			hit = hit + 1
		end
		log("PlayerAttack: 블리자드 타일 피해 pos=(" .. tostring(pos.x) .. "," .. tostring(pos.y) .. ") 맞은 몬스터=" .. tostring(hit) .. "/" .. tostring(#targets) .. " (타일당 최대 6)")
	end

	@ExecSpace("ServerOnly")
	method void AttackBlizzard(number combatPower, number atkMultiplier)
		-- 블리자드 타임라인 (쿨타임 20초는 클라이언트 SkillManager가 관리/표시):
		--   0.0s      시전 이펙트(96b261) + 사운드(267aa4 1회 + c50b1e30 20초간 작게 반복)
		--             + 맵이 서서히 살짝 어두워짐(15초 뒤 복귀)
		--             + 맵 메인 BGM이 서서히 20%로 작아짐(13초 뒤부터 서서히 원상복귀)
		--             + 데미지 스킨이 얼음 스킨(d0bbfb14)으로 교체됨(19초 뒤 원래 스킨으로 복구)
		--             + 조작 잠금 3초
		--             (얼음책 5db175 / 바닥 서리 a428e9f4·1c0dd97b / 얼음조각 낙하는 현재 주석 처리됨)
		--   ~0.5-0.9s 팩 바닥 이펙트(tile/hit 10종 중 랜덤) 15개 생성 - 클립마다 고드름이 꽂히는 프레임이
		--             달라서, 생성 시점을 그만큼 앞당겨 보정한다(모두 약 2.3초에 "동시에" 착지 = 동시 데미지)
		--   3.0s      화면 폭설 시작(UI 오버레이, 우상→좌하) - 7초간 전량 → 절반 소멸 → 4초 더 → 나머지 소멸
		--   3~18s     팩 바닥 이펙트 10종을 10번, 범위 안 몬스터 위치에 추가 생성
		--
		--   데미지는 오직 "타일"에서만 나온다(기존의 시전자 주위 30명 일괄 판정은 제거됨).
		--   타일 하나가 자기 클립의 hitFrame(고드름이 바닥에 꽂히는 프레임)에 도달한 순간,
		--   그 자리(반경 1.2)의 몬스터를 타일당 최대 6명까지 전투력의 700~1000%로 때린다.
		--   → 초기 타일 15개와 이후 타일 10개가 완전히 같은 방식(SpawnOneBlizzardTile).
		--   0~15s     반짝임 이펙트(90ff4f10) 5회 + 배경 이펙트(6da13ae8) 5회
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isBlizzarding then
			log("PlayerAttack: AttackBlizzard 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isBlizzarding = true
		self._T.pendingBlizzardCombatPower = combatPower

		-- 얼음조각/반짝임은 캐릭터가 움직여도 "시전한 위치" 기준으로 떨어져야 하므로 시전 좌표를 고정해둔다.
		local castPos = self.Entity.TransformComponent.WorldPosition
		self._T.blizzardCastX = castPos.x
		self._T.blizzardCastY = castPos.y
		-- 배경 이펙트 5회가 서로 겹치지 않게 쓰는 "이미 사용한 자리" 목록 - 시전마다 새로 시작한다.
		self._T.blizzardBackFXSpots = {}

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1

		-- (기능 추가) 시전 후 3초 동안은 이동/점프/공격 등 다른 행동을 할 수 없다(다른 스킬과 동일한 방식:
		-- PlayerControllerComponent를 끄고 복구 타이머에서 다시 켠다).
		-- 다른 이유로 이미 꺼져 있었다면(예: 사망 처리) 그 상태를 되살리지 않도록 이전 값을 기억해둔다.
		self._T.pendingBlizzardWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		log("PlayerAttack: 블리자드 조작 잠금 시작 (3초) Enable=" .. tostring(isvalid(playerCtrl) and playerCtrl.Enable))
		-- 이동 중 시전한 경우 관성으로 계속 미끄러지지 않도록 서버 쪽에서도 즉시 멈춘다.
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		_TimerService:SetTimerOnce(function()
			self:RestoreBlizzardControl()
		end, 3.0)

		-- (기능 추가) 15초 동안 데미지 스킨을 얼음 스킨으로 교체(끝나면 원상복구).
		self:ApplyBlizzardDamageSkin()

		self:PlayBlizzardCastEffect(self.Entity)
		-- (임시 비활성) 캐릭터 앞 얼음책(5db17594) - 요청에 따라 호출만 주석 처리했다.
		-- 메서드(SpawnBlizzardCastBook)는 그대로 남겨뒀으니 아래 줄의 주석만 풀면 원래대로 돌아온다.
		-- self:SpawnBlizzardCastBook(dirX)
		self:PlayBlizzardScreenDim()
		-- (기능 추가) 맵 메인 BGM을 20%까지 낮췄다가 13초 뒤 원상복귀.
		self:PlayBlizzardBgmDuck()
		-- (기능 추가) 15초 동안 화면에 폭설이 내린다.
		self:PlayBlizzardSnowfall()

		-- 팩 바닥 이펙트 22개는 0.5~2.5초 사이 각각 다른 랜덤 시점에 하나씩 생성된다(요청사항).
		self:SpawnBlizzardTiles()

		-- (기능 수정) "시전자 주위 30명을 무조건 때리는" 일괄 판정(DetonateBlizzard)을 없앴다(요청사항).
		-- 이제 데미지는 오직 타일에서만 나온다 - 타일 하나가 고드름을 꽂는 순간, 그 자리(반경 1.2)의
		-- 몬스터를 타일당 최대 6명까지 때린다(초기 타일 15개 + 이후 타일 10개 모두 동일).
		-- DetonateBlizzard / FindDragonRoarTargets 기반 일괄 판정 메서드는 지우지 않고 남겨뒀다(미사용).
		-- 재시전 잠금(isBlizzarding)만 예전 판정 시점과 같은 타이밍에 풀어준다.
		_TimerService:SetTimerOnce(function()
			self._T.isBlizzarding = false
		end, 4.5)

		-- (임시 비활성) 바닥 서리 이펙트(a428e9f4 / 1c0dd97b) 45개 - 요청에 따라 호출만 주석 처리했다.
		-- 메서드(SpawnBlizzardFrostEffects / SpawnOneBlizzardFrost)는 그대로 남겨뒀으니 아래 3줄의
		-- 주석만 풀면 원래대로 돌아온다. 다른 연출/판정과는 독립적이라 꺼도 블리자드에 영향이 없다.
		-- _TimerService:SetTimerOnce(function()
		-- 	self:SpawnBlizzardFrostEffects()
		-- end, 3.5)

		-- (기능 수정) 팩(80003323)의 바닥 이펙트 10종 중 하나를, 3~18초 사이 각자 다른 랜덤 시점에
		-- 최대 10번(20 → 절반), "범위 안 몬스터가 있는 위치"에 생성한다(랜덤 발판 → 몬스터 위치로 변경).
		-- 그 자리의 몬스터는 고드름이 떨어지는 2.2초 뒤에 전투력의 700~1000% 피해.
		for i = 1, 10 do
			local delay = 3.0 + _UtilLogic:RandomDouble() * 15.0
			_TimerService:SetTimerOnce(function()
				self:SpawnBlizzardPillarOnGround()
			end, delay)
		end

		-- (기능 수정) 배경 이펙트는 15초 동안 5번 재생한다 - 서로 최소 2초 이상 텀이 생기도록
		-- 3초 간격 슬롯(2.5 / 5.5 / 8.5 / 11.5 / 14.5초)마다 0~1초의 랜덤 지터만 얹는다.
		for i = 1, 5 do
			local delay = 2.5 + (i - 1) * 3.0 + _UtilLogic:RandomDouble() * 1.0
			_TimerService:SetTimerOnce(function()
				self:SpawnBlizzardBackgroundEffect()
			end, delay)
		end

		-- 0~15초 사이 랜덤한 시점에 반짝임 이펙트 5회.
		for i = 1, 5 do
			local delay = _UtilLogic:RandomDouble() * 15.0
			_TimerService:SetTimerOnce(function()
				self:SpawnBlizzardSparkle()
			end, delay)
		end

		-- (임시 비활성) 얼음조각 30개 낙하(3~18초 사이 랜덤 시점, 맞으면 0.3초 뒤 100~150% 피해) -
		-- 요청에 따라 호출만 주석 처리했다. 메서드(DropBlizzardIceShard / PlayBlizzardIceShardEffect /
		-- FindBlizzardShardTargets / DealBlizzardShardHit)와 데미지 공식(skill.blizzard.shard)은 그대로
		-- 남겨뒀으니 아래 6줄의 주석만 풀면 원래대로 돌아온다.
		-- 얼음조각은 블리자드의 주 판정(DetonateBlizzard)이나 기둥 피해와는 별개의 추가 피해라, 꺼도
		-- 스킬의 나머지 동작(시전/판정/쿨타임/연출)에는 영향이 없다.
		-- for i = 1, 30 do
		-- 	local delay = 3.0 + _UtilLogic:RandomDouble() * 15.0
		-- 	_TimerService:SetTimerOnce(function()
		-- 		self:DropBlizzardIceShard()
		-- 	end, delay)
		-- end
	end

	@ExecSpace("Multicast")
	method void PlayBlizzardCastEffect(Entity attacker)
		-- 시전 즉시 캐릭터 몸쪽에서 1회 재생되는 이펙트 + 사운드.
		-- (기능 수정) "화면 흔들림 효과 제거" 요청 - ShakeCamera 호출을 뺐다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		-- (버그 수정) "시전 이펙트가 캐릭터를 가린다" - OrderInLayer = -1 만으로는 안 됐다. 캐릭터 아바타는
		-- SortingLayer="MapLayer0" / OrderInLayer=4 로 그려지는데(실측), 이펙트는 기본 SortingLayer라
		-- 레이어 자체가 아바타보다 앞이라 OrderInLayer 비교가 소용없었다.
		-- → 아바타와 같은 SortingLayer(MapLayer0)에 올리고, OrderInLayer를 아바타(4)보다 작게(2) 준다.
		--   (지형 타일이 1이므로 2는 "지형보다 앞, 캐릭터보다 뒤"가 된다.)
		-- (기능 수정) Y를 조금(-0.35) 내려 캐릭터 발치 쪽에서 퍼지게 한다.
		local backOption = { ["SortingLayer"] = "MapLayer0", ["OrderInLayer"] = 2 }
		local castOffset = Vector3(0, -0.35, 0)
		_EffectService:PlayEffectAttached("96b261657b0c4aa792bd6f3e7d6c6681", attacker, castOffset, 0, Vector3(1, 1, 1), false, backOption)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		self:EchoShadowSkillEffectAttached("96b261657b0c4aa792bd6f3e7d6c6681", attacker, castOffset, 0, Vector3(1, 1, 1), backOption, 0)
		_SoundService:PlaySound("267aa4a9324f460b80bc04600aa4d0e0", 1.0)
		-- 시전 시점부터 c50b1e30을 20초간 재생한다(클립이 20초보다 짧을 수 있어 반복 재생 후 20초에 정지).
		-- (기능 수정) "배경 소리가 잘 안 들린다" - 볼륨 0.5 → 0.8 → (요청) 1.5배인 1.2로.
		_SoundService:PlayLoopSound("c50b1e30210d4019a97da3e76c33079f", 1.2)
		_TimerService:SetTimerOnce(function()
			_SoundService:StopSound("c50b1e30210d4019a97da3e76c33079f")
		end, 20.0)
	end

	@ExecSpace("ServerOnly")
	method void ApplyBlizzardDamageSkin()
		-- (기능 수정) 블리자드 시전 후 19초 동안(15초 → +4초 연장) 데미지 스킨(공격 숫자 모양)을
		-- 얼음 스킨으로 바꿨다가 시간이 끝나면 원래 스킨으로 되돌린다.
		-- (버그 수정) 메테오와 겹쳐 쓰면 서로의 스킬 스킨을 "원본"으로 잘못 저장해 기본으로 안 돌아오던
		-- 문제 - 저장/복구를 공용 관리(ApplySkillDamageSkinShared)로 옮겼다.
		self:ApplySkillDamageSkinShared("blizzard", "d0bbfb140e164860b8b30281613a42c3")
		-- (기능 수정) 유지 시간 15초 → 19초(+4초 연장 요청).
		_TimerService:SetTimerOnce(function()
			self:RestoreBlizzardDamageSkin()
		end, 19.0)
	end

	@ExecSpace("ServerOnly")
	method void RestoreBlizzardDamageSkin()
		-- 19초 뒤 복구 요청 - 실제 복구는 공용 관리가 "마지막 스킬 스킨이 끝났을 때"만 수행한다.
		self:RestoreSkillDamageSkinShared("blizzard")
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillDamageSkinShared(string skillKey, string skinRuid)
		-- 스킬 데미지 스킨 교체의 공용 관리자(블리자드/메테오 공용).
		-- (버그 수정) 스킬별로 "원본 스킨"을 따로 저장하면, 두 스킬을 겹쳐 쓸 때 나중 스킬이 앞 스킬의
		-- "스킬 스킨"을 원본으로 저장해버려 지속시간이 다 끝나도 기본 스킨으로 안 돌아온다.
		-- → 원본(base)은 "스킬 스킨이 하나도 활성화되지 않은 시점"에 한 번만 공용으로 저장하고,
		--   복구는 마지막 활성 스킬이 끝나는 순간에만 base로 되돌린다.
		-- 데미지 스킨은 "공격자" 쪽 DamageSkinSettingComponent.DamageSkinId 가 결정한다
		-- (맞는 쪽에는 DamageSkinSpawnerComponent가 있어야 숫자가 뜬다 - 몬스터 모델에 이미 있다).
		if not isvalid(self.Entity) then return end
		local skinComp = self.Entity:GetComponent("MOD.Core.DamageSkinSettingComponent")
		if not isvalid(skinComp) then
			-- DefaultPlayer.model의 Components 배열엔 없고 엔진이 붙여주는 형태라, 혹시 없을 때를 대비해 직접 붙인다.
			self.Entity:AddComponent("MOD.Core.DamageSkinSettingComponent")
			skinComp = self.Entity:GetComponent("MOD.Core.DamageSkinSettingComponent")
		end
		if not isvalid(skinComp) then
			log_warning("[PlayerAttack] DamageSkinSettingComponent를 찾지 못해 스킬 데미지 스킨을 적용하지 못했습니다: " .. tostring(skillKey))
			return
		end
		if self._T.skillSkinActive == nil then
			self._T.skillSkinActive = {}
		end
		local anyActive = false
		for _, v in pairs(self._T.skillSkinActive) do
			if v then
				anyActive = true
				break
			end
		end
		-- 원본은 문자열 id로 기억한다(DataRef 객체를 그대로 들고 있으면 나중에 값이 바뀔 수 있다).
		if not anyActive then
			local cur = skinComp.DamageSkinId
			self._T.skillSkinBaseId = (cur ~= nil) and cur.DataId or ""
		end
		self._T.skillSkinActive[skillKey] = true
		skinComp.DamageSkinId = DataRef(skinRuid)
		log("PlayerAttack: 스킬 데미지 스킨 적용 [" .. tostring(skillKey) .. "] 원본(base)=" .. tostring(self._T.skillSkinBaseId))
	end

	@ExecSpace("ServerOnly")
	method void RestoreSkillDamageSkinShared(string skillKey)
		-- 이 스킬의 스킨 활성 표시를 내리고, 아직 활성인 다른 스킬 스킨이 있으면 복구를 보류한다
		-- (그 스킬이 끝날 때 base로 복구된다). 마지막 스킬이면 base 스킨으로 되돌린다.
		if not isvalid(self.Entity) then return end
		if self._T.skillSkinActive == nil then
			self._T.skillSkinActive = {}
		end
		self._T.skillSkinActive[skillKey] = nil
		for otherKey, v in pairs(self._T.skillSkinActive) do
			if v then
				log("PlayerAttack: 스킬 데미지 스킨 복구 보류 [" .. tostring(skillKey) .. "] - [" .. tostring(otherKey) .. "] 아직 활성")
				return
			end
		end
		local skinComp = self.Entity:GetComponent("MOD.Core.DamageSkinSettingComponent")
		if not isvalid(skinComp) then return end
		local originalId = self._T.skillSkinBaseId
		if originalId == nil or originalId == "" then
			-- 원본이 비어 있었다면(컴포넌트를 새로 붙인 경우 등) 기본 공격 데미지 스킨으로 되돌린다.
			originalId = "3271c3e79bf04ecba9a107d55495970d"
		end
		skinComp.DamageSkinId = DataRef(originalId)
		self._T.skillSkinBaseId = nil
		log("PlayerAttack: 스킬 데미지 스킨 원상복구 [" .. tostring(skillKey) .. "] -> " .. tostring(originalId))
	end

	@ExecSpace("ServerOnly")
	method void RestoreBlizzardControl()
		-- 시전 3초 뒤 조작을 되돌린다. 시전 전에 이미 꺼져 있었다면(사망 등) 그대로 둔다.
		if not isvalid(self.Entity) then return end
		local playerCtrl = self.Entity.PlayerControllerComponent
		local wasLocked = isvalid(playerCtrl) and (not playerCtrl.Enable)
		if isvalid(playerCtrl) and self._T.pendingBlizzardWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- 복구 직전에 실제로 잠겨 있었는지(=3초 내내 잠금이 유지됐는지)를 함께 남긴다.
		log("PlayerAttack: 블리자드 조작 잠금 해제 (3초 유지됨=" .. tostring(wasLocked) .. ")")
	end

	-- ── 블리자드 폭설 연출 ────────────────────────────────────────────────
	-- 눈송이는 원본 시트(2d507f2d)에서 결정/눈발/알갱이를 잘라 3종으로 만들어 업로드했다.
	-- 대응표: msw-dev-tools/resources/블리자드눈/RUID.md
	-- 실제 낙하는 클라이언트 UI 오버레이(BlizzardSnowfall)가 담당한다.

	@ExecSpace("Multicast")
	method void PlayBlizzardSnowfall()
		-- 화면 오른쪽 위 → 왼쪽 아래로 눈이 빠르게 쏟아지는 폭설(클라이언트 UI 오버레이).
		-- 시전 3초 뒤부터: 7초간 전량 → 절반 먼저 소멸 → 4초 더 → 나머지 소멸(요청사항).
		if not self:IsClient() then return end
		_TimerService:SetTimerOnce(function()
			_BlizzardSnowfall:StartSnow(7.0, 4.0)
		end, 3.0)
	end

	@ExecSpace("Multicast")
	method void PlayBlizzardBgmDuck()
		-- 시전하는 동안 맵의 메인 BGM을 서서히 낮추고 13초 뒤부터 원상복귀.
		-- 1.5초에 걸쳐 줄어들고, 11.5초 유지(= 시전 후 13초 시점), 2.5초에 걸쳐 원래대로.
		-- (요청) 블리자드/메테오의 스킬 BGM이 나올 때 기존 맵 BGM이 겹쳐 들리지 않게 목표 볼륨 50% → 10%.
		-- 스킬 자체 사운드(시전음/눈보라·메테오 루프)는 BGM 채널이 아니라 그대로 들린다.
		-- 메테오(PlayMeteorCastEffect 경로)도 이 메서드를 그대로 재사용하므로 같이 10%가 적용된다.
		if not self:IsClient() then return end
		_BlizzardBgmDucker:StartDuck(1.5, 11.5, 2.5, 0.1)
	end

	@ExecSpace("Multicast")
	method void PlayBlizzardScreenDim()
		-- 맵 전체가 서서히 "약간만" 어두워졌다가 서서히 밝아진다.
		-- (기능 수정) "밝아지는 시점을 2초 앞당겨달라" - 유지 시간 15초 → 13초.
		-- (요청) 어두워지는 정도를 약하게 - 최대 알파 0.35 → 0.2.
		if not self:IsClient() then return end
		_BlizzardScreenDim:StartDim(1.5, 13.0, 2.5, 0.2)
	end

	@ExecSpace("ServerOnly")
	method void SpawnBlizzardCastBook(number dirX)
		-- 시전 시 캐릭터 앞에 얼음책(5db17594)이 생겨 위로 떠오르면서 1.5초에 걸쳐 사라진다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "BlizzardCastBook", Vector3(pos.x + dirX * 0.45, pos.y + 0.35, 0), map)
		if not isvalid(fx) then return end
		fx:AddComponent("script.BlizzardFadingEffect")
		local comp = fx:GetComponent("script.BlizzardFadingEffect")
		if isvalid(comp) then
			comp.StartAlpha = 1.0
			comp.HoldSeconds = 0.0
			comp.FadeSeconds = 1.5
			comp.RiseSpeed = 0.5
			comp.OrderInLayerValue = 10   -- 캐릭터 앞
			comp.ScaleValue = 1.0
			comp.ClipRUID = "5db175946e27401f8203d7a01e632631"
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 2.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnBlizzardTiles()
		-- 시전자 주변의 "발판이 있는 자리"를 골라 바닥 이펙트 30개를 생성한다.
		-- 서로 겹치지 않도록 이미 고른 자리들과 최소 거리(MIN_GAP) 이상 떨어진 후보만 채택하고,
		-- 후보 뽑기가 실패해도 무한 루프에 빠지지 않도록 시도 횟수를 제한한다.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local fh = map.FootholdComponent
		local myPos = self.Entity.TransformComponent.WorldPosition
		local clips = self:GetBlizzardTileClips()

		-- (기능 수정) 생성 개수 30 → 22 → 15개. 최소 간격은 0.9 유지.
		local WANT = 15
		local MIN_GAP = 0.9      -- 이펙트 간 최소 거리(월드 유닛)
		local RANGE_X = 10.4     -- 시전자 기준 좌우 탐색 범위
		local RANGE_Y = 3.9      -- 시전자 기준 상하 탐색 범위(다른 층 발판도 포함)
		local MAX_TRIES = 2000

		local placed = {}
		local tries = 0
		while #placed < WANT and tries < MAX_TRIES do
			tries = tries + 1
			local x = myPos.x + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * RANGE_X
			local probeY = myPos.y + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * RANGE_Y
			local y = nil
			if isvalid(fh) then
				local hit = self:FindNearbyFootholdAtX(fh, x, probeY, 3.0)
				if hit ~= nil then
					y = hit:GetYByX(x) + 0.05
				end
			end
			if y ~= nil then
				local ok = true
				for _, p in ipairs(placed) do
					local dx = p.x - x
					local dy = p.y - y
					if math.sqrt(dx * dx + dy * dy) < MIN_GAP then
						ok = false
						break
					end
				end
				if ok then
					table.insert(placed, { x = x, y = y })
				end
			end
		end

		-- (기능 수정) "초기 타일들의 데미지가 한꺼번에 들어가도록" - 타일마다 고드름이 꽂히는 프레임
		-- (hitFrame: 14~18)이 달라서, 같은 시점에 생성하면 착지(=데미지) 시점이 최대 4프레임만큼 어긋난다.
		-- 그래서 생성 시점을 hitFrame만큼 앞당겨 보정한다:
		--     생성지연 = 기준지연 - hitFrame * 프레임당시간   (hitFrame이 큰 클립일수록 먼저 생성)
		-- 이렇게 하면 모든 초기 타일이 "기준지연" 시점에 동시에 착지한다.
		-- 데미지 자체는 여전히 실제 재생 프레임(FrameIndex) 이벤트로 들어가므로, 아래 프레임당시간
		-- 값이 조금 틀려도 착지 순간에는 정확히 맞는다(동시성만 그만큼 흐트러진다).
		local FRAME_SEC = 0.1        -- 클립 프레임당 재생 시간(초) 추정치 - 실측 후 조정 가능
		local MAX_HIT_FRAME = 18     -- 클립들 중 가장 늦게 꽂히는 프레임(tile/0~2)
		local LAND_AT = 0.5 + MAX_HIT_FRAME * FRAME_SEC   -- 모든 초기 타일이 착지하는 시점(≈2.3초)

		for i, p in ipairs(placed) do
			local clip = clips[_UtilLogic:RandomIntegerRange(1, #clips)]
			-- 착지 시점(LAND_AT)에서 이 클립이 꽂히는 데 걸리는 시간을 빼면 이 타일의 생성 시점이 된다.
			local delay = LAND_AT - clip.hitFrame * FRAME_SEC
			if delay < 0.1 then
				delay = 0.1
			end
			local px, py = p.x, p.y
			local idx = i
			_TimerService:SetTimerOnce(function()
				self:SpawnOneBlizzardTile(map, clip.ruid, clip.frames, clip.hitFrame, Vector3(px, py, 0), idx)
			end, delay)
		end
		log("PlayerAttack: 블리자드 바닥 이펙트 생성 " .. tostring(#placed) .. "/" .. tostring(WANT) .. "개 (시도 " .. tostring(tries) .. "회, 착지 " .. tostring(LAND_AT) .. "초에 동시)")
	end

	@ExecSpace("ServerOnly")
	method void SpawnOneBlizzardTile(Entity map, string clipRuid, integer clipFrames, integer hitFrame, Vector3 pos, integer index)
		-- 바닥 이펙트 1개 생성. 클립을 처음부터 끝까지 한 번 재생하고 사라진다(클라이언트 BlizzardTileVisual).
		-- 데미지는 클립이 hitFrame(고드름이 바닥에 꽂히는 프레임)에 도달한 순간 그 자리에 들어간다 -
		-- 시전자 클라이언트의 BlizzardTileVisual이 프레임 이벤트를 보고 서버(DealBlizzardTileArea)를 호출한다.
		local fxEntity = _SpawnService:SpawnByModelId("spearburstfadingeffect", "BlizzardTile_" .. tostring(index), pos, map)
		if not isvalid(fxEntity) then
			log_warning("PlayerAttack: 블리자드 바닥 이펙트 스폰 실패 index=" .. tostring(index))
			return
		end
		fxEntity:AddComponent("script.BlizzardTileVisual")
		local comp = fxEntity:GetComponent("script.BlizzardTileVisual")
		if isvalid(comp) then
			comp.ExpectedFrames = clipFrames
			comp.HitFrameIndex = hitFrame
			comp.CasterEntity = self.Entity
			-- "블리자드 이펙트의 zorder는 사용자 캐릭터보다 뒤" 요청 - 캐릭터(기본 4)보다 확실히 뒤로
			-- 가도록 음수 OrderInLayer를 준다(Z값만으로는 확실하게 뒤로 가지 않는다).
			comp.OrderInLayerValue = -1
			-- (되돌림) 팩(skill/800033.img/skill/80003323)의 이펙트는 색/투명도를 건드리지 않고 원본 그대로,
			-- 좌우 반전도 하지 않는다(요청사항).
			comp.AlphaValue = 1.0
			comp.TintR = 1.0
			comp.TintG = 1.0
			comp.TintB = 1.0
			comp.IsFlipX = false
			-- ClipRUID는 마지막에 넣는다 - 클라이언트의 OnSyncProperty(ClipRUID)가 실제 적용을 트리거하므로,
			-- 그 시점엔 나머지 값들이 이미 도착해 있어야 한다.
			comp.ClipRUID = clipRuid
		end
		-- 클립 1회 재생분(길어야 3초 남짓)만큼만 살려두고 정리한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(fxEntity) then
				fxEntity:Destroy()
			end
		end, 6.0)
	end

	-- 시전 위치 주변에서 "발판이 있는" 좌표 하나를 랜덤으로 고른다(없으면 nil). 얼음조각/반짝임/서리
	-- 이펙트가 공통으로 쓴다. 기준점은 시전 시점에 고정해둔 좌표(blizzardCastX/Y)다 - 캐릭터가 움직여도
	-- 연출은 "블리자드를 사용한 위치" 범위 안에서 계속된다.
	@ExecSpace("ServerOnly")
	method Vector2 PickBlizzardGroundSpot(number rangeX, number rangeY)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return nil end
		local fh = map.FootholdComponent
		if not isvalid(fh) then return nil end
		local cx = self._T.blizzardCastX or self.Entity.TransformComponent.WorldPosition.x
		local cy = self._T.blizzardCastY or self.Entity.TransformComponent.WorldPosition.y
		for i = 1, 40 do
			local x = cx + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * rangeX
			local probeY = cy + (_UtilLogic:RandomDouble() * 2.0 - 1.0) * rangeY
			local hit = self:FindNearbyFootholdAtX(fh, x, probeY, 3.0)
			if hit ~= nil then
				return Vector2(x, hit:GetYByX(x) + 0.05)
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method void SpawnBlizzardFrostEffects()
		-- 시전 2.5초 뒤: 캐릭터 주변 발판 위에 서리 이펙트(a428e9f4 / 1c0dd97b) 15개를 랜덤 배치한다.
		-- 각각 15~20초 사이 랜덤한 시간 뒤에 사라지며, 사라질 때 1.5초에 걸쳐 서서히 투명해진다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local clips = { "a428e9f4129141e7a6dd1f48ffda4147", "1c0dd97b95b440b3ad512646db0ee079" }
		local placed = {}
		local made = 0
		local tries = 0
		-- (기능 수정) 서리 이펙트 개수 3배(15 → 45). 최소 간격 때문에 후보가 버려지는 경우가 많아
		-- 목표 개수가 찰 때까지(또는 시도 상한까지) 반복한다.
		while made < 45 and tries < 400 do
			tries = tries + 1
			local i = made + 1
			local spot = self:PickBlizzardGroundSpot(8.0, 3.0)
			if spot ~= nil then
				-- 개수가 3배로 늘고 크기도 작아졌으므로(30~70%) 최소 간격도 0.5로 좁힌다.
				local ok = true
				for _, p in ipairs(placed) do
					local dx = p.x - spot.x
					local dy = p.y - spot.y
					if math.sqrt(dx * dx + dy * dy) < 0.5 then
						ok = false
						break
					end
				end
				if ok then
					table.insert(placed, spot)
					local clip = clips[_UtilLogic:RandomIntegerRange(1, #clips)]
					-- 총 수명 15~20초 = 유지시간 + 페이드아웃 1.5초.
					local life = 15.0 + _UtilLogic:RandomDouble() * 5.0
					-- (기능 수정) 원본 크기의 30%~70% 사이 랜덤한 크기.
					local scale = 0.3 + _UtilLogic:RandomDouble() * 0.4
					self:SpawnOneBlizzardFrost(map, clip, Vector3(spot.x, spot.y, 0), life - 1.5, scale, i)
					made = made + 1
				end
			end
		end
		log("PlayerAttack: 블리자드 서리 이펙트 생성 " .. tostring(made) .. "개")
	end

	@ExecSpace("ServerOnly")
	method void SpawnOneBlizzardFrost(Entity map, string clipRuid, Vector3 pos, number holdSeconds, number scale, integer index)
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "BlizzardFrost_" .. tostring(index), pos, map)
		if not isvalid(fx) then return end
		fx:AddComponent("script.BlizzardFadingEffect")
		local comp = fx:GetComponent("script.BlizzardFadingEffect")
		if isvalid(comp) then
			-- 서리 이펙트: 투명도 90%, 원본 크기의 30~70% 랜덤, 좌우 반전, 참고 이미지 평균색
			-- (RGB 149,179,187)의 청회색 보정. 팩(80003323) 이펙트는 원본 그대로 두고 이 두 클립만 바꾼다.
			comp.StartAlpha = 0.9
			comp.HoldSeconds = holdSeconds
			comp.FadeSeconds = 1.5
			comp.RiseSpeed = 0
			comp.OrderInLayerValue = -1   -- 캐릭터보다 뒤
			comp.ScaleValue = scale
			-- (기능 수정) 좌우 반전을 한 번 더 뒤집어(true → false) 원래 방향으로 되돌린다.
			comp.IsFlipX = false
			comp.TintR = 0.58
			comp.TintG = 0.70
			comp.TintB = 0.73
			comp.ClipRUID = clipRuid
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, holdSeconds + 2.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnBlizzardBackgroundEffect()
		-- 시전 2.5초 뒤: 배경 이펙트(6da13ae8)를 지형지물보다 뒤에서 희미하게 1회 재생한다.
		-- (버그 수정) OrderInLayer를 -100으로 두면 맵 배경 이미지 뒤로 완전히 밀려 화면에 아예 보이지
		-- 않았다 - 지형 타일(기본 OrderInLayer 1)보다는 뒤, 배경보다는 앞이 되도록 -1로 올린다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		-- (기능 추가) 5번 재생되는 배경 이펙트가 매번 같은 자리(시전자 머리 위)에 겹치지 않도록,
		-- 서리 이펙트와 같은 방식으로 범위 안에서 자리를 뽑되 이미 쓴 자리와 최소 거리(4.0)를 둔다.
		if self._T.blizzardBackFXSpots == nil then
			self._T.blizzardBackFXSpots = {}
		end
		local basePos = self.Entity.TransformComponent.WorldPosition
		local pos = Vector2(basePos.x, basePos.y + 1.0)
		local fallback = nil
		for i = 1, 30 do
			local cand = self:PickBlizzardGroundSpot(8.0, 3.0)
			if cand ~= nil then
				fallback = cand
				local ok = true
				for _, p in ipairs(self._T.blizzardBackFXSpots) do
					local dx = p.x - cand.x
					local dy = p.y - cand.y
					-- 최소 간격 2.5 - 4.0으로 두면 발판이 좁은 맵에서 후보가 다 걸러져 매번 같은
					-- 대체 위치(시전자 머리 위)에 겹쳐 뜨는 문제가 있었다(실측).
					if math.sqrt(dx * dx + dy * dy) < 2.5 then
						ok = false
						break
					end
				end
				if ok then
					fallback = nil
					pos = Vector2(cand.x, cand.y + 1.5)
					table.insert(self._T.blizzardBackFXSpots, Vector2(cand.x, cand.y))
					break
				end
			end
		end
		if fallback ~= nil then
			-- 간격 조건을 만족하는 자리를 못 찾았으면, 시전자 머리 위에 또 겹치지 말고 마지막 랜덤 자리를 쓴다.
			pos = Vector2(fallback.x, fallback.y + 1.5)
			table.insert(self._T.blizzardBackFXSpots, Vector2(fallback.x, fallback.y))
		end
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "BlizzardBackFX", Vector3(pos.x, pos.y, 0), map)
		if not isvalid(fx) then return end
		fx:AddComponent("script.BlizzardFadingEffect")
		local comp = fx:GetComponent("script.BlizzardFadingEffect")
		if isvalid(comp) then
			-- (버그 수정) 이 클립은 흰빛 계열이라 알파 0.35로는 밝은 하늘 배경에 완전히 묻혀 보이지 않았다
			-- ("배경에 6da13ae8가 보이지 않습니다") - 알파를 0.8로 올리고 크기도 키운다. 그래도 지형 타일보다
			-- 뒤(OrderInLayer -1, 같은 MapLayer0)라 배경 연출로만 보인다.
			-- (기능 수정) 요청사항 - 크기 절반(3.0 → 1.5), 투명도 50%(0.8 → 0.5), 재생속도 절반(1.0 → 0.5).
			comp.StartAlpha = 0.5
			-- 재생속도가 절반이라 클립 1회 재생 분량도 두 배가 된다(1.6초 → 3.2초). 안 늘리면 재생 도중에
			-- 페이드아웃이 시작돼 끝까지 못 보고 사라진다.
			comp.HoldSeconds = 3.2
			comp.FadeSeconds = 0.6
			comp.RiseSpeed = 0
			comp.SortingLayerName = "MapLayer0"
			comp.OrderInLayerValue = -1   -- 지형 타일보다는 뒤, 맵 배경보다는 앞
			comp.ScaleValue = 1.5
			comp.PlayRateValue = 0.5
			comp.ClipRUID = "6da13ae8587b4931b9c3ecd556e052ec"
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 4.5)
		log("PlayerAttack: 블리자드 배경 이펙트 재생 pos=(" .. tostring(pos.x) .. "," .. tostring(pos.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void SpawnBlizzardPillarOnGround()
		-- (기능 수정) 팩(80003323)의 바닥 이펙트 10종 중 하나를 "범위 안 몬스터가 있는 자리"에 생성한다.
		-- 랜덤 발판에 뿌리면 몬스터가 없는 허공에 떨어지는 경우가 많아, 범위 안 살아있는 몬스터 중
		-- 하나를 골라 그 발밑(몬스터 위치)에 떨어뜨린다. 몬스터가 하나도 없으면 아무것도 하지 않는다.
		--
		-- (기능 수정) 초기 타일과 완전히 같은 경로(SpawnOneBlizzardTile)를 쓴다 - 같은 엔티티/같은 클립 재생/
		-- 같은 데미지 방식(클립의 hitFrame에 도달한 순간, 그 자리 반경 1.2, 타일당 최대 6명).
		-- 예전의 "고정 2.4초 뒤 피해 + _EffectService 재생" 방식은 클립마다 고드름이 닿는 시점이 달라
		-- 이르거나 늦었다.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local cx = self._T.blizzardCastX or self.Entity.TransformComponent.WorldPosition.x
		local cy = self._T.blizzardCastY or self.Entity.TransformComponent.WorldPosition.y
		-- 판정 범위(드래곤 로어와 동일: 가로 15.0 / 세로 7.5) 안의 살아있는 몬스터들.
		local candidates = self:FindDragonRoarTargets(Vector2(cx, cy), 30)
		if #candidates == 0 then return end
		local target = candidates[_UtilLogic:RandomIntegerRange(1, #candidates)]
		if not isvalid(target) then return end
		local tpos = target.TransformComponent.WorldPosition

		local clips = self:GetBlizzardTileClips()
		local clip = clips[_UtilLogic:RandomIntegerRange(1, #clips)]
		self._T.blizzardPillarCount = (self._T.blizzardPillarCount or 0) + 1
		local idx = 1000 + self._T.blizzardPillarCount   -- 초기 타일(1~15)과 이름이 겹치지 않게
		self:SpawnOneBlizzardTile(map, clip.ruid, clip.frames, clip.hitFrame, Vector3(tpos.x, tpos.y, 0), idx)
		log("PlayerAttack: 블리자드 추가 타일 생성 (몬스터 위치) pos=(" .. tostring(tpos.x) .. "," .. tostring(tpos.y) .. ") hitFrame=" .. tostring(clip.hitFrame))
	end

	@ExecSpace("Multicast")
	method void PlayBlizzardPillarEffect(string clipRuid, number px, number py)
		if not self:IsClient() then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		_EffectService:PlayEffect(clipRuid, map, Vector3(px, py, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = -1 })
	end

	@ExecSpace("ServerOnly")
	method void DealBlizzardPillarHit(Entity target)
		-- 기둥 이펙트가 뜬 발판 자리에 있던 몬스터 1마리에게 피해를 준다(이번 호출 전용 단일 대상 패턴).
		if not isvalid(target) then return end
		self._T.blizzardPillarCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.blizzard.pillar", target)
		-- (요청) 블리자드에 데미지를 입은 몬스터는 50% 확률로 얼어붙는다(차지 블로우 빙결 공용, 4초 -
		-- 체인 라이트닝의 빙결 대상 판정 IsTargetFrozen과 연동된다).
		if _UtilLogic:RandomDouble() < 0.5 then
			self:ApplyChargeBlowFreeze(target, 4.0)
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnBlizzardSparkle()
		-- 시전 후 15초 동안 랜덤한 시점에 5번 정도, 블리자드 범위 안 랜덤 위치에서 반짝임 이펙트(90ff4f10)를 재생한다.
		if not isvalid(self.Entity) then return end
		local spot = self:PickBlizzardGroundSpot(8.0, 3.0)
		if spot == nil then return end
		self:PlayBlizzardSparkleEffect(spot.x, spot.y + 0.3)
		log("PlayerAttack: 블리자드 반짝임 이펙트 재생 pos=(" .. tostring(spot.x) .. "," .. tostring(spot.y) .. ")")
	end

	@ExecSpace("Multicast")
	method void PlayBlizzardSparkleEffect(number px, number py)
		if not self:IsClient() then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		_EffectService:PlayEffect("90ff4f1089ed4adba09908e19ee5290a", map, Vector3(px, py, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = -1 })
	end

	@ExecSpace("ServerOnly")
	method void DropBlizzardIceShard()
		-- 시전 3초 뒤부터 15초 동안 랜덤한 시점에 5개 정도, 블리자드 범위 안 랜덤 위치에 얼음조각(46893ddb)이
		-- 떨어진다. 그 자리에 몬스터가 있었으면 0.3초 뒤에 전투력의 100%~150% 피해를 준다.
		if not isvalid(self.Entity) then return end
		local spot = self:PickBlizzardGroundSpot(8.0, 3.0)
		if spot == nil then return end
		self:PlayBlizzardIceShardEffect(spot.x, spot.y)

		local hitTargets = self:FindBlizzardShardTargets(spot, 1.2)
		log("PlayerAttack: 블리자드 얼음조각 낙하 pos=(" .. tostring(spot.x) .. "," .. tostring(spot.y) .. ") 맞은 몬스터=" .. tostring(#hitTargets))
		if #hitTargets == 0 then return end
		_TimerService:SetTimerOnce(function()
			for _, t in ipairs(hitTargets) do
				self:DealBlizzardShardHit(t)
			end
		end, 0.3)
	end

	@ExecSpace("Multicast")
	method void PlayBlizzardIceShardEffect(number px, number py)
		-- (기능 수정) 얼음조각 이펙트는 4종 중 랜덤으로 하나를 재생한다.
		if not self:IsClient() then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local shardClips = {
			"31e46cc996124cef90b00cb3df7511d3",
			"1337ffe04c53468b87d591dfc6e73ad6",
			"243dc71d00f14282b669b0ccb2e5e406",
			"21061252ec4545ecb9007fab4ef73839",
		}
		local clip = shardClips[_UtilLogic:RandomIntegerRange(1, #shardClips)]
		-- (기능 수정) 얼음조각 크기를 원본의 2/4(=50%)로 한다.
		_EffectService:PlayEffect(clip, map, Vector3(px, py, 0), 0, Vector3(0.5, 0.5, 0.5), false, { ["OrderInLayer"] = -1 })
		_SoundService:PlaySoundAtPos("3edd6d189b9b4bf1ac48162339848e36", Vector3(px, py, 0), self.Entity, 0.7)
	end

	@ExecSpace("ServerOnly")
	method table FindBlizzardShardTargets(Vector2 pos, number radius)
		-- 얼음조각이 떨어진 자리 근처의 살아있는 몬스터 목록.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local result = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local p = mc.Entity.TransformComponent.WorldPosition
				local dx = p.x - pos.x
				local dy = p.y - pos.y
				if math.sqrt(dx * dx + dy * dy) <= radius then
					table.insert(result, mc.Entity)
				end
			end
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void DealBlizzardShardHit(Entity target)
		-- 얼음조각 피해(전투력의 100%~150%) - 다른 다중 대상 스킬과 동일하게 이번 호출 전용 단일 대상만 통과시킨다.
		if not isvalid(target) then return end
		self._T.blizzardShardCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.blizzard.shard", target)
	end

	@ExecSpace("ServerOnly")
	method void DetonateBlizzard()
		-- 바닥 이펙트 생성 1.5초 뒤 호출되어 실제 판정을 진행한다 - 시전자 주위, 범위는 드래곤 로어와 동일
		-- (FindDragonRoarTargets 재사용: 가로 15.0 / 세로 7.5, 전방위, 가까운 순 최대 20명).
		if not isvalid(self.Entity) then return end
		local worldPos = self.Entity.TransformComponent.WorldPosition
		-- (기능 수정) 최대 대상 20명 → 30명.
		local targets = self:FindDragonRoarTargets(Vector2(worldPos.x, worldPos.y), 30)
		for _, t in ipairs(targets) do
			self:DealBlizzardHit(t)
		end
		log("PlayerAttack: 블리자드 발동! targets=" .. tostring(#targets))
	end

	@ExecSpace("ServerOnly")
	method void DealBlizzardHit(Entity target)
		-- 대상 하나에게만 블리자드 데미지를 적중시킨다(드래곤 로어와 동일한 단일 대상 패턴).
		if not isvalid(target) then return end
		self._T.blizzardCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local hitComps = self:AttackShadowSafe(shape, "skill.blizzard", target)
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		if actuallyHit then
			self:PlayBlizzardHitEffect(target)
		end
	end

	@ExecSpace("Multicast")
	method void PlayBlizzardHitEffect(Entity target)
		-- 블리자드에 맞은 몬스터 전용 히트 이펙트(팩의 hit/0 클립).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("735ad75ae1f64d88a9444cf9832f4abc", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, {})
		self:EchoShadowHitEffect("735ad75ae1f64d88a9444cf9832f4abc", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.5)
	end

	@ExecSpace("ServerOnly")
	method void AttackParryCounter(number combatPower)
		-- 패링(1차) 성공 반격. PlayerHit.CheckParryBlock이 "가드 표시" 0.5초 뒤에 호출한다.
		-- 시전자 주위(반경 3.0) 가까운 순 최대 6명에게 전투력의 500%~700% 피해를 준다(요청사항).
		-- 판정 방식은 블리자드/드래곤로어와 동일 - 대상마다 그 대상 전용 단일 판정을 따로 돌려
		-- 밀집 지역에서 판정 박스가 이웃까지 겹쳐 맞히는 것을 막는다.
		if not isvalid(self.Entity) then return end
		self._T.pendingParryCombatPower = combatPower
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local targets = self:FindMonstersInRadius(Vector2(worldPos.x, worldPos.y + 0.5), 3.0, 6)
		local hitCount = 0
		for _, t in ipairs(targets) do
			if self:DealParryCounterHit(t) then hitCount = hitCount + 1 end
		end
		log("PlayerAttack: 패링 반격! combatPower=" .. tostring(combatPower) .. " targets=" .. tostring(#targets) .. " hit=" .. tostring(hitCount) .. " lastDamage=" .. tostring(self._T.lastParryDamage))
	end

	@ExecSpace("ServerOnly")
	method boolean DealParryCounterHit(Entity target)
		-- 대상 하나에게만 패링 반격 데미지를 적중시킨다(블리자드와 동일한 단일 대상 패턴).
		-- 실제 판정이 성사됐는지(true/false)를 돌려줘 호출부가 적중 수를 로그로 남길 수 있게 한다.
		if not isvalid(target) then return false end
		self._T.parryCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local hitComps = self:AttackShadowSafe(shape, "skill.parry", target)
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void PlayParryCounterVisuals()
		-- (요청 2026-07-27) 패링 성공 연출: 이전에 하던 모든 모션을 멈추고 swingT3(3프레임 모션)를
		-- 재생하면서 검격 이펙트를 모션과 동기해 겹쳐 재생한다. 동시에 구버전 클립
		-- fa71427649df4eeb8a3fd1ddf4cf9023의 1~4프레임(칼 부딪힘 스파크)을 랜덤한 각도로 1회 재생.
		-- (요청 2026-07-28) 검격을 클립 3167048c의 12~23프레임으로 교체 - 상세는 아래 slash 주석.
		-- RUID 대응표: msw-dev-tools/resources/패링검격/RUID.md
		if not isvalid(self.Entity) then return end
		self:StopBreather()
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1

		-- (요청 2026-07-28) swingT3가 피격/이동/착지 상태 전환에 캔슬되지 않게 - 브랜디쉬와 같은
		-- 상태 몸동작 매핑 억제(IDLE/MOVE/FALL/JUMP/HIT 5종, Multicast 즉시 제거)를 모션 전에 걸고,
		-- 모션(3배속 약 0.15초)이 끝난 뒤 서버 타이머로 매핑·컨트롤을 함께 복구한다.
		self:SuppressBrandishStateMotions()
		self:PlayParrySwingMotion(self.Entity, dirX)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			self:RestoreBrandishStateMotions()
			self:RestoreParryControl()
		end, 0.25)

		-- 검격: (요청 2026-07-28 교체) 라이브러리 클립 3167048c17b94a809f83836a1dfc4575의
		-- 12~23프레임(인덱스 11~22, 불꽃 검격 버스트 -> 연기 소산 12장)을 프레임 교체로 재생한다.
		-- (요청) 재생속도는 10% 감속(0.37초)을 되돌려 처음 값 0.037초 간격으로 복원 - 총 약 0.44초.
		-- 같은 클립 출신 프레임들이라 각자의 피벗이 서로 정렬돼 있어 엔티티 위치는 몸 중심 한 곳이면 된다.
		-- (이전 검격 시트 6프레임은 msw-dev-tools/resources/패링검격/RUID.md에 보관 - 미사용 전환)
		local slash = {
			"697e026b5c314a798f8d9709f53750ee",
			"80c99d8c2d1c4af083f45ac41eed6427",
			"9b741d8f0f494a1c92cc9138b6483835",
			"e1445a2788914e0da35aac0afd84c984",
			"d597c4be7305402abd0db552555db844",
			"59c9de29813a4b518f3047fddd32bfe0",
			"fe8f028da11146429831e28f0418247a",
			"6d680c10e49c415196b877779cc53498",
			"1b733750b199436ea9fac6e043f170a6",
			"738ef9ba228044d792a5216ee47b7854",
			"7c9c706857f8427eab8ad561277b0484",
			"fed37c0c37ed427e9aa93f946bb65062",
		}
		-- (요청 2026-07-28) 검격 리소스를 캐릭터 뒤쪽(바라보는 반대 방향)·아래로 이동.
		-- (요청 2026-07-28) 크기를 다시 70%로: 0.6 -> 0.42 (약 4.3유닛).
		self:SpawnParryFrameEffect(slash, 0.037, -0.8 * dirX, -0.2, 6, 0, dirX > 0, 0.42)

		-- 칼 부딪힘 스파크: fa714 클립의 1~4프레임 스프라이트를 같은 간격으로 재생.
		-- "랜덤한 각도로 변형" - 시전마다 0~360도 무작위 회전(서버에서 한 번 굴려 모든 클라 동일).
		local spark = {
			"4eb79d452f7f464ebe8cbe5abc267426",
			"bca99c25fd7d4eff9dfbc97826c0ac46",
			"7562004f471a4e909c2eee2747a71df7",
			"ea7be11eff3a4814aa58b99bf3cfe2d5",
		}
		local sparkAngle = _UtilLogic:RandomDouble() * 360
		self:SpawnParryFrameEffect(spark, 0.074, 0, 0.5, 7, sparkAngle, false, 1.0)
		log("PlayerAttack: 패링 반격 연출 시작 dirX=" .. tostring(dirX) .. " sparkAngle=" .. string.format("%.1f", sparkAngle))
	end

	@ExecSpace("Multicast")
	method void PlayParrySwingMotion(Entity attacker, number dirX)
		-- 패링 성공 순간, 진행 중이던 몸동작(걷기/시전 모션 등)을 전부 끊고 swingT3를 1회 재생한다.
		-- 러시 PlayRushMotion과 같은 원리 - 조작 주체 클라에서 컨트롤러를 끊어 이동 입력을 막고
		-- (요청: 모션 동안 이동 불가), 새 ActionStateChangedEvent가 진행 중인 raw 클립을 덮어쓴다.
		-- 캔슬 방지는 호출부의 SuppressBrandishStateMotions(상태 매핑 억제)가 담당하고,
		-- 컨트롤 복귀는 서버 타이머의 RestoreParryControl이 담당한다(여기엔 복귀 로직 없음).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		local playerCtrl = attacker.PlayerControllerComponent
		-- 원래 컨트롤러 상태를 기억해 복구 시 그대로 되돌린다(다른 스킬이 잠근 상태면 잠긴 채 유지).
		self._T.parryWasCtrlEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			if _UserService.LocalPlayer == attacker then
				playerCtrl.Enable = false
			end
			playerCtrl.LookDirectionX = dirX
		end
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end

		-- (요청 2026-07-28) 모션 속도 3배 - PlayRate 3.0.
		body:SendEvent(ActionStateChangedEvent("swingT3", "swingT3", 3.0, SpriteAnimClipPlayType.Onetime))
		log("[Parry] PlayParrySwingMotion sent (swingT3 x3)")
	end

	@ExecSpace("Multicast")
	method void RestoreParryControl()
		-- 패링 swingT3 종료 후 조작 복귀 + 자세 정리. 같은 서버 타이머에서 출발한
		-- RestoreBrandishStateMotions(@Sync)의 매핑 복구가 클라에 도착해야 IDLE 토글이 stand를
		-- 내려보낼 수 있으므로, 도착 지연에 대비해 0.2초 뒤 한 번 더 토글한다(브랜디쉬 안전망과 동일).
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and _UserService.LocalPlayer == self.Entity and self._T.parryWasCtrlEnabled then
			playerCtrl.Enable = true
		end
		local sc = self.Entity.StateComponent
		if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
			sc:ChangeState("IDLE")
			sc:ChangeState("MOVE")
			sc:ChangeState("IDLE")
		end
		log("[Parry] RestoreParryControl 컨트롤 복귀 wasCtrl=" .. tostring(self._T.parryWasCtrlEnabled))
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			local sc2 = self.Entity.StateComponent
			if isvalid(sc2) and sc2.CurrentStateName ~= "DEAD" then
				sc2:ChangeState("IDLE")
				sc2:ChangeState("MOVE")
				sc2:ChangeState("IDLE")
			end
		end, 0.2)
	end

	@ExecSpace("ServerOnly")
	method void SpawnParryFrameEffect(table frames, number frameInterval, number offsetX, number offsetY, integer orderInLayer, number zRot, boolean flipX, number scale)
		-- 정지 스프라이트 프레임 교체 재생(SpawnRushFrameEffect와 같은 패턴). 패링 전용으로
		-- 회전(zRot)/배율(scale)/좌우반전(flipX)을 추가로 받아 검격 시트와 랜덤 각도 스파크에 같이 쓴다.
		-- 플레이어 자식으로 붙여 스윙 동안 캐릭터를 따라간다.
		self._T.parryFxSeq = (self._T.parryFxSeq or 0) + 1
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "ParryFx" .. tostring(self._T.parryFxSeq), Vector3(offsetX, offsetY, 0), self.Entity)
		if not isvalid(fx) then return end
		fx.TransformComponent.ZRotation = zRot
		fx:AddComponent("script.SpearBurstFadingEffect")
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.IsFlipX = flipX
			comp.StartAlpha = 1.0
			comp.EndAlpha = 1.0
			comp.HoldDuration = 5.0        -- 수명보다 길게 잡아 트윈이 시작되지 않게(프레임 교체만 사용)
			comp.TweenDuration = 0.0
			comp.StartScale = scale
			comp.EndScale = scale
			comp.OrderInLayerValue = orderInLayer
			comp.ClipRUID = frames[1]
		end
		for i = 2, #frames do
			local frameRuid = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then comp.ClipRUID = frameRuid end
			end, (i - 1) * frameInterval)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, #frames * frameInterval + 0.05)
	end

	@ExecSpace("ServerOnly")
	method void AttackFireArrow(number combatPower, number atkMultiplier, number rawDirX, number rawDirY, number level)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 파이어에로우: 방향키(위/아래/대각선) 입력으로 각도를 바꿔 화살을 발사한다. 입력이 없으면 캐릭터가
		-- 바라보는 방향(전방)으로 발사. 레벨(50 기준)에 따라 몸쪽 이펙트와 화살 RUID가 달라진다.
		-- level은 SkillManager에서 combatPower와 동일하게 클라이언트에서 계산해 전달받는다 -
		-- _UIMyInfoManager.CharLevel은 서버에서 InitStats() 최초 1회 1로 고정된 뒤 갱신되지 않는 값이라 사용 불가.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local dirX, dirY = rawDirX, rawDirY
		local mag = math.sqrt(dirX * dirX + dirY * dirY)
		if mag > 0.0001 then
			dirX = dirX / mag
			dirY = dirY / mag
		else
			local playerCtrl = self.Entity.PlayerControllerComponent
			dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
			dirY = 0
		end
		self._T.pendingFireArrowDirX = dirX

		local castRuid = (level >= 50) and "c04324310b7d43219ec0d0fa400c4a5b" or "f3d1726f78be40beae0b32960858f132"
		local arrowRuid = (level >= 50) and "17e6f8af37eb4be09b95304e7854c3db" or "bf1fda424a06413d9617789715d0470e"

		-- 기모으는 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다 (매직클로/썬더볼트 등과 동일한 패턴).
		-- 홀드 지속발동(공격속도가 빨라지면 다음 시전이 이전 시전의 잠금 해제보다 먼저 겹쳐 들어올 수 있음) 중에도
		-- 안전하도록, "원래 활성화 상태였는지"는 잠금 체인의 첫 시전에서만 기록하고(이미 잠긴 상태에서 캡처하면
		-- false가 저장되어 영원히 안 풀리는 버그가 생김), 실제 복구도 토큰으로 가장 최근 시전에서만 실행되게 한다.
		local playerCtrl = self.Entity.PlayerControllerComponent
		if not self._T.isFireArrowMovementLocked then
			self._T.pendingFireArrowWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isFireArrowMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.fireArrowMoveLockToken = (self._T.fireArrowMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.fireArrowMoveLockToken

		-- 순수 상하 방향(dirX==0)은 캐릭터가 원래 보던 좌우 방향을 그대로 유지한다.
		local horizDirX
		if dirX ~= 0 then
			horizDirX = (dirX > 0) and 1 or -1
		else
			horizDirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		end

		-- 기모으는 느낌: 활 쏘는 모션 + 시전 이펙트/사운드는 즉시 재생하고, 실제 화살 발사는 약간의 딜레이 후에 한다.
		self:PlayFireArrowCastEffect(self.Entity, castRuid, dirX, dirY)
		self:PlayFireArrowMotion(self.Entity, "shoot1", horizDirX, atkMultiplier)
		_TimerService:SetTimerOnce(function()
			self:SpawnFireArrowProjectile(arrowRuid, combatPower, dirX, dirY)
		end, 0.25 * atkMultiplier)
		-- 이동 잠금은 모션 재생 시간이 아니라 스킬 재사용 대기시간(SkillManager의 0.75*atkMultiplier 쿨다운)과
		-- 동일하게 끝까지 유지한다 - "스킬 딜레이 동안 계속 못 움직여야 한다"는 요구사항 반영.
		_TimerService:SetTimerOnce(function()
			self:RestoreFireArrowControl(myMoveLockToken)
		end, 0.75 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayFireArrowMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 파이어에로우 전용 활 쏘는 모션 재생. 다른 스킬과 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isFireArrowDirectionLocked = true
		self._T.lockedFireArrowDirX = dirX
		self._T.lockedFireArrowMotionName = motionName
		self._T.isFireArrowMotionPlaying = true
		self._T.fireArrowLockToken = (self._T.fireArrowLockToken or 0) + 1
		local myFireArrowLockToken = self._T.fireArrowLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedFireArrowPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[FireArrow] PlayFireArrowMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		-- 모션 재생 자체(포즈 유지)는 화살이 발사되는 시점(0.25*mult)에 끝나지만, 이동 잠금(방향 고정)은
		-- 스킬 재사용 대기시간 전체(0.75*mult, SkillManager 쿨다운과 동일)까지 유지한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isFireArrowMotionPlaying = false
		end, 0.25 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.fireArrowLockToken ~= myFireArrowLockToken then return end
			self._T.isFireArrowDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.75 * mult)
	end

	@ExecSpace("Server")
	method void RestoreFireArrowControl(integer moveLockToken)
		-- 기모으는 딜레이가 끝나 화살이 발사된 직후 컨트롤러를 되돌린다. 홀드 지속발동으로 더 최근 시전이
		-- 이미 다시 잠가둔 상태라면(토큰 불일치) 여기서 섣불리 풀지 않는다 - 그 최근 시전의 복구 타이머가 처리한다.
		if self._T.fireArrowMoveLockToken ~= moveLockToken then return end
		self._T.isFireArrowMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingFireArrowWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingFireArrowDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnFireArrowProjectile(string arrowRuid, number combatPower, number dirX, number dirY)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.fireArrowCount = (self._T.fireArrowCount or 0) + 1
		local name = "firearrow_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.fireArrowCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이에서 날아가도록 y를 올린다 (다른 스킬들의 body-center 기준값 0.35 재사용)
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("firearrowprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] FireArrow 발사체 스폰 실패")
			return
		end

		local sprite = proj.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.SpriteRUID = arrowRuid
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type FireArrowProjectileAttack
		local projAtk = proj:GetComponent("script.FireArrowProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type FireArrowProjectile
		local projComp = proj:GetComponent("script.FireArrowProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			-- 쉐도우 파트너 활성 여부를 원본 화살에 새겨둔다 - 히트 시 원본+보너스(타수 2배) 합산과 2줄 표시에 쓰인다.
			projComp.ShadowEchoOn = self._T.shadowPartnerActive == true
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, dirY)
		end

		self:SpawnShadowEchoArrowProjectile("firearrowprojectile", "script.FireArrowProjectile", arrowRuid, Vector3(myPos.x, myPos.y + 0.35, myPos.z), dirX, dirY, combatPower)
	end

	@ExecSpace("Multicast")
	method void PlayFireArrowCastEffect(Entity attacker, string effectRuid, number dirX, number dirY)
		-- 사용자 몸 쪽에서 1회 재생되는 시전 이펙트 + 사운드.
		-- 순수 좌우 방향(dirY==0)은 회전 대신 FlipX로 반전한다 - 180도 회전을 쓰면 이펙트 원점이 발밑까지
		-- 밀려 내려가는 문제가 있어서(사용자 확인 - 왼쪽은 정상, 오른쪽만 밀림), 회전 없이 좌우만 미러링한다.
		-- 위/아래/대각선 방향은 회전이 필요하므로 그대로 두되, 방향별로 사용자가 실제 화면으로 확인해 지적한
		-- 어긋난 위치를 방향별 로컬 오프셋으로 보정한다(위=좌측+상단으로, 아래=우측+상단으로, 우측아래=우측+상단으로, 우측위=상단으로 더).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local angleDeg = 0
		local flipX = false
		local offsetX = 0
		local offsetY = 0
		if dirY == 0 then
			flipX = dirX > 0
		elseif dirX == 0 and dirY > 0 then
			-- 위
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = -0.15
			offsetY = 0.2
		elseif dirX == 0 and dirY < 0 then
			-- 아래
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = 0.35
			offsetY = 0.3
		elseif dirX > 0 and dirY > 0 then
			-- 우측위
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = -0.15
			offsetY = 0.45
		elseif dirX > 0 and dirY < 0 then
			-- 우측아래
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = 0.2
			offsetY = 0.45
		elseif dirX < 0 and dirY > 0 then
			-- 좌측위 (앞쪽 = 왼쪽이므로 offsetX는 음수)
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = -0.2
			offsetY = 0.2
		else
			-- 좌측아래 (아직 별도 피드백 없음 - 기존 기본 보정 유지)
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
		end
		-- 순수 상하 발사(위/아래)는 캐릭터가 원래 보던 좌우 방향을 유지한 채 쏘는데, 위 보정값들은
		-- 오른쪽을 볼 때 기준으로 맞춘 값이다. 왼쪽을 볼 때는 아바타 반전으로 몸의 시각적 중심이
		-- 왼쪽으로 치우쳐 이펙트가 상대적으로 오른쪽에 붙어 보인다(사용자 확인 - 오른쪽 볼 때는 정상).
		-- 왼쪽을 보고 있으면 그만큼 왼쪽으로 추가 보정한다.
		if dirX == 0 and dirY ~= 0 then
			local playerCtrl = attacker.PlayerControllerComponent
			if isvalid(playerCtrl) and playerCtrl.LookDirectionX < 0 then
				offsetX = offsetX - 0.15
			end
		end
		local castOptions = { ["FlipX"] = flipX }
		local serial = _EffectService:PlayEffectAttached(effectRuid, attacker, Vector3(offsetX, offsetY, 0), angleDeg, Vector3(1, 1, 1), false, castOptions)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		local echoSerial = self:EchoShadowSkillEffectAttached(effectRuid, attacker, Vector3(offsetX, offsetY, 0), angleDeg, Vector3(1, 1, 1), castOptions, dirX)
		_SoundService:PlaySound("6f972ab4e14841398281f3fc2a8f376e", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
			if echoSerial ~= 0 then
				_EffectService:RemoveEffect(echoSerial)
			end
		end, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackIronArrow(number combatPower, number atkMultiplier, number rawDirX, number rawDirY)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 아이언에로우: 파이어에로우와 완전히 동일한 구조(8방향 발사·기모으는 딜레이·이동봉인)를 그대로
		-- 재사용하되, 전용 이펙트/사운드를 쓰고 레벨에 따른 분기는 없다(고정 1종). 파이어에로우와 서로
		-- 간섭하지 않도록 모든 _T 필드는 별도로 둔다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local dirX, dirY = rawDirX, rawDirY
		local mag = math.sqrt(dirX * dirX + dirY * dirY)
		if mag > 0.0001 then
			dirX = dirX / mag
			dirY = dirY / mag
		else
			local playerCtrl = self.Entity.PlayerControllerComponent
			dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
			dirY = 0
		end
		self._T.pendingIronArrowDirX = dirX

		local castRuid = "dcac510901fe451282ad7b93abc3032d"
		local arrowRuid = "1e06841cc18a47c9975303520f3429d6"

		-- 기모으는 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다 (파이어에로우와 동일한 첫-시전-캡처 +
		-- 토큰 가드 패턴 - 홀드 지속발동 중에도 안전).
		local playerCtrl = self.Entity.PlayerControllerComponent
		if not self._T.isIronArrowMovementLocked then
			self._T.pendingIronArrowWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isIronArrowMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.ironArrowMoveLockToken = (self._T.ironArrowMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.ironArrowMoveLockToken

		-- 순수 상하 방향(dirX==0)은 캐릭터가 원래 보던 좌우 방향을 그대로 유지한다.
		local horizDirX
		if dirX ~= 0 then
			horizDirX = (dirX > 0) and 1 or -1
		else
			horizDirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		end

		self:PlayIronArrowCastEffect(self.Entity, castRuid, dirX, dirY)
		self:PlayIronArrowMotion(self.Entity, "shoot1", horizDirX, atkMultiplier)
		-- 화살이 실제로 발사되기까지의 기모으는 딜레이: 사용자 지정값 0.7로 직접 설정.
		_TimerService:SetTimerOnce(function()
			self:SpawnIronArrowProjectile(arrowRuid, combatPower, dirX, dirY)
		end, 0.7 * atkMultiplier)
		-- 이동 잠금은 모션 재생 시간이 아니라 스킬 재사용 대기시간(SkillManager의 0.75*atkMultiplier 쿨다운)과
		-- 동일하게 끝까지 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreIronArrowControl(myMoveLockToken)
		end, 0.75 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayIronArrowMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 아이언에로우 전용 활 쏘는 모션 재생. 파이어에로우와 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isIronArrowDirectionLocked = true
		self._T.lockedIronArrowDirX = dirX
		self._T.lockedIronArrowMotionName = motionName
		self._T.isIronArrowMotionPlaying = true
		self._T.ironArrowLockToken = (self._T.ironArrowLockToken or 0) + 1
		local myIronArrowLockToken = self._T.ironArrowLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedIronArrowPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[IronArrow] PlayIronArrowMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		-- 모션 재생 자체(포즈 유지)는 화살이 발사되는 시점(0.7*mult, 기모으는 딜레이와 동일하게 맞춤)에 끝나지만,
		-- 이동 잠금(방향 고정)은 스킬 재사용 대기시간 전체(0.75*mult, SkillManager 쿨다운과 동일)까지 유지한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isIronArrowMotionPlaying = false
		end, 0.7 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.ironArrowLockToken ~= myIronArrowLockToken then return end
			self._T.isIronArrowDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.75 * mult)
	end

	@ExecSpace("Server")
	method void RestoreIronArrowControl(integer moveLockToken)
		-- 기모으는 딜레이가 끝나 화살이 발사된 직후 컨트롤러를 되돌린다. 홀드 지속발동으로 더 최근 시전이
		-- 이미 다시 잠가둔 상태라면(토큰 불일치) 여기서 섣불리 풀지 않는다.
		if self._T.ironArrowMoveLockToken ~= moveLockToken then return end
		self._T.isIronArrowMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingIronArrowWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingIronArrowDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnIronArrowProjectile(string arrowRuid, number combatPower, number dirX, number dirY)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.ironArrowCount = (self._T.ironArrowCount or 0) + 1
		local name = "ironarrow_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.ironArrowCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이에서 날아가도록 y를 올린다 (파이어에로우와 동일한 body-center 기준값 0.35).
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("ironarrowprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] IronArrow 발사체 스폰 실패")
			return
		end

		local sprite = proj.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.SpriteRUID = arrowRuid
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type IronArrowProjectileAttack
		local projAtk = proj:GetComponent("script.IronArrowProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type IronArrowProjectile
		local projComp = proj:GetComponent("script.IronArrowProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			-- 쉐도우 파트너 활성 여부를 원본 화살에 새겨둔다 - 히트 시 원본+보너스(타수 2배) 합산과 2줄 표시,
			-- 히트 이펙트 시간차 2배 재생에 쓰인다.
			projComp.ShadowEchoOn = self._T.shadowPartnerActive == true
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, dirY)
		end

		self:SpawnShadowEchoArrowProjectile("ironarrowprojectile", "script.IronArrowProjectile", arrowRuid, Vector3(myPos.x, myPos.y + 0.35, myPos.z), dirX, dirY, combatPower)
	end

	@ExecSpace("Multicast")
	method void PlayIronArrowCastEffect(Entity attacker, string effectRuid, number dirX, number dirY)
		-- 사용자 몸 쪽에서 1회 재생되는 시전 이펙트 + 사운드. 파이어에로우와 동일한 방향별 오프셋/회전
		-- 보정 로직을 그대로 재사용한다(사용자가 이미 화면으로 확인해 맞춰둔 값).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local angleDeg = 0
		local flipX = false
		local offsetX = 0
		local offsetY = 0
		if dirY == 0 then
			-- 좌/우: 이전값(0.15)과 직전값(0.0)의 중간 - 0.075.
			flipX = dirX > 0
			offsetY = 0.075
		elseif dirX == 0 and dirY > 0 then
			-- 위(대각선 아님): 왼쪽을 보고 쏠 때는 더 왼쪽으로(-0.3, 기존 유지), 오른쪽을 보고 쏠 때는
			-- 몸에서 너무 멀어졌다는 피드백으로 좌측으로 옮김(0.3 -> -0.15, 원래의 좌측 기본값 수준으로).
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			local playerCtrl = attacker.PlayerControllerComponent
			local facingLeft = isvalid(playerCtrl) and playerCtrl.LookDirectionX < 0
			offsetX = facingLeft and -0.3 or -0.15
			offsetY = 0.2
		elseif dirX == 0 and dirY < 0 then
			-- 아래(대각선 아님): 오른쪽을 보고 쏠 때는 더 오른쪽으로(0.3, 기존 유지), 왼쪽을 보고 쏠 때는
			-- 몸에서 너무 멀어졌다는 피드백으로 우측으로 옮김(-0.3 -> 0.15, 원래의 우측 기본값 수준으로).
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			local playerCtrl = attacker.PlayerControllerComponent
			local facingRight = isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0
			offsetX = facingRight and 0.3 or 0.15
		elseif dirX > 0 and dirY > 0 then
			-- 우측위: 방금 올라간 정도(0.5->0.65, +0.15)만큼 한번 더 올림 - 0.65 -> 0.8.
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = 0.3
			offsetY = 0.8
		elseif dirX > 0 and dirY < 0 then
			-- 우측아래: 조금만 더 올림 - offsetY 0.1->0.2.
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = 0.45
			offsetY = 0.2
		elseif dirX < 0 and dirY > 0 then
			-- 좌측위: 우측위와 높이를 맞추는 기준(0.5) - 좌측 당김은 그대로 유지.
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = -0.7
			offsetY = 0.5
		else
			-- 좌측아래: 살짝 왼쪽으로 더 - offsetX -0.15 추가(offsetY -0.2 유지).
			angleDeg = math.deg(math.atan(dirY, dirX)) + 180
			offsetX = -0.15
			offsetY = -0.2
		end
		local castOptions = { ["FlipX"] = flipX }
		local serial = _EffectService:PlayEffectAttached(effectRuid, attacker, Vector3(offsetX, offsetY, 0), angleDeg, Vector3(1, 1, 1), false, castOptions)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		local echoSerial = self:EchoShadowSkillEffectAttached(effectRuid, attacker, Vector3(offsetX, offsetY, 0), angleDeg, Vector3(1, 1, 1), castOptions, dirX)
		_SoundService:PlaySound("7d5ef2c392a34251990a9dc8b51deb12", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
			if echoSerial ~= 0 then
				_EffectService:RemoveEffect(echoSerial)
			end
		end, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackAngelRay(number combatPower, number atkMultiplier)
		-- 엔젤레이(4차): 아이언에로우와 완전히 동일한 구조(기모으는 딜레이·이동봉인·관통 투사체)를
		-- 재사용하되, 8방향 조준 없이 캐릭터가 바라보는 방향(전방)으로만 발사하고(사용자 요청 사양),
		-- 시전/적중 이펙트는 직접 업로드한 클래식 아트를 프레임 교체 방식으로 재생한다.
		-- 관통은 최대 10명(AngelRayProjectile.MaxHitCount). 다른 스킬과 간섭하지 않도록 _T 필드는 별도.
		-- (기능 유지) 다른 스킬을 쓰면 숨고르기 모션은 중지한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		self._T.pendingAngelRayDirX = dirX

		-- 기모으는 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다(첫-시전-캡처 + 토큰 가드 패턴 -
		-- 홀드 지속발동 중에도 잠금이 고착되지 않는다).
		if not self._T.isAngelRayMovementLocked then
			self._T.pendingAngelRayWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isAngelRayMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.angelRayMoveLockToken = (self._T.angelRayMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.angelRayMoveLockToken

		-- 활쏘는 모션(shoot1)으로 시전한다(사용자 요청 - 아이언에로우와 동일한 모션).
		self:PlayAngelRayMotion(self.Entity, "shoot1", dirX, atkMultiplier)
		self:SpawnAngelRayCastEffect(dirX)
		self:PlayAngelRayUseSound(self.Entity)
		-- 빛줄기가 실제로 발사되기까지의 기모으는 딜레이: 아이언에로우와 동일한 0.7*배율.
		_TimerService:SetTimerOnce(function()
			self:SpawnAngelRayProjectile(combatPower, dirX)
		end, 0.7 * atkMultiplier)
		-- 이동 잠금은 스킬 재사용 대기시간(SkillManager의 0.75*atkMultiplier 쿨다운)과 동일하게 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreAngelRayControl(myMoveLockToken)
		end, 0.75 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayAngelRayMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 엔젤레이 전용 시전 모션 재생. 아이언에로우와 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isAngelRayDirectionLocked = true
		self._T.lockedAngelRayDirX = dirX
		self._T.lockedAngelRayMotionName = motionName
		self._T.isAngelRayMotionPlaying = true
		self._T.angelRayLockToken = (self._T.angelRayLockToken or 0) + 1
		local myAngelRayLockToken = self._T.angelRayLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedAngelRayPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[AngelRay] PlayAngelRayMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		-- 모션 재생 자체(포즈 유지)는 빛줄기가 발사되는 시점(0.7*mult)에 끝나지만,
		-- 이동 잠금(방향 고정)은 스킬 재사용 대기시간 전체(0.75*mult)까지 유지한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isAngelRayMotionPlaying = false
		end, 0.7 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.angelRayLockToken ~= myAngelRayLockToken then return end
			self._T.isAngelRayDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.75 * mult)
	end

	@ExecSpace("Server")
	method void RestoreAngelRayControl(integer moveLockToken)
		-- 기모으는 딜레이가 끝나 빛줄기가 발사된 직후 컨트롤러를 되돌린다. 홀드 지속발동으로 더 최근 시전이
		-- 이미 다시 잠가둔 상태라면(토큰 불일치) 여기서 섣불리 풀지 않는다.
		if self._T.angelRayMoveLockToken ~= moveLockToken then return end
		self._T.isAngelRayMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingAngelRayWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- 다른 스킬들과 동일하게 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingAngelRayDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnAngelRayProjectile(number combatPower, number dirX)
		-- 전방으로 관통 빛줄기 한 발을 발사한다. 발사 높이는 아이언에로우의 몸통 중심(0.35)에서
		-- (요청) 살짝 내린 사용자 지정값 0.3으로 확정(0.25는 너무 낮았음 - 조정은 이 값만).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.angelRayCount = (self._T.angelRayCount or 0) + 1
		local name = "angelray_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.angelRayCount)
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("angelrayprojectile", name, Vector3(myPos.x, myPos.y + 0.3, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] AngelRay 발사체 스폰 실패")
			return
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type AngelRayProjectileAttack
		local projAtk = proj:GetComponent("script.AngelRayProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type AngelRayProjectile
		local projComp = proj:GetComponent("script.AngelRayProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			-- 쉐도우 파트너 활성 여부를 원본에 새겨둔다 - 히트 시 원본+보너스(타수 2배) 합산과 2줄 표시에 쓰인다.
			projComp.ShadowEchoOn = self._T.shadowPartnerActive == true
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, 0)
		end
		log("[AngelRay] 발사 dirX=" .. tostring(dirX) .. " combatPower=" .. tostring(combatPower))

		self:SpawnShadowEchoArrowProjectile("angelrayprojectile", "script.AngelRayProjectile", "4d01ad5c78c14a8fb954fb76713048c4", Vector3(myPos.x, myPos.y + 0.3, myPos.z), dirX, 0, combatPower)
	end

	@ExecSpace("ServerOnly")
	method void SpawnAngelRayCastEffect(number dirX)
		-- 캐릭터 몸에서 피어오르는 클래식 시전 이펙트(effect0~14, 프레임당 60ms). 정지 스프라이트 15장이라
		-- EffectService(애니메이션클립 전용) 대신 공용 스프라이트 페이드 엔티티(SpearBurstFadingEffect)를
		-- 프레임 교체 방식으로 재사용한다(아이스샷 시전과 동일). 패딩 정렬본(185x194, origin(112,135))이라
		-- 단일 고정 위치 재생으로 흔들림이 없다 - origin이 캔버스 중심보다 x+19.5px/y+38px에 있으므로
		-- 중심을 (0.195*방향, 0.38)에 두면 origin이 캐릭터 발끝에 오는데, (요청) 이펙트가 조금 낮아
		-- 보인다는 피드백으로 y를 올렸다가 0.58은 과해서 사용자 지정값 0.43으로 확정(조정은 이 값만).
		-- 아트는 왼쪽 바라보기 기준이라 오른쪽을 볼 때 FlipX(x 오프셋 부호도 dirX를 곱해 반전).
		-- (원본/RUID 대응표: msw-dev-tools/resources/엔젤레이/RUID.md)
		local frames = {
			"f589e80ef37e4e2fbbe99b97915b329e", "9c4e6931f24c4aaa92363594c6c181e1",
			"6b3b8eab7b5e4cc28c73684fe9794b91", "f0b14236ed864b63bc2a04c62722fe48",
			"fdfd7c732ac64deaa1513b497c33fc9c", "8cebe7a19ebd4a58a48989e4e1f2d1a3",
			"ce02b0dd95744002b6f3d9671268257f", "da302311a55b4795b3e54ab7d2dbe17f",
			"02c11b4b3caf47c693a5eb960eec1138", "92e6e9e493ac4b89956df9f209d04b21",
			"3061ea19cdb34f40a503645097b2a891", "5abf2cb1687340c8bed551d2ea178dc2",
			"921860f9bee942ccb572a21439b6f6e0", "13eb62c1a0094965adbb19e3dbb5d4f0",
			"848cc0f7534642c9b5716c2c4f8bd30a",
		}
		self._T.angelRayFxSeq = (self._T.angelRayFxSeq or 0) + 1
		local fxName = "AngelRayCastFx_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.angelRayFxSeq)
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", fxName, Vector3(0.195 * dirX, 0.43, 0), self.Entity)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		---@type SpearBurstFadingEffect
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.IsFlipX = dirX > 0
			comp.StartAlpha = 1.0
			comp.EndAlpha = 0.0
			-- 15프레임(0.06초 간격 = 0.9초)을 다 보여준 뒤 페이드가 시작되도록 잡는다.
			comp.HoldDuration = 0.92
			comp.TweenDuration = 0.15
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.OrderInLayerValue = 6
			comp.ClipRUID = frames[1]
		end
		for i = 2, 15 do
			local idx = i
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then
					comp.ClipRUID = frames[idx]
				end
			end, 0.06 * (idx - 1))
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 1.2)
	end

	@ExecSpace("Multicast")
	method void PlayAngelRayUseSound(Entity attacker)
		-- 엔젤레이 사용음 - 원본 팩(skill/232.img/skill/2321007)에 Use 오디오가 없어
		-- 매직 미사일 사용음을 임시 재사용한다(전용 사운드가 생기면 교체 가능).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("a2ade2fb109b490cb95814c0622b4f4f", 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackHolyArrow(number combatPower, number atkMultiplier)
		-- 홀리 에로우(2차): 엔젤레이와 완전히 동일한 구조(전방 고정·기모으는 딜레이·이동봉인·관통 투사체)의
		-- 하위 버전. 관통은 최대 6명(HolyArrowProjectile.MaxHitCount), 화살은 3프레임 애니메이션.
		-- 다른 스킬과 간섭하지 않도록 _T 필드는 별도로 둔다.
		-- (기능 유지) 다른 스킬을 쓰면 숨고르기 모션은 중지한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		self._T.pendingHolyArrowDirX = dirX

		-- 기모으는 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다(첫-시전-캡처 + 토큰 가드 패턴).
		if not self._T.isHolyArrowMovementLocked then
			self._T.pendingHolyArrowWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isHolyArrowMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.holyArrowMoveLockToken = (self._T.holyArrowMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.holyArrowMoveLockToken

		-- 활쏘는 모션(shoot1)으로 시전한다(엔젤레이와 동일).
		self:PlayHolyArrowMotion(self.Entity, "shoot1", dirX, atkMultiplier)
		self:SpawnHolyArrowCastEffect(dirX)
		self:PlayHolyArrowUseSound(self.Entity)
		-- 화살이 실제로 발사되기까지의 기모으는 딜레이: 엔젤레이와 동일한 0.7*배율.
		_TimerService:SetTimerOnce(function()
			self:SpawnHolyArrowProjectile(combatPower, dirX)
		end, 0.7 * atkMultiplier)
		-- 이동 잠금은 스킬 재사용 대기시간(SkillManager의 0.75*atkMultiplier 쿨다운)과 동일하게 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreHolyArrowControl(myMoveLockToken)
		end, 0.75 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayHolyArrowMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 홀리 에로우 전용 활 쏘는 모션 재생. 엔젤레이와 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isHolyArrowDirectionLocked = true
		self._T.lockedHolyArrowDirX = dirX
		self._T.lockedHolyArrowMotionName = motionName
		self._T.isHolyArrowMotionPlaying = true
		self._T.holyArrowLockToken = (self._T.holyArrowLockToken or 0) + 1
		local myHolyArrowLockToken = self._T.holyArrowLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedHolyArrowPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[HolyArrow] PlayHolyArrowMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isHolyArrowMotionPlaying = false
		end, 0.7 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.holyArrowLockToken ~= myHolyArrowLockToken then return end
			self._T.isHolyArrowDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.75 * mult)
	end

	@ExecSpace("Server")
	method void RestoreHolyArrowControl(integer moveLockToken)
		-- 기모으는 딜레이가 끝나 화살이 발사된 직후 컨트롤러를 되돌린다(토큰 가드 - 홀드 잠금 고착 방지).
		if self._T.holyArrowMoveLockToken ~= moveLockToken then return end
		self._T.isHolyArrowMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingHolyArrowWasControllerEnabled then
			playerCtrl.Enable = true
		end
		self:PlayBreather(self.Entity, self._T.pendingHolyArrowDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnHolyArrowProjectile(number combatPower, number dirX)
		-- 전방으로 관통 화살 한 발을 발사한다. 발사 높이는 엔젤레이와 동일한 0.3.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.holyArrowCount = (self._T.holyArrowCount or 0) + 1
		local name = "holyarrow_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.holyArrowCount)
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("holyarrowprojectile", name, Vector3(myPos.x, myPos.y + 0.3, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] HolyArrow 발사체 스폰 실패")
			return
		end

		---@type HolyArrowProjectileAttack
		local projAtk = proj:GetComponent("script.HolyArrowProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type HolyArrowProjectile
		local projComp = proj:GetComponent("script.HolyArrowProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			projComp.ShadowEchoOn = self._T.shadowPartnerActive == true
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, 0)
		end
		log("[HolyArrow] 발사 dirX=" .. tostring(dirX) .. " combatPower=" .. tostring(combatPower))

		self:SpawnShadowEchoArrowProjectile("holyarrowprojectile", "script.HolyArrowProjectile", "d8275b5454a84af580d7dc865ae7ada0", Vector3(myPos.x, myPos.y + 0.3, myPos.z), dirX, 0, combatPower)
	end

	@ExecSpace("ServerOnly")
	method void SpawnHolyArrowCastEffect(number dirX)
		-- 캐릭터 몸에서 피어오르는 클래식 시전 이펙트(effect0~6, 프레임당 100ms). 정지 스프라이트 7장이라
		-- 공용 스프라이트 페이드 엔티티(SpearBurstFadingEffect)를 프레임 교체 방식으로 재사용한다.
		-- 패딩 정렬본(143x89, origin(103,76))은 origin이 캔버스 중심보다 x+31.5px/y+31.5px에 있으므로
		-- 중심을 (0.315*방향, 0.315)에 두면 origin이 캐릭터 발끝에 온다. 아트는 왼쪽 바라보기 기준이라
		-- 오른쪽을 볼 때 FlipX(x 오프셋 부호도 dirX를 곱해 반전).
		-- (원본/RUID 대응표: msw-dev-tools/resources/홀리에로우/RUID.md)
		local frames = {
			"d9e3726f83b648cbb235ff2ec77f2904", "ffd0471aa2654f0f83d52f9437a69451",
			"cdd3bb9a395644a7bf44b52751cf695a", "b3b8ccb8e5a247c28402d470aadc379c",
			"c96717e1d97042f589ea2da562525ad4", "ffdc4a624af340e093d6ebee921349f1",
			"801d3ae9a54e4b6d965ac2ba5565cfde",
		}
		self._T.holyArrowFxSeq = (self._T.holyArrowFxSeq or 0) + 1
		local fxName = "HolyArrowCastFx_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.holyArrowFxSeq)
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", fxName, Vector3(0.315 * dirX, 0.315, 0), self.Entity)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		---@type SpearBurstFadingEffect
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.IsFlipX = dirX > 0
			comp.StartAlpha = 1.0
			comp.EndAlpha = 0.0
			-- 7프레임(0.1초 간격 = 0.7초)을 다 보여준 뒤 페이드가 시작되도록 잡는다.
			comp.HoldDuration = 0.72
			comp.TweenDuration = 0.15
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.OrderInLayerValue = 6
			comp.ClipRUID = frames[1]
		end
		for i = 2, 7 do
			local idx = i
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then
					comp.ClipRUID = frames[idx]
				end
			end, 0.1 * (idx - 1))
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayHolyArrowUseSound(Entity attacker)
		-- 홀리 에로우 사용음 - MSW 라이브러리 원본 팩(skill/230.img/skill/2301005)의 _audio/Use 재사용.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("9af8818422a04d12877fb9e1c30573a8", 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackArrowBlow(number combatPower, number atkMultiplier, boolean enhanced)
		-- 에로우 블로우(1차): 전방으로 화살 한 발을 쏴서 적 "한 명"에게 전투력의 150%~200% 피해를 준다.
		-- 아이언 에로우의 구조(활 쏘는 모션·시전 딜레이·이동봉인)를 그대로 재사용하되, 8방향 조준은
		-- 없고(원작처럼 바라보는 방향 전방 고정) 몸쪽 시전 이펙트도 없다(해당 리소스가 없음).
		-- 다른 화살 스킬들과 서로 간섭하지 않도록 모든 _T 필드는 별도로 둔다.
		-- (기능 유지) 다른 스킬을 쓰면 숨고르기 모션은 중지한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		self._T.pendingArrowBlowDirX = dirX

		-- 시전 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다(아이언에로우와 동일한 첫-시전-캡처 +
		-- 토큰 가드 패턴 - 홀드 지속발동 중에도 잠금이 고착되지 않는다).
		if not self._T.isArrowBlowMovementLocked then
			self._T.pendingArrowBlowWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isArrowBlowMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.arrowBlowMoveLockToken = (self._T.arrowBlowMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.arrowBlowMoveLockToken

		self:PlayArrowBlowMotion(self.Entity, "shoot1", dirX, atkMultiplier)
		-- 1차 스킬이라 기모으는 동작 없이 빠르게 발사한다(아이언에로우의 0.7보다 훨씬 짧은 0.2).
		_TimerService:SetTimerOnce(function()
			-- 조준은 실제로 화살이 나가는 이 시점에 계산한다(시전 중 대상이 움직여도 따라간다).
			local aim = self:ComputeArrowAimDirection(dirX, self.ArrowAimXReach, self.ArrowAimYHalfHeight)
			self:SpawnArrowBlowProjectile(combatPower, aim.x, aim.y, enhanced)
		end, 0.2 * atkMultiplier)
		-- 이동 잠금은 스킬 재사용 대기시간(SkillManager의 0.75*atkMultiplier 쿨다운)과 동일하게 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreArrowBlowControl(myMoveLockToken)
		end, 0.75 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayArrowBlowMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 에로우 블로우 전용 활 쏘는 모션 재생. 아이언에로우와 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isArrowBlowDirectionLocked = true
		self._T.lockedArrowBlowDirX = dirX
		self._T.lockedArrowBlowMotionName = motionName
		self._T.isArrowBlowMotionPlaying = true
		self._T.arrowBlowLockToken = (self._T.arrowBlowLockToken or 0) + 1
		local myArrowBlowLockToken = self._T.arrowBlowLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedArrowBlowPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[ArrowBlow] PlayArrowBlowMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		-- 모션 재생 자체(포즈 유지)는 화살이 발사되는 시점(0.2*mult)에 끝나지만, 이동 잠금(방향 고정)은
		-- 스킬 재사용 대기시간 전체(0.75*mult)까지 유지한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isArrowBlowMotionPlaying = false
		end, 0.2 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.arrowBlowLockToken ~= myArrowBlowLockToken then return end
			self._T.isArrowBlowDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.75 * mult)
	end

	@ExecSpace("Server")
	method void RestoreArrowBlowControl(integer moveLockToken)
		-- 시전이 끝나 컨트롤러를 되돌린다. 홀드 지속발동으로 더 최근 시전이 이미 다시 잠가둔 상태라면
		-- (토큰 불일치) 여기서 섣불리 풀지 않는다.
		if self._T.arrowBlowMoveLockToken ~= moveLockToken then return end
		self._T.isArrowBlowMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingArrowBlowWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- 다른 스킬들과 동일하게 컨트롤 복구 시점에 공용 숨고르기 모션을 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingArrowBlowDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnArrowBlowProjectile(number combatPower, number dirX, number dirY, boolean enhanced)
		-- 에로우 블로우 화살 한 발을 맵에 스폰하고 조준 방향(dirX, dirY)으로 발사한다.
		-- enhanced면 화살에 강화 플래그를 새겨 첫 명중 지점에서 폭발(이펙트 3개 + 최대 5명 시간차 타격)한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.arrowBlowCount = (self._T.arrowBlowCount or 0) + 1
		local name = "arrowblow_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.arrowBlowCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이에서 날아가도록 y를 올린다(다른 화살 스킬과 동일한 0.35).
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("arrowblowprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] ArrowBlow 발사체 스폰 실패")
			return
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type ArrowBlowProjectileAttack
		local projAtk = proj:GetComponent("script.ArrowBlowProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type ArrowBlowProjectile
		local projComp = proj:GetComponent("script.ArrowBlowProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp.Enhanced = enhanced
			projComp:Fire(dirX, dirY)
		end
		log("[ArrowBlow] 화살 발사 dir=(" .. string.format("%.2f", dirX) .. "," .. string.format("%.2f", dirY) .. ") combatPower=" .. tostring(combatPower) .. " enhanced=" .. tostring(enhanced))
	end

	@ExecSpace("ServerOnly")
	method void AttackDoubleShot(number combatPower, number atkMultiplier, integer jobIdx)
		-- 더블샷(1차): 전방으로 화살 두 발을 동시에 쏜다. 두 발은 같은 x·같은 y에서 출발해 날아갈수록
		-- 위아래로 미세하게 벌어지고, 각각 적 한 명씩을 맞혀 럭키세븐처럼 데미지 숫자가 2줄로 뜬다.
		-- 화살 그림은 직업별로 다르다 - 신궁(jobIdx 7)은 ball2, 보우마스터(8) 및 그 외는 ball1.
		-- 에로우 블로우와 동일한 구조(활 쏘는 모션·시전 딜레이·이동봉인)를 쓰되 전용 _T 필드를 둔다.
		-- (기능 유지) 다른 스킬을 쓰면 숨고르기 모션은 중지한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		self._T.pendingDoubleShotDirX = dirX

		-- 시전 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다(첫-시전-캡처 + 토큰 가드 패턴 -
		-- 홀드 지속발동 중에도 잠금이 고착되지 않는다).
		if not self._T.isDoubleShotMovementLocked then
			self._T.pendingDoubleShotWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isDoubleShotMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.doubleShotMoveLockToken = (self._T.doubleShotMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.doubleShotMoveLockToken

		-- 신궁은 ball2(37x7 굵은 금색 화살), 그 외(보우마스터 포함)는 ball1(29x3 가는 주황 화살).
		local ballRuid = (jobIdx == 7) and "c43f61a98b8f41fd8a7d5f8769034db8" or "f1a8e518ae624dbcbe9c007af3429c2d"

		self:PlayDoubleShotMotion(self.Entity, "shoot1", dirX, atkMultiplier)
		_TimerService:SetTimerOnce(function()
			-- 조준은 실제로 화살이 나가는 이 시점에 계산한다(시전 중 대상이 움직여도 따라간다).
			-- 두 발은 완전히 같은 방향/좌표에서 동시에 발사된다(HitIndex/SpreadDir만 다르다).
			local aim = self:ComputeArrowAimDirection(dirX, self.ArrowAimXReach, self.ArrowAimYHalfHeight)
			self:SpawnDoubleShotProjectile(ballRuid, combatPower, aim.x, aim.y, 1, 1)
			self:SpawnDoubleShotProjectile(ballRuid, combatPower, aim.x, aim.y, 2, -1)
		end, 0.2 * atkMultiplier)
		-- 이동 잠금은 스킬 재사용 대기시간(SkillManager의 0.75*atkMultiplier 쿨다운)과 동일하게 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreDoubleShotControl(myMoveLockToken)
		end, 0.75 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayDoubleShotMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 더블샷 전용 활 쏘는 모션 재생. 다른 화살 스킬과 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isDoubleShotDirectionLocked = true
		self._T.lockedDoubleShotDirX = dirX
		self._T.lockedDoubleShotMotionName = motionName
		self._T.isDoubleShotMotionPlaying = true
		self._T.doubleShotLockToken = (self._T.doubleShotLockToken or 0) + 1
		local myDoubleShotLockToken = self._T.doubleShotLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedDoubleShotPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[DoubleShot] PlayDoubleShotMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isDoubleShotMotionPlaying = false
		end, 0.2 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.doubleShotLockToken ~= myDoubleShotLockToken then return end
			self._T.isDoubleShotDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.75 * mult)
	end

	@ExecSpace("Server")
	method void RestoreDoubleShotControl(integer moveLockToken)
		-- 시전이 끝나 컨트롤러를 되돌린다. 홀드 지속발동으로 더 최근 시전이 이미 다시 잠가둔 상태라면
		-- (토큰 불일치) 여기서 섣불리 풀지 않는다.
		if self._T.doubleShotMoveLockToken ~= moveLockToken then return end
		self._T.isDoubleShotMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingDoubleShotWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- 다른 스킬들과 동일하게 컨트롤이 복구된 시점에 공용 숨고르기 모션을 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingDoubleShotDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnDoubleShotProjectile(string ballRuid, number combatPower, number dirX, number dirY, integer hitIndex, number spreadDir)
		-- 더블샷 화살 한 발을 맵에 스폰하고 전방으로 발사한다. 두 발은 완전히 같은 좌표에서 출발하고
		-- (spreadDir이 서로 반대라) 날아가면서 위아래로 벌어진다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.doubleShotCount = (self._T.doubleShotCount or 0) + 1
		local name = "doubleshot_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.doubleShotCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이에서 날아가도록 y를 올린다(다른 화살 스킬과 동일한 0.35).
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("doubleshotprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] DoubleShot 발사체 스폰 실패")
			return
		end

		local sprite = proj.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.SpriteRUID = ballRuid
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type DoubleShotProjectileAttack
		local projAtk = proj:GetComponent("script.DoubleShotProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type DoubleShotProjectile
		local projComp = proj:GetComponent("script.DoubleShotProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			projComp.HitIndex = hitIndex
			projComp.SpreadDir = spreadDir
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, dirY)
		end
		log("[DoubleShot] 화살 발사 hitIndex=" .. tostring(hitIndex) .. " spreadDir=" .. tostring(spreadDir) .. " dir=(" .. string.format("%.2f", dirX) .. "," .. string.format("%.2f", dirY) .. ") combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("ServerOnly")
	method void AttackStrafe(number combatPower, number atkMultiplier)
		-- 스트레이프(3차): 전방으로 화살 네 발을 짧은 시간차(0.09초 간격)로 연속 발사한다. 네 발은 같은
		-- 직선을 따라 날아가 보통 맨 앞의 적 한 명에게 4줄의 데미지가 뜬다(영상: "1명을 4번 공격").
		-- 더블샷과 동일한 구조(활 쏘는 모션·시전 딜레이·이동봉인)를 쓰되 전용 _T 필드를 둔다.
		-- (기능 유지) 다른 스킬을 쓰면 숨고르기 모션은 중지한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		self._T.pendingStrafeDirX = dirX

		-- 시전 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다(첫-시전-캡처 + 토큰 가드 패턴 -
		-- 홀드 지속발동 중에도 잠금이 고착되지 않는다).
		if not self._T.isStrafeMovementLocked then
			self._T.pendingStrafeWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isStrafeMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.strafeMoveLockToken = (self._T.strafeMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.strafeMoveLockToken

		-- 확정 히트 데미지 공식(CalcDamageBase의 skill.strafe.lock 분기)과 판정 실패 시 표시 전용
		-- 데미지가 함께 읽는 전투력을 미리 걸어둔다(스피어 버스터의 pendingSpearBurstCombatPower와 동일).
		self._T.pendingStrafeCombatPower = combatPower

		self:PlayStrafeMotion(self.Entity, "shoot1", dirX, atkMultiplier)
		self:PlayStrafeCastEffect(self.Entity, dirX)
		_TimerService:SetTimerOnce(function()
			-- 조준/타겟은 첫 발이 나가는 이 시점에 한 번만 확정하고 네 발이 그대로 공유한다.
			-- (기능 변경) 스피어 버스터 로직 참고 - 전방 박스에서 몬스터 "한 명"을 타겟으로 고정하고,
			-- 그 대상이 4발 도중에 죽더라도 4대가 전부 들어가도록 각 발의 도착 시점에 확정 히트
			-- (DealStrafeLockHit)를 별도로 예약한다. 화살 자체는 시각 연출 전용이 된다.
			local myPos = self.Entity.TransformComponent.WorldPosition
			local originX, originY = myPos.x, myPos.y + 0.35
			-- (피드백) 사거리: 다른 화살 스킬(6.0)의 1/3(2.0) → 다시 2.5배로 5.0 확정.
			local strafeReach = self.ArrowAimXReach / 3 * 2.5
			local target = self:FindNearestMonsterInForwardBox(Vector2(originX, originY), dirX, strafeReach, self.ArrowAimYHalfHeight)
			local aim = self:ComputeArrowAimDirection(dirX, strafeReach, self.ArrowAimYHalfHeight)
			local hasTarget = isvalid(target)
			-- (요청) "한 지점 수렴" 대신 네 발이 타겟 몸의 위쪽부터 아래쪽까지 나뉘어 꽂힌다 - 타겟
			-- 히트박스 높이의 위 3/4 지점부터 아래 3/4 지점까지 4개 도착 높이를 만들고, 각 발은 몸통
			-- 주변의 서로 다른 출발 높이에서 자기 도착점을 향해 날아간다(각도는 자연히 발마다 다르다).
			local destX, destCenterY
			local halfH = 0.3
			if hasTarget then
				self._T.strafeCurrentTarget = target
				local tp = target.TransformComponent.WorldPosition
				local ty = tp.y
				local thc = target.HitComponent
				if isvalid(thc) then
					ty = ty + thc.ColliderOffset.y
					-- 몬스터 히트박스 실제 높이로 위→아래 분산 폭을 정한다(Box는 세로 절반, Circle은 반지름).
					if thc.ColliderType == ColliderType.Box then
						halfH = thc.BoxSize.y / 2
					elseif thc.ColliderType == ColliderType.Circle then
						halfH = thc.CircleRadius
					end
					if halfH < 0.15 then halfH = 0.15 end
				end
				destX, destCenterY = tp.x, ty
			else
				destX, destCenterY = originX + aim.x * strafeReach, originY + aim.y * strafeReach
			end
			-- 도착 높이: 타겟 몸통 중심 기준 위(+0.75H)→아래(-0.75H) 순. 1발째가 맨 위에 꽂힌다.
			local destYOffsets = { halfH * 0.75, halfH * 0.25, -halfH * 0.25, -halfH * 0.75 }
			for i = 1, 4 do
				local hitIndex = i
				-- 4줄이 뜨는 시간 간격은 스피어 버스터(0.1초*배율)와 같게 - 발사 간격이 곧 도착 간격이 된다.
				local spawnDelay = 0.1 * atkMultiplier * (i - 1)
				-- (피드백) 출발은 네 발 모두 한 점(몸통 중심) - 도착점만 타겟 위→아래로 갈라진다.
				local ddx = destX - originX
				local ddy = (destCenterY + destYOffsets[i]) - originY
				local dist = math.sqrt(ddx * ddx + ddy * ddy)
				if dist < 0.0001 then dist = 0.0001 end
				local dirAx, dirAy = ddx / dist, ddy / dist
				-- 타겟이 있으면 x좌표 교차 판정(LockHit)이 소멸을 담당하므로 flightTime은 끄고(0),
				-- 타겟이 없으면 사거리 끝 가상 지점에서 사라지도록 비행시간을 건다.
				-- (피드백) 화살 속도 4/5 - StrafeProjectile.Speed(8)와 같은 값으로 나눠야 한다.
				local flightTime = 0
				if not hasTarget then
					flightTime = dist / 8.0
					if flightTime < 0.05 then flightTime = 0.05 end
				end
				-- (요청) "한 명만 공격" - 화살의 물리 판정은 항상 끈다. 데미지는 x좌표가 타겟과 겹치는
				-- 순간 화살이 직접 발동하는 확정 히트(DealStrafeLockHit)로만 들어간다.
				local destYOff = destYOffsets[i]
				if spawnDelay <= 0 then
					self:SpawnStrafeProjectile(combatPower, dirAx, dirAy, hitIndex, 0, flightTime, hasTarget, target, destX, destYOff)
				else
					_TimerService:SetTimerOnce(function()
						self:SpawnStrafeProjectile(combatPower, dirAx, dirAy, hitIndex, 0, flightTime, hasTarget, target, destX, destYOff)
					end, spawnDelay)
				end
			end
		end, 0.2 * atkMultiplier)
		-- 이동 잠금은 스킬 재사용 대기시간(SkillManager의 0.9*atkMultiplier 쿨다운)과 동일하게 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreStrafeControl(myMoveLockToken)
		end, 0.9 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayStrafeMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 스트레이프 전용 활 쏘는 모션 재생. 다른 화살 스킬과 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		-- 네 발이 나가는 동안(마지막 발 0.47*배율) 모션이 유지되도록 더블샷보다 창을 길게 잡는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isStrafeDirectionLocked = true
		self._T.lockedStrafeDirX = dirX
		self._T.lockedStrafeMotionName = motionName
		self._T.isStrafeMotionPlaying = true
		self._T.strafeLockToken = (self._T.strafeLockToken or 0) + 1
		local myStrafeLockToken = self._T.strafeLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedStrafePlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[Strafe] PlayStrafeMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isStrafeMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.strafeLockToken ~= myStrafeLockToken then return end
			self._T.isStrafeDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.9 * mult)
	end

	@ExecSpace("Multicast")
	method void PlayStrafeCastEffect(Entity attacker, number dirX)
		-- 원본 팩(skill/800032.img/skill/80003299)의 effect(파란 링 + 노란 섬광, 6프레임)를 몸 쪽에서
		-- 1회 재생한다 + 화살류 공용 시전 사운드. 원본 아트는 왼쪽 발사 기준이라 오른쪽을 볼 때 FlipX.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		-- (피드백) 링이 캐릭터 위쪽에 떠 보인다 → 높이 0.0으로 내림. "몸쪽으로 당겨달라"가 세 차례
		-- 이어져 전방 오프셋 0.5 → 0.2 → 0.1 → 0.0(몸 중앙 완전 겹침)으로 확정.
		local castOptions = { ["FlipX"] = dirX > 0 }
		local serial = _EffectService:PlayEffectAttached("028a2e518e6c4713ad7300684d4a39d2", attacker, Vector3(0, 0.0, 0), 0, Vector3(1, 1, 1), false, castOptions)
		_SoundService:PlaySound("7d5ef2c392a34251990a9dc8b51deb12", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	@ExecSpace("Server")
	method void RestoreStrafeControl(integer moveLockToken)
		-- 시전이 끝나 컨트롤러를 되돌린다. 홀드 지속발동으로 더 최근 시전이 이미 다시 잠가둔 상태라면
		-- (토큰 불일치) 여기서 섣불리 풀지 않는다.
		if self._T.strafeMoveLockToken ~= moveLockToken then return end
		self._T.isStrafeMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingStrafeWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- 다른 스킬들과 동일하게 컨트롤이 복구된 시점에 공용 숨고르기 모션을 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingStrafeDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnStrafeProjectile(number combatPower, number dirX, number dirY, integer hitIndex, number startYOffset, number flightTime, boolean lockHit, Entity lockTarget, number targetX, number hitYOffset)
		-- 스트레이프 화살 한 발을 맵에 스폰하고 발사한다. 네 발이 몸통 주변의 서로 다른 높이
		-- (startYOffset)에서 시간차로 출발하고, 방향(dirX, dirY)은 호출부가 "자기 시작점 → 자기 도착
		-- 높이(타겟 몸 위~아래)"로 미리 계산해 넘겨준다. lockHit이면 화살 스스로 x좌표가 targetX를
		-- 지나는 순간 확정 히트를 발동하고 소멸한다(물리 판정은 항상 꺼짐 - "한 명만 공격").
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.strafeCount = (self._T.strafeCount or 0) + 1
		local name = "strafe_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.strafeCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이(0.35) 기준으로 발마다 startYOffset을 더해 출발시킨다.
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("strafeprojectile", name, Vector3(myPos.x, myPos.y + 0.35 + startYOffset, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] Strafe 발사체 스폰 실패")
			return
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type StrafeProjectileAttack
		local projAtk = proj:GetComponent("script.StrafeProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type StrafeProjectile
		local projComp = proj:GetComponent("script.StrafeProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			projComp.HitIndex = hitIndex
			projComp.FlightTime = flightTime
			projComp.AttackEnabled = false
			projComp.LockHit = lockHit
			projComp.TargetX = targetX
			projComp.HitYOffset = hitYOffset
			if lockHit and isvalid(lockTarget) then
				projComp.TargetEntity = lockTarget
				projComp.OwnerEntity = self.Entity
			end
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, dirY)
		end
		log("[Strafe] 화살 발사 hitIndex=" .. tostring(hitIndex) .. " startYOffset=" .. tostring(startYOffset) .. " dir=(" .. string.format("%.2f", dirX) .. "," .. string.format("%.2f", dirY) .. ") lockHit=" .. tostring(lockHit) .. " targetX=" .. string.format("%.2f", targetX) .. " hitYOffset=" .. string.format("%.2f", hitYOffset))
	end

	@ExecSpace("Server")
	method void DealStrafeLockHit(Entity target, number dirX, integer hitIndex, number hitYOffset)
		-- 고정 타겟에게 스트레이프 4연발 중 hitIndex번째 화살을 확정 적중시킨다. 스피어 버스터의
		-- DealSpearBurstStabHit와 완전히 동일한 구조다: 대상 자리에서 진짜 Attack() 판정을 걸되
		-- (IsAttackTarget이 strafeCurrentTarget 단일 대상만 통과), 앞선 화살에 대상이 이미 죽어 판정이
		-- 실패해도 표시 전용 데미지를 같은 공식으로 새로 굴려 4줄이 항상 뜨게 한다.
		-- (버그 수정 이력 참고) 같은 AttackComponent로 같은 대상을 짧은 간격으로 반복 Attack()하면
		-- GetDisplayHitCount=0을 반환해도 자동 데미지 숫자가 중복으로 뜨는 문제가 실측 확인돼, 대상의
		-- DamageSkinSpawnerComponent를 판정 직전 잠깐 떼었다가 붙인다(더블스탭/스피어 버스터와 동일).
		if not isvalid(target) then return end
		self._T.strafeCurrentTarget = target
		---@type Monster
		local monsterComp = target:GetComponent("script.Monster")
		local wasAlreadyDead = isvalid(monsterComp) and monsterComp.IsDead
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local targetSkinSpawner = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		if isvalid(targetSkinSpawner) then target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent") end
		local hitComps = self:Attack(shape, "skill.strafe.lock", CollisionGroups.HitBox)
		if not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then target:AddComponent("MOD.Core.DamageSkinSpawnerComponent") end
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		local damage = self._T.lastStrafeDamage or 0
		local isCritical = self._T.lastStrafeIsCritical or false
		if not actuallyHit then
			-- 대상이 이미 죽어 판정 자체가 실패해도 4줄이 항상 뜨도록 표시 전용 데미지를 동일 공식으로
			-- 새로 굴린다(실제 Hp에는 영향 없음). CalcDamageBase의 skill.strafe.lock 분기와 반드시
			-- 같은 배율(200%~250%)을 유지해야 한다. 크리티컬도 독립적으로 굴린다.
			local critRate = self:GetServerCritRatePercent() / 100
			local critMult = (self._T.currentCritDamagePercent or 125) / 100
			local combatPower = self._T.pendingStrafeCombatPower or 0
			local mult = 2.0 + _UtilLogic:RandomDouble() * (2.5 - 2.0)
			damage = self:ApplyComboAttackBonus(math.floor(combatPower * mult))
			-- 백스탭도 실제 히트와 같은 시전 판정으로 얹는다 - 이 표시 전용 경로에 안 얹으면 앞선 타격에
			-- 대상이 죽은 뒤의 줄만 보너스가 빠져 "6줄 중 일부만 백스탭이 걸린 것처럼" 보인다.
			damage = self:ApplyBackstabBonus(damage, self.Entity, target, "skill.strafe.lock")
			isCritical = _UtilLogic:RandomDouble() < critRate
			if isCritical then damage = math.floor(damage * critMult) end
		end
		self:ShowStrafeLockDamageSkin(target, damage, hitIndex, isCritical)
		self:PlayStrafeLockHitEffect(target, hitYOffset)
		-- 실제로 명중했고 대상이 살아있었다면 Monster.HandleHitEvent가 이미 히트음을 재생했다 - 이미
		-- 죽어있었거나 판정이 실패한 경우에만 직접 보충 재생해 4번의 히트음이 항상 나도록 한다
		-- (스피어 버스터와 동일한 중복 방지 로직).
		if isvalid(monsterComp) and (not actuallyHit or wasAlreadyDead) then
			monsterComp:PlayHitSound()
		end
		log("[Strafe] DealStrafeLockHit hitIndex=" .. tostring(hitIndex) .. " actuallyHit=" .. tostring(actuallyHit) .. " wasAlreadyDead=" .. tostring(wasAlreadyDead) .. " damage=" .. tostring(damage))
	end

	@ExecSpace("Client")
	method void ShowStrafeLockDamageSkin(Entity target, integer damage, integer hitIndex, boolean isCritical)
		-- 영상처럼 네 발의 데미지를 서로 겹치지 않는 4줄로 나눠 표시한다(1발째가 맨 아래, 4발째가 맨 위).
		-- (요청) 줄 간격은 스피어 버스터와 동일한 0.3 - 3줄 -0.3/0/0.3, 6줄 -0.75~0.75와 같은 규격의
		-- 4줄 중앙 배치(-0.45/-0.15/0.15/0.45)를 쓴다.
		if not isvalid(target) then return end
		local offsetY = -0.45 + (hitIndex - 1) * 0.3
		_DamageSkinService:Play(
			target, self:GetHitDamageSkinId(), 0,
			{ damage }, DamageSkinTweenType.Default, isCritical,
			Vector2(0, offsetY), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		)
		log("[Strafe] ShowStrafeLockDamageSkin hitIndex=" .. tostring(hitIndex) .. " damage=" .. tostring(damage) .. " offsetY=" .. tostring(offsetY) .. " crit=" .. tostring(isCritical))
	end

	@ExecSpace("Client")
	method void PlayStrafeLockHitEffect(Entity target, number hitYOffset)
		-- 원본 팩(skill/800032.img/skill/80003299)의 hit/0(분홍 별 폭발)을 화살이 실제로 꽂힌 높이
		-- (몸통 중심 + hitYOffset)에서 1회 터뜨린다 + 화살 히트 사운드.
		if not isvalid(target) then return end
		local offsetY = 0.3
		local hitComp = target.HitComponent
		if isvalid(hitComp) then offsetY = hitComp.ColliderOffset.y end
		offsetY = offsetY + hitYOffset
		local serial = _EffectService:PlayEffectAttached("2d66c100851845ec902a98ede7c88b78", target, Vector3(0, offsetY, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 5 })
		_SoundService:PlaySound("eb49560ca2a84e0585e0e83cd61c9dc6", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void AttackIceShot(number combatPower, number atkMultiplier)
		-- 아이스 샷(3차): 캐릭터 주변 백청색 방사광과 함께 정면으로 탄환(ball)을 딱 한 발 쏜다.
		-- 탄환이 도착한 지점에서 화살비가 쏟아지고, 그 범위 안의 몬스터 최대 10명이 각각 한 번씩
		-- 전투력의 500%~700% 피해 + 얼음 결정 이펙트 + 3초 빙결(이동/AI 정지, 차지 블로우 얼음 빙결과
		-- 동일한 처리)을 받는다. 파이어 샷과 완전히 같은 구조다(원본 영상 기준).
		-- (기능 유지) 다른 스킬을 쓰면 숨고르기 모션은 중지한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		self._T.pendingIceShotDirX = dirX
		-- 확정 히트 데미지 공식(CalcDamageBase의 skill.iceshot 분기)이 읽는 전투력을 미리 걸어둔다.
		self._T.pendingIceShotCombatPower = combatPower

		-- 시전 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다(첫-시전-캡처 + 토큰 가드 패턴).
		if not self._T.isIceShotMovementLocked then
			self._T.pendingIceShotWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isIceShotMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.iceShotMoveLockToken = (self._T.iceShotMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.iceShotMoveLockToken

		self:PlayIceShotMotion(self.Entity, "shoot1", dirX, atkMultiplier)
		self:SpawnIceShotCastEffect()
		self:PlayIceShotUseSound(self.Entity)
		_TimerService:SetTimerOnce(function()
			-- (원본 영상 반영) 시전할 때 탄환은 딱 한 발만 나간다. 캐릭터가 바라보는 쪽에서 가장 가까운
			-- 대상을 조준하고, 그 한 발이 도착한 자리에서 광역 히트 + 화살비가 터진다.
			-- 바라보는 쪽에 대상이 없으면 앞으로 날아가다 사라지는 시각 전용 탄환만 나간다.
			local myPos = self.Entity.TransformComponent.WorldPosition
			local originX, originY = myPos.x, myPos.y + 0.35
			local aim = self:FindShotAimTarget(Vector2(originX, originY), dirX)
			if isvalid(aim) then
				self:SpawnIceShotProjectile(aim, originX, originY)
			else
				self:SpawnIceShotBlankProjectile(originX, originY, dirX)
				log("[IceShot] 조준 대상 없음 - 시각 전용 탄환 발사")
			end
		end, 0.4 * atkMultiplier)
		-- 이동 잠금은 스킬 재사용 대기시간(SkillManager의 1.0*atkMultiplier 쿨다운)과 동일하게 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreIceShotControl(myMoveLockToken)
		end, 1.0 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayIceShotMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 아이스 샷 전용 활 쏘는 모션 재생. 다른 화살 스킬과 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isIceShotDirectionLocked = true
		self._T.lockedIceShotDirX = dirX
		self._T.lockedIceShotMotionName = motionName
		self._T.isIceShotMotionPlaying = true
		self._T.iceShotLockToken = (self._T.iceShotLockToken or 0) + 1
		local myIceShotLockToken = self._T.iceShotLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedIceShotPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[IceShot] PlayIceShotMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isIceShotMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.iceShotLockToken ~= myIceShotLockToken then return end
			self._T.isIceShotDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 1.0 * mult)
	end

	@ExecSpace("Multicast")
	method void PlayIceShotUseSound(Entity attacker)
		-- 아이스 샷 사용음(화살류 공용 시전음 재사용 - 아이스샷 원본 폴더에 오디오가 없음).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("7d5ef2c392a34251990a9dc8b51deb12", 1.0)
	end

	@ExecSpace("Server")
	method void RestoreIceShotControl(integer moveLockToken)
		-- 시전이 끝나 컨트롤러를 되돌린다(토큰 가드 - 홀드 지속발동 중 잠금 고착 방지).
		if self._T.iceShotMoveLockToken ~= moveLockToken then return end
		self._T.isIceShotMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingIceShotWasControllerEnabled then
			playerCtrl.Enable = true
		end
		self:PlayBreather(self.Entity, self._T.pendingIceShotDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnIceShotCastEffect()
		-- 캐릭터 몸에서 퍼지는 백청색 방사광(effect1~9, 0.11초 간격) + 스페셜 잔광 1회.
		-- 정지 스프라이트 9장이라 EffectService(애니메이션클립 전용) 대신 프로젝트 공용 스프라이트
		-- 페이드 엔티티(SpearBurstFadingEffect)를 프레임 교체 방식으로 재사용한다(더블샷 히트와 동일).
		-- (원본/RUID 대응표: msw-dev-tools/resources/아이스샷/RUID.md)
		local frames = {
			"b403326e82304598873d37bbf57c6b93",
			"450dda0f413945faa44fb2135082ef05",
			"73aa5e24acfd4b66b91829f779099365",
			"e67191d8816d478a880550c3a58d9f8f",
			"3f29477d4edb4ae5a2def02d69bcd587",
			"bd1609c01d4b40a5b13bf8455c9a22f7",
			"f9e8423d4d514dcfa88f42fe5867d8a3",
			"4ece98754816484dace1322e13042151",
			"249df88b783c492a8d82e862780719fd",
		}
		self._T.iceShotFxSeq = (self._T.iceShotFxSeq or 0) + 1
		local fxName = "IceShotCastFx_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.iceShotFxSeq)
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", fxName, Vector3(0, 0.35, 0), self.Entity)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		---@type SpearBurstFadingEffect
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.StartAlpha = 1.0
			comp.EndAlpha = 0.0
			-- 9프레임(0.11초 간격 = 0.99초)을 다 보여준 뒤 페이드가 시작되도록 잡는다.
			comp.HoldDuration = 1.0
			comp.TweenDuration = 0.15
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.OrderInLayerValue = 6
			comp.ClipRUID = frames[1]
		end
		for i = 2, 9 do
			local idx = i
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then
					comp.ClipRUID = frames[idx]
				end
			end, 0.11 * (idx - 1))
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 1.3)

		-- 스페셜 잔광(effectspecial) - 시전 시작에 짧게 겹쳐 보여준다.
		local spName = "IceShotCastSp_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.iceShotFxSeq)
		local sp = _SpawnService:SpawnByModelId("spearburstfadingeffect", spName, Vector3(0, 0.35, 0), self.Entity)
		if isvalid(sp) then
			sp:AddComponent("script.SpearBurstFadingEffect")
			---@type SpearBurstFadingEffect
			local spComp = sp:GetComponent("script.SpearBurstFadingEffect")
			if isvalid(spComp) then
				spComp.StartAlpha = 0.9
				spComp.EndAlpha = 0.0
				spComp.HoldDuration = 0.2
				spComp.TweenDuration = 0.3
				spComp.StartScale = 1.0
				spComp.EndScale = 1.15
				spComp.OrderInLayerValue = 5
				spComp.ClipRUID = "cb01592c6d3746a2a3ca161044896c15"
			end
			_TimerService:SetTimerOnce(function()
				if isvalid(sp) then sp:Destroy() end
			end, 0.6)
		end
	end

	@ExecSpace("ServerOnly")
	method table FindIceShotTargets(Vector2 fromPos, integer maxCount)
		-- 아이스 샷 대상 선정: 썬더볼트와 동일하게 방향 무관 - 캐릭터 주변(가로 ±4.5, 세로 ±1.5) 안의
		-- 살아있는 script.Monster를 가까운 순으로 최대 maxCount(10)명까지 반환한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 4.5 and math.abs(dy) <= 1.5 then
					table.insert(candidates, { entity = mc.Entity, dist = math.abs(dx) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method Entity FindShotAimTarget(Vector2 fromPos, number dirX)
		-- (파이어 샷 / 아이스 샷 공용) 탄환 한 발이 조준할 대상 하나를 고른다. 캐릭터가 바라보는 쪽
		-- (dirX 방향)에 있는 대상 중 가장 가까운 하나 - 바라보는 쪽에 아무도 없으면 nil을 돌려준다
		-- (뒤쪽 몬스터를 조준해 탄환이 등 뒤로 날아가면 활 쏘는 모션과 어긋나기 때문).
		local candidates = self:FindIceShotTargets(fromPos, 10)
		for _, ent in ipairs(candidates) do
			if isvalid(ent) then
				local dx = ent.TransformComponent.WorldPosition.x - fromPos.x
				if dx * dirX >= -0.3 then
					return ent
				end
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method table FindShotAreaTargets(Vector2 center, integer maxCount)
		-- (파이어 샷 / 아이스 샷 공용) 탄환이 도착한 지점을 중심으로 화살비가 덮는 범위(가로 ±2.2,
		-- 세로 ±1.5) 안의 살아있는 몬스터를 가까운 순으로 최대 maxCount명 돌려준다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - center.x
				local dy = pos.y - center.y
				if math.abs(dx) <= 2.2 and math.abs(dy) <= 1.5 then
					table.insert(candidates, { entity = mc.Entity, dist = math.abs(dx) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void SpawnIceShotBlankProjectile(number originX, number originY, number dirX)
		-- 조준 대상이 없을 때 앞으로 날아가다 사라지는 시각 전용 탄환(히트 판정 없음).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.iceShotCount = (self._T.iceShotCount or 0) + 1
		local name = "iceshot_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.iceShotCount)
		local proj = _SpawnService:SpawnByModelId("iceshotprojectile", name, Vector3(originX, originY, 0), map)
		if not isvalid(proj) then return end
		---@type IceShotProjectile
		local projComp = proj:GetComponent("script.IceShotProjectile")
		if isvalid(projComp) then
			projComp.LockHit = false
			projComp.FlightTime = 0.5
			projComp:Fire(dirX, 0)
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnFireShotBlankProjectile(number originX, number originY, number dirX)
		-- 파이어 샷 쪽 동일 처리(조준 대상 없음 - 시각 전용 탄환).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.fireShotCount = (self._T.fireShotCount or 0) + 1
		local name = "fireshot_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.fireShotCount)
		local proj = _SpawnService:SpawnByModelId("fireshotprojectile", name, Vector3(originX, originY, 0), map)
		if not isvalid(proj) then return end
		---@type FireShotProjectile
		local projComp = proj:GetComponent("script.FireShotProjectile")
		if isvalid(projComp) then
			projComp.LockHit = false
			projComp.FlightTime = 0.5
			projComp:Fire(dirX, 0)
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnIceShotProjectile(Entity target, number originX, number originY)
		-- 대상 하나에게 날아갈 얼음 화살을 스폰한다. 화살은 시각 연출 + x좌표 교차 감지 담당이고,
		-- 데미지/빙결은 도착 순간 화살이 호출하는 DealIceShotHit가 처리한다(스트레이프와 동일 구조).
		if not isvalid(target) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local tp = target.TransformComponent.WorldPosition
		local ty = tp.y
		local thc = target.HitComponent
		if isvalid(thc) then ty = ty + thc.ColliderOffset.y end
		local ddx = tp.x - originX
		local ddy = ty - originY
		local dist = math.sqrt(ddx * ddx + ddy * ddy)
		if dist < 0.0001 then dist = 0.0001 end

		self._T.iceShotCount = (self._T.iceShotCount or 0) + 1
		local name = "iceshot_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.iceShotCount)
		local proj = _SpawnService:SpawnByModelId("iceshotprojectile", name, Vector3(originX, originY, 0), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] IceShot 발사체 스폰 실패")
			return
		end
		---@type IceShotProjectile
		local projComp = proj:GetComponent("script.IceShotProjectile")
		if isvalid(projComp) then
			projComp.LockHit = true
			projComp.TargetX = tp.x
			projComp.TargetEntity = target
			projComp.OwnerEntity = self.Entity
			projComp:Fire(ddx / dist, ddy / dist)
		end
		log("[IceShot] 화살 발사 -> " .. tostring(target.Name) .. " dir=(" .. string.format("%.2f", ddx / dist) .. "," .. string.format("%.2f", ddy / dist) .. ")")
	end

	@ExecSpace("Server")
	method void DealIceShotHit(Entity anchor)
		-- 탄환 한 발이 도착한 지점 기준 광역 확정 히트. (원본 영상) 화살비가 쏟아지는 그 범위 안의
		-- 대상 최대 10명이 각각 한 번씩 맞는다 - 대상마다 진짜 Attack() 판정(단일 대상 게이트)으로
		-- 전투력의 500%~700% 피해(엔진 자동 데미지 표시 1줄) + 얼음 결정 이펙트 + 3초 빙결.
		if not isvalid(anchor) then return end
		local center = anchor.TransformComponent.WorldPosition
		local victims = self:FindShotAreaTargets(Vector2(center.x, center.y), 10)
		local hitCount = 0
		for _, victim in ipairs(victims) do
			if isvalid(victim) then
				self._T.iceShotCurrentTarget = victim
				---@type Monster
				local monsterComp = victim:GetComponent("script.Monster")
				local pos = victim.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
				self:Attack(shape, "skill.iceshot", CollisionGroups.HitBox)
				self._T.iceShotCurrentTarget = nil
				hitCount = hitCount + 1
				self:SpawnIceShotHitEffect(victim)
				-- (요청) 빙결 시간을 2초 늘려 5초간 몬스터가 못 움직인다 - 차지 블로우 얼음 빙결(파란 틴트 +
				-- 모션 정지 + AI/이동 정지)을 그대로 재사용하되 지속시간만 5초로 넘긴다. 죽었다면 걸지 않는다.
				if isvalid(monsterComp) and not monsterComp.IsDead then
					-- (요청) 빙결 지속시간 통일: 5초 → 4초.
					self:ApplyChargeBlowFreeze(victim, 4.0)
				end
			end
		end
		self:SpawnArrowRain(center.x, center.y, false)
		-- (요청) 파이어 샷의 낙하 파편(ember)과 똑같은 매커니즘으로 얼음 조각도 떨군다.
		self:SpawnIceShotFallingShards(center.x, center.y)
		self:PlayIceShotHitSound(self.Entity)
		log("[IceShot] DealIceShotHit 광역 " .. tostring(hitCount) .. "명 at ("
			.. string.format("%.2f", center.x) .. ", " .. string.format("%.2f", center.y) .. ")")
	end

	@ExecSpace("Multicast")
	method void PlayIceShotHitSound(Entity attacker)
		-- 아이스 샷 히트음(화살류 공용 히트음 재사용).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("eb49560ca2a84e0585e0e83cd61c9dc6", 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnIceShotFallingShards(number cx, number cy)
		-- (요청) 아이스 샷도 파이어 샷의 낙하 파편(ember)과 똑같은 매커니즘으로 얼음 조각을 떨군다.
		-- 아트는 얼음 화살(arrow1~9, = 화살비와 같은 프레임)을 그대로 쓰되 작게(파편 느낌) 만든다.
		-- 화살비(4발)와 별개로 10개를 0~0.3초에 걸쳐 왼쪽아래 대각선으로 흩뿌린다(연출 전용 - 판정 없음).
		-- 낙하는 파이어 ember와 동일한 규격: 속도(원래 5~8의 33%=1.65~2.64), 수명 1.08초(10% 빨리 소멸),
		-- 대각선 -0.8, 시전 방향 30% 앞 스폰 오프셋. 프레임 순환/대각선 낙하는 ArrowRainArrow가 담당한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local shardForwardX = (self._T.pendingIceShotDirX or 1) * 1.6 * 0.3
		local shardCount = 10
		for idx = 1, shardCount do
			local spawnDelay = _UtilLogic:RandomDouble() * 0.3
			_TimerService:SetTimerOnce(function()
				self._T.iceShardSeq = (self._T.iceShardSeq or 0) + 1
				local name = "iceshard_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.iceShardSeq)
				local ox = (_UtilLogic:RandomDouble() * 2 - 1) * 1.6
				local shard = _SpawnService:SpawnByModelId("arrowrainarrow", name, Vector3(cx + shardForwardX + ox, cy + 2.5, 0), map)
				if not isvalid(shard) then return end
				---@type ArrowRainArrow
				local comp = shard:GetComponent("script.ArrowRainArrow")
				if isvalid(comp) then
					-- (피드백) 낙하물(얼음 조각) 크기 20% 확대 - 0.5 → 0.6.
					comp.ArrowScale = 0.6
					local mySpeed = (5 + _UtilLogic:RandomDouble() * 3) * 0.33
					comp.Speed = mySpeed
					comp.FallDistance = mySpeed * 1.08
					comp:Fire(-0.8, -1)
				end
			end, spawnDelay)
		end
		log("[IceShot] SpawnIceShotFallingShards at (" .. string.format("%.2f", cx) .. ", " .. string.format("%.2f", cy) .. ") shards=" .. tostring(shardCount))
	end

	@ExecSpace("ServerOnly")
	method void SpawnIceShotHitEffect(Entity target)
		-- 맞은 대상 몸에서 자라났다 부서지는 얼음 결정(hit1~6, 0.12초 간격). 프레임마다 세로 크기가
		-- 크게 달라(80px -> 187px) 그냥 중앙 배치하면 밑동이 파고들어서, UseFrameLocalPos로 각 프레임의
		-- "눈에 보이는 하단"을 대상 발밑에 고정한 채 위로만 자라게 한다(밑동 고정 - 프레임 높이의 절반을
		-- 로컬 y로 준다).
		if not isvalid(target) then return end
		local frames = {
			{ ruid = "fc4f1fba7c57461380a634feda24aa5c", y = 0.40 },
			{ ruid = "9963f5ab73474e2786259878ef66f3f6", y = 0.40 },
			{ ruid = "26cbc52d8d444032b20fea7af775fd3b", y = 0.40 },
			{ ruid = "34097d531f564cce9ed75b6a531e8f60", y = 0.56 },
			{ ruid = "76ee3683807148dda4bc742ad5279633", y = 0.68 },
			{ ruid = "0b76f710f9df4baebf5c92d0281ce92b", y = 0.94 },
		}
		self._T.iceShotHitFxSeq = (self._T.iceShotHitFxSeq or 0) + 1
		local fxName = "IceShotHitFx_" .. tostring(target.Name) .. "_" .. tostring(self._T.iceShotHitFxSeq)
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", fxName, Vector3(0, frames[1].y, 0), target)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		---@type SpearBurstFadingEffect
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.StartAlpha = 1.0
			comp.EndAlpha = 0.0
			-- 6프레임(0.12초 간격 = 0.72초)을 다 보여준 뒤 페이드가 시작되도록 잡는다.
			comp.HoldDuration = 0.75
			comp.TweenDuration = 0.2
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.OrderInLayerValue = 5
			comp.UseFrameLocalPos = true
			comp.FrameLocalPos = Vector2(0, frames[1].y)
			comp.ClipRUID = frames[1].ruid
		end
		for i = 2, 6 do
			local idx = i
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then
					comp.ClipRUID = frames[idx].ruid
					comp.FrameLocalPos = Vector2(0, frames[idx].y)
				end
			end, 0.12 * (idx - 1))
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 1.1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnArrowRain(number px, number py, boolean isFire)
		-- (파이어 샷 / 아이스 샷 공용) 탄환이 도착한 자리에 위에서 화살이 쏟아진다. 연출 전용이라
		-- 데미지 판정은 없다 - 피해/빙결은 DealFireShotHit / DealIceShotHit가 이미 한 번만 처리한다.
		-- 화살 아트는 아이스 샷 원본 리소스의 9프레임 화살이고, 파이어 샷은 붉게 틴트해 불화살로 쓴다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		-- 원본 영상처럼 우상단 -> 좌하단으로 비스듬히 꽂히는 화살이 도착지점 가로 ±1.55에 흩뿌려진다.
		-- (요청) 개수는 6 -> 4발(약 30% 감소), 위치/생성시간/속도를 전부 랜덤하게 낸다.
		local arrowCount = 4
		local dropHeight = 2.4
		local slantX = -0.8
		-- 착지점 바로 위가 아니라, 기울어진 만큼 반대편(오른쪽 위)에서 출발해야 착지점에 꽂힌다.
		local startOffsetX = -slantX * dropHeight
		local travel = dropHeight * math.sqrt(slantX * slantX + 1)
		for i = 1, arrowCount do
			-- 랜덤 위치(±1.55), 랜덤 속도(2~4에서 10% 상향 = 2.2~4.4), 랜덤 생성 시간(0~0.35초).
			local myOx = (_UtilLogic:RandomDouble() * 2 - 1) * 1.55
			local mySpeed = (2.0 + _UtilLogic:RandomDouble() * 2.0) * 1.1
			local myDelay = _UtilLogic:RandomDouble() * 0.35
			_TimerService:SetTimerOnce(function()
				self._T.arrowRainSeq = (self._T.arrowRainSeq or 0) + 1
				local name = "arrowrain_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.arrowRainSeq)
				local spawnPos = Vector3(px + myOx + startOffsetX, py + dropHeight, 0)
				local arrow = _SpawnService:SpawnByModelId("arrowrainarrow", name, spawnPos, map)
				if not isvalid(arrow) then
					log_warning("[ArrowRain] 화살비 스폰 실패")
					return
				end
				---@type ArrowRainArrow
				local comp = arrow:GetComponent("script.ArrowRainArrow")
				if isvalid(comp) then
					-- (요청) 10% 더 빨리 사라지도록 낙하 거리를 90%로 줄인다.
					comp.FallDistance = travel * 0.9
					comp.Speed = mySpeed
					if isFire then
						comp.TintR = 1.0
						comp.TintG = 0.45
						comp.TintB = 0.25
					else
						-- (요청) 아이스 샷 얼음 화살비만 크기 1.3배(기본 0.85 -> 1.105). Fire()가 ArrowScale를
						-- 읽어 Scale에 반영하므로 Fire 호출 전에 설정한다.
						comp.ArrowScale = 0.85 * 1.3
					end
					comp:Fire(slantX, -1)
				end
			end, myDelay)
		end
		log("[ArrowRain] " .. (isFire and "fire" or "ice") .. " 화살비 " .. tostring(arrowCount) .. "발 at ("
			.. string.format("%.2f", px) .. ", " .. string.format("%.2f", py) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void AttackArcherSupport(number combatPower)
		-- 궁병 지원(3차, 2026-07-28): 30초 동안 유저의 등 뒤 먼 곳(화면 밖)에서 아이스 샷/파이어 샷 화살이
		-- 몬스터를 향해 총 15발(2초 간격, 얼음/불 교차) 날아온다. 화살이 꽂히면 아이스 샷 / 파이어 샷처럼
		-- 그 일대를 속성 공격한다 - 범위 안 최대 6명이 각각 전투력의 200~300% 피해 + 속성 연출.
		-- 화살 비주얼은 화살비 공용 ArrowRainArrow(9프레임 얼음 화살, 불은 붉은 틴트)를 재사용한다.
		-- 재시전은 SkillManager의 2분 쿨타임이 막아주지만, 만약을 위해 토큰으로 이전 시전 예약을 무효화한다.
		self._T.pendingArcherSupportCombatPower = combatPower
		self._T.archerSupportToken = (self._T.archerSupportToken or 0) + 1
		local myToken = self._T.archerSupportToken
		-- (요청) 발수 15 → 30발(2배). 발사 시각도 균등 2초 간격이 아니라 랜덤으로 흩뿌려 지원 사격이
		-- 기계적으로 째깍거리지 않게 한다 - 30초를 30칸으로 나눈 뒤 각 칸 안에서 다시 랜덤(칸 이탈 없이
		-- 전체가 고르게 퍼지면서도 간격은 매번 달라진다).
		local SHOT_COUNT = 30
		local DURATION = 30.0
		local SLOT = DURATION / SHOT_COUNT
		for i = 1, SHOT_COUNT do
			local isFire = (i % 2 == 0)
			local fireAt = 0.3 + (i - 1) * SLOT + _UtilLogic:RandomDouble() * SLOT
			_TimerService:SetTimerOnce(function()
				if self._T.archerSupportToken ~= myToken then return end
				if not isvalid(self.Entity) then return end
				self:FireArcherSupportArrow(isFire)
			end, fireAt)
		end
		log("PlayerAttack: 궁병 지원 시작 - 30초간 지원 사격 30발(랜덤 간격) combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("ServerOnly")
	method void FireArcherSupportArrow(boolean isFire)
		-- 지원 화살 1발: 살아있는 몬스터 중 시전자 기준 넓은 범위(가로 ±10, 세로 ±5) 안에서 무작위 하나를 골라
		-- (요청) 유저의 "뒤쪽 약간 위" - 화면 밖 보이지 않는 먼 곳에서 그 몬스터를 향해 날아온다.
		-- 도착하면 그 자리에 아이스 샷 / 파이어 샷과 같은 범위 속성 공격이 터진다(DealArcherSupportHit).
		-- 몬스터가 없으면 이번 발은 생략.
		if not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local myPos = self.Entity.TransformComponent.WorldPosition
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		-- (요청) 조준 범위 확대 - 예전엔 "가장 가까운 6마리" 중에서만 골라 시전자 발밑에만 쏟아졌다.
		-- 이제 캐릭터 기준 가로 ±10 / 세로 ±5(PC 화면 12.8×7.2보다 넓은 범위) 안의 몬스터 전체를
		-- 후보로 두고 그 중 무작위로 고른다. 범위 안에 아무도 없으면 가까운 순 12마리로 폴백한다.
		local RANGE_X = 10.0
		local RANGE_Y = 5.0
		local inRange = {}
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead and mc.Entity.Enable then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - myPos.x
				local dy = pos.y - myPos.y
				table.insert(candidates, { entity = mc.Entity, dist = math.sqrt(dx * dx + dy * dy) })
				if math.abs(dx) <= RANGE_X and math.abs(dy) <= RANGE_Y then
					table.insert(inRange, mc.Entity)
				end
			end
		end
		if #candidates == 0 then
			log("[ArcherSupport] 대상 없음 - 이번 발 생략")
			return
		end
		local target = nil
		if #inRange > 0 then
			target = inRange[1 + math.floor(_UtilLogic:RandomDouble() * #inRange)]
		else
			table.sort(candidates, function(a, b) return a.dist < b.dist end)
			local pickMax = math.min(#candidates, 12)
			target = candidates[1 + math.floor(_UtilLogic:RandomDouble() * pickMax)].entity
		end
		if not isvalid(target) then return end
		local tp = target.TransformComponent.WorldPosition

		-- (요청) 발사 원점 = 유저 등 뒤 먼 곳(가로 16유닛, PC 화면 폭 12.8의 절반보다 훨씬 밖) + 약간 위(5유닛).
		-- 좌우로 조금씩 흩어져 매번 같은 선을 그리지 않게 한다.
		local playerCtrl = self.Entity.PlayerControllerComponent
		local lookDirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		local backX = -lookDirX * (16.0 + _UtilLogic:RandomDouble() * 2.0)
		local startPos = Vector3(myPos.x + backX, myPos.y + 5.0 + _UtilLogic:RandomDouble() * 1.0, 0)
		local aimY = tp.y + 0.5
		local dx = tp.x - startPos.x
		local dy = aimY - startPos.y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < 0.0001 then dist = 0.0001 end

		self._T.archerArrowSeq = (self._T.archerArrowSeq or 0) + 1
		local arrow = _SpawnService:SpawnByModelId("arrowrainarrow", "archersupport_" .. tostring(self._T.archerArrowSeq), startPos, map)
		if not isvalid(arrow) then
			log_warning("[ArcherSupport] 화살 스폰 실패")
			return
		end
		---@type ArrowRainArrow
		local comp = arrow:GetComponent("script.ArrowRainArrow")
		-- 먼 곳에서 오므로 화살비(2~4)보다 빠르게 날린다. (요청) 속도를 이전(22)의 2/3로 낮춤.
		local ARROW_SPEED = 22.0 * (2.0 / 3.0)
		if isvalid(comp) then
			comp.Speed = ARROW_SPEED
			comp.FallDistance = dist       -- 대상 위치에서 정확히 사라지게
			comp.ArrowScale = 1.0
			if isFire then
				comp.TintR = 1.0
				comp.TintG = 0.45
				comp.TintB = 0.25
			end
			comp:Fire(dx, dy)
		end

		-- 화살이 도착하는 시점에 그 자리에서 범위 속성 공격이 터진다.
		_TimerService:SetTimerOnce(function()
			local cx, cy = tp.x, tp.y
			if isvalid(target) then
				local nowPos = target.TransformComponent.WorldPosition
				cx, cy = nowPos.x, nowPos.y
			end
			self:DealArcherSupportHit(cx, cy, isFire)
		end, dist / ARROW_SPEED)
		log("[ArcherSupport] " .. (isFire and "불" or "얼음") .. " 화살 ← 등 뒤 ("
			.. string.format("%.1f", startPos.x) .. ", " .. string.format("%.1f", startPos.y) .. ") → ("
			.. string.format("%.1f", tp.x) .. ", " .. string.format("%.1f", tp.y) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void DealArcherSupportHit(number cx, number cy, boolean isFire)
		-- (요청) 지원 화살은 한 명만 때리는 게 아니라, 꽂힌 자리 일대를 속성 공격한다 - 아이스 샷 /
		-- 파이어 샷의 광역 히트를 그대로 축소 재사용한다. 범위(FindShotAreaTargets: 가로 ±2.2, 세로 ±1.5)
		-- 안의 몬스터 최대 6명이 각각 한 번씩 전투력의 200~300% 피해를 받고, 속성별 연출 + 상태이상이 붙는다.
		--   얼음 화살 → 얼음 결정 + 착탄점 얼음 파편 낙하 + 4초 빙결(아이스 샷 본체와 동일)
		--   불 화살   → 화염 폭발 + 착탄점 바닥 불길 + 20% 확률 화상(파이어 샷 본체와 동일)
		-- (요청 반영) 처음에는 상태이상을 뺐었는데 "속성 효과가 안 들어온다"는 피드백으로 본체와 동일하게 맞춤.
		local victims = self:FindShotAreaTargets(Vector2(cx, cy), 6)
		local hitCount = 0
		for _, victim in ipairs(victims) do
			if isvalid(victim) then
				self._T.archerSupportCurrentTarget = victim
				local pos = victim.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
				self:AttackShadowSafe(shape, "skill.archersupport", victim)
				self._T.archerSupportCurrentTarget = nil
				hitCount = hitCount + 1
				---@type Monster
				local monsterComp = victim:GetComponent("script.Monster")
				if isFire then
					self:PlayFireShotHitBurst(victim)
					-- 불 속성: 파이어 샷과 같은 20% 확률 화상.
					if _UtilLogic:RandomDouble() < 0.2 then
						self:ApplyElementalBurn(victim, self._T.pendingArcherSupportCombatPower or 0)
					end
				else
					self:SpawnIceShotHitEffect(victim)
					-- 얼음 속성: 아이스 샷과 같은 4초 빙결(푸른 물듦 + 이동속도 50%). 죽었으면 걸지 않는다.
					if isvalid(monsterComp) and not monsterComp.IsDead then
						self:ApplyChargeBlowFreeze(victim, 4.0)
					end
				end
			end
		end
		-- 착탄점 연출은 속성당 한 번만.
		if isFire then
			self:SpawnFireShotGroundFire(cx, cy)
		else
			self:SpawnIceShotFallingShards(cx, cy)
		end
		self:PlayIceShotHitSound(self.Entity)
		log("[ArcherSupport] " .. (isFire and "불" or "얼음") .. " 착탄 광역 " .. tostring(hitCount) .. "명 at ("
			.. string.format("%.2f", cx) .. ", " .. string.format("%.2f", cy) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void AttackFireShot(number combatPower, number atkMultiplier)
		-- 파이어 샷(3차): 아이스 샷과 같은 구조 - 몸쪽 화염 폭발 시전 이펙트와 함께 정면으로 탄환(ball)을
		-- 딱 한 발 쏜다. 탄환이 도착한 지점에서 불화살비가 쏟아지고, 그 범위 안의 몬스터 최대 10명이 각각
		-- 한 번씩 전투력의 500%~700% 피해 + 화염 히트 이펙트를 받으며, 바닥을 따라 불길이 번지고(원본 팩
		-- tile 클립) 불꽃 파편이 흩어진다(special 클립).
		-- 리소스는 전부 원본 팩 skill/800033.img/skill/80003324의 애니메이션클립을 그대로 쓴다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		self._T.pendingFireShotDirX = dirX
		-- 확정 히트 데미지 공식(CalcDamageBase의 skill.fireshot 분기)이 읽는 전투력을 미리 걸어둔다.
		self._T.pendingFireShotCombatPower = combatPower

		-- 시전 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다(첫-시전-캡처 + 토큰 가드 패턴).
		if not self._T.isFireShotMovementLocked then
			self._T.pendingFireShotWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isFireShotMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.fireShotMoveLockToken = (self._T.fireShotMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.fireShotMoveLockToken

		self:PlayFireShotMotion(self.Entity, "shoot1", dirX, atkMultiplier)
		self:PlayFireShotCastEffect(self.Entity, dirX)
		_TimerService:SetTimerOnce(function()
			-- (원본 영상 반영) 아이스 샷과 완전히 같은 구조 - 탄환은 딱 한 발, 도착지점에서 광역 히트 +
			-- 화살비 + 바닥 불길이 터진다. 조준/탐색 헬퍼도 아이스 샷과 공용으로 쓴다.
			local myPos = self.Entity.TransformComponent.WorldPosition
			local originX, originY = myPos.x, myPos.y + 0.35
			local aim = self:FindShotAimTarget(Vector2(originX, originY), dirX)
			if isvalid(aim) then
				self:SpawnFireShotProjectile(aim, originX, originY)
			else
				self:SpawnFireShotBlankProjectile(originX, originY, dirX)
				log("[FireShot] 조준 대상 없음 - 시각 전용 탄환 발사")
			end
		end, 0.4 * atkMultiplier)
		-- 이동 잠금은 스킬 재사용 대기시간(SkillManager의 1.0*atkMultiplier 쿨다운)과 동일하게 유지한다.
		_TimerService:SetTimerOnce(function()
			self:RestoreFireShotControl(myMoveLockToken)
		end, 1.0 * atkMultiplier)
	end

	@ExecSpace("Multicast")
	method void PlayFireShotMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 파이어 샷 전용 활 쏘는 모션 재생. 다른 화살 스킬과 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isFireShotDirectionLocked = true
		self._T.lockedFireShotDirX = dirX
		self._T.lockedFireShotMotionName = motionName
		self._T.isFireShotMotionPlaying = true
		self._T.fireShotLockToken = (self._T.fireShotLockToken or 0) + 1
		local myFireShotLockToken = self._T.fireShotLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		self._T.lockedFireShotPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[FireShot] PlayFireShotMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isFireShotMotionPlaying = false
		end, 0.55 * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.fireShotLockToken ~= myFireShotLockToken then return end
			self._T.isFireShotDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 1.0 * mult)
	end

	@ExecSpace("Multicast")
	method void PlayFireShotCastEffect(Entity attacker, number dirX)
		-- 원본 팩의 effect(몸쪽 화염 폭발, 애니메이션클립)를 캐릭터 몸에서 1회 재생한다 + 화살류 공용
		-- 시전음. 원본 아트는 왼쪽 발사 기준이라 오른쪽을 볼 때 FlipX.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local castOptions = { ["FlipX"] = dirX > 0 }
		-- (요청) 시전 화염 폭발을 아래로 내려 캐릭터 몸쪽에서 나오도록 한다(y 0.35 -> 0.0).
		local serial = _EffectService:PlayEffectAttached("bde5b9e6e2c2462ab596f0f287b06c62", attacker, Vector3(0, 0.0, 0), 0, Vector3(1, 1, 1), false, castOptions)
		_SoundService:PlaySound("7d5ef2c392a34251990a9dc8b51deb12", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.5)
	end

	@ExecSpace("Server")
	method void RestoreFireShotControl(integer moveLockToken)
		-- 시전이 끝나 컨트롤러를 되돌린다(토큰 가드 - 홀드 지속발동 중 잠금 고착 방지).
		if self._T.fireShotMoveLockToken ~= moveLockToken then return end
		self._T.isFireShotMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingFireShotWasControllerEnabled then
			playerCtrl.Enable = true
		end
		self:PlayBreather(self.Entity, self._T.pendingFireShotDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnFireShotProjectile(Entity target, number originX, number originY)
		-- 대상 하나에게 날아갈 화염 탄환을 스폰한다. 탄환은 시각 연출 + x좌표 교차 감지 담당이고,
		-- 데미지/이펙트는 도착 순간 탄환이 호출하는 DealFireShotHit가 처리한다(아이스 샷과 동일 구조).
		if not isvalid(target) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local tp = target.TransformComponent.WorldPosition
		local ty = tp.y
		local thc = target.HitComponent
		if isvalid(thc) then ty = ty + thc.ColliderOffset.y end
		local ddx = tp.x - originX
		local ddy = ty - originY
		local dist = math.sqrt(ddx * ddx + ddy * ddy)
		if dist < 0.0001 then dist = 0.0001 end

		self._T.fireShotCount = (self._T.fireShotCount or 0) + 1
		local name = "fireshot_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.fireShotCount)
		local proj = _SpawnService:SpawnByModelId("fireshotprojectile", name, Vector3(originX, originY, 0), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] FireShot 발사체 스폰 실패")
			return
		end
		---@type FireShotProjectile
		local projComp = proj:GetComponent("script.FireShotProjectile")
		if isvalid(projComp) then
			projComp.LockHit = true
			projComp.TargetX = tp.x
			projComp.TargetEntity = target
			projComp.OwnerEntity = self.Entity
			projComp:Fire(ddx / dist, ddy / dist)
		end
		log("[FireShot] 탄환 발사 -> " .. tostring(target.Name) .. " dir=(" .. string.format("%.2f", ddx / dist) .. "," .. string.format("%.2f", ddy / dist) .. ")")
	end

	@ExecSpace("Server")
	method void DealFireShotHit(Entity anchor)
		-- 아이스 샷과 완전히 같은 구조의 광역 확정 히트. 탄환 한 발이 도착한 지점 주변 대상 최대
		-- 10명이 각각 한 번씩 전투력의 500%~700% 피해를 받고, 대상마다 화염 히트 이펙트 + 바닥 불길 +
		-- 불꽃 파편이 남는다(영상의 "불이 바닥을 타고 번지는" 연출).
		if not isvalid(anchor) then return end
		local center = anchor.TransformComponent.WorldPosition
		local victims = self:FindShotAreaTargets(Vector2(center.x, center.y), 10)
		local hitCount = 0
		for _, victim in ipairs(victims) do
			if isvalid(victim) then
				self._T.fireShotCurrentTarget = victim
				local pos = victim.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
				self:Attack(shape, "skill.fireshot", CollisionGroups.HitBox)
				self._T.fireShotCurrentTarget = nil
				hitCount = hitCount + 1
				-- 대상 몸의 화염 폭발(hit/0)은 맞은 각 대상에 붙인다.
				self:PlayFireShotHitBurst(victim)
				-- (요청) 불 속성 스킬 화상 - 파이어 샷은 20% 확률.
				if _UtilLogic:RandomDouble() < 0.2 then
					self:ApplyElementalBurn(victim, self._T.pendingFireShotCombatPower or 0)
				end
			end
		end
		-- 바닥 불길(tile 12개) + 떨어지는 불꽃 파편(special 15개)은 도착지점 한 곳에서 한 번만 낸다.
		self:SpawnFireShotGroundFire(center.x, center.y)
		self:SpawnArrowRain(center.x, center.y, true)
		self:PlayIceShotHitSound(self.Entity)
		log("[FireShot] DealFireShotHit 광역 " .. tostring(hitCount) .. "명 at ("
			.. string.format("%.2f", center.x) .. ", " .. string.format("%.2f", center.y) .. ")")
	end

	@ExecSpace("Multicast")
	method void PlayFireShotHitBurst(Entity target)
		-- 맞은 대상 몸에서 터지는 화염 폭발(hit/0, 원본 팩 애니메이션클립). 대상에 부착해 1회 재생.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local offsetY = 0.3
		local hitComp = target.HitComponent
		if isvalid(hitComp) then offsetY = hitComp.ColliderOffset.y end
		local serial = _EffectService:PlayEffectAttached("ed57488f3abb468798b5cb8921464341", target, Vector3(0, offsetY, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 5 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnFireShotGroundFire(number cx, number cy)
		-- (원본 영상 반영) 도착지점 바닥에 두 종류의 불을 낸다.
		--  · tile/0~2 - 바닥을 타고 번지는 불길. 3종류를 4개씩(총 12개) 도착지점 가로폭에 깔고, 각 조각은
		--    약 3번 반복 재생(≈1.2초)한 뒤 8~12프레임(0.8~1.2초)에 걸쳐 서서히 사라진다.
		--    → 반복 재생 + 프레임 페이드는 SpearBurstFadingEffect(클립 루프 + Hold 뒤 알파 트윈)로 낸다.
		--  · special/0~2 - 위에서 떨어지는 불꽃 파편. 3종류를 5개씩(총 15개) 0~0.3초에 걸쳐 흩뿌리고,
		--    5~8 사이의 서로 다른 속도로 내려오다 12프레임(≈1.2초)에 사라진다(FireShotEmberEffect).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local tiles = { "0279ebbf02fc42ee8d47b720ab35aef3", "5929523d735c4e848c3ab4f8b465bc8c", "9aa52c525f7c4eaeb71c096cfd405db3" }
		local specials = { "ba5335861bac490bb376c6279d8afdbe", "c7438da1d66e49c4bbbd2fb9379377d6", "5e48242e94c6463c8601119e8f263b3c" }

		-- 바닥 불길 12개: 3종류를 번갈아 배정한다. 크기 0.7, 간격 0.238에서 (요청) 각각 10% 상향
		-- (간격 0.238 -> 0.262, 크기 0.7 -> 0.77).
		for slot = 1, 12 do
			local ox = (slot - 6.5) * 0.262
			local clip = tiles[((slot - 1) % 3) + 1]
			self._T.fireGroundSeq = (self._T.fireGroundSeq or 0) + 1
			local name = "firetile_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.fireGroundSeq)
			local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", name, Vector3(cx + ox, cy + 0.15, 0), map)
			if isvalid(fx) then
				fx:AddComponent("script.SpearBurstFadingEffect")
				---@type SpearBurstFadingEffect
				local comp = fx:GetComponent("script.SpearBurstFadingEffect")
				if isvalid(comp) then
					comp.StartAlpha = 1.0
					comp.EndAlpha = 0.0
					-- 8프레임(0.8초)까지 꽉 찬 상태로 반복 재생 → 8~12프레임(0.4초)에 걸쳐 페이드아웃.
					comp.HoldDuration = 0.8
					comp.TweenDuration = 0.4
					comp.StartScale = 0.77
					comp.EndScale = 0.77
					comp.OrderInLayerValue = 4
					comp.ClipRUID = clip
				end
				_TimerService:SetTimerOnce(function()
					if isvalid(fx) then fx:Destroy() end
				end, 1.3)
			end
		end

		-- 떨어지는 불꽃 파편: 0~0.3초에 걸쳐 흩뿌린다. (요청) 개수는 15 -> 10개(약 30% 감소).
		-- (요청) 생성 위치를 x축으로 바라보는 방향 30% 앞에 둔다(가로 흩뿌림 폭 1.6의 30% = 0.48).
		local emberForwardX = (self._T.pendingFireShotDirX or 1) * 1.6 * 0.3
		local emberCount = 10
		for idx = 1, emberCount do
			local myIdx = idx
			local clip = specials[((idx - 1) % 3) + 1]
			local spawnDelay = _UtilLogic:RandomDouble() * 0.3
			_TimerService:SetTimerOnce(function()
				self._T.fireEmberSeq = (self._T.fireEmberSeq or 0) + 1
				local name = "fireember_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.fireEmberSeq)
				local ox = (_UtilLogic:RandomDouble() * 2 - 1) * 1.6
				local ember = _SpawnService:SpawnByModelId("fireshotembereffect", name, Vector3(cx + emberForwardX + ox, cy + 2.5, 0), map)
				if isvalid(ember) then
					---@type FireShotEmberEffect
					local comp = ember:GetComponent("script.FireShotEmberEffect")
					if isvalid(comp) then
						comp.ClipRUID = clip
						-- 낙하 속도 = 원래(5~8)의 30%(1.5~2.4)에서 다시 10% 상향 = ×0.33(1.65~2.64).
						-- 왼쪽아래 대각선으로 내린다.
						comp.FallSpeed = (5 + _UtilLogic:RandomDouble() * 3) * 0.33
						comp.DriftX = -0.8
						-- (요청) 10% 더 빨리 사라진다: 수명 1.2 -> 1.08, 파괴 타이머 1.3 -> 1.17.
						comp.Lifetime = 1.08
						comp.OrderInLayerValue = 6
					end
					_TimerService:SetTimerOnce(function()
						if isvalid(ember) then ember:Destroy() end
					end, 1.17)
				end
			end, spawnDelay)
		end
		log("[FireShot] SpawnFireShotGroundFire at (" .. string.format("%.2f", cx) .. ", " .. string.format("%.2f", cy) .. ") tiles=12 embers=" .. tostring(emberCount))
	end

	@ExecSpace("ServerOnly")
	method void AttackRapidFire(number combatPower, number atkMultiplier, number rawDirX, number rawDirY)
		-- 속사(2차) 한 발. 연사 간격(0.5초)과 조준 각도 보간은 시전한 클라이언트
		-- (SkillManager.RapidFireTick)이 담당하고, 서버는 넘겨받은 각도로 화살 한 발을 쏘는 것만 맡는다.
		-- 이동 잠금도 클라이언트가 연사가 끝날 때까지 통째로 들고 있으므로 여기서는 건드리지 않는다
		-- (다른 화살 스킬처럼 시전마다 잠갔다 푸는 방식은 0.5초 간격 연사에서 잠금/해제가 엇갈린다).
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local dirX, dirY = rawDirX, rawDirY
		local mag = math.sqrt(dirX * dirX + dirY * dirY)
		if mag > 0.0001 then
			dirX = dirX / mag
			dirY = dirY / mag
		else
			local ctrlForDir = self.Entity.PlayerControllerComponent
			dirX = (isvalid(ctrlForDir) and ctrlForDir.LookDirectionX >= 0) and 1 or -1
			dirY = 0
		end

		-- 순수 상하 조준(dirX가 0에 가까움)일 때는 캐릭터가 보던 좌우 방향을 그대로 유지한다.
		local playerCtrl = self.Entity.PlayerControllerComponent
		local horizDirX
		if math.abs(dirX) > 0.0001 then
			horizDirX = (dirX > 0) and 1 or -1
		else
			horizDirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		end

		-- (버그 수정) 연사 중 이동 잠금은 **서버에서** 걸어야 한다. PlayerControllerComponent.Enable은
		-- 서버가 들고 있는 @Sync 프로퍼티라 클라이언트에서 false를 넣어도 곧 되돌려지고(실측), 그 결과
		-- ↓키가 엔진의 앉기/눕기(ActionCrouch)로 흘러들어가 "아래로 조준하면 캐릭터가 눕는" 문제가 있었다.
		-- 매 발마다 다시 잠그고(이미 false면 그대로), 마지막 발사 1초 뒤에는 토큰 가드로 자동 복구한다 -
		-- 클라이언트의 종료 요청(RequestEndRapidFire)이 유실돼도 조작이 영영 잠기지 않게 하는 안전장치다.
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		self._T.rapidFireCtrlToken = (self._T.rapidFireCtrlToken or 0) + 1
		local myCtrlToken = self._T.rapidFireCtrlToken
		_TimerService:SetTimerOnce(function()
			if self._T.rapidFireCtrlToken ~= myCtrlToken then return end
			self:RestoreRapidFireControl()
		end, 1.0)

		-- (요청) 공격속도 2배 - 발사 간격이 0.25초로 줄었으므로 활 쏘는 모션도 2배 빠르게 재생해야
		-- 한 발 주기 안에 동작이 끝난다. PlayRapidFireMotion은 재생속도를 1/배율로 잡으므로
		-- 배율을 절반으로 넘기면 재생속도가 2배가 된다(브랜디쉬 motionMult와 같은 방식).
		self:PlayRapidFireMotion(self.Entity, "shoot1", horizDirX, atkMultiplier * 0.5)
		self:SpawnRapidFireProjectile(combatPower, dirX, dirY)
	end

	@ExecSpace("ServerOnly")
	method void RestoreRapidFireControl()
		-- 연사가 끝나 이동 잠금을 되돌린다. 키를 뗀 즉시(SkillManager.RequestEndRapidFire)와
		-- 마지막 발사 1초 뒤 안전장치, 두 경로에서 호출되므로 여러 번 불려도 안전해야 한다.
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) then
			playerCtrl.Enable = true
		end
		log("[RapidFire] 이동 잠금 해제")
	end

	@ExecSpace("Multicast")
	method void PlayRapidFireMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 속사 전용 활 쏘는 모션. 더블샷과 동일한 방식이되, 0.5초마다 다시 호출되므로 모션이 끝난 뒤
		-- IDLE로 되돌리는 처리는 넣지 않는다(연사 중에는 다음 발 모션이 곧바로 이어진다).
		-- 연사가 끝난 뒤의 자세 복구는 SkillManager가 EndRapidFire에서 한 번만 처리한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playRate = 1.0 / mult
		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
		end, 0.2 * mult)
	end

	@ExecSpace("ServerOnly")
	method void SpawnRapidFireProjectile(number combatPower, number dirX, number dirY)
		-- 속사 화살 한 발을 맵에 스폰하고 조준 방향으로 발사한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.rapidFireCount = (self._T.rapidFireCount or 0) + 1
		local name = "rapidfire_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.rapidFireCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이에서 날아가도록 y를 올린다(다른 화살 스킬과 동일한 0.35).
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("rapidfireprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] RapidFire 발사체 스폰 실패")
			return
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type RapidFireProjectileAttack
		local projAtk = proj:GetComponent("script.RapidFireProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type RapidFireProjectile
		local projComp = proj:GetComponent("script.RapidFireProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, dirY)
		end
		log("[RapidFire] 화살 발사 dir=(" .. string.format("%.2f", dirX) .. "," .. string.format("%.2f", dirY) .. ") combatPower=" .. tostring(combatPower))
	end

	-- ── 폭풍의 시(4차) ──────────────────────────────────────────────
	-- 키다운 홀드 연사. 발사 간격(0.2초)·종료 판정·방향 전환은 시전한 클라이언트
	-- (SkillManager.HurricaneTick)가 담당하고, 서버는 (1) 홀드 시작/종료/방향전환 시 이펙트와
	-- 반복 사운드를 멀티캐스트하고 (2) 요청이 올 때마다 화살 한 발을 스폰하는 것만 맡는다.
	-- 리소스는 원본 팩 skill/1311.img/skill/13111002: prepare(시전 1회) → keydown(루프),
	-- ball(화살), hit/0(적중), _audio/Use(반복 사용음).

	@ExecSpace("ServerOnly")
	method void BeginHurricane(number dirX)
		-- 홀드 시작 - 모든 클라이언트에 시전 이펙트/반복 사운드 시작을 알리고,
		-- (피드백) 연사 중에도 걸어다닐 수 있도록 이동을 막지 않는 대신 이동속도를 60%로 낮춘다.
		-- 플레이어 속도는 서버 소유 MovementComponent.InputSpeed로만 조절된다(러시/헤이스트와 동일 규칙).
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then return end
		local mv = self.Entity.MovementComponent
		if isvalid(mv) and self._T.hurricaneSlowed ~= true then
			self._T.hurricanePrevSpeed = mv.InputSpeed
			mv.InputSpeed = mv.InputSpeed * 0.6
			self._T.hurricaneSlowed = true
			log("[Hurricane] 이동속도 60% 적용 " .. string.format("%.2f", self._T.hurricanePrevSpeed) .. " → " .. string.format("%.2f", mv.InputSpeed))
		end
		self:StartHurricaneVisuals(self.Entity, dirX)
		log("[Hurricane] 홀드 시작 dirX=" .. tostring(dirX))
	end

	@ExecSpace("ServerOnly")
	method void RestoreHurricaneSpeed()
		-- 연사가 끝나 이동속도를 원래대로 되돌린다. 종료 요청과 토큰 자동복구 두 경로에서
		-- 호출되므로 여러 번 불려도 안전해야 한다(hurricaneSlowed 플래그로 1회만 복원).
		if self._T.hurricaneSlowed ~= true then return end
		self._T.hurricaneSlowed = false
		local mv = self.Entity.MovementComponent
		if isvalid(mv) then
			mv.InputSpeed = self._T.hurricanePrevSpeed or (mv.InputSpeed / 0.6)
			log("[Hurricane] 이동속도 복원 → " .. string.format("%.2f", mv.InputSpeed))
		end
	end

	@ExecSpace("ServerOnly")
	method void FlipHurricane(number dirX)
		-- 연사 중 좌/우 방향 전환 - 붙어있는 이펙트를 새 방향으로 다시 붙인다.
		self:FlipHurricaneVisuals(self.Entity, dirX)
	end

	@ExecSpace("ServerOnly")
	method void EndHurricaneHold()
		-- 연사 종료: 이동속도(60%) 복원 + 이펙트/반복 사운드 정지.
		self:RestoreHurricaneSpeed()
		self:StopHurricaneVisuals(self.Entity)
		log("[Hurricane] 홀드 종료")
	end

	@ExecSpace("ServerOnly")
	method void AttackHurricane(number combatPower, number atkMultiplier, number rawDirX)
		-- 폭풍의 시 한 발. 서버는 넘겨받은 좌/우 방향으로 수평 화살 한 발을 쏘는 것만 맡는다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local dirX = (rawDirX >= 0) and 1 or -1

		-- (피드백) 연사 중에도 걸어다닐 수 있어야 하므로 조작은 잠그지 않는다(속도만 60% - BeginHurricane).
		-- 종료 요청이 유실돼도 이동속도/이펙트/사운드가 영영 남지 않도록, 마지막 발사 1초 뒤
		-- 토큰 가드로 자동 복구한다.
		self._T.hurricaneCtrlToken = (self._T.hurricaneCtrlToken or 0) + 1
		local myCtrlToken = self._T.hurricaneCtrlToken
		_TimerService:SetTimerOnce(function()
			if self._T.hurricaneCtrlToken ~= myCtrlToken then return end
			self:RestoreHurricaneSpeed()
			self:StopHurricaneVisuals(self.Entity)
		end, 1.0)

		-- 활쏘기 모션은 서버가 아니라 시전한 클라이언트(SkillManager.PlayHurricanePose)가 질주 자세와
		-- 같은 Loop 이벤트로 유지한다 - 서버 멀티캐스트 Onetime 모션(속사 방식)은 걷기를 뿌리박아
		-- (피드백) "연사 중 걸어다니기"가 되지 않았다.
		self:SpawnHurricaneProjectile(combatPower, dirX)
	end

	@ExecSpace("ServerOnly")
	method void SpawnHurricaneProjectile(number combatPower, number dirX)
		-- 폭풍의 시 화살 한 발을 맵에 스폰하고 수평으로 발사한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.hurricaneCount = (self._T.hurricaneCount or 0) + 1
		local name = "hurricane_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.hurricaneCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이에서 날아가도록 y를 올린다(다른 화살 스킬과 동일한 0.35).
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("hurricaneprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] Hurricane 발사체 스폰 실패")
			return
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type HurricaneProjectileAttack
		local projAtk = proj:GetComponent("script.HurricaneProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type HurricaneProjectile
		local projComp = proj:GetComponent("script.HurricaneProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, 0)
		end
		log("[Hurricane] 화살 발사 dirX=" .. tostring(dirX) .. " combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("Multicast")
	method void StartHurricaneVisuals(Entity attacker, number dirX)
		-- (요청) 키다운 시 처음에 prepare 이펙트를 1회 재생하고, 그 마지막 프레임부터는 keydown
		-- 이펙트를 반복 재생한다. 사용음도 키를 누르고 있는 동안 계속 반복해서 들린다.
		-- 원본 아트는 왼쪽 발사 기준이라 오른쪽을 볼 때 FlipX(스트레이프 시전 이펙트와 동일).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		self:StopHurricaneVisualsLocal()
		self._T.hurricaneVisualsActive = true
		self._T.hurricaneVisualDirX = dirX
		-- 연사 중에는 기본 무기 이펙트를 숨긴다(속사가 발사마다 토글하던 것을 홀드 단위로 한 번만).
		local ar = attacker.AvatarRendererComponent
		if isvalid(ar) then ar.ShowDefaultWeaponEffects = false end
		local opt = { ["FlipX"] = dirX > 0 }
		-- (피드백) 몸쪽 이펙트 높이: 0.35 → 0.0 → "살짝 올려" 0.15로 확정.
		self._T.hurricanePrepareSerial = _EffectService:PlayEffectAttached(
			"4423619c1a49476697b459e49bddb575", attacker,
			Vector3(0, 0.15, 0), 0, Vector3(1, 1, 1), false, opt
		)
		-- prepare 클립 길이(프레임 Delay 합산)만큼 기다렸다가 keydown 루프를 시작한다.
		local prepDur = self:GetHurricanePrepareDuration()
		self._T.hurricaneLoopToken = (self._T.hurricaneLoopToken or 0) + 1
		local myTok = self._T.hurricaneLoopToken
		_TimerService:SetTimerOnce(function()
			if self._T.hurricaneLoopToken ~= myTok then return end
			if self._T.hurricaneVisualsActive ~= true then return end
			if not isvalid(attacker) then return end
			self._T.hurricaneLoopSerial = _EffectService:PlayEffectAttached(
				"c47d84d453d0493c904046cc1d4ba9f2", attacker,
				Vector3(0, 0.15, 0), 0, Vector3(1, 1, 1), true, { ["FlipX"] = dirX > 0 }
			)
		end, prepDur)
		-- (피드백) "사용 사운드를 3배로 많이" - 기본 루프 재생에 더해 0.35초마다 같은 사운드를
		-- 한 번씩 겹쳐 재생해 연사(0.1초/발)에 맞는 촘촘한 소리를 만든다.
		_SoundService:PlayLoopSound("5be2bfc98ac5406485fd89dac2278ad4", 1.0)
		self._T.hurricaneSndTimerId = _TimerService:SetTimerRepeat(function()
			if self._T.hurricaneVisualsActive ~= true then return end
			_SoundService:PlaySound("5be2bfc98ac5406485fd89dac2278ad4", 1.0)
		end, 0.35)
		log("[Hurricane] 시전 이펙트 시작 prepDur=" .. string.format("%.2f", prepDur) .. " dirX=" .. tostring(dirX))
	end

	@ExecSpace("Multicast")
	method void FlipHurricaneVisuals(Entity attacker, number dirX)
		-- 연사 중 좌/우 방향 전환: prepare는 다시 재생하지 않고, keydown 루프만 새 방향으로 즉시
		-- 다시 붙인다(붙어있는 이펙트의 FlipX는 재생 중에 바꿀 수 없다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		if self._T.hurricaneVisualsActive ~= true then return end
		self._T.hurricaneVisualDirX = dirX
		self._T.hurricaneLoopToken = (self._T.hurricaneLoopToken or 0) + 1
		if self._T.hurricanePrepareSerial ~= nil then
			_EffectService:RemoveEffect(self._T.hurricanePrepareSerial)
			self._T.hurricanePrepareSerial = nil
		end
		if self._T.hurricaneLoopSerial ~= nil then
			_EffectService:RemoveEffect(self._T.hurricaneLoopSerial)
			self._T.hurricaneLoopSerial = nil
		end
		self._T.hurricaneLoopSerial = _EffectService:PlayEffectAttached(
			"c47d84d453d0493c904046cc1d4ba9f2", attacker,
			Vector3(0, 0.0, 0), 0, Vector3(1, 1, 1), true, { ["FlipX"] = dirX > 0 }
		)
	end

	@ExecSpace("Multicast")
	method void StopHurricaneVisuals(Entity attacker)
		-- 홀드 종료 - 붙어있는 이펙트와 반복 사운드를 모두 멈춘다(여러 번 불려도 안전해야 한다).
		if not self:IsClient() then return end
		self:StopHurricaneVisualsLocal()
	end

	@ExecSpace("ClientOnly")
	method void StopHurricaneVisualsLocal()
		-- 클라이언트 로컬 정리: 예약된 루프 시작 타이머 무효화 + 이펙트 제거 + 사운드 정지.
		self._T.hurricaneVisualsActive = false
		self._T.hurricaneLoopToken = (self._T.hurricaneLoopToken or 0) + 1
		if self._T.hurricaneSndTimerId ~= nil then
			_TimerService:ClearTimer(self._T.hurricaneSndTimerId)
			self._T.hurricaneSndTimerId = nil
		end
		local ar = isvalid(self.Entity) and self.Entity.AvatarRendererComponent or nil
		if isvalid(ar) then ar.ShowDefaultWeaponEffects = true end
		if self._T.hurricanePrepareSerial ~= nil then
			_EffectService:RemoveEffect(self._T.hurricanePrepareSerial)
			self._T.hurricanePrepareSerial = nil
		end
		if self._T.hurricaneLoopSerial ~= nil then
			_EffectService:RemoveEffect(self._T.hurricaneLoopSerial)
			self._T.hurricaneLoopSerial = nil
		end
		_SoundService:StopSound("5be2bfc98ac5406485fd89dac2278ad4")
	end

	@ExecSpace("ClientOnly")
	method number GetHurricanePrepareDuration()
		-- prepare 애니메이션클립의 총 길이(초). 프레임별 Delay를 합산하고 한 번 재면 캐시한다.
		if self._T.hurricanePrepDur ~= nil then return self._T.hurricanePrepDur end
		local dur = 0
		local clip = _ResourceService:LoadAnimationClipAndWait("4423619c1a49476697b459e49bddb575")
		if clip ~= nil and clip.Frames ~= nil then
			for _, f in ipairs(clip.Frames:ToTable()) do
				dur = dur + (f.Delay or 0)
			end
		end
		-- 프레임 Delay가 ms 단위(원본 WZ 규격)로 들어오는 경우 초 단위로 보정한다.
		if dur > 5 then dur = dur / 1000 end
		if dur <= 0 then dur = 0.6 end
		self._T.hurricanePrepDur = dur
		log("[Hurricane] prepare 클립 길이=" .. string.format("%.3f", dur) .. "초")
		return dur
	end

	-- ── 스나이핑(4차 차지) ──────────────────────────────────────────
	-- 키를 누르고 있으면 게이지(완충 10초)를 채우고, 떼면 게이지 비율만큼 데미지를 실은
	-- 관통 화살(최대 10명) 한 발을 쏜다. 차지 단계(0~4초/4~7초/7~10초)마다 차지 이펙트/화살/
	-- 슈팅 이펙트가 바뀐다. 게이지 누적/단계 판정/발사는 클라이언트(SkillManager.SnipingTick)가
	-- 담당하고, 서버는 (1) 이동속도 50% 적용/복원, (2) 게이지 바·% 숫자 표시, (3) 이펙트
	-- 멀티캐스트, (4) 발사체 스폰을 맡는다. 리소스는 원본 팩:
	--   1단계 skill/3241000 (effect/ball + 슈팅=hit0), 2단계 skill/3221025, 3단계 skill/3241001,
	--   공용 hit skill/3241002 hit/0, 게이지 ui/basic/keydownbar5/0/full.

	method string GetSnipingChargeRUID(number stage)
		-- 단계별 차지 이펙트(차지 중 5~12프레임 반복, 릴리즈 시 13~끝 재생).
		if stage >= 2 then return "f74015c5accf42e79889e343489f3ed6" end
		if stage >= 1 then return "79037c68813a4d48bf85a27bb1c34b5a" end
		return "0b6df3e081d0484fb9a4aa174f9784a8"
	end

	method string GetSnipingBallRUID(number stage)
		-- 단계별 화살 클립.
		if stage >= 2 then return "eb55ee8b8efe4345aa9c0d480df70939" end
		if stage >= 1 then return "2a51218fa53441b79ac41db6028a8110" end
		return "38f9664abbec45a4b11b05ecc9ebfa02"
	end

	method string GetSnipingShootRUID(number stage)
		-- 단계별 발사(슈팅) 이펙트.
		if stage >= 2 then return "4f091580df214c7dbb846ce850f7f491" end
		if stage >= 1 then return "c834c492754444f3b25046a222863743" end
		return "2d79c1fb547846b4ae6ca7435b88d996"
	end

	@ExecSpace("ServerOnly")
	method void BeginSniping(number dirX)
		-- 차지 시작: 이동속도 50% + 게이지 % 숫자 엔티티 스폰 + 하트비트 감시 + 이펙트 멀티캐스트.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then return end
		local mv = self.Entity.MovementComponent
		if isvalid(mv) and self._T.snipingSlowed ~= true then
			self._T.snipingPrevSpeed = mv.InputSpeed
			mv.InputSpeed = mv.InputSpeed * 0.5
			self._T.snipingSlowed = true
			log("[Sniping] 이동속도 50% 적용 " .. string.format("%.2f", self._T.snipingPrevSpeed) .. " → " .. string.format("%.2f", mv.InputSpeed))
		end
		self:SpawnSnipingGaugeText()
		self._T.snipingHolding = true
		self._T.snipingLastHeartbeat = _UtilLogic.ElapsedSeconds
		-- 클라이언트 하트비트(0.5초 간격)가 2.5초 이상 끊기면 릴리즈/취소 요청이 유실된 것으로 보고
		-- 스스로 정리한다(속도/게이지가 영영 남지 않게 하는 안전장치).
		if self._T.snipingWatchTimerId ~= nil then _TimerService:ClearTimer(self._T.snipingWatchTimerId) end
		self._T.snipingWatchTimerId = _TimerService:SetTimerRepeat(function()
			if self._T.snipingHolding ~= true then return end
			if _UtilLogic.ElapsedSeconds - (self._T.snipingLastHeartbeat or 0) > 2.5 then
				log_warning("[Sniping] 하트비트 유실 - 차지 자동 취소")
				self:CancelSnipingHold()
			end
		end, 1.0)
		self:StartSnipingVisuals(self.Entity, dirX)
		log("[Sniping] 차지 시작 dirX=" .. tostring(dirX))
	end

	@ExecSpace("ServerOnly")
	method void SpawnSnipingGaugeText()
		-- 머리 위 게이지(배경 Bg + 채움 Fill + % 숫자 Pct)를 플레이어 자식으로 스폰한다.
		-- (피드백) keydownbar의 full 클립은 모든 프레임이 꽉 찬 바 그림이라, 같은 아트 2겹으로
		-- 배경(어둡게 틴트)/채움(좌측 고정 스케일)을 만들어 "차오르는" 모습을 표현한다.
		if isvalid(self._T.snipingGaugeText) then return end
		local ent = _SpawnService:SpawnByModelId("snipinggaugetext", "SnipingGauge_" .. tostring(self.Entity.Name), Vector3(0, 1.05, 0), self.Entity)
		if not isvalid(ent) then
			log_warning("[Sniping] 게이지 스폰 실패")
			return
		end
		local bg = ent:GetChildByName("Bg", false)
		if isvalid(bg) and isvalid(bg.SpriteRendererComponent) then
			-- 배경은 같은 바 아트를 어둡게 깔아 "빈 게이지"로 보이게 한다(Color는 @Sync라 서버 지정 OK).
			bg.SpriteRendererComponent.Color = Color(0.25, 0.25, 0.25, 0.8)
		end
		-- % 숫자는 월드 전용 TextRendererComponent를 쓴다 - Text/FontColor가 @Sync라 서버 대입만으로
		-- 모든 클라이언트에 표시된다(TextComponent는 UI 전용이라 월드 엔티티에선 렌더링되지 않았다).
		local pctEnt = ent:GetChildByName("Pct", false)
		if isvalid(pctEnt) and isvalid(pctEnt.TextRendererComponent) then
			pctEnt.TextRendererComponent.FontColor = Color(1, 1, 0.55, 1)
		end
		self._T.snipingGaugeText = ent
		self:UpdateSnipingGaugeFill(0)
		self:UpdateSnipingGaugePctText(0)
	end

	@ExecSpace("ServerOnly")
	method void UpdateSnipingGaugePctText(number pct)
		-- 게이지 오른쪽 % 숫자 갱신(TextRendererComponent.Text는 @Sync).
		local ent = self._T.snipingGaugeText
		if not isvalid(ent) then return end
		local pctEnt = ent:GetChildByName("Pct", false)
		if not isvalid(pctEnt) then return end
		local tr = pctEnt.TextRendererComponent
		if not isvalid(tr) then return end
		tr.Text = tostring(math.floor(pct + 0.5)) .. "%"
	end

	@ExecSpace("ServerOnly")
	method void UpdateSnipingGaugeFill(number pct)
		-- 채움 바: 왼쪽 끝을 고정한 채 가로 스케일을 진행률만큼 늘린다(Transform은 @Sync라 서버 대입 OK).
		-- 바 아트 절반 스케일 기준 반폭 0.35유닛.
		local ent = self._T.snipingGaugeText
		if not isvalid(ent) then return end
		local fill = ent:GetChildByName("Fill", false)
		if not isvalid(fill) then return end
		local ratio = math.max(0, math.min(pct, 100) / 100)
		fill.TransformComponent.Scale = Vector3(0.5 * ratio, 0.5, 1)
		fill.TransformComponent.Position = Vector3(-0.35 * (1 - ratio), 0, 0)
	end

	@ExecSpace("ServerOnly")
	method void SnipingHeartbeat(number charge)
		-- 클라이언트가 0.5초마다 보내는 게이지 값 - % 숫자 갱신 + 하트비트 갱신.
		if self._T.snipingHolding ~= true then return end
		self._T.snipingLastHeartbeat = _UtilLogic.ElapsedSeconds
		local pct = math.floor(math.min(charge or 0, 10.0) / 10.0 * 100 + 0.5)
		self:UpdateSnipingGaugeFill(pct)
		self:UpdateSnipingGaugePctText(pct)
	end


	@ExecSpace("ServerOnly")
	method void SetSnipingStage(number stage, number dirX)
		-- 차지 단계 전환(4초/7초) 또는 좌/우 방향 전환 - 차지 이펙트를 교체한다.
		if self._T.snipingHolding ~= true then return end
		self:SetSnipingStageVisuals(self.Entity, stage, dirX)
	end

	@ExecSpace("ServerOnly")
	method void AttackSniping(number combatPower, number chargeRatio, number rawDirX, number stage)
		-- 릴리즈: 차지 이펙트를 끝까지 재생 + 슈팅 이펙트 + 관통 화살 한 발.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then
			self:CancelSnipingHold()
			return
		end
		local dirX = (rawDirX >= 0) and 1 or -1
		self:FinishSnipingServer()
		self:PlaySnipingReleaseVisuals(self.Entity, stage, dirX)
		self:PlayRapidFireMotion(self.Entity, "shoot1", dirX, 1.0)
		self:SpawnSnipingProjectile(combatPower, chargeRatio, dirX, stage)
	end

	@ExecSpace("ServerOnly")
	method void CancelSnipingHold()
		-- 발사 없이 차지 종료(사망/사다리/다른 스킬/하트비트 유실).
		self:FinishSnipingServer()
		self:StopSnipingVisuals(self.Entity)
		log("[Sniping] 차지 취소")
	end

	@ExecSpace("ServerOnly")
	method void FinishSnipingServer()
		-- 서버쪽 차지 상태 정리(여러 번 호출해도 안전): 속도 복원 + 게이지 텍스트 제거 + 감시 해제.
		self._T.snipingHolding = false
		if self._T.snipingWatchTimerId ~= nil then
			_TimerService:ClearTimer(self._T.snipingWatchTimerId)
			self._T.snipingWatchTimerId = nil
		end
		if isvalid(self._T.snipingGaugeText) then
			self._T.snipingGaugeText:Destroy()
		end
		self._T.snipingGaugeText = nil
		if self._T.snipingSlowed == true then
			self._T.snipingSlowed = false
			local mv = self.Entity.MovementComponent
			if isvalid(mv) then
				mv.InputSpeed = self._T.snipingPrevSpeed or (mv.InputSpeed / 0.5)
				log("[Sniping] 이동속도 복원 → " .. string.format("%.2f", mv.InputSpeed))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnSnipingProjectile(number combatPower, number chargeRatio, number dirX, number stage)
		-- 관통 화살 한 발을 스폰한다. 화살 아트는 단계별 ball 클립으로 갈아끼운다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.snipingCount = (self._T.snipingCount or 0) + 1
		local name = "sniping_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.snipingCount)
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("snipingprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] Sniping 발사체 스폰 실패")
			return
		end
		local spr = proj.SpriteRendererComponent
		if isvalid(spr) then
			spr.SpriteRUID = self:GetSnipingBallRUID(stage)
		end
		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type SnipingProjectileAttack
		local projAtk = proj:GetComponent("script.SnipingProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type SnipingProjectile
		local projComp = proj:GetComponent("script.SnipingProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.ChargeRatio = chargeRatio
			projComp.CritRate = self:GetServerCritRatePercent()
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, 0)
		end
		log("[Sniping] 화살 발사 stage=" .. tostring(stage) .. " charge=" .. string.format("%.2f", chargeRatio) .. " dirX=" .. tostring(dirX) .. " combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("Multicast")
	method void StartSnipingVisuals(Entity attacker, number dirX)
		-- 차지 시작 연출: 머리 위 게이지 바(10초에 걸쳐 차오름) + 1단계 차지 이펙트.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		self:StopSnipingVisualsLocal()
		self._T.snipingVisualsActive = true
		-- 게이지 바는 이펙트가 아니라 서버가 스폰한 엔티티(Bg/Fill/Pct)가 표시한다(SpawnSnipingGaugeText).
		self:ApplySnipingChargeEffect(attacker, 0, dirX)
		log("[Sniping] 차지 이펙트 시작")
	end

	@ExecSpace("Multicast")
	method void SetSnipingStageVisuals(Entity attacker, number stage, number dirX)
		-- 단계 전환/방향 전환: 이전 차지 이펙트를 지우고 해당 단계 이펙트로 교체한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		if self._T.snipingVisualsActive ~= true then return end
		self:ApplySnipingChargeEffect(attacker, stage, dirX)
	end

	@ExecSpace("ClientOnly")
	method void ApplySnipingChargeEffect(Entity attacker, number stage, number dirX)
		-- (요청) 차지 이펙트는 12프레임을 넘지 않는다: 0~12프레임을 1회 재생한 뒤 5~12프레임을
		-- 반복한다(폭풍의 시 prepare→keydown과 같은 토큰 방식). 원본 아트는 왼쪽 발사 기준이라
		-- 오른쪽을 볼 때 FlipX.
		local ruid = self:GetSnipingChargeRUID(stage)
		local flip = dirX > 0
		self._T.snipingChargeToken = (self._T.snipingChargeToken or 0) + 1
		local myTok = self._T.snipingChargeToken
		if self._T.snipingChargeSerial ~= nil then
			_EffectService:RemoveEffect(self._T.snipingChargeSerial)
			self._T.snipingChargeSerial = nil
		end
		if self._T.snipingChargeLoopSerial ~= nil then
			_EffectService:RemoveEffect(self._T.snipingChargeLoopSerial)
			self._T.snipingChargeLoopSerial = nil
		end
		-- (피드백) 원본 아트가 화면을 덮을 만큼 커서 전체 이펙트 크기를 절반으로 줄인다.
		self._T.snipingChargeSerial = _EffectService:PlayEffectAttached(
			ruid, attacker, Vector3(0, 0.15, 0), 0, Vector3(0.5, 0.5, 0.5), false,
			{ ["EndFrameIndex"] = 12, ["FlipX"] = flip }
		)
		local introDur = self:GetSnipingFrameRangeDuration(ruid, 0, 12)
		_TimerService:SetTimerOnce(function()
			if self._T.snipingChargeToken ~= myTok then return end
			if self._T.snipingVisualsActive ~= true then return end
			if not isvalid(attacker) then return end
			self._T.snipingChargeSerial = nil
			self._T.snipingChargeLoopSerial = _EffectService:PlayEffectAttached(
				ruid, attacker, Vector3(0, 0.15, 0), 0, Vector3(0.5, 0.5, 0.5), true,
				{ ["StartFrameIndex"] = 5, ["EndFrameIndex"] = 12, ["FlipX"] = flip }
			)
		end, introDur)
	end

	@ExecSpace("Multicast")
	method void PlaySnipingReleaseVisuals(Entity attacker, number stage, number dirX)
		-- 릴리즈 연출: 게이지/차지 루프를 지우고, 차지 이펙트의 13프레임~끝을 1회 재생 + 슈팅 이펙트.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local chargeRuid = self:GetSnipingChargeRUID(stage)
		local shootRuid = self:GetSnipingShootRUID(stage)
		local flip = dirX > 0
		self:StopSnipingVisualsLocal()
		local tailSerial = _EffectService:PlayEffectAttached(
			chargeRuid, attacker, Vector3(0, 0.15, 0), 0, Vector3(0.5, 0.5, 0.5), false,
			{ ["StartFrameIndex"] = 13, ["FlipX"] = flip }
		)
		local shootSerial = _EffectService:PlayEffectAttached(
			shootRuid, attacker, Vector3(0.2 * dirX, 0.35, 0), 0, Vector3(0.5, 0.5, 0.5), false,
			{ ["FlipX"] = flip }
		)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(tailSerial)
			_EffectService:RemoveEffect(shootSerial)
		end, 2.0)
	end

	@ExecSpace("Multicast")
	method void StopSnipingVisuals(Entity attacker)
		-- 차지 취소 - 게이지/차지 이펙트를 모두 지운다(여러 번 불려도 안전).
		if not self:IsClient() then return end
		self:StopSnipingVisualsLocal()
	end

	@ExecSpace("ClientOnly")
	method void StopSnipingVisualsLocal()
		-- 클라이언트 로컬 정리: 예약 타이머 무효화 + 게이지/차지 이펙트 제거.
		self._T.snipingVisualsActive = false
		self._T.snipingLoopToken = (self._T.snipingLoopToken or 0) + 1
		self._T.snipingChargeToken = (self._T.snipingChargeToken or 0) + 1
		if self._T.snipingChargeSerial ~= nil then
			_EffectService:RemoveEffect(self._T.snipingChargeSerial)
			self._T.snipingChargeSerial = nil
		end
		if self._T.snipingChargeLoopSerial ~= nil then
			_EffectService:RemoveEffect(self._T.snipingChargeLoopSerial)
			self._T.snipingChargeLoopSerial = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void EnsureSnipingClipCache(string ruid)
		-- 클립 프레임 Delay 목록을 한 번만 읽어 캐시한다(ms 단위로 오면 초로 보정).
		if self._T.snipClipCache == nil then self._T.snipClipCache = {} end
		if self._T.snipClipCache[ruid] ~= nil then return end
		local delays = {}
		local total = 0
		local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
		if clip ~= nil and clip.Frames ~= nil then
			for _, f in ipairs(clip.Frames:ToTable()) do
				local d = f.Delay or 0
				table.insert(delays, d)
				total = total + d
			end
		end
		local scale = 1.0
		if total > 5 then scale = 0.001 end
		for i = 1, #delays do delays[i] = delays[i] * scale end
		self._T.snipClipCache[ruid] = delays
	end

	@ExecSpace("ClientOnly")
	method number GetSnipingClipDuration(string ruid)
		-- 클립 전체 길이(초).
		self:EnsureSnipingClipCache(ruid)
		local delays = self._T.snipClipCache[ruid]
		local total = 0
		for i = 1, #delays do total = total + delays[i] end
		return total
	end

	@ExecSpace("ClientOnly")
	method number GetSnipingFrameRangeDuration(string ruid, number startIdx, number endIdx)
		-- 0-기준 프레임 startIdx~endIdx 구간의 길이(초). 프레임 수를 넘으면 있는 만큼만 합산한다.
		self:EnsureSnipingClipCache(ruid)
		local delays = self._T.snipClipCache[ruid]
		local total = 0
		for i = startIdx + 1, math.min(endIdx + 1, #delays) do
			total = total + delays[i]
		end
		if total <= 0 then total = 0.5 end
		return total
	end

	@ExecSpace("ClientOnly")
	method number GetSnipingClipFrameCount(string ruid)
		-- 클립의 총 프레임 수.
		self:EnsureSnipingClipCache(ruid)
		return #self._T.snipClipCache[ruid]
	end

	-- ── 체인샷(2차) ──────────────────────────────────────────────────
	-- 8방향으로 체인을 쏴서 지형에 박고, 3초 안에 다시 누르면 그 각도로 당겨져 날아간다.
	-- 이동 거리는 (벽까지 거리) + (벽까지 거리)/3 = 거리의 4/3배(요청).
	-- 체인 아트/아이콘/사용음은 원본 팩 skill/6400.img/skill/64001012의 special / icon / _audio/Use.

	method number RayHitDistanceToFoothold(Foothold seg, Vector2 origin, Vector2 dir, number maxDist)
		-- 반직선(origin + dir*t, 0 <= t <= maxDist)과 발판 선분의 교차 거리 t를 돌려준다(안 만나면 -1).
		-- FootholdComponent:Raycast는 "맞은 발판"만 주고 맞은 좌표는 주지 않아서, 대각선 체인의
		-- 정확한 고정점을 얻으려면 여기서 직접 선분-반직선 교차를 푼다. dir은 반드시 단위벡터여야
		-- t가 곧 거리가 된다.
		if seg == nil then return -1 end
		local sp = seg.StartPoint
		local ep = seg.EndPoint
		local sx = ep.x - sp.x
		local sy = ep.y - sp.y
		local denom = dir.x * sy - dir.y * sx
		if math.abs(denom) < 0.000001 then return -1 end   -- 평행
		local qpx = sp.x - origin.x
		local qpy = sp.y - origin.y
		local t = (qpx * sy - qpy * sx) / denom
		local u = (qpx * dir.y - qpy * dir.x) / denom
		if t < 0 or t > maxDist then return -1 end
		if u < 0 or u > 1 then return -1 end
		return t
	end

	@ExecSpace("ServerOnly")
	method void AttackChainShot(number combatPower, number atkMultiplier, number rawDirX, number rawDirY)
		-- 체인 발사: 조준 방향으로 지형을 찾아 고정점을 정하고 체인 줄 엔티티를 플레이어에 붙인다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local dirX, dirY = rawDirX, rawDirY
		local noAim = false
		local mag = math.sqrt(dirX * dirX + dirY * dirY)
		if mag > 0.0001 then
			dirX = dirX / mag
			dirY = dirY / mag
		else
			-- (요청) 방향키 없이 시전하면 서있는 바닥을 뺀 "가장 가까운 땅"으로 날린다(아래 전방향 스냅).
			-- 전방향에서도 못 찾으면 바라보는 쪽 수평이 폴백이다.
			noAim = true
			local ctrlForDir = self.Entity.PlayerControllerComponent
			dirX = (isvalid(ctrlForDir) and ctrlForDir.LookDirectionX >= 0) and 1 or -1
			dirY = 0
		end

		local CHAIN_MAX_RANGE = 6.0     -- 지형에 안 맞을 때 뻗는 최대 길이(요청)
		local CHAIN_HOLD = 3.0          -- 박힌 체인이 유지되는 시간(요청)
		local CHAIN_ORIGIN_Y = 0.35     -- 줄이 시작되는 높이(다른 화살 스킬과 동일한 가슴 높이)

		-- 이전 체인이 남아 있으면 먼저 정리한다(연속 시전).
		self:ClearChainShot()

		local myPos = self.Entity.TransformComponent.WorldPosition
		local origin = Vector2(myPos.x, myPos.y + CHAIN_ORIGIN_Y)
		local dir = Vector2(dirX, dirY)

		-- 경로상의 발판을 전부 받아 실제 교차 거리가 가장 가까운 것을 고정점으로 삼는다.
		-- 발밑 발판을 거리 0 근처에서 자기재검출하는 것을 막기 위해 최소 거리를 둔다.
		local map = self.Entity.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		local hitDist = -1
		-- 지금 밟고 있는 발판은 고정 대상에서 뺀다. 아래/대각선 아래로 쏘면 발밑 0.35 지점에서 자기가
		-- 서 있는 바닥에 그대로 박혀(실측: 거리 0.50) 체인이 늘 뭉툭하게 끝나기 때문이다.
		-- 같은 지면이 여러 조각으로 나뉘어 있어도 밟고 있는 조각만 빼면 옆 조각/아래층에는 정상적으로 박힌다.
		local rbForFh = self.Entity.RigidbodyComponent
		local standingFh = isvalid(rbForFh) and rbForFh:GetCurrentFoothold() or nil
		-- (버그 수정 2026-07-28) 공중(점프/낙하) 시전이면 GetCurrentFoothold가 nil이라 제외 목록이
		-- 비어, 체인이 발밑 바로 아래 발판(방금 뛰어오른 그 지면)에 박혀 목표 지역까지 못 간다.
		-- 공중일 때는 발밑 아래로 내리쏴 "바로 아래 발판"을 서 있는 발판처럼 취급해 제외한다.
		if standingFh == nil and isvalid(fh) then
			local downOrigin = Vector2(myPos.x, myPos.y + 0.1)
			local downHits = fh:RaycastAll(downOrigin, Vector2(0, -1), 3.0)
			local bestDownT = -1
			for _, h in ipairs(downHits) do
				local t = self:RayHitDistanceToFoothold(h, downOrigin, Vector2(0, -1), 3.0)
				if t >= 0 and (bestDownT < 0 or t < bestDownT) then
					bestDownT = t
					standingFh = h
				end
			end
		end
		-- (요청) 캐릭터가 서 있는 바닥으로는 날리지 않는다. 같은 지면이 여러 발판 조각으로 이어져
		-- 있으므로 Next/PreviousFootholdId 체인을 따라가 연결된 조각 전부를 제외 목록에 넣는다.
		local excludedFh = {}
		if standingFh ~= nil and isvalid(fh) then
			local startId = standingFh.Id
			excludedFh[startId] = true
			local cur = startId
			for i = 1, 64 do
				local f = fh:GetFoothold(cur)
				if f == nil then break end
				local nxt = f.NextFootholdId
				if nxt == nil or nxt <= 0 or excludedFh[nxt] == true then break end
				excludedFh[nxt] = true
				cur = nxt
			end
			cur = startId
			for i = 1, 64 do
				local f = fh:GetFoothold(cur)
				if f == nil then break end
				local prv = f.PreviousFootholdId
				if prv == nil or prv <= 0 or excludedFh[prv] == true then break end
				excludedFh[prv] = true
				cur = prv
			end
		end
		local function nearestHitAlong(ndx, ndy)
			-- 방향 (ndx,ndy)로 쐈을 때 가장 가까운 유효 교차 거리(없으면 -1). 서있는 지면 조각은 제외.
			local best = -1
			local hits = fh:RaycastAll(origin, Vector2(ndx, ndy), CHAIN_MAX_RANGE)
			for _, h in ipairs(hits) do
				if excludedFh[h.Id] ~= true then
					local t = self:RayHitDistanceToFoothold(h, origin, Vector2(ndx, ndy), CHAIN_MAX_RANGE)
					if t >= 0.15 and (best < 0 or t < best) then
						best = t
					end
				end
			end
			return best
		end
		if isvalid(fh) and noAim then
			-- (요청) 방향 입력이 없으면 360도 전방향에서 가장 가까운 땅(서있는 바닥 제외)으로 발사
			local bestT = -1
			local bestDx = dirX
			local bestDy = dirY
			for i = 0, 47 do
				local a = i * (7.5 * math.pi / 180.0)
				local ndx = math.cos(a)
				local ndy = math.sin(a)
				local t = nearestHitAlong(ndx, ndy)
				if t >= 0 and (bestT < 0 or t < bestT) then
					bestT = t
					bestDx = ndx
					bestDy = ndy
				end
			end
			if bestT >= 0 then
				hitDist = bestT
				dirX = bestDx
				dirY = bestDy
				log("[ChainShot] 방향 입력 없음 - 가장 가까운 땅으로 발사")
			end
		elseif isvalid(fh) then
			hitDist = nearestHitAlong(dirX, dirY)
			if hitDist < 0 then
				-- (요청) 조준 방향에 벽이 없으면 조준 기준 ±45도 부채꼴 안에서 가장 가까운 벽으로
				-- 스냅해서 날린다 (12시로 쏴도 1시 방향 벽이 있으면 그쪽으로).
				local baseAngle = math.atan(dirY, dirX)
				local bestT = -1
				local bestDx, bestDy = dirX, dirY
				for step = 1, 6 do
					for _, s in ipairs({ 1, -1 }) do
						local a = baseAngle + s * step * (7.5 * math.pi / 180.0)
						local ndx = math.cos(a)
						local ndy = math.sin(a)
						local t = nearestHitAlong(ndx, ndy)
						if t >= 0 and (bestT < 0 or t < bestT) then
							bestT = t
							bestDx = ndx
							bestDy = ndy
						end
					end
				end
				if bestT >= 0 then
					hitDist = bestT
					dirX = bestDx
					dirY = bestDy
					log("[ChainShot] 조준 방향에 벽 없음 - ±45도 부채꼴에서 가까운 벽으로 스냅")
				end
			end
		end

		local anchored = hitDist > 0
		local reach = anchored and hitDist or CHAIN_MAX_RANGE
		local anchorPos = Vector2(origin.x + dirX * reach, origin.y + dirY * reach)

		self._T.chainSeq = (self._T.chainSeq or 0) + 1
		local chainName = "chainshot_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.chainSeq)
		local chain = _SpawnService:SpawnByModelId("chainshotchain", chainName, Vector3(0, CHAIN_ORIGIN_Y, 0), self.Entity)
		if isvalid(chain) then
			---@type ChainShotChain
			local cc = chain:GetComponent("script.ChainShotChain")
			if isvalid(cc) then
				cc.AnchorPos = anchorPos
				cc.Anchored = anchored
			end
			self._T.chainEntity = chain
		end

		self:PlayChainShotSound(self.Entity)
		self:PlayChainShotMotion(self.Entity, "shoot1", (dirX >= 0) and 1 or -1, atkMultiplier)

		-- 박힌 체인만 당길 수 있다. 유지 시간이 끝나면 스스로 정리한다(토큰 가드로 새 체인과 안 엉키게).
		self._T.chainAnchored = anchored
		self._T.chainAnchorPos = anchorPos
		self._T.chainDir = Vector2(dirX, dirY)   -- 당기기 착지점 계산용(벽 너머 방향)
		self._T.chainToken = (self._T.chainToken or 0) + 1
		local myChainToken = self._T.chainToken
		_TimerService:SetTimerOnce(function()
			if self._T.chainToken ~= myChainToken then return end
			self:ClearChainShot()
		end, CHAIN_HOLD)

		self:NotifyChainShotAnchored(anchored, CHAIN_HOLD, self.Entity.PlayerComponent.UserId)
		log("[ChainShot] 발사 dir=(" .. string.format("%.2f", dirX) .. "," .. string.format("%.2f", dirY)
			.. ") anchored=" .. tostring(anchored) .. " 거리=" .. string.format("%.2f", reach))
	end

	@ExecSpace("ServerOnly")
	method void ClearChainShot()
		-- 체인 줄 제거 + 고정 상태 해제. 유지시간 만료 / 재시전 / 당기기 완료 때 호출된다.
		if isvalid(self._T.chainEntity) then
			self._T.chainEntity:Destroy()
		end
		self._T.chainEntity = nil
		self._T.chainAnchored = false
	end

	@ExecSpace("Client")
	method void NotifyChainShotAnchored(boolean anchored, number holdSeconds)
		-- 시전한 클라이언트에게만 "지형에 박혔는지"를 알려, 다음 입력을 당기기로 쓸지 새 발사로 쓸지 정하게 한다.
		_SkillManager:OnChainShotAnchored(anchored, holdSeconds)
	end

	@ExecSpace("Multicast")
	method void PlayChainShotSound(Entity caster)
		-- 체인샷 사용음(원본 팩의 _audio/Use).
		if not self:IsClient() then return end
		if not isvalid(caster) then return end
		_SoundService:PlaySound("176fcaa19ead485393cd3fd2c2f715d4", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayChainShotMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 체인을 쏘는 순간의 활 쏘기 모션. 속사와 같은 방식(짧게 한 번만 재생).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false
		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local motionEvent = ActionStateChangedEvent(motionName, motionName, 1.0 / mult, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
		end, 0.3 * mult)
	end

	@ExecSpace("ServerOnly")
	method void ChainShotPull(number combatPower)
		-- (요청) 박혀 있는 체인을 당기면 체인이 박힌 벽의 "위쪽 땅"에 착지한다.
		-- 벽면 앵커에서 진행 방향으로 살짝 넘어간 지점 위에서 아래로 발판을 찾아 착지점으로 삼고,
		-- 그 지점을 못 찾으면 예전처럼 체인 각도로 거리의 4/3배 날아간다.
		if self._T.chainAnchored ~= true then
			log("[ChainShot] 당기기 무시 - 박힌 체인 없음")
			return
		end
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then return end

		local myPos = self.Entity.TransformComponent.WorldPosition
		local anchor = self._T.chainAnchorPos

		local landX = nil
		local landY = nil
		local mapForLand = self.Entity.CurrentMap
		local fhForLand = isvalid(mapForLand) and mapForLand.FootholdComponent or nil
		if isvalid(fhForLand) then
			-- 앵커 좌우 양쪽을 대칭으로 조사한다 - 체인이 발판 윗줄의 "끝점" 근처(예: 섬 오른쪽 끝)에
			-- 박히면 진행 방향 쪽 탐사 지점이 전부 발판 밖으로 나가 엉뚱한 아래층만 걸리기 때문이다.
			-- 어느 면을 고를지는 아래의 "앵커 높이에 가까운 면 우선 + 아래층 감점" 점수가 결정한다.
			local offsets = { 0, 0.45, -0.45, 0.9, -0.9 }
			local down = Vector2(0, -1)
			-- (버그 수정) 탐사 지점 하나에서 면을 찾자마자 확정하지 않고, 모든 탐사 지점의 후보를
			-- 모아 "앵커 높이에 가장 가까운 면"을 고른다. 위 플랫폼 가장자리에 박았을 때 첫 탐사
			-- 지점(+0.45 옆)이 플랫폼 밖이면 아래층으로 떨어지던 문제와, 아래층에 박았는데 위층이
			-- 겹쳐 있던 문제를 함께 막는다. 앵커보다 많이 낮은 면(아래층)은 감점해 "박힌 곳 위"를 우선한다.
			local bestScore = nil
			for _, off in ipairs(offsets) do
				local probe = Vector2(anchor.x + off, anchor.y + 2.0)
				local hits = fhForLand:RaycastAll(probe, down, 4.5)
				for _, h in ipairs(hits) do
					local t = self:RayHitDistanceToFoothold(h, probe, down, 4.5)
					if t >= 0 then
						local y = probe.y - t
						local score = math.abs(y - anchor.y)
						if y < anchor.y - 0.2 then
							score = score + 1.0
						end
						if bestScore == nil or score < bestScore then
							bestScore = score
							landX = probe.x
							landY = y + 0.05
						end
					end
				end
			end
		end

		local dx = 0
		local dy = 0
		if landX ~= nil then
			dx = landX - myPos.x
			dy = landY - myPos.y
		else
			dx = anchor.x - myPos.x
			dy = (anchor.y - 0.35) - myPos.y      -- 줄은 가슴 높이에서 나가므로 발 기준으로 되돌린다
		end
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < 0.05 then
			self:ClearChainShot()
			return
		end
		local dirX = dx / dist
		local dirY = dy / dist
		local travel = dist
		if landX == nil then
			travel = dist * (4.0 / 3.0)
		end

		-- 지나가는 길의 적에게 피해(최대 6명, 전투력의 50%~70% - 요청). 돌진과 동일하게 서버가
		-- 이동 전에 대상을 확정하고 한 번씩만 때린다.
		self._T.pendingChainShotCombatPower = combatPower
		local targets = self:FindChainShotTargets(Vector2(myPos.x, myPos.y), dirX, dirY, travel, 6)
		self:DealChainShotHits(targets)

		-- 플레이어 이동은 반드시 클라이언트에서(돌진 RunRushMove와 같은 이유). 체인은 대각선/수직도
		-- 있으므로 x·y를 함께 직선 보간한다.
		local PULL_DURATION = 0.28
		self:RunChainPullMove(dirX, dirY, travel, PULL_DURATION, self.Entity.PlayerComponent.UserId)

		-- 다 날아간 뒤 줄을 걷는다.
		self._T.chainToken = (self._T.chainToken or 0) + 1
		_TimerService:SetTimerOnce(function()
			self:ClearChainShot()
		end, PULL_DURATION)
		if landX ~= nil then
			log("[ChainShot] 당기기 → 벽 위 착지 (" .. string.format("%.2f", landX) .. ", " .. string.format("%.2f", landY)
				.. ") 거리=" .. string.format("%.2f", dist) .. " 대상=" .. tostring(#targets) .. "명")
		else
			log("[ChainShot] 당기기(착지점 없음 - 기존 방식) 거리=" .. string.format("%.2f", dist)
				.. " 이동=" .. string.format("%.2f", travel) .. " 대상=" .. tostring(#targets) .. "명")
		end
	end

	method table FindChainShotTargets(Vector2 fromPos, number dirX, number dirY, number travel, integer maxCount)
		-- 당겨져 지나가는 경로(선분) 근처의 살아있는 몬스터를 가까운 순으로 최대 maxCount명 고른다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local HIT_RADIUS = 0.8
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead and mc.Entity.Enable then
				local pos = mc.Entity.TransformComponent.WorldPosition
				-- 경로 선분에 사영해 "얼마나 진행한 지점인지(proj)"와 "선분에서 벗어난 거리"를 구한다.
				local rx = pos.x - fromPos.x
				local ry = pos.y - fromPos.y
				local proj = rx * dirX + ry * dirY
				if proj >= 0 and proj <= travel then
					local perpX = rx - dirX * proj
					local perpY = ry - dirY * proj
					local perp = math.sqrt(perpX * perpX + perpY * perpY)
					if perp <= HIT_RADIUS then
						table.insert(candidates, { entity = mc.Entity, dist = proj })
					end
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void DealChainShotHits(table targets)
		-- 대상마다 개별 판정. 밀집 지역에서 이웃까지 겹쳐 맞는 것을 막기 위해 이번 호출 전용
		-- 단일 대상 포인터(chainShotCurrentTarget)로 거른다(돌진과 동일한 패턴).
		for _, t in ipairs(targets) do
			if isvalid(t) then
				self._T.chainShotCurrentTarget = t
				local pos = t.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
				self:AttackShadowSafe(shape, "skill.chainshot", t)
			end
		end
	end

	@ExecSpace("Client")
	method void RunChainPullMove(number dirX, number dirY, number distance, number duration)
		-- 체인에 당겨져 직선으로 날아간다. **반드시 클라이언트에서** 돈다 - 서버에서 플레이어를
		-- 움직이는 수단은 전부 무효/불안정하다(AttackRush 주석 참고).
		if not isvalid(self.Entity) then return end
		local rb = self.Entity.RigidbodyComponent
		if not isvalid(rb) then return end
		local playerCtrl = self.Entity.PlayerControllerComponent
		local mv = self.Entity.MovementComponent

		local startPos = self.Entity.TransformComponent.WorldPosition
		local speed = distance / math.max(duration, 0.001)
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
			playerCtrl.LookDirectionX = (dirX >= 0) and 1 or -1
		end
		if isvalid(mv) then mv:Stop() end

		-- (버그 수정) 진행량을 "틱마다 1/60초"로 세면 실제 타이머가 60Hz보다 느리게 돌 때(실측 약 45Hz)
		-- 목표 거리의 3/4밖에 못 가고 끊긴다. 벽시계 시간(ElapsedSeconds)으로 재서 프레임레이트와
		-- 무관하게 항상 정확히 distance만큼 이동하게 한다.
		local startTime = _UtilLogic.ElapsedSeconds
		if self._T.chainPullTimerId ~= nil then
			_TimerService:ClearTimer(self._T.chainPullTimerId)
		end
		self._T.chainPullTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self.Entity) then return end
			local elapsed = _UtilLogic.ElapsedSeconds - startTime
			local travelled = math.min(speed * elapsed, distance)
			rb:SetWorldPosition(Vector2(startPos.x + dirX * travelled, startPos.y + dirY * travelled))
		end, 1 / 60)

		_TimerService:SetTimerOnce(function()
			if self._T.chainPullTimerId ~= nil then
				_TimerService:ClearTimer(self._T.chainPullTimerId)
				self._T.chainPullTimerId = nil
			end
			-- 마지막에 목표 지점으로 한 번 맞춰준다 - 타이머가 끊기는 타이밍에 따라 몇 cm 덜 간 채로
			-- 끝나는 것을 막는다(요청한 "거리의 4/3" 를 정확히 지키기 위해).
			if isvalid(rb) then
				rb:SetWorldPosition(Vector2(startPos.x + dirX * distance, startPos.y + dirY * distance))
			end
			if isvalid(mv) then mv:Stop() end
			if isvalid(playerCtrl) then playerCtrl.Enable = true end
			log("[ChainShot] 당기기 이동 종료")
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void AttackFlash(number combatPower, number atkMultiplier, number rawDirX, number rawDirY, string weaponRuid)
		-- 섬광(2차, 2026-07-28): 판정/데미지/조준 스냅은 체인샷과 동일하되 연출이 다르다.
		-- swingT2 모션 후 장착 무기와 같은 RUID의 검(thumbnail://)이 회전하며 날아가 벽에 박히고,
		-- 체인샷과 달리 한 번 더 누를 필요 없이 즉시 그 방향으로 돌진해 벽 위 땅에 안착한다.
		-- 돌진 경로가 검 위치를 지나는 순간 검을 회수(제거)한다.
		-- weaponRuid는 클라이언트가 시전 시점에 읽어 넘긴다(장비 적용이 클라 전용이라 서버 GetEquip은 빈 값).
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isFlashActive then
			log("[Flash] 요청 차단됨(이미 진행 중)")
			return
		end

		local dirX, dirY = rawDirX, rawDirY
		local noAim = false
		local mag = math.sqrt(dirX * dirX + dirY * dirY)
		if mag > 0.0001 then
			dirX = dirX / mag
			dirY = dirY / mag
		else
			noAim = true
			local ctrlForDir = self.Entity.PlayerControllerComponent
			dirX = (isvalid(ctrlForDir) and ctrlForDir.LookDirectionX >= 0) and 1 or -1
			dirY = 0
		end

		local FLASH_MAX_RANGE = 6.0     -- 체인샷과 동일한 최대 사거리
		local FLASH_ORIGIN_Y = 0.35     -- 검이 출발하는 가슴 높이(체인샷과 동일)

		local myPos = self.Entity.TransformComponent.WorldPosition
		local origin = Vector2(myPos.x, myPos.y + FLASH_ORIGIN_Y)

		-- 고정점 탐색: 체인샷(AttackChainShot)과 완전히 동일한 규칙 - 서 있는 지면 조각(연결 조각 포함)
		-- 제외, 조준 방향 우선, 빗나가면 ±45도 부채꼴 스냅, 무입력이면 360도에서 가장 가까운 땅.
		local map = self.Entity.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		local hitDist = -1
		local rbForFh = self.Entity.RigidbodyComponent
		local standingFh = isvalid(rbForFh) and rbForFh:GetCurrentFoothold() or nil
		-- (버그 수정 2026-07-28) 공중(점프/낙하) 시전이면 GetCurrentFoothold가 nil이라 제외 목록이
		-- 비어, 검이 발밑 바로 아래 발판에 박혀 목표 지역까지 못 간다(체인샷과 동일한 수정).
		if standingFh == nil and isvalid(fh) then
			local downOrigin = Vector2(myPos.x, myPos.y + 0.1)
			local downHits = fh:RaycastAll(downOrigin, Vector2(0, -1), 3.0)
			local bestDownT = -1
			for _, h in ipairs(downHits) do
				local t = self:RayHitDistanceToFoothold(h, downOrigin, Vector2(0, -1), 3.0)
				if t >= 0 and (bestDownT < 0 or t < bestDownT) then
					bestDownT = t
					standingFh = h
				end
			end
		end
		local excludedFh = {}
		if standingFh ~= nil and isvalid(fh) then
			local startId = standingFh.Id
			excludedFh[startId] = true
			local cur = startId
			for i = 1, 64 do
				local f = fh:GetFoothold(cur)
				if f == nil then break end
				local nxt = f.NextFootholdId
				if nxt == nil or nxt <= 0 or excludedFh[nxt] == true then break end
				excludedFh[nxt] = true
				cur = nxt
			end
			cur = startId
			for i = 1, 64 do
				local f = fh:GetFoothold(cur)
				if f == nil then break end
				local prv = f.PreviousFootholdId
				if prv == nil or prv <= 0 or excludedFh[prv] == true then break end
				excludedFh[prv] = true
				cur = prv
			end
		end
		local function nearestHitAlong(ndx, ndy)
			local best = -1
			local hits = fh:RaycastAll(origin, Vector2(ndx, ndy), FLASH_MAX_RANGE)
			for _, h in ipairs(hits) do
				if excludedFh[h.Id] ~= true then
					local t = self:RayHitDistanceToFoothold(h, origin, Vector2(ndx, ndy), FLASH_MAX_RANGE)
					if t >= 0.15 and (best < 0 or t < best) then
						best = t
					end
				end
			end
			return best
		end
		if isvalid(fh) and noAim then
			local bestT = -1
			local bestDx = dirX
			local bestDy = dirY
			for i = 0, 47 do
				local a = i * (7.5 * math.pi / 180.0)
				local ndx = math.cos(a)
				local ndy = math.sin(a)
				local t = nearestHitAlong(ndx, ndy)
				if t >= 0 and (bestT < 0 or t < bestT) then
					bestT = t
					bestDx = ndx
					bestDy = ndy
				end
			end
			if bestT >= 0 then
				hitDist = bestT
				dirX = bestDx
				dirY = bestDy
			end
		elseif isvalid(fh) then
			hitDist = nearestHitAlong(dirX, dirY)
			if hitDist < 0 then
				local baseAngle = math.atan(dirY, dirX)
				local bestT = -1
				local bestDx, bestDy = dirX, dirY
				for step = 1, 6 do
					for _, s in ipairs({ 1, -1 }) do
						local a = baseAngle + s * step * (7.5 * math.pi / 180.0)
						local ndx = math.cos(a)
						local ndy = math.sin(a)
						local t = nearestHitAlong(ndx, ndy)
						if t >= 0 and (bestT < 0 or t < bestT) then
							bestT = t
							bestDx = ndx
							bestDy = ndy
						end
					end
				end
				if bestT >= 0 then
					hitDist = bestT
					dirX = bestDx
					dirY = bestDy
				end
			end
		end

		local anchored = hitDist > 0
		local reach = anchored and hitDist or FLASH_MAX_RANGE
		local anchorPos = Vector2(origin.x + dirX * reach, origin.y + dirY * reach)

		-- swingT2 모션(요청). 체인샷 모션 재생기와 같은 경로로 클라에 뿌린다.
		self:PlayChainShotMotion(self.Entity, "swingT2", (dirX >= 0) and 1 or -1, atkMultiplier)
		self:PlayChainShotSound(self.Entity)
		-- (요청 2026-07-28) 이동(돌진) 전 캐릭터 바닥에 지면 충격파 링 이펙트 1회.
		self:PlayFlashGroundEffect(self.Entity)
		-- (요청 2026-07-28) 손에 든 무기는 검을 회수할 때까지 잠깐 숨긴다(던진 검이 그 무기이므로).
		self:SetFlashWeaponVisible(self.Entity, false)

		self._T.isFlashActive = true
		self._T.flashToken = (self._T.flashToken or 0) + 1
		local myFlashToken = self._T.flashToken

		-- 회전하며 날아가는 검. 맵에 스폰해 서버가 매 틱 위치/회전을 굴린다(짧은 비행이라 보간 떨림 무시 가능).
		self._T.flashSeq = (self._T.flashSeq or 0) + 1
		local sword = _SpawnService:SpawnByModelId("spearburstfadingeffect", "FlashSword" .. tostring(self._T.flashSeq), Vector3(origin.x, origin.y, 0), map)
		if isvalid(sword) then
			local spr = sword.SpriteRendererComponent
			if isvalid(spr) and weaponRuid ~= "" then
				spr.SpriteRUID = "thumbnail://" .. weaponRuid
				spr.OrderInLayer = 6
			end
			-- (요청 2026-07-28) 던진 검 크기는 원본의 2/3.
			sword.TransformComponent.Scale = Vector3(2.0 / 3.0, 2.0 / 3.0, 1)
			self._T.flashSwordEntity = sword
		end

		local FLASH_THROW_SPEED = 14.0     -- 검 비행 속도(유닛/초)
		local FLASH_SPIN_SPEED = 900.0     -- 회전 속도(도/초)
		local throwDur = reach / FLASH_THROW_SPEED
		local throwStart = _UtilLogic.ElapsedSeconds
		-- (실측 보정 지점) 무기 썸네일은 보통 45도 대각(칼끝 우상단) 기준 - 진행 방향으로 박히도록
		-- 최종 각도 = 진행각 - 45도. 어색하면 이 오프셋만 조정한다.
		local stickAngle = math.deg(math.atan(dirY, dirX)) - 45.0
		if self._T.flashThrowTimerId ~= nil then
			_TimerService:ClearTimer(self._T.flashThrowTimerId)
		end
		self._T.flashThrowTimerId = _TimerService:SetTimerRepeat(function()
			if self._T.flashToken ~= myFlashToken then return end
			if not isvalid(sword) then return end
			local elapsed = _UtilLogic.ElapsedSeconds - throwStart
			local t = math.min(elapsed / math.max(throwDur, 0.001), 1.0)
			sword.TransformComponent.Position = Vector3(origin.x + dirX * reach * t, origin.y + dirY * reach * t, 0)
			if t >= 1.0 then
				sword.TransformComponent.ZRotation = stickAngle
				if self._T.flashThrowTimerId ~= nil then
					_TimerService:ClearTimer(self._T.flashThrowTimerId)
					self._T.flashThrowTimerId = nil
				end
				-- (요청 2026-07-28) 검이 박히는 순간, 박힌 검의 각도에 맞춰 바닥 파쇄 이펙트 1회(투명도 80%).
				-- 파쇄 아트의 기본 분출 방향은 위(+y) - 표면 노멀(-진행 방향)로 향하게 진행각 + 90도 회전.
				-- 빗나간 경우(지형 없음)는 박히는 게 아니므로 재생하지 않는다.
				if anchored then
					self:PlayFlashShatterEffect(self.Entity, anchorPos.x, anchorPos.y, math.deg(math.atan(dirY, dirX)) + 90.0)
				end
			else
				-- 진행 방향과 같은 쪽으로 도는 게 자연스럽다 - 오른쪽으로 던지면 시계 방향(-).
				local spinSign = (dirX >= 0) and -1 or 1
				sword.TransformComponent.ZRotation = spinSign * FLASH_SPIN_SPEED * elapsed
			end
		end, 1 / 60)

		if not anchored then
			-- 벽이 없으면 검은 끝까지 날아가 사라지고 돌진은 하지 않는다(체인샷 빗나감과 동일한 규격).
			_TimerService:SetTimerOnce(function()
				if self._T.flashToken ~= myFlashToken then return end
				self:ClearFlashSword()
				self._T.isFlashActive = false
			end, throwDur + 0.3)
			log("[Flash] 빗나감 - 지형 없음, 돌진 생략")
			return
		end

		-- 검이 박히는 순간 자동 돌진 시작(체인샷 당기기와 동일한 착지/판정/이동).
		_TimerService:SetTimerOnce(function()
			if self._T.flashToken ~= myFlashToken then return end
			self:FlashDash(combatPower, anchorPos, Vector2(dirX, dirY), myFlashToken)
		end, throwDur)
		log("[Flash] 발사 dir=(" .. string.format("%.2f", dirX) .. "," .. string.format("%.2f", dirY)
			.. ") 거리=" .. string.format("%.2f", reach) .. " weaponRuid=" .. tostring(weaponRuid))
	end

	@ExecSpace("ServerOnly")
	method void FlashDash(number combatPower, Vector2 anchor, Vector2 chainDir, integer flashToken)
		-- 섬광 2단계: 검이 박힌 지점을 향해 자동 돌진. 착지점 계산/대상 판정/이동은
		-- 체인샷 당기기(ChainShotPull)와 동일한 규칙을 그대로 쓴다(데미지도 skill.chainshot 공유).
		if self._T.flashToken ~= flashToken then return end
		if not isvalid(self.Entity) then
			self._T.isFlashActive = false
			return
		end
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" then
			self:ClearFlashSword()
			self._T.isFlashActive = false
			return
		end

		local myPos = self.Entity.TransformComponent.WorldPosition

		-- 착지점: 앵커 주변을 좌우 대칭으로 내리쏴 "앵커 높이에 가장 가까운 면"을 고른다(체인샷과 동일).
		local landX = nil
		local landY = nil
		local mapForLand = self.Entity.CurrentMap
		local fhForLand = isvalid(mapForLand) and mapForLand.FootholdComponent or nil
		if isvalid(fhForLand) then
			local offsets = { 0, 0.45, -0.45, 0.9, -0.9 }
			local down = Vector2(0, -1)
			local bestScore = nil
			for _, off in ipairs(offsets) do
				local probe = Vector2(anchor.x + off, anchor.y + 2.0)
				local hits = fhForLand:RaycastAll(probe, down, 4.5)
				for _, h in ipairs(hits) do
					local t = self:RayHitDistanceToFoothold(h, probe, down, 4.5)
					if t >= 0 then
						local y = probe.y - t
						local score = math.abs(y - anchor.y)
						if y < anchor.y - 0.2 then
							score = score + 1.0
						end
						if bestScore == nil or score < bestScore then
							bestScore = score
							landX = probe.x
							landY = y + 0.05
						end
					end
				end
			end
		end

		local dx = 0
		local dy = 0
		if landX ~= nil then
			dx = landX - myPos.x
			dy = landY - myPos.y
		else
			dx = anchor.x - myPos.x
			dy = (anchor.y - 0.35) - myPos.y
		end
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist < 0.05 then
			self:ClearFlashSword()
			self._T.isFlashActive = false
			return
		end
		local dirX = dx / dist
		local dirY = dy / dist
		local travel = dist
		if landX == nil then
			travel = dist * (4.0 / 3.0)
		end

		-- 경로상의 적 최대 6명, 체인샷과 같은 데미지(skill.chainshot - 전투력의 50~70%).
		self._T.pendingChainShotCombatPower = combatPower
		local targets = self:FindChainShotTargets(Vector2(myPos.x, myPos.y), dirX, dirY, travel, 6)
		self:DealChainShotHits(targets)

		local PULL_DURATION = 0.28
		self:RunChainPullMove(dirX, dirY, travel, PULL_DURATION, self.Entity.PlayerComponent.UserId)

		-- (요청) 돌진 도중 검 위치와 겹치는 순간 검을 회수한다 - 경로상에서 검(앵커)까지의 진행량을
		-- 시간 비율로 환산해 그 시점에 제거한다.
		local swordProj = (anchor.x - myPos.x) * dirX + (anchor.y - myPos.y) * dirY
		swordProj = math.max(0, math.min(swordProj, travel))
		local retrieveDelay = PULL_DURATION * (swordProj / math.max(travel, 0.001))
		_TimerService:SetTimerOnce(function()
			if self._T.flashToken ~= flashToken then return end
			self:ClearFlashSword()
			log("[Flash] 검 회수")
		end, retrieveDelay)

		_TimerService:SetTimerOnce(function()
			if self._T.flashToken ~= flashToken then return end
			self:ClearFlashSword()   -- 안전망(회수 타이머가 못 돌았어도 정리)
			self._T.isFlashActive = false
		end, PULL_DURATION + 0.1)
		log("[Flash] 자동 돌진 → " .. (landX ~= nil and "벽 위 착지" or "착지점 없음(4/3 관통)")
			.. " 거리=" .. string.format("%.2f", dist) .. " 대상=" .. tostring(#targets) .. "명 검회수t=" .. string.format("%.2f", retrieveDelay))
	end

	@ExecSpace("ServerOnly")
	method void ClearFlashSword()
		-- 섬광의 검 엔티티 제거(회수/빗나감/안전망 공용). 검이 돌아오는 시점이므로 숨겨둔
		-- 손 무기도 여기서 함께 되돌린다(모든 정리 경로가 이 메서드를 지나간다).
		if isvalid(self._T.flashSwordEntity) then
			self._T.flashSwordEntity:Destroy()
		end
		self._T.flashSwordEntity = nil
		if self._T.flashThrowTimerId ~= nil then
			_TimerService:ClearTimer(self._T.flashThrowTimerId)
			self._T.flashThrowTimerId = nil
		end
		self:SetFlashWeaponVisible(self.Entity, true)
	end

	@ExecSpace("Multicast")
	method void SetFlashWeaponVisible(Entity caster, boolean visible)
		-- (요청 2026-07-28) 섬광이 던지는 검 = 손에 든 무기이므로, 던진 동안(회수 전까지) 손 무기를
		-- 투명하게 숨긴다. 아바타 부위 틴트(SetAvatarPartColor)의 알파만 조절 - 두손/한손 어느 쪽이
		-- 장착돼 있어도 되도록 두 슬롯 모두에 적용한다(장착 안 된 슬롯은 무해).
		if not self:IsClient() then return end
		if not isvalid(caster) then return end
		local ar = caster.AvatarRendererComponent
		if not isvalid(ar) then return end
		local a = visible and 1.0 or 0.0
		ar:SetAvatarPartColor(MapleAvatarItemCategory.TwoHandedWeapon, 1, 1, 1, a)
		ar:SetAvatarPartColor(MapleAvatarItemCategory.OneHandedWeapon, 1, 1, 1, a)
	end

	@ExecSpace("Multicast")
	method void PlayFlashGroundEffect(Entity caster)
		-- (요청 2026-07-28) 섬광 시전(이동 전) 순간 캐릭터 발밑에 지면 충격파 링 1회.
		-- (요청) 크기 50% + 투명도 50%.
		if not self:IsClient() then return end
		if not isvalid(caster) then return end
		local wp = caster.TransformComponent.WorldPosition
		_EffectService:PlayEffect("23798d6930964aff953735b22f28a7c7", caster, Vector3(wp.x, wp.y + 0.1, 0), 0, Vector3(0.5, 0.5, 1), false, { ["Alpha"] = 0.5 })
	end

	@ExecSpace("Multicast")
	method void PlayFlashShatterEffect(Entity caster, number x, number y, number rotDeg)
		-- (요청 2026-07-28) 검이 박히는 순간, 박힌 지점에 파쇄 이펙트 1회.
		-- 박히는 검의 각도에 맞춰 회전시킨다(호출부에서 진행각+90도 계산 - 이 클립도 지면 기준 아트).
		-- (요청 교체 이력) 3ba089cf(돌 솟구침) → 1b4991da(불꽃·흙 분출) → 146af997(흙먼지 퍼짐), 투명도 50%.
		-- 클립 원본 182x101px - 스케일 원본 그대로(1.0).
		if not self:IsClient() then return end
		if not isvalid(caster) then return end
		_EffectService:PlayEffect("146af997ea3c4d77b99eaa477ae6057f", caster, Vector3(x, y, 0), rotDeg, Vector3(1.0, 1.0, 1), false, { ["Alpha"] = 0.5 })
	end

	@ExecSpace("ServerOnly")
	method void AttackAvenger(number combatPower, number atkMultiplier, number rawDirX, number rawDirY)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 어벤져: 파이어에로우/아이언에로우와 동일한 구조(8방향 발사·기모으는 딜레이·이동봉인)를 재사용한다.
		-- 전투력의 500% 고정 데미지로 최대 10명을 관통하고, 사거리는 파이어에로우의 2/3(AvengerProjectile.MaxLifetime로 조절).
		-- 몸쪽 이펙트(공식 어벤져 리소스팩 skill/800033.img/skill/80003327의 "effect")가 끝난 뒤 투사체(같은 팩의 "ball/0",
		-- RUID 0477b2c75e4b4fbcaf795e03bd8da11a)를 발사한다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end

		local dirX, dirY = rawDirX, rawDirY
		local mag = math.sqrt(dirX * dirX + dirY * dirY)
		if mag > 0.0001 then
			dirX = dirX / mag
			dirY = dirY / mag
		else
			local playerCtrl = self.Entity.PlayerControllerComponent
			dirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
			dirY = 0
		end
		self._T.pendingAvengerDirX = dirX

		local castRuid = "954896b2b40a4d8085586ea0ec2f0e19"
		local ballRuid = "0477b2c75e4b4fbcaf795e03bd8da11a"

		-- 기모으는 딜레이 동안 이동이 되지 않도록 컨트롤러를 잠근다 (파이어에로우/아이언에로우와 동일한
		-- 첫-시전-캡처 + 토큰 가드 패턴 - 홀드 지속발동 중에도 안전).
		local playerCtrl = self.Entity.PlayerControllerComponent
		if not self._T.isAvengerMovementLocked then
			self._T.pendingAvengerWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.isAvengerMovementLocked = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self._T.avengerMoveLockToken = (self._T.avengerMoveLockToken or 0) + 1
		local myMoveLockToken = self._T.avengerMoveLockToken

		-- 순수 상하 방향(dirX==0)은 캐릭터가 원래 보던 좌우 방향을 그대로 유지한다.
		local horizDirX
		if dirX ~= 0 then
			horizDirX = (dirX > 0) and 1 or -1
		else
			horizDirX = (isvalid(playerCtrl) and playerCtrl.LookDirectionX >= 0) and 1 or -1
		end

		-- 몸쪽 이펙트(14프레임 차지 모션) 재생 + 럭키세븐과 동일한 모션(swingO1/O2/O3 순환). 이펙트가
		-- 끝나는 시점(0.6*mult)에서 0.2*mult 더 기다린 뒤 투사체를 발사한다("이펙트가 끝나고 0.2초 뒤
		-- 투사체가 날아가야 한다"는 요청).
		self:PlayAvengerCastEffect(self.Entity, castRuid, horizDirX)
		local swing = self:GetAvengerSwing()
		-- (기능 수정) "방향키를 누르면서 스킬을 써도 모션이 안 끊기게 해달라"는 요청 - 스킬 시전과 같은
		-- 프레임에 모션을 보내면 이동 입력으로 인한 상태변경 이벤트와 경합해 스윙 모션이 씹힐 수 있다.
		-- 0.15초 늦춰서 보내면(사용자 권장값) 그 사이 이동 관련 상태변경이 먼저 정리되어 안전하다.
		_TimerService:SetTimerOnce(function()
			self:PlayAvengerMotion(self.Entity, swing.name, horizDirX, atkMultiplier)
		end, 0.15)
		local fireDelay = (0.6 + 0.2) * atkMultiplier
		_TimerService:SetTimerOnce(function()
			self:SpawnAvengerProjectile(ballRuid, combatPower, dirX, dirY)
		end, fireDelay)
		-- 이동 잠금은 모션 재생 시간이 아니라 스킬 재사용 대기시간(SkillManager의 0.85*atkMultiplier 쿨다운)과
		-- 동일하게 끝까지 유지한다 - 투사체 발사 시점(fireDelay=0.8*mult)보다 늦어야 하므로 0.75가 아닌 0.85로 맞춘다.
		_TimerService:SetTimerOnce(function()
			self:RestoreAvengerControl(myMoveLockToken)
		end, 0.85 * atkMultiplier)
	end

	method table GetAvengerSwing()
		-- (기능 수정) "모션을 럭키세븐하고 같아야 한다"는 요청 - 럭키세븐의 GetLuckySevenSwing과
		-- 동일한 후보군(swingO1/O2/O3, 한손무기 계열)을 매 시전마다 순차 순환시킨다. 인덱스는 럭키세븐과
		-- 섞이지 않도록 어벤져 전용 필드(avengerSwingIndex)로 별도 관리한다.
		local candidates = {
			{ name = "swingO1" },
			{ name = "swingO2" },
			{ name = "swingO3" },
		}
		self._T.avengerSwingIndex = (self._T.avengerSwingIndex or 0) % #candidates + 1
		return candidates[self._T.avengerSwingIndex]
	end

	@ExecSpace("Multicast")
	method void PlayAvengerMotion(Entity attacker, string motionName, number dirX, number atkMultiplier)
		-- 어벤져 전용 모션 재생. 파이어에로우/아이언에로우와 동일한 방식 - 별도 플래그로 서로 간섭하지 않는다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isAvengerDirectionLocked = true
		self._T.lockedAvengerDirX = dirX
		self._T.lockedAvengerMotionName = motionName
		self._T.isAvengerMotionPlaying = true
		self._T.avengerLockToken = (self._T.avengerLockToken or 0) + 1
		local myAvengerLockToken = self._T.avengerLockToken

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		-- (기능 수정) "방향키를 누르면서 쓰다 보니 모션이 자주 끊긴다 - 캐릭터 모션을 1.3배 오래 걸리게
		-- 해달라"는 요청 - playRate를 1.3으로 나눠 재생 시간을 1.3배 늘린다.
		local playRate = 1.0 / mult / 1.3
		self._T.lockedAvengerPlayRate = playRate

		local motionEvent = ActionStateChangedEvent(motionName, motionName, playRate, SpriteAnimClipPlayType.Onetime)
		body:SendEvent(motionEvent)
		log("[Avenger] PlayAvengerMotion sent: " .. tostring(motionName) .. " playRate=" .. tostring(playRate))

		-- 모션 재생 자체(포즈 유지)는 투사체가 발사되는 시점((0.6+0.2)*mult, 기모으는 딜레이와 동일하게
		-- 맞춤)에 끝나지만, 이동 잠금(방향 고정)은 스킬 재사용 대기시간 전체(0.85*mult, SkillManager
		-- 쿨다운과 동일)까지 유지한다.
		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isAvengerMotionPlaying = false
		end, (0.6 + 0.2) * mult)

		_TimerService:SetTimerOnce(function()
			if self._T.avengerLockToken ~= myAvengerLockToken then return end
			self._T.isAvengerDirectionLocked = false
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.85 * mult)
	end

	@ExecSpace("Server")
	method void RestoreAvengerControl(integer moveLockToken)
		-- 기모으는 딜레이가 끝나 투사체가 발사된 직후 컨트롤러를 되돌린다. 홀드 지속발동으로 더 최근 시전이
		-- 이미 다시 잠가둔 상태라면(토큰 불일치) 여기서 섣불리 풀지 않는다.
		if self._T.avengerMoveLockToken ~= moveLockToken then return end
		self._T.isAvengerMovementLocked = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingAvengerWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- (기능 추가) "다른 스킬들을 사용하고 난 다음도 모두 숨고르기 모션을 3번 하도록 해달라"는 요청 -
		-- 컨트롤이 복구된 이 시점에 공용 숨고르기(PlayBreather)를 시작한다.
		self:PlayBreather(self.Entity, self._T.pendingAvengerDirX or 1)
	end

	@ExecSpace("ServerOnly")
	method void SpawnAvengerProjectile(string ballRuid, number combatPower, number dirX, number dirY)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self._T.avengerCount = (self._T.avengerCount or 0) + 1
		local name = "avenger_" .. tostring(self.Entity.Name) .. "_" .. tostring(self._T.avengerCount)
		-- 발쪽(원점)이 아니라 몸통 중심 높이에서 날아가도록 y를 올린다 (다른 화살류 스킬과 동일한 body-center 기준값 0.35).
		-- (기능 수정) "투사체의 y값을 원상복귀해달라"는 요청 - 낮추는 대신 이펙트(954896b2...) 쪽만 내린다.
		local myPos = self.Entity.TransformComponent.WorldPosition
		local proj = _SpawnService:SpawnByModelId("avengerprojectile", name, Vector3(myPos.x, myPos.y + 0.35, myPos.z), map)
		if not isvalid(proj) then
			log_warning("[PlayerAttack] Avenger 투사체 스폰 실패")
			return
		end

		local sprite = proj.SpriteRendererComponent
		if isvalid(sprite) then
			sprite.SpriteRUID = ballRuid
		end

		-- 불의 영역/빙하지대 프록용 시전자 참조를 판정 컴포넌트에 새겨준다.
		---@type AvengerProjectileAttack
		local projAtk = proj:GetComponent("script.AvengerProjectileAttack")
		if projAtk ~= nil then projAtk.OwnerEntity = self.Entity end
		---@type AvengerProjectile
		local projComp = proj:GetComponent("script.AvengerProjectile")
		if isvalid(projComp) then
			projComp.CombatPower = combatPower
			projComp.CritRate = self:GetServerCritRatePercent()
			-- 쉐도우 파트너 활성 여부를 원본 투사체에 새겨둔다 - 히트 시 원본+보너스(타수 2배) 합산과 2줄 표시에 쓰인다.
			projComp.ShadowEchoOn = self._T.shadowPartnerActive == true
			-- 지금 적용 중인 데미지 스킨(블리자드 중이면 얼음 스킨)을 발사체에 새겨준다 - 수동 표시에 쓰인다.
			projComp.DamageSkinRUID = self:GetHitDamageSkinId()
			projComp:Fire(dirX, dirY)
		end

		self:SpawnShadowEchoArrowProjectile("avengerprojectile", "script.AvengerProjectile", ballRuid, Vector3(myPos.x, myPos.y + 0.35, myPos.z), dirX, dirY, combatPower)
	end

	@ExecSpace("Multicast")
	method void PlayAvengerCastEffect(Entity attacker, string effectRuid, number dirX)
		-- 사용자 몸 쪽에서 1회 재생되는 시전(차지) 이펙트 + 사운드. (기능 수정) "954896b2...의 값을
		-- 내려야 한다"는 요청 - 기존 0.15보다 더 내려 0.0(몸통 중심)으로 맞춘다. 회전/방향별 오프셋
		-- 없이 항상 같은 고정 위치에서 좌우 반전만 적용한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		-- (기능 수정) "954896b2...를 1.3배 빨리 진행해달라"는 요청 - PlayRate 옵션으로 이펙트 재생 속도를 올린다.
		local castOptions = { ["FlipX"] = dirX > 0, ["PlayRate"] = 1.3 }
		local serial = _EffectService:PlayEffectAttached(effectRuid, attacker, Vector3(0, 0.0, 0), 0, Vector3(1, 1, 1), false, castOptions)
		-- 쉐도우 파트너: 같은 시전 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
		local echoSerial = self:EchoShadowSkillEffectAttached(effectRuid, attacker, Vector3(0, 0.0, 0), 0, Vector3(1, 1, 1), castOptions, dirX)
		-- (기능 추가) "사용시 사운드입니다" 요청 - 스킬 사용 시점에 1회 재생.
		_SoundService:PlaySound("28d565bf11b242f8b55b05c1fe252b69", 1.0)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
			if echoSerial ~= 0 then
				_EffectService:RemoveEffect(echoSerial)
			end
		end, 1.0)
	end

	-- 어썰터 전용 판정 범위(전방위) 안의 살아있는 script.Monster 중 가장 가까운 하나를 찾는다.
	-- 범위는 드래곤 로어(가로 15.0, 세로 7.5)의 1/5(가로 3.0, 세로 1.5) - 사용자 요청.
	-- (기능 수정) "사거리를 전방으로만 하고 3배 늘려달라"는 요청 - 기존 전방위 판정(가로 3.0/세로 1.5)을
	-- 캐릭터가 바라보는 방향(dirX) 전방으로만 판정하도록 바꾸고 3배(가로 9.0/세로 4.5)로 늘린다.
	method Entity FindAssaulterTarget(Vector2 fromPos, number dirX)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return nil end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local nearest = nil
		local nearestDist = 999999
		-- (기능 수정) "위아래 사거리를 2.0으로 해달라"는 요청 - 세로 판정을 2.0으로 늘린다(가로는 그대로).
		local xReach = 9.0
		local yHalfHeight = 2.0
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if dx * dirX >= 0 and math.abs(dx) <= xReach and math.abs(dy) <= yHalfHeight then
					local dist = math.sqrt(dx * dx + dy * dy)
					if dist < nearestDist then
						nearestDist = dist
						nearest = mc.Entity
					end
				end
			end
		end
		return nearest
	end

	@ExecSpace("ServerOnly")
	method void AttackAssaulter(number combatPower)
		-- 어썰터: 캐릭터가 사라졌다가 0.25초 뒤 가장 가까운 적을 통과한 뒤쪽(진행 방향으로 더 나아간 자리)에
		-- 나타나며 그 적과 주변 적들(최대 6명)을 찌른다. 사라지는 자리에 78ea5621...(대상이 왼쪽=그대로/오른쪽=반전),
		-- 나타나는 자리에서 손을 바닥에 짚는 착지 모션(prone) + 맞은 대상들 위치마다 흑백톤 히트 이펙트(5fd114...)를 재생한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isAssaulting then
			log("PlayerAttack: AttackAssaulter 요청 차단됨(이미 진행 중)")
			return
		end

		local worldPos = self.Entity.TransformComponent.WorldPosition
		local originPos = Vector2(worldPos.x, worldPos.y)
		local playerCtrl0 = self.Entity.PlayerControllerComponent
		local facingDirX = (isvalid(playerCtrl0) and playerCtrl0.LookDirectionX >= 0) and 1 or -1
		local target = self:FindAssaulterTarget(originPos, facingDirX)
		local userId = self.Entity.PlayerComponent.UserId
		if target == nil then
			log("PlayerAttack: AttackAssaulter 실패 - 사거리 내 대상 없음")
			-- (기능 추가) "범위 내 타겟이 없으면 사용이 되지 않아야 한다"는 요청 - 클라이언트에 실패를
			-- 알려 쿨타임이 소모되지 않도록 한다.
			self:NotifyAssaulterResult(false, userId)
			return
		end
		self:NotifyAssaulterResult(true, userId)

		self._T.isAssaulting = true
		self._T.pendingAssaulterCombatPower = combatPower
		-- 시전 세대 번호 - 연속 시전 시 이전 시전의 컨트롤 복구 타이머(0.5초)가 새 시전 도중에
		-- 끼어들어 컨트롤을 되살리지 않도록 구분하는 용도.
		self._T.assaulterCastSerial = (self._T.assaulterCastSerial or 0) + 1

		local targetPos = target.TransformComponent.WorldPosition
		local dirX = (targetPos.x >= originPos.x) and 1 or -1
		self._T.pendingAssaulterTarget = target
		self._T.pendingAssaulterDirX = dirX

		local playerCtrl = self.Entity.PlayerControllerComponent
		-- (버그 방지) 연속 시전(체인) 중에는 직전 시전이 이미 컨트롤을 꺼둔 상태(Enable=false)라
		-- 그대로 캡처하면 마지막 복구 때 컨트롤이 영영 안 살아난다 - 체인의 첫 시전에서 캡처한
		-- 원래 값을 유지한다.
		if not self._T.assaulterControlSuppressed then
			self._T.pendingAssaulterWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
			self._T.assaulterControlSuppressed = true
		end
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		self:PlayAssaulterVanishEffect(self.Entity, Vector3(originPos.x, originPos.y, 0), dirX)

		-- (기능 수정) "0.5초 뒤 나타나면서 데미지를 주던 것을 0.25초로 바꿔달라"는 요청.
		_TimerService:SetTimerOnce(function()
			self:ReappearAssaulter()
		end, 0.25)
	end

	@ExecSpace("Client")
	method void NotifyAssaulterResult(boolean success)
		-- 어썰터 발동 성공/실패를 시전한 클라이언트에게만 알려, 실패 시(사거리 내 대상 없음) 스택/쿨타임
		-- UI가 소모되지 않도록 SkillManager에 전달한다.
		_SkillManager:OnAssaulterResult(success)
	end

	@ExecSpace("Client")
	method void NotifyAssaulterChainReady()
		-- 착지(순간이동 완료) 시점을 시전한 클라이언트에게만 알린다 - 어썰터만은 착지 즉시 딜레이 없이
		-- 연속 시전할 수 있게 하기 위한 신호 (SkillManager.OnAssaulterChainReady에서 잠금 해제).
		_SkillManager:OnAssaulterChainReady()
	end

	@ExecSpace("Multicast")
	method void PlayAssaulterVanishEffect(Entity attacker, Vector3 originPos, number dirX)
		-- 사라지는 연출: 아바타를 투명화하고, 원래 있던 자리에 78ea5621...을 1회 재생한다.
		-- 대상이 왼쪽에 있으면(dirX<0) 그대로, 오른쪽에 있으면(dirX>0) 좌우 반전.
		-- (기능 수정) "시작이펙트는 이동 후에도 캐릭터를 따라오지 말고 이동한 그 자리에 남아야 한다"는
		-- 요청 - 캐릭터에 부착(PlayEffectAttached)하면 순간이동할 때 이펙트도 같이 딸려가버리므로,
		-- 캐릭터가 사라지기 직전의 월드 좌표에 고정 재생(PlayEffect)한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		-- (기능 추가) "스킬 사용 즉시 사운드"를 넣어달라는 요청 - 도착 사운드와 별개로, 시전 시작 시점에
		-- 1회만 재생한다(쉐도우 파트너 에코는 없음 - 다른 즉시발동 캐스트 사운드들과 동일한 패턴).
		_SoundService:PlaySound("3cc6e9d3ad6b41fbbe2a6ab17b364b94", 1.0)
		local avatarRenderer = attacker.AvatarRendererComponent
		if isvalid(avatarRenderer) then
			avatarRenderer:SetAlpha(0, nil)
		end
		local options = { ["FlipX"] = dirX > 0 }
		local serial = _EffectService:PlayEffect("78ea5621bb574c8d8d7f84848262014d", attacker, originPos, 0, Vector3(1, 1, 1), false, options)
		-- 쉐도우 파트너: 사라지는 이펙트도 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫) - 이것도 고정 좌표 버전을 쓴다.
		local echoSerial = self:EchoShadowSkillEffect("78ea5621bb574c8d8d7f84848262014d", originPos, 0, Vector3(1, 1, 1), options, dirX)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
			if echoSerial ~= 0 then
				_EffectService:RemoveEffect(echoSerial)
			end
		end, 1.0)
	end

	@ExecSpace("Server")
	method void ReappearAssaulter()
		-- 0.25초 뒤 실제로 대상 뒤(진행 방향으로 더 나아간 자리)에 순간이동해 나타난다.
		local target = self._T.pendingAssaulterTarget
		local dirX = self._T.pendingAssaulterDirX or 1

		if not isvalid(target) then
			-- 대기하는 사이 대상이 죽거나 사라졌다면: 원래 자리에서 그냥 다시 나타난다.
			self:PlayAssaulterReappearEffects(self.Entity)
			self:RestoreAssaulterControl()
			self:NotifyAssaulterChainReady(self.Entity.PlayerComponent.UserId)
			return
		end

		-- (기능 추가) "대상 주변 적들도 최대 6명까지 데미지를 입히면서 히트이펙트를 달아달라"는 요청 -
		-- 썬더볼트와 동일한 패턴(위치 기반 탐색 후 동시 타격)으로, 주 대상의 위치를 중심으로 근처
		-- 적을 가까운 순으로 최대 6명까지 찾는다(주 대상 자신도 거리 0으로 포함됨).
		-- (요청) 착지 지점 계산에 써야 하므로 순간이동 전에 미리 찾는다.
		local targetPos = target.TransformComponent.WorldPosition
		local splashTargets = self:FindAssaulterSplashTargets(Vector2(targetPos.x, targetPos.y), 6)

		-- (요청) 착지 지점은 주 대상이 아니라 "이번에 맞는 적들 중 진행 방향으로 가장 먼 적"의
		-- 뒤쪽(+1.0)이다 - 캐릭터 1, 몬스터 3이면 4에 서는 규칙을 맞은 적 전원에 적용한 것.
		local farX = targetPos.x
		local farY = targetPos.y
		for _, st in ipairs(splashTargets) do
			if isvalid(st) then
				local sp = st.TransformComponent.WorldPosition
				if (sp.x - farX) * dirX > 0 then
					farX = sp.x
					farY = sp.y
				end
			end
		end

		local rb = self.Entity.RigidbodyComponent
		local map = self.Entity.CurrentMap
		if isvalid(rb) and isvalid(map) then
			local fh = map.FootholdComponent
			-- (기능 수정) "몬스터 뒤로 이동한 뒤 너무 가깝다 - 조금 더 이동시켜달라"는 요청 - 0.6 → 1.0.
			local BEHIND_OFFSET = 1.0
			local landX = farX + dirX * BEHIND_OFFSET
			local landY = farY
			if isvalid(fh) then
				local nearFh = self:FindNearbyFootholdAtX(fh, landX, farY, 1.2)
				if nearFh ~= nil then
					landY = nearFh:GetYByX(landX) + 0.05
				end
			end
			if isvalid(self.Entity.MovementComponent) then
				self.Entity.MovementComponent:Stop()
			end
			rb:SetWorldPosition(Vector2(landX, landY))
		end

		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) then
			-- (기능 수정) "이동 후 보는 방향을 바꾸지 말고 그대로 보게 해달라"는 요청 - 기존에는 착지 후
			-- 대상 쪽(-dirX)으로 돌아봤지만, 이제 이동(진행) 방향(dirX)을 그대로 유지한다.
			playerCtrl.LookDirectionX = dirX
		end

		self:PlayAssaulterReappearEffects(self.Entity)

		self:DealAssaulterHits(splashTargets)

		-- (기능 변경) 착지 즉시 어썰터만은 딜레이 없이 연속 시전할 수 있게 한다 (요청사항) -
		-- isAssaulting을 여기서 바로 풀고 시전한 클라이언트에 착지를 알린다(OnAssaulterChainReady).
		-- 이동/다른 스킬용 컨트롤 복구는 기존대로 0.5초 뒤 진행하되, 그 사이 새 어썰터 시전이
		-- 시작됐다면(세대 번호 불일치) 복구를 건너뛰어 새 시전을 방해하지 않는다.
		self._T.isAssaulting = false
		self:NotifyAssaulterChainReady(self.Entity.PlayerComponent.UserId)
		local mySerial = self._T.assaulterCastSerial
		_TimerService:SetTimerOnce(function()
			if self._T.assaulterCastSerial == mySerial then
				self:RestoreAssaulterControl()
			end
		end, 0.5)
	end

	-- 어썰터 착지 지점 주변의 살아있는 script.Monster를 가까운 순으로 최대 maxCount명까지 반환한다
	-- (썬더볼트의 FindThunderboltTargets와 동일한 구조 - 방향 무관, 위치 기반 박스 탐색).
	method table FindAssaulterSplashTargets(Vector2 fromPos, integer maxCount)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				if math.abs(dx) <= 2.0 and math.abs(dy) <= 1.5 then
					table.insert(candidates, { entity = mc.Entity, dist = math.sqrt(dx * dx + dy * dy) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	@ExecSpace("Multicast")
	method void PlayAssaulterReappearEffects(Entity attacker)
		-- 나타나는 연출: 아바타를 다시 보이게 하고, swingO1 모션의 마지막 프레임(사진 속 자세 - 찌르듯
		-- 내지르는 동작의 끝 포즈)만 2초간 고정해서 보여준 뒤 원래 자세(stand1)로 복귀한다 + 도착 사운드
		-- (bbb8c45c...)를 재생한다. 맞은 대상들 각각의 히트 이펙트는 PlayAssaulterHitEffect에서 대상별로
		-- 따로 재생한다(요청: "대상 주변 적들도 최대 6명까지 데미지+히트이펙트").
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		-- 연속 시전(체인) 시 이전 시전의 stand1 복귀 타이머가 새 시전의 끝 포즈를 중간에 덮어쓰지
		-- 않도록 세대 번호로 구분한다.
		self._T.assaulterMotionSerial = (self._T.assaulterMotionSerial or 0) + 1
		local motionSerial = self._T.assaulterMotionSerial
		_SoundService:PlaySound("bbb8c45c0d21491a97deb363a9d95e0c", 1.0)
		local avatarRenderer = attacker.AvatarRendererComponent
		if isvalid(avatarRenderer) then
			avatarRenderer:SetAlpha(1, nil)
			-- (버그 수정) "이동 후 착지 모션이 없다" - 순간이동 직후 같은 프레임에 모션을 보내면 텔레포트로
			-- 인한 위치 갱신(및 그로 인한 일시적 FALL 상태 전환)이 곧바로 이 one-shot 모션을 덮어써버리는
			-- 것으로 보인다. 위치가 안정된 뒤 보내도록 짧게 지연한다(0.1초).
			_TimerService:SetTimerOnce(function()
				if not isvalid(attacker) then return end
				local body = avatarRenderer:GetBodyEntity()
				if isvalid(body) then
					-- StartFrameIndex/EndFrameIndex에 총 프레임 수를 초과하는 큰 값을 넣으면 엔진이 실제
					-- 마지막 프레임 값으로 자동 보정한다(공식 문서 명시) - 두 값을 동일하게 최대치로 주면
					-- swingO1 애니메이션의 "끝 프레임 한 장"만 정지된 상태로 보여줄 수 있다.
					local motionEvent = ActionStateChangedEvent("swingO1", "swingO1", 1.0, SpriteAnimClipPlayType.Onetime, 2147483647, 2147483647)
					body:SendEvent(motionEvent)
				end
			end, 0.1)
			-- (기능 수정) "끝 모션의 길이를 1초 늘려달라"는 요청 - 1초 → 2초 고정 후 stand1로 복귀한다.
			_TimerService:SetTimerOnce(function()
				if not isvalid(attacker) then return end
				if self._T.assaulterMotionSerial ~= motionSerial then return end
				local body = avatarRenderer:GetBodyEntity()
				if isvalid(body) then
					local resetEvent = ActionStateChangedEvent("stand1", "stand1", 1.0, SpriteAnimClipPlayType.Loop)
					body:SendEvent(resetEvent)
				end
			end, 2.1)
		end
	end

	@ExecSpace("Multicast")
	method void PlayAssaulterHitEffect(Entity target, number dirX)
		-- 맞은 대상 한 명의 자리에 히트 이펙트(5fd114c9)를 원본 색 그대로 재생한다 - 주 대상/주변 적
		-- 모두 대상마다 따로 호출된다. (요청) 이펙트 방향은 몬스터가 아니라 "플레이어가 보는(돌진한)
		-- 방향"을 따라야 한다 - 대상에 부착(PlayEffectAttached)하면 몬스터의 좌우반전(Scale.x)을
		-- 물려받으므로, 부착 대신 대상의 현재 위치에 고정 재생하고 FlipX를 dirX로 직접 지정한다
		-- (사라지는 자리 이펙트와 같은 방식).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local mapEntity = self.Entity.CurrentMap
		if not isvalid(mapEntity) then return end
		-- (피드백) 실제로 보니 방향이 반대 - 반전 조건을 뒤집는다(dirX < 0일 때 FlipX).
		local options = { ["FlipX"] = dirX < 0 }
		local tp = target.TransformComponent.WorldPosition
		local pos = Vector3(tp.x, tp.y + 0.3, 0)
		local serial = _EffectService:PlayEffect("5fd114c93ac7453e9b54e228f2c62064", mapEntity, pos, 0, Vector3(1, 1, 1), false, options)
		-- 쉐도우 파트너: 같은 히트 이펙트를 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생.
		self:EchoShadowHitEffectAtPos("5fd114c93ac7453e9b54e228f2c62064", pos, 0, Vector3(1, 1, 1), options)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void DealAssaulterHits(table targets)
		-- 예약된 대상 전원(주 대상 + 주변 최대 6명)에게 같은 프레임 안에서 동시에 타격 판정과 이펙트를
		-- 발생시킨다 (썬더볼트의 DealThunderboltHits와 동일한 구조).
		if not isvalid(self.Entity) then return end
		local hitCount = 0
		for _, target in ipairs(targets) do
			if isvalid(target) then
				-- 이번 Attack() 호출은 이 대상 하나만 통과하도록 지정 (몬스터 밀집 지역에서 이웃까지
				-- 겹쳐 중복 피해가 들어가는 것을 방지 - IsAttackTarget의 assaulterCurrentTarget 체크 참고).
				self._T.assaulterCurrentTarget = target
				local pos = target.TransformComponent.WorldPosition
				local shape = CircleShape(Vector2(pos.x, pos.y), 0.6)
				local hitComps = self:AttackShadowSafe(shape, "skill.assaulter", target)
				local actuallyHit = false
				for _, hc in ipairs(hitComps) do
					if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
						actuallyHit = true
						break
					end
				end
				-- (기능 추가) "코마처럼 몬스터를 3초간 행동불능 상태로 만들고 b0bd80f44c...를 스턴 동안 띄워달라"는 요청 -
				-- 주 대상뿐 아니라 이번에 맞은 주변 적 전원에게 동일하게 적용한다.
				if actuallyHit then
					self:PlayAssaulterHitEffect(target, self._T.pendingAssaulterDirX or 1)
					self:PlayAssaulterStunEffect(target)
					self:ApplyAssaulterStun(target)
					hitCount = hitCount + 1
				end
			end
		end
		log("PlayerAttack: AttackAssaulter " .. tostring(#targets) .. "명 동시 타격, 실제 명중 " .. tostring(hitCount) .. "명")
	end

	@ExecSpace("ServerOnly")
	method void ApplyAssaulterStun(Entity target)
		-- 코마의 ApplyComaStun과 동일한 방식 - 몬스터 AI 추적/이동을 3초간 완전히 꺼서 행동불능으로 만든다.
		if not isvalid(target) then return end
		local aiChase = target.AIChaseComponent
		local wasAIEnabled = isvalid(aiChase) and aiChase.Enable
		if isvalid(aiChase) then
			aiChase.Enable = false
		end
		local movement = target.MovementComponent
		local wasMovementEnabled = isvalid(movement) and movement.Enable
		if isvalid(movement) then
			movement:Stop()
			movement.Enable = false
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(target) and isvalid(aiChase) and wasAIEnabled then
				aiChase.Enable = true
			end
			if isvalid(target) and isvalid(movement) and wasMovementEnabled then
				movement.Enable = true
			end
		end, 3.0)
	end

	@ExecSpace("Multicast")
	method void PlayAssaulterStunEffect(Entity target)
		-- 코마의 PlayComaStunEffect와 동일한 방식 - 대상 머리 위에 3초간 스턴 표시 이펙트(b0bd80f4...)를 띄운다.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local headY = 0.5
		local hit = target.HitComponent
		if isvalid(hit) then
			headY = hit.ColliderOffset.y + hit.BoxSize.y / 2
		end
		local serial = _EffectService:PlayEffectAttached("b0bd80f44c1543438ddf8c2c31a0a7ce", target, Vector3(0, headY, 0), 0, Vector3(1, 1, 1), true, {})
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 3.0)
	end

	@ExecSpace("Server")
	method void RestoreAssaulterControl()
		-- 착지 모션까지 끝난 뒤 컨트롤을 복구한다. 체인(연속 시전)의 마지막 복구 시점에만 호출되며,
		-- 다음 시전이 원래 컨트롤 값을 새로 캡처할 수 있도록 억제 플래그도 함께 푼다.
		self._T.isAssaulting = false
		self._T.assaulterControlSuppressed = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingAssaulterWasControllerEnabled then
			playerCtrl.Enable = true
		end
	end

	@ExecSpace("ServerOnly")
	method void AttackSpearBurst(number combatPower, number atkMultiplier, boolean enhanced)
		-- (기능 추가) "다른 스킬을 쓰면 숨고르기 모션은 중지" 요청 - 이 스킬을 새로 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		-- 스피어 버스터: 타격감을 위해 "3번 찌르는" 스킬로 재설계한다(더블스탭과 동일하게 대상
		-- 하나당 실제 판정을 3회 진행) - 찌르기 자세 모션(시전 즉시) + 찌르는 이펙트 3종(852883a5→
		-- 3c2ee6e6→521bf9f6) + 고정해둔 대상 전원에 대한 실제 데미지 판정(DealSpearBurstStabWave,
		-- 데미지 표시 3줄 + 피격 이펙트 84c06a06 + 몬스터 피격음)은 스킬 사용 damageStartDelay=0.7s
		-- 뒤 + 0.1s/0.2s*mult에 진행되고, 찌르는 이펙트 3종은 그와 별개로 스킬 사용 즉시
		-- (effectStartDelay=0.0s) + 0.1s/0.2s*mult에 진행된다(요청: "852883a5 등 3종 찌르기 이펙트를
		-- 스킬 사용 즉시 보여주는 걸로 우선"). → 3타 판정 이후 여유를 두고 컨트롤 복구.
		-- 모든 리소스는 왼쪽을 보는 기준으로 제작돼, 오른쪽을 보고 있으면(dirX>0) 좌우 반전(FlipX) +
		-- 위치 반전이 필요하다.
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isSpearBursting then
			log("PlayerAttack: AttackSpearBurst 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isSpearBursting = true
		self._T.pendingSpearBurstCombatPower = combatPower
		-- (4차 패시브) 어드밴스드 스피어 버스터 보유 여부. 이펙트 색(검정/하양/빨강 조화)에 쓰인다.
		-- 데미지 1.5배는 SkillManager가 combatPower를 미리 1.5배로 올려 넘기므로 여기선 색상용으로만 보관.
		self._T.spearBurstEnhanced = (enhanced == true)

		local mult = math.max(atkMultiplier or 1.0, 0.001)
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingSpearBurstDirX = dirX
		self._T.pendingSpearBurstWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 대상을 시전 시작 시점에 한 번만 찾아 고정한다(더블스탭/럭키세븐과 동일한 방식) - 드래곤머리가
		-- 발사되는 1.1초 시점까지 몬스터가 다른 공격으로 죽어 후보에서 빠지는 것을 방지한다.
		-- (기능 추가) "전방 2.5·상하 1.2로 해달라"는 요청으로 스피어 버스터 전용 탐색 범위를 직접 지정한다.
		-- 슬래쉬블래스트 쪽 호출부는 기존 값(2.0/1.0)을 그대로 유지하므로 이 변경은 스피어 버스터에만 적용된다.
		local worldPos = self.Entity.TransformComponent.WorldPosition
		self._T.spearBurstLockedTargets = self:FindSlashBlastTargets(Vector2(worldPos.x, worldPos.y), dirX, 3, 2.5, 1.2)

		-- 날개 이펙트는 진짜 라이브 트윈이 가능한 전용 엔티티(SpearBurstFadingEffect)로 재생한다
		-- (PlayEffectAttached 재생-재생 반복 방식은 깜빡임을 완전히 없앨 수 없어 실측 확인됨).
		-- 캐릭터의 자식 엔티티로 스폰해(로컬 오프셋 좌표) 캐릭터가 움직여도 같이 따라오게 한다 -
		-- 이전에는 맵의 자식으로 스폰 시점 월드좌표에 고정돼, 캐릭터가 움직이면 이펙트만 그 자리에 남는
		-- 문제가 있었다. X는 등 쪽으로 살짝만 떨어지도록 바라보는 방향 반대쪽으로 오프셋(-0.2*dirX, 기존
		-- -0.4에서 캐릭터 쪽으로 더 붙임)을 주고, Y는 등/어깨보다 살짝 낮게(0.05) 내렸다. 존재 시간(hold+tween)은
		-- 기존 0.3+0.3(총 0.6초)에서 1.5배인 0.45+0.45(총 0.9초)로 늘렸다.
		-- (4차 패시브) 강화 시 날개도 전용 아트로 교체. 과거엔 원본 파랑→검정 재색본(d536d11c)이었으나
		-- 사용자가 새로 그린 "스피어버스터 강화" 전용 날개 아트(160x192, 중심피벗)로 대체한다.
		local wingRuid = (enhanced == true) and "8da209f377f249f292e1d0c50c928683" or "c7051cc242c54208a7c22df2b4bcc28e"
		-- (버그 수정) 날개 위치는 강화 여부에 따라 분리한다. 두 아트는 알파(실루엣)가 픽셀 단위로
		-- 완전히 동일한데(실측: 원본 프레임 48fefc50과 강화본 008.png의 알파 diff=0) 피벗이 달라서
		-- 같은 좌표에 두면 화면에서 어긋난다 - 원본 클립은 WZ 피벗(x=56, y=-3 / 160x192)이고 강화
		-- 아트는 asset 업로드 기본값인 중심피벗이다.
		-- (실측) 같은 로컬좌표(0,3)에 나란히 스폰해 화면 픽셀을 비교한 결과, 강화본이 원본보다
		-- 화면 기준 왼쪽 35px · 아래 139px에 그려졌다(맵 스케일 138.3px/월드유닛 → 월드 0.253 / 1.005).
		-- 아래 wingEnhOffsetX/Y가 정확히 그 차이를 되돌려 강화 날개가 원본 날개와 완전히 겹치게 한다.
		-- FlipX(dirX>0)일 때는 피벗 기준으로 좌우가 뒤집히므로 X 보정 부호도 dirX로 뒤집는다.
		-- (기능 추가) "원본 파란 날개가 캐릭터 머리 위로 떠 있다 - 유저 위치까지 내려달라"는 피드백:
		-- 원본 날개는 이미지 하단이 캐릭터 발밑(원점) 기준 +0.17, 상단이 +1.95라 몸통이 아니라 머리
		-- 위쪽에 떠 있었다. 기준 y를 0.05 → -0.65로 0.7만큼 내려 날개 이미지 중앙(높이 1.79)이
		-- 캐릭터 몸통 중앙(≈+0.36)에 오도록 맞췄고, 이어서 "조금 더 위로"(+0.25) → "0.5 더 위로"(+0.5)
		-- → "0.4로" → "0.1로" → 최종 "0으로" 피드백을 거쳐 0으로 정착했다(날개 하단이 발밑 +0.12,
		-- 상단 +1.90, 중앙 ≈+1.01). 강화 날개도 같은 기준에서 위 보정만 더한다.
		local wingBaseY = 0.0
		local wingEnhOffsetX = (enhanced == true) and (-0.253 * dirX) or 0
		local wingY = (enhanced == true) and (wingBaseY + 1.005) or wingBaseY
		-- (기능 추가) "날개를 캐릭터쪽으로 dx를 조금 붙여달라"는 피드백으로 등 쪽 오프셋을 0.2 → 0.1로
		-- 절반만큼 더 캐릭터에 붙였다(0.4 → 0.2에 이은 두 번째 조정). 강화 날개의 wingEnhOffsetX는
		-- 두 아트의 피벗 차이를 되돌리는 보정값이라 여기서 건드리지 않는다 - 이 기준 오프셋만 옮기면
		-- 원본/강화 날개가 계속 같은 위치에 겹친 채로 함께 이동한다.
		-- 아래 쉐도우 파트너 복제본도 같은 기준값을 써야 하므로 변수로 뽑아둔다.
		local wingBaseX = -0.1 * dirX
		self:SpawnSpearBurstFadingEffect(
			wingRuid, Vector2(wingBaseX + wingEnhOffsetX, wingY), dirX > 0,
			1.0, 1.0, 1.0, 0.0, 0.45, 0.45, -1, false, "", 0, 0, 0, 0
		)
		-- (버그 수정) "쉐도우 파트너가 스피어버스터의 날개 이펙트는 따라하지 않는다" - 이 날개 이펙트는
		-- 다른 스킬 이펙트들과 달리 EchoShadowSkillEffectAttached(찌르기 이펙트 3종 등이 쓰는 공용
		-- 그림자 복제 경로)를 거치지 않고 SpawnSpearBurstFadingEffect라는 전용 라이브 트윈 엔티티로
		-- 직접 재생되고 있어, 그림자 몫 복제 호출 자체가 빠져 있었다. 다른 그림자 복제 이펙트와 동일한
		-- 관례(x축 뒤쪽으로 추가 오프셋 -0.45*dirX, 투명도 70%)를 그대로 적용해 별도로 한 번 더 재생한다.
		if self._T.shadowPartnerActive then
			self:SpawnSpearBurstFadingEffect(
				wingRuid, Vector2(wingBaseX - 0.45 * dirX + wingEnhOffsetX, wingY), dirX > 0,
				1.0, 1.0, 0.7, 0.0, 0.45, 0.45, -1, false, "", 0, 0, 0, 0
			)
		end
		-- 몸쪽 마법진 이펙트(176da561...)도 전용 엔티티(SpawnSpearBurstFadingEffect)로 재생해 투명도 50%→0%로
		-- 서서히 사라지면서 살짝 커지는 라이브 트윈을 재현한다 - PlayEffectAttached로 한 번 바꿨었지만
		-- 그러면 이 트윈 자체가 불가능해서(정적 1회 재생만 지원) 되돌렸다.
		-- (실측 이력) orderInLayer -1~-20은 캐릭터보다 뒤로 가지 않고, -30은 세션에 따라 보였다 안 보였다
		-- 하는 불안정한 값, -40 이하는 지형보다도 뒤로 밀려 항상 안 보였다 - 그래서 한 번은 -20(캐릭터
		-- 기준으로는 딱히 뒤도 아니지만 항상 보이는 안전값)으로 고정했었다. 이번 피드백은 "다른 이펙트(날개,
		-- 찌르는 이펙트 3종)와 겹칠 때 마법진이 앞에 보여야 한다"는 것으로, 그 이펙트들은 PlayEffectAttached
		-- 기본값(OrderInLayer 0 근방)을 쓰므로 마법진을 그보다 높은 양수로 올려 확실히 앞에 오도록 한다.
		-- (버그 수정) "마법진이 2번 재생된다"는 진짜 원인을 찾았다 - 애니메이션클립(176da561...)의
		-- RUID를 SpriteRUID에 그대로 넣으면 world용 SpriteRendererComponent엔 재생 방식(Loop/Onetime)을
		-- 제어하는 프로퍼티 자체가 없어(UI용과 달리) 엔진이 프레임을 계속 반복 재생했다. 대신 그 클립의
		-- 개별 프레임 스프라이트(마법진=d757a7ca..., 용머리=7d52e3968f...)를 직접 교체하는 방식으로
		-- 바꿔 반복 없이 정확히 한 번만 전환되게 한다.
		-- (기능 추가) 투명도 85%, 크기 75%→160%, 전체 속도 1.5배(0.6초, 각 구간 0.3초)로 조정.
		-- (버그 수정) "확대될 때 중앙에서 퍼지지 않고 한쪽에서 잡아당기듯 커진다" - 두 스프라이트의
		-- Pivot이 이미지 중앙이 아니라 좌하단 쪽으로 치우쳐 있어서였다(msw-search 실측: 마법진 pivot
		-- nx=0.6724,ny=0.1638, 116x116 → 중심오프셋(-0.20,0.39); 용머리 pivot nx=0.625,ny=0.1917,
		-- 168x120 → 중심오프셋(-0.21,0.37)). SpawnSpearBurstFadingEffect의 pivotOffset 인자로 넘겨
		-- 매 프레임 그만큼 반대로 위치를 보정해 이미지 중심이 고정된 채 커지도록 한다.
		-- (기능 추가) "좀 더 몸쪽 캐릭터 쪽으로 이동" - localOffset을 (0,0)에서 (0,0.25)로 올려 몸통
		-- 높이 쪽으로 옮겼다(추가 피드백으로 0.15→0.25로 한 번 더 올림). 투명도는 85%→60%로 낮췄고,
		-- 2번째 구간(용머리)이 95%만큼 커진 시점부터 투명도를 0%로 서서히 낮추는 처리는
		-- SpearBurstFadingEffect.mlua의 UpdateSplitGrowth에서 담당한다(StartAlpha=0.6 기준으로 페이드).
		-- (기능 추가) "버튼을 누르고 0.15초 뒤에 재생돼야 한다"는 피드백으로 스폰 자체를 0.15초 지연시켰다
		-- (날개 이펙트(c7051cc2)는 그대로 즉시 재생 - 이 마법진 이펙트만 지연).
		-- (되돌림) "캐릭터보다 앞은 Z-order(OrderInLayer)가 아니라 X축 이동으로 해야 한다"는 피드백으로
		-- OrderInLayer는 10으로 되돌리고(찌르기 3종의 OrderInLayer도 11로 함께 되돌림), 대신 localOffset.x를
		-- 캐릭터가 바라보는 방향(dirX)으로 0.2만큼 옮겨 앞쪽으로 이동시켰다.
		-- (기능 추가) "이펙트 속도를 50% 더 늘려달라(더 빠르게 커지고 더 빠르게 사라지도록)"는 피드백으로
		-- 전체 길이를 0.8→0.8/1.5초(≈0.533초)로 줄였다(1.5배 빠름).
		-- (기능 추가) "최대치를 10% 더 늘려달라"는 피드백으로 EndScale을 1.6→1.76(1.6*1.1)로 올렸다.
		-- (기능 추가) "Y축을 더 올려달라"는 피드백으로 localOffset.y를 0.25→0.35로 올렸다.
		-- (기능 추가) "커지는 속도를 5% 늦춰달라"는 피드백으로 전체 길이를 0.533→0.533*1.05(≈0.56초)로
		-- 늘렸다(5% 느리게).
		-- (기능 추가) "발동 시작 시간을 0.2초 더 미뤄달라"는 피드백으로 스폰 지연을 0.15→0.35초로 늘렸다.
		-- (4차 패시브) 어드밴스드 스피어 버스터 보유 시 마법진/용머리를 전용 아트로 교체한다.
		-- 과거엔 원본 파랑 클립을 "파랑→검정" 재색한 5a8f784/e831f448이었으나, 사용자가 새로 그린
		-- "스피어버스터 강화" 전용 아트(마법진 116x116, 용머리 168x120)로 대체한다.
		-- ⚠ pivot 주의: 원본 파랑 클립(d757a7ca/7d52e396)은 좌하단 치우친 pivot이라 split-growth가 중심에서
		-- 커지도록 pivotOffset(-0.20,0.39)/(-0.21,0.37) 보정이 필요했지만, 새 전용 아트는 asset 업로드 기본값인
		-- 중심피벗이라 보정이 필요 없다(0,0). enhanced 여부로 pivotOffset을 분기한다.
		local circleRuid = (enhanced == true) and "5b1685eba9af484cbcde8015ca7398f6" or "d757a7ca9e3b417fb2d0d5b725baa12c"
		local headRuid = (enhanced == true) and "3e2d1d048bb74bec8b9bd8966cde41ad" or "7d52e3968f954e2dabc8f5a050adcd40"
		local circlePivotX = (enhanced == true) and 0 or -0.20
		local circlePivotY = (enhanced == true) and 0 or 0.39
		local headPivotX = (enhanced == true) and 0 or -0.21
		local headPivotY = (enhanced == true) and 0 or 0.37
		_TimerService:SetTimerOnce(function()
			self:SpawnSpearBurstFadingEffect(
				circleRuid, Vector2(0.2 * dirX, 0.35), dirX > 0,
				0.75, 1.76, 0.6, 0.6, 0.0, 0.8 / 1.5 * 1.05, 10, true, headRuid,
				circlePivotX, circlePivotY, headPivotX, headPivotY
			)
		end, 0.35)
		-- 찌르는 이펙트 3종은 852883a5 → 3c2ee6e6 → 521bf9f6 순서대로 재생돼야 한다는 피드백으로,
		-- 동시 재생이 아니라 짧은 간격을 두고 순서대로 트리거한다. 타격감을 위해 "3번 찌르는 스킬"답게
		-- 데미지 판정과 무관하게 이 3번의 찌르기 각각에 공격 사운드를 재생한다(기존에는 시전 시점에
		-- 한 번만 재생돼 3번 찌르는 느낌이 안 산다는 피드백) - 사운드 호출은 각 PlaySpearBurst*Effect
		-- 메서드 안으로 옮겼다.
		-- (기능 추가) 이 3번의 찌르기 이펙트와 같은 타이밍에 실제 데미지 판정(DealSpearBurstStabWave)도
		-- 함께 진행해, 대상 몬스터의 데미지 표시 3줄 + 피격 이펙트 + 피격음이 이 3번의 순간에 맞춰
		-- 나도록 한다(요청: "3줄로 스킬 한번에 3대 때리는 느낌").
		-- (버그 수정) 이펙트 클립 자체(852883a5/3c2ee6e6/521bf9f6)의 0번 프레임이 msw-search 리소스
		-- 조회로 확인한 결과 4x4 사실상 투명 프레임이라, 이펙트 호출과 정확히 같은 프레임에 데미지를
		-- 넣으면 화면상 이펙트가 아직 안 보이는 상태에서 데미지가 먼저 들어간 것처럼 보였다(실측 확인).
		-- 이펙트 재생 자체(StartFrameIndex)는 원래대로 되돌리고, 대신 데미지 판정 쪽을 이펙트 호출
		-- 시점보다 이 투명 프레임 길이만큼(effectVisualDelay) 뒤로 미뤄 실제로 이펙트가 보이는 시점에
		-- 데미지가 들어가도록 한다.
		-- (기능 추가) 이펙트 시점과 데미지(히트) 시점을 하나의 hitStartDelay로 합쳐서 순차 조정해왔는데
		-- (0.8→0.4→0.1), "히트 속도는 0.7초 뒤로 하고 찌르기 3종 이펙트 시점은 그보다 0.5초 앞당겨
		-- 달라"는 피드백으로 다시 둘을 분리했다 - damageStartDelay(히트)=0.7, effectStartDelay(이펙트
		-- 3종)=damageStartDelay-0.5=0.2로 고정했었다.
		-- (기능 추가) "852883a5/3c2ee6e6/521bf9f6 이펙트 시점이 느리다 - 스킬버튼 누른 시점에서
		-- 0.2초 뒤로 해달라"는 피드백을 받았다. 계산상으로는 이미 0.2(damageStartDelay-0.5)였지만,
		-- damageStartDelay 파생값이 아니라 요청받은 절대값 그대로 명시적 리터럴로 고정해 앞으로
		-- damageStartDelay(히트 속도)만 따로 바뀌어도 이펙트 시점이 의도치 않게 함께 밀리지 않도록
		-- 한다.
		-- (되돌림) "852883a5/3c2ee6e6/521bf9f6 사이 간격을 늘리면 안 되고 다시 줄여야 한다"는
		-- 피드백으로 이펙트 3종 사이 간격을 0.2*mult/0.4*mult에서 다시 원래의 0.1*mult/0.2*mult로
		-- 되돌린다.
		-- (기능 추가) "852883a5와 c7051cc242c54208a7c22df2b4bcc28e(날개 이펙트, 시전 즉시 재생)
		-- 사이 간격을 절반으로 줄여달라"는 요청으로 한때 0.2 → 0.1로 줄였었으나, "그 간격은 다시
		-- 0.2초여야 한다"는 피드백으로 0.2로 되돌렸었다.
		-- (버그 수정) OrderInLayer로 마법진에 가려지는 문제로 착각했었으나, "852883a5는 날개 이펙트와
		-- 위치 자체가 달라 가려질 수 없다 - Z-order 문제가 아니라 보여지는 시점(딜레이) 자체가
		-- 문제다. 찌르기 이펙트 3종을 스킬 사용 즉시 보이는 것으로 우선 해보자"는 피드백으로
		-- effectStartDelay를 0(시전 즉시)으로 바꿨었다.
		-- (기능 추가) StartFrameIndex 수정으로 "852883a5 시작 시점이 스킬 사용 즉시로 바뀌었다"고
		-- 확인받은 뒤, "이 시작 시점에서 0.5초 후에 뜨는 것으로 바꿔달라"는 피드백으로
		-- effectStartDelay를 0 → 0.5로 조정한다.
		-- (기능 추가) "데미지가 들어가는 시점을 0.2초 앞당겨달라"는 피드백으로 damageStartDelay를
		-- 0.7→0.5로 줄였다(effectStartDelay는 그대로 0.5 유지 - 이제 데미지와 이펙트 시작이 같은
		-- 시점이 된다). SkillManager.mlua의 재사용 대기시간도 damageStartDelay와 반드시 동일해야
		-- 하므로 0.7→0.5로 함께 맞췄다.
		-- (버그 수정) "공격속도를 올려도 실제 공격 횟수(DPS)가 거의 안 오른다 - 파워스트라이크는
		-- 공속을 올리면 확실히 공격 횟수가 늘어난다"는 피드백. 원인은 damageStartDelay/effectStartDelay가
		-- atkMult와 무관한 고정값(0.5초)이었던 것 - 공속을 올려 mult가 작아져도 이 0.5초 고정 구간은
		-- 줄지 않아 스킬 전체 주기(SkillManager 쿨다운의 하한선)가 거의 안 줄었다. 다른 스킬들처럼
		-- 전체 주기가 mult에 비례하도록 두 값 모두 mult를 곱해 스케일링한다(공속을 올렸을 때 파워스트라이크와
		-- 동일한 비율로 스킬 전체 주기가 짧아지도록).
		-- (기능 추가) "날개가 생기고 다음 공격까지의 시간을 단축해달라 - stabT1 frame2가 재생될 때여야
		-- 한다"는 피드백. 날개 이펙트(c7051cc2)는 시전 즉시(t=0) 뜨고, 5단 조합 모션의 3번째 포즈인
		-- stabT1 frame2는 2 * poseInterval 시점에 재생된다(PlaySpearBurstStabMotion 참고). 그래서
		-- 고정값 0.5*mult이었던 두 딜레이를 그 포즈 시점에 정확히 맞춘다(0.5 → 0.288*mult).
		-- ⚠ poseInterval(0.144*mult)은 PlaySpearBurstStabMotion과 반드시 같은 값이어야 한다.
		-- 이 변경으로 3타가 모두(0.288 / 0.438 / 0.588 * mult) 모션 콤보(~0.72*mult) 안에 들어온다.
		local poseInterval = 0.144 * mult
		local damageStartDelay = 2 * poseInterval
		local effectStartDelay = 2 * poseInterval
		-- (기능 추가) "3종 찌르기 이펙트 간 시간 간격을 1.5배 늘려달라"는 피드백으로 간격 상수를
		-- 0.1/0.2*mult → 0.15/0.3*mult로 1.5배 늘렸다. 데미지 판정(DealSpearBurstStabWave) 타이밍도
		-- 화면 이펙트와 항상 함께 맞아야 하므로("3줄 데미지가 실제 3연타 이펙트와 같은 순간에 뜬다")
		-- 동일하게 1.5배로 같이 늘렸다.
		local enh = self._T.spearBurstEnhanced == true
		_TimerService:SetTimerOnce(function()
			self:PlaySpearBurstCircleEffect(self.Entity, dirX, enh)
			if enh then self:SpawnAdvSpearStabEffect(dirX, 1) end
		end, effectStartDelay)
		_TimerService:SetTimerOnce(function()
			self:DealSpearBurstStabWave(1, dirX)
		end, damageStartDelay)
		_TimerService:SetTimerOnce(function()
			self:PlaySpearBurstBuildupEffect1(self.Entity, dirX, enh)
			if enh then self:SpawnAdvSpearStabEffect(dirX, 2) end
		end, effectStartDelay + 0.15 * mult)
		_TimerService:SetTimerOnce(function()
			self:DealSpearBurstStabWave(2, dirX)
		end, damageStartDelay + 0.15 * mult)
		_TimerService:SetTimerOnce(function()
			self:PlaySpearBurstBuildupEffect2(self.Entity, dirX, enh)
			if enh then self:SpawnAdvSpearStabEffect(dirX, 3) end
		end, effectStartDelay + 0.3 * mult)
		_TimerService:SetTimerOnce(function()
			self:DealSpearBurstStabWave(3, dirX)
		end, damageStartDelay + 0.3 * mult)

		-- (사용자 실측 확정) 찌르기 모션은 단일 액션이 아니라 5개의 포즈를 순서대로 갈아끼우는 조합
		-- 모션이다 - stabT1 0/1/2 프레임 → stabTF 1프레임 → stabT2 2프레임(GetSpearBurstPoses 참고).
		-- (기능 추가) "모션이 즉시 시작해야 한다"는 피드백으로, 기존에 딜레이(0.55*mult 등)를 두고
		-- 타이머로 예약하던 것을 제거하고 시전 즉시(0초) 동기 호출로 바꿨다.
		self:PlaySpearBurstStabMotion(self.Entity, dirX, mult)

		-- (버그 수정) "반대 방향키를 누르고 있으면 찌르는 모션인 채로 뒤로 돌게 된다"는 피드백의 원인 -
		-- 컨트롤 복구(playerCtrl.Enable=true) 시점이 damageStartDelay+0.3*mult 공식만으로 계산돼,
		-- PlaySpearBurstStabMotion의 3단계 콤보(beat1Hold=0.12*mult+beat2Hold=0.25*mult+beat3Hold=0.2*mult)가
		-- 아직 안 끝났는데도 먼저 풀려버리는 경우가 있었다. 두 시점 중 항상 더 늦은 쪽을 기준으로 삼도록
		-- math.max로 묶어, 모션이 실제로 다 끝난 뒤에만 컨트롤이 풀리게 한다(모션 콤보 상수는
		-- PlaySpearBurstStabMotion의 beat1Hold/beat2Hold/beat3Hold와 반드시 일치해야 한다 - DPS 스케일링을
		-- 위해 이제 세 값 모두 mult가 곱해진다).
		-- (버그 수정) "공속을 올려도 DPS가 파워스트라이크만큼 안 오른다"는 추가 피드백 - 안전 여유였던
		-- "+0.05"가 mult와 무관한 고정값이라 공속이 빨라질수록 전체 주기에서 차지하는 비중이 커져 DPS
		-- 스케일링을 계속 깎아먹고 있었다. 두 안전 여유 모두 mult에 비례하도록(0.05*mult) 바꿔, 최종
		-- 주기가 damageStartDelay/motionComboEnd와 마찬가지로 순수하게 0.85*mult 형태(파워스트라이크의
		-- 0.75*atkMult와 동일한 단일 비례식)가 되도록 한다.
		-- (기능 변경) 3박자 콤보(0.12+0.25+0.35)가 5단 조합 포즈(5 * poseInterval)로 바뀌었다. 전체
		-- 길이는 0.72*mult로 동일하다(PlaySpearBurstStabMotion의 poseInterval=0.144*mult).
		-- (기능 변경) damageStartDelay가 0.5*mult → 0.288*mult로 당겨지면서, 아래 math.max의 승자가
		-- damageStartDelay 쪽(0.638*mult)에서 모션 콤보 쪽(0.77*mult)으로 바뀌었다 - 즉 이제는
		-- "3타가 다 끝난 시점"이 아니라 "모션이 다 끝난 시점"이 컨트롤 복구를 결정한다. 전체 주기는
		-- 0.85*mult → 0.77*mult로 짧아진다(요청대로 다음 공격까지의 시간이 단축된다).
		local motionComboEnd = 5 * poseInterval
		local restoreDelay = math.max(damageStartDelay + 0.3 * mult + 0.05 * mult, motionComboEnd + 0.05 * mult)
		_TimerService:SetTimerOnce(function()
			self:RestoreSpearBurstControl()
		end, restoreDelay)
	end

	-- PlayEffectAttached 재생-재생 반복으로 알파/스케일 페이드를 흉내내면 깜빡임을 완전히 없앨 수
	-- 없다는 것이 실측 확인됐다(엔진에 재생 중인 이펙트의 실시간 트윈 API가 없음). 대신 전용 엔티티
	-- (RootDesk/MyDesk/Models/Effects/SpearBurstFadingEffect.model, script.SpearBurstFadingEffect)를
	-- 스폰해 그 엔티티 자신의 SpriteRendererComponent.Color/TransformComponent.Scale을 매 프레임
	-- 직접 갱신하는 진짜 라이브 트윈으로 대체한다 - 깜빡임 없이 부드럽게 페이드/스케일된다.
	-- 캐릭터와의 앞/뒤 순서는 orderInLayer로 결정한다. (실측 확인) 같은 SortingLayer(Default)에서
	-- Position.z만 다르게 줘서는 이 전용 엔티티가 캐릭터(아바타 바디)보다 확실히 뒤로 가지 않았다 -
	-- OrderInLayer는 Z보다 우선순위가 높은 정렬 기준이라, 캐릭터 기준값(0)보다 1 작은/큰 값을 명시적으로
	-- 줘야 확실하게 뒤/앞이 결정된다. -100/100처럼 극단값을 주면 캐릭터가 아니라 맵의 다른 레이어(배경/지형)
	-- 까지 밀려날 위험이 있어, 캐릭터 기준 ±1의 작은 값만 사용한다.
	-- localOffset: 맵이 아니라 캐릭터 엔티티(self.Entity)의 자식으로 스폰해서 캐릭터 로컬 좌표로 해석된다 -
	-- 이전에는 맵의 자식으로 스폰 시점 월드좌표에 고정돼, 캐릭터가 움직이면 이펙트만 그 자리에 남는(따라오지
	-- 않는) 문제가 있었다. 자식으로 붙이면 부모(캐릭터) Transform을 따라 매 프레임 자동으로 같이 움직인다.
	@ExecSpace("ServerOnly")
	method void SpawnSpearBurstFadingEffect(string ruid, Vector2 localOffset, boolean flipX, number startScale, number endScale, number startAlpha, number endAlpha, number holdDuration, number tweenDuration, integer orderInLayer, boolean useSplitGrowth, string secondRuid, number pivotOffsetX, number pivotOffsetY, number secondPivotOffsetX, number secondPivotOffsetY)
		-- 플레이어 자신에게 재생한다(아래 앵커 지정판에 위임).
		self:SpawnSpearBurstFadingEffectAt(ruid, localOffset, flipX, startScale, endScale, startAlpha, endAlpha, holdDuration, tweenDuration, orderInLayer, useSplitGrowth, secondRuid, pivotOffsetX, pivotOffsetY, secondPivotOffsetX, secondPivotOffsetY, self.Entity)
	end

	@ExecSpace("ServerOnly")
	method void SpawnSpearBurstFadingEffectAt(string ruid, Vector2 localOffset, boolean flipX, number startScale, number endScale, number startAlpha, number endAlpha, number holdDuration, number tweenDuration, integer orderInLayer, boolean useSplitGrowth, string secondRuid, number pivotOffsetX, number pivotOffsetY, number secondPivotOffsetX, number secondPivotOffsetY, Entity anchor)
		-- anchor: 이펙트를 붙일 대상 - 플레이어 본인 또는 용사 소환수(HeroSummon.CastSpearBurst).
		if not isvalid(anchor) then return end
		local fxEntity = _SpawnService:SpawnByModelId("spearburstfadingeffect", "SpearBurstFX", Vector3(localOffset.x, localOffset.y, 0), anchor)
		if not isvalid(fxEntity) then return end
		fxEntity:AddComponent("script.SpearBurstFadingEffect")
		local comp = fxEntity:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			-- (4차 패시브) 강화 이펙트는 이제 Color 틴트가 아니라 "파랑→검정 재색된 스프라이트"를 직접 넣으므로
			-- 여기서 추가 틴트를 걸지 않는다(이중으로 어두워짐 방지). 색은 넘겨받은 ruid 자체가 이미 결정한다.
			comp.ClipRUID = ruid
			comp.IsFlipX = flipX
			comp.StartScale = startScale
			comp.EndScale = endScale
			comp.StartAlpha = startAlpha
			comp.EndAlpha = endAlpha
			comp.HoldDuration = holdDuration
			comp.TweenDuration = tweenDuration
			comp.OrderInLayerValue = orderInLayer
			comp.UseSplitGrowth = useSplitGrowth
			comp.SecondClipRUID = secondRuid
			comp.PivotOffsetX = pivotOffsetX
			comp.PivotOffsetY = pivotOffsetY
			comp.SecondPivotOffsetX = secondPivotOffsetX
			comp.SecondPivotOffsetY = secondPivotOffsetY
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fxEntity) then
				fxEntity:Destroy()
			end
		end, holdDuration + tweenDuration + 0.2)
	end

	@ExecSpace("ServerOnly")
	method void SpawnAdvSpearStabEffect(number dirX, integer variant)
		-- (4차 패시브) 재색(파랑→검정, 흰색 유지) 찌르기 용머리를 캐릭터 앞에 짧게 재생한다. 원본 파랑 클립
		-- (852883a5/3c2ee6e6/521bf9f6)은 애니메이션클립이라 새 클립 생성 불가(asset은 sprite만) → 각 클립의
		-- 프레임2를 재색한 sprite 3종으로 3타를 서로 다르게 재생한다(원본처럼 3개 머리로 보이도록).
		-- 위치: 원본 클립은 pivot을 부착점에 두고 렌더하는데, 이 스프라이트는 중심피벗이라 이미지 중심이
		-- (width/2-pivot_x, height/2-pivot_y)만큼 어긋난다 → 그 값을 localOffset으로 보정해 원본 위치와 맞춘다.
		-- 원본 클립 부착 오프셋(852883a5=0, 3c2ee6e6/521bf9f6=0.15*dir)도 합산했다.
		-- (스피어버스터 강화) 찌르기 3종 용머리를 사용자가 새로 그린 전용 아트로 교체한다.
		-- 새 아트는 원본 클립 프레임과 정확히 동일한 크기(164x80/156x88/152x72)로 그려졌고 중심피벗으로
		-- 업로드됐다. ox/oy(위치 보정)는 기존 재색본과 동일 크기·중심피벗이므로 그대로 시작값으로 두고,
		-- 실제 화면과 대조해 필요 시 미세조정한다.
		local ruid = "9229298b79a64868b7cee06dc198edec"   -- 찌르기1 (164x80)
		local ox, oy = 1.08, 0.28
		if variant == 2 then
			ruid = "38361a0c587544dc8b6074920475db82"       -- 찌르기2 (156x88)
			ox, oy = 1.19, 0.01
		elseif variant == 3 then
			ruid = "38922d3cb17f44bcaddf7d6269e5d6d2"       -- 찌르기3 (152x72)
			ox, oy = 1.17, 0.37
		end
		self:SpawnSpearBurstFadingEffect(
			ruid, Vector2(ox * dirX, oy), dirX > 0,
			1.0, 1.0, 1.0, 0.0, 0.12, 0.14, 11, false, "", 0, 0, 0, 0
		)
	end

	@ExecSpace("Multicast")
	method void PlaySpearBurstCircleEffect(Entity attacker, number dirX, boolean enhanced)
		-- 찌르는 이펙트 3종 중 첫 번째로, 스킬을 사용하는 시점에 몸쪽 높이에서 뜨는 마법진(발밑이
		-- 아니라 몸통 높이여야 한다는 피드백으로 Y 오프셋을 제거했다).
		-- (버그 수정) "날개/마법진 이펙트가 사라진 뒤에야 찌르기 이펙트가 보인다"는 피드백 원인을
		-- 찾았다 - 몸쪽 마법진(176da561...)의 OrderInLayer가 10으로, 이 찌르기 이펙트 3종의 기본값
		-- (미지정 시 0 근방)보다 높아 마법진이 다 사라지기 전까지 찌르기 이펙트를 가리고 있었다.
		-- 찌르기 이펙트가 effectStartDelay(0.2초) 시점에 마법진과 무관하게 항상 눈에 보이도록,
		-- 마법진(10)보다 높은 OrderInLayer(11)를 명시적으로 지정해 항상 앞에 그려지게 한다.
		-- (버그 수정) 그 뒤에도 "이펙트가 보이는 속도가 전혀 변하지 않는다"는 피드백이 계속돼
		-- effectStartDelay를 0.8→0.4→0.2→0.1→0까지 바꿔봐도 체감이 그대로였다 - 원인은 스케줄링
		-- 딜레이가 아니라 이펙트 클립 자체였다. msw-search로 852883a5/3c2ee6e6/521bf9f6 세 클립을
		-- 모두 재조회한 결과 셋 다 0번 프레임이 4x4 투명 placeholder이고 실제 형상은 1번 프레임부터
		-- 시작한다 - 호출 시점과 무관하게 클립이 항상 이 투명한 0번 프레임부터 재생을 시작해, 실제
		-- 형상이 보이기까지 클립 자체의 0번 프레임 재생 시간만큼 항상 고정 지연이 있었던 것이다(그래서
		-- effectStartDelay를 아무리 줄여도 체감이 변하지 않았다). StartFrameIndex=1을 지정해 투명한
		-- 0번 프레임을 건너뛰고 실제 형상이 있는 1번 프레임부터 바로 재생되도록 한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local flipX = dirX > 0
		-- (기능 추가) 마법진 이펙트의 OrderInLayer를 10→15로 올리면서, 이 찌르기 이펙트가 다시 가려지지
		-- (되돌림) 마법진이 X축 이동으로 앞에 오도록 바뀌어 OrderInLayer 경쟁이 더 이상 없으므로
		-- 원래 값(11)으로 되돌린다.
		-- (4차 패시브) 강화 시 원본 파랑 클립은 재생하지 않는다(재색 스프라이트를 AttackSpearBurst가 별도 스폰).
		if not enhanced then
			local opts1 = { ["FlipX"] = flipX, ["OrderInLayer"] = 11, ["StartFrameIndex"] = 1 }
			_EffectService:PlayEffectAttached("852883a5b27442e88ac5a23f5a218a58", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, opts1)
			-- 쉐도우 파트너: 같은 찌르기 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
			self:EchoShadowSkillEffectAttached("852883a5b27442e88ac5a23f5a218a58", attacker, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), opts1, dirX)
		end
		self:PlaySpearBurstAttackSound(attacker)
	end

	method table GetSpearBurstPoses()
		-- (사용자 실측 확정) 스피어 버스터의 정확한 모션은 단일 액션 전체 재생이 아니라, 아래 5개의
		-- 포즈를 순서대로 갈아끼우는 조합 모션이다(새비지블로우 8단 조합과 동일한 방식).
		--   1~3번 → stabT1의 0 / 1 / 2 프레임
		--   4번    → stabTF의 1프레임(2번째)
		--   5번    → stabT2의 2프레임(3번째)
		-- 프레임 번호는 0-based(엔진의 StartFrameIndex와 동일 기준)이다.
		return {
			{ action = "stabT1", frame = 0 },
			{ action = "stabT1", frame = 1 },
			{ action = "stabT1", frame = 2 },
			{ action = "stabTF", frame = 1 },
			{ action = "stabT2", frame = 2 },
		}
	end

	method void ApplySpearBurstPose(string action, integer frameIdx)
		-- 지정한 액션의 frameIdx번 프레임 하나에 캐릭터를 사실상 정지시킨다.
		-- ApplySavageBlowPose에서 실측으로 확인된 두 함정을 그대로 회피한다:
		-- 1) StartFrameIndex == EndFrameIndex(구간 길이 0)면 엔진이 이벤트를 통째로 무시한다 →
		--    반드시 EndFrameIndex = StartFrameIndex + 1 로 구간을 준다.
		-- 2) Onetime 클립이 끝까지 재생되면 기본 stand 모션으로 되돌아간다 → PlayRate를 극단적으로
		--    낮춰(0.001) 그 프레임에서 멈춰 있게 하고, 다음 포즈는 타이머로 직접 갈아끼운다.
		if not self:IsClient() then return end
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		-- 상태 변경(IDLE 복귀 등)으로 포즈가 덮여쓰이면 HandleStateChangeEvent가 이 값으로 다시 적용한다.
		self._T.lockedSpearBurstAction = action
		self._T.lockedSpearBurstFrameIdx = frameIdx

		local motionEvent = ActionStateChangedEvent(action, action, 0.001, SpriteAnimClipPlayType.Onetime, frameIdx, frameIdx + 1)
		body:SendEvent(motionEvent)
		log("[SpearBurst] pose " .. tostring(action) .. " frame=" .. tostring(frameIdx))
	end

	@ExecSpace("Multicast")
	method void PlaySpearBurstStabMotion(Entity attacker, number dirX, number atkMultiplier)
		-- (기능 변경) 이전에는 단일 액션(stabT2)을 Onetime→ZigzagLoop→Onetime 3박자로 재생해 "마지막
		-- 모션 → 직전 모션 → 마지막 모션"을 흉내냈으나, 사용자가 원작의 정확한 모션을 실측 확정해줬다 -
		-- stabT1 0/1/2 프레임 → stabTF 1프레임 → stabT2 2프레임의 5프레임 조합이다. 그래서 재생 방식을
		-- 새비지블로우와 동일한 "포즈를 타이머로 하나씩 갈아끼우는" 조합 모션(GetSpearBurstPoses +
		-- ApplySpearBurstPose)으로 교체한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isSpearBurstDirectionLocked = true
		self._T.lockedSpearBurstDirX = dirX
		self._T.isSpearBurstMotionPlaying = true
		-- 재시전 시 이전 숨고르기가 남아있으면 새 콤보를 방해하지 않도록 즉시 정리한다.
		self._T.isBreatherPlaying = false

		local mult = math.max(atkMultiplier or 1.0, 0.001)

		-- 5개의 포즈를 같은 간격으로 하나씩 갈아끼운다. 기존 3박자 콤보의 전체 길이(0.12+0.25+0.35 =
		-- 0.72*배율)를 그대로 유지해 AttackSpearBurst의 restoreDelay 계산이 바뀌지 않도록 5등분했다
		-- (0.72/5 = 0.144). 공속을 올리면(mult가 작아지면) 콤보 전체가 비례해서 짧아진다 - 이 mult
		-- 비례는 DPS 스케일링을 위해 반드시 유지해야 한다.
		-- ⚠ 이 간격/포즈 개수는 AttackSpearBurst의 motionComboEnd와 반드시 일치해야 한다.
		local poseInterval = 0.144 * mult
		local poses = self:GetSpearBurstPoses()
		for i, p in ipairs(poses) do
			local pose = p
			local delay = (i - 1) * poseInterval
			if delay <= 0 then
				self:ApplySpearBurstPose(pose.action, pose.frame)
			else
				_TimerService:SetTimerOnce(function()
					self:ApplySpearBurstPose(pose.action, pose.frame)
				end, delay)
			end
		end

		-- 마지막 포즈가 화면에서 유지되는 시간까지 포함해(#poses * poseInterval) 방향/모션 잠금을 푼다.
		-- (기존 주석 유지) "모션보다 딜레이가 짧아 모션 중 방향전환이 된다"는 신고로 마지막 구간에는
		-- 여유가 필요하다 - 마지막 포즈도 다른 포즈와 동일하게 poseInterval만큼 유지된 뒤 풀린다.
		-- (주의) ShowDefaultWeaponEffects 복구는 기존과 동일하게 RestoreSpearBurstControl이 담당한다 -
		-- 여기서 먼저 켜면 컨트롤 복구 전 남은 구간에 기본 무기 이펙트가 잠깐 되살아난다.
		_TimerService:SetTimerOnce(function()
			self._T.isSpearBurstMotionPlaying = false
			self._T.isSpearBurstDirectionLocked = false
			self._T.lockedSpearBurstAction = nil
			log("[SpearBurst] 방향/모션 잠금 해제 t=" .. tostring(_UtilLogic.ElapsedSeconds))
		end, #poses * poseInterval)
	end

	@ExecSpace("Multicast")
	method void PlaySpearBurstBuildupEffect1(Entity attacker, number dirX, boolean enhanced)
		-- 찌르는 이펙트 3종 중 두 번째(852883a5 다음). 몸통 높이(Y=0)에서 재생된다.
		-- (버그 수정) PlaySpearBurstCircleEffect와 동일한 이유로 마법진(OrderInLayer=10)에 가리지
		-- 않도록 OrderInLayer=11을 명시한다. 3c2ee6e6도 0번 프레임이 4x4 투명이라 StartFrameIndex=1로
		-- 건너뛴다(PlaySpearBurstCircleEffect와 동일한 원인/조치).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local flipX = dirX > 0
		-- (기능 추가) "몸쪽으로 조금 땡겨달라"는 피드백으로 앞쪽 오프셋을 0.3→0.15로 줄였다. 마법진
		-- (되돌림) 마법진이 X축 이동으로 앞에 오도록 바뀌어 OrderInLayer는 원래 값(11)으로 되돌린다.
		if not enhanced then
			local opts2 = { ["FlipX"] = flipX, ["OrderInLayer"] = 11, ["StartFrameIndex"] = 1 }
			_EffectService:PlayEffectAttached("3c2ee6e636924e179cca843f819f9b30", attacker, Vector3(0.15 * dirX, 0, 0), 0, Vector3(1, 1, 1), false, opts2)
			-- 쉐도우 파트너: 같은 찌르기 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
			self:EchoShadowSkillEffectAttached("3c2ee6e636924e179cca843f819f9b30", attacker, Vector3(0.15 * dirX, 0, 0), 0, Vector3(1, 1, 1), opts2, dirX)
		end
		self:PlaySpearBurstAttackSound(attacker)
	end

	@ExecSpace("Multicast")
	method void PlaySpearBurstBuildupEffect2(Entity attacker, number dirX, boolean enhanced)
		-- 찌르는 이펙트 3종 중 세 번째(마지막). 몸통 높이(Y=0)에서 재생된다.
		-- (버그 수정) PlaySpearBurstCircleEffect와 동일한 이유로 마법진(OrderInLayer=10)에 가리지
		-- 않도록 OrderInLayer=11을 명시한다. 521bf9f6도 0번 프레임이 4x4 투명이라 StartFrameIndex=1로
		-- 건너뛴다(PlaySpearBurstCircleEffect와 동일한 원인/조치).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local flipX = dirX > 0
		-- (기능 추가) "몸쪽으로 조금 땡겨달라"는 피드백으로 앞쪽 오프셋을 0.3→0.15로 줄였다. 마법진
		-- (되돌림) 마법진이 X축 이동으로 앞에 오도록 바뀌어 OrderInLayer는 원래 값(11)으로 되돌린다.
		if not enhanced then
			local opts3 = { ["FlipX"] = flipX, ["OrderInLayer"] = 11, ["StartFrameIndex"] = 1 }
			_EffectService:PlayEffectAttached("521bf9f60cb94a7fb9890ba2e0ede109", attacker, Vector3(0.15 * dirX, 0, 0), 0, Vector3(1, 1, 1), false, opts3)
			-- 쉐도우 파트너: 같은 찌르기 이펙트를 x축 뒤쪽에서 투명도 70%로 복제 재생(그림자 몫 - 데미지 없음)
			self:EchoShadowSkillEffectAttached("521bf9f60cb94a7fb9890ba2e0ede109", attacker, Vector3(0.15 * dirX, 0, 0), 0, Vector3(1, 1, 1), opts3, dirX)
		end
		self:PlaySpearBurstAttackSound(attacker)
	end

	-- (버그 수정) 이전에는 @ExecSpace("Multicast")였는데, 이 메서드를 서버가 직접 부르지 않고
	-- PlaySpearBurstCircleEffect/BuildupEffect1/2(이미 Multicast로 각 클라이언트에서 실행 중인 메서드) 안에서
	-- 호출하는 구조로 바뀌면서, 클라이언트 실행 컨텍스트 안에서 또 다른 Multicast 메서드를 호출하는 셈이 돼
	-- 실제로는 아무 데도 전달되지 않고 조용히 무시됐다(로그로 실측 확인 - 호출은 되지만 재생 로그가 전혀
	-- 안 찍힘). Multicast는 서버가 직접 호출해야 클라이언트들로 퍼진다 - 이미 클라이언트에서 실행 중인
	-- 호출부에서는 어노테이션 없는(호출한 쪽에서 그대로 실행되는) 일반 메서드여야 한다.
	method void PlaySpearBurstAttackSound(Entity attacker)
		-- 공격 사운드(fcac442d...). 공격속도에 따른 재생 속도 변경은 소리가 이상하게 들린다는
		-- 피드백으로 제거하고, 다른 스킬과 동일하게 고정 속도로 재생한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("fcac442d953049d980da4b8d7bd766d8", 1.0)
		log("[SpearBurst] PlaySpearBurstAttackSound 재생됨 t=" .. tostring(_UtilLogic.ElapsedSeconds))
	end

	@ExecSpace("Server")
	method void RestoreSpearBurstControl()
		self._T.isSpearBursting = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingSpearBurstWasControllerEnabled then
			playerCtrl.Enable = true
		end
		if isvalid(self.Entity.AvatarRendererComponent) then
			self.Entity.AvatarRendererComponent.ShowDefaultWeaponEffects = true
		end

		local sc = self.Entity.StateComponent
		if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
			sc:ChangeState("IDLE")
			sc:ChangeState("MOVE")
			sc:ChangeState("IDLE")
		end

		-- (버그 수정) "idle 모션이 호출되는 순간 숨고르기로 전환되어야 하는데 안 된다"는 신고 - 처음엔 위
		-- 토글보다 먼저 PlayBreather(무장)를 호출해 HandleStateChangeEvent가 토글의 StateChangeEvent를 잡게
		-- 했는데, 실측 결과 이 서버 메서드 안에서 순서대로 보낸 Multicast RPC(PlayBreather)와 StateComponent
		-- 상태 동기화(위 ChangeState)가 서로 다른 네트워크 경로를 타 클라이언트 도착 순서가 보장되지 않았고,
		-- 실제로는 상태 동기화가 먼저 도착해 이벤트를 놓치고 5초 안전망 타이머로만 겨우 시작되는 문제가 있었다.
		-- 이 메서드는 서버가 위에서 토글을 "이미" 동기적으로 완료한 뒤이므로, 클라이언트의 이벤트를 기다릴
		-- 필요 없이 곧장 시작을 지시하는 전용 Multicast(PlayBreatherImmediate)를 쓴다 - 무장/이벤트 대기 없이
		-- 도착하는 즉시 재생한다.
		self:PlayBreatherImmediate(self.Entity, self._T.pendingSpearBurstDirX or 1)
	end

	@ExecSpace("Multicast")
	method void PlayBreatherImmediate(Entity attacker, number dirX)
		-- RestoreSpearBurstControl처럼 서버가 IDLE→MOVE→IDLE 토글을 이미 동기적으로 끝낸 뒤 호출하는 전용
		-- 경로. PlayBreather(무장 후 StateChangeEvent 대기)와 달리 곧장 재생을 시작한다 - 자세한 이유는
		-- RestoreSpearBurstControl의 주석 참고.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		self._T.breatherToken = (self._T.breatherToken or 0) + 1
		local myToken = self._T.breatherToken
		self:StartBreatherNow(attacker, myToken)
	end

	@ExecSpace("Multicast")
	method void PlayBreather(Entity attacker, number dirX)
		-- (기능 추가) "가만히 있을 때 기본모션으로 돌아갔다가 다시 숨고르기로 가서 불안정해 보인다 -
		-- 기본모션으로 바뀌는 타이밍에 숨고르기를 넣어달라"는 요청 - 고정 시간을 기다리는 대신, 각
		-- 스킬의 모션 정리용 IDLE→MOVE→IDLE 토글이 실제로 "IDLE"(기본 모션)로 전환되는 순간을 감지해
		-- 그 즉시 숨고르기로 덮어쓴다(HandleStateChangeEvent 참고 - 기본 모션이 화면에 보일 틈이 없다).
		--
		-- (버그 수정) "idle 모션이 호출되는 순간 숨고르기로 전환돼야 하는데 안 된다"는 신고 - 예전에는
		-- 여기 도착 시점에 CurrentStateName이 이미 "IDLE"이면 곧장 시작했는데, 파워스트라이크류 스킬은
		-- ATTACK으로 상태 전환을 아예 하지 않고 raw 모션 이벤트만 보내기 때문에(PlayAttackMotion 참고)
		-- 스킬을 시전하는 내내 CurrentStateName이 계속 "IDLE"로 남아있다 - 즉 "이미 IDLE"이 "정말로 기본
		-- 모션으로 복귀하는 순간"을 의미하지 않았다. 그 결과 이 즉시-시작 경로가 실제 모션 정리 토글
		-- (0.8*mult초 뒤)보다 훨씬 먼저 숨고르기를 시작시켰고, 뒤늦게 진짜 토글이 발생하면서 그 토글이
		-- 만드는 진짜 StateChangeEvent(IDLE)가 방금 시작한 숨고르기 alert 애니메이션을 덮어써 기본 모션으로
		-- 되돌려버렸다(겉보기엔 "숨고르기가 시작 안 됨"). 이제는 무조건 "무장(armed)"만 하고, 실제 시작은
		-- HandleStateChangeEvent가 진짜 IDLE 전환 이벤트를 잡는 시점에서만 한다 - 모든 스킬이 결국 이 토글을
		-- 거치므로(클라이언트 쪽이든, 스피어 버스터처럼 서버 쪽이든) 항상 이벤트가 온다. 혹시 어느 스킬이
		-- 이 토글 없이 DEAD 등으로 빠지는 경우를 대비해서만 넉넉한 안전망 타이머를 둔다(공격속도 배율
		-- 최댓값 3.0 기준 최대 토글 지연 0.8*3.0=2.4초보다 충분히 긴 5초).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end

		self._T.breatherToken = (self._T.breatherToken or 0) + 1
		local myToken = self._T.breatherToken
		self._T.isBreatherArmed = true
		self._T.breatherArmedAttacker = attacker

		_TimerService:SetTimerOnce(function()
			if self._T.breatherToken ~= myToken then return end
			if not self._T.isBreatherArmed then return end
			self._T.isBreatherArmed = false
			self:StartBreatherNow(attacker, myToken)
		end, 5.0)
	end

	method void StartBreatherNow(Entity attacker, integer myToken)
		-- PlayBreather가 IDLE 전환 감지(또는 안전망 타이머)로 판단한 시점에 실제로 alert 모션을 재생한다.
		-- (참고) 이 메서드는 @ExecSpace를 지정하지 않는다 - PlayBreather의 클라이언트 측 이벤트 핸들러/
		-- 타이머 콜백(이미 IsClient()를 통과한 상태) 안에서 호출되므로 그대로 같은 컨텍스트에서
		-- 실행돼야 한다. Multicast로 지정하면 그 안에서 재호출 시 실행되지 않는 문제가 실측 확인됐다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		self._T.isBreatherPlaying = true

		local breatherEvent = ActionStateChangedEvent("alert", "alert", 1.0, SpriteAnimClipPlayType.Loop)
		body:SendEvent(breatherEvent)
		log("[Breather] 숨고르기 시작 (alert, 3초 또는 다른 행동 시까지)")

		_TimerService:SetTimerOnce(function()
			if self._T.breatherToken ~= myToken then return end
			if not self._T.isBreatherPlaying then return end
			self._T.isBreatherPlaying = false
			-- (버그 수정) "스피어 버스터 사용 후 숨고르기가 계속 지속된다"는 신고 - 원인은 여기서
			-- ChangeState("IDLE") 한 번만 불렀던 것. 컨트롤 복구 시점(RestoreSpearBurstControl 등)에서
			-- 이미 IDLE→MOVE→IDLE 토글을 거쳐 CurrentStateName이 이미 "IDLE"인 상태였기 때문에, 같은
			-- 상태로 다시 ChangeState("IDLE")를 부르면 실제 상태 전이가 없어 StateChangeEvent가 발생하지
			-- 않고, body에 직접 보낸 "alert" Loop 애니메이션을 덮어쓸 계기가 전혀 생기지 않아 화면에서
			-- 영원히 반복 재생되는 상태로 남았다. 이 파일의 다른 곳(PlayAttackMotion 등)에서 이미
			-- 검증된 것과 동일하게 IDLE→MOVE→IDLE 강제 토글로 반드시 새 StateChangeEvent를 일으켜야
			-- AvatarStateAnimationComponent가 기본 stand/walk 클립을 다시 내보내 alert를 확실히 덮어쓴다.
			local sc = attacker.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
			log("[Breather] 숨고르기 자동 종료(3초 경과)")
		end, 3.0)
	end

	@ExecSpace("Multicast")
	method void StopBreather()
		-- (기능 추가) "움직이거나 다른 스킬을 쓰면 숨고르기 모션은 중지하여야 합니다"는 요청 - 각
		-- Attack* 스킬 진입 시점에 호출해 취소한다. IDLE 전환을 기다리는 중(isBreatherArmed)이든
		-- 재생 중(isBreatherPlaying)이든 상관없이 토큰을 무조건 올리고 두 플래그 모두 내려, 대기
		-- 중이던 시작(HandleStateChangeEvent의 IDLE 감지 / 0.3초 안전망 타이머)과 재생 중이던
		-- 자동종료 타이머를 모두 무력화한다.
		if not self:IsClient() then return end
		self._T.breatherToken = (self._T.breatherToken or 0) + 1
		self._T.isBreatherArmed = false
		if self._T.isBreatherPlaying then
			self._T.isBreatherPlaying = false
			log("[Breather] 숨고르기 중단(다른 스킬 사용)")
		end
	end

	-- 찌르는 이펙트 3종(852883a5/3c2ee6e6/521bf9f6)이 뜨는 매 순간(0.0s/0.1s/0.2s*mult)마다, 고정해둔
	-- 대상 전원(최대 3명)에게 한 번씩 실제 데미지 판정을 진행한다(hitIndex=1/2/3, "3번 찌르기").
	-- (실측 확인) 여러 대상이 같은 프레임에서 동시에 Attack()하면 히트 사운드가 하나로 합쳐지는
	-- 문제가 있었다(슬래쉬블래스트/스피어 버스터 멀티타깃 사례) - 대상마다 짧게(0.05초) 간격을 두고
	-- 순차 처리한다. 0.05초는 다음 찌르기 이펙트 타이밍(0.1초 간격)과 겹치지 않을 정도로 짧게 잡았다.
	@ExecSpace("ServerOnly")
	method void DealSpearBurstStabWave(integer hitIndex, number dirX)
		if not isvalid(self.Entity) then return end
		local targets = self._T.spearBurstLockedTargets or {}
		self:DealNextSpearBurstStabHit(targets, 1, hitIndex, dirX)
	end

	@ExecSpace("Server")
	method void DealNextSpearBurstStabHit(table targets, integer idx, integer hitIndex, number dirX)
		if idx > #targets then return end
		if not isvalid(self.Entity) then return end
		local target = targets[idx]
		if isvalid(target) then
			self:DealSpearBurstStabHit(target, dirX, hitIndex)
		end
		if idx < #targets then
			_TimerService:SetTimerOnce(function()
				self:DealNextSpearBurstStabHit(targets, idx + 1, hitIndex, dirX)
			end, 0.05)
		end
	end

	-- 대상 하나에게 스피어 버스터의 3연타 중 hitIndex번째 타격을 적중시킨다. 더블스탭과 동일하게
	-- Client 메서드(ShowSpearBurstStabDamageSkin)를 직접 호출하므로 ExecSpace도 더블스탭의
	-- DealDoubleStabHit과 동일하게 "Server"로 맞춘다.
	-- (버그 수정 이력 참고) 더블스탭에서, 같은 AttackComponent 인스턴스로 같은 대상에게 짧은 간격으로
	-- 반복 Attack()을 걸면 GetDisplayHitCount=0을 반환해도 엔진이 히트마다 자동 데미지 숫자를 하나씩
	-- 추가로 띄우는 문제가 실측 확인됐다 - 대상의 DamageSkinSpawnerComponent를 판정 직전 잠깐
	-- 떼었다가 붙이는 방식으로 해결했다. 스피어 버스터의 3연타도 동일한 반복-Attack() 패턴이라
	-- 같은 조치를 쓴다.
	@ExecSpace("Server")
	method void DealSpearBurstStabHit(Entity target, number dirX, integer hitIndex)
		if not isvalid(target) then return end
		self._T.spearBurstCurrentTarget = target
		---@type Monster
		local monsterComp = target:GetComponent("script.Monster")
		-- Attack() 호출 전에 미리 확인해둔다 - Monster.HandleHitEvent는 호출 시점에 이미 죽어있으면
		-- (IsDead) 자기 히트음을 건너뛰므로, 이 값을 "네이티브가 이미 히트음을 냈는지" 판단 기준으로 쓴다.
		local wasAlreadyDead = isvalid(monsterComp) and monsterComp.IsDead
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local targetSkinSpawner = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		if isvalid(targetSkinSpawner) then target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent") end
		local hitComps = self:Attack(shape, "skill.spearburst", CollisionGroups.HitBox)
		if not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then target:AddComponent("MOD.Core.DamageSkinSpawnerComponent") end
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		local damage = self._T.lastSpearBurstDamage or 0
		local spearBurstBaseCrit = self._T.lastSpearBurstIsCritical or false
		local bonus = self._T.shadowEchoBonus or 0
		local bonusCrit = self._T.shadowEchoBonusIsCritical or false
		if not actuallyHit then
			-- 더블스탭과 동일하게, 앞선 타격에 대상이 이미 죽어 판정 자체가 실패해도(콜라이더가 더
			-- 이상 걸리지 않음) 3줄이 항상 뜨도록 표시 전용 데미지를 동일 공식으로 새로 굴린다(실제
			-- Hp에는 영향 없음). CalcDamage의 skill.spearburst 분기와 반드시 같은 배율을 유지해야 한다.
			-- (버그 수정) 더블스탭/매직클로와 동일한 이유로, 이 경로도 크리티컬을 독립적으로 굴리고
			-- self._T.shadowEchoBonus의 stale 값 대신 쉐도우 파트너 보너스도 여기서 새로 굴린다.
			local critRate = self:GetServerCritRatePercent() / 100
			local critMult = (self._T.currentCritDamagePercent or 125) / 100
			local combatPower = self._T.pendingSpearBurstCombatPower or 0
			local mult = 0.1 + _UtilLogic:RandomDouble() * (0.2 - 0.1)
			-- 콤보 어택 버프 보너스도 실제 판정(CalcDamage)과 동일하게 표시 전용 값에 반영한다.
			damage = self:ApplyComboAttackBonus(math.floor(combatPower * mult))
			-- 백스탭도 실제 히트와 같은 시전 판정으로 얹는다 - 이 표시 전용 경로에 안 얹으면 앞선 타격에
			-- 대상이 죽은 뒤의 줄만 보너스가 빠져 "6줄 중 일부만 백스탭이 걸린 것처럼" 보인다.
			damage = self:ApplyBackstabBonus(damage, self.Entity, target, "skill.spearburst")
			spearBurstBaseCrit = _UtilLogic:RandomDouble() < critRate
			if spearBurstBaseCrit then damage = math.floor(damage * critMult) end
			bonus = 0
			bonusCrit = false
			if self._T.shadowPartnerActive then
				bonus = math.floor(damage * (0.55 + _UtilLogic:RandomDouble() * 0.10))
				bonusCrit = _UtilLogic:RandomDouble() < critRate
				if bonusCrit then bonus = math.floor(bonus * critMult) end
			end
		end
		self:ShowSpearBurstStabDamageSkin(target, damage, hitIndex, bonus, spearBurstBaseCrit, bonusCrit)
		-- (기능 추가) "타격음이 2배로 많이 들리게 해달라" 요청 - 쉐도우 파트너 보너스가 있으면 아래의
		-- 중복 방지 로직과 별개로 항상 추가 1회를 더 재생한다.
		if bonus > 0 then
			self:PlayShadowEchoHitSound(target)
		end
		-- 타격 이펙트는 실제 판정 성공 여부와 무관하게 매번 재생한다(항상 3번 느껴지도록).
		-- (스피어버스터 강화) 강화 시에는 원본 클립(84c06a06)에 검붉은 틴트를 씌우던 방식 대신,
		-- 사용자가 새로 그린 폴더 아트(원본 히트 클립 프레임 0/1/2의 재작화본)를 프레임 순서대로
		-- 재생한다 - "히트 이펙트가 폴더 안에 들어있던 이펙트가 아니다"는 피드백.
		if self._T.spearBurstEnhanced == true then
			-- (요청) 강화 히트 이펙트의 투명도는 70%(1.0 → 0.85 → 0.6 → 0.7로 확정).
			self:SpawnAdvSpearHitFrames(target, dirX, 0.7, 0)
			if self._T.shadowPartnerActive then
				-- 쉐도우 파트너 몫: 0.25초 뒤 한 번 더. 원래 "본체 100% : 잔상 70%"의 비율이었으므로
				-- 본체 값에 같은 비율(0.7 x 0.7)을 곱해, 잔상이 본체보다 진해지는 역전을 막는다.
				self:SpawnAdvSpearHitFrames(target, dirX, 0.49, 0.25)
			end
		else
			self:PlaySpearBurstHitEffect(target, dirX, hitIndex, false)
		end
		-- (버그 수정) 실제로 명중했고(actuallyHit) 대상이 이번 타격 전까지 살아있었다면
		-- Monster.HandleHitEvent(Monster.mlua, 이 스킬과 무관하게 항상 동작)가 이미 자기 히트음을
		-- 재생했으므로 여기서 또 재생하면 같은 히트에 소리가 2번 겹친다(실측 확인). 대상이 이미
		-- 죽어있었거나(3연타 중 첫 타에 죽어 HandleHitEvent가 IsDead로 건너뜀) 판정 자체가 실패한
		-- 경우에만 이 스킬 전용으로 직접 재생해 3번의 히트음이 항상 나도록 보충한다.
		if isvalid(monsterComp) and (not actuallyHit or wasAlreadyDead) then
			monsterComp:PlayHitSound()
		end
		log("[SpearBurst] DealSpearBurstStabHit hitIndex=" .. tostring(hitIndex) .. " actuallyHit=" .. tostring(actuallyHit) .. " wasAlreadyDead=" .. tostring(wasAlreadyDead) .. " damage=" .. tostring(damage))
	end

	@ExecSpace("Client")
	method void ShowSpearBurstStabDamageSkin(Entity target, integer damage, integer hitIndex, integer bonus, boolean baseIsCritical, boolean bonusIsCritical)
		-- 다른 스킬과 동일한 기본 히트 데미지 스킨(RUID)을 사용한다. 3번의 찌르기가 위/중간/아래로
		-- 나뉘어 3줄로 쌓인 것처럼 보이도록 세로 오프셋을 준다(더블스탭의 ±0.2 2줄 배치와 동일한 방식).
		if not isvalid(target) then return end
		local offsetY = 0.0
		local bonusGap = 0.15
		if bonus > 0 then
			-- (기능 수정) 3줄->6줄로 늘어날 때 기존 간격(0.15)이 좁다는 피드백 - "1->2줄" 간격(0.3)과
			-- 동일한 단위로 6줄 전체를 -0.75/-0.45/-0.15/0.15/0.45/0.75로 재배치한다(버프가 없을 때의
			-- 3줄 배치는 그대로 유지).
			if hitIndex == 1 then
				offsetY = -0.75
			elseif hitIndex == 3 then
				offsetY = 0.45
			else
				offsetY = -0.15
			end
			bonusGap = 0.3
		else
			if hitIndex == 1 then
				offsetY = -0.3
			elseif hitIndex == 3 then
				offsetY = 0.3
			end
		end
		-- (버그 수정) 원본/보너스를 하나의 Play() 배열로 묶으면 3연타(3곳)가 각각 2줄씩이라 총 6줄이어야
		-- 하는데 실제로는 4줄처럼 겹쳐 보이는 문제가 있었다 - 배열로 묶인 두 값은 시간차(DelayPerAttack)로만
		-- 분리되고 같은 위치에서 뜨기 때문. 보너스를 별도의 Play() 호출로 분리해 offsetY를 bonusGap만큼
		-- 더 얹어서 서로 다른 위치에 뜨도록 한다.
		-- (버그 수정) "각자 크리티컬 여부를 독립적으로 판단해야 한다" - 하드코딩된 false 대신 CalcDamage가
		-- 이 타격(hitIndex)에 대해 독립적으로 굴린 결과를 그대로 전달한다.
		_DamageSkinService:Play(
			target, self:GetHitDamageSkinId(), 0,
			{ damage }, DamageSkinTweenType.Default, baseIsCritical,
			Vector2(0, offsetY), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		)
		if bonus > 0 then
			_DamageSkinService:Play(
			    target, self:GetHitDamageSkinId(), 0,
			    { bonus }, DamageSkinTweenType.Default, bonusIsCritical,
			    Vector2(0, offsetY + bonusGap), Vector2(1, 1), 1.0, 1.0, LitMode.Default
			)
		end
		log("[SpearBurst] ShowSpearBurstStabDamageSkin hitIndex=" .. tostring(hitIndex) .. " damage=" .. tostring(damage) .. " offsetY=" .. tostring(offsetY) .. " baseCrit=" .. tostring(baseIsCritical) .. " bonusCrit=" .. tostring(bonusIsCritical))
	end

	@ExecSpace("Multicast")
	method void PlaySpearBurstHitEffect(Entity target, number dirX, integer hitIndex, boolean enhanced)
		-- 스피어 버스터에 맞은 몬스터 전용 히트 이펙트. 여러 명이 맞으면 대상마다 각각 재생되고,
		-- 3연타의 hitIndex마다(찌르는 이펙트 3종과 같은 타이밍) 매번 새로 재생된다.
		-- 오른쪽을 보고 공격할 때(dirX>0) 좌우 반전한다(캐릭터 쪽 이펙트와 동일한 관례).
		-- (실측 확인) PlayEffectAttached로 몬스터에 붙이면 각 몬스터 자신의 좌우 방향(스스로 걷는
		-- 방향)에 따라 반전 결과가 뒤섞여 "몇 개는 오른쪽, 몇 개는 왼쪽"으로 들쭉날쭉하게 나온다 -
		-- 몬스터에 붙이지 않고 그 순간의 월드 좌표에 독립적으로 재생해 이 간섭을 없앤다.
		-- (실측 확인) 알파를 낮춰가며 재생을 반복해 페이드를 흉내내면 클립이 매번 처음부터 다시
		-- 시작돼 "깜빡거림"으로 보인다 - 한 번만 재생하고 클립 자체의 자연스러운 소멸에 맡긴다.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local pos = target.TransformComponent.WorldPosition
		local flipX = dirX > 0
		-- (요청) 어드밴스드 스피어 버스터 보유 시 히트 이펙트를 검붉은색으로. 원본(밝은 폭발)에 곱해
		-- 진한 검붉은 톤(어두운 빨강)이 되게 한다.
		-- (요청) 붉은색 비중을 줄이고 "검은색에 붉은색을 살짝 곁들인" 톤. R만 약간 남기고 전체를 어둡게.
		local hitOpts = { ["FlipX"] = flipX }
		if enhanced then hitOpts["Color"] = Color(0.3, 0.08, 0.08, 1.0) end
		_EffectService:PlayEffect("84c06a061ae74a10a96fd55947769868", target, Vector3(pos.x, pos.y, 0), 0, Vector3(1, 1, 1), false, hitOpts)
		-- 쉐도우 파트너: 같은 히트 이펙트를 0.25초 시간차를 두고 그 자리에 한 번 더(70% 투명도) 재생
		self:EchoShadowHitEffectAtPos("84c06a061ae74a10a96fd55947769868", Vector3(pos.x, pos.y, 0), 0, Vector3(1, 1, 1), hitOpts)
		log("[SpearBurst] PlaySpearBurstHitEffect hitIndex=" .. tostring(hitIndex) .. " t=" .. tostring(_UtilLogic.ElapsedSeconds))
	end

	@ExecSpace("ServerOnly")
	method void SpawnAdvSpearHitFrames(Entity target, number dirX, number alphaValue, number delaySeconds)
		-- (스피어버스터 강화) 히트 이펙트를 msw-dev-tools/resources/스피어버스터강화 폴더의 전용 아트로
		-- 재생한다. 원본 히트 클립(84c06a06)의 프레임 0/1/2를 그대로 재작화한 스프라이트 3장을 쓰며,
		-- 실측으로 원본 프레임과 알파(실루엣)가 픽셀 단위로 완전히 동일함을 확인했다
		-- (009=120x108/f0, 004=120x104/f1, 010=96x96/f2 - RUID.md에는 "미사용"으로 잘못 분류돼 있었다).
		-- asset 업로드는 sprite만 가능해 새 애니메이션클립을 만들 수 없으므로, 엔티티 하나의 ClipRUID를
		-- 순서대로 갈아끼워 클립처럼 재생한다(SpawnSlashBlastCastEffect와 동일한 프레임 교체 패턴).
		-- 원본의 4번째 프레임(68x88)은 재작화본이 없어 3프레임으로 끝낸다.
		-- delaySeconds > 0이면 그만큼 뒤에 재생한다(쉐도우 파트너 몫).
		-- (버그 수정) 이펙트를 몬스터의 자식으로 붙이면 몬스터가 오른쪽을 볼 때 부모의 Scale.x가
		-- 반전돼(몬스터 모델의 좌우 반전 관례) 자식인 이 이펙트까지 같이 뒤집힌다 - "히트 이펙트
		-- 방향이 몬스터가 보는 방향 기준으로 잡힌다"는 피드백의 원인. 원본 클립 재생부
		-- (PlaySpearBurstHitEffect)의 주석과 동일한 조치로, 몬스터에 붙이지 않고 그 순간의 월드
		-- 좌표에 맵의 자식으로 독립 스폰해 몬스터 방향의 간섭을 없애고 IsFlipX를 공격자(플레이어)의
		-- dirX로만 결정한다.
		if not isvalid(target) then return end
		local mapEntity = self.Entity.CurrentMap
		if not isvalid(mapEntity) then return end
		local targetPos = target.TransformComponent.WorldPosition
		local spawnX, spawnY = targetPos.x, targetPos.y + 0.4
		local frames = {
			"60930fee4e624d7f898debb4d0a92a3a",   -- f0 (120x108)
			"2b33049e548c43d7bbdd5f00dfd441de",   -- f1 (120x104)
			"51c423c9d2d841e993ae26fcfa986be4",   -- f2 (96x96)
		}
		local frameInterval = 0.07
		local playFrames = function()
			if not isvalid(mapEntity) then return end
			self._T.trailFxSeq = (self._T.trailFxSeq or 0) + 1
			local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "SBAdvHitFx" .. tostring(self._T.trailFxSeq), Vector3(spawnX, spawnY, 0), mapEntity)
			if not isvalid(fx) then return end
			fx:AddComponent("script.SpearBurstFadingEffect")
			local comp = fx:GetComponent("script.SpearBurstFadingEffect")
			if isvalid(comp) then
				comp.IsFlipX = dirX > 0        -- 공격자(플레이어)가 보는 방향 기준 - 맞은 몬스터 방향과 무관
				comp.StartAlpha = alphaValue
				comp.EndAlpha = alphaValue     -- 페이드 없이 프레임 재생만(사라짐은 아래 Destroy가 담당)
				comp.HoldDuration = 1.0        -- 전체 수명보다 길게 잡아 트윈이 아예 시작되지 않게 한다
				comp.TweenDuration = 0.0
				comp.StartScale = 1.0
				comp.EndScale = 1.0
				comp.OrderInLayerValue = 5     -- 몬스터보다 앞에 그려지도록
				comp.ClipRUID = frames[1]      -- 마지막에 설정(클라 OnSyncProperty가 실제 적용을 트리거)
			end
			for i = 2, #frames do
				local frameRuid = frames[i]
				_TimerService:SetTimerOnce(function()
					if isvalid(comp) then comp.ClipRUID = frameRuid end
				end, (i - 1) * frameInterval)
			end
			_TimerService:SetTimerOnce(function()
				if isvalid(fx) then fx:Destroy() end
			end, #frames * frameInterval + 0.03)
			log("[SpearBurst] SpawnAdvSpearHitFrames 재생 alpha=" .. tostring(alphaValue) .. " t=" .. tostring(_UtilLogic.ElapsedSeconds))
		end
		if delaySeconds > 0 then
			_TimerService:SetTimerOnce(playFrames, delaySeconds)
		else
			playFrames()
		end
	end

	-- ─────────────────────────────────────────────────────────────────────
	-- 새비지블로우 (2차 스킬)
	--
	-- 사양(요청사항):
	--  · 전방의 적 1명을 6번 공격한다. 데미지는 6줄로 표시된다.
	--  · 데미지는 한 줄당 전투력의 220%~300% (CalcDamageBase의 skill.savageblow 분기).
	--  · 시전하면 캐릭터 앞에 1→8번 이미지가 순서대로 빠르게 뜨고, 이미지가 바뀔 때마다 히트 사운드가 난다
	--    (SavageBlowVisual.mlua가 클라이언트에서 담당).
	--  · 2·3·4·5·6·8번 이미지가 보이는 순간에 각각 1타씩, 총 6타의 데미지 판정이 들어간다.
	--  · 히트 이펙트는 3종 중 시전마다 1개를 랜덤으로 골라, 그 하나만 6번 몬스터에게서 터진다.
	--  · 3번째 타격에 몬스터가 죽더라도 6줄이 모두 떠야 한다 → 스피어 버스터와 동일하게, 판정이 실패하면
	--    (콜라이더가 더 이상 걸리지 않으면) 같은 공식으로 표시 전용 데미지를 새로 굴려 줄만 띄운다.
	-- ─────────────────────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void AttackSavageBlow(number combatPower, number atkMultiplier)
		-- (다른 스킬과 동일) 새 스킬을 시전하는 시점에 이전 숨고르기가 재생 중이었다면 즉시 정리한다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then
			return
		end
		if self._T.isSavageBlowing then
			log("PlayerAttack: AttackSavageBlow 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isSavageBlowing = true

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingSavageBlowCombatPower = combatPower

		local playerCtrl = self.Entity.PlayerControllerComponent
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = isvalid(playerCtrl) and playerCtrl.LookDirectionX or 1
		self._T.pendingSavageBlowDirX = dirX
		self._T.pendingSavageBlowWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
		end
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end

		-- 대상은 시전 시점에 한 번만 골라 고정한다(더블스탭/스피어버스터와 동일) - 6타가 진행되는 도중에
		-- 대상이 죽어도 나머지 타격의 데미지 줄이 계속 그 자리에 떠야 하므로, 매 타격마다 다시 찾지 않는다.
		self._T.savageBlowTarget = self:FindNearestMonsterInForwardBox(Vector2(worldPos.x, worldPos.y), dirX, 2.0, 1.0)

		-- 히트 이펙트는 3종 중 하나를 이번 시전에서 한 번만 골라, 6번 모두 같은 것으로 재생한다(요청사항 -
		-- "3개중 랜덤으로 하나를 골라 그 고른 하나의 이펙트만 6번 뜨고 사라짐").
		local hitEffects = {
			"5154d64ae24843a3bc29a878f13768ad",
			"45087e25ef5949f68af9fe40c5b3c0a9",
			"53a8a9f33fdb42819715399936e1a7fa",
		}
		local hitRuid = hitEffects[_UtilLogic:RandomIntegerRange(1, 3)]

		-- 프레임 간격/시작 딜레이. SavageBlowVisual.FrameInterval과 반드시 같은 값이어야 화면(이미지)과
		-- 판정(데미지)이 같은 순간에 일어난다.
		-- (기능 변경 이력)
		--  · "너무 빠르다 - 1/2로" 요청 → 프레임 간격/시작 딜레이를 2배(0.06→0.12 / 0.1→0.2)로 늘렸다.
		--  · 이번엔 "후딜이 더 줄어야 한다 - 모션이 더 빨라야 한다"는 피드백 → 프레임 간격 0.12 → 0.09,
		--    시작 딜레이 0.2 → 0.12로 당겼다(연출 전체 길이 1.16 → 0.84*배율).
		-- SavageBlowVisual.FrameInterval의 기본값도 같은 값(0.09)으로 맞춰야 한다.
		local frameInterval = 0.09 * mult
		local startDelay = 0.12 * mult

		-- 캐릭터 모션은 8장의 이펙트 프레임과 1:1로 맞춰 8개의 포즈를 순서대로 잡는다(요청받은 조합) -
		-- 그래서 프레임 타이밍(startDelay/frameInterval)이 정해진 뒤에 호출한다.
		self:PlaySavageBlowMotion(self.Entity, dirX, mult, startDelay, frameInterval)

		_TimerService:SetTimerOnce(function()
			self:SpawnSavageBlowVisual(dirX, frameInterval)
		end, startDelay)

		-- 6타 판정: 2·3·4·5·6·8번 이미지가 보이는 순간(= startDelay + (프레임번호-1) * 간격)에 각각 1타.
		local damageFrames = { 2, 3, 4, 5, 6, 8 }
		for i, frameIdx in ipairs(damageFrames) do
			local hitIndex = i
			local delay = startDelay + (frameIdx - 1) * frameInterval
			_TimerService:SetTimerOnce(function()
				self:DealSavageBlowHit(hitIndex, dirX, hitRuid)
			end, delay)
		end

		-- (기능 수정) "끝 딜레이를 더 줄여달라"는 추가 피드백 - 마지막 타격(8번 프레임 = 0.12 + 7*0.09 =
		-- 0.75*배율) 직후에 바로 컨트롤을 돌려준다(= 0.77*배율). 8번 이미지 자체는 전용 이펙트 엔티티가
		-- 자기 타이머로 끝까지 재생하므로, 컨트롤을 먼저 풀어도 연출이 잘리지 않는다.
		-- SkillManager의 재사용 대기시간(0.82*배율)도 여기에 맞춰 함께 줄였다.
		local restoreDelay = startDelay + 7 * frameInterval + 0.02 * mult
		_TimerService:SetTimerOnce(function()
			self:RestoreSavageBlowControl()
		end, restoreDelay)

		log("[SavageBlow] AttackSavageBlow dirX=" .. tostring(dirX) .. " combatPower=" .. tostring(combatPower) .. " hitRuid=" .. tostring(hitRuid) .. " targetFound=" .. tostring(isvalid(self._T.savageBlowTarget)))
	end

	method table GetSavageBlowPoses()
		-- (요청) 캐릭터 모션은 아래 포즈들을 순서대로 조합해서 만든다. 이펙트 프레임(1~8)과 앞에서부터
		-- 1:1로 짝지어, 이미지가 바뀌는 순간마다 포즈도 함께 바뀐다.
		--   1번 이미지 → stabO1 첫 모션
		--   2번        → swingOF 끝 모션
		--   3번        → proneStab 첫 모션
		--   4번        → swingOF 끝 모션
		--   5번        → swingO2 첫 모션
		--   6번        → stabO1 끝 모션
		--   7번        → alert 중간 모션
		-- (기능 변경) 마지막 8번(swingO1 첫 모션)은 빼달라는 요청으로 제거했다 - 8번 이펙트가 뜨는
		-- 동안에는 7번 포즈(alert 중간)가 그대로 유지된다.
		-- 각 액션의 실제 프레임 수는 플레이 중 프레임을 하나씩 넘겨보며 실측해서 확정했다:
		--   swingOF = 4프레임(0~3, 끝=3) / stabO1 = 2프레임(0~1, 끝=1) / alert = 3프레임(0~2, 중간=1)
		-- 그래서 "끝 모션"/"중간 모션"도 아래처럼 실제 프레임 번호로 직접 적는다.
		return {
			{ action = "stabO1",    frame = 0 },  -- 첫 모션
			{ action = "swingOF",   frame = 3 },  -- 끝 모션 (총 4프레임)
			{ action = "proneStab", frame = 0 },  -- 첫 모션
			{ action = "swingOF",   frame = 3 },  -- 끝 모션
			{ action = "swingO2",   frame = 0 },  -- 첫 모션
			{ action = "stabO1",    frame = 1 },  -- 끝 모션 (총 2프레임)
			{ action = "alert",     frame = 1 },  -- 중간 모션 (총 3프레임)
		}
	end

	@ExecSpace("Multicast")
	method void PlaySavageBlowMotion(Entity attacker, number dirX, number atkMultiplier, number startDelay, number frameInterval)
		-- 다른 스킬(더블스탭 등)은 액션 하나를 통째로 재생하지만, 새비지블로우는 8개의 포즈를 이펙트
		-- 프레임과 같은 타이밍에 하나씩 갈아끼우는 방식이다(요청받은 조합 모션).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false

		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		if isvalid(playerCtrl) then
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isSavageBlowDirectionLocked = true
		self._T.lockedSavageBlowDirX = dirX
		self._T.isSavageBlowMotionPlaying = true
		-- 재시전 시 이전 숨고르기가 남아있으면 새 모션을 방해하지 않도록 즉시 정리한다.
		self._T.isBreatherPlaying = false

		local mult = math.max(atkMultiplier or 1.0, 0.001)

		-- 8개의 포즈를 이펙트 프레임과 동일한 시점(startDelay + (i-1)*frameInterval)에 하나씩 적용한다.
		local poses = self:GetSavageBlowPoses()
		for i, p in ipairs(poses) do
			local pose = p
			local delay = startDelay + (i - 1) * frameInterval
			_TimerService:SetTimerOnce(function()
				self:ApplySavageBlowPose(pose.action, pose.frame)
			end, delay)
		end

		_TimerService:SetTimerOnce(function()
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			self._T.isSavageBlowMotionPlaying = false
		end, 0.78 * mult)

		-- (기능 변경) 키를 누르고 있으면 계속 재시전되므로(SkillManager의 홀드 반복 목록에 추가됨),
		-- 이 모션 해제 타이머가 다음 시전 도중에 터지면 새 포즈를 stand로 덮어써 버린다. 재사용
		-- 대기시간(0.82*배율)보다 앞에서 끝나야 한다 - 마지막 포즈(0.12 + 6*0.09 = 0.66*배율)와 마지막
		-- 타격(0.75*배율)이 모두 끝난 0.79*배율에 모션을 정리한다("끝 딜레이를 더 줄여달라"는 피드백).
		_TimerService:SetTimerOnce(function()
			self._T.isSavageBlowDirectionLocked = false
			self._T.lockedSavageBlowAction = nil
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, 0.79 * mult)
	end

	method void ApplySavageBlowPose(string action, integer frameIdx)
		-- 지정한 액션의 frameIdx번 프레임 하나에 캐릭터를 사실상 정지시킨다.
		--
		-- (실측으로 확인한 두 가지 함정)
		-- 1) StartFrameIndex == EndFrameIndex(구간 길이 0)로 보내면 엔진이 이벤트를 통째로 무시한다
		--    (포즈가 전혀 바뀌지 않는다). 반드시 EndFrameIndex = StartFrameIndex + 1 로 구간을 줘야 한다.
		-- 2) PlayType=Onetime 클립이 끝까지 재생되고 나면 캐릭터가 기본 stand 모션으로 되돌아간다 -
		--    즉 "빠르게 감아서 마지막 프레임에 멈추기"는 통하지 않는다. 대신 PlayRate를 극단적으로 낮춰
		--    (0.001) 그 프레임에서 사실상 멈춰 있게 만든다. 다음 포즈는 우리가 타이머로 직접 갈아끼운다.
		if not self:IsClient() then return end
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		-- 상태 변경(IDLE 복귀 등)으로 포즈가 덮여쓰이면 HandleStateChangeEvent가 이 값으로 다시 적용한다.
		self._T.lockedSavageBlowAction = action
		self._T.lockedSavageBlowFrameIdx = frameIdx

		local motionEvent = ActionStateChangedEvent(action, action, 0.001, SpriteAnimClipPlayType.Onetime, frameIdx, frameIdx + 1)
		body:SendEvent(motionEvent)
		log("[SavageBlow] pose " .. tostring(action) .. " frame=" .. tostring(frameIdx))
	end

	@ExecSpace("ServerOnly")
	method void SpawnSavageBlowVisual(number dirX, number frameInterval)
		-- 캐릭터 앞(바라보는 방향)에 1~8번 이미지를 순서대로 재생하는 전용 엔티티를 캐릭터의 자식으로 스폰한다.
		-- 자식으로 붙여야 캐릭터가 움직여도 이펙트가 따라온다(SpearBurstFadingEffect와 동일한 이유).
		-- 이미지는 한자(流血殺 등)라 좌우 반전하면 글자가 뒤집혀 보이므로 FlipX는 쓰지 않고, 위치만 바라보는
		-- 방향으로 옮긴다.
		local fx = _SpawnService:SpawnByModelId("savageblowvisual", "SavageBlowFX", Vector3(0.55 * dirX, 0.45, 0), self.Entity)
		if not isvalid(fx) then
			log_warning("[SavageBlow] SpawnSavageBlowVisual: 스폰 실패 (savageblowvisual 모델 없음?)")
			return
		end
		fx:AddComponent("script.SavageBlowVisual")
		local comp = fx:GetComponent("script.SavageBlowVisual")
		if isvalid(comp) then
			comp.FrameInterval = frameInterval
			comp.OrderInLayerValue = 11
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then
				fx:Destroy()
			end
		end, frameInterval * 8 + 0.4)
		log("[SavageBlow] SpawnSavageBlowVisual interval=" .. tostring(frameInterval))
	end

	@ExecSpace("Server")
	method void DealSavageBlowHit(integer hitIndex, number dirX, string hitRuid)
		-- 6타 중 hitIndex번째 타격. 스피어 버스터(DealSpearBurstStabHit)와 완전히 동일한 구조다:
		-- 같은 AttackComponent 인스턴스로 같은 대상을 짧은 간격으로 반복 타격하면 GetDisplayHitCount=0이어도
		-- 엔진이 자동 데미지 숫자를 추가로 띄우는 문제가 있어, 대상의 DamageSkinSpawnerComponent를 판정
		-- 직전에 잠깐 떼었다가 붙인다.
		if not isvalid(self.Entity) then return end
		local target = self._T.savageBlowTarget
		if not isvalid(target) then return end
		self._T.savageBlowCurrentTarget = target

		---@type Monster
		local monsterComp = target:GetComponent("script.Monster")
		-- Attack() 호출 전에 미리 확인한다 - Monster.HandleHitEvent는 이미 죽어있으면(IsDead) 자기 히트음을
		-- 건너뛰므로, "네이티브가 이 타격의 히트음을 이미 냈는지" 판단 기준으로 쓴다.
		local wasAlreadyDead = isvalid(monsterComp) and monsterComp.IsDead

		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local targetSkinSpawner = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		if isvalid(targetSkinSpawner) then target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent") end
		local hitComps = self:Attack(shape, "skill.savageblow", CollisionGroups.HitBox)
		if not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then target:AddComponent("MOD.Core.DamageSkinSpawnerComponent") end

		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end

		local damage = self._T.lastSavageBlowDamage or 0
		local baseCrit = self._T.lastSavageBlowIsCritical or false
		local bonus = self._T.shadowEchoBonus or 0
		local bonusCrit = self._T.shadowEchoBonusIsCritical or false

		if not actuallyHit then
			-- 앞선 타격에 대상이 이미 죽어 판정 자체가 실패해도(콜라이더가 더 이상 걸리지 않음) 6줄이 항상
			-- 뜨도록, CalcDamageBase의 skill.savageblow 분기와 동일한 공식(220%~300%)으로 표시 전용 데미지를
			-- 새로 굴린다(실제 Hp에는 영향 없음). 크리티컬/쉐도우 파트너 보너스도 stale 값 대신 여기서 새로 굴린다.
			local critRate = self:GetServerCritRatePercent() / 100
			local critMult = (self._T.currentCritDamagePercent or 125) / 100
			local combatPower = self._T.pendingSavageBlowCombatPower or 0
			local mult = 2.2 + _UtilLogic:RandomDouble() * (3.0 - 2.2)
			damage = self:ApplyComboAttackBonus(math.floor(combatPower * mult))
			-- 백스탭도 실제 히트와 같은 시전 판정으로 얹는다 - 이 표시 전용 경로에 안 얹으면 앞선 타격에
			-- 대상이 죽은 뒤의 줄만 보너스가 빠져 "6줄 중 일부만 백스탭이 걸린 것처럼" 보인다.
			damage = self:ApplyBackstabBonus(damage, self.Entity, target, "skill.savageblow")
			baseCrit = _UtilLogic:RandomDouble() < critRate
			if baseCrit then damage = math.floor(damage * critMult) end
			bonus = 0
			bonusCrit = false
			if self._T.shadowPartnerActive then
				bonus = math.floor(damage * (0.55 + _UtilLogic:RandomDouble() * 0.10))
				bonusCrit = _UtilLogic:RandomDouble() < critRate
				if bonusCrit then bonus = math.floor(bonus * critMult) end
			end
		end

		self:ShowSavageBlowDamageSkin(target, damage, hitIndex, bonus, baseCrit, bonusCrit)
		if bonus > 0 then
			self:PlayShadowEchoHitSound(target)
		end

		-- 히트 이펙트는 실제 판정 성공 여부와 무관하게 매번 재생한다(대상이 죽어도 6번 모두 터져야 한다).
		self:SpawnSavageBlowHitEffect(target, hitRuid, dirX)

		-- 실제로 명중했고 대상이 이번 타격 전까지 살아있었다면 Monster.HandleHitEvent가 이미 히트음을 냈다 -
		-- 여기서 또 내면 같은 타격에 소리가 2번 겹친다(스피어 버스터에서 실측). 이미 죽어있었거나 판정이
		-- 실패한 경우에만 보충 재생한다.
		if isvalid(monsterComp) and (not actuallyHit or wasAlreadyDead) then
			monsterComp:PlayHitSound()
		end

		log("[SavageBlow] DealSavageBlowHit hitIndex=" .. tostring(hitIndex) .. " actuallyHit=" .. tostring(actuallyHit) .. " wasAlreadyDead=" .. tostring(wasAlreadyDead) .. " damage=" .. tostring(damage))
	end

	@ExecSpace("Client")
	method void ShowSavageBlowDamageSkin(Entity target, integer damage, integer hitIndex, integer bonus, boolean baseIsCritical, boolean bonusIsCritical)
		-- 6타를 세로로 6줄 쌓아 보여준다(스피어 버스터의 3줄 배치와 동일한 방식, 줄 수만 6개로 늘림).
		-- 줄 간격은 0.3 (요청: "6줄 간격은 좋다").
		-- (기능 수정 이력)
		--  · 첫 줄이 대상 중심보다 0.75 아래에서 시작해 "다른 스킬보다 너무 아래"라는 피드백 → 0.0으로 올림.
		--  · 이번엔 "약간 높다 - 조금 내려달라"는 피드백 → 시작점을 0.0 → -0.2로 살짝 내렸다.
		--    (6줄: -0.2 / 0.1 / 0.4 / 0.7 / 1.0 / 1.3)
		if not isvalid(target) then return end
		local offsetY = -0.2 + (hitIndex - 1) * 0.3
		local bonusGap = 0.15
		if bonus > 0 then
			-- 쉐도우 파트너 버프가 켜지면 한 타격당 2줄이라 총 12줄이 된다 - 기존 간격(0.4/보너스 0.2)으로는
			-- 12줄이 서로 붙어 보인다는 피드백으로 간격을 한 단계 더 넓혔다(0.5 / 보너스 0.25).
			-- (12줄: -0.2, 0.05 / 0.3, 0.55 / 0.8, 1.05 / 1.3, 1.55 / 1.8, 2.05 / 2.3, 2.55)
			offsetY = -0.2 + (hitIndex - 1) * 0.5
			bonusGap = 0.25
		end
		_DamageSkinService:Play(
			target, self:GetHitDamageSkinId(), 0,
			{ damage }, DamageSkinTweenType.Default, baseIsCritical,
			Vector2(0, offsetY), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		)
		if bonus > 0 then
			_DamageSkinService:Play(
				target, self:GetHitDamageSkinId(), 0,
				{ bonus }, DamageSkinTweenType.Default, bonusIsCritical,
				Vector2(0, offsetY + bonusGap), Vector2(1, 1), 1.0, 1.0, LitMode.Default
			)
		end
		log("[SavageBlow] ShowSavageBlowDamageSkin hitIndex=" .. tostring(hitIndex) .. " damage=" .. tostring(damage) .. " offsetY=" .. tostring(offsetY) .. " crit=" .. tostring(baseIsCritical))
	end

	@ExecSpace("ServerOnly")
	method void SpawnSavageBlowHitEffect(Entity target, string ruid, number dirX)
		-- 몬스터 자리에서 터지는 히트 이펙트. 이 3종(hit1~3)은 애니메이션클립이 아니라 정지 스프라이트라
		-- _EffectService로 재생할 수 없어, 정지 스프라이트를 알파/스케일 트윈으로 띄웠다 사라지게 하는
		-- 기존 전용 엔티티(SpearBurstFadingEffect)를 그대로 재사용한다.
		-- 몬스터의 자식이 아니라 맵의 자식으로 그 순간의 월드 좌표에 스폰한다 - 3번째 타격에 몬스터가 죽어
		-- 엔티티가 비활성화(Enable=false)돼도 남은 타격의 이펙트가 정상적으로 보여야 하기 때문이다.
		if not isvalid(target) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local pos = target.TransformComponent.WorldPosition
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "SavageBlowHitFX", Vector3(pos.x, pos.y + 0.2, 0), map)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.ClipRUID = ruid
			comp.IsFlipX = dirX > 0
			comp.StartScale = 1.0
			comp.EndScale = 1.35
			comp.StartAlpha = 1.0
			comp.EndAlpha = 0.0
			comp.HoldDuration = 0.05
			comp.TweenDuration = 0.15
			comp.OrderInLayerValue = 12
			comp.UseSplitGrowth = false
			comp.SecondClipRUID = ""
			comp.PivotOffsetX = 0
			comp.PivotOffsetY = 0
			comp.SecondPivotOffsetX = 0
			comp.SecondPivotOffsetY = 0
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then
				fx:Destroy()
			end
		end, 0.4)
	end

	@ExecSpace("Server")
	method void RestoreSavageBlowControl()
		self._T.isSavageBlowing = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) and self._T.pendingSavageBlowWasControllerEnabled then
			playerCtrl.Enable = true
		end
		-- 다른 스킬들과 동일하게 컨트롤이 복구된 시점에 공용 숨고르기 모션을 재생한다.
		self:PlayBreather(self.Entity, self._T.pendingSavageBlowDirX or 1)
	end


	method table FindRushTargets(Vector2 fromPos, number dirX, integer maxCount, number scanRange)
		-- 돌진 전용: 진행 방향 "앞"에 있는 적만 가까운 순으로 최대 maxCount명 고른다.
		-- 뒤쪽 적은 밀어낼 수 없으므로 애초에 제외한다(앞에 아무도 없으면 제자리 시전 판정에도 쓰인다).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return {} end
		local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
		local candidates = {}
		for _, comp in ipairs(monsterComps) do
			---@type Monster
			local mc = comp
			if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead and mc.Entity.Enable then
				local pos = mc.Entity.TransformComponent.WorldPosition
				local dx = pos.x - fromPos.x
				local dy = pos.y - fromPos.y
				-- (버그 수정) 판정 범위가 고정 8칸이라 사거리(2.33칸)보다 훨씬 길어 멀리 있는 적까지
				-- 맞고 밀렸다. 실제로 밀고 지나갈 수 있는 구간(사거리 + 몸 앞 여유)으로 제한한다.
				if dx * dirX > 0 and math.abs(dx) <= scanRange and math.abs(dy) <= 1.5 then
					table.insert(candidates, { entity = mc.Entity, dist = math.abs(dx) })
				end
			end
		end
		table.sort(candidates, function(a, b) return a.dist < b.dist end)
		local result = {}
		for i = 1, math.min(#candidates, maxCount) do
			table.insert(result, candidates[i].entity)
		end
		return result
	end

	method number FindGroundEdgeX(FootholdComponent fh, Foothold startFh, number fromX, number dirX, number maxDistance)
		-- 지금 밟고 있는 발판에서 dirX 방향으로 "지면이 실제로 끊기는 지점"의 x를 돌려준다.
		-- 같은 지면이 여러 조각으로 나뉘어 있을 수 있어 NextFootholdId/PreviousFootholdId 체인을 따라간다
		-- (AttackTeleport의 검증된 로직과 동일한 방식). 벽(IsBlockVerticalLine)이 먼저 나오면 그 앞에서 끊는다.
		local desiredX = fromX + dirX * maxDistance
		if fh == nil or startFh == nil then return desiredX end

		local EDGE_MARGIN = 0.15
		local chainFh = startFh
		local farEdgeX = (dirX > 0) and math.max(startFh.StartPoint.x, startFh.EndPoint.x) or math.min(startFh.StartPoint.x, startFh.EndPoint.x)
		for _ = 1, 50 do
			if (dirX > 0 and farEdgeX >= desiredX) or (dirX < 0 and farEdgeX <= desiredX) then break end
			local nextId = (dirX > 0) and chainFh.NextFootholdId or chainFh.PreviousFootholdId
			if nextId == nil or nextId == 0 then break end
			local nextFh = fh:GetFoothold(nextId)
			if nextFh == nil then break end
			chainFh = nextFh
			farEdgeX = (dirX > 0) and math.max(nextFh.StartPoint.x, nextFh.EndPoint.x) or math.min(nextFh.StartPoint.x, nextFh.EndPoint.x)
		end
		local limitX = farEdgeX - dirX * EDGE_MARGIN
		if (dirX > 0 and limitX < desiredX) or (dirX < 0 and limitX > desiredX) then
			desiredX = limitX
		end
		return desiredX
	end

	@ExecSpace("ServerOnly")
	method void AttackRush(number combatPower, number atkMultiplier, string weaponClass)
		-- 돌진(4차): 전방의 적을 최대 10명까지 밀어내며 2.95초 동안 전진한다.
		-- (요청) 앞에 적이 없으면 돌진하지 않고 제자리에서 시전만 한다.
		-- 발판이 끊기는 지점에서는 플레이어도 몬스터도 더 나아가지 않는다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then return end
		if self._T.isRushing then
			log("PlayerAttack: AttackRush 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isRushing = true

		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = playerCtrl.LookDirectionX
		local startPos = self.Entity.TransformComponent.WorldPosition
		local rb = self.Entity.RigidbodyComponent
		local map = self.Entity.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil

		-- (요청) 사거리 1/3로 축소: 7.0 -> 2.33. 몬스터 밀기 한계/판정 범위 계산에 쓴다
		-- (플레이어 본인의 정지 지점은 이동 주체인 클라이언트가 RunRushMove에서 따로 계산한다).
		local RUSH_MAX_DISTANCE = 2.33
		-- 플레이어 몸 앞 "제설판" 거리 - 밀린 몬스터가 최종적으로 서는 위치(플레이어 정지점 + 이 값).
		local RUSH_PUSH_FRONT = 1.0
		-- (요청) 이동 시간 0.25초 / 딜레이(컨트롤 복귀) 0.27초 / 모션 지속시간 0.4초.
		-- 모션은 딜레이보다 길게 유지해 딜레이가 끝날 때까지 자세가 바뀌지 않게 한다(요청).
		-- (요청) 공속이 오르면 모션이 빨라지고 딜레이도 그만큼 줄어야 한다 - 세 값에 모두 같은 배율을
		-- 곱해 "이동 종료 < 딜레이 종료 < 모션 종료" 순서를 그대로 유지한다(하나만 줄이면 딜레이가
		-- 이동보다 먼저 끝나 컨트롤러가 돌진 자세를 덮어쓴다). 돌진 거리(RUSH_MAX_DISTANCE)는 그대로라
		-- 공속이 오르면 같은 거리를 더 빨리 주파한다.
		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		local RUSH_MOVE_DURATION = 0.25 * mult
		local RUSH_DELAY = 0.27 * mult
		local RUSH_MOTION_DURATION = 0.4 * mult

		-- 밀어낼 대상(전방 최대 10명)
		-- 판정 범위 = 돌진 사거리 + 몸 앞 여유(밀어내는 폭). 사거리를 바꾸면 판정도 같이 따라온다.
		local targets = self:FindRushTargets(Vector2(startPos.x, startPos.y), dirX, 10, RUSH_MAX_DISTANCE + RUSH_PUSH_FRONT)

		self._T.pendingRushWasControllerEnabled = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then playerCtrl.Enable = false end
		if isvalid(self.Entity.MovementComponent) then self.Entity.MovementComponent:Stop() end


		-- 모션: (요청) 창/두손검 = stabT1의 2번째 동작, 한손검 = stabO1의 2번째 동작.
		-- 프레임 인덱스는 0부터이므로 "2번째" = 1. 한 자세로 고정해 돌진 내내 유지한다.
		-- (요청/사진 확인) 창 = 양손무기 찌르기1(stabT1)의 **끝자세**(창을 앞으로 완전히 내뻗은 프레임).
		-- 두손검은 한손검과 같은 모션(stabO1 2번째 프레임)을 쓴다.
		-- 프레임 인덱스는 0부터. stabT1은 앞 프레임이 창을 뒤로 당긴 준비자세라 끝 프레임을 잡아야 한다.
		local motionName = "stabO1"
		local motionFrame = 1
		if weaponClass == "spear" then
			motionName = "stabT1"
			motionFrame = 2
		end
		self:PlayRushMotion(self.Entity, motionName, dirX, RUSH_MOTION_DURATION, motionFrame)
		self:PlayRushCastEffect(dirX)
		self:PlayRushUseSound(self.Entity)

		if #targets == 0 then
			-- 앞에 적 없음: 제자리 시전. 이동/타격 없이 모션만 끝나면 컨트롤을 돌려준다.
			log("PlayerAttack: AttackRush 제자리 시전(전방에 적 없음)")
			_TimerService:SetTimerOnce(function()
				self:RestoreRushControl()
			end, RUSH_DELAY)
			return
		end

		-- 이동 한계: 지면이 끊기는 지점까지만(위에서 선언한 RUSH_MAX_DISTANCE 사용).
		local startFh = isvalid(rb) and rb:GetCurrentFoothold() or nil
		local stopX = self:FindGroundEdgeX(fh, startFh, startPos.x, dirX, RUSH_MAX_DISTANCE)

		-- 몬스터별로 "플레이어와의 상대 간격"과 "그 몬스터 자신의 지면 끝"을 미리 잡아둔다.
		-- (요청) 몬스터는 상대 간격을 유지한 채 따라오는 게 아니라, 플레이어 앞의 "제설판"에 밀려
		-- 한 자리에 모여야 한다. 예) 몬스터가 x=1,2,3이고 돌진거리가 3이면 셋 다 최종 x=4.
		-- 그래서 개별 offsetX를 쓰지 않고, 매 틱 "플레이어 앞면(plowX)보다 뒤에 있으면 plowX로 끌어올린다".
		local pushInfos = {}
		for _, t in ipairs(targets) do
			if isvalid(t) then
				local tp = t.TransformComponent.WorldPosition
				local tRb = t.RigidbodyComponent
				local tFh = isvalid(tRb) and tRb:GetCurrentFoothold() or nil
				table.insert(pushInfos, {
					entity = t,
					limitX = self:FindGroundEdgeX(fh, tFh, tp.x, dirX, RUSH_MAX_DISTANCE + 2.0),
				})
			end
		end

		self._T.pendingRushCombatPower = combatPower
		self._T.rushDirX = dirX
		self._T.rushStopX = stopX
		self._T.rushPushInfos = pushInfos
		self._T.rushStartX = startPos.x
		self._T.rushElapsed = 0
		self._T.rushDuration = RUSH_MOVE_DURATION

		-- 데미지는 시전 1회분만(전투력 300~400%) 각 대상에게 준다 - 밀려나는 동안 중복 타격하지 않는다.
		self:DealRushHits(targets)

		-- (핵심) 플레이어 이동은 **클라이언트**가 매 틱 SetWorldPosition으로 처리한다.
		-- 실측 근거: 서버에서 플레이어를 움직이는 수단이 전부 막혀 있다 - rb.MoveVelocity 대입 무효,
		-- MovementComponent:MoveToDirection 무효(컨트롤러 ON/OFF 둘 다), rb.RealMoveVelocity는 서버에서
		-- 항상 0이라 속도 피드백 불가, AddForce는 관성이 누적돼 발판 끝을 뚫고 나가며 Stop()으로도 못 세운다.
		-- 반면 클라이언트에서 매 틱 SetWorldPosition하면 완전 등속으로 움직이고 되돌림도 없다(5초 후 위치 유지 확인).
		-- 플레이어 위치 권한이 클라이언트에 있어서 서버가 밀면 클라 예측이 되돌리는 것이 원인이었다.
		-- (몬스터는 서버 권한이라 서버 틱에서 SetWorldPosition으로 잘 밀린다 - 아래 RushTick.)
		-- 컨트롤러 복귀 시점을 딜레이(0.27)로 넘긴다 - 이동 종료(0.25)에 복귀시키면 딜레이가 끝나기도 전에
		-- 컨트롤러가 서기/걷기 애니메이션을 덮어써 돌진 자세가 풀린다(요청: 딜레이 도중 모션 유지).
		self:RunRushMove(dirX, RUSH_MOVE_DURATION, RUSH_DELAY, self.Entity.PlayerComponent.UserId)

		-- 서버 틱: 밀리는 몬스터만 담당(플레이어가 실제로 나아간 만큼 따라 옮긴다).
		self._T.rushTimerId = _TimerService:SetTimerRepeat(function()
			self:RushTick()
		end, 1 / 60)

		_TimerService:SetTimerOnce(function()
			self:EndRush()
		end, RUSH_DELAY)
		log("PlayerAttack: AttackRush 시작 targets=" .. tostring(#targets) .. " stopX=" .. tostring(stopX))
	end

	@ExecSpace("ServerOnly")
	method void RushTick()
		-- 돌진 이동 1틱. 플레이어를 목표 x까지 전진시키고, 밀리는 몬스터들을 같은 진행량만큼 끌고 간다.
		if not self._T.isRushing then return end
		if not isvalid(self.Entity) then return end
		local RUSH_PUSH_FRONT = 1.0
		local dirX = self._T.rushDirX or 1
		local curX = self.Entity.TransformComponent.WorldPosition.x

		-- 몬스터: 플레이어 앞면(plowX)에 닿은 놈만 그 앞으로 밀어낸다. 이미 plowX보다 앞에 있으면
		-- 건드리지 않는다 -> 뒤쪽 몬스터부터 차례로 걸려 결국 다 같은 자리(최종 plowX)에 모인다.
		local plowX = curX + dirX * RUSH_PUSH_FRONT
		for _, info in ipairs(self._T.rushPushInfos or {}) do
			local t = info.entity
			if isvalid(t) then
				local tRb = t.RigidbodyComponent
				if isvalid(tRb) then
					local tp = t.TransformComponent.WorldPosition
					local behindPlow = (dirX > 0 and tp.x < plowX) or (dirX < 0 and tp.x > plowX)
					if behindPlow then
						local wantX = plowX
						local limitX = info.limitX
						-- 자기 발판 끝을 넘어서는 밀리지 않는다(요청).
						if (dirX > 0 and wantX > limitX) or (dirX < 0 and wantX < limitX) then
							wantX = limitX
						end
						if (dirX > 0 and wantX > tp.x) or (dirX < 0 and wantX < tp.x) then
							tRb:SetWorldPosition(Vector2(wantX, tp.y))
						end
					end
				end
			end
		end
	end

	@ExecSpace("Client")
	method void RunRushMove(number dirX, number duration, number ctrlRestoreDelay)
		-- 돌진의 플레이어 이동. **반드시 클라이언트에서** 돈다 - 서버에서 플레이어를 움직이는 수단은
		-- 전부 무효/불안정하고(AttackRush 주석 참고), 클라이언트에서 매 틱 SetWorldPosition하면
		-- 완전 등속 + 되돌림 없음이 실측으로 확인됐다.
		if not isvalid(self.Entity) then return end
		local rb = self.Entity.RigidbodyComponent
		if not isvalid(rb) then return end
		local playerCtrl = self.Entity.PlayerControllerComponent
		local mv = self.Entity.MovementComponent

		-- 정지 지점(지면이 끊기는 곳)은 여기서 계산한다 - 이동 주체가 클라이언트이기 때문.
		-- (요청) 이동 시간 0.3초. 최대 사거리를 그 안에 주파하도록 속도를 역산한다.
		-- (요청) 사거리 1/3로 축소: 7.0 -> 2.33.
		local RUSH_MAX_DISTANCE = 2.33
		local RUSH_SPEED = RUSH_MAX_DISTANCE / duration
		local startPos = self.Entity.TransformComponent.WorldPosition
		local map = self.Entity.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		local startFh = rb:GetCurrentFoothold()
		local stopX = self:FindGroundEdgeX(fh, startFh, startPos.x, dirX, RUSH_MAX_DISTANCE)

		-- (버그 수정) 예전엔 여기서 "원래 켜져 있었나"를 읽어 그 값일 때만 복구했는데, 이제 PlayRushMotion이
		-- 이 시점보다 먼저 컨트롤러를 꺼버릴 수 있어(둘은 별도 RPC라 순서가 보장되지 않는다) 항상 false로
		-- 읽혀 영영 복구되지 않는다. 시전 자체가 DEAD/사다리 상태를 막고 들어오므로 무조건 복구한다.
		if isvalid(playerCtrl) then
			playerCtrl.Enable = false
			playerCtrl.LookDirectionX = dirX
		end

		local elapsed = 0
		if self._T.rushMoveTimerId ~= nil then
			_TimerService:ClearTimer(self._T.rushMoveTimerId)
		end
		self._T.rushMoveTimerId = _TimerService:SetTimerRepeat(function()
			if not isvalid(self.Entity) then return end
			elapsed = elapsed + 1 / 60
			local cur = self.Entity.TransformComponent.WorldPosition
			local wantX = startPos.x + dirX * RUSH_SPEED * elapsed
			-- 발판이 끊기는 지점을 넘어가지 않는다(요청) - 넘길 값은 여기서 잘라낸다.
			if (dirX > 0 and wantX > stopX) or (dirX < 0 and wantX < stopX) then
				wantX = stopX
			end
			rb:SetWorldPosition(Vector2(wantX, cur.y))
		end, 1 / 60)

		-- 이동만 먼저 끝낸다(컨트롤러는 아직 잠근 채로 둔다 - 자세 유지).
		_TimerService:SetTimerOnce(function()
			if self._T.rushMoveTimerId ~= nil then
				_TimerService:ClearTimer(self._T.rushMoveTimerId)
				self._T.rushMoveTimerId = nil
			end
			if isvalid(mv) then mv:Stop() end
			log("[Rush] RunRushMove 이동종료 stopX=" .. tostring(stopX))
		end, duration)

		-- 컨트롤러 복귀는 딜레이 시점에. 이때까지는 돌진 자세가 그대로 유지된다.
		_TimerService:SetTimerOnce(function()
			if isvalid(playerCtrl) then
				playerCtrl.Enable = true
			end
			log("[Rush] RunRushMove 컨트롤 복귀")
		end, ctrlRestoreDelay)
		log("[Rush] RunRushMove 시작 dirX=" .. tostring(dirX) .. " stopX=" .. tostring(stopX))
	end

	@ExecSpace("ServerOnly")
	method void EndRush()
		-- 돌진 종료: 이동 틱을 끄고 컨트롤을 돌려준다.
		if self._T.rushTimerId ~= nil then
			_TimerService:ClearTimer(self._T.rushTimerId)
			self._T.rushTimerId = nil
		end
		self._T.rushPushInfos = nil
		if isvalid(self.Entity.MovementComponent) then
			self.Entity.MovementComponent:Stop()
		end
		self:RestoreRushControl()
	end

	@ExecSpace("ServerOnly")
	method void RestoreRushControl()
		-- (버그 수정) RestoreBrandishControl과 동일한 이유로 무조건 복구한다 - 이미 컨트롤러가 꺼져 있는
		-- 동안 돌진이 시작하면 pendingRushWasControllerEnabled가 false로 찍혀 영영 복구되지 않았다.
		-- 클라이언트 쪽(RunRushMove)은 같은 원인으로 이미 무조건 복구로 고쳐져 있었는데 서버 쪽인
		-- 여기만 남아 있었다.
		self._T.isRushing = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) then
			playerCtrl.Enable = true
		end
		log("[Rush] RestoreRushControl 컨트롤 복구 wasCtrl=" .. tostring(self._T.pendingRushWasControllerEnabled))
	end

	@ExecSpace("ServerOnly")
	method void DealRushHits(table targets)
		-- 대상마다 개별 판정을 낸다. 실제 데미지 수치는 CalcDamageBase의 "skill.rush" 분기가 계산한다
		-- (다중 대상이라도 대상별 단일 포인터(rushCurrentTarget)로 걸러 이웃 겹침 타격을 막는다).
		for _, t in ipairs(targets) do
			if isvalid(t) then
				self._T.rushCurrentTarget = t
				local pos = t.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
				self:AttackShadowSafe(shape, "skill.rush", t)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void CastDoubleJump(number dirX)
		-- 더블 점프(1차): 이동 자체는 시전한 클라이언트가 처리하고(SkillManager.RunDoubleJumpMove),
		-- 여기서는 도약 지점에 남는 이펙트와 사용음만 담당한다. 두 RUID 모두 원본 팩
		-- skill/3300.img/skill/33001102(더블 점프)의 effect / _audio/Use 그대로다.
		self:PlayDoubleJumpSound(self.Entity)
		self:SpawnDoubleJumpEffect(dirX)
		log("[DoubleJump] CastDoubleJump dirX=" .. tostring(dirX))
	end

	@ExecSpace("Multicast")
	method void PlayDoubleJumpSound(Entity caster)
		-- 더블 점프 사용음. 주변 모든 클라이언트에서 재생한다(돌진 PlayRushUseSound와 동일한 패턴).
		if not self:IsClient() then return end
		if not isvalid(caster) then return end
		_SoundService:PlaySound("83efc24157d04c67b152d6782ce82b6b", 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnDoubleJumpEffect(number dirX)
		-- 도약한 "그 자리"에 남는 이펙트라 플레이어가 아니라 맵에 붙인다(플레이어에 붙이면 같이 날아가서
		-- 발자국처럼 보이지 않는다). 재생/페이드는 기존 SpearBurstFadingEffect를 그대로 재사용한다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		self._T.doubleJumpFxSeq = (self._T.doubleJumpFxSeq or 0) + 1
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "DoubleJumpFx" .. tostring(self._T.doubleJumpFxSeq), Vector3(pos.x, pos.y + 0.25, 0), map)
		if not isvalid(fx) then
			log_warning("[DoubleJump] 이펙트 스폰 실패")
			return
		end
		fx:AddComponent("script.SpearBurstFadingEffect")
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.IsFlipX = dirX > 0        -- (돌진과 동일) 원본 아트가 왼쪽 기준이라 오른쪽으로 갈 때 반전
			comp.StartAlpha = 1.0
			comp.EndAlpha = 0.0
			comp.HoldDuration = 0.2
			comp.TweenDuration = 0.25
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.OrderInLayerValue = 3
			comp.ClipRUID = "a2b497a1013f44e7b29ef8de081720f1"
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, 0.6)
		log("[DoubleJump] 이펙트 스폰 x=" .. string.format("%.2f", pos.x) .. " y=" .. string.format("%.2f", pos.y))
	end

	@ExecSpace("Multicast")
	method void PlayRushUseSound(Entity attacker)
		-- 돌진 사용음. 구버전 원본 팩(skill/111.img/skill/1111012)의 _audio/Use가 MSW 라이브러리에
		-- 그대로 살아있어 업로드 없이 참조한다(아트만 구버전이 없어 직접 조달했다).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("d9522927411a4f8f9dc7e083ee891f7f", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayRushMotion(Entity attacker, string motionName, number dirX, number holdDuration, integer frameIndex)
		-- 지정한 한 프레임(frameIndex)만 잡아 돌진 내내 그 자세를 유지한다.
		-- PlayAttackMotionFramed와 같은 방식이되 시작/끝 프레임을 같게 줘서 정지 자세로 만든다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end

		avatarRenderer.ShowDefaultWeaponEffects = false
		if isvalid(attacker.MovementComponent) then
			attacker.MovementComponent:Stop()
		end
		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(playerCtrl) then
			-- (버그 수정) 방향키를 누른 채 시전하면 돌진 자세가 안 보였다 - PlayerController가 걷기
			-- 애니메이션을 계속 내보내 아래 자세 이벤트를 덮어쓰기 때문. 컨트롤러를 끄는 건 클라의
			-- RunRushMove였는데 그건 별도 RPC라 이 모션보다 늦게 도착할 수 있었다. 자세를 보내기
			-- **직전에** 여기서 끊어, 시전~모션 사이에 다른 행동/애니메이션이 끼어들 틈을 없앤다.
			-- (조작 주체인 본인 클라이언트에서만 끈다 - Multicast라 남의 화면에서도 실행된다.)
			if _UserService.LocalPlayer == attacker then
				playerCtrl.Enable = false
			end
			playerCtrl.LookDirectionX = dirX
		end
		self._T.isRushMotionPlaying = true
		self._T.lockedRushDirX = dirX
		self._T.lockedRushMotionName = motionName
		self._T.lockedRushFrame = frameIndex

		body:SendEvent(ActionStateChangedEvent(motionName, motionName, 1.0, SpriteAnimClipPlayType.Onetime, frameIndex, frameIndex))
		log("[Rush] PlayRushMotion sent: " .. tostring(motionName) .. " frame=" .. tostring(frameIndex))

		_TimerService:SetTimerOnce(function()
			self._T.isRushMotionPlaying = false
			if isvalid(avatarRenderer) then
				avatarRenderer.ShowDefaultWeaponEffects = true
			end
			local sc = self.Entity.StateComponent
			if isvalid(sc) and sc.CurrentStateName ~= "DEAD" then
				sc:ChangeState("IDLE")
				sc:ChangeState("MOVE")
				sc:ChangeState("IDLE")
			end
		end, holdDuration)
	end

	@ExecSpace("ServerOnly")
	method void PlayRushCastEffect(number dirX)
		-- 돌진 이펙트: 구버전 원본에서 뽑아온 노란 빔 5프레임 + 흰 섬광 6프레임을 겹쳐 재생한다
		-- (원본 WZ의 effect / effect0 2겹 구조). MSW 라이브러리의 같은 스킬 effect는 현대 리메이크
		-- 아트라 쓰지 않는다. RUID 대응표: msw-dev-tools/resources/돌진/RUID.md
		local beam = {
			"c3dabaa7cf6543aaae6e12a8f7450755",
			"e329cbdd2402405f8a4ffa09dd73369f",
			"35e3a144e09c4f0db5ea3ddf9f8e6a21",
			"e01b24a0d0b14a919cce57e5a8e54c4c",
			"598fa2d4779049b9be5d9c4e62194d0c",
		}
		local white = {
			"5e115329cbbf43b481c144ae34190357",
			"4700271227d84b589e384262c3ace071",
			"560dc982d20745b391af3911ed148700",
			"ba976729a84a4003939e1d14c12b581d",
			"917b8bff6c5044f4a1bea90b7606609c",
			"639c7632196842e08b5a1a31a5f296f8",
		}
		-- (요청) 이펙트가 캐릭터보다 너무 앞에 떠 있어 몸에 겹치도록 당긴다.
		-- 스프라이트가 좌우 반전(IsFlipX)되면서 그림 덩어리가 오프셋 기준보다 앞쪽으로 쏠리기 때문에
		-- 음수 오프셋이 필요하다. 화면 비교(-1.4/-0.9/-0.4)로 -0.9에서 캐릭터가 빔 안에 들어오는 것을 확인.
		-- 흰 섬광은 스프라이트가 더 작아(195px vs 260px) 같은 비율로 -0.7.
		-- 전방 오프셋(음수일수록 뒤). 조정 이력: -1.5/-1.2/-1.05/-0.9/-0.3/0.45를 거쳐 -0.45로 확정(요청).
		-- 흰 섬광은 스프라이트가 작아(195px vs 260px) 같은 비율로 -0.35.
		-- (요청 번복) 한때 캐릭터 뒤(MapLayer0/2·3)로 보냈다가 "다시 캐릭터를 가리게" 요청받아
		-- 원래대로 기본 SortingLayer + 6/7(캐릭터 앞)로 복원했다.
		self:SpawnRushFrameEffect(beam, dirX, -0.45, 0.35, 6)
		self:SpawnRushFrameEffect(white, dirX, -0.35, 0.45, 7)
	end

	@ExecSpace("ServerOnly")
	method void SpawnRushFrameEffect(table frames, number dirX, number offsetX, number offsetY, integer orderInLayer)
		-- 정지 스프라이트 여러 장을 순서대로 갈아끼워 애니메이션처럼 재생한다
		-- (SpawnSlashBlastCastEffect와 같은 패턴 - ClipRUID가 @Sync라 바뀔 때마다 클라가 재적용).
		local frameInterval = 0.1
		self._T.trailFxSeq = (self._T.trailFxSeq or 0) + 1
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "RushFx" .. tostring(self._T.trailFxSeq), Vector3(offsetX * dirX, offsetY, 0), self.Entity)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			comp.IsFlipX = dirX > 0        -- (실측 정정) 원본 이미지는 왼쪽 방향 - 오른쪽 볼 때 좌우 반전
			comp.StartAlpha = 1.0
			comp.EndAlpha = 1.0
			comp.HoldDuration = 5.0        -- 수명보다 길게 잡아 트윈이 시작되지 않게(프레임 교체만 사용)
			comp.TweenDuration = 0.0
			comp.StartScale = 1.0
			comp.EndScale = 1.0
			comp.OrderInLayerValue = orderInLayer
			comp.ClipRUID = frames[1]
		end
		for i = 2, #frames do
			local frameRuid = frames[i]
			_TimerService:SetTimerOnce(function()
				if isvalid(comp) then comp.ClipRUID = frameRuid end
			end, (i - 1) * frameInterval)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(fx) then fx:Destroy() end
		end, #frames * frameInterval + 0.05)
	end


	@ExecSpace("Multicast")
	method void DisableLocalControllerForBrandish(Entity attacker)
		-- 브랜디쉬 시전 순간, 조작 주체(로컬 플레이어) 클라이언트에서 PlayerController를 즉시 끊어
		-- 걷기(MOVE) 애니메이션이 첫 모션(swingT3)을 덮어쓰지 못하게 한다. 돌진 PlayRushMotion과 동일한 패턴.
		-- Multicast라 남의 화면에서도 실행되므로, 본인 클라에서만 끈다(남의 화면 모션은 상태/모션 이벤트로 구동됨).
		-- 복구는 서버 RestoreBrandishControl(Enable=true 동기화)가 담당한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		if _UserService.LocalPlayer ~= attacker then return end
		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(playerCtrl) then playerCtrl.Enable = false end
		if isvalid(attacker.MovementComponent) then attacker.MovementComponent:Stop() end
	end

	@ExecSpace("ServerOnly")
	method void AttackBrandish(number combatPower, number atkMultiplier, string weaponClass, boolean enhanced)
		-- 브랜디쉬(4차): 검을 크게 휘둘러 전방의 적을 벤다. 한 번 시전에 총 3줄 -
		-- swingT3 마지막에 1줄, 이어지는 swingTF 마지막에 2줄이 들어간다(요청). 줄당 전투력의 400~700% 피해.
		-- 모션은 무기 분류와 무관하게 swingT3 -> swingTF 연속 재생(요청) - weaponClass는 쓰지 않는다.
		self:StopBreather()
		local currentState = self.Entity.StateComponent.CurrentStateName
		if currentState == "DEAD" or currentState == "CLIMB" or currentState == "LADDER" then return end
		if self._T.isBrandishing then
			log("PlayerAttack: AttackBrandish 요청 차단됨(이미 진행 중)")
			return
		end
		self._T.isBrandishing = true
		self._T.brandish2Queued = false   -- 이번 브랜디쉬의 콤보 예약 초기화(이전 시전의 잔여 예약 방지)
		self._T.brandishEnhanced = (enhanced == true)   -- 브랜디쉬 강화 버프 활성 여부(붉은 이펙트/색감)

		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		self._T.pendingBrandishCombatPower = combatPower
		local playerCtrl = self.Entity.PlayerControllerComponent
		local dirX = playerCtrl.LookDirectionX
		self._T.pendingBrandishDirX = dirX
		self._T.pendingBrandishWasCtrl = isvalid(playerCtrl) and playerCtrl.Enable
		if isvalid(playerCtrl) then playerCtrl.Enable = false end

		-- 시전 중 몸동작이 브랜디쉬 자세를 덮어쓰는 경로를 이번 시전 동안만 전부 막는다.
		-- (요청 ①) "맞으면 피격 모션 때문에 모션이 끊긴다" (요청 ②) "점프 브랜디쉬 중 착지하면 모션이 멈춘다"
		-- 원인은 같다 - 상태가 바뀌면 엔진(AvatarStateAnimationComponent)이 그 상태에 매핑된 몸동작을
		-- 자동으로 내려보내 진행 중인 raw 클립을 덮어쓴다. 매핑 자체를 빼두면(msw-avatar Strategy A)
		-- 상태만 조용히 바뀌고 몸에는 아무 클립도 안 내려가 브랜디쉬 자세가 그대로 이어진다.
		-- (버그 수정 - 이동 중 시전) 순서가 결정적이다. 아래 클라 컨트롤러 끄기 + 이동정지는 MOVE→IDLE
		-- 전환을 유발하는데, 그 순간 IDLE 매핑이 남아 있으면 엔진이 stand를 내려보내 첫 모션(swingT3)을
		-- 묻는다("idle 자세에서 시작하여 앞쪽 모션이 묻힌다"). 예전엔 이 억제가 ServerOnly라 @Sync가 클라에
		-- 도착하기 전에 전환이 일어나 stand가 새어나왔다. Multicast로 바꿔 클라에서도 즉시 매핑을 빼두고,
		-- 반드시 이동정지(MOVE→IDLE 유발)보다 **먼저** 호출한다. RestoreBrandishStateMotions(@Sync)에서 복구.
		self:SuppressBrandishStateMotions()
		self:SetBrandishMotionGuard(true)

		-- (버그 수정) 이동(방향키 홀드) 중 브랜디쉬를 쓰면 걷기 애니메이션이 첫 모션을 덮어쓰는 문제.
		-- 위 컨트롤러 끄기는 ServerOnly라 @Sync 도착 전까지 클라 PlayerController가 걷기(MOVE)를 계속
		-- 내보낸다. 돌진(PlayRushMotion)처럼 조작 주체 클라에서 즉시 컨트롤러를 끊는다(매핑은 이미 위에서
		-- 빼뒀으므로 이 정지가 유발하는 MOVE→IDLE에서 stand도 안 나온다). 복구는 서버 RestoreBrandishControl.
		self:DisableLocalControllerForBrandish(self.Entity)
		if isvalid(self.Entity.MovementComponent) then self.Entity.MovementComponent:Stop() end

		-- (요청) 모션 속도 2배 + 그만큼 못 움직이는 기간도 짧게. PlayAttackMotion은 재생속도를 1/배율로
		-- 잡으므로, 배율을 절반으로 넘기면 재생속도가 2배가 되고 아래 타이머들도 전부 같은 배율을 쓰므로
		-- 모션/판정/조작복구가 통째로 정확히 절반 시간에 끝난다(싱크 유지). 데미지 공식은 mult가 아니라
		-- pendingBrandishCombatPower를 쓰므로 이 변경에 영향받지 않는다.
		-- (요청) 그 2배에서 다시 20% 느리게 -> 재생속도 2.0배 -> 1.6배. 배율은 재생속도의 역수라
		-- 0.5 / 0.8 = 0.625를 곱한다.
		local motionMult = mult * 0.625
		-- (요청) 마지막 모션(swingTF)만 0.2초 더 길게. raw 클립 길이가 0.65*배율이므로, 배율에
		-- 0.2/0.65를 더하면 그 클립만 정확히 0.2초 길어진다(= 그만큼 더 천천히 재생된다).
		-- 아래 2타 판정/조작복구도 이 배율을 쓰므로 늘어난 길이에 그대로 따라붙는다.
		local finishMult = motionMult + 0.2 / 0.65
		-- swingTF 시작 시각(= swingT3 클립이 끝나는 시각). 아래 2타/조작복구의 기준점.
		local finishStart = 0.65 * motionMult
		-- (요청) 2타의 2줄 사이 텀 - 같은 틱에 몰아 넣으면 숫자가 한꺼번에 툭 튀어나와 뻣뻣하다.
		-- 이 스킬의 다른 시간값과 동일하게 공속 배율을 태운다(공속이 오르면 텀도 같이 좁아진다) -
		-- 고정값으로 두면 공속이 아주 빠를 때 둘째 줄이 조작 복구 뒤로 밀려난다.
		self._T.brandishFinishGap = 0.1 * mult

		-- 모션은 파워스트라이크와 같은 재생기(PlayAttackMotion)를 쓴다 - 상태 변경 시 자세를 다시
		-- 덧씌우는 기존 핸들러(HandleStateChangeEvent)가 그대로 적용돼 이동 중에도 모션이 살아남는다.
		-- raw 모션 한 클립의 길이는 0.65초 * 배율이다(PlayAttackMotion에 실측 문서화됨) - 두 모션을
		-- 그 길이만큼 띄워 연달아 재생하고, 각 타격을 클립이 끝나기 직전(0.55*배율, 약 85% 지점)에 맞춘다.
		self:PlayAttackMotion(self.Entity, "swingT3", dirX, motionMult)
		self:PlayBrandishCastEffect(self.Entity, dirX, self._T.brandishEnhanced == true)
		self:PlayBrandishUseSound(self.Entity)

		-- 1타: swingT3의 마지막 모션에서 1줄(요청).
		_TimerService:SetTimerOnce(function()
			self:DealBrandishFirstHits()
		end, 0.55 * motionMult)
		-- swingT3가 끝나는 시점에 swingTF를 이어서 재생한다(요청). 이 클립만 0.2초 긴 배율을 쓴다.
		_TimerService:SetTimerOnce(function()
			self:PlayAttackMotion(self.Entity, "swingTF", self._T.pendingBrandishDirX or 1, finishMult)
		end, finishStart)
		-- 2타: swingTF의 마지막 동작에서 2줄(요청). 1타에서 잡아둔 그 대상들만 때린다.
		-- 길어진 swingTF 클립의 같은 지점(85%)이라 판정도 그만큼 뒤로 밀린다.
		_TimerService:SetTimerOnce(function()
			self:DealBrandishFinishHits()
		end, finishStart + 0.55 * finishMult)

		-- 조작 복구(못 움직이는 기간의 끝) - swingTF 배율을 따라가므로 마지막 모션이 길어진 만큼 같이 밀린다.
		-- ⚠ SkillManager의 브랜디쉬 공용 쿨다운이 이 시각과 반드시 같아야 한다(어긋나면 홀드 연속 시전이
		-- "이미 진행 중"으로 차단되거나, 모션이 끝났는데도 다음 시전이 안 나간다) - 그 쪽 주석 참고.
		-- (브랜디쉬2 콤보) 브랜디쉬 진행 [절반~끝]에 브랜디쉬를 재입력하면 SkillManager가 QueueBrandish2로
		-- brandish2Queued를 켠다. 그 경우 여기서 조작을 복구하는 대신 AttackBrandish2(빠른 추가 2줄)로 이어
		-- 간다 - 시전 잠금(isBrandishing/매핑억제/가드)을 그대로 유지한 채 넘겨, 브랜디쉬2가 자기 끝에서 한
		-- 번만 RestoreBrandishControl한다. 예약이 없으면 평소대로 즉시 복구.
		_TimerService:SetTimerOnce(function()
			if self._T.brandish2Queued then
				self._T.brandish2Queued = false
				self:AttackBrandish2(self._T.pendingBrandish2CombatPower or 0, self._T.pendingBrandish2AtkMult or 1.0)
			else
				self:RestoreBrandishControl()
			end
		end, finishStart + 0.75 * finishMult)
		log("PlayerAttack: AttackBrandish 시전 dir=" .. tostring(dirX) .. " motionMult=" .. tostring(motionMult) .. " finishMult=" .. tostring(finishMult))
	end

	@ExecSpace("ServerOnly")
	method void DealBrandishFirstHits()
		-- 1타(swingT3 마지막) - 전방 박스 안의 적을 최대 6명까지 한 번에 타격한다(슬래시블러스트와 같은
		-- 탐색 방식). 여기서 찾은 대상 목록을 그대로 저장해 2타(swingTF 마지막)가 재탐색 없이 같은
		-- 대상만 때리게 한다("첫번째 공격과 2번째 공격은 같은 대상만 공격한다"는 요청) - 2타 때 다시
		-- 탐색하면 그 사이 다가온 다른 몬스터까지 맞는다.
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = self._T.pendingBrandishDirX or 1
		local targets = self:FindSlashBlastTargets(Vector2(worldPos.x, worldPos.y), dirX, 6, 2.5, 1.0)
		self._T.brandishTargets = targets
		for _, t in ipairs(targets) do
			if isvalid(t) then
				self._T.brandishCurrentTarget = t
				local pos = t.TransformComponent.WorldPosition
				local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
				self:AttackShadowSafe(shape, "skill.brandish", t)
				self:PlayBrandishHitEffect(t)
			end
		end
		log("[Brandish] DealBrandishFirstHits targets=" .. tostring(#targets))
	end

	@ExecSpace("ServerOnly")
	method void DealBrandishFinishHits()
		-- 2타(swingTF 마지막) - 1타에서 저장해둔 대상만 순회하며 대상마다 2줄을 넣는다.
		-- (요청) 두 줄을 같은 틱에 몰아 넣으면 숫자 2개가 한꺼번에 툭 튀어나와 뻣뻣하다 - 둘째 줄만
		-- 짧은 텀(brandishFinishGap) 뒤에 넣어 아래 줄 -> 윗 줄로 이어져 뜨게 한다
		-- (ShowBrandishFinishDamageSkin이 hitIndex별로 offsetY를 0.0 / 0.3으로 쌓아 올린다).
		-- targets는 지역변수로 잡아 클로저에 담는다 - 아래에서 _T.brandishTargets를 비워도 둘째 줄이
		-- 같은 대상 목록을 그대로 쓴다(1타/2타가 같은 대상만 때린다는 요청 유지).
		local targets = self._T.brandishTargets
		if targets == nil then return end
		local gap = self._T.brandishFinishGap or 0.1
		for _, t in ipairs(targets) do
			if isvalid(t) then
				self:DealBrandishFinishHit(t, 1)
			end
		end
		_TimerService:SetTimerOnce(function()
			for _, t in ipairs(targets) do
				if isvalid(t) then
					self:DealBrandishFinishHit(t, 2)
				end
			end
		end, gap)
		self._T.brandishTargets = nil
	end

	@ExecSpace("ServerOnly")
	method void DealBrandishFinishHit(Entity target, integer hitIndex)
		-- 2타의 2줄 중 hitIndex번째. 새비지블로우(DealSavageBlowHit)와 완전히 동일한 구조다:
		--  · 같은 AttackComponent 인스턴스로 같은 대상을 짧은 간격으로 두 번 때리면 GetDisplayHitCount=0이어도
		--    엔진이 자동 데미지 숫자를 추가로 띄워, 판정 직전에 대상의 DamageSkinSpawnerComponent를 잠깐 뗀다.
		--  · 1타에 대상이 이미 죽어 판정 자체가 실패해도(콜라이더가 더 이상 걸리지 않음) 2줄이 항상 뜨도록
		--    표시 전용 데미지를 새로 굴린다("첫번째 공격으로 적이 죽었어도 데미지를 준다"는 요청).
		if not isvalid(target) then return end
		self._T.brandishCurrentTarget = target

		---@type Monster
		local monsterComp = target:GetComponent("script.Monster")
		-- Attack() 호출 전에 미리 확인한다 - Monster.HandleHitEvent는 이미 죽어있으면(IsDead) 자기 히트음을
		-- 건너뛰므로, "네이티브가 이 타격의 히트음을 이미 냈는지" 판단 기준으로 쓴다.
		local wasAlreadyDead = isvalid(monsterComp) and monsterComp.IsDead

		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local targetSkinSpawner = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		if isvalid(targetSkinSpawner) then target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent") end
		local hitComps = self:Attack(shape, "skill.brandish.finish", CollisionGroups.HitBox)
		if isvalid(target) and not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then
			target:AddComponent("MOD.Core.DamageSkinSpawnerComponent")
		end

		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end

		local damage = self._T.lastBrandishFinishDamage or 0
		local baseCrit = self._T.lastBrandishFinishIsCritical or false
		local bonus = self._T.shadowEchoBonus or 0
		local bonusCrit = self._T.shadowEchoBonusIsCritical or false

		if not actuallyHit then
			-- CalcDamageBase의 skill.brandish.finish 분기와 동일한 공식(400%~700%)으로 표시 전용 데미지를
			-- 새로 굴린다(실제 Hp에는 영향 없음). 크리티컬/쉐도우 파트너 보너스도 stale 값 대신 새로 굴린다.
			local critRate = self:GetServerCritRatePercent() / 100
			local critMult = (self._T.currentCritDamagePercent or 125) / 100
			local combatPower = self._T.pendingBrandishCombatPower or 0
			local mult = 4.0 + _UtilLogic:RandomDouble() * 3.0
			damage = self:ApplyComboAttackBonus(math.floor(combatPower * mult))
			-- 백스탭도 실제 히트와 같은 시전 판정으로 얹는다 - 이 표시 전용 경로에 안 얹으면 앞선 타격에
			-- 대상이 죽은 뒤의 줄만 보너스가 빠져 "6줄 중 일부만 백스탭이 걸린 것처럼" 보인다.
			damage = self:ApplyBackstabBonus(damage, self.Entity, target, "skill.brandish.finish")
			baseCrit = _UtilLogic:RandomDouble() < critRate
			if baseCrit then damage = math.floor(damage * critMult) end
			bonus = 0
			bonusCrit = false
			if self._T.shadowPartnerActive then
				bonus = math.floor(damage * (0.55 + _UtilLogic:RandomDouble() * 0.10))
				bonusCrit = _UtilLogic:RandomDouble() < critRate
				if bonusCrit then bonus = math.floor(bonus * critMult) end
			end
		end

		self:ShowBrandishFinishDamageSkin(target, damage, hitIndex, bonus, baseCrit, bonusCrit)
		if bonus > 0 then
			self:PlayShadowEchoHitSound(target)
		end
		-- 히트 이펙트는 실제 판정 성공 여부와 무관하게 매번 재생한다(대상이 죽어도 2줄 모두 터져야 한다).
		self:PlayBrandishHitEffect(target)

		-- 실제로 명중했고 대상이 이번 타격 전까지 살아있었다면 Monster.HandleHitEvent가 이미 히트음을 냈다 -
		-- 여기서 또 내면 같은 타격에 소리가 2번 겹친다(스피어 버스터/새비지블로우에서 실측). 이미 죽어있었거나
		-- 판정이 실패한 경우에만 보충 재생한다("해당 몬스터의 타격소리를 들려준다"는 요청).
		if isvalid(monsterComp) and (not actuallyHit or wasAlreadyDead) then
			monsterComp:PlayHitSound()
		end

		log("[Brandish] DealBrandishFinishHit hitIndex=" .. tostring(hitIndex) .. " actuallyHit=" .. tostring(actuallyHit) .. " wasAlreadyDead=" .. tostring(wasAlreadyDead) .. " damage=" .. tostring(damage))
	end

	@ExecSpace("Client")
	method void ShowBrandishFinishDamageSkin(Entity target, integer damage, integer hitIndex, integer bonus, boolean baseIsCritical, boolean bonusIsCritical)
		-- 2타의 2줄을 세로로 쌓아 보여준다(새비지블로우의 6줄 배치와 동일한 방식, 줄 수만 2개).
		-- (2줄: 0.0 / 0.3, 쉐도우 파트너로 4줄이 되면 0.0, 0.25 / 0.5, 0.75)
		if not isvalid(target) then return end
		local offsetY = (hitIndex - 1) * 0.3
		local bonusGap = 0.15
		if bonus > 0 then
			offsetY = (hitIndex - 1) * 0.5
			bonusGap = 0.25
		end
		local skinRuid = self:GetHitDamageSkinId()
		_DamageSkinService:Play(
			target, skinRuid, 0,
			{ damage }, DamageSkinTweenType.Default, baseIsCritical,
			Vector2(0, offsetY), Vector2(1, 1), 1.0, 1.0, LitMode.Default
		)
		if bonus > 0 then
			_DamageSkinService:Play(
				target, skinRuid, 0,
				{ bonus }, DamageSkinTweenType.Default, bonusIsCritical,
				Vector2(0, offsetY + bonusGap), Vector2(1, 1), 1.0, 1.0, LitMode.Default
			)
		end
		log("[Brandish] ShowBrandishFinishDamageSkin hitIndex=" .. tostring(hitIndex) .. " damage=" .. tostring(damage) .. " offsetY=" .. tostring(offsetY) .. " crit=" .. tostring(baseIsCritical))
	end

	@ExecSpace("ServerOnly")
	method void RestoreBrandishControl()
		-- (버그 수정) "점프하고 어느 순간 다음 모션이 안 나간다" - 예전엔 시전 시작 시점에 찍어둔
		-- "원래 컨트롤러가 켜져 있었나"(pendingBrandishWasCtrl)가 true일 때만 복구했는데, 이미 컨트롤러가
		-- 꺼져 있는 동안(다른 스킬의 잠금 구간, 홀드 연속 시전 중 이전 시전의 잔여 잠금 등) 브랜디쉬가
		-- 시작하면 그 값이 false로 찍힌다. 그런데 AttackBrandish는 그와 무관하게 컨트롤러를 끄므로,
		-- 복구 시점에 false를 보고 그냥 넘어가 컨트롤러가 영영 꺼진 채로 남는다 -> 이동도 안 되고
		-- 다음 스킬 모션도 안 나간다. RunRushMove가 같은 원인으로 이미 한 번 고쳐진 것과 동일한 버그다
		-- (그 쪽 주석 참고). 시전 자체가 DEAD/사다리 상태를 막고 들어오므로 무조건 복구한다.
		self._T.isBrandishing = false
		local playerCtrl = self.Entity.PlayerControllerComponent
		if isvalid(playerCtrl) then
			playerCtrl.Enable = true
		end
		-- 시전 중 빼뒀던 몸동작 매핑을 기본값 그대로 되돌린다(AttackBrandish 참고).
		self:RestoreBrandishStateMotions()
		self:SetBrandishMotionGuard(false)
		local sc = self.Entity.StateComponent
		log("[Brandish] RestoreBrandishControl 컨트롤 복구 wasCtrl=" .. tostring(self._T.pendingBrandishWasCtrl) .. " state=" .. tostring(isvalid(sc) and sc.CurrentStateName or "nil"))
	end

	@ExecSpace("Multicast")
	method void SuppressBrandishStateMotions()
		-- 브랜디쉬 시전 중 브랜디쉬 자세를 덮어쓸 수 있는 상태들의 몸동작 매핑을 전부 빼둔다.
		-- 대상 5종과 그 이유:
		--   IDLE - 착지(FALL -> IDLE)나 피격 복귀, 이동정지(MOVE -> IDLE) 때 stand가 내려와 모션을 끊는다
		--          ("점프 브랜디쉬 착지 시 모션 중지" / "이동 중 시전 시 idle에서 시작해 앞 모션이 묻힘"의 직접 원인).
		--   MOVE - 이동(방향키 홀드) 중 시전 시, 컨트롤러가 클라에서 꺼지기 직전까지 walk가 첫 모션을 덮어쓴다.
		--   FALL - 점프 브랜디쉬에서 상승(JUMP) -> 하강 전환 시 fall이 내려와 공중에서 끊긴다.
		--   JUMP - 시전 도중 점프 상태로 바뀌는 경우(기본 매핑이 fall).
		--   HIT  - 시전 중 피격(몸동작 대신 표정만 바꾸는 요청 - OnHitDuringSkill 참고).
		-- DEAD는 남겨둔다 - 시전 중 죽으면 사망 모션은 정상적으로 나와야 한다.
		-- (버그 수정) 예전엔 ServerOnly라 매핑 제거가 @Sync로 클라에 도착하기 전에 상태 전환이 일어나면
		-- stand/walk가 새어나와 첫 모션을 묻었다. Multicast로 바꿔 서버+모든 클라에서 즉시 제거한다.
		-- 서버도 함께 실행되므로 상태 권한 쪽 매핑도 동일하게 빠진다. 복구는 RestoreBrandishStateMotions(@Sync).
		local asac = self.Entity.AvatarStateAnimationComponent
		if not isvalid(asac) then return end
		asac:RemoveActionSheet("IDLE")
		asac:RemoveActionSheet("MOVE")
		asac:RemoveActionSheet("FALL")
		asac:RemoveActionSheet("JUMP")
		asac:RemoveActionSheet("HIT")
	end

	@ExecSpace("ServerOnly")
	method void RestoreBrandishStateMotions()
		-- SuppressBrandishStateMotions가 빼둔 5종을 StateToAvatarBodyActionSheet 기본값 그대로 되돌린다.
		-- 기본값은 런타임 실측(AvatarBodyActionStateName / PlayRate): IDLE=stand@1.0 / MOVE=walk@1.68 /
		-- FALL=fall@1.0 / JUMP=fall@1.0 / HIT=hit@1.0. ⚠ MOVE는 PlayRate가 1.0이 아니라 1.68이다 -
		-- 1.0으로 복구하면 시전 후 걷기 애니메이션이 느려진다.
		-- 시전 중 사망 등으로 빠져나가도 RestoreBrandishControl은 타이머로 항상 실행되므로 매핑이 빠진 채로
		-- 남지 않는다. ServerOnly + @Sync로 모든 클라에 복구가 전파된다.
		local asac = self.Entity.AvatarStateAnimationComponent
		if not isvalid(asac) then return end
		asac.StateToAvatarBodyActionSheet["IDLE"] = AvatarBodyActionElement("stand", 1.0)
		asac.StateToAvatarBodyActionSheet["MOVE"] = AvatarBodyActionElement("walk", 1.68)
		asac.StateToAvatarBodyActionSheet["FALL"] = AvatarBodyActionElement("fall", 1.0)
		asac.StateToAvatarBodyActionSheet["JUMP"] = AvatarBodyActionElement("fall", 1.0)
		asac.StateToAvatarBodyActionSheet["HIT"] = AvatarBodyActionElement("hit", 1.0)
	end

	@ExecSpace("Multicast")
	method void SetBrandishMotionGuard(boolean on)
		-- 브랜디쉬 시전 중 "상태 전환이 몸동작을 건드리지 못하게" 막는 클라이언트 플래그를 켜고 끈다.
		-- 상태 전환/모션 재적용을 판단하는 코드(HandleStateChangeEvent, PlayerHit.ClientWatchdogTick)가
		-- 전부 클라이언트에서 돌기 때문에, 서버 전용인 _T.isBrandishing으로는 판단할 수 없어 별도로 둔다.
		self._T.brandishMotionGuard = on
		if on then return end
		if not self:IsClient() then return end
		-- 시전이 끝나는 시점의 자세 정리 안전망.
		-- PlayAttackMotion이 모션 끝에 도는 정리 토글(IDLE->MOVE->IDLE)은 IDLE 매핑이 있어야 stand를
		-- 내려보내 브랜디쉬 자세를 지운다. 그런데 매핑 복구(@Sync, 서버)가 그 토글보다 늦게 도착하면
		-- 토글이 헛돌아 브랜디쉬 자세로 굳은 채 남는다(움직이기 전까지). 매핑 복구와 같은 호출에서
		-- 출발한 이 RPC 뒤에 여유를 두고 한 번 더 토글해 확실히 되돌린다.
		-- 상태 전이 권한은 본인 클라이언트에만 있다 - 남의 화면(Multicast라 모두 실행된다)에서 부르면
		-- [LEA-3022]로 실패한다(PlayerHit.ClientWatchdogTick과 같은 이유).
		if _UserService.LocalPlayer ~= self.Entity then return end
		_TimerService:SetTimerOnce(function()
			-- 그 사이 새 시전이 시작됐으면(홀드 연속 시전) 새 모션을 건드리면 안 되므로 건너뛴다.
			if self._T.brandishMotionGuard then return end
			local sc = self.Entity.StateComponent
			if not isvalid(sc) or sc.CurrentStateName == "DEAD" then return end
			sc:ChangeState("IDLE")
			sc:ChangeState("MOVE")
			sc:ChangeState("IDLE")
			log("[Brandish] 시전 종료 자세 정리 토글 완료")
		end, 0.1)
	end

	method boolean IsBrandishMotionGuardOn()
		-- PlayerHit의 클라이언트 워치독이 참조한다 - 다른 스크립트가 _T를 직접 읽지 않도록 메서드로 노출한다.
		return self._T.brandishMotionGuard == true
	end

	@ExecSpace("ServerOnly")
	method void OnHitDuringSkill()
		-- PlayerHit.OnHit(서버)이 피격 때마다 호출한다. 브랜디쉬 시전 중이면 피격 몸동작을 막아둔 상태라
		-- (AttackBrandish 참고) 그대로 두면 맞은 티가 전혀 안 난다 - 몸동작 대신 표정만 피격 표정으로
		-- 바꿔준다(요청). PlayEmotion은 표정 전용이라 진행 중인 몸 클립에 영향을 주지 않는다.
		if not self._T.isBrandishing then return end
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		-- PlayEmotion은 @ExecSpace("Client") - 서버에서 호출하면 엔진이 클라이언트로 전달한다.
		avatarRenderer:PlayEmotion(EmotionalType.Hit, 1.0)
		log("[Brandish] 시전 중 피격 - 몸동작 유지, 표정만 피격 표정으로 변경")
	end

	@ExecSpace("ServerOnly")
	method void QueueBrandish2(number combatPower, number atkMultiplier)
		-- (브랜디쉬2 콤보) 브랜디쉬 진행 [절반~끝]에 브랜디쉬를 재입력하면 SkillManager의 서버 RPC
		-- (RequestQueueBrandish2)가 호출한다. 진행 중일 때만 예약을 켜, 브랜디쉬 조작복구 시점에 AttackBrandish2로
		-- 이어지게 한다(AttackBrandish의 복구 타이머 참고). 진행 중이 아니면 무시.
		if not self._T.isBrandishing then return end
		self._T.brandish2Queued = true
		self._T.pendingBrandish2CombatPower = combatPower
		self._T.pendingBrandish2AtkMult = atkMultiplier
		log("[Brandish2] 예약됨 combatPower=" .. tostring(combatPower))
	end

	@ExecSpace("ServerOnly")
	method void AttackBrandish2(number combatPower, number atkMultiplier)
		-- 브랜디쉬2(브랜디쉬 콤보 마무리): 브랜디쉬 끝에 이어서 빠른 2줄 추가타를 넣는다.
		-- 모션 = swingOF 프레임 0~2 + swingTF 프레임 2~3(빠르게, 마지막 조금 길게). 시전이펙트 = da1c...,
		-- 히트이펙트 = 브랜디쉬와 동일(PlayBrandishHitEffect), 사운드 = 1488... . 데미지 = 브랜디쉬 마무리
		-- 2줄과 동일(skill.brandish.finish, 400~700%) - DealBrandishFinishHit을 그대로 재사용한다.
		-- 브랜디쉬 시전 잠금(isBrandishing/매핑억제/가드)을 이어받아 유지하다가, 이 스킬 끝에서 한 번만 복구.
		if not self._T.isBrandishing then
			self:RestoreBrandishControl()
			return
		end
		local mult = math.max(0.1, math.min(atkMultiplier or 1.0, 3.0))
		-- DealBrandishFinishHit의 표시데미지는 pendingBrandishCombatPower를 참조하므로 브랜디쉬2 값으로 갱신.
		self._T.pendingBrandishCombatPower = combatPower
		self._T.pendingBrandish2CombatPower = combatPower
		local dirX = self._T.pendingBrandishDirX or 1

		-- (요청) 브랜디쉬보다 빠르게. seg1=swingOF 0~2, seg2=swingTF 2~3(마지막 조금 길게). 시간값은 튜닝 대상.
		local segMult = mult * 0.5          -- 재생속도 2배(빠르게)
		local seg1Time = 0.14 * mult        -- swingOF(0~2) 표시 시간
		local seg2Time = 0.24 * mult        -- swingTF(2~3) 표시 시간(마지막 조금 길게)
		self:PlayBrandish2Motion(self.Entity, dirX, segMult, seg1Time)
		self:PlayBrandish2CastEffect(self.Entity, dirX)
		self:PlayBrandish2Sound(self.Entity)

		-- 빠른 2줄: swingTF 임팩트(seg1Time 부근)에 1줄, 짧은 텀 뒤 2줄.
		_TimerService:SetTimerOnce(function() self:DealBrandish2Hits(1) end, seg1Time)
		_TimerService:SetTimerOnce(function() self:DealBrandish2Hits(2) end, seg1Time + 0.06 * mult)

		-- 조작 복구: 브랜디쉬2 모션 끝(마지막 조금 길게 포함) 뒤 한 번만.
		_TimerService:SetTimerOnce(function()
			self:RestoreBrandishControl()
		end, seg1Time + seg2Time + 0.12 * mult)
		log("[Brandish2] 발동 dir=" .. tostring(dirX) .. " mult=" .. tostring(mult))
	end

	@ExecSpace("ServerOnly")
	method void DealBrandish2Hits(integer hitIndex)
		-- 브랜디쉬2의 2줄 중 hitIndex번째. 브랜디쉬 마무리(DealBrandishFinishHit)를 그대로 재사용해
		-- 같은 데미지(400~700%)/데미지스킨 세로쌓기/히트이펙트/히트음을 낸다. 대상은 매번 새로 탐색한다
		-- (브랜디쉬 종료 후라 이전 대상 목록이 비어 있음).
		local worldPos = self.Entity.TransformComponent.WorldPosition
		local dirX = self._T.pendingBrandishDirX or 1
		local targets = self:FindSlashBlastTargets(Vector2(worldPos.x, worldPos.y), dirX, 6, 2.5, 1.0)
		for _, t in ipairs(targets) do
			if isvalid(t) then
				self:DealBrandishFinishHit(t, hitIndex)
			end
		end
		log("[Brandish2] DealBrandish2Hits hitIndex=" .. tostring(hitIndex) .. " targets=" .. tostring(#targets))
	end

	@ExecSpace("Multicast")
	method void PlayBrandish2Motion(Entity attacker, number dirX, number mult, number seg1Time)
		-- 브랜디쉬2 모션: swingOF(0~2) 재생 후 seg1Time 뒤 swingTF(2~3)를 이어 재생한다. 브랜디쉬 시전 중이라
		-- 상태매핑이 억제되어 있어(SuppressBrandishStateMotions) raw 모션이 덮이지 않는다. 마지막 세그먼트는
		-- 재생속도를 약간 낮춰(=조금 길게) 보여준다(요청).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local avatarRenderer = attacker.AvatarRendererComponent
		if not isvalid(avatarRenderer) then return end
		local body = avatarRenderer:GetBodyEntity()
		if not isvalid(body) then return end
		avatarRenderer.ShowDefaultWeaponEffects = false
		if isvalid(attacker.MovementComponent) then attacker.MovementComponent:Stop() end
		local playerCtrl = attacker.PlayerControllerComponent
		if isvalid(playerCtrl) then playerCtrl.LookDirectionX = dirX end
		local playRate = 1.0 / math.max(mult, 0.001)
		-- seg1: swingOF 프레임 0~2(빠르게)
		body:SendEvent(ActionStateChangedEvent("swingOF", "swingOF", playRate, SpriteAnimClipPlayType.Onetime, 0, 2))
		-- seg2: swingTF 프레임 2~3(빠르게, 마지막 조금 길게 = playRate 약간 낮춤)
		_TimerService:SetTimerOnce(function()
			if not isvalid(body) then return end
			body:SendEvent(ActionStateChangedEvent("swingTF", "swingTF", playRate * 0.8, SpriteAnimClipPlayType.Onetime, 2, 3))
		end, seg1Time)
	end

	@ExecSpace("Multicast")
	method void PlayBrandish2CastEffect(Entity attacker, number dirX)
		-- 브랜디쉬2 시전 이펙트(요청 RUID). 브랜디쉬 시전이펙트와 동일하게 몸 중앙(x=0)에 부착 재생한다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local options = { ["FlipX"] = dirX > 0, ["Alpha"] = 1.0, ["OrderInLayer"] = 5 }
		local serial = _EffectService:PlayEffectAttached("da1c1c482f114293930993049ac7b764", attacker, Vector3(0, 0.0, 0), 0, Vector3(1, 1, 1), false, options)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.0)
	end

	@ExecSpace("Multicast")
	method void PlayBrandish2Sound(Entity attacker)
		-- 브랜디쉬2 사용음(요청 RUID).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("1488e238bb474c9087cd563a892d5dcb", 1.0)
	end

	@ExecSpace("ServerOnly")
	method void SummonDarkDragon(number combatPower)
		-- 플레이어가 시전하는 서먼 다크드래곤: 수명 10분(600초).
		self:SummonDarkDragonLife(combatPower, 600)
	end

	method void SummonDarkDragonLife(number combatPower, number lifetime)
		-- 서먼 다크드래곤: 드래곤 소환수(DarkDragon 컴포넌트)를 플레이어의 자식으로 스폰한다.
		-- spearburstfadingeffect 모델(Sprite+Transform, 기본 RUID "")을 몸체로 재활용 - 별도 모델 불필요.
		-- 위치/애니는 DarkDragon 컴포넌트가 처리(클라 로컬 궤도 + 프레임 교체). 블랙드래곤 연쇄 소환도 이걸 재호출.
		-- lifetime: 드래곤 수명(초). 플레이어 시전=600, 드래곤 버프(서먼블랙드래곤)로 나온 것=90.
		self._T.pendingDarkDragonCombatPower = combatPower
		self._T.darkDragonSeq = (self._T.darkDragonSeq or 0) + 1
		local dragon = _SpawnService:SpawnByModelId("spearburstfadingeffect", "DarkDragon" .. tostring(self._T.darkDragonSeq), Vector3(0, 1.0, 0), self.Entity)
		if not isvalid(dragon) then
			log_warning("[DarkDragon] 소환 실패(spawn nil)")
			return
		end
		dragon:AddComponent("script.DarkDragon")
		---@type DarkDragon
		local comp = dragon:GetComponent("script.DarkDragon")
		if isvalid(comp) then
			comp.OwnerEntity = self.Entity
			comp.Lifetime = lifetime
		end
		log("[DarkDragon] 소환 완료 seq=" .. tostring(self._T.darkDragonSeq) .. " combatPower=" .. tostring(combatPower) .. " lifetime=" .. tostring(lifetime))
	end

	method number GetDarkDragonCombatPower()
		-- 드래곤(블랙드래곤 연쇄 소환/공격)이 참조하는 소환 시점 전투력.
		return self._T.pendingDarkDragonCombatPower or 0
	end

	@ExecSpace("ServerOnly")
	method void DealDarkDragonHit(Entity target)
		-- 드래곤 공격 1타: 단일 대상 포인터(darkDragonCurrentTarget)로 걸러 skill.darkdragon(200~300%) 판정.
		if not isvalid(target) then return end
		self._T.darkDragonCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.darkdragon", target)
	end

	@ExecSpace("Multicast")
	method void PlayBrandishUseSound(Entity attacker)
		-- 브랜디쉬 사용음. MSW 라이브러리의 구버전 원본 팩(skill/112.img/skill/1121008)에 그대로 살아있다.
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		_SoundService:PlaySound("6c06fe8ab27b469eb61f466ea7f7e182", 1.0)
	end

	@ExecSpace("Multicast")
	method void PlayBrandishCastEffect(Entity attacker, number dirX, boolean enhanced)
		-- 시전 이펙트(주황 아크 9프레임) - skill/800033.img/skill/80003319의 effect(요청).
		-- animationclip이라 EffectService로 바로 재생한다(스프라이트 프레임 교체 방식 불필요).
		-- (요청) 좌우를 반대로 뒤집고(FlipX 조건 반전) 높이를 0.4 내렸다(y 0.4 -> 0.0, 40픽셀).
		-- (요청) 이펙트를 몸쪽으로 - x 0.6 -> 0.3 -> -0.45 -> -0.2 -> 0. 이제 앞뒤 치우침 없이
		-- 캐릭터 몸 중앙에 붙는다(x가 0이라 dirX를 곱해도 그대로 0 - 방향과 무관하게 항상 중앙).
		if not self:IsClient() then return end
		if not isvalid(attacker) then return end
		local options = { ["FlipX"] = dirX > 0, ["Alpha"] = 1.0, ["OrderInLayer"] = 5 }
		-- (브랜디쉬 강화 버프) 활성 시 이펙트를 진한 빨강으로 물들인다(요청). Color는 원본 픽셀에 곱해지므로
		-- 밝은 주황 아크에 (1.0, 0.13, 0.13)을 곱하면 초록/파랑 성분이 크게 줄어 진한 빨강이 된다(아이콘과 일관).
		if enhanced then options["Color"] = Color(1.0, 0.13, 0.13, 1.0) end
		local serial = _EffectService:PlayEffectAttached("1c29e2f0793a48eb8aa40f697b93963d", attacker, Vector3(0, 0.0, 0), 0, Vector3(1, 1, 1), false, options)
		-- (버그 수정) "8번째 9번째 프레임이 보이지 않아 부자연스럽다" - 이 클립은 정확히 9프레임인데
		-- (리소스 조회로 확인: index 0~8), 아래 정리용 타이머가 1.0초에 이펙트를 지워버려 재생이 끝나기
		-- 전에 잘려나갔다(메이플 스킬 이펙트는 프레임당 100~120ms라 9프레임이면 약 0.9~1.1초).
		-- 이 타이머는 클립이 끝나도 남는 경우를 대비한 안전망일 뿐이므로, 클립 길이보다 확실히 뒤인
		-- 2.0초로 미뤄 9프레임이 전부 나오게 한다(isLoop=false라 재생이 끝나면 더 진행되지 않는다).
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 2.0)
	end

	-- ── 용사 소환(3차) ───────────────────────────────────────────────────
	-- 전사 3계열(히어로/팔라딘/다크나이트) 중 랜덤 1명을 아바타 NPC로 소환한다. AI/장비/스킬은
	-- script.HeroSummon이 담당하고, 여기서는 스폰과 skill.herosummon 판정 파이프라인만 맡는다.

	@ExecSpace("ServerOnly")
	method void SummonHero(number playerLevel)
		-- 용사 소환: herosummon 모델(아바타 NPC)을 맵에 스폰. 기존 용사가 있으면 교체한다.
		local old = self._T.heroSummonEntity
		if isvalid(old) then old:Destroy() end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_warning("[HeroSummon] 소환 실패 - CurrentMap 없음")
			return
		end
		local myPos = self.Entity.TransformComponent.WorldPosition
		self._T.heroSummonSeq = (self._T.heroSummonSeq or 0) + 1
		local hero = _SpawnService:SpawnByModelId("herosummon", "HeroSummon" .. tostring(self._T.heroSummonSeq), Vector3(myPos.x, myPos.y + 0.2, 0), map)
		if not isvalid(hero) then
			log_warning("[HeroSummon] 소환 실패(spawn nil)")
			return
		end
		hero:AddComponent("script.HeroSummon")
		---@type HeroSummon
		local comp = hero:GetComponent("script.HeroSummon")
		if isvalid(comp) then
			-- AddComponent 직후에는 프로퍼티 대입만 한다(같은 프레임 메서드 호출은 _T 미초기화로
			-- LEA-2007 위험 - 실제 초기화는 HeroSummon이 첫 ServerTick에서 지연 실행).
			local lines = { "hero", "paladin", "darkknight" }
			comp.OwnerEntity = self.Entity
			comp.HeroLevel = math.max(1, math.floor(playerLevel * 2 / 3))
			comp.HeroLine = lines[_UtilLogic:RandomIntegerRange(1, 3)]
			comp.Lifetime = 300
			-- 용사 HP = 주인 최대 HP의 2/3 (머리 위 HP바 표시용 - HeroSummon.SpawnHpBar)
			local ownerMaxHp = 50
			if isvalid(self.Entity.PlayerComponent) then
				ownerMaxHp = self.Entity.PlayerComponent.MaxHp or 50
			end
			comp.HeroMaxHp = math.max(1, math.floor(ownerMaxHp * 2 / 3))
			comp.HeroHp = comp.HeroMaxHp
		end
		self._T.heroSummonEntity = hero
		log("[HeroSummon] 스폰 완료 seq=" .. tostring(self._T.heroSummonSeq) .. " playerLevel=" .. tostring(playerLevel))
	end

	-- ── 힐러 소환(3차) ───────────────────────────────────────────────────
	-- 비숍 힐러를 아바타 NPC로 소환한다. AI/장비/힐·텔레포트는 script.HealerSummon이 담당하고,
	-- 여기서는 스폰과 해제만 맡는다(공격 스킬이 없어 판정 파이프라인이 필요 없다).

	@ExecSpace("ServerOnly")
	method void SummonHealer(number playerLevel)
		-- 힐러 소환: healersummon 모델(아바타 NPC)을 맵에 스폰. 기존 힐러가 있으면 교체한다.
		local old = self._T.healerSummonEntity
		if isvalid(old) then old:Destroy() end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_warning("[HealerSummon] 소환 실패 - CurrentMap 없음")
			return
		end
		local myPos = self.Entity.TransformComponent.WorldPosition
		self._T.healerSummonSeq = (self._T.healerSummonSeq or 0) + 1
		local healer = _SpawnService:SpawnByModelId("healersummon", "HealerSummon" .. tostring(self._T.healerSummonSeq), Vector3(myPos.x, myPos.y + 0.2, 0), map)
		if not isvalid(healer) then
			log_warning("[HealerSummon] 소환 실패(spawn nil)")
			return
		end
		healer:AddComponent("script.HealerSummon")
		---@type HealerSummon
		local comp = healer:GetComponent("script.HealerSummon")
		if isvalid(comp) then
			-- AddComponent 직후에는 프로퍼티 대입만 한다(같은 프레임 메서드 호출은 _T 미초기화로
			-- LEA-2007 위험 - 실제 초기화는 HealerSummon이 첫 ServerTick에서 지연 실행).
			comp.OwnerEntity = self.Entity
			comp.HealerLevel = math.max(1, math.floor(playerLevel * 2 / 3))
			comp.Lifetime = 300
			-- 힐러 HP = 주인 최대 HP의 2/3 (용사와 같은 규격 - 머리 위 HP바 표시용)
			local ownerMaxHp = 50
			if isvalid(self.Entity.PlayerComponent) then
				ownerMaxHp = self.Entity.PlayerComponent.MaxHp or 50
			end
			comp.HealerMaxHp = math.max(1, math.floor(ownerMaxHp * 2 / 3))
			comp.HealerHp = comp.HealerMaxHp
		end
		self._T.healerSummonEntity = healer
		log("[HealerSummon] 스폰 완료 seq=" .. tostring(self._T.healerSummonSeq) .. " playerLevel=" .. tostring(playerLevel))
	end

	@ExecSpace("ServerOnly")
	method void DismissHealer()
		-- 힐러 소환 취소(버프 아이콘 우클릭): 소환된 힐러를 즉시 제거한다.
		local healer = self._T.healerSummonEntity
		if isvalid(healer) then
			healer:Destroy()
		end
		self._T.healerSummonEntity = nil
		log("PlayerAttack: 힐러 소환 취소(우클릭) - 힐러 제거")
	end

	-- ── 암행(1차 패시브) ─────────────────────────────────────────────
	-- 스킬 1회 시전이 한 대상을 때리는 타수만큼 20% 확률로(TryProcElementalZones에서
	-- 시전별 추적 대상 기준으로 굴림 - 다수 대상으로 퍼진 같은 줄은 1번만) 맞은 적 주변
	-- 랜덤 위치(1.5~4.0, 좌우 랜덤 + 위쪽 0~1.2 부양)에 그림자를 소환한다. 그림자는
	-- 별도 생성 이펙트 없이 투명도 70%로 나타나 스윙 모션(skill/411.img/skill/4111002
	-- special/swingO1·O2·O3·OF 중 랜덤 1, 0.7배속)으로 표창을 하나 던지고, 그 자리에서
	-- 서서히 투명해지며 사라진다(dead 클립 없이 알파 페이드 - 그래서 그림자는 이펙트가
	-- 아니라 엔티티(amhaengshadow 모델)로 스폰해 SpriteRenderer 알파를 계단식으로 낮춘다).
	-- 표창은 그림자→적 각도로 날아가 전투력의 100%~200% 피해를 준다(AmhaengShuriken 위임).

	-- ── 백스탭(2차) ──────────────────────────────────────────────────────
	-- 몬스터가 바라보는 방향의 "뒤쪽"에서 때리면 데미지가 늘어난다. 포인트 1당 +5%p이며
	-- 20 마스터면 +100%(2배)다.
	-- 판정을 서버에 두는 이유: 대상이 바라보는 방향(몬스터 모델의 좌우 반전)은 AI가 굴러가는 서버가
	-- 기준이고, 데미지 공식(CalcDamage) 자체도 서버에서만 실행된다.
	-- 적용 범위: 이 컴포넌트의 CalcDamage를 타는 공격 - 기본공격과 근접/직접 타격 스킬 전부.
	-- 투사체 스킬(럭키세븐/화살 계열 등)은 각자 자기 파일의 CalcDamage에서 시전 시점에 데미지를
	-- 미리 굴려두므로(PreRolled) 이번 범위에 넣지 않았다.

	@ExecSpace("ServerOnly")
	method void SetBackstabState(boolean on, integer level)
		-- 백스탭 토글 상태 + 투자 포인트의 서버측 스위치. 기본은 OFF(nil)이며
		-- SkillManager.RequestSetBackstabState가 토글 시와 포인트를 찍을 때마다 호출한다.
		self._T.backstabEnabled = on
		self._T.backstabLevel = level
		log("PlayerAttack: 백스탭 서버 스위치 = " .. tostring(on) .. " Lv." .. tostring(level))
	end

	method boolean IsFacingRight(Entity target)
		-- 대상(몬스터)이 오른쪽을 바라보고 있는지. 원본 WZ 아트는 왼쪽을 바라보는 것이 기본이라
		-- 오른쪽을 볼 때 좌우가 반전된다. 이 프로젝트의 몬스터 모델은 반전을 TransformComponent.Scale.x
		-- 음수로 표현하고(스프라이트와 콜라이더를 함께 뒤집는 몬스터 관례 - 이 파일의
		-- PlaySpearBurstHitEffect 주석 참고), 일부 엔티티는 SpriteRendererComponent.FlipX를 쓴다.
		-- 둘 중 하나만 켜져 있으면 반전(=오른쪽 바라봄), 둘 다 켜져 있으면 원래대로(=왼쪽)다.
		if not isvalid(target) then return false end
		local flipped = false
		local tr = target.TransformComponent
		if isvalid(tr) and tr.Scale.x < 0 then flipped = not flipped end
		local spr = target.SpriteRendererComponent
		if isvalid(spr) and spr.FlipX == true then flipped = not flipped end
		return flipped
	end

	method boolean IsBackstabPosition(Entity attacker, Entity defender)
		-- 공격자가 대상의 "뒤통수" 쪽에 서 있는지. 대상이 오른쪽을 보고 있으면 대상보다 왼쪽,
		-- 왼쪽을 보고 있으면 대상보다 오른쪽에 있을 때 뒤쪽이다. x가 같으면(정확히 겹침) 뒤가 아니다.
		if not isvalid(attacker) or not isvalid(defender) then return false end
		local ax = attacker.TransformComponent.WorldPosition.x
		local dx = defender.TransformComponent.WorldPosition.x
		if ax == dx then return false end
		if self:IsFacingRight(defender) then
			return ax < dx
		end
		return ax > dx
	end

	method boolean IsBackstabLatched(Entity defender)
		-- **한 번의 시전은 하나의 판정으로 굳힌다.**
		-- (버그 수정) "새비지블로우 6줄 중 맨 아래 줄(=1타)만 백스탭이 적용되는 것 같다"는 신고 대응.
		-- 다타 스킬은 타격 사이(0.1~0.2초)에 대상이 플레이어 쪽으로 돌아설 수 있어(피격 → 추격 전환)
		-- 매 타격마다 새로 판정하면 1타만 걸리고 나머지는 빠진다. 대상별로 첫 타격의 판정을 기억해두고
		-- 타격이 촘촘히 이어지는 동안은 그 값을 그대로 써서 "한 시전 = 전부 적용 또는 전부 미적용"으로
		-- 맞춘다. (같은 신고의 또 다른 원인인 "앞선 타격에 대상이 죽은 뒤의 표시 전용 데미지 재굴림"은
		-- 각 Deal*Hit의 `if not actuallyHit` 분기에서 ApplyBackstabBonus를 함께 호출해 막았다.)
		local now = _UtilLogic.ElapsedSeconds
		local latches = self._T.backstabLatches
		if latches == nil then
			latches = {}
			self._T.backstabLatches = latches
		end
		-- (연막 4차) 연막 안에서 하는 공격은 위치와 무관하게 **전부 백스탭 취급**한다(요청 사양).
		if self:IsSmokeScreenActive() then
			return true
		end
		local cur = latches[defender]
		if cur ~= nil then
			-- GAP 이상 끊겼으면 새 시전으로 본다(다타 스킬의 타격 간격은 0.1~0.2초, 스킬 재사용
			-- 대기시간은 그보다 훨씬 길다). HOLD는 폭풍의 시/속사처럼 키를 눌러 계속 쏘는 스킬이
			-- 첫 판정을 무한히 붙들지 않게 하는 상한이다.
			local GAP = 0.35
			local HOLD = 1.5
			if (now - cur.last) <= GAP and (now - cur.first) <= HOLD then
				cur.last = now
				return cur.behind
			end
		end
		-- 오래된 항목 정리 - 대상이 계속 바뀌어도 표가 무한히 커지지 않게 한다.
		for k, v in pairs(latches) do
			if (now - v.last) > 3.0 then latches[k] = nil end
		end
		local behind = self:IsBackstabPosition(self.Entity, defender)
		latches[defender] = { behind = behind, first = now, last = now }
		return behind
	end

	method integer ApplyBackstabBonus(integer dmg, Entity attacker, Entity defender, string attackInfo)
		-- 백스탭 추가 데미지를 얹는다. 켜져 있고, 이 플레이어 본인의 공격이고, 대상의 뒤쪽에서
		-- 때렸을 때만 (1 + 0.05 × 포인트)를 곱한다. 조건이 하나라도 아니면 원래 값 그대로다.
		if self._T.backstabEnabled ~= true then return dmg end
		local level = self._T.backstabLevel or 0
		if level <= 0 then return dmg end
		-- 소환수 공격(용사/드래곤 등)은 공격자가 플레이어가 아니므로 제외한다 - "내가 뒤에서 때렸다"가
		-- 스킬 설명이고, 소환수 위치까지 태우면 의도와 어긋난다.
		if attacker ~= self.Entity then return dmg end
		if not isvalid(defender) then return dmg end
		if not self:IsBackstabLatched(defender) then return dmg end
		local bonusRate = 0.05 * level
		local out = math.floor(dmg * (1.0 + bonusRate))
		log("[Backstab] 뒤통수 적중! Lv." .. tostring(level) .. " (+" .. tostring(math.floor(bonusRate * 100))
			.. "%) " .. tostring(dmg) .. " -> " .. tostring(out)
			.. " target=" .. tostring(defender.Name) .. " facingRight=" .. tostring(self:IsFacingRight(defender))
			.. " attackInfo=" .. tostring(attackInfo))
		self:TryBackstabDarkSightShake()
		return out
	end

	-- ── 백스탭 + 다크사이트 동시 적중 연출 ────────────────────────────────
	-- (요청) 백스탭 추가 데미지와 다크사이트 딜(은신 중/은신을 푸는 그 공격)이 **동시에** 들어간
	-- 순간에만 화면이 좌우로 조금씩 한 번 흔들린다. 둘 중 하나만이면 아무 일도 없다.

	method void TryBackstabDarkSightShake()
		-- 백스탭이 실제로 적용된 히트에서만 호출된다(ApplyBackstabBonus 끝). 여기서 다크사이트 쪽
		-- 조건을 함께 확인해 둘 다 맞을 때만 흔들림을 시전자 화면에 보낸다.
		-- 다크사이트 딜 판정은 GetServerCritRatePercent / GetServerCombatPower와 **같은 조건**을 쓴다 -
		-- 공격으로 은신이 풀리면 그 순간 darkSightActive는 이미 false가 되고 darkSightCritUntil(해제 후
		-- 1초)만 남으므로, 둘 중 하나라도 참이면 "이 공격은 다크사이트 딜"이다.
		local now = _UtilLogic.ElapsedSeconds
		local dsDeal = (self._T.darkSightActive == true) or ((self._T.darkSightCritUntil or 0) > now)
		if not dsDeal then return end
		-- 다타 스킬(새비지블로우 6타 등)은 이 조건이 여러 번 맞으므로 한 시전에 한 번만 흔든다.
		if (self._T.bsShakeUntil or 0) > now then return end
		self._T.bsShakeUntil = now + 0.6
		local pcomp = self.Entity.PlayerComponent
		if not isvalid(pcomp) then return end
		self:PlayBackstabDarkSightShake(pcomp.UserId)
		log("[Backstab] 다크사이트 동시 적중 - 좌우 화면 흔들림 재생")
	end

	@ExecSpace("Client")
	method void PlayBackstabDarkSightShake()
		-- (요청) 같은 순간에 화면 왼쪽(높이 65%)에 "CRITICAL" 배너도 한 번 띄운다.
		-- 배너 본체는 전용 UI 그룹(ui/BackstabCriticalGroup.ui)과 BackstabCriticalUI가 담당한다.
		-- (기능 수정) "흔들림 때문에 확인이 어렵다" - 흔들림이 끝난 직후부터 재생하도록 아래 흔들림
		-- 길이(dur 0.24초)보다 약간 뒤인 0.26초를 시작 지연으로 넘긴다.
		_BackstabCriticalUI:PlaySequence(0.26)
		-- 좌우로만 조금씩 한 번 흔든다. CameraComponent.ShakeCamera는 흔들 방향을 지정할 수 없어
		-- (intensity/duration만 받는다) 좌우 전용 연출이 안 되므로, 클라 전용 값인 CameraOffset의
		-- x만 감쇠 진동시키고 끝나면 원래 값으로 되돌린다(y는 건드리지 않는다).
		local cam = _CameraService:GetCurrentCameraComponent()
		if not isvalid(cam) then return end
		-- 이미 흔들고 있으면 겹쳐 걸지 않는다 - 원래 오프셋을 흔들리는 중간값으로 덮어써버리면
		-- 흔들림이 끝난 뒤 화면이 옆으로 밀린 채 남는다.
		if self._T.bsShakeRunning == true then return end
		self._T.bsShakeRunning = true
		local base = cam.CameraOffset
		local amp = 0.12          -- 좌우 최대 진폭(월드 유닛 = 12픽셀). "조금씩"에 맞춘 값
		local dur = 0.24          -- 전체 길이
		local step = 1.0 / 60.0
		local elapsed = 0.0
		local tid = 0
		tid = _TimerService:SetTimerRepeat(function()
			elapsed = elapsed + step
			local c = _CameraService:GetCurrentCameraComponent()
			if not isvalid(c) or elapsed >= dur then
				if isvalid(c) then c.CameraOffset = base end
				_TimerService:ClearTimer(tid)
				self._T.bsShakeRunning = false
				return
			end
			-- 좌 → 우 → 좌로 2왕복 하면서 진폭이 0으로 줄어든다(감쇠 진동).
			local t = elapsed / dur
			c.CameraOffset = Vector2(base.x + math.sin(t * math.pi * 4.0) * amp * (1.0 - t), base.y)
		end, step)
	end

	@ExecSpace("ServerOnly")
	method void SetAmhaengEnabled(boolean on)
		-- (요청) 암행 토글 상태의 서버측 스위치. 켜져 있을 때만 온히트 프록(20% 굴림)이 동작한다.
		-- 기본은 OFF(nil) - SkillManager.RequestSetAmhaengActive가 토글 시마다 호출한다.
		self._T.amhaengEnabled = on
		log("PlayerAttack: 암행 서버 스위치 = " .. tostring(on))
	end

	-- ── 암행2(3차) ────────────────────────────────────────────────────────
	-- (요청) 암행1과 **같은 확률(5% - 처음 20%에서 하향)이지만 완전히 독립적으로** 굴린다 - 암행1이 터졌다고 암행2가
	-- 함께 터지는 것이 아니다. 발동하면 맞은 몬스터가 **바라보는 방향의 뒤쪽**에 그림자가 나타나
	-- 쉐도우 파트너 그림자와 같은 special/* 클립으로 더블스탭 또는 새비지블로우 모션을 재생하고,
	-- 그 스킬의 타격 이펙트를 **알파 0.65**로 얇게 재생하며 한 타당 전투력의 100%~200% 피해를 준다
	-- (한 타당 데미지 공식은 암행1의 표창과 동일 - 3차 상위 스킬이지만 타수만 늘어난 셈).

	@ExecSpace("ServerOnly")
	method void SetAmhaeng2Enabled(boolean on)
		-- 암행2 토글의 서버측 스위치. 기본은 OFF(nil).
		self._T.amhaeng2Enabled = on
		log("PlayerAttack: 암행2 서버 스위치 = " .. tostring(on))
	end

	@ExecSpace("ServerOnly")
	method Entity PickAmhaengRangeTarget()
		-- (요청) 암행1·암행2는 모두 "때린 그 몬스터"가 아니라 **드래곤 로어 절반 범위
		-- (가로 ±7.5 / 세로 ±3.75) 안의 랜덤한 위치의 적**을 공격한다. 범위 판정은 샤이닝 레이와
		-- 같은 함수를 재사용하고(거리순 정렬된 목록) 그중 하나를 무작위로 고른다.
		-- (암행2에서 먼저 도입 → 이후 요청으로 암행1도 같은 규칙을 쓰게 되어 공용 함수로 이름을 바꿨다.)
		local myPos = self.Entity.TransformComponent.WorldPosition
		local candidates = self:FindShiningRayTargets(Vector2(myPos.x, myPos.y), 30)
		if #candidates <= 0 then return nil end
		return candidates[_UtilLogic:RandomIntegerRange(1, #candidates)]
	end

	method table GetAmhaeng2PoseClips(string variant)
		-- 그림자가 취할 포즈(쉐도우 파트너 그림자와 동일한 skill/411.img/skill/4111002 special/* 클립).
		-- 더블스탭 = 찌르기 2연타, 새비지블로우 = 본체 6타의 포즈 조합과 같은 순서.
		if variant == "doublestab" then
			return {
				"8736f22509854a2a873a12da0bdea57a",   -- special/stabO1
				"087ddd3b2038432d8477a9ce1d2a4977",   -- special/stabO2
			}
		end
		return {
			"8736f22509854a2a873a12da0bdea57a",   -- special/stabO1
			"1e8698fd912644f28458031b25a62827",   -- special/swingOF
			"06184b0d6c0446c6944827222843b399",   -- special/proneStab
			"1e8698fd912644f28458031b25a62827",   -- special/swingOF
			"07531c9679d44f7992d7c66871b5f551",   -- special/swingO2
			"8736f22509854a2a873a12da0bdea57a",   -- special/stabO1
		}
	end

	@ExecSpace("ServerOnly")
	method void SpawnAmhaeng2Shadow(Entity target)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		if not isvalid(target) then return end
		local tp = target.TransformComponent.WorldPosition
		-- 뒤쪽 = 대상이 바라보는 방향의 반대편(백스탭과 같은 IsFacingRight 판정을 재사용한다).
		local behindDir = -1
		if not self:IsFacingRight(target) then behindDir = 1 end
		local dist = 0.8 + _UtilLogic:RandomDouble() * 0.4
		local sx = tp.x + behindDir * dist
		local sy = tp.y
		-- 그림자는 대상을 바라본다(대상이 그림자보다 오른쪽이면 +1).
		local faceDir = 1
		if tp.x < sx then faceDir = -1 end

		local variant = "doublestab"
		if _UtilLogic:RandomDouble() < 0.5 then variant = "savageblow" end
		local poses = self:GetAmhaeng2PoseClips(variant)
		local interval = 0.18
		if variant == "savageblow" then interval = 0.09 end

		self._T.amhaeng2Seq = (self._T.amhaeng2Seq or 0) + 1
		local seq = self._T.amhaeng2Seq
		local shadow = _SpawnService:SpawnByModelId("amhaengshadow", "amh2shadow_" .. tostring(seq), Vector3(sx, sy, 0), map)
		if not isvalid(shadow) then
			log_warning("[Amhaeng2] 그림자 스폰 실패")
			return
		end
		local spr = shadow.SpriteRendererComponent
		if isvalid(spr) then
			spr.SpriteRUID = poses[1]
			spr.Color = Color(1, 1, 1, 0.7)   -- 그림자 자체는 암행1과 같은 70%
		end
		-- 클립 기본 방향은 왼쪽 바라봄 - 오른쪽을 봐야 하면 Scale.x 반전(암행1과 동일).
		if faceDir >= 0 then
			shadow.TransformComponent.Scale = Vector3(-1, 1, 1)
		end

		-- (요청) 새비지블로우 변형은 그림자 자리에서 전용 이펙트 클립을 시전당 1회 재생한다.
		-- (피드백) "좀 더 아래로" - 높이를 sy + 0.35 → sy 로 0.35유닛 내렸다(그림자 발밑 높이).
		if variant == "savageblow" then
			self:PlayAmhaeng2SavageBlowCastEffect(sx + faceDir * 0.35, sy, faceDir)
		end

		-- 한 타당 데미지는 던지는 시점(=발동 시점)에 미리 확정한다(암행1과 동일 공식/동일 캐싱 방식).
		local cp = math.max(self:GetServerCombatPower(), 10)
		for i = 1, #poses do
			local poseIdx = i
			local poseRuid = poses[i]
			local presetDamage = math.floor(cp * (1.0 + _UtilLogic:RandomDouble()))
			_TimerService:SetTimerOnce(function()
				if not isvalid(self.Entity) then return end
				if isvalid(shadow) and isvalid(shadow.SpriteRendererComponent) then
					shadow.SpriteRendererComponent.SpriteRUID = poseRuid
				end
				self:DealAmhaeng2Hit(target, presetDamage, variant, faceDir, poseIdx)
			end, interval * (poseIdx - 1) + 0.08)
		end
		-- 마지막 타격 뒤 그 자리에서 서서히 사라진다(암행1의 페이드 재사용).
		_TimerService:SetTimerOnce(function()
			self:FadeOutAmhaengShadow(shadow)
		end, interval * #poses + 0.16)
		log("[Amhaeng2] 그림자 소환 variant=" .. variant .. " x=" .. string.format("%.2f", sx)
			.. " behindDir=" .. tostring(behindDir) .. " face=" .. tostring(faceDir) .. " hits=" .. tostring(#poses))
	end

	@ExecSpace("Server")
	method void DealAmhaeng2Hit(Entity target, number presetDamage, string variant, number faceDir, integer hitIndex)
		-- 암행2 그림자의 한 타. 데미지 공식/단일 대상 게이트는 암행1과 같은 preset 경로를 쓰되
		-- attackInfo를 "skill.amhaeng2"로 따로 두어 **데미지 숫자를 흉내내는 스킬처럼 직접 표시**한다.
		-- (버그 수정) 처음엔 "skill.amhaeng"을 그대로 썼는데, 쉐도우 파트너가 켜져 있으면
		-- GetDisplayHitCount가 0을 돌려주므로(모든 히트의 엔진 자동표시 off) 데미지 숫자가 아예
		-- 안 떠서 "더블스탭 2줄 / 새비지블로우 6줄이 아니다"로 보였다. 이제 각 타마다
		-- 본체 스킬과 똑같은 Show*DamageSkin으로 hitIndex 위치에 한 줄씩 쌓아 올린다.
		if not isvalid(self.Entity) then return end
		if not isvalid(target) then return end
		self._T.amhaengCurrentTarget = target
		self._T.amhaengHitPreset = presetDamage
		self._T.inAmhaengHit = true
		self._T.lastAmhaeng2Damage = presetDamage
		self._T.lastAmhaeng2IsCritical = false
		local targetPos = target.TransformComponent.WorldPosition
		local shape = CircleShape(Vector2(targetPos.x, targetPos.y), 0.6)
		self:AttackShadowSafe(shape, "skill.amhaeng2", target)
		self._T.inAmhaengHit = false
		self._T.amhaengCurrentTarget = nil
		self._T.amhaengHitPreset = 0
		-- 실제 적용된 값(크리티컬/쉐도우 파트너 보너스 반영)을 CalcDamage가 캐싱해둔 것으로 표시한다.
		local shown = self._T.lastAmhaeng2Damage or presetDamage
		local shownCrit = self._T.lastAmhaeng2IsCritical or false
		local bonus = self._T.shadowEchoBonus or 0
		local bonusCrit = self._T.shadowEchoBonusIsCritical or false
		if variant == "doublestab" then
			self:ShowDoubleStabDamageSkin(target, shown, hitIndex, bonus, shownCrit, bonusCrit)
			self:PlayAmhaeng2DoubleStabHitEffect(target, faceDir)
		else
			self:ShowSavageBlowDamageSkin(target, shown, hitIndex, bonus, shownCrit, bonusCrit)
			self:SpawnAmhaeng2SavageBlowHitEffect(target, faceDir)
		end
	end

	@ExecSpace("Multicast")
	method void PlayAmhaeng2SavageBlowCastEffect(number x, number y, number faceDir)
		-- (요청) 암행2의 새비지블로우는 이 이펙트 클립(skill/800033.img/skill/80003303의 effect)이
		-- 보여야 한다. 본체 새비지블로우의 연출(SavageBlowVisual)에 대응하는 "시전 이펙트"이므로
		-- 그림자 자리에서 시전당 1회 재생한다.
		-- 정지 스프라이트 3종(타격 이펙트)과 달리 이것은 animationclip이라 _EffectService로 재생한다.
		-- (피드백) "좀 더 아래로, 투명도 40%" - 높이 오프셋을 0.35 낮추고(호출부 참고) 알파를 0.4로 내렸다.
		if not self:IsClient() then return end
		local serial = _EffectService:PlayEffect("d068d34b66d34aa28a170dfa5b55e13f", self.Entity, Vector3(x, y, 0), 0,
			Vector3(1, 1, 1), false, { ["FlipX"] = faceDir > 0, ["Alpha"] = 0.4, ["OrderInLayer"] = 12 })
		log("[Amhaeng2] 새비지블로우 이펙트 재생 serial=" .. tostring(serial)
			.. string.format(" pos=(%.2f, %.2f)", x, y) .. " alpha=0.40 flipX=" .. tostring(faceDir > 0))
	end

	@ExecSpace("Multicast")
	method void PlayAmhaeng2DoubleStabHitEffect(Entity target, number faceDir)
		-- 더블스탭 타격 이펙트(본체와 같은 클립)를 알파 65%로 재생한다.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("8de01c7022964b1b9d6cf96070073446", target,
			Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["FlipX"] = faceDir > 0, ["Alpha"] = 0.65 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 0.5)
	end

	@ExecSpace("ServerOnly")
	method void SpawnAmhaeng2SavageBlowHitEffect(Entity target, number faceDir)
		-- 새비지블로우 타격 이펙트 3종은 애니메이션클립이 아니라 정지 스프라이트라 _EffectService로
		-- 재생할 수 없다(본체 SpawnSavageBlowHitEffect와 같은 이유) - 알파/스케일 트윈 전용 엔티티를
		-- 쓰되 시작 알파를 0.65로 낮춰 스폰한다.
		if not isvalid(target) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local hitEffects = {
			"5154d64ae24843a3bc29a878f13768ad",
			"45087e25ef5949f68af9fe40c5b3c0a9",
			"53a8a9f33fdb42819715399936e1a7fa",
		}
		local ruid = hitEffects[_UtilLogic:RandomIntegerRange(1, 3)]
		local pos = target.TransformComponent.WorldPosition
		local fx = _SpawnService:SpawnByModelId("spearburstfadingeffect", "Amhaeng2HitFX", Vector3(pos.x, pos.y + 0.2, 0), map)
		if not isvalid(fx) then return end
		fx:AddComponent("script.SpearBurstFadingEffect")
		local comp = fx:GetComponent("script.SpearBurstFadingEffect")
		if isvalid(comp) then
			-- (버그 수정) "암행2의 새비지블로우 리소스가 안 보인다" - 본체 SpawnSavageBlowHitEffect가
			-- 채워주는 필드 중 HoldDuration / TweenDuration / OrderInLayerValue 등을 빼먹어서
			-- 지속시간 0으로 즉시 사라지고(그리고 레이어도 뒤로 깔려) 보이지 않았다.
			-- 본체와 동일하게 전부 채우고 StartAlpha만 0.65로 낮춘다.
			comp.ClipRUID = ruid
			comp.IsFlipX = faceDir > 0
			comp.StartScale = 1.0
			comp.EndScale = 1.35
			comp.StartAlpha = 0.65   -- (요청) 스킬 이미지 투명도 65%
			comp.EndAlpha = 0.0
			comp.HoldDuration = 0.05
			comp.TweenDuration = 0.15
			comp.OrderInLayerValue = 12
			comp.UseSplitGrowth = false
			comp.SecondClipRUID = ""
			comp.PivotOffsetX = 0
			comp.PivotOffsetY = 0
			comp.SecondPivotOffsetX = 0
			comp.SecondPivotOffsetY = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void SpawnAmhaengShadow(Entity target)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		if not isvalid(target) then return end
		local tp = target.TransformComponent.WorldPosition
		-- (피드백) "너무 멀리서, 좌우에서만 소환된다" - 거리를 1.5~4.0으로 좁히고,
		-- 위쪽 0~1.2 랜덤 부양을 더해 대각선 위치에서도 나타나게 한다(그림자라 공중 부양 허용).
		local dist = 1.5 + _UtilLogic:RandomDouble() * (4.0 - 1.5)
		local side = 1
		if _UtilLogic:RandomDouble() < 0.5 then side = -1 end
		local sx = tp.x + side * dist
		local sy = tp.y + _UtilLogic:RandomDouble() * 1.2
		-- 그림자가 몬스터 쪽을 바라보는 방향: 몬스터가 그림자의 오른쪽이면 +1, 왼쪽이면 -1.
		local faceDir = 1
		if tp.x < sx then faceDir = -1 end
		-- 그림자 스윙 클립(skill/411.img/skill/4111002 special/swingO1·O2·O3·OF) 중 랜덤 1.
		local clips = {
			"edfb3dd0204f49e1a5dfac95520439b8", -- special/swingO1
			"07531c9679d44f7992d7c66871b5f551", -- special/swingO2
			"fc164d4b226e4a22bab992992cdfdd4c", -- special/swingO3
			"1e8698fd912644f28458031b25a62827", -- special/swingOF
		}
		local clipIdx = _UtilLogic:RandomIntegerRange(1, 4)
		self._T.amhaengSeq = (self._T.amhaengSeq or 0) + 1
		local seq = self._T.amhaengSeq

		-- 그림자 엔티티 스폰: 클립 원점이 발밑 기준(실측)이라 지면 y 그대로 두면 땅 위에 선다.
		-- (피드백) 스윙은 0.7배 느리게 재생 - 이후 타이밍(표창 던지기/페이드 시작)도 1/0.7배로 늘려 맞춘다.
		local shadow = _SpawnService:SpawnByModelId("amhaengshadow", "amhshadow_" .. tostring(seq), Vector3(sx, sy, 0), map)
		if not isvalid(shadow) then
			log_warning("[Amhaeng] 그림자 스폰 실패")
			return
		end
		local spr = shadow.SpriteRendererComponent
		if isvalid(spr) then
			spr.SpriteRUID = clips[clipIdx]
			spr.PlayRate = 0.7
			-- (피드백) 그림자 투명도 70%(Alpha=0.7 - 쉐도우 파트너와 같은 규약). 페이드는 이 값에서 시작한다.
			spr.Color = Color(1, 1, 1, 0.7)
		end
		-- 클립 기본 방향은 왼쪽 바라봄(WZ 캐릭터 클립 관례) - 오른쪽을 봐야 하면 Scale.x 반전.
		if faceDir >= 0 then
			shadow.TransformComponent.Scale = Vector3(-1, 1, 1)
		end

		-- 표창은 스윙 중간(0.15/0.7≈0.21초)에 그림자 손 높이에서 스폰된다. 데미지는 던지는 시점에 확정.
		local cp = math.max(self:GetServerCombatPower(), 10)
		local presetDamage = math.floor(cp * (1.0 + _UtilLogic:RandomDouble()))
		local projName = "amhaeng_" .. tostring(seq)
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or not isvalid(map) then return end
			local proj = _SpawnService:SpawnByModelId("amhaengshuriken", projName, Vector3(sx + faceDir * 0.3, sy + 0.6, 0), map)
			if not isvalid(proj) then
				log_warning("[Amhaeng] 표창 스폰 실패")
				return
			end
			---@type AmhaengShuriken
			local comp = proj:GetComponent("script.AmhaengShuriken")
			if comp ~= nil then
				comp:Setup(target, self.Entity, presetDamage)
			end
		end, 0.21)
		-- (피드백) dead 클립 없이, 던진 뒤(0.3/0.7≈0.43초)부터 그 자리에서 서서히 투명해지며 사라진다.
		_TimerService:SetTimerOnce(function()
			self:FadeOutAmhaengShadow(shadow)
		end, 0.43)
		log("[Amhaeng] 그림자 소환 x=" .. string.format("%.2f", sx) .. " y=" .. string.format("%.2f", sy) .. " face=" .. tostring(faceDir) .. " clip=" .. tostring(clipIdx) .. " dmg=" .. tostring(presetDamage))
	end

	@ExecSpace("ServerOnly")
	method void FadeOutAmhaengShadow(Entity shadowEnt)
		-- 그림자 알파를 0.6초에 걸쳐 5계단으로 낮춘 뒤 파괴한다(독구름 PlayFadeOut과 동일한
		-- 계단식 타이머 패턴 - 네이티브 SpriteRenderer.Color는 서버 대입이 클라이언트로 동기화된다).
		local steps = 5
		local stepTime = 0.12
		local stepIndex = 0
		local fadeStep
		fadeStep = function()
			stepIndex = stepIndex + 1
			if not isvalid(shadowEnt) then return end
			local spr = shadowEnt.SpriteRendererComponent
			if isvalid(spr) then
				-- 기본 투명도 70%에서 시작해 0까지 내려간다.
				local a = 0.7 * (1 - stepIndex / steps)
				if a < 0 then a = 0 end
				spr.Color = Color(1, 1, 1, a)
			end
			if stepIndex < steps then
				_TimerService:SetTimerOnce(fadeStep, stepTime)
			else
				shadowEnt:Destroy(0.05)
			end
		end
		fadeStep()
	end

	@ExecSpace("Server")
	method void DealAmhaengHit(Entity target, number presetDamage)
		-- 표창(AmhaengShuriken)이 타겟에 도달한 순간 호출되어 그 대상 하나에게만 판정을 실행한다
		-- (매직 미사일과 동일한 단일 대상 게이트). 판정 동안 inAmhaengHit을 켜서 암행 데미지 줄이
		-- 다시 암행을 발동시키는 연쇄를 막는다.
		if not isvalid(self.Entity) then return end
		if not isvalid(target) then return end
		self._T.amhaengCurrentTarget = target
		self._T.amhaengHitPreset = presetDamage
		self._T.inAmhaengHit = true
		local targetPos = target.TransformComponent.WorldPosition
		local shape = CircleShape(Vector2(targetPos.x, targetPos.y), 0.6)
		self:AttackShadowSafe(shape, "skill.amhaeng", target)
		self._T.inAmhaengHit = false
		self._T.amhaengCurrentTarget = nil
		self._T.amhaengHitPreset = 0
		-- (피드백) 표창이 대상에 닿는 순간 지정된 hit 클립을 대상 몸에서 재생한다 - 판정 성공
		-- 여부와 무관하게 표창이 도달한 시점이므로 항상 재생(새비지블로우 히트 이펙트와 같은 방침).
		self:PlayAmhaengHitEffect(target)
		log("PlayerAttack: DealAmhaengHit target=" .. tostring(target.Name) .. " dmg=" .. tostring(presetDamage))
	end

	@ExecSpace("Multicast")
	method void PlayAmhaengHitEffect(Entity target)
		-- 암행 표창 명중 이펙트: 사용자 지정 hit 클립을 대상 몸(y+0.2 = 표창 조준점과 동일)에서
		-- 재생한다(매직 미사일 명중 이펙트 PlayMagicMissileHitEffect와 동일한 부착 재생 패턴).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		_EffectService:PlayEffectAttached("458e72f0720a4584a9a7fc3642b6e601", target, Vector3(0, 0.2, 0), 0, Vector3(1, 1, 1), false, {})
		log("[Amhaeng] 표창 명중 이펙트 재생 target=" .. tostring(target.Name))
	end

	-- ── 불의 영역(2차 버프) ─────────────────────────────────────────
	-- 10분간: 공격 적중(OnAttack) 시 10% 확률로 그 자리에 화염 지대를 만든다.
	-- 화염 지대 = 10초 유지, 2초마다 범위 안 몬스터에게 전투력의 200%~300% 피해.
	-- 리소스: 시전 4a729e5b(불색 틴트)/사용음 af39b536/생성음 6d345fda/장판 4종 랜덤.

	@ExecSpace("ServerOnly")
	method void CastFireZoneBuff(number combatPower)
		-- 버프 활성(10분) + 공용 alert2 시전(모션/조작잠금/사용음) + 시전 이펙트.
		self._T.fireZoneBuffUntil = _UtilLogic.ElapsedSeconds + 600.0
		self._T.fireZoneCombatPower = combatPower
		self:CastBuffMotion("af39b536300f43d3a657fc82d63abfe3", 1.0, nil)
		self:PlayFireZoneCastFx()
		log("[FireZone] 불의 영역 버프 시작(10분, 전투력=" .. tostring(math.floor(combatPower)) .. ")")
	end

	@ExecSpace("Multicast")
	method void PlayFireZoneCastFx()
		-- 시전자 몸 이펙트 1회. (피드백) 원본 클립 색을 불색(주황-붉은 틴트)으로 바꿔 재생한다.
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		-- (피드백) 몸 주변 마법진을 조금 위로(0 → 0.3).
		local serial = _EffectService:PlayEffectAttached("4a729e5b7b0f4759ba197dcbb1d25a8b", self.Entity, Vector3(0, 0.3, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8, ["Color"] = Color(1, 0.45, 0.12, 1) })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 4.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnFireZone(Vector3 pos)
		-- 화염 지대 생성: 생성음+장판 이펙트(4종 랜덤, 10초 루프) + 2초마다 범위 판정(총 5회).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local zonePower = self._T.fireZoneCombatPower or 0
		local idx = _UtilLogic:RandomIntegerRange(1, 4)
		self:PlayFireZoneSpawnFx(Vector3(pos.x, pos.y, 0), idx)
		local ticksLeft = 5
		local tick
		tick = function()
			if ticksLeft <= 0 then return end
			ticksLeft = ticksLeft - 1
			if not isvalid(self.Entity) or not isvalid(map) then return end
			local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
			for _, comp in ipairs(monsterComps) do
				---@type Monster
				local mc = comp
				if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
					local mp = mc.Entity.TransformComponent.WorldPosition
					if math.abs(mp.x - pos.x) <= 1.5 and math.abs(mp.y - pos.y) <= 1.2 then
						self:DealFireZoneDotDamage(mc.Entity, zonePower)
					end
				end
			end
			_TimerService:SetTimerOnce(tick, 2.0)
		end
		_TimerService:SetTimerOnce(tick, 2.0)
		log("[FireZone] 화염 지대 생성 x=" .. string.format("%.2f", pos.x) .. " y=" .. string.format("%.2f", pos.y))
	end

	@ExecSpace("Multicast")
	method void PlayFireZoneSpawnFx(Vector3 pos, integer idx)
		-- 생성 사운드 + 4종 중 서버가 고른 화염 장판 이펙트를 10초 루프 재생.
		-- (요청) 몬스터를 가리면 안 된다 - 화상저주 장판과 같은 원리로 OrderInLayer만으론 안 되고
		-- SortingLayer를 몬스터와 같은 "MapLayer0"으로 맞춘 뒤 몬스터(2)보다 작은 1로 깐다.
		if not self:IsClient() then return end
		local mapEntity = self.Entity.CurrentMap
		if not isvalid(mapEntity) then return end
		_SoundService:PlaySound("6d345fda6041465680c0238ff8a1f12d", 1.0)
		local ruids = {
			"288e10be2948421ebd107829c10f07ba", "923441a3738d45acbf57a54160cef756",
			"9691429ecec748e792173dd277901ee0", "6dd0db759f9a4f6680f298105676d203",
		}
		local i = math.max(1, math.min(idx, 4))
		local ruid = ruids[i]
		-- (실측 보정) 4종을 같은 y에 나란히 재생해 스크린샷으로 잰 클립별 내부 여백 편차:
		-- 1번(288e10be)은 몬스터 위치 그대로 바닥에 붙지만 2/3/4번은 각각 ~0.25/0.55/1.0유닛 떠서
		-- 클립별로 그만큼 내려 붙인다.
		local yOffsets = { 0.0, -0.25, -0.55, -1.0 }
		local groundedPos = Vector3(pos.x, pos.y + yOffsets[i], pos.z)
		local zoneOptions = { ["SortingLayer"] = "MapLayer0", ["OrderInLayer"] = 1 }
		local serial = _EffectService:PlayEffect(ruid, mapEntity, groundedPos, 0, Vector3(1, 1, 1), true, zoneOptions)
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 10.0)
	end

	@ExecSpace("ServerOnly")
	method void DealFireZoneDotDamage(Entity target, number combatPower)
		-- 화염 지대 도트 1회(단일 대상 게이트 - 차지블로우 도트와 동일 패턴). 이 판정의 OnAttack이
		-- 다시 화염 지대를 낳는 연쇄를 inFireZoneTick 플래그로 차단한다.
		if not isvalid(target) then return end
		self._T.pendingFireZonePower = combatPower
		self._T.fireZoneDotTarget = target
		self._T.inFireZoneTick = true
		local pos = target.TransformComponent.WorldPosition
		self:AttackFrom(Vector2(1.4, 2.0), Vector2(pos.x, pos.y + 0.7), "dot.firezone", CollisionGroups.HitBox)
		self._T.inFireZoneTick = false
		self._T.fireZoneDotTarget = nil
		-- (요청) 불 속성 화상 - 불의 영역 화염 지대는 도트 1회당 10% 확률.
		if _UtilLogic:RandomDouble() < 0.1 then
			self:ApplyElementalBurn(target, combatPower)
		end
	end

	method void TryProcElementalZones(Entity defender)
		-- 불의 영역/빙하지대 온히트 프록 공용 진입점. 본체 공격(OnAttack)뿐 아니라 투사체(파이어 에로우
		-- 등 11종)/독안개(포이즌 미스트)처럼 별도 AttackComponent로 판정하는 스킬도 각자의 OnAttack에서
		-- 시전자의 이 메서드를 호출한다 - "프록이 발동하는 스킬이 한정되어 있다"는 피드백의 원인이
		-- 본체 OnAttack에만 판정이 걸려 있던 것이라서다. 화염/빙하 지대 자신의 도트 판정이 다시 지대를
		-- 낳는 연쇄는 기존 inFireZoneTick 플래그로 그대로 차단한다.
		if not self:IsServer() then return end
		if not isvalid(defender) then return end
		-- (암행 - 1차 패시브) 발동 판정은 "데미지 줄마다"가 아니라 "스킬 1회 시전이 한 대상을
		-- 몇 번 때리느냐"만큼 5% 확률을 굴린다(요청사항 - 처음 20%에서 하향). 예: 매직클로(1명 2타)=2번,
		-- 슬래쉬블래스트(5명 각 1타)=1번, 스피어버스터(5명 3줄)=3번, 새비지블로우=6번.
		-- 구현: 시전마다 "처음 맞은 대상" 하나를 추적 대상으로 고정하고, 그 대상에게 들어오는
		-- 히트에서만 1회씩 굴린다 - 다른 대상 히트는 같은 줄이 옆 대상으로 퍼진 것이므로 굴리지
		-- 않는다. 시전 구분은 콤보 구슬 스택과 동일한 실측 시간창 방식(같은 시전의 히트는 0.4초
		-- 이내에 몰리고, 재사용은 쿨다운 0.7초 이상이라 겹치지 않는다). 추적 대상이 도중에 죽으면
		-- (isvalid 실패) 다음 히트의 대상으로 갈아탄다(폭풍의 시처럼 연사 중 대상이 바뀌는 경우).
		-- 쉐도우 파트너 중에는 모든 실히트가 원본+보너스 2줄이므로 히트당 2번 굴린다
		-- (새비지블로우+쉐도우 파트너 = 단일 대상 12줄 = 12번). 암행 표창 자신의 데미지로는
		-- 다시 발동하지 않는다(연쇄 방지 - inAmhaengHit).
		-- 화염/빙하 지대의 도트 데미지 줄에서도 발동하도록 inFireZoneTick 가드보다 앞에 둔다.
		-- (요청) 암행은 상시 패시브 → ON/OFF 토글로 전환 - 켜져 있을 때(amhaengEnabled)만 굴린다.
		-- 기본은 OFF이며, 토글 시 SkillManager.RequestSetAmhaengActive → SetAmhaengEnabled로 반영된다.
		if self._T.amhaengEnabled == true and not self._T.inAmhaengHit then
			local now = _UtilLogic.ElapsedSeconds
			local sinceLast = now - (self._T.amhaengTrackTime or -10)
			if sinceLast >= 0.4 or not isvalid(self._T.amhaengTrackTarget) then
				self._T.amhaengTrackTarget = defender
			end
			self._T.amhaengTrackTime = now
			if defender == self._T.amhaengTrackTarget then
				local rollCount = (self._T.shadowPartnerActive == true) and 2 or 1
				for _ = 1, rollCount do
					-- (요청) 발동 확률 20% → **5%**로 하향.
					if _UtilLogic:RandomDouble() < 0.05 then
						-- (요청) 암행1도 암행2와 같이 공격 대상이 아니라 드래곤 로어 절반 범위 안의
						-- **랜덤한 적**을 노린다(굴림 자체는 지금까지처럼 "맞은 대상" 기준으로 센다).
						local amhTarget = self:PickAmhaengRangeTarget()
						if isvalid(amhTarget) then
							self:SpawnAmhaengShadow(amhTarget)
						end
					end
				end
			end
		end
		-- (요청) 암행2(3차): 암행1과 **같은 확률(5%)**을 쓰지만 굴림은 완전히 독립이다 - 암행1이
		-- 터질 때마다 암행2가 함께 터지는 것이 아니다. 대상 추적/시전 구분 방식은 암행1과 동일하되
		-- 상태를 따로 들고 간다(amhaeng2Track*). 암행 계열 데미지 줄에서는 굴리지 않는다(연쇄 방지).
		if self._T.amhaeng2Enabled == true and not self._T.inAmhaengHit then
			local now2 = _UtilLogic.ElapsedSeconds
			local since2 = now2 - (self._T.amhaeng2TrackTime or -10)
			if since2 >= 0.4 or not isvalid(self._T.amhaeng2TrackTarget) then
				self._T.amhaeng2TrackTarget = defender
			end
			self._T.amhaeng2TrackTime = now2
			if defender == self._T.amhaeng2TrackTarget then
				local rollCount2 = (self._T.shadowPartnerActive == true) and 2 or 1
				for _ = 1, rollCount2 do
					-- (요청) 발동 확률 20% → **5%**로 하향(암행1과 같은 값, 굴림은 여전히 독립).
					if _UtilLogic:RandomDouble() < 0.05 then
						-- (요청) 공격 대상이 아니라 드래곤 로어 절반 범위 안의 **랜덤한 적**을 노린다.
						local amh2Target = self:PickAmhaengRangeTarget()
						if isvalid(amh2Target) then
							self:SpawnAmhaeng2Shadow(amh2Target)
						end
					end
				end
			end
		end
		if self._T.inFireZoneTick then return end
		-- (불의 영역) 버프 지속 중 공격 적중 시 10% 확률로 그 자리에 화염 지대를 만든다.
		if (self._T.fireZoneBuffUntil or 0) > _UtilLogic.ElapsedSeconds
			and _UtilLogic:RandomDouble() < 0.1 then
			self:SpawnFireZone(defender.TransformComponent.WorldPosition)
		end
		-- (빙하지대) 불의 영역과 독립적으로 10% 확률 - 두 버프가 모두 켜져 있으면 각각 굴린다.
		if (self._T.glacierBuffUntil or 0) > _UtilLogic.ElapsedSeconds
			and _UtilLogic:RandomDouble() < 0.1 then
			self:SpawnGlacierZone(defender.TransformComponent.WorldPosition)
		end
	end

	-- ── 빙하지대(2차 버프) ──────────────────────────────────────────
	-- 불의 영역의 얼음 판: 10분 버프, 공격 적중 시 10% 확률로 그 자리에 빙하 영역
	-- (지속 10초, 2초마다 전투력 200%~300% - 화염 지대와 같은 데미지 딜러 공유).
	-- 시전 마법진은 불의 영역과 같은 클립(4a729e5b)을 얼음/눈색(파랑-흰 틴트)으로 재생.
	-- 장판 비주얼: 눈결정 클립(f69a8c62)을 작은 랜덤 크기로 다수, 10초간 랜덤 위치에 계속 내린다.

	@ExecSpace("ServerOnly")
	method void CastGlacierZoneBuff(number combatPower)
		-- 버프 활성(10분) + 공용 alert2 시전(모션/조작잠금/사용음) + 시전 이펙트.
		self._T.glacierBuffUntil = _UtilLogic.ElapsedSeconds + 600.0
		self._T.glacierCombatPower = combatPower
		self:CastBuffMotion("af39b536300f43d3a657fc82d63abfe3", 1.0, nil)
		self:PlayGlacierCastFx()
		log("[GlacierZone] 빙하지대 버프 시작(10분, 전투력=" .. tostring(math.floor(combatPower)) .. ")")
	end

	@ExecSpace("Multicast")
	method void PlayGlacierCastFx()
		-- 시전자 몸 이펙트 1회 - 불의 영역과 같은 마법진을 얼음/눈색(파랑-흰) 틴트로 재생(마법진 y=0.3).
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local serial = _EffectService:PlayEffectAttached("4a729e5b7b0f4759ba197dcbb1d25a8b", self.Entity, Vector3(0, 0.3, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8, ["Color"] = Color(0.6, 0.85, 1, 1) })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 4.0)
	end

	@ExecSpace("ServerOnly")
	method void SpawnGlacierZone(Vector3 pos)
		-- 빙하 영역 생성: 화염 지대와 같은 틱 구조(10초, 2초마다 ±1.5/±1.2 범위, 전투력 200~300%).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		local zonePower = self._T.glacierCombatPower or 0
		self:PlayGlacierZoneFx(Vector3(pos.x, pos.y, 0))
		local ticksLeft = 5
		local tick
		tick = function()
			if ticksLeft <= 0 then return end
			ticksLeft = ticksLeft - 1
			if not isvalid(self.Entity) or not isvalid(map) then return end
			local monsterComps = map:GetChildComponentsByTypeName("script.Monster", true)
			for _, comp in ipairs(monsterComps) do
				---@type Monster
				local mc = comp
				if isvalid(mc) and isvalid(mc.Entity) and not mc.IsDead then
					local mp = mc.Entity.TransformComponent.WorldPosition
					if math.abs(mp.x - pos.x) <= 1.5 and math.abs(mp.y - pos.y) <= 1.2 then
						self:DealFireZoneDotDamage(mc.Entity, zonePower)
						-- (요청) 빙하지대에 데미지를 입은 몬스터는 30% 확률로 얼어붙는다(차지 블로우 빙결 공용,
						-- 4초 - 체인 라이트닝의 빙결 대상 판정 IsTargetFrozen과 연동된다).
						if _UtilLogic:RandomDouble() < 0.3 then
							self:ApplyChargeBlowFreeze(mc.Entity, 4.0)
						end
					end
				end
			end
			_TimerService:SetTimerOnce(tick, 2.0)
		end
		_TimerService:SetTimerOnce(tick, 2.0)
		log("[GlacierZone] 빙하 영역 생성 x=" .. string.format("%.2f", pos.x) .. " y=" .. string.format("%.2f", pos.y))
	end

	@ExecSpace("Multicast")
	method void PlayGlacierZoneFx(Vector3 pos)
		-- 생성 사운드(전용 미지정 - 화염 생성음 공유) + 눈결정을 작은 랜덤 크기(0.15~0.35)로
		-- 0.3초마다 2개씩, 영역(±1.5) 안 랜덤 위치에 10초간 계속 내린다. 몬스터를 가리지 않게
		-- 화염 지대와 같은 MapLayer0/OrderInLayer 1.
		if not self:IsClient() then return end
		local mapEntity = self.Entity.CurrentMap
		if not isvalid(mapEntity) then return end
		_SoundService:PlaySound("6d345fda6041465680c0238ff8a1f12d", 1.0)
		local elapsed = 0
		local spawnTimer
		spawnTimer = _TimerService:SetTimerRepeat(function()
			elapsed = elapsed + 0.3
			if elapsed > 10.0 then
				if spawnTimer then _TimerService:ClearTimer(spawnTimer) end
				return
			end
			-- (피드백) 생성량 절반: 0.3초마다 2개 → 1개.
			local s = 0.15 + _UtilLogic:RandomDouble() * 0.2
			local x = pos.x - 1.5 + _UtilLogic:RandomDouble() * 3.0
			-- (피드백) 생성 높이 상한을 기존(+1.8)의 2/3인 +1.2로 제한.
			local y = pos.y + 0.2 + _UtilLogic:RandomDouble() * 1.0
			-- (피드백) 재생속도 절반(0.5배) + 두 번째 프레임(인덱스 1) 제거 - 한 번에 프레임을 건너뛸 수
			-- 없어 [0]과 [2~끝] 두 구간으로 나눠 이어 재생한다(프레임당 ~0.1초/0.5배=0.2초 추정 핸드오프).
			-- (피드백) 투명도 75%.
			local optsA = { ["SortingLayer"] = "MapLayer0", ["OrderInLayer"] = 1, ["PlayRate"] = 0.5, ["Alpha"] = 0.75, ["StartFrameIndex"] = 0, ["EndFrameIndex"] = 0 }
			local serialA = _EffectService:PlayEffect("f69a8c62757a40c6bb0d5a8e6e903aab", mapEntity, Vector3(x, y, 0), 0, Vector3(s, s, 1), false, optsA)
			_TimerService:SetTimerOnce(function()
				_EffectService:RemoveEffect(serialA)
				if not isvalid(mapEntity) then return end
				local optsB = { ["SortingLayer"] = "MapLayer0", ["OrderInLayer"] = 1, ["PlayRate"] = 0.5, ["Alpha"] = 0.75, ["StartFrameIndex"] = 2 }
				local serialB = _EffectService:PlayEffect("f69a8c62757a40c6bb0d5a8e6e903aab", mapEntity, Vector3(x, y, 0), 0, Vector3(s, s, 1), false, optsB)
				_TimerService:SetTimerOnce(function()
					_EffectService:RemoveEffect(serialB)
				end, 3.0)
			end, 0.2)
		end, 0.3)
	end

	-- ── 리저렉션(4차) ───────────────────────────────────────────────
	-- 죽어 쓰러져 있는(사망 상태 10초 안) 소환 용사를 그 자리에서 HP 가득 찬 상태로 부활시킨다.
	-- 리소스: 원본 팩 skill/232.img/skill/2321006 (시전 c6f54657 / 부활 64b8f9ee / 사용음 fda4b435).

	@ExecSpace("ServerOnly")
	method void CastResurrection()
		-- 시전 이펙트+사용음은 대상이 없어도 재생한다. (피드백) 시전 이펙트와 부활 이펙트는 동시에
		-- 시작하고, 부활 이펙트 7프레임 시점에 부활시킨다(프레임당 0.12초 - WZ 표준 딜레이 가정).
		-- (피드백) 사용 모션은 2차 버프와 같은 alert2 계열 공용 시전(숨고르기+조작잠금). 잠금은
		-- 시전 이펙트 전체 길이의 0.7배: 19×0.12/0.7×0.7 ≈ 2.28초(클라 스킬 잠금과 동일).
		-- 사용음은 CastBuffMotion이 함께 재생한다.
		self:CastBuffMotion("fda4b4350ef14f07b2de294974efe1aa", 1.0, 19 * 0.12 / 0.7 * 0.7)
		self:PlayResurrectionCastFx()
		local hero = self._T.heroSummonEntity
		if not isvalid(hero) then
			log("[PlayerAttack] 리저렉션 - 부활 대상 없음(소환 용사 없음)")
			return
		end
		---@type HeroSummon
		local hs = hero:GetComponent("script.HeroSummon")
		if not isvalid(hs) or hs.HeroHp > 0 then
			log("[PlayerAttack] 리저렉션 - 부활 대상 없음(용사가 죽어 있지 않음)")
			return
		end
		-- 부활이 확정됐으니 사망 소멸 타이머를 먼저 멈춰 연출 도중 파괴되지 않게 한다.
		hs:PrepareResurrect()
		self:PlayResurrectionReviveFx(hero)
		-- (피드백 최종) 두 이펙트 모두 원본의 0.7배 재생 - 프레임당 0.12초 / 0.7 ≈ 0.171초.
		local frameDur = 0.12 / 0.7
		_TimerService:SetTimerOnce(function()
			if not isvalid(hero) then return end
			---@type HeroSummon
			local hs2 = hero:GetComponent("script.HeroSummon")
			if isvalid(hs2) then hs2:Resurrect() end
		end, 7 * frameDur)
		log("[PlayerAttack] 리저렉션 시전 - 용사 부활 예약")
	end

	@ExecSpace("Multicast")
	method void PlayResurrectionCastFx()
		-- 시전자 몸에서 시전 이펙트 1회 (사용음은 CastBuffMotion의 공용 시전이 재생한다).
		-- (피드백 최종) 전체를 원본 속도의 0.7배로 균일 재생(구간 분할 없음).
		if not self:IsClient() then return end
		if not isvalid(self.Entity) then return end
		local serial = _EffectService:PlayEffectAttached("c6f54657879448b496daecc8a15c2918", self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8, ["PlayRate"] = 0.7 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 5.0)
	end

	@ExecSpace("Multicast")
	method void PlayResurrectionReviveFx(Entity target)
		-- 죽어 쓰러진 용사 자리에 남기는 부활 이펙트 1회(발밑 y=0 부착, 원본 속도의 0.7배).
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local serial = _EffectService:PlayEffectAttached("64b8f9ee7c4f43ef98f77296c4ef145b", target, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8, ["PlayRate"] = 0.7 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, 5.0)
	end

	@ExecSpace("ServerOnly")
	method void DealHeroSummonStabHit(Entity target, number combatPower, number mult, integer hitIndex)
		-- 용사 스피어버스터 1줄(hitIndex번째): 엔진 자동 표시를 끄고(스포너 잠깐 제거 + GetDisplayHitCount=0),
		-- 원본 스피어버스터와 동일한 3줄 세로 배치(ShowSpearBurstStabDamageSkin)로 수동 표시한다.
		-- (피드백) 자동 표시로는 3타가 전부 같은 위치에 떠서 "한 줄로 3번"처럼 보였다.
		if not isvalid(target) then return end
		self._T.heroSummonCurrentTarget = target
		self._T.pendingHeroSummonCombatPower = combatPower
		self._T.pendingHeroSummonMultMin = mult
		self._T.pendingHeroSummonMultMax = mult
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local targetSkinSpawner = target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")
		if isvalid(targetSkinSpawner) then target:RemoveComponent("MOD.Core.DamageSkinSpawnerComponent") end
		self._T.lastHeroStabDamage = 0
		self:AttackShadowSafe(shape, "skill.herosummon.stab", target)
		if not isvalid(target:GetComponent("MOD.Core.DamageSkinSpawnerComponent")) then target:AddComponent("MOD.Core.DamageSkinSpawnerComponent") end
		-- 방금 판정이 실제로 적용한 값(콤보/크리 반영)을 원본과 같은 위/중간/아래 3줄 배치로 표시.
		local dmg = self._T.lastHeroStabDamage or 0
		if dmg > 0 then
			self:ShowSpearBurstStabDamageSkin(target, dmg, hitIndex, 0, self._T.lastHeroStabIsCritical or false, false)
		end
	end

	@ExecSpace("ServerOnly")
	method void DealHeroSummonHit(Entity target, number combatPower, number multMin, number multMax)
		-- 용사 공격 1타: 단일 대상 포인터로 걸러 skill.herosummon(용사 전투력 × 배율) 판정.
		if not isvalid(target) then return end
		self._T.heroSummonCurrentTarget = target
		self._T.pendingHeroSummonCombatPower = combatPower
		self._T.pendingHeroSummonMultMin = multMin
		self._T.pendingHeroSummonMultMax = multMax
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		self:AttackShadowSafe(shape, "skill.herosummon", target)
	end

	-- ── 프리져(4차) ──────────────────────────────────────────────────────
	-- 5분간 프리져 소환수(FreezerSummon)를 소환한다. AI/이동/모션은 script.FreezerSummon이 담당하고,
	-- 여기서는 스폰과 skill.freezer 판정(80% 확률 2초 빙결 포함)만 맡는다.

	@ExecSpace("ServerOnly")
	method void SummonFreezer(number combatPower)
		-- 프리져 소환: spearburstfadingeffect 모델을 **맵의 자식**으로 스폰한다(바하뮤트/용 소환과 동일).
		-- ⚠ 플레이어의 자식으로 두면 텔레포트로 주인이 워프할 때 프리져도 같이 순간이동해 버린다.
		-- 재시전하면 기존 프리져를 교체한다.
		self._T.pendingFreezerCombatPower = combatPower
		local old = self._T.freezerEntity
		if isvalid(old) then old:Destroy() end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_warning("[Freezer] 소환 실패 - CurrentMap 없음")
			return
		end
		self._T.freezerSeq = (self._T.freezerSeq or 0) + 1
		local myPos = self.Entity.TransformComponent.WorldPosition
		local fCtrl = self.Entity.PlayerControllerComponent
		local fLook = (isvalid(fCtrl) and fCtrl.LookDirectionX >= 0) and 1 or -1
		local fSpawn = Vector3(myPos.x - fLook * 0.5, myPos.y + 0.8, 0)
		local freezer = _SpawnService:SpawnByModelId("spearburstfadingeffect", "Freezer" .. tostring(self._T.freezerSeq), fSpawn, map)
		if not isvalid(freezer) then
			log_warning("[Freezer] 소환 실패(spawn nil)")
			return
		end
		freezer:AddComponent("script.FreezerSummon")
		---@type FreezerSummon
		local comp = freezer:GetComponent("script.FreezerSummon")
		if isvalid(comp) then
			comp.OwnerEntity = self.Entity
			comp.Lifetime = 600   -- (요청) 10분 버프
		end
		self._T.freezerEntity = freezer
		-- 소환 사운드(mob/9830009.img의 _audio/Regen).
		self:PlayBuffSound("6eb5b37dad16420baf8df8c29734f9f2")
		log("[Freezer] 소환 완료 seq=" .. tostring(self._T.freezerSeq) .. " combatPower=" .. tostring(math.floor(combatPower)))
	end

	@ExecSpace("ServerOnly")
	method void DealFreezerHit(Entity target)
		-- 프리져 공격 1타: 단일 대상 포인터로 걸러 skill.freezer(전투력 200~300%) 판정.
		-- (요청) 맞은 적은 80% 확률로 2초간 빙결(차지 블로우/아이스 샷의 빙결 재사용).
		if not isvalid(target) then return end
		self._T.freezerCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local hitComps = self:AttackShadowSafe(shape, "skill.freezer", target)
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		if actuallyHit and _UtilLogic:RandomDouble() < 0.8 then
			self:ApplyChargeBlowFreeze(target, 2.0)
			log("[Freezer] 빙결 적중(2초) target=" .. target.Name)
		end
	end

	-- ── 피닉스(4차) ──────────────────────────────────────────────────────
	-- 10분간 피닉스 소환수(PhoenixSummon)를 소환한다. AI/이동/모션은 script.PhoenixSummon이 담당하고,
	-- 여기서는 스폰과 skill.phoenix 판정(2초 스턴 + 머리 위 스턴 이펙트 포함)만 맡는다.

	@ExecSpace("ServerOnly")
	method void SummonPhoenix(number combatPower)
		-- 피닉스 소환: spearburstfadingeffect 모델을 **맵의 자식**으로 스폰한다(프리져와 동일 패턴).
		-- ⚠ 플레이어의 자식으로 두면 텔레포트로 주인이 워프할 때 피닉스도 같이 순간이동해 버린다.
		-- 재시전하면 기존 피닉스를 교체한다.
		self._T.pendingPhoenixCombatPower = combatPower
		local old = self._T.phoenixEntity
		if isvalid(old) then old:Destroy() end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_warning("[Phoenix] 소환 실패 - CurrentMap 없음")
			return
		end
		self._T.phoenixSeq = (self._T.phoenixSeq or 0) + 1
		local myPos = self.Entity.TransformComponent.WorldPosition
		local pCtrl = self.Entity.PlayerControllerComponent
		local pLook = (isvalid(pCtrl) and pCtrl.LookDirectionX >= 0) and 1 or -1
		local pSpawn = Vector3(myPos.x - pLook * 0.5, myPos.y + 0.8, 0)
		local phoenix = _SpawnService:SpawnByModelId("spearburstfadingeffect", "Phoenix" .. tostring(self._T.phoenixSeq), pSpawn, map)
		if not isvalid(phoenix) then
			log_warning("[Phoenix] 소환 실패(spawn nil)")
			return
		end
		phoenix:AddComponent("script.PhoenixSummon")
		---@type PhoenixSummon
		local comp = phoenix:GetComponent("script.PhoenixSummon")
		if isvalid(comp) then
			comp.OwnerEntity = self.Entity
			comp.Lifetime = 600
		end
		self._T.phoenixEntity = phoenix
		-- 소환 사운드(mob/9300089.img의 _audio/Regen).
		self:PlayBuffSound("a30e038d7a9a4260abc1d645cf3aef75")
		log("[Phoenix] 소환 완료 seq=" .. tostring(self._T.phoenixSeq) .. " combatPower=" .. tostring(math.floor(combatPower)))
	end

	@ExecSpace("ServerOnly")
	method void DealPhoenixHit(Entity target)
		-- 피닉스 공격 1타: 단일 대상 포인터로 걸러 skill.phoenix(전투력 200~300%) 판정.
		-- (요청) 맞은 적은 2초간 스턴 + 스턴이 풀릴 때까지 머리 위에 피닉스 스킬 팩의 히트 이펙트를
		-- 루프 재생(드래곤 로어 스턴 표시와 동일한 방식).
		if not isvalid(target) then return end
		self._T.phoenixCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		local hitComps = self:AttackShadowSafe(shape, "skill.phoenix", target)
		local actuallyHit = false
		for _, hc in ipairs(hitComps) do
			if isvalid(hc) and isvalid(hc.Entity) and hc.Entity == target then
				actuallyHit = true
				break
			end
		end
		if actuallyHit then
			self:ApplyPhoenixStun(target, 2.0)
			self:PlayPhoenixStunEffect(target, 2.0)
			log("[Phoenix] 스턴 적중(2초) target=" .. target.Name)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyPhoenixStun(Entity target, number duration)
		-- 피닉스 스턴: 코마 스턴과 같은 방식이되, 배치 몬스터가 AIWander를 쓰는 경우까지 포함해
		-- (빙결 처리와 동일하게) AIChase/AIWander/Movement를 duration 동안 모두 꺼서 행동불능으로 만든다.
		if not isvalid(target) then return end
		local aiChase = target.AIChaseComponent
		local wasChaseEnabled = isvalid(aiChase) and aiChase.Enable
		if isvalid(aiChase) then aiChase.Enable = false end
		local aiWander = target.AIWanderComponent
		local wasWanderEnabled = isvalid(aiWander) and aiWander.Enable
		if isvalid(aiWander) then aiWander.Enable = false end
		local movement = target.MovementComponent
		local wasMovementEnabled = isvalid(movement) and movement.Enable
		if isvalid(movement) then
			movement:Stop()
			movement.Enable = false
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(target) then
				if isvalid(aiChase) and wasChaseEnabled then aiChase.Enable = true end
				if isvalid(aiWander) and wasWanderEnabled then aiWander.Enable = true end
				if isvalid(movement) and wasMovementEnabled then movement.Enable = true end
			end
		end, duration)
	end

	@ExecSpace("Multicast")
	method void PlayPhoenixStunEffect(Entity target, number duration)
		-- 스턴이 풀릴 때까지 대상 머리 위에 피닉스 스킬 팩(skill/311.img/skill/3111005)의 hit/0 클립을
		-- 루프 재생. 머리 높이는 코마 스턴 표시와 동일하게 HitComponent 콜라이더로 계산한다.
		if not self:IsClient() then return end
		if not isvalid(target) then return end
		local headY = 0.5
		local hit = target.HitComponent
		if isvalid(hit) then
			headY = hit.ColliderOffset.y + hit.BoxSize.y / 2
		end
		local serial = _EffectService:PlayEffectAttached("3a436ae129ae4aab8ca9533d8864afc7", target, Vector3(0, headY, 0), 0, Vector3(1, 1, 1), true, { ["OrderInLayer"] = 7 })
		_TimerService:SetTimerOnce(function()
			_EffectService:RemoveEffect(serial)
		end, duration)
	end

	-- ── 바하뮤트(4차) ────────────────────────────────────────────────────
	-- 10분간 바하뮤트 소환수(BahamutSummon)를 소환한다. 적에게 날아가지 않고 주인 곁에 머물며
	-- 주변 6.5유닛의 적을 한 번에 최대 6마리까지 브레스로 때린다. AI/이동/모션은
	-- script.BahamutSummon이 담당하고, 여기서는 스폰과 skill.bahamut 판정만 맡는다.

	@ExecSpace("ServerOnly")
	method void SummonBahamut(number combatPower)
		-- 바하뮤트 소환: spearburstfadingeffect 모델을 **맵의 자식**으로 스폰한다(용 소환과 동일).
		-- ⚠ 플레이어의 자식으로 두면(프리져/피닉스 방식) 텔레포트로 주인이 워프할 때 자식인
		-- 바하뮤트도 같이 순간이동해 버린다. 맵 자식이면 워프의 영향을 받지 않아 제자리에 남았다가
		-- 천천히 날아온다(요청 사양). 재시전하면 기존 바하뮤트를 교체한다.
		self._T.pendingBahamutCombatPower = combatPower
		local old = self._T.bahamutEntity
		if isvalid(old) then old:Destroy() end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_warning("[Bahamut] 소환 실패 - CurrentMap 없음")
			return
		end
		self._T.bahamutSeq = (self._T.bahamutSeq or 0) + 1
		local myPos = self.Entity.TransformComponent.WorldPosition
		-- 처음부터 홈(뒤 1.1 / 위 0.75) 근처에 뜨도록 스폰한다.
		local ctrl = self.Entity.PlayerControllerComponent
		local look = (isvalid(ctrl) and ctrl.LookDirectionX >= 0) and 1 or -1
		local spawnPos = Vector3(myPos.x - look * 1.1, myPos.y + 0.75, 0)
		local bahamut = _SpawnService:SpawnByModelId("spearburstfadingeffect", "Bahamut" .. tostring(self._T.bahamutSeq), spawnPos, map)
		if not isvalid(bahamut) then
			log_warning("[Bahamut] 소환 실패(spawn nil)")
			return
		end
		bahamut:AddComponent("script.BahamutSummon")
		---@type BahamutSummon
		local comp = bahamut:GetComponent("script.BahamutSummon")
		if isvalid(comp) then
			comp.OwnerEntity = self.Entity
			comp.Lifetime = 600
		end
		self._T.bahamutEntity = bahamut
		-- 소환 사운드(skill/232.img/skill/2321003의 _audio/Use).
		self:PlayBuffSound("5044fe5629044efd8da504d153fae348")
		log("[Bahamut] 소환 완료 seq=" .. tostring(self._T.bahamutSeq) .. " combatPower=" .. tostring(math.floor(combatPower)))
	end

	@ExecSpace("ServerOnly")
	method void DealBahamutHit(Entity target)
		-- 바하뮤트 브레스 1타(대상 1마리). BahamutSummon이 최대 6마리에 대해 각각 한 번씩 부른다.
		-- 단일 대상 포인터로 걸러 이웃까지 겹쳐맞는 것을 막는다(다크드래곤/피닉스와 동일한 패턴).
		if not isvalid(target) then return end
		self._T.bahamutCurrentTarget = target
		local pos = target.TransformComponent.WorldPosition
		local shape = BoxShape(Vector2(pos.x, pos.y), Vector2(1.0, 1.6), 0)
		-- 판정은 대상의 월드 좌표에 박스를 놓으므로 플레이어가 보는 방향과 무관하다
		-- (실측: 플레이어 뒤쪽 대상 24건 전부 명중 확인 - 방향 편향 없음).
		self:AttackShadowSafe(shape, "skill.bahamut", target)
	end

	-- ── 엘퀴네스(4차 소환) ────────────────────────────────────────────────
	-- 바하뮤트와 완전히 같은 원리의 소환수(주인 곁 체류 + 그 자리에서 최대 6마리 광역 브레스).
	-- 이동/모션/타격 타이밍은 script.ElquinesSummon이 담당하고, 여기서는 스폰과 skill.elquines 판정만 맡는다.

