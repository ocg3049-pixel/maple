@Component
script PlayerHit extends HitComponent

    property number ImmuneCooldown = 1.0

    -- MonsterAttack.IsAttackTarget이 공격자 쪽에서 참조하는 무적 플래그.
    -- IsHitTarget(방어자 쪽 훅)은 이 프로젝트의 몬스터 근접공격 경로에서 전혀 호출되지 않고,
    -- 겹친 여러 공격자의 피해가 OnHit 호출 횟수와 무관하게 한 번에 합산 적용되는 것으로 실측되어
    -- (Enable=false로 즉시 꺼도 같은 틱에 겹친 공격자들의 피해는 그대로 들어옴), 실제로 동작하는
    -- IsAttackTarget 쪽에서 걸러내야 한다.
    property boolean IsInvincible = false

    -- HP 자연 회복. 소모/피격 후에도 멈추지 않는다 - 멈춤을 되살리려면 HpRegenTick에 게이트를 추가할 것.
    -- (요청 2026-08-12 4차) **기본값 0 = 공짜 회복 없음.** 초보자 스킬 "HP 회복"에 분배한 만큼만 채워진다
    -- (분배 1포인트당 0.05%, 마스터 30 = 1.5%). 값은 클라 SkillManager.RequestSyncHpRegen이 밀어 넣는다.
    -- ⚠ 종전에는 MP와 같은 초당 1% 고정이었다.
    property number HpRegenPercentPerSecond = 0.0
    property number HpRegenTickSeconds = 0.25

    method void OnBeginPlay()
        if self:IsServer() then
            -- BoxSize/ColliderOffset가 (0,0)으로 비어있으면 아바타 크기에 맞춘 자동 판정 박스가
            -- TransformComponent 원점(발밑)을 중심으로 계산되어 절반이 땅 밑으로 파고들었다 - 몬스터가
            -- 멀리 있거나 아래쪽에 있어도 맞는 것처럼 보인 원인. 발밑(0)부터 머리(0.7)까지를 덮도록 명시적으로 설정.
            self.BoxSize = Vector2(0.45, 0.7)
            self.ColliderOffset = Vector2(0, 0.35)

            -- (피드백) 피격 시 몸에서 터지는 초록-흰 반짝이 버스트는 HitEffectSpawnerComponent의
            -- 엔진 기본 이펙트다(끄고 A/B 실측으로 확인). DefaultPlayer.model은 Global/이라 수정할 수
            -- 없으니 런타임에 꺼둔다.
            local hes = self.Entity.HitEffectSpawnerComponent
            if isvalid(hes) then
                hes.Enable = false
            end

            -- (버그 수정) "피격돼도 HP가 안 깎이고 죽지도 않는다"는 신고에 대한 자가복구 안전장치.
            -- OnHit이 무적(Enable=false)을 걸어두고 푸는 타이머가 어떤 이유로든 유실되면 영구 무적이 된다.
            -- 무적이 ImmuneCooldown보다 한참 오래 유지되면 강제로 풀어준다.
            self._T.invincibleFor = 0
            self._T.serverWatchdogId = _TimerService:SetTimerRepeat(function()
                self:ServerWatchdogTick()
            end, 0.25)

            -- (요청 2026-08-09) HP 자연 회복 - **초당 최대 HP의 1%**, 멈춤 없이 계속.
            -- HP는 서버 권한(pc.Hp)이라 클라 타이머로는 못 채운다. MP(MpManager, 클라 전용)와
            -- 같은 비율/주기를 쓰되 이쪽은 플레이어 엔티티마다 서버에서 돈다.
            self._T.hpRegenAccum = 0
            self._T.hpRegenId = _TimerService:SetTimerRepeat(function()
                self:HpRegenTick()
            end, self.HpRegenTickSeconds, self.HpRegenTickSeconds)
        end

        if self:IsClient() then
            -- (버그 수정) "이동이 안 된다"는 신고의 직접 원인.
            -- 플레이어 아바타의 상태 전이 권한은 **클라이언트**에 있다(서버에서 ChangeState를 호출하면
            -- [LEA-3022] InvalidExecSpace로 실패한다 - 실제 로그에서 299회 확인). 기존 코드는 경직 단축을
            -- 위해 서버에서 HIT -> IDLE 전이를 시도했기 때문에 매번 실패했고, OnHit이 HitComponent를
            -- 즉시 Enable=false로 꺼버리는 탓에 엔진의 "HIT 자동 종료"까지 동작하지 않아 플레이어가
            -- HIT 상태에 갇혀 이동 입력이 먹지 않는 상황이 생겼다(스킬은 PlayerAttack을 직접 호출하므로
            -- 그대로 나가서 "스킬로는 움직이는데 이동만 안 되는" 증상이 된다).
            -- → 경직 단축과 HIT 갇힘 복구를 모두 권한이 있는 클라이언트 쪽에서 처리한다.
            self._T.hitFor = 0
            self._T.clientWatchdogId = _TimerService:SetTimerRepeat(function()
                self:ClientWatchdogTick()
            end, 0.1)
        end
    end

    method void OnEndPlay()
        if self._T.serverWatchdogId then
            _TimerService:ClearTimer(self._T.serverWatchdogId)
            self._T.serverWatchdogId = nil
        end
        if self._T.hpRegenId then
            _TimerService:ClearTimer(self._T.hpRegenId)
            self._T.hpRegenId = nil
        end
        if self._T.clientWatchdogId then
            _TimerService:ClearTimer(self._T.clientWatchdogId)
            self._T.clientWatchdogId = nil
        end
        if self._T.blinkTimerId then
            _TimerService:ClearTimer(self._T.blinkTimerId)
            self._T.blinkTimerId = nil
        end
    end

    @ExecSpace("ServerOnly")
    method void HpRegenTick()
        -- 매 틱 최대 HP의 (HpRegenPercentPerSecond% × 틱초)만큼 채운다. 멈춤 조건은 없다.
        if not isvalid(self.Entity) then return end
        local pc = self.Entity.PlayerComponent
        if not isvalid(pc) then return end

        local maxHp = pc.MaxHp or 0
        local hp = pc.Hp or 0
        -- 사망(0 이하) 상태는 부활이 채워주므로 건드리지 않는다(기존 회복 코드와 같은 판정).
        if maxHp <= 0 or hp <= 0 or hp >= maxHp then
            self._T.hpRegenAccum = 0
            return
        end

        -- pc.Hp는 정수라 틱당 회복량이 1 미만이면 매번 버려진다. 소수부를 모아 1 이상일 때만 반영한다.
        self._T.hpRegenAccum = (self._T.hpRegenAccum or 0)
            + maxHp * (self.HpRegenPercentPerSecond / 100) * self.HpRegenTickSeconds
        local gain = math.floor(self._T.hpRegenAccum)
        if gain < 1 then return end
        self._T.hpRegenAccum -= gain
        pc.Hp = math.min(hp + gain, maxHp)
    end

    -- (요청 2026-08-09) 자동사냥 로프 등반 중 무적. 등반 중 피격을 맞으면 로프에서 떨어지고,
    -- 그 뒤 재부착이 1유닛씩 스냅해 "텔레포트로 위로 올라가는" 것처럼 보였다(실측: 등반 로그에 state=HIT).
    -- ⚠ 워치독의 강제 해제(ImmuneCooldown+2초) 대상에서 빼야 등반 내내 유지된다 - 대신 여기에
    --   자체 상한(20초)을 둬서 해제 호출이 유실돼도 영구 무적이 되지 않게 한다.
    @ExecSpace("ServerOnly")
    method void SetClimbInvincible(boolean on)
        -- 켤 때는 피격 컴포넌트를 끄고, 끌 때는 원상복구한다(OnHit의 무적 처리와 같은 방식).
        if not isvalid(self.Entity) then return end
        if on then
            self._T.climbInvincible = true
            self._T.climbInvincibleFor = 0
            self.IsInvincible = true
            self.Enable = false
            log("[PlayerHit] 로프 등반 무적 ON")
        else
            if self._T.climbInvincible ~= true then return end
            self._T.climbInvincible = false
            self._T.climbInvincibleFor = 0
            -- 피격 중(OnHit의 1초 무적)이 겹쳐 있을 수 있으므로, 그쪽이 아니면 원상복구한다.
            if self._T.invincible ~= true then
                self.IsInvincible = false
                self.Enable = true
            end
            log("[PlayerHit] 로프 등반 무적 OFF")
        end
    end

    @ExecSpace("ServerOnly")
    method void ServerWatchdogTick()
        -- 무적이 비정상적으로 오래 지속되면(= 해제 타이머 유실) 강제로 되돌린다.
        if not isvalid(self.Entity) then return end
        -- 로프 등반 무적은 의도된 장기 무적이라 아래 강제 해제 대상이 아니다 - 대신 자체 상한을 둔다.
        if self._T.climbInvincible == true then
            self._T.climbInvincibleFor = (self._T.climbInvincibleFor or 0) + 0.25
            if self._T.climbInvincibleFor > 20.0 then
                log_warning("[PlayerHit] 로프 등반 무적이 20초를 넘겼다 - 강제 해제(해제 호출 유실 자가복구)")
                self:SetClimbInvincible(false)
            end
            self._T.invincibleFor = 0
            return
        end
        if not self.IsInvincible then
            self._T.invincibleFor = 0
            return
        end
        self._T.invincibleFor = (self._T.invincibleFor or 0) + 0.25
        if self._T.invincibleFor > self.ImmuneCooldown + 2.0 then
            log_warning("[PlayerHit] 무적이 비정상적으로 오래 유지됨 - 강제 해제 (피격/사망 불가 버그 자가복구)")
            self.Enable = true
            self._T.invincible = false
            self.IsInvincible = false
            self._T.invincibleFor = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void ClientWatchdogTick()
        -- 내 캐릭터에 대해서만 동작해야 한다 - 다른 플레이어의 상태를 내 클라이언트에서 바꾸려 하면
        -- 권한이 없어 [LEA-3022]가 다시 발생한다.
        local localPlayer = _UserService.LocalPlayer
        if not isvalid(localPlayer) or localPlayer ~= self.Entity then return end
        local sc = self.Entity.StateComponent
        if not isvalid(sc) then return end

        -- (요청) 브랜디쉬 시전 중에는 HIT -> IDLE 복귀를 미룬다 - 여기서 IDLE로 되돌리면 IDLE에 매핑된
        -- 기본 자세(stand)가 몸에 내려가 브랜디쉬 모션을 끊는다("모션은 그대로 두고 표정만" 요청).
        -- 시전 중 피격의 표시는 표정(PlayerAttack.OnHitDuringSkill의 PlayEmotion)이 담당한다.
        -- 이 워치독은 0.1초마다 계속 돌고 있으므로, 시전이 끝나 가드가 풀리면 곧바로 IDLE로 복구된다
        -- - HIT에 영구히 갇히는 이동불가 버그로 돌아가지 않는다.
        ---@type PlayerAttack
        local pa = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(pa) and pa:IsBrandishMotionGuardOn() then return end

        if sc.CurrentStateName ~= "HIT" then
            self._T.hitFor = 0
            return
        end

        -- HIT에 머문 시간이 경직 단축 기준(0.15초)을 넘으면 IDLE로 되돌린다.
        -- 이 한 줄이 (1) 원래 의도했던 경직 1/4 단축과 (2) HIT 상태에 영구히 갇히는 이동불가 버그의
        -- 자가복구를 동시에 담당한다.
        self._T.hitFor = (self._T.hitFor or 0) + 0.1
        if self._T.hitFor >= 0.15 then
            sc:ChangeState("IDLE")
            self._T.hitFor = 0
        end
    end

    @ExecSpace("ServerOnly")
    method void StartGuardParry(integer guardLv)
        -- 가드(패링) 스킬 사용: 지금부터 1.2초간 패링 창이 열린다. 이 사이에 들어오는 공격은
        -- CheckGuardBlock(공격자 쪽 IsAttackTarget에서 호출)이 무시시키고 2초 무적으로 전환한다.
        -- (개편) 성공 시 감소율 = 5% × 분배 포인트 (마스터 10 = 50%) - 레벨을 함께 기억한다.
        self._T.guardSkillLv = math.max(1, math.min(guardLv or 1, 10))
        self._T.guardParryUntil = _UtilLogic.ElapsedSeconds + 1.2
        log("[PlayerHit] 가드 패링 창 오픈(1.2초, Lv." .. tostring(self._T.guardSkillLv) .. ")")
    end

    -- (자동사냥) 서버가 자동 가드 판정에 쓰는 상태 동기화 - 자동사냥 토글/가드 투자 레벨.
    @ExecSpace("ServerOnly")
    method void SetAutoHuntGuardState(boolean autoOn, integer guardLv)
        self._T.autoHuntOn = autoOn
        self._T.guardSkillLv = math.max(0, math.min(guardLv or 0, 10))
        log("[PlayerHit] 자동 가드 상태: auto=" .. tostring(autoOn) .. " 가드 Lv." .. tostring(self._T.guardSkillLv))
    end

    -- (자동사냥) 서버에서 이 플레이어가 자동사냥 중인지 - 조작 잠금 감시
    -- (PlayerAttack.ControlWatchdogTick)가 자동사냥의 의도적 컨트롤러-끔을 오인하지 않는 데 쓴다.
    @ExecSpace("ServerOnly")
    method boolean IsAutoHuntOn()
        return self._T.autoHuntOn == true
    end

    @ExecSpace("ServerOnly")
    method void StartParryStance(number combatPower)
        -- 패링(2차 스킬) 사용: (요청 2026-07-28 개편) 시전 즉시 이펙트/모션(swingT3+검격+스파크)이
        -- 나가고, 1.5초 가드 창을 연다. 창 안에 공격을 받으면 CheckParryBlock이 가드 표시와 함께
        -- 그 피해를 무시하고 3초 무적 + 0.5초 뒤 반격을 처리한다.
        -- combatPower는 반격 데미지 계산에 쓰려고 시전 시점의 값을 서버에 넘겨받아 보관한다
        -- (전투력은 장비 잠재능력 등 클라이언트 전용 상태에 의존하므로 서버가 직접 계산할 수 없다).
        self._T.parryUntil = _UtilLogic.ElapsedSeconds + 1.5
        self._T.parryCombatPower = combatPower
        ---@type PlayerAttack
        local paVisual = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(paVisual) then
            paVisual:PlayParryCounterVisuals()
        end
        log("[PlayerHit] 패링 시전 - 즉시 이펙트 + 가드 창 오픈(1.5초) combatPower=" .. tostring(combatPower))
    end

    @ExecSpace("ServerOnly")
    method void StartPowerGuardLv(number duration, integer healPct, integer reducePct)
        -- (개편 2026-08-12) 파워가드 사용: duration초간 ① "피격 1초 후부터 10초에 걸쳐 입은 피해의
        -- healPct%(분배당 2%)를 회복"하는 창 + ② 피격과 무관하게 **받는 피해 reducePct%(분배당 1%) 감소**
        -- (ApplyDamageReduction에서 가드/아이언 월과 곱연산). 공격력 +10은 폐지 - 클라 스탯 버프 없음.
        -- ⚠ 기존 StartPowerGuard에 인자를 더하지 않고 이름을 바꿨다(LEA-1102 회피, *Lv 관례).
        self._T.powerGuardUntil = _UtilLogic.ElapsedSeconds + duration
        self._T.powerGuardHealPct = healPct
        self._T.powerGuardReducePct = reducePct
        log("[PlayerHit] 파워가드 창 오픈(" .. tostring(duration) .. "초) - 피격 후 지연 회복 " .. tostring(healPct)
            .. "% + 받는 피해 " .. tostring(reducePct) .. "% 감소")
    end

    @ExecSpace("ServerOnly")
    method boolean CheckGuardBlock()
        -- MonsterAttack.IsAttackTarget에서 호출된다(무적과 동일하게 공격자 쪽에서 걸러야 실제 동작 -
        -- IsHitTarget은 이 프로젝트의 몬스터 공격 경로에서 호출되지 않는 것으로 실측됨).
        -- true를 돌려주면 이번 공격이 통째로 무시된다(데미지 미적용 + 데미지 숫자도 안 뜸).
        local now = _UtilLogic.ElapsedSeconds
        -- ② 패링 성공 후 2초 무적 버프 중이면 계속 무시.
        if (self._T.guardInvulnUntil or 0) >= now then return true end
        -- (자동사냥) 데미지를 입을 타이밍에 25% 확률로 가드가 자동 발동한다 - 가드 투자 1pt 이상 +
        -- 자동 가드 쿨타임(30 - (분배-1)초) 준비 상태일 때만. 발동하면 아래 패링 성공 분기를 그대로 탄다.
        if self._T.autoHuntOn == true and (self._T.guardSkillLv or 0) >= 1
            and (self._T.autoGuardReadyAt or 0) <= now and (self._T.guardParryUntil or 0) < now then
            if _UtilLogic:RandomDouble() < 0.25 then
                -- (요청) 자동 발동 = 곧바로 이번 공격을 패링하는 성공이므로, 수동 가드의 "성공 시
                -- 쿨타임 5초 단축"을 그대로 반영해 다음 자동 가드까지 5초만 기다린다.
                self._T.autoGuardReadyAt = now + 5.0
                self._T.guardParryUntil = now + 0.1
                log("[PlayerHit] 자동 가드 발동(25%) - 성공 단축 반영, 다음 자동 가드까지 5초")
            end
        end
        -- ① 패링 창(1초) 안에 공격이 들어오면: 그 공격을 무시하고 2초 무적 시작 + 클라이언트에 성공 통지.
        if (self._T.guardParryUntil or 0) >= now then
            self._T.guardParryUntil = 0            -- 패링은 1회 소모
            self._T.guardInvulnUntil = now + 2.0
            -- (개편) 가드 성공 시 10초간 받는 피해 (5% × 분배 포인트) 감소 버프 (판정: ApplyDamageReduction)
            self._T.guardShieldUntil = now + 10.0
            self._T.guardShieldPct = 5 * math.max(1, self._T.guardSkillLv or 1)
            local pc = self.Entity.PlayerComponent
            if isvalid(pc) then
                _SkillManager:NotifyGuardParrySuccess(pc.UserId)
            end
            self:PlayGuardSuccessEffects()
            log("[PlayerHit] 가드 패링 성공! 2초 무적 + 10초 피해 " .. tostring(self._T.guardShieldPct) .. "% 감소")
            return true
        end
        return false
    end

    -- 받는 피해 감소 합산 - MonsterAttack.CalcDamage가 호출한다.
    -- 가드 성공 버프(5%/pt)·아이언 월(2%/pt)·파워가드(1%/분배, 2026-08-12 신설)가 곱연산으로 겹친다. 최소 1.
    @ExecSpace("ServerOnly")
    method integer ApplyDamageReduction(integer damage)
        local now = _UtilLogic.ElapsedSeconds
        local factor = 1.0
        if (self._T.guardShieldUntil or 0) >= now then
            -- (개편) 감소율 = 5% × 가드 분배 포인트 (마스터 10 = 50%)
            factor = factor * (1 - (self._T.guardShieldPct or 5) / 100)
        end
        if (self._T.ironWallUntil or 0) >= now then
            factor = factor * (1 - (self._T.ironWallReducePct or 0) / 100)
        end
        -- (요청 2026-08-12) 파워가드 버프 중 상시 감소 - 피격 여부와 무관하게 버프만 켜져 있으면 적용.
        if (self._T.powerGuardUntil or 0) >= now then
            factor = factor * (1 - (self._T.powerGuardReducePct or 0) / 100)
        end
        if factor >= 1.0 then return damage end
        return math.max(1, math.floor(damage * factor))
    end

    -- (팔라딘 2차) 아이언 월: duration초간 받는 피해를 reducePct% 감소시킨다.
    @ExecSpace("ServerOnly")
    method void StartIronWall(number duration, integer reducePct)
        self._T.ironWallUntil = _UtilLogic.ElapsedSeconds + duration
        self._T.ironWallReducePct = reducePct
        log("[PlayerHit] 아이언 월 " .. tostring(duration) .. "초 - 받는 피해 " .. tostring(reducePct) .. "% 감소")
    end

    @ExecSpace("ServerOnly")
    method void CancelIronWall()
        self._T.ironWallUntil = 0
        log("[PlayerHit] 아이언 월 취소")
    end

    @ExecSpace("ServerOnly")
    method void CancelGuardShield()
        self._T.guardShieldUntil = 0
        log("[PlayerHit] 가드 피해 감소 버프 취소")
    end

    @ExecSpace("Multicast")
    method void PlayGuardSuccessEffects()
        -- 가드 성공 연출: 캐릭터 몸에서 가드 이펙트 1회 발산 + 가드 사운드 + 데미지 스킨 자리에 "Guard" 텍스트.
        -- Multicast는 서버도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
        if not self:IsClient() then return end
        if not isvalid(self.Entity) then return end
        -- (팔라딘 개편) 가드 성공 사운드/이펙트 교체 - 사운드 e1dacc28···, 이펙트는 기존 베리어 대신 fd0e7aeb···
        _SoundService:PlaySound("e1dacc286f764f13bc578bcdb2d1ec1e", 1.0)
        -- (피드백) 방패 이펙트 높이: -0.3 (사용자 지정값)
        _EffectService:PlayEffectAttached("fd0e7aeb826f4a5486af1a03dfbf592e", self.Entity, Vector3(0, -0.3, 0), 0, Vector3(1, 1, 1), false)
        -- 엔진 데미지 스킨의 "Guard" 텍스트(피격 스킨 RUID 기반) - 데미지 숫자 대신 Guard가 뜬다.
        _DamageSkinService:PlayTextDamage(self.Entity, "02c22d93421b4038b3c413b3e40b57ec", DamageSkinTextType.Guard, DamageSkinTweenType.Default)
        -- (팔라딘 개편) 머리 위 상태 아이콘(29dc0219···)을 감소 버프 지속(10초) 동안 루프 표시.
        -- 재가드로 갱신되면 기존 아이콘을 지우고 새로 건다(토큰으로 옛 제거 타이머 무효화).
        self._T.guardHeadToken = (self._T.guardHeadToken or 0) + 1
        local headTok = self._T.guardHeadToken
        if self._T.guardHeadSerial ~= nil then
            _EffectService:RemoveEffect(self._T.guardHeadSerial)
            self._T.guardHeadSerial = nil
        end
        -- (피드백) 머리 위 아이콘 높이: 0 (사용자 지정값)
        self._T.guardHeadSerial = _EffectService:PlayEffectAttached("29dc0219becf49a9b3ef6fadfb888350", self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), true)
        _TimerService:SetTimerOnce(function()
            if self._T.guardHeadToken ~= headTok then return end
            if self._T.guardHeadSerial ~= nil then
                _EffectService:RemoveEffect(self._T.guardHeadSerial)
                self._T.guardHeadSerial = nil
            end
        end, 10)
    end

    -- ── 홀리 매직쉘(4차 버프) ────────────────────────────────────────
    -- 시전하면 자신과 HP를 가진 아군 소환수 전원에게 "10회 방어" 쉴드가 걸린다(개체마다 각각 10회).
    -- 가드/패링과 완전히 같은 자리(MonsterAttack.IsAttackTarget)에서 걸러야 실제로 동작한다.

    @ExecSpace("ServerOnly")
    method void GrantHolyShell(integer count)
        -- 쉴드 부여(재시전하면 남은 개수와 무관하게 새로 count개로 채운다).
        self._T.holyShellCount = count
        log("[PlayerHit] 홀리 매직쉘 " .. tostring(count) .. "회 부여")
    end

    @ExecSpace("ServerOnly")
    method integer GetHolyShellCount()
        return self._T.holyShellCount or 0
    end

    @ExecSpace("ServerOnly")
    method boolean CheckHolyShellBlock()
        -- 쉴드가 남아 있으면 1개 소모하고 이번 공격을 통째로 무시한다(가드와 동일하게 true 반환).
        -- (요청) 막아낸 뒤 **1.5초 무적** - 그 동안 들어오는 공격은 쉴드를 더 쓰지 않고 그냥 무시한다
        -- (밀집 지역에서 한 번에 여러 대 맞아 쉴드가 순식간에 증발하는 것을 막는다).
        local now = _UtilLogic.ElapsedSeconds
        if (self._T.holyShellInvulnUntil or 0) >= now then return true end
        local n = self._T.holyShellCount or 0
        if n <= 0 then return false end
        n = n - 1
        self._T.holyShellCount = n
        self._T.holyShellInvulnUntil = now + 1.5
        self:PlayHolyShellBlockEffects(n)
        log("[PlayerHit] 홀리 매직쉘 방어! 남은 쉴드 " .. tostring(n) .. " (1.5초 무적)")
        return true
    end

    @ExecSpace("Multicast")
    method void PlayHolyShellBlockEffects(integer remain)
        -- 쉴드 성공 연출: 막은 개체 몸에서 쉴드 이펙트 + "Guard" 표시 + 머리 위 남은 개수 숫자.
        -- (피드백) 막을 때 사운드는 재생하지 않는다(요청). 이펙트 높이도 0.2 → -0.1로 더 내렸다.
        if not self:IsClient() then return end
        if not isvalid(self.Entity) then return end
        local serial = _EffectService:PlayEffectAttached("ec0acf34d59043f695f43c55222a7b0e", self.Entity, Vector3(0, -0.1, 0), 0, Vector3(1, 1, 1), false, { ["OrderInLayer"] = 8, ["Alpha"] = 0.5 })
        _TimerService:SetTimerOnce(function()
            _EffectService:RemoveEffect(serial)
        end, 1.2)
        -- 가드 표시(가드/패링과 같은 엔진 텍스트 데미지스킨).
        _DamageSkinService:PlayTextDamage(self.Entity, "02c22d93421b4038b3c413b3e40b57ec", DamageSkinTextType.Guard, DamageSkinTweenType.Default)
        -- 남은 쉴드 개수를 머리 위에 숫자로 표시(힐과 같은 파란 스킨 재사용).
        _DamageSkinService:Play(
            self.Entity, "d58b67cf0f3a4eaf9fe1ad87c0ffac8a", 0,
            { remain }, DamageSkinTweenType.Default, false,
            Vector2(0, 0.35), Vector2(1, 1), 1.0, 1.0, LitMode.Default
        )
    end

    @ExecSpace("ServerOnly")
    method boolean CheckParryBlock()
        -- 패링 판정. CheckGuardBlock과 완전히 동일한 구조로 MonsterAttack.IsAttackTarget에서 호출된다
        -- (IsHitTarget은 이 프로젝트의 몬스터 공격 경로에서 호출되지 않는 것으로 실측됨 - 무적/가드와
        -- 같은 이유로 공격자 쪽에서 걸러야 실제로 동작한다). true면 이번 공격이 통째로 무시된다.
        local now = _UtilLogic.ElapsedSeconds
        -- ② 가드 성공 후 3초 무적 중이면 계속 무시.
        if (self._T.parryInvulnUntil or 0) >= now then return true end
        -- ① 가드 창(1.5초) 안에 공격이 들어오면: 가드 표시와 함께 그 공격을 무시하고 3초 무적 시작 +
        --    반격 예약. 시전 이펙트/모션은 이미 StartParryStance(시전 즉시)에서 재생됐다(2026-07-28 개편).
        if (self._T.parryUntil or 0) >= now then
            self._T.parryUntil = 0            -- 가드는 1회 소모
            self._T.parryInvulnUntil = now + 3.0
            local pc = self.Entity.PlayerComponent
            if isvalid(pc) then
                _SkillManager:NotifyParrySuccess(pc.UserId)
            end
            self:PlayParrySuccessEffects()
            -- (요청) 가드 표시 0.5초 뒤 주변 최대 6명에게 전투력의 500~700% 반격 피해.
            local combatPower = self._T.parryCombatPower or 0
            _TimerService:SetTimerOnce(function()
                self:FireParryCounter(combatPower)
            end, 0.5)
            log("[PlayerHit] 패링 가드 성공! 피해 무시 + 3초 무적 + 0.5초 뒤 반격 예약")
            return true
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method void FireParryCounter(number combatPower)
        -- 패링 성공 0.5초 뒤 실제 반격 판정. 판정/데미지 공식은 다른 스킬과 동일하게 PlayerAttack이 담당한다.
        if not isvalid(self.Entity) then return end
        ---@type PlayerAttack
        local pa = self.Entity:GetComponent("script.PlayerAttack")
        if not isvalid(pa) then
            log_warning("[PlayerHit] FireParryCounter: PlayerAttack 컴포넌트를 찾지 못했다")
            return
        end
        pa:AttackParryCounter(combatPower)
    end

    @ExecSpace("Multicast")
    method void PlayParrySuccessEffects()
        -- 패링 성공 연출. (요청 이력)
        --  · 가드의 몸통 이펙트(d7852ad7) 제거 - "가드와 같은 이펙트는 없앤다".
        --  · 크게 퍼지던 Nova 파티클 제거 - "이펙트가 너무 크다".
        --  · 카메라 줌 감쇠진동(화면 이동) 제거 - "화면 이동은 일단 없앤다".
        --  · 퍼져나가는 링 클립 제거 - "이펙트 없앤다. 일렁거림만 있고 따로 이미지는 없을 예정".
        -- (최종 지정) 이펙트/사운드를 사용자가 직접 지정한 리소스로 교체:
        --  · 이펙트 7344e618 - 옅은 빛 알갱이가 흩어지는 클립(14프레임, 원본 약 13x7.7 유닛).
        --    형체가 뚜렷한 그림이 아니라 화면 전체가 일렁이듯 반짝이는 연출이다.
        --  · 사운드 dca3f8aa - 검과 검이 부딪히는 날카로운 금속성 타격음(패링 막아냄 표현).
        -- Multicast는 서버도 함께 실행하므로 클라이언트에서만 실행되게 막는다.
        if not self:IsClient() then return end
        if not isvalid(self.Entity) then return end
        _SoundService:PlaySound("dca3f8aa0f524bf59e85ff44792b1860", 1.0)
        _DamageSkinService:PlayTextDamage(self.Entity, "02c22d93421b4038b3c413b3e40b57ec", DamageSkinTextType.Guard, DamageSkinTweenType.Default)
        self:PlayParryShimmer()
    end

    @ExecSpace("ClientOnly")
    method void PlayParryShimmer()
        -- 패링 일렁임 연출.
        --  ① 노란 빛 - 이 클립의 원본 알갱이는 분홍빛이다(프레임 평균 RGB 실측 (1.00, 0.70, 0.83)).
        --    Color는 **곱연산**이라 채널별 계수로 색을 바꾼다: g x1.7로 분홍의 부족한 초록을 채우고(넘치는
        --    만큼은 1.0으로 잘림), b x0.55로 파랑을 깎아 (1.0, 1.0, ~0.46) = 따뜻한 노란 빛을 만든다.
        --    (흰색이 필요하면 b를 1.45로 - 분홍 제거 원리는 동일하다.)
        --  ② 투명도 70% - Alpha 옵션 0.7.
        --  ③ 캐릭터를 따라다니면 안 됨 - PlayEffectAttached(부착)가 아니라 PlayEffect(월드 고정)를 쓴다.
        --    시전 순간의 위치에 깔리고, 이후 캐릭터가 움직여도 그 자리에 남는다.
        --  ④ 알갱이 크기 절반 - scale 2.0 -> 1.0. 대신 한 장으로는 화면이 안 차므로 좌/우 두 장을
        --    x -3.2 / +3.2로 나란히 깔아 화면 전체를 덮는다(클립 1장이 약 13x7.7 유닛, PC 화면은 12.8x7.2).
        if not isvalid(self.Entity) then return end
        local wp = self.Entity.TransformComponent.WorldPosition
        local shimmerColor = Color(1.0, 1.7, 0.55, 1)
        local shimmerOpts = { ["Color"] = shimmerColor, ["Alpha"] = 0.7 }
        _EffectService:PlayEffect("7344e61864444842b917cb4be91e548e", self.Entity, Vector3(wp.x - 3.2, wp.y + 0.5, 0), 0, Vector3(1.0, 1.0, 1), false, shimmerOpts)
        _EffectService:PlayEffect("7344e61864444842b917cb4be91e548e", self.Entity, Vector3(wp.x + 3.2, wp.y + 0.5, 0), 0, Vector3(1.0, 1.0, 1), false, shimmerOpts)
    end

    @ExecSpace("Multicast")
    method void PlayInvincibleBlink(number duration)
        -- (요청 2026-08-10) 피격 무적 시간 동안 캐릭터가 회색이 됐다 말았다 깜빡이며 무적임을 표시한다.
        -- AvatarRendererComponent:SetColor는 클라이언트 시각 효과라 Multicast로 전 클라이언트에서 돈다.
        -- 이 프로젝트에서 SetColor는 여기서만 쓴다(다크사이트류는 SetAlpha라 서로 간섭 없음).
        if not self:IsClient() then return end
        if not isvalid(self.Entity) then return end
        local ar = self.Entity.AvatarRendererComponent
        if not isvalid(ar) then return end

        -- 재피격(무적 만료 직후 연타 피격)으로 이전 깜빡임이 남아 있으면 무효화하고 새로 시작.
        self._T.blinkToken = (self._T.blinkToken or 0) + 1
        local blinkTok = self._T.blinkToken
        if self._T.blinkTimerId ~= nil then
            _TimerService:ClearTimer(self._T.blinkTimerId)
            self._T.blinkTimerId = nil
        end

        local isGray = false
        self._T.blinkTimerId = _TimerService:SetTimerRepeat(function()
            if self._T.blinkToken ~= blinkTok then return end
            if not isvalid(self.Entity) then return end
            local arT = self.Entity.AvatarRendererComponent
            if not isvalid(arT) then return end
            -- 사망하면 즉시 원색으로 복구하고 멈춘다(사망 연출을 회색으로 덮지 않기 위해).
            local sc = self.Entity.StateComponent
            if isvalid(sc) and sc.CurrentStateName == "DEAD" then
                arT:SetColor(1.0, 1.0, 1.0, 1.0, nil)
                if self._T.blinkTimerId ~= nil then
                    _TimerService:ClearTimer(self._T.blinkTimerId)
                    self._T.blinkTimerId = nil
                end
                return
            end
            isGray = not isGray
            if isGray then
                -- (피드백 2026-08-10) 회색을 더 연하게: 0.45 → 0.65
                arT:SetColor(0.65, 0.65, 0.65, 1.0, nil)
            else
                arT:SetColor(1.0, 1.0, 1.0, 1.0, nil)
            end
        end, 0.08)   -- (피드백 2026-08-10) 깜빡임 더 빠르게: 0.12초 → 0.08초

        _TimerService:SetTimerOnce(function()
            -- 무적 종료: 깜빡임을 멈추고 반드시 원색으로 되돌린다.
            if self._T.blinkToken ~= blinkTok then return end
            if self._T.blinkTimerId ~= nil then
                _TimerService:ClearTimer(self._T.blinkTimerId)
                self._T.blinkTimerId = nil
            end
            if isvalid(self.Entity) then
                local arE = self.Entity.AvatarRendererComponent
                if isvalid(arE) then arE:SetColor(1.0, 1.0, 1.0, 1.0, nil) end
            end
        end, duration)
    end

    method boolean IsHitTarget(string attackInfo)
        -- 무적 상태면 판정을 거부한다 - 실측 결과 이 프로젝트의 몬스터 근접공격(MonsterAttack)에는 이 훅이
        -- 전혀 호출되지 않는 것으로 확인됐지만, 다른 공격 경로가 이 훅을 실제로 참조할 경우를 대비한
        -- 보조 방어선으로 남겨둔다 - 주 방어선은 MonsterAttack.IsAttackTarget의 IsInvincible 체크.
        if self._T.invincible then return false end
        return true
    end

    method void OnHit(Entity attacker, integer damage, boolean isCritical, string attackInfo, int32 hitCount)
        -- 서버가 유일한 권위 - OnHit의 부모 ExecSpace가 미지정(=All)이라 클라이언트에서도 호출될 수 있어
        -- 클라이언트 쪽 실행은 맨 앞에서 걸러낸다.
        if not self:IsServer() then return end
        if self._T.invincible then return end
        self._T.invincible = true
        self.IsInvincible = true
        self.Enable = false
        self._T.invincibleFor = 0

        __base:OnHit(attacker, damage, isCritical, attackInfo, hitCount)

        -- (개편 2026-08-12, 표시 조정) 파워가드 버프 중이면 **3초에 한 번씩 총 3틱**으로
        -- 입은 피해의 healPct%(분배당 2%, 마스터 40%)를 회복한다. 표시는 힐 데미지 스킨.
        -- (피드백) 1초 간격 10틱은 숫자가 너무 자주 떠 보기 불편 - 3초×3틱으로 큼직하게.
        -- ⚠ damage는 ApplyDamageReduction(파워가드 상시 감소 포함)을 거친 실피해 - 회복도 실피해 기준.
        if (self._T.powerGuardUntil or 0) >= _UtilLogic.ElapsedSeconds and damage > 0 then
            local totalHeal = math.floor(damage * (self._T.powerGuardHealPct or 10) / 100)
            if totalHeal > 0 then
                local tickHeal = math.max(1, math.floor(totalHeal / 3))
                local ent = self.Entity
                for tick = 1, 3 do
                    _TimerService:SetTimerOnce(function()
                        if not isvalid(ent) then return end
                        local pcT = ent.PlayerComponent
                        if not isvalid(pcT) or pcT.Hp <= 0 then return end
                        pcT.Hp = math.min(pcT.Hp + tickHeal, pcT.MaxHp)
                        ---@type PlayerAttack
                        local paT = ent:GetComponent("script.PlayerAttack")
                        if isvalid(paT) then paT:ShowHealDamageSkin(ent, tickHeal) end
                    end, tick * 3.0)   -- 3초 뒤부터 3초 간격 3틱 (3/6/9초)
                end
                log("[PlayerHit] 파워가드 지연 회복 예약: 피해 " .. tostring(damage) .. " -> 총 +" .. tostring(totalHeal) .. " HP (3초 간격 3틱)")
            end
        end

        -- (요청) 스킬 시전 중 피격이면 몸동작은 그대로 두고 표정만 피격 표정으로 바꾼다.
        -- 시전 중인지 판단과 표정 재생은 그 상태를 들고 있는 PlayerAttack이 담당한다(시전 중이 아니면
        -- 아무것도 하지 않으므로 평소 피격 동작은 그대로다).
        ---@type PlayerAttack
        local pa = self.Entity:GetComponent("script.PlayerAttack")
        if isvalid(pa) then pa:OnHitDuringSkill() end

        -- (요청 2026-08-10) 피격 연출 2종:
        --  ① 3초 경계 자세 - 창을 열어두면 IDLE 복귀마다 alert 자세로 대체(PlayerAttack.StartHitStance).
        --  ② 무적(ImmuneCooldown) 동안 캐릭터가 회색으로 깜빡이며 무적임을 표시.
        if isvalid(pa) then pa:StartHitStance() end
        self:PlayInvincibleBlink(self.ImmuneCooldown)

        -- (기능 이동) 경직(HIT) 단축은 클라이언트 워치독(ClientWatchdogTick)이 담당한다 - 여기서
        -- 서버가 ChangeState("IDLE")를 호출하면 플레이어 상태 권한이 없어 [LEA-3022]로 항상 실패한다.

        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) then
                self.Enable = true
                self._T.invincible = false
                self.IsInvincible = false
                self._T.invincibleFor = 0
            end
        end, self.ImmuneCooldown)
    end

end
