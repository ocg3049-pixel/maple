            {id="monster-2337@154", name="난폭한 화장품", level=154, sprite="948f02fe8279446f82a81b4feb2cdb33", kinds={"monster-2337"}},
            {id="monster-1552@155", name="까칠한 파마기", level=155, sprite="c4c0517f2d62421ca40dcf55460c8a0c", kinds={"monster-1552"}},
            {id="monster-970@155", name="까칠한 헤어롤", level=155, sprite="3181f9430ebe46f6aba6b8b09b8c3729", kinds={"monster-970","monster-3127"}},
            {id="monster-942@155", name="난폭한 화장대", level=155, sprite="22b76a9bc39244f287000b17d324635d", kinds={"monster-942","monster-242"}},
            {id="monster-1719@210", name="오염된 수액", level=210, sprite="89a629e1eb4c4e3bb96dd59b59865812", kinds={"monster-1719"}},
            {id="monster-2783@211", name="부패한 수액", level=211, sprite="e0969494299947e98aa99f736815be8a", kinds={"monster-2783"}},
            {id="monster-2115@212", name="타락마족 검병", level=212, sprite="4c43df863c3540f3876d7c09e918062b", kinds={"monster-2115"}},
            {id="monster-1975@213", name="타락마족 강화검병", level=213, sprite="bb6a5949fd2f4d80a9ac59445d5af3d6", kinds={"monster-1975"}},
            {id="monster-3545@214", name="타락마족 도끼병", level=214, sprite="6f049333c91e4b33ac996ba69d69e304", kinds={"monster-3545"}},
            {id="monster-308@215", name="타락마족 강화도끼병", level=215, sprite="28d8ba35882f4e0fb4d85c3d178d8e31", kinds={"monster-308"}},
            {id="monster-2240@216", name="타락마족 방패병", level=216, sprite="eb8b5f48c28d41559862d2664ed931c5", kinds={"monster-2240"}},
            {id="monster-3472@217", name="타락마족 강화방패병", level=217, sprite="1b4eb5ecc88a476aa16f81ce278b02b2", kinds={"monster-3472"}},
            {id="monster-2708@218", name="타락마족 늑대기수", level=218, sprite="f44d8e5d9e6b489381c90063d3e5c92c", kinds={"monster-2708"}},
            {id="monster-3562@219", name="타락마족 강화늑대기수", level=219, sprite="f1034fa1c4de42f18f3a84f09d9e1761", kinds={"monster-3562"}},
        }
        self._T.byId = {}
        self._T.byKind = {}
        for _, row in ipairs(self._T.rows) do
            self._T.byId[row.id] = row
            for _, kind in ipairs(row.kinds) do self._T.byKind[kind .. "@" .. tostring(row.level)] = row end
        end
        return self._T.rows
    end

    method any Get(string id)
        self:All()
        return self._T.byId[id]
    end

    method any Find(string kind, integer level)
        self:All()
        return self._T.byKind[kind .. "@" .. tostring(level)]
    end
end
