@Logic
script HeroMonsterBalance extends Logic

	method integer GetReferenceSP(integer level, integer startLevel, integer lastLevel)
		-- 요청의 Lv.11=4 SP 기준: 전직 레벨에 1, 이후 레벨마다 3. 실제 스킬창 예산과는 별개인 HP 기준이다.
		if level < startLevel then return 0 end
		return 1 + 3 * (math.min(level, lastLevel) - startLevel)
	end

	method number GetMeanDamage(number combatPower, number rateMin, number rateMax)
		-- 실제 CalcDamageBase의 균등 난수와 타격별 내림을 반영한 비치명타 평균값.
		local low = combatPower * rateMin
		local high = combatPower * rateMax
		if high <= low then return math.floor(low) end
		local a = math.floor(low)
		local b = math.floor(high)
		local sumLow = a * (a - 1) / 2 + a * (low - a)
		local sumHigh = b * (b - 1) / 2 + b * (high - b)
		return (sumHigh - sumLow) / (high - low)
	end

	method table GetReference(integer level)
		-- 동일 레벨 기본 장비(총합=7L), 분노·최대 콤보·최대 발도술, 비치명타 주력기 1회 기준.
		-- 장비 잠재/공속 옵션과 확률 추가타·소환수 피해는 기준 장비 및 주력기 피해에 포함하지 않는다.
		-- 해금은 현재 HeroSkillTable/SkillManager: 분노40, 콤보·파스강화70, 발도술75, 브랜디쉬120, 어드콤135.
		local lv = math.max(1, math.min(200, level))
		if self._T.references == nil then self._T.references = {} end
		if self._T.references[lv] ~= nil then return self._T.references[lv] end
		local sp1 = self:GetReferenceSP(lv, 10, 29)
		local sp2 = self:GetReferenceSP(lv, 30, 69)
		local sp3 = self:GetReferenceSP(lv, 70, 119)
		local sp4 = self:GetReferenceSP(lv, 120, 159)
		local ps = math.min(20, sp1)
		local rage = lv >= 40 and math.min(20, sp2) or 0
		local baseCP = (7 * lv) ^ 2
		local best = { level = lv, sp1 = sp1, sp2 = sp2, sp3 = sp3, sp4 = sp4,
			powerStrike = ps, rage = rage, enhance = 0, combo = 0, batto = 0,
			advancedCombo = 0, brandish = 0, orbs = 0, damage = -1 }
		-- 각 차수 예산 안에서 주력기 1회 피해가 가장 큰 합법적인 배분을 비교한다.
		local maxCombo = math.min(30, sp3)
		local maxBatto = lv >= 75 and math.min(20, sp3) or 0
		-- 피해가 바뀌는 중첩 상한 경계와 선행 마스터 조건만 비교한다. 같은 효과의 더 비싼 배분은 제외한다.
		for _, combo in ipairs({0, 1, 5, 10, 15, 20, 30}) do
			if combo > maxCombo then continue end
			for _, batto in ipairs({0, 1, 10, 20}) do
				if batto > maxBatto then continue end
				if combo + batto > sp3 then continue end
				local enhance = ps == 20 and math.min(30, sp3 - combo - batto) or 0
				local orbs = combo > 0 and math.min(5, 1 + math.floor(combo / 5)) or 0
				local stacks = batto > 0 and (batto >= 20 and 3 or (batto >= 10 and 2 or 1)) or 0
				local maxAdv = lv >= 135 and combo == 30 and math.min(30, sp4) or 0
				for _, advanced in ipairs({0, 1, 5, 10, 15, 20}) do
					if advanced > maxAdv then continue end
					local brandish = lv >= 120 and ps == 20 and enhance == 30 and math.min(30, sp4 - advanced) or 0
					local totalOrbs = orbs + (advanced > 0 and math.min(5, 1 + math.floor(advanced / 5)) or 0)
					-- CharInfoManager: 분노·콤보·발도술은 덧셈으로 모은 뒤 전투력에 한 번 곱하고 /100 내림.
					local cp = math.max(1, math.floor(math.floor(baseCP * (1 + (rage + totalOrbs * 3 + stacks * 3) / 100)) / 100))
					local minRate = ps > 0 and (100 + 4 * ps + 4 * enhance) / 100 or 0.2
					local maxRate = ps > 0 and (120 + 6 * ps + 4 * enhance) / 100 or 1
					local hitCount = 1
					if brandish > 0 then
						minRate = 1.8 + 0.04 * (brandish - 1)
						maxRate = 2.4 + 0.04 * (brandish - 1)
						hitCount = 3
					end
					local damage = self:GetMeanDamage(cp, minRate, maxRate) * hitCount
					if damage > best.damage then
						best.damage = damage
						best.combatPower = cp
						best.enhance = enhance
						best.combo = combo
						best.batto = batto
						best.advancedCombo = advanced
						best.brandish = brandish
						best.orbs = totalOrbs
						best.minRate = minRate
						best.maxRate = maxRate
						best.hitCount = hitCount
					end
				end
			end
		end
		best.hp = math.max(1, math.ceil(best.damage * 1.9))
		self._T.references[lv] = best
		return best
	end

	method integer GetMonsterHP(integer level)
		-- 계산 결과를 레벨별로 캐시해 같은 종 몬스터의 스폰마다 다시 탐색하지 않는다.
		return self:GetReference(level).hp
	end
end
