@Logic
script CharInfoManager extends Logic

	property boolean detailOpen = true

	-- 공격속도 단계 (기본 5단계 = 파워스트라이크 현재 속도). "공격 속도의 비약" 사용 시 1단계씩 증가한다.
	-- 인벤토리와 마찬가지로 클라이언트 전용 상태 - 서버에는 대응 데이터가 없어(코스튬/인벤과 동일한 이유) 사용 시
	-- 스킬 발동 RPC 인자로 배율을 계산해 넘겨준다 (SkillManager:UseSkillInSlot 참고).
	property integer atkSpeedStage = 5

	-- "레벨 70 물약" 사용 시 누적되는 보너스. 이 스탯 시스템은 공격력/마력을 하나의 flatATK로 합쳐서 계산하므로
	-- (CalcCombatPower/UpdateStats의 "공격력" 또는 "마력" 옵션 분기 참고), 공격력 +1000·마력 +1000을 합쳐 2000으로 반영한다.
	property integer potionAttackBonus = 0

	-- (신규) 2차 버프 스킬(분노/메디테이션/파워가드)이 주는 공마(공격력·마력) 보너스의 합.
	-- 이 스탯 시스템은 공격력/마력을 하나의 flatATK로 합쳐 계산하므로(위 potionAttackBonus 참고)
	-- "공마 +30"은 여기에 30을 더하는 것으로 반영된다. 각 버프는 서로 독립적으로 켜지고, 이 값은
	-- 활성 버프들의 보너스 합이다. 전투력은 스킬 시전 시 RPC 인자로 서버에 전달되므로(SkillManager
	-- 참고) 이 보너스가 스킬 데미지에도 자동으로 반영된다.
	property integer buffAttackBonus = 0
	-- (발도술) 처치 중첩 버프의 크리티컬 확률 보너스(+3%×중첩). CalcCritRate/UpdateStats 두 곳에서 가산된다.
	property integer battoCritBonus = 0

	-- (표창+ 개편 2026-08-05) 지금 고른 표창 종류가 주는 상시 효과. 표창을 바꾸거나 표창+ 계열 스킬에
	-- 포인트를 찍을 때 SkillManager.ApplyShurikenAttackBonus가 통째로 다시 대입한다(누적이 아니다).
	--   · 공격력은 skillAttackBonus에 함께 합산된다(아래 프로퍼티)
	--   · 크리티컬 확률은 CalcCritRate/UpdateStats에서 가산
	--   · 공격속도 단계는 GetAttackSpeedStage에서 가산(부스터/발도술과 겹쳐 적용)
	property integer shurikenCritBonus = 0
	property integer shurikenAtkSpeedStage = 0

	-- 스킬 포인트 투자로 얻는 상시 공격력 보너스. 지금은 "표창+"(포인트 1당 +2)만 쓴다.
	-- 버프(buffAttackBonus)와 달리 켜고 끄는 것이 아니라 투자 포인트에 따라 고정으로 유지된다.
	property integer skillAttackBonus = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		local detailBtn = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailToggleBtn")
		if isvalid(detailBtn) then
			detailBtn:ConnectEvent(ButtonClickEvent, self.OnToggleDetail)
		end
		log("[CharInfo] ready")
	end

	@ExecSpace("ClientOnly")
	method void OnToggleDetail(ButtonClickEvent event)
		local panel = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailPanel")
		if not isvalid(panel) then return end
		panel.Enable = not panel.Enable
		self.detailOpen = panel.Enable

		-- 버튼 텍스트 갱신
		local btn = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailToggleBtn")
		if isvalid(btn) then
			btn.TextComponent.Text = panel.Enable and "▲ 세부 정보" or "▼ 세부 정보"
		end

		-- BG 크기 변경 (창이 줄어드는 효과)
		-- 펼침: 650×936, 축소: 650×398 (top=468 고정, bottom=70)
		local bg = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/BG")
		if isvalid(bg) then
			if panel.Enable then
				bg.UITransformComponent.anchoredPosition = Vector2(0, 0)
				bg.UITransformComponent.RectSize = Vector2(650, 936)
			else
				-- top 468 고정, height=398 → center=269
				bg.UITransformComponent.anchoredPosition = Vector2(0, 269)
				bg.UITransformComponent.RectSize = Vector2(650, 398)
			end
		end
	end

	-- Called by UIEquipInventoryManager when CharInfoWindow opens or equipment changes
	@ExecSpace("ClientOnly")
	method void RefreshCharInfo()
		-- detailOpen 상태 복원 (이전에 닫았으면 닫힌 채로 열림)
		local panel = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailPanel")
		if isvalid(panel) then panel.Enable = self.detailOpen end
		local bg = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/BG")
		if isvalid(bg) then
			if self.detailOpen then
				bg.UITransformComponent.anchoredPosition = Vector2(0, 0)
				bg.UITransformComponent.RectSize = Vector2(650, 936)
			else
				bg.UITransformComponent.anchoredPosition = Vector2(0, 269)
				bg.UITransformComponent.RectSize = Vector2(650, 398)
			end
		end
		local btn = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailToggleBtn")
		if isvalid(btn) then
			btn.TextComponent.Text = self.detailOpen and "▲ 세부 정보" or "▼ 세부 정보"
		end

		self:UpdateLevelClass()
		self:UpdateCharName()
		self:UpdateAvatar()
		self:UpdateStats()
	end

	@ExecSpace("ClientOnly")
	method void UpdateLevelClass()
		-- 원작 스타일: 레벨 배지(상단 중앙)와 직업 배지(좌측)를 분리 표시한다.
		-- (Phase 1) 표시 레벨은 장비 전투력 환산(GetDisplayLevel) 단일 진입점으로 통일 -
		-- 기존 "전투력 ÷ 10" 선형식과 CharLevel(죽은 값) 참조를 대체한다.
		local level = self:GetDisplayLevel()
		local e = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/LevelClassText")
		if isvalid(e) then
			e.TextComponent.Text = "Lv." .. tostring(level)
		end
		local c = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/ClassBadgeText")
		if isvalid(c) then
			local jobIdx = _UIMyInfoManager:GetSelectedCharacterJobIdx()
			c.TextComponent.Text = _UIMyInfoManager:GetClassNameForLevel(jobIdx, level)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateCharName()
		local name = self:GetCurrentCharName()
		local e = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/CharNameText")
		if isvalid(e) then
			e.TextComponent.Text = name
		end
	end

	@ExecSpace("ClientOnly")
	method string GetCurrentCharName()
		-- Read from CharacterSelectComponent which stores slot data
		local selectBg = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharacterSelectGroup/SelectBackground")
		if not isvalid(selectBg) then return "캐릭터" end
		local charSelectComp = selectBg:GetComponent(CharacterSelectComponent)
		if not isvalid(charSelectComp) then return "캐릭터" end
		local slot = charSelectComp.selectedSlot
		if slot < 1 or slot > charSelectComp:MaxSlot() then return "캐릭터" end
		local data = charSelectComp:GetSlotData(slot)
		if data == "" then return "캐릭터" end
		-- First pipe-delimited field is character name
		local name = string.match(data, "^([^|]+)")
		return name ~= nil and name or "캐릭터"
	end

	@ExecSpace("ClientOnly")
	method void UpdateAvatar()
		local avatarEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/AvatarImage")
		if not isvalid(avatarEnt) then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local pc = player:GetComponent(CostumeManagerComponent)
		if not isvalid(pc) then return end
		local ac = avatarEnt:GetComponent(CostumeManagerComponent)
		if not isvalid(ac) then return end

		-- Copy player's current costume to the avatar display
		ac:SetEquip(MapleAvatarItemCategory.Body,  "3cf4cb29ae344577b9eed37e531688a4")
		ac:SetEquip(MapleAvatarItemCategory.Face,  pc:GetEquip(MapleAvatarItemCategory.Face))
		ac:SetEquip(MapleAvatarItemCategory.Hair,  pc:GetEquip(MapleAvatarItemCategory.Hair))
		ac:SetEquip(MapleAvatarItemCategory.Coat,  pc:GetEquip(MapleAvatarItemCategory.Coat))
		ac:SetEquip(MapleAvatarItemCategory.Pants, pc:GetEquip(MapleAvatarItemCategory.Pants))
		ac:SetEquip(MapleAvatarItemCategory.Shoes, pc:GetEquip(MapleAvatarItemCategory.Shoes))
		-- 모자도 플레이어와 똑같이 맞춘다 (넣지 않으면 계정 기본 아바타의 모자가 비쳐 보인다)
		ac:SetEquip(MapleAvatarItemCategory.Cap,   pc:GetEquip(MapleAvatarItemCategory.Cap))
		-- 두손무기/한손무기(후르츠 대거·나무 스태프·우드완드는 실제 리소스가 한손무기 카테고리)를 모두 확인
		local twoHandWeapon = pc:GetEquip(MapleAvatarItemCategory.TwoHandedWeapon)
		if twoHandWeapon ~= "" then
			ac:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, twoHandWeapon)
		end
		local oneHandWeapon = pc:GetEquip(MapleAvatarItemCategory.OneHandedWeapon)
		if oneHandWeapon ~= "" then
			ac:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, oneHandWeapon)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateStats()
		-- (Phase 1) 표시 레벨은 이제 장비 전투력 환산(GetDisplayLevel) 하나만 쓴다.
		-- _UIMyInfoManager.CharLevel은 서버 InitStats 이후 갱신되지 않는 죽은 값이라 참조 금지.
		local level = self:GetDisplayLevel()

		-- Read HP from local player
		local hp, maxHp = 0, 50
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local pc = player.PlayerComponent
			if isvalid(pc) then
				hp    = pc.Hp    or 0
				maxHp = pc.MaxHp or 50
			end
		end

		-- Accumulate bonuses from all equipped items (slots 1-25; 10~25는 잠금 칸이라 빈 문자열로 스킵됨)
		local flatSTR, flatDEX, flatINT, flatLUK = 0, 0, 0, 0
		local pctSTR,  pctDEX,  pctINT,  pctLUK  = 0, 0, 0, 0
		local flatATK, pctATK   = 0, 0
		local dmgPct            = 0
		local defIgnoreAdd      = 0
		local critAdd           = 0
		local critDmgAdd        = 0
		local cdReduceAdd       = 0   -- (Phase 3) 스킬 쿨타임 감소 초 합산 (표시용)

		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end

			-- 무기 슬롯 기본옵션: 직업별 드롭박스 지급 무기는 공격력/마력 +30 고정 (잠재능력과 별개)
			if slot == 6 then
				local baseName = _UIEquipInventoryManager:ParseName(s)
				if _UIEquipInventoryManager:IsJobDropWeapon(baseName) then
					flatATK += 30
				end
			end

			-- Starforce bonus (field 4)
			local stars = self:ParseFieldNum(s, 4)
			if stars > 0 then
				local sf = self:CalcStarforceStats(stars)
				flatSTR += sf.str; flatDEX += sf.dex
				flatINT += sf.int; flatLUK += sf.luk
				flatATK += sf.atk
			end

			-- Potential options: fields 10-12 (pot1-3) and 14-16 (addpot1-3)
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				-- (Phase 3) 쿨타임 감소는 "+N"이 아니라 "-N초" 형식이라 아래 가드보다 먼저 처리한다
				if string.match(opt, "재사용 대기시간") then
					cdReduceAdd += tonumber(string.match(opt, "%-(%d+)초") or "0") or 0
					continue
				end
				local numStr = string.match(opt, "%+(%d+)")
				if numStr == nil then continue end
				local val  = tonumber(numStr) or 0
				local isPct = string.sub(opt, -1) == "%"

				if string.match(opt, "올스탯") then
					if isPct then
						pctSTR += val; pctDEX += val; pctINT += val; pctLUK += val
					else
						flatSTR += val; flatDEX += val; flatINT += val; flatLUK += val
					end
				elseif string.match(opt, "STR") then
					if isPct then pctSTR += val else flatSTR += val end
				elseif string.match(opt, "DEX") then
					if isPct then pctDEX += val else flatDEX += val end
				elseif string.match(opt, "INT") then
					if isPct then pctINT += val else flatINT += val end
				elseif string.match(opt, "LUK") then
					if isPct then pctLUK += val else flatLUK += val end
				elseif string.match(opt, "공격력") or string.match(opt, "마력") then
					if isPct then pctATK += val else flatATK += val end
				elseif string.match(opt, "크리티컬 데미지") then
					-- (Phase 3 버그 수정) "크리티컬 데미지"는 "데미지"의 상위 문자열이라 데미지 분기보다
					-- **먼저** 검사해야 한다 - 기존 순서(데미지 먼저)에서는 크뎀 옵션이 데미지%로 오합산됐다.
					critDmgAdd += val
				elseif string.match(opt, "크리티컬") then
					critAdd += val
				elseif string.match(opt, "보스") then
					-- (요청 복원) 보스 몬스터 데미지(무기 전용 30/35/40%): 보스 판정이 없는 동안에는
					-- 상태창 데미지%에 그대로 합산해 유효 옵션으로 동작한다
					dmgPct += val
				elseif string.match(opt, "데미지") then
					dmgPct += val
				elseif string.match(opt, "방어율 무시") then
					defIgnoreAdd += val
				end
			end
		end

		-- Final stat values
		flatATK += self.potionAttackBonus
		flatATK += self.buffAttackBonus
		-- 표창+ 등 스킬 포인트 투자로 얻는 상시 공격력(포인트 1당 +2)
		flatATK += self.skillAttackBonus
		local baseVal  = 4 + level * 5
		local strFinal = math.floor((baseVal + flatSTR) * (1 + pctSTR / 100))
		local dexFinal = math.floor((baseVal + flatDEX) * (1 + pctDEX / 100))
		local intFinal = math.floor((baseVal + flatINT) * (1 + pctINT / 100))
		local lukFinal = math.floor((baseVal + flatLUK) * (1 + pctLUK / 100))

		local statATK      = (1 + flatATK) * (1 + pctATK / 100)

		-- (버그 수정) "전투력에 직접 곱하면 안 되고, 데미지% 스탯이 콤보당 20%씩 합산으로 올라야
		-- 한다 - 그러면 전투력은 그 데미지%를 반영하는 기존 공식에서 자동으로 계산된다"는 피드백.
		-- 콤보 어택 버프의 구슬 1개당 +20% 보너스(PlayerAttack.ApplyComboAttackBonus와 동일 수치)를
		-- 장비 데미지%(dmgPct)와 똑같이 totalDmgPct에 가산한다 - 별도 배율을 곱하지 않는다.
		local player = _UserService.LocalPlayer
		local comboDmgPct = 0
		if isvalid(player) then
			local pa = player:GetComponent(PlayerAttack)
			if isvalid(pa) then
				comboDmgPct = 20 * (pa.ComboOrbCount or 0)
			end
		end
		local totalDmgPct = dmgPct + comboDmgPct
		-- (Phase 4) 기본 크리티컬 확률 50% → 10% (GDD §4.7) - 크확은 주로 잠재 옵션으로 쌓는 성장 축
		-- (발도술) 처치 중첩 버프의 크확 보너스(+3%×중첩)를 스탯창에도 반영한다(CalcCritRate와 동일 가산).
		-- (표창+ 개편) 고른 표창의 크확(5~9번 10~30%)도 함께 표시한다.
		local critRate     = 10 + critAdd + self.battoCritBonus + self.shurikenCritBonus
		-- 크리티컬 데미지: 기본 125%(크리티컬 적중 시 데미지 100% -> 125%로 상승) + 장비 잠재능력의
		-- "크리티컬 데미지 +N%" 옵션 합산. PlayerAttack.SyncCritDamage로 서버에 동기화되어 실제
		-- 전투 데미지 계산(크리티컬 배율)에 그대로 반영된다.
		local critDamage   = 125 + critDmgAdd

		-- Defense ignore: base 50% + additional compounded
		local defIgnore = 100 - (1 - 0.5) * (1 - defIgnoreAdd / 100) * 100

		-- (버그 수정) "전투력 공식이 잘못됐다 - 데미지%가 올라도 전투력에 영향을 주지 않는다"는 피드백.
		-- 올바른 공식: 제일 높은 스탯×4 + 부스탯×스탯공격력×총데미지×크리티컬데미지 (부스탯이 SubStat만
		-- 단독으로 더해지는 게 아니라 StatATK×TotalDmgMult×CritDmg 전체 곱과 함께 곱해져야 한다). 기존
		-- 코드는 subStat을 별도 항으로 더하기만 해서, totalDmgMult가 곱해지는 항(statATK 항)이 statATK
		-- 값 자체가 작을 때는 전투력에 거의 영향을 주지 못했다.
		local mainStat     = math.max(strFinal, dexFinal, intFinal, lukFinal)
		local subStat      = dexFinal   -- Novice/Warrior/Rogue sub = DEX
		local totalDmgMult = 1 + totalDmgPct / 100
		local critDmg      = 1.35
		local combat       = mainStat * 4 + subStat * statATK * totalDmgMult * critDmg

		-- Update stat value text entities
		local base = "/ui/DefaultGroup/CharInfoWindow/DetailPanel/"
		local function sv(name, text)
			local e = _EntityService:GetEntityByPath(base .. "StatVal_" .. name)
			if isvalid(e) then e.TextComponent.Text = text end
		end

		sv("Combat",    tostring(math.floor(combat)))
		sv("StatATK",   string.format("%.1f", statATK))
		sv("TotalDmg",  tostring(totalDmgPct) .. "%")
		sv("DefIgnore", string.format("%.0f%%", defIgnore))
		sv("HP",        tostring(hp) .. " / " .. tostring(maxHp))
		sv("MP",        "0 / 0")
		sv("STR",       tostring(strFinal))
		sv("DEX",       tostring(dexFinal))
		sv("INT",       tostring(intFinal))
		sv("LUK",       tostring(lukFinal))
		sv("CritRate",  tostring(critRate) .. "%")
		sv("CritDmg",   tostring(critDamage) .. "%")
		sv("CDReduce",  tostring(cdReduceAdd) .. "초")
		sv("CDImmune",  "0%")
		sv("AtkSpeed",  tostring(self:GetAttackSpeedStage()) .. "단계")
		sv("Meso",      "0%")
		sv("Drop",      "0%")
		sv("ExpBonus",  "0%")
	end

	-- (요청) 무기 특성에 의한 공격속도 보너스 단계. 한손검은 가볍고 빠른 무기라 장착 중 +2단계.
	-- atkSpeedStage를 직접 바꾸지 않고(비약/부스터의 증감·저장과 얽히지 않도록) 조회 시점에 동적으로 더한다 -
	-- 무기를 바꿔 끼면 자동으로 사라진다.
	@ExecSpace("ClientOnly")
	method integer GetWeaponAttackSpeedBonus()
		if _SkillManager:GetWeaponMotionClass() == "onehand" then
			return 2
		end
		return 0
	end

	-- 공격속도 단계 반환 (기본 5단계 + 무기 보너스)
	@ExecSpace("ClientOnly")
	method integer GetAttackSpeedStage()
		-- (표창+ 개편) 고른 표창의 공속 단계(8·9번 +1)도 함께 얹는다.
		return self.atkSpeedStage + self:GetWeaponAttackSpeedBonus() + self.shurikenAtkSpeedStage
	end

	-- 공격속도 단계 → 시간 배율. 5단계=1.0(현재 파워스트라이크 기준), 1단계 오를 때마다 이전 단계 대비 10%씩 줄어든다(복리).
	-- 모션 재생시간/공격 딜레이/타이밍 등 "시간" 값에 그대로 곱해서 사용한다 (배율이 작을수록 더 빠름).
	@ExecSpace("ClientOnly")
	method number GetAttackSpeedMultiplier()
		return 0.9 ^ (self:GetAttackSpeedStage() - 5)
	end

	-- "공격 속도의 비약" 사용 시 호출 - 공격속도 1단계 증가
	@ExecSpace("ClientOnly")
	method void IncreaseAttackSpeedStage()
		self.atkSpeedStage = self.atkSpeedStage + 1
		log("[CharInfo] 공격속도 증가: " .. tostring(self.atkSpeedStage) .. "단계")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end
	end

	-- "부스터" 스킬 사용 시 호출 - 공격속도 1단계를 5분간 상승시킨다(재사용 시 중첩되지 않고 지속시간만 갱신 -
	-- 토큰 비교로 먼저 걸린 타이머의 원복을 무시). 이 스탯은 서버에 대응 데이터가 없는 클라이언트 전용 값이라
	-- (atkSpeedStage 자체가 그러하듯) 이 클라이언트에서 즉시 적용한다.
	@ExecSpace("ClientOnly")
	method void UseBooster(number duration, integer stages)
		-- (스킬 효과 개편) 지속시간·공속 단계를 스킬 투자 레벨 기반으로 호출부(SkillManager)가 넘긴다.
		-- 재시전으로 단계가 달라질 수 있으므로(9→10레벨 분배 직후), 이전 적용 단계를 정확히 되돌리고 새로 건다.
		if self._T.boosterActive then
			self.atkSpeedStage = self.atkSpeedStage - (self._T.boosterStages or 1)
		end
		self.atkSpeedStage = self.atkSpeedStage + stages
		self._T.boosterStages = stages
		self._T.boosterActive = true
		log("[CharInfo] 부스터 발동 - 공격속도 +" .. tostring(stages) .. "단계: " .. tostring(self.atkSpeedStage) .. "단계 (" .. tostring(duration) .. "초)")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end

		self._T.boosterToken = (self._T.boosterToken or 0) + 1
		local myToken = self._T.boosterToken

		_TimerService:SetTimerOnce(function()
			if self._T.boosterToken ~= myToken then return end
			self.atkSpeedStage = self.atkSpeedStage - (self._T.boosterStages or 1)
			self._T.boosterActive = false
			log("[CharInfo] 부스터 종료 - 공격속도 원복: " .. tostring(self.atkSpeedStage) .. "단계")
			local cw2 = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw2) and cw2.Enable then
				self:UpdateStats()
			end
		end, duration)

		_BoosterBuffUI:ShowBuff(duration)
	end

	-- (버프 아이콘 우클릭 취소) 부스터를 즉시 종료한다 - 자연 만료(UseBooster의 타이머 본문)와
	-- 동일한 정리를 지금 수행하고, 토큰을 올려 예약된 만료 타이머를 무효화한다.
	@ExecSpace("ClientOnly")
	method void CancelBooster()
		if not self._T.boosterActive then return end
		self._T.boosterToken = (self._T.boosterToken or 0) + 1
		self.atkSpeedStage = self.atkSpeedStage - (self._T.boosterStages or 1)
		self._T.boosterActive = false
		log("[CharInfo] 부스터 취소(우클릭) - 공격속도 원복: " .. tostring(self.atkSpeedStage) .. "단계")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end
	end

	-- 발도술(히어로 3차) 기본 사용 효과: 버프 지속시간 동안 공속 +1단계. 부스터와 동일한 토큰 패턴이되
	-- 별도 필드(battoProc*)라 부스터/비약과 겹쳐 적용된다. 재시전 시 이전 적용을 되돌리고 새로 건다.
	-- (효과 개편) 예전엔 처치 중첩 프록이 이 메서드로 공속을 올렸지만, 지금은 시전 시점(SkillManager
	-- 디스패치)이 지속시간 전체로 1단계를 거는 용도다. 중첩 프록은 UseBattoStackBuff(공격력/크확) 참고.
	@ExecSpace("ClientOnly")
	method void UseBattoAtkSpeed(number remain, integer stages)
		if self._T.battoProcActive then
			self.atkSpeedStage = self.atkSpeedStage - (self._T.battoProcStages or 1)
		end
		self.atkSpeedStage = self.atkSpeedStage + stages
		self._T.battoProcStages = stages
		self._T.battoProcActive = true
		log("[CharInfo] 발도술 프록 - 공격속도 +" .. tostring(stages) .. "단계 (" .. string.format("%.1f", remain) .. "초): " .. tostring(self.atkSpeedStage) .. "단계")
		local cwBT = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBT) and cwBT.Enable then
			self:UpdateStats()
		end
		self._T.battoProcToken = (self._T.battoProcToken or 0) + 1
		local myToken = self._T.battoProcToken
		_TimerService:SetTimerOnce(function()
			if self._T.battoProcToken ~= myToken then return end
			self:CancelBattoAtkSpeed()
		end, remain)
	end

	-- 발도술 프록 공속 원복(만료/취소 공용). 서버 종료 통보(NotifyBattoProcEnd)와 클라 자체 만료
	-- 타이머 어느 쪽이 먼저 와도 한 번만 되돌린다.
	@ExecSpace("ClientOnly")
	method void CancelBattoAtkSpeed()
		if not self._T.battoProcActive then return end
		self._T.battoProcToken = (self._T.battoProcToken or 0) + 1
		self.atkSpeedStage = self.atkSpeedStage - (self._T.battoProcStages or 1)
		self._T.battoProcActive = false
		log("[CharInfo] 발도술 프록 종료 - 공격속도 원복: " .. tostring(self.atkSpeedStage) .. "단계")
		local cwBT = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBT) and cwBT.Enable then
			self:UpdateStats()
		end
	end

	-- 각성(나이트로드 4차): 지속시간 동안 공속을 구간별로 크게 올린다(1~9분배 5단계 / 10~19 10단계 /
	-- 20분배 이상 15단계). 부스터/발도술과 같은 토큰 패턴이되 별도 필드(awakeningProc*)라 서로 겹쳐
	-- 적용된다. 재시전 시 이전 적용을 정확히 되돌리고 새로 건다.
	-- ⚠ 공속은 서버에 대응 데이터가 없는 **클라 전용 상태**다(부스터와 같은 이유) - 스킬 시전 때
	--   GetAttackSpeedMultiplier로 계산한 배율이 RPC 인자로 서버에 전달된다.
	@ExecSpace("ClientOnly")
	method void UseAwakeningAtkSpeed(number remain, integer stages)
		if self._T.awakeningProcActive then
			self.atkSpeedStage = self.atkSpeedStage - (self._T.awakeningProcStages or 0)
		end
		self.atkSpeedStage = self.atkSpeedStage + stages
		self._T.awakeningProcStages = stages
		self._T.awakeningProcActive = true
		log("[CharInfo] 각성 - 공격속도 +" .. tostring(stages) .. "단계 (" .. string.format("%.1f", remain) .. "초): " .. tostring(self.atkSpeedStage) .. "단계")
		local cwAW = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwAW) and cwAW.Enable then
			self:UpdateStats()
		end
		self._T.awakeningProcToken = (self._T.awakeningProcToken or 0) + 1
		local myToken = self._T.awakeningProcToken
		_TimerService:SetTimerOnce(function()
			if self._T.awakeningProcToken ~= myToken then return end
			self:CancelAwakeningAtkSpeed()
		end, remain)
	end

	-- 각성 공속 원복(만료/취소/서버 종료 통보 공용). 어느 쪽이 먼저 와도 한 번만 되돌린다.
	@ExecSpace("ClientOnly")
	method void CancelAwakeningAtkSpeed()
		if not self._T.awakeningProcActive then return end
		self._T.awakeningProcToken = (self._T.awakeningProcToken or 0) + 1
		self.atkSpeedStage = self.atkSpeedStage - (self._T.awakeningProcStages or 0)
		self._T.awakeningProcActive = false
		log("[CharInfo] 각성 종료 - 공격속도 원복: " .. tostring(self.atkSpeedStage) .. "단계")
		local cwAW = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwAW) and cwAW.Enable then
			self:UpdateStats()
		end
	end

	-- 발도술 처치 중첩 프록(효과 개편): 중첩당 공격력 +10(buffAttackBonus 합산 경로 - 분노/메디와 겹침)과
	-- 크리티컬 확률 +3%(battoCritBonus)를 remain초 동안 적용한다. 중첩이 바뀌면 이전 적용을 정확히
	-- 되돌리고 새 수치를 다시 건다. 서버(PlayerAttack.AddBattoStack)가 중첩/남은 시간을 계산해 넘긴다.
	-- 스킬은 시전 때마다 전투력/크확을 새로 넘기지만, 엔진이 서버에서 직접 띄우는 기본공격은 동기화 값만
	-- 보므로 다크사이트와 같은 즉시 재동기화(SyncDarkSightStats - 이름과 달리 범용 스탯 재동기화)를 태운다.
	@ExecSpace("ClientOnly")
	method void UseBattoStackBuff(number remain, integer stacks)
		if self._T.battoStackActive then
			self.buffAttackBonus = self.buffAttackBonus - (self._T.battoStackAtk or 0)
			self.battoCritBonus = self.battoCritBonus - (self._T.battoStackCrit or 0)
		end
		local atkBonus = 10 * stacks
		local critBonus = 3 * stacks
		self.buffAttackBonus = self.buffAttackBonus + atkBonus
		self.battoCritBonus = self.battoCritBonus + critBonus
		self._T.battoStackAtk = atkBonus
		self._T.battoStackCrit = critBonus
		self._T.battoStackActive = true
		log("[CharInfo] 발도술 중첩 프록 - 공격력 +" .. tostring(atkBonus) .. " 크확 +" .. tostring(critBonus) .. "% (" .. string.format("%.1f", remain) .. "초)")
		local cwBS = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBS) and cwBS.Enable then
			self:UpdateStats()
		end
		_SkillManager:SyncDarkSightStats()
		self._T.battoStackToken = (self._T.battoStackToken or 0) + 1
		local myToken = self._T.battoStackToken
		_TimerService:SetTimerOnce(function()
			if self._T.battoStackToken ~= myToken then return end
			self:CancelBattoStackBuff()
		end, remain)
	end

	-- 발도술 중첩 프록 원복(만료/취소 공용). 서버 종료 통보와 클라 자체 만료 타이머 어느 쪽이 먼저 와도
	-- 한 번만 되돌리고, 기본공격용 서버 동기화 값도 즉시 갱신한다.
	@ExecSpace("ClientOnly")
	method void CancelBattoStackBuff()
		if not self._T.battoStackActive then return end
		self._T.battoStackToken = (self._T.battoStackToken or 0) + 1
		self.buffAttackBonus = self.buffAttackBonus - (self._T.battoStackAtk or 0)
		self.battoCritBonus = self.battoCritBonus - (self._T.battoStackCrit or 0)
		self._T.battoStackActive = false
		log("[CharInfo] 발도술 중첩 프록 종료 - 공격력/크확 원복 (buffAttackBonus=" .. tostring(self.buffAttackBonus) .. " battoCritBonus=" .. tostring(self.battoCritBonus) .. ")")
		local cwBS = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBS) and cwBS.Enable then
			self:UpdateStats()
		end
		_SkillManager:SyncDarkSightStats()
	end

	-- 브랜디쉬 강화(4차 버프): 5분간 ①브랜디쉬 데미지 1.5배 ②브랜디쉬 공속 +1단계 ③브랜디쉬 이펙트/아이콘
	-- 붉은/핑크색. 부스터와 동일한 토큰 패턴(중첩 없이 지속시간만 갱신). 브랜디쉬 전용이라 전역 atkSpeedStage를
	-- 건드리지 않고 별도 플래그로만 관리한다 - SkillManager가 브랜디쉬 시전 시 IsBrandishEnhanceActive를 읽어
	-- 데미지(전투력×1.5)/공속(배율×0.9=+1단계)/이펙트색을 적용한다. 서버엔 대응 데이터가 없는 클라 전용 값이다.
	@ExecSpace("ClientOnly")
	method void UseBrandishEnhance()
		if not self._T.brandishEnhanceActive then
			self._T.brandishEnhanceActive = true
			log("[CharInfo] 브랜디쉬 강화 발동 - 데미지 1.5배 / 공속 +1단계 / 붉은 이펙트 (5분)")
		end
		self._T.brandishEnhanceToken = (self._T.brandishEnhanceToken or 0) + 1
		local myToken = self._T.brandishEnhanceToken
		local duration = 300
		_TimerService:SetTimerOnce(function()
			if self._T.brandishEnhanceToken ~= myToken then return end
			self._T.brandishEnhanceActive = false
			log("[CharInfo] 브랜디쉬 강화 종료")
		end, duration)
		-- (2단계 예정) 버프바 표시: _BrandishEnhanceBuffUI:ShowBuff(duration) - 전용 버프 슬롯 UI 제작 후 연결.
	end

	-- SkillManager가 브랜디쉬/브랜디쉬2 시전 시 참조한다(클라 전용 상태).
	method boolean IsBrandishEnhanceActive()
		return self._T.brandishEnhanceActive == true
	end

	-- 어드밴스드 스피어 버스터(4차, 2026-08-05 스펙 개편): **연출 전용 토글**이다.
	-- 데미지 보너스(분배당 스피어 버스터 줄당 최소 +5%p / 최대 +10%p)는 투자 레벨만으로 항상 적용되고
	-- (SkillManager.GetAdvSpearBurstMin/MaxBonus), 이 값은 새로 그린 전용 아트(용머리/마법진/날개/
	-- 찌르기3종)를 쓸지 여부만 결정한다. OFF면 안 배운 것처럼 원래 스피어 버스터 이펙트로 나간다.
	-- (구 사양의 "보유 시 데미지 1.5배"는 폐지 - 레벨 스케일과 이중 성장이었다.)
	property boolean advancedSpearBusterEffectOn = true
	method boolean IsAdvancedSpearBusterEffectOn()
		return self.advancedSpearBusterEffectOn == true
	end

	-- (요청) 어드밴스드 스피어 버스터를 퀵슬롯에서 쓰면 강화 이펙트를 켜고 끈다. 토글 후 새 상태(true=ON)를 돌려준다.
	-- 클라 전용 상태(SkillManager가 시전 시 이 값을 읽어 enhanced 플래그만 서버로 넘긴다 - 데미지는 무관).
	@ExecSpace("ClientOnly")
	method boolean ToggleAdvancedSpearBusterEffect()
		self.advancedSpearBusterEffectOn = not (self.advancedSpearBusterEffectOn == true)
		log("[CharInfoManager] 어드밴스드 스피어 버스터 강화 이펙트 " .. (self.advancedSpearBusterEffectOn and "ON" or "OFF"))
		return self.advancedSpearBusterEffectOn
	end

	-- 에로우 블로우 강화(1차): ON이면 에로우 블로우가 적중 지점에서 폭발해 최대 5명까지 시간차로 타격한다.
	-- 어드밴스드 스피어 버스터와 동일하게 스킬을 슬롯에 배정해 쓰면 ON/OFF가 토글되는 클라 전용 상태다
	-- (SkillManager가 시전 시 클라에서 읽어 enhanced 플래그를 서버로 넘긴다). 기본은 OFF.
	property boolean arrowBlowEnhanceOn = false
	method boolean IsArrowBlowEnhanceActive()
		return self.arrowBlowEnhanceOn == true
	end

	@ExecSpace("ClientOnly")
	method boolean ToggleArrowBlowEnhance()
		-- 에로우 블로우 강화를 켜고 끈다. 토글 후 새 상태(true=ON)를 돌려준다.
		self.arrowBlowEnhanceOn = not (self.arrowBlowEnhanceOn == true)
		log("[CharInfoManager] 에로우 블로우 강화 " .. (self.arrowBlowEnhanceOn and "ON" or "OFF"))
		return self.arrowBlowEnhanceOn
	end

	-- 암행(나이트로드 2차): 상시 패시브 → ON/OFF 토글 → (요청 2026-08-05) **지속시간이 있는 버프**로
	-- 바뀌었다. 켜져 있는 동안만 온히트 그림자 표창이 발동한다.
	-- ⚠ 지속시간 관리(타이머·버프바 표시·서버 통보)는 전부 SkillManager가 한다 - 여기는 "지금 켜져
	--   있는가" 하나만 들고 있는다(발동 판정은 서버 PlayerAttack, 스위치는 RequestSetAmhaengState).
	property boolean amhaengOn = false
	method boolean IsAmhaengActive()
		return self.amhaengOn == true
	end

	@ExecSpace("ClientOnly")
	method void SetAmhaengActive(boolean on)
		-- 암행 활성 상태를 그대로 지정한다(시전 시 true / 만료·취소 시 false).
		self.amhaengOn = (on == true)
		log("[CharInfoManager] 암행 " .. (self.amhaengOn and "ON" or "OFF"))
	end

	-- 암행2(3차): 암행1과 같은 확률(5%)로 **독립적으로** 굴려, 몬스터 뒤쪽에 그림자를 소환해
	-- 더블스탭 또는 새비지블로우를 쓰게 한다. 암행1과 마찬가지로 테스트용 ON/OFF 토글이다.
	property boolean amhaeng2On = false
	method boolean IsAmhaeng2Active()
		return self.amhaeng2On == true
	end

	@ExecSpace("ClientOnly")
	method boolean ToggleAmhaeng2()
		-- 암행2를 켜고 끈다. 토글 후 새 상태(true=ON)를 돌려준다.
		self.amhaeng2On = not (self.amhaeng2On == true)
		log("[CharInfoManager] 암행2 " .. (self.amhaeng2On and "ON" or "OFF"))
		return self.amhaeng2On
	end

	-- 백스탭(2차): 몬스터가 바라보는 방향의 뒤쪽에서 때리면 추가 데미지를 주는 스킬.
	-- (요청) 테스트를 위해 지금은 암행과 동일한 ON/OFF 토글이다 - 나중에 "스킬을 보유하고만 있으면
	-- 항상 발동"으로 바꿀 예정이므로, 발동 여부 판정을 이 한 곳(IsBackstabActive)에만 두어
	-- 그때 이 메서드가 항상 true를 돌려주도록 고치면 되게 만들어 둔다.
	-- 실제 뒤통수 판정/데미지 증가는 서버(PlayerAttack)에서 하므로, 토글 시 SkillManager가 RPC로
	-- 서버에도 반영한다(암행과 동일한 구조).
	property boolean backstabOn = false
	method boolean IsBackstabActive()
		return self.backstabOn == true
	end

	@ExecSpace("ClientOnly")
	method boolean ToggleBackstab()
		-- 백스탭을 켜고 끈다. 토글 후 새 상태(true=ON)를 돌려준다.
		self.backstabOn = not (self.backstabOn == true)
		log("[CharInfoManager] 백스탭 " .. (self.backstabOn and "ON" or "OFF"))
		return self.backstabOn
	end

	-- 매직 에로우(3차 토글 3종): 매직 미사일의 속성 강화 상태. ""=무속성(기본), "light"=빛(노랑·하양),
	-- "ice"=얼음(파랑), "fire"=불(붉은색). 켜져 있는 동안 매직 미사일의 구체/이펙트 색이 속성색으로 바뀌고
	-- 데미지가 2배가 된다. 세 속성은 서로 배타적 - 하나를 켜면 나머지는 자동으로 꺼진다.
	-- 에로우 블로우 강화와 동일한 클라 전용 상태(SkillManager가 시전 시 클라에서 읽어 서버로 넘긴다).
	property string magicMissileElement = ""
	method string GetMagicMissileElement()
		-- 현재 켜져 있는 매직 에로우 속성 키를 돌려준다. 꺼져 있으면 빈 문자열.
		return self.magicMissileElement or ""
	end

	@ExecSpace("ClientOnly")
	method boolean ToggleMagicMissileElement(string element)
		-- 매직 에로우 속성을 토글한다. 같은 속성을 다시 쓰면 OFF, 다른 속성 중이었으면 이 속성으로 교체(ON).
		-- 토글 후 "이 속성이 켜졌는지"(true=ON)를 돌려준다.
		if self.magicMissileElement == element then
			self.magicMissileElement = ""
		else
			self.magicMissileElement = element
		end
		local on = self.magicMissileElement == element
		log("[CharInfoManager] 매직 에로우 속성(" .. tostring(element) .. ") " .. (on and "ON" or "OFF"))
		return on
	end

	-- (신규) 2차 버프 스킬의 공마 보너스 적용 공통 코어. UseBooster와 동일한 토큰 패턴으로,
	-- 재사용 시 중첩 없이 지속시간만 갱신한다. key는 버프별 상태를 _T에 분리 저장하는 접두사.
	-- 각 버프는 서로 독립적이라(분노+메디테이션+파워가드 동시 활성 가능) buffAttackBonus는 합산된다.
	@ExecSpace("ClientOnly")
	method void ApplyAttackBuff(string key, integer atkBonus, number duration)
		local activeKey = "buff_" .. key .. "_active"
		local bonusKey = "buff_" .. key .. "_bonus"
		local tokenKey = "buff_" .. key .. "_token"
		if not self._T[activeKey] then
			self.buffAttackBonus = self.buffAttackBonus + atkBonus
			self._T[activeKey] = true
			self._T[bonusKey] = atkBonus
			log("[CharInfo] 버프 발동(" .. key .. ") 공마 +" .. tostring(atkBonus) .. " (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
			local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw) and cw.Enable then self:UpdateStats() end
		end
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		local myToken = self._T[tokenKey]
		_TimerService:SetTimerOnce(function()
			if self._T[tokenKey] ~= myToken then return end
			self.buffAttackBonus = self.buffAttackBonus - (self._T[bonusKey] or 0)
			self._T[activeKey] = false
			log("[CharInfo] 버프 종료(" .. key .. ") 공마 원복 (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
			local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw) and cw.Enable then self:UpdateStats() end
		end, duration)
	end

	-- (용 소환, 2026-08-04) 살아 있는 소환 용 1마리당 공격력 +10. 지속시간이 정해진 다른 버프와 달리
	-- "현재 마리 수로 계속 갱신"되는 값이라 ApplyAttackBuff의 토큰/타이머 패턴을 쓰지 않고, 이전 값과의
	-- 차이만 buffAttackBonus에 반영한다(용이 추가 소환되거나 격추될 때마다 곧바로 따라온다).
	@ExecSpace("ClientOnly")
	method void SetSummonDragonAttackBonus(integer atkBonus)
		-- atkBonus = 살아 있는 마리 수 × 10. 0이면 보너스가 완전히 사라진다(소환 종료/전멸).
		local prev = self._T.summonDragonAtk or 0
		if prev == atkBonus then return end
		self.buffAttackBonus = self.buffAttackBonus - prev + atkBonus
		self._T.summonDragonAtk = atkBonus
		log("[CharInfo] 소환 용 공격력 보너스 " .. tostring(prev) .. " → " .. tostring(atkBonus)
			.. " (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then self:UpdateStats() end
	end

	-- (버프 아이콘 우클릭 취소) 공마 버프(분노/메디테이션/파워가드)를 즉시 종료한다 -
	-- ApplyAttackBuff의 자연 만료 본문과 동일한 정리를 지금 수행하고, 토큰을 올려 예약 타이머를 무효화한다.
	@ExecSpace("ClientOnly")
	method void CancelAttackBuff(string key)
		local activeKey = "buff_" .. key .. "_active"
		local bonusKey = "buff_" .. key .. "_bonus"
		local tokenKey = "buff_" .. key .. "_token"
		if not self._T[activeKey] then return end
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		self.buffAttackBonus = self.buffAttackBonus - (self._T[bonusKey] or 0)
		self._T[activeKey] = false
		log("[CharInfo] 버프 취소(우클릭, " .. key .. ") 공마 원복 (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then self:UpdateStats() end
	end

	-- 분노(2차 버프): 5분간 공마 +30.
	@ExecSpace("ClientOnly")
	method void UseRage(number duration, integer atkBonus)
		-- (스킬 효과 개편) 공마 보너스(분배당 +2, 마스터 +40)·지속시간을 호출부가 투자 레벨로 계산해 넘긴다.
		self:ApplyAttackBuff("rage", atkBonus, duration)
		_RageBuffUI:ShowBuff(duration)
	end

	-- 메디테이션(2차 버프): 5분간 공마 +30.
	@ExecSpace("ClientOnly")
	method void UseMeditation()
		self:ApplyAttackBuff("meditation", 30, 300)
		_MeditationBuffUI:ShowBuff(300)
	end

	-- (다크드래곤) 드래곤이 걸어주는 분노/메디테이션 스탯 버프를 소유주 클라에 적용한다. 서버(DarkDragon)가
	-- 소유주 UserId를 마지막 인자로 넘겨 이 클라 메서드를 호출한다(쿨타임 초기화 ResetAllCooldowns와 동일 패턴).
	-- key="rage"/"meditation", 지속시간 30초. 공마 +30(기존 분노/메디테이션과 동일 보너스).
	@ExecSpace("Client")
	method void ApplyDragonStatBuff(string key, integer atkBonus, number duration)
		self:ApplyAttackBuff(key, atkBonus, duration)
		if key == "rage" then
			_RageBuffUI:ShowBuff(duration)
		elseif key == "meditation" then
			_MeditationBuffUI:ShowBuff(duration)
		end
		log("[CharInfo] 드래곤 버프 적용(" .. key .. ") +" .. tostring(atkBonus) .. " " .. tostring(duration) .. "초")
	end

	-- 블레스(2차 버프): 5분간 공마 +30 (자신 몫). 주변 소환 용사 몫은 서버(PlayerAttack.AttackBless)가 처리한다.
	@ExecSpace("ClientOnly")
	method void UseBless()
		self:ApplyAttackBuff("bless", 30, 300)
		_BlessBuffUI:ShowBuff(300)
	end

	-- 파워가드(2차 버프): 5분간 공격력 +10. 받는 피해 30% 회복은 서버(PlayerHit)에서 별도로 처리한다
	-- (스탯 버프는 클라 전용이지만 피해 회복은 서버 피격 파이프라인에서 일어나므로).
	@ExecSpace("ClientOnly")
	method void UsePowerGuard(number duration)
		-- (스킬 효과 개편) 지속시간을 호출부가 투자 레벨로 계산해 넘긴다. 공격력 +10은 고정.
		self:ApplyAttackBuff("powerguard", 10, duration)
		_PowerGuardBuffUI:ShowBuff(duration)
	end

	-- "공격력 물약" 사용 시 호출 - 공격력 +500. potionAttackBonus는 세션 전용 스탯이라
	-- (CharacterPersistence가 저장하지 않음) 게임 종료 시 사라진다.
	@ExecSpace("ClientOnly")
	method void UseAttackPotion()
		self.potionAttackBonus = self.potionAttackBonus + 500
		log("[CharInfo] 공격력 물약 사용: 공격력 +500 (누적 potionAttackBonus=" .. tostring(self.potionAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
			self:UpdateLevelClass()
		end
	end

	-- "레벨 70 물약" 사용 시 호출 - 공격력 +1000, 마력 +1000 (이 스탯 시스템은 둘을 flatATK 하나로 합쳐 계산하므로 2000 반영)
	@ExecSpace("ClientOnly")
	method void UseLevel70Potion()
		self.potionAttackBonus = self.potionAttackBonus + 2000
		log("[CharInfo] 레벨 70 물약 사용: 공격력/마력 각 +1000 (누적 potionAttackBonus=" .. tostring(self.potionAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end
	end

	-- Standalone critical-rate percentage (same formula as UpdateStats' "CritRate" stat: base 50% +
	-- equipped potential "크리티컬" options), for callers that need the number outside the stat window
	-- (skills sync this to the server so PlayerAttack.CalcCritical rolls against the real stat instead
	-- of a hardcoded chance).
	@ExecSpace("ClientOnly")
	method number CalcCritRate()
		local critAdd = 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				-- (Phase 3 버그 수정) "크리티컬 데미지" 옵션이 크리티컬 확률로 오합산되지 않게 제외한다
				if string.match(opt, "크리티컬") and not string.match(opt, "크리티컬 데미지") then
					local numStr = string.match(opt, "%+(%d+)")
					if numStr ~= nil then
						critAdd += tonumber(numStr) or 0
					end
				end
			end
		end
		-- (Phase 4) 기본 크리티컬 확률 50% → 10% (GDD §4.7)
		-- (발도술) 처치 중첩 버프의 크확 보너스(+3%×중첩) 가산 - 스킬 시전/기본공격 동기화 모두 이 값을 탄다.
		-- (표창+ 개편) 고른 표창의 크확(5~9번 10~30%) 가산.
		return 10 + critAdd + self.battoCritBonus + self.shurikenCritBonus
	end

	-- (Phase 4) 잠재 "스킬 재사용 대기시간 -N초" 옵션의 합산 초. SkillManager.ApplyCooldownReduction이
	-- 5초 이상 개별 쿨타임에 적용한다 (스탯창 CDReduce 표시와 동일 계산).
	@ExecSpace("ClientOnly")
	method number GetCooldownReduction()
		local cdAdd = 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				if string.match(opt, "재사용 대기시간") then
					cdAdd += tonumber(string.match(opt, "%-(%d+)초") or "0") or 0
				end
			end
		end
		return cdAdd
	end

	-- Standalone critical-damage percentage (same formula as UpdateStats' "CritDmg" stat: base 125% +
	-- equipped potential "크리티컬 데미지" options), for callers that need the number outside the stat
	-- window (skills sync this to the server so PlayerAttack.CalcDamage's crit multiplier uses the real
	-- stat instead of a hardcoded 200%).
	@ExecSpace("ClientOnly")
	method number CalcCritDamage()
		local critDmgAdd = 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				if string.match(opt, "크리티컬 데미지") then
					local numStr = string.match(opt, "%+(%d+)")
					if numStr ~= nil then
						critDmgAdd += tonumber(numStr) or 0
					end
				end
			end
		end
		return 125 + critDmgAdd
	end

	-- Standalone combat-power number (same formula as UpdateStats' "Combat" stat), for callers that only need the number (e.g. UIMyInfoManager's world HUD level).
	@ExecSpace("ClientOnly")
	method number CalcCombatPower()
		-- 현재 장착 장비 기준 전투력 (교체 시뮬레이션 없이)
		return self:CalcCombatPowerSwap(0, "")
	end

	-- 장비 slot(1~7)을 swapStr로 교체했다고 가정한 전투력. swapSlot=0이면 현재 장비 그대로.
	-- 툴팁의 "전투력 증가량" 계산용 - UpdateStats/기존 CalcCombatPower와 동일한 공식을 사용한다.
	@ExecSpace("ClientOnly")
	method number CalcCombatPowerSwap(number swapSlot, string swapStr)
		-- (Phase 1) baseVal용 레벨도 장비 전투력 환산 레벨을 쓴다 (_UIMyInfoManager.CharLevel은 죽은 값).
		-- GetDisplayLevel → CalcEquipCombatPower는 이 메서드를 호출하지 않으므로 순환 없음.
		local level = self:GetDisplayLevel()

		local flatSTR, flatDEX, flatINT, flatLUK = 0, 0, 0, 0
		local pctSTR,  pctDEX,  pctINT,  pctLUK  = 0, 0, 0, 0
		local flatATK, pctATK   = 0, 0
		local dmgPct            = 0

		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if slot == swapSlot then s = swapStr end
			if s == "" then continue end

			-- 무기 슬롯 기본옵션: 직업별 드롭박스 지급 무기는 공격력/마력 +30 고정 (잠재능력과 별개)
			if slot == 6 then
				local baseName = _UIEquipInventoryManager:ParseName(s)
				if _UIEquipInventoryManager:IsJobDropWeapon(baseName) then
					flatATK += 30
				end
			end

			local stars = self:ParseFieldNum(s, 4)
			if stars > 0 then
				local sf = self:CalcStarforceStats(stars)
				flatSTR += sf.str; flatDEX += sf.dex
				flatINT += sf.int; flatLUK += sf.luk
				flatATK += sf.atk
			end

			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				local numStr = string.match(opt, "%+(%d+)")
				if numStr == nil then continue end
				local val  = tonumber(numStr) or 0
				local isPct = string.sub(opt, -1) == "%"

				if string.match(opt, "올스탯") then
					if isPct then
						pctSTR += val; pctDEX += val; pctINT += val; pctLUK += val
					else
						flatSTR += val; flatDEX += val; flatINT += val; flatLUK += val
					end
				elseif string.match(opt, "STR") then
					if isPct then pctSTR += val else flatSTR += val end
				elseif string.match(opt, "DEX") then
					if isPct then pctDEX += val else flatDEX += val end
				elseif string.match(opt, "INT") then
					if isPct then pctINT += val else flatINT += val end
				elseif string.match(opt, "LUK") then
					if isPct then pctLUK += val else flatLUK += val end
				elseif string.match(opt, "공격력") or string.match(opt, "마력") then
					if isPct then pctATK += val else flatATK += val end
				elseif string.match(opt, "크리티컬") then
					-- (Phase 3) 크리티컬 확률/데미지는 전투력 공식 미반영 - "데미지" 분기 오합산 방지
				elseif string.match(opt, "보스") then
					-- (요청 복원) 보스 몬스터 데미지(무기 전용): 보스 판정 도입 전까지 데미지%로 합산
					dmgPct += val
				elseif string.match(opt, "데미지") then
					dmgPct += val
				end
			end
		end

		flatATK += self.potionAttackBonus
		flatATK += self.buffAttackBonus
		-- 표창+ 등 스킬 포인트 투자로 얻는 상시 공격력(포인트 1당 +2)
		flatATK += self.skillAttackBonus
		local baseVal  = 4 + level * 5
		local strFinal = math.floor((baseVal + flatSTR) * (1 + pctSTR / 100))
		local dexFinal = math.floor((baseVal + flatDEX) * (1 + pctDEX / 100))
		local intFinal = math.floor((baseVal + flatINT) * (1 + pctINT / 100))
		local lukFinal = math.floor((baseVal + flatLUK) * (1 + pctLUK / 100))

		local statATK      = (1 + flatATK) * (1 + pctATK / 100)
		local totalDmgMult = 1 + dmgPct / 100

		-- (버그 수정) UpdateStats()의 "Combat" 표시값과 동일한 공식으로 맞춘다 - 제일 높은 스탯×4 +
		-- 부스탯×스탯공격력×총데미지×크리티컬데미지 (자세한 배경은 UpdateStats() 주석 참고).
		local mainStat = math.max(strFinal, dexFinal, intFinal, lukFinal)
		local subStat  = dexFinal
		local critDmg  = 1.35
		local combat   = mainStat * 4 + subStat * statATK * totalDmgMult * critDmg

		return math.floor(combat)
	end

	-- (Phase 1) 레벨 산정 전용 "장비 전투력(EquipCP)". 장착 장비(슬롯 1~25)에서 유래한 스탯만 합산한다.
	-- 제외 항목: 레벨 기본 스탯 baseVal(레벨→스탯→전투력→레벨 순환 참조 방지), 물약(potionAttackBonus),
	-- 버프(buffAttackBonus), 스킬 투자(skillAttackBonus) - "순수 아이템 성능만 레벨로 치환"이 사양.
	-- 대신 레벨과 무관한 고정 기저 스탯 10을 깔아, 스탯 장비가 없어도 공격력 옵션이 전투력에 반영되게 한다
	-- (기저 0이면 부스탯=0이라 공격력×부스탯 항이 통째로 0이 되는 붕괴 방지).
	-- 표시/스킬용 전투력은 기존 CalcCombatPower()를 그대로 쓴다.
	@ExecSpace("ClientOnly")
	method number CalcEquipCombatPower()
		local flatSTR, flatDEX, flatINT, flatLUK = 0, 0, 0, 0
		local pctSTR,  pctDEX,  pctINT,  pctLUK  = 0, 0, 0, 0
		local flatATK, pctATK   = 0, 0
		local dmgPct            = 0

		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end

			-- 무기 슬롯 기본옵션: 직업별 드롭박스 지급 무기는 공격력/마력 +30 고정 (잠재능력과 별개)
			if slot == 6 then
				local baseName = _UIEquipInventoryManager:ParseName(s)
				if _UIEquipInventoryManager:IsJobDropWeapon(baseName) then
					flatATK += 30
				end
			end

			local stars = self:ParseFieldNum(s, 4)
			if stars > 0 then
				local sf = self:CalcStarforceStats(stars)
				flatSTR += sf.str; flatDEX += sf.dex
				flatINT += sf.int; flatLUK += sf.luk
				flatATK += sf.atk
			end

			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				local numStr = string.match(opt, "%+(%d+)")
				if numStr == nil then continue end
				local val  = tonumber(numStr) or 0
				local isPct = string.sub(opt, -1) == "%"

				if string.match(opt, "올스탯") then
					if isPct then
						pctSTR += val; pctDEX += val; pctINT += val; pctLUK += val
					else
						flatSTR += val; flatDEX += val; flatINT += val; flatLUK += val
					end
				elseif string.match(opt, "STR") then
					if isPct then pctSTR += val else flatSTR += val end
				elseif string.match(opt, "DEX") then
					if isPct then pctDEX += val else flatDEX += val end
				elseif string.match(opt, "INT") then
					if isPct then pctINT += val else flatINT += val end
				elseif string.match(opt, "LUK") then
					if isPct then pctLUK += val else flatLUK += val end
				elseif string.match(opt, "공격력") or string.match(opt, "마력") then
					if isPct then pctATK += val else flatATK += val end
				elseif string.match(opt, "크리티컬") then
					-- (Phase 3) 크리티컬 확률/데미지는 전투력 공식 미반영 - "데미지" 분기 오합산 방지
				elseif string.match(opt, "보스") then
					-- (요청 복원) 보스 몬스터 데미지(무기 전용): 보스 판정 도입 전까지 데미지%로 합산
					dmgPct += val
				elseif string.match(opt, "데미지") then
					dmgPct += val
				end
			end
		end

		local baseVal  = 10   -- 고정 기저 스탯 (레벨 비의존 - 순환 참조 없음)
		local strFinal = math.floor((baseVal + flatSTR) * (1 + pctSTR / 100))
		local dexFinal = math.floor((baseVal + flatDEX) * (1 + pctDEX / 100))
		local intFinal = math.floor((baseVal + flatINT) * (1 + pctINT / 100))
		local lukFinal = math.floor((baseVal + flatLUK) * (1 + pctLUK / 100))

		local statATK      = (1 + flatATK) * (1 + pctATK / 100)
		local totalDmgMult = 1 + dmgPct / 100

		local mainStat = math.max(strFinal, dexFinal, intFinal, lukFinal)
		local subStat  = dexFinal
		local critDmg  = 1.35
		local combat   = mainStat * 4 + subStat * statATK * totalDmgMult * critDmg

		return math.floor(combat)
	end

	-- (Phase 1) 장비 전투력 → 표시 레벨 환산 (GDD §4.1 CP(L) 구간 테이블의 역함수).
	-- 필요 전투력 테이블은 최초 호출 시 한 번 생성해 _T에 캐싱한다. 어떤 기준에도 못 미치면 레벨 1(하한),
	-- 상한 200 가드. 앵커(v1 - Phase 5에서 CSV 이관 예정): Lv40=19,200 / Lv70≈130k / Lv120≈1.3M / Lv160≈8.2M.
	@ExecSpace("ClientOnly")
	method integer GetLevelForEquipCP(number cp)
		if self._T.levelCurve == nil then
			-- (Phase 5) CSV가 진실의 원천 - Balance/LevelCurve.csv를 읽고, 없거나 손상이면 하드코딩 폴백.
			local curve = nil
			local ok, ds = pcall(function() return _DataService:GetTable("LevelCurve") end)
			if ok and ds ~= nil then
				local n = ds:GetRowCount()
				if n >= 40 then
					curve = {}
					for i = 1, n do
						local lv = math.floor(tonumber(ds:GetCell(i, "level")) or 0)
						local reqCp = tonumber(ds:GetCell(i, "requiredCP")) or 0
						if lv >= 1 and lv <= 200 then curve[lv] = reqCp end
					end
					if curve[40] == nil then curve = nil end
					if curve ~= nil then log("[CharInfo] LevelCurve CSV 로드 완료 (" .. tostring(n) .. "행)") end
				end
			end
			if curve == nil then
				-- (재보정 v3) 스타포스 실물 CP 앵커: Lv40=13,000(6부위 12성) / Lv70=72,000(17성) /
				-- Lv120=250,000(20~21성) / Lv160=722,000(23성 - "22~24성 6부위=160" 사용자 앵커) / 161+ ×1.12 벽
				curve = {}
				for lv = 1, 40 do curve[lv] = 8.125 * lv * lv end                   -- 1~40: 8.125×L²
				for lv = 41, 70 do curve[lv] = curve[lv - 1] * 1.0587 end           -- 41~70: ×1.0587 복리
				for lv = 71, 120 do curve[lv] = curve[lv - 1] * 1.0252 end          -- 71~120: ×1.0252 복리
				for lv = 121, 160 do curve[lv] = curve[lv - 1] * 1.0269 end         -- 121~160: ×1.0269 복리
				for lv = 161, 200 do curve[lv] = curve[lv - 1] * 1.12 end           -- 161+: ×1.12 (벽)
				log("[CharInfo] LevelCurve 폴백(하드코딩) 사용")
			end
			self._T.levelCurve = curve
		end
		local curve = self._T.levelCurve
		local level = 1
		for lv = 1, 200 do
			local need = curve[lv]
			if need == nil then break end   -- CSV 행이 200 미만일 때 안전 종료
			if cp >= need then
				level = lv
			else
				break
			end
		end
		return level
	end

	-- (Phase 1) 현재 장비 전투력 기준 표시 레벨. 레벨을 참조하는 모든 지점의 단일 진입점 -
	-- 기존 "전투력 ÷ 10" 선형 환산과 _UIMyInfoManager.CharLevel(죽은 값) 참조를 전부 이걸로 대체한다.
	@ExecSpace("ClientOnly")
	method integer GetDisplayLevel()
		return self:GetLevelForEquipCP(self:CalcEquipCombatPower())
	end

	-- Returns starforce flat bonus stats table {str, dex, int, luk, atk}
	@ExecSpace("ClientOnly")
	method table CalcStarforceStats(integer stars)
		local str_ = 0
		local dex_ = 0
		local int_ = 0
		local luk_ = 0
		local atk_ = 0
		for i = 0, stars - 1 do
			if i < 5 then
				str_ += 3; dex_ += 3; int_ += 3; luk_ += 3
			elseif i < 10 then
				str_ += 4; dex_ += 4; int_ += 4; luk_ += 4
			elseif i < 15 then
				str_ += 5; dex_ += 5; int_ += 5; luk_ += 5
			elseif i < 20 then
				str_ += 7; dex_ += 7; int_ += 7; luk_ += 7
				atk_ += 7
			elseif i < 22 then
				str_ += 22; dex_ += 22; int_ += 22; luk_ += 22
				atk_ += 21
			else
				atk_ += i + 1
			end
		end
		return {str=str_, dex=dex_, int=int_, luk=luk_, atk=atk_}
	end

	-- Parse n-th pipe-delimited field as number (0 if missing or non-numeric)
	@ExecSpace("ClientOnly")
	method number ParseFieldNum(string s, integer n)
		local v = self:GetField(s, n)
		return tonumber(v) or 0
	end

	-- Return the n-th pipe-delimited field (1-indexed); "" if out of range
	@ExecSpace("ClientOnly")
	method string GetField(string s, integer n)
		local count = 0
		local last  = 1
		local slen  = string.len(s)
		local i     = 1
		while i <= slen do
			if string.sub(s, i, i) == "|" then
				count += 1
				if count == n then return string.sub(s, last, i - 1) end
				last = i + 1
			end
			i += 1
		end
		count += 1
		if count == n then return string.sub(s, last) end
		return ""
	end

end
