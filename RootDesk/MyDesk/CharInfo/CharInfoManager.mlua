@Logic
script CharInfoManager extends Logic

	property boolean detailOpen = true

	-- 공격속도 단계 (전투력 개편 2026-08-08: 기본 4단계 = "공격속도 100%"). 사용자에게는 단계 대신
	-- 퍼센트로 표기한다 - 1단계 오를 때마다 +10%p (부스터 +1단계 = "+10%", +2단계 = "+20%").
	-- "공격 속도의 비약" 사용 시 1단계씩 증가한다.
	-- 인벤토리와 마찬가지로 클라이언트 전용 상태 - 서버에는 대응 데이터가 없어(코스튬/인벤과 동일한 이유) 사용 시
	-- 스킬 발동 RPC 인자로 배율을 계산해 넘겨준다 (SkillManager:UseSkillInSlot 참고).
	property integer atkSpeedStage = 4

	-- "레벨 70 물약" 사용 시 누적되는 보너스. 이 스탯 시스템은 공격력/마력을 하나의 flatATK로 합쳐서 계산하므로
	-- (CalcCombatPower/UpdateStats의 "공격력" 또는 "마력" 옵션 분기 참고), 공격력 +1000·마력 +1000을 합쳐 2000으로 반영한다.
	property integer potionAttackBonus = 0

	-- (신규) 2차 버프 스킬(분노/메디테이션/파워가드)이 주는 공마(공격력·마력) 보너스의 합.
	-- 이 스탯 시스템은 공격력/마력을 하나의 flatATK로 합쳐 계산하므로(위 potionAttackBonus 참고)
	-- "공마 +30"은 여기에 30을 더하는 것으로 반영된다. 각 버프는 서로 독립적으로 켜지고, 이 값은
	-- 활성 버프들의 보너스 합이다. 전투력은 스킬 시전 시 RPC 인자로 서버에 전달되므로(SkillManager
	-- 참고) 이 보너스가 스킬 데미지에도 자동으로 반영된다.
	property integer buffAttackBonus = 0

	-- (블레스 개편 2026-08-08) 버프가 주는 STR/DEX/INT/LUK 공통 보너스의 합. buffAttackBonus의
	-- 4스탯판이다 - UpdateStats/CalcCombatPower 두 곳에서 네 스탯에 똑같이 가산된다.
	-- 블레스는 "분배 1포인트당 각 +3"이므로 마스터 30에서 90이 들어온다.
	property integer buffStatBonus = 0

	-- (신고 수정 2026-08-13 / 확장 2026-08-14) **"실효 버프" 보너스 통.** 위의 buffAttackBonus /
	-- buffStatBonus는 `_T.cpIncludeBuffs`가 켜진 **표시 경로에서만** 전투력에 들어간다 - 그래서 버프를
	-- 걸어도 스탯창 숫자만 오르고 스킬이 서버로 넘기는 전투력(= 실제 데미지)은 그대로였다
	-- (신고: "블레스의 공격력·스탯 상승이 실제 전투력 상승으로 오르지 않는다" / 요청 08-14: 메디테이션도
	--  "사용 시 마력에 따라 전투력이 오르게").
	-- 이 통에 들어온 버프만 CalcCombatPowerBase가 **항상** 합산한다(표시·스킬·기본공격 공통).
	-- 지금 쓰는 버프: **블레스**(공마 + 4스탯) / **메디테이션**(마력).
	-- ⚠ 레벨 환산(CalcEquipCombatPower)에서는 `_T.cpExcludeRealBuff` 플래그로 제외한다 -
	--   "레벨은 순수 장비 성능"(GDD §4.1)이 깨지면 최대 MP·매직 미사일 구체 수·SP 예산이 함께 흔들린다.
	-- ⚠ 그래서 이 버프들은 ApplyAttackBuff/ApplyStatBuff 공용 코어를 쓰지 않는다(쓰면 이중 합산).
	--   나머지 버프(파워가드·부스터·드래곤 블러드·발도술·드래곤이 걸어주는 분노/메디테이션 등)는
	--   요청 범위 밖이라 종전대로 표시 전용 통에 남아 있다 - 옮기면 전부 조용히 강해진다.
	property integer realBuffAttackBonus = 0
	property integer realBuffStatBonus = 0

	-- (발도술) 공격 중첩 버프의 크리티컬 확률 보너스(+3%×중첩). CalcCritRate/UpdateStats 두 곳에서 가산된다.
	property integer battoCritBonus = 0
	-- (발도술, 요청 2026-08-12) 공격 중첩 버프의 공격속도 보너스(+3%×중첩). 단계(10%)로는 3%를 표현할 수
	-- 없어 GetAttackSpeedPercent의 퍼센트 항에 직접 더한다(잠재 "공격속도 +N%"와 같은 자리).
	property integer battoStackAtkSpdPct = 0
	-- (요청 2026-08-12) 스탯창 "최종 데미지" 줄의 **장비+버프 몫 캐시**. UpdateStats가 25슬롯을 훑어
	-- 계산한 값을 담아두고, 콤보 구슬만 바뀔 때는 경량 경로(RefreshFinalDamageRow)가 이 값을 재사용한다.
	property integer equipBuffFinalDmgPct = 0
	-- (요청 2026-08-12) 초보자 패시브 "민첩 훈련"의 공격속도 보너스(5포인트당 +1%). 발도술 중첩과 같은
	-- 퍼센트 항에 더한다(단계 10% 단위로는 1%를 표현할 수 없다). SkillManager.ApplyBeginnerPassives가 대입.
	property integer beginnerAtkSpdPct = 0
	-- 콤보 감시 타이머 id(OnBeginPlay에서 걸고 OnEndPlay에서 푼다 - LEA-3051 방지).
	property integer comboWatchTimerId = 0

	-- (표창+ 개편 2026-08-05) 지금 고른 표창 종류가 주는 상시 효과. 표창을 바꾸거나 표창+ 계열 스킬에
	-- 포인트를 찍을 때 SkillManager.ApplyShurikenAttackBonus가 통째로 다시 대입한다(누적이 아니다).
	--   · 공격력은 skillAttackBonus에 함께 합산된다(아래 프로퍼티)
	--   · 크리티컬 확률은 CalcCritRate/UpdateStats에서 가산
	--   · 공격속도 단계는 GetAttackSpeedStage에서 가산(부스터/발도술과 겹쳐 적용)
	property integer shurikenCritBonus = 0
	property integer shurikenAtkSpeedStage = 0

	-- (샤프 아이즈, 신궁 4차 2026-08-06) 버프 지속 중에만 얹히는 크리티컬 보너스.
	--   · 크리티컬 확률: 분배 1포인트당 +1%p (마스터 30에서 +30) - CalcCritRate/UpdateStats에서 가산
	--   · 크리티컬 데미지: 전 구간 공통 +8%p - CalcCritDamage/UpdateStats에서 가산
	-- 발도술 중첩(battoCritBonus)과 같은 자리에 더해지되 별도 필드라 서로 겹쳐 적용된다.
	-- ⚠ 두 값 모두 **클라 전용 상태**다(장비 잠재와 같은 이유) - 서버 판정에는 스킬 시전/버프 시작 시점의
	--   SyncCritRate / SyncCritDamage로 밀어 넣는다(SkillManager.SyncSharpEyesStats).
	property integer sharpEyesCritBonus = 0
	property integer sharpEyesCritDmgBonus = 0

	-- 스킬 투자·표창 선택으로 얻는 상시 공격력 보너스. 표창+ 4차수 투자(포인트 1당 +1) +
	-- 지금 고른 표창의 공격력(아대 장착 시) + 트레이닝 1차(×2)·3차(×4)가 전부 여기 합산된다.
	-- 계산은 SkillManager.ApplyShurikenAttackBonus 한 곳에서 통째로 다시 대입한다(누적 아님).
	-- 버프(buffAttackBonus)와 달리 켜고 끄는 것이 아니라 투자 포인트에 따라 고정으로 유지된다.
	-- ⚠ (요청 2026-08-14 5차) **실효 보너스로 승격됐다** - CalcCombatPowerBase의
	--   `cpExcludeRealBuff` 블록에서 더해지므로 스탯창 표시뿐 아니라 **스킬 데미지가 쓰는 전투력에도
	--   반영**된다(종전에는 cpIncludeBuffs 표시 전용이라 숫자만 올랐다). 레벨 환산
	--   (CalcEquipCombatPower)에서만 제외된다 - 스킬 투자분이 레벨로 되먹임되면 순환하기 때문.
	property integer skillAttackBonus = 0
	-- (요청 2026-08-12) **공격력·마력 둘 다** 올리는 상시 보너스(현재는 초보자 "무기 숙련"만).
	-- skillAttackBonus(표창+·표창 효과·트레이닝 = 공격력 전용)와 구분해 두 줄에 각각 옳게 표시한다.
	property integer commonAttackBonus = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		local detailBtn = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailToggleBtn")
		if isvalid(detailBtn) then
			detailBtn:ConnectEvent(ButtonClickEvent, self.OnToggleDetail)
		end
		-- (요청 2026-08-12) 콤보 구슬 수가 바뀌면 스탯창 "최종 데미지" 줄을 실시간으로 따라가게 한다.
		-- 창이 닫혀 있거나 구슬 수가 그대로면 아무것도 하지 않는다(0.5초 주기·비교 후 그 한 줄만 갱신).
		-- ⚠ OnBeginPlay에서 건 타이머는 OnEndPlay에서 반드시 푼다 - 안 그러면 [LEA-3051] MemoryLeak(실측).
		self.comboWatchTimerId = _TimerService:SetTimerRepeat(self.ComboRowWatchTick, 0.5, 0.5)
		log("[CharInfo] ready")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 콤보 감시 타이머 해제(OnBeginPlay와 짝).
		if self.comboWatchTimerId ~= 0 then
			_TimerService:ClearTimer(self.comboWatchTimerId)
			self.comboWatchTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void ComboRowWatchTick()
		-- 구슬 수가 바뀌면 ① 서버 캐시 전투력을 갱신하고(기본공격/서버 발동 패시브는 동기화된 값만 본다 -
		-- 콤보가 전투력 배율에 합류한 2026-08-12 2차 개편 이후 필수) ② 스탯창이 열려 있으면 그 한 줄을 다시 쓴다.
		-- 스킬 시전은 매번 자기 전투력을 넘기므로 이 동기화와 무관하다.
		local cur = self:GetComboFinalDamagePct()
		if cur == (self._T.lastComboRowPct or -1) then return end
		self._T.lastComboRowPct = cur
		_SkillManager:SyncDarkSightStats()
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if not isvalid(cw) or not cw.Enable then return end
		local panel = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailPanel")
		if not isvalid(panel) or not panel.Enable then return end
		self:RefreshFinalDamageRow()
	end

	@ExecSpace("ClientOnly")
	method void OnToggleDetail(ButtonClickEvent event)
		local panel = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailPanel")
		if not isvalid(panel) then return end
		panel.Enable = not panel.Enable
		self.detailOpen = panel.Enable

		-- 버튼 텍스트 갱신
		local btn = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailToggleBtn")
		if isvalid(btn) then
			btn.TextComponent.Text = panel.Enable and "▲ 세부 정보" or "▼ 세부 정보"
		end

		-- BG 크기 변경 (창이 줄어드는 효과)
		-- 펼침: 650×936, 축소: 650×398 (top=468 고정, bottom=70)
		local bg = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/BG")
		if isvalid(bg) then
			if panel.Enable then
				bg.UITransformComponent.anchoredPosition = Vector2(0, 0)
				bg.UITransformComponent.RectSize = Vector2(650, 936)
			else
				-- top 468 고정, height=398 → center=269
				bg.UITransformComponent.anchoredPosition = Vector2(0, 269)
				bg.UITransformComponent.RectSize = Vector2(650, 398)
			end
		end
	end

	-- Called by UIEquipInventoryManager when CharInfoWindow opens or equipment changes
	@ExecSpace("ClientOnly")
	method void RefreshCharInfo()
		-- detailOpen 상태 복원 (이전에 닫았으면 닫힌 채로 열림)
		local panel = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailPanel")
		if isvalid(panel) then panel.Enable = self.detailOpen end
		local bg = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/BG")
		if isvalid(bg) then
			if self.detailOpen then
				bg.UITransformComponent.anchoredPosition = Vector2(0, 0)
				bg.UITransformComponent.RectSize = Vector2(650, 936)
			else
				bg.UITransformComponent.anchoredPosition = Vector2(0, 269)
				bg.UITransformComponent.RectSize = Vector2(650, 398)
			end
		end
		local btn = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/DetailToggleBtn")
		if isvalid(btn) then
			btn.TextComponent.Text = self.detailOpen and "▲ 세부 정보" or "▼ 세부 정보"
		end

		self:UpdateLevelClass()
		self:UpdateCharName()
		self:UpdateAvatar()
		self:UpdateStats()
	end

	@ExecSpace("ClientOnly")
	method void UpdateLevelClass()
		-- 원작 스타일: 레벨 배지(상단 중앙)와 직업 배지(좌측)를 분리 표시한다.
		-- (Phase 1) 표시 레벨은 장비 전투력 환산(GetDisplayLevel) 단일 진입점으로 통일 -
		-- 기존 "전투력 ÷ 10" 선형식과 CharLevel(죽은 값) 참조를 대체한다.
		local level = self:GetDisplayLevel()
		local e = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/LevelClassText")
		if isvalid(e) then
			e.TextComponent.Text = "Lv." .. tostring(level)
		end
		local c = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/ClassBadgeText")
		if isvalid(c) then
			local jobIdx = _UIMyInfoManager:GetSelectedCharacterJobIdx()
			c.TextComponent.Text = _UIMyInfoManager:GetClassNameForLevel(jobIdx, level)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateCharName()
		local name = self:GetCurrentCharName()
		local e = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/CharNameText")
		if isvalid(e) then
			e.TextComponent.Text = name
		end
	end

	@ExecSpace("ClientOnly")
	method string GetCurrentCharName()
		-- Read from CharacterSelectComponent which stores slot data
		local selectBg = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharacterSelectGroup/SelectBackground")
		if not isvalid(selectBg) then return "캐릭터" end
		local charSelectComp = selectBg:GetComponent(CharacterSelectComponent)
		if not isvalid(charSelectComp) then return "캐릭터" end
		local slot = charSelectComp.selectedSlot
		if slot < 1 or slot > charSelectComp:MaxSlot() then return "캐릭터" end
		local data = charSelectComp:GetSlotData(slot)
		if data == "" then return "캐릭터" end
		-- First pipe-delimited field is character name
		local name = string.match(data, "^([^|]+)")
		return name ~= nil and name or "캐릭터"
	end

	@ExecSpace("ClientOnly")
	method void UpdateAvatar()
		local avatarEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow/AvatarImage")
		if not isvalid(avatarEnt) then return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		local pc = player:GetComponent(CostumeManagerComponent)
		if not isvalid(pc) then return end
		local ac = avatarEnt:GetComponent(CostumeManagerComponent)
		if not isvalid(ac) then return end

		-- Copy player's current costume to the avatar display
		ac:SetEquip(MapleAvatarItemCategory.Body,  "3cf4cb29ae344577b9eed37e531688a4")
		ac:SetEquip(MapleAvatarItemCategory.Face,  pc:GetEquip(MapleAvatarItemCategory.Face))
		ac:SetEquip(MapleAvatarItemCategory.Hair,  pc:GetEquip(MapleAvatarItemCategory.Hair))
		ac:SetEquip(MapleAvatarItemCategory.Coat,  pc:GetEquip(MapleAvatarItemCategory.Coat))
		ac:SetEquip(MapleAvatarItemCategory.Pants, pc:GetEquip(MapleAvatarItemCategory.Pants))
		ac:SetEquip(MapleAvatarItemCategory.Shoes, pc:GetEquip(MapleAvatarItemCategory.Shoes))
		-- 모자도 플레이어와 똑같이 맞춘다 (넣지 않으면 계정 기본 아바타의 모자가 비쳐 보인다)
		ac:SetEquip(MapleAvatarItemCategory.Cap,   pc:GetEquip(MapleAvatarItemCategory.Cap))
		-- 두손무기/한손무기(후르츠 대거·나무 스태프·우드완드는 실제 리소스가 한손무기 카테고리)를 모두 확인
		local twoHandWeapon = pc:GetEquip(MapleAvatarItemCategory.TwoHandedWeapon)
		if twoHandWeapon ~= "" then
			ac:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, twoHandWeapon)
		end
		local oneHandWeapon = pc:GetEquip(MapleAvatarItemCategory.OneHandedWeapon)
		if oneHandWeapon ~= "" then
			ac:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, oneHandWeapon)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateStats()
		-- (Phase 1) 표시 레벨은 이제 장비 전투력 환산(GetDisplayLevel) 하나만 쓴다.
		-- _UIMyInfoManager.CharLevel은 서버 InitStats 이후 갱신되지 않는 죽은 값이라 참조 금지.
		local level = self:GetDisplayLevel()

		-- Read HP from local player
		local hp, maxHp = 0, 50
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local pc = player.PlayerComponent
			if isvalid(pc) then
				hp    = pc.Hp    or 0
				maxHp = pc.MaxHp or 50
			end
		end

		-- Accumulate bonuses from all equipped items (slots 1-25; 10~25는 잠금 칸이라 빈 문자열로 스킵됨)
		local flatSTR, flatDEX, flatINT, flatLUK = 0, 0, 0, 0
		local pctSTR,  pctDEX,  pctINT,  pctLUK  = 0, 0, 0, 0
		-- (요청 2026-08-12 3차) 아이템 유래 무기 성능은 **단일 값**이다 - 스타포스·무기 기본옵션·잠재
		-- 「공격력 +N」·「마력 +N」이 모두 여기 합산되고, **착용자 직업에 따라 공격력 또는 마력 중
		-- 한쪽으로만** 표시·적용된다(마법 직업 = 비숍/썬콜/불독은 마력, 그 외는 공격력).
		-- ⚠ 종전엔 스타포스·무기 기본을 양쪽에 넣어 "아이템 공격력이 오르면 공격력·마력이 동시에
		--   오르는" 문제가 있었다(신고).
		-- (신고 수정 2026-08-16) 「마력 +N」 잠재를 굴렸는데 스탯창의 **공격력**이 올랐다 - 위 사양대로
		-- 두 태그를 한 통에 합치고 직업으로 몰아줬기 때문이다. 이제 **옵션 태그 그대로** 나눈다:
		-- 「공격력」→ 공격력 줄, 「마력」→ 마력 줄. 무기 기본 성능(+30)과 스타포스 공격력은 원작처럼
		-- **양쪽에** 붙는 기존 사양을 유지한다(itemBothATK).
		local flatATK, pctATK   = 0, 0     -- 잠재 「공격력」 전용
		local flatMATK, pctMATK = 0, 0     -- 잠재 「마력」 전용
		local itemBothATK       = 0        -- 무기 기본 + 스타포스 (공격력·마력 양쪽)
		local dmgPct            = 0
		local defIgnoreAdd      = 0
		local critAdd           = 0
		local critDmgAdd        = 0
		local cdReduceAdd       = 0   -- (Phase 3) 스킬 쿨타임 감소 초 합산 (표시용)

		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end

			-- 무기 슬롯 기본옵션: 직업별 드롭박스 지급 무기는 공격력/마력 +30 고정 (잠재능력과 별개)
			if slot == 6 then
				local baseName = _UIEquipInventoryManager:ParseName(s)
				if _UIEquipInventoryManager:IsJobDropWeapon(baseName) then
					itemBothATK += 30
				end
			end

			-- Starforce bonus (field 4)
			local stars = self:ParseFieldNum(s, 4)
			if stars > 0 then
				local sf = self:CalcStarforceStats(stars)
				flatSTR += sf.str; flatDEX += sf.dex
				flatINT += sf.int; flatLUK += sf.luk
				itemBothATK += sf.atk
			end

			-- Potential options: fields 10-12 (pot1-3) and 14-16 (addpot1-3)
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				-- (Phase 3) 쿨타임 감소는 "+N"이 아니라 "-N초" 형식이라 아래 가드보다 먼저 처리한다
				if string.match(opt, "재사용 대기시간") then
					cdReduceAdd += tonumber(string.match(opt, "%-(%d+)초") or "0") or 0
					continue
				end
				local numStr = string.match(opt, "%+(%d+)")
				if numStr == nil then continue end
				local val  = tonumber(numStr) or 0
				local isPct = string.sub(opt, -1) == "%"

				if string.match(opt, "올스탯") then
					if isPct then
						pctSTR += val; pctDEX += val; pctINT += val; pctLUK += val
					else
						flatSTR += val; flatDEX += val; flatINT += val; flatLUK += val
					end
				elseif string.match(opt, "STR") then
					if isPct then pctSTR += val else flatSTR += val end
				elseif string.match(opt, "DEX") then
					if isPct then pctDEX += val else flatDEX += val end
				elseif string.match(opt, "INT") then
					if isPct then pctINT += val else flatINT += val end
				elseif string.match(opt, "LUK") then
					if isPct then pctLUK += val else flatLUK += val end
				elseif string.match(opt, "마력") then
					-- (신고 수정 2026-08-16) 「마력」은 **마력 줄에만** 오른다(종전엔 공격력 통에 합산돼
					-- 전사 캐릭터의 공격력이 올랐다). ⚠ "공격력" 검사보다 먼저 둘 것 - 두 태그는
					-- 서로의 부분 문자열이 아니지만, 순서를 지켜야 의도가 코드에서 바로 읽힌다.
					if isPct then pctMATK += val else flatMATK += val end
				elseif string.match(opt, "공격력") then
					-- 「공격력」은 공격력 줄에만 오른다.
					if isPct then pctATK += val else flatATK += val end
				elseif string.match(opt, "크리티컬 데미지") then
					-- (Phase 3 버그 수정) "크리티컬 데미지"는 "데미지"의 상위 문자열이라 데미지 분기보다
					-- **먼저** 검사해야 한다 - 기존 순서(데미지 먼저)에서는 크뎀 옵션이 데미지%로 오합산됐다.
					critDmgAdd += val
				elseif string.match(opt, "크리티컬") then
					critAdd += val
				elseif string.match(opt, "보스") then
					-- (요청 복원) 보스 몬스터 데미지(무기 전용 30/35/40%): 보스 판정이 없는 동안에는
					-- 상태창 데미지%에 그대로 합산해 유효 옵션으로 동작한다
					dmgPct += val
				elseif string.match(opt, "데미지") then
					dmgPct += val
				elseif string.match(opt, "방어율 무시") then
					defIgnoreAdd += val
				end
			end
		end

		-- Final stat values
		-- (요청 2026-08-12 4차) **아이템 몫과 공용 몫을 나눈다.**
		--   · 아이템(스타포스·무기 기본·잠재) → 직업이 쓰는 **한 줄에만**(마법=마력 / 그 외=공격력).
		--   · 물약·버프·스킬(무기 숙련·표창+·분노 등) → "공격력과 마력 둘 다 오른다"가 사양이므로 **양쪽에**.
		-- 전투력은 두 값 중 높은 쪽(=아이템이 실린 쪽)을 쓰므로 아래 표시 분배와 무관하게 정확하다.
		--   ⚠ 표창 계열(skillAttackBonus)은 **공격력 전용**이라 공용 몫에 넣지 않는다(요청 2026-08-12).
		-- (신고 수정 2026-08-16) 아이템 몫을 셋으로 나눈다:
		--   · itemBothATK  = 무기 기본(+30)·스타포스 → 원작처럼 공격력·마력 **양쪽**
		--   · flatATK/pctATK  = 잠재 「공격력」 → 공격력 줄만
		--   · flatMATK/pctMATK = 잠재 「마력」  → 마력 줄만
		-- 종전엔 셋을 한 통에 합쳐 직업으로 몰아줘서, 전사가 「마력」 잠재를 굴리면 공격력이 올랐다.
		local itemFlatATK = flatATK
		-- (신고 수정 2026-08-13) 블레스·메디테이션은 buffAttackBonus가 아니라 실효 통
		-- (realBuffAttackBonus)에 있으므로 표시 줄에도 여기서 함께 더한다 - 안 더하면 스탯창
		-- 공격력/마력 줄에서만 그 버프들이 사라진다.
		local commonFlatATK = self.potionAttackBonus + self.buffAttackBonus + self.commonAttackBonus
			+ self.realBuffAttackBonus
		local atkOnlyFlat = self.skillAttackBonus
		-- (블레스 개편 2026-08-08) 4스탯 버프 보너스. 공마(buffAttackBonus)와 달리 STR/DEX/INT/LUK에
		-- 똑같이 얹히는 값이라 별도 프로퍼티로 둔다. 실효 통 몫(realBuffStatBonus)도 같은 자리에 더한다.
		local statBuffAll = self.buffStatBonus + self.realBuffStatBonus
		flatSTR += statBuffAll; flatDEX += statBuffAll
		flatINT += statBuffAll; flatLUK += statBuffAll
		local baseVal  = 4 + level * 5
		local strFinal = math.floor((baseVal + flatSTR) * (1 + pctSTR / 100))
		local dexFinal = math.floor((baseVal + flatDEX) * (1 + pctDEX / 100))
		local intFinal = math.floor((baseVal + flatINT) * (1 + pctINT / 100))
		local lukFinal = math.floor((baseVal + flatLUK) * (1 + pctLUK / 100))

		-- (요청 2026-08-12 4차) 아이템 몫은 직업이 쓰는 줄에만, 공용 몫(물약·버프·스킬)은 양쪽에.
		--   예) 히어로가 무기 숙련 50pt → 공격력·마력 두 줄 모두 +50, 아이템 성능은 공격력 줄에만.
		-- 표창 계열(atkOnlyFlat)은 공격력 줄에만 더한다 - 표창은 마력을 올리지 않는다(요청).
		-- (신고 수정 2026-08-16) 아이템 몫은 **직업이 쓰는 줄에만** 들어간다.
		--   공격력 줄 = 공용(물약·버프) + 표창 + [비마법이면 무기기본/스타포스] + 잠재「공격력」
		--   마력  줄 = 공용(물약·버프)        + [마법이면   무기기본/스타포스] + 잠재「마력」
		-- ⚠ 무기 기본(+30)·스타포스를 **양쪽에** 넣으면 "히어로인데 마력이 높게 잡힌다"가 된다
		--   (신고 2026-08-16 2차 - 08-12에도 같은 이유로 한 번 고쳤던 자리다. 다시 넣지 말 것).
		-- 잠재 「공격력」/「마력」은 직업과 무관하게 **각자의 줄**에 보여준다 - 안 쓰는 옵션이라도
		-- 무엇이 붙어 있는지는 스탯창에서 보이는 편이 정직하다(전투력에는 직업이 쓰는 쪽만 실린다).
		local atkFlat  = commonFlatATK + atkOnlyFlat + itemFlatATK
		local matkFlat = commonFlatATK + flatMATK
		if self:IsMagicJob() then
			matkFlat += itemBothATK
		else
			atkFlat += itemBothATK
		end
		local statATK      = (1 + atkFlat) * (1 + pctATK / 100)
		local statMATK     = (1 + matkFlat) * (1 + pctMATK / 100)

		-- (버그 수정) "전투력에 직접 곱하면 안 되고, 데미지% 스탯이 콤보당 20%씩 합산으로 올라야
		-- 한다 - 그러면 전투력은 그 데미지%를 반영하는 기존 공식에서 자동으로 계산된다"는 피드백.
		-- 콤보 어택 버프의 구슬 1개당 +20% 보너스(PlayerAttack.ApplyComboAttackBonus와 동일 수치)를
		-- 장비 데미지%(dmgPct)와 똑같이 totalDmgPct에 가산한다 - 별도 배율을 곱하지 않는다.
		-- (요청 2026-08-15) 구슬당 수치를 여기서 또 쓰지 않고 **단일 출처**(GetComboFinalDamagePct)를
		-- 부른다 - 드래곤 버프의 절반 페널티(구슬당 1%)가 스탯창 표시와 전투력 배율 양쪽에 같이 걸린다.
		-- 종전엔 `2 * ComboOrbCount`가 여기 복제돼 있어 한쪽만 고치면 표시와 실데미지가 어긋났다.
		local comboDmgPct = self:GetComboFinalDamagePct()
		local totalDmgPct = dmgPct + comboDmgPct
		-- (Phase 4) 기본 크리티컬 확률 50% → 10% (GDD §4.7) - 크확은 주로 잠재 옵션으로 쌓는 성장 축
		-- (발도술) 처치 중첩 버프의 크확 보너스(+3%×중첩)를 스탯창에도 반영한다(CalcCritRate와 동일 가산).
		-- (표창+ 개편) 고른 표창의 크확(5~9번 10~30%)도 함께 표시한다.
		-- (샤프 아이즈) 버프 지속 중 크확 보너스(+1%p×분배)도 함께 반영한다(CalcCritRate와 동일 가산).
		local critRate     = 10 + critAdd + self.battoCritBonus + self.shurikenCritBonus + self.sharpEyesCritBonus
		-- 크리티컬 데미지: 기본 125%(크리티컬 적중 시 데미지 100% -> 125%로 상승) + 장비 잠재능력의
		-- "크리티컬 데미지 +N%" 옵션 합산. PlayerAttack.SyncCritDamage로 서버에 동기화되어 실제
		-- 전투 데미지 계산(크리티컬 배율)에 그대로 반영된다.
		-- (샤프 아이즈) 버프 지속 중 +8%p(전 구간 공통)도 함께 반영한다(CalcCritDamage와 동일 가산).
		local critDamage   = 125 + critDmgAdd + self.sharpEyesCritDmgBonus

		-- (요청 2026-08-12) 방어율 무시 표시는 삭제됐다(.ui 라벨/값 엔티티 제거) - 파서(defIgnoreAdd)는
		-- 기존 저장 옵션 호환을 위해 남겨둔다.
		-- (전투력 개편 2026-08-08 + 추가 전투력 2026-08-12) 표시 전투력 = CalcCombatPower() -
		-- 장비 총합² × (1 + 추가 전투력%/100). 추가 전투력 = 잠재 데미지/보스뎀(장비) + 분노(버프).
		-- 버프가 켜지면 이 표시 전투력이 그대로 올라간다(레벨은 CalcEquipCombatPower 기준이라 불변).
		-- 스탯창 **"최종 데미지"** 줄(요청 2026-08-12로 "추가 전투력"에서 개명) = 실제 데미지에 곱해지는
		-- 총 배율. 적용 경로가 둘로 나뉘어 있다:
		--   · 장비(잠재 데미지/보스뎀) + 분노 → **전투력에 직접 곱해**진다(아래 combat).
		--   · 콤보 어택 구슬 → 서버가 최종 데미지에 곱한다(PlayerAttack.ApplyComboAttackBonus).
		-- 표시는 둘을 합쳐 보여주되(사용자가 체감하는 값은 합계다), **전투력 배율에는 콤보를 넣지 않는다**
		-- - 넣으면 시전 전투력에 이미 콤보가 실린 채 서버가 또 곱해 이중 적용된다.
		-- ⚠ (버그 수정 2026-08-12) 여기서 `CalcCombatPower()`를 부르면 그 안에서 CollectBonusCombatPowerPct가
		--   또 25슬롯을 훑어 **한 프레임에 25슬롯 스캔이 4회**(GetDisplayLevel + Unified + Collect×2)가 된다.
		--   실측: 그 지점에서 UpdateStats가 조용히 중단돼 이후 코드(sv 표시)와 **호출자의 남은 코드까지
		--   통째로 죽었다**(분노 UseRage가 UpdateStats 뒤의 `_RageBuffUI:ShowBuff()`에 도달 못 해 버프
		--   아이콘이 아예 안 뜨던 신고의 진짜 원인). bonusCpPct를 먼저 구해 놓고 배율만 직접 곱한다.
		-- (요청 2026-08-12 3차) **표시 전투력은 버프를 포함한다.** 레벨 산정(CalcEquipCombatPower)만
		-- 아이템 전용이고, 이 줄은 사용자가 체감하는 "지금 내 전투력"이라 버프가 빠지면 분노는 오르는데
		-- 발도술 공속·콤보 구슬은 안 오르는 불일치가 생긴다(신고).
		--   · 최종 데미지%(장비 + 분노 + **콤보 구슬**) → 배율로 곱한다.
		--   · 버프 공격력/공속/크리티컬 → cpIncludeBuffs 플래그로 전투력 공식 안에서 직접 반영한다.
		local bonusCpPct = self:CollectBonusCombatPowerPct(0, "") + self:GetBuffBonusCombatPowerPct()
			+ self:GetComboFinalDamagePct()
		self._T.cpIncludeBuffs = true
		local combat = self:CalcCombatPowerUnified(0, "")
		self._T.cpIncludeBuffs = false
		if bonusCpPct ~= 0 then
			combat = math.floor(combat * (1 + bonusCpPct / 100))
		end
		-- (요청 2026-08-14 10차) 이 줄은 CalcCombatPowerSwap을 성능 때문에 손으로 펼쳐 쓴 것이라
		-- 최종 1/100 축소도 직접 걸어줘야 한다 - 안 걸면 스탯창 숫자만 100배로 남는다.
		combat = self:ScaleFinalCombatPower(combat)

		-- Update stat value text entities
		local base = "/ui/DefaultGroup/CharInfoWindow/DetailPanel/"
		local function sv(name, text)
			local e = _EntityService:GetEntityByPath(base .. "StatVal_" .. name)
			if isvalid(e) then e.TextComponent.Text = text end
		end

		sv("Combat",    tostring(math.floor(combat)))
		sv("StatATK",   string.format("%.1f", statATK))
		-- (요청 2026-08-12) "최종 데미지" 줄 - 장비/분노(전투력 경유) + 콤보 구슬(서버 경유) 합계.
		-- 장비 몫은 25슬롯 스캔이라 여기서 구한 값을 필드에 캐시해 두고, 전투 중 수시로 바뀌는 콤보 몫은
		-- 경량 경로(RefreshFinalDamageRow)가 이 캐시를 재사용해 그 한 줄만 갱신한다.
		self.equipBuffFinalDmgPct = bonusCpPct
		sv("TotalDmg",  "+" .. tostring(bonusCpPct + self:GetComboFinalDamagePct()) .. "%")
		-- (요청 2026-08-12 2차) 마력은 공격력과 **별개 수치**다 - 마력 태그 옵션만 반영된다.
		-- 마법 직업(주스탯 INT)은 이 값이 데미지·전투력의 근거가 되고, 그 외 직업은 공격력을 쓴다.
		sv("MagicATK",  string.format("%.1f", statMATK))
		sv("HP",        tostring(hp) .. " / " .. tostring(maxHp))
		-- (2026-08-08) MP가 실제 자원이 되면서 고정 "0 / 0" 표시를 MpManager 값으로 교체.
		sv("MP",        tostring(_MpManager:GetCurrentMp()) .. " / " .. tostring(_MpManager:GetMaxMp()))
		sv("STR",       tostring(strFinal))
		sv("DEX",       tostring(dexFinal))
		sv("INT",       tostring(intFinal))
		sv("LUK",       tostring(lukFinal))
		sv("CritRate",  tostring(critRate) .. "%")
		sv("CritDmg",   tostring(critDamage) .. "%")
		sv("CDReduce",  tostring(cdReduceAdd) .. "초")
		sv("CDImmune",  "0%")
		-- (전투력 개편) 공격속도는 단계 대신 퍼센트로 표기 (기본 4단계 = 100%, 1단계당 +10%p)
		sv("AtkSpeed",  tostring(self:GetAttackSpeedPercent()) .. "%")
		-- (요청 2026-08-12) 초보자 패시브 "아이템 감각"이 **드롭률과 메소 획득량을 함께** 올린다
		-- (요청 2026-08-15: 분배당 +0.5%, 마스터 200 = +100%). 종전엔 두 줄 모두 "0%" 하드코딩이었다.
		-- ⚠ 0.5 단위라 tostring을 그대로 쓰면 "+12.5%"가 "+12.5%"로는 나와도 정수 구간에서 "+13.0%"처럼
		--   보이는 표기 흔들림이 생긴다 - 소수 첫째 자리로 고정한다.
		local itemSensePct = _SkillManager:GetBeginnerDropRatePct()
		sv("Meso",      "+" .. string.format("%.1f", itemSensePct) .. "%")
		sv("Drop",      "+" .. string.format("%.1f", itemSensePct) .. "%")
		-- (요청 2026-08-12) "추가 경험치 획득" 줄은 삭제됐다(.ui Label/StatVal_ExpBonus 엔티티 제거).
	end

	-- (요청) 무기 특성에 의한 공격속도 보너스 단계. **한손검**은 가볍고 빠른 무기라 장착 중 +2단계.
	-- atkSpeedStage를 직접 바꾸지 않고(비약/부스터의 증감·저장과 얽히지 않도록) 조회 시점에 동적으로 더한다 -
	-- 무기를 바꿔 끼면 자동으로 사라진다.
	-- ⚠ (버그 수정 2026-08-08) 예전엔 `GetWeaponMotionClass() == "onehand"`로 판정했는데, 그건 **모션**
	--   분류라 우드완드(비숍)/나무 스태프(아크메이지)/후르츠 대거(섀도어)도 onehand다 - 비숍이 지급받는
	--   완드만 껴도 공속이 2단계 올랐다(신고). 보너스는 **팔라딘의 한손검(카알대검)만** 받아야 하므로
	--   무기 이름 기반 전용 판정(IsOneHandedSwordEquipped)으로 갈랐다. 모션 분류는 그대로 둔다.
	@ExecSpace("ClientOnly")
	method integer GetWeaponAttackSpeedBonus()
		if _SkillManager:IsOneHandedSwordEquipped() then
			return 2
		end
		return 0
	end

	-- 공격속도 단계 반환 (기본 4단계 + 무기 보너스)
	@ExecSpace("ClientOnly")
	method integer GetAttackSpeedStage()
		-- (표창+ 개편) 고른 표창의 공속 단계(8·9번 +1)도 함께 얹는다.
		return self.atkSpeedStage + self:GetWeaponAttackSpeedBonus() + self.shurikenAtkSpeedStage
	end

	-- (전투력 개편 2026-08-08) 사용자 표기용 공격속도 퍼센트. 기본 4단계 = 100%, 1단계당 +10%p.
	-- 무기 잠재의 "공격속도 +N%" 옵션(무기 전용 특수 옵션)도 여기 합산된다 - 표기와 실속도가 같은 값을 쓴다.
	@ExecSpace("ClientOnly")
	method number GetAttackSpeedPercent()
		local extras = self:CollectPotentialExtras()
		-- (발도술 개편 2026-08-12) 중첩당 +3%는 단계가 아니라 퍼센트 항에 직접 얹힌다.
		-- (초보자 패시브 2026-08-12) "민첩 훈련" 5포인트당 +1%도 같은 자리에 더한다.
		return math.floor(100 + (self:GetAttackSpeedStage() - 4) * 10 + extras.atkSpdPct
			+ self.battoStackAtkSpdPct + self.beginnerAtkSpdPct)
	end

	-- (전투력 개편 2026-08-08) 스탯 합산 루프(UpdateStats 계열)가 다루지 않는 특수 잠재 옵션 수집기.
	-- 최대 HP/MP(플랫·% - 실수치 반영 사양)와 무기 전용 "공격속도 +N%"를 장착 장비 전체에서 합산한다.
	-- 호출부: HP → UIMyInfoManager.UpdateBars / MP → MpManager.GetMaxMp / 공속% → GetAttackSpeedPercent.
	@ExecSpace("ClientOnly")
	method table CollectPotentialExtras()
		local hpFlat, hpPct, mpFlat, mpPct, atkSpdPct = 0, 0, 0, 0, 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				local numStr = string.match(opt, "%+(%d+)")
				if numStr == nil then continue end
				local val = tonumber(numStr) or 0
				local isPct = string.sub(opt, -1) == "%"
				if string.match(opt, "최대 HP") then
					if isPct then hpPct += val else hpFlat += val end
				elseif string.match(opt, "최대 MP") then
					if isPct then mpPct += val else mpFlat += val end
				elseif string.match(opt, "공격속도") then
					if isPct then atkSpdPct += val end
				end
			end
		end
		return {hpFlat = hpFlat, hpPct = hpPct, mpFlat = mpFlat, mpPct = mpPct, atkSpdPct = atkSpdPct}
	end

	-- (전투력 개편) 직업 → 주스탯 이름. 전사(히어로/팔라딘/다크나이트)=STR, 마법사(비숍/썬콜/불독)=INT,
	-- 궁수(신궁/보우마스터)=DEX, 도적(나이트로드/섀도어)=LUK. jobIdx 순서는 UIMyInfoManager.GetJobStageNames 기준.
	@ExecSpace("ClientOnly")
	method string GetMainStatName()
		local jobIdx = _UIMyInfoManager:GetSelectedCharacterJobIdx()
		if jobIdx >= 1 and jobIdx <= 3 then return "STR" end
		if jobIdx >= 4 and jobIdx <= 6 then return "INT" end
		if jobIdx == 7 or jobIdx == 8 then return "DEX" end
		if jobIdx == 9 or jobIdx == 10 then return "LUK" end
		return "STR"
	end

	-- (요청 2026-08-12) 마법 직업 판정 - 주스탯이 INT인 직업(비숍/썬콜/불독)이 곧 마력 사용 직업이다.
	-- 전투력 공식(CalcCombatPowerBase)이 공격력/마력 중 무엇을 쓸지 이 한 곳에서 가른다.
	@ExecSpace("ClientOnly")
	method boolean IsMagicJob()
		return self:GetMainStatName() == "INT"
	end

	-- 공격속도 → 시간 배율. "공격속도 100%"=1.0, 110%면 시간이 100/110로 줄어든다(=10% 빨라짐).
	-- 모션 재생시간/공격 딜레이/타이밍 등 "시간" 값에 그대로 곱해서 사용한다 (배율이 작을수록 더 빠름).
	-- (전투력 개편) 기존 0.9^(단계-5) 복리식을 퍼센트 선형식으로 교체 - 표기("+10%")와 실속도가 일치한다.
	@ExecSpace("ClientOnly")
	method number GetAttackSpeedMultiplier()
		local pct = self:GetAttackSpeedPercent()
		if pct < 10 then pct = 10 end
		return 100 / pct
	end

	-- "공격 속도의 비약" 사용 시 호출 - 공격속도 1단계(+10%) 증가
	@ExecSpace("ClientOnly")
	method void IncreaseAttackSpeedStage()
		self.atkSpeedStage = self.atkSpeedStage + 1
		log("[CharInfo] 공격속도 증가: " .. tostring(self:GetAttackSpeedPercent()) .. "%")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end
	end

	-- "부스터" 스킬 사용 시 호출 - 공격속도를 지속시간 동안 상승시킨다(재사용 시 중첩되지 않고 지속시간만 갱신 -
	-- 토큰 비교로 먼저 걸린 타이머의 원복을 무시). 이 스탯은 서버에 대응 데이터가 없는 클라이언트 전용 값이라
	-- (atkSpeedStage 자체가 그러하듯) 이 클라이언트에서 즉시 적용한다.
	-- (전투력 개편) 사용자 표기는 단계 대신 퍼센트 - 1단계 = "+10%", 2단계 = "+20%".
	@ExecSpace("ClientOnly")
	method void UseBooster(number duration, integer stages)
		-- (스킬 효과 개편) 지속시간·공속 단계를 스킬 투자 레벨 기반으로 호출부(SkillManager)가 넘긴다.
		-- 재시전으로 단계가 달라질 수 있으므로(9→10레벨 분배 직후), 이전 적용 단계를 정확히 되돌리고 새로 건다.
		if self._T.boosterActive then
			self.atkSpeedStage = self.atkSpeedStage - (self._T.boosterStages or 1)
		end
		self.atkSpeedStage = self.atkSpeedStage + stages
		self._T.boosterStages = stages
		self._T.boosterActive = true
		log("[CharInfo] 부스터 발동 - 공격속도 +" .. tostring(stages * 10) .. "%: " .. tostring(self:GetAttackSpeedPercent()) .. "% (" .. tostring(duration) .. "초)")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end

		self._T.boosterToken = (self._T.boosterToken or 0) + 1
		local myToken = self._T.boosterToken

		_TimerService:SetTimerOnce(function()
			if self._T.boosterToken ~= myToken then return end
			self.atkSpeedStage = self.atkSpeedStage - (self._T.boosterStages or 1)
			self._T.boosterActive = false
			log("[CharInfo] 부스터 종료 - 공격속도 원복: " .. tostring(self:GetAttackSpeedPercent()) .. "%")
			local cw2 = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw2) and cw2.Enable then
				self:UpdateStats()
			end
		end, duration)

		_BoosterBuffUI:ShowBuff(duration)
	end

	-- (버프 아이콘 우클릭 취소) 부스터를 즉시 종료한다 - 자연 만료(UseBooster의 타이머 본문)와
	-- 동일한 정리를 지금 수행하고, 토큰을 올려 예약된 만료 타이머를 무효화한다.
	@ExecSpace("ClientOnly")
	method void CancelBooster()
		if not self._T.boosterActive then return end
		self._T.boosterToken = (self._T.boosterToken or 0) + 1
		self.atkSpeedStage = self.atkSpeedStage - (self._T.boosterStages or 1)
		self._T.boosterActive = false
		log("[CharInfo] 부스터 취소(우클릭) - 공격속도 원복: " .. tostring(self:GetAttackSpeedPercent()) .. "%")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end
	end

	-- 발도술(히어로 3차) 기본 사용 효과: 버프 지속시간 동안 공속 +1단계. 부스터와 동일한 토큰 패턴이되
	-- 별도 필드(battoProc*)라 부스터/비약과 겹쳐 적용된다. 재시전 시 이전 적용을 되돌리고 새로 건다.
	-- (효과 개편) 예전엔 처치 중첩 프록이 이 메서드로 공속을 올렸지만, 지금은 시전 시점(SkillManager
	-- 디스패치)이 지속시간 전체로 1단계를 거는 용도다. 중첩 프록은 UseBattoStackBuff(공격력/크확) 참고.
	@ExecSpace("ClientOnly")
	method void UseBattoAtkSpeed(number remain, integer stages)
		if self._T.battoProcActive then
			self.atkSpeedStage = self.atkSpeedStage - (self._T.battoProcStages or 1)
		end
		self.atkSpeedStage = self.atkSpeedStage + stages
		self._T.battoProcStages = stages
		self._T.battoProcActive = true
		log("[CharInfo] 발도술 프록 - 공격속도 +" .. tostring(stages * 10) .. "% (" .. string.format("%.1f", remain) .. "초): " .. tostring(self:GetAttackSpeedPercent()) .. "%")
		local cwBT = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBT) and cwBT.Enable then
			self:UpdateStats()
		end
		self._T.battoProcToken = (self._T.battoProcToken or 0) + 1
		local myToken = self._T.battoProcToken
		_TimerService:SetTimerOnce(function()
			if self._T.battoProcToken ~= myToken then return end
			self:CancelBattoAtkSpeed()
		end, remain)
	end

	-- 발도술 프록 공속 원복(만료/취소 공용). 서버 종료 통보(NotifyBattoProcEnd)와 클라 자체 만료
	-- 타이머 어느 쪽이 먼저 와도 한 번만 되돌린다.
	@ExecSpace("ClientOnly")
	method void CancelBattoAtkSpeed()
		if not self._T.battoProcActive then return end
		self._T.battoProcToken = (self._T.battoProcToken or 0) + 1
		self.atkSpeedStage = self.atkSpeedStage - (self._T.battoProcStages or 1)
		self._T.battoProcActive = false
		log("[CharInfo] 발도술 프록 종료 - 공격속도 원복: " .. tostring(self:GetAttackSpeedPercent()) .. "%")
		local cwBT = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBT) and cwBT.Enable then
			self:UpdateStats()
		end
	end

	-- 각성(나이트로드 4차): 지속시간 동안 공속을 구간별로 크게 올린다(1~9분배 5단계 / 10~19 10단계 /
	-- 20분배 이상 15단계). 부스터/발도술과 같은 토큰 패턴이되 별도 필드(awakeningProc*)라 서로 겹쳐
	-- 적용된다. 재시전 시 이전 적용을 정확히 되돌리고 새로 건다.
	-- ⚠ 공속은 서버에 대응 데이터가 없는 **클라 전용 상태**다(부스터와 같은 이유) - 스킬 시전 때
	--   GetAttackSpeedMultiplier로 계산한 배율이 RPC 인자로 서버에 전달된다.
	@ExecSpace("ClientOnly")
	method void UseAwakeningAtkSpeed(number remain, integer stages)
		if self._T.awakeningProcActive then
			self.atkSpeedStage = self.atkSpeedStage - (self._T.awakeningProcStages or 0)
		end
		self.atkSpeedStage = self.atkSpeedStage + stages
		self._T.awakeningProcStages = stages
		self._T.awakeningProcActive = true
		log("[CharInfo] 각성 - 공격속도 +" .. tostring(stages * 10) .. "% (" .. string.format("%.1f", remain) .. "초): " .. tostring(self:GetAttackSpeedPercent()) .. "%")
		local cwAW = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwAW) and cwAW.Enable then
			self:UpdateStats()
		end
		self._T.awakeningProcToken = (self._T.awakeningProcToken or 0) + 1
		local myToken = self._T.awakeningProcToken
		_TimerService:SetTimerOnce(function()
			if self._T.awakeningProcToken ~= myToken then return end
			self:CancelAwakeningAtkSpeed()
		end, remain)
	end

	-- 각성 공속 원복(만료/취소/서버 종료 통보 공용). 어느 쪽이 먼저 와도 한 번만 되돌린다.
	@ExecSpace("ClientOnly")
	method void CancelAwakeningAtkSpeed()
		if not self._T.awakeningProcActive then return end
		self._T.awakeningProcToken = (self._T.awakeningProcToken or 0) + 1
		self.atkSpeedStage = self.atkSpeedStage - (self._T.awakeningProcStages or 0)
		self._T.awakeningProcActive = false
		log("[CharInfo] 각성 종료 - 공격속도 원복: " .. tostring(self:GetAttackSpeedPercent()) .. "%")
		local cwAW = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwAW) and cwAW.Enable then
			self:UpdateStats()
		end
	end

	-- 발도술 처치 중첩 프록(효과 개편): 중첩당 공격력 +10(buffAttackBonus 합산 경로 - 분노/메디와 겹침)과
	-- 크리티컬 확률 +3%(battoCritBonus)를 remain초 동안 적용한다. 중첩이 바뀌면 이전 적용을 정확히
	-- 되돌리고 새 수치를 다시 건다. 서버(PlayerAttack.AddBattoStack)가 중첩/남은 시간을 계산해 넘긴다.
	-- 스킬은 시전 때마다 전투력/크확을 새로 넘기지만, 엔진이 서버에서 직접 띄우는 기본공격은 동기화 값만
	-- 보므로 다크사이트와 같은 즉시 재동기화(SyncDarkSightStats - 이름과 달리 범용 스탯 재동기화)를 태운다.
	@ExecSpace("ClientOnly")
	method void UseBattoStackBuff(number remain, integer stacks)
		-- (요청 2026-08-12) 중첩당 **공격력 +10 → 공격속도 +3%**. 공속은 단계(10%)가 아니라 퍼센트로
		-- 직접 얹어야 3%가 표현되므로, 잠재 "공격속도 +N%"와 같은 자리(GetAttackSpeedPercent의 퍼센트 항)에
		-- 더하는 전용 필드를 쓴다 - 부스터/비약의 단계 증감과 겹쳐도 서로 간섭하지 않는다.
		if self._T.battoStackActive then
			self.battoStackAtkSpdPct = self.battoStackAtkSpdPct - (self._T.battoStackSpd or 0)
			self.battoCritBonus = self.battoCritBonus - (self._T.battoStackCrit or 0)
		end
		local spdBonus = 3 * stacks
		local critBonus = 3 * stacks
		self.battoStackAtkSpdPct = self.battoStackAtkSpdPct + spdBonus
		self.battoCritBonus = self.battoCritBonus + critBonus
		self._T.battoStackSpd = spdBonus
		self._T.battoStackCrit = critBonus
		self._T.battoStackActive = true
		log("[CharInfo] 발도술 중첩 프록 - 공격속도 +" .. tostring(spdBonus) .. "% 크확 +" .. tostring(critBonus) .. "% (" .. string.format("%.1f", remain) .. "초)")
		local cwBS = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBS) and cwBS.Enable then
			self:UpdateStats()
		end
		_SkillManager:SyncDarkSightStats()
		self._T.battoStackToken = (self._T.battoStackToken or 0) + 1
		local myToken = self._T.battoStackToken
		_TimerService:SetTimerOnce(function()
			if self._T.battoStackToken ~= myToken then return end
			self:CancelBattoStackBuff()
		end, remain)
	end

	-- 발도술 중첩 프록 원복(만료/취소 공용). 서버 종료 통보와 클라 자체 만료 타이머 어느 쪽이 먼저 와도
	-- 한 번만 되돌리고, 기본공격용 서버 동기화 값도 즉시 갱신한다.
	@ExecSpace("ClientOnly")
	method void CancelBattoStackBuff()
		if not self._T.battoStackActive then return end
		self._T.battoStackToken = (self._T.battoStackToken or 0) + 1
		self.battoStackAtkSpdPct = self.battoStackAtkSpdPct - (self._T.battoStackSpd or 0)
		self.battoCritBonus = self.battoCritBonus - (self._T.battoStackCrit or 0)
		self._T.battoStackActive = false
		log("[CharInfo] 발도술 중첩 프록 종료 - 공격속도/크확 원복 (battoStackAtkSpdPct=" .. tostring(self.battoStackAtkSpdPct) .. " battoCritBonus=" .. tostring(self.battoCritBonus) .. ")")
		local cwBS = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwBS) and cwBS.Enable then
			self:UpdateStats()
		end
		_SkillManager:SyncDarkSightStats()
	end

	-- 브랜디쉬 강화(4차 버프): 5분간 ①브랜디쉬 데미지 1.5배 ②브랜디쉬 공속 +1단계 ③브랜디쉬 이펙트/아이콘
	-- 붉은/핑크색. 부스터와 동일한 토큰 패턴(중첩 없이 지속시간만 갱신). 브랜디쉬 전용이라 전역 atkSpeedStage를
	-- 건드리지 않고 별도 플래그로만 관리한다 - SkillManager가 브랜디쉬 시전 시 IsBrandishEnhanceActive를 읽어
	-- 데미지(전투력×1.5)/공속(배율×0.9=+1단계)/이펙트색을 적용한다. 서버엔 대응 데이터가 없는 클라 전용 값이다.
	@ExecSpace("ClientOnly")
	method void UseBrandishEnhance()
		if not self._T.brandishEnhanceActive then
			self._T.brandishEnhanceActive = true
			log("[CharInfo] 브랜디쉬 강화 발동 - 데미지 1.5배 / 공속 +1단계 / 붉은 이펙트 (5분)")
		end
		self._T.brandishEnhanceToken = (self._T.brandishEnhanceToken or 0) + 1
		local myToken = self._T.brandishEnhanceToken
		local duration = 300
		_TimerService:SetTimerOnce(function()
			if self._T.brandishEnhanceToken ~= myToken then return end
			self._T.brandishEnhanceActive = false
			log("[CharInfo] 브랜디쉬 강화 종료")
		end, duration)
		-- (2단계 예정) 버프바 표시: _BrandishEnhanceBuffUI:ShowBuff(duration) - 전용 버프 슬롯 UI 제작 후 연결.
	end

	-- SkillManager가 브랜디쉬/브랜디쉬2 시전 시 참조한다(클라 전용 상태).
	method boolean IsBrandishEnhanceActive()
		return self._T.brandishEnhanceActive == true
	end

	-- 어드밴스드 스피어 버스터(4차, 2026-08-05 스펙 개편): **연출 전용 토글**이다.
	-- 데미지 보너스(분배당 스피어 버스터 줄당 최소 +5%p / 최대 +10%p)는 투자 레벨만으로 항상 적용되고
	-- (SkillManager.GetAdvSpearBurstMin/MaxBonus), 이 값은 새로 그린 전용 아트(용머리/마법진/날개/
	-- 찌르기3종)를 쓸지 여부만 결정한다. OFF면 안 배운 것처럼 원래 스피어 버스터 이펙트로 나간다.
	-- (구 사양의 "보유 시 데미지 1.5배"는 폐지 - 레벨 스케일과 이중 성장이었다.)
	property boolean advancedSpearBusterEffectOn = true
	method boolean IsAdvancedSpearBusterEffectOn()
		return self.advancedSpearBusterEffectOn == true
	end

	-- (요청) 어드밴스드 스피어 버스터를 퀵슬롯에서 쓰면 강화 이펙트를 켜고 끈다. 토글 후 새 상태(true=ON)를 돌려준다.
	-- 클라 전용 상태(SkillManager가 시전 시 이 값을 읽어 enhanced 플래그만 서버로 넘긴다 - 데미지는 무관).
	@ExecSpace("ClientOnly")
	method boolean ToggleAdvancedSpearBusterEffect()
		self.advancedSpearBusterEffectOn = not (self.advancedSpearBusterEffectOn == true)
		log("[CharInfoManager] 어드밴스드 스피어 버스터 강화 이펙트 " .. (self.advancedSpearBusterEffectOn and "ON" or "OFF"))
		return self.advancedSpearBusterEffectOn
	end

	-- ⚠ (요청 2026-08-06) "에로우 블로우 강화"는 ON/OFF 토글 → **패시브**가 되어 이 클라 상태가
	--   폐지됐다. 폭발 여부는 이제 SkillManager가 시전 시점에 투자 레벨(≥1)로 직접 판정한다.
	--   토글 상태 프로퍼티/메서드(arrowBlowEnhanceOn / IsArrowBlowEnhanceActive /
	--   ToggleArrowBlowEnhance)는 참조가 남지 않아 제거했다.

	-- 암행(나이트로드 2차): 상시 패시브 → ON/OFF 토글 → (요청 2026-08-05) **지속시간이 있는 버프**로
	-- 바뀌었다. 켜져 있는 동안만 온히트 그림자 표창이 발동한다.
	-- ⚠ 지속시간 관리(타이머·버프바 표시·서버 통보)는 전부 SkillManager가 한다 - 여기는 "지금 켜져
	--   있는가" 하나만 들고 있는다(발동 판정은 서버 PlayerAttack, 스위치는 RequestSetAmhaengState).
	property boolean amhaengOn = false
	method boolean IsAmhaengActive()
		return self.amhaengOn == true
	end

	@ExecSpace("ClientOnly")
	method void SetAmhaengActive(boolean on)
		-- 암행 활성 상태를 그대로 지정한다(시전 시 true / 만료·취소 시 false).
		self.amhaengOn = (on == true)
		log("[CharInfoManager] 암행 " .. (self.amhaengOn and "ON" or "OFF"))
	end

	-- 암행2(3차): 암행1과 같은 확률로 **독립적으로** 굴려, 몬스터 뒤쪽에 그림자를 소환해
	-- 더블스탭 또는 새비지블로우를 쓰게 한다.
	-- (요청 2026-08-06) ON/OFF 토글 → 암행1과 **완전히 같은 지속시간 버프**로 전환했다.
	-- ⚠ 지속시간 관리(타이머·버프바 표시·서버 통보)는 전부 SkillManager가 한다 - 여기는 "지금 켜져
	--   있는가" 하나만 들고 있는다(암행1과 동일한 구조).
	property boolean amhaeng2On = false
	method boolean IsAmhaeng2Active()
		return self.amhaeng2On == true
	end

	@ExecSpace("ClientOnly")
	method void SetAmhaeng2Active(boolean on)
		-- 암행2 활성 상태를 그대로 지정한다(시전 시 true / 만료·취소 시 false).
		self.amhaeng2On = (on == true)
		log("[CharInfoManager] 암행2 " .. (self.amhaeng2On and "ON" or "OFF"))
	end

	-- 백스탭(2차): 몬스터가 바라보는 방향의 뒤쪽에서 때리면 추가 데미지를 주는 스킬.
	-- (요청 2026-08-06) 테스트용 ON/OFF 토글 → **패시브**로 전환했다. 이제 배우기만 하면(투자 1 이상)
	-- 항상 발동하고, 퀵슬롯에도 올릴 수 없다(SkillManager.IsPassiveSkillName).
	-- ⚠ 발동 여부 판정은 이 메서드 한 곳에만 둔다 - 서버 스위치(RequestSetBackstabState)의 on 인자는
	--   전부 "투자 레벨 ≥ 1"에서 나오므로, 여기 backstabOn 상태는 더 이상 쓰지 않는다.
	--   실제 뒤통수 판정/데미지 증가는 서버(PlayerAttack.ApplyBackstabBonus)가 담당한다.
	method boolean IsBackstabActive()
		return _SkillManager:GetHeroSkillLevelByName("백스탭") >= 1
	end

	-- 매직 에로우(3차 토글 3종): 매직 미사일의 속성 강화 상태. ""=무속성(기본), "light"=빛(노랑·하양),
	-- "ice"=얼음(파랑), "fire"=불(붉은색). 켜져 있는 동안 매직 미사일의 구체/이펙트 색이 속성색으로 바뀌고
	-- 데미지가 2배가 된다. 세 속성은 서로 배타적 - 하나를 켜면 나머지는 자동으로 꺼진다.
	-- 에로우 블로우 강화와 동일한 클라 전용 상태(SkillManager가 시전 시 클라에서 읽어 서버로 넘긴다).
	property string magicMissileElement = ""
	method string GetMagicMissileElement()
		-- 현재 켜져 있는 매직 에로우 속성 키를 돌려준다. 꺼져 있으면 빈 문자열.
		return self.magicMissileElement or ""
	end

	@ExecSpace("ClientOnly")
	method boolean ToggleMagicMissileElement(string element)
		-- 매직 에로우 속성을 토글한다. 같은 속성을 다시 쓰면 OFF, 다른 속성 중이었으면 이 속성으로 교체(ON).
		-- 토글 후 "이 속성이 켜졌는지"(true=ON)를 돌려준다.
		if self.magicMissileElement == element then
			self.magicMissileElement = ""
		else
			self.magicMissileElement = element
		end
		local on = self.magicMissileElement == element
		log("[CharInfoManager] 매직 에로우 속성(" .. tostring(element) .. ") " .. (on and "ON" or "OFF"))
		return on
	end

	-- (신규) 2차 버프 스킬의 공마 보너스 적용 공통 코어. UseBooster와 동일한 토큰 패턴으로,
	-- 재사용 시 중첩 없이 지속시간만 갱신한다. key는 버프별 상태를 _T에 분리 저장하는 접두사.
	-- 각 버프는 서로 독립적이라(분노+메디테이션+파워가드 동시 활성 가능) buffAttackBonus는 합산된다.
	@ExecSpace("ClientOnly")
	method void ApplyAttackBuff(string key, integer atkBonus, number duration)
		local activeKey = "buff_" .. key .. "_active"
		local bonusKey = "buff_" .. key .. "_bonus"
		local tokenKey = "buff_" .. key .. "_token"
		if not self._T[activeKey] then
			self.buffAttackBonus = self.buffAttackBonus + atkBonus
			self._T[activeKey] = true
			self._T[bonusKey] = atkBonus
			log("[CharInfo] 버프 발동(" .. key .. ") 공마 +" .. tostring(atkBonus) .. " (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
			local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw) and cw.Enable then self:UpdateStats() end
		end
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		local myToken = self._T[tokenKey]
		_TimerService:SetTimerOnce(function()
			if self._T[tokenKey] ~= myToken then return end
			self.buffAttackBonus = self.buffAttackBonus - (self._T[bonusKey] or 0)
			self._T[activeKey] = false
			log("[CharInfo] 버프 종료(" .. key .. ") 공마 원복 (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
			local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw) and cw.Enable then self:UpdateStats() end
		end, duration)
	end

	-- (용 소환, 2026-08-04) 살아 있는 소환 용 1마리당 공격력 +10. 지속시간이 정해진 다른 버프와 달리
	-- "현재 마리 수로 계속 갱신"되는 값이라 ApplyAttackBuff의 토큰/타이머 패턴을 쓰지 않고, 이전 값과의
	-- 차이만 buffAttackBonus에 반영한다(용이 추가 소환되거나 격추될 때마다 곧바로 따라온다).
	@ExecSpace("ClientOnly")
	method void SetSummonDragonAttackBonus(integer atkBonus)
		-- atkBonus = 살아 있는 마리 수 × 10. 0이면 보너스가 완전히 사라진다(소환 종료/전멸).
		local prev = self._T.summonDragonAtk or 0
		if prev == atkBonus then return end
		self.buffAttackBonus = self.buffAttackBonus - prev + atkBonus
		self._T.summonDragonAtk = atkBonus
		log("[CharInfo] 소환 용 공격력 보너스 " .. tostring(prev) .. " → " .. tostring(atkBonus)
			.. " (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then self:UpdateStats() end
	end

	-- (버프 아이콘 우클릭 취소) 공마 버프(분노/메디테이션/파워가드)를 즉시 종료한다 -
	-- ApplyAttackBuff의 자연 만료 본문과 동일한 정리를 지금 수행하고, 토큰을 올려 예약 타이머를 무효화한다.
	@ExecSpace("ClientOnly")
	method void CancelAttackBuff(string key)
		-- (버그 수정 2026-08-12) 분노는 개편으로 공마 장부(buff_rage_*)가 아니라 **추가 전투력% 장부**
		-- (_T.rageUntil/rageFinalPct)를 쓴다. 우클릭 취소가 아래 공마 경로만 타고 조기 return 해서
		-- 전투력 +20%가 그대로 남아 있었다(신고). 분노는 여기서 먼저 배율을 끈다.
		if key == "rage" then
			if (self._T.rageUntil or 0) > _UtilLogic.ElapsedSeconds then
				self._T.rageUntil = 0
				self._T.rageFinalPct = 0
				-- 토큰을 올려 예약된 만료 타이머가 나중에 또 건드리지 않게 무효화한다(공마 취소와 같은 구조).
				self._T.rageToken = (self._T.rageToken or 0) + 1
				log("[CharInfo] 분노 취소(우클릭) - 전투력 배율 원복")
				-- 서버 캐시 전투력(기본공격이 읽는 값)도 즉시 되돌린다.
				_SkillManager:SyncDarkSightStats()
				local cwR = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
				if isvalid(cwR) and cwR.Enable then self:UpdateStats() end
			end
			-- 드래곤이 걸어준 공마 +30 분노(ApplyDragonStatBuff)가 동시에 켜져 있을 수 있으므로
			-- 아래 공용 공마 경로도 그대로 이어서 탄다.
		end
		local activeKey = "buff_" .. key .. "_active"
		local bonusKey = "buff_" .. key .. "_bonus"
		local tokenKey = "buff_" .. key .. "_token"
		if not self._T[activeKey] then return end
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		self.buffAttackBonus = self.buffAttackBonus - (self._T[bonusKey] or 0)
		self._T[activeKey] = false
		log("[CharInfo] 버프 취소(우클릭, " .. key .. ") 공마 원복 (합계 buffAttackBonus=" .. tostring(self.buffAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then self:UpdateStats() end
	end

	-- 분노(2차 버프): (개편 2026-08-12 2차) **전투력 +1%/분배** 버프 - "추가 전투력%"에 합산되어
	-- 전투력(표시 포함)에 직접 곱해진다(GetBuffBonusCombatPowerPct → CalcCombatPowerSwap).
	@ExecSpace("ClientOnly")
	method void UseRage(number duration, integer bonusCpPct)
		-- 표시 전투력·스킬 시전·기본공격 동기화 전투력이 전부 CalcCombatPower 경유라 한 곳에서 반영된다.
		-- 레벨은 CalcEquipCombatPower(배율 미적용) 기준이라 버프로는 오르내리지 않는다(사양).
		-- 드래곤이 걸어주는 분노(ApplyDragonStatBuff "rage")는 기존 공마+30 그대로다(토큰 키가 달라 충돌 없음).
		local now = _UtilLogic.ElapsedSeconds
		self._T.rageFinalPct = bonusCpPct
		self._T.rageUntil = now + duration
		self._T.rageToken = (self._T.rageToken or 0) + 1
		local myToken = self._T.rageToken
		log("[CharInfo] 분노 발동 - 전투력 +" .. tostring(bonusCpPct) .. "% (" .. tostring(duration) .. "초)")
		-- 기본공격은 서버가 "동기화해둔 전투력"만 보므로 켜고 끌 때 즉시 밀어넣는다
		-- (다크사이트·발도술 중첩과 같은 이유·같은 경로). 스탯창이 열려 있으면 표시도 즉시 갱신.
		_SkillManager:SyncDarkSightStats()
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then self:UpdateStats() end
		_TimerService:SetTimerOnce(function()
			if self._T.rageToken ~= myToken then return end
			self._T.rageFinalPct = 0
			log("[CharInfo] 분노 종료 - 전투력 원복")
			_SkillManager:SyncDarkSightStats()
			local cw2 = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw2) and cw2.Enable then self:UpdateStats() end
		end, duration)
		_RageBuffUI:ShowBuff(duration)
	end

	-- 메디테이션(2차 버프): 마력 보너스·지속시간을 호출부(SkillManager)가 투자 레벨로 계산해 넘긴다.
	@ExecSpace("ClientOnly")
	method void UseMeditation(number duration, integer atkBonus)
		-- (썬콜 개편 2026-08-08) 고정 +30/5분 → 마력 +2/분배(마스터 +40).
		-- (요청 2026-08-14) 지속시간은 **블레스와 동일**(SkillManager.GetMeditationDuration이 블레스
		-- 헬퍼를 위임받는다 - 호출부가 계산해 넘겨준다), 그리고 **오른 마력이 실제 전투력에 반영**되도록
		-- 공용 버프 코어(ApplyAttackBuff = 표시 전용) 대신 **실효 버프 통**(ApplyRealBuff)을 쓴다.
		-- ⚠ 다크드래곤이 걸어주는 메디테이션(ApplyDragonStatBuff "meditation", +30/30초)은 별개 사양이라
		--   여전히 공용 통을 쓴다 - 우클릭 취소가 두 경로를 모두 부르는 이유(BuffBarManager 참고).
		self:ApplyRealBuff("meditation", atkBonus, 0, duration)
		_MeditationBuffUI:ShowBuff(duration)
	end

	-- (다크드래곤) 드래곤이 걸어주는 분노/메디테이션 스탯 버프를 소유주 클라에 적용한다. 서버(DarkDragon)가
	-- 소유주 UserId를 마지막 인자로 넘겨 이 클라 메서드를 호출한다(쿨타임 초기화 ResetAllCooldowns와 동일 패턴).
	-- key="rage"/"meditation", 지속시간 30초. 공마 +30(기존 분노/메디테이션과 동일 보너스).
	@ExecSpace("Client")
	method void ApplyDragonStatBuff(string key, integer atkBonus, number duration)
		self:ApplyAttackBuff(key, atkBonus, duration)
		if key == "rage" then
			_RageBuffUI:ShowBuff(duration)
		elseif key == "meditation" then
			_MeditationBuffUI:ShowBuff(duration)
		end
		log("[CharInfo] 드래곤 버프 적용(" .. key .. ") +" .. tostring(atkBonus) .. " " .. tostring(duration) .. "초")
	end

	-- 블레스(2차 버프): 5분간 자신에게 공마 + 4스탯 보너스. 주변 소환 용사 몫은 서버
	-- (PlayerAttack.AttackBless)가 처리한다.
	-- (비숍 개편 2026-08-08) 고정 +30이던 것을 **분배 레벨 비례**로 바꿨다 - 호출부(SkillManager
	-- 시전 분기)가 GetBlessAttackBonus / GetBlessStatBonus로 계산해 넘겨준다.
	-- (신고 수정 2026-08-13) 블레스는 공용 버프 코어(ApplyAttackBuff/ApplyStatBuff)를 쓰지 않고
	-- **실효 버프 통**(realBuffAttackBonus / realBuffStatBonus)에 담는다 - 공용 통은 표시 전용 경로에서만
	-- 전투력에 실려서 "스탯창은 오르는데 데미지는 그대로"였다(신고). 실효 통은 CalcCombatPowerBase가
	-- 항상 합산하므로 표시·스킬 시전·기본공격이 한 값을 본다.
	-- (요청 2026-08-14 2차) 지속시간이 투자 레벨 비례(20초 + 분배당 10초)가 되면서 호출부가 계산해
	-- 넘겨준다 - 공식의 유일한 출처는 여전히 SkillManager.GetBlessBuffDurationLv 한 곳이다.
	-- ⚠ 인자 없던 UseBless에 duration을 더하지 않고 이름을 새로 지었다(LEA-1102 회피 관례).
	@ExecSpace("ClientOnly")
	method void UseBlessLv(integer atkBonus, integer statBonus, number duration)
		self:ApplyRealBuff("bless", atkBonus, statBonus, duration)
		_BlessBuffUI:ShowBuff(duration)
	end

	-- 실효 버프 적용 코어. ApplyAttackBuff와 **같은 토큰/타이머 패턴**이지만(재시전 시 중첩 없이
	-- 지속시간만 갱신) 합산 대상이 실효 통이라 전투력·데미지에 곧바로 반영된다.
	-- key로 버프별 장부를 분리해 블레스와 메디테이션이 서로를 지우지 않는다.
	@ExecSpace("ClientOnly")
	method void ApplyRealBuff(string key, integer atkBonus, integer statBonus, number duration)
		local atkKey = "realbuff_" .. key .. "_atk"
		local statKey = "realbuff_" .. key .. "_stat"
		local tokenKey = "realbuff_" .. key .. "_token"
		local newAtk = math.max(0, atkBonus or 0)
		local newStat = math.max(0, statBonus or 0)
		-- 재시전이면 이전 몫을 빼고 새 몫을 넣는다(중첩 방지 - 지속시간만 갱신되는 효과).
		self.realBuffAttackBonus = self.realBuffAttackBonus - (self._T[atkKey] or 0) + newAtk
		self.realBuffStatBonus = self.realBuffStatBonus - (self._T[statKey] or 0) + newStat
		self._T[atkKey] = newAtk
		self._T[statKey] = newStat
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		local myToken = self._T[tokenKey]
		log("[CharInfo] 실효 버프 발동(" .. key .. ") 공마 +" .. tostring(newAtk) .. " / 4스탯 각 +" .. tostring(newStat)
			.. " (" .. tostring(math.floor(duration)) .. "초, 합계 공마=" .. tostring(self.realBuffAttackBonus)
			.. " 스탯=" .. tostring(self.realBuffStatBonus) .. ")")
		self:RefreshAfterRealBuffChange()
		_TimerService:SetTimerOnce(function()
			if self._T[tokenKey] ~= myToken then return end
			self.realBuffAttackBonus = self.realBuffAttackBonus - (self._T[atkKey] or 0)
			self.realBuffStatBonus = self.realBuffStatBonus - (self._T[statKey] or 0)
			self._T[atkKey] = 0
			self._T[statKey] = 0
			log("[CharInfo] 실효 버프 종료(" .. key .. ") 전투력 원복")
			self:RefreshAfterRealBuffChange()
		end, duration)
	end

	-- 실효 버프 보너스가 바뀐 직후의 공통 갱신(발동/만료/우클릭 취소 세 경로가 공유한다).
	@ExecSpace("ClientOnly")
	method void RefreshAfterRealBuffChange()
		-- 서버 캐시 전투력(기본공격이 읽는 값) + 스탯창 표시를 한 번에 맞춘다 - 분노(UseRage)와 같은 경로.
		_SkillManager:SyncDarkSightStats()
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then self:UpdateStats() end
	end

	-- 실효 버프 즉시 종료(버프 아이콘 우클릭 취소). 토큰을 올려 예약된 만료 타이머를 무효화한다.
	@ExecSpace("ClientOnly")
	method void CancelRealBuff(string key)
		local atkKey = "realbuff_" .. key .. "_atk"
		local statKey = "realbuff_" .. key .. "_stat"
		local tokenKey = "realbuff_" .. key .. "_token"
		if (self._T[atkKey] or 0) == 0 and (self._T[statKey] or 0) == 0 then return end
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		self.realBuffAttackBonus = self.realBuffAttackBonus - (self._T[atkKey] or 0)
		self.realBuffStatBonus = self.realBuffStatBonus - (self._T[statKey] or 0)
		self._T[atkKey] = 0
		self._T[statKey] = 0
		log("[CharInfo] 실효 버프 취소(우클릭, " .. key .. ") 전투력 원복")
		self:RefreshAfterRealBuffChange()
	end

	-- 블레스 즉시 종료(버프 아이콘 우클릭 취소) - BuffBarManager 호출부 호환용 얇은 별칭.
	@ExecSpace("ClientOnly")
	method void CancelBless()
		self:CancelRealBuff("bless")
	end

	-- 4스탯(STR/DEX/INT/LUK) 공통 버프 보너스 적용 코어. ApplyAttackBuff와 **완전히 같은 토큰 패턴**이라
	-- 재사용 시 중첩 없이 지속시간만 갱신된다. 두 메서드를 합치지 않은 이유는 합산 대상 프로퍼티가
	-- 다르기 때문이고(공마 = buffAttackBonus / 4스탯 = buffStatBonus), 한쪽만 쓰는 버프가 대부분이다.
	@ExecSpace("ClientOnly")
	method void ApplyStatBuff(string key, integer statBonus, number duration)
		-- statBonus가 0이면 아무 일도 하지 않는다(공마만 주는 버프가 이 경로를 타도 안전하게).
		if statBonus == nil or statBonus <= 0 then return end
		local activeKey = "statbuff_" .. key .. "_active"
		local bonusKey = "statbuff_" .. key .. "_bonus"
		local tokenKey = "statbuff_" .. key .. "_token"
		if not self._T[activeKey] then
			self.buffStatBonus = self.buffStatBonus + statBonus
			self._T[activeKey] = true
			self._T[bonusKey] = statBonus
			log("[CharInfo] 스탯 버프 발동(" .. key .. ") 4스탯 +" .. tostring(statBonus)
				.. " (합계 buffStatBonus=" .. tostring(self.buffStatBonus) .. ")")
			local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw) and cw.Enable then self:UpdateStats() end
		end
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		local myToken = self._T[tokenKey]
		_TimerService:SetTimerOnce(function()
			if self._T[tokenKey] ~= myToken then return end
			self.buffStatBonus = self.buffStatBonus - (self._T[bonusKey] or 0)
			self._T[activeKey] = false
			log("[CharInfo] 스탯 버프 종료(" .. key .. ") 4스탯 원복 (합계 buffStatBonus=" .. tostring(self.buffStatBonus) .. ")")
			local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
			if isvalid(cw) and cw.Enable then self:UpdateStats() end
		end, duration)
	end

	-- 4스탯 버프 즉시 종료(버프 아이콘 우클릭 취소). ApplyStatBuff의 자연 만료 본문과 동일한 정리를
	-- 지금 수행하고 토큰을 올려 예약 타이머를 무효화한다 - CancelAttackBuff와 같은 구조.
	@ExecSpace("ClientOnly")
	method void CancelStatBuff(string key)
		-- 공마 버프와 짝을 이루는 취소 경로 - 블레스는 두 메서드를 함께 불러야 완전히 꺼진다.
		local activeKey = "statbuff_" .. key .. "_active"
		local bonusKey = "statbuff_" .. key .. "_bonus"
		local tokenKey = "statbuff_" .. key .. "_token"
		if not self._T[activeKey] then return end
		self._T[tokenKey] = (self._T[tokenKey] or 0) + 1
		self.buffStatBonus = self.buffStatBonus - (self._T[bonusKey] or 0)
		self._T[activeKey] = false
		log("[CharInfo] 스탯 버프 취소(우클릭, " .. key .. ") 4스탯 원복 (합계 buffStatBonus=" .. tostring(self.buffStatBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then self:UpdateStats() end
	end

	-- 파워가드(2차 버프): 5분간 공격력 +10. 받는 피해 30% 회복은 서버(PlayerHit)에서 별도로 처리한다
	-- (스탯 버프는 클라 전용이지만 피해 회복은 서버 피격 파이프라인에서 일어나므로).
	@ExecSpace("ClientOnly")
	method void UsePowerGuard(number duration)
		-- (개편 2026-08-12) 공격력 +10 폐지 - 효과는 전부 서버(PlayerHit: 지연 회복 + 받는 피해
		-- 상시 감소, StartPowerGuardLv). 여기는 버프바 표시만 남는다.
		_PowerGuardBuffUI:ShowBuff(duration)
	end

	-- "공격력 물약" 사용 시 호출 - 공격력 +500. potionAttackBonus는 세션 전용 스탯이라
	-- (CharacterPersistence가 저장하지 않음) 게임 종료 시 사라진다.
	@ExecSpace("ClientOnly")
	method void UseAttackPotion()
		self.potionAttackBonus = self.potionAttackBonus + 500
		log("[CharInfo] 공격력 물약 사용: 공격력 +500 (누적 potionAttackBonus=" .. tostring(self.potionAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
			self:UpdateLevelClass()
		end
	end

	-- "레벨 70 물약" 사용 시 호출 - 공격력 +1000, 마력 +1000 (이 스탯 시스템은 둘을 flatATK 하나로 합쳐 계산하므로 2000 반영)
	@ExecSpace("ClientOnly")
	method void UseLevel70Potion()
		self.potionAttackBonus = self.potionAttackBonus + 2000
		log("[CharInfo] 레벨 70 물약 사용: 공격력/마력 각 +1000 (누적 potionAttackBonus=" .. tostring(self.potionAttackBonus) .. ")")
		local cw = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cw) and cw.Enable then
			self:UpdateStats()
		end
	end

	-- Standalone critical-rate percentage (same formula as UpdateStats' "CritRate" stat: base 50% +
	-- equipped potential "크리티컬" options), for callers that need the number outside the stat window
	-- (skills sync this to the server so PlayerAttack.CalcCritical rolls against the real stat instead
	-- of a hardcoded chance).
	@ExecSpace("ClientOnly")
	method number CalcCritRate()
		local critAdd = 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				-- (Phase 3 버그 수정) "크리티컬 데미지" 옵션이 크리티컬 확률로 오합산되지 않게 제외한다
				if string.match(opt, "크리티컬") and not string.match(opt, "크리티컬 데미지") then
					local numStr = string.match(opt, "%+(%d+)")
					if numStr ~= nil then
						critAdd += tonumber(numStr) or 0
					end
				end
			end
		end
		-- (Phase 4) 기본 크리티컬 확률 50% → 10% (GDD §4.7)
		-- (발도술) 처치 중첩 버프의 크확 보너스(+3%×중첩) 가산 - 스킬 시전/기본공격 동기화 모두 이 값을 탄다.
		-- (표창+ 개편) 고른 표창의 크확(5~9번 10~30%) 가산.
		-- (샤프 아이즈) 버프 지속 중 크확 보너스(+1%p×분배) 가산.
		return 10 + critAdd + self.battoCritBonus + self.shurikenCritBonus + self.sharpEyesCritBonus
	end

	-- (Phase 4) 잠재 "스킬 재사용 대기시간 -N초" 옵션의 합산 초. SkillManager.ApplyCooldownReduction이
	-- 5초 이상 개별 쿨타임에 적용한다 (스탯창 CDReduce 표시와 동일 계산).
	@ExecSpace("ClientOnly")
	method number GetCooldownReduction()
		local cdAdd = 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				if string.match(opt, "재사용 대기시간") then
					cdAdd += tonumber(string.match(opt, "%-(%d+)초") or "0") or 0
				end
			end
		end
		return cdAdd
	end

	-- Standalone critical-damage percentage (same formula as UpdateStats' "CritDmg" stat: base 125% +
	-- equipped potential "크리티컬 데미지" options), for callers that need the number outside the stat
	-- window (skills sync this to the server so PlayerAttack.CalcDamage's crit multiplier uses the real
	-- stat instead of a hardcoded 200%).
	@ExecSpace("ClientOnly")
	method number CalcCritDamage()
		local critDmgAdd = 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				if string.match(opt, "크리티컬 데미지") then
					local numStr = string.match(opt, "%+(%d+)")
					if numStr ~= nil then
						critDmgAdd += tonumber(numStr) or 0
					end
				end
			end
		end
		-- (샤프 아이즈) 버프 지속 중 크리티컬 데미지 +8%p(전 구간 공통) 가산.
		return 125 + critDmgAdd + self.sharpEyesCritDmgBonus
	end

	-- (샤프 아이즈, 신궁 4차 2026-08-06) 버프 시작/갱신. 발도술 프록(UseBattoAtkSpeed)과 같은 토큰 패턴 -
	-- 재시전하면 이전 적용을 정확히 되돌린 뒤 새로 건다(중복 가산 방지).
	-- ⚠ 지속시간이 끝나면 이 안의 타이머가 스스로 CancelSharpEyes를 부른다 - 버프바 표시(SharpEyesBuffUI)와
	--   서버 동기화(SkillManager)는 각자 자기 만료 경로에서 처리한다.
	@ExecSpace("ClientOnly")
	method void UseSharpEyes(number remain, integer critRateBonus, integer critDmgBonus)
		self.sharpEyesCritBonus = critRateBonus
		self.sharpEyesCritDmgBonus = critDmgBonus
		self._T.sharpEyesActive = true
		log("[CharInfo] 샤프 아이즈 - 크확 +" .. tostring(critRateBonus) .. "% / 크뎀 +" .. tostring(critDmgBonus)
			.. "% (" .. string.format("%.0f", remain) .. "초)")
		local cwSE = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwSE) and cwSE.Enable then
			self:UpdateStats()
		end
		self._T.sharpEyesToken = (self._T.sharpEyesToken or 0) + 1
		local mySEToken = self._T.sharpEyesToken
		_TimerService:SetTimerOnce(function()
			if self._T.sharpEyesToken ~= mySEToken then return end
			self:CancelSharpEyes()
		end, remain)
	end

	-- 샤프 아이즈 원복(만료/우클릭 취소 공용). 어느 경로가 먼저 와도 한 번만 되돌린다.
	@ExecSpace("ClientOnly")
	method void CancelSharpEyes()
		if not self._T.sharpEyesActive then return end
		self._T.sharpEyesToken = (self._T.sharpEyesToken or 0) + 1
		self.sharpEyesCritBonus = 0
		self.sharpEyesCritDmgBonus = 0
		self._T.sharpEyesActive = false
		log("[CharInfo] 샤프 아이즈 종료 - 크확/크뎀 원복")
		local cwSE2 = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharInfoWindow")
		if isvalid(cwSE2) and cwSE2.Enable then
			self:UpdateStats()
		end
	end

	-- (전투력 개편 2026-08-08) 전투력 공식 단일 구현. 기존 3중 복제(UpdateStats/CalcCombatPowerSwap/
	-- CalcEquipCombatPower)를 전부 이 메서드로 위임한다. 사용자 확정 사양:
	--   ① 공격력 항 = 모든 아이템 공격력 합 × (1 + 공격력%합/100)   - 공격력%는 무기 잠재 특수 옵션
	--   ② 스탯 항   = **직업 주스탯** 합 × (1 + 주스탯%합/100) ÷ 4   - 주스탯 4 = 공격력 1 환산
	--     (요청 2026-08-16) 종전엔 4스탯을 전부 합쳤다 - 전사가 INT/LUK 옵션을 굴려도 전투력·레벨이
	--     올라서, 이제 주스탯 외의 스탯은 어떤 경로로도 실리지 않는다.
	--   ③ base = (① + ②) × (1 + 추가공격속도%/100)                  - 공속 12%면 12%만큼 상승
	--   ④ ~~크리티컬 기대 데미지 증가율~~ → **폐지**(요청 2026-08-16). 크리티컬은 실제 타격에서 이미
	--     배율로 적용되므로 전투력에 또 실으면 이중 적용이고, 레벨(총합÷7)까지 밀어 올린다.
	--   ⑤ 전투력 = base의 제곱(거듭제곱)
	-- (요청 2026-08-08) 전투력은 **아이템만으로** 계산한다 - 물약(potionAttackBonus)/버프(buffAttackBonus·
	-- buffStatBonus)/스킬 투자(skillAttackBonus)는 전투력에 포함하지 않는다. 표시 전투력과 레벨 환산용
	-- 장비 전투력이 같은 값이 된다.
	-- (기존 공식의 레벨 기본 스탯 baseVal·데미지%·보스뎀 항은 사양에서 제외됐다.)
	-- 이 메서드는 제곱 **전**의 "총합"(정수)을 돌려준다 - 전투력은 CalcCombatPowerUnified(=총합²),
	-- 레벨은 GetLevelForEquipCP(=총합÷7 내림)가 각각 이 값을 쓴다.
	@ExecSpace("ClientOnly")
	method number CalcCombatPowerBase(number swapSlot, string swapStr)
		-- (테스트 /lv 명령) 오버라이드 활성 시 장비 무관하게 그 레벨의 총합(레벨×7)을 반환 -
		-- 전투력(총합²)·표시레벨(총합÷7)·스킬 데미지가 이 한 곳에서 전부 따라온다.
		if (self._T.testLevelOverride or 0) > 0 then
			-- 오버라이드는 레벨을 못 박는 것이므로 아이템 공속 배수도 태우지 않는다(0으로 리셋 -
			-- 직전 계산의 값이 남아 레벨이 한 번 더 부풀지 않게).
			self._T.lastItemAtkSpdPct = 0
			return self._T.testLevelOverride * 7
		end
		-- (요청 2026-08-16) 전투력도 **직업이 쓰는 쪽만** 센다. 종전엔 잠재 「공격력」·「마력」을 한 통에
		-- 합산해, 전사가 마력 잠재를 굴려도 전투력(=데미지)이 올랐다(스탯창 표시는 08-16에 먼저 분리).
		--   · bothATK = 무기 기본(+30)·스타포스 + 물약/버프/스킬 공마 → **항상** 포함(양쪽에 붙는 값)
		--   · 잠재 「공격력」 → 비마법 직업만 / 잠재 「마력」 → 마법 직업(비숍·썬콜·불독)만
		-- ⚠ 이 값은 레벨 환산(총합÷7)도 함께 쓴다 - 직업과 안 맞는 옵션을 끼고 있던 캐릭터는
		--   레벨이 내려가고, 그러면 SP 자동 회수(10초 유예)가 뒤따른다.
		local bothATK           = 0
		local flatATK, atkPct   = 0, 0     -- 잠재 「공격력」
		local flatMATK, matkPct = 0, 0     -- 잠재 「마력」
		-- (요청 2026-08-16) 스탯 항은 **직업 주스탯만** 센다 - 무관한 스탯(전사의 INT/LUK 등)은
		-- 전투력에도, 그것을 √로 되돌려 쓰는 레벨에도 전혀 실리지 않는다.
		local mainStat = self:GetMainStatName()
		local statFlat, statPct = 0, 0
		local critAdd, critDmgAdd = 0, 0
		local atkSpdPct = 0

		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if slot == swapSlot then s = swapStr end
			if s == "" then continue end

			-- 무기 슬롯 기본옵션: 직업별 드롭박스 지급 무기는 공격력/마력 +30 고정 (잠재능력과 별개)
			-- (요청 2026-08-12) 마력 분리 후에도 무기 자체 성능은 공격력·마력 양쪽에 붙는다(원작 무기와 동일).
			if slot == 6 then
				local baseName = _UIEquipInventoryManager:ParseName(s)
				if _UIEquipInventoryManager:IsJobDropWeapon(baseName) then
					bothATK += 30
				end
			end

			-- Starforce bonus (field 4): 1성당 직업 주스탯 +4, 무기 성능 +3
			-- (2026-08-16) CalcStarforceStats는 **주스탯 칸에만** 값을 채우므로 넷을 더해도 주스탯 몫이다
			-- (주스탯만 센다는 이번 사양과 이미 일치한다).
			local stars = self:ParseFieldNum(s, 4)
			if stars > 0 then
				local sf = self:CalcStarforceStats(stars)
				statFlat += sf.str + sf.dex + sf.int + sf.luk
				bothATK += sf.atk
			end

			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				local numStr = string.match(opt, "%+(%d+)")
				if numStr == nil then continue end
				local val  = tonumber(numStr) or 0
				local isPct = string.sub(opt, -1) == "%"

				if string.match(opt, "올스탯") then
					-- 올스탯은 4스탯 전부에 붙지만 **전투력에 실리는 건 주스탯 몫 하나뿐**이다
					-- (요청 2026-08-16 - 아래 주스탯 분기와 같은 이유).
					if isPct then statPct += val else statFlat += val end
				elseif string.match(opt, "STR") or string.match(opt, "DEX")
					or string.match(opt, "INT") or string.match(opt, "LUK") then
					-- (요청 2026-08-16) **직업 주스탯이 아닌 스탯은 전투력·레벨에 전혀 실리지 않는다.**
					-- 종전엔 4스탯을 전부 합쳐 ÷4 했기 때문에, 전사가 INT/LUK 옵션을 굴려도 레벨이 올랐다(신고).
					-- 주스탯 판정은 GetMainStatName 한 곳(직업 인덱스 → STR/DEX/INT/LUK)을 그대로 쓴다.
					if string.match(opt, mainStat) ~= nil then
						if isPct then statPct += val else statFlat += val end
					end
				elseif string.match(opt, "최대 HP") or string.match(opt, "최대 MP") then
					-- HP/MP는 생존 스탯 - 전투력 공식 미반영 (실수치 반영은 CollectPotentialExtras)
				elseif string.match(opt, "공격속도") then
					if isPct then atkSpdPct += val end
				elseif string.match(opt, "마력") then
					-- (요청 2026-08-16) 마법 직업만 쓰는 값. ⚠ "공격력"보다 먼저 검사한다.
					if isPct then matkPct += val else flatMATK += val end
				elseif string.match(opt, "공격력") then
					-- (요청 2026-08-16) 비마법 직업만 쓰는 값.
					if isPct then atkPct += val else flatATK += val end
				elseif string.match(opt, "크리티컬 데미지") then
					critDmgAdd += val
				elseif string.match(opt, "크리티컬") then
					critAdd += val
				end
			end
		end

		-- (요청 2026-08-08) 단계마다 정수로 내림한 뒤 마지막 정수를 제곱한다 - 전투력이 항상
		-- "총합×총합"의 완전제곱수가 되어 눈으로 검산된다. 예) 총합 1004, 공속 12%면
		-- floor(1004×1.12)=1124 → 전투력 1124×1124=1,263,376.
		-- (요청 2026-08-12) 마법 직업(비숍/썬콜/불독 = 주스탯 INT)은 **마력**이, 그 외 직업은
		-- **공격력**이 전투력의 근거다. 주스탯 판정(GetMainStatName)을 그대로 재사용해 한 곳에서 가른다.
		-- (요청 2026-08-12 3차) **표시 전용 버프 반영.** `_T.cpIncludeBuffs`가 켜져 있을 때만 버프/물약/스킬
		-- 유래 성능을 함께 넣는다 - 레벨 산정(CalcEquipCombatPower)과 스킬 시전 전투력은 이 플래그를
		-- 켜지 않으므로 **아이템만**이라는 기존 사양이 그대로 유지된다("레벨은 순수 장비 성능" - GDD §4.1).
		-- 시그니처를 바꾸면 호출부 전수 수정 + LEA-1102 위험이 있어 플래그 방식으로 뒀다(단일 스레드라 안전).
		if self._T.cpIncludeBuffs == true then
			-- 전투력은 "공격력·마력 중 높은 쪽"을 쓰는 단일 값이라 두 축을 모두 더한다.
			-- ⚠ (요청 2026-08-14 5차) **표창 계열(skillAttackBonus)은 여기서 뺐다** - 아래 실효 버프
			--   블록으로 옮겨 표시/스킬 구분 없이 항상 반영된다. 여기 남겨두면 표시 경로에서 두 번 더해진다.
			-- (2026-08-16) 물약·버프 공마는 "공격력과 마력 둘 다 오른다"는 사양이라 **양쪽 통**에 넣는다.
			bothATK += self.potionAttackBonus + self.buffAttackBonus
				+ self.commonAttackBonus
			-- (요청 2026-08-16) **버프 공속은 전투력에서 뺐다.** 종전엔 표시 공속 초과분(부스터 단계·
			-- 발도술 중첩 +3%/스택·무기 보너스)을 여기서 전투력에 곱했는데, 부스터/발도술은 "공격 속도만
			-- 올리는" 버프인데도 전투력이 올라 **데미지까지 함께 오르는** 이중 이득이 됐다(신고).
			-- 크리티컬도 버프분(발도술 중첩·표창+·샤프 아이즈)을 함께 반영한다.
			critAdd += self.battoCritBonus + self.shurikenCritBonus + self.sharpEyesCritBonus
			critDmgAdd += self.sharpEyesCritDmgBonus
		end

		-- (신고 수정 2026-08-13 / 확장 08-14) **실효 버프(블레스·메디테이션)는 표시/스킬 구분 없이 항상
		-- 반영한다.** 위 cpIncludeBuffs 블록은 표시 전용이라, 그 통에 담아 두면 스탯창 숫자만 오르고
		-- 스킬이 넘기는 전투력(=데미지)은 그대로였다(신고: "블레스의 공격력·스탯 상승이 실제 전투력
		-- 상승으로 오르지 않는다" / 요청: 메디테이션도 "마력에 따라 전투력이 오르게").
		-- (요청 2026-08-14 5차) **표창 계열(skillAttackBonus)도 같은 이유로 여기로 승격**했다 -
		--   표창+ 4차수 투자 + 지금 고른 표창의 공격력 + 트레이닝 1·3차가 전부 이 통에 들어 있는데,
		--   종전엔 표시 전용이라 스탯창 숫자만 오르고 실제 스킬 데미지는 그대로였다(신고: "표창+에서
		--   오르는 공격력이 전투력에 적용되지 않는다"). ⚠ 승격 대상은 **공격력뿐**이다 - 같은 통에서
		--   나오는 표창 크확(shurikenCritBonus)·공속(shurikenAtkSpeedStage)은 위 표시 블록에 그대로 둔다.
		-- ⚠ 단 **레벨 환산 경로(CalcEquipCombatPower)만은 제외**한다 - "레벨은 순수 장비 성능"이라
		--   여기 넣으면 버프로 표시 레벨이 출렁이고 최대 MP·매직 미사일 구체 수·SP 예산이 함께 흔들린다.
		--   (표창+·트레이닝도 스킬 투자분이라 레벨로 되먹임되면 순환한다 - 반드시 이 블록 안에 둔다.)
		-- ⚠ 4스탯은 아래 statTerm에서 ÷4 되므로 네 스탯 각 +N은 statFlat에 4N을 더해야 한다
		--   (장비 "올스탯 +N"이 statFlat += N*4인 것과 같은 규칙).
		if self._T.cpExcludeRealBuff ~= true then
			-- (2026-08-16) 실효 버프·스킬(블레스/메디테이션/표창+/트레이닝) 공마도 양쪽 통에 넣는다.
			bothATK += self.realBuffAttackBonus + self.skillAttackBonus
			-- (요청 2026-08-16) 4스탯 전부에 붙는 버프(블레스 등)도 **주스탯 몫 하나만** 전투력에 실린다
			-- (종전 ×4 → ×1). 무관한 스탯은 어떤 경로로 들어와도 전투력·레벨을 올리지 않는다.
			statFlat += self.realBuffStatBonus
		end

		-- (요청 2026-08-12 3차) 무기 성능이 단일 값이 되면서 직업 분기가 사라졌다 - 마법 직업이든
		-- 아니든 같은 값을 쓰고, 그 값이 상태창에서 공격력/마력 중 어느 줄로 보이는지만 다르다.
		-- (요청 2026-08-16) 잠재 공마 옵션은 **직업이 쓰는 쪽만** 전투력에 실린다.
		-- 마법 직업(비숍/썬콜/불독 = 주스탯 INT)은 「마력」, 그 외는 「공격력」.
		local useFlat, usePct = flatATK, atkPct
		if self:IsMagicJob() then
			useFlat, usePct = flatMATK, matkPct
		end
		local atkTerm  = (bothATK + useFlat) * (1 + usePct / 100)
		local statTerm = statFlat * (1 + statPct / 100) / 4
		local total = math.floor(atkTerm + statTerm)
		-- (요청 2026-08-16) **공격속도 항 제거.** 종전엔 여기서 `total × (1 + 공속%/100)`을 곱했다 -
		-- 공속은 초당 타격 수를 늘릴 뿐 한 방의 데미지를 올리지 않는데, 전투력이 곧 데미지의 근거라
		-- 공속이 데미지로 이중 환산됐다. 아이템 공속도 같은 이유로 전투력에서 뺀다.
		-- ⚠ 다만 **레벨 환산에는 아이템 공속을 그대로 곱한다**(요청) - 아래에 아이템 공속 누적치를
		--   남겨 두고 GetDisplayLevel 경로(CalcEquipCombatPower)가 그 값을 쓴다. 버프 공속은 레벨에도
		--   넣지 않는다("레벨은 순수 장비 성능" - 버프로 표시 레벨이 출렁이면 SP 예산·최대 MP가 흔들린다).
		self._T.lastItemAtkSpdPct = atkSpdPct

		-- (요청 2026-08-16) **크리티컬은 전투력에 반영하지 않는다.** 종전엔 크확·크뎀을 "기대 데미지
		-- 증가율"로 환산해 곱했는데(critFactor), 크리티컬은 실제 타격에서 이미 배율로 적용되므로
		-- 전투력(=시전 데미지의 근거)에 또 실으면 **이중 적용**이고, 그 전투력이 레벨(총합÷7)까지
		-- 밀어 올린다. 공격속도를 뺀 것과 같은 취지다.
		-- critAdd/critDmgAdd 누적은 남겨 둔다 - 스탯창 표시(UpdateStats)는 별도 계산이지만,
		-- 나중에 전투력에 다시 넣을 일이 생기면 여기 한 줄만 되살리면 되게 자리를 남긴다.

		if total < 0 then total = 0 end
		return total
	end

	-- 전투력 = 총합 × 총합 (완전제곱수). 총합 계산은 CalcCombatPowerBase 한 곳이다.
	@ExecSpace("ClientOnly")
	method number CalcCombatPowerUnified(number swapSlot, string swapStr)
		local t = self:CalcCombatPowerBase(swapSlot, swapStr)
		return t * t
	end

	-- (요청 2026-08-14 10차) **최종 전투력 1/100 축소.** 전투력이 총합²이라 레벨이 오를수록 자릿수가
	-- 급격히 불어나는데, 데미지가 `전투력 × 배율`이라 그 자릿수가 그대로 화면 숫자가 된다
	-- (요청: "눈에 보이는 데미지 숫자가 너무 커지지 않았으면"). 마지막 단계에서 100으로 나눠 내린다 -
	-- 예) 490 → 4.
	-- ⚠ **적용 지점은 "최종 전투력"뿐이다.** 중간 단계에 넣으면 다른 계산이 통째로 어긋난다.
	--   · 적용   : CalcCombatPowerSwap(= CalcCombatPower · 표시/데미지의 단일 출구) /
	--              스탯창 전투력 줄(UpdateStats) / 경량 갱신(RefreshFinalDamageRow) / /lv 토스트
	--   · 미적용 : CalcCombatPowerBase(총합) · CalcCombatPowerUnified(총합²) · CalcEquipCombatPower ·
	--              GetLevelForEquipCP · GetEquipCPForLevel
	--     → 레벨 = √전투력 ÷ 7이라 레벨 경로에 넣으면 **표시 레벨이 그대로 1/10로 무너진다**
	--       (최대 MP·매직 미사일 구체 수·SP 예산·스킬 레벨 제한이 전부 그 레벨을 본다).
	-- ⚠ 몬스터 HP도 같은 곡선((7L)²×배율)에서 나온다 - RegionTierLogic.GetMonsterHpForLevel이 **같은
	--   1/100**을 적용한다. 한쪽만 바꾸면 처치 시간이 100배가 되므로 두 곳은 반드시 함께 움직인다.
	-- ⚠ 0 방지: 총합 7~9(전투력 49~81) 구간은 내리면 0이 되어 데미지가 영영 0이 된다 - 전투력이
	--   남아 있는 한 최소 1은 보장한다(1레벨 캐릭터가 아무것도 못 때리는 것을 막는다).
	@ExecSpace("ClientOnly")
	method number ScaleFinalCombatPower(number cp)
		-- 최종 전투력에 1/100 축소(내림)를 적용한다. 위 주석의 적용/미적용 목록을 반드시 지킬 것.
		if cp == nil or cp <= 0 then return 0 end
		local scaled = math.floor(cp / 100)
		if scaled < 1 then scaled = 1 end
		return scaled
	end

	-- (테스트 /lv 명령) 레벨 오버라이드. 0 이하 = 해제. 활성 중엔 CalcCombatPowerBase가 장비 무관하게
	-- "그 레벨의 총합(레벨×7)"을 돌려주므로 전투력·표시레벨·HP 보고·SP·티어 게이트가 전부 자동 연동된다.
	-- 세션 한정(_T) - 저장에 남지 않는다.
	@ExecSpace("ClientOnly")
	method void SetTestLevelOverride(integer level)
		if level == nil or level <= 0 then
			self._T.testLevelOverride = nil
			_UIToast:ShowMessage("레벨 오버라이드 해제 - 장비 기준으로 복귀")
			log("[TestCommand] 레벨 오버라이드 해제")
		else
			local lv = math.max(1, math.min(200, math.floor(level)))
			self._T.testLevelOverride = lv
			local total = lv * 7
			-- (요청 2026-08-14 10차) 토스트에도 **화면에 보이는 값**(1/100 축소분)을 찍는다 - 스탯창과
			-- 다른 숫자가 뜨면 오버라이드가 안 먹은 것처럼 보인다.
			_UIToast:ShowMessage("테스트 레벨 " .. tostring(lv) .. " 적용 (전투력 "
				.. tostring(self:ScaleFinalCombatPower(total * total)) .. ")")
			log("[TestCommand] 레벨 오버라이드 " .. tostring(lv) .. " (총합 " .. tostring(total) .. ")")
		end
		self:UpdateStats()
		-- 서버 캐시 전투력(기본공격/서버 발동 패시브가 읽는 currentCombatPower)은 스킬 시전 때만
		-- 갱신되므로, 명령 즉시 새 값을 밀어준다 - 안 밀면 기본공격이 낡은 전투력으로 나간다(실측).
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			---@type PlayerAttack
			local pa = player:GetComponent("script.PlayerAttack")
			if isvalid(pa) then
				pa:SyncCombatPower(_SkillManager:PeekEffectiveCombatPower())
			end
		end
	end

	-- Standalone combat-power number (same formula as UpdateStats' "Combat" stat), for callers that only need the number (e.g. UIMyInfoManager's world HUD level).
	@ExecSpace("ClientOnly")
	method number CalcCombatPower()
		-- 현재 장착 장비 기준 전투력 (교체 시뮬레이션 없이)
		return self:CalcCombatPowerSwap(0, "")
	end

	-- 장비 slot(1~7)을 swapStr로 교체했다고 가정한 전투력. swapSlot=0이면 현재 장비 그대로.
	-- 툴팁의 "전투력 증가량" 계산용 - (전투력 개편 2026-08-08) 공식은 CalcCombatPowerUnified 단일 구현.
	-- (요청 2026-08-12) **추가 전투력%** 신설 - 잠재 "데미지/보스 데미지 +N%"(장비)와 분노(버프)가
	-- 전투력(총합²)에 **직접 곱해진다**. 레벨 경로(CalcEquipCombatPower)는 이 배율을 받지 않으므로
	-- 추가 전투력·버프는 레벨과 무관하다(사양). 잠재 데미지%는 08-08 개편 때 공식에서 빠져 표시
	-- 전용이던 죽은 옵션이었는데, 이 배율로 실효화된다.
	@ExecSpace("ClientOnly")
	method number CalcCombatPowerSwap(number swapSlot, string swapStr)
		-- (요청 2026-08-12 2차) **최종 데미지%가 전투력에 곱해진다.** 구성: 장비(잠재 데미지/보스뎀) +
		-- 분노(버프) + **콤보 구슬(2%/개)**. 콤보가 합류하면서 서버 ApplyComboAttackBonus는 항등이 됐다.
		-- ⚠ 패닉/코마는 데미지 공식에 구슬 수를 직접 곱하므로 여기 실린 콤보 배율을 빼고 넘겨야 한다
		--   (SkillManager.GetEffectiveCombatPowerNoCombo) - 안 그러면 구슬 수가 두 번 곱해진다.
		local cp = self:CalcCombatPowerUnified(swapSlot, swapStr)
		local pct = self:CollectBonusCombatPowerPct(swapSlot, swapStr) + self:GetBuffBonusCombatPowerPct()
			+ self:GetComboFinalDamagePct()
		if pct ~= 0 then
			cp = math.floor(cp * (1 + pct / 100))
		end
		-- (요청 2026-08-14 10차) **최종 1/100 축소는 여기가 단일 출구다.** 표시 전투력도, 스킬이 서버로
		-- 넘기는 전투력(GetEffectiveCombatPower → PeekEffectiveCombatPower → CalcCombatPower)도,
		-- 소환수/장판이 그대로 쓰는 전투력도 전부 이 메서드를 지나므로 한 곳에서 덮인다.
		return self:ScaleFinalCombatPower(cp)
	end

	-- (요청 2026-08-12) 장비 유래 추가 전투력% 합 - 잠재/에디셔널의 "데미지 +N%"·"보스 몬스터 데미지 +N%".
	-- "크리티컬 데미지"는 별도 스탯이라 먼저 걸러낸다(상위 문자열 함정 - UpdateStats 파서와 동일).
	@ExecSpace("ClientOnly")
	method number CollectBonusCombatPowerPct(number swapSlot, string swapStr)
		local pct = 0
		for slot = 1, 25 do
			local s = _UIEquipInventoryManager:GetEquip(slot)
			if slot == swapSlot then s = swapStr end
			if s == "" then continue end
			for _, fi in ipairs({10, 11, 12, 14, 15, 16}) do
				local opt = self:GetField(s, fi)
				if opt == "" or opt == "0" then continue end
				local numStr = string.match(opt, "%+(%d+)")
				if numStr == nil then continue end
				if string.sub(opt, -1) ~= "%" then continue end
				if string.match(opt, "크리티컬") then continue end
				if string.match(opt, "보스") or string.match(opt, "데미지") then
					pct += tonumber(numStr) or 0
				end
			end
		end
		return pct
	end

	-- (요청 2026-08-12) 버프 유래 추가 전투력% - 현재는 분노(분배당 +1%)만. 레벨에는 반영되지 않는다.
	@ExecSpace("ClientOnly")
	method number GetBuffBonusCombatPowerPct()
		if (self._T.rageUntil or 0) <= _UtilLogic.ElapsedSeconds then return 0 end
		return self._T.rageFinalPct or 0
	end

	-- (요청 2026-08-12 2차) 콤보 어택 구슬이 주는 최종 데미지% = **구슬 1개당 2% 고정**.
	-- 어드밴스드 콤보의 "구슬당 +2%/분배"는 폐지됐다(어드콤은 구슬 상한·2개 동시 획득만 담당).
	-- 이 값은 이제 **전투력 배율에 합류**한다(CalcCombatPowerSwap) - 서버 ApplyComboAttackBonus는
	-- 항등 함수가 되어 이중 적용이 없다. 스킬 레벨 조회가 빠져 매우 가벼우므로 전투력 경로에서 매번 불러도 된다.
	@ExecSpace("ClientOnly")
	method number GetComboFinalDamagePct()
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return 0 end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return 0 end
		local orbs = pa.ComboOrbCount or 0
		if orbs <= 0 then return 0 end
		-- (요청 2026-08-16) 구슬 1개당 최종 데미지 2% → **3%**.
		-- (요청 2026-08-15) **다크드래곤이 걸어준** 콤보 어택은 구슬 효과가 절반이다(3% → 1.5%/개).
		-- 상한(5개)은 그대로 두고 효과만 내린다. 본인이 직접 시전한 콤보 어택은 3% 그대로.
		local perOrb = 3.0
		if pa.ComboFromDragon then perOrb = perOrb * 0.5 end
		return perOrb * orbs
	end

	-- (요청 2026-08-12) 스탯창 "최종 데미지" 줄만 가볍게 다시 쓴다. 콤보 구슬은 전투 중 수시로 바뀌는데
	-- UpdateStats 전체는 25슬롯을 여러 번 훑어 무겁다(그 중첩 호출이 조용한 중단을 일으킨 전례가 있다).
	-- 장비/버프 몫은 UpdateStats가 캐시해둔 값(equipBuffFinalDmgPct)을 재사용하고 콤보 몫만 새로 구한다.
	@ExecSpace("ClientOnly")
	method void RefreshFinalDamageRow()
		local base = "/ui/DefaultGroup/CharInfoWindow/DetailPanel/"
		local pct = self.equipBuffFinalDmgPct + self:GetComboFinalDamagePct()
		local e = _EntityService:GetEntityByPath(base .. "StatVal_TotalDmg")
		if isvalid(e) then
			e.TextComponent.Text = "+" .. tostring(pct) .. "%"
		end
		-- (요청 2026-08-12 3차) 콤보 구슬이 전투력 배율에 들어가므로 **전투력 줄도 함께** 따라가야 한다.
		-- 25슬롯을 훑는 계산이라 스탯창이 열려 있고 구슬 수가 실제로 바뀐 순간에만 호출된다(감시 틱 조건).
		local c = _EntityService:GetEntityByPath(base .. "StatVal_Combat")
		if isvalid(c) then
			self._T.cpIncludeBuffs = true
			local cp = self:CalcCombatPowerUnified(0, "")
			self._T.cpIncludeBuffs = false
			if pct ~= 0 then cp = math.floor(cp * (1 + pct / 100)) end
			-- (요청 2026-08-14 10차) UpdateStats의 전투력 줄과 같은 식이므로 최종 1/100도 같이 건다.
			cp = self:ScaleFinalCombatPower(cp)
			c.TextComponent.Text = tostring(math.floor(cp))
		end
	end

	-- (Phase 1) 레벨 산정 전용 "장비 전투력(EquipCP)". 장착 장비(슬롯 1~25)에서 유래한 성능만 합산한다.
	-- 제외 항목: 물약(potionAttackBonus), 버프(buffAttackBonus), 스킬 투자(skillAttackBonus) -
	-- "순수 아이템 성능만 레벨로 치환"이 사양. (전투력 개편 2026-08-08) 공식은 CalcCombatPowerUnified
	-- 단일 구현으로 위임 - 레벨 기본 스탯이 공식에서 빠져 순환 참조 걱정도 없어졌다.
	-- 표시/스킬용 전투력은 기존 CalcCombatPower()를 그대로 쓴다.
	@ExecSpace("ClientOnly")
	method number CalcEquipCombatPower()
		-- (요청 2026-08-08) 전투력이 아이템만으로 계산되면서 표시 전투력과 완전히 같은 값이 됐다 -
		-- 호출부 호환을 위해 별칭으로 남긴다.
		-- (신고 수정 2026-08-13) 실효 버프(블레스·메디테이션)는 표시/스킬 전투력에 항상 실리므로,
		-- **레벨 경로인 여기서는 명시적으로 제외**한다 - 안 그러면 버프를 걸 때마다 표시 레벨이 오르내리고
		-- 최대 MP·매직 미사일 구체 수·SP 예산·스킬 레벨 제한 페널티가 함께 흔들린다("레벨은 순수 장비 성능").
		-- ⚠ (버그 수정 2026-08-14) 플래그는 **끝나면 원래 값으로 되돌린다**(false로 못 박지 않는다).
		--   이 계산 도중 다시 이 메서드가 불릴 수 있다 - CalcCombatPowerBase → GetAttackSpeedPercent /
		--   GetSkillPowerMultiplier → GetDisplayLevel → 여기, 하는 경로가 있다. 안쪽 호출이 끝나며
		--   플래그를 false로 눕히면 **바깥 계산이 그 뒤부터 버프를 포함**해서, 레벨이 버프만큼 올라갔다
		--   (실측: 실효 버프 +40에서 표시 레벨 33 → 39).
		local prevExclude = self._T.cpExcludeRealBuff
		self._T.cpExcludeRealBuff = true
		local cp = self:CalcCombatPowerUnified(0, "")
		self._T.cpExcludeRealBuff = prevExclude
		-- (요청 2026-08-16) **레벨 환산에만 아이템 공격속도를 곱한다** - 공속 10%짜리 장비를 끼면
		-- 레벨이 1.1배가 된다. 전투력(=데미지 근거)에서는 공속을 뺐지만(CalcCombatPowerBase 참고)
		-- 공속 장비의 값어치는 레벨로 남긴다는 사양이다. 레벨 = 총합÷7이므로 **총합에 곱한 뒤**
		-- 다시 제곱해서 돌려준다(호출부 GetLevelForEquipCP가 √로 총합을 복원하는 구조 유지).
		-- ⚠ 버프 공속(부스터·발도술)은 여기 들어오지 않는다 - `lastItemAtkSpdPct`는 장비 옵션만 센다.
		-- (요청 2026-08-16) 공속이 레벨에 미치는 영향이 너무 커서 **절반**으로 줄인다 -
		-- 공속 10%면 레벨 ×1.10 → **×1.05**(spd/100 → spd/200).
		local spd = self._T.lastItemAtkSpdPct or 0
		if spd > 0 and cp > 0 then
			local total = math.floor(math.sqrt(cp) + 0.5)
			total = math.floor(total * (1 + spd / 200))
			cp = total * total
		end
		return cp
	end

	-- (레벨 환산 개편 2026-08-08) 레벨 = 전투력 총합(제곱 전 정수) ÷ 7 (내림). 사용자 확정 사양 -
	-- 구 LevelCurve.csv 구간 테이블은 폐지한다(전투력이 총합²의 완전제곱수라 √로 총합을 정확히 복원).
	-- 예) 총합 1162 → 레벨 166. 하한 1 / 상한 200 가드.
	@ExecSpace("ClientOnly")
	method integer GetLevelForEquipCP(number cp)
		if cp < 0 then cp = 0 end
		local total = math.floor(math.sqrt(cp) + 0.5)
		local level = math.floor(total / 7)
		if level < 1 then level = 1 end
		if level > 200 then level = 200 end
		return level
	end

	-- (Phase 1) 현재 장비 전투력 기준 표시 레벨. 레벨을 참조하는 모든 지점의 단일 진입점 -
	-- 기존 "전투력 ÷ 10" 선형 환산과 _UIMyInfoManager.CharLevel(죽은 값) 참조를 전부 이걸로 대체한다.
	@ExecSpace("ClientOnly")
	method integer GetDisplayLevel()
		return self:GetLevelForEquipCP(self:CalcEquipCombatPower())
	end

	-- GetLevelForEquipCP의 **역함수** - 그 레벨에 해당하는 전투력을 돌려준다.
	-- (요청 2026-08-07) 소환수(용사)의 "레벨에 맞는 전투력"을 구하는 데 쓴다.
	-- (레벨 환산 개편 2026-08-08) 레벨 = 총합÷7 규칙의 역: 총합 = 레벨×7, 전투력 = 총합².
	@ExecSpace("ClientOnly")
	method number GetEquipCPForLevel(integer level)
		local lv = math.max(1, math.min(math.floor(level), 200))
		local total = lv * 7
		return total * total
	end

	-- Returns starforce flat bonus stats table {str, dex, int, luk, atk}
	-- (전투력 개편 2026-08-08) 구간표(3/4/5/7/22 …) 폐지 - 1성당 "직업 주스탯 +4, 공격력 +3" 균일.
	-- 주스탯 4 = 공격력 1 환산 규칙이라 1성당 실질 공격력 +4 상당이지만, 표현은 주스탯+공격력으로 나눈다.
	-- 표시용 복제본(EnhancementManager.GetStarforceStatText / UIEquipInventoryManager.BuildTooltipStatsText)과
	-- 반드시 함께 맞춰야 한다.
	@ExecSpace("ClientOnly")
	method table CalcStarforceStats(integer stars)
		local t = {str = 0, dex = 0, int = 0, luk = 0, atk = stars * 3}
		local main = self:GetMainStatName()
		local mainVal = stars * 4
		if main == "STR" then t.str = mainVal
		elseif main == "DEX" then t.dex = mainVal
		elseif main == "INT" then t.int = mainVal
		else t.luk = mainVal end
		return t
	end

	-- Parse n-th pipe-delimited field as number (0 if missing or non-numeric)
	@ExecSpace("ClientOnly")
	method number ParseFieldNum(string s, integer n)
		local v = self:GetField(s, n)
		return tonumber(v) or 0
	end

	-- Return the n-th pipe-delimited field (1-indexed); "" if out of range
	@ExecSpace("ClientOnly")
	method string GetField(string s, integer n)
		local count = 0
		local last  = 1
		local slen  = string.len(s)
		local i     = 1
		while i <= slen do
			if string.sub(s, i, i) == "|" then
				count += 1
				if count == n then return string.sub(s, last, i - 1) end
				last = i + 1
			end
			i += 1
		end
		count += 1
		if count == n then return string.sub(s, last) end
		return ""
	end

end
