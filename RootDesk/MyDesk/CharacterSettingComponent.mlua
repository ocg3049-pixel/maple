    @ExecSpace("ClientOnly")
    method void CacheDemoClip(string ruid)
        -- Load once during job preparation; playback never waits for a resource.
        self._T.demoClipCache=self._T.demoClipCache or {}
        if self._T.demoClipCache[ruid]~=nil then return end
        local clip=_ResourceService:LoadAnimationClipAndWait(ruid)
        if clip==nil or not clip.IsLoadComplete then return end
        local frames={} local duration=0
        for _,frame in ipairs(clip.Frames:ToTable()) do
            local sprite=frame.FrameSprite
            duration=duration+math.max(.001,frame.Delay)
            table.insert(frames,{ruid=sprite.RUID,finish=duration,visible=sprite.Width>1 and sprite.Height>1,width=sprite.Width,height=sprite.Height,dx=frame.Offset.x,dy=frame.Offset.y})
        end
        self._T.demoClipCache[ruid]={frames=frames,duration=duration}
    end

    @ExecSpace("ClientOnly")
    method void DemoClipEffect(integer slot, string ruid, number x, number y, number scale, number age, boolean flip, string key)
        -- Sample the complete clip on one clock. GUI native clips can stall on frame zero.
        -- NativeSize owns the sprite pivot; only the clip offset belongs in UI coordinates.
        local clip=(self._T.demoClipCache or {})[ruid]
        if clip==nil or age<0 or age>=clip.duration then return end
        for i,frame in ipairs(clip.frames) do
            if age<frame.finish then
                if frame.visible then
                    self:DemoEffect(slot,frame.ruid,x+(flip and -frame.dx or frame.dx)*scale,y+frame.dy*scale,scale,age,clip.duration,flip,0,2147483647,1,key..":"..tostring(i))
                    self._T.demoClipLastFrames=self._T.demoClipLastFrames or {}
                    self._T.demoClipLastFrames[slot]=i
                end
                return
            end
        end
    end



    @ExecSpace("ClientOnly")
    method void RenderJobDemo(number delta)
        -- Render the introduction entirely in UI; no camera switching or GPU readbacks.
        if self._T.demoNodes==nil then
            local nodes={fx={},enemy={},damage={}}
            nodes.actor=self:CreationUI("CreationBook/Demo/Scene/Actor")
            for i=1,52 do nodes.fx[i]=self:CreationUI("CreationBook/Demo/Scene/Fx"..tostring(i)) end
            for i=1,4 do
                nodes.enemy[i]=self:CreationUI("CreationBook/Demo/Scene/Enemy"..tostring(i))
                nodes.enemy[i].UITransformComponent.UIScale=Vector3(0.55,0.55,1)
            end
            for i=1,8 do nodes.damage[i]=self:CreationUI("CreationBook/Demo/Scene/Damage"..tostring(i)) end
            nodes.hp=self:CreationUI("CreationBook/Demo/Scene/DummyHp/Fill")
            self._T.demoNodes=nodes
            _UILogic:SetSiblingIndex(self:CreationUI("CreationBook/Demo/Scene/Dim").UITransformComponent,3)
            -- The introduction keeps one unchanging backdrop, including during buffs and ultimates.
            self:CreationUI("CreationBook/Demo/Scene/Dim").Enable=false
            self:CreationUI("CreationBook/Demo/Scene/Backdrop").Enable=true
            self:CreationUI("CreationBook/Demo/Scene").CanvasGroupComponent.GroupAlpha=1
            self:CreationUI("CreationBook/Demo/Scene/NativeDamage").Enable=false
            for i,name in ipairs({"Backdrop","Soil","Grass","GrassLight"}) do
                _UILogic:SetSiblingIndex(self:CreationUI("CreationBook/Demo/Scene/"..name).UITransformComponent,i)
            end
            for _,label in ipairs(nodes.damage) do _UILogic:SetSiblingIndex(label.UITransformComponent,1000000) end
            if Environment:IsMakerPlay() then log("[VRF][CreationDemo] UI stage visible; screen captures=0") end
            self._T.demoData=self:JobDemoData()
            self._T.demoFxKeys={}
        end
        local player=_UserService.LocalPlayer
        if not isvalid(player) then return end
        local attack=player:GetComponent("script.PlayerAttack")
        if not isvalid(attack) then return end
        local nodes=self._T.demoNodes
        local job=self.jobIdx
        local generation=self._T.demoGeneration or 0
        local spec=self._T.demoData[job]
        if spec==nil then return end
        if self._T.demoJob~=job then
            self._T.demoPreparing=true
            _ResourceService:PreloadAsync({spec.fx,"c9c6022d09854016b0c7f8422441ba2a","8e280ed43a29449287fc7a75e8d2e439"},function(result) end)
            self:StopDemoAudio()
            self._T.demoJob=job
            for _,fx in ipairs(nodes.fx) do fx.Enable=false end
            for _,ally in ipairs(self._T.demoAllies or {}) do ally.Enable=false end
            self._T.demoUltimateAt=nil self._T.demoUltimateJob=nil self._T.demoShot=nil self._T.demoUltimateHits={} self._T.demoTiles={}
            self._T.demoStageKey=nil self._T.demoFxKeys={}
            self._T.demoTimeline=self:DemoTimeline(job)
            self._T.demoCycle=-1
            self._T.demoStarProjectiles={}
            self._T.demoSounds={}
            self._T.demoSummons={}
            self._T.demoPartner=false
            self._T.demoAmhaengAt=nil
            self._T.demoAwake=false
            self._T.demoCombo=false
            self._T.demoTime=0
            self._T.demoPendingDelta=0
            self._T.demoMotionKey=nil
            self._T.demoDamageSlots={}
            self._T.demoHp=100000
            self._T.demoHitCount=0
            self._T.demoHitKeys={}
            self._T.demoLastHit=-10
            self._T.demoStageKey=nil
            self._T.demoChargeFrames={}
            self._T.demoChargeTrails={}
            self._T.demoSavagePoses=attack:GetSavageBlowPoses()
            if job==7 or job==8 then
                self._T.demoBirdClips=self._T.demoBirdClips or {}
                local clips=job==7 and {"1137e890f2e444bebfe4c51be7893f89","c5e8473026df4b0491f3ceb2af224af5","e08387d34c1c43d6a895207f3608472b"} or {"65314ea68ace41368e6883772510840c","922fa176488740c0b4c74fdd30d45f33","a09d9772cc4c4cecb4138862b36d089e"}
                for _,ruid in ipairs(clips) do
                    if self._T.demoBirdClips[ruid]==nil then
                        local clip=_ResourceService:LoadAnimationClipAndWait(ruid)
                        if clip~=nil and clip.IsLoadComplete then
                            local frames=clip.Frames:ToTable() local duration=0
                            for _,frame in ipairs(frames) do duration=duration+math.max(.01,frame.Delay) end
                            self._T.demoBirdClips[ruid]={frames=frames,duration=duration}
                        end
                    end
                end
            end
            if job==7 then
                local clip=_ResourceService:LoadAnimationClipAndWait("abe88a701a094181b44c8aa9746a1cd7")
                if clip~=nil and clip.IsLoadComplete then self._T.demoChargeFrames[1]=clip.Frames:ToTable() end
            end
            if job==2 then for mode=1,4 do
                self._T.demoChargeTrails[mode]={}
                for _,motion in ipairs({"swingO1","swingO2","swingO3","swingOF","stabOF"}) do self._T.demoChargeTrails[mode][motion]=attack:GetChargeBlowTrailFrames(mode,motion) end
            end end
            self._T.demoFxKeys={}
            _DecoWindowManager:ApplyCostumeSnapshot(nodes.actor.CostumeManagerComponent,self:JobDemoAppearance())
            self:CreationUI("CreationBook/Title").TextGUIRendererComponent.Text=self:GetSelectedJobName().." · 4차"
            self:CreationUI("CreationBook/Demo/Skill").TextGUIRendererComponent.Text=spec.name
            self:CreationUI("CreationBook/Footer").TextGUIRendererComponent.Text=spec.note
            if job==6 then self:CacheDemoFireDemon() end
            if job==4 then self._T.demoTiles=attack:GetGenesisTileClips()
            elseif job==5 then self._T.demoTiles=attack:GetBlizzardTileClips()
            elseif job==6 then self._T.demoTiles=attack:GetMeteorTileClips() end
            if job>=4 and job<=6 then
                self:CacheDemoClip("6cf8c9dcbdf94d539a8d6afe1ef57281")
                for _,clip in ipairs(self._T.demoTiles) do
                    clip.duration=attack:GetSnipingFrameRangeDuration(clip.ruid,0,clip.frames-1)
                    clip.hitDelay=attack:GetSnipingFrameRangeDuration(clip.ruid,0,clip.hitFrame-1)
                end
                self._T.demoAngelDuration=attack:GetSnipingFrameRangeDuration("3c075a252a75471aa2afb46284a92b18",0,31)
                self._T.demoAngelHit=attack:GetSnipingFrameRangeDuration("3c075a252a75471aa2afb46284a92b18",0,11)
            end
            if job==1 then self:CacheDemoClip("1c29e2f0793a48eb8aa40f697b93963d") end
            if job==2 then self:CacheDemoClip("1de1c87ae2ed443184844dc0ea1e831e") end
            if job==3 then
                self:CacheDemoClip("6337b66c57a947e7b2cda8bbf8697094")
                self:CacheDemoClip("5468cadd2f60428e925bc368968e1a1e")
            end
            if job==4 then
                self._T.demoShiningFrames={attack:BuildShiningRayEffectFrames(),attack:BuildShiningRaySineffectFrames(),attack:BuildShiningRayHitFrames()}
                local preload={}
                for _,frames in ipairs(self._T.demoShiningFrames) do for _,f in ipairs(frames) do table.insert(preload,f.ruid) end end
                _ResourceService:PreloadAsync(preload,function(result) end)
                for _,ruid in ipairs({"f0035d3b88da4c9a91689b9db9c6bf7a","1c434f7cecf94e1cb16b68ee0079b01d","3c075a252a75471aa2afb46284a92b18","841bc14615dd48a49e247f7b3bd75ed8"}) do self:CacheDemoClip(ruid) end
                for _,clip in ipairs(self._T.demoTiles) do self:CacheDemoClip(clip.ruid) end
            end
            if job==5 then
                self:CacheDemoClip("96b261657b0c4aa792bd6f3e7d6c6681")
                for _,clip in ipairs(self._T.demoTiles) do self:CacheDemoClip(clip.ruid) end
            end
            if job==7 then self:CacheDemoClip("028a2e518e6c4713ad7300684d4a39d2") end
            if job==7 then
                self._T.demoSnipingIntro={}
                for stage=0,2 do self._T.demoSnipingIntro[stage]=attack:GetSnipingFrameRangeDuration(attack:GetSnipingChargeRUID(stage),0,12) end
            end
            if job==8 then self._T.demoPrepare=attack:GetHurricanePrepareDuration() end
            if job==2 then self._T.demoCharge=attack:GetChargeBlowTrailFrames(4,"swingT2") end
            -- Resolve ally costumes before the demo clock starts, not during an attack.
            if job==2 or job==4 or job==10 then
                self._T.demoAllies=self._T.demoAllies or {}
                self._T.demoAllyLooks=self._T.demoAllyLooks or {}
                local jobs=job==4 and {10,8,3} or {job==2 and 8 or 10}
                for i=1,4 do self._T.demoAllies[i]=self:CreationUI("CreationBook/Demo/Scene/Ally"..tostring(i)) end
                for i,allyJob in ipairs(jobs) do
                    local ally=self._T.demoAllies[i]
                    _DecoWindowManager:ApplyCostumeSnapshot(ally.CostumeManagerComponent,self:JobDemoAppearanceFor(allyJob))
                    if generation~=(self._T.demoGeneration or 0) then return end
                    self._T.demoAllyLooks[i]=tostring(job)..":"..tostring(allyJob)
                end
            end
            self._T.demoSpearPoses=attack:GetSpearBurstPoses()
            for _,slot in ipairs({23,24,25,26,44,45,46}) do _UILogic:SetSiblingIndex(nodes.fx[slot].UITransformComponent,4) end
            _UILogic:SetSiblingIndex(nodes.fx[10].UITransformComponent,4)
            if job>=4 and job<=6 then
                _UILogic:SetSiblingIndex(nodes.fx[1].UITransformComponent,4)
                _UILogic:SetSiblingIndex(nodes.fx[2].UITransformComponent,5)
            else
                _UILogic:SetSiblingIndex(nodes.fx[1].UITransformComponent,99)
                _UILogic:SetSiblingIndex(nodes.fx[2].UITransformComponent,99)
            end
            if Environment:IsMakerPlay() then log("[CreationBook] native replay job="..tostring(job).." skill="..spec.name) end
        end
        self._T.demoPreparing=false
        if self.jobIdx~=job or generation~=(self._T.demoGeneration or 0) then return end
        local scene=self:CreationUI("CreationBook/Demo/Scene")
        if scene.CanvasGroupComponent.GroupAlpha~=1 then scene.CanvasGroupComponent.GroupAlpha=1 end
        if self._T.demoStageKey==nil then self._T.demoPendingDelta=0 end
        self._T.demoTime=self._T.demoTime+delta
        local timeline=self._T.demoTimeline
        local cycle=math.floor(self._T.demoTime/timeline.length)
        local t=self._T.demoTime%timeline.length
        if self._T.demoCycle~=cycle then
            self:StopDemoAudio()
            self._T.demoCycle=cycle self._T.demoHp=1000000 self._T.demoPetHit=nil
            self._T.demoStarProjectiles={}
            self._T.demoUltimateAt=nil self._T.demoShot=nil self._T.demoSupportStart=nil self._T.demoBehind=false self._T.demoClose=false self._T.demoComboCount=0
            self._T.demoDemonHit=nil self._T.demoDragonHit=nil self._T.demoWyvernHit=nil self._T.demoAllyHit={}
            self._T.demoMistPopAt=nil self._T.demoMistPopHits={}
            self._T.demoAmhaengAt=nil self._T.demoFieldMode=nil self._T.demoCurseAt=nil self._T.demoShockAt=nil
            self._T.demoSummons={} self._T.demoPartner=false self._T.demoAwake=false self._T.demoCombo=false
        end
        local step=timeline.steps[#timeline.steps]
        local stepIndex=#timeline.steps
        for i,row in ipairs(timeline.steps) do if t<row.start+row.duration then step=row stepIndex=i break end end
        local age=(t-step.start)*step.rate
        local segment=step.segment
        local key=tostring(job)..":"..tostring(cycle)..":"..tostring(stepIndex)
        if self._T.demoStageKey~=key then
            self._T.demoStageKey=key
            self:BeginDemoStep(step,job)
            self:CreationUI("CreationBook/Footer").TextGUIRendererComponent.Text=spec.note
        end
        local x=(job<=3 or job==10) and (self._T.demoClose and 4 or -60) or -112
        if job==10 and self._T.demoBehind then x=130 end
        local floorY=-57
        local scale=0.55
        nodes.actor.UITransformComponent.anchoredPosition=Vector2(x,floorY)
        nodes.actor.UITransformComponent.UIScale=Vector3(scale,scale,1)
        nodes.actor.AvatarGUIRendererComponent.Color=Color.white
        nodes.actor.AvatarGUIRendererComponent.FlipX=not (job==10 and self._T.demoBehind)
        self._T.demoFxUsed={}
        if job==2 and step.kind=="main" then self._T.demoCharge=self._T.demoChargeTrails[(step.index-1)%3+1] end
        local hit=false
        if self:DemoSpecial(step,age,x,floorY,scale,key,attack) then
            -- Buffs, summons and finishing attacks have their own native presentation.
        elseif segment>0 then
            hit=self:DemoFollowup(job,segment,age,x,floorY,scale,key)
        elseif age<0 then
            self:DemoMotion("stand2",1,0,2147483647,key..":idle")
        elseif job==1 then
            if age<0.40625 then self:DemoMotion("swingT3",1.6,0,2147483647,key..":first")
            elseif age<1.106 then self:DemoMotion("swingTF",1/0.9326923,0,2147483647,key..":finish")
            else self:DemoMotion("stand2",1,0,2147483647,key..":rest") end
            self:DemoClipEffect(1,spec.fx,x,floorY,scale,age,true,key..":arc")
            hit=(age>0.34375 and age<0.49) or (age>0.919 and age<1.12)
        elseif job==2 then
            local mode=(step.index-1)%3+1
            local final=age>=0.65
            local action=final and (step.index%2==0 and "stabOF" or "swingOF") or ("swingO"..tostring((step.index-1)%3+1))
            self:DemoMotion(action,1,0,2147483647,key..":"..action)
            local a=age-(final and 1.1 or .45)
            local frames=self._T.demoChargeTrails[mode][action]
            if frames~=nil and a>=0 and a<#frames*.05 then
                local f=math.min(#frames,math.floor(a/.05)+1)
                self:DemoEffect(1,frames[f],x+75*scale,floorY+35*scale,scale,a,#frames*.05,not attack:IsChargeBlowTrailMirrored(mode,attack:GetChargeBlowTrailRow(action)),0,2147483647,1,key..":"..action..":"..tostring(f))
                nodes.fx[1].SpriteGUIRendererComponent.FlipY=attack:IsChargeBlowTrailFlippedY(action)
                nodes.fx[1].SpriteGUIRendererComponent.Color=Color(1,1,1,.75)
                nodes.fx[1].UITransformComponent.UIScale=Vector3(scale,scale*attack:GetChargeBlowTrailScaleY(action),1)
            end
        elseif job==3 then
            self:DemoEffect(10,"8da209f377f249f292e1d0c50c928683",x-35.3*scale,floorY+100.5*scale,scale,age,0.9,true,0,2147483647,1,key..":wing")
            if age>=0 and age<0.9 then nodes.fx[10].SpriteGUIRendererComponent.Color=Color(1,1,1,math.min(1,(0.9-age)/0.45)) end
            local ca=age-0.35
            if ca>=0 and ca<0.56 then
                local cr=ca<0.28 and "5b1685eba9af484cbcde8015ca7398f6" or "3e2d1d048bb74bec8b9bd8966cde41ad"
                self:DemoEffect(11,cr,x+20*scale,floorY+35*scale,scale*(0.75+1.01*ca/0.56),ca,0.56,true,0,2147483647,1,key..":circle"..tostring(ca>=0.28))
                nodes.fx[11].SpriteGUIRendererComponent.Color=Color(1,1,1,0.6*math.min(1,(0.56-ca)/0.15))
            end
            if age<0.72 then
                local p=self._T.demoSpearPoses[math.min(5,math.floor(age/0.144)+1)]
                self:DemoMotion(p.action,0.001,p.frame,p.frame+1,key..":pose"..tostring(math.floor(age/0.144)))
            else self:DemoMotion("stand2",1,0,2147483647,key..":rest") end
            local ruids={"9229298b79a64868b7cee06dc198edec","38361a0c587544dc8b6074920475db82","38922d3cb17f44bcaddf7d6269e5d6d2"}
            local ox={108,119,117}
            local oy={28,1,37}
            for i=1,3 do
                local a=age-(i+1)*0.144
                self:DemoEffect(i,ruids[i],x+ox[i]*scale,floorY+oy[i]*scale,scale,a,0.26,true,0,2147483647,1,key..":head"..tostring(i))
                if a>=0 then nodes.fx[i].SpriteGUIRendererComponent.Color=Color(1,1,1,math.min(1,math.max(0,(0.26-a)/0.14))) end
                if a>=0 and a<0.12 then hit=true end
            end
        elseif job>=4 and job<=6 then
            -- These skills keep the caster standing in PlayerAttack, with effects behind them.
            self:DemoMotion("stand1",1,0,2147483647,key..":cast")
            local land=job==4 and 1.6 or (job==5 and 2.3 or 3.146)
            hit=age>=land and age<land+0.25
        elseif job==7 then
            if age<1.2 then self:DemoMotion("shoot2",0.001,1,2,key..":charge")
            elseif age<1.95 then self:DemoMotion("shoot2",1,0,2147483647,key..":shot")
            else self:DemoMotion("stand2",1,0,2147483647,key..":rest") end
            if age>=0 and age<1.2 then
                local stage=1
                local frames=self._T.demoChargeFrames[1]
                if frames~=nil and #frames>0 then
                    local fi=math.min(#frames,5)
                    self:DemoEffect(1,frames[fi].FrameSprite.RUID,x,floorY+20*scale,scale*0.7,age,1.2,true,0,2147483647,1,key..":charge"..tostring(stage)..":"..tostring(fi))
                end
            end
            self:DemoEffect(2,"abe88a701a094181b44c8aa9746a1cd7",x,floorY+20*scale,scale*0.7,age-1.2,1.6,true,4,2147483647,1,key..":release")
            self:DemoEffect(3,spec.fx,x+(age-1.2)*660,floorY+35*scale,scale,age-1.2,0.4,true,0,2147483647,1,key..":arrow")
            hit=age>1.38 and age<1.66
        elseif job==8 then
            if age<3 then self:DemoMotion("shoot1",1,0,2147483647,key..":shot"..tostring(math.floor(age/0.5)))
            else self:DemoMotion("stand2",1,0,2147483647,key..":rest") end
            local prep=self._T.demoPrepare or 0.6
            self:DemoEffect(1,"4423619c1a49476697b459e49bddb575",x,floorY+15*scale,scale,age,prep,true,0,2147483647,1,key..":prepare")
            self:DemoEffect(2,"c47d84d453d0493c904046cc1d4ba9f2",x,floorY+15*scale,scale,age-prep,math.max(0,3-prep),true,0,2147483647,1,key..":hold")
            nodes.fx[2].SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
            for i=1,5 do
                local shot=math.floor(age/0.1)-(i-1)
                local a=age-shot*0.1
                if shot>=0 and shot<30 then self:DemoEffect(i+2,spec.fx,x+a*495,floorY+35*scale,scale,a,0.4,true,0,2147483647,1,key..":arrow"..tostring(shot)) end
            end
            hit=age>0.2 and age<3.35
        elseif job==9 then
            if age<0.85 then self:DemoMotion("swingO"..tostring(cycle%3+1),1,0,2147483647,key..":throw")
            else self:DemoMotion("stand1",1,0,2147483647,key..":rest") end
            self:DemoEffect(1,"db19194fc2804ac887c0d5add5cf28cd",x+45*scale,floorY+35*scale,scale*0.3,age,1,true,0,2147483647,1,key..":cast")
        elseif job==10 then
            self:DemoMotion("stand1",1,0,2147483647,key..":stand")
            local frames=self:DemoBoomerangFrames()
            if age<0.9 then
                local f=math.min(15,math.floor(age/0.06)+1)
                local row=frames[f]
                self:DemoEffect(1,row[1],x+(row[4]-row[2]/2)*scale,floorY+(row[5]-row[3]/2)*scale,scale,age,0.9,true,0,2147483647,1,key..":step"..tostring(f))
            end
            hit=age>0.3 and age<0.75
        end
        self:UpdateDemoDamage(job,segment,age,key,delta)
        local actorPos=nodes.actor.UITransformComponent.anchoredPosition
        self:DemoPersistent(step,age,actorPos.x,actorPos.y,scale,key,attack)
        if job==9 then self:DemoStarProjectiles(floorY,scale) end
        for i=1,52 do if not self._T.demoFxUsed[i] and nodes.fx[i].Enable then nodes.fx[i].Enable=false end end
        self:UpdateDemoDamageLabels()
    end




















