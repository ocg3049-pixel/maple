			{ "0f60840e17be428a9fab9f40c174bfab", 0.110, 0.805 },
		},attack={
			{ "56b30c245ba74e95b6cff98bf0589bf4", 0.085, 0.920 },
			{ "afacf4bb28d345c6819738f045744e0f", -0.220, 0.750 },
