    @ExecSpace("ClientOnly")
    method void DemoMotion(string action, number rate, integer first, integer last, string key)
        -- Use the same raw body actions and frame ranges as PlayerAttack.
        if self._T.demoMotionKey==key then return end
        local body=self._T.demoNodes.actor.AvatarGUIRendererComponent:GetBodyEntity()
        if not isvalid(body) then return end
        self._T.demoAction=action
        self._T.demoActionRate=rate*(self._T.demoStep and self._T.demoStep.rate or 1)
        self._T.demoActionFirst=first self._T.demoActionLast=last
        body:SendEvent(ActionStateChangedEvent(action,action,rate*(self._T.demoStep and self._T.demoStep.rate or 1),SpriteAnimClipPlayType.Onetime,first,last))
        self._T.demoMotionKey=key
    end

    @ExecSpace("ClientOnly")
    method void DemoEffect(integer index, string ruid, number x, number y, number scale, number age, number life, boolean flip, integer first, integer last, number rate, string key)
        -- NativeSize preserves each combat clip's original proportions and pivot.
        if self._T.demoRenderGeneration~=(self._T.demoGeneration or 0) then return end
        local fx=self._T.demoNodes.fx[index]
        -- Expired effects must not hide a slot already claimed by another effect this frame.
        if age<0 or age>=life then return end
        local spr=fx.SpriteGUIRendererComponent
        if spr.PreserveSprite~=PreserveSpriteType.NativeSize then spr.PreserveSprite=PreserveSpriteType.NativeSize end
        if self._T.demoFxKeys[index]~=key then
            -- Changing the image starts its player; only toggle for a repeated same clip.
            if spr.ImageRUID.DataId==ruid then fx.Enable=false
            else spr.ImageRUID=DataRef(ruid) end
            spr.StartFrameIndex=first
            spr.EndFrameIndex=last
            spr.PlayRate=rate
            spr.AnimClipPlayType=SpriteAnimClipPlayType.Onetime
            spr.FlipX=flip
            spr.FlipY=false
            fx.UITransformComponent.UIRotation=Vector3.zero
            spr.Color=Color.white
            self._T.demoFxKeys[index]=key
        end
        local tr=fx.UITransformComponent
        local pos=tr.anchoredPosition
        if pos.x~=x or pos.y~=y then tr.anchoredPosition=Vector2(x,y) end
        local size=tr.UIScale
        if size.x~=scale or size.y~=scale then tr.UIScale=Vector3(scale,scale,1) end
        if not fx.Enable then fx.Enable=true end
        self._T.demoFxUsed[index]=true
    end

