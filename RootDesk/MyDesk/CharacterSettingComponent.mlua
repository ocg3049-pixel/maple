    @ExecSpace("ClientOnly")
    method table JobDemoAppearance()
        return self:JobDemoAppearanceFor(self.jobIdx)
    end


    @ExecSpace("ClientOnly")
    method void SelectCreationTab(string tab)
        -- Keep name, appearance and dye selections while changing the book's contents.
        if _LoginFlow.phase~="create" and _LoginFlow.phase~="job" then return end
        if _AppearanceColorPicker:BlocksInput() then return end
        if tab~="hair" and tab~="face" and tab~="job" then return end
        if _LoginFlow.phase=="job" then _LoginFlow:ShowPhase("create",false) end
        self:ResetDemoPlayback()
        self._T.creationTab=tab
        self._T.bookPhase=nil
        if tab~="job" then
            self._T.galleryKind=tab
            self._T.galleryPage=math.floor(((tab=="hair" and self.hairIdx or self.faceIdx)-1)/8)+1
        end
        self:UpdateCreation(0)
        _UIAudio:Play("Tab")
        if Environment:IsMakerPlay() then log("[CreationBook] tab="..tab) end
    end


    @ExecSpace("ClientOnly")
    method string DemoFollowupName(integer job, integer segment)
        -- Name the exact follow-up whose effects are replayed below.
        if job==1 or job==3 then return segment==1 and "파워 스트라이크" or "슬래쉬 블래스트" end
        if job==2 then return segment==1 and "아이스 차지 블로우" or "파이어 차지 블로우" end
        if job==4 then return segment==1 and "홀리 애로우" or "매직 클로" end
        if job==5 then return segment==1 and "썬더볼트" or "매직 클로" end
        if job==6 then return segment==1 and "파이어 애로우" or "매직 클로" end
        if job==7 then return segment==1 and "아이스 샷" or "애로우 블로우" end
        if job==8 then return segment==1 and "파이어 샷" or "애로우 블로우" end
        if job==9 then return "럭키 세븐" end
        return "새비지 블로우"
    end

    @ExecSpace("ClientOnly")
    method boolean DemoFollowup(integer job, integer segment, number age, number x, number y, number scale, string key)
        -- Reuse the in-game skill's action, art, offsets and release order in the UI stage.
        local active=age>=0 and age<((job==7 or job==8) and 1.5 or 0.85)
        local hit=age>=0.55 and age<0.75
        if not active then self:DemoMotion("stand2",1,0,2147483647,key..":rest") return false end
        if job==1 or job==3 then
            self:DemoMotion("swingT2",1,0,2147483647,key..":swing")
            if segment==2 then self:DemoEffect(1,"44c1d14578e24c639e480f54b156a8a2",x,y,scale,age,0.8,true,0,2147483647,1,key..":cast") end
            local ruid=job==3 and "e46fe5e970f84e3f8f75ea914b2e3bf7" or "447033cc51594e20a25d15bfe2995d2e"
            self:DemoEffect(2,ruid,x+10*scale,y,scale,age,0.65,true,0,2147483647,1,key..":swingfx")
            self:DemoEffect(3,"dad03b3a528348bf98295b01edd621a4",65,y+20,scale,age-0.55,0.5,true,0,2147483647,1,key..":hit")
        elseif job==2 then
            self:DemoMotion("swingT2",1,0,2147483647,key..":swing")
            local a=age-0.45
            local mode=segment==1 and 2 or 1
            local frames=self._T.demoChargeTrails[mode]
            if frames~=nil and a>=0 and a<0.2 then
                local fi=math.min(#frames,math.floor(a/0.05)+1)
                self:DemoEffect(1,frames[fi],x+75*scale,y+35*scale,scale,a,0.2,true,0,2147483647,1,key..":trail"..tostring(fi))
            end
        elseif job>=4 and job<=6 then
            self:DemoMotion((job==6 and segment==1) and "shoot1" or ("swingO"..tostring(segment+1)),1,0,2147483647,key..":cast")
            if segment==2 then
                self:DemoEffect(1,"2a0d72e836fb4862aae83087035f3d2a",x,y,scale,age,0.8,true,0,2147483647,1,key..":start")
                for i=1,2 do self:DemoEffect(i+1,"598d2d1859e84eaab18ae460a0a1e0a4",65,y+20,scale,age-0.5-(i-1)*0.1,0.45,true,0,2147483647,1,key..":hit"..tostring(i)) end
            elseif job==5 then
                self:DemoEffect(1,"7b1fbc817b9a478e9f5c384dfc1a7176",x+8*scale,y,scale,age,0.8,true,0,2147483647,1,key..":cast")
                self:DemoEffect(2,"bb8d0c3c8b9940dfa5e4678bc642fa8d",65,y+30*scale,scale,age-0.55,0.65,false,0,2147483647,1,key..":hit")
            else
                local projectile=job==4 and "d8275b5454a84af580d7dc865ae7ada0" or "bf1fda424a06413d9617789715d0470e"
                if job==6 then self:DemoEffect(1,"f3d1726f78be40beae0b32960858f132",x,y,scale,age,0.8,true,0,2147483647,1,key..":firecast") end
                if job==4 then
                    local frames={"d9e3726f83b648cbb235ff2ec77f2904","ffd0471aa2654f0f83d52f9437a69451","cdd3bb9a395644a7bf44b52751cf695a","b3b8ccb8e5a247c28402d470aadc379c","c96717e1d97042f589ea2da562525ad4","ffdc4a624af340e093d6ebee921349f1","801d3ae9a54e4b6d965ac2ba5565cfde"}
                    local fi=math.min(7,math.floor(age/0.1)+1)
                    self:DemoEffect(1,frames[fi],x+31.5*scale,y+31.5*scale,scale,age,0.7,true,0,2147483647,1,key..":cast"..tostring(fi))
                end
                self:DemoEffect(2,projectile,x+(age-0.3)*660,y+30*scale,scale,age-0.3,0.27,true,0,2147483647,1,key..":arrow")
            end
        elseif job==7 or job==8 then
            self:DemoMotion(job==7 and "shoot2" or "shoot1",1,0,2147483647,key..":shot")
            local ruid="ac868a4ac45c4489a3c2e60ad3dd9454"
            if segment==1 then
                if job==8 then
                    self:DemoEffect(1,"bde5b9e6e2c2462ab596f0f287b06c62",x,y,scale,age,1.5,true,0,2147483647,1,key..":fire")
                    ruid="19a71cea2102460ea0ca9d431ce601ea"
                else
                    ruid="7d360ab4c5ef4690bbebd54ff766cc5b"
                    local frames={"b403326e82304598873d37bbf57c6b93","450dda0f413945faa44fb2135082ef05","73aa5e24acfd4b66b91829f779099365","e67191d8816d478a880550c3a58d9f8f","3f29477d4edb4ae5a2def02d69bcd587","bd1609c01d4b40a5b13bf8455c9a22f7","f9e8423d4d514dcfa88f42fe5867d8a3","4ece98754816484dace1322e13042151","249df88b783c492a8d82e862780719fd"}
                    local fi=math.min(9,math.floor(age/0.11)+1)
                    self:DemoEffect(1,frames[fi],x,y+35*scale,scale,age,1.15,false,0,2147483647,1,key..":ice"..tostring(fi))
                    self._T.demoNodes.fx[1].SpriteGUIRendererComponent.Color=Color(1,1,1,math.min(1,math.max(0,(1.15-age)/.15)))
                    self:DemoEffect(3,"cb01592c6d3746a2a3ca161044896c15",x,y+35*scale,scale*(1+.15*math.min(1,age/.5)),age,.5,false,0,2147483647,1,key..":iceSpecial")
                    self._T.demoNodes.fx[3].SpriteGUIRendererComponent.Color=Color(1,1,1,.9*math.min(1,math.max(0,(.5-age)/.3)))
                end
            end
            self:DemoEffect(2,ruid,x+(age-0.25)*800*scale,y+35*scale,scale,age-0.25,(65-x)/(800*scale),true,0,2147483647,1,key..":arrow")
        elseif job==9 then
            self:DemoMotion("swingO"..tostring(segment),1,0,2147483647,key..":throw")
            self:DemoEffect(1,"0ae88fa494e743158da6ddb81c0c55f2",x,y+12*scale,scale,age,0.8,true,0,2147483647,1,key..":cast")
            for i=1,2 do
                local a=age-0.3-(i-1)*0.1
                self:DemoEffect(i+1,"bde5998c85f842dfaec3d0b1a886b5b3",x+a*700,y+35*scale,scale,a,0.255,true,0,2147483647,1,key..":star"..tostring(i))
            end
        else
            local fi=math.min(8,math.floor(age/0.09)+1)
            local pose=self._T.demoSavagePoses[math.min(7,fi)]
            self:DemoMotion(pose.action,0.001,pose.frame,pose.frame+1,key..":pose"..tostring(fi))
            local frames={"0c10c7f12e7445c2a840c593fbfc9513","c517f7f05a844af580b80bf420743ce8","3e556b633f4f4b358ae54cf4add11fd7","ed2c5cd4ceea4090813802f4143b3cfc","d99ee75c6cb041b48067b61fbb8734a0","4fa59e6d33d94917a8a4c9ea03745acf","f565ca85888249faad6eddf86992a486","61d7141ba8d047f4a2b8d514e64d3dfc"}
            self:DemoEffect(1,frames[fi],x+55*scale,y+45*scale,scale,age,0.72,false,0,2147483647,1,key..":savage"..tostring(fi))
            hit=age>0.18 and age<0.72
        end
        return hit
    end





    @ExecSpace("ClientOnly")
    method void DemoHit(number amount, boolean critical, integer lane)
        -- Separate repeated hits vertically, using the gameplay line spacing.
        self:DemoHitOffset(amount,critical,lane*.3)
    end

    @ExecSpace("ClientOnly")
    method void UpdateDemoDamage(integer job, integer segment, number age, string key, number delta)
        local step=self._T.demoStep
        local kind=step.kind
        local times={}
        if kind=="main" then
            if job==1 then times={0.344,0.919}
            elseif job==2 then times={0.45,1.1}
            elseif job==3 then times={0.288,0.432,0.576}
            elseif job>=4 and job<=6 then times={job==4 and 1.6 or (job==5 and 2.3 or 3.146)}

            elseif job==8 then for i=1,30 do times[i]=0.36+(i-1)*0.1 end
            elseif job==9 then times={} end
        elseif kind=="power" then times={0.45,1.1}
        elseif kind=="panic" then times={0.55}
        elseif kind=="roar" then times={1.5}
        elseif kind=="third" then times={.25+177/440}
        elseif kind=="snipe" then times={10.26}
        elseif kind=="assaulter" then times={0.8}
        elseif kind=="savage" then times={0.18,0.27,0.36,0.45,0.54,0.63}
        elseif kind=="assassinate" then for i=1,10 do times[i]=0.45+(i-1)*0.075 end
        elseif kind=="angel" then times={1.102}
        elseif kind=="shining" then times={1}
        elseif kind=="chain" then times={0.68}
        elseif kind=="iceDemon" then times={1.7}
        elseif kind=="fireDemon" then times={2.05}
        elseif kind=="fireArrow" then times={0.6}
        elseif kind=="explosion" then times={1}
        elseif kind=="strafe" then times={0.6,0.7,0.8,0.9} end
        for i,at in ipairs(times) do
            if age>=at and not self._T.demoHitKeys[i] then
                self._T.demoHitKeys[i]=true
                self._T.demoHitCount=self._T.demoHitCount+1
                local base=kind=="snipe" and 120000 or (kind=="panic" and 24000 or ((job>=4 and job<=6) and 18000 or 2400))
                local amount=math.floor(base*(0.9+(self._T.demoHitCount%7)*0.04))
                if job==2 and kind=="main" and i==1 then
                    local mode=(step.index-1)%3+1 local previous=self._T.demoFieldMode
                    if (previous==1 and mode==2) or (previous==2 and mode==1) then
                        self._T.demoCurseAt=self._T.demoTime self._T.demoFieldMode=nil
                    elseif (previous==1 and mode==3) or (previous==3 and mode==1) then
                        self._T.demoShockAt=self._T.demoTime self._T.demoFieldMode=nil
                    else self._T.demoFieldMode=mode self._T.demoFieldAt=self._T.demoTime end
                end
                if job==1 and (kind=="power" or kind=="main") and i==1 then
                    self._T.demoComboCount=math.min(10,(self._T.demoComboCount or 0)+1)
                    self._T.demoOrbBorn=self._T.demoOrbBorn or {}
                    self._T.demoOrbBorn[(self._T.demoComboCount-1)%5+1]=self._T.demoTime
                end
                local offset=(i-1)*.3
                if job==3 and kind=="main" then offset=(i-2)*.3 end
                if kind=="savage" then offset=-.2+(i-1)*(self._T.demoPartner and .5 or .3) end
                if kind=="assassinate" or (job==8 and kind=="main") then offset=0 end
                self:DemoHitOffset(amount,kind=="snipe" or kind=="panic",offset)
                if kind=="savage" and self._T.demoPartner then self:DemoHitOffset(math.floor(amount*.5),false,offset+.25) end
                local hitSound="d3205fdd08e34b68bc01292a997531ed"
                if job==4 then hitSound="039d09d0013640b182a7588ac2d34553"
                elseif job==5 then hitSound="3edd6d189b9b4bf1ac48162339848e36"
                elseif job==6 then hitSound="0500714fee8645bb9a4894535ea723b1"
                elseif job==7 or job==8 then hitSound="eb49560ca2a84e0585e0e83cd61c9dc6" end
                if kind=="chain" then hitSound="36187759ab2f4bc293aeb035e4ea8d73" end
                self:DemoSound(hitSound,false)
                if kind=="power" and i==2 then self:DemoSound("e0178f48602742c0bd8b295fdc27261c",false) end
                if kind=="assaulter" then self:DemoSound("bbb8c45c0d21491a97deb363a9d95e0c",false) end
            end
        end
        local nodes=self._T.demoNodes
        local flash=self._T.demoTime-self._T.demoLastHit<0.16
        local dummy=nodes.enemy[1]
        local ruid=flash and "8e280ed43a29449287fc7a75e8d2e439" or "c9c6022d09854016b0c7f8422441ba2a"
        if self._T.demoDummyRuid~=ruid then dummy.SpriteGUIRendererComponent.ImageRUID=DataRef(ruid) self._T.demoDummyRuid=ruid end
        dummy.SpriteGUIRendererComponent.Color=flash and Color(1,0.75,0.75,1) or Color.white
        nodes.hp.UITransformComponent.RectSize=Vector2(76*self._T.demoHp/1000000,5)
        nodes.damage[1].Enable=false
        if job==7 and kind=="snipe" and age<10 then
            local label=nodes.damage[1]
            label.Enable=true label.UITransformComponent.anchoredPosition=Vector2(-112+60*.55,-57+105*.55)
            label.UITransformComponent.RectSize=Vector2(40,18)
            label.TextGUIRendererComponent.FontSize=10
            label.TextGUIRendererComponent.FontColor=Color(1,1,.55,1)
            label.TextGUIRendererComponent.OutlineWidth=.12
            label.TextGUIRendererComponent.OutlineColor=Color(0,0,0,.85)
            label.TextGUIRendererComponent.Text=tostring(math.floor(age*10+.5)).."%"
        end
    end














    @ExecSpace("ClientOnly")
    method void ChangeGalleryPage(integer direction)
        local items=self._T.galleryKind=="face" and self:GetFaceItems() or self:GetHairItems()
        self._T.galleryPage=math.max(1,math.min(math.ceil(#items/8),(self._T.galleryPage or 1)+direction))
        self:DrawCreationGallery()
        _UIAudio:Play("Tab")
    end
    @ExecSpace("ClientOnly")
    method table DemoTimeline(integer job)
        local steps={}
        local function add(kind,label,duration,count,segment,rate)
            for i=1,(count or 1) do table.insert(steps,{kind=kind,label=label,duration=duration,segment=segment or 0,rate=rate or 1,index=i}) end
        end
        if job==9 or job==10 then add("haste","헤이스트",1.5,1,0,1) end
        if job==10 then add("clone","분신 소환",1.2,1,0,1) end
        add("booster","부스터",(job>=4 and job<=6) and 1.5 or 1.2,1,0,1)
        if job==1 then
            add("combo","콤보 어택",1.2,1,0,1)
            add("walk","허수아비 접근",0.65,1,0,1)
            add("power","파워 스트라이크 + 파이널 어택",1.0,10,1,1.55)
            add("panic","패닉",1.5,1,0,1)
            add("main","브랜디쉬",1.35,5,0,1)
        elseif job==2 then
            add("support","궁병지원",1.3,1,0,1)
            add("field","속성 필드",1.5,1,0,1)
            add("walk","허수아비 접근",0.65,1,0,1)
            add("main","차지 블로우 · 속성 필드",0.95,12,0,1.5)
        elseif job==3 then
            add("blood","드래곤 블러드",1.4,1,0,1)
            add("dragon","다크 드래곤 소환",1.3,1,0,1)
            add("wyvern","와이번 소환",1.2,1,0,1)
            add("mount","와이번 탑승 · 전진",2,1,0,1)
            add("dismount","하차",0.8,1,0,1)
            add("main","어드밴스드 스피어 버스터",1.2,3,0,1)
            add("roar","드래곤 로어",3.6,2,0,1)
        elseif job==4 then
            add("allies","도적 · 궁수 · 전사 소환",1.5,1,0,1)
            add("main","제네시스",4,1,0,1)
            add("angel","엔젤레이",1.15,5,0,1)
            add("shining","샤이닝레이",2.55,1,0,1)
            add("angel","엔젤레이",1.15,5,0,1)
        elseif job==5 then
            add("main","블리자드",4,1,0,1)
            add("iceDemon","아이스데몬",2.3,1,0,1)
            add("chain","체인 라이트닝",1,10,0,1)
        elseif job==6 then
            add("summon","엘퀴네스",1.5,1,0,1)
            add("main","메테오",4.5,1,0,1)
            add("fireDemon","파이어데몬",2.5,1,0,1)
            add("mist","포이즌 미스트",1.8,1,0,1)
            add("fireArrow","파이어 애로우",1.1,3,0,1)
            add("explosion","익스플로젼",2,1,0,1)
        elseif job==7 then
            add("summon","프리져",1.5,1,0,1)
            add("snipe","스나이핑 · 최대 차지",11.8,1,0,1)
            add("strafe","스트레이프",1.2,5,0,1)
            add("third","아이스 샷",2.6,1,1,1)
            add("snipe","스나이핑 · 최대 차지",11.8,1,0,1)
        elseif job==8 then
            add("summon","피닉스",1.5,1,0,1)
            add("third","파이어 샷",2.3,3,1,1)
            add("main","폭풍의 시",3.6,3,0,1)
        elseif job==9 then
            add("partner","쉐도우 파트너",1.3,1,0,1)
            add("stars","표창+ IV · 단일 대상",2,1,0,1)
            add("main","쿼드러플 스로우 · 단일 대상",0.77,5,0,1)
            add("awake","각성",1.7,1,0,1)
            add("main","각성 · 쿼드러플 스로우",0.2436,12,0,4.7619047619)
        elseif job==10 then
            add("partner","쉐도우 파트너",1.3,1,0,1)
            add("assaulter","어썰터",1.4,1,0,1)
            add("savage","새비지 블로우",1,5,1,1)
            add("smoke","연막탄",2.2,1,0,1)
            add("assassinate","암살",2.4,2,0,1)
        end
        add("rest","다시 시연합니다",(job>=4 and job<=6) and 5 or 1.5,1,0,1)
        local length=0
        for _,step in ipairs(steps) do step.start=length length=length+step.duration end
        return {steps=steps,length=length}
    end







    @ExecSpace("ClientOnly")
    method void DemoSound(string id, boolean loop)
        if id=="" then return end
        self._T.demoSounds=self._T.demoSounds or {}
        self._T.demoSounds[id]=true
        if loop then _GameAudio:PlayLoopSound(id,1) else _GameAudio:PlaySound(id,1) end
    end

    @ExecSpace("ClientOnly")
    method void StopDemoAudio()
        for id,_ in pairs(self._T.demoSounds or {}) do _GameAudio:StopSound(id) end
        self._T.demoSounds={}
        if self._T.demoDuck~=nil then _GameAudio:SetBGMVolume(self._T.demoDuck) self._T.demoDuck=nil end
        self._T.demoChargeSound=false
    end


    @ExecSpace("ClientOnly")
    method void BeginDemoStep(table step, integer job)
        self._T.demoHitKeys={}
        self._T.demoMaxDamageOffset=-100
        self._T.demoStep=step
        self._T.demoStepSound=false
        if step.kind=="third" then
            local drops={}
            for i=1,14 do table.insert(drops,{delay=_UtilLogic:RandomDouble()*(i<=4 and .35 or .3),ox=(_UtilLogic:RandomDouble()*2-1)*(i<=4 and 1.55 or 1.6),speed=i<=4 and (2+_UtilLogic:RandomDouble()*2)*1.1 or (5+_UtilLogic:RandomDouble()*3)*.33}) end
            self._T.demoShot={at=self._T.demoTime+.25+177/440,job=job,drops=drops}
        end
        local kind=step.kind
        if (job==9 and kind=="main" and step.index%3==1) or (job==10 and kind=="savage" and step.index%2==1) then
            self._T.demoAmhaengAt=self._T.demoTime+.2
            self._T.demoAmhaengSerial=(self._T.demoAmhaengSerial or 0)+1
            self._T.demoAmhaengHits={}
            self._T.demoAmhaengX=65+(job==9 and ((_UtilLogic:RandomDouble()<.5 and -1 or 1)*(1.5+_UtilLogic:RandomDouble()*2.5)) or (.8+_UtilLogic:RandomDouble()*.4))*55
            self._T.demoAmhaengY=-57+(job==9 and _UtilLogic:RandomDouble()*1.2*55 or 0)
        end
        _GameAudio:StopSound("5be2bfc98ac5406485fd89dac2278ad4")
        local use={fireArrow="6f972ab4e14841398281f3fc2a8f376e",angel="a2ade2fb109b490cb95814c0622b4f4f",shining="6f972ab4e14841398281f3fc2a8f376e",mist="eb7f504670a14802a48cc94f4eb66848",strafe="7d5ef2c392a34251990a9dc8b51deb12",savage="e0178f48602742c0bd8b295fdc27261c",assaulter="3cc6e9d3ad6b41fbbe2a6ab17b364b94",booster="a83d56a314fd449cad236fd7d9b2fa63",combo="4b254b65adbe4df4885acbe2e2fa3671",power="e0178f48602742c0bd8b295fdc27261c",panic="d01b135e62a74129b1515c8e0250a2f5",roar="7dd03981265b4d9a8c638bf0b18649cc",partner="6c7c28167b9049419435cc53001cef0c",awake="af39b536300f43d3a657fc82d63abfe3",assassinate="0f213b255ab34a0e8ed258c89f3b62fe",third="7d5ef2c392a34251990a9dc8b51deb12"}
        if kind=="smoke" then self:DemoSound("ad63f4c64f304b6c876fb68511addb87",false)
        elseif kind=="haste" then self:DemoSound("64795afda95e4b7dbdbdfe731e7d405a",false)
        elseif kind=="booster" and job>=4 and job<=6 then self:DemoSound("c4d8035c4ded408aadc62ebbf6eb54a3",false)
        elseif use[kind]~=nil then self:DemoSound(use[kind],false) end
        if kind=="main" and job>=4 and job<=6 then self._T.demoUltimateAt=self._T.demoTime self._T.demoUltimateJob=job self._T.demoUltimateHits={} end
        if kind=="iceDemon" or kind=="fireDemon" or kind=="wyvern" or kind=="mist" or kind=="blood" then self._T.demoSummons[kind]=self._T.demoTime end
        if kind=="mist" then self._T.demoMistPopAt=nil self._T.demoMistPopHits={} end
        if kind=="combo" then self._T.demoComboCount=0 self._T.demoOrbBorn={} end
        if kind=="walk" or kind=="mount" then self._T.demoClose=true end
        if kind=="support" or kind=="smoke" then self._T.demoSummons[kind]=self._T.demoTime end
        if kind=="main" then
            if job==9 then
                self._T.demoStarProjectiles=self._T.demoStarProjectiles or {}
                local mult=1/step.rate local gap=0.07*math.max(mult,0.6)
                local count=self._T.demoPartner and 8 or 4
                local info=_ShurikenLibrary:Get(9)
                for i=1,count do
                    self._T.demoStarSerial=(self._T.demoStarSerial or 0)+1
                    local slot=13+(self._T.demoStarSerial-1)%18
                    local height=_ShurikenLibrary:GetThrowHeight()*55
                    local spread=16.5*0.28125*(1-2*(i-1)/(count-1))
                    table.insert(self._T.demoStarProjectiles,{slot=slot,at=self._T.demoTime+0.4*mult+(i-1)*gap,x=-112,y=-57+height,targetY=-57+height+spread,ruid=info.fly,echo=i>4,lane=i-1,key=self._T.demoStageKey..":projectile"..tostring(i)})
                end
            end
            local sounds={"6c06fe8ab27b469eb61f466ea7f7e182","e0178f48602742c0bd8b295fdc27261c","fcac442d953049d980da4b8d7bd766d8","d07011d88da0400e8018379396e564b9","267aa4a9324f460b80bc04600aa4d0e0","d906d21dc9bd4c8cb66861d423044a65","7d5ef2c392a34251990a9dc8b51deb12","7d5ef2c392a34251990a9dc8b51deb12","879c81c8fc274aea87dc673de48ab5d1"}
            self:DemoSound(sounds[job] or "",false)
            if job==8 then self:DemoSound("5be2bfc98ac5406485fd89dac2278ad4",true) end
            if job>=4 and job<=6 then
                local bgms={"f0f6d14dc2ab41e48289b9b08838c2e5","c50b1e30210d4019a97da3e76c33079f","de5f1d1c7ed644b9a31a31d5c078ed31"}
                if self._T.demoDuck==nil then self._T.demoDuck=_GameAudio._T.duck or 1 end
                _GameAudio:SetBGMVolume(0.1)
                local id=bgms[job-3]
                if not self._T.demoSounds[id] then self:DemoSound(id,true) end
            end
        elseif kind=="snipe" then self:DemoSound("cd440aa30a954f54b41e45172b849ffb",true) self._T.demoChargeSound=true
        elseif kind=="partner" then self._T.demoPartner=true
        elseif kind=="combo" then self._T.demoCombo=true
        elseif kind=="panic" then self._T.demoComboCount=0 self._T.demoOrbBorn={}
        elseif kind=="awake" then
            self._T.demoAwake=true
            if self._T.demoDuck==nil then self._T.demoDuck=_GameAudio._T.duck or 1 end
            _GameAudio:SetBGMVolume(0.1)
            self:DemoSound("732c8aeac0624d21bdcfc89bc6244105",true)
        elseif kind=="summon" or kind=="dragon" or kind=="archer" or kind=="allies" or kind=="clone" then
            self._T.demoSummons[kind]=self._T.demoTime
            local sounds={[4]="5044fe5629044efd8da504d153fae348",[6]="9cd912e261bd4b72bd3113d7c8cbc6ed",[7]="6eb5b37dad16420baf8df8c29734f9f2",[8]="a30e038d7a9a4260abc1d645cf3aef75"}
            if kind=="summon" then self:DemoSound(sounds[job] or "",false) end
        end
        self:CreationUI("CreationBook/Demo/Skill").TextGUIRendererComponent.Text=step.label..(step.index>1 and "  "..tostring(step.index) or "")
        if Environment:IsMakerPlay() then log("[CreationBook] sequence job="..tostring(job).." skill="..kind.." count="..tostring(step.index)) end
    end













    @ExecSpace("ClientOnly")
    method boolean DemoSpecial(table step, number age, number x, number y, number scale, string key, any attack)
        local kind=step.kind
        local job=self.jobIdx
        if self:DemoAdditionalSkill(step,age,x,y,scale,key,attack) then return true end
        if kind=="main" or kind=="third" then return false end
        if kind=="power" then
            self:DemoMotion(age<.65 and "swingT2" or "swingTF",1,0,2147483647,key..(age<.65 and ":swing" or ":final"))
            self:DemoEffect(1,"447033cc51594e20a25d15bfe2995d2e",x+10*scale,y,scale,age-.45,.20,true,0,2147483647,1,key..":swingfx")
            self:DemoEffect(2,"dad03b3a528348bf98295b01edd621a4",65+40*scale,y,scale,age-.45,.5,true,0,2147483647,1,key..":back")
            self:DemoEffect(3,"e46fe5e970f84e3f8f75ea914b2e3bf7",x+10*scale,y,scale,age-1.1,.65,true,0,2147483647,1,key..":finalfx")
            self:DemoEffect(4,"c36e70d7b1d84845bf4067d069ba5e1a",65,y+25,scale,age-1.1,.5,false,0,2147483647,1,key..":hit")
            self._T.demoNodes.fx[1].SpriteGUIRendererComponent.Color=Color(1,1,1,.8)
            self._T.demoNodes.fx[3].SpriteGUIRendererComponent.Color=Color(1,1,1,.8)
        elseif kind=="booster" and job>=4 and job<=6 then
            self:DemoMotion("alert",1,0,2147483647,key)
            -- Dedicated slot: a delayed texture update cannot show the book on a later attack.
            self:DemoClipEffect(11,"6cf8c9dcbdf94d539a8d6afe1ef57281",x+25*scale,y,scale,age,true,key)
        elseif kind=="booster" or kind=="blood" then
            self:DemoMotion("stand1",1,0,2147483647,key..":buff")
            local frames=kind=="booster" and {
			"42514aa334774d0bb0fade61945e5970", "9d4e8b3b2eab441a8aa42ef883531704",
			"b7b99713c5ba4a55948ee31c7e213820", "c94fc0ca497c4ee2b2496bae4ded3259",
			"d5f5ceb4d0a04e25b3b978755d7a2f85", "3d84f51e0bc84c99b90e1e299338401f",
			"ea23c07eb82742709a0cad07d9614954", "c112602d64c84307b0438420d8d8a394",
			"85ed511773ff4ba1be37b92190c0cd50",
		} or {
			"17d4148acb0b4d67a1f3680778e9444b", "9e7588ff39d8486c912331b84020d583",
			"61f1012f9c6b403f90570c994088b26f", "f00e153032174ac496c58ac96ff14643",
			"a1c176033b9d4ecb9b4e774e954f5826", "fa0f0b8a618c4cabb1bd5d2a67cdde72",
			"6940317f79e641cba0379e42badeae1f", "ddb7f000fabe4ef4a73038965a146583",
			"7a7f27ef00d742ac8c0fb9060c37c60e", "f27543a0eb8e425c9e0725401b38ece7",
			"103919eff81f444e800c51b6737ecb9c", "113ef93caa1741d58a9deb555db0f582",
			"77da6025562145ff9b3bb5458371c6ba", "71f48142db364828b39e953dc63dcf50",
			"db8e4beca5bb4b9282433e5830449d42", "db260e0665cc44ce8f4261af3670c57a",
		}
            local duration=kind=="booster" and 0.1 or 0.07
            local fi=math.min(#frames,math.floor(age/duration)+1)
            local xs={-.03,.025,.04,.11,.145,.145,.03,.105,.12}
            local ys={.06,.075,.165,.17,.17,.20,.225,.22,.22}
            if kind=="blood" then
                xs={-.095,.04,.04,.025,.03,.035,.04,.04,.035,.035,.035,.04,.04,.04,.04,.04}
                ys={.96,.32,.32,.31,.31,.305,.305,.30,.305,.305,.305,.305,.305,.305,.305,.31}
            end
            -- Buff-only slots never become a target's hit effect on the next step.
            self:DemoEffect(44,frames[fi],x+xs[fi]*100*scale,y+ys[fi]*100*scale,scale,age,#frames*duration,true,0,2147483647,1,key..":buff"..tostring(fi))
            if kind=="blood" then
                self:DemoEffect(45,"4bd903c41887458f9ccf1aa20aa46181",x+.04*100*scale,y+.31*100*scale,scale*(1+math.max(0,age-1.12)*3),age-1.12,0.2,true,0,2147483647,1,key..":tail")
                self._T.demoNodes.fx[45].SpriteGUIRendererComponent.Color=Color(1,1,1,math.max(0,1-(age-1.12)/.2))
            end
        elseif kind=="combo" or kind=="partner" or kind=="awake" then
            self:DemoMotion("alert",1,0,2147483647,key..":buff")
            local ruid=kind=="combo" and "19e3ba3ab994431b81a3d4ee7a1b86e0" or (kind=="partner" and "6db426f91ed54b83beddb7837d96fb4c" or "c4442692903d48f6aa3583ee83cfc521")
            self:DemoEffect(1,ruid,x,y+(kind=="awake" and 22 or 0),scale,age,step.duration,true,0,2147483647,1,key..":buff")
            if kind=="partner" then self:DemoEffect(2,"8ef08d990aeb452bad114479f6bc76fd",x,y,scale,age,1.3,true,0,2147483647,1,key..":front") end
        elseif kind=="panic" then
            self:DemoMotion("swingT2",1,0,2147483647,key..":panic")
            self:DemoEffect(1,attack:GetPanicEffectRuid(10),x,y,scale*1.1,age,1.5,true,0,2147483647,1,key..":cast")
            self:DemoEffect(2,"4b8e5b7b21f74a26a54cf3a17d91930c",65,y+15,scale*2,age-0.55,0.8,false,0,2147483647,1,key..":hit")
        elseif kind=="roar" then
            self:DemoMotion("alert",1,0,2147483647,key..":roar")
            self:DemoClipEffect(1,"5468cadd2f60428e925bc368968e1a1e",x,y,scale,age,true,key..":roar")
            local stun=self._T.demoClipCache["6337b66c57a947e7b2cda8bbf8697094"]
            if age<2 and stun~=nil then
                self:DemoClipEffect(2,"6337b66c57a947e7b2cda8bbf8697094",x,y+70*scale,scale,age%stun.duration,false,key..":stun:"..tostring(math.floor(age/stun.duration)))
            end
        elseif kind=="stars" then
            self:DemoMotion("stand1",1,0,2147483647,key..":choose")
            -- Slot positions are already pixels; apply the same preview scale as the actor once.
            local ringScale=scale
            local spread=math.min(1,age/0.18)*math.min(1,math.max(0,(1.8-age)/0.18))
            for i=1,9 do
                local info=_ShurikenLibrary:Get(i)
                local p=_SkillManager:GetShurikenSlotPos(i,9)
                self:DemoEffect(i,info.icon,x+p.x*ringScale*spread,y+40*scale+p.y*ringScale*spread,ringScale,age,1.8,false,0,2147483647,1,key..":star"..tostring(i))
            end
            self:DemoEffect(10,"0e35906499314071a510a886c92a1dde",x,y+40*scale,ringScale,age-1.35,0.65,false,0,2147483647,1,key..":pick")
        elseif kind=="snipe" then
            if age<10 then
                self:DemoMotion("shoot2",0.001,1,2,key..":charge")
                local stage=math.min(2,math.floor(age/(10/3)))
                local stageAge=age-stage*(10/3)
                local looping=stageAge>=self._T.demoSnipingIntro[stage]
                self:DemoEffect(1,attack:GetSnipingChargeRUID(stage),x,y+15*scale,scale*0.5,stageAge,10,true,looping and 5 or 0,12,1,key..":stage"..tostring(stage)..":"..tostring(looping))
                self._T.demoNodes.fx[1].SpriteGUIRendererComponent.AnimClipPlayType=looping and SpriteAnimClipPlayType.Loop or SpriteAnimClipPlayType.Onetime
            else
                if self._T.demoChargeSound then _GameAudio:StopSound("cd440aa30a954f54b41e45172b849ffb") self._T.demoChargeSound=false self:DemoSound("7d5ef2c392a34251990a9dc8b51deb12",false) end
                self:DemoMotion("shoot2",1,0,2147483647,key..":release")
                self:DemoEffect(1,attack:GetSnipingChargeRUID(2),x,y+8,scale*0.5,age-10,1.5,true,13,2147483647,1,key..":tail")
                self:DemoEffect(2,attack:GetSnipingShootRUID(2),x+11,y+19,scale*0.5,age-10,1.5,true,0,2147483647,1,key..":release")
                self:DemoEffect(3,attack:GetSnipingBallRUID(2),x+(age-10)*720,y+20,scale,age-10,0.3,true,0,2147483647,1,key..":arrow")
            end
        elseif kind=="assaulter" then
            if age>=.8 then self._T.demoBehind=true end
            local tx=age<0.8 and -60 or 130
            self._T.demoNodes.actor.UITransformComponent.anchoredPosition=Vector2(tx,y)
            self._T.demoNodes.actor.AvatarGUIRendererComponent.Color=Color(1,1,1,age<0.8 and 0 or 1)
            self._T.demoNodes.actor.AvatarGUIRendererComponent.FlipX=age<0.7
            local frames={
			"316118f8a80a4ce992e7f5a9a84ce721", "150b5255237f4e6c8a873cb4ae80e9c8",
			"54d78693959b4babb1fe2fd6e2ff1ee3", "99f282382a0147f295f776297fa1095e",
			"e87245990ba54cc899304722089dead0", "e567c85e9d2e4f67bef25e99f1badb49",
			"6c010db6b6244a38af4d3c877565a309", "41093edab78c4c56b5119d55a880a064",
			"7c6d247ed19c4424a9068ea8200b47da", "a10deaf907694d82aa2b7d68f82f5fbf",
			"dd96705b1c6a48999a721ddb70e5e9d6", "de4cb0667240476ebd7163e4b694e53c",
			"fef55524a6a94235b060e78341f67510", "a1dfebbea2c24f6d85ed054dd9deaaa5"
		}
            local fi=math.min(#frames,math.floor(age/0.1)+1)
            local geometry={{91,75,48,72},{87,75,46,72},{83,78,45,75},{85,82,42,79},{83,82,40,79},{87,80,45,78},{69,65,-37,70},{48,53,-53,65},{38,50,45,50},{70,74,50,74},{71,73,39,74},{65,67,26,67},{37,66,-5,65},{85,62,43,61}}
            local g=geometry[fi]
            self:DemoEffect(1,frames[fi],tx-(g[1]*.5-g[3])*scale,y+(g[4]-g[2]*.5)*scale,scale,age,1.4,true,0,2147483647,1,key..":dash"..tostring(fi))
            local hitAge=age-.8
            if hitAge>=0 and hitAge<.54 then
                local hits={"ef25d1fcb69c4d3dbed9978403753114","270e31778ea6475e807e27bc835765d8","c5990dd1744347aea53516a51cb086df","ce339ca7e6a44ee3815d5f77edefebac"}
                local shapes={{54,40,26,16},{242,45,109,20},{123,49,92,22},{123,51,91,23}}
                local hi=hitAge<.12 and 1 or (hitAge<.25 and 2 or (hitAge<.39 and 3 or 4))
                local h=shapes[hi]
                self:DemoEffect(2,hits[hi],65+(h[1]*.5-h[3])*scale,y+(30+h[4]-h[2]*.5)*scale,scale,hitAge,.54,false,0,2147483647,1,key..":hit"..tostring(hi))
            end
        elseif kind=="savage" then
            self._T.demoNodes.actor.UITransformComponent.anchoredPosition=Vector2(130,y)
            self._T.demoNodes.actor.AvatarGUIRendererComponent.FlipX=false
            self:DemoFollowup(10,1,age,130,y,scale,key)
            local fx=self._T.demoNodes.fx[1]
            fx.UITransformComponent.anchoredPosition=Vector2(130-55*scale,y+45*scale)
            fx.SpriteGUIRendererComponent.FlipX=true
        elseif kind=="assassinate" then
            self._T.demoNodes.actor.UITransformComponent.anchoredPosition=Vector2(130,y)
            self._T.demoNodes.actor.AvatarGUIRendererComponent.FlipX=false
            self:DemoMotion("stabO1",1,0,2147483647,key..":stab")
            self:DemoEffect(1,"166b0965cf0e4827867a7581de618779",95,y+15,scale*0.5,age,0.8,false,0,2147483647,1,key..":approach")
            self._T.demoNodes.actor.AvatarGUIRendererComponent.Color=Color(1,1,1,age<1.2 and 0 or 1)
            for i=1,10 do
                self:DemoEffect(i+1,"8e8656117ba5498aa4f8308cd53c59d9",65,y+30,scale*.2,age-.45-(i-1)*.075,.4,false,0,2147483647,1,key..":hit"..tostring(i))
                self._T.demoNodes.fx[i+1].UITransformComponent.UIRotation=Vector3(0,0,(i*137.5)%360)
            end
        elseif kind=="rest" then self:DemoMotion("stand2",1,0,2147483647,key..":rest")
        else
            self:DemoMotion("alert",1,0,2147483647,key..":summon")
            -- Summons use their own appearance frames in DemoSummon.
        end
        return true
    end













    @ExecSpace("ClientOnly")
    method void DemoPersistent(table step, number age, number x, number y, number scale, string key, any attack)
        local job=self.jobIdx
        local nodes=self._T.demoNodes
        local dim=self:CreationUI("CreationBook/Demo/Scene/Dim")
        dim.SpriteGUIRendererComponent.Color=Color(0,0,0,self._T.demoAwake and 0.5 or 0)
        
        if self._T.demoCombo then
            local count=self._T.demoComboCount or 0
            self:DemoEffect(12,"9cfc22d7db1842608b648d9d7b5d216e",x+2*scale,y+41*scale,scale,0,1,false,0,2147483647,1,"comboCenter")
            nodes.fx[12].UITransformComponent.UIRotation=Vector3(0,0,-self._T.demoTime*360)
            nodes.fx[12].SpriteGUIRendererComponent.Color=Color(1,1,1,0.8)
            for i=1,math.min(5,count) do
                local a=self._T.demoTime*2.7+(i-1)*math.pi*2/5
                local born=(self._T.demoOrbBorn or {})[i] or 0
                local t=math.min(1,(self._T.demoTime-born)/0.65)
                local size=scale*(1+2*(1-t)*(1-t))
                self:DemoEffect(12+i,(i<=count-5 and attack:GetComboOrbPinkSpriteRuid(i) or attack:GetComboOrbSpriteRuid(i)),x+2*scale+math.cos(a)*42*scale,y+41*scale+math.sin(a)*42*scale,size,0,1,false,0,2147483647,1,"orb"..tostring(i)..":"..tostring(i<=count-5))
            end
        end
        if job==2 and self._T.demoFieldMode~=nil then
            local mode=self._T.demoFieldMode
            local fields={"6169b9874ef64af3899f14fc2a8420fd","256171c083234b5db66fac1cab2d20d5","fd8d94ac1de548958b8467a4131659cb"}
            self:DemoEffect(24,fields[mode],65,y,mode==1 and scale*.275 or scale,self._T.demoTime-self._T.demoFieldAt,10,false,0,2147483647,mode==1 and .5 or 1,"field:"..tostring(self._T.demoFieldAt))
            nodes.fx[24].SpriteGUIRendererComponent.Color=Color(1,1,1,mode==1 and .6 or .5)
            nodes.fx[24].SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
        end
        if job==7 and step.kind=="snipe" and age<10 then
            local ratio=math.min(1,age/10)
            self:DemoEffect(46,"f56452e2c7464911bd7696e9d36ad8db",x,y+105*scale,scale*.5,0,1,false,0,2147483647,1,"snipeGaugeBg")
            nodes.fx[46].SpriteGUIRendererComponent.Color=Color(.25,.25,.25,.8)
            self:DemoEffect(47,"f56452e2c7464911bd7696e9d36ad8db",x-35*scale*(1-ratio),y+105*scale,scale*.5,0,1,false,0,2147483647,1,"snipeGaugeFill")
            nodes.fx[47].UITransformComponent.UIScale=Vector3(scale*.5*ratio,scale*.5,1)
        end
        self:DemoShotAftermath(scale)
        if job>=4 and job<=6 and self._T.demoUltimateJob==job and self._T.demoUltimateAt~=nil and #self._T.demoTiles>0 then
            local age=self._T.demoTime-self._T.demoUltimateAt
            local castKey="ultimate:"..tostring(job)..":"..tostring(self._T.demoUltimateAt)
            local casts={{"f0035d3b88da4c9a91689b9db9c6bf7a","1c434f7cecf94e1cb16b68ee0079b01d"},{"96b261657b0c4aa792bd6f3e7d6c6681"},{"47286e5fd6eb4a989792415aacf07f73","2eb15c8e49f8492f948c5292cd31171f"}}
            for i,ruid in ipairs(casts[job-3]) do
                if job==4 or job==5 then self:DemoClipEffect(22+i,ruid,-112,y-(job==5 and 35*scale or 0),scale,age,false,castKey..":cast"..tostring(i))
                else self:DemoEffect(22+i,ruid,-112,y,scale,age,3,false,0,2147483647,1,castKey..":cast"..tostring(i)) end
            end
            for i=1,6 do
                local clip=self._T.demoTiles[(i-1)%#self._T.demoTiles+1]
                local delay=job==4 and .5 or ((job==5 and 2.3 or 3.146)-clip.hitDelay)
                if job==4 or job==5 then self:DemoClipEffect(24+i,clip.ruid,-80+i*35,y,scale,age-delay,false,castKey..":tile"..tostring(i))
                else self:DemoEffect(24+i,clip.ruid,-80+i*35,y,scale,age-delay,clip.duration,false,0,2147483647,1,castKey..":tile"..tostring(i)) end
            end
            local alpha=0.2*math.min(1,age/1.5)*math.min(1,math.max(0,(17-age)/2.5))
            dim.SpriteGUIRendererComponent.Color=job==4 and Color(1,1,1,alpha) or (job==6 and Color(0.3,0.03,0.03,alpha) or Color(0,0,0,alpha))
            for wave=0,9 do
                local a=age-(3+wave*1.5)
                local slot=13+wave
                local clip=self._T.demoTiles[wave%#self._T.demoTiles+1]
                local hitAt=job==4 and self._T.demoAngelHit or clip.hitDelay
                self._T.demoUltimateHits=self._T.demoUltimateHits or {}
                if a>=hitAt and not self._T.demoUltimateHits[wave] then
                    self._T.demoUltimateHits[wave]=true self:DemoHit(18000,false,wave%3)
                end
                local ruid=clip.ruid local fxX=65 local fxY=y local size=scale local flip=false
                if job==4 then
                    ruid=wave%2==0 and "3c075a252a75471aa2afb46284a92b18" or "841bc14615dd48a49e247f7b3bd75ed8"
                    flip=wave%2==0 fxX=65+(flip and -100 or 100)*scale fxY=y-30*scale size=scale*0.6
                end
                local waveKey="ultimate:"..tostring(job)..":"..tostring(self._T.demoUltimateAt)..":"..tostring(wave)
                if job==4 or job==5 then self:DemoClipEffect(slot,ruid,fxX,fxY,size,a,flip,waveKey)
                else self:DemoEffect(slot,ruid,fxX,fxY,size,a,job==4 and self._T.demoAngelDuration or clip.duration,flip,0,2147483647,1,waveKey) end
            end
        end
        self:DemoExtraSummons(step,age,x,y,scale,key,attack)
        self:DemoSummon(x,y,scale)
        self:DemoAllies(step,age,x,y,key)
        self:DemoThiefEffects(step,age,x,y,scale,key,attack)
        self:DemoSupportEffects(step,age,x,y,scale,key)
    end

















    @ExecSpace("ClientOnly")
    method void DemoAllies(table step, number age, number x, number y, string key)
        if self._T.demoAllies==nil then
            self._T.demoAllies={}
            for i=1,4 do self._T.demoAllies[i]=self:CreationUI("CreationBook/Demo/Scene/Ally"..tostring(i)) end
        end
        local generation=self._T.demoGeneration or 0
        local nodes=self._T.demoAllies
        local shadow=false -- partner uses its native special/* sprites below
        local clone=self._T.demoSummons.clone~=nil
        local archer=self._T.demoSummons.archer~=nil
        local allies=self._T.demoSummons.allies~=nil
        local count=allies and 3 or ((shadow and 1 or 0)+(clone and 1 or 0)+(archer and 1 or 0))
        for i=1,4 do nodes[i].Enable=i<=count end
        for i=1,count do
            local e=nodes[i]
            local shadow=shadow and i==1
            local job=shadow and self.jobIdx or (clone and 10 or (archer and 8 or (i==1 and 10 or (i==2 and 8 or 3))))
            local look=tostring(self._T.demoJob)..":"..tostring(job)
            self._T.demoAllyLooks=self._T.demoAllyLooks or {}
            if self._T.demoAllyLooks[i]~=look then
                _DecoWindowManager:ApplyCostumeSnapshot(e.CostumeManagerComponent,self:JobDemoAppearanceFor(job))
                if generation~=(self._T.demoGeneration or 0) then return end
                self._T.demoAllyLooks[i]=look
            end
            e.Enable=true
            e.UITransformComponent.anchoredPosition=Vector2(shadow and x-20 or (job==3 and 4 or (job==10 and 105 or -130+(i-1)*28)),y)
            local allyScale=clone and 0.55 or 0.45
            e.UITransformComponent.UIScale=Vector3(allyScale,allyScale,1)
            e.AvatarGUIRendererComponent.FlipX=job~=10 or shadow
            e.AvatarGUIRendererComponent.Color=shadow and Color(0.25,0.25,0.4,0.65) or Color.white
            local allyAge=self._T.demoTime-(self._T.demoSummons.clone or self._T.demoSummons.allies or self._T.demoSummons.archer or 0)
            local tick=math.floor(allyAge/2.4)
            local phase=allyAge%2.4
            local action=shadow and (self._T.demoAction or "stand1") or (job==8 and "shoot1" or (job==10 and "stabO1" or "stabT1"))
            local first=0 local last=2147483647 local rate=1
            local poseIndex=0
            if job==10 and not shadow then
                if phase<.72 then
                    poseIndex=math.min(7,math.floor(phase/.09)+1)
                    local pose=self._T.demoSavagePoses[poseIndex]
                    action=pose.action first=pose.frame last=pose.frame+1 rate=.001
                else action="stand1" end
            end
            local motionKey=tostring(self._T.demoCycle)..":"..tostring(tick)..":"..action..":"..tostring(poseIndex)
            self._T.demoAllyMotion=self._T.demoAllyMotion or {}
            if self._T.demoAllyMotion[i]~=motionKey then
                local body=e.AvatarGUIRendererComponent:GetBodyEntity()
                if isvalid(body) then body:SendEvent(ActionStateChangedEvent(action,action,rate,SpriteAnimClipPlayType.Onetime,first,last)) end
                self._T.demoAllyMotion[i]=motionKey
            end
            if not shadow then
                local slot=32+(i-1)*2
                local ax=e.UITransformComponent.anchoredPosition.x
                if job==8 then
                    -- Each arrow owns a slot for its full flight; no teleporting slot reuse.
                    for shot=0,3 do
                        local arrowAge=phase-.2-shot*.1
                        local dy=16.5*(.75-1.5*shot/3)
                        local duration=(65-ax)/440
                        local arrowSlot=49+shot
                        self:DemoEffect(arrowSlot,"ac868a4ac45c4489a3c2e60ad3dd9454",ax+arrowAge*440,y+19.25+dy*arrowAge/duration,.45,arrowAge,duration,true,0,2147483647,1,"allyStrafe:"..tostring(i)..":"..tostring(tick)..":"..tostring(shot))
                        self._T.demoNodes.fx[arrowSlot].UITransformComponent.UIRotation=Vector3(0,0,math.deg(math.atan(dy,65-ax)))
                    end
                    self:DemoEffect(slot+1,"028a2e518e6c4713ad7300684d4a39d2",ax,y,.45,phase,1,true,0,2147483647,1,"allyBowCast:"..tostring(i)..":"..tostring(tick))
                elseif job==10 then
                    local frames={"0c10c7f12e7445c2a840c593fbfc9513","c517f7f05a844af580b80bf420743ce8","3e556b633f4f4b358ae54cf4add11fd7","ed2c5cd4ceea4090813802f4143b3cfc","d99ee75c6cb041b48067b61fbb8734a0","4fa59e6d33d94917a8a4c9ea03745acf","f565ca85888249faad6eddf86992a486","61d7141ba8d047f4a2b8d514e64d3dfc"}
                    local fi=math.min(8,math.floor(phase/.09)+1)
                    self:DemoEffect(slot,frames[fi],ax-55*allyScale,y+45*allyScale,allyScale,phase,.72,true,0,2147483647,1,"allySavage:"..tostring(i)..":"..tostring(tick)..":"..tostring(fi))
                elseif job==3 then
                    local age=phase-.288
                    self:DemoEffect(slot,"9229298b79a64868b7cee06dc198edec",ax+108*.45,y+28*.45,.45,age,.26,true,0,2147483647,1,"allyBurst:"..tostring(tick))
                    self:DemoEffect(slot+1,"8da209f377f249f292e1d0c50c928683",ax-35.3*.45,y+100.5*.45,.45,phase,.9,true,0,2147483647,1,"allyWing:"..tostring(tick))
                end
                self._T.demoAllyHit=self._T.demoAllyHit or {}
                self._T.demoAllyHit[i]=self._T.demoAllyHit[i] or {}
                local hits=job==10 and 6 or 1
                for line=1,hits do
                    local at=job==10 and (.18+(line-1)*.09) or .6
                    if phase>=at and self._T.demoAllyHit[i][line]~=tick then
                        self._T.demoAllyHit[i][line]=tick
                        self:DemoHit(1800,false,job==10 and line-1 or i-1)
                        if job==10 and line==6 then if Environment:IsMakerPlay() then log("[CreationBook] clone savage hits=6 cycle="..tostring(tick)) end end
                    end
                end
            end
        end
    end













    @ExecSpace("ClientOnly")
    method void DemoSummon(number x, number y, number scale)
        local started=self._T.demoSummons.summon
        if self._T.demoSummons.dragon~=nil then
            local t=self._T.demoTime-self._T.demoSummons.dragon
            local frames={"7ac2730a18ac47e083a46dc5e879deac","fa619b956fad497ca2f3a686985a2319","4f30d3c01e424ed6a0752a8236a9bb1f","cfb1fcf539844ada8ac200500ee0fb39","43f7075f03254c3c94a5b98c635d1a98"}
            local phase=t%5 local serial=math.floor(t/5)
            if phase>=3 then frames={"87672a20076545599a3db8f49cab3004","72f34a0b01494325bd89343292d83619","bf23099d75e94310bed5429863c830c5","c16ddf9d7cf04223bc9d44111de8e8ee","6e919b4a2a854e0f9bbedc4e6851a53e"} end
            local frame=math.floor(t/0.16)%#frames+1
            local dx=65-(x-35) local dy=16.5-60
            self:DemoEffect(39,"f9b7dfc6f8964ce4864ccfdb2a83ac0c",x-35,y+60,scale*.7,phase-4,1,false,0,2147483647,1,"dragonattack:"..tostring(serial))
            self._T.demoNodes.fx[39].UITransformComponent.UIRotation=Vector3(0,0,math.deg(math.atan(dy,dx))+180)
            if phase>=4 and self._T.demoDragonHit~=serial then self._T.demoDragonHit=serial self:DemoHit(3200,false,1) end
            self:DemoEffect(31,frames[frame],x-35,y+60,0.3,0,1,true,0,2147483647,1,"dragon:"..tostring(frame))
        end
        if started==nil then return end
        local job=self.jobIdx
        local t=self._T.demoTime-started
        if self._T.demoPetFrames==nil then self._T.demoPetFrames={[4]={spawn={
