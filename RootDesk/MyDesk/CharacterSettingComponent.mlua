@Component
script CharacterSettingComponent extends Component

	property number faceIdx = 1

	property number hairIdx = 1
	property integer hairColorIdx = 1
	property integer faceColorIdx = 1

	property number topIdx = 1

	property number bottomIdx = 1

	property number shoesIdx = 1

	property number weaponIdx = 1

	property boolean buttonsConnected = false

	property number jobIdx = 0

	property boolean jobButtonsConnected = false

	method table GetFaceItems()
		-- Selected native face color is also the saved item RUID.
		return _AppearanceColorCatalog:GetCreationItems("face", self.faceColorIdx)
	end

	method table GetHairItems()
		-- Selected native hair color is also the saved item RUID.
		return _AppearanceColorCatalog:GetCreationItems("hair", self.hairColorIdx)
	end

	method table GetTopItems()
		local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, 3)
		if item == "" then return {{"직업 선택 필요", ""}} end
		return {{_UIEquipInventoryManager:ParseName(item), _UIEquipInventoryManager:ParseRUID(item)}}
	end

	method table GetBottomItems()
		local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, 4)
		if item == "" then return {{"한벌옷 착용", ""}} end
		return {{_UIEquipInventoryManager:ParseName(item), _UIEquipInventoryManager:ParseRUID(item)}}
	end

	method table GetShoesItems()
		local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, 5)
		if item == "" then return {{"직업 선택 필요", ""}} end
		return {{_UIEquipInventoryManager:ParseName(item), _UIEquipInventoryManager:ParseRUID(item)}}
	end

	method table GetWeaponItems()
		-- Match the starter weapon for the chosen job.
		return {{_UIEquipInventoryManager:GetJobWeaponName(self.jobIdx), _UIEquipInventoryManager:GetJobWeaponRUID(self.jobIdx)}}
	end

	method table GetJobItems()
		return {
			"히어로", "팔라딘",
			"다크나이트", "비숍",
			"아크메이지(썬,콜)", "아크메이지(불,독)",
			"신궁", "보우마스터",
			"나이트로드", "섀도어",
		}
	end

	@ExecSpace("ClientOnly")
	method void ConnectJobButtons()
		-- Retain the touch subscriptions for session cleanup.
		if self.jobButtonsConnected then return end
		self._T.jobConnections = {}
		local base = "/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/JobSelectPanel/JobBtn_"
		for i = 1, 10 do
			local capturedIdx = i
			local btn = _EntityService:GetEntityByPath(base .. tostring(i))
			if isvalid(btn) then
				-- 눌림 애니메이션이 반응하는 전체 Raycast 영역과 선택 판정을 동일하게 맞춘다.
				-- ButtonClickEvent는 가장자리에서 눌림은 보이지만 release 판정이 누락되는 경우가 있어
				-- 실제 시각 피드백이 시작되는 TouchDown 시점에 한 번만 선택한다.
				local connection = btn:ConnectEvent(UITouchDownEvent, function(event)
					self:OnJobSelected(capturedIdx)
				end)
				table.insert(self._T.jobConnections, {entity = btn, connection = connection})
			end
		end
		self.jobButtonsConnected = true
		log("[JobSelect] connected=" .. tostring(#self._T.jobConnections))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Release job subscriptions when the login session ends.
		for _, rec in ipairs(self._T.jobConnections or {}) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(UITouchDownEvent, rec.connection) end
		end
		for _, rec in ipairs(self._T.rowConnections or {}) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.connection) end
		end
		self._T.rowConnections = nil
		self.buttonsConnected = false
		self._T.jobConnections = nil
		self.jobButtonsConnected = false
	end

	method void UpdateJobButtonVisuals()
		local base = "/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/JobSelectPanel/JobBtn_"
		for i = 1, 10 do
			local btn = _EntityService:GetEntityByPath(base .. tostring(i))
			if isvalid(btn) then
				if i == self.jobIdx then
					btn.SpriteGUIRendererComponent.Color = Color(1, 0.72, 0.34, 1)
				else
					btn.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				end
			end
		end
	end

	method void UpdateCompleteButtonState()
		local okBtn = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/CreateCharacterok")
		if isvalid(okBtn) then
			okBtn.ButtonComponent.Enable = self.jobIdx > 0
		end
	end

	@ExecSpace("ClientOnly")
	method void OnJobSelected(number idx)
		-- Reject stale selection events from other login phases.
		if _LoginFlow.phase ~= "job" or idx < 1 or idx > #self:GetJobItems() then return end
		self.jobIdx = idx
		self:UpdateAllText()
		self:ApplyCostume()
		self:UpdateJobButtonVisuals()
		self:UpdateCompleteButtonState()
		log("[JobSelect] selected=" .. self:GetSelectedJobName())
	end

	method string GetSelectedJobName()
		if self.jobIdx <= 0 then return "" end
		return self:GetJobItems()[self.jobIdx]
	end

	method number Wrap(number idx, table list)
		if idx < 1 then
			return #list
		elseif idx > #list then
			return 1
		else
			return idx
		end
	end

	method void SetRowText(string rowName, string text)
		local path = self.Entity.Path .. "/" .. rowName .. "/FaceValueText"
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) then
			entity.TextGUIRendererComponent.Text = text
		end
	end

	method void UpdateAllText()
		self:SetRowText("Row_Face",   self:GetFaceItems()[self.faceIdx][1])
		self:SetRowText("Row_Hair",   self:GetHairItems()[self.hairIdx][1])
		self:SetRowText("Row_Top",    self:GetTopItems()[self.topIdx][1])
		self:SetRowText("Row_Bottom", self:GetBottomItems()[self.bottomIdx][1])
		self:SetRowText("Row_Shoes",  self:GetShoesItems()[self.shoesIdx][1])
		self:SetRowText("Row_Weapon", self:GetWeaponItems()[self.weaponIdx][1])
		self:SetRowText("Row_FaceColor", self:GetFaceItems()[self.faceIdx][3])
		self:SetRowText("Row_HairColor", self:GetHairItems()[self.hairIdx][3])
	end

	method void ApplyCostume()
		-- Clear all old clothing before applying the selected job starter set.
		local preview = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/PreviewAvatar")
		if not isvalid(preview) then return end
		local cm = preview.CostumeManagerComponent
		if not isvalid(cm) then return end
		cm.UseCustomEquipOnly = true
		cm:SetEquip(MapleAvatarItemCategory.Body, "5b510a5cb03b4ba9bfe1b1666b17b2cf")
		cm:SetEquip(MapleAvatarItemCategory.Face, self:GetFaceItems()[self.faceIdx][2])
		cm:SetEquip(MapleAvatarItemCategory.Hair, self:GetHairItems()[self.hairIdx][2])
		for _, category in ipairs({MapleAvatarItemCategory.Cap, MapleAvatarItemCategory.Cape, MapleAvatarItemCategory.Coat, MapleAvatarItemCategory.Longcoat, MapleAvatarItemCategory.Pants, MapleAvatarItemCategory.Glove, MapleAvatarItemCategory.Shoes, MapleAvatarItemCategory.OneHandedWeapon, MapleAvatarItemCategory.TwoHandedWeapon, MapleAvatarItemCategory.SubWeapon, MapleAvatarItemCategory.FaceAccessory, MapleAvatarItemCategory.EyeAccessory, MapleAvatarItemCategory.EarAccessory, MapleAvatarItemCategory.Ear}) do
			cm:SetEquip(category, "")
		end
		if self.jobIdx == 0 then
			cm:SetEquip(MapleAvatarItemCategory.Coat, "ae8d3590a96e48c3b7cd75d46ebd3f15")
			cm:SetEquip(MapleAvatarItemCategory.Pants, "61f10ef0a6204e0ab6593bdf36fed3e5")
		end
		local categories = {[3] = MapleAvatarItemCategory.Coat, [4] = MapleAvatarItemCategory.Pants, [5] = MapleAvatarItemCategory.Shoes, [6] = MapleAvatarItemCategory.TwoHandedWeapon, [7] = MapleAvatarItemCategory.Cap, [8] = MapleAvatarItemCategory.Cape, [9] = MapleAvatarItemCategory.Glove}
		for slot = 3, 9 do
			local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, slot)
			if item ~= "" then
				local category = categories[slot]
				if slot == 3 and _UIEquipInventoryManager:IsLongcoatItem(item) then category = MapleAvatarItemCategory.Longcoat end
				if slot == 6 and _UIEquipInventoryManager:IsOneHandedJobWeapon(_UIEquipInventoryManager:ParseName(item)) then category = MapleAvatarItemCategory.OneHandedWeapon end
				cm:SetEquip(category, _UIEquipInventoryManager:ParseRUID(item))
			end
		end
	end

	method void ConnectRowButtons(string rowName, any prevFunc, any nextFunc)
		-- Retain subscriptions so restarting play does not duplicate clicks.
		self._T.rowConnections = self._T.rowConnections or {}
		for _, row in ipairs({{"FacePrevButton", prevFunc}, {"FaceNextButton", nextFunc}}) do
			local button = _EntityService:GetEntityByPath(self.Entity.Path .. "/" .. rowName .. "/" .. row[1])
			if isvalid(button) then
				local connection = button:ConnectEvent(ButtonClickEvent, row[2])
				table.insert(self._T.rowConnections, {entity = button, connection = connection})
			end
		end
	end

	method void Init()
		if not self.buttonsConnected then
			self:ConnectRowButtons("Row_Face",   self.OnFacePrev,   self.OnFaceNext)
			self:ConnectRowButtons("Row_Hair",   self.OnHairPrev,   self.OnHairNext)
			self:ConnectRowButtons("Row_Top",    self.OnTopPrev,    self.OnTopNext)
			self:ConnectRowButtons("Row_Bottom", self.OnBottomPrev, self.OnBottomNext)
			self:ConnectRowButtons("Row_Shoes",  self.OnShoesPrev,  self.OnShoesNext)
			self:ConnectRowButtons("Row_Weapon", self.OnWeaponPrev, self.OnWeaponNext)
			self:ConnectRowButtons("Row_FaceColor", self.OnFaceColorPrev, self.OnFaceColorNext)
			self:ConnectRowButtons("Row_HairColor", self.OnHairColorPrev, self.OnHairColorNext)
			self.buttonsConnected = true
		end
		self:ConnectJobButtons()
		self.faceColorIdx = 1
		self.hairColorIdx = 1
		self.faceIdx   = 1
		self.hairIdx   = 1
		self.topIdx    = 1
		self.bottomIdx = 1
		self.shoesIdx  = 1
		self.weaponIdx = 1
		self.jobIdx    = 0
		self:UpdateAllText()
		self:ApplyCostume()
		self:UpdateJobButtonVisuals()
		self:UpdateCompleteButtonState()
	end

	method void OnFacePrev(ButtonClickEvent event)
		self.faceIdx = self:Wrap(self.faceIdx - 1, self:GetFaceItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnFaceNext(ButtonClickEvent event)
		self.faceIdx = self:Wrap(self.faceIdx + 1, self:GetFaceItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnHairPrev(ButtonClickEvent event)
		self.hairIdx = self:Wrap(self.hairIdx - 1, self:GetHairItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnHairNext(ButtonClickEvent event)
		self.hairIdx = self:Wrap(self.hairIdx + 1, self:GetHairItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnTopPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnTopNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnBottomPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnBottomNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnShoesPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnShoesNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnWeaponPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnWeaponNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	@ExecSpace("ClientOnly")
	method void OnFaceColorPrev(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetFaceItems()[self.faceIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.faceColorIdx = ((self.faceColorIdx - 1 + -1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end

	@ExecSpace("ClientOnly")
	method void OnFaceColorNext(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetFaceItems()[self.faceIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.faceColorIdx = ((self.faceColorIdx - 1 + 1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end

	@ExecSpace("ClientOnly")
	method void OnHairColorPrev(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetHairItems()[self.hairIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.hairColorIdx = ((self.hairColorIdx - 1 + -1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end

	@ExecSpace("ClientOnly")
	method void OnHairColorNext(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetHairItems()[self.hairIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.hairColorIdx = ((self.hairColorIdx - 1 + 1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end

end
