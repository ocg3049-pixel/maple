			"746e837c321d4ad49ff7b2d45bebbe3b", "49067e2f9b48468f83670946feb36d00",
			"c3ccd28a1538424ba8de3dbf7296cefc", "aa73d034ee744829a5adb80bba8ff653",
			"6dfb1820aa224e1eba8c972e87b0f337", "2b7c26a68f7c4c5da65d1e2d41964e70",
			"01ee429bfdec415db565efac779f5b41", "84277879bbd84fb0abde04d2a990b3ab",
			"0ea4289706f64e88911df8d93578c5f0", "0e9c5b4660994c1b94c3a95e5c0e1b11",
			"2069596aa0644c6382ad0bcffcd5f78b", "dcf8643257e74642a414667460a76333",
			"eb7863f9c6ea452e9a595b37555a89fe", "8ae07b10339a4de4b2e4e3146ae6697f",
			"710c5700232d496385735f158fd06ac6",
		}},[8]={attack={
			"a5d0745555fd4b678976f2e0b9d94a38", "2a26381dc6284ed18ae2592ca8df3e0c",
			"c7b20fac0f7c49f2b30f10c15d842826", "720f9da349f54d3baddc573ff1423478",
			"35936e07e6c442a08b91230fa9b3b607", "ec345522135e4a76b02a2ddb54b8f751",
			"11c90f0a51e94c2d8617ed53ca439917", "4573e4cfa46c4ede819dc765c064ce86",
			"19e7ddb3a2724e9999ffaf370a28626b", "235a25c4ced7448d94cc005868b81967",
			"7506ad835fe645d9a64491f23f8c82aa", "373b5608ad5c46e2b78fbcc00de47a63",
			"764864ef173142e9bb9acaa40ff2ddb8", "35d91ec3215f4244b2da439722599a97",
			"e52cf4e8a5394c59ac937cf0d36f5aad", "1b87e09089a549d788f9686cdaa6eadf",
			"cd2a4c9906cf42c685767b96765c9a5f", "d2538070f23b42658eed6dd7afc5d4cf",
			"dac139320f7b4c4ca63835716b6daab4", "d855eba453c84bb087cc9464b3c19928",
			"ec46e5657b864d19b740159b465d23d1",
		}}} end
        local data=self._T.demoPetFrames[job]
        local px=x-110*scale local py=y+75*scale
        local size=0.85*scale local clip="" local first=0 local last=2147483647
        local state="stand" local frame=1 local loop=false local alpha=math.min(1,t/0.4)
        local spawnTime=job==4 and 0.72 or (job==5 and 1.5 or 1.8)
        local period=job==4 and 4.2 or 4.8
        local attackAge=(t-spawnTime)%period
        local cycle=math.floor((t-spawnTime)/period)
        local hitAt=job==4 and 1.08 or 1.44
        if job==4 or job==6 then
            local frames=data.stand
            if t<spawnTime then state="spawn" frames=data.spawn frame=math.min(#frames,math.floor(t/0.12)+1)
            elseif attackAge<(job==4 and 1.62 or 2.25) then state="attack" frames=data.attack frame=math.min(#frames,math.floor(attackAge/(job==4 and 0.09 or 0.12))+1)
            else frame=math.floor(t/(job==4 and 0.15 or 0.18))%#frames+1 end
            local row=frames[frame]
            if type(row)=="table" then clip=row[1] px=px-row[2]*100*size py=py+row[3]*100*size
            else clip=row py=py+83*size end
        elseif job==5 then
            clip="23b5af3095bd4be6af97422e7bf98df4" loop=true
            if t<1.44 then state="spawn" clip="6d33d5e5eed64028beab08a5118acbe3" first=11-math.floor(t/0.12) last=first frame=first loop=false
            elseif t>=spawnTime and attackAge<2.25 then state="attack" clip="12eb937249b94fa1a4a2b28039b42f9e" loop=false end
        elseif job==7 or job==8 then
            size=scale px=x-50*scale py=y+80*scale
            spawnTime=1.2 period=7.2 attackAge=(t-spawnTime)%period cycle=math.floor((t-spawnTime)/period) hitAt=2.8
            clip=job==7 and "1137e890f2e444bebfe4c51be7893f89" or "65314ea68ace41368e6883772510840c" loop=true
            if t<spawnTime then state="spawn" clip=job==7 and "e08387d34c1c43d6a895207f3608472b" or "a09d9772cc4c4cecb4138862b36d089e" loop=false
            elseif attackAge<1.4 then state="move" clip=job==7 and "c5e8473026df4b0491f3ceb2af224af5" or "922fa176488740c0b4c74fdd30d45f33" px=px+(65-px)*attackAge/1.4
            elseif attackAge<2.5 then state="attack" frame=math.min(21,11+math.floor((attackAge-1.4)/0.1)) clip=data.attack[frame] px=65
            elseif attackAge<5.1 then state="gone" alpha=0
            elseif attackAge<6.6 then state="return" frame=math.min(21,7+math.floor((attackAge-5.1)/0.1)) clip=data.attack[frame] end
            if t>=spawnTime then self:DemoEffect(32,job==7 and "9863cc13ee6f4de0b51d2888ac1370de" or "43a18ef761724c75b8e79049200a8dd9",65,y+30*scale,scale,attackAge-2.5,1.6,false,0,2147483647,1,"petHit:"..tostring(cycle)) end
        else return end
        if job==7 or job==8 then
            local native=(self._T.demoBirdClips or {})[clip]
            if native~=nil and native.duration>0 then
                local clock=state=="spawn" and math.min(t,native.duration-.001) or t%native.duration
                for i,f in ipairs(native.frames) do
                    clock=clock-math.max(.01,f.Delay)
                    if clock<0 then clip=f.FrameSprite.RUID frame=i break end
                end
                loop=false
            end
            self._T.demoPetState=state self._T.demoPetFrame=frame
        end
        local petKey=tostring(job)..":"..state..":"..tostring(cycle)..":"..tostring(frame)
        self:DemoEffect(31,clip,px,py,size,0,1,true,first,last,1,petKey)
        local spr=self._T.demoNodes.fx[31].SpriteGUIRendererComponent
        spr.AnimClipPlayType=loop and SpriteAnimClipPlayType.Loop or SpriteAnimClipPlayType.Onetime
        spr.PlayRate=1 spr.Color=Color(1,1,1,alpha)
        local hitKey=tostring(job)..":"..tostring(cycle)
        if t>=spawnTime and attackAge>=hitAt and self._T.demoPetHit~=hitKey then
            self._T.demoPetHit=hitKey self:DemoHit(1800,false,0)
            local sounds={[4]="154f797432104a0b9de86cdb7c9e7a6a",[5]="d769daa17e6c4e9eb78a57e5a02f80a9",[6]="08150c9ada3e405ab7c44d024b3cc710",[7]="f03324b1068e4c1caf4d753262fc096f",[8]="82622cad8b1b4cef8c58aa36d07d949a"}
            self:DemoSound(sounds[job],false)
        end
    end





    @ExecSpace("ClientOnly")
    method void DemoStarProjectiles(number y, number scale)
        local list=self._T.demoStarProjectiles or {}
        local now=self._T.demoTime local slot=12
        for i=#list,1,-1 do
            local shot=list[i] local age=now-shot.at
            if age>=0 then
                local dx=65-shot.x local dy=shot.targetY-shot.y
                local distance=math.sqrt(dx*dx+dy*dy)
                local travel=math.max(0,(distance-35*scale)/(800*scale))
                if age>=travel then
                    self:DemoHit(shot.echo and 1200 or 2400,false,shot.lane)
                    self:DemoSound("eb49560ca2a84e0585e0e83cd61c9dc6",false)
                    table.remove(list,i)
                else
                    slot=shot.slot
                    if slot<=30 then
                        local f=math.min(1,age*800*scale/distance)
                        self:DemoEffect(slot,shot.ruid,shot.x+dx*f,shot.y+dy*f,scale,0,1,true,0,2147483647,1,shot.key)
                        local fx=self._T.demoNodes.fx[slot]
                        fx.UITransformComponent.UIRotation=Vector3(0,0,math.deg(math.atan(dy,dx)))
                        fx.SpriteGUIRendererComponent.PlayRate=1
                        fx.SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
                        fx.SpriteGUIRendererComponent.Color=Color(1,1,1,shot.echo and 0.55 or 1)
                    end
                end
            end
        end
    end



    @ExecSpace("ClientOnly")
    method boolean DemoAdditionalSkill(table step, number age, number x, number y, number scale, string key, any attack)
        local kind=step.kind
        local u=100*scale
        if kind=="haste" then
            self:DemoMotion("alert",1,0,2147483647,key)
            self:DemoEffect(1,"410e6a09f8ec471f87bd8d55c34cc48d",x,y,scale,age,1.5,false,0,2147483647,1,key)
        elseif kind=="smoke" then
            self:DemoMotion(age<.6 and "swingOF" or "stand1",1,0,2147483647,key..tostring(age>=.6))
        elseif kind=="support" then
            self:DemoMotion("alert",1,0,2147483647,key)
        elseif kind=="field" then
            self:DemoMotion("swingO2",1/0.7,0,2147483647,key)
            self:DemoClipEffect(44,"1de1c87ae2ed443184844dc0ea1e831e",x+30*scale,y,scale,age,false,key)
        elseif kind=="walk" then
            self._T.demoNodes.actor.UITransformComponent.anchoredPosition=Vector2(-60+64*math.min(1,age/0.65),y)
            self:DemoMotion("walk2",1,0,2147483647,key)
        elseif kind=="wyvern" or kind=="dismount" then
            self:DemoMotion("stand2",1,0,2147483647,key)
        elseif kind=="mount" then
            self._T.demoNodes.actor.UITransformComponent.anchoredPosition=Vector2(-60+64*math.min(1,math.max(0,(age-.5)/1.5)),y+35)
            self:DemoMotion("sit",1,0,2147483647,key)
            local rider=self._T.demoNodes.actor.UITransformComponent.anchoredPosition
            self:DemoEffect(1,"86500681cfad4e8488cf4ba9376fe801",rider.x,rider.y+20,scale*1.1,age,0.5,false,0,2147483647,1,key)
        elseif kind=="angel" then
            self:DemoMotion("shoot1",1,0,2147483647,key)
            local frames={
			"f589e80ef37e4e2fbbe99b97915b329e", "9c4e6931f24c4aaa92363594c6c181e1",
			"6b3b8eab7b5e4cc28c73684fe9794b91", "f0b14236ed864b63bc2a04c62722fe48",
			"fdfd7c732ac64deaa1513b497c33fc9c", "8cebe7a19ebd4a58a48989e4e1f2d1a3",
			"ce02b0dd95744002b6f3d9671268257f", "da302311a55b4795b3e54ab7d2dbe17f",
			"02c11b4b3caf47c693a5eb960eec1138", "92e6e9e493ac4b89956df9f209d04b21",
			"3061ea19cdb34f40a503645097b2a891", "5abf2cb1687340c8bed551d2ea178dc2",
			"921860f9bee942ccb572a21439b6f6e0", "13eb62c1a0094965adbb19e3dbb5d4f0",
			"848cc0f7534642c9b5716c2c4f8bd30a",
		}
            local f=math.min(#frames,math.floor(age/0.06)+1)
            self:DemoEffect(1,frames[f],x+19.5*scale,y+43*scale,scale,age,1.07,true,0,2147483647,1,key..tostring(f))
            local t=age-0.7 local travel=(65-x)/(800*scale)
            self:DemoEffect(2,"4d01ad5c78c14a8fb954fb76713048c4",x+t*800*scale,y+30*scale,scale,t,travel,true,0,2147483647,1,key..":ball")
        elseif kind=="shining" then
            self:DemoMotion("swingO2",0.5,0,2147483647,key)
            local groups=self._T.demoShiningFrames
            for i,frames in ipairs(groups) do
                local t=age-(i==3 and 1 or 0)
                if t>=0 then
                    local f=frames[math.min(#frames,math.floor(t/0.12)+1)]
                    self:DemoEffect(i,f.ruid,(i==3 and 65 or x)+f.x*u,y+f.y*u,scale,t,#frames*0.12+0.15,true,0,2147483647,1,key..tostring(i)..":"..tostring(math.floor(t/0.12)))
                end
            end
        elseif kind=="iceDemon" then
            self:DemoMotion("swingO2",1,0,2147483647,key)
            self:DemoEffect(1,"28cc63a0d29a468c9f9842e5ef7dc0ac",x+2*u,y,scale,age,1.7,false,0,2147483647,1,key)
            self:DemoEffect(2,"d0bbbf99a1b3428293deacf96fb0b0de",x+0.5*u+(age-0.6)*2.333333*u,y+0.35*u,scale,age-0.6,3.857143,true,0,2147483647,1,key..":ball")
        elseif kind=="fireDemon" then
            self:DemoMotion("swingO2",1,0,2147483647,key)
            local frames=self._T.demoFireDemonFrames
            local f=frames[math.min(#frames,math.floor(age/0.1)+1)]
            self:DemoEffect(1,f[1],x-f[2]*u,y+f[3]*u,scale,age,1.7,false,0,2147483647,1,key..tostring(math.floor(age/0.1)))
            local balls={"078eed6ff6a64ad7955abc2a711b7070","5e4c3c20435b4887a9df7a6b0fb2e2f3","11183b6b7795412ea0935ecf40c5de01","0e66ec0897164684afa31353406d8fe2"}
            local t=age-0.95
            if t>=0 then self:DemoEffect(2,balls[math.floor(t/0.1)%4+1],x+0.5*u+t*2.333333*u,y+0.35*u,scale,t,3.857143,true,0,2147483647,1,key..":ball"..tostring(math.floor(t/0.1))) end
        elseif kind=="chain" then
            self:DemoMotion("swingO2",1,0,2147483647,key)
            local frames={
			"d5cf4af358ad4b968b0098482b8e4f01",
			"5acc3586c88744a4a317017949deaeac",
			"bda2f30b3f2e4f7797923dfa6d67a2ad",
			"80ef1189a2bb4c62b6d38e9acf49646e",
			"434499f4207643e6b15b1bc486038ab9",
			"efdb69589210447da328503a7919ae41",
			"3d3c65d7fd3b4ca5a0b9f04b5f2e7491",
			"d815226fbe56432fb67affffdbd33836",
		}
            local f=math.min(#frames,math.floor(age/0.09)+1)
            local t=math.max(0,math.min(1,(age-0.5)/0.052))
            self:DemoEffect(1,frames[f],x+(-.05+.85*t)*u,y+(.05-.25*t)*u,scale*.6,age,.9,true,0,2147483647,1,key..tostring(f))
            if age>=.65 then self._T.demoNodes.fx[1].SpriteGUIRendererComponent.Color=Color(1,1,1,math.max(0,(.9-age)/.25)) end
            local clips={"fde245aeb0eb49baa3b0bd64fbc05f7a","fdfe96a01f704ede9882f5e324c70118","a83eaccf55764d269aec652f27fe1944"}
            for i=1,8 do self:DemoEffect(i+1,clips[(i-1)%3+1],x+44+(65-x-44)*i/8,y+16,scale*.65,age-.68,.3,false,0,2147483647,1,key..":chain"..tostring(i)) end
            self:DemoEffect(10,"b499aa0ce95647ceb592198e0ce0d97c",65,y+.2*u,scale*.65,age-.68,.32,false,0,2147483647,1,key..":hit")
        elseif kind=="mist" then
            self:DemoMotion("swingO2",1,0,2147483647,key)
            local frames={
			{ ruid = "1700015d7c2442b78e9ba7e415805a69", x = -0.625, y = 0.420 },
			{ ruid = "e371ffa7dfe44d8e909c059160ffb1ec", x = -0.630, y = 0.435 },
			{ ruid = "dd4fd90408414f7590ec076b5e40d944", x = -0.640, y = 0.440 },
			{ ruid = "3ff878ceda484e6f9c2b06754d077ab8", x = -0.640, y = 0.420 },
			{ ruid = "ffb987bd624f45ecaf212a8b8f0a9ca3", x = -0.640, y = 0.430 },
			{ ruid = "286bebe1f08144309fa1d52e178e0269", x = -0.640, y = 0.435 },
			{ ruid = "8bd9be973f944c48adc964df04699894", x = -0.545, y = 0.330 },
			{ ruid = "3fbc8d8a4e734b19987763bf76eb2a35", x = -0.540, y = 0.315 },
			{ ruid = "9a5909ba934d4f81a665b2b60b15fc80", x = -0.555, y = 0.350 },
			{ ruid = "a815dd5b52de469dbbe97051f246c9b1", x = -0.560, y = 0.350 },
			{ ruid = "8777aa4a32ac426ea227415b11a1772d", x = -0.535, y = 0.350 },
			{ ruid = "5cfe320f978549a991f812837932f2f3", x = -0.530, y = 0.350 },
			{ ruid = "040d3a6e368f43f2ba85c5b78c229682", x = -0.535, y = 0.350 },
			{ ruid = "fe17d206f30f49f2adb50d8f73c6b40e", x = -0.530, y = 0.350 },
		}
            local f=frames[math.min(#frames,math.floor(age/.1)+1)]
            self:DemoEffect(1,f.ruid,x-f.x*u,y+f.y*u,scale,age,1.4,true,0,2147483647,1,key..tostring(math.floor(age/.1)))
        elseif kind=="fireArrow" then
            self:DemoFollowup(6,1,age,x,y,scale,key)
        elseif kind=="explosion" then
            self:DemoMotion("alert",1,0,2147483647,key)
            self:DemoEffect(1,"419e26654a5e470fa386a8a4e92e9eb3",x,y,scale,age,1,false,0,2147483647,1,key)
            self:DemoEffect(2,"38f9aa42ec39406987a9fd92ba2c14ad",x,y,scale,age-1,1,false,0,2147483647,1,key..":blast")
            self:DemoEffect(3,"154a7b585c474b07ae77d96a465756e6",x,y,scale,age-1,1,false,0,2147483647,1,key..":special")
            if age>=1 and self._T.demoSummons.mist~=nil then
                self._T.demoSummons.mist=nil
                self._T.demoMistPopAt=self._T.demoTime
                self._T.demoMistPopHits={}
                if Environment:IsMakerPlay() then log("[CreationBook] poison mist detonated and removed") end
            end
        elseif kind=="strafe" then
            self:DemoMotion("shoot2",1,0,2147483647,key)
            -- Same feet anchor as PlayStrafeCastEffect; NativeSize supplies the sprite pivot.
            self:DemoClipEffect(1,"028a2e518e6c4713ad7300684d4a39d2",x,y,scale,age,true,key..":cast")
            for i=1,4 do
                local t=age-(.2+.1*(i-1))
                local dx=65-x local dy=16.5*(.75-1.5*(i-1)/3)
                local distance=math.sqrt(dx*dx+dy*dy)
                local duration=distance/(800*scale)
                self:DemoEffect(i+1,"ac868a4ac45c4489a3c2e60ad3dd9454",x+dx*t/duration,y+.35*u+dy*t/duration,scale,t,duration,true,0,2147483647,1,key..tostring(i))
                self._T.demoNodes.fx[i+1].UITransformComponent.UIRotation=Vector3(0,0,math.deg(math.atan(dy,dx)))
            end
        else return false end
        return true
    end



    @ExecSpace("ClientOnly")
    method void DemoExtraSummons(table step, number age, number x, number y, number scale, string key, any attack)
        local starts=self._T.demoSummons
        if starts.blood~=nil then
            -- Follow the rendered rider position, including the mount's vertical offset.
            local t=self._T.demoTime-starts.blood
            local pulse=t%3 local serial=math.floor(t/3)
            if step.kind=="mount" then pulse=age end
            if serial>0 then
                local ruid=pulse<.14 and "7984d07ac9d34320be87cf0744e37925" or (pulse<.28 and "e1d7aa4dedcc43cea11cfd879f216e3c" or "1f6dc4a446df4eaaa0fec17b455758b3")
                local dx=pulse<.14 and .105 or (pulse<.28 and .095 or 0)
                self:DemoEffect(48,ruid,x+dx*100*scale,y+.325*100*scale,scale,pulse,.48,true,0,2147483647,1,"bloodPulse:"..tostring(serial)..":"..step.kind..":"..ruid)
                if pulse>=.28 then self._T.demoNodes.fx[48].SpriteGUIRendererComponent.Color=Color(1,1,1,math.max(0,(.48-pulse)/.2)) end
            end
        end
        if starts.wyvern~=nil then
            local t=self._T.demoTime-starts.wyvern
            local mounted=step.kind=="mount"
            local phase=t%6
            local clip=mounted and "af21747f71154e3392d2669160dceb81" or (phase>4.4 and "0314573ebc8d43f49e50047bdf28133a" or "2d932a6e7989426a9856fb5fc2d0e59f")
            self:DemoEffect(40,clip,x-(mounted and 19.25 or 30),y+(mounted and -90*scale or 42),scale*1.1,0,1,true,0,2147483647,1,"wyvern:"..tostring(math.floor(t/6))..":"..clip)
            self._T.demoNodes.fx[40].SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
            if not mounted then
                self:DemoEffect(41,"b57982104fc24997900fcdd693be1f77",65,y+16.5,scale*1.1,phase-5.1,.9,false,0,2147483647,1,"wyvernhit"..tostring(math.floor(t/6)))
                local serial=math.floor(t/6)
                if phase>=5.1 and self._T.demoWyvernHit~=serial then self._T.demoWyvernHit=serial self:DemoHit(3500,false,1) end
            end
        end
        local started=starts.iceDemon or starts.fireDemon
        if started~=nil then
            local t=self._T.demoTime-started-1.8
            if t>=0 and t<20 then
                local fire=starts.fireDemon~=nil
                local phase=t%3.4 local serial=math.floor(t/3.4)
                local ruid=fire and "bdcd828ae2b84712913b4d1caf4faa0f" or "e78cee3d2fe148c6a917d072977ccb1d"
                if phase>=1 then ruid=fire and "6016fff40eb44ea0bea95b0b62fb4c38" or "dfcf285ec5734d66a5ea7766505e5040" end
                self:DemoEffect(42,ruid,10,y,scale*2/3,0,1,true,0,2147483647,1,"demon:"..tostring(serial)..ruid)
                self._T.demoNodes.fx[42].SpriteGUIRendererComponent.Color=Color(1,1,1,math.min(1,t))
                self:DemoEffect(43,fire and "30f71881e7f8462baa8976be22c8aee9" or "237aff6426064721a4bc57105d22abb8",65,y+16.5,scale*2/3,phase-1.96,.8,false,0,2147483647,1,"demonhit"..tostring(serial))
                if phase>=1.96 and self._T.demoDemonHit~=serial then self._T.demoDemonHit=serial self:DemoHit(1800,false,2) end
            end
        end
        if starts.mist~=nil then
            local t=self._T.demoTime-starts.mist-1.2
            self:DemoEffect(44,"eaed7d6a19f0483aa51dc5ff151f7acf",65,y,scale*10,t,40,false,0,2147483647,1,"mistzone")
            self._T.demoNodes.fx[44].SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
        end
        if self._T.demoMistPopAt~=nil then
            local t=self._T.demoTime-self._T.demoMistPopAt
            local offsets={{-48,12},{26,32},{-15,52},{55,16},{-35,35},{8,20}}
            for i,p in ipairs(offsets) do
                local a=t-(i-1)*.3
                self:DemoEffect(32+i,"154a7b585c474b07ae77d96a465756e6",65+p[1],-57+p[2],scale,a,1,false,0,2147483647,1,"mistPop:"..tostring(self._T.demoMistPopAt)..":"..tostring(i))
                if a>=0 and not self._T.demoMistPopHits[i] then
                    self._T.demoMistPopHits[i]=true
                    self:DemoHit(3600,false,(i-1)%3)
                    self:DemoSound("3edd6d189b9b4bf1ac48162339848e36",false)
                end
            end
            if t>=2.5 then self._T.demoMistPopAt=nil end
        end
    end

    @ExecSpace("ClientOnly")
    method table JobDemoAppearanceFor(integer job)
        local eq={}
        for i=1,27 do
            local item=""
            if i<=2 then item=self:AppearanceItem(i)
            elseif i<=9 then
                local row=_UIEquipInventoryManager:GetEquipmentAppearance(job,i,30)
                if row~=nil then item=row[4].."|"..row[5].."|"..tostring(i).."|0|0|0" end
            end
            eq[i]={name=_UIEquipInventoryManager:ParseName(item),ruid=_UIEquipInventoryManager:ParseRUID(item),item=item}
        end
        local finals=_DecoWindowManager:ComposeAppearance(eq,{},job)
        table.insert(finals,{1,"5b510a5cb03b4ba9bfe1b1666b17b2cf"})
        return finals
    end


    @ExecSpace("ClientOnly")
    method void UpdateDemoDamageLabels()
        -- Seven reusable labels animate locally; the first stays reserved for charge progress.
        local nodes=self._T.demoNodes
        if nodes==nil then return end
        local now=self._T.demoTime or 0
        for i=2,8 do
            local label=nodes.damage[i]
            local hit=(self._T.demoDamageSlots or {})[i]
            local age=hit and now-hit.at or 1
            local visible=hit~=nil and age>=0 and age<.85
            if label.Enable~=visible then label.Enable=visible end
            if visible then
                label.UITransformComponent.anchoredPosition=Vector2(65,hit.y+age*28)
                local alpha=math.min(1,(.85-age)/.25)
                label.TextGUIRendererComponent.FontColor=hit.critical and Color(1,.55,.2,alpha) or Color(1,.95,.55,alpha)
            end
        end
    end


    @ExecSpace("ClientOnly")
    method void UpdateJobDemo(number delta)
        -- Preserve elapsed time if a first resource load suspends the renderer.
        if self._T.demoRendering and (self._T.demoPreparing or self._T.demoJob~=self.jobIdx) then return end
        self._T.demoPendingDelta=(self._T.demoPendingDelta or 0)+delta
        if self._T.demoRendering or (self._T.demoPendingDelta<1/30 and self._T.demoJob==self.jobIdx) then return end
        self._T.demoRendering=true
        local elapsed=self._T.demoPendingDelta
        self._T.demoPendingDelta=0
        self._T.demoRenderGeneration=self._T.demoGeneration or 0
        self:RenderJobDemo(elapsed)
        if self._T.demoRenderGeneration~=(self._T.demoGeneration or 0) then
            if self._T.demoNodes~=nil then for _,fx in ipairs(self._T.demoNodes.fx) do fx.Enable=false end end
            self._T.demoJob=nil
        end
        self._T.demoRendering=false
    end

    @ExecSpace("ClientOnly")
    method void DemoThiefEffects(table step, number age, number x, number y, number scale, string key, any attack)
        if self.jobIdx~=9 and self.jobIdx~=10 then return end
        local nodes=self._T.demoNodes
        if self._T.demoPartner then
            local clips={
			proneStab = "06184b0d6c0446c6944827222843b399",
			prone = "d41f649cd95341a29a1bdf24b629b6c1",
			stand1 = "f4aba8c33f204125a231595006d84b4a",
			stand2 = "85497bc859ae45a29a0aea551ce8345b",
			walk1 = "74c3a6b4f33e481ebdd241d1cd92370e",
			walk2 = "bce3238cb89c454bbd9798eb92286ba5",
			alert = "07002b4e493048e9a5f857b02e3ba51c",
			dead = "55b24d5e74074e638770aa5266190028",
			fly = "cbd3663877364d2cafeae1dffb1e553c",
			heal = "f713b8efdada4fd2ab5235331d510a7d",
			ladder = "05bf354c21e74f7681deac6f206f2704",
			rope = "311af551050744debb1c5acf7b8e268d",
			shoot1 = "f72d242125aa40f09bce04b9881b1423",
			shoot2 = "05969cc0bb60409ebb4c1b4ef059eb0a",
			shootF = "1760108d7e904933a91168b568f91a9d",
			stabO1 = "8736f22509854a2a873a12da0bdea57a",
			stabO2 = "087ddd3b2038432d8477a9ce1d2a4977",
			stabOF = "087d665af45a4c7994fe652eb0ad16a1",
			stabT1 = "df7c1492de864fea852ce8f4aa45de58",
			stabT2 = "2fdbfcd7056d45fb80009e1f79d3f404",
			stabTF = "86a6af2b709245e7a6da1ec30ce67ff3",
			swingO1 = "edfb3dd0204f49e1a5dfac95520439b8",
			swingO2 = "07531c9679d44f7992d7c66871b5f551",
			swingO3 = "fc164d4b226e4a22bab992992cdfdd4c",
			swingOF = "1e8698fd912644f28458031b25a62827",
			swingP1 = "115a328173d840c2ab3757c6816eae78",
			swingP2 = "e2d1a0a592ec485c8af9cf82e8bdf9ca",
			swingPF = "8d3c203a44b4486aae2b19133ca794ab",
			swingT1 = "04fec532f4f74ffb9741ebafe2526201",
			swingT2 = "af61463a604f437bb9e5c782992622fb",
			swingT3 = "15a76a6ee450459a97fe44e3ad9283d0",
			swingTF = "9212c14c063e4d4ca27dc1cb1dfc5edf",
		}
            local action=self._T.demoAction or "stand1"
            local actor=nodes.actor.AvatarGUIRendererComponent
            local dir=actor.FlipX and 1 or -1
            self:DemoEffect(45,clips[action] or clips.stand1,x-22*scale*dir,y-2*scale,scale,0,1,actor.FlipX,self._T.demoActionFirst or 0,self._T.demoActionLast or 2147483647,self._T.demoActionRate or 1,"partner:"..(self._T.demoMotionKey or key))
            nodes.fx[45].SpriteGUIRendererComponent.Color=Color(.05,.05,.05,actor.Color.a)
        end
        local started=self._T.demoSummons.smoke
        if started~=nil and self._T.demoTime>=started+1.1 then
            local t=self._T.demoTime-started-1.1
            local tiles={"bc1ba61e96e5474d92525cd20990aace","048e10628f134eca9bc0e9a46ce5e2cf","18312d09b99c45eebe6d5cfba1fdbddc","8cbe41f131c244c58ff6d1669bc6b8ef","8c99c7df2b73470cafd310c6fcb797b2","14c3bcf57c854f3291a02efde5becdc5","6a31da72eabb4efcac6ebb5dc09ce15a","5d7f5dfe794a4cdfabbafcc58601e625","fd820c75aaf9447093ec0191f3911bed"}
            local f=math.floor(t/.12)%18
            if f>=9 then f=17-f end
            self:DemoEffect(46,tiles[f+1],130,-57+attack:GetSmokeScreenCenterOffsetY()*100*scale,scale*4,t,20,false,0,2147483647,1,"smoke:"..tostring(f))
            nodes.fx[46].SpriteGUIRendererComponent.Color=Color(1,1,1,.7*math.min(1,t/2))
            self:CreationUI("CreationBook/Demo/Scene/Dim").SpriteGUIRendererComponent.Color=Color(.45,.45,.5,.55*math.min(1,t/2))
        end
        if not self._T.demoPartner or self._T.demoAmhaengAt==nil then return end
        local serial=self._T.demoAmhaengSerial or 0
        local t=self._T.demoTime-self._T.demoAmhaengAt
        if t<0 or t>1.5 then return end
        local variant=serial%2==0 and "doublestab" or "savageblow"
        local clips=attack:GetAmhaeng2PoseClips(variant)
        local sx=self._T.demoAmhaengX local sy=self._T.demoAmhaengY
        local face=sx<65 local frame=1 local alpha=.7
        local interval=variant=="doublestab" and .18 or .09
        if self.jobIdx==9 then
            clips={"edfb3dd0204f49e1a5dfac95520439b8","07531c9679d44f7992d7c66871b5f551","fc164d4b226e4a22bab992992cdfdd4c","1e8698fd912644f28458031b25a62827"}
            frame=serial%4+1 alpha=.7*math.min(1,math.max(0,(.93-t)/.5))
        else
            frame=math.min(#clips,math.floor(math.max(0,t-.08)/interval)+1)
            alpha=.7*math.min(1,math.max(0,(interval*#clips+.66-t)/.5))
        end
        self:DemoEffect(47,clips[frame],sx,sy,scale,t,1.4,face,0,2147483647,self.jobIdx==9 and .7 or 1,"amhaeng:"..tostring(serial)..":"..tostring(frame))
        nodes.fx[47].SpriteGUIRendererComponent.Color=Color(1,1,1,alpha)
        if self.jobIdx==9 then
            local dir=face and 1 or -1
            local bx=sx+30*scale*dir local by=sy+60*scale
            local dx=65-bx local dy=-57+20*scale-by
            local distance=math.sqrt(dx*dx+dy*dy)
            local duration=math.max(.01,(distance-30*scale)/(700*scale))
            local a=t-.21
            if a<duration then
                self:DemoEffect(48,"2fc1bc6b1de741458d3b83227097aa99",bx+dx*a/(distance/(700*scale)),by+dy*a/(distance/(700*scale)),scale,a,duration,false,0,2147483647,1,"amhaengBall:"..tostring(serial))
                nodes.fx[48].UITransformComponent.UIRotation=Vector3(0,0,math.deg(math.atan(dy,dx))+180)
            else
                self:DemoEffect(48,"458e72f0720a4584a9a7fc3642b6e601",65,-57+20*scale,scale,a-duration,.5,false,0,2147483647,1,"amhaengHit:"..tostring(serial))
                if not self._T.demoAmhaengHits[1] then self._T.demoAmhaengHits[1]=true self:DemoHit(1600,false,1) end
            end
        else
            if variant=="savageblow" then
                self:DemoEffect(48,"d068d34b66d34aa28a170dfa5b55e13f",sx+(face and 35 or -35)*scale,sy,scale,t,.7,face,0,2147483647,1,"amhaengCast:"..tostring(serial))
                nodes.fx[48].SpriteGUIRendererComponent.Color=Color(1,1,1,.4)
            else
                self:DemoEffect(48,"8de01c7022964b1b9d6cf96070073446",65,-57,scale,t-.08,.5,face,0,2147483647,1,"amhaengHit:"..tostring(serial))
                nodes.fx[48].SpriteGUIRendererComponent.Color=Color(1,1,1,.65)
            end
            for i=1,#clips do
                if t>=.08+(i-1)*interval and not self._T.demoAmhaengHits[i] then self._T.demoAmhaengHits[i]=true self:DemoHit(math.floor(1600/#clips),false,i%3) end
            end
        end
    end


    @ExecSpace("ClientOnly")
    method void DemoSupportEffects(table step, number age, number x, number y, number scale, string key)
        if self.jobIdx~=2 then return end
        local started=self._T.demoSummons.support
        if started~=nil then
            self._T.demoSupportShots=self._T.demoSupportShots or {}
            if self._T.demoSupportStart~=started then
                self._T.demoSupportStart=started self._T.demoSupportShots={}
                for i=1,30 do
                    table.insert(self._T.demoSupportShots,{at=.3+i-1+_UtilLogic:RandomDouble(),sx=-60-(16+_UtilLogic:RandomDouble()*2)*100*scale,sy=-57+(5+_UtilLogic:RandomDouble())*100*scale,hit=false})
                end
            end
            local t=self._T.demoTime-started
            local arrows={"2d244b18d5da41fd946220e319e73dce","c76a4948cd2b479797c816948d4eb632","55c85742031c4a3eacafc0e64b83e8aa","3a1249350d2f4e49a7a6f580c9fc04fe","64ab16e3ec4b4c2bb49ad42bfb79e4e5","3b2bdef2d73848eb9d50466559fbbd81","5dd40edc6d764efaac5562db877e878b","b506c14e7d6740279d4a2a7101fef728","98ffd0585ec04ec990ab6e76ecd27095"}
            for i,shot in ipairs(self._T.demoSupportShots) do
                local a=t-shot.at local dx=65-shot.sx local dy=-57+50*scale-shot.sy
                local duration=math.sqrt(dx*dx+dy*dy)/(22*2/3*100*scale)
                local slot=13+(i-1)%4
                if a>=0 and a<duration then
                    local f=math.min(9,math.floor(a/.05)+1)
                    self:DemoEffect(slot,arrows[f],shot.sx+dx*a/duration,shot.sy+dy*a/duration,scale,a,duration,false,0,2147483647,1,"support:"..tostring(started)..":"..tostring(i)..":"..tostring(f))
                    self._T.demoNodes.fx[slot].UITransformComponent.UIRotation=Vector3(0,0,math.deg(math.atan(dy,dx))+135)
                    self._T.demoNodes.fx[slot].SpriteGUIRendererComponent.Color=i%2==0 and Color(1,.45,.25,1) or Color.white
                end
                if a>=duration and a<duration+1 then
                    self:DemoEffect(slot+4,i%2==0 and "ed57488f3abb468798b5cb8921464341" or "0b76f710f9df4baebf5c92d0281ce92b",65,-57+30*scale,scale,a-duration,1,false,0,2147483647,1,"supportHit:"..tostring(started)..":"..tostring(i))
                    if not shot.hit then shot.hit=true self:DemoHit(3500,false,1) end
                end
            end
        end
        if self._T.demoCurseAt~=nil then
            self:DemoEffect(25,"288e10be2948421ebd107829c10f07ba",65,y,scale,self._T.demoTime-self._T.demoCurseAt,20,false,0,2147483647,1,"curse:"..tostring(self._T.demoCurseAt))
            self._T.demoNodes.fx[25].SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
            self._T.demoNodes.fx[25].SpriteGUIRendererComponent.Color=Color(1,1,1,.6)
        end
        if self._T.demoShockAt~=nil then
            self:DemoEffect(26,"6beb8d728a7d4cca92eb7f4d2d9c45f9",65,y,scale,self._T.demoTime-self._T.demoShockAt,20,false,0,2147483647,1,"shock:"..tostring(self._T.demoShockAt))
            self._T.demoNodes.fx[26].SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
            self._T.demoNodes.fx[26].SpriteGUIRendererComponent.Color=Color(1,1,1,.6)
        end
    end

    @ExecSpace("ClientOnly")
    method void DemoShotAftermath(number scale)
        local shot=self._T.demoShot
        if shot==nil or shot.job~=self.jobIdx then return end
        local age=self._T.demoTime-shot.at
        if age<0 or age>2 then return end
        local u=100*scale local y=-57 local fire=shot.job==8
        local key="shot:"..tostring(shot.at)
        local arrows={"2d244b18d5da41fd946220e319e73dce","c76a4948cd2b479797c816948d4eb632","55c85742031c4a3eacafc0e64b83e8aa","3a1249350d2f4e49a7a6f580c9fc04fe","64ab16e3ec4b4c2bb49ad42bfb79e4e5","3b2bdef2d73848eb9d50466559fbbd81","5dd40edc6d764efaac5562db877e878b","b506c14e7d6740279d4a2a7101fef728","98ffd0585ec04ec990ab6e76ecd27095"}
        local embers={"ba5335861bac490bb376c6279d8afdbe","c7438da1d66e49c4bbbd2fb9379377d6","5e48242e94c6463c8601119e8f263b3c"}
        local tiles={"0279ebbf02fc42ee8d47b720ab35aef3","5929523d735c4e848c3ab4f8b465bc8c","9aa52c525f7c4eaeb71c096cfd405db3"}
        if fire then
            for i=1,12 do
                self:DemoEffect(12+i,tiles[(i-1)%3+1],65+(i-6.5)*.262*u,y+.15*u,scale*.77,age,1.2,false,0,2147483647,1,key..":tile"..tostring(i))
                local spr=self._T.demoNodes.fx[12+i].SpriteGUIRendererComponent
                spr.AnimClipPlayType=SpriteAnimClipPlayType.Loop spr.Color=Color(1,1,1,math.min(1,math.max(0,(1.2-age)/.4)))
            end
            self:DemoEffect(37,"ed57488f3abb468798b5cb8921464341",65,y+.3*u,scale,age,1,false,0,2147483647,1,key..":hit")
        else
            local frames={{"fc4f1fba7c57461380a634feda24aa5c",.40},{"9963f5ab73474e2786259878ef66f3f6",.40},{"26cbc52d8d444032b20fea7af775fd3b",.40},{"34097d531f564cce9ed75b6a531e8f60",.56},{"76ee3683807148dda4bc742ad5279633",.68},{"0b76f710f9df4baebf5c92d0281ce92b",.94}}
            local f=math.min(6,math.floor(age/.12)+1)
            self:DemoEffect(37,frames[f][1],65,y+frames[f][2]*u,scale,age,.95,false,0,2147483647,1,key..":hit"..tostring(f))
            self._T.demoNodes.fx[37].SpriteGUIRendererComponent.Color=Color(1,1,1,math.min(1,math.max(0,(.95-age)/.2)))
        end
        for i,d in ipairs(shot.drops) do
            local t=age-d.delay
            if t>=0 then
                local rain=i<=4
                local slot=rain and 37+i or (i<=10 and 20+i or 22+i)
                local speed=d.speed local norm=math.sqrt(1.64)
                local dist=0
                -- Rain and ice shards normalize (-.8,-1); fire embers use vertical speed directly.
                if rain or not fire then dist=speed*t/norm else dist=speed*t end
                local life=rain and 2.4*norm*.9/speed or 1.08
                local px=65+((rain and 1.92 or .48)+d.ox-.8*dist)*u
                local py=y+((rain and 2.4 or 2.5)-dist)*u
                local f=math.min(9,math.floor(t/.05)+1)
                local ruid=not rain and fire and embers[(i-5)%3+1] or arrows[f]
                local size=scale*(rain and (fire and .85 or 1.105) or (fire and 1 or .6))
                self:DemoEffect(slot,ruid,px,py,size,t,life,false,0,2147483647,1,key..":drop"..tostring(i)..":"..(not rain and fire and "clip" or tostring(f)))
                local fx=self._T.demoNodes.fx[slot]
                if rain or not fire then fx.UITransformComponent.UIRotation=Vector3(0,0,math.deg(math.atan(-1,-.8))+135) end
                local alpha=rain and 1 or math.min(1,math.max(0,(life-t)/.15))
                fx.SpriteGUIRendererComponent.Color=rain and fire and Color(1,.45,.25,alpha) or Color(1,1,1,alpha)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void HideDemoCapture()
        -- Compatibility cleanup for callers leaving the introduction page.
        self._T.demoDamageSlots={}
        if self._T.demoNodes~=nil then
            for _,label in ipairs(self._T.demoNodes.damage) do label.Enable=false end
        end
    end

    @ExecSpace("ClientOnly")
    method void ResetDemoPlayback()
        -- Invalidate in-flight loads and captures before changing a job or closing its page.
        self._T.demoGeneration=(self._T.demoGeneration or 0)+1
        self._T.demoPendingDelta=0
        self._T.demoUltimateAt=nil self._T.demoUltimateJob=nil self._T.demoUltimateHits={}
        self._T.demoSummons={} self._T.demoStarProjectiles={} self._T.demoShot=nil
        self._T.demoMistPopAt=nil self._T.demoMistPopHits={}
        self._T.demoPartner=false self._T.demoAmhaengAt=nil
        self._T.demoStageKey=nil self._T.demoJob=nil
        self:StopDemoAudio()
        self:HideDemoCapture()
        self._T.demoDamageCursor=0
        if self._T.demoNodes~=nil then
            for _,fx in ipairs(self._T.demoNodes.fx) do
                fx.Enable=false
                fx.SpriteGUIRendererComponent.ImageRUID=DataRef("")
            end
            for _,ally in ipairs(self._T.demoAllies or {}) do ally.Enable=false end
        end
        local dim=self:CreationUI("CreationBook/Demo/Scene/Dim")
        if isvalid(dim) then dim.SpriteGUIRendererComponent.Color=Color(0,0,0,0) end
    end

    @ExecSpace("ClientOnly")
    method void DemoHitOffset(number amount, boolean critical, number offsetY)
        -- Preview-only numbers use a fixed UI pool instead of capturing a world damage skin.
        if self._T.demoRenderGeneration~=(self._T.demoGeneration or 0) then return end
        local nodes=self._T.demoNodes
        if nodes==nil then return end
        self._T.demoDamageCursor=(self._T.demoDamageCursor or 0)%7+1
        local slot=self._T.demoDamageCursor+1
        self._T.demoDamageSlots=self._T.demoDamageSlots or {}
        self._T.demoDamageSlots[slot]={at=self._T.demoTime,y=-12+offsetY*55,critical=critical}
        local label=nodes.damage[slot]
        label.UITransformComponent.RectSize=Vector2(110,24)
        local text=label.TextGUIRendererComponent
        text.FontSize=critical and 17 or 14
        text.OutlineWidth=.12 text.OutlineColor=Color(0,0,0,.85)
        text.Text=tostring(math.floor(amount))
        if self._T.demoDamageStyleJob~=self.jobIdx then
            self._T.demoDamageStyleJob=self.jobIdx
            if Environment:IsMakerPlay() then log("[VRF][CreationDemo] pooled damage labels job="..tostring(self.jobIdx)) end
        end
        self._T.demoLastDamageOffset=offsetY
        self._T.demoMaxDamageOffset=math.max(self._T.demoMaxDamageOffset or -100,offsetY)
        self._T.demoDamageLineCount=(self._T.demoDamageLineCount or 0)+1
        self._T.demoHp=math.max(0,self._T.demoHp-amount)
        self._T.demoLastHit=self._T.demoTime
    end






    @ExecSpace("ClientOnly")
    method void OnCreationArrow(KeyboardKey key)
        if (_LoginFlow.phase~="create" and _LoginFlow.phase~="job") or _LoginFlow.busy or _AppearanceColorPicker:BlocksInput() then return end
        local name=self:CreationUI("CreateCharacterName")
        if isvalid(name) and isvalid(name.TextGUIRendererInputComponent) and name.TextGUIRendererInputComponent.IsFocused then return end
        local tab=self._T.creationTab
        local columns=tab=="job" and 5 or 2
        local step=key==KeyboardKey.LeftArrow and -1 or key==KeyboardKey.RightArrow and 1 or key==KeyboardKey.UpArrow and -columns or key==KeyboardKey.DownArrow and columns or 0
        if step==0 then return end
        if tab=="job" then self:OnJobSelected(self.jobIdx<=0 and 1 or (self.jobIdx-1+step)%#self:GetJobItems()+1)
        elseif tab=="hair" or tab=="face" then
            local hair=tab=="hair"
            local items=hair and self:GetHairItems() or self:GetFaceItems()
            local selected=hair and self.hairIdx or self.faceIdx
            local index=(selected-1+step)%#items+1
            if hair then self.hairIdx=index self._T.customHair=nil else self.faceIdx=index self._T.customFace=nil end
            self._T.galleryPage=math.floor((index-1)/8)+1
            self:UpdateAllText() self:ApplyCostume() self:DrawCreationGallery()
        else return end
        _UIAudio:Play("Tab")
        if Environment:IsMakerPlay() then log("[VRF] CreationArrow tab="..tab.." hair="..tostring(self.hairIdx).." face="..tostring(self.faceIdx).." job="..tostring(self.jobIdx)) end
    end
end
