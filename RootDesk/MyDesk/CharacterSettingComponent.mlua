@Component
script CharacterSettingComponent extends Component

	property number faceIdx = 1

	property number hairIdx = 1
	property integer hairColorIdx = 1
	property integer faceColorIdx = 1

	property number topIdx = 1

	property number bottomIdx = 1

	property number shoesIdx = 1

	property number weaponIdx = 1

	property boolean buttonsConnected = false

	property number jobIdx = 0

	property boolean jobButtonsConnected = false

	method table GetFaceItems()
		-- Selected native face color is also the saved item RUID.
		return _AppearanceColorCatalog:GetCreationItems("face", self.faceColorIdx)
	end

	method table GetHairItems()
		-- Selected native hair color is also the saved item RUID.
		return _AppearanceColorCatalog:GetCreationItems("hair", self.hairColorIdx)
	end

	method table GetTopItems()
		local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, 3)
		if item == "" then return {{"직업 선택 필요", ""}} end
		return {{_UIEquipInventoryManager:ParseName(item), _UIEquipInventoryManager:ParseRUID(item)}}
	end

	method table GetBottomItems()
		local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, 4)
		if item == "" then return {{"한벌옷 착용", ""}} end
		return {{_UIEquipInventoryManager:ParseName(item), _UIEquipInventoryManager:ParseRUID(item)}}
	end

	method table GetShoesItems()
		local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, 5)
		if item == "" then return {{"직업 선택 필요", ""}} end
		return {{_UIEquipInventoryManager:ParseName(item), _UIEquipInventoryManager:ParseRUID(item)}}
	end

	method table GetWeaponItems()
		-- Match the starter weapon for the chosen job.
		return {{_UIEquipInventoryManager:GetJobWeaponName(self.jobIdx), _UIEquipInventoryManager:GetJobWeaponRUID(self.jobIdx)}}
	end

	method table GetJobItems()
		return {
			"히어로", "팔라딘",
			"다크나이트", "비숍",
			"아크메이지(썬,콜)", "아크메이지(불,독)",
			"신궁", "보우마스터",
			"나이트로드", "섀도어",
		}
	end

	@ExecSpace("ClientOnly")
	method void ConnectJobButtons()
		-- Retain the touch subscriptions for session cleanup.
		if self.jobButtonsConnected then return end
		self._T.jobConnections = {}
		local base = "/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/CreationBook/JobList/JobBtn_"
		for i = 1, 10 do
			local capturedIdx = i
			local btn = _EntityService:GetEntityByPath(base .. tostring(i))
			if isvalid(btn) then
				-- 눌림 애니메이션이 반응하는 전체 Raycast 영역과 선택 판정을 동일하게 맞춘다.
				-- ButtonClickEvent는 가장자리에서 눌림은 보이지만 release 판정이 누락되는 경우가 있어
				-- 실제 시각 피드백이 시작되는 TouchDown 시점에 한 번만 선택한다.
				local connection = btn:ConnectEvent(UITouchDownEvent, function(event)
					self:OnJobSelected(capturedIdx)
				end)
				table.insert(self._T.jobConnections, {entity = btn, connection = connection})
			end
		end
		self.jobButtonsConnected = true
		if Environment:IsMakerPlay() then log("[JobSelect] connected=" .. tostring(#self._T.jobConnections)) end
	end

	@ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- The game camera may already be disabled while Play Test is shutting down.
        self._T.demoEnding=true
        self._T.demoPreviousCamera=nil
        self:StopDemoAudio() self:HideDemoCapture()
		-- Release job subscriptions when the login session ends.
		for _, rec in ipairs(self._T.jobConnections or {}) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(UITouchDownEvent, rec.connection) end
		end
		for _, rec in ipairs(self._T.rowConnections or {}) do
			if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.connection) end
		end
		for _,rec in ipairs(self._T.creationConnections or {}) do
            if isvalid(rec.entity) then
                if rec.touch then rec.entity:DisconnectEvent(UITouchDownEvent,rec.connection) else rec.entity:DisconnectEvent(ButtonClickEvent,rec.connection) end
            end
        end
        if self._T.creationKey~=nil then _InputService:DisconnectEvent(KeyDownEvent,self._T.creationKey) self._T.creationKey=nil end
        self._T.creationConnections=nil
        self._T.rowConnections = nil
		self.buttonsConnected = false
		self._T.jobConnections = nil
		self.jobButtonsConnected = false
	end





	method void UpdateJobButtonVisuals()
        -- Keep selection colors within the original parchment palette.
		local base = "/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/CreationBook/JobList/JobBtn_"
		for i = 1, 10 do
			local btn = _EntityService:GetEntityByPath(base .. tostring(i))
			if isvalid(btn) then
				if i == self.jobIdx then
					btn.SpriteGUIRendererComponent.Color = Color(0.88, 0.61, 0.28, 1)
				else
					btn.SpriteGUIRendererComponent.Color = Color(0.96, 0.85, 0.66, 1)
				end
			end
		end
	end

	method void UpdateCompleteButtonState()
		local okBtn = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/CreateCharacterok")
		if isvalid(okBtn) then
			okBtn.ButtonComponent.Enable = self.jobIdx > 0
		end
	end

	@ExecSpace("ClientOnly")
	method void OnJobSelected(number idx)
		-- Reject stale selection events from other login phases.
		if (_LoginFlow.phase ~= "job" and _LoginFlow.phase ~= "create") or self._T.creationTab ~= "job" then return end
        if _AppearanceColorPicker:BlocksInput() or idx < 1 or idx > #self:GetJobItems() then return end
        if _LoginFlow.phase == "job" then _LoginFlow:ShowPhase("create",false) end
        self:ResetDemoPlayback()
		self.jobIdx = idx
		self._T.demoJob = nil
		self:UpdateAllText()
		self:ApplyCostume()
		self:UpdateJobButtonVisuals()
		self:UpdateCompleteButtonState()
		if Environment:IsMakerPlay() then log("[JobSelect] selected=" .. self:GetSelectedJobName()) end
	end

	method string GetSelectedJobName()
		if self.jobIdx <= 0 then return "" end
		return self:GetJobItems()[self.jobIdx]
	end

	method number Wrap(number idx, table list)
		if idx < 1 then
			return #list
		elseif idx > #list then
			return 1
		else
			return idx
		end
	end

	method void SetRowText(string rowName, string text)
		local path = self.Entity.Path .. "/" .. rowName .. "/FaceValueText"
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) then
			entity.TextGUIRendererComponent.Text = text
		end
	end

    method void UpdateAllText()
        -- Only hair and face are configurable; job equipment stays automatic.
        self:SetRowText("Row_Face", self:GetFaceItems()[self.faceIdx][1])
        self:SetRowText("Row_Hair", self:GetHairItems()[self.hairIdx][1])
    end

	method void ApplyCostume()
		-- Clear all old clothing before applying the selected job starter set.
		local preview = _EntityService:GetEntityByPath("/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/PreviewAvatar")
		if not isvalid(preview) then return end
		local cm = preview.CostumeManagerComponent
		if not isvalid(cm) then return end
		cm.UseCustomEquipOnly = true
		cm:SetEquip(MapleAvatarItemCategory.Body, "5b510a5cb03b4ba9bfe1b1666b17b2cf")
		cm:SetEquip(MapleAvatarItemCategory.Face, _UIEquipInventoryManager:ParseRUID(self:AppearanceItem(1)))
		cm:SetEquip(MapleAvatarItemCategory.Hair, _UIEquipInventoryManager:ParseRUID(self:AppearanceItem(2)))
		for _, category in ipairs({MapleAvatarItemCategory.Cap, MapleAvatarItemCategory.Cape, MapleAvatarItemCategory.Coat, MapleAvatarItemCategory.Longcoat, MapleAvatarItemCategory.Pants, MapleAvatarItemCategory.Glove, MapleAvatarItemCategory.Shoes, MapleAvatarItemCategory.OneHandedWeapon, MapleAvatarItemCategory.TwoHandedWeapon, MapleAvatarItemCategory.SubWeapon, MapleAvatarItemCategory.FaceAccessory, MapleAvatarItemCategory.EyeAccessory, MapleAvatarItemCategory.EarAccessory, MapleAvatarItemCategory.Ear}) do
			cm:SetEquip(category, "")
		end
		if self.jobIdx == 0 then
			cm:SetEquip(MapleAvatarItemCategory.Coat, "ae8d3590a96e48c3b7cd75d46ebd3f15")
			cm:SetEquip(MapleAvatarItemCategory.Pants, "61f10ef0a6204e0ab6593bdf36fed3e5")
		end
		local categories = {[3] = MapleAvatarItemCategory.Coat, [4] = MapleAvatarItemCategory.Pants, [5] = MapleAvatarItemCategory.Shoes, [6] = MapleAvatarItemCategory.TwoHandedWeapon, [7] = MapleAvatarItemCategory.Cap, [8] = MapleAvatarItemCategory.Cape, [9] = MapleAvatarItemCategory.Glove}
		for slot = 3, 9 do
			local item = _UIEquipInventoryManager:GetStarterEquipment(self.jobIdx, slot)
			if item ~= "" then
				local category = categories[slot]
				if slot == 3 and _UIEquipInventoryManager:IsLongcoatItem(item) then category = MapleAvatarItemCategory.Longcoat end
				if slot == 6 and _UIEquipInventoryManager:IsOneHandedJobWeapon(_UIEquipInventoryManager:ParseName(item)) then category = MapleAvatarItemCategory.OneHandedWeapon end
				cm:SetEquip(category, _UIEquipInventoryManager:ParseRUID(item))
			end
		end
		_DecoWindowManager:ApplyCostumeSnapshot(cm, self:CreationAppearance(""))
	end
	method void ConnectRowButtons(string rowName, any prevFunc, any nextFunc)
		-- Retain subscriptions so restarting play does not duplicate clicks.
		self._T.rowConnections = self._T.rowConnections or {}
		for _, row in ipairs({{"FacePrevButton", prevFunc}, {"FaceNextButton", nextFunc}}) do
			local button = _EntityService:GetEntityByPath(self.Entity.Path .. "/" .. rowName .. "/" .. row[1])
			if isvalid(button) then
				local connection = button:ConnectEvent(ButtonClickEvent, row[2])
				table.insert(self._T.rowConnections, {entity = button, connection = connection})
			end
		end
	end

	method void Init()
		if not self.buttonsConnected then
			self:ConnectRowButtons("Row_Face",   self.OnFacePrev,   self.OnFaceNext)
			self:ConnectRowButtons("Row_Hair",   self.OnHairPrev,   self.OnHairNext)
			self:ConnectRowButtons("Row_Top",    self.OnTopPrev,    self.OnTopNext)
			self:ConnectRowButtons("Row_Bottom", self.OnBottomPrev, self.OnBottomNext)
			self:ConnectRowButtons("Row_Shoes",  self.OnShoesPrev,  self.OnShoesNext)
			self:ConnectRowButtons("Row_Weapon", self.OnWeaponPrev, self.OnWeaponNext)
			self:ConnectRowButtons("Row_FaceColor", self.OnFaceColorPrev, self.OnFaceColorNext)
			self:ConnectRowButtons("Row_HairColor", self.OnHairColorPrev, self.OnHairColorNext)
			self.buttonsConnected = true
		end
		self:ConnectJobButtons()
		self._T.customHair = nil
		self._T.customFace = nil
		self._T.galleryKind = "hair"
        self._T.creationTab = "job"
        self._T.bookPhase = nil
		self._T.boardProgress = 0
		self:BindCreationBook()
		self.faceColorIdx = 1
		self.hairColorIdx = 1
		self.faceIdx   = 1
		self.hairIdx   = 1
		self.topIdx    = 1
		self.bottomIdx = 1
		self.shoesIdx  = 1
		self.weaponIdx = 1
		self.jobIdx    = 0
		self:UpdateAllText()
		self:ApplyCostume()
		self:UpdateJobButtonVisuals()
		self:UpdateCompleteButtonState()
	end

	method void OnFacePrev(ButtonClickEvent event)
		self.faceIdx = self:Wrap(self.faceIdx - 1, self:GetFaceItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnFaceNext(ButtonClickEvent event)
		self.faceIdx = self:Wrap(self.faceIdx + 1, self:GetFaceItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnHairPrev(ButtonClickEvent event)
		self.hairIdx = self:Wrap(self.hairIdx - 1, self:GetHairItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnHairNext(ButtonClickEvent event)
		self.hairIdx = self:Wrap(self.hairIdx + 1, self:GetHairItems())
		self:UpdateAllText()
		self:ApplyCostume()
	end

	method void OnTopPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnTopNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnBottomPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnBottomNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnShoesPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnShoesNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnWeaponPrev(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	method void OnWeaponNext(ButtonClickEvent event)
		-- Starter equipment cannot be changed.
		return
	end

	@ExecSpace("ClientOnly")
	method void OnFaceColorPrev(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetFaceItems()[self.faceIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.faceColorIdx = ((self.faceColorIdx - 1 + -1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end

	@ExecSpace("ClientOnly")
	method void OnFaceColorNext(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetFaceItems()[self.faceIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.faceColorIdx = ((self.faceColorIdx - 1 + 1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end

	@ExecSpace("ClientOnly")
	method void OnHairColorPrev(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetHairItems()[self.hairIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.hairColorIdx = ((self.hairColorIdx - 1 + -1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end

	@ExecSpace("ClientOnly")
	method void OnHairColorNext(ButtonClickEvent event)
		-- Cycle colors within the selected style.
		local row = self:GetHairItems()[self.hairIdx]
		local colors = _AppearanceColorCatalog:GetColors(row[2])
		self.hairColorIdx = ((self.hairColorIdx - 1 + 1) % #colors) + 1
		self:UpdateAllText()
		self:ApplyCostume()
	end


    @ExecSpace("ClientOnly")
    method Entity CreationUI(string name)
        -- Reuse UI references instead of traversing the scene tree every frame.
        self._T.creationUICache=self._T.creationUICache or {}
        local cached=self._T.creationUICache[name]
        if isvalid(cached) then return cached end
        local entity=_EntityService:GetEntityByPath("/ui/LoginScene/Stage/CreateCharacter/CreateCharacterBackground/"..name)
        if isvalid(entity) then self._T.creationUICache[name]=entity end
        return entity
    end

    @ExecSpace("ClientOnly")
    method string AppearanceItem(integer slot)
        if slot == 2 and self._T.customHair ~= nil then return self._T.customHair end
        if slot == 1 and self._T.customFace ~= nil then return self._T.customFace end
        local row = slot == 2 and self:GetHairItems()[self.hairIdx] or self:GetFaceItems()[self.faceIdx]
        return row[1] .. "|" .. row[2] .. "|" .. tostring(slot) .. "|0|0|0"
    end

    @ExecSpace("ClientOnly")
    method table CreationAppearance(string hairOverride)
        local eq = {}
        for i = 1, 27 do
            local item = ""
            if i <= 2 then item=self:AppearanceItem(i) elseif i<=9 then item=_UIEquipInventoryManager:GetStarterEquipment(self.jobIdx,i) end
            if i == 2 and hairOverride ~= "" then item = hairOverride end
            eq[i] = {name=_UIEquipInventoryManager:ParseName(item), ruid=_UIEquipInventoryManager:ParseRUID(item), item=item}
        end
        local finals = _DecoWindowManager:ComposeAppearance(eq,{},self.jobIdx)
        for _,f in ipairs(finals) do if f[1] == 5 then f[2] = "" end end
        table.insert(finals,{1,"5b510a5cb03b4ba9bfe1b1666b17b2cf"})
        return finals
    end

    @ExecSpace("ClientOnly")
    method void SetAppearanceColor(integer slot, string item)
        if _LoginFlow.phase ~= "create" then return end
        if slot == 2 then self._T.customHair = item else self._T.customFace = item end
        self:ApplyCostume()
        self:DrawCreationGallery()
        if Environment:IsMakerPlay() then log("[CreationBook] color applied slot=" .. tostring(slot)) end
    end

    @ExecSpace("ClientOnly")
    method void BindCreationBook()
        if self._T.creationConnections ~= nil then return end
        self._T.creationConnections = {}
        self._T.creationKey=_InputService:ConnectEvent(KeyDownEvent,function(event) self:OnCreationArrow(event.key) end)
        local function bind(path, callback)
            local e = self:CreationUI(path)
            if not isvalid(e) then return end
            local function activate()
                local now=_UtilLogic.ElapsedSeconds
                if not e.EnabledInHierarchy or _AppearanceColorPicker:BlocksInput() then return end
                self._T.creationTapAt=self._T.creationTapAt or {}
                if now-(self._T.creationTapAt[path] or -10)<0.35 then return end
                self._T.creationTapAt[path]=now
                callback()
            end
            local c=e:ConnectEvent(UITouchDownEvent,activate)
            table.insert(self._T.creationConnections,{entity=e,connection=c,touch=true})
            local click=e:ConnectEvent(ButtonClickEvent,activate)
            table.insert(self._T.creationConnections,{entity=e,connection=click,touch=false})
        end
        for _,kind in ipairs({"Hair","Face"}) do
            local chosen = string.lower(kind)
            local callback = function()
                self:SelectCreationTab(chosen)
            end
            bind("CreationBook/Gallery/"..kind,callback)
            bind("CharacterSettingPanel/Row_"..kind.."/Choose",callback)
        end
        bind("CharacterSettingPanel/Row_Job/Choose",function() self:SelectCreationTab("job") end)
        bind("CreationBook/Gallery/Color",function()
            if _LoginFlow.phase == "create" then _AppearanceColorPicker:Open("creation",self._T.galleryKind == "face" and 1 or 2,"") end
        end)
        bind("CreationBook/Gallery/Previous",function() self:ChangeGalleryPage(-1) end)
        bind("CreationBook/Gallery/Next",function() self:ChangeGalleryPage(1) end)
        for i=1,8 do
            local slot=i
            bind("CreationBook/Gallery/Card"..tostring(i),function()
                if _LoginFlow.phase ~= "create" or _AppearanceColorPicker.opened then return end
                local hair=self._T.galleryKind ~= "face"
                local items=hair and self:GetHairItems() or self:GetFaceItems()
                local index=((self._T.galleryPage or 1)-1)*8+slot
                if index > #items then return end
                if hair then self.hairIdx=index self._T.customHair=nil else self.faceIdx=index self._T.customFace=nil end
                self:UpdateAllText()
                self:ApplyCostume()
                self:DrawCreationGallery()
                _UIAudio:Play("Tab")
            end)
        end
        if Environment:IsMakerPlay() then log("[CreationBook] gallery ready hair=17 face=9") end
    end



    @ExecSpace("ClientOnly")
    method void DrawCreationGallery()
        -- Show actual head avatars with the same dye pipeline as the creation preview.
        local hair=self._T.galleryKind ~= "face"
        local items=hair and self:GetHairItems() or self:GetFaceItems()
        local selected=hair and self.hairIdx or self.faceIdx
        local appearance=self:CreationAppearance("")
        local preview=self:CreationUI("CreationBook/Gallery/Preview")
        _DecoWindowManager:ApplyCostumeSnapshot(preview.CostumeManagerComponent,appearance)
        preview.AvatarGUIRendererComponent.FlipX=false
        preview:SendEvent(BodyActionStateChangeEvent(true,MapleAvatarBodyActionState.Stand))
        local hairPart,facePart
        for _,part in ipairs(appearance) do
            if part[1]==3 then hairPart=part elseif part[1]==4 then facePart=part end
        end
        self._T.galleryLooks=self._T.galleryLooks or {}
        local pages=math.max(1,math.ceil(#items/8))
        local page=math.max(1,math.min(pages,self._T.galleryPage or 1))
        self._T.galleryPage=page
        self:CreationUI("CreationBook/Gallery/Page").TextGUIRendererComponent.Text=tostring(page).." / "..tostring(pages)
        self:CreationUI("CreationBook/Gallery/Previous").ButtonComponent.Enable=page>1
        self:CreationUI("CreationBook/Gallery/Next").ButtonComponent.Enable=page<pages
        for i=1,17 do
            local e=self:CreationUI("CreationBook/Gallery/Card"..tostring(i))
            local index=(page-1)*8+i
            e.Enable=i<=8 and index<=#items
            if i<=8 and index<=#items then
                local row=items[index]
                local ruid=row[2]
                if index==selected then ruid=_UIEquipInventoryManager:ParseRUID(self:AppearanceItem(hair and 2 or 1)) end
                e.SpriteGUIRendererComponent.Color=index==selected and Color(1,0.78,0.34,1) or Color(0.91,0.85,0.71,1)
                local avatar=e:GetChildByName("Head"):GetChildByName("Avatar")
                local cm=avatar.CostumeManagerComponent
                local headScale=hair and 0.6 or 1.05
                avatar.UITransformComponent.UIScale=Vector3(headScale,headScale,1)
                avatar.UITransformComponent.anchoredPosition=Vector2(0,hair and -30 or -47)
                local hp=hair and index~=selected and {3,ruid} or hairPart
                local fp=not hair and index~=selected and {4,ruid} or facePart
                local lookKey=hp[2]..tostring(hp[3])..tostring(hp[4])..fp[2]..tostring(fp[3])..tostring(fp[4])
                if self._T.galleryLooks[i]~=lookKey then
                    cm.UseCustomEquipOnly=true
                    _DecoWindowManager:ApplyCostumeSnapshot(cm,{{1,"5b510a5cb03b4ba9bfe1b1666b17b2cf"},hp,fp})
                    avatar.AvatarGUIRendererComponent.Color=Color.white
                    avatar:SendEvent(BodyActionStateChangeEvent(true,MapleAvatarBodyActionState.Stand))
                    self._T.galleryLooks[i]=lookKey
                end
                local label=string.gsub(row[1],"^%S+색 ","")
                label=string.gsub(label," 헤어$","")
                label=string.gsub(label," Hair$","")
                e:GetChildByName("Name").TextGUIRendererComponent.Text=label
            end
        end
        self:CreationUI("CreationBook/Title").TextGUIRendererComponent.Text=hair and "마음에 드는 헤어를 선택하세요" or "마음에 드는 성형을 선택하세요"
        self:CreationUI("CreationBook/Footer").TextGUIRendererComponent.Text=hair and "선택한 헤어는 두 색과 비율을 조절할 수 있어요." or "선택한 얼굴의 눈 색상을 바꿀 수 있어요."
    end





    @ExecSpace("ClientOnly")
    method void UpdateCreation(number delta)
        local active=(_LoginFlow.phase=="job" or _LoginFlow.phase=="create")
        if not active then
            if self._T.demoWasActive then self:ResetDemoPlayback() self:HideDemoCapture() self._T.demoWasActive=false end
            if _AppearanceColorPicker.opened and _AppearanceColorPicker._T.source=="creation" then _AppearanceColorPicker:Close() end
            return
        end
        self._T.demoWasActive=true
        local target=1
        local p=self._T.boardProgress or 0
        p=p+math.max(-delta/0.45,math.min(delta/0.45,target-p))
        local changed=p~=(self._T.boardProgress or 0)
        self._T.boardProgress=p
        _LoginFlow._T.creationBookProgress=p
        if changed then _LoginFlow:ApplyCamera() end
        local shift=-240*p*p*(3-2*p)
        if self._T.boardOriginal==nil then
            self._T.boardOriginal={}
            for _,name in ipairs({"Signboard","FrameTop","FrameBottom","FrameLeft","FrameRight","CharacterSettingPanel","JobSelectPanel","CreateCharacterName","CreateCharacterok","Cancel","NameRules"}) do
                local e=self:CreationUI(name)
                if isvalid(e) then table.insert(self._T.boardOriginal,{entity=e,x=e.UITransformComponent.anchoredPosition.x,y=e.UITransformComponent.anchoredPosition.y}) end
            end
        end
        if changed or not self._T.boardPlaced then
            for _,rec in ipairs(self._T.boardOriginal) do if isvalid(rec.entity) then rec.entity.UITransformComponent.anchoredPosition=Vector2(rec.x+shift,rec.y) end end
            self._T.boardPlaced=true
        end
        local preview=self:CreationUI("PreviewAvatar")
        local appearanceTab=(self._T.creationTab or "job")~="job"
        if not self._T.previewPlaced then
            preview.UITransformComponent.anchoredPosition=Vector2(405,165)
            preview.UITransformComponent.UIScale=Vector3(1,1,1)
            preview.AvatarGUIRendererComponent.FlipX=false
            self._T.previewPlaced=true
        end
        local book=self:CreationUI("CreationBook")
        if not book.Enable then book.Enable=true end
        if target==0 then return end
        local tab=self._T.creationTab or "job"
        local isJob=tab=="job"
        local demo=self:CreationUI("CreationBook/Demo")
        if demo.Enable~=(isJob and self.jobIdx>0) then demo.Enable=isJob and self.jobIdx>0 end
        local joblist=self:CreationUI("CreationBook/JobList")
        if joblist.Enable~=(isJob) then joblist.Enable=isJob end
        local jobprompt=self:CreationUI("CreationBook/JobPrompt")
        if jobprompt.Enable~=(isJob and self.jobIdx<=0) then jobprompt.Enable=isJob and self.jobIdx<=0 end
        local gallery=self:CreationUI("CreationBook/Gallery")
        if gallery.Enable~=(not isJob) then gallery.Enable=not isJob end
        local key=tab..":"..tostring(self.jobIdx)
        if self._T.bookPhase~=key then
            self._T.bookPhase=key
            for _,part in ipairs({"Hair","Face","Job"}) do
                local button=self:CreationUI("CharacterSettingPanel/Row_"..part.."/Choose")
                button.SpriteGUIRendererComponent.Color=string.lower(part)==tab and Color(0.88,0.61,0.28,1) or Color(0.96,0.83,0.60,1)
            end
            if not isJob then
                self:DrawCreationGallery()
            elseif self.jobIdx>0 then
                self._T.demoJob=nil
            else
                self:CreationUI("CreationBook/Title").TextGUIRendererComponent.Text="직업을 선택하세요"
                self:CreationUI("CreationBook/Footer").TextGUIRendererComponent.Text="직업에 맞는 기본 장비가 자동으로 적용됩니다."
            end
        end
        if isJob and self.jobIdx>0 then self:UpdateJobDemo(delta) else self:StopDemoAudio() self:HideDemoCapture() end
    end








