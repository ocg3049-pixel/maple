@Component
script LadderTopExit extends Component
    property number LandingOffsetY = -0.08

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Keep the native grab margin; this cap releases only players climbing above its landing.
        if Environment:IsMakerPlay() then log("[VRF] LadderTopExit ready " .. self.Entity.Name) end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Character movement is client-owned, so detach and land on the same authority as climbing.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMap ~= self.Entity.CurrentMap then return end
        local state = player.StateComponent
        if not isvalid(state) or (state.CurrentStateName ~= "LADDER" and state.CurrentStateName ~= "CLIMB") then return end
        local climb = self.Entity.ClimbableComponent
        if not isvalid(climb) or not climb.Enable then return end
        local transform = self.Entity.TransformComponent
        local landing = transform:ToWorldPoint(Vector3(0, self.LandingOffsetY, 0))
        local center = transform:ToWorldPoint(Vector3(climb.BoxOffset.x, climb.BoxOffset.y, 0))
        local edge = transform:ToWorldPoint(Vector3(climb.BoxOffset.x + climb.BoxSize.x * 0.5, climb.BoxOffset.y + climb.BoxSize.y * 0.5, 0))
        local pos = player.TransformComponent.WorldPosition
        if math.abs(pos.x - center.x) > math.abs(edge.x - center.x) + 0.02 then return end
        if pos.y <= landing.y + 0.0005 or pos.y > edge.y + 0.35 then return end
        local body = player.RigidbodyComponent
        local movement = player.MovementComponent
        if not isvalid(body) or not isvalid(movement) then return end
        body:Detach()
        movement:Stop()
        body:SetForce(Vector2.zero)
        movement:SetWorldPosition(Vector2(pos.x, landing.y + 0.001))
        if Environment:IsMakerPlay() then log("[VRF] LadderTopExit landed " .. self.Entity.Name .. " from=" .. tostring(pos.y) .. " to=" .. tostring(landing.y + 0.001)) end
    end
end
