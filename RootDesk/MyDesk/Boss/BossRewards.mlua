@Logic
script BossRewards extends Logic
    method integer Week(number now)
        -- January 1, 2026 is Thursday; midnight in Korea is 15:00 UTC the previous day.
        return math.floor((now-(DateTime(2026,1,1).Elapsed-9*3600000))/604800000)
    end

    method table Read(string snapshot)
        -- Only the server creates these immutable weekly loot rolls.
        local raw=string.match("\n"..(snapshot or ""),"\nBWRD\t([^\r\n]+)")
        if raw then
            local ok,data=pcall(function() return _HttpService:JSONDecode(raw) end)
            if ok and type(data)=="table" and data.v==1 then data.weeks=data.weeks or {} data.bundles=data.bundles or {} return data end
        end
        return {v=1,weeks={},bundles={}}
    end

    method string Record(table data)
        -- Empty maps are omitted because the native JSON encoder needs concrete types.
        return "BWRD\t".._HttpService:JSONEncode(_OfflineRestRewards:JsonTable(data))
    end

    method string Write(string snapshot, table data)
        -- Replace exactly this ledger and preserve the rest of the character snapshot.
        local lines={}
        for line in string.gmatch(snapshot or "","[^\r\n]+") do if string.sub(line,1,5)~="BWRD\t" then table.insert(lines,line) end end
        table.insert(lines,self:Record(data)) return table.concat(lines,"\n")
    end

    method boolean Eligible(table data, integer stage, integer week)
        -- Each boss has its own lockout; earlier legacy title clears do not consume it.
        return (tonumber(data.weeks[tostring(stage)]) or -999999)<week
    end

    method table Bundle(string snapshot, integer key)
        -- Server validation always resolves the bundle from the authoritative save.
        return self:Read(snapshot).bundles[tostring(key)] or {}
    end

    method boolean IsShell(string item)
        -- Use the actual icon field, not a translated display name.
        return string.match(item or "","^[^|]*|([^|]+)")=="3eb056d03f034a29b52bfa917319d71a"
    end

    @ExecSpace("ClientOnly")
    method integer AttackBonus()
        -- Possession in ETC grants one flat bonus; it never changes equipment-based level.
        local inv=_UIEquipInventoryManager
        if inv._T.tabData==nil then return 0 end
        for i=1,128 do if self:IsShell(inv:GetTabItem("etc",i)) then return 10 end end
        return 0
    end

    @ExecSpace("ServerOnly")
    method table Roll(Entity player, integer stage)
        -- Roll 2,000 ordinary monsters at this boss's recommended level.
        local attack=player:GetComponent("script.PlayerAttack")
        local dropMult=isvalid(attack) and 1+attack:GetDropRateBonusPct()/100 or 1
        local mesoMult=isvalid(attack) and 1+attack:GetMesoRateBonusPct()/100 or 1
        local level=_RegionTierLogic:GetServerLevelOf(player)
        local rewardLevel=_BossStageManager:Stage(stage).recommended or 20
        local rate=level>0 and _RegionTierLogic:GetLevelDropRate(rewardLevel,level) or 1
        local bundle={meso=0,items={}}
        for i=1,2000 do
            local amount=_MonsterDropRules:CalculateMeso(_RegionTierLogic:RollMesoForLevel(rewardLevel),mesoMult,rate)
            if _UtilLogic:RandomDouble()<_MonsterDropRules:GetMesoDropChance(rate) then bundle.meso=bundle.meso+amount end
        end
        local itemTable=_MonsterDropRules:GetItems()
        for i=1,2000 do
            for _,drop in ipairs(itemTable) do
                local chance=_MonsterDropRules:CalculateItemChance(drop.rate,drop.fixedRate==true,dropMult,rate)
                if _UtilLogic:RandomDouble()<chance then
                    local item=drop.name.."|"..drop.ruid.."|0|0|0|0|1"
                    if drop.type=="cosmetic_roll" then
                        local categories=_CosmeticBoxCatalog:DropCategories()
                        local category=categories[_UtilLogic:RandomIntegerRange(1,#categories)]
                        item=_CosmeticBoxCatalog:BoxItem("cosmetic:"..category.key,1)
                    end
                    table.insert(bundle.items,item)
                end
            end
        end
        -- The rare roll is exactly 2%, independent of drop buffs and level difference.
        if stage==1 and _UtilLogic:RandomDouble()<0.02 then table.insert(bundle.items,"무지개색 달팽이 등껍질|3eb056d03f034a29b52bfa917319d71a|0|0|0|0|1") end
        if Environment:IsMakerPlay() then log("[VRF] BossReward rolls=2000 level="..tostring(rewardLevel).." meso="..tostring(bundle.meso).." items="..tostring(#bundle.items)) end
        return bundle
    end

    @ExecSpace("ServerOnly")
    method Vector3 ResolveLootPosition(Entity boss)
        local thief=boss:GetComponent("script.ThiefEncounter")
        if isvalid(thief) and thief._T.lastDefeatedPosition~=nil then return thief._T.lastDefeatedPosition end
        local stumpy=boss:GetComponent("script.StumpyEncounter")
        if isvalid(stumpy) and stumpy.SlamStarted>=0 then
            return stumpy.SlamOrigin+Vector3(0,stumpy:JumpHeight(_UtilLogic.ServerElapsedSeconds-stumpy.SlamStarted),0)
        end
        local king=boss:GetComponent("script.KingSlimeEncounter")
        if isvalid(king) and king.JumpStarted>=0 then
            return king.JumpOrigin+Vector3(0,king:JumpHeight(_UtilLogic.ServerElapsedSeconds-king.JumpStarted),0)
        end
        return boss.TransformComponent.WorldPosition
    end

    @ExecSpace("ServerOnly")
    method void Award(table run)
        -- Reserve the roll before any drop. Re-entry, retries and disconnects cannot reroll it.
        local sv=_CharacterPersistence._T.sv[run.uid]
        local player=_UserService:GetUserEntityByUserId(run.uid)
        if run.practice or sv==nil or sv.activeId~=run.id or not isvalid(player) then return end
        local data=self:Read(sv.saves[run.id] or "")
        local week=self:Week(DateTime.UtcNow.Elapsed)
        if not self:Eligible(data,run.stage,week) then return end
        local key=100000+week*100+run.stage
        local bundle=self:Roll(player,run.stage) bundle.stage=run.stage bundle.week=week
        -- Claimed historic bundles can be pruned; unclaimed bundles survive future weeks.
        local receipts=_EventRewards:ReadState(sv.saves[run.id] or "")
        for old in pairs(data.bundles) do if _EventRewards:HasLevel(receipts,tonumber(old)) then data.bundles[old]=nil end end
        data.weeks[tostring(run.stage)]=week data.bundles[tostring(key)]=bundle
        sv.saves[run.id]=self:Write(sv.saves[run.id] or "",data)
        sv.dirtySaves[run.id]=true
        local position=run.rewardPosition or (isvalid(run.boss) and self:ResolveLootPosition(run.boss) or player.TransformComponent.WorldPosition)
        local map=player.CurrentMap
        local saved=_CharacterPersistence:WriteCharacterSaves(sv,true)
        self:Receive(run.id,self:Record(data),run.uid)
        if isvalid(map) and isvalid(player) and player.CurrentMap==map then self:SpawnLoot(map,position,bundle,key,run.uid,run.id) end
        self:Notice(saved and "주간 보상이 떨어졌습니다. 미수령 보상은 보상창에 보관됩니다." or "주간 보상을 보관했습니다. 보상창에서 저장 확인 후 받을 수 있습니다.",run.uid)
        if Environment:IsMakerPlay() then log("[BossRewards] reserved stage="..tostring(run.stage).." week="..tostring(week).." meso="..tostring(bundle.meso).." saved="..tostring(saved)) end
    end

    method table LootRows(table bundle)
        -- Split only the visuals: every pile shares the original single-claim reward receipt.
        local drops={}
        local meso=math.max(0,math.floor(tonumber(bundle.meso) or 0))
        local piles=math.min(30,meso)
        if piles>0 then
            local each=math.floor(meso/piles)
            local remainder=meso%piles
            for i=1,piles do
                local amount=each+(i<=remainder and 1 or 0)
                local ruid=amount<50 and "a724200c454c4fcf878b0a3cdbb706d6" or amount<100 and "5c78b56b91964dcaa83c1d30b8cd3cce" or amount<1000 and "c3fe3ffa606f41069ce8b36278e9e7e8" or "f0aa7764ff5344848d59accafa2dbf6e"
                table.insert(drops,{name=tostring(amount),ruid=ruid,kind="meso"})
            end
        end
        for _,item in ipairs(bundle.items or {}) do
            table.insert(drops,{name=string.match(item,"^([^|]+)") or "전리품",ruid=string.match(item,"^[^|]+|([^|]+)") or "",kind=self:IsShell(item) and "etc" or "sprite"})
        end
        return drops
    end

    @ExecSpace("ServerOnly")
    method void SpawnLoot(Entity map, Vector3 position, table bundle, integer key, string uid, string id)
        -- Fan out the same durable reward; recovery potions are never part of boss loot.
        local drops=self:LootRows(bundle)
        local rare=false
        for _,row in ipairs(drops) do if row.kind=="etc" then rare=true break end end
        local centerX=position.x
        local edge=#map:GetChildComponentsByTypeName("script.ThiefEncounter",true)>0 and 14.6 or 6.8
        local left=-edge local right=edge
        local regional=map:GetFirstChildComponentByTypeName("script.RegionalBossEncounter",true)
        if isvalid(regional) then local d=regional:Data() left=d.left+0.3 right=d.right-0.3 end
        for i,row in ipairs(drops) do
            local entity=_SpawnService:SpawnByModelId(row.kind=="meso" and "droppedmeso" or "droppedshell","BossLoot"..tostring(key).."_"..tostring(i),position,map)
            if isvalid(entity) then
                local drop=entity:GetComponent("script.DroppedItemComponent")
                drop.ItemName=row.name drop.ItemRUID=row.ruid drop.ItemType=row.kind drop.KillerUserId=uid
                drop.BossRewardKey=key drop.BossRewardCharacter=id
                -- Even lanes plus alternating heights keep the shower readable at either arena edge.
                local lane=#drops>1 and (i-1)/(#drops-1) or 0.5
                local upwardSpeed=6.8+((i-1)%5)*0.45
                local flightTime=2*upwardSpeed/math.abs(drop.gravity)
                local landingX=math.max(left,math.min(right,centerX+(lane-0.5)*7.2))
                drop._T.vx=(landingX-position.x)/flightTime drop._T.vy=upwardSpeed
                drop.settleDuration=(rare and 3 or 1.1)+((i-1)%6)*0.08
                entity.SpriteRendererComponent.SpriteRUID=row.ruid
                entity.SpriteRendererComponent.DrawMode=SpriteDrawMode.Simple
                if row.name=="장비 상자" then _MonsterDropRules:ApplyEquipmentBoxVisual(entity) end
                if row.kind=="etc" then drop.GroundOffset=0.35 end
            end
        end
        if Environment:IsMakerPlay() then log("[VRF] BossLoot origin="..tostring(position).." piles="..tostring(#drops).." meso="..tostring(bundle.meso).." potions=0") end
        if rare then self:Flash(uid) end
        if #drops==0 then self:Collect(id,key,uid) end
    end

    @ExecSpace("Client")
    method void Receive(string id, string record)
        -- Character identity prevents a delayed reply from leaking between slots.
        if id~=self._T.id then return end
        self._T.data=self:Read(record)
        if _BossStageManager.opened then _BossStageManager:Draw() end
    end

    @ExecSpace("ClientOnly")
    method void Restore(string id, string snapshot)
        -- Restore pending bundles even if the player disconnected during the clear animation.
        self._T.id=id self._T.data=self:Read(snapshot) self._T.autoKey=nil
        if _BossStageManager.opened then _BossStageManager:Draw() end
    end

    @ExecSpace("Client")
    method void Collect(string id, integer key)
        -- Multiple ground items can request the same bundle; the receipt allows only one grant.
        if id~=self._T.id or _EventRewards:HasLevel(_EventRewards._T.state or _EventRewards:ReadState(""),key) then return end
        _GameAudio:PlaySound("c6da79f93bc34e7cb213080a00f09fef",1.0)
        self._T.autoKey=key self._T.autoAt=_UtilLogic.ElapsedSeconds+0.25
    end

    @ExecSpace("Client")
    method void Notice(string message)
        -- Keep failure recovery visible without interrupting the clear animation.
        _UIToast:ShowMessage(message)
    end

    @ExecSpace("ClientOnly")
    method Entity UI(string path)
        -- Non-interactive overlay stays independent of modal input and camera movement.
        return _EntityService:GetEntityByPath("/ui/BossLoot/"..path)
    end

    @ExecSpace("Client")
    method void Flash()
        -- Clone to restart the clip at frame zero; the native end event removes it after one play.
        self:ClearFlash()
        local e=self:UI("FlashTemplate"):Clone("RareDropFlash")
        self._T.flash=e
        e.SpriteGUIRendererComponent.ImageRUID=DataRef("755980d09e4847d4b351ad211f1feaa0")
        e.SpriteGUIRendererComponent.PlayRate=1
        e.SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Onetime
        self._T.flashEnd=e:ConnectEvent(SpriteGUIAnimPlayerEndEvent,function() self:ClearFlash() end)
        self:FitFlash(e) e.Enable=true self._T.flashUntil=_UtilLogic.ElapsedSeconds+8
        if Environment:IsMakerPlay() then log("[BossRewards] rare flash started once") end
    end

    @ExecSpace("ClientOnly")
    method void FitFlash(Entity e)
        -- Cover the full actual viewport, including ultrawide and mobile aspect ratios.
        local tr=e.Parent.UITransformComponent
        local a=_UILogic:ScreenToLocalUIPosition(Vector2.zero,tr)
        local b=_UILogic:ScreenToLocalUIPosition(Vector2(_UILogic.ScreenWidth,_UILogic.ScreenHeight),tr)
        e.UITransformComponent.anchoredPosition=(a+b)*0.5
        local size=math.max(math.abs(b.x-a.x)/1400,math.abs(b.y-a.y)/800)
        e.UITransformComponent.RectSize=Vector2(1400*size,800*size)
    end

    @ExecSpace("ClientOnly")
    method void ClearFlash()
        -- Explicit event cleanup is required when an arena closes before the clip finishes.
        local e=self._T.flash
        if isvalid(e) then
            if self._T.flashEnd then e:DisconnectEvent(SpriteGUIAnimPlayerEndEvent,self._T.flashEnd) end
            e:Destroy() if Environment:IsMakerPlay() then log("[BossRewards] rare flash ended") end
        end
        self._T.flash=nil self._T.flashEnd=nil
    end

    @ExecSpace("ClientOnly")
    method void Acquired(table gifts)
        -- Successful boss reward receipts use the same background-free pickup notification.
        for _,item in ipairs(gifts) do
            _ItemPickupLogic:ShowDropNotice(_UIEquipInventoryManager:ParseName(item),_UIEquipInventoryManager:ParseRUID(item),self:IsShell(item) and "etc" or "sprite")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- No storage polling: only local animation expiry and one pickup-triggered claim.
        local now=_UtilLogic.ElapsedSeconds
        if isvalid(self._T.flash) then self:FitFlash(self._T.flash) if now>=(self._T.flashUntil or 0) then self:ClearFlash() end end
        if self._T.goldUntil then
            local e=self:UI("Acquired")
            if now>=self._T.goldUntil then e.Enable=false self._T.goldUntil=nil
            else
                local tr=e.Parent.UITransformComponent
                local a=_UILogic:ScreenToLocalUIPosition(Vector2.zero,tr)
                local b=_UILogic:ScreenToLocalUIPosition(Vector2(_UILogic.ScreenWidth,_UILogic.ScreenHeight),tr)
                e.UITransformComponent.anchoredPosition=Vector2((a.x+b.x)*0.5,b.y-math.abs(b.y-a.y)*0.10)
                e.UITransformComponent.RectSize=Vector2(math.abs(b.x-a.x)*0.95,90)
                e.TextGUIRendererComponent.FontSize=math.min(40,math.abs(b.x-a.x)/24)
                e.TextGUIRendererComponent.FontColor=Color(1,0.8,0.2,math.min(1,self._T.goldUntil-now))
            end
        end
        local key=self._T.autoKey
        if key and _BossStageManager._T.battle~=true and now>=(self._T.autoAt or 0) and _LoginFlow:IsInGame() and not _RewardCenter.opened and (not _GameSystemMenu:BlocksInput() or (_BossStageManager._T.result==true and not _GameSystemMenu.opened)) and _EventRewards._T.ready and not _RewardCenter:Pending() then
            self._T.autoKey=nil
            if not _EventRewards:HasLevel(_EventRewards._T.state,key) then
                if not _EventRewards:ClaimFromCenter("boss",key) then _UIToast:ShowMessage("보스 보상을 보상창에 보관했습니다. 가방 공간을 확인해주세요.") end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Normalize unusual source pivots once, outside the animation update loop.
        local ids={"3eb056d03f034a29b52bfa917319d71a","d5a2e9cbe4e5440cae77cfe3def85bde"}
        _ResourceService:PreloadAsync(ids,function()
            local centers={}
            for _,id in ipairs(ids) do
                local sprite=_ResourceService:LoadSpriteAndWait(id)
                if sprite and sprite.IsLoadComplete then centers[id]=Vector3((sprite.Width/2-sprite.PivotPixel.x)/math.max(1,sprite.PixelPerUnit),(sprite.Height/2-sprite.PivotPixel.y)/math.max(1,sprite.PixelPerUnit),0) end
            end
            if centers[ids[1]] and centers[ids[2]] then self._T.auraOffset=centers[ids[1]]-centers[ids[2]]*0.22 end
        end)
        if Environment:IsMakerPlay() then log("[BossRewards] weekly ledger and rare overlay ready") end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Do not retain animation event listeners after stopping the Maker.
        self:ClearFlash()
    end
end
