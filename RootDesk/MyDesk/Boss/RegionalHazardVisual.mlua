@Component
script RegionalHazardVisual extends Component
    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        local pixel=self.Entity.PixelRendererComponent
        local sprite=self.Entity.SpriteRendererComponent
        if not isvalid(pixel) or not isvalid(sprite) then return end
        local c=sprite.Color
        if self._T.color==nil or self._T.color~=c then
            -- Telegraph only: a translucent center with an opaque dashed edge.
            pixel:ResetWithColor(16,16,Color(c.r,c.g,c.b,0.12))
            local edge=Color(c.r,c.g,c.b,0.9)
            for i=1,16 do
                if (i-1)%4<3 then
                    pixel:SetPixel(i,1,edge) pixel:SetPixel(i,16,edge)
                    pixel:SetPixel(1,i,edge) pixel:SetPixel(16,i,edge)
                end
            end
            pixel.SortingLayer="MapLayer7" pixel.OrderInLayer=80
            self._T.color=c
        end
    end
end
