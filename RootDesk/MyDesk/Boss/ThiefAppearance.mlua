            "75ab266b2a05437f82330c2f73ca26ef", -- 검은색 언밸런스 레이어컷
            "ee87991ffda04ba2a04fadba3ab43dec", -- 검은색 아주삐쭉 헤어
            "c3bc1bcb8f0d484ca483ab92c08d6b7b", -- 검은색 나이트 헤어
            "e6834347495d47619d2a2440c9124b00", -- 검은색 윈드 샤기컷
            "262327333eff480ebc02f2d72487ef67", -- 검은색 콘로우헤어
            "53edbe247a7445b7bd93b14f559514cd", -- 검은색 스파르타 헤어
            "be5b0897ee4544f1ad32fef8c6265e4f", -- 검은색 노틸러스 헤어
            "c9a81c25c32e4f74811d391b284ae5c9", -- 검은색 허쉬 헤어
            "6ecedd99426e48dfa688dc17d2267a85", -- 검은색 무결 헤어
            "d60c0286255a474f972d15f5086062cc", -- 검은색 시크릿 투톤 헤어
            "76b8e0ad7d9745beb81a0c6ccad69bef", -- 검은색 아토믹 헤어
            "fe59954a28214032862dd47172dd3497", -- 검은색 스타 라이더 헤어
        }
    end

    method table Faces()
        return {
            "9b5d7ca4c5d54b00ac3c523d6541547f", -- 반항적인 얼굴
            "598d546c71744ad3b2d466b2854daa03", -- 카리스마 듀블
            "6ea978f14bb243c0a5311a915e05e688", -- 도전적인 얼굴
            "b2cd0bb4646e49ef86ae39bd6fb91af8", -- 차가운 얼굴
            "78db282dd8a34b8ab6554478fc16d8d4", -- 냉정한 얼굴
            "653b41fe2a3d47949f1b824cf06c7212", -- 강인한 오드아이
            "93f5aecc7d77440098fdfd6e1156cf3c", -- 괴도 팬텀 얼굴
            "df1ad26f9b5645719dd60a1d55352606", -- 샤프한 얼굴
            "e82ae5ced3e544cf83bf85866ee39622", -- 시크한 얼굴
            "207148fa147346edb561653c604459d8", -- 매서운 얼굴
            "924e423b4d214adf80e08343f05912fd", -- 이카르트 얼굴
            "76fb731cdf274cafbd81eed13d5b590d", -- 강렬한 얼굴
            "f13f8b793533400c995cc877039fc7cb", -- 비장한 얼굴
            "27f959ec4e8f4ea0bc02a2c38bf424c3", -- 자신있는 얼굴
            "80adfb9d950f4184be96b248a48aee24", -- 신중한 얼굴
            "b42131f130c84032ae4db7b1b852e253", -- 단호한 얼굴
            "6c5a7ef8f812421dbf826a321d3a02d6", -- 호전적인 얼굴
            "de22fd3aec584baaa1f4204d02052da3", -- 야심찬 얼굴
            "af2c7be045794c268af4c25f5ea5c5c0", -- 크로우 얼굴
            "5556fc0a221a48a7952df084f9077e8f", -- 무심한 얼굴
        }
    end

    method string RandomName()
        local letters={"l","i","I"}
        local chars={"l","i","I"}
        local length=_UtilLogic:RandomIntegerRange(6,10)
        for i=4,length do chars[i]=letters[_UtilLogic:RandomIntegerRange(1,3)] end
        for i=length,2,-1 do
            local j=_UtilLogic:RandomIntegerRange(1,i)
            chars[i],chars[j]=chars[j],chars[i]
        end
        return table.concat(chars)
    end

    method void Weapon(Entity entity, integer job)
        local row=_UIEquipInventoryManager:GetEquipmentAppearance(job,6,3)
        if row==nil or (row[6]~="weapon" and row[6]~="twohandweapon") then return end
        local cm=entity.CostumeManagerComponent
        if row[6]=="twohandweapon" then
            cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon,"")
            cm:SetEquip(MapleAvatarItemCategory.SubWeapon,"")
            if cm.CustomTwoHandedWeaponEquip~=row[5] then cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon,row[5]) end
        else
            cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon,"")
            if cm.CustomOneHandedWeaponEquip~=row[5] then cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon,row[5]) end
        end
    end

    method void Apply(Entity entity, integer job, boolean leader)
        local cm=entity.CostumeManagerComponent
        cm.UseCustomEquipOnly=true
        cm:SetEquip(MapleAvatarItemCategory.Body,"3cf4cb29ae344577b9eed37e531688a4")
        local hairs=self:Hairs() local faces=self:Faces()
        cm:SetEquip(MapleAvatarItemCategory.Hair,hairs[leader and 2 or _UtilLogic:RandomIntegerRange(1,#hairs)])
        cm:SetEquip(MapleAvatarItemCategory.Face,faces[leader and 2 or _UtilLogic:RandomIntegerRange(1,#faces)])
        local categories={cap=MapleAvatarItemCategory.Cap,cape=MapleAvatarItemCategory.Cape,longcoat=MapleAvatarItemCategory.Longcoat,coat=MapleAvatarItemCategory.Coat,pants=MapleAvatarItemCategory.Pants,shoes=MapleAvatarItemCategory.Shoes,glove=MapleAvatarItemCategory.Glove,weapon=MapleAvatarItemCategory.OneHandedWeapon,twohandweapon=MapleAvatarItemCategory.TwoHandedWeapon}
        for _,slot in ipairs({6,7,3,8,5,9}) do
            local row=_UIEquipInventoryManager:GetEquipmentAppearance(job,slot,3)
            if row~=nil and categories[row[6]]~=nil then cm:SetEquip(categories[row[6]],row[5]) end
        end
    end
end
