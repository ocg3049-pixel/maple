            "8961e58b87d14fecbb6660976088f324", -- 검은색 와일드 헤어
            "36b72f68f9fe4ae3912f1616fe992ba9", -- 검은색 스파이키 헤어
            "69dd4956cc044be295a72ad6343634bd", -- 검은색 뺀질이 헤어
