                [11]={["stage"]=11,["name"]="설산의 마녀",["mapTitle"]="설원의 성지",["episode"]="눈보라 속에서 길을 묻는 목소리를 따라가서는 안 된다. 설산의 마녀는 따뜻한 숨결을 모으기 위해 얼음꽃으로 모험가의 발자국을 덮는다.",["source"]="211040401",["map"]="regional_boss_11",["model"]="regionalboss11",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=48,["recommended"]=53,["hp"]=156962,["mult"]=3.2973039591039996,["portrait"]="4b50438f59154f41aba918b2d28bb8d2",["stand"]="4b50438f59154f41aba918b2d28bb8d2",["move"]="8816e805196a4f09aca79f27de12ade8",["jump"]="bdd2cc8707254cbeac714bbc260b367e",["die"]="ba9ce08382224dd9ad9e3a97428d4cdd",["hit"]="79d70b581e22411abbd0f142c038b7ad",["hitSound"]="54ff82cdad984a0083427e5f4e435036",["dieSound"]="b8000451037c4bffa65426e767cb8e09",["music"]="af3acec8784a4f80a0a354479b2132ff",["ball"]="f55dd57a708e43238b64715c02bb06cc",["hitFx"]="1ce6c57be86d46fb87573762be86b011",["floor"]=-4.54,["left"]=-5.549999999999999,["right"]=5.54999971,["playerX"]=-3.549999999999999,["bossX"]=3.54999971,["camera"]={-6.549999999999999,6.54999971,-6.34,0.8600000000000003},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="고드름 비",["kind"]="rain",["count"]=5,["rate"]=0.28,["speed"]=3.5,["tell"]=1.3,["clip"]="bdd2cc8707254cbeac714bbc260b367e",["sound"]="5ad33c2925c64d4c8f3a725009a7bc8a",["hit"]="1ce6c57be86d46fb87573762be86b011"},{["name"]="서릿빛 마법",["kind"]="fan",["count"]=3,["rate"]=0.3,["speed"]=3,["tell"]=1,["clip"]="3fdc356c027b4266862efc746fab77e7",["sound"]="7e20c0872d4d45d0a525d5fc746d6688",["hit"]="c5a807748e9443348e5b14162948f26b"},{["name"]="눈보라 속 빈자리",["kind"]="safe",["count"]=1,["rate"]=0.42,["speed"]=0,["tell"]=1.8,["clip"]="8659c5f8bca847d3b70052b340f33bfc",["sound"]="c7b4c91a9caa44e68c1a7be0e3c37259",["hit"]="0719861214fa45578488a1083f49df5a"}},["resources"]={"bdd2cc8707254cbeac714bbc260b367e","3fdc356c027b4266862efc746fab77e7","8659c5f8bca847d3b70052b340f33bfc","ba9ce08382224dd9ad9e3a97428d4cdd","79d70b581e22411abbd0f142c038b7ad","8816e805196a4f09aca79f27de12ade8","ecb6ec96