                [19]={["stage"]=19,["name"]="요괴선사",["mapTitle"]="요괴의 숲",["episode"]="세상의 이치를 깨우쳤다는 요괴선사는 낮잠을 방해받는 이유만은 이해하지 못했다. 화가 나면 부적을 흩뿌리고, 자신도 헷갈릴 만큼 빠르게 자리를 바꾼다.",["source"]="250010503",["map"]="regional_boss_19",["model"]="regionalboss19",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=72,["recommended"]=77,["hp"]=770321,["mult"]=16.182202422659177,["portrait"]="b2b92bce28c445e1bdfb93e819c19bbf",["stand"]="b2b92bce28c445e1bdfb93e819c19bbf",["move"]="f571daf7778641eb91b96b1e2fe22008",["jump"]="9524f87bfe81448a96d2abc5a7a1728f",["die"]="b7c33f5defd24d5fb741d3392df64cd1",["hit"]="d42a6fdf9e1d4bc1960cf81088cec38c",["hitSound"]="de69950a4a2040a69ee0cc4e39477571",["dieSound"]="89da05930cd242fea251400178ef29da",["music"]="52205e07ceaf4902a7f3f0789334c9cc",["ball"]="76f330ee98d943bbb425a67863815f9a",["hitFx"]="76f330ee98d943bbb425a67863815f9a",["floor"]=-5.44,["left"]=-10.0600007,["right"]=11.9399993,["playerX"]=-8.0600007,["bossX"]=9.9399993,["camera"]={-11.0600007,12.9399993,-7.24,-0.040000000000000036},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="흩날리는 부적",["kind"]="fan",["count"]=5,["rate"]=0.25,["speed"]=3.8,["tell"]=1.1,["clip"]="9524f87bfe81448a96d2abc5a7a1728f",["sound"]="ff726851b86a4dc8b147955fca99a236",["hit"]="76f330ee98d943bbb425a67863815f9a"},{["name"]="오행 봉인진",["kind"]="mine",["count"]=5,["rate"]=0.3,["speed"]=0,["tell"]=1.8,["clip"]="ff1e1edea42e4998b7d1f1ec31e3c9e5",["sound"]="4cbec75d7d184a989be3b23b079c21a7",["hit"]="76f330ee98d943bbb425a67863815f9a"},{["name"]="둔갑술",["kind"]="blink",["count"]=2,["rate"]=0.35,["speed"]=0,["tell"]=1.5,["clip"]="9524f87bfe81448a96d2abc5a7a1728f",["sound"]="4cbec75d7d184a989be3b23b079c21a7",["hit"]="76f330ee98d943bbb425a67863815f9a"}},["resources"]={"9524f87bfe81448a96d2abc5a7a1728f","b7c33f5defd24d5fb741d3392df64cd1","d42a6fdf9e1d4bc1960cf81088cec38c","f571daf7778641eb91b96b1e2fe22008","ff1e1edea42e4998b7d1f1ec31e3c9e5","b2b92bce28c445e1bdfb93e819c19bbf","ff726851b86a4dc8b147955