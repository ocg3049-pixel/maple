                [18]={["stage"]=18,["name"]="자동경비시스템",["mapTitle"]="보안 연구소",["episode"]="주인을 잃은 연구소에서도 경비 장치는 정해진 순찰을 계속한다. 출입 허가를 확인할 사람이 사라진 뒤로 자동경비시스템은 모든 생명체를 침입자로 기록하고 있다.",["source"]="310060220",["map"]="regional_boss_18",["model"]="regionalboss18",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=69,["recommended"]=74,["hp"]=631411,["mult"]=13.26410034644195,["portrait"]="decf2b41a0a64551b44b7bd69b953f4f",["stand"]="decf2b41a0a64551b44b7bd69b953f4f",["move"]="b272d3d6f61242ad99e9cf5d8010086a",["jump"]="8edd6b3d474c44079d995740e215fa53",["die"]="5e84c1cd39d346deb3201c5b56ac13cf",["hit"]="b2eed4f3b4574df5bad6d8af628a103d",["hitSound"]="cccfa4b5459046bc8f4ea46206706336",["dieSound"]="3489a4e737fb49ecbd688674198484a7",["music"]="da0fd5929e344edcb3b71ffedaa09561",["ball"]="9734c35ea77f49ebb38979df48b81817",["hitFx"]="9734c35ea77f49ebb38979df48b81817",["floor"]=-0.16,["left"]=15.230000500000001,["right"]=27.33,["playerX"]=17.230000500000003,["bossX"]=25.33,["camera"]={14.230000500000001,28.33,-1.96,5.24},["water"]=false,["stationary"]=true,["patterns"]={{["name"]="수평 감시선",["kind"]="beam",["count"]=1,["rate"]=0.32,["speed"]=0,["tell"]=1.4,["clip"]="8edd6b3d474c44079d995740e215fa53",["sound"]="507e7c05e3d64f0081e9589c729cc7fe",["hit"]="9734c35ea77f49ebb38979df48b81817"},{["name"]="봉쇄 격자",["kind"]="cross",["count"]=3,["rate"]=0.3,["speed"]=0,["tell"]=1.7,["clip"]="fafbb903ce104285826a509e81621af1",["sound"]="679c33cd4afb46dc8ecb97effbcb88aa",["hit"]="c6a672f359294a60b446632be2a114d8"},{["name"]="보안 지뢰",["kind"]="mine",["count"]=5,["rate"]=0.25,["speed"]=0,["tell"]=1.7,["clip"]="4297a96584d64eaca71bd15db895d0bd",["sound"]="1f075f56e7f34d348153e2432a032691",["hit"]="9734c35ea77f49ebb38979df48b81817"}},["resources"]={"8edd6b3d474c44079d995740e215fa53","fafbb903ce104285826a509e81621af1","5e84c1cd39d346deb3201c5b56ac13cf","b2eed4f3b4574df5bad6d8af628a103d","b272d3d6f61242ad99e9cf5d8010086a","ed0bca2ce27f4e6eaece3a7e2c5cb31d","4297a96584d64eaca71bd15db89