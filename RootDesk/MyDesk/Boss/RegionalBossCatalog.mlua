                [26]={["stage"]=26,["name"]="그리프",["mapTitle"]="그리프의 숲",["episode"]="거친 바람이 나뭇잎을 하늘로 끌어올리면 숲의 왕이 날개를 편다. 그리프는 번개보다 먼저 그림자를 드리우며, 자신의 하늘을 가로지른 모험가를 내려다본다.",["source"]="240020101",["map"]="regional_boss_26",["model"]="regionalboss26",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=93,["recommended"]=98,["hp"]=3098780,["mult"]=65.09632094061286,["portrait"]="3a3d17c98a3944a1ae169d33cca2c99c",["stand"]="3a3d17c98a3944a1ae169d33cca2c99c",["move"]="74191c32e6c240d5a9daee58eac09ecb",["jump"]="3bab112c7c0649a3bc29594364f523ff",["die"]="a0fab07a4b9e4fbca86ae109b76db138",["hit"]="6079cbd6f14d472d8e7e7cf98d94fb9e",["hitSound"]="9f4374d1b5f547e69dba95ea8aef8c2a",["dieSound"]="bfc8fed2aa074c89883c7af998746ac7",["music"]="1261a0c32aaa48ee8218df7bb38c2435",["ball"]="b5a2ac289c5e44dd8cce2f530df47ee2",["hitFx"]="b5a2ac289c5e44dd8cce2f530df47ee2",["floor"]=-4.52,["left"]=-6.450000000000001,["right"]=9.15,["playerX"]=-4.450000000000001,["bossX"]=7.15,["camera"]={-7.450000000000001,10.15,-6.319999999999999,0.8800000000000008},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="바람 칼날",["kind"]="fan",["count"]=5,["rate"]=0.28,["speed"]=4.5,["tell"]=1.2,["clip"]="3bab112c7c0649a3bc29594364f523ff",["sound"]="07af83074fb94d56a4519116f8d5ab1b",["hit"]="b5a2ac289c5e44dd8cce2f530df47ee2"},{["name"]="낙뢰",["kind"]="rain",["count"]=5,["rate"]=0.35,["speed"]=5,["tell"]=1.7,["clip"]="2fde6dcff84444a981ac548a10fff963",["sound"]="75852215f6bb46b5b42914d7dc0d229c",["hit"]="c5a4d99fea3140b29432c1cf929e9d69"},{["name"]="날개바람",["kind"]="beam",["count"]=2,["rate"]=0.38,["speed"]=0,["tell"]=1.5,["clip"]="2dda172d44a94bb6bcf61e964915a741",["sound"]="09d1746db4ba4c61ab0fb5510e191292",["hit"]="da70051e811e48e7bc7d74d22f31c58c"}},["resources"]={"3bab112c7c0649a3bc29594364f523ff","2fde6dcff84444a981ac548a10fff963","2dda172d44a94bb6bcf61e964915a741","a0fab07a4b9e4fbca86ae109b76db138","6079cbd6f14d472d8e7e7cf98d94fb9e","74191c32e6c240d5a9daee58eac09ecb","fe18b0a5cfb