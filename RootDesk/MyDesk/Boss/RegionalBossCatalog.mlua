@Logic
script RegionalBossCatalog extends Logic
    method table Stage(integer stage)
        if self._T.entries==nil then
            self._T.entries={
                [6]={["stage"]=6,["name"]="파우스트",["mapTitle"]="저주의 숲",["episode"]="보랏빛 안개 사이에서 들리는 웃음소리는 숲을 떠나지 못한 원숭이의 것이라고 한다. 파우스트는 길 잃은 모험가의 그림자를 모아 오래된 나무 아래 숨긴다.",["source"]="101020200",["map"]="regional_boss_6",["model"]="regionalboss6",["encounter"]="RegionalBossEncounter",["implemented"]=true,["level"]=33,["recommended"]=38,["hp"]=174228,["mult"]=1.22,["portrait"]="f7be8b50fd7743eb92b1235ab68ab3f0",["stand"]="f7be8b50fd7743eb92b1235ab68ab3f0",["move"]="f0b1b3ee713444e2873711317f5de60d",["jump"]="95b69d3223ce4a6c86e45a0557e6d392",["die"]="5cd0f6ea2253494ca18d1bfd1cf62192",["hit"]="a7dc481428ae490c95ddd584456259da",["hitSound"]="6e576bff22fb40609123882edfa0d723",["dieSound"]="aad98f3649084ee3ac2609f3d1848204",["music"]="b87b1307cb584a57941a1aeac41644c1",["ball"]="49b21aaa1d574ba787149841a31bf1a5",["hitFx"]="ad12599c6ecd4dfbaae39e6600315edc",["floor"]=-24.36,["left"]=-17.2399979,["right"]=-1.6600000900000005,["playerX"]=-15.239997899999999,["bossX"]=-3.6600000900000005,["camera"]={-18.2399979,-0.6600000900000005,-26.16,-18.96},["water"]=false,["stationary"]=false,["patterns"]={{name="바나나 던지기",kind="fan",count=1,rate=0.24,speed=3,tell=1.25,clip="95b69d3223ce4a6c86e45a0557e6d392",sound="8c96726a88bd4cb0bc9e7984b5cf197d"}},["resources"]={"6372ef5147db4c60868bdb050d20096e","b9153096b4104c139239d1873b7c28d2","9873f8d11af348af9abfafd70c001a01","2a98813a77154e8e8871c8c1d0b7ea80","cb4b8f3451bb4f0dab53327cce29c873","725858b58c524741bc036b7360716de9","45e0a175e4b2491296f244b893c6ee98","0c805e8052c14fbda03173990bf2d2b8","c86800e208dc4de4a8cf71b51778a2fb","3a426a5dd5c0474fa95a83778ce87da7","1be7a0a705ee45dea337c9d0ceda28c9","4ba44ff83cb3471b84f9035c9a8ee64f","95b69d3223ce4a6c86e45a0557e6d392","5cd0f6ea2253494ca18d1bfd1cf62192","a7dc481428ae490c95ddd584456259da","f0b1b3ee713444e2873711317f5de60d","681d4068577d4610945b63da43f48b9f","f7be8b50fd7743eb92b1235ab68ab3f0","8c96726a88bd4cb0bc9e7984b5cf197d","2aabf3819d5b4eb9a69a5144c27e5090","6e576bff22fb40609123882edfa0d723","aad98f3649084ee3ac2609f3d1848204","0e3a97f6a83844859166d34a5a56b507","9922e94142f9413aa5359297f852a5a2","49b21aaa1d574ba787149841a31bf1a5","ad12599c6ecd4dfbaae39e6600315edc"},["patternText"]="상호작용: 성수 투척 · 재사용 30초\n명중 피해 4,444~7,777\n빗나가면 바닥에서 3초간 부유 후 소멸\n\n바나나 한 개 · 최대 HP 24%\n바나나의 중심을 피하세요\n\n좀비루팡 · HP 1,000 / 전 구간 2~3마리\n접촉·바나나: 최대 HP 20%\n바나나: 파워스트라이크 사거리 · 이후 무해하게 소멸\n\n망령 · HP 2,000 / 5~8초마다 1마리 · 최대 2마리\n준비 시작 시 위치 고정 · 3초 후 돌진\n일반 접촉: 10초간 최대 HP 총 40%\n돌진: 최대 HP 50%\n\nHP 50% 미만: 의문의 숙녀 1회 소환\nHP 30,000 · 기본공격 20%\n7~15초마다 MP 50% / HP 50% 교대 공격\n찍기: 11번째 프레임 · 점프로 회피\n찌르기: 3번째 프레임 충전 후 레이저 발사\n카메라 너머까지 · 바닥에서 숙이거나 점프로 회피\n숙녀 생존 중 맵 밝기 80%\n\nHP 50% 미만: 맵의 임의 위치에서 멜러디 출현\nHP 3,000 · 돌진 피해 70%\n가로 돌진 · 세로 판정 1픽셀\n본체 접촉 피해 없음"},
                [7]={["stage"]=7,["name"]="킹크랑",["mapTitle"]="파도 해변",["episode"]="해변에 밀려온 보물은 모두 자신의 것이라 믿는 거대한 소라게다. 킹크랑이 집게를 치켜들면 잔잔하던 바다도 성난 파도로 변한다.",["source"]="120041800",["map"]="regional_boss_7",["model"]="regionalboss7",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=36,["recommended"]=41,["hp"]=70852,["mult"]=1.4884,["portrait"]="0b6f0cbdc042402984083351636e29b1",["stand"]="0b6f0cbdc042402984083351636e29b1",["move"]="31881195d9b5485dbc5a5089eb22ddc5",["jump"]="6c57e47e917549689f8aebd5494ee338",["die"]="5a79966cdda24c1c8208ccbba1c8ff2f",["hit"]="218cbc224da04dc797818d1f141dd4d5",["hitSound"]="e80302ebf6e64b0aaba3d74060bb7d80",["dieSound"]="48370127c9b1415bbfcb6e9cadc91e0b",["music"]="9c09f187eeae4be2979e1d344b0925fe",["ball"]="8394705c13394b78a8b9a38e1313cb22",["hitFx"]="8394705c13394b78a8b9a38e1313cb22",["floor"]=-0.96,["left"]=-13.249999549999998,["right"]=8.750000450000002,["playerX"]=-11.249999549999998,["bossX"]=6.750000450000002,["camera"]={-14.249999549999998,9.750000450000002,-2.76,4.44},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="집게 내려치기",["kind"]="melee",["count"]=1,["rate"]=0.32,["speed"]=0,["tell"]=0.9,["clip"]="6c57e47e917549689f8aebd5494ee338",["sound"]="63ad5a1b95a34bdb8fa9183b1ec401d5",["hit"]="8394705c13394b78a8b9a38e1313cb22"},{["name"]="밀려오는 파도",["kind"]="wave",["count"]=2,["rate"]=0.25,["speed"]=3,["tell"]=1.2,["clip"]="5b035ddefea846689d13344c381d68a4",["sound"]="63ad5a1b95a34bdb8fa9183b1ec401d5",["hit"]="8394705c13394b78a8b9a38e1313cb22"},{["name"]="해일의 눈",["kind"]="safe",["count"]=1,["rate"]=0.4,["speed"]=0,["tell"]=1.8,["clip"]="6c57e47e917549689f8aebd5494ee338",["sound"]="63ad5a1b95a34bdb8fa9183b1ec401d5",["hit"]="8394705c13394b78a8b9a38e1313cb22"}},["resources"]={"6c57e47e917549689f8aebd5494ee338","5a79966cdda24c1c8208ccbba1c8ff2f","218cbc224da04dc797818d1f141dd4d5","31881195d9b5485dbc5a5089eb22ddc5","5b035ddefea846689d13344c381d68a4","0b6f0cbdc042402984083351636e29b1","b20a656829a142c0afd9e9