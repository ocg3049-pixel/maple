                [24]={["stage"]=24,["name"]="스노우맨",["mapTitle"]="얼음 골짜기",["episode"]="눈더미라고 생각하고 다가간 모험가들은 뒤늦게 거대한 발자국을 발견한다. 스노우맨은 자신의 털에 맺힌 눈을 털어 낼 뿐이지만, 작은 골짜기에는 한바탕 눈사태가 난다.",["source"]="211040100",["map"]="regional_boss_24",["model"]="regionalboss24",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=87,["recommended"]=92,["hp"]=2081954,["mult"]=43.73577058627578,["portrait"]="bf93196a2da842eaaf93c944453416d8",["stand"]="bf93196a2da842eaaf93c944453416d8",["move"]="881ed191bfad4861b63aa94d2a9a2bb8",["jump"]="022330aea10449ac970a86ee17db8709",["die"]="23d06abe8f804666beaee7246a586f05",["hit"]="4ace032a3dcf4e6a9ee28925c92a93c6",["hitSound"]="9dfb7764926940a2a4a1e9d5db2b782f",["dieSound"]="5c352ae1664042118c6d527280d67cc3",["music"]="31d14710b2144ca18d355a8271f2bd32",["ball"]="1325ee6c65874b01ae5581b3f3d7a3f8",["hitFx"]="61a7400399b74971ac00644cecde6c77",["floor"]=-3.04,["left"]=-4.200000000000001,["right"]=6.9,["playerX"]=-2.200000000000001,["bossX"]=4.9,["camera"]={-5.200000000000001,7.9,-4.84,2.3600000000000003},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="눈덩이 연사",["kind"]="fan",["count"]=5,["rate"]=0.28,["speed"]=3,["tell"]=1.2,["clip"]="022330aea10449ac970a86ee17db8709",["sound"]="9b888225a1f44f6887c8d75b2b81d12c",["hit"]="61a7400399b74971ac00644cecde6c77"},{["name"]="얼음 파편",["kind"]="rain",["count"]=6,["rate"]=0.25,["speed"]=3.8,["tell"]=1.6,["clip"]="bc47715d8e634067af5bf97b923a1c6f",["sound"]="f8ac2900b7c74f28aa94d7cc48369d78",["hit"]="61a7400399b74971ac00644cecde6c77"},{["name"]="설원의 발구르기",["kind"]="shock",["count"]=3,["rate"]=0.3,["speed"]=0,["tell"]=1.7,["clip"]="510199e23a4e4dd09217d13d12edde17",["sound"]="f8ac2900b7c74f28aa94d7cc48369d78",["hit"]="61a7400399b74971ac00644cecde6c77"}},["resources"]={"022330aea10449ac970a86ee17db8709","23d06abe8f804666beaee7246a586f05","4ace032a3dcf4e6a9ee28925c92a93c6","881ed191bfad4861b63aa94d2a9a2bb8","bc47715d8e634067af5bf97b923a1c6f","510199e23a4e4dd09217d13d12edde17","bf93196a2da8