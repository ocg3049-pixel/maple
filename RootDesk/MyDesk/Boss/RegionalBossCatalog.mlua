                [12]={["stage"]=12,["name"]="다일",["mapTitle"]="깊은 수렁",["episode"]="오래된 배수로를 지나온 물건들은 모두 다일의 늪에 쌓인다. 보물처럼 쌓아 둔 고철을 건드리면 졸고 있던 거대한 악어가 물살보다 빠르게 달려든다.",["source"]="103030400",["map"]="regional_boss_12",["model"]="regionalboss12",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=51,["recommended"]=56,["hp"]=191493,["mult"]=4.022710830106879,["portrait"]="002f7f9d3abc49928a922e8eb3038cf1",["stand"]="002f7f9d3abc49928a922e8eb3038cf1",["move"]="99712d6acafb4374adc0b10ff16dcbca",["jump"]="75ec4896515b4423b1d3e26259426b32",["die"]="e133539edc3d486eaa17345a4859661d",["hit"]="794f9746118f4e73bc99f66c68f96286",["hitSound"]="eadb0b6efee74c92bddfdcd4c5604efe",["dieSound"]="197dac41590b4541accfec6a6bd0c7b6",["music"]="de986ed081c846699d17f4c18622f828",["ball"]="49b21aaa1d574ba787149841a31bf1a5",["hitFx"]="49b21aaa1d574ba787149841a31bf1a5",["floor"]=-1.2,["left"]=-7.484999999999999,["right"]=14.515,["playerX"]=-5.484999999999999,["bossX"]=12.515,["camera"]={-8.485,15.515,-3,4.2},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="수렁 돌진",["kind"]="dash",["count"]=1,["rate"]=0.4,["speed"]=5,["tell"]=1.3,["clip"]="75ec4896515b4423b1d3e26259426b32",["sound"]="16d3d57c44c445e59f43fd59ac3abd56",["hit"]=""},{["name"]="진흙 발자국",["kind"]="pool",["count"]=4,["rate"]=0.16,["speed"]=0,["tell"]=1,["clip"]="75ec4896515b4423b1d3e26259426b32",["sound"]="16d3d57c44c445e59f43fd59ac3abd56",["hit"]=""},{["name"]="꼬리 휘두르기",["kind"]="melee",["count"]=1,["rate"]=0.35,["speed"]=0,["tell"]=1,["clip"]="75ec4896515b4423b1d3e26259426b32",["sound"]="16d3d57c44c445e59f43fd59ac3abd56",["hit"]=""}},["resources"]={"e133539edc3d486eaa17345a4859661d","794f9746118f4e73bc99f66c68f96286","99712d6acafb4374adc0b10ff16dcbca","75ec4896515b4423b1d3e26259426b32","002f7f9d3abc49928a922e8eb3038cf1","eadb0b6efee74c92bddfdcd4c5604efe","197dac41590b4541accfec6a6bd0c7b6","16d3d57c44c445e59f43fd59ac3abd56"},["patternText"]="수렁 돌진 · 최대 HP 40%\n돌진을 점프로 회피\n\n진흙 발자국 · 최대 HP 16%\n바닥 잔류물 회피\n