                [20]={["stage"]=20,["name"]="주니어 발록",["mapTitle"]="금지된 제단",["episode"]="봉인이 약해질 때마다 제단 아래에서 검은 날개 소리가 들린다. 주니어 발록은 오래된 신전을 자신의 둥지로 삼고, 찾아온 모험가에게 어둠의 힘을 시험한다.",["source"]="105030500",["map"]="regional_boss_20",["model"]="regionalboss20",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=75,["recommended"]=80,["hp"]=939792,["mult"]=19.742286955644197,["portrait"]="4b3ad414c1184c02b5eb459b29ee8ece",["stand"]="4b3ad414c1184c02b5eb459b29ee8ece",["move"]="4f60f3e6658d439aa7aa35f23a155d9d",["jump"]="45a54fc4b202417bab825bf820698d7e",["die"]="6489dfbcae58487fb64d9978065b282c",["hit"]="47ef73f20aa245f9ad2cc12c8f4c11da",["hitSound"]="ebdc6045118f43b78f4d607cebaa58bc",["dieSound"]="5426f991bb464ae9af69332eeab59a71",["music"]="bfa8c3e2a33f4e8d871e03df2737c304",["ball"]="788a0d0288514c17af0c3e35ad6834fa",["hitFx"]="f02babaa89c7423f8b236e0193b34df0",["floor"]=-1.3,["left"]=-4.0699996899999995,["right"]=11.2699995,["playerX"]=-2.0699996899999995,["bossX"]=9.2699995,["camera"]={-5.0699996899999995,12.2699995,-3.1,4.1000000000000005},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="암흑 운석",["kind"]="rain",["count"]=6,["rate"]=0.32,["speed"]=4,["tell"]=1.6,["clip"]="45a54fc4b202417bab825bf820698d7e",["sound"]="21ac666399fd4adf8a1bfc197c2a20bd",["hit"]="f02babaa89c7423f8b236e0193b34df0"},{["name"]="마력 폭격",["kind"]="fan",["count"]=5,["rate"]=0.3,["speed"]=4.2,["tell"]=1.2,["clip"]="94ccc3fa961d46ef8f839841493765ad",["sound"]="5d70c04f900a4a4ba95ca1ecad8f5767",["hit"]="7a049161810249209cf0c284bbcf50d7"},{["name"]="제단 붕괴",["kind"]="shock",["count"]=2,["rate"]=0.4,["speed"]=0,["tell"]=1.8,["clip"]="670661a1a9e8434eb6888cceb6d617c9",["sound"]="dbc755c0609e45f39f6b76a5ed119921",["hit"]="e728847c3e974093a7a1837bb0871335"}},["resources"]={"45a54fc4b202417bab825bf820698d7e","94ccc3fa961d46ef8f839841493765ad","670661a1a9e8434eb6888cceb6d617c9","6489dfbcae58487fb64d9978065b282c","47ef73f20aa245f9ad2cc12c8f4c11da","4f60f3e6658d439aa7aa35f23a155d9d","