                [25]={["stage"]=25,["name"]="마뇽",["mapTitle"]="마뇽의 숲",["episode"]="숲을 지나는 뜨거운 바람은 마뇽이 낮잠에서 깨어났다는 신호다. 자신의 둥지 주변에 남은 낯선 발자국을 발견하면, 붉은 용은 나무 사이로 불길을 토해 낸다.",["source"]="240020401",["map"]="regional_boss_25",["model"]="regionalboss25",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=90,["recommended"]=95,["hp"]=2539984,["mult"]=53.357640115256444,["portrait"]="b8cdd7920392456f99272649c7cb7c2d",["stand"]="b8cdd7920392456f99272649c7cb7c2d",["move"]="7988e04f93f749e39d199da40324bf5f",["jump"]="4aa4b090aa304f898a8f91caeb59d736",["die"]="a0bde46d583747ba96bc550b2fc00ee6",["hit"]="1631e67423e247b1bae0bd1183769752",["hitSound"]="81bca2419e4f45939c2545462f4d8ef2",["dieSound"]="",["music"]="1261a0c32aaa48ee8218df7bb38c2435",["ball"]="5ac6554c0ea94009bbd9389df0542339",["hitFx"]="5ac6554c0ea94009bbd9389df0542339",["floor"]=-4.52,["left"]=-9.149999,["right"]=6.450000000000001,["playerX"]=-7.149998999999999,["bossX"]=4.450000000000001,["camera"]={-10.149999,7.450000000000001,-6.319999999999999,0.8800000000000008},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="화염 숨결",["kind"]="fan",["count"]=7,["rate"]=0.3,["speed"]=4,["tell"]=1.4,["clip"]="4aa4b090aa304f898a8f91caeb59d736",["sound"]="f783efef20e94aedb798b1d01e7a2ee5",["hit"]="5ac6554c0ea94009bbd9389df0542339"},{["name"]="날개 돌진",["kind"]="dash",["count"]=1,["rate"]=0.45,["speed"]=5.5,["tell"]=1.6,["clip"]="636bebcce89546e08f7e930bcf81708e",["sound"]="",["hit"]="b6b5849af24a416ab1680a1dced9697f"},{["name"]="용의 진동",["kind"]="shock",["count"]=2,["rate"]=0.38,["speed"]=0,["tell"]=1.8,["clip"]="79ca2314b4fb420c96526e3d3464b15b",["sound"]="1116cf6b36ab43e4a159567b345fb37b",["hit"]="128fe611ea9347aab589c5b5d4d8fc5b"}},["resources"]={"4aa4b090aa304f898a8f91caeb59d736","636bebcce89546e08f7e930bcf81708e","79ca2314b4fb420c96526e3d3464b15b","a0bde46d583747ba96bc550b2fc00ee6","1631e67423e247b1bae0bd1183769752","7988e04f93f749e39d199da40324bf5f","9020a3625cfb45e5934d0b5bd95ebaea","b8cdd792039245