                [10]={["stage"]=10,["name"]="루루모",["mapTitle"]="연구실 203호",["episode"]="서로 다른 실험약이 만나 태어난 루루모는 붉은 몸과 푸른 몸의 기분이 늘 다르다. 한쪽이 화를 내면 다른 쪽은 바닥에 차가운 흔적을 남긴다.",["source"]="261010103",["map"]="regional_boss_10",["model"]="regionalboss10",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=45,["recommended"]=50,["hp"]=128657,["mult"]=2.7027081631999996,["portrait"]="4b9724ec31ed4fb8b240a3686d6ff41c",["stand"]="4b9724ec31ed4fb8b240a3686d6ff41c",["move"]="412aab8f924f4e8a9d791ffb25c6a3af",["jump"]="6c57fc6fa4c0472889199cd4ba323735",["die"]="dc98f57510c34ac2881519fc1da0de2e",["hit"]="28a8fe887140470b9a4edcd800ed8932",["hitSound"]="02978e150e8f43a6bc67158ef4460602",["dieSound"]="90c88050ee4b485888b86c34c14ea8e0",["music"]="55117072498b4e6bafcfe45da29cd1f8",["ball"]="4c425a9ca1d24f22856cd74e8dee1f0d",["hitFx"]="4c425a9ca1d24f22856cd74e8dee1f0d",["floor"]=-2.14,["left"]=-8.285,["right"]=13.715,["playerX"]=-6.285,["bossX"]=11.715,["camera"]={-9.285,14.715,-3.9400000000000004,3.2600000000000002},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="붉은 시약",["kind"]="fan",["count"]=4,["rate"]=0.25,["speed"]=3.6,["tell"]=1.1,["clip"]="6c57fc6fa4c0472889199cd4ba323735",["sound"]="2ece1dfb1d5249189bc842425eeb9980",["hit"]="4c425a9ca1d24f22856cd74e8dee1f0d"},{["name"]="푸른 시약 웅덩이",["kind"]="pool",["count"]=3,["rate"]=0.18,["speed"]=0,["tell"]=1.5,["clip"]="bd4a3fe610064954a4ccaff9047f42b7",["sound"]="f706e9d404554c57baf480e976e7e5dd",["hit"]="4c425a9ca1d24f22856cd74e8dee1f0d"},{["name"]="엇갈린 반응",["kind"]="safe",["count"]=2,["rate"]=0.38,["speed"]=0,["tell"]=1.7,["clip"]="6b40e4e3926a478fa88599685debc215",["sound"]="55d33a7be42b4efba706be5e71744822",["hit"]="4c425a9ca1d24f22856cd74e8dee1f0d"}},["resources"]={"6c57fc6fa4c0472889199cd4ba323735","dc98f57510c34ac2881519fc1da0de2e","28a8fe887140470b9a4edcd800ed8932","412aab8f924f4e8a9d791ffb25c6a3af","bd4a3fe610064954a4ccaff9047f42b7","6b40e4e3926a478fa88599685debc215","4b9724ec31ed4fb8b240a3686d6ff41c","2