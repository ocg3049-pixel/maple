                [23]={["stage"]=23,["name"]="키메라",["mapTitle"]="연구소 A-3",["episode"]="닫힌 연구실 문 너머에서는 서로 다른 짐승의 울음이 한꺼번에 들린다. 키메라는 자신을 만든 이들을 기억하지 못하지만, 깨진 시험관의 냄새만 맡으면 사납게 날뛴다.",["source"]="261020700",["map"]="regional_boss_23",["model"]="regionalboss23",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=84,["recommended"]=89,["hp"]=1706520,["mult"]=35.8489922838326,["portrait"]="3f5236d28b1f409797fe7c4b48743b8a",["stand"]="3f5236d28b1f409797fe7c4b48743b8a",["move"]="602442e3a83c423b92d2245fb6384858",["jump"]="18a29b25caeb41a8a4267b68ff49a40a",["die"]="d85f8d59bb5543bcb3ecb8ee8a3ba5ac",["hit"]="e7d383d93dce42548917bb81de8e8cf4",["hitSound"]="61462b120b634797b42bd1070b02b7ac",["dieSound"]="5153b020db2c43a5ac81e67e239d5866",["music"]="55117072498b4e6bafcfe45da29cd1f8",["ball"]="ab113d9a5ca5402d85ecc2ab7a4f51a1",["hitFx"]="127defcb953144368b79da1417f8b4b4",["floor"]=-1.8,["left"]=-3.6799999999999997,["right"]=18.32,["playerX"]=-1.6799999999999997,["bossX"]=16.32,["camera"]={-4.68,19.32,-3.6,3.6000000000000005},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="맹독 탄막",["kind"]="fan",["count"]=5,["rate"]=0.28,["speed"]=3.6,["tell"]=1.2,["clip"]="18a29b25caeb41a8a4267b68ff49a40a",["sound"]="28cfa48eacde424587e0000c04a3eeb7",["hit"]="127defcb953144368b79da1417f8b4b4"},{["name"]="독성 잔류물",["kind"]="pool",["count"]=5,["rate"]=0.18,["speed"]=0,["tell"]=1.5,["clip"]="ec7b571a85244965b296d26e6511e06d",["sound"]="d122e77fd2a04f549eb0aa8d8183e5cf",["hit"]="127defcb953144368b79da1417f8b4b4"},{["name"]="실험체 폭주",["kind"]="dash",["count"]=1,["rate"]=0.45,["speed"]=5.6,["tell"]=1.5,["clip"]="18a29b25caeb41a8a4267b68ff49a40a",["sound"]="d122e77fd2a04f549eb0aa8d8183e5cf",["hit"]="127defcb953144368b79da1417f8b4b4"}},["resources"]={"18a29b25caeb41a8a4267b68ff49a40a","d85f8d59bb5543bcb3ecb8ee8a3ba5ac","e7d383d93dce42548917bb81de8e8cf4","602442e3a83c423b92d2245fb6384858","ec7b571a85244965b296d26e6511e06d","3f5236d28b1f409797fe7c4b48743b8a","28cfa48eacde424587e00