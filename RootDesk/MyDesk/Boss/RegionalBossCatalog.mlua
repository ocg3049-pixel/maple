                [28]={["stage"]=28,["name"]="레비아탄",["mapTitle"]="검은 와이번의 둥지",["episode"]="협곡 가장 깊은 곳의 바람은 레비아탄의 숨결처럼 차갑다. 오랜 세월 바위에 남긴 발톱 자국 사이로 서리가 피어나면, 둥지의 주인이 마지막 침입자를 맞이한다.",["source"]="240040320",["map"]="regional_boss_28",["model"]="regionalboss28",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=99,["recommended"]=104,["hp"]=4612224,["mult"]=96.88936408800818,["portrait"]="063d6cb856c54130ac74f81842b3f95c",["stand"]="063d6cb856c54130ac74f81842b3f95c",["move"]="9386a203ce5f4551b0dd9d6b8d97bfcd",["jump"]="423dd803460b44b1b77ac0f6e4f91eca",["die"]="6412dc6e9529402c8c8ac9ebda64d487",["hit"]="ed0dd890d0fa4e96bdffc14e55c43632",["hitSound"]="ce5ec067c4b84deaacf6e82d4f8afb42",["dieSound"]="",["music"]="ecc11fe5cb074083bc27ad1334b727d0",["ball"]="61f43f08d555438297aa7709e1d11525",["hitFx"]="61f43f08d555438297aa7709e1d11525",["floor"]=-19.3,["left"]=-3.25,["right"]=10.75,["playerX"]=-1.25,["bossX"]=8.75,["camera"]={-4.25,11.75,-21.1,-13.9},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="빙룡의 숨결",["kind"]="fan",["count"]=9,["rate"]=0.3,["speed"]=4.2,["tell"]=1.5,["clip"]="423dd803460b44b1b77ac0f6e4f91eca",["sound"]="d0704dd03db74332b7b1c68162a53559",["hit"]="61f43f08d555438297aa7709e1d11525"},{["name"]="꼬리 쓸기",["kind"]="dash",["count"]=2,["rate"]=0.42,["speed"]=5.4,["tell"]=1.8,["clip"]="f1acba02aef04393980927d035a468c7",["sound"]="a4a2ab9be81141e7953a1f36e307b3b6",["hit"]="fa7c27b128e24cf4af9f1364f73f4021"},{["name"]="영원의 서리",["kind"]="safe",["count"]=2,["rate"]=0.48,["speed"]=0,["tell"]=2.1,["clip"]="423dd803460b44b1b77ac0f6e4f91eca",["sound"]="c50c320c470f4f2198e1739ae87481b3",["hit"]="61f43f08d555438297aa7709e1d11525"}},["resources"]={"423dd803460b44b1b77ac0f6e4f91eca","f1acba02aef04393980927d035a468c7","6412dc6e9529402c8c8ac9ebda64d487","ed0dd890d0fa4e96bdffc14e55c43632","9386a203ce5f4551b0dd9d6b8d97bfcd","d1766d53e8454f218a2198ab34f415fb","063d6cb856c54130ac74f81842b3f95c","d0704dd03db74332b7b1c68162a53559","a4a2ab9be81141e7953a1f36e307b3b6","5c3e75bfed2c47508c037e1550c5243d","ce5ec067c4b84deaacf6e82d4f8afb42","c50c320c470f4f2198e1739ae87481b3","61f43f08d555438297aa7709e1d11525","fa7c27b128e24cf4af9f1364f73f4021"},["patternText"]="빙룡의 숨결 · 최대 HP 30%\n구슬 사이로 이동\n\n꼬리 쓸기 · 최대 HP 42%\n돌진을 점프로 회피\n\n영원의 서리 · 최대 HP 48%\n초록색 안전지대로 이동\n\nHP 50% 이하: 공격 간격 단축 · 일부 탄막 증가\n접촉 피해: 최대 HP 20%"}
            }
            for _,ruid in ipairs({"8abe28da0a4d492c95d89f0501177a3b","ba1872fe7b014d04a65685fb6ecfb783","182001a35e4d4cddabb9ee5968da1198","0b579fe17d524e59badc9afddc2ba641","d5fc95edba314acea050a7a45a1bd55f","e8ae083a1ee948c78c7f2aaa1889a153","248d2c4adc65485fb4b47f51a6f6d4a1","a507fe0f27a246469ff7bab9681f8820","5f0861e6bbb44dacb7c5f55145cb2adc","f767184f745e40f4a7c526850bbceae7","ed5028331be34ba0848152ae26019093","e55b96c2fde44c6e9fac2e8c9201950b","425c7f1a98004a07b2922ee3202af427","1e2a030302a94b1485907bc9ce719eb5","9f0ce35330b745ba86f09151139d499a","ce2e5b9a226e4b6a8a2b921ad5b7ff40","24d67c21f6304b86b31f4ee71106e20a","f10ce91969e2454a99186b594f9de6a8","6db0e011ba23450b8569a5a789abb1f7","8cbe1fce67ef4328a91623de29aa1ee4","348b89874d0e4c6cb22582549bfe5b4b"}) do table.insert(self._T.entries[6].resources,ruid) end
            -- Preload every attack visual, including shared projectile fallbacks.
            for _,entry in pairs(self._T.entries) do
                local known={}
                for _,ruid in ipairs(entry.resources) do known[ruid]=true end
                for _,ruid in ipairs({entry.ball,entry.hitFx}) do
                    if ruid~=nil and ruid~="" and not known[ruid] then table.insert(entry.resources,ruid) known[ruid]=true end
                end
            end
        end
        return self._T.entries[stage]
    end
