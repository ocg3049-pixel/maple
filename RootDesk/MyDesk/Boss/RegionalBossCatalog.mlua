                [27]={["stage"]=27,["name"]="피아누스",["mapTitle"]="피아누스의 동굴",["episode"]="바다 깊은 곳에서 오래 잠들어 있던 거대한 물고기다. 피아누스가 눈을 뜨면 해류가 거꾸로 흐르고, 동굴 벽을 타고 흐르는 빛조차 위험한 신호가 된다.",["source"]="230040420",["map"]="regional_boss_27",["model"]="regionalboss27",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=96,["recommended"]=101,["hp"]=3780512,["mult"]=79.41751154754769,["portrait"]="207c5d6dcee243ad9a141397244ba9a9",["stand"]="207c5d6dcee243ad9a141397244ba9a9",["move"]="207c5d6dcee243ad9a141397244ba9a9",["jump"]="e76534125d994b9c8a1f3bb520c4533f",["die"]="d63b783f0ba847fda76f340ccb8995ea",["hit"]="09dd05ae2710401fb33adce7e376a16e",["hitSound"]="0a28b0fce3754b6c96fd864400c1beb3",["dieSound"]="b5733ff11e8749599af80f91d9ddb830",["music"]="4f16b0b4ffd54477a7dc02174626e155",["ball"]="b3b6895c89504a6ca5a85e4621a729fa",["hitFx"]="b3b6895c89504a6ca5a85e4621a729fa",["floor"]=-1.68,["left"]=-5.27,["right"]=6.17,["playerX"]=-3.2699999999999996,["bossX"]=4.17,["camera"]={-6.27,7.17,-3.48,5.32},["water"]=true,["stationary"]=true,["patterns"]={{["name"]="심해 광선",["kind"]="beam",["count"]=2,["rate"]=0.4,["speed"]=0,["tell"]=1.5,["clip"]="e76534125d994b9c8a1f3bb520c4533f",["sound"]="22db46490a854e6886715ce7f7df03d1",["hit"]="b3b6895c89504a6ca5a85e4621a729fa"},{["name"]="심해 폭탄",["kind"]="mine",["count"]=5,["rate"]=0.35,["speed"]=0,["tell"]=1.8,["clip"]="8b9483cd4b084d2ab99766d15bf8b5d1",["sound"]="ed7b97a6788844f8b1258e0ee1eb6458",["hit"]="501dad8eaf5a4399baa9f9a68c6e6fee"},{["name"]="역류",["kind"]="wave",["count"]=3,["rate"]=0.3,["speed"]=3.3,["tell"]=1.6,["clip"]="307df6910ac9413dbd49e95a23c94daa",["sound"]="",["hit"]="306a9aafa3fb43498f1b783b85512305"}},["resources"]={"e76534125d994b9c8a1f3bb520c4533f","8b9483cd4b084d2ab99766d15bf8b5d1","307df6910ac9413dbd49e95a23c94daa","d63b783f0ba847fda76f340ccb8995ea","09dd05ae2710401fb33adce7e376a16e","f164c9d3f2684ba5a22876f23df5ae3d","c93b5d7f48894e1da84555f8bfd4cd13","5cac3f98d1494997a6eee4e49834e6bb","b9e8898d9e014ba6af0ba28f6