                [16]={["stage"]=16,["name"]="구미호",["mapTitle"]="달빛 고개",["episode"]="아홉 개의 꼬리가 달빛을 가리면 길은 조금 전과 달라진다. 구미호는 도망치는 모험가를 쫓기보다, 그가 먼저 여우불을 따라오기를 기다린다.",["source"]="224000131",["map"]="regional_boss_16",["model"]="regionalboss16",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=63,["recommended"]=68,["hp"]=424221,["mult"]=8.911650326822057,["portrait"]="959ea412aeac4065bdb2c58e8be26d91",["stand"]="959ea412aeac4065bdb2c58e8be26d91",["move"]="730a07e8f4b7415d820a39deb22c3f9e",["jump"]="84dcb999264745eabe9fcc1cd895dff0",["die"]="8f69efaf07514bd7a5fe9c37f3bb5c94",["hit"]="a735d722d25149f7a36325e4085ea03a",["hitSound"]="df5896ae63924d5e9d8a72b52b9c36ab",["dieSound"]="9b1c7aefcef04fcb955d468e77c43fe5",["music"]="d3504fb295be4807a089f8f505f88d30",["ball"]="98e332e2bcc94df0bc6c80fd7d203877",["hitFx"]="98e332e2bcc94df0bc6c80fd7d203877",["floor"]=-0.94,["left"]=-6.05,["right"]=2.78999972,["playerX"]=-4.282000055999999,["bossX"]=1.021999776,["camera"]={-8.03000014,4.76999986,-2.74,4.460000000000001},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="쫓아오는 여우불",["kind"]="homing",["count"]=3,["rate"]=0.25,["speed"]=2.5,["tell"]=1.3,["clip"]="84dcb999264745eabe9fcc1cd895dff0",["sound"]="342d5f33e44d4be3810396ec179037e2",["hit"]="98e332e2bcc94df0bc6c80fd7d203877"},{["name"]="달빛 바꿔치기",["kind"]="blink",["count"]=1,["rate"]=0.35,["speed"]=0,["tell"]=1.5,["clip"]="ed6ae2b37b614fe9b2d8baf4f1b34870",["sound"]="ebdef15d41b84ecc8dadde416d2cb219",["hit"]="98e332e2bcc94df0bc6c80fd7d203877"},{["name"]="아홉 꼬리의 불꽃",["kind"]="rain",["count"]=9,["rate"]=0.22,["speed"]=3.2,["tell"]=1.8,["clip"]="1cb2f28812b642c7bc878da7b095db99",["sound"]="ebdef15d41b84ecc8dadde416d2cb219",["hit"]="98e332e2bcc94df0bc6c80fd7d203877"}},["resources"]={"84dcb999264745eabe9fcc1cd895dff0","8f69efaf07514bd7a5fe9c37f3bb5c94","a735d722d25149f7a36325e4085ea03a","730a07e8f4b7415d820a39deb22c3f9e","ed6ae2b37b614fe9b2d8baf4f1b34870","1cb2f28812b642c7bc878da7b095db99","959ea412aeac4065bd