                [15]={["stage"]=15,["name"]="리치",["mapTitle"]="죽은 나무의 숲",["episode"]="말라붙은 나무 사이를 떠도는 검은 로브에는 주인이 없다고 한다. 리치는 숲의 침묵을 깨뜨린 이에게 표식을 남기고, 사라진 생명의 메아리를 불러낸다.",["source"]="211041400",["map"]="regional_boss_15",["model"]="regionalboss15",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=60,["recommended"]=65,["hp"]=347722,["mult"]=7.304631415427917,["portrait"]="8b20897f0de04e76a742460b6cbadb41",["stand"]="8b20897f0de04e76a742460b6cbadb41",["move"]="82965e5a9a6a4a9295a9dcb72c158c10",["jump"]="2eb9f0c278734f558d87ac12159e09b5",["die"]="ef23a1eab16e4c56adcf4938e3378706",["hit"]="e6bb40a549684e9f9225671eb568835f",["hitSound"]="4bb3a91d99e54ea1951199756a6079b1",["dieSound"]="5827be9e5da74c83aa45baddf4ac611f",["music"]="af3acec8784a4f80a0a354479b2132ff",["ball"]="6d1e0018b1a6426ab5e026b9d1a075f1",["hitFx"]="6d1e0018b1a6426ab5e026b9d1a075f1",["floor"]=3.86,["left"]=13.349999999999998,["right"]=23.55,["playerX"]=15.349999999999998,["bossX"]=21.55,["camera"]={12.049999999999999,24.85,2.0599999999999996,9.26},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="사신의 표식",["kind"]="mine",["count"]=3,["rate"]=0.38,["speed"]=0,["tell"]=1.8,["clip"]="2eb9f0c278734f558d87ac12159e09b5",["sound"]="9ee7ed885dc1475ea6373313e79ff7d9",["hit"]="6d1e0018b1a6426ab5e026b9d1a075f1"},{["name"]="영혼 수확",["kind"]="fan",["count"]=7,["rate"]=0.25,["speed"]=3.2,["tell"]=1.4,["clip"]="05cee9d246ef49e88e41cc4069545913",["sound"]="1672763305dc4ce5b07a22f2f14229f6",["hit"]="a0d5264c500646948855136a7e6b9e9c"},{["name"]="침묵의 장막",["kind"]="safe",["count"]=1,["rate"]=0.45,["speed"]=0,["tell"]=2,["clip"]="ea12c442477243f4b1fcfc98a2a1e26e",["sound"]="22e3ca5e2e6c469bada451a0ea33219d",["hit"]="93a8b075d34a47559490007c7c2d2864"}},["resources"]={"2eb9f0c278734f558d87ac12159e09b5","05cee9d246ef49e88e41cc4069545913","ea12c442477243f4b1fcfc98a2a1e26e","ef23a1eab16e4c56adcf4938e3378706","e6bb40a549684e9f9225671eb568835f","82965e5a9a6a4a9295a9dcb72c158c10","bed77896b6914b368f9f41