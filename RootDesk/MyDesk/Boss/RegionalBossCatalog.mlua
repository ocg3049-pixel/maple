                [8]={["stage"]=8,["name"]="타이머",["mapTitle"]="시간의 갈림길",["episode"]="시계탑에서 버려진 시간들이 태엽 속으로 흘러들어 갔다. 타이머의 종이 세 번 울리면 조금 전 서 있던 자리에도 늦은 충격이 찾아온다.",["source"]="220040200",["map"]="regional_boss_8",["model"]="regionalboss8",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=39,["recommended"]=44,["hp"]=86440,["mult"]=1.815848,["portrait"]="cbdd230e5cd34b7b9eeb1cd206d19f34",["stand"]="cbdd230e5cd34b7b9eeb1cd206d19f34",["move"]="684685ca8dc84aac920f77e5c5d871f1",["jump"]="9a4f5adadc25455e88c0394ee41f346d",["die"]="cb0d2a03101b4210b142a74cd178de88",["hit"]="a8f2cac815354c40a9147389bc070d78",["hitSound"]="82b043fa08784ef6bcdc54271e116924",["dieSound"]="e1bd45722eca4a898c0d44cd8b1acca2",["music"]="1c02b98497e649ae9df8b55777eb1167",["ball"]="e5558e07445143b6999f20246768a3fe",["hitFx"]="e5558e07445143b6999f20246768a3fe",["floor"]=-3.72,["left"]=-4.98,["right"]=4.190000000000001,["playerX"]=-3.146,["bossX"]=2.3560000000000008,["camera"]={-6.795,6.005000000000001,-5.5200000000000005,1.6800000000000002},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="세 번의 종소리",["kind"]="mine",["count"]=3,["rate"]=0.28,["speed"]=0,["tell"]=1.5,["clip"]="9a4f5adadc25455e88c0394ee41f346d",["sound"]="a02c38a939c0417996ab99d8b216a3a8",["hit"]="e5558e07445143b6999f20246768a3fe"},{["name"]="초침 가르기",["kind"]="beam",["count"]=1,["rate"]=0.32,["speed"]=0,["tell"]=1.2,["clip"]="3ef6b2dcc75f4d4990e6e7f106bda49e",["sound"]="d1c2d1c12ab74f81b7311d075b3644fb",["hit"]="e5558e07445143b6999f20246768a3fe"},{["name"]="되감는 시간",["kind"]="echo",["count"]=3,["rate"]=0.3,["speed"]=0,["tell"]=1.8,["clip"]="9a4f5adadc25455e88c0394ee41f346d",["sound"]="d1c2d1c12ab74f81b7311d075b3644fb",["hit"]="e5558e07445143b6999f20246768a3fe"}},["resources"]={"9a4f5adadc25455e88c0394ee41f346d","cb0d2a03101b4210b142a74cd178de88","a8f2cac815354c40a9147389bc070d78","684685ca8dc84aac920f77e5c5d871f1","3ef6b2dcc75f4d4990e6e7f106bda49e","cbdd230e5cd34b7b9eeb1cd206d19f34","a02c38a939c0417996ab99d8b