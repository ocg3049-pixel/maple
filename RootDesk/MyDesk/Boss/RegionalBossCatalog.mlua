                [17]={["stage"]=17,["name"]="태륜",["mapTitle"]="떠돌이 곰의 영토",["episode"]="수련을 마치지 못한 태륜은 아직도 산길의 발소리를 대련 신청으로 알아듣는다. 느린 몸짓 뒤에 숨긴 기운은 단단한 바위도 굴려 보낼 만큼 거세다.",["source"]="250010304",["map"]="regional_boss_17",["model"]="regionalboss17",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=66,["recommended"]=71,["hp"]=517550,["mult"]=10.87221339872291,["portrait"]="0e1e782401624d7693959777c0b16ebe",["stand"]="0e1e782401624d7693959777c0b16ebe",["move"]="52eef131b7604e758e7dd92fb803a64e",["jump"]="2979b16c037649adaf543912a4127c77",["die"]="3c45042f3e544edeadccb1c66061e440",["hit"]="bd722884c2c245d7b8955fdc6c5d6ebb",["hitSound"]="d210d7f63393416a9c36b4925f489192",["dieSound"]="48cb66cc49094e39ad1fcaa2b6d1ca7d",["music"]="52205e07ceaf4902a7f3f0789334c9cc",["ball"]="5328a3875a32437784c949579f259a00",["hitFx"]="353079a9d111455ab55d75577f9d7967",["floor"]=-3.94,["left"]=-9.99,["right"]=-1.1500000000000004,["playerX"]=-8.222,["bossX"]=-2.918,["camera"]={-11.97,0.8300000000000001,-5.74,1.4600000000000004},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="기공탄",["kind"]="fan",["count"]=3,["rate"]=0.3,["speed"]=4,["tell"]=1,["clip"]="2979b16c037649adaf543912a4127c77",["sound"]="8af849f7f4a940bc928dc62bf45a4448",["hit"]="353079a9d111455ab55d75577f9d7967"},{["name"]="맹호 돌파",["kind"]="dash",["count"]=1,["rate"]=0.42,["speed"]=5.5,["tell"]=1.4,["clip"]="e46219e629744c669c477077b962287c",["sound"]="a09a622456dc42db9501847b438ae32e",["hit"]="8e38989c6f3d4f87876d37e431ee11c1"},{["name"]="대지 울림",["kind"]="shock",["count"]=2,["rate"]=0.3,["speed"]=0,["tell"]=1.5,["clip"]="2979b16c037649adaf543912a4127c77",["sound"]="16cffc2c75014589bb73e7898a87b007",["hit"]="353079a9d111455ab55d75577f9d7967"}},["resources"]={"2979b16c037649adaf543912a4127c77","e46219e629744c669c477077b962287c","3c45042f3e544edeadccb1c66061e440","bd722884c2c245d7b8955fdc6c5d6ebb","52eef131b7604e758e7dd92fb803a64e","2fb08ea98d2e47a9977f961b1452c86e","0e1e782401624d7693959777c0b16ebe","