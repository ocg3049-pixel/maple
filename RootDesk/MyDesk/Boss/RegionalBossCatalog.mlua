                [14]={["stage"]=14,["name"]="좀비 머쉬맘",["mapTitle"]="은밀한 습지",["episode"]="달빛도 닿지 않는 습지에서 버섯 하나가 다시 눈을 떴다. 좀비 머쉬맘이 착지할 때마다 땅속에 잠든 포자가 깨어나 오래도록 독한 흔적을 남긴다.",["source"]="105010200",["map"]="regional_boss_14",["model"]="regionalboss14",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=57,["recommended"]=62,["hp"]=285018,["mult"]=5.987402799531079,["portrait"]="a908b6976a9844aea9408a80ec9bdc6b",["stand"]="a908b6976a9844aea9408a80ec9bdc6b",["move"]="d607a7dc605648fbbba53727bf631739",["jump"]="76571b5afc704ff18a5c59bdae450a61",["die"]="e65ef0b7866f498fb942ae749705fd97",["hit"]="452efbf925a34f2291d1ac00b1cd40a6",["hitSound"]="106b18a499774e6086993008b50edca1",["dieSound"]="545c60960d8d476a84c5e1f330a0a8d4",["music"]="190ac389eaf547e1b817baaca733a5d0",["ball"]="49b21aaa1d574ba787149841a31bf1a5",["hitFx"]="085fb5d69ee34ce6b008677e52bef80d",["floor"]=1.66,["left"]=2.170000000000001,["right"]=15.829999999999998,["playerX"]=4.170000000000001,["bossX"]=13.829999999999998,["camera"]={1.1700000000000008,16.83,-0.14000000000000012,7.0600000000000005},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="망자의 뜀박질",["kind"]="shock",["count"]=2,["rate"]=0.35,["speed"]=0,["tell"]=1.3,["clip"]="b5e4a508d0e842e1823c2a258d217737",["sound"]="c7849311e89d4a59a3b1204f177443ad",["hit"]=""},{["name"]="썩은 포자",["kind"]="pool",["count"]=4,["rate"]=0.18,["speed"]=0,["tell"]=1.4,["clip"]="0a3e975eb04d4f83ab8864218defb04f",["sound"]="14534b2c2d0843efac1b3e75cced88da",["hit"]=""},{["name"]="부패의 비",["kind"]="rain",["count"]=5,["rate"]=0.25,["speed"]=3,["tell"]=1.6,["clip"]="b5e4a508d0e842e1823c2a258d217737",["sound"]="14534b2c2d0843efac1b3e75cced88da",["hit"]=""}},["resources"]={"b5e4a508d0e842e1823c2a258d217737","e65ef0b7866f498fb942ae749705fd97","452efbf925a34f2291d1ac00b1cd40a6","76571b5afc704ff18a5c59bdae450a61","d607a7dc605648fbbba53727bf631739","0a3e975eb04d4f83ab8864218defb04f","a908b6976a9844aea9408a80ec9bdc6b","c7849311e89d4a59a3b1204f177443ad","9e26a53