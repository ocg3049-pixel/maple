                [21]={["stage"]=21,["name"]="디트와 로이",["mapTitle"]="연구소 C-3",["episode"]="두 이름을 가진 실험체는 하나의 몸으로 서로 다른 명령을 수행한다. 디트가 출력을 높이면 로이는 경고등을 켜지만, 두 신호가 겹치는 순간에는 아무도 폭주를 멈추지 못한다.",["source"]="261020500",["map"]="regional_boss_21",["model"]="regionalboss21",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=78,["recommended"]=83,["hp"]=1146546,["mult"]=24.08559008588592,["portrait"]="7468ef1995cc4808833ac99c331f0a41",["stand"]="7468ef1995cc4808833ac99c331f0a41",["move"]="1c83f9e0a6c54d2bb2b8a5d093d33790",["jump"]="7405a7c101024447817e0eb4d7a67052",["die"]="e783f0a9baba45d9ad617e5df0c8a464",["hit"]="235e2a03c7bf4f9bb7d534423aee0554",["hitSound"]="0257f1ecce9e459a860b710977a5445c",["dieSound"]="19aeae10ddd94b6b9ebf3cd23c5508da",["music"]="55117072498b4e6bafcfe45da29cd1f8",["ball"]="6d724085803747a4b7bdd4297eaca43e",["hitFx"]="6d724085803747a4b7bdd4297eaca43e",["floor"]=-1.66,["left"]=-6.870000000000001,["right"]=8.68,["playerX"]=-4.870000000000001,["bossX"]=6.68,["camera"]={-7.870000000000001,9.68,-3.46,3.74},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="엇갈린 방전",["kind"]="cross",["count"]=2,["rate"]=0.32,["speed"]=0,["tell"]=1.6,["clip"]="7405a7c101024447817e0eb4d7a67052",["sound"]="a4c0b28a68154e8fb4f2c8ec824b341c",["hit"]="6d724085803747a4b7bdd4297eaca43e"},{["name"]="과열 증기",["kind"]="mine",["count"]=4,["rate"]=0.3,["speed"]=0,["tell"]=1.5,["clip"]="1dc0b00d91b24f66a84e9a1980fc4a47",["sound"]="90c066f692194c37a05dfaecfbf91f91",["hit"]="91a4ea8ee41a4f109427facccc0523a3"},{["name"]="비상 돌진",["kind"]="dash",["count"]=2,["rate"]=0.35,["speed"]=4.8,["tell"]=1.7,["clip"]="7b11a901119443bf807e5eb98b7fa8e1",["sound"]="7bdd4fa9db0547af91940f68bf5f12bb",["hit"]="6b898372029e4861a7b05ff7113284df"}},["resources"]={"7405a7c101024447817e0eb4d7a67052","1dc0b00d91b24f66a84e9a1980fc4a47","7b11a901119443bf807e5eb98b7fa8e1","e783f0a9baba45d9ad617e5df0c8a464","235e2a03c7bf4f9bb7d534423aee0554","1c83f9e0a6c54d2bb2b8a5d093d33790","4ef921161a1b46ee8f