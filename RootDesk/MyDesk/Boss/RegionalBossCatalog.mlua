                [13]={["stage"]=13,["name"]="제노",["mapTitle"]="통제실 3",["episode"]="지구의 기계를 분석하던 제노는 결국 자신이 통제실의 주인이라고 선언했다. 눈앞의 침입자보다 먼저 움직일 곳을 계산하지만, 과열된 조준 장치는 잠시 같은 방향만 바라본다.",["source"]="221030820",["map"]="regional_boss_13",["model"]="regionalboss13",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=54,["recommended"]=59,["hp"]=233622,["mult"]=4.907707212730393,["portrait"]="689bc520bc2544abb62ec505ca91aab4",["stand"]="689bc520bc2544abb62ec505ca91aab4",["move"]="6f1f55e91a08410e8de6599d99333caa",["jump"]="7585c76a06bb49628b0a137729dd3ef6",["die"]="59339a39fac74c448835042516162e1b",["hit"]="80f1eba683554d40b8dc1ba7fbbe8770",["hitSound"]="379dc5ab10214f408be20f06b1e238c1",["dieSound"]="8701dd1b28074c8bb5816e2562571253",["music"]="b487abd0fc4e466788afbc41db95353f",["ball"]="908710847a0249c98cf8e935dfb1ddd8",["hitFx"]="908710847a0249c98cf8e935dfb1ddd8",["floor"]=-0.72,["left"]=3.2300000000000004,["right"]=25.13,["playerX"]=5.23,["bossX"]=23.13,["camera"]={2.2300000000000004,26.13,-2.52,4.680000000000001},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="추적 조준 레이저",["kind"]="beam",["count"]=1,["rate"]=0.35,["speed"]=0,["tell"]=1.3,["clip"]="7585c76a06bb49628b0a137729dd3ef6",["sound"]="18edd85e21564348a334e8a33f6ca63b",["hit"]="908710847a0249c98cf8e935dfb1ddd8"},{["name"]="궤도 폭탄",["kind"]="mine",["count"]=4,["rate"]=0.28,["speed"]=0,["tell"]=1.6,["clip"]="c68a17e01f83412882ac127cda104ee3",["sound"]="",["hit"]="908710847a0249c98cf8e935dfb1ddd8"},{["name"]="교차 광선",["kind"]="cross",["count"]=2,["rate"]=0.32,["speed"]=0,["tell"]=1.8,["clip"]="7585c76a06bb49628b0a137729dd3ef6",["sound"]="",["hit"]="908710847a0249c98cf8e935dfb1ddd8"}},["resources"]={"7585c76a06bb49628b0a137729dd3ef6","59339a39fac74c448835042516162e1b","80f1eba683554d40b8dc1ba7fbbe8770","6f1f55e91a08410e8de6599d99333caa","c68a17e01f83412882ac127cda104ee3","689bc520bc2544abb62ec505ca91aab4","18edd85e21564348a334e8a33f6ca63b","5c0e64290dc94d15a7e1f469c81d3060","379dc5ab10214f40