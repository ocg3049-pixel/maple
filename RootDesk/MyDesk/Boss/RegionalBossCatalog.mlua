                [9]={["stage"]=9,["name"]="머쉬맘",["mapTitle"]="버섯의 숲",["episode"]="어린 버섯들의 낮잠을 지키는 숲의 어머니. 머쉬맘은 낯선 발소리를 들으면 큰 갓을 흔들며 뛰어오른다. 그 아래에서는 작은 돌멩이도 가만히 있을 수 없다.",["source"]="100020101",["map"]="regional_boss_9",["model"]="regionalboss9",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=42,["recommended"]=47,["hp"]=105457,["mult"]=2.2153345599999996,["portrait"]="86015373d23b4b05bb8fcc6086354652",["stand"]="86015373d23b4b05bb8fcc6086354652",["move"]="c745828d831b42739b9a58c07f334864",["jump"]="5ecbcc4002a5491aafd7e1d3191c6ddc",["die"]="ec90f0b64a814c4980de89f496d360ec",["hit"]="90fee9416184420a9796a679751d1ec5",["hitSound"]="c611ae50c5d84814a6d2ccfad8a472c5",["dieSound"]="d48ec1cc57a247028f390041fc89c97f",["music"]="3926b48759d246dc8464a876ff7fa5ce",["ball"]="49b21aaa1d574ba787149841a31bf1a5",["hitFx"]="05113e9dc86448cb8581731824106d75",["floor"]=-2.14,["left"]=-19.039999,["right"]=0.14000000000000057,["playerX"]=-17.039999,["bossX"]=-1.8599999999999994,["camera"]={-20.039999,1.1400000000000006,-3.9400000000000004,3.2600000000000002},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="쿵쿵 내려찍기",["kind"]="shock",["count"]=1,["rate"]=0.35,["speed"]=0,["tell"]=1.2,["clip"]="90c5456e2a8a45478df02500797a9afd",["sound"]="f135fc39ffe94be18ef9c0f82d3669c5",["hit"]=""},{["name"]="포자 흩뿌리기",["kind"]="fan",["count"]=5,["rate"]=0.2,["speed"]=2.8,["tell"]=1,["clip"]="b9345875a8134c7c9a1b6aed8551d808",["sound"]="5da7bb48092947f395e9f76f601323ca",["hit"]=""},{["name"]="세 번의 뜀박질",["kind"]="shock",["count"]=3,["rate"]=0.28,["speed"]=0,["tell"]=1.6,["clip"]="90c5456e2a8a45478df02500797a9afd",["sound"]="5da7bb48092947f395e9f76f601323ca",["hit"]=""}},["resources"]={"90c5456e2a8a45478df02500797a9afd","ec90f0b64a814c4980de89f496d360ec","90fee9416184420a9796a679751d1ec5","5ecbcc4002a5491aafd7e1d3191c6ddc","c745828d831b42739b9a58c07f334864","b9345875a8134c7c9a1b6aed8551d808","86015373d23b4b05bb8fcc6086354652","f135fc39ffe94be18ef9c0f82d3669c5","7c8e5f1ef0b