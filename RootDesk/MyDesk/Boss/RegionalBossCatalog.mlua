                [22]={["stage"]=22,["name"]="엘리쟈",["mapTitle"]="검은빛의 정원",["episode"]="구름 위 정원을 지키던 엘리쟈의 노래가 어느 날부터 슬프게 변했다. 떨어진 깃털에 별빛이 맺히면, 아름다운 정원은 침입자가 숨을 곳 없는 빛의 무대가 된다.",["source"]="200010302",["map"]="regional_boss_22",["model"]="regionalboss22",["encounter"]="RegionalBossEncounter",["implemented"]=false,["level"]=81,["recommended"]=86,["hp"]=1398787,["mult"]=29.384419904780824,["portrait"]="d458879e2e2949f2bb2e915ff67fbc64",["stand"]="d458879e2e2949f2bb2e915ff67fbc64",["move"]="e4e1fb8384994d8890b786f7b9df93a3",["jump"]="d72a977e76a04ffcbab240d8cfb39da7",["die"]="1ebdf7b4f5b64af3a385a18551a410fe",["hit"]="5ee4cd91882446e99905bea46f26e8e6",["hitSound"]="24f9a3efb46b4ab7adfce22c336d7d01",["dieSound"]="",["music"]="02301b8112894626a78f8d517aada78a",["ball"]="1660382723ff40c296845e8ded7bbc86",["hitFx"]="1660382723ff40c296845e8ded7bbc86",["floor"]=-0.84,["left"]=-3.75,["right"]=10.05,["playerX"]=-1.75,["bossX"]=8.05,["camera"]={-4.75,11.05,-2.64,4.5600000000000005},["water"]=false,["stationary"]=false,["patterns"]={{["name"]="별빛 깃털",["kind"]="fan",["count"]=7,["rate"]=0.24,["speed"]=3.6,["tell"]=1.2,["clip"]="8c933520034f4a3a8fb4163495ab714e",["sound"]="f0b9aa38b71241db8d6ec117d0add0cf",["hit"]="1660382723ff40c296845e8ded7bbc86"},{["name"]="빛의 기둥",["kind"]="rain",["count"]=5,["rate"]=0.32,["speed"]=4.5,["tell"]=1.6,["clip"]="bc600b6d206849b29235b226a729e72b",["sound"]="f2180dc05f78499fad94a556d5cff42c",["hit"]="1660382723ff40c296845e8ded7bbc86"},{["name"]="정원의 안식처",["kind"]="safe",["count"]=1,["rate"]=0.42,["speed"]=0,["tell"]=1.9,["clip"]="c160b5eeeefb46cf95a42f9914225024",["sound"]="f2180dc05f78499fad94a556d5cff42c",["hit"]="1660382723ff40c296845e8ded7bbc86"}},["resources"]={"8c933520034f4a3a8fb4163495ab714e","1ebdf7b4f5b64af3a385a18551a410fe","5ee4cd91882446e99905bea46f26e8e6","d72a977e76a04ffcbab240d8cfb39da7","e4e1fb8384994d8890b786f7b9df93a3","bc600b6d206849b29235b226a729e72b","c160b5eeeefb46cf95a42f9914225024","d458879e2e2949f2bb2e915ff67fbc64","f0b9aa38b71