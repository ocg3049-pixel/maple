@Component
script StumpyFlyeye extends Component
    property string OwnerId = ""
    @Sync property number HitAt = -10

    @ExecSpace("ServerOnly")
    method void Configure(integer index, integer count)
        -- Keep the flying Rigidbody in kinematic mode for its entire lifetime.
        local e=self.Entity local m=e:GetComponent("script.Monster")
        m.Stationary=true m.MonsterDisplayName="플라이아이" m.MaxHp=300 m.Hp=300
        m.HitSoundRUID="dfed4b65571f4432a43753658eed63b2" m.DeathSoundRUID="ba58626a6f30402789d82a2096be2fad"
        m:SetupMonsterNameTag()
        e.StateComponent:DisconnectHitEvent()
        local origin=e.TransformComponent.WorldPosition
        e.RigidbodyComponent.KinematicMove=true e.RigidbodyComponent.KinematicMoveAcceleration=Vector2(1,1)
        e.RigidbodyComponent:SetWorldPosition(Vector2(origin.x,origin.y)) e.RigidbodyComponent:PositionReset()
        e.MovementComponent.InputSpeed=1
        e:GetComponent("script.MonsterAttack"):SetMapActivity(false)
        local t=self._T
        t.roam=0 t.ready=true t.dead=false t.age=0 t.mode="spread"
        t.phase=index*2.39996+_UtilLogic:RandomDouble()*0.3
        t.frequency=3.2+_UtilLogic:RandomDouble()*1.8 t.speed=1.25+_UtilLogic:RandomDouble()*0.4
        local angle=math.rad(20+140*(index-1)/math.max(1,count-1))
        t.direction=Vector2(math.cos(angle),math.sin(angle))
        t.untilAt=0.9+_UtilLogic:RandomDouble()*0.25 t.nextAttack=1.5+index*0.22
        if Environment:IsMakerPlay() then log("[Stumpy] flyeye ready hp=300") end
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if not self._T.ready or self._T.dead then return end
        local e=self.Entity local m=e:GetComponent("script.Monster") local t=self._T
        if m.IsDead then self:BeginDeathMotion() return end
        if m:HoldHitReaction() then return end
        local r=(_BossStageManager._T.runs or {})[self.OwnerId]
        local p=_UserService:GetUserEntityByUserId(self.OwnerId)
        if not _BossStageManager:IsEncounterVisible(r) or not isvalid(p) or p.CurrentMap~=e.CurrentMap then e.MovementComponent:Stop() return end
        t.age=t.age+delta
        local pos=e.TransformComponent.WorldPosition
        local aim=p.TransformComponent.WorldPosition+Vector3(0,0.35,0)
        local dx=aim.x-pos.x local dy=aim.y-pos.y
        local distance=math.max(0.01,math.sqrt(dx*dx+dy*dy))
        local direction=t.direction local speed=t.speed
        if t.mode=="spread" or t.mode=="retreat" then
            speed=t.mode=="spread" and 1.65 or 1.8
            if t.age>=t.untilAt then t.mode="approach" end
        elseif t.mode=="swoop" then
            speed=2
            if t.age>=t.untilAt then
                t.mode="retreat" t.untilAt=t.age+0.65+_UtilLogic:RandomDouble()*0.3
                t.nextAttack=t.untilAt+0.5+_UtilLogic:RandomDouble()*0.7
                t.direction=Vector2(-dx/distance,0.4+math.abs(math.sin(t.phase)))
                direction=t.direction
            end
        elseif distance<=4.5 then
            -- Different phases and approach lanes keep the flock from becoming one stack.
            local lateral=math.sin(t.age*t.frequency+t.phase)*0.85
            direction=Vector2(dx/distance-dy/distance*lateral,dy/distance+dx/distance*lateral)
            local encounter=isvalid(r.boss) and r.boss:GetComponent("script.StumpyEncounter") or nil
            if isvalid(encounter) then
                for _,other in ipairs(encounter._T.summons or {}) do
                    if other~=e and isvalid(other) and isvalid(other:GetComponent("script.StumpyFlyeye")) then
                        local q=other.TransformComponent.WorldPosition
                        local sx=pos.x-q.x local sy=pos.y-q.y local d2=sx*sx+sy*sy
                        if d2>0.0001 and d2<0.49 then direction=direction+Vector2(sx,sy)*(0.28/d2) end
                    end
                end
            end
            if distance<0.9 and t.age>=t.nextAttack and not m:IsSpawnProtected() then
                t.mode="swoop" t.untilAt=t.age+0.42 t.direction=Vector2(dx/distance,dy/distance)
                direction=t.direction
            elseif distance<0.7 and t.age<t.nextAttack then
                direction=Vector2(-dx/distance,0.45+math.sin(t.phase)*0.3)
            end
        else
            t.roam=t.roam-delta
            if t.roam<=0 then
                local angle=_UtilLogic:RandomDouble()*math.pi*2
                t.direction=Vector2(math.cos(angle),math.sin(angle)) t.roam=0.8+_UtilLogic:RandomDouble()*1.2
            end
            direction=t.direction speed=0.8
        end
        if pos.x<-7 and direction.x<0 then direction=Vector2(math.abs(direction.x),direction.y) end
        if pos.x>7 and direction.x>0 then direction=Vector2(-math.abs(direction.x),direction.y) end
        if pos.y<0.2 and direction.y<0 then direction=Vector2(direction.x,math.abs(direction.y)) end
        if pos.y>3.6 and direction.y>0 then direction=Vector2(direction.x,-math.abs(direction.y)) end
        local length=math.max(0.01,math.sqrt(direction.x*direction.x+direction.y*direction.y))
        e.MovementComponent.InputSpeed=speed
        e.MovementComponent:MoveToDirection(direction/length,0)
        if math.abs(direction.x)>0.02 then e.TransformComponent.Scale=Vector3(direction.x>0 and -1 or 1,1,1) end
        e.SpriteRendererComponent.SpriteRUID=_UtilLogic.ServerElapsedSeconds-self.HitAt<0.25 and "da1ea90aa01a4d1ba8bf15f1f9a5e4f6" or "04d56278279f45c6a99f6726ef5c91fe"
        if t.mode~="spread" and not m:IsSpawnProtected() then
            local attack=e:GetComponent("script.MonsterAttack")
            attack:AttackFast(BoxShape(Vector2(pos.x,pos.y),e.HitComponent.BoxSize,0),"boss.stumpy.flyeye",CollisionGroups.HitBox)
        end
    end

    @ExecSpace("ServerOnly")
    method void Parried()
        -- Parry removal is not a kill and cannot grant drops or on-kill rewards.
        if self._T.dead then return end
        self._T.dead=true self.Entity.HitComponent.Enable=false self.Entity.MovementComponent:Stop()
        self.Entity:GetComponent("script.Monster").IsDead=true
        -- Finish IsAttackTarget's boolean return before invalidating its owner component.
        local entity=self.Entity
        _TimerService:SetTimerOnce(function()
            if isvalid(entity) then entity:Destroy() end
            if Environment:IsMakerPlay() then log("[Stumpy] flyeye removed by parry") end
        end,0.03)
    end

    @ExecSpace("ServerOnly")
    method void BeginDeathMotion()
        -- Preserve the native flying corpse position while its death animation finishes.
        if self._T.dead then return end
        self._T.dead=true
        self.Entity.MovementComponent:Stop() self.Entity.HitComponent.Enable=false
        self.Entity.SpriteRendererComponent.SpriteRUID="d69b6340252740a48b4631ce00d058c7"
        local m=self.Entity:GetComponent("script.Monster")
        m.DeathFadeStarted=_UtilLogic.ServerElapsedSeconds+0.8 m.DestroyDelay=1.8
        if Environment:IsMakerPlay() then log("[Stumpy] flyeye death") end
    end
end
