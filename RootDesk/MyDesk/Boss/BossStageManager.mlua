        local ordinary={
            {name="달팽이",stand="17b55730c26f4fd6b8fcfa288da388de",move="f40108c8b0b84696a67337b801201f7d",hit="a3feafdb656943baa3f8897a7042b21f",die="a25ed762135448ccb2307604f3179565"},
            {name="파란 달팽이",stand="0c69164656d24f64bd1a1f6ee4019dff",move="ca6e5b65e1d643838ba920fbbeb32d8f",hit="938c814d2142406c8a6480ee2b025ac3",die="af2e35a7899d4cc18e4f4aec7f8e9f06"},
            {name="빨간 달팽이",stand="ffb9e9fba641457c818e9bf9d724461a",move="4f8eab1a9fbf4a35b28f986c4fa12f48",hit="a9c736c7e74544c18740d6eb36b2f103",die="d5fad1d29d4d4254855d8ee1c4bda507"}
        }
        local specials={
            {name="특수 빨간 달팽이",stand="791308a26d594d3f97d785f59336d219",move="48bebe02ca7b490abb99f961a8931f84",hit="222fb8ad82904e958ec433d6d1362415",die="3980735003d8422db819258c65c80f4c",angry="763517e8afcf416b9c41893c5e8801c2",sleep="1333102b40da4f3aa2d0ee84607f0355",roll="68ef2089106446779fa610f8e1089ddf"},
            {name="특수 파란 달팽이",stand="4b87a7d7c50849ea80324a096a2696cd",move="efd14699882e43a3812c0f533f145e96",hit="5e707eb29bad426f980241691eae18b2",die="2868fe2359604496af8e2fc0d286f7ce",angry="a51be8ee9cdf49d68030357b22ba7d09",sleep="fcd01d91572e4979ba16a4d431727317",roll="a51a6a2df83248969b38d7fe46b57acb"},
            {name="특수 보라 달팽이",stand="86049b9cb6da4c479d78b4895ba7bcac",move="7ac20de57308480f9b55db16ddd7a949",hit="490a25fc72d1467cbe13b513240cc99c",die="4a083487c4c341cd89a0917d7e919952",angry="67840b3526644dee983abf65ab50097a",sleep="1d630326d3b84eaaa85248d74e7cf087",roll="26a4157757274a07b9ca2814a02475d7"}
        }
        return (special and specials or ordinary)[math.max(1,math.min(3,color))]
