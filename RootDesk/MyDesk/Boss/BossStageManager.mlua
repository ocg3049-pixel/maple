    method string BattleMusic(integer stage)
        local regional=_RegionalBossCatalog:Stage(stage)
        if regional~=nil then return regional.music end
        -- Stumpy uses the original 102020500 (돌풍지대) map's BGM.
        return stage==5 and "00d83a12fc444a81b66af176d23fa695" or stage==4 and "bbbf2616f2064d658f4d53af5faf9d3e" or stage==2 and "f555b438ab2a41b0a714ccc6dbe720df" or stage==3 and "190ac389eaf547e1b817baaca733a5d0" or "d479098207e2405a8dfdaff121b04ebc"
    end

    @ExecSpace("ClientOnly")
    method void StartManoMusic()
        -- The arena owns its music; normal map audio resumes after leaving it.
        local p=_UserService.LocalPlayer
        if not isvalid(p) or not isvalid(p.CurrentMap) or not self:IsArena(p.CurrentMap.Name) then return end
        local map=p.CurrentMap
        local sound=map.SoundComponent
        if not isvalid(sound) then self._T.musicPending=true return end
        self._T.musicPending=false
        sound:Stop() sound.AudioClipRUID=self:BattleMusic(self._T.stage or 1)
        sound.Bgm=true sound.Loop=true sound.Volume=1
        self._T.bossMusic=sound
        _ResourceService:PreloadAsync({sound.AudioClipRUID},function()
            if isvalid(sound) and self._T.bossMusic==sound and isvalid(p) and p.CurrentMap==map then
                sound:Play()
                if Environment:IsMakerPlay() then log("[BossStage] BGM playing stage="..tostring(self._T.stage).." ruid="..tostring(sound.AudioClipRUID)) end
            end
        end)
    end
    @ExecSpace("ClientOnly")
    method boolean IsTargetInteractionKey(any key)
        return self._T.battle==true and (key==KeyboardKey.Tab or _KeySettingManager:GetFuncForKeyEnum(key)=="interact")
    end

    @ExecSpace("ClientOnly")
    method void TryToggleTarget()
        if not self._T.battle or self._T.result or self._T.destination~=nil then return end
        if _GameSystemMenu:BlocksInput() or _MapleHUDManager:IsChatTyping() or _MapleHUDManager:HasOpenChatBlockingWindow() or _KeySettingManager:IsCapturingKey() then return end
        local p=_UserService.LocalPlayer
        if not isvalid(p) or p.PlayerComponent.Hp<=0 then return end
        local now=_UtilLogic.ElapsedSeconds
        if now<(self._T.targetCooldownUntil or 0) then return end
        self._T.targetCooldownUntil=now+1
        _BeginnerRecovery:Cancel()
        self:RequestToggleTarget()
    end

    @ExecSpace("Server")
    method void RequestToggleTarget()
        self:ToggleTargetForUser(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void ToggleTargetForUser(string uid)
        local r=(self._T.runs or {})[uid]
        local p=_UserService:GetUserEntityByUserId(uid)
        if r==nil or r.state~="active" or not isvalid(r.boss) or not isvalid(p) or p.PlayerComponent.Hp<=0 or not isvalid(p.CurrentMap) or p.CurrentMap.Name~=r.map then return end
        if r.stage==4 then r.boss.ThiefEncounter:UseMoneyBag(p) return end
        if r.stage==5 then r.boss.SerufEncounter:UseAir() return end
        if r.stage==6 then r.boss.FaustEncounter:UseHolyWater(p) return end
        if r.stage==2 then self:BeginStumpyParry(r,p) return end
        local now=_UtilLogic.ServerElapsedSeconds
        if now<(r.targetNextAt or 0) then return end
        local attack=p:GetComponent("script.PlayerAttack")
        if not isvalid(attack) then return end
        r.targetNextAt=now+1
        attack.BossNearestTarget=not attack.BossNearestTarget
        self:ReceiveTargetMode(attack.BossNearestTarget,true,uid)
        if Environment:IsMakerPlay() then log("[BossStage] target mode="..(attack.BossNearestTarget and "nearest" or "boss")) end
    end

    @ExecSpace("Client")
    method void ReceiveTargetMode(boolean nearest, boolean animate)
        if not self._T.battle then return end
        self:UI("TargetControl/Button/Icon").Enable=true
        self:LeaderPortrait("TargetControl/Button/LeaderArt",false)
        self:UI("TargetControl/Button/Heading").TextGUIRendererComponent.Text=self._T.stage==6 and "성수 던지기" or self._T.stage==4 and "돈주머니 던지기" or self._T.stage==5 and "산소 보충" or self._T.stage==2 and "공격 방어" or "공격 우선순위"
        self:UI("TargetControl/KeyBox/Inner/Hint").TextGUIRendererComponent.Text=(self._T.stage==4 or self._T.stage==5 or self._T.stage==6) and "사용" or "전환"
        self:UI("TargetControl/Button/Icon").SpriteGUIRendererComponent.PreserveSprite=(self._T.stage==4 or self._T.stage==5 or self._T.stage==6) and PreserveSpriteType.None or PreserveSpriteType.AspectOnly
        self:UI("TargetControl/Button/Icon").UITransformComponent.RectSize=Vector2(self._T.stage==4 and 48 or self._T.stage==5 and 78 or 88,self._T.stage==4 and 48 or 78)
        self:UI("TargetControl/Button/Icon").UITransformComponent.anchoredPosition=Vector2(0,self._T.stage==4 and 0 or 9)
        self:UI("TargetControl/Button/MoneyBackground").Enable=self._T.stage==4
        self:UI("TargetControl/Button/HolyBackground").Enable=self._T.stage==6
        -- Keep the scenery behind the money bag, and the cooldown shade above it.
        local layers={"Inner","MoneyBackground","HolyBackground","Icon","LeaderArt","Heading","Mode","OxygenMask","Flash","Cooldown"}
        for index,name in ipairs(layers) do _UILogic:SetSiblingIndex(self:UI("TargetControl/Button/"..name).UITransformComponent,index) end
        if Environment:IsMakerPlay() then log("[VRF] Target layers background="..tostring(_UILogic:GetSiblingIndex(self:UI("TargetControl/Button/Inner").UITransformComponent)).." icon="..tostring(_UILogic:GetSiblingIndex(self:UI("TargetControl/Button/Icon").UITransformComponent)).." time="..tostring(_UILogic:GetSiblingIndex(self:UI("TargetControl/Button/Cooldown").UITransformComponent))) end
        self:UI("TargetControl/Button/OxygenMask").UITransformComponent.anchoredPosition=Vector2(0,self._T.stage==4 and 0 or 9)
        self:UI("TargetControl/Button/OxygenMask").UITransformComponent.RectSize=Vector2(self._T.stage==4 and 64 or 78,self._T.stage==4 and 64 or 78)
        if self._T.stage==4 then
            self:UI("TargetControl/Button/Icon").SpriteGUIRendererComponent.ImageRUID=DataRef("17ae6a22966f45738bb92fb97ecc3e9d")
            self:CenterInteractionIcon("MoneyBackground")
            self:UI("TargetControl/Button/Mode").TextGUIRendererComponent.Text="단원 유인 · 10초"
            self:UpdateTargetControl() return
        end
        if self._T.stage==6 then
            self:UI("TargetControl/Button/Icon").SpriteGUIRendererComponent.ImageRUID=DataRef("9873f8d11af348af9abfafd70c001a01")
            self:UI("TargetControl/Button/Icon").UITransformComponent.RectSize=Vector2(32,64)
            self:UI("TargetControl/Button/Icon").UITransformComponent.anchoredPosition=Vector2(0,2)
            self:UI("TargetControl/Button/OxygenMask").UITransformComponent.anchoredPosition=Vector2(0,2)
            self:CenterInteractionIcon("HolyBackground")
            self:UI("TargetControl/Button/Mode").TextGUIRendererComponent.Text="정화의 성수 · 30초"
            self:UpdateTargetControl() return
        end
        if self._T.stage==5 then
            self:UI("TargetControl/Button/Icon").SpriteGUIRendererComponent.ImageRUID=DataRef("39e08b10949f41568b888434c385f3da")
            self:UI("TargetControl/Button/Mode").TextGUIRendererComponent.Text="공기방울"
            self:UpdateTargetControl() return
        end
        if self._T.stage==2 then
            self:UI("TargetControl/Button/Icon").SpriteGUIRendererComponent.ImageRUID=DataRef("thumbnail://19adfadeeb3346558da7f05d182a67dc")
            self:UI("TargetControl/Button/Mode").TextGUIRendererComponent.Text="패링"
            self:UpdateTargetControl() return
        end
        self._T.targetNearest=nearest
        local icon=self:UI("TargetControl/Button/Icon").SpriteGUIRendererComponent
        icon.ImageRUID=DataRef(nearest and "thumbnail://17b55730c26f4fd6b8fcfa288da388de" or ("thumbnail://"..self:Stage(self._T.stage or 1).portrait))
        self:UI("TargetControl/Button/Mode").TextGUIRendererComponent.Text=nearest and "가까운 적 우선" or "보스 우선"
        if animate then
            self._T.targetBlinkAt=_UtilLogic.ElapsedSeconds
            self._T.targetCooldownUntil=_UtilLogic.ElapsedSeconds+1
            _AutoHuntManager._T.target=nil _AutoHuntManager._T.nextScan=0 _AutoHuntManager._T.platformScanAt=0
            if Environment:IsMakerPlay() then log("[BossStage] target button changed; blink start") end
        else self._T.targetBlinkAt=nil end
        self:UpdateTargetControl()
    end

    @ExecSpace("Client")
    method void HolyWaterState(string mapName, number cooldown, boolean thrown)
        local player=_UserService.LocalPlayer
        if not self._T.battle or self._T.result or self._T.stage~=6 or not isvalid(player) or player.CurrentMap.Name~=mapName then return end
        self._T.targetCooldownUntil=_UtilLogic.ElapsedSeconds+cooldown
        if thrown then
            self._T.targetBlinkAt=_UtilLogic.ElapsedSeconds
            _GameAudio:PlaySound("c6da79f93bc34e7cb213080a00f09fef",0.65)
        end
        self:UpdateTargetControl()
        if Environment:IsMakerPlay() then log("[VRF] Holy water UI cooldown="..tostring(cooldown)) end
    end

    @ExecSpace("Client")
    method void MoneyBagState(string mapName, number cooldown, boolean thrown)
        -- Share the normal interaction key/touch button and shade its server-approved cooldown.
        local p=_UserService.LocalPlayer
        if not self._T.battle or self._T.result or self._T.stage~=4 or not isvalid(p) or not isvalid(p.CurrentMap) or p.CurrentMap.Name~=mapName then return end
        self._T.targetCooldownUntil=_UtilLogic.ElapsedSeconds+cooldown
        if thrown then
            self._T.targetBlinkAt=_UtilLogic.ElapsedSeconds
            _GameAudio:PlaySound("c6da79f93bc34e7cb213080a00f09fef",0.65)
        end
        self:UpdateTargetControl()
        if Environment:IsMakerPlay() then log("[VRF] Money bag UI cooldown="..tostring(cooldown).." thrown="..tostring(thrown)) end
    end

    @ExecSpace("ClientOnly")
    method void BindTargetDrag()
        -- Screen events keep dragging alive when the pointer leaves the button.
        self._T.targetTouch={}
        local function bind(event,callback)
            table.insert(self._T.targetTouch,{ev=event,h=_InputService:ConnectEvent(event,callback)})
        end
        bind(ScreenTouchEvent,function(e)
            if not self._T.battle or self:BlocksInput() or self._T.targetDrag~=nil then return end
            local control=self:UI("TargetControl")
            if not _UIClickArbiter:ContainsScreenPoint(control,e.TouchPoint) then return end
            if _GameSystemMenu:BlocksInput() then return end
            self._T.targetDrag={id=e.TouchId,start=_UILogic:ScreenToLocalUIPosition(e.TouchPoint,control.Parent.UITransformComponent),position=control.UITransformComponent.anchoredPosition,moved=false}
        end)
        bind(ScreenTouchHoldEvent,function(e)
            local drag=self._T.targetDrag
            if drag==nil or drag.id~=e.TouchId then return end
            if not self._T.battle or self:BlocksInput() then self._T.targetDrag=nil return end
            local control=self:UI("TargetControl")
            local point=_UILogic:ScreenToLocalUIPosition(e.TouchPoint,control.Parent.UITransformComponent)
            local delta=point-drag.start
            if math.abs(delta.x)+math.abs(delta.y)<8 and not drag.moved then return end
            drag.moved=true self._T.targetSuppressUntil=_UtilLogic.ElapsedSeconds+0.4
            local size=control.Parent.UITransformComponent.RectSize
            local p=drag.position+delta
            control.UITransformComponent.anchoredPosition=Vector2(math.max(8,math.min(size.x-176,p.x)),math.max(-size.y/2+117,math.min(size.y/2-117,p.y)))
        end)
        bind(ScreenTouchReleaseEvent,function(e)
            local drag=self._T.targetDrag
            if drag==nil or drag.id~=e.TouchId then return end
            if drag.moved then self._T.targetSuppressUntil=_UtilLogic.ElapsedSeconds+0.4 end
            self._T.targetDrag=nil
        end)
    end

    @ExecSpace("ClientOnly")
    method void UpdateTargetControl()
        if not self._T.battle then self._T.targetDrag=nil return end
        local now=_UtilLogic.ElapsedSeconds
        local start=self._T.targetBlinkAt
        local glow=false
        if start~=nil then
            local age=now-start
            glow=(age<0.12) or (age>=0.24 and age<0.36)
            if age>=0.48 then self._T.targetBlinkAt=nil if Environment:IsMakerPlay() then log("[BossStage] target button blink complete count=2") end end
        end
        local display=self._T.targetDisplay or {}
        self._T.targetDisplay=display
        if display.glow~=glow then
            display.glow=glow self:UI("TargetControl/Button/Flash").Enable=glow
        end
        local left=math.max(0,(self._T.targetCooldownUntil or 0)-now)
        local mask=self:UI("TargetControl/Button/OxygenMask")
        mask.Enable=(self._T.stage==4 or self._T.stage==5 or self._T.stage==6) and left>0
        if mask.Enable then mask.SpriteGUIRendererComponent.FillAmount=math.min(1,left/(self._T.stage==6 and 30 or self._T.stage==4 and 10 or (self._T.airMaskDuration or 33))) end
        for i=#(self._T.airPenalties or {}),1,-1 do
            local v=self._T.airPenalties[i] local age=now-v.at
            if not isvalid(v.entity) or age>=1.2 then
                if isvalid(v.entity) then v.entity:Destroy() end table.remove(self._T.airPenalties,i)
            else
                v.entity.UITransformComponent.anchoredPosition=Vector2(0,45+age*40)
                v.entity.TextGUIRendererComponent.FontColor=Color(1,0.12,0.12,1-age/1.2)
            end
        end
        local active=self._T.stage==2 and now<(self._T.parryActiveUntil or 0)
        local cooldown=active and "방어 중" or (left>0 and string.format("%.1f",left) or "")
        if display.cooldown~=cooldown then
            display.cooldown=cooldown
            self:UI("TargetControl/Button/Cooldown").TextGUIRendererComponent.Text=cooldown
        end
        if now>=(display.nextKeyCheck or 0) then
            display.nextKeyCheck=now+0.25
            local key=_KeySettingManager:GetKeyForFunc("interact")
            if display.key~=key then
                display.key=key
                self:UI("TargetControl/KeyBox/Inner/Key").TextGUIRendererComponent.Text=key~="" and key or "미지정"
            end
        end
    end

    @ExecSpace("Client")
    method void StumpyEffect(Entity boss, string ruid, Vector3 position, number direction, boolean attached, string sound, boolean shake)
        local p=_UserService.LocalPlayer
        if not (self._T.battle or (self._T.result and not self._T.resultWon)) or not isvalid(boss) or not isvalid(p) or p.CurrentMap~=boss.CurrentMap then return end
        local effectId=0
        if shake then
            -- The authoritative landing packet also snaps the interpolated visual to the floor.
            boss.SpriteRendererComponent.SpriteRUID="3a3034172ea14fe0b5e636604e352306"
            boss.SpriteRendererComponent.StartFrameIndex=9 boss.SpriteRendererComponent.EndFrameIndex=23
            boss.SpriteRendererComponent.PlayRate=1
            _NetworkMotionVisual:SnapImpact(boss,position)
        end
        if ruid~="" then
            if attached then effectId=_EffectService:PlayEffectAttached(ruid,boss,position,0,Vector3.one,false,{SortingLayer="MapLayer0",OrderInLayer=5})
            else effectId=_EffectService:PlayEffect(ruid,boss,position,0,Vector3(-direction,1,1),false,{SortingLayer="MapLayer0",OrderInLayer=5}) end
        end
        local parrySound=sound=="5a55b82229f24b3ca689fb433fa6f542" or sound=="4a789e378be34ed9980b4f21fb202186" or sound=="ba389f19b1164975a83e193e85be4896"
        local volume=parrySound and 1.6 or 0.8
        if sound~="" then _GameAudio:PlayBossSound(sound,volume) end
        if shake and isvalid(p.CameraComponent) then p.CameraComponent:ShakeCamera(0.35,0.5) end
        if Environment:IsMakerPlay() then log("[Stumpy] effect="..ruid.." id="..tostring(effectId).." fixed="..tostring(not attached).." position="..tostring(position).." direction="..tostring(direction).." shake="..tostring(shake).." sound="..sound.." volume="..tostring(volume)) end
    end

    @ExecSpace("ServerOnly")
    method void BeginStumpyParry(table r, Entity player)
        -- Only the encounter owner can open a parry window; the server owns both cooldowns.
        local now=_UtilLogic.ServerElapsedSeconds
        if now<(r.parryNextAt or 0) then return end
        r.parryUntil=now+1.2 r.parryNextAt=now+21.2
        self:ParryState(r.map,"active",1.2,21.2,r.uid)
        if Environment:IsMakerPlay() then log("[StumpyParry] active window=1.2") end
    end

    @ExecSpace("ServerOnly")
    method void TickStumpyParry(string uid)
        -- Resolve an unused window once, then start its twenty-second failure cooldown.
        local r=(self._T.runs or {})[uid]
        if r==nil or r.stage~=2 or r.state~="active" or r.parryUntil==nil then return end
        local now=_UtilLogic.ServerElapsedSeconds
        if now>=r.parryUntil then
            r.parryUntil=nil r.parryNextAt=now+20
            self:ParryState(r.map,"failed",0,20,uid)
            if Environment:IsMakerPlay() then log("[StumpyParry] failed cooldown=20") end
        end
    end

    @ExecSpace("ServerOnly")
    method boolean IsStumpyParryInvincible(Entity player)
        -- A per-encounter deadline cannot be cleared early by ordinary hit timers or leak into another map.
        if not isvalid(player) or not isvalid(player.PlayerComponent) or player.PlayerComponent.Hp<=0 then return false end
        local r=(self._T.runs or {})[player.PlayerComponent.UserId]
        if r==nil or r.stage~=2 or r.state~="active" or not isvalid(player.CurrentMap) or player.CurrentMap.Name~=r.map then return false end
        return _UtilLogic.ServerElapsedSeconds<(r.parryInvincibleUntil or 0)
    end

    @ExecSpace("ServerOnly")
    method boolean TryStumpyParry(Entity player, Entity attacker, string attackInfo, any impact)
        -- Only the shadow summons are parryable on ordinary body contact.
        if attackInfo~="boss.stumpy.ball" and attackInfo~="boss.stumpy.slam" and attackInfo~="boss.stumpy.dash" and attackInfo~="boss.stumpy.bats" and attackInfo~="boss.stumpy.flyeye" and attackInfo~="boss.stumpy.shadow" then return false end
        if not isvalid(player.PlayerComponent) or player.PlayerComponent.Hp<=0 then return false end
        local uid=player.PlayerComponent.UserId
        local r=(self._T.runs or {})[uid]
        if r==nil or r.stage~=2 or r.state~="active" or not isvalid(r.boss) or player.CurrentMap~=r.boss.CurrentMap or attacker.CurrentMap~=player.CurrentMap then return false end
        if attacker~=r.boss then
            local a=attacker:GetComponent("script.MonsterAttack")
            if not isvalid(a) or a.BossOwner~=uid then return false end
        end
        if attackInfo=="boss.stumpy.shadow" then
            local shadow=attacker:GetComponent("script.ManoSnail")
            if not isvalid(shadow) or not shadow._T.shadow then return false end
        end
        local now=_UtilLogic.ServerElapsedSeconds
        if r.parryUntil==nil or now>r.parryUntil then return false end
        r.parryUntil=nil r.parryNextAt=now+5 r.parryInvincibleUntil=now+1.5
        local hit=player:GetComponent("script.PlayerHit")
        if isvalid(hit) then hit:PlayInvincibleBlink(1.5) end
        local pos=impact or player.TransformComponent.WorldPosition+Vector3(0,0.5,0)
        if attackInfo=="boss.stumpy.flyeye" then pos=attacker.TransformComponent.WorldPosition end
        if attackInfo=="boss.stumpy.dash" then
            self:StumpyEffect(player,"41e13add2ba746d9bbe624a31205a848",Vector3(0,0.4,0),1,true,"5a55b82229f24b3ca689fb433fa6f542",false,uid)
        elseif attackInfo=="boss.stumpy.shadow" then
            self:StumpyEffect(player,"d7852ad775ea4db8ac46a11c3735b9e1",Vector3(0,0.4,0),1,true,"ba389f19b1164975a83e193e85be4896",false,uid)
        else
            local sound=(attackInfo=="boss.stumpy.ball" or attackInfo=="boss.stumpy.flyeye") and "4a789e378be34ed9980b4f21fb202186" or ""
            self:StumpyEffect(r.boss,"19adfadeeb3346558da7f05d182a67dc",pos,1,false,sound,false,uid)
        end
        self:ParryState(r.map,"success",0,5,uid)
        if Environment:IsMakerPlay() then log("[StumpyParry] success kind="..attackInfo.." cooldown=5 invincible=1.5") end
        return true
    end

    @ExecSpace("Client")
    method void ParryState(string mapName, string result, number active, number cooldown)
        -- Share the same touch button and remappable interaction key on PC and mobile.
        local p=_UserService.LocalPlayer
        if not self._T.battle or self._T.stage~=2 or not isvalid(p) or p.CurrentMap.Name~=mapName then return end
        self._T.parryActiveUntil=_UtilLogic.ElapsedSeconds+active
        self._T.targetCooldownUntil=_UtilLogic.ElapsedSeconds+cooldown
        if result=="success" then self._T.targetBlinkAt=_UtilLogic.ElapsedSeconds end
        self:UI("TargetControl/Button/Mode").TextGUIRendererComponent.Text=result=="active" and "패링 준비" or "패링"
        self:UpdateTargetControl()
        if Environment:IsMakerPlay() then log("[StumpyParry] UI "..result.." cooldown="..tostring(cooldown)) end
    end
    @ExecSpace("ServerOnly")
    method void BossContactHit(Entity attacker, Entity player, string attackInfo)
        -- Apply the oxygen penalty only after actual accepted damage, regardless of attack type.
        if isvalid(player) and isvalid(player.PlayerComponent) then
            local run=(self._T.runs or {})[player.PlayerComponent.UserId]
            if run~=nil and run.stage==5 and run.state=="active" and isvalid(run.boss) and player.CurrentMap==run.boss.CurrentMap then
                run.boss.SerufEncounter:PlayerDamaged(player,attackInfo or "")
            end
        end
        -- Pattern hits do not use the ordinary body-contact cue.
        if attackInfo~=nil and attackInfo~="" and attackInfo~="boss.mano.contact" and attackInfo~="boss.stumpy.contact" and attackInfo~="boss.stumpy.shadow" and attackInfo~="boss.king.contact" and attackInfo~="boss.faust.contact" then return end
        if not isvalid(attacker) or not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        local uid=player.PlayerComponent.UserId
        local r=(self._T.runs or {})[uid]
        if r==nil or r.state~="active" or player.CurrentMap.Name~=r.map or attacker.CurrentMap~=player.CurrentMap then return end
        local attack=attacker:GetComponent("script.MonsterAttack")
        if attacker~=r.boss and (not isvalid(attack) or attack.BossOwner~=uid) then return end
        local p=player.TransformComponent:ToWorldPoint(Vector3(0,0.35,0))
        local hit=attacker.HitComponent
        local offset=isvalid(hit) and hit.ColliderOffset or Vector2(0,0.35)
        local a=attacker.TransformComponent:ToWorldPoint(Vector3(offset.x,offset.y,0))
        local first=_UtilLogic:RandomIntegerRange(0,1)*4
        self:BossContactImpact(player,(p+a)*0.5,first,_UtilLogic:RandomDouble()*360,uid)
    end

    @ExecSpace("Client")
    method void BossContactImpact(Entity player, Vector3 position, integer first, number angle)
        -- Human frames 1-4 / 5-8 map to zero-based inclusive ranges 0-3 / 4-7.
        if not isvalid(player) or player~=_UserService.LocalPlayer or not self._T.battle then return end
        _GameAudio:PlayBossSound("e6061e1f1efc4858805bb5d0d9944ff9",0.8)
        local serial=_EffectService:PlayEffect("fa71427649df4eeb8a3fd1ddf4cf9023",player,position,angle,Vector3.one,false,{StartFrameIndex=first,EndFrameIndex=first+3,SortingLayer="MapLayer0",OrderInLayer=7})
        if Environment:IsMakerPlay() then log("[BossContact] effect="..tostring(serial).." frames="..tostring(first+1).."-"..tostring(first+4).." angle="..tostring(angle)) end
    end
    method table BattleBuffOptions()
        -- Central place for boss-only balance options; both mechanics and the tooltip read these values.
        return {hpRecovery=1.5,mpRecovery=1.5}
    end

    method boolean BattleBuffActive(Entity player)
        -- Arena membership is authoritative, so death/revival does not stack or remove the arena rules.
        if not isvalid(player) or not isvalid(player.CurrentMap) or not self:IsArena(player.CurrentMap.Name) then return false end
        if self:IsClient() and player==_UserService.LocalPlayer and self._T.cancelledBattleMap==player.CurrentMap.Id then return false end
        local attack=player:GetComponent("script.PlayerAttack")
        return not isvalid(attack) or not attack.BossBuffCancelled
    end

    method number BattleBuffMultiplier(string option, Entity player)
        -- Outside boss arenas every multiplier returns its neutral value immediately.
        if not self:BattleBuffActive(player) then return 1 end
        return self:BattleBuffOptions()[option] or 1
    end

    method string BattleBuffDescription()
        -- Keep the visible options in sync with the central balance values.
        local options=self:BattleBuffOptions()
        return "초보자 HP 회복량 "..tostring(options.hpRecovery).."배\n초보자 MP 회복량 "..tostring(options.mpRecovery).."배\n자연 회복과 스킬 사용 중 회복에 적용\n아이콘 클릭 또는 보스전 종료 시 해제"
    end

    @ExecSpace("ClientOnly")
    method table BattleBuffTooltip()
        -- A map rule has no learnable level or manual cancellation.
        return {name="보스 전용 버프",ruid="29dc0219becf49a9b3ef6fadfb888350",desc="보스전에서 적용되는 전투 지원 효과입니다.",level=1,maxLevel=1,spendable=false}
    end

    @ExecSpace("ClientOnly")
    method void UpdateBattleBuffIcon()
        -- Reuse the common buff bar so its placement follows the desktop/mobile layout.
        local active=self:BattleBuffActive(_UserService.LocalPlayer)
        local icon=_EntityService:GetEntityByPath("/ui/DefaultGroup/BuffBar/BossBattleIcon")
        if isvalid(icon) then icon.Enable=active end
        if self._T.battleBuffVisible~=active then
            self._T.battleBuffVisible=active
            if Environment:IsMakerPlay() then log("[VRF] BossBattleBuff active="..tostring(active)) end
        end
    end

    -- UI item sprites use their rectangle center rather than the item's original world pivot.
    @ExecSpace("ClientOnly")
    method void CenterInteractionIcon(string background)
        local bg=self:UI("TargetControl/Button/"..background).UITransformComponent
        for _,name in ipairs({"Icon","OxygenMask"}) do
            local tr=self:UI("TargetControl/Button/"..name).UITransformComponent
            tr.AnchorsMin=bg.AnchorsMin tr.AnchorsMax=bg.AnchorsMax tr.Pivot=Vector2(0.5,0.5)
            tr.anchoredPosition=bg.anchoredPosition
        end
        local icon=self:UI("TargetControl/Button/Icon").SpriteGUIRendererComponent
        icon.LocalPosition=Vector2.zero icon.LocalScale=Vector2.one
        if Environment:IsMakerPlay() then log("[VRF] Interaction icon centered background="..background) end
    end

    @ExecSpace("ClientOnly")
    method void CancelBattleBuff()
        local player=_UserService.LocalPlayer
        if not self:BattleBuffActive(player) then return end
        self._T.cancelledBattleMap=player.CurrentMap.Id
        self:RequestCancelBattleBuff()
        self:UpdateBattleBuffIcon()
    end

    @ExecSpace("Server")
    method void RequestCancelBattleBuff()
        local player=_UserService:GetUserEntityByUserId(senderUserId)
        if not self:BattleBuffActive(player) then return end
        local attack=player:GetComponent("script.PlayerAttack")
        if isvalid(attack) then attack.BossBuffCancelled=true end
    end

end
