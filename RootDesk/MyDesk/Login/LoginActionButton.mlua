@Component
script LoginActionButton extends Component
    property string Action = ""
    property boolean FullRectInput = true

    @ExecSpace("ClientOnly")
    method boolean CanUseFullRect()
        if _AppearanceColorPicker:BlocksInput() then return false end
        if not self.FullRectInput or not self.Entity.EnabledInHierarchy or not self.Entity.VisibleInHierarchy then return false end
        local button = self.Entity.ButtonComponent
        if not isvalid(button) or not button.Enable then return false end
        local modal = _EntityService:GetEntityByPath("/ui/LoginScene/Modal")
        if isvalid(modal) and modal.EnabledInHierarchy then
            return self.Action == "noticeYes" or self.Action == "noticeNo"
        end
        return not _LoginFlow.busy
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        if not self.FullRectInput then return end
        local sprite = self.Entity.SpriteGUIRendererComponent
        local button = self.Entity.ButtonComponent
        if not isvalid(sprite) or not isvalid(button) then return end
        if self._T.normalRUID == nil then self._T.normalRUID = DataRef(sprite.ImageRUID.DataId) end
        local hover = self:CanUseFullRect() and self:HitArea( _InputService:GetCursorPosition())
        local ruid = self._T.normalRUID
        if not button.Enable then
            local ref = button.ImageRUIDs.DisabledSprite
            ruid = ref ~= nil and ref or self._T.normalRUID
        elseif hover and self._T.pointerId ~= nil then
            local ref = button.ImageRUIDs.PressedSprite
            ruid = ref ~= nil and ref or self._T.normalRUID
        elseif hover then
            local ref = button.ImageRUIDs.HighlightedSprite
            ruid = ref ~= nil and ref or self._T.normalRUID
        end
        if ruid ~= nil and ruid.DataId ~= "" then sprite.ImageRUID = ruid end
        if hover and not self._T.hovered then _UIAudio:Play("BtMouseOver") end
        self._T.hovered = hover
        if not self:CanUseFullRect() then self._T.pointerId = nil end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandlePointerDown(ScreenTouchEvent event)
        if not self:CanUseFullRect() then return end
        if self:HitArea( event.TouchPoint) then self._T.pointerId = event.TouchId end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandlePointerUp(ScreenTouchReleaseEvent event)
        if self._T.pointerId ~= event.TouchId then return end
        self._T.pointerId = nil
        if not self:CanUseFullRect() or not self:ReleaseHit(event.TouchPoint) then return end
        _UIAudio:Play("BtMouseClick")
        if Environment:IsMakerPlay() then log("[LoginButton] full rectangle click: " .. self.Action) end
        _LoginFlow:Action(self.Action)
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleClick(ButtonClickEvent event)
        if self.FullRectInput then return end
        _LoginFlow:Action(self.Action)
    end
    @ExecSpace("ClientOnly")
    method boolean ReleaseHit(Vector2 point)
        -- Small finger movement after pressing should not discard an otherwise valid tap.
        local area=self.Entity:GetChildByName("HitArea")
        if not isvalid(area) then area=self.Entity end
        local tr=area.UITransformComponent local p=_UILogic:ScreenToLocalUIPosition(point,tr)
        local margin=(Environment:IsMobilePlatform() or _MobileUIManager:IsMobile()) and 12 or 3
        return math.abs(p.x)<tr.RectSize.x/2+margin and math.abs(p.y)<tr.RectSize.y/2+margin
    end

    @ExecSpace("ClientOnly")
    method boolean HitArea(Vector2 point)
        -- 그림 크기는 유지하면서 월드 선택의 터치 범위만 넓힌다.
        local area=self.Entity:GetChildByName("HitArea")
        return _UICursorManager:Hit(isvalid(area) and area or self.Entity,point)
    end

end
