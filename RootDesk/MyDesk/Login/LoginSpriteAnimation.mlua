@Component
script LoginSpriteAnimation extends Component
    property string Frames = ""
    property number Interval = 0.14
    property boolean Loop = true
    property string Heights = ""
    property string Widths = ""
    property string OriginsX = ""
    property string OriginsY = ""
    property number OriginX = 0
    property number TopY = 0
    property number StartDelay = 0
    property number PulsePeriod = 0
    property boolean UseFrameLayers = false

    @ExecSpace("ClientOnly")
    method table Numbers(string value)
        -- 원본 프레임 크기와 WZ 원점을 한 번만 해석한다.
        local out = {}
        for part in string.gmatch(value, "[^,]+") do table.insert(out, tonumber(part) or 0) end
        return out
    end

    @ExecSpace("ClientOnly")
    method void Replay()
        -- 선택 변경 때 첫 프레임을 즉시 적용한다. 비활성 상태에서도 초기화 가능하다.
        self._T.elapsed = 0
        self._T.index = 0
        self:Advance(0)
    end

    @ExecSpace("ClientOnly")
    method void Advance(number delta)
        -- 반복/한 번 재생을 분리하고 마지막 프레임의 원점과 크기를 유지한다.
        if self._T.frames == nil or self._T.heights == nil or self._T.widths == nil or self._T.ox == nil or self._T.oy == nil then
            -- Replay와 첫 Update가 겹쳐도 불완전한 프레임 캐시를 공개하지 않는다.
            local frames = {}
            for ruid in string.gmatch(self.Frames, "[^,]+") do table.insert(frames, ruid) end
            local heights = self:Numbers(self.Heights)
            local widths = self:Numbers(self.Widths)
            local ox = self:Numbers(self.OriginsX)
            local oy = self:Numbers(self.OriginsY)
            self._T.heights = heights
            self._T.widths = widths
            self._T.ox = ox
            self._T.oy = oy
            self._T.frames = frames
        end
        local count = #self._T.frames
        if count == 0 then return end
        self._T.elapsed = (self._T.elapsed or 0) + delta
        local elapsed = math.max(0, self._T.elapsed - self.StartDelay)
        local tick = math.floor(elapsed / math.max(0.05, self.Interval))
        local index = self.Loop and (tick % count + 1) or math.min(count, tick + 1)
        local renderer = self.Entity.SpriteGUIRendererComponent
        if self.PulsePeriod > 0 then
            renderer:SetAlpha(self._T.elapsed < self.StartDelay and 0 or (0.15 + 0.65 * (0.5 - 0.5 * math.cos(elapsed * 6.283185 / self.PulsePeriod))))
        end
        if index == self._T.index then return end
        self._T.index = index
        if self.UseFrameLayers then
            -- Each immutable frame owns its ORI-aligned rect, so texture loading
            -- cannot display the previous frame with the next frame's dimensions.
            self.Entity.UITransformComponent.anchoredPosition = Vector2(self.OriginX, self.TopY)
            renderer:SetAlpha(0)
            for i = 1, count do
                local layer = self.Entity:GetChildByName("Frame" .. tostring(i))
                if isvalid(layer) then layer.CanvasGroupComponent.GroupAlpha = i == index and 1 or 0 end
            end
            return
        end
        renderer.ImageRUID = DataRef(self._T.frames[index])
        local height = self._T.heights[index]
        if height ~= nil then
            local tr = self.Entity.UITransformComponent
            local width = self._T.widths[index] or tr.RectSize.x
            tr.RectSize = Vector2(width, height)
            local x = tr.anchoredPosition.x
            if self._T.ox[index] ~= nil then x = self.OriginX + width / 2 - self._T.ox[index] end
            tr.anchoredPosition = Vector2(x, self.TopY + (self._T.oy[index] or 0) - height / 2)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 숨겨진 화면에서는 프레임 계산을 멈춘다.
        if self.Entity.EnabledInHierarchy and not self._T.paused then self:Advance(self._T.limitFrameDelta and math.min(delta, 0.1) or delta) end
    end
end
