@Component
script UISlotClickForwarder extends Component

	property number slotIdx = 0
	property string windowType = "equip"

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleTouch(UITouchDownEvent event)
		-- 겹친 창 관통 방지: 이 슬롯이 속한 창이 클릭 지점의 최상단 창일 때만 전달한다.
		local winPath = "/ui/DefaultGroup/EquipWindow"
		if self.windowType == "inven" then winPath = "/ui/DefaultGroup/InvenWindow" end
		if not _UIClickArbiter:AcceptClickAt(winPath, event.TouchPoint) then return end
		_UIEquipInventoryManager:OnSlotClick(self.windowType, self.slotIdx)
	end

end
