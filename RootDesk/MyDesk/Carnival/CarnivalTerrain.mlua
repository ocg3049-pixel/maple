@Logic
script CarnivalTerrain extends Logic
    method table Data(integer layout)
        -- A single continuous floor is shared by rendering, native physics and both teams.
        self._T.maps=self._T.maps or {}
        local index=math.max(0,math.min(3,layout))+1
        if self._T.maps[index]~=nil then return self._T.maps[index] end
        local width=(layout==0 and 24 or 36)*2/5
        local edge={l=-width/2,r=width/2,y=0,y2=0,custom=true}
        local data={name="CarnivalFlat"..tostring(layout),flat=true,floorY=0,bounds={minX=-width/2,maxX=width/2,minY=-1,maxY=8,count=1},spawn={x=0,y=0.2},edges={edge},arts={}}
        for x=-width/2,width/2,1.75 do
            table.insert(data.arts,{ruid="1f94f80bacb14f4192e5cfc17be327ee",x=x,y=-0.32,sx=1,sy=1,flip=false,layer=0,order=0})
        end
        data.platforms={{l=edge.l,r=edge.r,y=0}}
        data.platforms.edges=data.edges data.platforms.bounds=data.bounds data.platforms.spawn=data.spawn
        data.platforms.floorY=data.floorY
        self._T.maps[index]=data
        return data
    end
    @ExecSpace("ClientOnly")
    method void Draw(integer layout, number scale, number cameraX, number cameraY)
        -- Project original sprite pivots and footholds through the same camera as the actors.
        local data=self:Data(layout)
        local parent=_CarnivalUI:UI("Lobby/Scene/Terrain")
        local template=_CarnivalUI:UI("Lobby/Scene/TerrainTemplate")
        if self._T.layout~=layout then
            for _,node in ipairs(self._T.nodes or {}) do if isvalid(node) then _EntityService:Destroy(node) end end
            self._T.nodes={} self._T.layout=layout
            for i,art in ipairs(data.arts) do
                local node=_SpawnService:SpawnByEntity(template,"MapSprite"..tostring(i),Vector3.zero,parent,false)
                node.SpriteGUIRendererComponent.ImageRUID=DataRef(art.ruid)
                node.SpriteGUIRendererComponent.PreserveSprite=PreserveSpriteType.NativeSize
                node.SpriteGUIRendererComponent.FlipX=art.flip
                node.Enable=true self._T.nodes[i]=node
            end
            log("[VRF] Carnival terrain map="..data.name.." edges="..tostring(#data.edges).." sprites="..tostring(#data.arts))
        end
        parent.UITransformComponent.anchoredPosition=Vector2(-cameraX*scale,-cameraY*scale)
        parent.UITransformComponent.UIScale=Vector3(scale/100,scale/100,1)
        for i,art in ipairs(data.arts) do
            local node=self._T.nodes[i]
            node.UITransformComponent.anchoredPosition=Vector2(art.x*100,art.y*100)
            node.UITransformComponent.UIScale=Vector3(art.sx,art.sy,1)
        end
    end

    @ExecSpace("ClientOnly")
    method void Background(number width, number height, number scale, number cameraX, number cameraY)
        -- Both source images are 400 by 512; they alternate horizontally without stretching either axis.
        local parent=_CarnivalUI:UI("Lobby/Scene/BackdropTiles")
        -- Spawned children must stay behind actors, regardless of the editor serialization order.
        for index,name in ipairs({"Backing","BackdropTiles","Terrain"}) do
            local transform=_CarnivalUI:UI("Lobby/Scene/"..name).UITransformComponent
            if _UILogic:GetSiblingIndex(transform)~=index then _UILogic:SetSiblingIndex(transform,index) end
        end
        local zoom=math.max(height/512,scale/100)
        local tileWidth=400*zoom local tileHeight=512*zoom
        local needed=math.ceil(width/tileWidth)+2
        self._T.backgrounds=self._T.backgrounds or {}
        local offset=cameraX*scale*0.25
        local first=math.floor((offset-width/2)/tileWidth)
        for i=1,math.max(needed,#self._T.backgrounds) do
            local node=self._T.backgrounds[i]
            if i<=needed and not isvalid(node) then
                node=_SpawnService:SpawnByEntity(_CarnivalUI:UI("Lobby/Scene/Backdrop0"),"BackdropTile"..tostring(i),Vector3.zero,parent,false)
                self._T.backgrounds[i]=node
            end
            if isvalid(node) then
                node.Enable=i<=needed
                if node.Enable then
                    local index=first+i-1
                    local ruid=index%2==0 and "374303657b2544ff9b7f487b7b5c62e0" or "8d2d285512b84e75b23c7aa9aea5155e"
                    if node.SpriteGUIRendererComponent.ImageRUID.DataId~=ruid then node.SpriteGUIRendererComponent.ImageRUID=DataRef(ruid) end
                    node.SpriteGUIRendererComponent.PreserveSprite=PreserveSpriteType.AspectOnly
                    node.UITransformComponent.RectSize=Vector2(tileWidth,tileHeight)
                    node.UITransformComponent.anchoredPosition=Vector2((index+0.5)*tileWidth-offset,0)
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release generated UI pieces with the world session.
        for _,node in ipairs(self._T.nodes or {}) do if isvalid(node) then _EntityService:Destroy(node) end end
        for _,node in ipairs(self._T.backgrounds or {}) do if isvalid(node) then _EntityService:Destroy(node) end end
        self._T.nodes={} self._T.backgrounds={} self._T.layout=nil
    end
end
