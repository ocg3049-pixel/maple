@Logic
script CarnivalSkillBalance extends Logic
	method integer GetBasicTrainingLevel(table levels)
		-- Read the renamed passive, retaining compatibility with older saved Carnival builds.
		return math.max(0, math.min(math.floor(tonumber(levels["기본기 강화"] or levels["파워스트라이크 강화"]) or 0), 30))
	end

	method number GetPowerStrikeMinPercent(integer lv, table levels)
		-- 미투자(0)도 계산은 되지만 실제 시전은 IsSkillUsableByInvestment가 막는다.
		local v = math.max(0, math.min(lv, 20))
		local enhanceLv = self:GetBasicTrainingLevel(levels)
		return 100 + 4 * v + 4 * enhanceLv
	end

	method number GetPowerStrikeMaxPercent(integer lv, table levels)
		-- 최소 배율과 짝을 이루는 상한 - 서버가 이 둘 사이에서 타격마다 1회 굴린다.
		local v = math.max(0, math.min(lv, 20))
		local enhanceLv = self:GetBasicTrainingLevel(levels)
		return 120 + 6 * v + 4 * enhanceLv
	end

	method number GetSlashBlastMinPercent(integer lv, table levels)
		-- 최대 6명을 순차로 때리므로, 이 배율이 대상마다 각각 굴려진다.
		local v = math.max(0, math.min(lv, 20))
		return 50 + 2 * v + 4 * self:GetBasicTrainingLevel(levels)
	end

	method number GetSlashBlastMaxPercent(integer lv, table levels)
		-- 최소 배율과 짝을 이루는 상한.
		local v = math.max(0, math.min(lv, 20))
		return 60 + 3 * v + 4 * self:GetBasicTrainingLevel(levels)
	end

	method number GetHolyArrowMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		return 150 + 4 * (v - 1)
	end

	method number GetHolyArrowMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		return 200 + 4 * (v - 1)
	end

	method number GetAngelRayMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 350 + 15 * (v - 1)
	end

	method number GetAngelRayMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 400 + 15 * (v - 1)
	end

	method number GetMagicMissileMinPercent(integer lv, table levels)
		-- Magic Missile shares the original base curve, not the warrior's passive enhancement.
		return 50 + 2 * math.max(0, math.min(lv, 20))
	end

	method number GetMagicMissileMaxPercent(integer lv, table levels)
		-- Keep the magic skill independent of Basic Training.
		return 60 + 3 * math.max(0, math.min(lv, 20))
	end

	method number GetIronArrowMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		return 150 + 4 * (v - 1)
	end

	method number GetIronArrowMaxPercent(integer lv, table levels)
		-- 최소%와 폭(20%p)이 함께 밀려 올라간다 - 요청대로 "최소·최대 4%씩" 오른다.
		local v = math.max(1, math.min(lv, 20))
		return 170 + 4 * (v - 1)
	end

	method number GetStrafeMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		-- 현재 2/3 조정값에서 추가로 20% 하향.
		return (120 + 5 * (v - 1)) * 2.0 / 3.0 * 0.8
	end

	method number GetStrafeMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return (130 + 6 * (v - 1)) * 2.0 / 3.0 * 0.8
	end

	method number GetIceShotMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 200 + 5 * (v - 1)
	end

	method number GetIceShotMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 220 + 5 * (v - 1)
	end

	method number GetFireShotMinPercent(integer lv, table levels)
		return self:GetIceShotMinPercent(lv,levels)
	end

	method number GetFireShotMaxPercent(integer lv, table levels)
		return self:GetIceShotMaxPercent(lv,levels)
	end

	method number GetArrowBombMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		return (130 + 4 * (v - 1)) * 2 / 3
	end

	method number GetArrowBombMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		return (140 + 4 * (v - 1)) * 2 / 3
	end

	method number GetThunderboltMinPercent(integer lv, table levels)
		return self:GetHolyArrowMinPercent(lv,levels) * 2 / 3
	end

	method number GetThunderboltMaxPercent(integer lv, table levels)
		return self:GetHolyArrowMaxPercent(lv,levels) * 2 / 3
	end

	method number GetColdBeamMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		-- 현재 데미지에서 10% 증가.
		return (250 + 5 * (v - 1)) * 2 / 3 * 1.7 * 0.8 * 1.1
	end

	method number GetColdBeamMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		return (270 + 5 * (v - 1)) * 2 / 3 * 1.7 * 0.8 * 1.1
	end

	method number GetFireArrowMinPercent(integer lv, table levels)
		return self:GetHolyArrowMinPercent(lv,levels) * 0.5
			+ self:GetFireArrowEnhanceBonus((levels["파이어에로우 강화"] or 0),levels)
	end

	method number GetFireArrowMaxPercent(integer lv, table levels)
		-- 마스터 레벨(20)도 홀리 에로우와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetHolyArrowMaxPercent(lv,levels) * 0.5
			+ self:GetFireArrowEnhanceBonus((levels["파이어에로우 강화"] or 0),levels)
	end

	method number GetTripleThrowMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 40 + 1 * (v - 1)
	end

	method number GetTripleThrowMaxPercent(integer lv, table levels)
		-- 최소%와 폭(10%p)이 함께 밀려 올라간다 - 요청대로 "최소 2% 최대 2%씩" 오른다.
		local v = math.max(1, math.min(lv, 30))
		return 45 + 1 * (v - 1)
	end

	method number GetQuadThrowMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 70 + 1 * (v - 1)
	end

	method number GetQuadThrowMaxPercent(integer lv, table levels)
		-- 최소%와 폭(10%p)이 함께 밀려 올라간다 - 요청대로 "최소 2% 최대 2%씩" 오른다.
		local v = math.max(1, math.min(lv, 30))
		return 75 + 1 * (v - 1)
	end

	method number GetAvengerMinPercent(integer lv, table levels)
		-- 암행/스피어 버스터와 같은 "1레벨 기준값 + (lv-1)" 관례.
		local v = math.max(1, math.min(lv, 20))
		return 160 + 3 * (v - 1)
	end

	method number GetAvengerMaxPercent(integer lv, table levels)
		-- 최소%와 폭(20%p)이 함께 밀려 올라간다 - 요청대로 "최소 3 최대 3%씩" 오른다.
		local v = math.max(1, math.min(lv, 20))
		return 180 + 3 * (v - 1)
	end

	method number GetSavageBlowMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 20 + 0.8 * (v - 1)
	end

	method number GetSavageBlowMaxPercent(integer lv, table levels)
		-- 최소·최대가 같은 폭(+0.8%p)으로 함께 오른다.
		local v = math.max(1, math.min(lv, 30))
		return 24 + 0.8 * (v - 1)
	end

	method number GetShiningRayMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 20))
		return 1000 + 30 * (v - 1)
	end

	method number GetShiningRayMaxPercent(integer lv, table levels)
		-- 최소와 같은 폭으로 함께 밀려 올라간다(요청: "최소 최저 30%씩 상승").
		local v = math.max(1, math.min(lv, 20))
		return 1500 + 30 * (v - 1)
	end

	method number GetIceStrikeMinPercent(integer lv, table levels)
		-- 아이스 스트라이크 최소 데미지는 같은 레벨 샤이닝 레이의 정확히 1/4이다.
		return self:GetShiningRayMinPercent(lv,levels) * 0.25
	end

	method number GetIceStrikeMaxPercent(integer lv, table levels)
		-- 아이스 스트라이크 최대 데미지는 같은 레벨 샤이닝 레이의 정확히 1/4이다.
		return self:GetShiningRayMaxPercent(lv,levels) * 0.25
	end

	method number GetGenesisMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 500 + 15 * (v - 1)
	end

	method number GetGenesisMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 650 + 15 * (v - 1)
	end

	method number GetBlizzardMinPercent(integer lv, table levels)
		return self:GetGenesisMinPercent(lv,levels)
	end

	method number GetBlizzardMaxPercent(integer lv, table levels)
		-- 마스터 레벨(30)도 제네시스와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetGenesisMaxPercent(lv,levels)
	end

	method number GetMeteorMinPercent(integer lv, table levels)
		return self:GetGenesisMinPercent(lv,levels)
	end

	method number GetMeteorMaxPercent(integer lv, table levels)
		-- 마스터 레벨(30)도 제네시스와 같아 상한 클램프가 어긋나지 않는다.
		return self:GetGenesisMaxPercent(lv,levels)
	end

	method number GetChainLightningMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 500 + 10 * (v - 1)
	end

	method number GetChainLightningMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 700 + 20 * (v - 1)
	end

	method number GetFireWaveMinPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 500 + 7 * (v - 1)
	end

	method number GetFireWaveMaxPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 550 + 7 * (v - 1)
	end

	method number GetChargeBlowMinPercent(integer lv, table levels)
		-- 차지 블로우 데미지 하한(%).
		-- 본체 분배당 +6%p, 4차 강화는 분배당 +6%p를 합산한다.
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		local enhanceLv = math.max(0, math.min((levels["차지 블로우 강화"] or 0), 30))
		return 340 + 6 * (lv - 1) + 6 * enhanceLv
	end

	method number GetChargeBlowMaxPercent(integer lv, table levels)
		-- 차지 블로우 데미지 상한(%).
		-- 최소 배율과 동일하게 본체 +6%p/pt, 4차 강화 +6%p/pt를 합산한다.
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		local enhanceLv = math.max(0, math.min((levels["차지 블로우 강화"] or 0), 30))
		return 380 + 6 * (lv - 1) + 6 * enhanceLv
	end

	method number GetPanicMinPercent(integer lv, table levels)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 30)
		return 180 + 15 * (lv - 1)
	end

	method number GetPanicMaxPercent(integer lv, table levels)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 30)
		return 240 + 20 * (lv - 1)
	end

	method number GetComaMinPercent(integer lv, table levels)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 90 + (180 - 90) / 19 * (lv - 1)
	end

	method number GetComaMaxPercent(integer lv, table levels)
		if lv < 1 then lv = 1 end
		lv = math.min(lv, 20)
		return 120 + (240 - 120) / 19 * (lv - 1)
	end

	method number GetFireArrowEnhanceBonus(integer lv, table levels)
		local v = math.max(0, math.min(lv, 20))
		if v <= 0 then return 0 end
		return 100 + 5 * (v - 1)
	end

	method number GetHealPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return math.max(1, math.floor(v / 2))
	end
	method number GetFlashJumpForceUnit(integer lv, table levels)
		local units = {3, 3, 3, 4, 4, 5, 5, 6, 6, 7}
		local v = math.max(1, math.min(lv, 10))
		return units[v]
	end
	method number GetFlashJumpForceScale(integer lv, table levels)
		return self:GetFlashJumpForceUnit(lv, levels) / 5.0
	end
	method integer GetHeroSummonLevelPercent(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 50 + math.floor(v / 2)
	end
	method number GetGenesisCooldown(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 120 - (v - 1)
	end
	method number GetBlizzardCooldown(integer lv, table levels)
		local v = math.max(1, math.min(lv, 30))
		return 120 - (v - 1)
	end
	method number GetMeteorCooldown(integer lv, table levels)
		-- 값을 복사하면 한쪽만 고쳤을 때 조용히 갈라지므로 제네시스 헬퍼를 그대로 호출한다
		-- (마스터 30 클램프도 동일). 구 사양은 20초 고정이었다.
		return self:GetGenesisCooldown(lv, levels)
	end
end
