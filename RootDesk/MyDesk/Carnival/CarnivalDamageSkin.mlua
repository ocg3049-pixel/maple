    @ExecSpace("ClientOnly")
    method void Prepare(string skin, any ready)
        self._T.skins=self._T.skins or {}
        local entry=self._T.skins[skin]
        if entry~=nil then
            if entry.ready then ready(entry) else table.insert(entry.waiters,ready) end
            return
        end
        local groups=self:Catalog()[skin]
        if groups==nil then
            -- Keep unsupported future skins visible; log once so their atlas can be registered.
            self._T.unsupported=self._T.unsupported or {}
            if not self._T.unsupported[skin] then self._T.unsupported[skin]=true log_warning("[Carnival] Unregistered damage skin: "..skin) end
            self:Prepare("3271c3e79bf04ecba9a107d55495970d",ready)
            return
        end
        entry={groups=groups,waiters={ready},sprites={}} self._T.skins[skin]=entry
        _DamageSkinService:PreloadAsync(skin,function(success)
            if self._T.skins[skin]~=entry then return end
            if not success then self._T.skins[skin]=nil log_warning("[Carnival] Damage skin preload failed: "..skin) return end
            for _,group in pairs(groups) do
                for _,id in ipairs(group) do
                    local sprite=_ResourceService:LoadSpriteAndWait(id)
                    if sprite~=nil then entry.sprites[id]={width=sprite.Width,height=sprite.Height,pivot=sprite.PivotPixel} end
                end
            end
            entry.ready=true
            local waiters=entry.waiters entry.waiters={}
            for _,callback in ipairs(waiters) do callback(entry) end
            if Environment:IsMakerPlay() then log("[VRF] Carnival original skin loaded="..skin) end
        end)
    end

    method void Play(Entity target, string skin, number delay, table damages, DamageSkinTweenType tween, any criticals, Vector2 offset, Vector2 scale, number rate, number alpha, LitMode lighting)
        if not isvalid(target) then return end
        if not self:IsClient() then
            -- Native enums cannot cross execution spaces; transmit only primitive values.
            local packet={}
            for i,value in ipairs(damages) do
                local text=0
                if type(value)~="number" then
                    if value==DamageSkinTextType.Miss then text=1 elseif value==DamageSkinTextType.Guard then text=2 elseif value==DamageSkinTextType.Resist then text=3 elseif value==DamageSkinTextType.Shot then text=4 elseif value==DamageSkinTextType.Counter then text=5 end
                end
                table.insert(packet,{damage=type(value)=="number" and value or 0,text=text,critical=criticals==true or (type(criticals)=="table" and criticals[i]==true)})
            end
            self:Broadcast(target,skin,delay,packet,tostring(tween),offset,scale,rate,alpha,tostring(lighting))
            return
        end
        local binding=_CarnivalActorPresentation:BindingFor(target)
        if binding==nil then
            _DamageSkinService:Play(target,skin,delay,damages,tween,criticals,offset,scale,rate,alpha,lighting)
            return
        end
        offset=offset or Vector2.zero scale=scale or Vector2.one
        if scale.x==0 and scale.y==0 then scale=Vector2.one end
        if rate==nil or rate<=0 then rate=1 end
        alpha=alpha or 1
        local stamp=_UtilLogic.ElapsedSeconds
        local point=target.TransformComponent.WorldPosition
        local spawn=target.DamageSkinSpawnerComponent
        local anchor=isvalid(spawn) and spawn.DamageSkinOffset or Vector2.zero
        local position=Vector3(point.x+anchor.x+offset.x,point.y+anchor.y+offset.y+1,point.z)
        self:Prepare(skin,function(entry)
            if not _CarnivalUI.opened or _CarnivalActorPresentation:BindingFor(target)==nil then return end
            for i,value in ipairs(damages) do
                local critical=criticals==true or (type(criticals)=="table" and criticals[i]==true)
                self:CreateLine(target,binding,entry,value,critical,position+Vector3(0,(i-1)*0.3,0),scale,stamp+(i-1)*math.max(0,delay or 0),rate,alpha,skin)
            end
        end)
    end

    method void PlayTextDamage(Entity target, string skin, DamageSkinTextType textType, DamageSkinTweenType tween)
        self:Play(target,skin,0,{textType},tween,false,Vector2.zero,Vector2.one,1,1,LitMode.Default)
    end

    @ExecSpace("ClientOnly")
    method void CreateLine(Entity target, table binding, table entry, any value, boolean critical, Vector3 position, Vector2 scale, number stamp, number rate, number alpha, string skin)
        self:EnsureUI()
        local layer=_CarnivalUI:UI("Lobby/Scene/DamageLayer")
        local template=_CarnivalUI:UI("Lobby/Scene/DamageLineTemplate")
        if not isvalid(layer) or not isvalid(template) then return end
        -- Bound transient entity count even when many summons hit at once.
        self._T.lines=self._T.lines or {}
        while #self._T.lines>=160 do self:RemoveLine(1) end
        local groups=entry.groups local glyphs={}
        if type(value)=="number" then
            local text=tostring(math.max(0,math.floor(value)))
            for i=1,#text do
                local index=tonumber(string.sub(text,i,i))+1
                local group=critical and (i==1 and 4 or 3) or (i==1 and 2 or 1)
                table.insert(glyphs,groups[group][index])
            end
        else
            local group=5
            if value==DamageSkinTextType.Guard then group=6 elseif value==DamageSkinTextType.Resist then group=9 elseif value==DamageSkinTextType.Shot then group=7 elseif value==DamageSkinTextType.Counter then group=8 end
            if groups[group]~=nil then table.insert(glyphs,groups[group][1]) end
            critical=false
        end
        if #glyphs==0 then return end
        self._T.serial=(self._T.serial or 0)+1
        local node=_SpawnService:SpawnByEntity(template,"NativeDamage"..tostring(self._T.serial),Vector3.zero,layer,false)
        if not isvalid(node) then return end
        node.Enable=false
        node.UITransformComponent.anchoredPosition=_CarnivalActorPresentation:ProjectAnchor(binding,target,position)
        local width=0
        for _,id in ipairs(glyphs) do local sprite=entry.sprites[id] if sprite~=nil then width=width+sprite.width-3 end end
        local cursor=-width/2
        if critical and groups[10]~=nil then self:AddGlyph(node,groups[10][1],entry,cursor-9,0) end
        for _,id in ipairs(glyphs) do
            local sprite=entry.sprites[id]
            if sprite~=nil then
                self:AddGlyph(node,id,entry,cursor+sprite.pivot.x,0)
                cursor=cursor+sprite.width-3
            end
        end
        node.Enable=false
        table.insert(self._T.lines,{node=node,target=target,origin=binding.origin,position=position,scale=scale,stamp=stamp,rate=rate,alpha=alpha,publishAt=_UtilLogic.ElapsedSeconds+0.001})
        if _CarnivalActorPresentation._T.verifyEffects then log("[VRF] Carnival damage line value="..tostring(value).." critical="..tostring(critical).." skin="..skin) end
    end

    @ExecSpace("ClientOnly")
    method void AddGlyph(Entity line, string id, table entry, number x, number y)
        if entry.sprites[id]==nil then return end
        local node=_SpawnService:SpawnByEntity(_CarnivalUI:UI("Lobby/Scene/TerrainTemplate"),"Glyph",Vector3.zero,line,false)
        node.Enable=true
        local sprite=node.SpriteGUIRendererComponent
        sprite.ImageRUID=DataRef(id) sprite.Color=Color.white sprite.Type=ImageType.Simple
        sprite.PreserveSprite=PreserveSpriteType.NativeSize sprite.RaycastTarget=false
        node.UITransformComponent.anchoredPosition=Vector2(x,y)
        node.UITransformComponent.UIScale=Vector3.one
    end

    @ExecSpace("ClientOnly")
    method void DrawFrame()
        local now=_UtilLogic.ElapsedSeconds
        local layer=_CarnivalUI:UI("Lobby/Scene/DamageLayer")
        if isvalid(layer) then
            local last=layer.Parent.Children.Count-1
            if _UILogic:GetSiblingIndex(layer.UITransformComponent)~=last then _UILogic:SetSiblingIndex(layer.UITransformComponent,last) end
        end
        for i=#(self._T.lines or {}),1,-1 do
            local line=self._T.lines[i]
            local age=(now-line.stamp)*line.rate
            if age>=1.2 or not isvalid(line.node) or not _CarnivalUI.opened then self:RemoveLine(i)
            elseif age>=0 then
                local ppu=_CarnivalView._T.scale or 100
                local point=line.position local origin=line.origin
                line.node.UITransformComponent.anchoredPosition=_CarnivalView:Project(point.x-origin.x,point.y-origin.y+age*0.4)
                local pop=1+0.15*math.max(0,1-age/0.12)
                line.node.UITransformComponent.UIScale=Vector3(ppu/100*line.scale.x*pop,ppu/100*line.scale.y*pop,1)
                line.node.CanvasGroupComponent.GroupAlpha=line.alpha*math.min(1,math.max(0,(1.2-age)/0.4))
                local visible=not _CarnivalUI.minimized and now>=line.publishAt
                if line.node.Enable~=visible then line.node.Enable=visible end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RemoveLine(integer index)
        local line=table.remove(self._T.lines,index)
        if line~=nil and isvalid(line.node) then _EntityService:Destroy(line.node) end
        self._T.released=(self._T.released or 0)+1
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for i=#(self._T.lines or {}),1,-1 do self:RemoveLine(i) end
        self._T.lines={} self._T.skins={}
    end
    @ExecSpace("Multicast")
    method void Broadcast(Entity target, string skin, number delay, table packet, string tweenName, Vector2 offset, Vector2 scale, number rate, number alpha, string lightingName)
        if not self:IsClient() then return end
        local texts={DamageSkinTextType.Miss,DamageSkinTextType.Guard,DamageSkinTextType.Resist,DamageSkinTextType.Shot,DamageSkinTextType.Counter}
        local damages={} local criticals={}
        for i,line in ipairs(packet) do
            damages[i]=line.text>0 and texts[line.text] or line.damage
            criticals[i]=line.critical
        end
        self:Play(target,skin,delay,damages,DamageSkinTweenType.CastFrom(tweenName),criticals,offset,scale,rate,alpha,LitMode.CastFrom(lightingName))
    end

    @ExecSpace("ClientOnly")
    method void EnsureUI()
        -- Also supports UI roots restored from an older cached instance during login/map changes.
        local scene=_CarnivalUI:UI("Lobby/Scene")
        local sprite=_CarnivalUI:UI("Lobby/Scene/TerrainTemplate")
        if not isvalid(scene) or not isvalid(sprite) then return end
        for _,name in ipairs({"DamageLayer","DamageLineTemplate"}) do
            local node=scene:GetChildByName(name)
            if not isvalid(node) then
                node=_SpawnService:SpawnByEntity(sprite,name,Vector3.zero,scene,false)
                node:RemoveComponent("SpriteGUIRendererComponent")
                if name=="DamageLineTemplate" then
                    node:AddComponent("CanvasGroupComponent")
                    node.CanvasGroupComponent.Interactable=false node.CanvasGroupComponent.BlocksRaycasts=false
                end
                node.Enable=name=="DamageLayer"
            end
        end
    end

end
