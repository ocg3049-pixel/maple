@Logic
script CarnivalDamageSkin extends Logic
    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.lines={} self._T.skins={} self._T.serial=0
        for skin,_ in pairs(self:Catalog()) do self:Prepare(skin,function(entry) end) end
        log("[VRF] Carnival damage skin adapter ready")
    end

    @ExecSpace("ClientOnly")
    method table Catalog()
        -- These are the original sprites embedded in the game's six native damage-skin resources.
        -- PreloadAsync loads their atlas; no replacement font or re-drawn digits are used.
        if self._T.catalog~=nil then return self._T.catalog end
        self._T.catalog={
            ["3271c3e79bf04ecba9a107d55495970d"]={
                [1]={"c5e87d2d275c4ba38a8944b21ba69673","d77434f8637d43b0982e6523d80cf9da","7de93510f6f645d0b17e2be7f43992dd","d3fdf258a9a84bb69b85f32716666f3f","fbb06a63e4cd4d4695b945ba6a3720e4","348b646183d24d8fb54d098d28650cf3","ab6c8b11130345adade6f6437fddd85a","40c14d4268724e23b8e9b1b5b0e6d503","2bf5676b528546ecaa8e5185a88d58c4","31217e1037874aa1a7df7d7b61397769"},
