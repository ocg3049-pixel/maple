@Logic
script CarnivalSkills extends Logic
    @ExecSpace("ClientOnly")
    method table Definition(string name)
        -- The balance functions remain owned by SkillManager; no second damage curve is maintained here.
        if not _SkillManager:IsSkillUsableByInvestment(name) or _SkillManager:IsPassiveSkillName(name) then return nil end
        local lv=math.max(1,_SkillManager:GetHeroSkillLevelByName(name))
        local mult=_CharInfoManager:GetAttackSpeedMultiplier()
        local d={name=name,level=lv,cost=_SkillManager:GetSkillMpCost(name),kind="attack",hits=1,targets=1,range=2,height=1,cooldown=0.75*mult,lock=0.75*mult,delay=0.25*mult,action="swingO1",rate=1/math.max(0.1,mult)}
        if name=="파워스트라이크" then d.min=_SkillManager:GetPowerStrikeMinPercent(lv)/100 d.max=_SkillManager:GetPowerStrikeMaxPercent(lv)/100 d.hits=1 d.targets=1 d.range=1.65 d.action="swingO1" end
        if name=="슬래시블러스트" then d.min=_SkillManager:GetSlashBlastMinPercent(lv)/100 d.max=_SkillManager:GetSlashBlastMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=2 d.action="swingO1" end
        if name=="홀리 에로우" then d.min=_SkillManager:GetHolyArrowMinPercent(lv)/100 d.max=_SkillManager:GetHolyArrowMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=5.04 d.action="shoot1" end
        if name=="엔젤레이" then d.min=_SkillManager:GetAngelRayMinPercent(lv)/100 d.max=_SkillManager:GetAngelRayMaxPercent(lv)/100 d.hits=1 d.targets=10 d.range=6.3 d.action="shoot1" end
        if name=="매직 미사일" then d.min=_SkillManager:GetMagicMissileMinPercent(lv)/100 d.max=_SkillManager:GetMagicMissileMaxPercent(lv)/100 d.hits=1 d.targets=20 d.range=8 d.action="swingO1" end
        if name=="아이언 에로우" then d.min=_SkillManager:GetIronArrowMinPercent(lv)/100 d.max=_SkillManager:GetIronArrowMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="스트레이프" then d.min=_SkillManager:GetStrafeMinPercent(lv)/100 d.max=_SkillManager:GetStrafeMaxPercent(lv)/100 d.hits=4 d.targets=1 d.range=6 d.action="shoot1" end
        if name=="아이스 샷" then d.min=_SkillManager:GetIceShotMinPercent(lv)/100 d.max=_SkillManager:GetIceShotMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="파이어 샷" then d.min=_SkillManager:GetFireShotMinPercent(lv)/100 d.max=_SkillManager:GetFireShotMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="에로우 봄" then d.min=_SkillManager:GetArrowBombMinPercent(lv)/100 d.max=_SkillManager:GetArrowBombMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="썬더볼트" then d.min=_SkillManager:GetThunderboltMinPercent(lv)/100 d.max=_SkillManager:GetThunderboltMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="콜드빔" then d.min=_SkillManager:GetColdBeamMinPercent(lv)/100 d.max=_SkillManager:GetColdBeamMaxPercent(lv)/100 d.hits=1 d.targets=1 d.range=6 d.action="swingO1" end
        if name=="파이어에로우" then d.min=_SkillManager:GetFireArrowMinPercent(lv)/100 d.max=_SkillManager:GetFireArrowMaxPercent(lv)/100 d.hits=1 d.targets=1 d.range=6 d.action="swingO1" end
        if name=="트리플 스로우" then d.min=_SkillManager:GetTripleThrowMinPercent(lv)/100 d.max=_SkillManager:GetTripleThrowMaxPercent(lv)/100 d.hits=3 d.targets=1 d.range=6 d.action="shoot1" end
        if name=="쿼드러플 스로우" then d.min=_SkillManager:GetQuadThrowMinPercent(lv)/100 d.max=_SkillManager:GetQuadThrowMaxPercent(lv)/100 d.hits=4 d.targets=1 d.range=6 d.action="shoot1" end
        if name=="어벤져" then d.min=_SkillManager:GetAvengerMinPercent(lv)/100 d.max=_SkillManager:GetAvengerMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=6 d.action="swingO1" end
        if name=="새비지블로우" then d.min=_SkillManager:GetSavageBlowMinPercent(lv)/100 d.max=_SkillManager:GetSavageBlowMaxPercent(lv)/100 d.hits=6 d.targets=1 d.range=1.8 d.action="swingO1" end
        if name=="샤이닝 레이" then d.min=_SkillManager:GetShiningRayMinPercent(lv)/100 d.max=_SkillManager:GetShiningRayMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="아이스 스트라이크" then d.min=_SkillManager:GetIceStrikeMinPercent(lv)/100 d.max=_SkillManager:GetIceStrikeMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="제네시스" then d.min=_SkillManager:GetGenesisMinPercent(lv)/100 d.max=_SkillManager:GetGenesisMaxPercent(lv)/100 d.hits=1 d.targets=36 d.range=16 d.action="swingO1" end
        if name=="블리자드" then d.min=_SkillManager:GetBlizzardMinPercent(lv)/100 d.max=_SkillManager:GetBlizzardMaxPercent(lv)/100 d.hits=1 d.targets=36 d.range=16 d.action="swingO1" end
        if name=="메테오" then d.min=_SkillManager:GetMeteorMinPercent(lv)/100 d.max=_SkillManager:GetMeteorMaxPercent(lv)/100 d.hits=1 d.targets=36 d.range=16 d.action="swingO1" end
        if name=="체인라이트닝" then d.min=_SkillManager:GetChainLightningMinPercent(lv)/100 d.max=_SkillManager:GetChainLightningMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=6 d.action="swingO1" end
        if name=="불꽃 파도" then d.min=_SkillManager:GetFireWaveMinPercent(lv)/100 d.max=_SkillManager:GetFireWaveMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="차지 블로우" then d.min=_SkillManager:GetChargeBlowMinPercent(lv)/100 d.max=_SkillManager:GetChargeBlowMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=2 d.action="swingO1" end
        if name=="패닉" then d.min=_SkillManager:GetPanicMinPercent(lv)/100 d.max=_SkillManager:GetPanicMaxPercent(lv)/100 d.hits=1 d.targets=1 d.range=2 d.action="swingO1" end
        if name=="코마" then d.min=_SkillManager:GetComaMinPercent(lv)/100 d.max=_SkillManager:GetComaMaxPercent(lv)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="홀리 에로우" then d.delay=0.5*mult d.speed=10 d.sprite="d8275b5454a84af580d7dc865ae7ada0" d.airBlock=true end
        if name=="매직 미사일" then d.hits=_SkillManager:GetMagicMissileProjectileCount(_CharInfoManager:GetDisplayLevel()) d.cooldown=_SkillManager:ApplyCooldownReduction(_SkillManager:GetMagicMissileCooldown()) d.lock=0.6*mult d.delay=0.85 d.homing=true d.sprite="cd7845e4574548fab1279593ed0a62a8" d.airBlock=true end
        if name=="텔레포트" then d.kind="teleport" d.cooldown=_SkillManager:ApplyCooldownReduction(0.54) d.lock=0 end
        if name=="더블 점프" or name=="플래시 점프" then d.kind="airjump" d.lock=0 d.cooldown=name=="더블 점프" and _SkillManager:ApplyCooldownReduction(5) or 0 d.force=name=="플래시 점프" and _SkillManager:GetFlashJumpForceScale(lv) or 1 end
        if name=="힐" then d.kind="heal" d.heal=_SkillManager:GetHealPercent(lv) end
        if name=="HP 회복" or name=="MP 회복" then d.kind="recovery" d.lock=0.5 d.cooldown=3 d.action="stand1" end
        if name=="용사 소환" or name=="궁수 소환" or name=="도적 소환" then
            d.kind="summon" d.cooldown=0.5 d.duration=300 d.lock=0
            local level=_CharInfoManager:GetDisplayLevel()
            local summonLevel=math.max(1,math.floor(level*_SkillManager:GetHeroSummonLevelPercent(lv)/100))
            d.summonLevel=summonLevel d.powerRatio=_CharInfoManager:GetEquipCPForLevel(summonLevel)/math.max(1,_CharInfoManager:GetEquipCPForLevel(level))
        end
        if name=="제네시스" then d.cooldown=_SkillManager:ApplyCooldownReduction(_SkillManager:GetGenesisCooldown(lv)) d.height=8 end
        if name=="블리자드" then d.cooldown=_SkillManager:ApplyCooldownReduction(_SkillManager:GetBlizzardCooldown(lv)) d.height=8 end
        if name=="메테오" then d.cooldown=_SkillManager:ApplyCooldownReduction(_SkillManager:GetMeteorCooldown(lv)) d.height=8 end
        if d.kind=="attack" and d.min==nil then return nil end
        return d
    end

    @ExecSpace("ClientOnly")
    method table Actor()
        -- Keep preview state and the latest server actor separate from the world player's state.
        if _CarnivalUI.state.state=="active" then
            local p=_UserService.LocalPlayer
            for _,a in ipairs((_CarnivalUI.state.scene or {}).actors or {}) do if a.uid==p.PlayerComponent.UserId then return a end end
            return nil
        end
        if _CarnivalReplica:InLobby() then
            local p=_CarnivalReplica._T.client
            return p~=nil and p.lobbyScene~=nil and p.lobbyScene.actors[1] or nil
        end
        return _CarnivalView._T.lobby
    end

    @ExecSpace("ClientOnly")
    method void Press(string key)
        -- Focused manual input uses the same cast path as Carnival automatic skills.
        self:TryCast(key,false,0)
    end

    @ExecSpace("ClientOnly")
    method boolean TryCast(string key, boolean automatic, integer targetSlot)
        -- Manual and automatic requests share MP, cooldown and server validation without borrowing world input.
        if not automatic and not _CarnivalView:CanInput() then return false end
        if automatic and (_CarnivalUI.state.state~="active" or not _CarnivalView.autoOn) then return false end
        local slot=_SkillManager:GetSkillOnKey(key)
        if slot==nil or slot.name=="" then return false end
        if _RecoveryPotionManager:IsQuickslotPotion(slot.name) then
            if automatic then return false end
            _RecoveryPotionManager:UseQuickslot(slot.name,slot.ruid) return true
        end
        local lobby=_CarnivalReplica:InLobby()
        if lobby and _SkillManager:SupportsActorSkill(slot.name) then _CarnivalReplica:PressSkill(key) return true end
        if _CarnivalUI.state.state=="active" and _SkillManager:SupportsActorSkill(slot.name) then
            local a=self:Actor()
            if a==nil or a.dead or (automatic and (not a.autoMode or a.locked)) then return false end
            return _CarnivalReplica:CastBattle(key,automatic,targetSlot)
        end
        local d=self:Definition(slot.name)
        if d==nil then return false end
        local a=self:Actor() if a==nil or a.dead then return false end
        local now=_UtilLogic.ElapsedSeconds
        self._T.cooldowns=self._T.cooldowns or {}
        if now<(self._T.cooldowns[d.name] or 0) then return false end
        if d.lock>0 and now<(self._T.lockUntil or 0) then return false end
        if d.airBlock and not a.ground then return false end
        if d.kind=="airjump" and (a.ground or a.airJumpUsed) then return false end
        local dx=a.face or 1 local dy=0
        local autoTarget=nil
        if automatic then
            if not a.autoMode or a.locked or now<(_CarnivalView._T.manualUntil or 0) then return false end
            for _,m in ipairs((_CarnivalUI.state.scene or {}).monsters or {}) do if m.slot==targetSlot and _CarnivalBattle:LivingTarget(m) then autoTarget=m break end end
            if autoTarget==nil then return false end
            if d.kind=="attack" and (math.abs(autoTarget.x-a.x)>d.range or math.abs(autoTarget.y-a.y)>d.height) then return false end
            dx=autoTarget.x>=a.x and 1 or -1
            d.autoTarget=targetSlot d.automatic=true
        end
        if not automatic and _CarnivalView:Pressed(KeyboardKey.LeftArrow) then dx=-1 elseif not automatic and _CarnivalView:Pressed(KeyboardKey.RightArrow) then dx=1 end
        if not automatic and _CarnivalView:Pressed(KeyboardKey.UpArrow) then dy=1 elseif not automatic and _CarnivalView:Pressed(KeyboardKey.DownArrow) then dy=-1 end
        if d.kind=="recovery" and (not a.ground or (a.recovery~=nil and a.recovery.kind==(d.name=="HP 회복" and "hp" or "mp"))) then return false end
        local battle=_CarnivalUI.state.state=="active"
        local platforms=battle and _CarnivalBattle:Platforms(_CarnivalUI.state.layout or 1) or {{l=-8,r=8,y=0}}
        if d.kind=="teleport" and self:Landing(a,platforms,dx,dy)==nil then return false end
        local mp=(lobby or battle) and _CarnivalReplica or _MpManager
        if not mp:TryConsumeMp(d.cost) then return false end
        self._T.cooldowns[d.name]=now+d.cooldown
        if d.lock>0 then self._T.lockUntil=now+d.lock end
        if battle or lobby then
            self._T.sequence=(self._T.sequence or 0)+1
            self._T.pending=self._T.pending or {} self._T.pending[self._T.sequence]={cost=d.cost,name=d.name,lobby=lobby,battle=battle and _CarnivalUI.state.id or nil,generation=lobby and _CarnivalReplica._T.client.generation or 0}
            if lobby then _CarnivalReplica:RequestLobbySkill(_CarnivalReplica._T.client.generation,d.name,dx,dy,self._T.sequence)
            else _CarnivalManager:RequestSkill(_CarnivalUI.state.id,d,dx,dy,self._T.sequence) end
        else
            self:Apply(a,{platforms=platforms,monsters={}},d,dx,dy,now)
            log("[VRF] Carnival preview skill="..d.name.." cost="..tostring(d.cost))
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method void Receipt(integer sequence, boolean accepted)
        -- Rejected requests refund their own cost once; a replay cannot refund twice.
        local pending=(self._T.pending or {})[sequence]
        if pending==nil then return end
        self._T.pending[sequence]=nil
        if not accepted then
            if pending.lobby then
                local p=_CarnivalReplica._T.client
                if p==nil or p.battle~=nil or p.generation~=pending.generation then return end
                _CarnivalReplica:RestoreMp(pending.cost)
            elseif pending.battle~=nil then
                local p=_CarnivalReplica._T.client
                if p==nil or p.battle~=pending.battle then return end
                _CarnivalReplica:RestoreMp(pending.cost)
            else _MpManager:RestoreMp(pending.cost) end
            self._T.cooldowns[pending.name]=nil self._T.lockUntil=0
        end
    end

    method table Landing(table a, table platforms, number dx, number dy)
        -- Match native teleport's 2.31-unit range, 0.6 vertical tolerance and foothold requirement.
        local best=nil local distance=-1
        if dy~=0 then
            for _,f in ipairs(platforms) do
                local h=(f.y-a.y)*dy
                if a.x>=f.l+0.15 and a.x<=f.r-0.15 and h>0.15 and h<=2.31 and h>distance then best={x=a.x,y=f.y+0.05} distance=h end
            end
        else
            local x=math.max(-7.7,math.min(7.7,a.x+dx*2.31))
            local nearest=0.601
            for _,f in ipairs(platforms) do
                local h=math.abs(f.y-a.y)
                if x>=f.l+0.15 and x<=f.r-0.15 and h<nearest then best={x=x,y=f.y+0.05} nearest=h end
            end
            if best==nil then
                for _,f in ipairs(platforms) do if math.abs(f.y-a.y)<0.15 and a.x>=f.l and a.x<=f.r then best={x=dx>0 and f.r-0.15 or f.l+0.15,y=f.y+0.05} break end end
            end
        end
        if best~=nil and math.abs(best.x-a.x)<0.1 and math.abs(best.y-a.y)<0.15 then return nil end
        return best
    end

    method boolean Apply(table a, table room, table d, number dx, number dy, number now)
        -- All gameplay mutations below target the independent actor/room.
        if d.kind=="teleport" then
            local landing=self:Landing(a,room.platforms,dx,dy) if landing==nil then return false end
            _CarnivalPhysics:Warp(a,landing.x,landing.y) if dy==0 then a.face=dx end
        elseif d.kind=="airjump" then
            if a.ground or a.airJumpUsed then return false end
            a.airJumpUsed=true
            if a.physics~=nil and isvalid(a.physics.body) then local rb=a.physics.body.RigidbodyComponent rb:PositionReset() rb:SetForce(Vector2(dx*4.5*d.force,4.04*d.force)) end
        elseif d.kind=="recovery" then
            a.recovery={kind=d.name=="HP 회복" and "hp" or "mp",ready=now+0.5,x=a.x,y=a.y}
        elseif d.kind=="heal" then a.hp=math.min(a.maxHp,a.hp+a.maxHp*d.heal/100*_CarnivalRules:TuningOptions().healing)
        elseif d.kind=="summon" then
            a.summons=a.summons or {}
            local pa=a.physics~=nil and isvalid(a.physics.body) and a.physics.body:GetComponent("PlayerAttack") or nil
            if not isvalid(pa) then return false end
            local class=d.name=="궁수 소환" and "archer" or (d.name=="도적 소환" and "thief" or "warrior")
            pa:SummonHeroClass(d.summonLevel,100,math.max(1,math.floor((a.power or 1)*d.powerRatio)),class)
            local entity=(pa._T.heroSummonEntities or {})[class]
            if not isvalid(entity) then return false end
            a.summons[d.name]={name=d.name,native=true,entity=entity,untilTime=now+d.duration,level=d.summonLevel}
            log("[VRF] Carnival original summon cast="..d.name.." native="..entity.Id)
        elseif d.kind=="attack" then
            a.face=dx
            a.effects=a.effects or {} a.effectSeq=(a.effectSeq or 0)+1
            local targets={}
            for _,m in ipairs(room.monsters) do
                if not m.dead and (m.x-a.x)*dx>=-0.3 and math.abs(m.x-a.x)<=d.range and math.abs(m.y-a.y)<=d.height then table.insert(targets,m) end
            end
            table.sort(targets,function(l,r) return math.abs(l.x-a.x)<math.abs(r.x-a.x) end)
            local predicted={}
            for i,m in ipairs(targets) do predicted[i]=m.hp end
            for i=1,d.hits do
                local target=nil
                if d.homing then
                    for j,m in ipairs(targets) do if predicted[j]>0 then target=m predicted[j]=predicted[j]-(a.power or 1)*d.min break end end
                    if target==nil and #targets>0 then target=targets[(i-1)%#targets+1] end
                end
                local x=a.x local y=a.y+0.65
                if d.homing then x=x-dx*(0.5+(i%3)*0.3) y=y+(i%4)*0.2 end
                table.insert(a.effects,{id=a.effectSeq*100+i,name=d.name,x=x,y=y,startX=x,face=dx,at=now+d.delay+(i-1)*0.04,untilTime=now+d.delay+3,range=d.range,height=d.height,speed=d.speed or 10,sprite=d.sprite or "",homing=d.homing==true,target=target,targetLife=target and target.life or 0,targets=d.targets,hit={},min=d.min,max=d.max,hitCount=0})
            end
        else return false end
        if d.kind~="recovery" then a.recovery=nil end
        a.skillName=d.name a.skillAction=d.action a.skillRate=d.rate or 1 a.skillUntil=now+math.max(0.3,d.lock) a.skillLock=now+d.lock
        log("[VRF] Carnival cast="..d.name.." kind="..d.kind)
        return true
    end

    @ExecSpace("ServerOnly")
    method void Damage(table r, table p, table m, number minimum, number maximum, number ratio)
        -- Use current server combat power and the normal level/critical damage rules.
        if m.dead then return end
        local a=p.actor
        local damage=a.power*(minimum+_UtilLogic:RandomDouble()*math.max(0,maximum-minimum))*ratio
        local critical=_UtilLogic:RandomDouble()*100<a.crit
        if critical then damage=damage*a.critMult end
        damage=math.max(0,math.floor(damage*_RegionTierLogic:GetLevelDamageRate(m.level,p.liveLevel or p.level)))
        m.hp=math.max(0,m.hp-damage) m.hit=damage m.hitSeq=m.hitSeq+1
        local native=a.nativeId~=nil and _EntityService:GetEntity(a.nativeId) or nil
        if isvalid(m.entity) and isvalid(native) then
            local pa=native:GetComponent("PlayerAttack")
            if isvalid(pa) then pa:ShowResolvedDamage(m.entity,damage,critical,pa:GetHitDamageSkinId()) end
        end
        if m.hp<=0 then _CarnivalBattle:Kill(r,p.team,m) end
    end

    method void Advance(table a, table room, number now, number delta, table r, table p)
        -- Effects persist independently of keyboard focus; server alone resolves monster hits.
        if a.recovery~=nil then
            if a.hp<=0 then a.recovery=nil
            elseif now<(a.recovery.settleUntil or 0) then a.recovery.x=a.x a.recovery.y=a.y
            elseif math.abs(a.x-a.recovery.x)>0.025 or math.abs(a.y-a.recovery.y)>0.025 or not a.ground then a.recovery=nil end
        end
        for i=#(a.effects or {}),1,-1 do
            local e=a.effects[i]
            if now>=e.at then
                local oldX=e.x
                if e.homing and e.target~=nil and not e.target.dead and e.target.life==e.targetLife then
                    local dx=e.target.x-e.x local dy=e.target.y+0.5-e.y local length=math.sqrt(dx*dx+dy*dy)
                    local step=math.min(length,e.speed*delta)
                    if length>0 then e.x=e.x+dx/length*step e.y=e.y+dy/length*step end
                    if length<0.5 and r~=nil then self:Damage(r,p,e.target,e.min,e.max,1) e.untilTime=now end
                else
                    e.x=e.x+e.face*e.speed*delta
                    if r~=nil and not e.homing then
                        for _,m in ipairs(room.monsters) do
                            if not m.dead and not e.hit[m.slot] and e.hitCount<e.targets and m.x>=math.min(oldX,e.x)-0.3 and m.x<=math.max(oldX,e.x)+0.3 and math.abs(m.y+0.5-e.y)<e.height then
                                e.hit[m.slot]=true e.hitCount=e.hitCount+1 self:Damage(r,p,m,e.min,e.max,1)
                            end
                        end
                    end
                    if math.abs(e.x-e.startX)>=e.range then e.untilTime=now end
                end
            end
            if now>=e.untilTime or e.hitCount>=e.targets then table.remove(a.effects,i) end
        end
        for name,s in pairs(a.summons or {}) do
            if now>=s.untilTime or (s.native and not isvalid(s.entity)) then a.summons[name]=nil
            elseif not s.native then
                s.x=s.x+(a.x-a.face-s.x)*math.min(1,delta*3) s.y=a.y s.face=a.face
                s.action=math.abs(s.x-a.x+a.face)>0.2 and "walk1" or "stand1"
                if r~=nil and now>=s.attackAt then
                    local target=nil local distance=6
                    for _,m in ipairs(room.monsters) do local d=math.abs(m.x-s.x) if not m.dead and math.abs(m.y-s.y)<1 and d<distance then target=m distance=d end end
                    if target~=nil then
                        s.face=target.x>=s.x and 1 or -1 s.attackAt=now+0.85 s.action="shoot1"
                        local hits=s.name=="도적 소환" and (s.level>=120 and 4 or (s.level>=70 and 3 or 2)) or 2
                        for i=1,hits do self:Damage(r,p,target,0.5/3,2.5/3,s.ratio) end
                    end
                end
            end
        end
    end

    method table Visuals(table a)
        -- Never serialize native entity references or monster tables in a client snapshot.
        local effects={} local summons={}
        for _,e in ipairs(a.effects or {}) do table.insert(effects,{id=e.id,x=e.x,y=e.y,face=e.face,sprite=e.sprite,name=e.name}) end
        for _,s in pairs(a.summons or {}) do table.insert(summons,{name=s.name,native=s.native==true,x=s.x,y=s.y,face=s.face,action=s.action,level=s.level}) end
        return {effects=effects,summons=summons}
    end
    @ExecSpace("ServerOnly")
    method table ServerDefinition(table p, table request)
        -- Resolve investment from the server's saved character snapshot, never from the cast payload.
        local sv=_CharacterPersistence._T.sv[p.uid]
        if sv==nil then return nil end
        local levels={}
        for _,line in ipairs(_CharacterPersistence:SplitLines(sv.saves[sv.activeId] or "")) do
            local name,value=string.match(line,"^SP\t([^\t]+)\t(%d+)$")
            if name~=nil then levels[name]=tonumber(value) end
        end
        local name=request.name if type(name)~="string" then return nil end
        local lv=levels[name] or 0 if lv<1 then return nil end
        local pa=p.player:GetComponent("script.PlayerAttack")
        local mult=isvalid(pa) and math.max(0.1,math.min(3,pa._T.lastAtkMultiplier or 1)) or 1
        local d={name=name,level=lv,kind="attack",hits=1,targets=1,range=2,height=1,cooldown=0.75*mult,lock=0.75*mult,delay=0.25*mult,action="swingO1",rate=1/mult}
        if name=="파워스트라이크" then d.min=_CarnivalSkillBalance:GetPowerStrikeMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetPowerStrikeMaxPercent(lv,levels)/100 d.hits=1 d.targets=1 d.range=1.65 d.action="swingO1" end
        if name=="슬래시블러스트" then d.min=_CarnivalSkillBalance:GetSlashBlastMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetSlashBlastMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=2 d.action="swingO1" end
        if name=="홀리 에로우" then d.min=_CarnivalSkillBalance:GetHolyArrowMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetHolyArrowMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=5.04 d.action="shoot1" end
        if name=="엔젤레이" then d.min=_CarnivalSkillBalance:GetAngelRayMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetAngelRayMaxPercent(lv,levels)/100 d.hits=1 d.targets=10 d.range=6.3 d.action="shoot1" end
        if name=="매직 미사일" then d.min=_CarnivalSkillBalance:GetMagicMissileMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetMagicMissileMaxPercent(lv,levels)/100 d.hits=1 d.targets=20 d.range=8 d.action="swingO1" end
        if name=="아이언 에로우" then d.min=_CarnivalSkillBalance:GetIronArrowMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetIronArrowMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="스트레이프" then d.min=_CarnivalSkillBalance:GetStrafeMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetStrafeMaxPercent(lv,levels)/100 d.hits=4 d.targets=1 d.range=6 d.action="shoot1" end
        if name=="아이스 샷" then d.min=_CarnivalSkillBalance:GetIceShotMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetIceShotMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="파이어 샷" then d.min=_CarnivalSkillBalance:GetFireShotMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetFireShotMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="에로우 봄" then d.min=_CarnivalSkillBalance:GetArrowBombMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetArrowBombMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="썬더볼트" then d.min=_CarnivalSkillBalance:GetThunderboltMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetThunderboltMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="콜드빔" then d.min=_CarnivalSkillBalance:GetColdBeamMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetColdBeamMaxPercent(lv,levels)/100 d.hits=1 d.targets=1 d.range=6 d.action="swingO1" end
        if name=="파이어에로우" then d.min=_CarnivalSkillBalance:GetFireArrowMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetFireArrowMaxPercent(lv,levels)/100 d.hits=1 d.targets=1 d.range=6 d.action="swingO1" end
        if name=="트리플 스로우" then d.min=_CarnivalSkillBalance:GetTripleThrowMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetTripleThrowMaxPercent(lv,levels)/100 d.hits=3 d.targets=1 d.range=6 d.action="shoot1" end
        if name=="쿼드러플 스로우" then d.min=_CarnivalSkillBalance:GetQuadThrowMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetQuadThrowMaxPercent(lv,levels)/100 d.hits=4 d.targets=1 d.range=6 d.action="shoot1" end
        if name=="어벤져" then d.min=_CarnivalSkillBalance:GetAvengerMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetAvengerMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=6 d.action="swingO1" end
        if name=="새비지블로우" then d.min=_CarnivalSkillBalance:GetSavageBlowMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetSavageBlowMaxPercent(lv,levels)/100 d.hits=6 d.targets=1 d.range=1.8 d.action="swingO1" end
        if name=="샤이닝 레이" then d.min=_CarnivalSkillBalance:GetShiningRayMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetShiningRayMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="아이스 스트라이크" then d.min=_CarnivalSkillBalance:GetIceStrikeMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetIceStrikeMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="제네시스" then d.min=_CarnivalSkillBalance:GetGenesisMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetGenesisMaxPercent(lv,levels)/100 d.hits=1 d.targets=36 d.range=16 d.action="swingO1" end
        if name=="블리자드" then d.min=_CarnivalSkillBalance:GetBlizzardMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetBlizzardMaxPercent(lv,levels)/100 d.hits=1 d.targets=36 d.range=16 d.action="swingO1" end
        if name=="메테오" then d.min=_CarnivalSkillBalance:GetMeteorMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetMeteorMaxPercent(lv,levels)/100 d.hits=1 d.targets=36 d.range=16 d.action="swingO1" end
        if name=="체인라이트닝" then d.min=_CarnivalSkillBalance:GetChainLightningMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetChainLightningMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=6 d.action="swingO1" end
        if name=="불꽃 파도" then d.min=_CarnivalSkillBalance:GetFireWaveMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetFireWaveMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=6 d.action="shoot1" end
        if name=="차지 블로우" then d.min=_CarnivalSkillBalance:GetChargeBlowMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetChargeBlowMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=2 d.action="swingO1" end
        if name=="패닉" then d.min=_CarnivalSkillBalance:GetPanicMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetPanicMaxPercent(lv,levels)/100 d.hits=1 d.targets=1 d.range=2 d.action="swingO1" end
        if name=="코마" then d.min=_CarnivalSkillBalance:GetComaMinPercent(lv,levels)/100 d.max=_CarnivalSkillBalance:GetComaMaxPercent(lv,levels)/100 d.hits=1 d.targets=6 d.range=3 d.action="swingO1" end
        if name=="홀리 에로우" then d.delay=0.5*mult d.speed=10 d.sprite="d8275b5454a84af580d7dc865ae7ada0" d.airBlock=true end
        if name=="매직 미사일" then d.hits=math.min(20,math.max(1,1+math.floor(((p.liveLevel or p.level)-20)/10))) d.cooldown=5 d.lock=0.6*mult d.delay=0.85 d.homing=true d.sprite="cd7845e4574548fab1279593ed0a62a8" d.airBlock=true end
        if name=="텔레포트" then d.kind="teleport" d.cooldown=0.54 d.lock=0 end
        if name=="더블 점프" or name=="플래시 점프" then d.kind="airjump" d.lock=0 d.cooldown=name=="더블 점프" and 5 or 0 d.force=name=="플래시 점프" and _CarnivalSkillBalance:GetFlashJumpForceScale(lv,levels) or 1 end
        if name=="힐" then d.kind="heal" d.heal=_CarnivalSkillBalance:GetHealPercent(lv,levels) end
        if name=="HP 회복" or name=="MP 회복" then d.kind="recovery" d.lock=0.5 d.cooldown=3 d.action="stand1" end
        if name=="용사 소환" or name=="궁수 소환" or name=="도적 소환" then
            d.kind="summon" d.cooldown=0.5 d.duration=300 d.lock=0
            local level=math.max(1,p.liveLevel or p.level)
            d.summonLevel=math.max(1,math.floor(level*_CarnivalSkillBalance:GetHeroSummonLevelPercent(lv,levels)/100))
            local ownerCP=math.min(200,level)*7 local summonCP=math.min(200,d.summonLevel)*7
            d.powerRatio=(summonCP*summonCP)/(ownerCP*ownerCP)
        end
        if name=="제네시스" or name=="블리자드" or name=="메테오" then d.cooldown=_CarnivalSkillBalance:GetGenesisCooldown(lv,levels) d.height=8 end
        if d.kind=="attack" and d.min==nil then return nil end
        return d
    end

    @ExecSpace("ClientOnly")
    method number RecoveryMultiplier(string kind)
        local a=self:Actor()
        local rate=_CarnivalTactics:RecoveryRate(a)
        if a==nil or a.dead or a.hp<=0 or a.recovery==nil or a.recovery.kind~=kind then return rate end
        local now=(_CarnivalUI.state.state=="active" or _CarnivalReplica:InLobby()) and _UtilLogic.ServerElapsedSeconds or _UtilLogic.ElapsedSeconds
        return rate*_CarnivalRules:RecoveryUseMultiplier(kind,now>=a.recovery.ready and 5 or 1)
    end


    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Auto skills keep running while the window is unfocused or minimized, just like its server hunt.
        local state=_CarnivalUI.state local now=_UtilLogic.ElapsedSeconds
        if state.state~="active" or not _CarnivalView.autoOn or not _LoginFlow:IsInGame() then return end
        if now<(self._T.autoTickAt or 0) then return end
        self._T.autoTickAt=now+0.1
        self:AutoTick()
    end

    @ExecSpace("ClientOnly")
    method void AutoTick()
        -- Use native skill execution, replica resources and utility priorities before attacks.
        local a=self:Actor() local now=_UtilLogic.ElapsedSeconds
        for i,row in ipairs((_CarnivalUI.state.scene or {}).actors or {}) do if a~=nil and row.uid==a.uid then _CarnivalReplica:BindBattle(i,row) break end end
        local p=_CarnivalReplica._T.client
        if a==nil or a.dead or not a.autoMode or p==nil or not isvalid(p.actor) then return end
        if a.locked or now<(self._T.lockUntil or 0) or now<(_CarnivalView._T.manualUntil or 0) then return end
        for _,pending in pairs(self._T.pending or {}) do if pending~=nil then return end end
        if self:TryAutoRecovery(a,p) then return end
        local target=nil local monsters=(_CarnivalUI.state.scene or {}).monsters or {}
        for _,m in ipairs(monsters) do if m.slot==a.autoTarget and _CarnivalBattle:LivingTarget(m) then target=m break end end
        local slots=_MobileUIManager:IsMobile() and _MobileUIManager:ExportMobileSkills() or _SkillManager:ExportHotkeys()
        local candidates={} local desiredRange=math.max(1.05,(a.basicRange or 1.65)-0.4)
        for key,slot in pairs(slots) do
            local name=slot.name or ""
            if not _SkillManager:IsSkillUsableByInvestment(name) or _SkillManager:IsPassiveSkillName(name) then continue end
            if _CarnivalView:SlotCooldown(name)>0 or _CarnivalReplica:GetCurrentMp()<_SkillManager:GetSkillMpCost(name) then continue end
            if name=="슬래시블러스트" and a.hp<=_SkillManager:GetSlashBlastHpCost() then continue end
            local d=self:Definition(name) local role=_AutoHuntManager:GetSkillRole(name)
            local score=0 local buff=_CarnivalUI:BuffRemaining(name)
            local retry=((p.autoBuffRetry or {})[name] or 0)
            if role=="heal" and self:NeedsAutoHeal(a,p) then score=100000
            elseif role=="restoration" and a.hp<=a.maxHp*0.8 and buff<=1 then score=99000
            elseif (role=="buff" or role=="summon" or role=="dragonride" or role=="shadowclone" or role=="awakening") and buff<=1 and now>=retry then score=20000
            elseif role=="dragonblood" and a.hp>=a.maxHp*0.5 and buff<=1 and now>=retry then score=19000
            elseif role=="recoveryaura" and target~=nil then score=18000
            elseif target~=nil and role~="manual" and role~="mobility" and role~="teleport" and role~="dash" and role~="darksight" and role~="chargemode" then
                if role=="buff" or role=="summon" or role=="dragonride" or role=="shadowclone" or role=="dragonblood" or role=="awakening" then continue end
                local range=self:AutoAttackRange(name,d,p.actor) local height=d~=nil and d.height or 2.5
                desiredRange=math.max(desiredRange,math.min(7,range*0.9))
                if math.abs(target.x-a.x)<=range and math.abs(target.y-a.y)<=height then
                    local count=0
                    for _,m in ipairs(monsters) do if _CarnivalBattle:LivingTarget(m) and math.abs(m.x-a.x)<=range and math.abs(m.y-a.y)<=height then count=count+1 end end
                    score=d~=nil and (d.min or 1)+(d.max or 1) or 200
                    score=score*(d~=nil and d.hits or 1)*math.min(d~=nil and d.targets or 6,count)
                    if role=="drainshot" and a.hp<a.maxHp*0.7 then score=90000 end
                end
            end
            if score>0 and (_SkillManager:SupportsActorSkill(name) or d~=nil) then table.insert(candidates,{key=key,name=name,score=score,role=role}) end
        end
        if now>=(self._T.rangeAt or 0) then self._T.rangeAt=now+0.5 _CarnivalReplica:SetAutoRange(_CarnivalUI.state.id,desiredRange) end
        table.sort(candidates,function(l,r) if l.score==r.score then return l.key<r.key end return l.score>r.score end)
        if #candidates>0 and candidates[1].score<18000 then
            local pool={} local frontCount=0
            local face=target~=nil and (target.x>=a.x and 1 or -1) or a.face
            for _,m in ipairs(monsters) do
                local dx=(m.x-a.x)*face
                if _CarnivalBattle:LivingTarget(m) and dx>=0 and dx<=8 and math.abs(m.y-a.y)<=1 then frontCount=frontCount+1 end
            end
            for _,c in ipairs(candidates) do
                if c.name=="럭키세븐" or c.name=="트리플 스로우" or c.name=="쿼드러플 스로우" or c.name=="어벤져" then c.w=1 table.insert(pool,c) end
            end
            if #pool>0 then
                _AutoHuntManager:ApplyNightLordWeights(pool,frontCount)
                local total=0 for _,c in ipairs(pool) do total=total+c.w end
                local roll=_UtilLogic:RandomDouble()*total local chosen=pool[#pool]
                for _,c in ipairs(pool) do roll=roll-c.w if c.w>0 and roll<=0 then chosen=c break end end
                candidates={chosen}
            end
        end
        for _,candidate in ipairs(candidates) do
            if self:TryCast(candidate.key,true,target~=nil and target.slot or 0) then
                p.autoBuffRetry=p.autoBuffRetry or {}
                p.autoBuffRetry[candidate.name]=now+math.max(1,candidate.role=="summon" and _AutoHuntManager:GetSummonRecastInterval(candidate.name) or _AutoHuntManager:GetBuffPeriod(candidate.name))
                if Environment:IsMakerPlay() then log("[VRF] Carnival auto skill="..candidate.name.." role="..candidate.role.." target="..tostring(target~=nil and target.slot or 0)) end
                return
            end
        end
    end


    @ExecSpace("ClientOnly")
    method number AutoAttackRange(string name, table definition, Entity actor)
        -- Leave twenty percent of projectile acquisition/travel range unused before firing.
        if self._T.projectileRanges==nil then
            self._T.projectileRanges={
                ["더블샷"]=5.4,["에로우 블로우"]=5.4,["에로우 봄"]=5.4,
                ["아이언 에로우"]=5.04,["파이어에로우"]=5.04,["홀리 에로우"]=5.04,
                ["엔젤레이"]=9,["스트레이프"]=5,["아이스 샷"]=4.8,["파이어 샷"]=4.8,
                ["속사"]=6,["폭풍의 시"]=6,["어벤져"]=4.8,["피어싱"]=8,["스나이핑"]=8,
                ["매직 미사일"]=6,["달팽이 세마리"]=4,["아이스 데몬"]=9}
        end
        if name=="럭키세븐" or name=="트리플 스로우" or name=="쿼드러플 스로우" or name=="드레인 샷" then
            local attack=isvalid(actor) and actor:GetComponent("PlayerAttack") or nil
            return _ShurikenLibrary:GetSkillReach(isvalid(attack) and attack._T.awakeningActive==true).x*0.8
        end
        local reach=self._T.projectileRanges[name]
        return reach~=nil and reach*0.8 or (definition~=nil and definition.range or 7)
    end

    @ExecSpace("ClientOnly")
    method boolean NeedsAutoHeal(table a, table p)
        if a.hp<=a.maxHp*0.8 then return true end
        local now=_UtilLogic.ElapsedSeconds
        if now<(p.nextHealScan or 0) then return p.healNearby==true end
        p.nextHealScan=now+0.25 p.healNearby=false
        for _,ally in ipairs((_CarnivalUI.state.scene or {}).actors or {}) do
            if not ally.dead and ally.hp>0 and ally.hp<=ally.maxHp*0.8
                and math.abs(ally.x-a.x)<=3.2 and math.abs(ally.y-a.y)<=2.56 then p.healNearby=true return true end
        end
        local map=p.actor.CurrentMap local pos=p.actor.TransformComponent.WorldPosition
        for _,spec in ipairs({{"script.HeroSummon","HeroHp","HeroMaxHp"},{"script.HealerSummon","HealerHp","HealerMaxHp"},{"script.SummonDragon","DragonHp","DragonMaxHp"}}) do
            for _,summon in ipairs(map:GetChildComponentsByTypeName(spec[1],true)) do
                if isvalid(summon) and isvalid(summon.Entity) and summon.OwnerEntity==p.actor
                    and summon[spec[2]]>0 and summon[spec[2]]<=summon[spec[3]]*0.8 then
                    local target=summon.Entity.TransformComponent.WorldPosition
                    if math.abs(target.x-pos.x)<=3.2 and math.abs(target.y-pos.y)<=2.56 then p.healNearby=true return true end
                end
            end
        end
        return false
    end


    @ExecSpace("ClientOnly")
    method boolean TryAutoRecovery(table a, table p)
        local now=_UtilLogic.ElapsedSeconds
        local threat=false
        for _,m in ipairs((_CarnivalUI.state.scene or {}).monsters or {}) do
            if _CarnivalBattle:LivingTarget(m) and math.abs(m.x-a.x)<=4 and math.abs(m.y-a.y)<=2.5 then threat=true break end
        end
        local rest=p.autoRecovery
        if a.recovery~=nil then
            if rest==nil then rest={started=now,hp=a.hp} p.autoRecovery=rest end
            local ratio=a.recovery.kind=="hp" and a.hp/math.max(1,a.maxHp) or _CarnivalReplica:GetCurrentMp()/math.max(1,_CarnivalReplica:GetMaxMp())
            if threat or a.hp<rest.hp or ratio>=0.95 or now-rest.started>=8 then
                _CarnivalReplica:CancelActorRecovery() p.autoRecovery=nil p.nextAutoRecovery=now+1
                return false
            end
            rest.hp=a.hp return true
        end
        if p.recoveryPending then return true end
        p.autoRecovery=nil
        if threat or not a.ground or now<(p.nextAutoRecovery or 0) then return false end
        p.nextAutoRecovery=now+0.5
        local best=0 local kind=nil
        for _,candidate in ipairs({"hp","mp"}) do
            local ratio=candidate=="hp" and a.hp/math.max(1,a.maxHp) or _CarnivalReplica:GetCurrentMp()/math.max(1,_CarnivalReplica:GetMaxMp())
            local threshold=candidate=="hp" and 0.75 or 0.60
            local name=candidate=="hp" and "HP 회복" or "MP 회복"
            local rate=candidate=="hp" and _SkillManager:GetBeginnerHpRegenPct() or _SkillManager:GetBeginnerMpRegenPct()
            local wait=(1-ratio)*100/math.max(0.01,rate)
            local score=wait+(ratio<=0.3 and 1000 or 0)
            if ratio<=threshold and wait>2 and rate>0 and _SkillManager:GetHeroSkillLevelByName(name)>0
                and ((p.recoveryCooldowns or {})[candidate] or 0)<=_UtilLogic.ServerElapsedSeconds and score>best then kind=candidate best=score end
        end
        if kind==nil then return false end
        _CarnivalReplica:TryRecovery(kind)
        return p.recoveryPending==true
    end

end
