@Logic
script CarnivalRules extends Logic
    property integer InitialRating = 100
    property number RespawnSeconds = 10
    property number MinimumWait = 8
    property integer MaxSummons = 150
    property integer MonsterLimit = 150
    property integer BaseMonsters = 6

    method boolean IsArena(string name)
        -- Dynamic match maps and their templates never use field loot or field respawns.
        return string.sub(name or "",1,9)=="carnival_"
    end

    method integer Cost(integer level)
        -- Higher levels strictly increase the price of a permanent summon slot.
        return 20+math.max(1,level)*5
    end

    method integer KillPoints(integer level)
        -- Match currency is independent of persistent victory rating.
        return 5+math.max(1,math.floor(level/5))
    end

    method string Tier(integer points)
        -- Thresholds remain centralized for future balance changes.
        if points>=1500 then return "마스터" end
        if points>=900 then return "다이아몬드" end
        if points>=500 then return "플래티넘" end
        if points>=250 then return "골드" end
        if points>=100 then return "실버" end
        return "브론즈"
    end

    method boolean Compatible(table a, table b, number now)
        -- Queues never merge; both candidates must finish the initial balance wait.
        if a.mode~=b.mode or now-a.at<self.MinimumWait or now-b.at<self.MinimumWait then return false end
        local age=math.min(now-a.at,now-b.at)-self.MinimumWait
        return math.abs(a.rating-b.rating)<=75+age*4 and math.abs(a.level-b.level)<=math.min(60,5+age*0.3)
    end

    method table SoloTeams(table players)
        -- Deterministic tie breaks keep the highest and lowest rating on one team.
        local sorted={}
        for _,p in ipairs(players) do table.insert(sorted,p) end
        table.sort(sorted,function(a,b) if a.rating==b.rating then return a.uid<b.uid end return a.rating>b.rating end)
        return {{sorted[1],sorted[4]},{sorted[2],sorted[3]}}
    end

    method table Transfers(table winners, table losers)
        -- Winners take only available loser points; no rating is minted or made negative.
        local winLevel,loseLevel=0,0
        for _,p in ipairs(winners) do winLevel=winLevel+p.level end
        for _,p in ipairs(losers) do loseLevel=loseLevel+p.level end
        winLevel=winLevel/#winners loseLevel=loseLevel/#losers
        local each=math.max(5,math.min(40,math.floor(20+(loseLevel-winLevel)*0.5)))
        local deltas={} local pool=0
        for _,p in ipairs(losers) do local loss=math.min(p.rating,each) deltas[p.uid]=-loss pool=pool+loss end
        local share=math.floor(pool/#winners) local extra=pool%#winners
        for i,p in ipairs(winners) do deltas[p.uid]=share+(i<=extra and 1 or 0) end
        return deltas
    end
    method table CopyProfile(table source)
        source=source or {}
        local p={rating=math.max(0,math.floor(tonumber(source.rating) or self.InitialRating)),wins1=math.max(0,math.floor(tonumber(source.wins1) or 0)),losses1=math.max(0,math.floor(tonumber(source.losses1) or 0)),wins2=math.max(0,math.floor(tonumber(source.wins2) or 0)),losses2=math.max(0,math.floor(tonumber(source.losses2) or 0)),history={}}
        if type(source.history)=="table" then
            for _,h in ipairs(source.history) do
                if type(h)=="table" then table.insert(p.history,{match=tostring(h.match or ""),mode=tostring(h.mode or "duel"),won=h.won==true,delta=math.floor(tonumber(h.delta) or 0),at=tonumber(h.at) or 0}) end
                if #p.history>=10 then break end
            end
        end
        return p
    end


    method integer UpgradeCost(string kind, table upgrades)
        -- Match currency prices are shared by the UI and authoritative server.
        if kind=="heal" then return 30 end
        if kind=="clear" then return 200 end
        if kind=="recovery" or kind=="power" then return 50+25*(upgrades[kind] or 0) end
        return -1
    end

end
