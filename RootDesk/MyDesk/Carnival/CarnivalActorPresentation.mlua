        self._T.resourcesTotal=#resources self._T.resourcesLoaded=0
        local loadBatch
        loadBatch=function(first)
            if first>#resources then
                if Environment:IsMakerPlay() then log("[VRF] Carnival skill preload="..tostring(self._T.resourcesLoaded).."/"..tostring(self._T.resourcesTotal)) end
                return
            end
            local batch={}
            for i=first,math.min(first+31,#resources) do table.insert(batch,resources[i]) end
            _ResourceService:PreloadAsync(batch,function(results)
                for _,status in pairs(results) do
                    if status==PreloadResultStatus.Success then self._T.resourcesLoaded=self._T.resourcesLoaded+1 end
                end
                _TimerService:SetTimerOnce(function() loadBatch(first+32) end,0.01)
            end)
        end
        loadBatch(1)
    end


    @ExecSpace("ClientOnly")
    method integer PlayOwnedEffectAttached(Entity owner, string ruid, Entity anchor, Vector3 offset, number rotation, Vector3 scale, boolean loop, table options)
        -- Establish the source actor before a summon attaches a hit effect to a monster.
        local binding=self:BindingFor(owner)
        if binding~=nil and isvalid(anchor) and self:BindingFor(anchor)==nil then
            self._T.owners=self._T.owners or {}
            self._T.owners[anchor.Id]=binding.actor
        end
        return self:PlayEffectAttached(ruid,anchor,offset,rotation,scale,loop,options)
    end


    @ExecSpace("ClientOnly")
    method Vector3 WorldScale(Entity entity)
        -- Preserve parent mirrors and scaling when flattening into the scene UI.
        local scale=Vector3(1,1,1)
        local cursor=entity
        while isvalid(cursor) and cursor~=entity.CurrentMap do
            local tr=cursor.TransformComponent
            if isvalid(tr) then scale=Vector3(scale.x*tr.Scale.x,scale.y*tr.Scale.y,scale.z*tr.Scale.z) end
            cursor=cursor.Parent
        end
        return scale
    end

    @ExecSpace("ClientOnly")
    method boolean UpdateEffectTransform(table effect, table binding)
        -- Attached effects use local coordinates, whereas world effects remain fixed.
        if not isvalid(effect.node) or not isvalid(binding.view) then return false end
        local tr=effect.node.UITransformComponent
        local scale=effect.scale
        local rotation=effect.rotation
        if effect.worldPosition~=nil then
            tr.anchoredPosition=self:ProjectWorld(binding,effect.worldPosition)
        elseif isvalid(effect.anchor) then
            local anchor=effect.anchor.TransformComponent
            tr.anchoredPosition=self:ProjectAnchor(binding,effect.anchor,anchor:ToWorldPoint(effect.offset))
            local parentScale=self:WorldScale(effect.anchor)
            scale=Vector3(scale.x*parentScale.x,scale.y*parentScale.y,scale.z*parentScale.z)
            rotation=rotation+anchor.WorldZRotation
        else return false end
        tr.UIRotation=Vector3(0,0,rotation)
        tr.UIScale=Vector3(scale.x*binding.ppu/100,scale.y*binding.ppu/100,scale.z)
        if effect.options.SyncFlip==true and isvalid(effect.anchor) then
            local source=effect.anchor.SpriteRendererComponent
            local controller=effect.anchor.PlayerControllerComponent
            local sprite=effect.visual.SpriteGUIRendererComponent
            if isvalid(source) then sprite.FlipX=source.FlipX sprite.FlipY=source.FlipY
            elseif isvalid(controller) then sprite.FlipX=_CarnivalReplica:PresentationFacing(effect.anchor)>0 end
        end
        return true
    end


    @ExecSpace("ClientOnly")
    method void SortScene()
        -- Keep the world renderer order inside this window, without global UI overrides.
        local scene=_CarnivalUI:UI("Lobby/Scene")
        if not isvalid(scene) then return end
        self._T.sortDirty=false
        local list={} local seen={}
        local function add(node, order, depth)
            if not isvalid(node) or node.Parent~=scene or seen[node.Id] then return end
            seen[node.Id]=true
            table.insert(list,{node=node,order=order,depth=depth or 0})
        end
        for _,binding in pairs(self._T.views or {}) do
            local entity=binding.actor
            if isvalid(entity) then
                local renderer=entity.AvatarRendererComponent or entity.SpriteRendererComponent
                if isvalid(renderer) then add(binding.view,renderer.OrderInLayer,entity.TransformComponent.WorldPosition.z) end
            end
        end
        for _,record in pairs(self._T.entities or {}) do
            if isvalid(record.entity) then
                local source=record.entity
                local renderer=source.AvatarRendererComponent or source.SpriteRendererComponent
                if isvalid(renderer) then add(record.node,renderer.OrderInLayer,source.TransformComponent.WorldPosition.z)
                elseif isvalid(source.TextRendererComponent) then add(record.node,1000,0) end
                add(record.health,1001,0)
            end
        end
        for _,effect in pairs(self._T.effects or {}) do
            add(effect.node,effect.options.OrderInLayer or 4,0)
        end
        table.sort(list,function(a,b)
            if a.order~=b.order then return a.order<b.order end
            if a.depth~=b.depth then return a.depth>b.depth end
            return a.node.Id<b.node.Id
        end)
        local signature=""
        for _,item in ipairs(list) do signature=signature..item.node.Id..":"..tostring(item.order)..";" end
        if self._T.sortSignature==signature then return end
        self._T.sortSignature=signature
        local first=#scene.Children:ToTable()-#list
        for i,item in ipairs(list) do
            local transform=item.node.UITransformComponent local index=first+i-1
            if _UILogic:GetSiblingIndex(transform)~=index then
                -- Preserve the current frame's layout when the UI hierarchy changes.
                local position=transform.anchoredPosition local scale=transform.UIScale local rotation=transform.UIRotation
                _UILogic:SetSiblingIndex(transform,index)
                transform.anchoredPosition=position transform.UIScale=scale transform.UIRotation=rotation
            end
        end
    end


    @ExecSpace("ClientOnly")
    method void RefreshEntity(Entity entity)
        -- Present after the source movement tick, avoiding a frame of extra interpolation delay.
        if not isvalid(entity) then return end
        local record=(self._T.entities or {})[entity.Id]
        if record==nil or not isvalid(record.actor) then return end
        local binding=(self._T.views or {})[record.actor.Id]
        if binding~=nil and isvalid(binding.view) then self:DrawEntity(record,binding) end
    end

    method string SkillForegroundLayer(Entity entity)
        if not isvalid(entity) or not isvalid(entity.CurrentMap) then return "MapLayer0" end
        local map=entity.CurrentMap
        self._T.foregroundLayers=self._T.foregroundLayers or {}
        local cached=self._T.foregroundLayers[map.Id]
        if cached~=nil then return cached end
        local name,order="MapLayer0",-2147483648
        for _,layer in ipairs(map:GetChildComponentsByTypeName("MOD.Core.MapLayerComponent",true)) do
            if layer.LayerSortOrder>order then name=layer.MapLayerName order=layer.LayerSortOrder end
        end
        self._T.foregroundLayers[map.Id]=name
        return name
    end

    method table ForegroundOptions(Entity entity, table options)
        local result={}
        for key,value in pairs(options or {}) do result[key]=value end
        result.SortingLayer=self:SkillForegroundLayer(entity)
        result.OrderInLayer=20000+math.max(-1000,math.min(1000,result.OrderInLayer or 0))
        return result
    end

    method void RaiseSkillEntity(Entity entity)
        if not isvalid(entity) then return end
        local layer=self:SkillForegroundLayer(entity)
        local renderers=entity:GetChildComponentsByTypeName("MOD.Core.SpriteRendererComponent",true)
        if isvalid(entity.SpriteRendererComponent) then table.insert(renderers,entity.SpriteRendererComponent) end
        for _,sprite in ipairs(renderers) do
            sprite.SortingLayer=layer
            if sprite.OrderInLayer<19000 then sprite.OrderInLayer=20000+math.max(-1000,math.min(1000,sprite.OrderInLayer)) end
        end
    end
end
