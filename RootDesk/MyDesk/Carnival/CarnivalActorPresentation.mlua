@Logic
script CarnivalActorPresentation extends Logic
    @ExecSpace("ClientOnly")
    method void Bind(Entity actor, Entity view, number pixelsPerUnit, Vector2 origin)
        -- Register a real world actor's UI surface; unregistered actors retain native rendering.
        self._T.views=self._T.views or {}
        local binding=self._T.views[actor.Id]
        if binding==nil then binding={actor=actor} self._T.views[actor.Id]=binding self._T.sortDirty=true end
        binding.view=view binding.ppu=pixelsPerUnit binding.origin=origin
    end

    @ExecSpace("ClientOnly")
    method void Unbind(Entity actor)
        -- Remove the actor's attached effects before releasing its window.
        if actor==nil then return end
        if self._T.avatarAlpha then self._T.avatarAlpha[actor.Id]=nil end
        if self._T.views then self._T.views[actor.Id]=nil end
        local entities={}
        for id,record in pairs(self._T.entities or {}) do if record.actor==actor then table.insert(entities,id) end end
        for _,id in ipairs(entities) do self:RemoveEntity(id) end
        local remove={}
        for serial,effect in pairs(self._T.effects or {}) do
            if effect.actor==actor then table.insert(remove,serial) end
        end
        for _,serial in ipairs(remove) do self:RemoveEffect(serial) end
    end

    @ExecSpace("ClientOnly")
    method integer PlayEffectAttached(string ruid, Entity actor, Vector3 offset, number rotation, Vector3 scale, boolean loop, table options)
        -- Forward the original skill's resource, frame range, rate, color and transform without a second skill definition.
        local binding=self:BindingFor(actor)
        if binding==nil or not isvalid(binding.view) then
            return _EffectService:PlayEffectAttached(ruid,actor,offset,rotation,scale,loop,self:ForegroundOptions(actor,options))
        end
        options=self:ForegroundOptions(actor,options)
        local template=_CarnivalUI:UI("Lobby/Scene/EffectAnchorTemplate")
        if not isvalid(template) then return 0 end
        self._T.serial=(self._T.serial or 0)-1
        local serial=self._T.serial
        -- The anchor template owns a Visual child; clone the complete tree before publishing.
        local node=_SpawnService:SpawnByEntity(template,"NativeSkillEffect"..tostring(-serial),Vector3.zero,_CarnivalUI:UI("Lobby/Scene"),true)
        if not isvalid(node) then return 0 end
        node.Enable=false
        node.Visible=false
        local visual=node:GetChildByName("Visual")
        if not isvalid(visual) then _EntityService:Destroy(node) return 0 end
        local effect={node=node,visual=visual,actor=binding.actor,anchor=actor,offset=offset,rotation=rotation,scale=scale,options=options,frames={},ruid=ruid,worldPosition=options.carnivalWorldPosition,loop=loop,born=_UtilLogic.ElapsedSeconds,readyFrame=(self._T.frameSerial or 0)+2}
        self._T.effects=self._T.effects or {}
        self._T.effects[serial]=effect
        local sprite=visual.SpriteGUIRendererComponent
        sprite.Type=ImageType.Simple
        sprite.PreserveSprite=PreserveSpriteType.NativeSize
        sprite.RaycastTarget=false
        sprite.ImageRUID=DataRef(ruid)
        sprite.StartFrameIndex=options.StartFrameIndex or 0
        sprite.EndFrameIndex=options.EndFrameIndex or 2147483647
        sprite.PlayRate=0
        sprite.AnimClipPlayType=loop and SpriteAnimClipPlayType.Loop or SpriteAnimClipPlayType.Onetime
        sprite.FlipX=options.FlipX==true
        sprite.FlipY=options.FlipY==true
        local color=options.Color or Color.white
        sprite.Color=Color(color.r,color.g,color.b,color.a*(options.Alpha or 1))
        if options.MaterialID~=nil then sprite.MaterialId=options.MaterialID end
        self:UpdateEffectTransform(effect,binding)
        effect.frameEvent=visual:ConnectEvent(SpriteGUIAnimPlayerChangeFrameEvent,function(e)
            effect.frames[e.FrameIndex]=true
            effect.total=e.TotalFrameCount
            effect.last=e.FrameIndex
        end)
        effect.endEvent=visual:ConnectEvent(SpriteGUIAnimPlayerEndEvent,function()
            if loop then return end
            local count=0
            for _,seen in pairs(effect.frames) do if seen then count=count+1 end end
            if self._T.verifyEffects then log("[VRF] Carnival original effect completed ruid="..ruid.." frames="..tostring(count).."/"..tostring(effect.total).." last="..tostring(effect.last)) end
            self:RemoveEffect(serial)
        end)
        self._T.sortDirty=true
        node.Enable=true
        if self._T.verifyEffects then log("[VRF] Carnival original effect routed ruid="..ruid.." rate="..tostring(sprite.PlayRate).." ppu="..tostring(binding.ppu)) end
        return serial
    end

    @ExecSpace("ClientOnly")
    method void RemoveEffect(integer serial)
        -- Negative IDs belong to this UI adapter; native EffectService IDs pass through unchanged.
        if serial>=0 then _EffectService:RemoveEffect(serial) return end
        local effect=(self._T.effects or {})[serial]
        if effect==nil then return end
        self._T.effects[serial]=nil self._T.sortDirty=true
        if isvalid(effect.node) then
            if isvalid(effect.visual) then
                effect.visual:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent,effect.frameEvent)
                effect.visual:DisconnectEvent(SpriteGUIAnimPlayerEndEvent,effect.endEvent)
            end
            _EntityService:Destroy(effect.node)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release all renderer subscriptions and temporary UI entities on stop.
        local remove={}
        for serial,_ in pairs(self._T.effects or {}) do table.insert(remove,serial) end
        for _,serial in ipairs(remove) do self:RemoveEffect(serial) end
        local entities={} for id,_ in pairs(self._T.entities or {}) do table.insert(entities,id) end
        for _,id in ipairs(entities) do self:RemoveEntity(id) end
        self._T.views={} self._T.effects={} self._T.entities={} self._T.owners={}
    end

    @ExecSpace("ClientOnly")
    method integer PlayEffect(Entity owner, string ruid, Entity context, Vector3 position, number rotation, Vector3 scale, boolean loop, table options)
        -- Converts the original world-space effect to the actor window without altering the clip.
        local binding=self:BindingFor(owner)
        if binding==nil or not isvalid(binding.view) then
            return _EffectService:PlayEffect(ruid,context,position,rotation,scale,loop,self:ForegroundOptions(owner,options))
        end
        local effectOptions={}
        for key,value in pairs(options or {}) do effectOptions[key]=value end
        effectOptions.carnivalWorldPosition=position
        -- A hit flash belongs to its world position, not to the projectile that is destroyed on impact.
        local actorPos=binding.actor.TransformComponent.WorldPosition
        local serial=self:PlayEffectAttached(ruid,binding.actor,position-actorPos,rotation,scale,loop,effectOptions)
        local effect=(self._T.effects or {})[serial]
        if effect~=nil then
            effect.worldPosition=position
            self:UpdateEffectTransform(effect,binding)
        end
        return serial
    end

    @ExecSpace("ClientOnly")
    method void TrackEntity(Entity actor, Entity entity)
        -- Watches the native entity rather than simulating a second projectile.
        if not isvalid(actor) or not isvalid(entity) or actor==entity then return end
        if (self._T.entities or {})[entity.Id]~=nil then return end
        -- Avatar internals already render through AvatarGUIRenderer; never project them a second time.
        local avatar=actor.AvatarRendererComponent
        local avatarRoot=isvalid(avatar) and avatar:GetAvatarRootEntity() or nil
        local cursor=entity
        while isvalid(cursor) and cursor~=actor do
            if cursor==avatarRoot or cursor.Name=="HealerHpBar" or cursor.Name=="HeroHpBar" or cursor.Name=="ShadowCloneHpBar" then return end
            local parent=cursor.Parent
            if isvalid(parent) and isvalid(parent.AvatarRendererComponent) and cursor==parent.AvatarRendererComponent:GetAvatarRootEntity() then return end
            cursor=cursor.Parent
        end
        self._T.entities=self._T.entities or {}
        if self._T.entities[entity.Id]~=nil then return end
        local record={actor=actor,entity=entity,frameChanges=0}
        self._T.entities[entity.Id]=record
        self._T.owners=self._T.owners or {}
        self._T.owners[entity.Id]=actor
        if self._T.verifyEffects then log("[VRF] Carnival native entity tracked name="..entity.Name) end
    end

    @ExecSpace("ClientOnly")
    method void RemoveEntity(string entityId)
        if self._T.avatarAlpha then self._T.avatarAlpha[entityId]=nil end
        -- Releases only the UI proxy; the original entity keeps its normal game lifetime.
        local record=(self._T.entities or {})[entityId]
        if record==nil then return end
        self._T.entities[entityId]=nil self._T.sortDirty=true
        if isvalid(record.avatarSource) and record.avatarEvent~=nil then record.avatarSource:DisconnectEvent(ActionStateChangedEvent,record.avatarEvent) end
        if isvalid(record.frameSource) and record.frameEvent~=nil then record.frameSource:DisconnectEvent(SpriteAnimPlayerChangeFrameEvent,record.frameEvent) end
        if self._T.owners~=nil then
            self._T.owners[entityId]=nil
            if record.visualId~=nil then self._T.owners[record.visualId]=nil end
        end
        local effects={}
        for serial,effect in pairs(self._T.effects or {}) do if effect.anchor==record.entity or effect.anchor==record.frameSource then table.insert(effects,serial) end end
        for _,serial in ipairs(effects) do self:RemoveEffect(serial) end
        if isvalid(record.node) then _EntityService:Destroy(record.node) end
        if isvalid(record.health) then _EntityService:Destroy(record.health) end
        if self._T.verifyEffects and record.projected then
            log("[VRF] Carnival native entity released frames="..tostring(record.frameChanges).." ruid="..tostring(record.ruid))
        end
    end

    @ExecSpace("ClientOnly")
    method void DrawEntity(table record, table binding)
        -- Copies transform, appearance and animation frame from the running native renderer.
        local entity=record.entity
        if isvalid(entity.TextRendererComponent) then self:DrawTextEntity(record,binding) return end
        if isvalid(entity.AvatarRendererComponent) then self:DrawAvatarEntity(record,binding) return end
        local network=(_NetworkMotionVisual._T.entries or {})[entity.Id]
        local visual=network~=nil and isvalid(network.visual) and network.visual or entity
        if record.frameSource~=visual then
            if isvalid(record.frameSource) and record.frameEvent~=nil then record.frameSource:DisconnectEvent(SpriteAnimPlayerChangeFrameEvent,record.frameEvent) end
            record.frameSource=visual record.visualId=visual.Id record.frame=nil
            self._T.owners[visual.Id]=record.actor
            record.frameEvent=visual:ConnectEvent(SpriteAnimPlayerChangeFrameEvent,function(event)
                record.frame=event.FrameIndex record.frameChanges=record.frameChanges+1
            end)
            local shuriken=entity:GetComponent("LuckySevenProjectile")
            if isvalid(shuriken) then shuriken:RefreshCarnivalFlyVisual() end
        end
        local source=visual.SpriteRendererComponent
        if not isvalid(source) or source.SpriteRUID==nil or source.SpriteRUID=="" then
            if isvalid(record.node) then record.node.Enable=false end
            return
        end
        if not isvalid(record.node) then
            local template=_CarnivalUI:UI("Lobby/Scene/EffectAnchorTemplate")
            if not isvalid(template) then return end
            -- Native projectiles use the same anchor/Visual tree as skill effects.
            record.node=_SpawnService:SpawnByEntity(template,"NativeEntity_"..entity.Id,Vector3.zero,_CarnivalUI:UI("Lobby/Scene"),true)
            if not isvalid(record.node) then return end
            record.spriteNode=record.node:GetChildByName("Visual")
            if not isvalid(record.spriteNode) then _EntityService:Destroy(record.node) record.node=nil return end
            record.node.Visible=false
            record.node.Enable=true
            self._T.sortDirty=true
            record.readyFrame=(self._T.frameSerial or 0)+2
            record.spriteNode.SpriteGUIRendererComponent.Type=ImageType.Simple
            record.spriteNode.SpriteGUIRendererComponent.PreserveSprite=PreserveSpriteType.NativeSize
            record.spriteNode.SpriteGUIRendererComponent.RaycastTarget=false
            record.spriteNode.SpriteGUIRendererComponent.AnimClipPlayType=SpriteAnimClipPlayType.Loop
        end
        local node=record.node local sprite=record.spriteNode.SpriteGUIRendererComponent
        -- Publish only after costume, image and transform are initialized.
        if record.ruid~=source.SpriteRUID then
            record.ruid=source.SpriteRUID record.frame=nil
            sprite.ImageRUID=DataRef(source.SpriteRUID)
        end
        if source.DrawMode~=SpriteDrawMode.Simple then
            sprite.Type=source.DrawMode==SpriteDrawMode.Sliced and ImageType.Sliced or ImageType.Tiled
            sprite.PreserveSprite=PreserveSpriteType.None
            record.spriteNode.UITransformComponent.RectSize=source.TiledSize*100
        else
            sprite.Type=ImageType.Simple sprite.PreserveSprite=PreserveSpriteType.NativeSize
        end
        sprite.FlipX=source.FlipX sprite.FlipY=source.FlipY
        sprite.Color=source.Color sprite.PlayRate=source.PlayRate
        sprite.MaterialId=source.MaterialID
        local first=record.frame or source.StartFrameIndex
        local last=record.frame or source.EndFrameIndex
        if sprite.StartFrameIndex~=first or sprite.EndFrameIndex~=last then
            sprite.EndFrameIndex=2147483647
            sprite.StartFrameIndex=first sprite.EndFrameIndex=last
        end
        node.UITransformComponent.anchoredPosition=self:ProjectAnchor(binding,entity,visual.TransformComponent.WorldPosition)
        node.UITransformComponent.UIRotation=Vector3(0,0,visual.TransformComponent.WorldZRotation)
        local sx=1 local sy=1 local cursor=visual
        while isvalid(cursor) and cursor~=entity.CurrentMap do
            local transform=cursor.TransformComponent
            if isvalid(transform) then sx=sx*transform.Scale.x sy=sy*transform.Scale.y end
            cursor=cursor.Parent
        end
        node.UITransformComponent.UIScale=Vector3(sx*binding.ppu/100,sy*binding.ppu/100,1)
        local visible=visual.EnabledInHierarchy and visual.VisibleInHierarchy and source.Enable and (self._T.frameSerial or 0)>=(record.readyFrame or 0)
        if node.Visible~=visible then node.Visible=visible end
        if not record.projected then
            record.projected=true
            if self._T.verifyEffects then log("[VRF] Carnival native entity projected name="..entity.Name.." ruid="..tostring(record.ruid)) end
        end
    end

    @ExecSpace("ClientOnly")
    method void DrawFrame(number delta)
        -- Run after the window camera and actor views have been updated for this frame.
        self._T.frameSerial=(self._T.frameSerial or 0)+1
        -- Native hit flashes are often child sprites spawned directly by projectile components.
        for id,binding in pairs(self._T.views or {}) do
            if not isvalid(binding.actor) then
                self._T.views[id]=nil
                local stale={}
                for serial,effect in pairs(self._T.effects or {}) do if effect.actor==binding.actor then table.insert(stale,serial) end end
                for _,serial in ipairs(stale) do self:RemoveEffect(serial) end
            else
                for _,child in pairs(binding.actor.Children) do
                    self:TrackEntity(binding.actor,child)
                end
            end
        end
        local remove={}
        for id,record in pairs(self._T.entities or {}) do
            local binding=isvalid(record.actor) and (self._T.views or {})[record.actor.Id] or nil
            if not isvalid(record.entity) or binding==nil or not isvalid(binding.view) then table.insert(remove,id)
            else
                for _,child in pairs(record.entity.Children) do self:TrackEntity(record.actor,child) end
                self:DrawEntity(record,binding)
            end
        end
        for _,id in ipairs(remove) do self:RemoveEntity(id) end
        local expired={}
        for serial,effect in pairs(self._T.effects or {}) do
            if isvalid(effect.actor) and isvalid(effect.node) and isvalid(effect.visual) then
                local binding=(self._T.views or {})[effect.actor.Id]
                if binding~=nil then
                    local positioned=self:UpdateEffectTransform(effect,binding)
                    -- Enabling a new UI clone initializes its transform on the next frame.
                    -- Keep it hidden and paused until that initialization has finished.
                    if not positioned then
                        effect.node.Visible=false
                        table.insert(expired,serial)
                    elseif not effect.published and self._T.frameSerial>=effect.readyFrame then
                        effect.published=true
                        effect.visual.SpriteGUIRendererComponent.PlayRate=effect.options.PlayRate or 1
                        effect.node.Visible=true
                        if self._T.verifyEffects then log("[VRF][EffectPublish] ruid="..effect.ruid.." at="..tostring(effect.node.UITransformComponent.anchoredPosition)) end
                        if Environment:IsMakerPlay() and not self._T.anchorVerified then
                            self._T.anchorVerified=true
                            log("[VRF][CarnivalEffectAnchor] separate visual positioned at="..tostring(effect.node.UITransformComponent.anchoredPosition))
                        end
                    end
                else table.insert(expired,serial) end
            else table.insert(expired,serial) end
        end
        for _,serial in ipairs(expired) do self:RemoveEffect(serial) end
        if self._T.sortDirty or _UtilLogic.ElapsedSeconds>=(self._T.sortAt or 0) then
            self._T.sortAt=_UtilLogic.ElapsedSeconds+0.1 self:SortScene()
        end
        _CarnivalDamageSkin:DrawFrame()
    end


    @ExecSpace("ClientOnly")
    method table BindingFor(Entity anchor)
        -- Resolves actor and projectile anchors without changing player ownership.
        if not isvalid(anchor) then return nil end
        local views=self._T.views or {}
        if views[anchor.Id]~=nil then return views[anchor.Id] end
        local owner=(self._T.owners or {})[anchor.Id]
        if isvalid(owner) then return views[owner.Id] end
        local parent=anchor.Parent
        if isvalid(parent) and parent~=anchor.CurrentMap then return self:BindingFor(parent) end
        local p=_CarnivalReplica._T.client
        local monster=anchor:GetComponent("Monster")
        if p~=nil and isvalid(p.actor) and isvalid(monster) and monster.CarnivalRoom~="" and monster.CarnivalRoom==p.actor.PlayerAttack._T.carnivalRoom then return views[p.actor.Id] end
        return nil
    end

    @ExecSpace("ClientOnly")
    method void DrawAvatarEntity(table record, table binding)
        -- Project the summoned entity's own costume and action events, never the local player's outfit.
        local entity=record.entity local ar=entity.AvatarRendererComponent
        self:DrawSummonHealth(record,binding)
        if not isvalid(record.node) then
            local template=_CarnivalUI:UI("Lobby/Scene/Actor1/Body")
            record.node=_SpawnService:SpawnByEntity(template,"NativeAvatar_"..entity.Id,Vector3.zero,_CarnivalUI:UI("Lobby/Scene"),false)
            if not isvalid(record.node) then return end
            record.node.Enable=false
            record.node.AvatarGUIRendererComponent.PreserveAvatar=PreserveSpriteType.NativeSize
            record.node.AvatarGUIRendererComponent.RaycastTarget=false
            record.node.AvatarGUIRendererComponent.FlipX=false
        end
        local node=record.node local gui=node.AvatarGUIRendererComponent
        -- Publish only after costume, image and transform are initialized.
        local costume=entity.CostumeManagerComponent local copy=node.CostumeManagerComponent
        if isvalid(costume) and isvalid(copy) and _UtilLogic.ElapsedSeconds>=(record.costumeAt or 0) then
            record.costumeAt=_UtilLogic.ElapsedSeconds+0.2
            copy.UseCustomEquipOnly=costume.UseCustomEquipOnly copy.DefaultEquipUserId=costume.DefaultEquipUserId
            for _,key in ipairs(_CarnivalBattle:EquipKeys()) do if copy[key]~=costume[key] then copy[key]=costume[key] end end
        end
        local body=ar:GetBodyEntity() local target=gui:GetBodyEntity()
        if isvalid(body) and isvalid(target) and (record.avatarSource~=body or record.avatarTarget~=target) then
            if isvalid(record.avatarSource) and record.avatarEvent~=nil then record.avatarSource:DisconnectEvent(ActionStateChangedEvent,record.avatarEvent) end
            record.avatarSource=body record.avatarTarget=target
            record.avatarEvent=body:ConnectEvent(ActionStateChangedEvent,function(e)
                if not isvalid(node) then return end
                local receiver=node.AvatarGUIRendererComponent:GetBodyEntity()
                if isvalid(receiver) then
                    receiver:SendEvent(ActionStateChangedEvent(e.CoreActionName,e.PartsActionName,e.PlayRate,e.PlayType,e.StartFrameIndex,e.EndFrameIndex))
                    record.frameChanges=record.frameChanges+1
                end
            end)
            local summon=entity:GetComponent("HealerSummon") or entity:GetComponent("HeroSummon")
            local action=isvalid(summon) and summon._T.avatarAction or nil
            if action~=nil then target:SendEvent(ActionStateChangedEvent(action[1],action[2],action[3],action[4],action[5],action[6]))
            else target:SendEvent(ActionStateChangedEvent("stand1","stand1",1,SpriteAnimClipPlayType.Loop)) end
        end
        node.UITransformComponent.anchoredPosition=self:ProjectAnchor(binding,entity,entity.TransformComponent.WorldPosition)
        local scale=self:WorldScale(entity)
        node.UITransformComponent.UIScale=Vector3(scale.x*binding.ppu/100,scale.y*binding.ppu/100,1)
        node.UITransformComponent.UIRotation=Vector3(0,0,entity.TransformComponent.WorldZRotation)
        self:CopyAvatarAlpha(entity,gui)
        gui.PlayRate=ar.PlayRate gui.MaterialId=ar.MaterialId
        node.Enable=entity.EnabledInHierarchy and entity.VisibleInHierarchy
        if not record.projected then
            record.projected=true
            if Environment:IsMakerPlay() then log("[VRF] Carnival original summon avatar="..entity.Name.." ownCostume=true") end
        end
    end

    @ExecSpace("ClientOnly")
    method Vector2 ProjectWorld(table binding, Vector3 position)
        -- A flying projectile belongs to the room, independently of its caster's prediction.
        local origin=binding.origin
        return _CarnivalView:Project(position.x-origin.x,position.y-origin.y)
    end

    @ExecSpace("ClientOnly")
    method Vector2 ProjectAnchor(table binding, Entity anchor, Vector3 position)
        -- Only effects parented to an actor inherit that actor's predicted screen position.
        local cursor=anchor
        while isvalid(cursor) and cursor~=binding.actor.CurrentMap do
            if cursor==binding.actor then
                local offset=position-binding.actor.TransformComponent.WorldPosition
                return binding.view.UITransformComponent.anchoredPosition+Vector2(offset.x*binding.ppu,offset.y*binding.ppu)
            end
            cursor=cursor.Parent
        end
        return self:ProjectWorld(binding,position)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Hidden windows still release expired effects and destroyed projectiles.
        if not _CarnivalUI.opened or _CarnivalUI.minimized then self:DrawFrame(delta) end
    end

    method void SetAvatarAlpha(any renderer, number alpha)
        if not isvalid(renderer) then return end
        renderer:SetAlpha(alpha,nil)
        if not self:IsClient() then return end
        self._T.avatarAlpha=self._T.avatarAlpha or {}
        self._T.avatarAlpha[renderer.Entity.Id]=alpha
    end

    @ExecSpace("ClientOnly")
    method void CopyAvatarAlpha(Entity actor, any gui)
        local alpha=(self._T.avatarAlpha or {})[actor.Id]
        if alpha==nil then alpha=1 end
        local color=gui.Color
        if color.a~=alpha then gui.Color=Color(color.r,color.g,color.b,alpha) end
    end

    @ExecSpace("ClientOnly")
    method void DrawTextEntity(table record, table binding)
        -- Charge percentages and native text children retain their world font and position.
        local entity=record.entity local source=entity.TextRendererComponent
        if not isvalid(record.node) then
            local template=_CarnivalUI:UI("Lobby/Scene/Actor1/Name")
            record.node=_SpawnService:SpawnByEntity(template,"NativeText_"..entity.Id,Vector3.zero,_CarnivalUI:UI("Lobby/Scene"),false)
            if not isvalid(record.node) then return end
        end
        local node=record.node local target=node.TextGUIRendererComponent
        target.Text=source.Text target.FontColor=source.FontColor target.FontSize=source.FontSize
        local scale=entity.TransformComponent.Scale
        node.UITransformComponent.RectSize=source.RectSize*100
        node.UITransformComponent.anchoredPosition=self:ProjectAnchor(binding,entity,entity.TransformComponent.WorldPosition)+source.RectOffset*binding.ppu
        node.UITransformComponent.UIScale=Vector3(scale.x*binding.ppu/100,scale.y*binding.ppu/100,1)
        node.Enable=entity.EnabledInHierarchy and entity.VisibleInHierarchy and source.Enable
    end

    @ExecSpace("ClientOnly")
    method void DrawSummonHealth(table record, table binding)
        -- Reuse the real summon-party health gauge above each summoned avatar.
        local entity=record.entity local hp=0 local maximum=0
        local hero=entity:GetComponent("HeroSummon") local healer=entity:GetComponent("HealerSummon")
        local clone=entity:GetComponent("ShadowClone")
        if isvalid(hero) then hp=hero.HeroHp maximum=hero.HeroMaxHp
        elseif isvalid(healer) then hp=healer.HealerHp maximum=healer.HealerMaxHp
        elseif isvalid(clone) then hp=clone.CloneHp maximum=clone.CloneMaxHp else return end
        if not isvalid(record.health) then
            local template=_EntityService:GetEntityByPath("/ui/SummonPartyUI/Board/Row1/HpBg")
            if not isvalid(template) then return end
            record.health=_SpawnService:SpawnByEntity(template,"SummonHP_"..entity.Id,Vector3.zero,_CarnivalUI:UI("Lobby/Scene"),true)
            if not isvalid(record.health) then return end
            -- The shared gauge uses polygon points, so scale the whole tree instead of only its rect.
            record.health.Enable=false
            local transform=record.health.UITransformComponent
            transform.AlignmentOption=AlignmentType.Center
            transform.AnchorsMin=Vector2(0.5,0.5)
            transform.AnchorsMax=Vector2(0.5,0.5)
            transform.Pivot=Vector2(0.5,0.5)
            transform.RectSize=Vector2(110,12)
            transform.UIScale=Vector3(0.5,0.5,1)
        end
        record.health.UITransformComponent.anchoredPosition=self:ProjectAnchor(binding,entity,entity.TransformComponent.WorldPosition+Vector3(0,1.05,0))
        local fill=record.health:GetChildByName("HpFill")
        if not isvalid(fill) then return end
        local ratio=maximum>0 and math.max(0,math.min(1,hp/maximum)) or 0
        _SummonPartyUI:UpdateFill(fill,ratio)
        record.health.Enable=entity.EnabledInHierarchy and hp>0 and maximum>0
        if Environment:IsMakerPlay() and not record.healthVerified and isvalid(fill.PolygonGUIRendererComponent) then
            record.healthVerified=true
            log("[VRF] Carnival summon polygon HP ready ratio="..tostring(ratio).." size=55x6")
        end
    end


