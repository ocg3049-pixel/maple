@Logic
script UIPopup extends Logic

	property TextComponent message = "3606e39d-32de-427e-8d23-b38af810a3b4"

	property ButtonComponent btnOk = "94a274e4-4111-40f1-924d-c95a3a1f14d5"

	property ButtonComponent btnCancel = "0f5de49b-2adc-409a-816d-15aa43df8e0d"

	property Entity popupGroup = "fb7a3b06-7026-4590-8efe-bb33416dd8f9"

	property Entity popup = "aa954759-0e39-430f-85fa-80bf2e5fe31d"

	property any onOk = nil

	property any onCancel = nil

	property number duration = 0.15

	property number from = 0.5

	property number to = 1

	property boolean isOpen = false

	property boolean isTweenPlaying = false

	property number tweenEventId = 0

	property any okHandler = nil

	property any cancelHandler = nil

	@ExecSpace("ClientOnly")
	method void Open(string message, any onOk, any onCancel)
		if self:BlocksInput() and self.isOpen then
			return
		end
		self.isOpen = true
        self._T.dragStart=nil
        self.popup.UITransformComponent.anchoredPosition=Vector2.zero
		self.popupGroup.UIGroupComponent.GroupType=UIGroupType.UIType
        self.popupGroup.UIGroupComponent.GroupOrder=1000
        _UILogic:SetSiblingIndex(self.popupGroup.UITransformComponent,100000)
        self.popupGroup.Enable = true
        self.popup.Parent.Enable=true
        self.popup.Enable=true
        self.btnOk.Entity.Enable=true
        self.btnCancel.Entity.Enable=true
        _UICursorManager:BringToFront()
		self.message.Text = message
		self.onOk = onOk
		self.onCancel = onCancel
		
		
		self.okHandler = self.btnOk.Entity:ConnectEvent(ButtonClickEvent,self.OnClickOk)
		self.cancelHandler = self.btnCancel.Entity:ConnectEvent(ButtonClickEvent,self.OnClickCancel)
		self:StartTween(true)
	end

	@ExecSpace("ClientOnly")
	method void OnClickOk()
		if self.isTweenPlaying == true then
			return
		end
		if self.onOk ~= nil then
			self.onOk()
			self.onOk = nil
		end
		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void OnClickCancel()
		if self.isTweenPlaying == true then
			return
		end
		if self.onCancel ~= nil then
			self.onCancel()
			self.onCancel = nil
		end
		self:Close()
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- Release callbacks immediately; repeated close calls cannot stack tweens.
		if not self.isOpen then return end
        self._T.dragStart=nil
        self._T.inputUntil=_UtilLogic.ElapsedSeconds+0.2
		self:ReleaseHandlers()
		self.onOk = nil
		self.onCancel = nil
		self:StartTween(false)
	end

	@ExecSpace("ClientOnly")
	method void StartTween(boolean open)
		-- Only one animation may own the popup at a time.
		if self.tweenEventId > 0 then _TimerService:ClearTimer(self.tweenEventId) end
		self.tweenEventId = 0
		
		local transform = self.popup.UITransformComponent
		local canvasGroup = self.popupGroup.CanvasGroupComponent 
		if open == true then
			canvasGroup.GroupAlpha = 0
			transform.UIScale = Vector3(self.from,self.from,1)
		else
			transform.UIScale = Vector3(self.to,self.to,1)
		end
		self.isTweenPlaying = true
		local time = 0
		
		
		local preTime = _UtilLogic.ElapsedSeconds
		
		local tween = function()
			local delta = _UtilLogic.ElapsedSeconds - preTime
			time = time + delta
			local timeValue = time	
			preTime = _UtilLogic.ElapsedSeconds
		
			if time >= self.duration then
				timeValue = self.duration
				if open == false then
					self.popupGroup.Enable = false
					self.isOpen = false
				end
				self.isTweenPlaying = false
				_TimerService:ClearTimer(self.tweenEventId)
				self.tweenEventId = 0
		
			end
			if open == false then
				timeValue = self.duration - timeValue
			end
			local tweenValue = _TweenLogic:Ease(self.from, self.to, 
				self.duration, EaseType.SineEaseIn, timeValue)
			transform.UIScale = Vector3(tweenValue,tweenValue,1)
			canvasGroup.GroupAlpha = timeValue / self.duration
		end
		self.tweenEventId = _TimerService:SetTimerRepeat(tween,1/60)
		
	end

    @ExecSpace("ClientOnly")
    method void ReleaseHandlers()
        -- Connections outlive a closed popup unless explicitly disconnected.
        if self.okHandler ~= nil and isvalid(self.btnOk) then self.btnOk.Entity:DisconnectEvent(ButtonClickEvent, self.okHandler) end
        if self.cancelHandler ~= nil and isvalid(self.btnCancel) then self.btnCancel.Entity:DisconnectEvent(ButtonClickEvent, self.cancelHandler) end
        self.okHandler = nil
        self.cancelHandler = nil
    end

    @ExecSpace("ClientOnly")
    method void Reset()
        -- Teardown must not start a new closing animation.
        self:ReleaseHandlers()
        if self.tweenEventId > 0 then _TimerService:ClearTimer(self.tweenEventId) end
        self.tweenEventId = 0
        self.isTweenPlaying = false
        self.isOpen = false
        self._T.dragStart=nil
        self._T.inputUntil=0
        self.onOk = nil
        self.onCancel = nil
        if isvalid(self.popupGroup) then self.popupGroup.Enable = false end
    end
    @ExecSpace("ClientOnly")
    method boolean BlocksInput()
        local shown=isvalid(self.popup) and self.popup.EnabledInHierarchy and self.popup.VisibleInHierarchy
        if self.isOpen and not shown then
            self:Reset()
            if Environment:IsMakerPlay() then log("[VRF] hidden popup state recovered") end
        end
        return shown or _UtilLogic.ElapsedSeconds<(self._T.inputUntil or 0)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Route modal keyboard and pointer input before the windows underneath.
        self:Reset()
        self._T.keyInput=_InputService:ConnectEvent(KeyDownEvent,function(event)
            if event.key==KeyboardKey.Mouse0 then self:BeginDrag(_InputService:GetCursorPosition()) else self:OnKey(event) end
        end)
        self._T.touchInput=_InputService:ConnectEvent(ScreenTouchEvent,function(event)
            if event.TouchId==1 then self:BeginDrag(event.TouchPoint) end
        end)
        self._T.touchHold=_InputService:ConnectEvent(ScreenTouchHoldEvent,function(event)
            if event.TouchId==1 then self:DragTo(event.TouchPoint) end
        end)
        self._T.touchRelease=_InputService:ConnectEvent(ScreenTouchReleaseEvent,function(event)
            if event.TouchId==1 then self._T.dragStart=nil end
        end)
        if Environment:IsMakerPlay() then log("[VRF] popup keyboard and background drag ready") end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release every global subscription before the next play session.
        self:Reset()
        if self._T.keyInput then _InputService:DisconnectEvent(KeyDownEvent,self._T.keyInput) end
        if self._T.touchInput then _InputService:DisconnectEvent(ScreenTouchEvent,self._T.touchInput) end
        if self._T.touchHold then _InputService:DisconnectEvent(ScreenTouchHoldEvent,self._T.touchHold) end
        if self._T.touchRelease then _InputService:DisconnectEvent(ScreenTouchReleaseEvent,self._T.touchRelease) end
    end

    @ExecSpace("ClientOnly")
    method void OnKey(KeyDownEvent event)
        -- One modal consumes Enter/Escape; never activate a hidden/disabled button.
        if not self.isOpen or not self:BlocksInput() or self.isTweenPlaying then return end
        if event.key==KeyboardKey.Return or event.key==KeyboardKey.KeypadEnter then
            if self.btnOk.Enable and self.btnOk.Entity.EnabledInHierarchy then self:OnClickOk() end
        elseif event.key==KeyboardKey.Escape then
            if self.btnCancel.Enable and self.btnCancel.Entity.EnabledInHierarchy then self:OnClickCancel() end
        end
    end

    @ExecSpace("ClientOnly")
    method void BeginDrag(Vector2 point)
        -- Only the dialog's background is draggable, excluding both action buttons.
        if not self.isOpen or self.isTweenPlaying or self._T.dragStart~=nil then return end
        if not _UICursorManager:Hit(self.popup,point) then return end
        if _UICursorManager:Hit(self.btnOk.Entity,point) or _UICursorManager:Hit(self.btnCancel.Entity,point) then return end
        self._T.dragStart=_UILogic:ScreenToLocalUIPosition(point,self.popup.Parent.UITransformComponent)
        self._T.dragOrigin=self.popup.UITransformComponent.anchoredPosition
    end

    @ExecSpace("ClientOnly")
    method void DragTo(Vector2 point)
        -- Convert in the parent's space so dragging stays correct at any resolution.
        if self._T.dragStart==nil then return end
        if not self.isOpen or self.isTweenPlaying then self._T.dragStart=nil return end
        local p=_UILogic:ScreenToLocalUIPosition(point,self.popup.Parent.UITransformComponent)
        local position=self._T.dragOrigin+p-self._T.dragStart
        local size=self.popup.UITransformComponent.RectSize
        local screen=self.popupGroup.UITransformComponent.RectSize
        local x=math.max(0,(screen.x-size.x)/2-12)
        local y=math.max(0,(screen.y-size.y)/2-12)
        self.popup.UITransformComponent.anchoredPosition=Vector2(math.max(-x,math.min(x,position.x)),math.max(-y,math.min(y,position.y)))
    end

end
