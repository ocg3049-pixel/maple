@Component
script CharacterSelectComponent extends Component

	-- 캐릭터 선택창 데이터/렌더링 담당.
	-- 캐릭터는 총 12칸(MaxSlot)까지 만들 수 있고, 화면에는 한 페이지에 3칸(PageSize)씩
	-- 4페이지(PageCount)로 나눠 보여준다.
	--   * selectedSlot / GetSlotData / SetSlotData / ApplySlotDataToUI 의 인덱스는 전부
	--     "전체 인덱스(1~12)"다 - 서버(CharacterPersistence)의 캐릭터 목록 순서와 1:1로 맞아야
	--     삭제/입장 RPC 인덱스가 어긋나지 않는다.
	--   * 화면 슬롯 엔티티(CharacterSlot1~3)는 현재 페이지에 해당하는 3칸만 그린다.

	property number selectedSlot = 0
	property number currentPage = 1

	method integer MaxSlot()
		-- 만들 수 있는 캐릭터 총 개수.
		return 12
	end

	method integer PageSize()
		-- 한 페이지에 보여주는 슬롯 수(화면 슬롯 엔티티 개수와 같아야 한다).
		return 3
	end

	method integer PageCount()
		-- 전체 페이지 수.
		return 4
	end

	method table Slots()
		-- 전체 슬롯 데이터(1~12). 테이블은 선언형 property로 두면 초기화 시점이 불명확해 _T에 지연 생성한다.
		if self._T.slots == nil then
			local t = {}
			for i = 1, self:MaxSlot() do
				t[i] = ""
			end
			self._T.slots = t
		end
		return self._T.slots
	end

	method string GetSlotData(number slotNum)
		-- 전체 인덱스(1~12)의 캐릭터 데이터 문자열. 없으면 "".
		local n = math.floor(slotNum)
		if n < 1 or n > self:MaxSlot() then return "" end
		local d = self:Slots()[n]
		if d == nil then return "" end
		return d
	end

	method void SetSlotData(number slotNum, string data)
		-- 전체 인덱스(1~12)에 캐릭터 데이터 문자열을 기록(화면 갱신은 하지 않는다).
		local n = math.floor(slotNum)
		if n < 1 or n > self:MaxSlot() then return end
		self:Slots()[n] = data
	end

	method void LoadCharacters()
		-- 선택창을 열기 직전 초기화 - 전체 슬롯 비우고 1페이지로 되돌린다.
		for i = 1, self:MaxSlot() do
			self:SetSlotData(i, "")
		end
		self.selectedSlot = 0
		self.currentPage = 1
		self:RefreshPage()
	end

	-- ══════════════════════════ 페이지 ↔ 슬롯 인덱스 변환 ══════════════════════════

	method integer PageOfIndex(number globalIdx)
		-- 전체 인덱스가 속한 페이지 번호.
		local n = math.floor(globalIdx)
		if n < 1 then return 1 end
		return math.floor((n - 1) / self:PageSize()) + 1
	end

	method integer UISlotOfIndex(number globalIdx)
		-- 전체 인덱스가 페이지 안에서 몇 번째 화면 슬롯인지(1~3).
		local n = math.floor(globalIdx)
		if n < 1 then return 1 end
		return ((n - 1) % self:PageSize()) + 1
	end

	method integer GlobalIndexOfUISlot(number uiIdx)
		-- 현재 페이지 기준으로 화면 슬롯(1~3) → 전체 인덱스(1~12).
		return (math.floor(self.currentPage) - 1) * self:PageSize() + math.floor(uiIdx)
	end

	method string UISlotPath(number uiIdx)
		-- 화면 슬롯 엔티티 경로.
		return "/ui/DefaultGroup/CharacterSelectGroup/SelectBackground/CharacterSlot" .. tostring(math.floor(uiIdx))
	end

	-- ══════════════════════════ 페이지 이동 ══════════════════════════

	method void GoToPage(number page)
		-- 지정 페이지로 이동(범위 밖은 잘라낸다).
		local p = math.floor(page)
		if p < 1 then p = 1 end
		if p > self:PageCount() then p = self:PageCount() end
		self.currentPage = p
		self:RefreshPage()
	end

	method void MovePage(number delta)
		-- 이전/다음 페이지(CharacterPageButton에서 호출).
		self:GoToPage(math.floor(self.currentPage) + math.floor(delta))
	end

	-- ══════════════════════════ 화면 렌더링 ══════════════════════════

	method void RefreshPage()
		-- 현재 페이지의 3칸을 데이터대로 다시 그리고, 페이지 표시/버튼 상태도 갱신한다.
		local page = math.floor(self.currentPage)
		if page < 1 then page = 1 end
		if page > self:PageCount() then page = self:PageCount() end
		self.currentPage = page

		local selected = math.floor(self.selectedSlot)
		for ui = 1, self:PageSize() do
			local g = (page - 1) * self:PageSize() + ui
			self:RenderUISlot(ui, self:GetSlotData(g))
			self:HighlightUISlot(ui, selected == g)
		end
		self:UpdatePageUI()
		self:UpdateCreateButton()
	end

	method void RenderUISlot(number uiIdx, string data)
		-- 화면 슬롯 1칸을 데이터대로 그린다(빈 문자열이면 비운다).
		local slotBase = self:UISlotPath(uiIdx)
		local nameText = _EntityService:GetEntityByPath(slotBase .. "/NameText")
		local slotAvatar = _EntityService:GetEntityByPath(slotBase .. "/SlotAvatar")

		if data == "" then
			if isvalid(nameText) then nameText.TextComponent.Text = "" end
			if isvalid(slotAvatar) then slotAvatar.Enable = false end
			return
		end

		local parts = {}
		for part in string.gmatch(data, "([^|]+)") do
			table.insert(parts, part)
		end
		if #parts < 7 then return end

		-- data 포맷: 이름|얼굴|머리|상의|하의|신발|무기|직업|모자 (미착용 = "NONE" 또는 필드 없음)
		local charName   = parts[1]
		local faceRUID   = self:RuidField(parts[2])
		local hairRUID   = self:RuidField(parts[3])
		local topRUID    = self:RuidField(parts[4])
		local bottomRUID = self:RuidField(parts[5])
		local shoesRUID  = self:RuidField(parts[6])
		local weaponRUID = self:RuidField(parts[7])
		local capRUID    = self:RuidField(parts[9])

		if isvalid(nameText) then nameText.TextComponent.Text = charName end

		if isvalid(slotAvatar) then
			slotAvatar.Enable = true
			local cm = slotAvatar:GetComponent(CostumeManagerComponent)
			if isvalid(cm) then
				cm:SetEquip(MapleAvatarItemCategory.Body, "3cf4cb29ae344577b9eed37e531688a4")
				cm:SetEquip(MapleAvatarItemCategory.Face, faceRUID)
				cm:SetEquip(MapleAvatarItemCategory.Hair, hairRUID)
				cm:SetEquip(MapleAvatarItemCategory.Coat, topRUID)
				cm:SetEquip(MapleAvatarItemCategory.Pants, bottomRUID)
				cm:SetEquip(MapleAvatarItemCategory.Shoes, shoesRUID)
				if weaponRUID ~= "" then
					-- (버그 수정) 아바타 리소스 카테고리가 한손무기인 RUID를 TwoHandedWeapon 슬롯에 넣으면
					-- LEA-3005로 장착이 실패해 선택 화면 아바타에 무기가 안 보였다 - 카테고리에 맞는 슬롯으로 분기.
					if self:IsOneHandedWeaponRuid(weaponRUID) then
						cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, weaponRUID)
					else
						cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, weaponRUID)
					end
				else
					cm:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
					cm:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
				end
				-- 모자도 다른 장비처럼 지금 착용 중인 아이템을 그대로 보여준다 (없으면 맨머리)
				cm:SetEquip(MapleAvatarItemCategory.Cap, capRUID)
			end
		end
	end

	method void HighlightUISlot(number uiIdx, boolean on)
		-- 선택된 슬롯을 밝은 테두리 색으로 구분한다(12칸/4페이지라 선택 위치가 보이지 않으면 헷갈린다).
		local slotBG = _EntityService:GetEntityByPath(self:UISlotPath(uiIdx) .. "/SlotBG")
		if not isvalid(slotBG) then return end
		local spr = slotBG.SpriteGUIRendererComponent
		if not isvalid(spr) then return end
		if on then
			spr.Color = Color(0.24, 0.42, 0.78, 0.95)
		else
			spr.Color = Color(0.145098045, 0.168627456, 0.2901961, 0.85)
		end
	end

	method void UpdatePageUI()
		-- 페이지 표시("2 / 4")와 이전/다음 버튼 상태(끝 페이지에서는 흐리게).
		local base = "/ui/DefaultGroup/CharacterSelectGroup/SelectBackground/"
		local page = math.floor(self.currentPage)

		local pageText = _EntityService:GetEntityByPath(base .. "PageText")
		if isvalid(pageText) and isvalid(pageText.TextGUIRendererComponent) then
			pageText.TextGUIRendererComponent.Text = tostring(page) .. " / " .. tostring(self:PageCount())
		end

		self:SetPageButtonDim(base .. "PrevPageButton", page <= 1)
		self:SetPageButtonDim(base .. "NextPageButton", page >= self:PageCount())
	end

	method void SetPageButtonDim(string path, boolean dim)
		-- 더 이동할 페이지가 없는 방향의 버튼을 흐리게 표시한다(ButtonComponent에는 Interactable이 없다).
		local e = _EntityService:GetEntityByPath(path)
		if not isvalid(e) then return end
		local spr = e.SpriteGUIRendererComponent
		if not isvalid(spr) then return end
		if dim then
			spr.Color = Color(1, 1, 1, 0.35)
		else
			spr.Color = Color(1, 1, 1, 1)
		end
	end

	-- ══════════════════════════ 외부 호출용(전체 인덱스 기준) ══════════════════════════

	method void ClearSlotUI(number slotNum)
		-- 전체 인덱스 기준으로 슬롯을 비운다(현재 페이지에 보이는 칸일 때만 화면을 손댄다).
		if self:PageOfIndex(slotNum) ~= math.floor(self.currentPage) then return end
		self:RenderUISlot(self:UISlotOfIndex(slotNum), "")
	end

	method void ApplySlotDataToUI(number slotNum, string data)
		-- 전체 인덱스 기준으로 슬롯을 그린다(현재 페이지에 보이는 칸일 때만 화면을 손댄다).
		if data == "" then
			self:ClearSlotUI(slotNum)
			return
		end
		if self:PageOfIndex(slotNum) ~= math.floor(self.currentPage) then return end
		self:RenderUISlot(self:UISlotOfIndex(slotNum), data)
	end

	method boolean IsOneHandedWeaponRuid(string ruid)
		-- 아바타 리소스 카테고리가 onehandedweapon인 직업 지급 무기 RUID 목록 - TwoHandedWeapon 슬롯에
		-- SetEquip하면 LEA-3005가 나는 무기들(UIEquipInventoryManager.IsOneHandedJobWeapon의 RUID판).
		if ruid == "444f1da6365d4599a27bbfd207585856" then return true end -- 카알대검
		if ruid == "1489702f013a4ba4a1ec080da4df17c3" then return true end -- 후르츠 대거
		if ruid == "7380b5e5754a4e338e65fa232a8a095b" then return true end -- 나무 스태프
		if ruid == "061712eadf7d4357a6c306dfd5368860" then return true end -- 우드완드
		return false
	end

	method string RuidField(any v)
		-- 캐릭터 목록 데이터의 RUID 필드 해석: 없거나 "NONE"이면 미착용("")
		if v == nil then return "" end
		local s = tostring(v)
		if s == "NONE" then return "" end
		return s
	end

	method integer FilledCount()
		-- 현재 만들어져 있는 캐릭터 수(전체 페이지 합산).
		local count = 0
		for i = 1, self:MaxSlot() do
			if self:GetSlotData(i) ~= "" then
				count = count + 1
			end
		end
		return count
	end

	method integer FirstEmptySlot()
		-- 비어 있는 첫 전체 인덱스(없으면 0).
		for i = 1, self:MaxSlot() do
			if self:GetSlotData(i) == "" then return i end
		end
		return 0
	end

	method boolean HasName(string name)
		-- 같은 이름의 캐릭터가 이미 있는지(전체 페이지 검사).
		for i = 1, self:MaxSlot() do
			local d = self:GetSlotData(i)
			if d ~= "" then
				local n = string.match(d, "^([^|]+)")
				if n ~= nil and n == name then return true end
			end
		end
		return false
	end

	method void AddCharacter(number slotNum, string name, string faceRUID, string hairRUID, string topRUID, string bottomRUID, string shoesRUID, string weaponRUID, number jobIdx)
		if weaponRUID == "" then weaponRUID = "NONE" end
		local data = name .. "|" .. faceRUID .. "|" .. hairRUID .. "|" .. topRUID .. "|" .. bottomRUID .. "|" .. shoesRUID .. "|" .. weaponRUID .. "|" .. tostring(jobIdx)
		self:SetSlotData(slotNum, data)
		self:ApplySlotDataToUI(slotNum, data)
		self:UpdateCreateButton()
	end

	method void SelectSlot(number slotNum)
		-- 전체 인덱스 기준 선택. 다른 페이지의 캐릭터를 고르면 그 페이지로 따라 넘어간다.
		local n = math.floor(slotNum)
		self.selectedSlot = n
		if n >= 1 and n <= self:MaxSlot() then
			self.currentPage = self:PageOfIndex(n)
		end
		self:RefreshPage()
	end

	method void DeleteAndCompact(number targetSlot)
		-- 로컬 전용 삭제(서버 경유 삭제는 CharacterPersistence가 처리) - 뒤 캐릭터를 앞으로 당긴다.
		local remaining = {}
		for i = 1, self:MaxSlot() do
			if i ~= math.floor(targetSlot) then
				local d = self:GetSlotData(i)
				if d ~= "" then
					table.insert(remaining, d)
				end
			end
		end

		for i = 1, self:MaxSlot() do
			self:SetSlotData(i, "")
		end
		for i, data in ipairs(remaining) do
			self:SetSlotData(i, data)
		end

		self.selectedSlot = 0
		self:RefreshPage()
	end

	method void UpdateCreateButton()
		-- 12칸이 모두 차면 "새 캐릭터 만들기" 버튼을 숨긴다.
		local createBtn = _EntityService:GetEntityByPath("/ui/DefaultGroup/CharacterSelectGroup/SelectBackground/CreateCharacterButton")
		if isvalid(createBtn) then
			createBtn.Enable = self:FilledCount() < self:MaxSlot()
		end
	end

end
