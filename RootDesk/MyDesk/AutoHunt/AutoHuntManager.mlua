@Logic
script AutoHuntManager extends Logic

	-- (M2) 자동사냥: F7 토글 - 용사 소환처럼 몬스터를 따라다니며, 스킬바에 배정된 스킬들을
	-- 용도(버프/소환수/광역/단일)에 맞게 알아서 골라 쓴다.
	-- · 이동: 클라 권한. 자동 이동 중에만 PlayerController를 끈다(입력 0이 이동을 덮는 문제) - 정지/OFF 시 복구.
	-- · 위/아래 발판 대상은 점프/다운점프로 따라간다. 걷기/정지 모션은 StateComponent WALK/IDLE로 맞춘다.
	-- · 동선은 하강 순환: 위(SpawnLocation)에서 시작해 아래층 적이 3배 이상 가까우면 다운점프로
	--   내려가며 사냥하고, 맨아래에서 사냥감이 끊기면 SpawnLocation으로 복귀해 다시 내려온다.
	-- · 공격/버프 시전은 전부 실제 버튼 경로(UseSkillInSlot)라 모션·쿨다운·위력 배율이 수동과 동일하다.
	property boolean autoOn = false

	-- 로프 등반 속도 계수(요청 2026-08-09). MoveToDirection에 넘길 델타에 곱한다.
	-- 이력: 1.0 = 실측 2.0유닛/초(달리기와 비슷해 너무 빠름) → 0.45 = 약 0.5유닛/초(느리다는 신고)
	--       → 0.675 = 약 0.76유닛/초 → 1.0125 = 약 1.14유닛/초 (요청: 다시 "1.5배").
	property number RopeClimbSpeedFactor = 1.0125
	property any keyHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		log("[AutoHunt] ready (F7 토글)")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.keyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
			self.keyHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- 자동사냥 토글 키는 키설정창(기능 "autohunt", 기본 F7)에서 바꿀 수 있다 - 강화창과 동일한 기능 매핑 판정.
		if _KeySettingManager:IsCapturingKey() then return end
		if _KeySettingManager:GetFuncForKeyEnum(event.key) ~= "autohunt" then return end
		self:Toggle()
	end

	@ExecSpace("ClientOnly")
	method void Toggle()
		self.autoOn = not self.autoOn
		local keyName = _KeySettingManager:GetKeyForFunc("autohunt")
		if keyName == "" then keyName = "F7" end
		if self.autoOn then
			self._T.target = nil
			self._T.chaseStart = _UtilLogic.ElapsedSeconds
			self._T.elemDwellUntil = nil   -- (팔라딘) 속성 순환 주기 초기화 - 켜자마자 전환하지 않게 ElementChainTick이 새로 잡는다
			self._T.noTargetSince = nil   -- 이전 세션 잔재로 켜자마자 복귀하는 것 방지
			_UIToast:ShowMessage("자동사냥 시작 (" .. keyName .. "로 중지)")
		else
			_UIToast:ShowMessage("자동사냥 중지")
			self._T.elemDwellUntil = nil
			self._T.rideFlight = false   -- (다크나이트) 비행 이동 중 OFF - 탑승 상태는 유저 조작에 맡긴다
			self:StopMoving()
		end
		-- (팔라딘) 서버 자동 가드(피격 타이밍 25% 자동 발동) 상태 동기화 - 가드 투자 레벨 동봉.
		_SkillManager:RequestSetAutoHuntState(self.autoOn, _SkillManager:GetHeroSkillLevelByName("가드"))
		log("[AutoHunt] " .. (self.autoOn and "ON" or "OFF"))
	end

	-- (P2) 자동 HP 물약: HP 30% 이하면 소비 탭의 HP포션을 자동 사용한다 (1초 주기 검사).
	-- 포션 힐(2초 간격 5틱)이 진행되는 동안은 다시 쓰지 않는다 - PotionShopManager의
	-- "이미 진행 중" 거부에 아이템만 소모되는 사고 방지.
	@ExecSpace("ClientOnly")
	method void TryAutoPotion(number now, Entity player)
		if (self._T.nextPotionCheck or 0) > now then return end
		self._T.nextPotionCheck = now + 1.0
		if (self._T.potionHealUntil or 0) > now then return end
		local pc = player.PlayerComponent
		if not isvalid(pc) then return end
		local maxHp = pc.MaxHp or 0
		if maxHp <= 0 then return end
		local hp = pc.Hp or 0
		if hp / maxHp > 0.3 then return end
		-- 소비 탭에서 HP포션 탐색 (이름이 첫 필드)
		for i = 1, 128 do
			local s = _UIEquipInventoryManager:GetTabItem("consume", i)
			if s ~= "" and string.find(s, "HP포션", 1, true) == 1 then
				-- (유실 방지) 수동 사용과 공용 게이트(TryUsePotion)로 통일 - 수락 시에만 아이템 소모.
				if not _PotionShopManager:TryUsePotion() then return end
				self._T.potionHealUntil = now + 10.5   -- 힐 5틱(2초 간격) + 여유
				_UIEquipInventoryManager:SetTabItem("consume", i, "")
				_UIEquipInventoryManager:RefreshUI()
				log("[AutoHunt] 자동 HP포션 사용 (HP " .. tostring(hp) .. "/" .. tostring(maxHp) .. ")")
				return
			end
		end
	end

	-- (P2) 몬스터 전멸 시 배회: 걷기(1~2초)와 대기(1~2.5초)를 교대하며 리젠을 기다린다.
	-- 발판 끝에 다다르면 방향을 반전해 떨어지지 않는다. 대상이 다시 잡히면 즉시 추적으로 복귀.
	@ExecSpace("ClientOnly")
	method void WanderTick(number now, Entity player, number delta)
		if (self._T.wanderPhaseUntil or 0) <= now then
			if self._T.wanderWalking == true then
				self._T.wanderWalking = false
				self._T.wanderPhaseUntil = now + 1.0 + _UtilLogic:RandomDouble() * 1.5
				self:StopMoving()
			else
				-- ⚠ (신고 2026-08-09) "다 잡은 층에서 좌우를 두리번거린다"의 원인:
				--   예전엔 방향을 **먼저 정하고 걷다가** 발판 끝에서 되돌렸다. 짧은 발판에서는 그 되돌림이
				--   매 구간 반복돼, 실제로는 거의 못 움직이면서 몸만 좌우로 도는 모습이 됐다.
				--   → 걷기 구간에 들어가기 **전에** 실제로 걸을 수 있는 방향을 먼저 확인한다.
				-- ⚠⚠ (버그 수정 2026-08-09, 실측으로 확정) **PredictFootholdEnd의 극성이 정반대로 쓰이고 있었다.**
				--   `.d.mlua` 원문: "Checks whether you can move the distance from the step you are currently
				--   stepping on" → **true = 그 거리만큼 갈 수 있다 / false = 발판 끝이라 못 간다.**
				--   실측(map01, y=-1.25 지면 x[-2.76~4.44], 캐릭터를 좌표별로 옮겨가며 측정):
				--     x=0.00(가운데)  R=true  L=true      x=2.00(가운데)  R=true  L=true
				--     x=4.20(오른끝)  R=false L=true      x=4.40(오른끝)  R=false L=true
				--     x=-2.60(왼끝)   R=true  L=false     x=-2.72(왼끝)   R=true  L=false
				--   → 조각(0.9유닛)으로 쪼개진 지형에서도 **체인을 따라** 판정한다. 예전 주석의
				--     "조각 경계마다 true라 엣지 감지에 못 쓴다"는 오진이었다 - 가운데에서 true인 건
				--     오탐이 아니라 "갈 수 있다"는 정답이었다.
				--   그래서 `not`을 붙인 이 코드는 **지형 한가운데서 canRight/canLeft가 둘 다 false**가 되어
				--   아래 "양쪽 다 막힘" 분기로 빠졌다 → 배회가 3~5초 대기만 반복하며 **제자리에 얼어붙고**,
				--   반대로 진짜 발판 끝에서만 "걸을 수 있다"고 판단했다(신고 "언덕에 잘 대응하지 못한다 /
				--   양쪽을 왔다갔다 하지 못한다"의 직접 원인).
				local rbPick = player.RigidbodyComponent
				local canRight = true
				local canLeft = true
				if isvalid(rbPick) and rbPick:IsOnGround() then
					canRight = rbPick:PredictFootholdEnd(0.4, true)
					canLeft = rbPick:PredictFootholdEnd(0.4, false)
				end
				if not canRight and not canLeft then
					-- 양쪽 다 막힘 = 설 자리만 있는 좁은 발판. **방향도 건드리지 않고** 그냥 쉰다
					-- (여기서 방향을 바꾸면 그게 바로 두리번거림이 된다).
					self._T.wanderWalking = false
					self._T.wanderPhaseUntil = now + 3.0 + _UtilLogic:RandomDouble() * 2.0
					self:StopMoving()
					return
				end
				self._T.wanderWalking = true
				-- 이전 방향을 70% 이어가되, 그쪽이 막혀 있으면 열린 쪽으로 간다.
				local prevDir = self._T.wanderDir
				if prevDir ~= 1 and prevDir ~= -1 then
					prevDir = (_UtilLogic:RandomDouble() < 0.5) and -1 or 1
				end
				local wantDir = prevDir
				if _UtilLogic:RandomDouble() >= 0.7 then wantDir = -prevDir end
				if wantDir > 0 and not canRight then wantDir = -1 end
				if wantDir < 0 and not canLeft then wantDir = 1 end
				self._T.wanderDir = wantDir
				-- 한 방향으로 충분히 이동해야 리젠 지점을 훑는다(구간 1.0~2.0초 → 1.6~3.2초).
				self._T.wanderPhaseUntil = now + 1.6 + _UtilLogic:RandomDouble() * 1.6
				log("[AutoHunt] 배회 걷기 dir=" .. tostring(self._T.wanderDir))
			end
		end
		if self._T.wanderWalking == true then
			-- 발판 끝 감지 → 방향 반전 (떨어짐 방지)
			-- ⚠ (신고 2026-08-09) 여기에 쿨다운이 없어서, 발판이 짧으면 반전 직후 반대쪽 끝도 곧바로
			--   걸려 **매 프레임 좌우로 튀는** 진동이 났다("좌우로 빠르게 반복"의 직접 원인).
			--   0.7초 안에 다시 반전해야 하는 상황 = 발판이 너무 짧다는 뜻이므로, 더 튕기지 말고
			--   이번 걷기 구간을 접고 대기로 넘어간다.
			local rb = player.RigidbodyComponent
			-- 발판 끝에 닿으면 **되돌지 않고 그대로 멈춘다.**
			-- ⚠ 예전엔 여기서 방향을 반전했는데, 그 반전이 곧 "두리번거림"이었다. 출발 방향은 위에서
			--   이미 "걸을 수 있는 쪽"으로 골랐으니, 끝에 닿았다는 건 이 방향으로 다 걸었다는 뜻이다 -
			--   자연스럽게 멈춰 쉬고, 다음 구간에서 열린 방향을 새로 고르면 된다.
			-- 예측 거리 0.4(구 0.6): 0.6이면 좌우 합쳐 1.2유닛 이상인 발판에서만 걸을 수 있어,
			-- 이 맵처럼 짧은 턱이 많은 지형에서는 배회가 매번 즉시 중단됐다(실측).
			-- ⚠ (버그 수정 2026-08-09) 위 canRight/canLeft와 **같은 극성 오류**가 여기에도 있었다 -
			--   PredictFootholdEnd는 "갈 수 있으면 true"라, `not` 없이 쓰면 **길이 열려 있을 때 멈추고**
			--   진짜 발판 끝에서는 계속 걸어 떨어졌다. 멈춰야 하는 건 false(= 더 못 간다)일 때다.
			if isvalid(rb) and rb:IsOnGround() and not rb:PredictFootholdEnd(0.4, (self._T.wanderDir or 1) > 0) then
				-- (신고 2026-08-09) 끊긴 게 **절벽이 아니라 뛰어 올라설 턱**이면 멈추지 말고 넘어간다 -
				-- 그래야 리젠을 기다리는 동안에도 위/아래 단을 오가며 넓게 훑는다(추적 경로와 같은 판정).
				if self:TryStepUpOverWall(player, player.TransformComponent.WorldPosition,
					(self._T.wanderDir or 1), now) then
					return
				end
				self._T.wanderWalking = false
				self._T.wanderPhaseUntil = now + 1.0 + _UtilLogic:RandomDouble() * 1.5
				self:StopMoving()
				return
			end
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) then
				if pcc.Enable then pcc.Enable = false end
				pcc.LookDirectionX = self._T.wanderDir or 1
			end
			player.MovementComponent:MoveToDirection(Vector2(self._T.wanderDir or 1, 0), delta)
			self._T.moving = true
			local sc = player.StateComponent
			if isvalid(sc) and sc.CurrentStateName == "IDLE" then
				sc:ChangeState("MOVE")
			end
			-- (신고) 배회 걷기 중에도 지형 턱에 끼면 점프로 탈출한다.
			self:CheckStuckAndJump(now, player, player.TransformComponent.WorldPosition)
		end
	end

	-- (섬광 등 조준 스킬 연동) 자동사냥이 켜져 있는지 - SkillManager가 조준 대체 여부 판단에 쓴다.
	@ExecSpace("ClientOnly")
	method boolean IsActive()
		return self.autoOn == true
	end

	-- 자동사냥이 지금 스스로 걷는 중인지(컨트롤러를 끄고 MoveToDirection으로 이동).
	-- PlayerAttack의 방향 잠금 강제 IDLE이 이 걷기와 싸우며 MOVE↔IDLE로 튕기지 않게,
	-- 걷는 동안은 방향 잠금이 물러나는 판단(ShouldEnforceDirectionLock)에 쓰인다.
	@ExecSpace("ClientOnly")
	method boolean IsAutoMoving()
		return self.autoOn == true and self._T.moving == true
	end

	-- 현재 대상 쪽 수평 조준 방향(-1/1). 대상이 없으면 바라보는 방향(LookDirectionX)을 쓴다.
	@ExecSpace("ClientOnly")
	method number GetAimDirX()
		if self._T.aimDirX ~= nil then return self._T.aimDirX end
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) and pcc.LookDirectionX < 0 then return -1 end
		end
		return 1
	end

	-- 현재 대상 쪽 수직 조준 방향(-1/0/1). 위아래로 제법 떨어진(|dy|≥1.2) 대상일 때만 ±1.
	@ExecSpace("ClientOnly")
	method number GetAimDirY()
		return self._T.aimDirY or 0
	end

	-- ── 스킬 용도 분류 ─────────────────────────────────────────────────────
	-- 스킬바에 배정된 스킬을 역할별로 나눈다. 미분류 스킬은 "manual"(자동사냥이 건드리지 않음).
	@ExecSpace("ClientOnly")
	method string GetSkillRole(string skillName)
		local roles = {
			-- 버프 (지속형 - 만료 전 주기 재시전)
			["부스터"] = "buff", ["분노"] = "buff", ["파워가드"] = "buff", ["메디테이션"] = "buff",
			["블레스"] = "buff", ["헤이스트"] = "buff", ["샤프 아이즈"] = "buff",
			["콤보 어택"] = "buff", ["홀리 매직쉘"] = "buff", ["브랜디쉬 강화"] = "buff",
			["불의 영역"] = "buff", ["빙하지대"] = "buff", ["발도술"] = "buff",
			-- (다크나이트) 드래곤 블러드: HP를 계속 소모하는 유지형이라 HP 게이트 + 버프바 잔여 확인이
			-- 필요한 전용 역할(주기 재시전만 하는 일반 buff와 다름 - DragonBloodTick 참고)
			["드래곤 블러드"] = "dragonblood",
			-- (다크나이트) 드래곤 라이딩: 미소환+쿨 종료 상태에서만 "소환"으로 사용(활성 중 재시전=탑승이라 금지)
			["드래곤 라이딩"] = "dragonride",
			-- (팔라딘) 아이언 월/속성필드도 지속형 버프 - 주기는 GetBuffPeriod가 투자 레벨로 계산
			["아이언 월"] = "buff", ["속성필드"] = "buff",
			-- (나이트로드) 지속시간형 버프 2종 - 주기는 GetBuffPeriod가 투자 레벨로 계산한다.
			--   · 암행: 1분+분배당 10초 (온히트 그림자 표창)
			--   · 쉐도우 파트너: 30초+분배당 10초 (표창 100개 소모 - 재고가 모자라면 자동으로 낮은
			--     번호 표창으로 내려가므로 시전 자체는 항상 성공한다)
			-- (섀도어, 2026-08-06) 암행2도 토글 → 지속시간 버프가 되면서 암행1과 같은 주기 유지 대상이 됐다.
			["암행"] = "buff", ["쉐도우 파트너"] = "buff", ["암행2"] = "buff",
			-- (나이트로드) 각성: 쿨 5분 고정 - 돌면 바로 쓰는 게 이득이라 전용 역할로 뺀다.
			["각성"] = "awakening",
			-- (나이트로드, 요청 2026-08-05) 드레인 샷: HP 보충기 전용 역할 - HP가 깎여 있으면
			-- 자체 쿨(5초)이 돌 때마다 로테이션에 앞서 우선 사용한다(TryAttackCast 상단 참고).
			["드레인 샷"] = "drainshot",
			-- (팔라딘) 리스토네이션: HP가 풀이 아닐 때만 30~60초 주기 회복 (요청)
			["리스토네이션"] = "restoration",
			-- (비숍, 요청 2026-08-11) 힐: 저체력 소환수 응급 치유 전용 역할(TryHealSummonTick).
			["힐"] = "heal",
			-- (팔라딘) 궁병 지원: 120~150초 주기 사용 (요청)
			["궁병 지원"] = "archer",
			-- (팔라딘) 차지 블로우 속성 전환 4종: 전투 중 속성 순환/연계(ElementChainTick)가 쓴다
			["디바인 스윙 강화"] = "chargemode", ["디바인 스티그마 강화"] = "chargemode",
			["디바인 저지먼트 강화"] = "chargemode", ["디바인 차지"] = "chargemode",
			-- 소환수 (주기 재소환 - 재사용 시 교체되는 기존 동작 활용)
			["용사 소환"] = "summon", ["힐러 소환"] = "summon", ["용 소환"] = "summon",
			-- (비숍 개편 2026-08-08) 소환 3종 - 용사 소환과 완전히 같은 규격이라 역할도 같다.
			["궁수 소환"] = "summon", ["도적 소환"] = "summon",
			["서먼 다크드래곤"] = "summon", ["바하뮤트"] = "summon", ["프리져"] = "summon",
			["피닉스"] = "summon", ["이프리트"] = "summon", ["엘퀴네스"] = "summon",
			-- 광역 (주변에 몬스터가 몰렸을 때 우선)
			["슬래시블러스트"] = "aoe", ["브랜디쉬"] = "aoe", ["돌진"] = "aoe", ["차지 블로우"] = "aoe",
			["블리자드"] = "aoe", ["메테오"] = "aoe", ["제네시스"] = "aoe", ["체인라이트닝"] = "aoe",
			["샤이닝 레이"] = "aoe", ["드래곤 로어"] = "aoe", ["트리플 스로우"] = "aoe",
			["쿼드러플 스로우"] = "aoe", ["아이스 샷"] = "aoe",
			-- (신궁, 요청 2026-08-06) 스트레이프는 화살 4발이 **적 하나**를 4번 때리는 단일 대상기다 -
			-- aoe로 두면 몰렸을 때 가중 3.0을 받아 진짜 광역인 아이스 샷을 밀어냈다(새비지블로우와 같은 이유).
			["스트레이프"] = "single",
			-- (섀도어 개편 2026-08-06) 새비지블로우는 전방 1명을 6번 때리는 **단일 대상** 스킬이라
			-- single로 옮긴다(광역으로 두면 몰렸을 때 가중 3.0을 받아 암살 주력을 밀어냈다).
			-- 어썰터/암살은 주변을 함께 치는 광역이라 aoe 그대로.
			["에로우 봄"] = "aoe", ["어썰터"] = "aoe", ["암살"] = "aoe",
			-- (섀도어) 다크사이트/연막은 전용 역할 - 로테이션이 아니라 자기 규칙으로 시전한다.
			["다크사이트"] = "darksight", ["연막"] = "smokescreen",
			-- (섀도어) 분신 소환: 살아 있을 때 다시 누르면 **위치 교환**이라 일반 summon으로 두면 안 된다
			-- (드래곤 라이딩과 같은 이유) - 미소환 + 쿨 종료일 때만 소환하는 전용 역할.
			["분신 소환"] = "shadowclone",
			["익스플로젼"] = "aoe", ["포이즌 미스트"] = "aoe", ["파이어 샷"] = "aoe",
			["폭풍의 시"] = "aoe",
			-- (다크나이트) 스피어 버스터: 3차 주력 광역 - 미분류라 자동사냥이 아예 안 쓰던 것 수정
			["스피어 버스터"] = "aoe",
			-- 이동기: 위아래로 제법 떨어진 대상 추적 전용 (요청 - 가까운 적에게는 쓰지 않는다)
			["섬광"] = "mobility",
			-- 대시: 같은 층의 먼 대상(3유닛↑) 접근 가속 (요청 - 이동 시 대시 스킬 활용)
			["러시"] = "dash",
			-- 단일 (기본 로테이션)
			["파워스트라이크"] = "single", ["럭키세븐"] = "single", ["더블스탭"] = "single",
			["새비지블로우"] = "single",
			["매직클로"] = "single", ["더블샷"] = "single",
			-- (요청 2026-08-09, 히어로 3차) 패닉/코마는 **콤보 구슬을 전량 소모하는 같은 자원**을 놓고
			-- 다투므로 확률 로테이션에 두면 안 된다 - 구슬 1개짜리 패닉이 계속 새어 나가 코마가 구슬을
			-- 모을 기회를 빼앗는다. 스나이핑/피어싱처럼 **자기 규칙**을 가진 전용 역할로 뺀다.
			--   · 코마 = 구슬 수에 비례해 범위가 커지는 전방위 다수기(TryComaCast)
			--   · 패닉 = 잘 죽지 않는 단일 대상(보스/탱커) 전용(TryPanicCast)
			-- ⚠ 특히 코마를 "single"로 두면 몰렸을 때 가중이 0.15로 **깎여서** 정작 쓸 자리에서 안 나갔다.
			["패닉"] = "panic", ["코마"] = "coma",
			["매직 미사일"] = "single", ["썬더볼트"] = "single", ["파이어에로우"] = "single",
			["홀리 에로우"] = "single", ["엔젤레이"] = "single", ["에로우 블로우"] = "single",
			["아이언 에로우"] = "single",
			["속사"] = "single", ["어벤져"] = "single",
			-- (신궁, 요청 2026-08-06) 체인샷은 **이동기**다 - 8방향으로 체인을 박고 그 각도로 당겨져
			-- 날아간다(지나친 적도 때리지만 주목적은 이동). 공격 로테이션에서 빼고 섬광과 같은 자리에 둔다.
			["체인샷"] = "chainshot",
			-- (신궁, 요청 2026-08-06) 스나이핑은 좌우 직선만 때리는 관통 3명 차지기 - 확률 로테이션이
			-- 아니라 "직선상에 적이 여럿일 때 + 대상 HP에 맞춘 차징"이라는 자기 규칙으로 쓴다.
			["스나이핑"] = "sniping",
			-- (신궁 2026-08-06 신설) 피어싱도 같은 차지 구조라 전용 역할이 필요하다 - 일반 로테이션에
			-- 넣으면 UseSkillInSlot이 차지를 "시작"만 하고 아무도 떼주지 않아 눌린 채로 굳는다.
			["피어싱"] = "piercing",
			-- (썬콜, 요청 2026-08-08) 텔레포트 = 이동기(수직 2.31유닛 도약 / 수평 접근 가속) - 전용 역할.
			["텔레포트"] = "teleport",
			-- (썬콜, 요청 2026-08-08) 리커버리 오로라 = 주변 노쿨 설치기. 블리자드 난사 콤보의 축이라
			-- 일반 버프 주기가 아니라 자체 쿨 종료 즉시 재설치하는 전용 역할로 뺀다.
			["리커버리 오로라"] = "recoveryaura",
			-- (불독, 2026-08-08) 리커버리 마나 = 리커버리 오로라의 불독판(같은 오로라 + MP 회복) -
			-- 쿨타임 상태도 SkillManager에서 공유하므로 역할도 같다(메테오 난사 콤보의 축).
			["리커버리 마나"] = "recoveryaura",
		}
		return roles[skillName] or "manual"
	end

	-- 스킬바 전체를 스캔해 역할별 슬롯 목록을 만든다 (5초 캐시).
	@ExecSpace("ClientOnly")
	method void RefreshSlotRoles()
		local now = _UtilLogic.ElapsedSeconds
		if self._T.roleCacheUntil ~= nil and self._T.roleCacheUntil > now then return end
		self._T.roleCacheUntil = now + 5.0
		local buffs, summons, aoes, singles, mobilities, dashes = {}, {}, {}, {}, {}, {}
		local restorations, archers, chargemodes, dragonbloods, dragonrides = {}, {}, {}, {}, {}
		local heals = {}
		local awakenings = {}
		local drainshots = {}
		local darksights, smokescreens, shadowclones = {}, {}, {}
		-- (신궁 2026-08-06) 체인샷 = 이동기 / 스나이핑 = 자기 규칙 차지기.
		local chainshots, snipings, piercings = {}, {}, {}
		-- (썬콜 2026-08-08) 텔레포트 = 이동기 / 리커버리 오로라 = 노쿨 설치기.
		local teleports, recoveryauras = {}, {}
		-- (히어로 3차 2026-08-09) 코마 = 구슬 비례 범위 다수기 / 패닉 = 탱커 전용 단일기.
		local comas, panics = {}, {}
		local hotkeys = _SkillManager:ExportHotkeys()
		for key, slot in pairs(hotkeys) do
			if slot ~= nil and slot.name ~= nil and slot.name ~= "" then
				local role = self:GetSkillRole(slot.name)
				-- (요청 2026-08-10) 속성필드는 버프 목록 맨 앞 - 차지 블로우 속성 연계(ElementChainTick)의
				-- 전제 버프라 꺼져 있으면 필드가 안 깔린다. 여러 버프가 동시에 밀렸을 때 가장 먼저 되살린다.
				if role == "buff" and slot.name == "속성필드" then table.insert(buffs, 1, { key = key, name = slot.name })
				elseif role == "buff" then table.insert(buffs, { key = key, name = slot.name })
				elseif role == "summon" then table.insert(summons, { key = key, name = slot.name })
				elseif role == "aoe" then table.insert(aoes, { key = key, name = slot.name })
				elseif role == "single" then table.insert(singles, { key = key, name = slot.name })
				elseif role == "mobility" then table.insert(mobilities, { key = key, name = slot.name })
				elseif role == "dash" then table.insert(dashes, { key = key, name = slot.name })
				elseif role == "restoration" then table.insert(restorations, { key = key, name = slot.name })
				elseif role == "heal" then table.insert(heals, { key = key, name = slot.name })
				elseif role == "archer" then table.insert(archers, { key = key, name = slot.name })
				elseif role == "chargemode" then table.insert(chargemodes, { key = key, name = slot.name })
				elseif role == "dragonblood" then table.insert(dragonbloods, { key = key, name = slot.name })
				elseif role == "dragonride" then table.insert(dragonrides, { key = key, name = slot.name })
				elseif role == "awakening" then table.insert(awakenings, { key = key, name = slot.name })
				elseif role == "drainshot" then table.insert(drainshots, { key = key, name = slot.name })
				elseif role == "darksight" then table.insert(darksights, { key = key, name = slot.name })
				elseif role == "smokescreen" then table.insert(smokescreens, { key = key, name = slot.name })
				elseif role == "shadowclone" then table.insert(shadowclones, { key = key, name = slot.name })
				elseif role == "chainshot" then table.insert(chainshots, { key = key, name = slot.name })
				elseif role == "sniping" then table.insert(snipings, { key = key, name = slot.name })
				elseif role == "piercing" then table.insert(piercings, { key = key, name = slot.name })
				elseif role == "teleport" then table.insert(teleports, { key = key, name = slot.name })
				elseif role == "recoveryaura" then table.insert(recoveryauras, { key = key, name = slot.name })
				elseif role == "coma" then table.insert(comas, { key = key, name = slot.name })
				elseif role == "panic" then table.insert(panics, { key = key, name = slot.name })
				end
			end
		end
		self._T.slotBuffs = buffs
		self._T.slotSummons = summons
		self._T.slotAoes = aoes
		self._T.slotSingles = singles
		self._T.slotMobilities = mobilities
		self._T.slotDashes = dashes
		self._T.slotRestorations = restorations
		self._T.slotHeals = heals
		self._T.slotArchers = archers
		self._T.slotChargemodes = chargemodes
		self._T.slotDragonBloods = dragonbloods
		self._T.slotDragonRides = dragonrides
		self._T.slotAwakenings = awakenings
		self._T.slotDrainShots = drainshots
		self._T.slotDarkSights = darksights
		self._T.slotSmokeScreens = smokescreens
		self._T.slotShadowClones = shadowclones
		self._T.slotChainShots = chainshots
		self._T.slotSnipings = snipings
		self._T.slotPiercings = piercings
		self._T.slotTeleports = teleports
		self._T.slotRecoveryAuras = recoveryauras
		self._T.slotComas = comas
		self._T.slotPanics = panics
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- (신고 2026-08-04) 수동 조작 중에도 지형 턱/발판 이음매에 끼어 좌우 이동이 안 먹는 경우가
		-- 있다 - 자동사냥이 꺼져 있어도 수동 끼임 탈출 감시는 항상 돌린다(자동사냥 중에는 기존
		-- CheckStuckAndJump가 담당하므로 중복 방지를 위해 OFF일 때만).
		if not self.autoOn then
			local mp = _UserService.LocalPlayer
			if isvalid(mp) then self:ManualStuckTick(mp) end
			return
		end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		-- 사망 중에는 일시정지 (부활하면 자동 재개)
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "DEAD" then
			self:StopMoving()
			return
		end
		local now = _UtilLogic.ElapsedSeconds

		-- (다크나이트, 요청 사양) 드래곤 라이딩 = "이동할 때만 탑승"하는 이동기.
		-- ① 자동사냥이 스스로 탑승한 비행 이동(rideFlight) 중이면 목표점까지 날아가고 도착 즉시 하차한다
		--    (하차한 드래곤은 소환수로서 따로 공격). 비행 시작은 아래 추적 분기(위층 대상)에서 건다.
		-- ② 그 외의 탑승(수동 탑승 등 - 비행 목표가 없는 상태)은 다른 스킬이 전부 막히고
		--    조작이 충돌하므로 자동 하차한다.
		if _SkillManager:IsDragonRideMounted() then
			if self._T.rideFlight == true then
				self:RideFlightTick(now, player, delta)
			elseif (self._T.nextDismount or 0) <= now then
				self._T.nextDismount = now + 1.5
				_SkillManager:ToggleDragonRide()
				log("[AutoHunt] 목표 없는 탑승 감지 - 자동 하차 (비행과 자동 이동 충돌 방지)")
			end
			return
		end
		self._T.rideFlight = false   -- 하차 상태면 비행 플래그 정리(안전망)

		-- (신고) 자동 점프/다운점프의 착지 복귀: 컨트롤러가 꺼진 동안 JUMP/FALL 상태로 남으면
		-- 이후 걷기/대기 모션이 안 나온다 - 점프 0.35초 뒤부터 착지가 확인되면 IDLE로 되돌린다.
		if (self._T.jumpedAt or 0) > 0 and now - self._T.jumpedAt > 0.35 then
			local rbLand = player.RigidbodyComponent
			if isvalid(rbLand) and rbLand:IsOnGround() then
				if isvalid(sc) and (sc.CurrentStateName == "JUMP" or sc.CurrentStateName == "FALL") then
					sc:ChangeState("IDLE")
				end
				self._T.jumpedAt = 0
			end
		end

		-- (P2) 자동 HP 물약: 위급 상황이라 홀드보다 먼저 본다
		self:TryAutoPotion(now, player)

		-- (신고 2026-08-06) "암살의 투명이 풀리기 전에 이곳저곳 이동한다"
		-- 암살은 **몸이 사라진 채 제자리에서** 연쇄 타격을 하고 그 자리로 돌아오는 연출이다. 그 사이에
		-- 자동사냥이 계속 걸어 다니면 보이지 않는 몸이 옮겨 다녀서, 복귀했을 때 엉뚱한 곳에 서 있게 된다.
		-- 사라져 있는 동안에는 이동/점프/대상 재선정을 전부 멈춘다(시전은 SkillManager가 이미 막는다 -
		-- 암살 중에는 암살 외 스킬 입력이 전부 거부된다). 물약은 위급 상황이라 위에서 먼저 처리한다.
		if _SkillManager:IsAssassinateActive() then
			if self._T.moving == true then self:StopMoving() end
			-- (실측) StopMoving 한 번만으로는 걷던 관성이 남아 0.1~0.4유닛 더 미끄러진다 - 사라져 있는
			-- 동안에는 매 틱 멈춰 세워 제자리를 지킨다.
			local mvAs = player.MovementComponent
			if isvalid(mvAs) then mvAs:Stop() end
			-- 정지 구간을 "끼임"으로 오판하지 않게 샘플을 비운다(시전 홀드와 같은 처리).
			self._T.stuckLastX = nil
			self._T.stuckLastY = nil
			return
		end

		-- (버그 수정) 시전 모션 홀드: 방금 스킬을 시전했다면 모션·잠금이 끝날 때까지
		-- 이동/점프/재선정을 하지 않는다 - 모션이 끝나기 전에 걸어나가 스윙이 끊기는 문제 방지.
		if (self._T.holdMoveUntil or 0) > now then
			-- 시전 홀드 동안의 정지를 "끼임"으로 오판하지 않게 샘플을 비운다 (재개 후 새로 잰다)
			self._T.stuckLastX = nil
			self._T.stuckLastY = nil
			return
		end
		-- (요청) 파이널어택 모션 존중: 스윙 모션 가드(파워스트라이크/슬래시블러스트/파이널어택/브랜디쉬)가
		-- 켜져 있는 동안은 다음 행동을 하지 않는다 - 파이널어택은 60% 확률 후발동이라 고정 홀드로는 못 잡는다.
		---@type PlayerAttack
		local paGuard = player:GetComponent(PlayerAttack)
		if isvalid(paGuard) and paGuard:IsBrandishMotionGuardOn() then
			-- 가드가 풀린 직후를 알기 위해 마지막으로 켜져 있던 시각을 남긴다.
			self._T.motionGuardLastOn = now
			return
		end
		-- (신고 2026-08-09) 가드 해제 직후 곧바로 다음 행동(특히 다운점프)을 하면, 공격 모션이 빼둔
		-- FALL/JUMP 액션시트 매핑이 아직 복구되기 전이라 **모션 없이 선 자세로 내려간다**.
		-- 근본 수정은 PlayerAttack.RestoreBrandishStateMotions를 Multicast로 바꾼 것이고, 이건 그 전파를
		-- 확실히 기다리기 위한 얇은 유예다(0.12초).
		if (self._T.motionGuardLastOn or -99) + 0.12 > now then
			return
		end

		self:RefreshSlotRoles()

		-- 대상 탐색 (0.3초 주기 캐시)
		-- ⚠ (버그 수정 2026-08-09) 로프 등반 중에는 재탐색을 멈춘다. 0.3초마다 최근접 대상이 바뀌면
		--   그때마다 EndRopeClimb("대상 변경")이 걸려 **등반이 시작되자마자 취소되는 무한 루프**가 된다
		--   (실측: 5초에 시작 16회/취소 16회). 등반은 자체 타임아웃이 있으니 여기서 고정해도 안전하다.
		-- (요청 2026-08-11) climb(매달림) 중에는 대상이 죽거나 사라져도 등반을 완주하므로, 대상
		--   유무와 무관하게 재탐색을 계속 잠근다 - 안 잠그면 "대상 변경"이 완주 중 등반을 끊는다.
		local ropeBusy = ((self._T.ropeState or "") == "climb")
			or (((self._T.ropeState or "") ~= "") and isvalid(self._T.target))
		-- (요청 2026-08-10) **대상 잠금 5초** - 한 번 목표를 정했으면 5초 안에는 다른 몬스터로 갈아타지
		--   않는다. 0.3초마다 "최근접"으로 다시 고르는 구조라, 리젠/몬스터 이동으로 최근접이 바뀔 때마다
		--   목표가 흔들려 왔다 갔다 하는 이해할 수 없는 동선이 나왔다(신고: 맵 좌측 아래).
		--   ⚠ 잠금은 **대상이 살아 있을 때만** 건다 - 죽었거나 사라졌으면 즉시 새로 고른다(대부분의
		--     대상은 5초 안에 죽으므로 실제로 지연이 체감되는 구간은 거의 없다).
		--   ⚠ 포기 경로는 잠금과 무관하게 살아 있다 - 5초 추적 타임아웃 / 끼임 3회 / 다운점프 불가 /
		--     로프 타임아웃은 모두 `self._T.target = nil`을 직접 넣으므로 아래 curAlive가 false가 된다.
		local curT0 = self._T.target
		local curAlive = false
		if curT0 ~= nil and isvalid(curT0) then
			local mcLock = curT0:GetComponent("script.Monster")
			curAlive = (mcLock ~= nil and mcLock.IsDead ~= true)
		end
		local targetLocked = curAlive and ((self._T.targetLockUntil or 0) > now)
		if not ropeBusy and not targetLocked
			and (self._T.target == nil or not isvalid(self._T.target) or (self._T.nextScan or 0) <= now) then
			self._T.nextScan = now + 0.3
			local newTarget = self:FindTarget(player)
			-- (요청 2026-08-09) 잠금 5초가 풀린 뒤에도 **뒤로 되돌아가는 재선정은 하지 않는다.**
			--   가던 길에 몬스터가 리젠되면 그쪽이 최근접이 되어 대상이 바뀌고, 지금까지 걸어온 거리를
			--   그대로 되돌아간다. 그 사이 또 리젠되면 다시 뒤집혀 왕복만 하는 구간이 생긴다.
			--   → 현재 대상이 아직 살아 있고 1초 이상 접근 중이었다면, **진행 방향과 반대쪽** 후보로는
			--     갈아타지 않는다(앞쪽/같은 방향 후보는 가는 길에 있으므로 그대로 허용).
			--   포기 경로는 그대로 살아 있다 - 5초 추적 타임아웃 / 끼임 / 도달 불가 판정이 대상을 바꾼다.
			local keepTarget = false
			local curT = self._T.target
			if newTarget ~= nil and curT ~= nil and isvalid(curT) and newTarget ~= curT
				and (now - (self._T.chaseStart or now)) >= 1.0 then
				local pxNow = player.TransformComponent.WorldPosition.x
				local curDx = curT.TransformComponent.WorldPosition.x - pxNow
				local newDx = newTarget.TransformComponent.WorldPosition.x - pxNow
				-- 부호가 다르면 = 반대편이다(되돌아가야 한다). 0.2 안쪽의 미세한 차이는 방향으로 안 본다.
				if math.abs(curDx) > 0.2 and math.abs(newDx) > 0.2
					and ((curDx > 0) ~= (newDx > 0)) then
					keepTarget = true
					if (self._T.keepLogAt or -99) + 3.0 < now then
						self._T.keepLogAt = now
						log("[AutoHunt] 되돌아가기 방지 - 접근 " .. string.format("%.1f", now - (self._T.chaseStart or now))
							.. "초째라 뒤쪽 대상으로 갈아타지 않는다")
					end
				end
			end
			if newTarget ~= self._T.target and not keepTarget then
				-- (요청 2026-08-09) 대상이 바뀌면 진행 중이던 로프 등반은 무효다 - 여기서 정리하지 않으면
				-- 옛 대상 기준 목표높이로 계속 매달려 올라가는 유령 등반이 남는다.
				self:EndRopeClimb(player, "대상 변경")
				self._T.target = newTarget
				self._T.chaseStart = now
				-- 새 목표를 잡은 순간부터 5초 잠금 시작(요청 2026-08-10).
				self._T.targetLockUntil = now + 5.0
				-- 대상이 얼마나 자주 바뀌는지 추적용(잠금이 실제로 먹는지 확인 + 향후 동선 디버깅).
				log("[AutoHunt] 대상 변경 (직전 유지 " .. string.format("%.1f", now - (self._T.lastRetargetAt or now)) .. "초)")
				self._T.lastRetargetAt = now
			end
		end
		local target = self._T.target
		-- (썬콜, 요청 2026-08-08) 블리자드 + 리커버리 오로라 콤보: 오로라 주변 노쿨을 이용해 블리자드를
		-- 주력으로 난사한다. 이 틱을 콤보가 소비했으면(제자리 난사 / 오로라 복귀 걷기) 여기서 끝낸다.
		-- ⚠ 대상은 인자로 넘기지 않고 안에서 self._T.target을 읽는다 - Entity 파라미터에 nil이 넘어가면
		--   메서드 본문이 한 줄도 실행되지 않는 엔진 함정([[feedback_msw_nil_entity_param_silent_fail]])
		--   때문에 "무대상 난사" 분기가 통째로 죽는다.
		if self:MageAuraComboTick(now, player, delta) then return end
		-- (불독, 요청 2026-08-08) 포이즌 미스트 카펫: 사냥 동선을 따라 지나가며 아직 안 덮인 자리에
		-- 독안개를 깔아둔다(익스플로젼 유폭 재료). 대상 유무와 무관 - 주변에 적이 있을 때만 소비된다.
		if self:PoisonCarpetTick(now, player) then return end
		-- (비숍, 요청 2026-08-11) 저체력 소환수 응급 힐 - 대상 유무와 무관하게 사냥보다 먼저 본다.
		if self:TryHealSummonTick(now, player, delta) then return end
		if target == nil or not isvalid(target) then
			-- (P2) 몬스터가 없어도 버프/소환수 유지는 계속하고, 그 외에는 배회하며 리젠을 기다린다.
			-- (요청) 맨아래 층에서 잡을 대상이 없으면(남은 적이 위층뿐이거나 전멸) 위로 복귀한다.
			-- (신고 2026-08-06) 중간 발판 정체: 남은 적이 위층뿐이면(도달 수단 없어 후보 제외) 맨아래가
			-- 아니라서 복귀도 못 하고 리젠까지 제자리 배회만 했다 - 무대상 4초 지속 시 중간에서도 복귀.
			-- 대상이 없으면 등반할 이유도 없다 - 로프에 매달린 채 배회 로직과 뒤엉키지 않게 먼저 정리한다.
			-- (요청 2026-08-11) 단, 이미 매달려 오르는 중(climb)이면 대상이 없어도 **끝까지 올라간 뒤**
			-- 재탐색한다 - 중간에 놓고 떨어지는 어색한 동작 방지.
			if (self._T.ropeState or "") == "climb" then
				local ppO = player.TransformComponent.WorldPosition
				if self:RopeClimbTick(now, player, ppO, 99.0, delta) then return end
			end
			self:EndRopeClimb(player, "무대상")
			if not self:TryUtilityCast(now) then
				if self:TryBottomReturn(now, player) then return end
				if self:TryNoTargetReturn(now, player) then return end
				self:WanderTick(now, player, delta)
			end
			return
		end
		self._T.noTargetSince = nil

		local mon = target:GetComponent("script.Monster")
		if mon == nil or mon.IsDead == true then
			-- (요청 2026-08-11) 로프에 매달려 오르는 중(climb)에 대상이 죽으면 등반을 접지 않고
			-- **끝까지 올라간 뒤** 재탐색한다 - 종전의 "대상 사망 - 재탐색" 즉시 취소는 매달림 중
			-- 놓고 떨어지는 동작이 어색해서 뒤집었다. approach(로프까지 걷는 중)는 기존대로 접는다.
			if (self._T.ropeState or "") == "climb" then
				local ppD = player.TransformComponent.WorldPosition
				if self:RopeClimbTick(now, player, ppD, 99.0, delta) then return end
			end
			self._T.target = nil
			return
		end

		local pp = player.TransformComponent.WorldPosition
		local mp = target.TransformComponent.WorldPosition
		local dx = mp.x - pp.x
		local dy = mp.y - pp.y

		-- (요청 2026-08-12) **밀린 버프는 접근보다 먼저 - 제자리에서 다 쓰고 이동한다.**
		-- ⚠ 왜 필요한가: 유틸 시전(TryUtilityCast)이 "사거리 안" 분기에만 걸려 있어서, 자동사냥을 켜면
		--   버프가 전부 밀려 있는데도 **적 앞까지 걸어간 다음에야** 하나씩 켰다(신고). 대상이 없을 때는
		--   이미 위(무대상 분기)에서 먼저 쓰고 있었으니, 대상이 있는 경로에도 같은 순서를 맞춘다.
		--   시전에 성공하면 MarkUtilityCast가 다음 시전까지 이동을 잠그므로 남은 버프도 제자리에서 이어진다.
		-- ⚠ 등반/도약 중에는 끼어들지 않는다 - 이동을 상태 기계가 가져간 구간이라 여기서 시전하면
		--   매달림/공중 동작이 끊긴다(아래 RopeClimbTick·jumpAtkUntil 블록이 처리할 몫).
		local rsBuff = self._T.ropeState or ""
		if rsBuff ~= "climb" and rsBuff ~= "approach" and (self._T.jumpAtkUntil or 0) <= now then
			if self:TryUtilityCast(now) then return end
		end
		-- (섀도어, 요청 2026-08-06) 다크사이트 잠복 중에는 대상의 **뒤통수 쪽 자리**를 목표로 걷는다.
		-- 그래야 은신이 풀리는 첫 공격이 백스탭 + 다크사이트 딜로 겹친다("적 뒤를 잡아서 더블스탭").
		-- dx만 뒤통수 자리 기준으로 바꾸고, 실제 공격 여부는 TryAttackCast의 게이트가 정한다.
		if self:IsDarkSightAmbushing(now) then
			dx = (mp.x + self:GetBehindDirOfTarget(target) * 0.9) - pp.x
		end
		-- (헛빵 수정) 실제 스킬 대상 선정(파스/슬블/차지 블로우)은 유클리드 반경 1.5인데, 박스
		-- 판정(|dx|≤1.3·|dy|<1.2)은 모서리에서 최대 1.76까지 통과시켜 허공 시전이 났다.
		-- 걷기 접근은 |dx|≤1.1로 더 붙고, 공격은 유클리드 거리 1.15 이내에서만 한다.
		local range = 1.1
		local dist = math.sqrt(dx * dx + dy * dy)
		-- 조준 방향 기억 - 섬광 등 방향키 조준 스킬이 "적 쪽 방향키를 누른 것처럼" 읽어간다(GetAimDirX/Y).
		-- 수직 조준은 위아래로 제법 떨어진(|dy|≥1.2) 대상일 때만 넣는다.
		if math.abs(dx) > 0.05 then
			self._T.aimDirX = (dx > 0) and 1 or -1
		end
		if dy >= 1.2 then
			self._T.aimDirY = 1
		elseif dy <= -1.2 then
			self._T.aimDirY = -1
		else
			self._T.aimDirY = 0
		end

		-- 상태 디버그 (2초 주기) - look = 현재 바라보는 방향(LookDirectionX)
		if (self._T.nextDbg or 0) <= now then
			self._T.nextDbg = now + 2.0
			local lookX = 0
			local pccDbg = player.PlayerControllerComponent
			if isvalid(pccDbg) then lookX = pccDbg.LookDirectionX end
			log("[AutoHunt] px=" .. string.format("%.2f", pp.x) .. " dx=" .. string.format("%.2f", dx) .. " dy=" .. string.format("%.2f", dy) .. " look=" .. tostring(lookX))
		end

		-- (요청 2026-08-09) 로프 등반: 앞점프로 닿지 않는 위층 대상은 로프로 올라간다.
		-- 이 함수가 true를 돌려주면 이번 틱의 이동은 등반 상태 기계가 가져간 것이므로 아래 추적 로직을 건너뛴다.
		-- ⚠ 등반 중에는 공격도 하지 않는다 - CLIMB 상태에서는 시전 자체가 막혀 있어(각 Attack*의 상태 가드)
		--   여기서 return하는 것이 실제 동작과 일치한다.
		-- (요청 2026-08-10) 점프 공격 공중 단계: 도약 창(jumpAtkUntil)이 열려 있으면 이동/추적
		-- 로직을 멈추고, 상승 중 대상이 전방 공격 박스(위 1.0) 안에 든 순간 공중 시전한다
		-- (TryAttackCast의 지상 게이트에 이 창 동안만 예외를 뚫어 놓았다). 착지하면 창을 닫는다.
		-- ⚠ 로프 판정(RopeClimbTick)보다 먼저 - 공중 도약 중에 로프 접근이 끼어들면 안 된다.
		if (self._T.jumpAtkUntil or 0) > now then
			local rbJa = player.RigidbodyComponent
			if isvalid(rbJa) and not rbJa:IsOnGround() then
				-- 상승 구간(도약 0.5초 안)에서만 시전 - 판정 박스는 시전 0.25초 뒤 그 시점 위치라,
				-- 정점 직전에 쏘면 판정 순간이 정점 부근이 되어 위쪽 1.0 박스가 대상을 덮는다.
				-- (신고 2차) 가장자리 도약(대각선 위 대상) 허용: |dx|≤1.25까지, 유클리드는 서버
				-- 실판정(1.5) 안쪽 1.42까지. 정점을 지나 대상이 살짝 아래로 내려가도 아래 박스(0.5)가
				-- 있으므로 dy 하한은 -0.4까지 본다.
				-- (신고 2026-08-10 "점프 슬블이 확실한 거리인데 안 맞는다") dy 상한 1.05 → 0.95:
				-- 슬블/파스의 서버 세로 박스가 정확히 ±1.0이라 1.0~1.05 구간은 뽑혀도 무조건 빗나갔다.
				-- 시전 좌표 동봉(LvPos)으로 복제 지연은 잡았으니 남은 오차 몫 0.05만 남긴다.
				if dy >= -0.4 and dy <= 0.95 and math.abs(dx) <= 1.35
					and (dx * dx + dy * dy) <= 1.42 * 1.42
					and (now - (self._T.jumpedAt or now)) <= 0.5 then
					self._T.chaseStart = now
					self._T.jumpAtkCastDone = true
					self:TryAttackCast(now, player, pp)
				end
				return
			end
			if (now - (self._T.jumpedAt or 0)) > 0.35 then
				self._T.jumpAtkUntil = 0   -- 착지 - 창 종료 (다음 도약은 nextJumpAtk 쿨 뒤)
				-- 헛도약 판정: 이번 도약에서 대상이 한 번도 시전 게이트에 못 들었으면 기하적으로
				-- 못 닿는 자리다 - 2회 연속이면 TryJumpAttack이 포기한다(무한 도약 루프 방지).
				if self._T.jumpAtkCastDone == true then
					self._T.jumpAtkFails = 0
				else
					self._T.jumpAtkFails = (self._T.jumpAtkFails or 0) + 1
					log("[AutoHunt] 점프 공격 헛도약 (" .. tostring(self._T.jumpAtkFails)
						.. "/2) - 공중 시전 게이트에 못 넣음 (dy=" .. string.format("%.2f", dy)
						.. " dx=" .. string.format("%.2f", dx) .. ")")
				end
			else
				return   -- 도약 직후 아직 지상 판정인 프레임 - 대기
			end
		end

		-- (신고 2026-08-10 3차) **"바로 조금 위" 대상 우선 점프 공격.** 점프 정점 공격이 닿는
		-- 높이(0.9 ~ 점프사거리+1.15)의 가까운(|dx|≤2.5) 위층 대상은 로프/등반으로 돌아가지 않고
		-- 그 자리에서 점프 공격으로 잡는다 - 사람이 하듯 "점프+공격 한 번"이 동선이 제일 짧다.
		-- 그동안 로프 판정이 이보다 먼저라, 로프가 있는 맵에서는 점프 한 번이면 닿는 적도 매번
		-- 로프로 돌아가서 점프 공격이 보이지 않았다(신고의 직접 원인).
		--   · 하한 0.9: 그 아래는 서 있는 공격 박스(위 1.0)가 이미 닿아 지상 공격이 더 빠르다.
		--   · 걸어서 이어진 지형(경사/계단 체인)은 제외 - 걸어 올라가는 게 자연스럽다.
		--   · 헛도약 2회면 TryJumpAttack이 스스로 포기하므로 로프/등반 경로가 그대로 이어받는다.
		if (self._T.ropeState or "") == "" and dy >= 0.9 and dist > 1.15
			and math.abs(dx) <= 2.5 then
			local reachJa = self:GetPlainJumpReach(player)
			if dy <= reachJa + 1.15 and not self:IsWalkConnectedToTarget(player, pp, mp)
				and self:TryJumpAttack(now, player, dx, dy, reachJa, delta) then
				return
			end
		end

		if self:RopeClimbTick(now, player, pp, dy, delta) then return end

		-- (버그 수정) 사거리 판정에 수직 거리도 포함한다 - |dx|만 보면 아래/위층 몬스터를 "사거리 내"로
		-- 오인해 허공에 파워스트라이크/슬래시블러스트를 발동했다. 같은 층(|dy|<1.2)일 때만 공격하고,
		-- 스킬 실판정(반경 1.5)보다 안쪽인 유클리드 1.15 이내까지 붙어야 공격한다 (헛빵 방지).
		-- (나이트로드, 요청) 각성 중에는 표창 3종이 드래곤 로어 범위(가로 ±15 / 세로 ±7.5)를 방향 무관으로
		-- 조준하므로 **제자리에서 거의 다 닿는다** - 굳이 걸어가지 않고 그 자리에서 계속 던진다.
		-- 표창 스킬이 하나도 배정돼 있지 않으면(근접 위주 구성) 평소처럼 접근한다.
		if self:IsAwakeningOn() and self:HasStarThrowSlot()
			and math.abs(dx) <= 15.0 and math.abs(dy) <= 7.5 then
			if self._T.moving then self:StopMoving() end
			self._T.chaseStart = now
			if math.abs(dx) > 0.05 then
				local pccAw = player.PlayerControllerComponent
				if isvalid(pccAw) then
					local wantAw = (dx > 0) and 1 or -1
					if pccAw.LookDirectionX ~= wantAw then
						pccAw.LookDirectionX = wantAw
						self._T.dirChangedAt = now
					end
				end
			end
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
			return
		end
		-- (요청 2026-08-06) 연막 안에서는 암살 사거리가 2배(9유닛)로 늘어난다 - 그 안의 대상은
		-- 걸어가지 않고 **제자리에서** 계속 암살로 끌어당긴다(각성 표창 제자리 사냥과 같은 처리).
		if self:ShouldSnipeWithAssassinate(dx, dy) then
			if self._T.moving then self:StopMoving() end
			self._T.chaseStart = now
			if math.abs(dx) > 0.05 then
				local pccSn = player.PlayerControllerComponent
				if isvalid(pccSn) then
					local wantSn = (dx > 0) and 1 or -1
					if pccSn.LookDirectionX ~= wantSn then
						pccSn.LookDirectionX = wantSn
						self._T.dirChangedAt = now
					end
				end
			end
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
			return
		end
		-- (썬콜, 요청 2026-08-08) 마법 사거리 안의 대상은 걸어가 붙지 않고 제자리에서 시전한다.
		-- "먼 거리 한 명의 적"은 매직클로가, 4차에서는 체인라이트닝이 이 자리를 주로 맡는다
		-- (각성 표창/연막 저격 제자리 사냥의 자매 규칙 - 실제 스킬 선택은 TryAttackCast의 썬콜 블록).
		if self:ShouldMageSnipe(player, pp, dx, dy) then
			if self._T.moving then self:StopMoving() end
			self._T.chaseStart = now
			if math.abs(dx) > 0.05 then
				local pccMg = player.PlayerControllerComponent
				if isvalid(pccMg) then
					local wantMg = (dx > 0) and 1 or -1
					if pccMg.LookDirectionX ~= wantMg then
						pccMg.LookDirectionX = wantMg
						self._T.dirChangedAt = now
					end
				end
			end
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
			return
		end
		-- (신궁/보우마스터, 요청 2026-08-10) 활 사거리(전방 조준 최대 6유닛) 안의 같은 층 대상은
		-- 걸어가 붙지 않고 제자리에서 쏜다 - "사거리가 아주 긴데 파워스트라이크처럼 근접으로 쓴다"는
		-- 신고의 직접 수정(마법 저격 제자리 사냥과 같은 처리).
		if self:ShouldArcherSnipe(player, pp, dx, dy) then
			if self._T.moving then self:StopMoving() end
			self._T.chaseStart = now
			-- 매 틱 찍히면 넘치므로 3초에 한 번만 남긴다(활 저격 발동 확인용).
			if (self._T.archerSnipeLogAt or -99) + 3.0 < now then
				self._T.archerSnipeLogAt = now
				log("[AutoHunt] 활 저격 - 제자리 시전 (dx=" .. string.format("%.2f", dx)
					.. " dy=" .. string.format("%.2f", dy) .. ")")
			end
			if math.abs(dx) > 0.05 then
				local pccAr = player.PlayerControllerComponent
				if isvalid(pccAr) then
					local wantAr = (dx > 0) and 1 or -1
					if pccAr.LookDirectionX ~= wantAr then
						pccAr.LookDirectionX = wantAr
						self._T.dirChangedAt = now
					end
				end
			end
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
			return
		end
		-- (신궁, 요청 2026-08-07) 접근 중이라도 아이언 에로우가 닿으면 그 자리에서 쏜다 -
		-- 8방향 관통이라 걸어가서 붙을 필요가 없다. 아래 접근 분기보다 **먼저** 본다(접근 분기는
		-- 이동만 하고 return 하므로, 뒤에 두면 먼 대상에게는 영영 기회가 없다).
		if self:TryIronArrowRanged(now, player, dx, dy) then return end
		-- (신고 2026-08-10) 아래쪽 사거리 게이트는 **비대칭**이어야 한다 - 파스/기본공격의 서버 판정
		-- 박스가 위 1.0 / **아래 0.5**라, |dy|<1.2 대칭 게이트는 아래로 0.6~1.2 떨어진 적을 "사거리
		-- 안"으로 오인해 제자리에서 계속 헛방을 쳤다(공격 중에는 chaseStart가 갱신돼 5초 타임아웃도
		-- 안 걸려 영영 반복). 아래 0.6(박스 0.5 + 콜라이더 몫)부터는 접근으로 넘긴다 - 걷기가 경사/
		-- 턱을 내려가 높이를 맞추고, 더 아래(-0.8↓)는 다운점프가 맡는다.
		if dist > 1.15 or dy >= 1.2 or dy <= -0.6 then
			-- (요청) 맨아래 층에서 남은 적이 수평으로 꽤 멀면(8유닛↑) 걸어가지 않고 위로 복귀해
			-- 위에서부터 다시 내려오며 잡는다 (하강 순환 동선).
			if math.abs(dx) >= 8.0 and self:TryBottomReturn(now, player) then return end
			-- 접근. 5초 넘게 사거리에 못 들면 이 대상을 3초간 제외하고 재선정한다.
			if (now - (self._T.chaseStart or now)) > 5.0 then
				if self._T.banned == nil then self._T.banned = {} end
				self._T.banned[target] = now + 3.0
				self._T.target = nil
				self:StopMoving()
				log("[AutoHunt] 추적 타임아웃 - 대상 제외 후 재선정")
				return
			end
			-- (다크나이트, 요청 사양) 위층 대상(dy≥1.2)은 드래곤 라이딩으로 날아 올라간다 - "이동할 때만
			-- 탑승"이고 도착하면 RideFlightTick이 즉시 하차시킨다(드래곤은 다시 소환수로 따로 공격).
			-- 소환이 활성일 때만(미탑승) 가능 - 소환 자체는 TryUtilityCast의 dragonride 유지가 담당.
			if dy >= 1.2 and (self._T.nextRideMove or 0) <= now
				and self._T.slotDragonRides ~= nil and #self._T.slotDragonRides > 0
				and _SkillManager:CanAutoMountDragonRide() then
				self._T.nextRideMove = now + 4.0
				self._T.rideFlight = true
				self._T.rideFlightX = mp.x
				-- (버그 수정 2026-08-04) 목표 높이를 몬스터 +0.3 → **+1.0**으로 올린다.
				-- 하차 처리(SkillManager.ToggleDragonRide)는 탑승 때 올렸던 만큼 캐릭터를 0.6 내리는데,
				-- +0.3에서 내리면 발판 표면보다 0.3 **아래**가 되어 발판이 캐릭터를 잡지 못하고
				-- 그대로 떨어졌다("올라가다 말고 다시 떨어진다"의 직접 원인). +1.0이면 하차 후에도
				-- 발판 위(+0.4)라 중력이 자연스럽게 착지시킨다.
				self._T.rideFlightY = mp.y + 1.0
				self._T.rideFlightStart = now
				-- (버그 수정) 거리 비례 타임아웃/진척 감시의 기준값을 탑승 시점에 기록해 둔다.
				self._T.rideFlightDist = math.sqrt(dx * dx + (dy + 1.0) * (dy + 1.0))
				self._T.rideProgressDist = nil
				self._T.rideProgressAt = now + 2.0
				_SkillManager:ToggleDragonRide()   -- 탑승 (하차는 RideFlightTick 도착 판정이)
				log("[AutoHunt] 드래곤 라이딩 비행 이동 시작 (dy=" .. string.format("%.2f", dy) .. ")")
				return
			end
			-- (요청) 섬광 = 상하 이동기: 위아래로 제법 떨어진(|dy|≥1.2) 대상을 쫓을 때만 시전한다 -
			-- 가까운/같은 높이 대상에게는 절대 쓰지 않는다 (공격 로테이션에서도 제외됨).
			if math.abs(dy) >= 1.2 and (self._T.nextFlash or 0) <= now
				and self._T.slotMobilities ~= nil and #self._T.slotMobilities > 0 then
				self._T.nextFlash = now + 2.5   -- 섬광 자체 쿨 2초 + 여유
				local pccF = player.PlayerControllerComponent
				if isvalid(pccF) then pccF.LookDirectionX = (dx > 0) and 1 or -1 end
				self._T.holdMoveUntil = now + 1.0
				_SkillManager:UseSkillInSlot(self._T.slotMobilities[1].key)
				log("[AutoHunt] 섬광 이동 시전 (dy=" .. string.format("%.2f", dy) .. ")")
				return
			end
			-- (신궁, 요청 2026-08-06) 체인샷 = 유동적 이동. 섬광과 같은 자리에서 쓴다 -
			-- 위아래로 떨어진 대상(|dy|≥1.2)이거나 같은 층에서 멀리(3유닛↑) 떨어졌을 때.
			if self._T.slotChainShots ~= nil and #self._T.slotChainShots > 0 then
				local csDirX = (dx > 0) and 1 or -1
				local csDirY = 0
				if dy >= 1.2 then csDirY = 1 elseif dy <= -1.2 then csDirY = -1 end
				if csDirY ~= 0 or math.abs(dx) >= 3.0 then
					if self:TryChainShotMove(now, player, csDirX, csDirY,
						"dx=" .. string.format("%.2f", dx) .. " dy=" .. string.format("%.2f", dy)) then
						return
					end
				end
			end
			-- (썬콜, 요청 2026-08-08) 텔레포트 = 이동기. 위아래로 떨어진 대상(±2.4유닛 이내)은 수직
			-- 텔레포트로 층을 넘고, 같은 층 먼 대상(3유닛↑)은 텔레포트(2.31유닛 도약)로 접근을 가속한다.
			-- 방향키 입력이 없으면 시전 분기가 자동사냥 조준값(GetAimDirX/Y)을 방향키처럼 읽는다.
			-- MP가 모자라면 UseSkillInSlot이 조용히 거부하고 걷기가 그대로 이어진다(손해 없음).
			if self._T.slotTeleports ~= nil and #self._T.slotTeleports > 0
				and (self._T.nextTeleportMove or 0) <= now then
				-- (요청 2026-08-11 "텔레포트 사용 빈도가 너무 적다 - 이득이면 보통 텔레포트로 이동")
				-- 발동 범위를 넓혀 점프/아랫점프 영역을 텔레포트가 흡수한다:
				--   · 위 0.8~2.4(구 1.2~) - 점프로 닿는 낮은 층도 텔포가 있으면 텔포로 오른다.
				--   · 아래 -0.8~-2.6(구 -1.2~-2.4) - 아랫점프 거리부터 텔포 우선(이 블록이 아랫점프
				--     분기보다 앞에 있어 tpDirY≠0면 그대로 이어받는다).
				--   · 수평 2.2 이상(구 3.0) - 도약 거리(2.31유닛)만 넘으면 걷기보다 이득이다.
				local tpDirY = 0
				if dy >= 0.8 and dy <= 2.4 then tpDirY = 1
				elseif dy <= -0.8 and dy >= -2.6 then tpDirY = -1 end
				if tpDirY ~= 0 or (math.abs(dy) < 0.8 and math.abs(dx) >= 2.2) then
					self._T.nextTeleportMove = now + 0.9   -- 자체 쿨 0.54초 + 여유
					self._T.aimDirX = (dx > 0) and 1 or -1
					self._T.aimDirY = tpDirY
					local pccTp = player.PlayerControllerComponent
					if isvalid(pccTp) then pccTp.LookDirectionX = self._T.aimDirX end
					_SkillManager:UseSkillInSlot(self._T.slotTeleports[1].key)
					log("[AutoHunt] 텔레포트 이동 (dx=" .. string.format("%.2f", dx)
						.. " dy=" .. string.format("%.2f", dy) .. ")")
					if tpDirY ~= 0 then
						-- 수직 텔레포트는 착지/재선정 시간을 준다. 수평은 걷기와 겹쳐 그대로 가속된다.
						self._T.holdMoveUntil = now + 0.35
						return
					end
				end
			end
			-- 자동 이동 중에만 컨트롤러를 끈다 (입력 0이 이동을 덮는 문제 - 정지/OFF 시 복구)
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) and pcc.Enable then pcc.Enable = false end
			local dir = (dx > 0) and 1 or -1
			-- 바라보는 방향 = 이동 방향. 스킬 판정/이펙트는 전부 LookDirectionX를 읽으므로 직접 갱신한다
			if isvalid(pcc) then pcc.LookDirectionX = dir end
			-- (요청) 같은 층의 먼 대상(3유닛↑)은 대시(러시)로 가속 접근한다 - 질주 0.4초, 자체 쿨 3초
			-- (요청 2026-08-10) **질주 중 발판에서 떨어지지 않게 한다.** 질주는 이동속도 2배라 평소 걷기보다
			--   훨씬 빨리 가장자리에 닿는다. 두 겹으로 막는다:
			--   ① 시작 게이트 - 진행 방향으로 지면이 2유닛 이상 이어질 때만 질주에 든다.
			--   ② 주행 중 감시 - 이미 질주 중이라도 앞이 0.7유닛 안에 끊기면 즉시 질주를 끊는다
			--      (EndSprint는 질주 중이 아니면 스스로 return하므로 매 틱 불러도 안전하다).
			--   판정은 PredictFootholdEnd(= "그 거리만큼 갈 수 있으면 true").
			local rbDash = player.RigidbodyComponent
			local dashGroundOk = true
			local dashEdgeNear = false
			if isvalid(rbDash) and rbDash:IsOnGround() then
				dashGroundOk = rbDash:PredictFootholdEnd(2.0, dir > 0)
				dashEdgeNear = not rbDash:PredictFootholdEnd(0.7, dir > 0)
			end
			if dashEdgeNear then
				_SkillManager:EndSprint()
			end
			if math.abs(dx) >= 3.0 and math.abs(dy) < 0.8 and (self._T.nextDash or 0) <= now
				and dashGroundOk
				and self._T.slotDashes ~= nil and #self._T.slotDashes > 0 then
				self._T.nextDash = now + 3.5
				self._T.aimDirX = dir
				_SkillManager:UseSkillInSlot(self._T.slotDashes[1].key)
				log("[AutoHunt] 대시 접근 (dx=" .. string.format("%.2f", dx) .. ")")
			end
			-- (나이트로드·섀도어, 요청) 플래시 점프는 **필요한 두 상황에서만** 쓴다.
			--   ① 위 발판 대상: 그냥 점프로는 못 닿는 높이도 점프+플래시 점프면 올라간다(사거리 안일 때만).
			--      가로로도 밀려나지만 그 위 발판에 올라서기만 하면 나머지는 걷기가 마무리한다.
			--   ② 같은 층 먼 대상: 이 두 직업은 러시(대시)가 없어 접근이 느리다 - 3유닛 이상 벌어졌고
			--      대시 슬롯도 없을 때만 가속용으로 쓴다(가까운 대상엔 절대 안 쓴다).
			if self:GetFlashJumpLevel() > 0 then
				local fjReach = self:GetFlashJumpReach()
				if dy >= 1.2 and dy <= fjReach then
					if self:TryFlashJumpMove(now, player, dir, "위 발판 추적 (dy=" .. string.format("%.2f", dy)
						.. " 사거리=" .. string.format("%.2f", fjReach) .. ")") then
						return
					end
				elseif math.abs(dy) < 0.8 and math.abs(dx) >= 3.0
					and (self._T.slotDashes == nil or #self._T.slotDashes == 0) then
					if self:TryFlashJumpMove(now, player, dir, "같은 층 가속 접근 (dx=" .. string.format("%.2f", dx) .. ")") then
						return
					end
				end
			end
			-- (신궁, 요청 2026-08-06) 더블 점프도 플래시 점프와 **같은 두 상황**에서만 쓴다.
			-- 두 스킬을 동시에 가진 직업은 없지만, 만에 하나 겹쳐도 플래시 점프가 먼저 소비되므로
			-- 여기까지 내려오지 않는다(위 분기가 return 한다).
			if self:GetDoubleJumpLevel() > 0 then
				local djReach = self:GetDoubleJumpReach()
				if dy >= 1.2 and dy <= djReach then
					if self:TryDoubleJumpMove(now, player, dir, "위 발판 추적 (dy=" .. string.format("%.2f", dy)
						.. " 사거리=" .. string.format("%.2f", djReach) .. ")") then
						return
					end
				-- (요청 2026-08-10 "더블 점프를 유용하게") 가속 접근 문턱 3.0 → 2.5 완화 + 세로 허용
				-- 0.8 → 1.0 - 활 저격(최대 5.6 제자리 시전) 도입으로 걷기 접근 자체가 "저격 사거리 밖"
				-- 구간으로 밀려서, 문턱이 높으면 걷기 첫 틱의 도약 기회를 놓친다. 도약 전방 이동이
				-- 약 4.6유닛이라 2.5유닛+ 대상이면 지나치지 않고 사거리 안으로 들어간다.
				elseif math.abs(dy) < 1.0 and math.abs(dx) >= 2.5
					and (self._T.slotDashes == nil or #self._T.slotDashes == 0) then
					if self:TryDoubleJumpMove(now, player, dir, "같은 층 가속 접근 (dx=" .. string.format("%.2f", dx) .. ")") then
						return
					end
				end
			end
			-- 같은 층이면 공격 거리(유클리드 1.15)에 들 때까지 계속 걷는다. 다른 층 대상은 수평 정렬이
			-- 끝나면(|dx|≤사거리) 좌우로 부들거리지 않게 제자리에서 점프/다운점프·섬광만 기다린다.
			-- (요청 2026-08-10) **등반 직후 층 고정 동안에는 발판 밖으로 걸어 나가지 않는다.**
			--   다운점프만 막으면 "가장자리로 걸어가 그냥 떨어지는" 경로가 그대로 남는다
			--   (실측: 등반 1초 뒤 낙하 2건 - 다운점프가 아니라 걸어서 떨어진 것).
			--   사다리로 올라온 직후가 특히 위험하다 - 도착 지점이 대개 발판 가장자리다.
			--   앞이 막혀 있어도 위로 넘을 턱이면 아래 TryStepUpOverWall이 따로 처리하므로 손해가 없다.
			local holdEdge = false
			if (self._T.layerHoldUntil or 0) > now then
				local rbHold = player.RigidbodyComponent
				if isvalid(rbHold) and rbHold:IsOnGround()
					and not rbHold:PredictFootholdEnd(0.4, dir > 0) then
					holdEdge = true
					if (self._T.holdEdgeLogAt or -99) + 3.0 < now then
						self._T.holdEdgeLogAt = now
						log("[AutoHunt] 등반 직후 층 고정 - 발판 끝이라 그 방향으로 걸어 나가지 않는다")
					end
				end
			end
			if (math.abs(dy) < 1.2 or math.abs(dx) > range) and not holdEdge then
				player.MovementComponent:MoveToDirection(Vector2(dir, 0), delta)
				self._T.moving = true
				-- 걷기 모션: 컨트롤러가 꺼진 동안 상태를 직접 맞춘다 (버튼 이동과 같은 모션).
				-- 플레이어 이동 상태명은 "MOVE"(PlayerControllerComponent가 등록 - animation-state.md §1.2),
				-- 아바타 상태 권한은 클라이언트라 ClientOnly 호출이 정상이다.
				if isvalid(sc) and sc.CurrentStateName == "IDLE" then
					sc:ChangeState("MOVE")
				end
				-- (신고) 걷는데 제자리면(지형 턱에 낌) 점프로 탈출한다.
				self:CheckStuckAndJump(now, player, pp)
				-- (신고 2026-08-09 "벽을 보고 계속 걷고 있다") 진행 방향 지면이 끊겼는데(턱/벽) 대상이
				-- 그 너머면, **대상과의 dy/|dx| 게이트와 무관하게** 올라설 발판을 확인하고 앞점프로 넘는다.
				-- ⚠ 아래 "앞점프로 위 발판 등반"은 `dy>=0.4 && |dx|<=1.2` 게이트라 이 상황을 절대 못 잡는다 -
				--   벽에 막혀 있으니 |dx|가 줄지 않고, 그래서 게이트가 영영 안 열려 벽만 보고 걷는다.
				--   실측(map01): x=2.76 y=-6.65에서 state=MOVE인 채 6초 이상 정체, look=1,
				--   PredictFootholdEnd(0.4/0.15, 오른쪽)=false. 이 지점은 y=-6.65 지면[-3.54~2.76]이
				--   끝나고 **0.60 위**의 y=-6.05 지면[2.76~5.34]이 시작되는 한 단 턱이다.
				-- ⚠ 끼임 탈출(CheckStuckAndJump)은 0.6초 표본을 쓰는데 시전 홀드(holdMoveUntil)마다
				--   표본이 비워져 공격 중에는 거의 발동하지 못한다(실측 70초에 2회). 그래서 시간 표본이
				--   필요 없는 **즉시 판정**(PredictFootholdEnd + 위쪽 레이캐스트)으로 따로 잡는다.
				if not self:TryStepUpOverWall(player, pp, dir, now) then
					-- (신고 2026-08-10) **같은 높이지만 끊긴 발판** 인지: 대상 쪽으로 걷는데 지면이 끊겼고
					-- (앞 0.35에 더 못 감) 뛰어 올라설 턱도 없으며, 대상이 아래층도 아니면(dy>-0.8 -
					-- 아래층 대상을 향해 걸어 내려가는 낙하는 정상 경로라 건드리지 않는다) 내 발판과 대상
					-- 발판이 체인으로 이어져 있는지 확인한다. 끊겨 있으면 걸어가 봐야 낭떠러지에서 떨어져
					-- 아래층으로 추락할 뿐이다(신고: 로프로 올라온 뒤 같은 높이의 건너편 발판 대상을 향해
					-- 걷다가 추락) - 떨어지기 전에 멈추고 대상을 제외해 재선정한다.
					-- ⚠ 이어진 움푹 지형(내려갔다 올라오는 길)은 체인이 붙어 있어 여기 걸리지 않는다.
					local rbGap = player.RigidbodyComponent
					if dy > -0.8 and isvalid(rbGap) and rbGap:IsOnGround()
						and not rbGap:PredictFootholdEnd(0.35, dir > 0) then
						-- 턱이 있고 점프로 닿으면 TryStepUpOverWall(쿨 1초)이 곧 넘는다 - 제외하지 않는다.
						local stepH = self:GetStepUpHeightAhead(player, pp, dir)
						if (stepH <= 0 or stepH > self:GetPlainJumpReach(player))
							and not self:IsWalkConnectedToTarget(player, pp, mp) then
							-- (신고 2026-08-10 2차) 걸어서 못 가는 너머의 적이 **약간 위**(0.5↑)면 제외하기
							-- 전에 가장자리 점프 공격을 시도한다 - "걸어서는 못 가는 위치의 적에게 점프
							-- 공격을 안 한다"의 직접 해결(가능 여부는 TryJumpAttack의 높이 reach+1.15 /
							-- 거리 1.35 판정이 정한다).
							if dy >= 0.5
								and self:TryJumpAttack(now, player, dx, dy, self:GetPlainJumpReach(player), delta) then
								return
							end
							if self._T.banned == nil then self._T.banned = {} end
							self._T.banned[target] = now + 6.0
							self._T.target = nil
							self._T.nextScan = 0
							self:StopMoving()
							log("[AutoHunt] 끊긴 발판 너머 대상(dy=" .. string.format("%.2f", dy)
								.. " dx=" .. string.format("%.2f", dx) .. ") - 낭떠러지 앞 정지, 제외 후 재선정")
							return
						end
						-- (신고 2026-08-10) **아래층 대상을 향한 걷기 낙하도 착지점을 본다.** 위 검사(dy>-0.8)는
						-- 아래층 대상의 걷기 낙하를 "정상 경로"로 그냥 두는데, 가장자리 너머 착지점이 대상 층보다
						-- 1.2 이상 아래면(다운점프 과낙하와 같은 기하 - 대상 발판이 여기까지 안 이어짐) 떨어져
						-- 봐야 한참 아래로 지나친다. 떨어지기 전에 멈추고 제외한다(다운점프 정렬 경로가 |dx|≤1.5
						-- 에서 대상 위 정렬로 다시 시도한다).
						if dy <= -0.8 and isvalid(rbGap) and rbGap:IsOnGround()
							and not rbGap:PredictFootholdEnd(0.35, dir > 0) then
							local mapWO = player.CurrentMap
							local fhWO = isvalid(mapWO) and mapWO.FootholdComponent or nil
							if isvalid(fhWO) then
								local edgeX = pp.x + dir * 0.4
								local edgeFh = fhWO:Raycast(Vector2(edgeX, pp.y - 0.3), Vector2(0, -1), 10.0)
								local overshootW = true
								if edgeFh ~= nil then
									local edgeY = edgeFh:GetYByX(edgeX)
									if edgeY ~= nil and edgeY >= mp.y - 1.2 then overshootW = false end
								end
								if overshootW then
									if self._T.banned == nil then self._T.banned = {} end
									self._T.banned[target] = now + 4.0
									self._T.target = nil
									self._T.nextScan = 0
									self:StopMoving()
									log("[AutoHunt] 아래층 대상 걷기 낙하 과낙하(가장자리 착지점이 대상 층보다 한참 아래) - 정지 후 재선정 (dy="
										.. string.format("%.2f", dy) .. " dx=" .. string.format("%.2f", dx) .. ")")
									return
								end
							end
						end
					end
				end
			elseif self._T.moving then
				self:StopMoving()
			end
			-- (P2 개선) 위/아래 발판 추적: 수평으로 먼저 정렬한 뒤에만 점프/다운점프한다 -
			-- 멀리서 무의미하게 뛰어오르는 낭비 방지 (위 발판은 |dx|≤1.2, 아래 발판은 |dx|≤1.5에서만)
			-- (나이트로드, 요청) 헤이스트 점프 보정: 헤이스트가 켜져 있으면 점프력이 "바로 위 발판을
			-- 살짝 넘길 만큼"으로 미리 맞춰진다(PlayerAttack.HasteJumpAssistTick) - 그 사거리 안의
			-- 위층 대상은 점프로 확실히 올라갈 수 있다. 수평 정렬이 끝난 뒤에만 뛴다.
			if (self._T.nextJump or 0) <= now and dy >= 1.2 and math.abs(dx) <= 1.2
				and self:GetHasteJumpReach() >= dy then
				self._T.nextJump = now + 1.0
				self._T.jumpedAt = now
				player.MovementComponent:Jump()
				if isvalid(sc) then sc:ChangeState("JUMP") end
				log("[AutoHunt] 헤이스트 점프 보정으로 위 발판 추적 (dy=" .. string.format("%.2f", dy)
					.. " 사거리=" .. string.format("%.2f", self:GetHasteJumpReach()) .. ")")
				return
			end
			-- (요청 2026-08-09) **앞점프로 올라갈 수 있는 지형이면 그냥 점프해서 올라간다.**
			-- 그동안 위층 대상은 이동기(섬광/플래시 점프/더블 점프/텔레포트/헤이스트)를 가진 직업만
			-- 따라갈 수 있어서, 히어로처럼 아무것도 없는 직업은 바로 위 발판의 적을 영영 못 잡았다
			-- (FindTarget에서 후보 제외 → 무대상 배회 → 신고 "발판 경로를 못 찾는다").
			-- ⚠ 아래 "위 발판엔 점프하지 않는다" 규칙과 모순이 아니다 - 그 규칙은 **공중에서 때리려는**
			--   점프를 막은 것이고, 이건 **발판에 올라선 뒤** 평소처럼 싸우기 위한 이동이다.
			--   그래서 올라설 발판이 실제로 있는지(HasFootholdAbove) 확인한 뒤에만 뛴다.
			-- ⚠ 하한이 0.4인 이유(실측 2026-08-09): 이 맵의 턱은 **+0.49 / +1.03유닛**이었다. 예전처럼
			--   1.1 이상만 "위층"으로 보면 이 턱들이 전부 "같은 층"으로 분류돼, 자동사냥이 턱 밑을
			--   향해 계속 걸어가기만 하고 못 올라간다(신고 "발판 경로를 못 찾는다"의 직접 원인).
			if (self._T.nextJump or 0) <= now and dy >= 0.4 and math.abs(dx) <= 1.2 then
				local plainReach = self:GetPlainJumpReach(player)
				-- (요청 2026-08-10) **대상이 선 그 발판까지 한 번에 올라설 수 있을 때만 뛴다.**
				--   구 판정(HasSeparateFootholdAbove)은 "위에 아무 발판이라도 있나"라, 대상이 두 층 위면
				--   중간 발판이 잡혀 통과했다 → 올라가도 대상 층엔 못 닿아 내려오고, 대상이 그대로라
				--   같은 판단을 2~3번 반복했다(사용자 가설, 관측과 일치).
				if plainReach >= dy and self:CanReachTargetLayer(player, pp, mp, plainReach) then
					self._T.nextJump = now + 1.0
					self._T.jumpedAt = now
					-- 올라간 직후 되돌아 내려가지 않게 하강을 1.2초 보류 + 3초간 올라온 층 고정(신고 2026-08-10).
					self._T.noDownJumpUntil = now + 1.2
					self._T.layerHoldUntil = now + 3.0
					player.MovementComponent:Jump()
					if isvalid(sc) then sc:ChangeState("JUMP") end
					log("[AutoHunt] 앞점프로 위 발판 등반 (dy=" .. string.format("%.2f", dy)
						.. " 사거리=" .. string.format("%.2f", plainReach) .. ")")
					return
				end
				-- 못 올라가는 위층 대상이다 - 5초 추적 타임아웃까지 붙어서 헛되이 기다리지 말고
				-- **바로 제외하고 다른 대상을 고른다.** 이게 없으면 제외→재선정→같은 대상으로 왕복이 반복된다.
				-- ⚠ 단, "확실히 못 간다"일 때만 제외한다 - 경사면처럼 걸어서 올라가는 지형이나 판정
				--   불가 상황에서 제외하면 멀쩡한 대상을 버리는 회귀가 된다(IsTargetLayerUnreachable 참고).
				if not self:IsTargetLayerUnreachable(player, pp, mp, plainReach) then
					-- 뛰지는 않지만 대상은 유지 - 걷기/경사면 등반이 이어서 처리한다.
					return
				end
				-- (요청 2026-08-10) 도달 불가 위층이라도 **점프 정점의 공격 박스가 닿는 높이**면
				-- 제외하지 않고 점프 공격으로 잡는다 - 그동안 이런 적은 ban되어 무시됐다
				-- (신고: "지형적으로 가기는 힘드나 점프 공격으로 간단하게 해치울 수 있는 적을 무시").
				-- (신고 2차) dy≥1.2 게이트 삭제 - "약간 위"(0.4~1.2)의 중간 발판 차단 대상도 점프
				-- 공격이 닿는다(높이 판정은 TryJumpAttack 안의 reach+1.15가 담당).
				if self:TryJumpAttack(now, player, dx, dy, plainReach, delta) then
					return
				end
				if self._T.banned == nil then self._T.banned = {} end
				self._T.banned[target] = now + 6.0
				self._T.target = nil
				self._T.nextScan = 0
				self:StopMoving()
				log("[AutoHunt] 위층 대상 도달 불가(대상 발판까지 한 번에 못 올라감 dy="
					.. string.format("%.2f", dy) .. " 사거리=" .. string.format("%.2f", plainReach)
					.. ") - 제외 후 재선정")
				return
			end
			if (self._T.nextJump or 0) <= now then
				-- (요청) 위 발판의 적에게는 점프 자체를 하지 않는다 - 점프 정점 타이밍에만 닿는
				-- 공격은 난이도만 높다. 위층 적은 FindTarget에서 아예 제외되고(섬광 보유 시 예외),
				-- 아래층 적만 다운점프로 내려가 잡는다. 컨트롤러가 꺼진 동안엔 낙하 상태 전환도
				-- 직접 해줘야 모션이 나온다 (걷기 IDLE→MOVE와 같은 이유, 착지 복귀는 OnUpdate 상단).
				-- ⚠ (신고 2026-08-10 "언덕에 올라갈 때마다 이상하게 한 번 움직인다") **올라간 직후 하강 금지.**
				--   실측 궤적(10Hz): 앞점프로 둔덕(y=-0.65)에 착지 → 0.4초 서 있다가 → 같은 x에서 그대로
				--   다운점프해 원래 층(y=-1.25)으로 되돌아가고, 이어서 한 층 더 내려갔다. 올라간 의미가
				--   사라지고 "올라갔다 도로 내려오는" 한 동작이 눈에 띈다.
				--   원인은 등반 판정(위층 대상)과 하강 판정(아래층 우선)이 서로를 모르는 것 - 착지한
				--   순간의 최근접이 아래층이면 곧바로 하강 조건이 성립한다.
				--   → 등반 직후 1.2초는 하강을 보류한다. 그 뒤에도 아래가 이득이면 그때 내려간다.
				if (self._T.noDownJumpUntil or 0) > now then
					-- 보류 중 - 이번 틱은 하강하지 않는다(걷기/공격은 그대로 진행).
				elseif dy < -0.8 and math.abs(dx) <= 1.5 then
					-- (신고 2026-08-06) 발밑에 착지 발판이 없으면 DownJump가 엔진에서 무시돼 0.8초마다
					-- 제자리 재시도(미세 이동)만 반복했다 - 레이캐스트로 착지 발판을 확인하고, 없으면
					-- 추적 타임아웃(5초)을 기다리지 않고 즉시 이 대상을 제외하고 재선정한다.
					local mapDJ = player.CurrentMap
					local fhDJ = isvalid(mapDJ) and mapDJ.FootholdComponent or nil
					local canLand = false
					local landOvershoot = false
					if isvalid(fhDJ) then
						local belowFhDJ = fhDJ:Raycast(Vector2(pp.x, pp.y - 0.3), Vector2(0, -1), 8.0)
						if belowFhDJ ~= nil then
							canLand = true
							-- (신고 2026-08-10) **과낙하 검사.** 예: 대상은 5층, 나는 7층인데 내 x의 착지점이
							-- 1층이면(대상 발판이 내 x까지 안 이어짐) 다운점프가 대상 층을 지나쳐 한참 아래로
							-- 떨어진다 - 그동안 "아래 발판이 있는가"만 보고 **어디에 떨어지는가**는 안 봤다.
							local landYDJ = belowFhDJ:GetYByX(pp.x)
							if landYDJ ~= nil and landYDJ < mp.y - 1.2 then landOvershoot = true end
						end
					end
					if not canLand then
						if self._T.banned == nil then self._T.banned = {} end
						self._T.banned[target] = now + 4.0
						self._T.target = nil
						self._T.nextScan = 0
						self:StopMoving()
						log("[AutoHunt] 아래 발판 없음 - 다운점프 불가 대상 제외 후 재선정")
						return
					end
					if landOvershoot then
						-- 대상 **바로 위**(|dx|≤0.3)로 수평 정렬한 뒤 내려간다 - 대상이 딛고 선 발판
						-- 위에서 내려가면 착지점이 반드시 그 층이다(레이가 대상 발판에 먼저 막힌다).
						local dirOv = (dx > 0) and 1 or -1
						local rbOv = player.RigidbodyComponent
						if math.abs(dx) > 0.3 and isvalid(rbOv) and rbOv:IsOnGround()
							and rbOv:PredictFootholdEnd(0.3, dirOv > 0) then
							local pccOv = player.PlayerControllerComponent
							if isvalid(pccOv) then
								if pccOv.Enable then pccOv.Enable = false end
								pccOv.LookDirectionX = dirOv
							end
							player.MovementComponent:MoveToDirection(Vector2(dirOv, 0), delta)
							self._T.moving = true
							if isvalid(sc) and sc.CurrentStateName == "IDLE" then sc:ChangeState("MOVE") end
							if (self._T.ovLogAt or -99) + 3.0 < now then
								self._T.ovLogAt = now
								log("[AutoHunt] 다운점프 과낙하 방지 - 대상 위로 정렬 중 (dx="
									.. string.format("%.2f", dx) .. " dy=" .. string.format("%.2f", dy) .. ")")
							end
							return
						end
						-- 정렬했는데도 과낙하(대상이 자기 발판 끝에 서 있음) 또는 지면이 끊겨 더 못 붙는다 -
						-- 여기서 내려가면 한참 아래로 떨어져 되돌아오는 손해만 남으니 제외하고 재선정한다.
						if self._T.banned == nil then self._T.banned = {} end
						self._T.banned[target] = now + 4.0
						self._T.target = nil
						self._T.nextScan = 0
						self:StopMoving()
						log("[AutoHunt] 다운점프 과낙하(착지점이 대상 층보다 한참 아래) - 정렬 불가라 제외 후 재선정 (dx="
							.. string.format("%.2f", dx) .. " dy=" .. string.format("%.2f", dy) .. ")")
						return
					end
					self._T.nextJump = now + 0.8
					self._T.jumpedAt = now
					-- ⚠ (신고 수정 2026-08-09) "아무 모션 없이 선 자세로 내려간다"의 원인:
					--   **PlayerControllerComponent가 꺼져 있으면 ChangeState("FALL")이 적용되지 않는다**
					--   (실측 30회: ctrlEnable=false면 직후에도 state=IDLE 그대로, true면 FALL로 전환됨).
					--   낙하 중에는 자동사냥이 이동 입력을 주지 않으므로 컨트롤러를 켜도 조작이 충돌하지 않고,
					--   오히려 엔진이 낙하/착지 모션을 스스로 재생해준다. 착지 후 정리는 OnUpdate 상단의
					--   "착지 복귀"(jumpedAt) 로직이 담당한다.
					-- ⚠ (신고 2026-08-09, 사용자 가설이 정확했다) 공격 모션 중에는 PlayerAttack이
					--   FALL/JUMP 몸동작 매핑을 통째로 빼둔다(SuppressBrandishStateMotions). 그 구간에
					--   다운점프하면 상태는 FALL이 되어도 재생할 클립이 없어 **선 자세로 내려간다**.
					--   실측: 자동사냥 중 FALL 매핑이 빠져 있는 시간이 **396 샘플 중 182(46%)**나 됐다.
					--   매핑이 돌아올 때까지 이번 틱은 미룬다 - 공격이 끝나면 곧 복구되고, 대상은 그대로라
					--   다음 틱에 정상적으로 내려간다.
					local asacDJ = player.AvatarStateAnimationComponent
					if isvalid(asacDJ) and asacDJ.StateToAvatarBodyActionSheet["FALL"] == nil then
						return
					end
					-- (요청 2026-08-09) 방금 공격했다면 다운점프를 **1초 미룬다.**
					-- 매핑 복구만으로는 부족했다는 신고("내려갈 때 모션이 경직") - 공격 클립이 아직 재생
					-- 중인데 낙하로 갈아타면 몸동작이 끊겨 굳은 것처럼 보인다. 공격 모션이 온전히 끝난 뒤
					-- 내려가게 해 전환을 매끄럽게 한다. 대상은 그대로라 1초 뒤 같은 자리에서 이어진다.
					if (self._T.lastAttackAt or -99) + 1.0 > now then
						return
					end
					local pccDJ = player.PlayerControllerComponent
					if isvalid(pccDJ) and not pccDJ.Enable then pccDJ.Enable = true end
					self._T.moving = false
					player.MovementComponent:DownJump()
					if isvalid(sc) then sc:ChangeState("FALL") end
				end
			end
		else
			-- ⚠ 방향 전환 발걸음(아래) 중에는 여기서 멈추면 안 된다 - StopMoving이 MovementComponent:Stop()을
			--   부르기 때문에, 매 틱 "정지 → 이동"이 반복되어 발걸음이 상쇄돼 제자리에 머문다(실측: 방향은
			--   55회 뒤집혔는데 x는 4.45 그대로였다).
			if self._T.moving and (self._T.turnStepUntil or 0) <= now then
				self:StopMoving()
			end
			self._T.chaseStart = now
			-- (버그 수정) 시전 직전 바라보는 방향을 대상 쪽으로 강제한다. 스킬 판정·모션·이펙트가 전부
			-- PlayerControllerComponent.LookDirectionX를 읽으므로 이 값을 직접 대입해야 방향이 바뀐다
			-- (기존 "짧은 이동" 방식은 LookDirectionX를 갱신하지 못해 반대 방향으로 시전됐음).
			-- (헛빵 수정 2) 방향이 실제로 바뀐 순간을 기록한다 - 서버는 시전 시점에 자기 복제본의
			-- LookDirectionX를 읽는데, 대입과 같은 프레임에 시전 RPC를 보내면 복제가 아직 옛 방향이라
			-- 등 뒤로 판정 박스가 열렸다(dir=-1 targets=0 다발). TryAttackCast가 이 시각을 보고
			-- 전환 직후 0.25초는 시전을 보류한다.
			-- ⚠ 불감대 0.2: 예전 0.05는 대상이 몸에 붙어 좌우로 조금만 흔들려도 방향이 뒤집혀
			--   "제자리에서 이리저리 도는" 모습이 됐다(실측 50초에 55회 전환). 0.2 안쪽 흔들림은 무시한다.
			if math.abs(dx) > 0.2 then
				local pccFace = player.PlayerControllerComponent
				if isvalid(pccFace) then
					local wantDir = (dx > 0) and 1 or -1
					if pccFace.LookDirectionX ~= wantDir then
						pccFace.LookDirectionX = wantDir
						self._T.dirChangedAt = now
						-- (요청 2026-08-09) 방향만 홱 뒤집지 말고 **살짝 걸으면서** 돌게 한다.
						self._T.turnStepUntil = now + 0.15
						self._T.turnStepDir = wantDir
					end
				end
			end
			-- 방향 전환 직후의 짧은 발걸음.
			-- ⚠ MoveToDirection의 deltaTime은 **사다리에서만** 적용된다(d.mlua) - 지상에선 걸음 길이를
			--   델타가 아니라 **지속 시간**으로 조절해야 한다. 0.15초면 약 0.2유닛으로, 사거리(1.1) 안에 머문다.
			if (self._T.turnStepUntil or 0) > now then
				local pccStep = player.PlayerControllerComponent
				if isvalid(pccStep) and pccStep.Enable then pccStep.Enable = false end
				player.MovementComponent:MoveToDirection(Vector2(self._T.turnStepDir or 1, 0), delta)
				self._T.moving = true
				if isvalid(sc) and sc.CurrentStateName == "IDLE" then
					sc:ChangeState("MOVE")
				end
			end
			-- ① 버프/소환수 유지가 우선 ② 아니면 주변 몬스터 수에 맞는 공격 스킬
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
		end
	end

	-- (신고) 끼임 탈출: 걷기 시도 중인데 실제로 거의 안 움직이면(지형 턱/모서리에 낌 - 점프나
	-- 이동기 없이는 못 빠져나옴) 전방 점프로 턱을 넘는다. 0.6초마다 이동량을 재고, 연속 3회
	-- 점프로도 못 빠져나오면 그 대상을 제외하고 재선정한다(도달 불가 지형).
	@ExecSpace("ClientOnly")
	method void CheckStuckAndJump(number now, Entity player, Vector3 pp)
		if (self._T.stuckCheckAt or 0) > now then return end
		local lastX = self._T.stuckLastX
		local lastY = self._T.stuckLastY
		self._T.stuckLastX = pp.x
		self._T.stuckLastY = pp.y
		self._T.stuckCheckAt = now + 0.6
		if lastX == nil then return end
		-- 걷기 시도 중 + 지상 + 0.6초간 이동량이 미미하면 끼임으로 판정 (공중/낙하 중은 제외)
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return end
		if math.abs(pp.x - lastX) >= 0.08 or math.abs(pp.y - lastY) >= 0.3 then
			self._T.stuckCount = 0
			return
		end
		self._T.stuckCount = (self._T.stuckCount or 0) + 1
		if self._T.stuckCount >= 3 then
			-- 점프로도 못 빠져나오는 지형: 대상을 잠시 제외하고 재선정한다.
			self._T.stuckCount = 0
			local target = self._T.target
			if target ~= nil and isvalid(target) then
				if self._T.banned == nil then self._T.banned = {} end
				self._T.banned[target] = now + 4.0
			end
			self._T.target = nil
			self._T.nextScan = 0
			self:StopMoving()
			log("[AutoHunt] 끼임 지속 - 대상 제외 후 재선정")
			return
		end
		-- (나이트로드·섀도어) 두 번째 시도부터는 평범한 점프로 이미 못 넘은 턱이므로 플래시 점프로
		-- 크게 넘어본다. 안 배웠거나 간격 제한에 걸리면 아래 평범한 점프로 그대로 떨어진다.
		if self._T.stuckCount >= 2 then
			local dirStuck = 1
			local pccStuck = player.PlayerControllerComponent
			if isvalid(pccStuck) then dirStuck = (pccStuck.LookDirectionX >= 0) and 1 or -1 end
			if self:TryFlashJumpMove(now, player, dirStuck, "끼임 탈출 (" .. tostring(self._T.stuckCount) .. "/3)") then
				return
			end
		end
		-- 전방 점프로 턱 넘기 (착지 복귀는 OnUpdate 상단의 jumpedAt 처리)
		player.MovementComponent:Jump()
		self._T.jumpedAt = now
		local sc = player.StateComponent
		if isvalid(sc) then sc:ChangeState("JUMP") end
		log("[AutoHunt] 끼임 감지 - 점프 탈출 시도 (" .. tostring(self._T.stuckCount) .. "/3)")
	end

	-- (신고 2026-08-04) 수동 조작 끼임 탈출: 이동키(좌/우 한쪽)를 누르고 있는데 지상에서 0.5초간
	-- 제자리면 지형 턱/발판 이음매에 낀 것으로 보고 자동 점프로 턱을 넘겨준다(자동사냥 끼임 탈출의
	-- 수동판 - CheckStuckAndJump와 상태를 분리해 서로 간섭하지 않는다). 시전 잠금(PlayerController
	-- 비활성) 중이나 공중에서는 판정하지 않는다.
	@ExecSpace("ClientOnly")
	method void ManualStuckTick(Entity player)
		local now = _UtilLogic.ElapsedSeconds
		local pcc = player.PlayerControllerComponent
		if not isvalid(pcc) or not pcc.Enable then
			self._T.mStuckLastX = nil
			return
		end
		local leftHeld = _InputService:IsKeyPressed(KeyboardKey.LeftArrow)
		local rightHeld = _InputService:IsKeyPressed(KeyboardKey.RightArrow)
		if leftHeld == rightHeld then   -- 안 누르거나 양쪽 동시 - 이동 의도 없음으로 보고 샘플 초기화
			self._T.mStuckLastX = nil
			return
		end
		-- (신고 2026-08-05) 시전 스윙 중에는 끼임 점프를 쏘지 않는다 - 드레인 샷처럼 컨트롤러를
		-- 끄지 않는 시전 중에 방향키를 잡고 있으면 제자리가 되는데, 이걸 지형 끼임으로 오인해
		-- "방향전환만 해도 자동으로 점프"하던 원인. 스윙이 끝나면 샘플을 새로 재기 시작한다.
		---@type PlayerAttack
		local paSwing = player:GetComponent(PlayerAttack)
		if isvalid(paSwing) and paSwing:IsSwingMotionActive() then
			self._T.mStuckLastX = nil
			return
		end
		if (self._T.mStuckCheckAt or 0) > now then return end
		local pp = player.TransformComponent.WorldPosition
		local lastX = self._T.mStuckLastX
		local lastY = self._T.mStuckLastY
		self._T.mStuckLastX = pp.x
		self._T.mStuckLastY = pp.y
		self._T.mStuckCheckAt = now + 0.5
		if lastX == nil then return end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return end
		if math.abs(pp.x - lastX) >= 0.08 or math.abs(pp.y - lastY) >= 0.3 then return end
		player.MovementComponent:Jump()
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "IDLE" or sc.CurrentStateName == "MOVE") then
			sc:ChangeState("JUMP")
		end
		-- 좌표를 남겨 끼임 지점 분석 데이터로 쓴다(신고 재현 시 이 로그 위치가 문제 지형).
		log("[AutoHunt] 수동 끼임 감지 - 자동 점프 탈출 (x=" .. string.format("%.2f", pp.x) .. " y=" .. string.format("%.2f", pp.y) .. " dir=" .. (rightHeld and "R" or "L") .. ")")
	end

	-- (다크나이트) 드래곤 라이딩 비행 이동 1틱: 탑승 시점에 기록한 목표점(rideFlightX/Y)으로 직선 비행
	-- (KinematicMove 자유이동이라 MoveToDirection에 y성분이 그대로 먹힌다).
	--
	-- (버그 수정 2026-08-04) "위 발판으로 올라가려다 별로 못 간 상태에서 내려 다시 떨어진다"는 신고.
	-- 원인 두 가지:
	--   ① 도착 판정이 **유클리드 0.8**이라, 목표(몬스터)가 대각선으로 가까우면 아직 발판 높이에
	--      한참 못 미쳤는데도 도착으로 쳐서 공중에서 하차 → 발판이 없어 그대로 추락했다.
	--      → **수평으로 붙었고(|dx|≤0.6) 목표 높이까지 실제로 올라왔을 때(y ≥ 목표y-0.25)**만 도착.
	--   ② 안전망 타임아웃이 6초 고정이었는데, 탑승 이동속도가 스펙 개편으로 1.0~1.38배까지
	--      내려가(예전 3.2배) 같은 높이를 오르는 데 훨씬 오래 걸린다 - 정상 비행 도중에 타임아웃이
	--      먼저 터져 공중에서 내려버렸다. → 거리에 비례한 타임아웃(최소 8초, 최대 20초)으로 바꾸고,
	--      "2초 동안 목표까지의 거리가 0.2도 줄지 않으면" 막힌 것으로 보고 그때 하차한다.
	@ExecSpace("ClientOnly")
	method void RideFlightTick(number now, Entity player, number delta)
		local tx = self._T.rideFlightX or 0
		local ty = self._T.rideFlightY or 0
		local pp = player.TransformComponent.WorldPosition
		local fdx = tx - pp.x
		local fdy = ty - pp.y
		local fdist = math.sqrt(fdx * fdx + fdy * fdy)

		-- 진척 감시: 2초마다 거리를 비교해 0.2 이상 줄지 않았으면 막힌 것으로 본다.
		local stalled = false
		if (self._T.rideProgressAt or 0) <= now then
			local prev = self._T.rideProgressDist
			if prev ~= nil and (prev - fdist) < 0.2 then stalled = true end
			self._T.rideProgressDist = fdist
			self._T.rideProgressAt = now + 2.0
		end

		local elapsed = now - (self._T.rideFlightStart or now)
		local limit = math.max(8.0, math.min(20.0, (self._T.rideFlightDist or fdist) * 2.0 + 5.0))
		local arrived = (math.abs(fdx) <= 0.6 and pp.y >= (ty - 0.25))
		if arrived or stalled or elapsed > limit then
			self._T.rideFlight = false
			_SkillManager:ToggleDragonRide()   -- 하차 - 드래곤은 소환수로 복귀해 따로 공격
			self._T.holdMoveUntil = now + 0.8  -- 하차 워프 연출(0.5초) 동안 대기
			self._T.target = nil
			self._T.nextScan = 0
			local reason = "도착"
			if not arrived then
				if stalled then reason = "진척 없음" else reason = "시간 초과" end
			end
			log("[AutoHunt] 드래곤 라이딩 비행 종료(" .. reason .. ") - 하차 (dist="
				.. string.format("%.2f", fdist) .. " dy=" .. string.format("%.2f", fdy)
				.. " t=" .. string.format("%.1f", elapsed) .. "/" .. string.format("%.1f", limit) .. ")")
			return
		end
		local pcc = player.PlayerControllerComponent
		if isvalid(pcc) then
			if pcc.Enable then pcc.Enable = false end
			if math.abs(fdx) > 0.05 then pcc.LookDirectionX = (fdx > 0) and 1 or -1 end
		end
		-- (버그 수정) 목표 바로 아래에서 수평 성분이 0에 가까워지면 정규화 벡터가 흔들려 제자리를
		-- 맴돈다 - 아직 높이가 모자라면 상승(y)을 우선해 확실히 발판 높이까지 올라가게 한다.
		local dirX = fdx
		local dirY = fdy
		if fdy > 0.3 and math.abs(fdx) < 0.3 then
			dirX = 0
			dirY = fdy
		end
		local dlen = math.sqrt(dirX * dirX + dirY * dirY)
		if dlen < 0.0001 then dlen = 1 end
		player.MovementComponent:MoveToDirection(Vector2(dirX / dlen, dirY / dlen), delta)
		self._T.moving = true
	end

	-- (비숍, 요청 2026-08-11) 저체력 소환수 응급 힐: 내 소환수(용사 계열 HeroSummon / 힐러
	-- HealerSummon - HP가 @Sync라 클라에서 바로 읽힌다) 중 HP 60% 미만이 있으면 사냥을 잠시 멈추고
	-- 힐 사거리(서버 실판정 ±3.6의 안쪽 3.2)까지 걸어가 힐을 시전한다. 힐은 서버(FindHealTargets)가
	-- 이미 소환수를 회복 대상에 포함하므로 여기는 "가서 쓰는" 판단만 한다.
	-- 이번 틱을 소환수 접근/시전에 썼으면 true(사냥 이동/공격은 다음 틱에).
	@ExecSpace("ClientOnly")
	method boolean TryHealSummonTick(number now, Entity player, number delta)
		if self._T.slotHeals == nil or #self._T.slotHeals == 0 then return false end
		if (self._T.nextSummonHeal or 0) > now then return false end
		local pp = player.TransformComponent.WorldPosition
		local map = player.CurrentMap
		if not isvalid(map) then return false end
		-- 가장 위급한(비율 최저) 내 소환수 하나를 고른다. 1초 게이트(전수 스캔 비용).
		local worst = nil
		local worstRatio = 0.6
		for _, comp in ipairs(map:GetChildComponentsByTypeName("script.HeroSummon", true)) do
			---@type HeroSummon
			local hs = comp
			if isvalid(hs) and isvalid(hs.Entity) and hs.OwnerEntity == player
				and (hs.HeroMaxHp or 0) > 0 and hs.HeroHp > 0 then
				local r = hs.HeroHp / hs.HeroMaxHp
				if r < worstRatio then
					worstRatio = r
					worst = hs.Entity
				end
			end
		end
		for _, comp in ipairs(map:GetChildComponentsByTypeName("script.HealerSummon", true)) do
			---@type HealerSummon
			local hl = comp
			if isvalid(hl) and isvalid(hl.Entity) and hl.OwnerEntity == player
				and (hl.HealerMaxHp or 0) > 0 and hl.HealerHp > 0 then
				local r = hl.HealerHp / hl.HealerMaxHp
				if r < worstRatio then
					worstRatio = r
					worst = hl.Entity
				end
			end
		end
		if worst == nil then
			self._T.nextSummonHeal = now + 1.0   -- 위급 소환수 없음 - 1초 뒤 재검사
			self._T.healChaseUntil = nil
			return false
		end
		-- 접근 시간 제한: 4초 안에 사거리에 못 들면 한동안 포기한다(지형으로 못 가는 소환수에 매달리지 않게).
		if self._T.healChaseUntil == nil then self._T.healChaseUntil = now + 4.0 end
		if now > self._T.healChaseUntil then
			self._T.healChaseUntil = nil
			self._T.nextSummonHeal = now + 6.0
			log("[AutoHunt] 소환수 힐 접근 포기(4초 초과)")
			return false
		end
		local tp = worst.TransformComponent.WorldPosition
		local dx = tp.x - pp.x
		local dy = tp.y - pp.y
		if math.abs(dx) <= 3.2 and math.abs(dy) <= 3.2 then
			-- 사거리 안 - 힐 시전. 재검사는 5초 뒤(힐 모션 + 회복 반영 여유).
			self._T.healChaseUntil = nil
			self._T.nextSummonHeal = now + 5.0
			self._T.holdMoveUntil = now + 0.8
			self._T.nextAtk = now + 0.8
			_SkillManager:UseSkillInSlot(self._T.slotHeals[1].key)
			log("[AutoHunt] 소환수 응급 힐 (HP " .. tostring(math.floor(worstRatio * 100)) .. "%)")
			return true
		end
		-- 사거리 밖 - 소환수 쪽으로 걷는다(소환수는 리쉬로 주인 근처에 있어 수평 접근이면 대부분 닿는다).
		if math.abs(dx) > 0.3 then
			local dir = (dx > 0) and 1 or -1
			local pccH = player.PlayerControllerComponent
			if isvalid(pccH) then
				if pccH.Enable then pccH.Enable = false end
				pccH.LookDirectionX = dir
			end
			player.MovementComponent:MoveToDirection(Vector2(dir, 0), delta)
			self._T.moving = true
			local scH = player.StateComponent
			if isvalid(scH) and scH.CurrentStateName == "IDLE" then scH:ChangeState("MOVE") end
			return true
		end
		return false
	end

	-- (팔라딘, 요청 2026-08-10) 전투 중 속성 운용. 구 "속성 콤보 선설치"(ElementComboTick - 걷다가
	-- 아무 곳에서나 제자리에서 속성을 4번이나 바꿔가며 적도 없는 허공을 때려 장판을 미리 깔던 시퀀스)는
	-- 폐지했다 - 장판은 실제 사냥 공격에 얹혀서만 나온다:
	--  ① 연계 마무리: 지금 자리(대상/나 주변)에 소모 가능한 속성 필드가 있으면 - 즉 "한 번만 더 다른
	--     속성으로 공격하면 장판이 깔리는" 상황이면 - 그 속성으로 바꿔둔다. 다음 공격 틱의 차지 블로우
	--     한 방이 실제 대상을 때리면서 연계를 터뜨린다. (2026-08-15 양방향화) 쌍은 불↔얼음(화상 저주)과
	--     얼음↔전기(감전) 둘이고, 어느 속성이 먼저든 성립한다 - 전기 필드도 얼음으로 마무리할 수 있다.
	--     필드 존재는 PlayerAttack의 클라 사본(GetChainReadyFieldMode)으로 본다 - 용사 소환수가 깐
	--     필드도 같은 장부라 함께 잡힌다.
	--  ② 속성 다양화: 연계 거리가 없으면 9~13초마다 스윙(불)→스티그마(얼음)→저지먼트(전기)→차지(성)
	--     순환으로 드는 속성을 바꾼다(퀵슬롯에 있는 것만, 저지먼트만 계속 들고 있지 않게). 순서가
	--     불→얼음→전기라, 속성필드 버프 중엔 직전 주기가 남긴 필드를 다음 주기 첫 타가 바로 ①로 소모한다.
	-- 사거리 검증을 통과한 실제 대상이 있는 공격 틱에서만 호출된다. 속성을 바꾼 틱은 true -
	-- 이번 공격 틱은 전환에 쓰고, 0.35초 뒤 공격 틱이 차지 블로우를 뽑아 마무리한다.
	@ExecSpace("ClientOnly")
	method boolean IsChargeModeReady(integer mode)
		-- (팔라딘) 그 속성이 재사용 대기에 걸려 있지 않은지. 2026-08-15부터 속성을 바꾸면 **직전에 쓰던
		-- 속성**이 20초 잠기므로, 자동사냥이 잠긴 속성으로 전환을 시도해 공격 틱을 헛되이 쓰지 않게
		-- 후보 선정 단계에서 미리 거른다.
		return _SkillManager:GetChargeBlowModeCooldownLeft(mode) <= 0
	end

	@ExecSpace("ClientOnly")
	method boolean ElementChainTick(number now, Entity player, Vector3 pp, Vector3 tp)
		local modes = self._T.slotChargemodes
		if modes == nil or #modes == 0 then return false end
		local hasCb = false
		if self._T.slotAoes ~= nil then
			for _, s in ipairs(self._T.slotAoes) do
				if s.name == "차지 블로우" then hasCb = true break end
			end
		end
		if not hasCb then return false end
		-- 전환 최소 간격 2.5초: 디바인 공용 0.5초 쿨 존중 + 얼음↔전기 왕복 플랩 방지.
		if (self._T.nextElemSwitch or 0) > now then return false end
		local byName = {}
		for _, s in ipairs(modes) do byName[s.name] = s end
		local cur = _SkillManager:GetEffectiveChargeBlowMode()
		-- ① 연계 마무리 - 대상 위치 우선, 없으면 내 위치(허공이어도 서버가 시전자 위치로 연계를 판정한다).
		--    이미 소모 속성을 들고 있으면(cur가 얼음/전기) 전환 없이 그냥 공격해도 연계가 터진다 - false.
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		local switchTo = nil
		local reason = ""
		if isvalid(pa) then
			local fm = pa:GetChainReadyFieldMode(tp)
			if fm == 0 then fm = pa:GetChainReadyFieldMode(pp) end
			-- (양방향 연계 2026-08-15) 얼음 필드는 전기·불 **어느 쪽으로도** 소모된다 - 이미 둘 중
			-- 하나를 들고 있으면 전환 없이 그냥 때린다. 전기 필드는 얼음이 소모한다(신규 방향).
			if fm == 2 and cur ~= 1 and self:IsChargeModeReady(1) then
				switchTo = byName["디바인 스티그마 강화"]
				reason = "불 필드 연계(화상 저주)"
			elseif fm == 1 and cur ~= 3 and cur ~= 2 and self:IsChargeModeReady(3) then
				-- 얼음 필드는 전기·불 어느 쪽으로도 소모되지만, 전기 쪽이 감전 장판(20초 지속딜)을
				-- 남겨 화상 저주 장판과 함께 굴릴 수 있으므로 우선한다.
				switchTo = byName["디바인 저지먼트 강화"]
				reason = "얼음 필드 연계(감전)"
			elseif fm == 1 and cur ~= 3 and cur ~= 2 and self:IsChargeModeReady(2) then
				-- 전기가 20초 대기 중이면 불로 마무리해도 같은 화상 저주 쌍이 성립한다.
				switchTo = byName["디바인 스윙 강화"]
				reason = "얼음 필드 연계(화상 저주)"
			elseif fm == 3 and cur ~= 1 and self:IsChargeModeReady(1) then
				switchTo = byName["디바인 스티그마 강화"]
				reason = "전기 필드 연계(감전)"
			end
		end
		-- ② 속성 다양화 - 연계 거리가 없을 때만 주기 순환.
		if switchTo == nil then
			if self._T.elemDwellUntil == nil then
				-- 자동사냥 시작 직후에는 지금 속성 그대로 한 주기를 쓴다(켜자마자 전환하지 않게).
				self._T.elemDwellUntil = now + 9.0 + _UtilLogic:RandomDouble() * 4.0
				return false
			end
			if self._T.elemDwellUntil > now then return false end
			local cycle = {
				{ mode = 2, name = "디바인 스윙 강화" },
				{ mode = 1, name = "디바인 스티그마 강화" },
				{ mode = 3, name = "디바인 저지먼트 강화" },
				{ mode = 4, name = "디바인 차지" },
			}
			local curIdx = 1
			for i, c in ipairs(cycle) do
				if c.mode == cur then curIdx = i break end
			end
			-- 현재 속성의 "다음"부터 순서대로, 퀵슬롯에 있는 첫 속성으로 넘어간다.
			for off = 1, 3 do
				local c = cycle[((curIdx - 1 + off) % 4) + 1]
				-- (2026-08-15) 직전에 쓰던 속성은 20초 잠기므로 순환 후보에서도 건너뛴다.
				if byName[c.name] ~= nil and self:IsChargeModeReady(c.mode) then
					switchTo = byName[c.name]
					reason = "속성 순환"
					break
				end
			end
			if switchTo == nil then return false end
			self._T.elemDwellUntil = now + 9.0 + _UtilLogic:RandomDouble() * 4.0
		end
		self._T.nextElemSwitch = now + 2.5
		self._T.nextAtk = now + 0.35   -- 속성 전환은 즉시형 - 곧바로 다음 공격 틱을 연다
		_SkillManager:UseSkillInSlot(switchTo.key)
		log("[AutoHunt] 속성 전환: " .. switchTo.name .. " (" .. reason .. ")")
		return true
	end

	-- (요청 2026-08-10) 버프를 "거의 안 끊기게" - 재시전 시점 판정(HasPendingUtility/버프 루프 공용).
	-- 1차: 버프바 잔여시간 실측(폐루프) - 6초 이하로 내려오면 재시전(서버는 중첩 없이 지속시간만
	-- 갱신하므로 일찍 시전해도 안전). 여유를 6초로 둔 이유: 추격/등반/시전 홀드 구간에는 유틸 틱이
	-- 돌지 않아서, 3초 여유로는 만료 시점에 2~5초 끊기는 것이 실측됐다(아이언 월 -0.0 도달 후 재시전).
	-- 시전 직후 4초는 서버 반영 유예(중복 시전 방지)이자, MP 부족/시전 잠금/사망 등으로
	-- UseSkillInSlot이 조용히 거부됐을 때의 재시도 간격이다. 구 주기(개루프) 방식은 거부돼도
	-- lastCast가 갱신돼 버프가 꺼진 채 최대 한 주기(수 분)를 방치했다 - 수동 취소/사망 소실도
	-- 이제 몇 초 안에 되살린다.
	-- 2차(잔여 조회 불가 버프만): 기존 주기 방식(GetBuffPeriod).
	@ExecSpace("ClientOnly")
	method boolean IsBuffDue(number now, string skillName)
		local last = (self._T.lastCast and self._T.lastCast[skillName]) or -99999
		local remaining = self:GetBuffRemainingByName(skillName)
		if remaining >= 0 then
			return remaining <= 6.0 and (now - last) >= 4.0
		end
		return (now - last) >= self:GetBuffPeriod(skillName)
	end

	-- (요청 2026-08-10) 스킬 이름 → 버프바 잔여시간(초). 버프 유지의 **1차 판정**은 이 실측값이다 -
	-- 잔여가 3초 이하로 내려오면 재시전(TryUtilityCast 버프 루프의 폐루프 경로). 매핑이 없어 잔여를
	-- 조회할 수 없는 버프만 -1을 돌려 주기 방식(GetBuffPeriod)으로 떨어진다.
	-- 매핑은 BuffBarManager.buffList와 같은 BuffUI Logic들을 쓴다.
	@ExecSpace("ClientOnly")
	method number GetBuffRemainingByName(string skillName)
		if skillName == "부스터" then return _BoosterBuffUI:GetRemaining() end
		if skillName == "헤이스트" then return _HasteBuffUI:GetRemaining() end
		if skillName == "콤보 어택" then return _ComboBuffUI:GetRemaining() end
		if skillName == "쉐도우 파트너" then return _ShadowPartnerBuffUI:GetRemaining() end
		if skillName == "아이언 월" then return _IronWallBuffUI:GetRemaining() end
		if skillName == "속성필드" then return _ElemFieldBuffUI:GetRemaining() end
		if skillName == "분노" then return _RageBuffUI:GetRemaining() end
		if skillName == "메디테이션" then return _MeditationBuffUI:GetRemaining() end
		if skillName == "블레스" then return _BlessBuffUI:GetRemaining() end
		if skillName == "파워가드" then return _PowerGuardBuffUI:GetRemaining() end
		if skillName == "불의 영역" then return _FireZoneBuffUI:GetRemaining() end
		if skillName == "빙하지대" then return _GlacierBuffUI:GetRemaining() end
		if skillName == "발도술" then return _BattoBuffUI:GetRemaining() end
		if skillName == "샤프 아이즈" then return _SharpEyesBuffUI:GetRemaining() end
		if skillName == "암행" then return _AmhaengBuffUI:GetRemaining() end
		if skillName == "암행2" then return _Amhaeng2BuffUI:GetRemaining() end
		return -1.0
	end

	-- 버프별 재시전 주기(초) - **잔여시간을 조회할 수 없는 버프의 예비 경로**(GetBuffRemainingByName이
	-- -1인 경우). 기본값은 5분 버프 가정의 270초, 지속시간이 투자 레벨 비례인 버프는
	-- 실제 지속시간 공식(SkillManager의 단일 출처 헬퍼)에서 2초 여유를 빼 "만료 직전 갱신"한다.
	-- 자동사냥 ON 직후에는 lastCast가 비어 있어 어떤 주기든 즉시 1회 시전된다 - "꺼져 있으면 바로 켠다".
	@ExecSpace("ClientOnly")
	method number GetBuffPeriod(string skillName)
		-- (신고 2026-08-10) 콤보 어택: 구 코드는 "30분 버프"라는 낡은 가정으로 1500초(25분)였는데,
		-- 실제 지속시간은 개편 후 **레벨 비례 120초(Lv1)~600초(Lv30)**다 - Lv30이 아니면 버프가
		-- 꺼진 채 최대 23분을 방치해 구슬이 안 쌓이고 코마/패닉도 못 나갔다("끝나갈 때 다시 써야
		-- 한다"의 직접 원인). 만료 2초 전에 갱신한다(서버가 중첩 없이 지속시간만 갱신).
		if skillName == "콤보 어택" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("콤보 어택"))
			return math.max(10.0, _SkillManager:GetComboDurationForLevel(lv) - 2.0)
		end
		-- (같은 유형 일괄 수정) 아래 버프들도 지속시간이 레벨 비례라 기본 270초로는 하위 레벨에서
		-- 버프가 꺼진 채 방치됐다(부스터/분노/파워가드는 Lv1 20초!). 각자의 실제 공식과 동기화.
		if skillName == "부스터" or skillName == "분노" or skillName == "파워가드" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName(skillName))
			return math.max(10.0, _SkillManager:GetHeroBuffDuration(lv) - 2.0)
		end
		if skillName == "헤이스트" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("헤이스트"))
			return math.max(10.0, _SkillManager:GetHasteDurationForLevel(lv) - 2.0)
		end
		if skillName == "샤프 아이즈" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("샤프 아이즈"))
			return math.max(10.0, _SkillManager:GetSharpEyesDuration(lv) - 2.0)
		end
		if skillName == "메디테이션" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("메디테이션"))
			return math.max(10.0, _SkillManager:GetMeditationDuration(lv) - 2.0)
		end
		-- (팔라딘) 지속시간이 투자 레벨 비례인 버프는 만료 2초 전에 갱신한다.
		if skillName == "아이언 월" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("아이언 월"))
			return math.max(10.0, 30.0 + 20.0 * (lv - 1) - 2.0)
		end
		if skillName == "속성필드" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("속성필드"))
			return math.max(10.0, 60.0 + 20.0 * (lv - 1) - 2.0)
		end
		-- (나이트로드) 암행 - 1분 + 분배당 10초. 만료 2초 전에 갱신한다.
		if skillName == "암행" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("암행"))
			return math.max(10.0, _SkillManager:GetAmhaengDuration(lv) - 2.0)
		end
		-- (섀도어) 암행2 - 암행1과 완전히 같은 지속시간 공식(GetAmhaengDuration)을 쓴다.
		if skillName == "암행2" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("암행2"))
			return math.max(10.0, _SkillManager:GetAmhaengDuration(lv) - 2.0)
		end
		-- (나이트로드) 쉐도우 파트너 - 30초 + 분배당 10초. 표창 100개를 먹지만 재고가 모자라면
		-- 낮은 번호 표창으로 자동 폴백하므로 주기 유지만 하면 된다.
		if skillName == "쉐도우 파트너" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("쉐도우 파트너"))
			return math.max(10.0, _SkillManager:GetShadowPartnerDurationForLevel(lv) - 2.0)
		end
		-- (히어로) 발도술도 지속시간이 투자 레벨 비례(30초 + 분배당 20초) - 만료 2초 전에 갱신한다.
		if skillName == "발도술" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("발도술"))
			return math.max(10.0, 30.0 + 20.0 * (lv - 1) - 2.0)
		end
		return 270.0
	end

	-- 소환수 재소환 주기(초). 기본은 290초(지속 5분/10분짜리 소환수 기준)다.
	-- ⚠ (요청 2026-08-13) 프리져·피닉스는 지속시간이 **투자 레벨별**(20초 + 분배당 10초, 마스터 210초)이라
	--   290초를 그대로 쓰면 소환수가 사라진 채로 최대 4분 반을 방치하게 된다 - 실제 지속시간에서
	--   5초를 뺀 값으로 재소환한다(끊기기 직전에 갱신).
	--   (요청 2026-08-13) 피닉스도 프리져와 같이 재사용 대기시간이 없어져 언제든 다시 부를 수 있다 -
	--   두 소환수의 규격(데미지·지속시간·MP·무쿨)이 완전히 같아졌으므로 여기 규칙도 하나로 맞춘다.
	@ExecSpace("ClientOnly")
	method number GetSummonRecastInterval(string skillName)
		if skillName == "프리져" then
			local frLv = math.max(1, _SkillManager:GetHeroSkillLevelByName("프리져"))
			return math.max(10.0, _SkillManager:GetFreezerDuration(frLv) - 5.0)
		end
		if skillName == "피닉스" then
			local phLv = math.max(1, _SkillManager:GetHeroSkillLevelByName("피닉스"))
			return math.max(10.0, _SkillManager:GetPhoenixDuration(phLv) - 5.0)
		end
		return 290.0
	end

	-- 버프(스킬별 주기 유지)·소환수(재소환 주기 - GetSummonRecastInterval)를 하나씩 돌아가며 유지한다.
	-- 이번 틱에 유틸 스킬을 시전했으면 true (공격은 다음 틱에).
	-- (나이트로드) 각성이 지금 켜져 있는가 - 제자리 사냥 판정에 쓴다.
	@ExecSpace("ClientOnly")
	method boolean IsAwakeningOn()
		return _SkillManager:IsAwakeningActive()
	end

	@ExecSpace("ClientOnly")
	method boolean HasPendingUtility(number now)
		-- 지금 "쓰고 싶은 유틸 스킬"이 하나라도 있는가. 암살 잠금을 풀지 말지 정하는 데만 쓴다
		-- (아래 TryUtilityCast의 실제 조건들 중 시간/쿨 게이트만 싸게 재확인한다).
		if self._T.lastCast == nil then return true end
		if self._T.slotBuffs ~= nil then
			for _, s in ipairs(self._T.slotBuffs) do
				if self:IsBuffDue(now, s.name) then return true end
			end
		end
		if self._T.slotSummons ~= nil then
			for _, s in ipairs(self._T.slotSummons) do
				if s.name == "서먼 다크드래곤" then
					if _SkillManager:CanAutoSummonDarkDragon() then return true end
				elseif now - (self._T.lastCast[s.name] or -99999) >= self:GetSummonRecastInterval(s.name) then return true end
			end
		end
		if self._T.slotShadowClones ~= nil and #self._T.slotShadowClones > 0
			and _SkillManager:CanAutoSummonShadowClone() then return true end
		if self._T.slotSmokeScreens ~= nil and #self._T.slotSmokeScreens > 0
			and _SkillManager:CanAutoCastSmokeScreen() then return true end
		if self._T.slotDarkSights ~= nil and #self._T.slotDarkSights > 0
			and (self._T.nextDarkSight or 0) <= now and _SkillManager:CanAutoCastDarkSight() then return true end
		return false
	end

	-- (요청 2026-08-12) 유틸/버프를 시전한 직후의 이동 잠금 시간을 한 곳에서 정한다.
	-- ⚠ 왜 필요한가: 종전엔 어느 시전이든 `nextUtil = now + 1.2` / `holdMoveUntil = now + 1.0`을
	--   나란히 박아뒀는데, **잠금(1.0)이 다음 시전(1.2)보다 0.2초 먼저 풀린다**. 그래서 버프가 여러 개
	--   밀려 있으면 "하나 쓰고 → 0.2초 걸어가고 → 하나 쓰고"가 반복돼 제자리 시전이 안 됐다(신고).
	-- → 아직 쓸 유틸이 남아 있으면 **다음 시전 시각까지 통째로 붙잡아** 제자리에서 연속으로 쓰고,
	--   마지막 한 발이면 모션(1.0초)만 덮고 곧바로 사냥으로 돌아간다.
	-- ⚠ 호출 순서 주의 - 이 메서드는 **자기 스킬의 게이트를 갱신한 뒤에** 불러야 한다
	--   (lastCast / next* 를 먼저 밀어두지 않으면 방금 쓴 스킬이 "아직 밀려 있음"으로 잡힌다).
	@ExecSpace("ClientOnly")
	method void MarkUtilityCast(number now)
		-- 유틸 시전 후 다음 시전 시각과 이동 잠금을 함께 세운다.
		local gap = 1.2   -- 유틸 시전 간격 1.2초 (시전 모션 겹침 방지 - 종전 각 시전부에 흩어져 있던 값)
		self._T.nextUtil = now + gap
		if self:HasPendingUtility(now) then
			-- 다음 시전까지 이동 금지(+0.05초 여유) - 잠금이 먼저 풀리는 틈 자체를 없앤다.
			self._T.holdMoveUntil = now + gap + 0.05
		else
			self._T.holdMoveUntil = now + 1.0
		end
		-- ⚠ 잠금(holdMoveUntil)은 "새 이동 명령을 내리지 않는다"일 뿐 **이미 걷던 속도를 멈추지 않는다**
		--   (OnUpdate 상단이 그냥 return한다). 실측: 걸어가다 첫 버프를 쓰면 잔여 속도로 1.06유닛을 더
		--   미끄러졌다. 아이언 월/샤프 아이즈 시전부와 같은 방식으로 여기서 이동을 끊어 제자리에 세운다.
		local pUH = _UserService.LocalPlayer
		if isvalid(pUH) and isvalid(pUH.MovementComponent) then
			pUH.MovementComponent:Stop()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean TryUtilityCast(number now)
		if (self._T.nextUtil or 0) > now then return false end
		if self._T.lastCast == nil then self._T.lastCast = {} end
		-- (버그 수정 2026-08-06) **암살 잠금이 유틸 스킬을 영영 굶긴다.**
		-- 암살로 사라져 있는 동안에는 UseSkillInSlot이 암살 외 모든 스킬을 거부하는데(의도된 규칙),
		-- 자동사냥이 암살을 주력으로 쓰면 홀드가 매 시전마다 갱신돼 그 구간이 끊기지 않는다.
		-- 실측: 20초 동안 "암살 중 - 다른 스킬 사용 불가 (분신 소환/연막/다크사이트/어썰터)"만 반복되고
		-- **분신이 한 번도 소환되지 않았다** - "분신이 공격을 안 한다"의 진짜 원인이었다.
		-- → 쓸 유틸이 실제로 밀려 있을 때만 홀드를 풀고, 잠깐(1.2초) 암살을 쉬어 시전 창을 만든다.
		if _SkillManager:IsAssassinateActive() then
			if self:HasPendingUtility(now) then
				_SkillManager:ReleaseAssassinateHold()
				self._T.assassinatePauseUntil = now + 1.2
				log("[AutoHunt] 암살 홀드 해제 - 밀린 유틸 스킬 시전 창 확보")
			end
			return false
		end
		-- (나이트로드) 토글 스킬 자동 ON 주기 체크.
		-- ⚠ (2026-08-07) 마크 오브 어쌔신 자동 ON은 스킬이 "트레이닝"(순수 공격력 패시브)으로
		--   바뀌면서 제거했다 - 이제 켤 것이 없으므로 표창 분산만 남는다.
		if (self._T.nextMarkCheck or 0) <= now then
			self._T.nextMarkCheck = now + 5.0
			-- (나이트로드, 요청 2026-08-07) 표창 분산도 같은 주기에 켠다 - 사냥은 다수 대상이 기본이라
			-- 분산이 항상 이득이고(적이 발 수만큼 있으면 총 출력 1.2~2.4배), 단일 대상에서만 손해다.
			-- ⚠ (버그 수정 2026-08-12) **직업 확인 필수.** 스킬 투자 레벨은 직업이 바뀌어도 데이터에
			--   남아서, 레벨만 보면 히어로/다크나이트로 사냥하는 중에도 나이트로드 전용 토글이 켜진다
			--   (신고: 자동사냥 중 버프바에 표창 계열 아이콘이 떴다 - 실측 로그 `표창 분산 자동 ON`).
			if not _SkillManager:IsStarSpreadEnabled()
				and _SkillManager:IsSkillInCurrentJob("표창 분산")
				and _SkillManager:GetHeroSkillLevelByName("표창 분산") >= 1 then
				_SkillManager:SetStarSpreadEnabled(true)
				log("[AutoHunt] 표창 분산 자동 ON")
			end
		end
		-- (나이트로드, 요청 2026-08-06) 표창+ 주기 교체: 표창이 2종 이상 열려 있으면 10초~3분 랜덤
		-- 주기로 갈아끼우며 사냥한다. (요청 보강 2026-08-06) **가능한 높은 등급 우선** - 재고가
		-- 넉넉한(40개↑) 2번 이상 표창만 후보로, 번호가 높을수록 가중 2배씩(최고 등급 위주 + 약간의
		-- 다양성). 1번(무제한 기본 표창)은 다른 표창 재고가 전부 바닥일 때만 고른다 - 사냥 중
		-- 소진 시 낮은 번호로 내려가는 폴백은 TryConsumeShuriken이 따로 처리한다.
		-- 다른 유틸 시전을 막지 않는 즉시 동작이라 return하지 않는다.
		-- ⚠ 위 표창 분산과 같은 이유로 **직업을 먼저 확인**한다 - 표창+ 투자가 남아 있는 타 직업
		--   캐릭터가 사냥 중에 표창을 갈아끼우는(= 표창+ 계열이 발동하는) 일이 없게 한다.
		if _SkillManager:IsSkillInCurrentJob("표창+") and _SkillManager:GetUnlockedShurikenCount() >= 2 then
			if (self._T.nextShurikenSwap or 0) <= now then
				local unlocked = _SkillManager:GetUnlockedShurikenCount()
				self._T.nextShurikenSwap = now + 10.0 + _UtilLogic:RandomDouble() * 170.0
				local cands = {}
				local total = 0
				for i = 2, unlocked do
					if _SkillManager:GetShurikenCount(i) >= 40 then
						local w = 2 ^ (i - 1)
						table.insert(cands, { idx = i, w = w })
						total = total + w
					end
				end
				local pick = 1
				if total > 0 then
					local r = _UtilLogic:RandomDouble() * total
					pick = cands[#cands].idx
					for _, c in ipairs(cands) do
						r = r - c.w
						if r <= 0 then
							pick = c.idx
							break
						end
					end
				end
				_SkillManager:AutoSelectShuriken(pick)
			end
		end
		-- (나이트로드, 요청) 각성은 쿨(5분 고정)이 돌면 **가장 먼저** 쓴다 - 지속 39초 동안 공속 +15단계에
		-- 표창 3종이 드래곤 로어 범위를 전부 조준하므로 아껴 봐야 손해다. 이미 켜져 있으면 건너뛴다.
		-- 실제 쿨 판정은 SkillManager의 전용 게이트가 하므로 여기서는 20초마다 조회만 재시도한다.
		if self._T.slotAwakenings ~= nil and #self._T.slotAwakenings > 0 then
			if (self._T.nextAwakening or 0) <= now and not self:IsAwakeningOn() then
				self._T.nextAwakening = now + 20.0
				if _SkillManager:CanAutoCastAwakening() then
					self:MarkUtilityCast(now)
					_SkillManager:UseSkillInSlot(self._T.slotAwakenings[1].key)
					log("[AutoHunt] 각성 시전 (쿨 종료 - 즉시 사용)")
					return true
				end
			end
		end
		-- (썬콜, 요청 2026-08-08) 리커버리 오로라: 재사용 대기시간이 돌면 사냥 중인 자리에 다시 깐다 -
		-- 주변 노쿨을 이용해 블리자드(썬콜)/메테오(불독 - "리커버리 마나")를 난사하는 콤보의 축
		-- (MageAuraComboTick이 활용한다).
		-- 허공/이동 경로에 낭비하지 않게 주변(±8유닛, 같은 층)에 몬스터가 있을 때만 설치한다.
		if self._T.slotRecoveryAuras ~= nil and #self._T.slotRecoveryAuras > 0 then
			if (self._T.nextRecoveryAura or 0) <= now then
				self._T.nextRecoveryAura = now + 10.0   -- 조회 재시도 간격(실제 게이트는 자체 쿨 2~3분)
				local playerRA = _UserService.LocalPlayer
				if isvalid(playerRA) and _SkillManager:CanAutoCastRecoveryAura() then
					local ppRA = playerRA.TransformComponent.WorldPosition
					if self:CountNearbyMonsters(playerRA, ppRA, 8.0) >= 1 then
						self:MarkUtilityCast(now)
						_SkillManager:UseSkillInSlot(self._T.slotRecoveryAuras[1].key)
						log("[AutoHunt] " .. self._T.slotRecoveryAuras[1].name .. " 설치 (주변 노쿨 - 난사 콤보)")
						return true
					end
				end
			end
		end
		if self._T.slotBuffs ~= nil then
			for _, s in ipairs(self._T.slotBuffs) do
				-- (요청 2026-08-10) 버프를 "거의 안 끊기게" - 판정은 IsBuffDue(버프바 잔여 실측 폐루프).
				-- 비용을 못 내면 건너뛰고 다음 유틸 틱에 재시도한다(UseSkillInSlot 조용한 거부로
				-- 유틸 슬롯 1.2초를 허비하지 않게).
				if self:IsBuffDue(now, s.name) then
					if not _SkillManager:CanAffordSkillCost(s.name) then
						-- (요청 2026-08-12) **버프 복구 우선 마나 절약 모드.** 버프가 밀렸는데 MP가 모자라
						-- 못 켜는 상황이면 이 창을 열어둔다 - TryAttackCast가 MP를 쓰는 공격 스킬을
						-- 3번에 1번만 쓰고 나머지는 기본공격(MP 0)으로 때워 버프를 먼저 되살린다.
						-- 이 루프는 시전이 없으면 nextUtil을 밀지 않아 매 틱 돌므로 창이 계속 갱신된다.
						self._T.mpSaveUntil = now + 3.0
					end
					if _SkillManager:CanAffordSkillCost(s.name) then
						self._T.lastCast[s.name] = now
						self:MarkUtilityCast(now)
						_SkillManager:UseSkillInSlot(s.key)
						log("[AutoHunt] 유지 시전: " .. s.name .. " (" .. s.key .. ")")
						return true
					end
				end
			end
		end
		if self._T.slotSummons ~= nil then
			for _, s in ipairs(self._T.slotSummons) do
				-- (다크나이트, 요청 2026-08-10) 서먼 다크드래곤은 고정 주기(구 605초)가 아니라 **실제 상태**로
				-- 판단한다: 드래곤이 사라졌는지(소멸 통보로 활성 창이 닫힘) + 쿨 종료(또는 드래곤의
				-- "쿨타임 초기화" 버프/오로라로 풀림)를 10초마다 조회한다. 구 방식은 드래곤이 일찍 사라지거나
				-- 시전이 거부돼도 lastCast가 갱신돼 최대 605초를 드래곤 없이 방치했다.
				if s.name == "서먼 다크드래곤" then
					if (self._T.nextDarkDragon or 0) <= now then
						self._T.nextDarkDragon = now + 10.0
						if _SkillManager:CanAutoSummonDarkDragon() then
							self:MarkUtilityCast(now)
							_SkillManager:UseSkillInSlot(s.key)
							log("[AutoHunt] 서먼 다크드래곤 재소환 (드래곤 없음 + 쿨 종료)")
							return true
						end
					end
				else
					local last = self._T.lastCast[s.name] or -99999
					if now - last >= self:GetSummonRecastInterval(s.name) then
						-- (요청 2026-08-13) 용사 소환·프리져가 MP 100을 쓰게 되면서 버프와 같은 처리가 필요해졌다 -
						-- 비용을 못 내면 lastCast를 밀지 않고 건너뛰어 다음 유틸 틱에 재시도한다(밀어버리면
						-- 소환에 실패한 채 재소환 주기만큼 방치된다). 마나 절약 창도 함께 연다.
						if not _SkillManager:CanAffordSkillCost(s.name) then
							self._T.mpSaveUntil = now + 3.0
						else
							self._T.lastCast[s.name] = now
							self:MarkUtilityCast(now)
							_SkillManager:UseSkillInSlot(s.key)
							log("[AutoHunt] 유지 시전: " .. s.name .. " (" .. s.key .. ")")
							return true
						end
					end
				end
			end
		end
		-- (다크나이트) 드래곤 라이딩: 미소환 + 재사용 대기 종료 상태에서만 "소환"으로 사용한다.
		-- 활성 중 재시전은 탑승 토글이라 CanAutoSummonDragonRide가 막는다(자동사냥은 절대 탑승하지 않음).
		if self._T.slotDragonRides ~= nil and #self._T.slotDragonRides > 0 then
			if (self._T.nextDragonRide or 0) <= now then
				self._T.nextDragonRide = now + 20.0   -- 조회 재시도 간격(실제 재소환은 자체 쿨 5분이 게이트)
				if _SkillManager:CanAutoSummonDragonRide() then
					self:MarkUtilityCast(now)
					_SkillManager:UseSkillInSlot(self._T.slotDragonRides[1].key)
					log("[AutoHunt] 드래곤 라이딩 소환 (자동사냥은 탑승하지 않음)")
					return true
				end
			end
		end
		-- (다크나이트) 드래곤 블러드: HP를 계속 소모하는 유지형(10초마다 최대 HP 4%, 10% 이하 자동해제).
		-- 주기 재시전 대신 버프바 잔여로 꺼짐(자동해제 포함)을 감지해 재점화하되, HP 50% 미만이면
		-- 켜자마자 다시 자동해제로 떨어지는 낭비라 HP가 회복될 때까지 기다린다.
		if self._T.slotDragonBloods ~= nil and #self._T.slotDragonBloods > 0 then
			if (self._T.nextDragonBlood or 0) <= now then
				self._T.nextDragonBlood = now + 10.0
				if _DragonBloodBuffUI:GetRemaining() <= 3.0 then
					local playerDB = _UserService.LocalPlayer
					if isvalid(playerDB) then
						local pcDB = playerDB.PlayerComponent
						if isvalid(pcDB) and (pcDB.MaxHp or 0) > 0 and (pcDB.Hp or 0) / pcDB.MaxHp >= 0.5 then
							self:MarkUtilityCast(now)
							_SkillManager:UseSkillInSlot(self._T.slotDragonBloods[1].key)
							log("[AutoHunt] 드래곤 블러드 재점화 (HP " .. tostring(pcDB.Hp) .. "/" .. tostring(pcDB.MaxHp) .. ")")
							return true
						end
					end
				end
			end
		end
		-- (팔라딘) 리스토네이션: HP가 풀이 아닐 때만 30~60초 랜덤 주기로 사용 (요청).
		if self._T.slotRestorations ~= nil and #self._T.slotRestorations > 0 then
			if (self._T.nextRestoration or 0) <= now then
				local player = _UserService.LocalPlayer
				if isvalid(player) then
					local pc = player.PlayerComponent
					if isvalid(pc) and (pc.Hp or 0) < (pc.MaxHp or 0) then
						self._T.nextRestoration = now + 30.0 + _UtilLogic:RandomDouble() * 30.0
						self:MarkUtilityCast(now)
						_SkillManager:UseSkillInSlot(self._T.slotRestorations[1].key)
						log("[AutoHunt] 리스토네이션 시전 (HP " .. tostring(pc.Hp) .. "/" .. tostring(pc.MaxHp) .. ")")
						return true
					end
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 분신 소환: 미소환 + 재사용 대기(5분) 종료 상태에서만 소환한다.
		-- ⚠ 살아 있을 때 다시 누르면 위치 교환이라 절대 재시전하지 않는다(CanAutoSummonShadowClone).
		if self._T.slotShadowClones ~= nil and #self._T.slotShadowClones > 0 then
			if (self._T.nextShadowClone or 0) <= now then
				self._T.nextShadowClone = now + 15.0   -- 조회 재시도 간격(실제 게이트는 자체 쿨 5분)
				if _SkillManager:CanAutoSummonShadowClone() then
					self:MarkUtilityCast(now)
					_SkillManager:UseSkillInSlot(self._T.slotShadowClones[1].key)
					log("[AutoHunt] 분신 소환 (자동사냥은 위치 교환을 쓰지 않는다)")
					return true
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 연막: 암살이 강화되는 구간이라 재사용 대기시간(3분)이 돌면
		-- 바로 깐다. 다만 광역 강화라 혼자 있는 몬스터 하나에 쓰면 낭비 - 주변에 2마리 이상일 때만.
		-- (연막 안에서의 스킬 선택 비율은 TryAttackCast의 섀도어 블록이 담당한다.)
		if self._T.slotSmokeScreens ~= nil and #self._T.slotSmokeScreens > 0 then
			if (self._T.nextSmokeScreen or 0) <= now then
				self._T.nextSmokeScreen = now + 10.0   -- 조회 재시도 간격(실제 게이트는 자체 쿨 3분)
				local playerSS = _UserService.LocalPlayer
				if isvalid(playerSS) and _SkillManager:CanAutoCastSmokeScreen() then
					local ppSS = playerSS.TransformComponent.WorldPosition
					if self:CountNearbyMonsters(playerSS, ppSS, 3.0) >= 2 then
						self:MarkUtilityCast(now)
						_SkillManager:UseSkillInSlot(self._T.slotSmokeScreens[1].key)
						log("[AutoHunt] 연막 시전 (암살 강화 구간 진입)")
						return true
					end
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 다크사이트: "가끔" = 재사용 대기시간 ~ 그 4배 사이 랜덤 주기.
		-- 켜고 나면 3~10초 뒤에 적의 뒤를 잡아 때린다(DarkSightAmbushTick) - 그 사이에는 어떤 공격도
		-- 하지 않는다(공격 동작 자체가 은신을 풀기 때문).
		if self._T.slotDarkSights ~= nil and #self._T.slotDarkSights > 0 then
			if (self._T.nextDarkSight or 0) <= now and not _SkillManager:IsDarkSightActive() then
				if _SkillManager:CanAutoCastDarkSight() and isvalid(self._T.target) then
					local dsCd = math.max(1.0, _SkillManager:GetDarkSightAutoCooldown())
					self._T.nextDarkSight = now + dsCd + _UtilLogic:RandomDouble() * dsCd * 3.0
					-- 기습 시각: (요청 2026-08-06) **주변에 적이 있으면 1초 뒤** 바로 친다.
					-- 적이 없을 때만 2~5초 기다리며 뒤를 잡을 자리를 찾는다(잠복이 의미 있는 경우).
					local dsPlayer = _UserService.LocalPlayer
					local dsNear = 0
					if isvalid(dsPlayer) then
						dsNear = self:CountNearbyMonsters(dsPlayer, dsPlayer.TransformComponent.WorldPosition, 3.0)
					end
					if dsNear > 0 then
						self._T.dsAmbushAt = now + 1.0
					else
						self._T.dsAmbushAt = now + 2.0 + _UtilLogic:RandomDouble() * 3.0
					end
					-- 뒤를 못 잡고 이 시각을 넘기면 그냥 평소대로 싸운다(은신은 첫 공격에 알아서 풀린다).
					self._T.dsAmbushDeadline = self._T.dsAmbushAt + 6.0
					self._T.nextUtil = now + 1.2
					_SkillManager:UseSkillInSlot(self._T.slotDarkSights[1].key)
					log("[AutoHunt] 다크사이트 잠복 시작 (기습 "
						.. string.format("%.1f", self._T.dsAmbushAt - now) .. "초 뒤 / 다음 주기 "
						.. string.format("%.0f", self._T.nextDarkSight - now) .. "초)")
					return true
				end
				-- 아직 쿨이거나 대상이 없으면 짧게 뒤에 다시 본다(주기를 소모하지 않는다).
				self._T.nextDarkSight = math.max(self._T.nextDarkSight or 0, now + 2.0)
			end
		end
		-- (팔라딘) 궁병 지원: 120~150초 랜덤 주기로 사용 (요청).
		if self._T.slotArchers ~= nil and #self._T.slotArchers > 0 then
			if (self._T.nextArcher or 0) <= now then
				self._T.nextArcher = now + 120.0 + _UtilLogic:RandomDouble() * 30.0
				self:MarkUtilityCast(now)
				_SkillManager:UseSkillInSlot(self._T.slotArchers[1].key)
				log("[AutoHunt] 궁병 지원 시전")
				return true
			end
		end
		return false
	end

	-- 공격 스킬 가중 랜덤 선택: 주변 3마리 이상이면 광역 가중↑, 아니면 균등.
	-- 상위 호환 규칙: 브랜디쉬가 배정돼 있으면 파워스트라이크/슬래시블러스트는 확률 1%로 강등
	-- (요청 사양 - 하위 스킬은 거의 쓰지 않고 브랜디쉬 위주로). (실쿨/미배정 처리는 SkillManager가 담당)
	@ExecSpace("ClientOnly")
	method void TryAttackCast(number now, Entity player, Vector3 pp)
		if (self._T.nextAtk or 0) > now then return end
		-- (나이트로드, 요청 2026-08-05) 각성 중에는 공속 +15단계로 스킬 쿨(0.73~0.80×공속)이 0.2초
		-- 안팎까지 줄어든다 - 0.5초 고정 틱이면 대부분을 흘려보내므로, "스킬 키를 누르고 있는 것처럼"
		-- 공속에 맞춰 틱을 좁힌다(하한 0.12초).
		local awakeningOn = self:IsAwakeningOn()
		local atkTick = 0.5
		if awakeningOn then
			atkTick = math.max(0.12, 0.85 * _CharInfoManager:GetAttackSpeedMultiplier())
		end
		self._T.nextAtk = now + atkTick
		-- (헛빵 수정) 시전 직전 재검증: 0.5초 주기 사이에 대상이 죽었거나 스킬 실판정 반경(1.5)
		-- 밖으로 벗어났으면 이번 시전을 건너뛴다 - 파스/슬블/차지 블로우 허공 시전 방지.
		local target = self._T.target
		if target == nil or not isvalid(target) then return end
		local monChk = target:GetComponent("script.Monster")
		if monChk == nil or monChk.IsDead == true then
			self._T.target = nil
			return
		end
		local tp = target.TransformComponent.WorldPosition
		local cdx = tp.x - pp.x
		local cdy = tp.y - pp.y
		-- (버그 수정 2026-08-05) 각성 제자리 사냥은 드래곤 로어 범위(±15/±7.5)의 대상을 그대로 두고
		-- 시전하는데, 이 사거리 게이트(1.3)가 그 대상을 걸러버려 제자리에서 아무것도 안 하고 서 있었다.
		-- 각성 + 표창 슬롯이면 로어 범위까지 허용한다(표창 3종이 방향 무관 자동조준하므로 헛빵이 아니다).
		-- (신고 2026-08-06) "연막을 쓰고 허공에다가 새비지 블로우를 쓴다"
		-- 연막 저격 구간에서는 대상이 최대 9유닛 밖에 있는데, 그 거리를 닿는 것은 **암살뿐**이다.
		-- 아래 로테이션이 근접 스킬(새비지블로우/어썰터/더블스탭)을 뽑으면 그대로 허공을 때린다 -
		-- "근접 사거리 밖에서의 저격인가"를 여기서 기억해 두고, 가중 계산 마지막에 암살만 남긴다.
		-- (신궁, 요청 2026-08-07) 아이언 에로우 = **닿지 않는 거리 전용**(공용 메서드).
		-- 제자리 사냥 분기(각성/연막)에서 여기까지 오는 경우를 위해 근접 게이트보다 먼저 한 번 본다.
		if self:TryIronArrowRanged(now, player, cdx, cdy) then return end
		local smokeSniping = false
		-- (썬콜, 요청 2026-08-08) 오로라 난사 모드: 오로라 안 + 블리자드 사용 가능이면 대상 거리와
		-- 무관하게 시전한다(블리자드는 시전자 주변 발판에 알아서 떨어진다). 마법 사거리 판정
		-- (ShouldMageSnipe)이 참이어도 붙지 않고 제자리에서 시전한다.
		local mageSniping = false
		-- (신궁/보마 2026-08-10) 활 저격 = 같은 층 사거리 안(최대 6유닛) 대상은 제자리에서 쏜다.
		local archerSniping = false
		-- (불독 확장 2026-08-08) 오로라 난사의 축은 썬콜 = 블리자드 / 불독 = 메테오 - 어느 쪽이든
		-- 오로라 안 + 사용 가능이면 대상 거리와 무관하게 제자리에서 시전한다.
		local mageBombard = _SkillManager:IsInRecoveryAura()
			and ((self:HasBlizzardSlot() and _SkillManager:IsBlizzardReady())
				or (self:HasMeteorSlot() and _SkillManager:IsMeteorReady()))
		if awakeningOn and self:HasStarThrowSlot() then
			if math.abs(cdx) > 15.0 or math.abs(cdy) > 7.5 then return end
		elseif self:ShouldSnipeWithAssassinate(cdx, cdy) then
			-- 연막 중 암살 사거리(9유닛) 안이면 붙지 않고 그대로 시전한다.
			smokeSniping = math.sqrt(cdx * cdx + cdy * cdy) > 1.3
		elseif mageBombard or self:ShouldMageSnipe(player, pp, cdx, cdy) then
			mageSniping = math.sqrt(cdx * cdx + cdy * cdy) > 1.3
		elseif self:ShouldArcherSnipe(player, pp, cdx, cdy) then
			-- (요청 2026-08-10) 활 사거리 안이면 붙지 않고 그대로 시전한다(마법 저격과 같은 처리).
			archerSniping = math.sqrt(cdx * cdx + cdy * cdy) > 1.3
		else
			-- (요청 2026-08-10) 점프 공격 창 동안은 1.45까지 완화 - 가장자리 도약(대각선 위 대상)은
			-- 1.3을 살짝 넘는다. 서버 실판정(반경 1.5) 안쪽까지만 연다.
			local atkGate = 1.3
			if (self._T.jumpAtkUntil or 0) > now then atkGate = 1.45 end
			if math.sqrt(cdx * cdx + cdy * cdy) > atkGate then return end
			-- (신고 2026-08-10) 아래 0.6 밖의 대상에게는 근접 로테이션을 쏘지 않는다 - 서버 아래 판정이
			-- 0.5뿐이라 무조건 헛방이다(0.5초 틱 사이에 대상이 아래로 흘러내린 경우의 재검증).
			if cdy <= -0.6 then
				self._T.nextAtk = now + 0.15
				return
			end
		end
		-- (헛빵 수정 2) 방향 전환 직후 0.25초는 시전 보류 - 서버의 LookDirectionX 복제가 아직 옛
		-- 방향이라 등 뒤로 시전됐다. 잠깐 기다렸다 재시도한다.
		-- (각성 예외) 각성 중 표창 3종은 방향 무관 조준이라 등 뒤 판정이 없다 - 보류 없이 바로 던진다.
		if not awakeningOn and (now - (self._T.dirChangedAt or -99)) < 0.25 then
			self._T.nextAtk = now + 0.15
			return
		end
		-- (사용자 신고) 점프 중(공중) 시전 금지 - 타격 판정은 시전 0.25초 뒤 그 시점 위치의 전방
		-- 박스(위 1.0/아래 0.5)라, 상승/하강 중에 쏘면 판정 순간 높이가 어긋나 빗맞는다. 지상에서만 쏜다.
		-- (요청 2026-08-10) 예외: 점프 공격 창(jumpAtkUntil) 동안은 공중 시전을 허용한다 -
		-- 지형적으로 못 올라가는 위층 대상은 점프 정점의 위쪽 박스(1.0)에 드는 그 순간이 유일한
		-- 기회다(시전 타이밍은 OnUpdate의 점프 공격 훅이 dy≤0.9 + 상승 구간으로 이미 조준했다).
		local rbAtk = player.RigidbodyComponent
		if isvalid(rbAtk) and not rbAtk:IsOnGround() then
			if (self._T.jumpAtkUntil or 0) <= now then
				self._T.nextAtk = now + 0.15
				return
			end
		end
		-- 대상이 현재 바라보는 방향의 뒤쪽이면 이번 틱은 방향만 맞추고 시전하지 않는다 (전방 박스 판정).
		-- (각성 예외) 방향 무관 조준이라 몸만 돌려두고 시전은 미루지 않는다.
		-- ⚠ (신고 2026-08-10 "적이 살짝 뒤에 있으면 사거리가 안 되는데도 그 자리에서 계속 공격한다")
		--   **불감대 0.05가 이 버그의 원인이었다.** 서버 실판정은 `dx * dirX >= 0`(전방 박스,
		--   FindSlashBlastTargets)이라 **0.03유닛만 뒤에 있어도 그 시전은 통째로 0마리 명중**이다.
		--   그런데 |cdx| ≤ 0.05면 방향 보정을 건너뛰어, 뒤를 보고 계속 헛방을 쳤다.
		--   실측 로그(02:22:20): `AttackBrandish 시전 dir=1.0` + 대상 dx=-0.030 → `DealBrandishFirstHits
		--   targets=0`, 바로 다음 시전에서 dir=-1.0로 바뀌자 `targets=3`.
		--   → 대상이 **바라보는 방향의 반대편이면 크기와 무관하게 무조건 돌린다.**
		--     불감대는 "이미 앞쪽인데 미세하게 흔들리는" 경우에만 남긴다(제자리 회전 방지).
		local pccDir = player.PlayerControllerComponent
		if isvalid(pccDir) then
			local lookNow = (pccDir.LookDirectionX >= 0) and 1 or -1
			local isBehind = (cdx * lookNow) < 0
			if isBehind or math.abs(cdx) > 0.05 then
				local wantDir = (cdx > 0) and 1 or -1
				if pccDir.LookDirectionX ~= wantDir then
					pccDir.LookDirectionX = wantDir
					self._T.dirChangedAt = now
					if not awakeningOn then
						self._T.nextAtk = now + 0.15
						return
					end
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 다크사이트 잠복 중에는 **아무 공격도 하지 않는다** - 어떤 공격
		-- 동작이든 은신이 풀리기 때문이다.
		--   · 기습 시각(시전 3~10초 뒤) 전이면 무조건 참는다.
		--   · 기습 시각이 지났으면 **대상의 뒤를 잡았을 때만** 시전한다(그 한 방이 백스탭 + 다크사이트 딜).
		--   · 마감(기습 시각 +6초)까지 뒤를 못 잡으면 포기하고 평소대로 싸운다(첫 공격에 은신은 풀린다).
		if _SkillManager:IsDarkSightActive() and (self._T.dsAmbushDeadline or 0) > now then
			if now < (self._T.dsAmbushAt or 0) then
				self._T.nextAtk = now + 0.2
				return
			end
			local behindDir = self:GetBehindDirOfTarget(target)
			if ((pp.x - tp.x) * behindDir) <= 0 then
				self._T.nextAtk = now + 0.2
				return
			end
			self._T.dsAmbushDeadline = 0
			log("[AutoHunt] 다크사이트 기습 - 적 뒤를 잡고 시전")
		end
		-- (팔라딘, 요청 2026-08-10) 속성 연계/순환 - 사거리 검증을 통과한 실제 대상이 있는 지금이
		-- 기준점이다. 전환한 틱은 공격을 쉬고, 0.35초 뒤 공격 틱의 차지 블로우가 연계를 마무리한다.
		if self:ElementChainTick(now, player, pp, tp) then return end
		-- (나이트로드, 요청 2026-08-05) 드레인 샷 = HP 보충기: HP가 90% 아래고 자체 쿨(5초)이 돌았으면
		-- 로테이션을 기다리지 않고 우선 사용한다. 대상이 사거리에 있는 지금이 기회다 - 맞혀야 회복된다.
		if self._T.slotDrainShots ~= nil and #self._T.slotDrainShots > 0
			and (self._T.nextDrainShot or 0) <= now then
			local pcDS = player.PlayerComponent
			if isvalid(pcDS) and (pcDS.MaxHp or 0) > 0 and (pcDS.Hp / pcDS.MaxHp) < 0.90 then
				self._T.nextDrainShot = now + 5.5
				self._T.holdMoveUntil = now + 0.8 * _CharInfoManager:GetAttackSpeedMultiplier()
				_SkillManager:UseSkillInSlot(self._T.slotDrainShots[1].key)
				log("[AutoHunt] 드레인 샷 (HP 보충)")
				return
			end
		end
		-- (신궁, 요청 2026-08-06) 스나이핑은 확률 로테이션이 아니라 자기 규칙으로 먼저 판단한다 -
		-- 좌우 직선만 때리는 관통 3명 차지기라 "전방 직선에 적이 2마리 이상"일 때만 쓰고,
		-- 차징 시간은 대상 HP 비율에 맞춘다(다 죽어가는 적에게 10초를 모으지 않는다).
		if self:TrySnipingCast(now, player, pp, target) then return end
		-- (신궁 2026-08-06) 피어싱도 같은 자기 규칙 차지기 - 스나이핑이 안 나갔을 때만 시도한다
		-- (둘 다 차지라 겹치면 서로의 차지를 취소한다).
		if self:TryPiercingCast(now, player, pp, target) then return end
		-- (히어로 3차, 요청 2026-08-09) 코마/패닉은 콤보 구슬을 전량 소모하는 자기 규칙 스킬이다 -
		-- 확률 로테이션보다 먼저 판단한다. 코마(다수)를 먼저 보고, 안 나갔을 때만 패닉(탱커)을 본다.
		if self:TryComaCast(now, player, pp, target) then return end
		if self:TryPanicCast(now, player, pp, target) then return end
		-- 다수 판정: 사거리권(1.6유닛)에 2마리 이상이면 광역 우선 (요청 - 다수면 슬래시블러스트 > 파워스트라이크)
		local nearby = self:CountNearbyMonsters(player, pp, 1.6)
		local crowded = (nearby >= 2)
		-- 돌진 각 판정: 바라보는 방향 전방 3유닛 직선상의 적 수 - 2마리 이상이면 밀어서 모을 수 있는 각
		local lookDir = 1
		local pccLook = player.PlayerControllerComponent
		if isvalid(pccLook) and pccLook.LookDirectionX < 0 then lookDir = -1 end
		local frontCount = self:CountMonstersInFront(player, pp, lookDir, 3.0)

		-- (요청) 상황별 가중: 1명일 땐 광역(슬래시블러스트 등) 확률을 확 낮추고(0.15),
		-- 다수일 땐 단일기(파워스트라이크 등) 확률을 확 낮춘다(0.15).
		local pool = {}
		if self._T.slotAoes ~= nil then
			for _, s in ipairs(self._T.slotAoes) do
				table.insert(pool, { key = s.key, name = s.name, w = crowded and 3.0 or 0.15 })
			end
		end
		if self._T.slotSingles ~= nil then
			for _, s in ipairs(self._T.slotSingles) do
				table.insert(pool, { key = s.key, name = s.name, w = crowded and 0.15 or 1.0 })
			end
		end

		-- (요청 2026-08-09) 전사 1차 2종의 **하드 금지 규칙** - 위 확률 가중(0.15)으로는 가끔 나가서
		-- "단일 대상에게 슬블만 긁는" 비효율이 남는다는 신고. 확률이 아니라 아예 후보에서 뺀다.
		--   · 단일 대상 → 슬래시블러스트 금지 (파워스트라이크가 단일 딜을 담당)
		--   · 슬래시블러스트 사거리에 4마리 이상 → 파워스트라이크 금지 (광역이 명백히 이득)
		-- ⚠ 두 규칙의 기준을 **같은 카운트(sbTargets)**로 통일한 이유: 서로 다른 기준을 쓰면
		--   "앞에 4마리인데 반경 1.6 안엔 1마리" 같은 구간에서 둘 다 0이 되어 기본공격으로 떨어진다.
		-- 카운트는 서버 판정(FindSlashBlastTargets: 전방 2.0 / |dy| 1.0 / 최대 6)에 맞춘 근사치다.
		local sbTargets = self:CountMonstersInFront(player, pp, lookDir, 2.0)
		local bannedName = ""
		for _, c in ipairs(pool) do
			if c.name == "슬래시블러스트" or c.name == "슬래쉬블래스트" then
				if sbTargets <= 1 and c.w > 0 then
					c.w = 0
					bannedName = "슬래시블러스트(단일)"
				end
			elseif c.name == "파워스트라이크" then
				if sbTargets >= 4 and c.w > 0 then
					c.w = 0
					bannedName = "파워스트라이크(4마리+)"
				end
			end
		end
		-- 공격 틱마다 찍히면 로그가 넘치므로 3초에 한 번만 남긴다(규칙 발동 확인용).
		if bannedName ~= "" and (self._T.banLogAt or -99) + 3.0 < now then
			self._T.banLogAt = now
			log("[AutoHunt] 전사1차 금지 규칙: " .. bannedName .. " 제외 (슬블 사거리 대상 " .. tostring(sbTargets) .. "마리)")
		end

		-- 상위 호환 강등: 브랜디쉬 보유 시 하위 스킬 가중치 ×0.01 (≈1%)
		local hasBrandish = false
		local hasChargeBlow = false
		local hasSpearBurst = false
		for _, c in ipairs(pool) do
			if c.name == "브랜디쉬" then hasBrandish = true end
			if c.name == "차지 블로우" then hasChargeBlow = true end
			if c.name == "스피어 버스터" then hasSpearBurst = true end
		end
		if hasBrandish then
			for _, c in ipairs(pool) do
				if c.name == "파워스트라이크" or c.name == "슬래시블러스트" then
					c.w = c.w * 0.01
				end
			end
		end
		-- (다크나이트) 스피어 버스터 보유 시: 브랜디쉬/차지 블로우와 같은 상위 호환 규칙으로
		-- 파스/슬블을 1%로 강등하고 스피어 버스터가 주력이 된다(단독 대상에게도 기본 가중 1.0).
		if hasSpearBurst then
			for _, c in ipairs(pool) do
				if c.name == "파워스트라이크" or c.name == "슬래시블러스트" then
					c.w = c.w * 0.01
				elseif c.name == "스피어 버스터" and not crowded then
					c.w = 1.0
				end
			end
		end
		-- (팔라딘, 요청) 차지 블로우 보유 시: 파스/슬블은 1%로 강등하고 차지 블로우가 주력
		-- (단독 대상에게도 광역 강등 없이 기본 가중 1.0, 다수면 3.0 유지).
		if hasChargeBlow then
			for _, c in ipairs(pool) do
				if c.name == "파워스트라이크" or c.name == "슬래시블러스트" then
					c.w = c.w * 0.01
				elseif c.name == "차지 블로우" and not crowded then
					c.w = 1.0
				end
			end
		end

		-- (나이트로드, 요청 2026-08-05) 표창 상위호환 강등 - 브랜디쉬 규칙과 동일:
		-- 트리플 스로우 보유 시 럭키세븐 ×0.01, 쿼드러플 스로우 보유 시 트리플 스로우 ×0.01
		-- (셋 다 있으면 럭키세븐은 트리플의 1%의 다시 일부라 사실상 안 나온다).
		local hasTripleThrow = false
		local hasQuadThrow = false
		local hasAvenger = false
		for _, c in ipairs(pool) do
			if c.name == "트리플 스로우" then hasTripleThrow = true end
			if c.name == "쿼드러플 스로우" then hasQuadThrow = true end
			if c.name == "어벤져" then hasAvenger = true end
		end
		if hasTripleThrow then
			for _, c in ipairs(pool) do
				if c.name == "럭키세븐" then c.w = c.w * 0.01 end
			end
		end
		if hasQuadThrow then
			for _, c in ipairs(pool) do
				if c.name == "트리플 스로우" then c.w = c.w * 0.01 end
			end
		end
		-- (나이트로드, 요청 2026-08-05) 어벤져 우선: 어벤져는 관통 광역이라, 전방 직선(관통 사거리
		-- 8유닛)에 서로 떨어져 늘어선 적이 **5마리 이상**이면 트리플/쿼드러플보다 이득이다 -
		-- 표창 상위기들의 현재 가중(강등/몰림 보정 후)의 3배로 올린다.
		if hasAvenger then
			local avFront = self:CountMonstersInFront(player, pp, lookDir, 8.0)
			if avFront >= 5 then
				local starW = 0
				for _, c in ipairs(pool) do
					if (c.name == "쿼드러플 스로우" or c.name == "트리플 스로우" or c.name == "럭키세븐")
						and c.w > starW then
						starW = c.w
					end
				end
				local avW = math.max(starW, 0.15) * 3.0
				for _, c in ipairs(pool) do
					if c.name == "어벤져" and c.w < avW then c.w = avW end
				end
			end
			-- (요청 2026-08-06) 각성 중에는 어벤져를 거의 쓰지 않는다(×2%) - 각성은 표창 3종이
			-- 로어 범위 자동조준 + 전탄 크리티컬이 되는 구간이라 표창 연사가 압도적으로 이득.
			-- 위 전방 5마리 부스트가 걸렸더라도 이 감쇠가 마지막에 덮는다.
			if awakeningOn then
				for _, c in ipairs(pool) do
					if c.name == "어벤져" then c.w = c.w * 0.02 end
				end
			end
		end

		-- (보마, 요청 2026-08-11) 속사는 **에로우 봄의 1/5 사용빈도** - 에로우 봄을 5회 쓸 때마다
		-- 속사 1회가 해금되는 카운트 방식. (1차 시도였던 "가중 ×0.2" 비율 방식은 에로우 봄이 비몰림
		-- 기본 가중(0.15)일 때 속사가 0.03이 되어 실측 180초에 0회 - 사실상 영영 안 나갔다.)
		-- 해금 전에는 후보에서 제외, 해금 후에는 그 시점 에로우 봄 가중과 동급으로 뽑힌다
		-- (해금 소진은 아래 시전부의 속사 버스트 분기가 한다). 에로우 봄이 퀵슬롯에 없으면
		-- 비교 기준이 없으므로 현행 가중을 그대로 둔다.
		local abW = 0
		local hasArrowBombPool = false
		for _, c in ipairs(pool) do
			if c.name == "에로우 봄" then
				hasArrowBombPool = true
				abW = c.w
			end
		end
		if hasArrowBombPool then
			for _, c in ipairs(pool) do
				if c.name == "속사" then
					if (self._T.abCastCount or 0) >= 5 and abW > 0 then
						c.w = abW
					else
						c.w = 0
					end
				end
			end
		end

		-- ── (섀도어, 요청 2026-08-06) 로테이션 ────────────────────────────────
		-- 상위 호환: 새비지블로우 > 더블스탭 (둘 다 배정돼 있으면 더블스탭은 1%).
		-- 4차: 암살이 주력(다수기) - 새비지블로우는 10%이고 그마저도 주변 적이 적을 때 위주.
		-- 연막 안: 어썰터 5% / 암살 92% / 새비지블로우 3%. 단 연막 안 적이 1~2명이면 새비지블로우.
		local hasSavage, hasAssassinate, hasDoubleStab, hasAssaulter = false, false, false, false
		for _, c in ipairs(pool) do
			if c.name == "새비지블로우" then hasSavage = true end
			if c.name == "암살" then hasAssassinate = true end
			if c.name == "더블스탭" then hasDoubleStab = true end
			if c.name == "어썰터" then hasAssaulter = true end
		end
		-- 어썰터 (신고: "연속으로 쓸 때도 있고 아예 안 쓸 때도 있다") - 스택이 찰 때마다 즉시 터지고
		-- 3스택이 쌓이면 세 번 연달아 나가던 것이 원인이다. **스택 보유 + 최소 간격** 두 조건을 함께
		-- 걸어 충전 리듬(1개당 10→5초)에 맞춰 띄엄띄엄 나가게 한다.
		if hasAssaulter then
			local asLvAuto = math.max(1, _SkillManager:GetHeroSkillLevelByName("어썰터"))
			self._T.assaulterSpacing = _SkillManager:GetAssaulterChargeSeconds(asLvAuto) * 0.9
			local asReady = (_SkillManager:GetAssaulterStacks() >= 1) and ((self._T.nextAssaulter or 0) <= now)
			if not asReady then
				for _, c in ipairs(pool) do
					if c.name == "어썰터" then c.w = 0 end
				end
			end
		end
		if hasSavage and hasDoubleStab then
			for _, c in ipairs(pool) do
				if c.name == "더블스탭" then c.w = c.w * 0.01 end
			end
		end
		if hasAssassinate then
			local smokeOn = _SkillManager:IsSmokeScreenActiveLocal()
			for _, c in ipairs(pool) do
				if smokeSniping then
					-- (버그 수정 2026-08-06, 신고 "연막 쓰고 허공에 새비지 블로우")
					-- 연막 저격 거리(근접 밖 ~ 9유닛)에서는 **암살만 닿는다**. 아래 "적이 1~2명이면
					-- 새비지블로우 100%" 규칙은 주변 적 수를 **플레이어 기준**으로 세는데, 저격 중에는
					-- 대상이 멀어 항상 0~2명으로 잡힌다 - 그래서 근접기인 새비지블로우가 100%로 뽑혀
					-- 허공을 때리고 있었다. 저격 거리에서는 암살에만 가중을 준다.
					-- ⚠ 여기서 암살 가중을 반드시 살려 둬야 한다 - 0으로 두면 아래 안전망에 걸려
					--   "저격 중 아무것도 못 쏘고 굳어버리는" 반대쪽 사고가 난다.
					if c.name == "암살" then c.w = 100.0 else c.w = 0 end
				elseif smokeOn and nearby <= 2 then
					-- 연막 안이지만 적이 1~2명 - 단일 대상 화력이 더 센 새비지블로우로 간다(요청).
					-- (근접 사거리 안일 때만 여기 온다 - 위 저격 분기가 먼저 걸러낸다.)
					if c.name == "새비지블로우" then c.w = 100.0
					elseif c.name == "암살" or c.name == "어썰터" then c.w = 0 end
				elseif smokeOn then
					if c.name == "암살" then c.w = 92.0
					elseif c.name == "어썰터" then c.w = (c.w > 0) and 5.0 or 0
					elseif c.name == "새비지블로우" then c.w = 3.0 end
				else
					if c.name == "암살" then c.w = 90.0
					elseif c.name == "새비지블로우" then c.w = (nearby <= 2) and 10.0 or 3.0
					elseif c.name == "어썰터" then c.w = (c.w > 0) and ((nearby >= 3) and 20.0 or 5.0) or 0 end
				end
			end
			-- (버그 수정 2026-08-06) 유틸 시전 창(1.2초) 동안은 암살을 쉰다 - 안 그러면 다음 틱에 다시
			-- 암살이 나가 잠금이 곧바로 걸려 분신 소환/연막/다크사이트가 또 밀린다.
			-- ⚠ 위 확률표가 암살 가중을 덮어쓰므로 **반드시 그 뒤**에서 0으로 만든다.
			if (self._T.assassinatePauseUntil or 0) > now then
				for _, c in ipairs(pool) do
					if c.name == "암살" then c.w = 0 end
				end
			end
		end

		-- ── (신궁, 요청 2026-08-06) 로테이션 ──────────────────────────────────
		-- ① 더블샷 ↔ 에로우 블로우는 **비슷한 비율**로 상황에 따라 갈린다 - 에로우 블로우는 강화를
		--    배우면 적중 지점에서 폭발해 주변 5명을 때리므로 **뭉쳤을 때 유리**하다.
		-- ② 차수 사다리: 퀵슬롯에 **더 높은 차수의 신궁 공격기**가 함께 있으면 아래 차수는 1%로 강등한다
		--    (브랜디쉬/차지 블로우/표창 상위호환과 같은 관례).
		--      1차 = 더블샷·에로우 블로우 / 2차 = 아이언 에로우 / 3차↑ = 스트레이프·아이스 샷·파이어 샷·속사·폭풍의 시
		-- ③ 스트레이프는 **단일 대상**에 강하고, 적이 뭉치면 **아이스 샷**이 주력이 된다.
		local hasDoubleShot, hasArrowBlow, hasIronArrow = false, false, false
		local hasHigherArcher = false
		for _, c in ipairs(pool) do
			if c.name == "더블샷" then hasDoubleShot = true end
			if c.name == "에로우 블로우" then hasArrowBlow = true end
			if c.name == "아이언 에로우" then hasIronArrow = true end
			if c.name == "스트레이프" or c.name == "아이스 샷" or c.name == "파이어 샷"
				or c.name == "속사" or c.name == "폭풍의 시" then
				hasHigherArcher = true
			end
		end
		if hasDoubleShot or hasArrowBlow or hasIronArrow then
			-- ① 1차 두 스킬의 상황 가중. 뭉치면 에로우 블로우(폭발), 단독이면 더블샷(2발) 쪽으로 기운다.
			--    어느 쪽이든 폭이 크지 않아 전체적으로는 "비슷한 비율"이 유지된다.
			for _, c in ipairs(pool) do
				if c.name == "에로우 블로우" then
					c.w = crowded and 2.0 or 0.8
				elseif c.name == "더블샷" then
					c.w = crowded and 0.8 or 1.6
				end
			end
			-- ② 차수 사다리 강등. **1차 두 종만** 대상이다 -
			--    (요청 2026-08-13) 아이언 에로우는 3차보다 약하지만 "직선으로 길고 8방향"이라 상황에
			--    따라 이득인 구간이 분명히 있다 → 일괄 1% 강등에서 빼고 아래 ③ 기대 데미지 비교에 맡긴다.
			if hasIronArrow then
				for _, c in ipairs(pool) do
					if c.name == "더블샷" or c.name == "에로우 블로우" then c.w = c.w * 0.01 end
				end
			end
			if hasHigherArcher then
				for _, c in ipairs(pool) do
					if c.name == "더블샷" or c.name == "에로우 블로우" then
						c.w = c.w * 0.01
					end
				end
			end
		end
		-- ③ (요청 2026-08-13) 활 주력기 4종은 **실제 기대 데미지**로 고른다.
		-- 전사 1차가 "슬블 사거리 안 마릿수"로 파스/슬블을 갈라 쓰는 것과 같은 사고방식이되, 활 스킬은
		-- 타수·명중 마릿수·사거리·쿨타임이 제각각이라 마릿수만으로는 비교가 안 된다 → 시전 1회 기대
		-- 데미지(기대배율 × 타수 × **실제로 맞는 마릿수**)를 시전주기로 나눠 같은 저울에 올린다
		-- (GetArcherSkillScore). 종전의 crowded 불리언 + 고정 가중은 "단일이면 스트레이프, 뭉치면
		-- 아이스 샷"만 표현할 수 있어, 직선으로 늘어선 적(아이언 에로우가 이득)을 전혀 잡지 못했다.
		local archerScore = {}
		local bestArcherScore = 0
		for _, c in ipairs(pool) do
			if c.name == "스트레이프" or c.name == "아이스 샷" or c.name == "파이어 샷" or c.name == "아이언 에로우" then
				local sc = self:GetArcherSkillScore(c.name, player, pp, lookDir)
				archerScore[c.name] = sc
				if sc > bestArcherScore then bestArcherScore = sc end
			end
		end
		if bestArcherScore > 0 then
			local bestArcherName = ""
			for _, c in ipairs(pool) do
				local sc = archerScore[c.name]
				if sc ~= nil then
					local ratio = sc / bestArcherScore
					if ratio >= 0.999 and bestArcherName == "" then bestArcherName = c.name end
					if ratio < 0.4 then
						-- 명백히 손해 - 확률로 남겨두면 MP만 새어 나간다(전사 1차 하드 금지와 같은 취지).
						c.w = 0
					else
						-- 제곱을 씌워 1등에 확실히 쏠리게 하되, 근소한 차이면 둘 다 섞여 나간다.
						c.w = 3.0 * ratio * ratio
					end
				end
			end
			-- 공격 틱마다 찍으면 로그가 넘치므로 3초에 한 번만 근거를 남긴다.
			if (self._T.archerPickLogAt or -99) + 3.0 < now then
				self._T.archerPickLogAt = now
				log("[AutoHunt] 활 주력 선택: " .. bestArcherName
					.. " (스트레이프 " .. string.format("%.0f", archerScore["스트레이프"] or 0)
					.. " / 아이스 " .. string.format("%.0f", archerScore["아이스 샷"] or 0)
					.. " / 파이어 " .. string.format("%.0f", archerScore["파이어 샷"] or 0)
					.. " / 아이언 " .. string.format("%.0f", archerScore["아이언 에로우"] or 0) .. ")")
			end
		end

		-- ── (썬콜, 요청 2026-08-08) 로테이션 ──────────────────────────────────
		-- ① 2차(썬더볼트)를 배웠으면 썬더볼트 위주로 사냥한다(앞뒤 ±3 최대 6명 동시 타격).
		-- ② 매직클로는 "먼 거리의 적" 전용 원거리 필러 - 근접에서는 거의 안 쓴다.
		-- ③ 매직 미사일은 위아래 판정(전방 6/세로 ±3)이 좋아 간간히 - 대상이 위아래로 벌어졌으면 올린다.
		-- ④ 체인라이트닝이 있으면 매직클로/썬더볼트는 1%로 강등(브랜디쉬 상위 호환 관례).
		-- ⑤ 리커버리 오로라 안에서는 블리자드가 압도적 주력(노쿨 난사)이고 체인/미사일을 조금 섞는다.
		-- ⑥ 사거리/쿨타임이 안 되는 스킬은 이번 틱 후보에서 제외한다(원거리 제자리 시전 헛빵 방지).
		local hasMagicClaw, hasThunderbolt, hasMagicMissileSk = false, false, false
		local hasChainLightningSk, hasBlizzardSk = false, false
		for _, c in ipairs(pool) do
			if c.name == "매직클로" then hasMagicClaw = true end
			if c.name == "썬더볼트" then hasThunderbolt = true end
			if c.name == "매직 미사일" then hasMagicMissileSk = true end
			if c.name == "체인라이트닝" then hasChainLightningSk = true end
			if c.name == "블리자드" then hasBlizzardSk = true end
		end
		if hasMagicClaw or hasThunderbolt or hasMagicMissileSk or hasChainLightningSk or hasBlizzardSk then
			local adxMage = math.abs(cdx)
			local adyMage = math.abs(cdy)
			for _, c in ipairs(pool) do
				if c.name == "썬더볼트" then
					c.w = crowded and 3.0 or 2.0
				elseif c.name == "매직클로" then
					-- 근접에서는 필러(0.4), 원거리 제자리 시전(mageSniping)에서는 주력 후보.
					c.w = mageSniping and 2.0 or 0.4
				elseif c.name == "매직 미사일" then
					c.w = (adyMage >= 0.8) and 1.5 or 0.5
				elseif c.name == "체인라이트닝" then
					c.w = crowded and 3.0 or 1.8
				elseif c.name == "블리자드" then
					c.w = crowded and 3.0 or 1.0
				end
			end
			-- ④ 상위 호환 강등.
			if hasChainLightningSk then
				for _, c in ipairs(pool) do
					if c.name == "매직클로" or c.name == "썬더볼트" then c.w = c.w * 0.01 end
				end
			end
			-- ⑥ 사거리/쿨타임 게이트. 상수는 서버 판정보다 살짝 안쪽(헛빵 방지 - ShouldMageSnipe와 동일).
			local inAuraMage = _SkillManager:IsInRecoveryAura()
			for _, c in ipairs(pool) do
				if c.name == "썬더볼트" and (adxMage > 2.8 or adyMage > 0.9) then c.w = 0 end
				-- (요청 2026-08-11) 매직클로 실판정 2/3 축소(전방 3.33/세로 ±1.0) - 안쪽 여유 3.2/0.9.
				if c.name == "매직클로" and (adxMage > 3.2 or adyMage > 0.9) then c.w = 0 end
				if c.name == "체인라이트닝" then
					-- 서버 첫 대상 조건: 전방 0.5~6.0 콘. 코앞(0.4 미만) 단독 대상은 첫 대상을 못 찾는다.
					if adxMage > 5.5 or adyMage > 0.8 + adxMage * 0.45 then c.w = 0 end
					if adxMage < 0.4 and nearby <= 1 then c.w = 0 end
				end
				if c.name == "매직 미사일" then
					if not _SkillManager:IsMagicMissileReady() or adxMage > 5.5 or adyMage > 2.8 then c.w = 0 end
				end
				-- (요청 2026-08-11, 비숍 "적 없는 곳으로 날린다") 홀리 에로우 = 수평 전방 9유닛 관통 -
				-- 대상이 세로로 어긋나 있거나(±0.5 밖) 사거리 밖이면 후보에서 뺀다.
				if c.name == "홀리 에로우" and (adxMage > 8.5 or adyMage > 0.5) then c.w = 0 end
				if c.name == "블리자드" then
					if not _SkillManager:IsBlizzardReady() then
						c.w = 0
					elseif not inAuraMage and (adxMage > 12.0 or adyMage > 4.2) then
						-- 오로라 밖에서는 대상이 블리자드 범위(±12.5/±4.7) 안일 때만 긴 쿨(제네시스와
						-- 동일 공식 91~120초)을 쓴다.
						c.w = 0
					end
				end
			end
			-- ⑤ 오로라 안 난사 모드: 블리자드 주력 + 체인/미사일 소량(요청 - "블리자드만 꼭 쓰는 건 아니다").
			if inAuraMage and hasBlizzardSk and _SkillManager:IsBlizzardReady() then
				for _, c in ipairs(pool) do
					if c.name == "블리자드" then c.w = 20.0
					elseif c.name == "체인라이트닝" then c.w = math.min(c.w, 2.0)
					elseif c.name == "매직 미사일" then c.w = math.min(c.w, 1.5)
					elseif c.name == "매직클로" or c.name == "썬더볼트" then c.w = math.min(c.w, 0.2)
					end
				end
			end
		end

		-- ── (불독, 요청 2026-08-08) 로테이션 ──────────────────────────────────
		-- 핵심 메커니즘: **포이즌 미스트를 맵 전역에 최대한 깔고 익스플로젼으로 사냥**한다.
		-- ① 익스플로젼이 주력 - 주변 유폭권(±2.2/±1.5)에 독안개가 있으면 가중을 2배로 올린다
		--    (독안개 파열마다 폭발 데미지가 한 번씩 더 들어가는 구조라 안개 위에서 터뜨리는 게 최대 효율).
		-- ② 포이즌 미스트는 "이 자리가 아직 안 덮였고 주변에 적이 있을 때"만 - 넓게 깔기 자체는
		--    PoisonCarpetTick(사냥 동선을 따라 지나가며 설치)이 담당하고, 로테이션에서는 근접전 중
		--    발밑 보충만 한다. 동시 유지 상한(10개)도 카펫과 공유한다.
		-- ③ 파이어에로우는 원거리 단일 필러(자동사냥은 방향키가 없어 수평 전방으로만 나간다).
		-- ④ 메테오는 블리자드와 같은 규칙 - 몰렸을 때 우선, 쿨/사거리 게이트, 오로라 안에서는 난사 주력.
		local hasFireArrowFp, hasPoisonMistFp, hasExplosionFp, hasMeteorFp = false, false, false, false
		for _, c in ipairs(pool) do
			if c.name == "파이어에로우" then hasFireArrowFp = true end
			if c.name == "포이즌 미스트" then hasPoisonMistFp = true end
			if c.name == "익스플로젼" then hasExplosionFp = true end
			if c.name == "메테오" then hasMeteorFp = true end
		end
		if hasFireArrowFp or hasPoisonMistFp or hasExplosionFp or hasMeteorFp then
			local adxFp = math.abs(cdx)
			local adyFp = math.abs(cdy)
			local inAuraFp = _SkillManager:IsInRecoveryAura()
			local mistsNearFp = self:CountMistsNear(player, pp.x, pp.y, 2.2, 1.5)
			local coveredHereFp = self:CountMistsNear(player, pp.x, pp.y, 2.5, 1.2) > 0
			local mistTotalFp = #self:GetActiveMistPositions(player)
			for _, c in ipairs(pool) do
				if c.name == "익스플로젼" then
					c.w = crowded and 3.0 or 1.5
					if mistsNearFp >= 1 then c.w = c.w * 2.0 end
				elseif c.name == "포이즌 미스트" then
					if coveredHereFp or mistTotalFp >= 10 then
						c.w = 0
					else
						c.w = (self:CountNearbyMonsters(player, pp, 2.5) >= 1) and 2.5 or 0
					end
				elseif c.name == "파이어에로우" then
					c.w = mageSniping and 2.5 or 0.8
				elseif c.name == "메테오" then
					c.w = crowded and 3.0 or 1.0
				end
			end
			-- 사거리/쿨타임 게이트. 상수는 서버 판정보다 살짝 안쪽(헛빵 방지 - 썬콜 ⑥과 같은 원리).
			for _, c in ipairs(pool) do
				if c.name == "파이어에로우" and (adxFp > 7.5 or adyFp > 0.6) then c.w = 0 end
				if c.name == "익스플로젼" then
					-- 폭발 본체 판정은 시전자 주변 ±3.0/±1.5 - 대상이 그 안이거나, 유폭할 안개+주변 적이
					-- 있으면(안개 파열 데미지는 안개 자리 기준) 대상 거리와 무관하게 허용한다.
					local targetInRange = adxFp <= 2.8 and adyFp <= 1.4
					local mistCombo = mistsNearFp >= 1 and self:CountNearbyMonsters(player, pp, 3.0) >= 1
					if not targetInRange and not mistCombo then c.w = 0 end
				end
				if c.name == "메테오" then
					if not _SkillManager:IsMeteorReady() then
						c.w = 0
					elseif not inAuraFp and (adxFp > 12.0 or adyFp > 4.2) then
						-- 오로라 밖에서는 대상이 메테오 범위(±12.5/±4.7) 안일 때만 긴 쿨(제네시스와
						-- 동일 공식 91~120초)을 쓴다.
						c.w = 0
					end
				end
			end
			-- 오로라 안 난사 모드: 메테오 주력 + 익스플로젼/미스트 소량(썬콜 ⑤의 불독판).
			if inAuraFp and hasMeteorFp and _SkillManager:IsMeteorReady() then
				for _, c in ipairs(pool) do
					if c.name == "메테오" then c.w = 20.0
					elseif c.name == "익스플로젼" then c.w = math.min(c.w, 2.0)
					elseif c.name == "포이즌 미스트" then c.w = math.min(c.w, 1.0)
					elseif c.name == "파이어에로우" or c.name == "매직클로" then c.w = math.min(c.w, 0.2)
					end
				end
			end
		end

		-- (다크나이트) 드래곤 로어 사용 규칙 — **주력기(스피어 버스터) 대비 사용 비율로 직접 지정한다**
		-- (요청 2026-08-05 재조정: 이전의 "감쇠 ×0.3 + 최소 간격 게이트 + 쓰고도 35% 남을 것" 조합은
		--  실제로는 거의 안 나왔다. 소모율이 마스터 51%라 "35% 여유" 조건이 사실상 HP 86% 이상을
		--  요구했고, 25초 간격 게이트가 남은 기회마저 잘라냈다. 셋 다 걷어내고 비율만 남긴다):
		--  ① HP가 **60% 이하면 사용하지 않는다**(가중 0).
		--  ② (요청 2026-08-05 재조정) **HP가 많을수록 더 자주** - 60%에서 20%, 100%(풀)에서 150%로
		--     비율이 **연속적으로** 올라간다(HP 80% = 85%, 90% = 117%).
		--     ⚠ 이전 사양은 "99% 이상이면 1:1, 그 아래는 전부 20%"인 계단식이었는데, 로어 자체가
		--       최대 HP의 41~70%를 먹어 한 번 쓰면 다시는 99%에 못 닿는다 - 결과적으로 항상 20%로
		--       굳어 "HP가 많은데도 안 쓴다"는 신고가 나왔다. 계단을 없애고 램프로 바꾼다.
		--  ③ 광역기라 단독 대상에게 쓰면 HP만 날린다 - 주변 2마리 이상일 때만 허용한다(기존 3마리에서 완화).
		-- ⚠ 비율의 기준은 "이 시점의 스피어 버스터 가중"이다. 위 상위호환/몰림 보정이 모두 끝난 뒤여야
		-- 하므로 이 블록의 위치를 앞으로 옮기지 말 것(몰림 3.0 / 단독 1.0 → 로어는 그 1/5 또는 1/3).
		local roarHpRatio = 1.0
		local pcHpGate = player.PlayerComponent
		if isvalid(pcHpGate) and (pcHpGate.MaxHp or 0) > 0 then
			roarHpRatio = (pcHpGate.Hp or 0) / pcHpGate.MaxHp
		end
		local roarSpearW = 0
		for _, c in ipairs(pool) do
			if c.name == "스피어 버스터" then roarSpearW = c.w end
		end
		local roarCrowded = (nearby >= 2)
		-- 소모량(최대 HP의 41~70%)보다 현재 HP가 적으면 시전 자체가 막힌다(SkillManager의 HP 부족 게이트).
		-- 뽑아 봐야 차단 + 토스트만 나오므로 여기서 미리 제외한다 - 투자 레벨이 낮아 소모율이 60%를
		-- 넘는 구간에서만 실제로 걸린다(마스터 51%, 30 마스터 41%면 60% 하한이 더 빡빡하다).
		local roarCostRatio = _SkillManager:GetDragonRoarHpCostPercent(
			math.max(1, _SkillManager:GetHeroSkillLevelByName("드래곤 로어"))) / 100
		-- (요청 2026-08-10) 드래곤 로어는 점프하면서 쓸 스킬이 아니다 - 점프 공격 창(공중 시전 허용
		-- 구간)과 공중에서는 제외한다. 제자리 스턴 연출 2초짜리 대형기라 도약 타이밍에 낭비된다.
		local roarAirborne = false
		local rbRoar = player.RigidbodyComponent
		if isvalid(rbRoar) and not rbRoar:IsOnGround() then roarAirborne = true end
		for _, c in ipairs(pool) do
			if c.name == "드래곤 로어" then
				if roarHpRatio <= 0.60 or roarHpRatio <= roarCostRatio or not roarCrowded
					or (self._T.jumpAtkUntil or 0) > now or roarAirborne then
					c.w = 0
				else
					-- 스피어 버스터를 안 배웠거나 슬롯에 없으면 기준이 없다 - 광역 기본 가중(3.0)을 기준으로 삼는다.
					local baseW = (roarSpearW > 0) and roarSpearW or 3.0
					-- HP 60% → 100% 구간을 0.2 → 1.5로 선형 보간(계단 없음 - 위 ② 참고).
					local roarT = (roarHpRatio - 0.60) / 0.40
					if roarT < 0 then roarT = 0 end
					if roarT > 1 then roarT = 1 end
					local share = 0.2 + 1.3 * roarT
					c.w = baseW * share
				end
			end
		end

		-- 돌진 규칙 (요청): 전방 직선상에 적이 없으면 아예 쓰지 않는다(가중 0).
		-- (요청 2026-08-04) 좋은 스킬이지만 자동사냥 관전 시점에서 직업 컨셉(차지 블로우 속성
		-- 연계)을 가리므로 사용빈도 하향: 몰림 부스트 ×4 → ×1.5, 기본 가중 ×0.35(크게 감쇠),
		-- 여기에 최소 12초 간격 게이트 - 몰린 상황이 흔해 부스트만 낮춰서는 여전히 자주 나온다.
		-- (요청 2026-08-10) **방향 게이트 신설**: 돌진은 바라보는 방향으로 몸이 밀려나는 이동기라,
		-- 다음 사냥 지점(지금 대상을 잡은 뒤 이어갈 곳)이 등 뒤면 이동거리만 늘린다(신고: "돌진
		-- 사용 시 다음 가야 할 지역과 반대로 이동") - 그때는 쓰지 않는다. 같은 방향이면 적을 다음
		-- 동선 쪽으로 밀어 모으면서 이동거리도 버는 이득이라 몰림 부스트를 1.5 → 2.0으로 올린다.
		local chargeInPool = false
		for _, c in ipairs(pool) do
			if c.name == "돌진" and c.w > 0 then chargeInPool = true end
		end
		local chargeNextDir = 0
		if chargeInPool then chargeNextDir = self:GetNextHuntDirX(player, pp, target) end
		for _, c in ipairs(pool) do
			if c.name == "돌진" then
				if frontCount <= 0 or (self._T.nextCharge or 0) > now
					or (self._T.jumpAtkUntil or 0) > now then
					c.w = 0
				elseif chargeNextDir ~= 0 and lookDir ~= chargeNextDir then
					c.w = 0
					if (self._T.chargeDirLogAt or -99) + 5.0 < now then
						self._T.chargeDirLogAt = now
						log("[AutoHunt] 돌진 방향 게이트 - 다음 사냥 지점(" .. tostring(chargeNextDir)
							.. ")이 등 뒤라 미사용 (look=" .. tostring(lookDir) .. ")")
					end
				else
					c.w = c.w * 0.35
					if frontCount >= 2 then
						c.w = c.w * ((chargeNextDir ~= 0 and lookDir == chargeNextDir) and 2.0 or 1.5)
					end
				end
			end
		end

		-- (안전망) 연막 저격 중에 암살 외 스킬이 남아 있으면 전부 지운다 - 위 섀도어 확률표 뒤에도
		-- 돌진/드래곤 로어 등 다른 직업 블록이 가중을 더할 수 있어, **모든 계산이 끝난 여기서** 한 번 더
		-- 못박는다. 암살조차 쓸 수 없는 순간이면(유틸 시전 창 1.2초 등) 이번 틱은 쉰다 -
		-- 아래 기본공격 폴백까지 가면 그것도 허공을 때린다.
		if smokeSniping then
			local snipeW = 0
			for _, c in ipairs(pool) do
				if c.name == "암살" then snipeW = c.w else c.w = 0 end
			end
			if snipeW <= 0 then
				self._T.nextAtk = now + 0.2
				return
			end
		end

		-- (안전망, 썬콜 2026-08-08) 원거리 마법 시전 중에는 마법 스킬 외의 것이 남지 않게 한다 -
		-- 근접기가 뽑히면 허공을 때린다. 쓸 수 있는 마법이 하나도 없으면 이번 틱은 쉰다
		-- (기본공격 폴백도 허공이다 - 연막 저격 안전망과 같은 구조).
		if mageSniping then
			local mageW = 0
			for _, c in ipairs(pool) do
				-- (불독 2026-08-08) 파이어에로우(수평 원거리)/메테오(±12.5 광역)도 원거리에서 실제로 닿는
				-- 마법이다 - 자기 사거리 게이트는 위 불독 블록이 이미 걸어뒀다.
				-- (비숍 2026-08-11) 홀리 에로우(수평 9유닛 관통)도 원거리 저격 마법이다 - 자기 사거리
				-- 게이트는 위 마법사 블록이 걸어뒀다(빠져 있으면 저격 중 후보가 전부 0이라 틱만 쉬었다).
				if c.name == "매직클로" or c.name == "썬더볼트" or c.name == "매직 미사일"
					or c.name == "체인라이트닝" or c.name == "블리자드"
					or c.name == "파이어에로우" or c.name == "메테오" or c.name == "홀리 에로우" then
					mageW = mageW + c.w
				else
					c.w = 0
				end
			end
			if mageW <= 0 then
				self._T.nextAtk = now + 0.2
				return
			end
		end

		-- (신궁/보마, 요청 2026-08-10) 활 저격 중에는 **그 거리에 실제로 닿는 활 스킬만** 남긴다 -
		-- 근접기(있다면)나 사거리 밖 활 스킬이 뽑히면 허공을 때린다. 사거리 상수는 ShouldArcherSnipe와
		-- 같은 "서버 판정보다 살짝 안쪽" 값. 쓸 수 있는 활 스킬이 하나도 없으면 이번 틱은 쉰다
		-- (연막 저격/마법 저격 안전망과 같은 구조).
		if archerSniping then
			local adxA = math.abs(cdx)
			local arrowYA = cdy >= -0.35 and cdy <= 1.0
			local bowW = 0
			for _, c in ipairs(pool) do
				local keep = false
				if c.name == "더블샷" or c.name == "에로우 블로우" or c.name == "에로우 봄"
					or c.name == "속사" or c.name == "폭풍의 시" then
					keep = adxA <= 5.6 and arrowYA
				elseif c.name == "스트레이프" then
					keep = adxA <= 4.7 and arrowYA
				elseif c.name == "아이스 샷" or c.name == "파이어 샷" then
					keep = adxA <= 4.6 and cdy >= -1.0 and cdy <= 1.7
				elseif c.name == "아이언 에로우" then
					-- (요청 2026-08-13) 여기 빠져 있어서 **활 저격 중에는 아이언 에로우가 늘 0**이었다 -
					-- 정작 사거리가 제일 긴(9유닛) 8방향 관통기라 이 구간이 가장 어울린다.
					-- 게이트는 TryIronArrowRanged의 실측 한계(수평 7 / 수직 4)보다 살짝 안쪽으로 잡는다.
					keep = adxA <= 6.5 and math.abs(cdy) <= 3.5
				end
				if keep then bowW = bowW + c.w else c.w = 0 end
			end
			if bowW <= 0 then
				self._T.nextAtk = now + 0.2
				return
			end
		end

		-- (요청 2026-08-11) **2차 공격 스킬이 퀵슬롯에 있으면 1차 매직클로는 1%로 강등**한다
		-- (궁수/전사/표창 차수 사다리와 같은 관례). 2차 = 썬더볼트(썬콜) / 파이어에로우(불독) /
		-- 홀리 에로우(비숍). 썬콜 블록의 매직클로 기본 가중(근접 0.4 / 저격 2.0)이 2차를 배운 뒤에도
		-- 그대로라 매직클로가 계속 섞여 나갔다. 위치는 마법사 가중 블록들(썬콜/불독)이 전부 끝난 뒤 -
		-- 앞에 두면 뒤 블록의 대입이 강등을 덮는다. "먼 거리 한 명" 원거리 저격 기능은 유지된다 -
		-- 다른 후보가 전부 사거리 게이트로 0이 되면 강등된 가중으로도 매직클로가 뽑힌다.
		local hasSecondMage = false
		local holyArrowW = 0
		for _, c in ipairs(pool) do
			if c.name == "썬더볼트" or c.name == "파이어에로우" then
				hasSecondMage = true
			end
			if c.name == "홀리 에로우" then holyArrowW = c.w end
		end
		if hasSecondMage then
			for _, c in ipairs(pool) do
				if c.name == "매직클로" then c.w = c.w * 0.01 end
			end
		end
		-- (요청 2026-08-11) **홀리 에로우 보유 시 매직클로 사용 확률 = 10%** - ×0.01 강등이 아니라
		-- 가중을 그 시점 홀리 에로우의 1/9로 맞춘다(매직클로:홀리 에로우 = 10:90). 홀리 에로우가
		-- 사거리 게이트로 0인 순간(세로 어긋남/9유닛 밖)에는 매직클로 가중을 건드리지 않는다 -
		-- 그 자리의 대안 후보로 남아야 한다.
		if holyArrowW > 0 then
			for _, c in ipairs(pool) do
				if c.name == "매직클로" then c.w = holyArrowW / 9.0 end
			end
		end

		-- (신고 2026-08-10) 아이언 에로우 인플라이트 게이트: 앞서 쏜 화살이 대상에 도달하기 전에는
		-- 로테이션에서도 다시 뽑지 않는다. 원거리 전용 경로(TryIronArrowRanged)는 nextIronArrow
		-- 장부로 간격을 지키는데, 로테이션 경로(single 후보)는 이 장부를 안 거쳐 "화살이 아직
		-- 도달하지 않아 적이 안 죽은 걸로 보고" 연발하는 낭비가 났다 - 같은 장부를 여기서도 본다.
		if (self._T.nextIronArrow or 0) > now then
			for _, c in ipairs(pool) do
				if c.name == "아이언 에로우" then c.w = 0 end
			end
		end

		-- (요청 2026-08-09) 자원(MP/HP) 비용을 못 내는 스킬은 후보에서 뺀다.
		-- ⚠ 이게 없으면 UseSkillInSlot이 비용 부족으로 **조용히 return**해서, 뽑히기만 하고 아무것도
		--   안 하는 "가만히 서 있는" 상태가 된다(MP 소모가 생긴 파워스트라이크/슬래시블러스트 신고).
		--   전부 빠지면 아래 total<=0 분기가 그대로 기본공격 폴백으로 이어진다 - 분기를 새로 만들지 않는다.
		for _, c in ipairs(pool) do
			if c.w > 0 and not _SkillManager:CanAffordSkillCost(c.name) then
				c.w = 0
			end
		end

		-- (요청 2026-08-12) **버프 복구 우선 마나 절약 모드** - 전 직업 공용.
		-- 버프가 밀렸는데 MP가 모자라 못 켜는 동안에는, MP를 쓰는 공격 스킬을 **3번에 1번만** 쓰고
		-- 나머지는 기본공격(MP 0)으로 때운다. 남는 MP로 버프를 먼저 되살리는 것이 결국 화력에 이득이다.
		-- ⚠ 무료 스킬은 그대로 둔다 - 마나를 안 쓰므로 막을 이유가 없다(그만큼 손해만 본다).
		-- 전부 0이 되면 아래 total<=0 분기가 그대로 기본공격 폴백으로 이어진다(분기를 새로 만들지 않는다).
		if (self._T.mpSaveUntil or 0) > now and _UtilLogic:RandomDouble() > (1.0 / 3.0) then
			local dropped = 0
			for _, c in ipairs(pool) do
				if c.w > 0 and _SkillManager:GetSkillMpCost(c.name) > 0 then
					c.w = 0
					dropped += 1
				end
			end
			if dropped > 0 and (self._T.mpSaveLogAt or -99) + 3.0 < now then
				self._T.mpSaveLogAt = now
				log("[AutoHunt] 마나 절약 - 버프 복구 우선(MP 소모 공격 " .. tostring(dropped) .. "종 이번 틱 제외)")
			end
		end

		local total = 0
		for _, c in ipairs(pool) do total += c.w end
		if #pool == 0 or total <= 0 then
			-- 배정된 공격 스킬이 없거나(또는 전부 자원 부족) 기본공격 (Control 공격과 동일 경로)
			-- ⚠ (요청 2026-08-13) 신궁·보우마스터는 기본공격이 무기 휘두르기가 아니라 **더블샷 화살 1발**이다.
			--   여기서 엔진 ActionAttack을 부르면 엔진이 자기 ATTACK 상태로 무기를 휘둘러 활 모션과 섞인다 -
			--   수동 공격 키와 **같은 경로**(SkillManager.DoArcherBasicAttack)로 보낸다.
			--   "마나가 없으면 평타" 폴백이 바로 이 지점이라, 이 분기를 빼먹으면 요청이 반쪽만 적용된다.
			if _SkillManager:IsArcherJob() then
				_SkillManager:DoArcherBasicAttack()
			else
				local pcc = player.PlayerControllerComponent
				if isvalid(pcc) then pcc:ActionAttack() end
			end
			-- (요청 2026-08-09) 마지막 공격 시각 - 다운점프를 1초 미루는 판단에 쓴다.
			self._T.lastAttackAt = now
			-- (요청 2026-08-09) 기본공격 후 **0.5초간 아무 행동도 하지 않는다.**
			-- holdMoveUntil은 OnUpdate 상단에서 이동/점프/대상 재선정/다음 공격을 통째로 막는
			-- 기존 장치라 그대로 재사용한다(시전 모션 홀드와 같은 경로).
			-- 기본공격 모션(임팩트 0.3초)이 온전히 끝난 뒤 다음 행동으로 넘어가게 하는 목적.
			self._T.holdMoveUntil = now + 0.5
			-- 공격 틱마다 찍히면 로그가 넘치므로 2초에 한 번만 남긴다(폴백에 빠진 이유 추적용).
			if (self._T.basicAtkLogAt or -99) + 2.0 < now then
				self._T.basicAtkLogAt = now
				log("[AutoHunt] 기본공격 폴백 (후보 " .. tostring(#pool) .. "개, 가중합 " .. tostring(total)
					.. " - 미배정이거나 전부 자원 부족)")
			end
			return
		end

		local r = _UtilLogic:RandomDouble() * total
		local pick = pool[#pool]
		for _, c in ipairs(pool) do
			r = r - c.w
			if r <= 0 then
				pick = c
				break
			end
		end
		-- 돌진이 뽑혔으면 최소 간격(12초) 게이트를 갱신한다 (사용빈도 하향 - 위 돌진 규칙 참고)
		if pick.name == "돌진" then
			self._T.nextCharge = now + 12.0
		end
		-- (섀도어) 어썰터가 뽑혔으면 최소 간격을 건다 - 스택 3개를 한 번에 쏟지 않게 하는 장치.
		if pick.name == "어썰터" then
			self._T.nextAssaulter = now + (self._T.assaulterSpacing or 6.0)
		end
		-- (신고 2026-08-10) 아이언 에로우가 로테이션에서 뽑혔을 때도 인플라이트 장부(nextIronArrow)를
		-- 갱신한다 - 화살 도달(기모으기 0.7×공속 + 거리/속도 6) + 처치 판정 여유 0.6초 동안은
		-- 원거리 경로/로테이션 어느 쪽도 다시 쏘지 않는다(도달 전 연발 낭비 방지).
		if pick.name == "아이언 에로우" then
			local iaD = math.sqrt(cdx * cdx + cdy * cdy)
			self._T.nextIronArrow = now + math.max(2.5,
				0.7 * _CharInfoManager:GetAttackSpeedMultiplier() + iaD / 6.0 + 0.6)
		end
		-- (보마, 요청 2026-08-11) 에로우 봄 사용 카운트 - 5회마다 속사 1회가 해금된다(위 가중 규칙 참고).
		if pick.name == "에로우 봄" then
			self._T.abCastCount = (self._T.abCastCount or 0) + 1
		end
		-- (요청 2026-08-05) 드래곤 로어의 최소 간격 게이트(25초/12초)는 **삭제**했다.
		-- 사용 빈도를 "스피어 버스터 대비 비율"로 지정받았는데, 시간 게이트가 남아 있으면 뽑혀도
		-- 차단되어 실제 비율이 지정값보다 훨씬 낮아진다(빈도가 너무 낮다는 신고의 직접 원인).
		-- 빈도 조절은 위 HP 비례 가중 램프(60% 20% ~ 풀 150%)와 HP 60% 하한만으로 한다.
		-- 시전 모션 동안 이동 금지 (서버 컨트롤 잠금 0.65×공속 + 여유)
		self._T.holdMoveUntil = now + 0.8 * _CharInfoManager:GetAttackSpeedMultiplier()
		-- (버그 수정 2026-08-07) 드래곤 로어만 서버 컨트롤 잠금이 **공격속도와 무관한 고정 2초**다
		-- (스턴 연출 - PlayerAttack.AttackDragonRoar). 다른 스킬 기준인 위 0.8×공속을 그대로 두면
		-- 공격 틱(0.5초)이 로어 모션 한가운데서 다음 스킬을 뽑아 **스피어 버스터가 겹쳐 나갔다**(신고).
		-- 잠금이 풀릴 때까지 공격 틱과 걷기를 함께 미뤄, 로테이션 자체가 돌지 않게 한다
		-- (그냥 시전만 막으면 뽑힌 스킬의 자체 간격 게이트 - 돌진 12초 등 - 이 헛되이 소모된다).
		if pick.name == "드래곤 로어" then
			self._T.holdMoveUntil = now + 2.0
			self._T.nextAtk = now + 2.0
		end
		-- (요청 2026-08-08) 블리자드/메테오/제네시스는 서버가 조작을 3초 잠근다(행동불가) - 그런데
		-- 자동사냥의 걷기(MoveToDirection)는 클라 권한이라 그 잠금이 안 먹혀 "블리자드를 쓰면서
		-- 걸어 다니는" 신고가 났다. 잠금 동안 이동/다음 스킬을 함께 멈춘다(드래곤 로어와 같은 처리).
		-- ⚠ 간격은 3.0이 아니라 4.6초 - 서버의 재시전 잠금(isBlizzarding/isGenesising, 4.5초 해제)이
		--   행동 잠금(3초)보다 길어서, 3초 간격으로 다시 뽑으면 "요청 차단됨(이미 진행 중)"만 반복하며
		--   헛요청이 낀다(실측: 사용 21회 중 발동 12회).
		if pick.name == "블리자드" or pick.name == "메테오" or pick.name == "제네시스" then
			self._T.holdMoveUntil = now + 3.0
			self._T.nextAtk = now + 4.6
		end
		-- (불독 2026-08-08) 익스플로젼은 시전 1.0초 뒤 **그 시점의 시전자 위치**에서 터진다 -
		-- 그 전에 걸어 나가면 폭발 중심이 대상/독안개에서 밀린다. 폭발 시점까지 이동을 멈춘다.
		if pick.name == "익스플로젼" then
			self._T.holdMoveUntil = now + 1.2
			self._T.nextAtk = now + 1.2
		end
		-- (신고 2026-08-11, 보마 "가만히 멈춰있는 시간이 많다") 속사/폭풍의 시 = 홀드 연사 스킬.
		-- UseSkillInSlot은 연사를 "시작"만 하는데 자동사냥은 실제 키를 누르고 있지 않아 다음 프레임에
		-- 즉시 종료됐다 - 이동만 잠기고 화살은 0~1발인 "멈춤"이 로테이션마다 반복된 원인
		-- (스나이핑/피어싱은 같은 이유로 전용 역할로 뺐지만 이 둘은 로테이션에 남아 있었다).
		-- 자동 홀드 버스트(2.5초 연사 - 속사 약 15발/폭풍의 시 약 12발)로 시전하고, 연사가 끝날
		-- 때까지 이동/다음 스킬을 함께 멈춘다(연사 중 이동 불가 사양과 일치).
		if pick.name == "속사" or pick.name == "폭풍의 시" then
			local burstSec = 2.5
			self._T.lastAttackAt = now
			self._T.holdMoveUntil = now + burstSec + 0.3
			self._T.nextAtk = now + burstSec + 0.3
			if pick.name == "속사" then
				-- (요청 2026-08-11) 해금 소진 - 다음 속사는 에로우 봄 5회를 다시 채워야 한다.
				self._T.abCastCount = 0
				_SkillManager:AutoRapidFireBurst(pick.key, burstSec)
			else
				_SkillManager:AutoHurricaneBurst(pick.key, burstSec)
			end
			log("[AutoHunt] " .. pick.name .. " 연사 버스트 " .. tostring(burstSec) .. "초")
			return
		end
		-- (요청 2026-08-09) 마지막 공격 시각 - 다운점프를 1초 미루는 판단에 쓴다.
		self._T.lastAttackAt = now
		_SkillManager:UseSkillInSlot(pick.key)
	end

	-- (성능) 클라 몬스터 목록 0.3초 캐시: FindTarget(0.3초 주기) + 공격 틱의 Count 2회가 저마다
	-- 맵 전체 재귀 스캔을 돌려 클라당 초당 ~7회 순회가 쌓였다 - 한 목록을 셋이 공유한다
	-- (죽은 몬스터는 각 사용처의 IsDead 검사가 걸러낸다).
	@ExecSpace("ClientOnly")
	method table GetMonsterComps(Entity player)
		local now = _UtilLogic.ElapsedSeconds
		if self._T.monComps ~= nil and (now - (self._T.monCompsAt or -99)) < 0.3 then
			return self._T.monComps
		end
		local map = player.CurrentMap
		local comps = nil
		if isvalid(map) then
			comps = map:GetChildComponentsByTypeName("script.Monster", true)
		end
		if comps == nil then comps = {} end
		self._T.monComps = comps
		self._T.monCompsAt = now
		return comps
	end

	-- 바라보는 방향(dir) 전방 distX유닛 직선상(같은 높이)의 살아있는 몬스터 수 - 돌진 각 판정용.
	@ExecSpace("ClientOnly")
	method integer CountMonstersInFront(Entity player, Vector3 pp, number dir, number distX)
		local comps = self:GetMonsterComps(player)
		if comps == nil then return 0 end
		local count = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local wp = e.TransformComponent.WorldPosition
					local relX = (wp.x - pp.x) * dir
					if relX > 0 and relX <= distX and math.abs(wp.y - pp.y) <= 1.2 then
						count += 1
					end
				end
			end
		end
		return count
	end

	-- ── (섀도어) 다크사이트 잠복/뒤잡기 판정 ─────────────────────────────
	-- 잠복은 "다크사이트가 켜져 있고 아직 기습하지 않은" 구간이다. 그동안 추적 목표 x는 대상의
	-- 뒤통수 자리로 바뀌고(OnUpdate) 공격은 전부 보류된다(TryAttackCast).

	@ExecSpace("ClientOnly")
	method boolean IsDarkSightAmbushing(number now)
		if not _SkillManager:IsDarkSightActive() then return false end
		return (self._T.dsAmbushDeadline or 0) > now
	end

	@ExecSpace("ClientOnly")
	method number GetBehindDirOfTarget(Entity target)
		-- 대상의 뒤통수가 대상 기준 어느 쪽인가(-1 = 왼쪽 / 1 = 오른쪽).
		-- 몬스터는 오른쪽을 볼 때 Scale.x가 음수다(프로젝트 관례) - 서버 백스탭 판정
		-- (PlayerAttack.IsFacingRight)과 **같은 기준**이어야 기습이 실제로 백스탭으로 인정된다.
		if not isvalid(target) then return -1 end
		local flipped = false
		local tr = target.TransformComponent
		if isvalid(tr) and tr.Scale.x < 0 then flipped = not flipped end
		local spr = target.SpriteRendererComponent
		if isvalid(spr) and spr.FlipX == true then flipped = not flipped end
		if flipped then return -1 end
		return 1
	end

	@ExecSpace("ClientOnly")
	method integer CountNearbyMonsters(Entity player, Vector3 pp, number radius)
		local comps = self:GetMonsterComps(player)
		if comps == nil then return 0 end
		local count = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local wp = e.TransformComponent.WorldPosition
					if math.abs(wp.x - pp.x) <= radius and math.abs(wp.y - pp.y) <= 1.2 then
						count += 1
					end
				end
			end
		end
		return count
	end

	-- (요청 2026-08-10) 다음 사냥 지점 미리 탐색: 지금 대상을 잡은 뒤 이어서 갈 곳이 내 기준
	-- 어느 쪽인지(-1/1, 없거나 불명이면 0). "대상을 잡은 자리"(대상 위치) 기준 최근접(같은 층
	-- 우선) 생존 몬스터를 다음 지점으로 본다 - 돌진 방향 게이트 등 동선 판단용. 0.5초 캐시.
	@ExecSpace("ClientOnly")
	method number GetNextHuntDirX(Entity player, Vector3 pp, Entity target)
		-- 다음 사냥 지점(현재 대상 제외 최근접)의 수평 방향을 돌려준다. 캐시 0.5초.
		local now = _UtilLogic.ElapsedSeconds
		if self._T.nextDirAt ~= nil and (now - self._T.nextDirAt) < 0.5 then
			return self._T.nextDirX or 0
		end
		self._T.nextDirAt = now
		self._T.nextDirX = 0
		if not isvalid(target) then return 0 end
		local tp = target.TransformComponent.WorldPosition
		local comps = self:GetMonsterComps(player)
		local best = nil
		local bestScore = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e ~= target and e.Visible ~= false then
					local banUntil = nil
					if self._T.banned ~= nil then banUntil = self._T.banned[e] end
					if banUntil == nil or banUntil <= now then
						local wp = e.TransformComponent.WorldPosition
						local ddx = math.abs(wp.x - tp.x)
						local ddy = math.abs(wp.y - tp.y)
						-- FindTarget의 층 페널티와 같은 결: 다른 층은 수직 거리에 가중을 준다.
						local score = ddx
						if ddy >= 1.5 then score = score + ddy * 2 end
						if best == nil or score < bestScore then
							best = e
							bestScore = score
						end
					end
				end
			end
		end
		if best == nil then return 0 end
		local nx = best.TransformComponent.WorldPosition.x
		if math.abs(nx - pp.x) < 0.5 then return 0 end   -- 사실상 제자리 - 방향으로 안 본다
		self._T.nextDirX = (nx > pp.x) and 1 or -1
		return self._T.nextDirX
	end

	@ExecSpace("ClientOnly")
	method Entity FindTarget(Entity player)
		-- 현재 맵에서 살아있는 최근접 몬스터. 같은 높이(|dy|<1.5)를 우선하고,
		-- 추적 타임아웃으로 제외된 대상은 제외 시간이 지날 때까지 건너뛴다.
		local comps = self:GetMonsterComps(player)
		if comps == nil or #comps == 0 then return nil end
		local pp = player.TransformComponent.WorldPosition
		local now = _UtilLogic.ElapsedSeconds
		-- (신고 2026-08-10) 지금 밟고 있는 발판 Id - 아래 "끊긴 발판" 후보 걸러내기의 기준점.
		local myFhId = 0
		local rbMe = player.RigidbodyComponent
		if isvalid(rbMe) then
			local curFh = rbMe:GetCurrentFoothold()
			if curFh ~= nil then myFhId = curFh.Id end
		end
		if myFhId <= 0 then myFhId = self:GetFootholdIdBelow(player, pp.x, pp.y + 0.1, 1.5) end

		-- ⚠ (신고 2026-08-10 "등반해서 위에 적을 잡으려는 것처럼 하다가 등반 이후 바로 다시 내려간다")
		--   **등반 직후 층 고정.** 올라온 발판 위에 아직 잡을 적이 남아 있으면 그 적부터 정리하고,
		--   아래층 후보는 아예 보지 않는다.
		--   근본 원인: 둔덕에 올라서면 아래층(y-0.60)의 적도 `|relY| < 1.5`라 **같은 층으로 분류**되어
		--   최근접 경쟁에 그대로 끼어든다. 착지 순간 x가 더 가까운 아래층 적이 이기면 곧바로 목표가
		--   아래로 넘어가고, 하강 보류(1.2초)가 풀리는 즉시 내려간다 - 올라간 의미가 사라진다.
		--   → 등반 후 3초 동안은 **내 발 높이 ±0.4 안의 적만** 후보로 본다(그런 적이 하나도 없으면
		--     평소 규칙으로 되돌아가 정상적으로 아래층을 고른다).
		--   ⚠ 폭이 0.4인 이유(실측 2026-08-10): 이 맵의 둔덕 높이가 **0.60**이라 ±0.8로 두면 바로 아래
		--     바닥의 적까지 "같은 층"에 들어와, 층 고정 중에도 그쪽으로 걸어가다 가장자리에서 떨어졌다
		--     (등반 1초 뒤 낙하 2건). 0.4면 0.60 단차를 확실히 가르면서 발판 경사/스프라이트 오차는 견딘다.
		local layerHold = ((self._T.layerHoldUntil or 0) > now)
		if layerHold then
			local sameLayerAny = false
			for _, comp in ipairs(comps) do
				if isvalid(comp) and comp.IsDead ~= true then
					local e = comp.Entity
					if isvalid(e) and e.Visible ~= false then
						local banUntil = nil
						if self._T.banned ~= nil then banUntil = self._T.banned[e] end
						if banUntil == nil or banUntil <= now then
							local wpA = e.TransformComponent.WorldPosition
							-- (신고 2026-08-10) 높이가 같아도 **끊긴 건너편 발판**이면 층 고정 대상이 아니다 -
							-- 그쪽으로 걸어가면 가장자리에서 그대로 떨어진다.
							if math.abs(wpA.y - pp.y) <= 0.4
								and self:IsWalkConnectedToPoint(player, myFhId, wpA.x, wpA.y) then
								sameLayerAny = true
							end
						end
					end
				end
			end
			if sameLayerAny then
				local bestHold = nil
				local bestHoldDx = 0
				for _, comp in ipairs(comps) do
					if isvalid(comp) and comp.IsDead ~= true then
						local e = comp.Entity
						if isvalid(e) and e.Visible ~= false then
							local banUntil = nil
							if self._T.banned ~= nil then banUntil = self._T.banned[e] end
							if banUntil == nil or banUntil <= now then
								local wp = e.TransformComponent.WorldPosition
								if math.abs(wp.y - pp.y) <= 0.4
									and self:IsWalkConnectedToPoint(player, myFhId, wp.x, wp.y) then
									local dxH = math.abs(wp.x - pp.x)
									if bestHold == nil or dxH < bestHoldDx then
										bestHold = e
										bestHoldDx = dxH
									end
								end
							end
						end
					end
				end
				if bestHold ~= nil then return bestHold end
			end
		end

		-- 1차: 같은 층(|dy|<1.5) 후보의 최근접 수평 거리 - "같은 층 가까운 곳에 적이 있나" 판정.
		-- 같은 패스에서 아래층(1.1유닛 이상 아래) 최근접 후보도 함께 찾는다 (하강 순환용).
		local sameLayerNearest = nil
		local belowBest = nil
		local belowBestDist = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local banUntil = nil
					if self._T.banned ~= nil then banUntil = self._T.banned[e] end
					if banUntil == nil or banUntil <= now then
						local wp = e.TransformComponent.WorldPosition
						local relY = wp.y - pp.y
						if math.abs(relY) < 1.5 then
							local dxA = math.abs(wp.x - pp.x)
							if sameLayerNearest == nil or dxA < sameLayerNearest then
								sameLayerNearest = dxA
							end
						elseif relY <= -1.1 then
							local dxB = wp.x - pp.x
							local dB = math.sqrt(dxB * dxB + relY * relY)
							if belowBest == nil or dB < belowBestDist then
								belowBest = e
								belowBestDist = dB
							end
						end
					end
				end
			end
		end
		-- (요청) 하강 우선 규칙: 같은 층 적의 수평 거리가 아래층 적까지 거리의 3배 이상이면
		-- 멀리 걸어가는 대신 아래층 적을 대상으로 삼아 다운점프로 내려간다.
		-- 같은 층에 적이 아예 없을 때도 아래층 적이 있으면 그쪽으로 내려간다.
		-- (신고 2026-08-06) 단, 그 대상의 x에 착지 발판이 없으면(플레이어 층 아래가 뚫린 지형)
		-- 다운점프로 내려갈 수 없다 - 하강 우선권을 주지 않는다(일반 점수 선정으로 넘어가고,
		-- 거기서 골라져도 다운점프 분기의 발밑 검사가 즉시 제외한다).
		if belowBest ~= nil then
			local mapFB = player.CurrentMap
			local fhFB = isvalid(mapFB) and mapFB.FootholdComponent or nil
			local belowReachable = true
			if isvalid(fhFB) then
				local bx = belowBest.TransformComponent.WorldPosition.x
				belowReachable = fhFB:Raycast(Vector2(bx, pp.y - 0.3), Vector2(0, -1), 8.0) ~= nil
			end
			if belowReachable and (sameLayerNearest == nil or sameLayerNearest >= belowBestDist * 3.0) then
				return belowBest
			end
		end
		-- (요청) 같은 층 가까운 곳(4유닛 내)에 적이 없으면 위아래 적의 페널티를 크게 완화해
		-- 수직 대상을 적극 선택한다 → 섬광(이동기) 사용 기회가 올라간다.
		local sameLayerClose = (sameLayerNearest ~= nil and sameLayerNearest <= 4.0)

		-- (요청) 위 발판의 적(위쪽으로 1.1유닛 이상)은 섬광 같은 상하 이동기가 없으면 도달 수단이
		-- 없다 - 위로 점프하는 접근을 없앴으므로 아예 대상 후보에서 제외한다. 아래층은 다운점프로
		-- 내려갈 수 있어 그대로 둔다.
		-- (다크나이트) 드래곤 라이딩 소환이 활성(미탑승)이면 탑승 비행으로 위층에 갈 수 있으므로
		-- 섬광과 동일하게 위층 적도 후보에 넣는다.
		-- (나이트로드) 헤이스트가 켜져 있으면 점프 보정 사거리만큼 위 발판에 올라갈 수 있다 -
		-- 그 높이 안의 위층 적은 후보에 넣는다(사거리 밖은 여전히 제외).
		-- (나이트로드·섀도어) 플래시 점프를 배웠으면 그 사거리 안의 위층 적도 후보에 넣는다
		-- (헤이스트 점프 보정과 같은 취급 - 실제 도약은 추적 분기의 TryFlashJumpMove가 한다).
		local hasteReach = self:GetHasteJumpReach()
		local flashReach = self:GetFlashJumpReach()
		-- (요청 2026-08-09) 이동기가 없어도 **앞점프로 닿는 높이**의 위층 적은 후보에 넣는다 -
		-- 실제 도약은 추적 분기의 "앞점프로 위 발판 등반"이 하고, 올라설 발판 확인도 거기서 한다.
		-- 이게 없으면 히어로처럼 이동기 없는 직업이 바로 위 발판의 적을 영영 후보에서 놓친다.
		local plainReach = self:GetPlainJumpReach(player)
		-- (썬콜, 요청 2026-08-08) 텔레포트가 퀵슬롯에 있으면 위 발판 2.31유닛까지 수직 텔레포트로
		-- 올라갈 수 있다 - 그 높이 안의 위층 적을 후보에 넣는다(실제 도약은 추적 분기의 텔레포트 이동이).
		local tpReach = 0
		if self._T.slotTeleports ~= nil and #self._T.slotTeleports > 0 then tpReach = 2.4 end
		local hasMobility = (self._T.slotMobilities ~= nil and #self._T.slotMobilities > 0)
			or (self._T.slotDragonRides ~= nil and #self._T.slotDragonRides > 0 and _SkillManager:CanAutoMountDragonRide())
		-- (요청 2026-08-10) 동선 예측: 살아있는 전체 몬스터의 무게중심 방향(x). 아래 점수 계산에서
		-- "가는 길목에 있는" 후보를 살짝 우선해, 잡고 나서 다음 지형으로 자연스럽게 이어지게 한다.
		local aliveSumX = 0
		local aliveCnt = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local eC = comp.Entity
				if isvalid(eC) and eC.Visible ~= false then
					aliveSumX = aliveSumX + eC.TransformComponent.WorldPosition.x
					aliveCnt += 1
				end
			end
		end
		local centroidDir = 0
		if aliveCnt >= 2 then
			local cxAll = aliveSumX / aliveCnt
			if math.abs(cxAll - pp.x) >= 1.0 then
				centroidDir = (cxAll > pp.x) and 1 or -1
			end
		end
		local best = nil
		local bestScore = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local banUntil = nil
					if self._T.banned ~= nil then banUntil = self._T.banned[e] end
					if banUntil == nil or banUntil <= now then
						local wp = e.TransformComponent.WorldPosition
						local relY = wp.y - pp.y
						-- (요청 2026-08-09) 어떤 이동기로도 못 닿는 위층이라도 **로프로 올라갈 수 있으면** 후보다.
						-- 실제 등반은 추적 분기의 RopeClimbTick이 담당하고, 실패하면 타임아웃으로 제외된다.
						local ropeOk = false
						if relY >= 1.1 then
							ropeOk = self:FindUsableRope(player, pp, wp.y, wp.x) ~= nil
						end
						-- (요청 2026-08-10) 이동기·점프로 못 올라가는 위층이라도 **점프 정점 공격**
						-- (점프 사거리 + 위쪽 판정 박스 0.9)이 닿는 높이면 후보에 남긴다 - 실제 공격은
						-- 추적 분기의 TryJumpAttack이 담당한다(그동안 이런 적은 무시됐다는 신고).
						if relY >= 1.1 and not hasMobility and relY > hasteReach and relY > flashReach
							and relY > tpReach and relY > plainReach + 1.15 and not ropeOk then
							continue
						end
						-- ⚠ (신고 2026-08-10) **높이는 같으나 끊겨서 서로 갈 수 없는 발판**의 적은 후보가 아니다.
						--   예전엔 |relY|만 보고 "같은 층"으로 분류해, 건너편 발판의 적을 향해 걸어가다
						--   가장자리에서 그대로 떨어졌다(신고: 좌측 로프로 올라간 뒤 우측 발판의 적을 향해 이동).
						--   판정 범위는 (-0.8, 1.1) - 그 위는 위층 전용 도달 판정(위 continue)이, 그 아래는
						--   다운점프 경로(착지 발판 레이캐스트)가 이미 따로 거른다.
						--   ⚠ 끊겨 있어도 **앞점프로 그 발판에 올라설 수 있으면** 정상 후보다(작은 턱/선반).
						if relY > -0.8 and relY < 1.1
							and not self:IsWalkConnectedToPoint(player, myFhId, wp.x, wp.y)
							and not self:CanReachTargetLayer(player, pp, wp, plainReach) then
							-- (신고 2026-08-10 2차) **약간 위**(0.5↑)의 끊긴 선반 위 적은 점프 정점
							-- 공격이 닿으면 후보에 남긴다 - 실제 공격은 추적 분기의 가장자리 점프
							-- 공격(TryJumpAttack)이 담당한다. 그 외(같은 높이/아래의 건너편)는 기존대로 제외.
							if not (relY >= 0.5 and relY <= plainReach + 1.15) then
								continue
							end
						end
						local dxA = math.abs(wp.x - pp.x)
						local dyA = math.abs(relY)
						local score = dxA
						if dyA >= 1.5 then
							if sameLayerClose then
								score = score + dyA * 10 + 100
							else
								score = score + dyA * 2
							end
						end
						-- (요청 2026-08-10) 군집 가중: 후보 주변(±2.0/±1.2)의 살아있는 적 수만큼
						-- 점수를 깎는다(최대 3마리 × 0.6) - 거리가 비슷하면 뭉친 곳을 골라, 도착해서
						-- 광역 로테이션으로 대상과 주변까지 한 번에 정리한다(요청: "대상 지점 + 주변
						-- 몬스터를 잡고").
						local nbrCnt = 0
						for _, compN in ipairs(comps) do
							if isvalid(compN) and compN.IsDead ~= true then
								local eN = compN.Entity
								if isvalid(eN) and eN ~= e and eN.Visible ~= false then
									local wpN = eN.TransformComponent.WorldPosition
									if math.abs(wpN.x - wp.x) <= 2.0 and math.abs(wpN.y - wp.y) <= 1.2 then
										nbrCnt += 1
									end
								end
							end
						end
						if nbrCnt > 3 then nbrCnt = 3 end
						score = score - nbrCnt * 0.6
						-- (요청 2026-08-10) 동선 연속 가중: 남은 적들의 무게중심과 같은 쪽 후보를
						-- 0.8 우선한다 - "그다음 어디로 갈지"를 미리 보고 가는 길목의 적부터 잡아
						-- 왕복 없이 한 방향으로 훑는 동선을 만든다.
						if centroidDir ~= 0 and dxA >= 0.5
							and (((wp.x - pp.x) > 0) == (centroidDir > 0)) then
							score = score - 0.8
						end
						if best == nil or score < bestScore then
							best = e
							bestScore = score
						end
					end
				end
			end
		end
		return best
	end

	-- (요청) 하강 순환 복귀: 맨아래 층(발밑에 더 이상 발판이 없음)에서 사냥감이 끊기면
	-- 아랫점프로 떨어지는 대신(엔진이 맨아래 관통 낙하를 막음) 맵의 SpawnLocation(맨 위)으로
	-- 순간이동해 위에서부터 다시 내려오며 사냥한다 - 사다리 없이 아래로만 내려가는 동선.
	-- SpawnLocation이 없는 맵에서는 아무것도 하지 않는다. 복귀했으면 true.
	@ExecSpace("ClientOnly")
	method boolean TryBottomReturn(number now, Entity player)
		if (self._T.nextBottomReturn or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		local map = player.CurrentMap
		if not isvalid(map) then return false end
		local fh = map.FootholdComponent
		if not isvalid(fh) then return false end
		-- 발밑 0.3유닛 아래에서 아래로 8유닛 레이캐스트 - 발판이 잡히면 아직 맨아래가 아니다.
		-- 예외: 이 맵은 전폭 바닥 0.6 위에 선반 발판이 겹쳐 있어, 선반 위에 서 있어도
		-- 바로 아래(1유닛 이내) 바닥이 진짜 맨아래(그 밑에 발판 없음)면 맨아래로 취급한다.
		local pp = player.TransformComponent.WorldPosition
		local below = fh:Raycast(Vector2(pp.x, pp.y - 0.3), Vector2(0, -1), 8.0)
		if below ~= nil then
			local by = below:GetYByX(pp.x)
			if (pp.y - by) > 1.0 then return false end
			local below2 = fh:Raycast(Vector2(pp.x, by - 0.3), Vector2(0, -1), 8.0)
			if below2 ~= nil then return false end
		end
		return self:ReturnToSpawn(now, player, "맨아래 도달")
	end

	-- (신고 2026-08-06) 중간 발판 무대상 정체 복귀: 잡을 수 있는 대상이 하나도 없는 상태(남은 적이
	-- 위층뿐이라 후보 제외/추적 제외 중)가 4초 이상 이어지고 맵에 살아있는 몬스터는 있으면,
	-- 맨아래가 아니어도 스폰 지점으로 복귀해 하강 순환을 다시 시작한다.
	-- 전멸(살아있는 몬스터 0)이면 리젠 대기이므로 배회를 유지한다(헛복귀 반복 방지). 복귀했으면 true.
	@ExecSpace("ClientOnly")
	method boolean TryNoTargetReturn(number now, Entity player)
		if self._T.noTargetSince == nil then
			self._T.noTargetSince = now
			return false
		end
		if now - self._T.noTargetSince < 4.0 then return false end
		local comps = self:GetMonsterComps(player)
		local anyAlive = false
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				anyAlive = true
				break
			end
		end
		if not anyAlive then return false end
		if self:ReturnToSpawn(now, player, "무대상 4초 지속") then
			self._T.noTargetSince = nil
			return true
		end
		return false
	end

	-- 스폰 지점(맨 위) 복귀 공용 절차 - 맨아래 도달/중간 무대상 정체 두 경로가 함께 쓴다.
	@ExecSpace("ClientOnly")
	method boolean ReturnToSpawn(number now, Entity player, string reason)
		if (self._T.nextBottomReturn or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		local map = player.CurrentMap
		if not isvalid(map) then return false end
		local spawnE = map:GetChildByName("SpawnLocation", true)
		if not isvalid(spawnE) then return false end
		self._T.nextBottomReturn = now + 4.0
		-- 순간이동은 검증된 패턴대로 1회만 호출한다 (SetWorldPosition 반복 호출은 되돌림 버그).
		local sp = spawnE.TransformComponent.WorldPosition
		rb:SetWorldPosition(Vector2(sp.x, sp.y + 0.2))
		rb:PositionReset()
		self._T.target = nil
		self._T.nextScan = 0
		self._T.holdMoveUntil = now + 0.4
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "MOVE" then
			sc:ChangeState("IDLE")
		end
		log("[AutoHunt] 스폰 지점 복귀(" .. reason .. ") (" .. string.format("%.1f, %.1f", sp.x, sp.y) .. ")")
		return true
	end

	-- (나이트로드) 표창 스킬(럭키세븐/트리플/쿼드러플)이 퀵슬롯에 하나라도 있는가 -
	-- 각성 중 "제자리 사냥" 판정에 쓴다(표창이 없으면 각성 중에도 평소처럼 붙어야 한다).
	@ExecSpace("ClientOnly")
	method boolean HasAssassinateSlot()
		-- 암살이 퀵슬롯에 올라와 있는가(연막 중 원거리 시전 판단에 쓴다).
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "암살" then return true end
				end
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method number GetAssassinateReach()
		-- (요청 2026-08-06) **연막 안에서는 암살 사거리가 2배**가 된다 - 자동사냥이 그걸 활용해야 한다.
		-- 서버 FindNearestAssassinateTarget의 기준(원형 4.5, 연막 중 9.0)과 **같은 값**이어야
		-- "사거리 안이라 판단했는데 서버는 대상을 못 찾는" 헛빵이 안 난다.
		if _SkillManager:IsSmokeScreenActiveLocal() then return 9.0 end
		return 4.5
	end

	@ExecSpace("ClientOnly")
	method boolean ShouldSnipeWithAssassinate(number dx, number dy)
		-- 연막 중 + 암살 보유 + 대상이 암살 사거리 안이면 **걸어가지 않고 제자리에서** 시전한다.
		-- (각성 중 표창 3종이 로어 범위를 그대로 조준하는 것과 같은 처리 - 그 분기의 자매 규칙이다.)
		if not self:HasAssassinateSlot() then return false end
		if not _SkillManager:IsSmokeScreenActiveLocal() then return false end
		local reach = self:GetAssassinateReach()
		return math.sqrt(dx * dx + dy * dy) <= reach
	end

	@ExecSpace("ClientOnly")
	method boolean HasStarThrowSlot()
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "럭키세븐" or s.name == "트리플 스로우" or s.name == "쿼드러플 스로우" then
						return true
					end
				end
			end
		end
		return false
	end

	-- ── (썬콜, 요청 2026-08-08) 마법 원거리 사냥 / 블리자드+리커버리 오로라 콤보 ──

	@ExecSpace("ClientOnly")
	method string FindBlizzardSlotKey()
		-- 블리자드가 배정된 단축키(없으면 빈 문자열). 역할은 aoe라 slotAoes에 들어 있다.
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "블리자드" then return s.key end
				end
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method boolean HasBlizzardSlot()
		-- 블리자드가 퀵슬롯에 올라와 있는가(오로라 콤보/난사 모드 판단에 쓴다).
		return self:FindBlizzardSlotKey() ~= ""
	end

	@ExecSpace("ClientOnly")
	method string FindMeteorSlotKey()
		-- (불독 2026-08-08) 메테오가 배정된 단축키(없으면 빈 문자열) - 블리자드의 불독판. 역할은 aoe.
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "메테오" then return s.key end
				end
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method boolean HasMeteorSlot()
		-- 메테오가 퀵슬롯에 올라와 있는가(불독 오로라 콤보/난사 모드 판단에 쓴다).
		return self:FindMeteorSlotKey() ~= ""
	end

	-- ── (불독, 요청 2026-08-08) 포이즌 미스트 카펫 - 맵 전역에 독안개 깔기 ──────
	-- 요청 메커니즘: "포이즌 미스트를 맵 전역에 가능한 한 깔고 익스플로젼으로 사냥".
	-- 전용 경로 탐색 없이, 기존 사냥 동선(추적/배회/하강 순환)이 맵을 훑는 것을 이용해
	-- "지나가는 자리가 아직 안 덮였고 주변에 적이 있으면" 발밑에 하나씩 깔아둔다.

	@ExecSpace("ClientOnly")
	method string FindPoisonMistSlotKey()
		-- 포이즌 미스트가 배정된 단축키(없으면 빈 문자열). 역할은 aoe라 slotAoes에 들어 있다.
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "포이즌 미스트" then return s.key end
				end
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method table GetActiveMistPositions(Entity player)
		-- 맵에 살아있는 독안개 위치 목록(1초 캐시). 서버가 스폰한 독안개 엔티티는 클라에도 복제되므로
		-- script.PoisonMistZone 컴포넌트 존재 여부로 스캔한다 - 커버리지/유폭권 판단 전용이라
		-- 위치(Transform 동기화 값)만 읽고 서버 전용 상태는 건드리지 않는다.
		local now = _UtilLogic.ElapsedSeconds
		if self._T.mistPosCache ~= nil and (now - (self._T.mistPosCacheAt or -99)) < 1.0 then
			return self._T.mistPosCache
		end
		local out = {}
		local map = player.CurrentMap
		if isvalid(map) then
			local comps = map:GetChildComponentsByTypeName("script.PoisonMistZone", true)
			for _, comp in ipairs(comps) do
				if isvalid(comp) and isvalid(comp.Entity) then
					local mpz = comp.Entity.TransformComponent.WorldPosition
					table.insert(out, { x = mpz.x, y = mpz.y })
				end
			end
		end
		self._T.mistPosCache = out
		self._T.mistPosCacheAt = now
		return out
	end

	@ExecSpace("ClientOnly")
	method integer CountMistsNear(Entity player, number x, number y, number rangeX, number rangeY)
		-- 기준점(x, y) 주변 박스(±rangeX/±rangeY) 안의 살아있는 독안개 수.
		local n = 0
		for _, m in ipairs(self:GetActiveMistPositions(player)) do
			if math.abs(m.x - x) <= rangeX and math.abs(m.y - y) <= rangeY then
				n += 1
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method boolean PoisonCarpetTick(number now, Entity player)
		-- 사냥 동선을 따라 지나가며 독안개를 깔아둔다. 이 틱을 카펫이 소비했으면 true.
		--   · 이 자리가 이미 덮여 있으면(±2.5/±1.2) 깔지 않는다 - "가능한 한 넓게".
		--   · 허공에 낭비하지 않게 주변(±3.0)에 살아있는 몬스터가 있을 때만 깐다.
		--   · 동시 유지 상한 10개 - 서버 부하(안개마다 1초 틱 전수 스캔) + 익스플로젼 유폭 상한(6개) 감안.
		local key = self:FindPoisonMistSlotKey()
		if key == "" then return false end
		if (self._T.nextMistDrop or 0) > now then return false end
		local pp = player.TransformComponent.WorldPosition
		local mists = self:GetActiveMistPositions(player)
		if #mists >= 10 then
			self._T.nextMistDrop = now + 2.0
			return false
		end
		if self:CountMistsNear(player, pp.x, pp.y, 2.5, 1.2) > 0 then return false end
		-- (요청 2026-08-11) 살아있는 적이 없어도 **리젠 자리**가 발밑 커버리지 안에 있으면 선설치한다 -
		-- 몬스터가 리젠되자마자 독이 발린 상태로 시작하게. 살아있는 적 조건과 OR.
		local nearAlive = self:CountNearbyMonsters(player, pp, 3.0) >= 1
		local nearRespawn = false
		if not nearAlive then nearRespawn = self:HasUncoveredRespawnSpotNear(player, pp) end
		if not nearAlive and not nearRespawn then return false end
		self._T.nextMistDrop = now + 2.0
		if self._T.moving then self:StopMoving() end
		-- 시전 모션(alert 0.6×공속) 동안 이동 금지 - 다른 유틸 시전과 같은 처리.
		self._T.holdMoveUntil = now + 0.9
		_SkillManager:UseSkillInSlot(key)
		log("[AutoHunt] 포이즌 미스트 카펫 - " .. (nearRespawn and "리젠 자리 선설치" or "새 자리에 독안개")
			.. " (" .. tostring(#mists + 1) .. "개째)")
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean HasUncoveredRespawnSpotNear(Entity player, Vector3 pp)
		-- (요청 2026-08-11) "죽어서 리젠 대기 중"인 몬스터의 리젠 자리(Monster.SpawnX/Y @Sync -
		-- 리젠은 항상 최초 배치 좌표에서 일어난다)가, 지금 이 자리에 안개를 깔면 실제로 덮일 범위
		-- (±1.5/±1.2 - 안개 판정 반경 1.8/1.5의 안쪽 여유값) 안에 있고, 그 자리를 다른 안개가
		-- 아직 안 덮고 있으면 참. 리젠 없이 소멸하는 몬스터는 사망 직후 Destroy로 isvalid에서
		-- 걸러지므로 "죽었는데 유효"는 사실상 리젠 대기와 같다.
		local comps = self:GetMonsterComps(player)
		if comps == nil then return false end
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead == true then
				local sx = comp.SpawnX or 0
				local sy = comp.SpawnY or 0
				if (sx ~= 0 or sy ~= 0)
					and math.abs(sx - pp.x) <= 1.5 and math.abs(sy - pp.y) <= 1.2
					and self:CountMistsNear(player, sx, sy, 2.5, 1.2) < 1 then
					return true
				end
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean ShouldMageSnipe(Entity player, Vector3 pp, number dx, number dy)
		-- 제자리 원거리 시전이 "이득인" 상황만 고른다 - 아무 때나 서 버리면 썬더볼트(근거리 주력) 위주
		-- 사냥이 무너진다. 사거리 상수는 서버 판정보다 살짝 안쪽(헛빵 방지):
		--   매직클로 전방 5.0/±1.5 → 4.8/1.4, 매직 미사일 전방 6.0/±3.0 → 5.5/2.8(쿨 5초),
		--   체인라이트닝 전방 0.5~6.0 콘(±0.8+0.45x) → 5.5.
		--   ① 체인라이트닝이 닿는다 → 항상 제자리(4차 주력 - 매직클로/썬더볼트는 1%로 강등된 상태).
		--   ② 주변에 적이 그 하나뿐이고 매직클로/매직 미사일이 닿는다 → 제자리("먼 거리 한 명" 요청).
		--   ③ 대상이 위아래로 벌어져 있고(±0.8↑) 매직 미사일이 닿는다 → 제자리(수직 판정 활용).
		--   ④ 썬더볼트를 아직 안 배웠고(1차) 매직클로가 닿는다 → 제자리(1차는 원거리가 주력이다).
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist <= 1.15 then return false end   -- 근접 로테이션이 처리한다
		local adx = math.abs(dx)
		local ady = math.abs(dy)
		local hasClaw, hasBolt, hasMissile, hasChain, hasFireArrowSn, hasHolyArrowSn = false, false, false, false, false, false
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "매직클로" then hasClaw = true end
					if s.name == "썬더볼트" then hasBolt = true end
					if s.name == "매직 미사일" then hasMissile = true end
					if s.name == "체인라이트닝" then hasChain = true end
					if s.name == "파이어에로우" then hasFireArrowSn = true end
					if s.name == "홀리 에로우" then hasHolyArrowSn = true end
				end
			end
		end
		if hasChain and adx >= 0.5 and adx <= 5.5 and ady <= 0.8 + adx * 0.45 then return true end
		-- (요청 2026-08-11, 비숍) 홀리 에로우 = 수평 전방 관통 화살(속도 10 × 수명 0.9 = 9유닛, 최대
		-- 6명 관통). 같은 층 사거리 안이면 걸어가 붙지 않고 제자리에서 쏜다(궁수 활 저격과 같은 이유 -
		-- 관통형이라 항상 제자리가 이득). 수평 고정 발사라 세로 허용은 ±0.5로 좁게 본다.
		if hasHolyArrowSn and adx >= 0.5 and adx <= 8.5 and ady <= 0.5 then return true end
		-- (요청 2026-08-11) 매직클로 실판정 2/3 축소(전방 3.33/±1.0) - 안쪽 여유 3.2/0.9.
		local clawReach = hasClaw and adx <= 3.2 and ady <= 0.9
		local missileReach = hasMissile and adx <= 5.5 and ady <= 2.8 and _SkillManager:IsMagicMissileReady()
		-- (불독 2026-08-08) 파이어에로우: 자동사냥은 방향키가 없어 수평 전방으로만 나간다 - 같은 높이의
		-- 먼 대상만 원거리 저격 대상으로 삼는다(투사체 수명 1.5초 × 속도 6 = 9유닛보다 살짝 안쪽).
		local fireArrowReach = hasFireArrowSn and adx <= 7.5 and ady <= 0.6
		if self:CountNearbyMonsters(player, pp, 7.0) <= 1 and (clawReach or missileReach or fireArrowReach) then return true end
		if ady >= 0.8 and missileReach then return true end
		if (not hasBolt) and clawReach then return true end
		return false
	end

	-- (신궁/보우마스터, 요청 2026-08-10) "활 스킬은 사거리가 아주 긴데 파워스트라이크처럼 근접으로
	-- 붙어서 쓴다" - 활 스킬의 전방 자동 조준 박스(서버 실측: 더블샷/에로우 블로우/에로우 봄
	-- 6.0×±0.8, 스트레이프 5.0×±0.8, 아이스 샷/파이어 샷 ±4.95×±1.65 - 모두 몸통 중심 y+0.35 기준)
	-- 안의 같은 층 대상은 걸어가 붙지 않고 **제자리에서 쏜다**(마법 저격 ShouldMageSnipe와 같은 구조).
	-- 사거리 상수는 서버 판정보다 살짝 안쪽(헛빵 방지). 여기서 참이면 TryAttackCast의 archerSniping
	-- 필터가 "그 거리에 실제로 닿는 활 스킬"만 로테이션에 남긴다. 마법 저격과 달리 조건 없이
	-- "닿으면 제자리"다 - 궁수는 주력이 전부 원거리 활이라 근접 주력이 무너질 걱정이 없다.
	@ExecSpace("ClientOnly")
	method boolean ShouldArcherSnipe(Entity player, Vector3 pp, number dx, number dy)
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist <= 1.15 then return false end   -- 근접 거리는 기존 로테이션이 처리한다
		local adx = math.abs(dx)
		local hasArrow, hasStrafe, hasShot = false, false, false
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "더블샷" or s.name == "에로우 블로우" or s.name == "에로우 봄"
						or s.name == "속사" or s.name == "폭풍의 시" then hasArrow = true end
					if s.name == "스트레이프" then hasStrafe = true end
					if s.name == "아이스 샷" or s.name == "파이어 샷" then hasShot = true end
				end
			end
		end
		-- 화살 조준 박스는 몸통 중심(발끝 +0.35) 기준 ±0.8 - 대상 발끝 dy로는 [-0.45, +1.15].
		-- 안쪽 마진을 두어 [-0.35, +1.0]만 "같은 층"으로 본다.
		local arrowY = dy >= -0.35 and dy <= 1.0
		if hasArrow and adx <= 5.6 and arrowY then return true end
		if hasStrafe and adx <= 4.7 and arrowY then return true end
		-- 아이스 샷/파이어 샷은 세로가 넉넉하다(±1.65 → 발끝 기준 [-1.15, +1.85], 마진 [-1.0, +1.7]).
		if hasShot and adx <= 4.6 and dy >= -1.0 and dy <= 1.7 then return true end
		return false
	end

	-- 오로라 주변 노쿨을 이용한 광역 난사 콤보 (썬콜 4차 = 블리자드 / 불독 4차 = 메테오).
	-- 이 틱을 콤보가 소비했으면 true.
	--   · 오로라 안 + (대상이 폭격 범위 안이거나 맵에 몬스터가 적으면) 제자리에서 난사한다.
	--   · 오로라 밖 + 폭격기 쿨타임 중이면 오로라로 걸어 돌아가 쿨타임을 갱신한다
	--     ("거리가 안 되면 가서 쓰고 다시 리커버리로 온다" - 가는 절반은 일반 추적이 담당).
	-- (불독 확장 2026-08-08) 블리자드 자리에 메테오를 그대로 끼울 수 있게 "폭격기" 슬롯/쿨 판정만
	-- 갈라 받는다 - 두 스킬 모두 시전자 주변 발판 ±12.5/±4.7에 알아서 떨어지는 같은 규격이다.
	@ExecSpace("ClientOnly")
	method boolean MageAuraComboTick(number now, Entity player, number delta)
		-- ⚠ 대상(self._T.target)은 nil일 수 있어 인자로 받지 않는다(nil Entity 인자 = 본문 미실행 함정).
		if self._T.slotRecoveryAuras == nil or #self._T.slotRecoveryAuras == 0 then return false end
		local bombKey = self:FindBlizzardSlotKey()
		local bombName = "블리자드"
		if bombKey == "" then
			bombKey = self:FindMeteorSlotKey()
			bombName = "메테오"
		end
		if bombKey == "" then return false end
		local bombReady = false
		if bombName == "메테오" then
			bombReady = _SkillManager:IsMeteorReady()
		else
			bombReady = _SkillManager:IsBlizzardReady()
		end
		if not _SkillManager:HasActiveRecoveryAura() then return false end
		local target = self._T.target
		local pp = player.TransformComponent.WorldPosition
		if _SkillManager:IsInRecoveryAura() then
			-- 살아있는 몬스터가 하나도 없으면 리젠 대기 - 평소 배회/복귀 로직에 맡긴다.
			local aliveCount = 0
			for _, comp in ipairs(self:GetMonsterComps(player)) do
				if isvalid(comp) and comp.IsDead ~= true then aliveCount += 1 end
			end
			if aliveCount == 0 then return false end
			-- 제자리 난사 조건: 대상이 폭격 범위(가로 ±12 / 세로 ±4.2 - 실범위 12.5/4.7보다 살짝
			-- 안쪽) 안이거나, 맵에 몬스터가 적어서(3마리 이하) 굳이 걸어갈 가치가 없을 때.
			-- 그 외(몬스터가 많은데 전부 멀다)는 일반 추적으로 나가 잡는다 - 폭격기를 쓰고 쿨이
			-- 돌기 시작하면 아래 복귀 분기가 데려온다.
			local inBlizRange = false
			if target ~= nil and isvalid(target) then
				local tpB = target.TransformComponent.WorldPosition
				inBlizRange = math.abs(tpB.x - pp.x) <= 12.0 and math.abs(tpB.y - pp.y) <= 4.2
			end
			if not inBlizRange and aliveCount > 3 then return false end
			if self._T.moving then self:StopMoving() end
			self._T.chaseStart = now
			if target ~= nil and isvalid(target) then
				-- 대상이 있으면 바라보는 방향을 맞춰 둔다(체인라이트닝/매직 미사일 혼용 대비).
				local tpF = target.TransformComponent.WorldPosition
				local dxF = tpF.x - pp.x
				if math.abs(dxF) > 0.05 then
					local pccF = player.PlayerControllerComponent
					if isvalid(pccF) then
						local wantF = (dxF > 0) and 1 or -1
						if pccF.LookDirectionX ~= wantF then
							pccF.LookDirectionX = wantF
							self._T.dirChangedAt = now
						end
					end
				end
				if not self:TryUtilityCast(now) then
					self:TryAttackCast(now, player, pp)
				end
				return true
			end
			-- 대상이 없어도(전부 위층/추적 제외 등) 블리자드/메테오는 시전자 주변 발판에 알아서 떨어진다 -
			-- 오로라 안이라 노쿨이므로 그냥 난사한다(간격 4.6초 = 서버 재시전 잠금 4.5초 + 여유,
			-- 로테이션 픽과 동일 - 3초로 두면 "요청 차단됨" 헛요청이 낀다).
			if not self:TryUtilityCast(now) then
				if (self._T.nextAtk or 0) <= now and bombReady then
					self._T.nextAtk = now + 4.6
					self._T.holdMoveUntil = now + 3.0
					_SkillManager:UseSkillInSlot(bombKey)
					log("[AutoHunt] 오로라 난사 - " .. bombName .. " (무대상)")
				end
			end
			return true
		end
		-- 오로라 밖: 폭격기를 쓰고 난 직후(쿨타임 중)면 오로라로 걸어 돌아가 쿨타임을 갱신한다.
		if bombReady then return false end
		local dxA = _SkillManager:GetRecoveryAuraX() - pp.x
		if math.abs(dxA) <= 0.5 then return false end   -- 사실상 도착 - 진입 판정(±3.0/±2.5)에 맡긴다
		local pccA = player.PlayerControllerComponent
		if isvalid(pccA) and pccA.Enable then pccA.Enable = false end
		local dirA = (dxA > 0) and 1 or -1
		if isvalid(pccA) then pccA.LookDirectionX = dirA end
		player.MovementComponent:MoveToDirection(Vector2(dirA, 0), delta)
		self._T.moving = true
		local scA = player.StateComponent
		if isvalid(scA) and scA.CurrentStateName == "IDLE" then
			scA:ChangeState("MOVE")
		end
		self:CheckStuckAndJump(now, player, pp)
		if (self._T.nextAuraReturnDbg or 0) <= now then
			self._T.nextAuraReturnDbg = now + 2.0
			log("[AutoHunt] 리커버리 오로라 복귀 중 (dx=" .. string.format("%.2f", dxA) .. ")")
		end
		return true
	end

	-- (나이트로드) 헤이스트 점프 보정으로 올라갈 수 있는 높이(월드 유닛). 헤이스트가 꺼져 있으면 0.
	-- 점프 높이는 점프력의 **제곱**에 비례한다(실측) - 보정 배율도 제곱으로 들어간다.
	-- 실제 보정은 서버(PlayerAttack.HasteJumpAssistTick)가 발판을 찾아 걸어주므로, 여기서는
	-- "그 사거리 안이면 올라갈 수 있다"는 판단 기준으로만 쓴다. 여유 0.15는 발판 두께/오차 몫.
	@ExecSpace("ClientOnly")
	method number GetPlainJumpReach(Entity player)
		-- (요청 2026-08-09) **평범한 앞점프**로 올라갈 수 있는 높이(월드 유닛).
		-- 실측 관계식은 높이 = 1.194 × JumpForce² (PlayerAttack.HasteJumpAssistTick 주석의 실측:
		-- JumpForce 1.0 → 1.194유닛 / 1.4 → 2.313유닛). 0.15는 발판 두께/타이밍 오차 몫이다.
		-- ⚠ JumpForce를 **실시간으로 읽는** 이유: 헤이스트 점프 보정이 이 값을 동적으로 바꾼다 -
		--   고정 상수로 두면 보정 중에도 옛 사거리로 판단해 올라갈 수 있는 발판을 포기한다.
		if not isvalid(player) then return 0 end
		local mv = player.MovementComponent
		if not isvalid(mv) then return 0 end
		local jf = mv.JumpForce or 1.0
		if jf <= 0 then return 0 end
		-- 여유 0.05: 정점이 실측 1.194라 0.15를 빼면 1.044가 되어, 실제 맵에 흔한 **+1.03 턱**을
		-- 0.014 차이로 아슬아슬하게만 통과한다(사실상 못 올라감). 정점은 물리적으로 확정값이므로
		-- 발판 두께 몫만 남긴다.
		return 1.194 * jf * jf - 0.05
	end

	@ExecSpace("ClientOnly")
	method boolean CanReachTargetLayer(Entity player, Vector3 pp, Vector3 mp, number reach)
		-- (요청 2026-08-10) **대상이 서 있는 그 발판까지 한 번에 올라설 수 있는가**를 본다. 올라설 수 있으면 true.
		-- ⚠ 기존 HasSeparateFootholdAbove는 "위에 **아무** 발판이라도 있나"만 확인했다. 대상이 두 층 위면
		--   중간 발판이 잡혀 true가 되어 일단 뛰어오르고, 올라가 봐야 대상 층에는 못 닿아 도로 내려온다.
		--   그리고 대상이 그대로 남아 있으니 같은 판단을 2~3번 반복한다(사용자 가설 - 실제 관측과 일치).
		-- 판정 3단계:
		--   ① 대상 발밑 발판 = 대상이 실제로 서 있는 층
		--   ② 그 층이 내 발 높이 기준 점프 사거리 안인가
		--   ③ 위로 쏜 **첫 발판**이 곧 그 층인가(중간 발판이 먼저 걸리면 한 번에 못 올라간다)
		local map = player.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		if not isvalid(fh) then return true end   -- 판정 불가면 막지 않는다(기존 동작 유지)
		-- ① 대상 발밑(살짝 위에서 아래로) - 대상이 딛고 선 발판
		local under = fh:Raycast(Vector2(mp.x, mp.y + 0.1), Vector2(0, -1), 2.0)
		if under == nil then return false end
		local layerY = under.StartPoint.y
		if under.EndPoint.y > layerY then layerY = under.EndPoint.y end
		-- ② 사거리 안인가
		local h = layerY - pp.y
		if h <= 0.05 or h > reach then return false end
		-- ③ 올라가는 길에 더 낮은 발판이 먼저 가로막지 않는가
		local hit = fh:Raycast(Vector2(mp.x, pp.y + 0.3), Vector2(0, 1), h + 0.5)
		if hit == nil then return false end
		if hit.Id ~= under.Id then return false end
		-- 지금 밟고 있는 발판이 잡히면 경사면이다 - 걸어서 올라갈 수 있으니 뛰지 않는다.
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			local cur = rb:GetCurrentFoothold()
			if cur ~= nil and cur.Id == hit.Id then return false end
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean IsTargetLayerUnreachable(Entity player, Vector3 pp, Vector3 mp, number reach)
		-- "이 대상 층은 **확실히** 못 간다"일 때만 true. 대상 제외(ban) 판단 전용이라 보수적으로 본다.
		-- 확실한 두 경우만 true:
		--   ① 대상 발판이 점프 사거리보다 높다
		--   ② 올라가는 길을 **더 낮은 다른 발판**이 먼저 막는다(= 한 번에 못 올라간다)
		-- 경사면(위로 쏜 발판이 지금 밟은 그 발판)·레이 실패·판정 불가는 전부 false로 둔다 -
		-- 걸어서 올라가거나 다른 경로가 있을 수 있으므로 멀쩡한 대상을 버리지 않는다.
		local map = player.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		if not isvalid(fh) then return false end
		local under = fh:Raycast(Vector2(mp.x, mp.y + 0.1), Vector2(0, -1), 2.0)
		if under == nil then return false end
		local layerY = under.StartPoint.y
		if under.EndPoint.y > layerY then layerY = under.EndPoint.y end
		local h = layerY - pp.y
		if h > reach then return true end                    -- ① 너무 높다
		if h <= 0.05 then return false end
		local hit = fh:Raycast(Vector2(mp.x, pp.y + 0.3), Vector2(0, 1), h + 0.5)
		if hit == nil then return false end
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			local cur = rb:GetCurrentFoothold()
			if cur ~= nil and cur.Id == hit.Id then return false end   -- 경사면 - 걸어서 올라간다
		end
		if hit.Id ~= under.Id then return true end            -- ② 중간 발판이 먼저 막는다
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean HasSeparateFootholdAbove(Entity player, number atX, number fromY, number upDist)
		-- atX 지점 위쪽 upDist 안에 **올라설 별개의 발판**이 있는지. 점프해도 올라설 곳이 없으면
		-- 헛뛰기가 되므로, 다운점프의 "발밑 발판 확인"(Raycast 아래)과 짝을 이루는 위쪽 판정이다.
		local map = player.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		if not isvalid(fh) then return true end   -- 판정 불가면 막지 않는다(기존 동작 유지)
		local hit = fh:Raycast(Vector2(atX, fromY + 0.3), Vector2(0, 1), math.max(0.5, upDist + 0.5))
		if hit == nil then return false end
		-- ⚠ 지금 밟고 있는 발판이 그대로 잡히면 **경사면**이다 - 걸어서 올라갈 수 있으니 뛰지 않는다.
		--   이 검사가 없으면 오르막에서 목표가 조금만 높아도 계속 점프해 우스꽝스럽게 튄다.
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			local cur = rb:GetCurrentFoothold()
			if cur ~= nil and cur.Id == hit.Id then return false end
		end
		return true
	end

	-- ── (신고 2026-08-09) 벽/턱 앞점프 등반 ────────────────────────────────
	-- "벽을 보고 계속 걷고 있다"의 해결. 대상과의 상대 위치가 아니라 **내 발밑 지형**만 보고
	-- 판정하므로, 대상이 벽 너머 어디에 있든(위/같은 높이/아래) 턱만 넘을 수 있으면 넘는다.

	@ExecSpace("ClientOnly")
	method number GetStepUpHeightAhead(Entity player, Vector3 pp, number dir)
		-- 진행 방향 바로 앞(0.5유닛)에 **올라설 한 단 위 발판**이 있으면 그 높이(유닛)를, 없으면 0.
		-- 아래로 뚝 떨어지는 절벽이면 위쪽에 아무것도 안 잡혀 0이 나온다 → 헛점프하지 않는다.
		local map = player.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		if not isvalid(fh) then return 0 end
		local curId = -1
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			local cur = rb:GetCurrentFoothold()
			if cur ~= nil then curId = cur.Id end
		end
		-- ⚠ 자기 발판 재검출 함정([[feedback-msw-foothold-raycast]] 1번): 서 있는 자리에서 정확히
		--   위로 쏘면 자기 발판이 거리 0으로 잡힌다. 여기선 원점을 **진행 방향으로 0.5 밀어** 피하고,
		--   그래도 같은 발판이 잡히면(경사면) 걸어서 올라갈 수 있다는 뜻이므로 0을 돌려준다.
		local probeX = pp.x + dir * 0.5
		local hit = fh:Raycast(Vector2(probeX, pp.y + 0.05), Vector2(0, 1), 3.0)
		if hit == nil then return 0 end
		if hit.Id == curId then return 0 end
		local topY = hit.StartPoint.y
		if hit.EndPoint.y > topY then topY = hit.EndPoint.y end
		local h = topY - pp.y
		if h <= 0.05 then return 0 end
		return h
	end

	@ExecSpace("ClientOnly")
	method boolean TryStepUpOverWall(Entity player, Vector3 pp, number dir, number now)
		-- 걷는 방향으로 더 못 가는데(지면 끊김) 그 앞이 **뛰어 올라설 수 있는 턱**이면 앞점프한다.
		-- 넘었으면 true. 인자 순서 주의: nil Entity 함정을 피하려 player를 첫 인자로 둔다.
		if not isvalid(player) then return false end
		if (self._T.nextJump or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		-- PredictFootholdEnd는 "그 거리만큼 갈 수 있으면 true"다([[feedback-msw-predictfootholdend-polarity]]).
		-- false = 지면이 끊겼다 = 벽이거나 절벽.
		if rb:PredictFootholdEnd(0.35, dir > 0) then return false end
		local stepUp = self:GetStepUpHeightAhead(player, pp, dir)
		if stepUp <= 0 then return false end          -- 절벽(위에 아무것도 없음) - 뛰어봐야 소용없다
		local reach = self:GetPlainJumpReach(player)
		if stepUp > reach then return false end       -- 점프로 못 닿는 벽 - 추적 타임아웃이 대상을 바꾼다
		self._T.nextJump = now + 1.0
		self._T.jumpedAt = now
		-- 턱을 넘은 직후 곧바로 도로 내려가지 않게: 하강 1.2초 보류 + 3초간 올라온 층 고정(신고 2026-08-10).
		self._T.noDownJumpUntil = now + 1.2
		self._T.layerHoldUntil = now + 3.0
		player.MovementComponent:Jump()
		local sc = player.StateComponent
		if isvalid(sc) then sc:ChangeState("JUMP") end
		log("[AutoHunt] 벽 앞점프 등반 (턱 높이=" .. string.format("%.2f", stepUp)
			.. " 사거리=" .. string.format("%.2f", reach) .. " dir=" .. tostring(dir) .. ")")
		return true
	end

	-- ── (요청 2026-08-10) 점프 공격 ─────────────────────────────────────────
	-- 지형적으로는 못 올라가는 위층 대상이라도, 점프 정점의 전방 공격 박스(위 1.0)가 닿는
	-- 높이(점프 사거리 + 1.15)면 무시하지 않고 점프 공격으로 잡는다.
	-- 흐름: 수평 정렬(|dx|≤1.1 - 부족하면 이 안에서 걷는다) → 도약 + 공중 시전 창(jumpAtkUntil)
	-- → OnUpdate의 점프 공격 훅이 대상이 박스에 든 순간 TryAttackCast(창 동안만 지상 게이트 예외)
	-- → 착지 후 쿨(1.5초) 두고 반복 - 여러 대 때려야 죽는 적도 도약을 거듭하며 잡는다.
	-- (신고 2026-08-10 2차) "약간 위 + 걸어서는 못 가는 위치의 적에게 점프 공격을 안 한다":
	--   벽/낭떠러지에 막혀 대상 바로 밑(구 |dx|≤0.8)까지 못 가는 경우가 바로 그 상황인데,
	--   정렬 실패로 포기(→제외)하고 있었다 - **가장자리 도약**을 허용한다: 지면이 끊겨 더 못
	--   붙어도 |dx|≤1.35면 그 자리에서 뛴다(전방 박스가 대각선 위를 덮는다 - 서버 실판정 반경 1.5).
	--   못 닿는 과확장은 헛도약 안전망(같은 대상 2회 연속 박스 진입 실패 → 포기 → 제외)이 걸러낸다.

	-- (신고 2026-08-11 "마법사는 공중에서 공격할 수 없는데 계속 점프 공격을 시도") 퀵슬롯에
	-- 마법사 공중 차단 스킬(SkillManager.mageAirBlock과 같은 13종)이 하나라도 있으면 마법사
	-- 사냥 중이다 - 점프 공격은 도약해 봐야 공중 시전 게이트에 막혀 헛점프만 반복하므로 봉인한다.
	@ExecSpace("ClientOnly")
	method boolean HasMageAirBlockedSkill()
		local mageAtk = {
			["매직클로"] = true, ["매직 미사일"] = true,
			["썬더볼트"] = true, ["체인라이트닝"] = true, ["블리자드"] = true,
			["파이어에로우"] = true, ["포이즌 미스트"] = true, ["익스플로젼"] = true, ["메테오"] = true,
			["홀리 에로우"] = true, ["샤이닝 레이"] = true, ["엔젤레이"] = true, ["제네시스"] = true,
		}
		for _, lst in ipairs({ self._T.slotAoes, self._T.slotSingles }) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if mageAtk[s.name] == true then return true end
				end
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean TryJumpAttack(number now, Entity player, number dx, number dy, number reach, number delta)
		-- 점프 공격을 시작/유지했으면 true(이번 틱 소비). 판정 밖이면 false - 호출부가 제외(ban)한다.
		-- 높이 허용 +1.15: 위쪽 판정 박스 1.0 + 몬스터 콜라이더가 중심 아래로 처지는 몫. 못 닿는
		-- 과확장은 아래 헛도약 안전망(2회 연속 박스 진입 실패 → 포기)이 자동으로 걸러낸다.
		-- (신고 2026-08-11) 마법사는 공중 시전이 통째로 막혀 있다 - 점프 공격 자체를 봉인해
		-- 호출부의 제외(ban)/로프·하강 경로가 대신 처리하게 한다.
		if self:HasMageAirBlockedSkill() then return false end
		if dy > reach + 1.15 then return false end
		-- 헛도약 안전망: 같은 대상에게 2번 연속 "공중 시전 게이트에 못 넣은" 도약을 했으면 물리적으로
		-- 못 닿는 기하다 - 더 뛰지 않고 포기해 호출부의 제외(ban)로 넘긴다(무한 도약 루프 방지).
		local tgtJa = self._T.target
		if self._T.jumpAtkFailTgt ~= tgtJa then
			self._T.jumpAtkFailTgt = tgtJa
			self._T.jumpAtkFails = 0
		end
		if (self._T.jumpAtkFails or 0) >= 2 then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return true end   -- 직전 도약 낙하 중 - 대기
		local dir = (dx > 0) and 1 or -1
		local sc = player.StateComponent
		local adx = math.abs(dx)
		local canWalkCloser = rb:PredictFootholdEnd(0.3, dir > 0)
		if adx > 1.1 and canWalkCloser then
			-- 수평 정렬 걷기 - 더 붙을 수 있으면 붙는 게 명중률이 좋다.
			local pccJa = player.PlayerControllerComponent
			if isvalid(pccJa) then
				if pccJa.Enable then pccJa.Enable = false end
				pccJa.LookDirectionX = dir
			end
			player.MovementComponent:MoveToDirection(Vector2(dir, 0), delta)
			self._T.moving = true
			if isvalid(sc) and sc.CurrentStateName == "IDLE" then sc:ChangeState("MOVE") end
			self._T.chaseStart = now   -- 교전 준비 중 - 5초 추적 타임아웃이 끊지 않게 갱신
			return true
		end
		if adx > 1.35 then return false end   -- 지면이 끊겨 못 붙는데 가장자리 도약 범위도 밖
		-- 정렬 완료(또는 가장자리) - 대상 쪽을 보고, 도약 간격이 돌면 뛴다.
		if self._T.moving then self:StopMoving() end
		local pccJb = player.PlayerControllerComponent
		if isvalid(pccJb) and pccJb.LookDirectionX ~= dir then
			pccJb.LookDirectionX = dir
			self._T.dirChangedAt = now
		end
		if (self._T.nextJumpAtk or 0) > now then
			self._T.chaseStart = now
			return true   -- 도약 간격 대기(제자리)
		end
		self._T.nextJumpAtk = now + 1.5
		self._T.nextJump = now + 1.2
		self._T.jumpedAt = now
		self._T.jumpAtkUntil = now + 1.1
		self._T.jumpAtkCastDone = false   -- 이번 도약에서 박스 진입(시전 시도)이 있었는지 - 헛도약 판정용
		self._T.chaseStart = now
		-- 공격 틱 위상(0.5초)이 상승 구간(0.5초)과 어긋나면 도약을 통째로 흘려보낸다 - 창을 여는
		-- 순간 틱을 초기화해 공중 훅이 조준한 첫 순간에 바로 쏠 수 있게 한다.
		self._T.nextAtk = 0
		player.MovementComponent:Jump()
		if isvalid(sc) then sc:ChangeState("JUMP") end
		log("[AutoHunt] 점프 공격 도약 (dy=" .. string.format("%.2f", dy)
			.. " dx=" .. string.format("%.2f", dx)
			.. " 점프 사거리=" .. string.format("%.2f", reach) .. ")")
		return true
	end

	-- ── (요청 2026-08-09) 로프 등반 ────────────────────────────────────────
	-- 앞점프로 닿지 않는 위층(이 맵 기준 +2.23유닛)은 로프가 정식 경로다. 맵의 ClimbableComponent를
	-- 훑어 "논리 로프"(세로로 이어진 세그먼트 묶음) 목록을 만들고, 내 층과 대상 층을 **둘 다** 잇는
	-- 로프가 있으면 그리로 걸어가 올라간다.
	-- ⚠ 실측(2026-08-09): ActionClimb은 PlayerControllerComponent.Enable=false(자동사냥과 같은 조건)
	--   에서도 동작한다 - state가 CLIMB로 바뀌고 y가 오른다.

	@ExecSpace("ClientOnly")
	method table GetRopes(Entity player)
		-- 맵의 로프 목록을 만들어 캐시한다. 세그먼트 3개가 로프 한 줄이라 x가 같고 세로로 이어진 것끼리 묶는다.
		local map = player.CurrentMap
		if not isvalid(map) then return {} end
		if self._T.ropeCache ~= nil and self._T.ropeCacheMap == map then return self._T.ropeCache end

		local comps = map:GetChildComponentsByTypeName("ClimbableComponent", true)
		-- 1) x별로 세그먼트 구간 모으기
		local byX = {}
		for _, c in ipairs(comps or {}) do
			if isvalid(c) and isvalid(c.Entity) then
				local wp = c.Entity.TransformComponent.WorldPosition
				local cx = wp.x + c.BoxOffset.x
				local half = c.BoxSize.y * 0.5
				local key = string.format("%.1f", cx)
				if byX[key] == nil then byX[key] = { x = cx, segs = {} } end
				table.insert(byX[key].segs, {
					bot = wp.y + c.BoxOffset.y - half,
					top = wp.y + c.BoxOffset.y + half,
				})
			end
		end
		-- 2) 같은 x라도 층이 다른 별개 로프일 수 있으므로, 아래에서부터 훑어 **맞닿은 것만** 합친다.
		local out = {}
		for _, group in pairs(byX) do
			table.sort(group.segs, function(a, b) return a.bot < b.bot end)
			local cur = nil
			for _, s in ipairs(group.segs) do
				if cur == nil then
					cur = { x = group.x, bot = s.bot, top = s.top }
				elseif s.bot <= cur.top + 0.4 then
					if s.top > cur.top then cur.top = s.top end
				else
					table.insert(out, cur)
					cur = { x = group.x, bot = s.bot, top = s.top }
				end
			end
			if cur ~= nil then table.insert(out, cur) end
		end
		self._T.ropeCache = out
		self._T.ropeCacheMap = map
		log("[AutoHunt] 로프 인덱스 구성: " .. tostring(#out) .. "줄 (세그먼트 " .. tostring(comps and #comps or 0) .. "개)")
		return out
	end

	@ExecSpace("ClientOnly")
	method table FindUsableRope(Entity player, Vector3 pp, number targetY, number targetX)
		-- 내 발 높이에서 잡을 수 있고(하단이 발 근처 이하) 대상 층까지 닿는(상단이 대상 높이 이상) 로프 중
		-- 수평으로 가장 가까운 것. 없으면 nil.
		-- ⚠ (신고 2026-08-10) 높이만 맞아서는 안 된다 - 같은 높이라도 **끊긴 별개 발판**으로 이어지는
		--   로프면 올라가 봐야 대상에게 갈 수 없다(좌측 로프로 올라간 뒤 같은 높이의 건너편 발판 대상을
		--   향해 걷다가 낭떠러지에서 추락하는 신고의 뿌리). 로프를 올라 내려설 발판이 대상이 딛는 발판과
		--   **체인으로 이어진** 로프만 쓴다.
		local best = nil
		local bestD = 99
		local targetFhId = self:GetFootholdIdBelow(player, targetX, targetY + 0.1, 2.0)
		for _, r in ipairs(self:GetRopes(player)) do
			if r.bot <= pp.y + 0.8 and r.top >= targetY - 0.8 and r.top > pp.y + 0.5 then
				local d = math.abs(r.x - pp.x)
				-- 너무 먼 로프까지 원정을 가면 사냥 효율이 더 나빠진다(걸어가는 동안 리젠이 끝난다).
				if d < bestD and d <= 12.0 then
					-- 올라간 뒤 서게 될 발판(등반이 끝나는 높이 = min(대상 발높이, 로프 상단)의 로프 x 지점).
					-- 발판을 못 찾으면(로프가 발판 가장자리 틈에 걸친 경우 등) 판정 불가로 보고 막지 않는다.
					local landY = targetY
					if r.top < landY then landY = r.top end
					local landFhId = self:GetFootholdIdBelow(player, r.x, landY + 0.5, 2.5)
					if targetFhId <= 0 or landFhId <= 0
						or self:AreFootholdIdsConnected(player, landFhId, targetFhId) then
						best = r
						bestD = d
					end
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method integer GetFootholdIdBelow(Entity player, number x, number y, number dist)
		-- (x, y)에서 아래로 dist만큼 레이캐스트해 처음 걸리는 발판의 Id. 없으면 0.
		-- ⚠ Foothold 객체가 아니라 **Id(정수)**를 돌려준다 - 네이티브 객체를 인자로 넘기면 nil일 때
		--   메서드 본문이 통째로 실행되지 않는 함정([[feedback_msw_nil_entity_param_silent_fail]])을
		--   피하려고 아래 연결 판정은 전부 정수 Id로만 주고받는다.
		local map = player.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		if not isvalid(fh) then return 0 end
		local hit = fh:Raycast(Vector2(x, y), Vector2(0, -1), dist)
		if hit == nil then return 0 end
		return hit.Id
	end

	@ExecSpace("ClientOnly")
	method boolean AreFootholdIdsConnected(Entity player, integer aId, integer bId)
		-- 두 발판이 NextFootholdId/PreviousFootholdId 체인으로 **걸어서** 이어져 있는가.
		-- 같은 높이처럼 보여도 끊긴 별개 발판은 체인이 끊겨 있다([[feedback-msw-foothold-raycast]] 3번:
		-- 겉보기 한 층도 수십 조각 체인이라 단일 조각의 끝점만 봐서는 진짜 가장자리를 모른다 - 그 역이용).
		-- 수직 연결선(턱/절벽 세그먼트)도 체인에 포함되므로 계단 지형은 "이어짐"으로 본다 -
		-- 턱을 실제로 넘는 건 TryStepUpOverWall 몫이고, 여기서는 경로 존재 여부만 가른다.
		-- 판정 불가(Id 0)면 막지 않는다(기존 동작 유지 - 멀쩡한 대상을 버리는 회귀 방지).
		if aId <= 0 or bId <= 0 then return true end
		if aId == bId then return true end
		local map = player.CurrentMap
		local fh = isvalid(map) and map.FootholdComponent or nil
		if not isvalid(fh) then return true end
		-- 맵 발판은 정적이라 결과를 캐시한다 (FindTarget이 0.3초마다 후보별로 물어본다).
		if self._T.fhConnCacheMap ~= map then
			self._T.fhConnCache = {}
			self._T.fhConnCacheMap = map
		end
		local lo = math.min(aId, bId)
		local hi = math.max(aId, bId)
		local key = tostring(lo) .. "|" .. tostring(hi)
		local cached = self._T.fhConnCache[key]
		if cached ~= nil then return cached end
		local start = fh:GetFoothold(aId)
		if start == nil then return true end
		-- 오른쪽(Next) 체인 → 실패 시 왼쪽(Previous) 체인. 한 층이 수십~수백 조각이라 상한은 넉넉히
		-- 400(무한루프 방지용 안전망이지 실제 경로 길이 제한이 아니다).
		local found = false
		for pass = 1, 2 do
			local cur = start
			for i = 1, 400 do
				local nid = cur.NextFootholdId
				if pass == 2 then nid = cur.PreviousFootholdId end
				if nid == nil or nid <= 0 or nid == aId then break end
				local nxt = fh:GetFoothold(nid)
				if nxt == nil then break end
				if nxt.Id == bId then
					found = true
					break
				end
				cur = nxt
			end
			if found then break end
		end
		self._T.fhConnCache[key] = found
		return found
	end

	@ExecSpace("ClientOnly")
	method boolean IsWalkConnectedToPoint(Entity player, integer myFhId, number x, number y)
		-- 내가 밟은 발판(myFhId)에서 (x, y) 지점이 딛고 선 발판까지 걸어서 갈 수 있는가.
		-- 후보 몬스터별로 불리므로 발판 Id만 주고받는다(연결 판정 자체는 쌍 단위 캐시).
		return self:AreFootholdIdsConnected(player, myFhId, self:GetFootholdIdBelow(player, x, y + 0.1, 2.0))
	end

	@ExecSpace("ClientOnly")
	method boolean IsWalkConnectedToTarget(Entity player, Vector3 pp, Vector3 mp)
		-- 지금 밟은 발판에서 대상이 딛는 발판까지 걸어서(체인으로) 갈 수 있는가.
		local aId = 0
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			local cur = rb:GetCurrentFoothold()
			if cur ~= nil then aId = cur.Id end
		end
		if aId <= 0 then aId = self:GetFootholdIdBelow(player, pp.x, pp.y + 0.1, 1.5) end
		local bId = self:GetFootholdIdBelow(player, mp.x, mp.y + 0.1, 2.0)
		return self:AreFootholdIdsConnected(player, aId, bId)
	end

	@ExecSpace("ClientOnly")
	method void ClearRopeState(Entity player, string reason, boolean stopMove)
		-- 등반 상태 정리 본체. 실패든 성공이든 반드시 이 한 곳을 지나게 해서 상태가 남지 않게 한다.
		-- ⚠ stopMove=false는 **점프 도중에 계획만 취소할 때** 쓴다 - 아래 StopMoving 주석 참고.
		if (self._T.ropeState or "") == "" then return end
		self._T.ropeState = ""
		self._T.ropeX = nil
		self._T.ropeGoalY = nil
		self._T.ropeUntil = nil
		self._T.ropeJumpUntil = nil
		self._T.ropeClimbFrom = nil
		-- (요청 2026-08-09) 등반 무적 해제. 켠 적이 있을 때만 끄도록 서버 쪽에서 한 번 더 거른다.
		if self._T.ropeInvincible == true then
			self._T.ropeInvincible = false
			_SkillManager:RequestSetClimbInvincible(false)
		end
		-- ⚠ (신고 2026-08-10 "언덕에 올라갈 때마다 이상하게 한 번 움직인다") StopMoving은
		--   `MovementComponent:Stop()` + **PlayerController 재활성**을 한다. 이걸 `Jump()` 직후에
		--   부르면 ① 점프의 수평 속도가 그 자리에서 끊기고 ② 컨트롤러가 살아나 입력 0의 감속이
		--   덮어써서, 턱을 넘다 말고 제자리에서 툭 떨어지는 부자연스러운 한 동작이 나온다.
		--   턱 등반으로 층이 바뀌어 계획만 무를 때는 이동을 건드리면 안 된다(stopMove=false).
		if stopMove then self:StopMoving() end
		log("[AutoHunt] 로프 등반 종료 - " .. tostring(reason))
	end

	@ExecSpace("ClientOnly")
	method void EndRopeClimb(Entity player, string reason)
		-- 기존 호출부 전부가 쓰는 기본형 - 정지까지 함께 한다.
		self:ClearRopeState(player, reason, true)
	end

	@ExecSpace("ClientOnly")
	method boolean RopeClimbTick(number now, Entity player, Vector3 pp, number dy, number delta)
		-- 로프 등반 상태 기계. 이번 틱의 이동을 이 함수가 가져갔으면 true를 돌려준다(호출부는 즉시 return).
		--   approach : 로프 x로 걸어가 정렬
		--   climb    : ActionClimb으로 올라가기
		-- ⚠ 대상은 인자로 받지 않고 self._T.target을 읽는다 - 대상이 죽거나 사라진 뒤에도 climb을
		--   완주시켜야 하는데, Entity 파라미터에 nil이 넘어가면 본문이 통째로 실행되지 않는 엔진 함정
		--   (feedback_msw_nil_entity_param_silent_fail) 때문에 nil을 인자로 못 넘긴다(MageAuraComboTick과 같은 사유).
		local st = self._T.ropeState or ""
		local target = self._T.target
		local targetGone = (target == nil or not isvalid(target))
		if not targetGone then
			local mcRope = target:GetComponent("script.Monster")
			targetGone = (mcRope ~= nil and mcRope.IsDead == true)
		end

		if st ~= "" then
			-- 대상 소실/사망: approach(아직 로프까지 걷는 중)면 즉시 접고 재탐색한다.
			-- (요청 2026-08-11) climb(매달려 오르는 중)이면 접지 않고 **끝까지 올라간 뒤** 재탐색한다 -
			-- 종전의 "대상 사망 - 재탐색" 즉시 취소(2026-08-11 오전)는 매달림 중 놓고 떨어지는 동작이
			-- 어색하다는 피드백으로 뒤집었다. 타임아웃 안전망은 climb에도 그대로 살아 있다.
			if targetGone and st ~= "climb" then
				self._T.target = nil
				self._T.nextScan = 0
				self:EndRopeClimb(player, "대상 사망/소실 - 재탐색")
				return false
			end
			if (self._T.ropeUntil or 0) < now then
				-- 이 대상은 로프로도 못 잡는다고 보고 잠시 제외한다(무한 재시도 방지).
				if target ~= nil and isvalid(target) then
					if self._T.banned == nil then self._T.banned = {} end
					self._T.banned[target] = now + 6.0
				end
				self._T.target = nil
				self._T.nextScan = 0
				self:EndRopeClimb(player, "시간 초과 - 대상 제외")
				return false
			end
		end

		if st == "approach" then
			local ddx = (self._T.ropeX or pp.x) - pp.x
			if math.abs(ddx) > 0.12 then
				-- ⚠ 실측: 매 틱 같은 속도로 밀면 목표를 지나쳐 좌우로 진동한다. 가까워지면 델타를 줄여
				--   감속 정렬한다(로프 판정 폭이 0.5라 x가 어긋나면 아예 안 잡힌다).
				local step = delta
				if math.abs(ddx) < 0.5 then step = delta * 0.35 end
				local pccA = player.PlayerControllerComponent
				if isvalid(pccA) then
					if pccA.Enable then pccA.Enable = false end
					pccA.LookDirectionX = (ddx > 0) and 1 or -1
				end
				local aDir = (ddx > 0) and 1 or -1
				player.MovementComponent:MoveToDirection(Vector2(aDir, 0), step)
				self._T.moving = true
				local scA = player.StateComponent
				if isvalid(scA) and scA.CurrentStateName == "IDLE" then scA:ChangeState("MOVE") end
				-- (신고 2026-08-09 2차) 로프까지 걸어가는 길목에 턱이 있으면 여기서도 벽을 보고 걷기만 했다 -
				-- 실측: x=2.76 y=-6.65(0.60 턱)에서 look=1인 채 10초 정체 후에야 추적 분기가 넘겨줬다.
				-- 추적 걷기와 **같은 판정**으로 턱을 넘는다(못 넘는 벽이면 로프 타임아웃이 대상을 바꾼다).
				if self:TryStepUpOverWall(player, pp, aDir, now) then
					-- ⚠ (신고 2026-08-09 3차 "올라간 뒤 10~15초 가만히 있는다") 턱을 넘으면 **내 층이 바뀐다.**
					--   아까 고른 로프는 옛 층 기준이라 새 층을 잇지 않을 수 있는데, 그대로 두면 딴 층 로프의
					--   x에 "정렬 완료" 하고 부착이 영영 실패해 ropeUntil이 끝날 때까지 얼어붙었다
					--   (실측: y=-6.05에서 로프 구간 -3.85~-3.12에 정렬 → state=IDLE·ctrl=false로 9.5초 정지).
					--   계획을 접고 다음 틱에 **새 층 기준으로 다시 고른다.**
					-- ⚠ 정지시키지 않는다(stopMove=false) - 방금 Jump()를 부른 직후라 여기서 StopMoving을
					--   하면 점프 수평 속도가 끊기고 컨트롤러가 되살아나 "이상하게 한 번 움직이는" 동작이 된다.
					self:ClearRopeState(player, "턱 등반으로 층 변경 - 로프 재선정", false)
					return true
				end
				return true
			end
			-- 정렬 완료 → **점프해서 로프를 잡는다.**
			-- (요청 2026-08-09) 그냥 부착하면 제자리에서 스르륵 붙어 순간이동처럼 보인다는 신고 -
			-- 먼저 뛰어오르고, 공중에서 로프 판정에 들어가는 순간 붙게 해 자연스러운 연결을 만든다.
			-- ropeJumpUntil 동안은 ActionClimb을 부르지 않아 점프 궤적이 그대로 보인다.
			-- ⚠ 컨트롤러가 꺼져 있으면 ChangeState가 먹지 않아 점프 모션이 안 나온다(다운점프와 같은 원인).
			--   StopMoving이 컨트롤러를 켜주므로 그 뒤에 점프시켜야 모션이 보인다 - 부착 시점에 다시 끈다.
			self:StopMoving()
			player.MovementComponent:Jump()
			local scJ = player.StateComponent
			if isvalid(scJ) then scJ:ChangeState("JUMP") end
			self._T.jumpedAt = now
			self._T.ropeJumpUntil = now + 0.22
			self._T.ropeState = "climb"
			self._T.ropeClimbFrom = now   -- 부착 실패 조기 종료 판정 기준(아래 climb 분기)
			-- 등반 무적 ON - 여기서 켜야 점프~부착 구간의 피격으로 떨어지는 것도 막힌다.
			if self._T.ropeInvincible ~= true then
				self._T.ropeInvincible = true
				_SkillManager:RequestSetClimbInvincible(true)
			end
			log("[AutoHunt] 로프 정렬 완료 - 점프하며 등반 시작 (x=" .. string.format("%.2f", self._T.ropeX or 0)
				.. " 목표높이=" .. string.format("%.2f", self._T.ropeGoalY or 0) .. ")")
			return true
		end

		if st == "climb" then
			-- 목표 높이에 도달했고 발판을 밟았으면 성공 종료 - 이후엔 평소 추적 로직이 이어받는다.
			local rbC = player.RigidbodyComponent
			if pp.y >= (self._T.ropeGoalY or 0) - 0.4 and isvalid(rbC) and rbC:IsOnGround() then
				-- (요청 2026-08-10) **사다리로 올라온 직후 바로 떨어지지 않게** 한다 - 앞점프 등반과 같은 처리.
				--   로프 도착 지점은 대개 발판 가장자리라, 그대로 아래층 대상을 향해 걸으면 한두 걸음 만에
				--   떨어져 "올라오자마자 도로 내려가는" 동작이 된다.
				--   ① 하강(다운점프) 1.2초 보류 ② 3초간 올라온 층 고정(FindTarget이 그 층 적만 본다)
				--   ③ 층 고정 동안에는 발판 끝 방향으로 걸어 나가지도 않는다(아래 추적 걷기의 게이트).
				self._T.noDownJumpUntil = now + 1.2
				self._T.layerHoldUntil = now + 3.0
				self:EndRopeClimb(player, "도착 (y=" .. string.format("%.2f", pp.y) .. ")")
				-- (요청 2026-08-11) 대상 없이 완주한 등반(사망/소실)이면 도착 즉시 재탐색을 연다.
				if targetGone then
					self._T.target = nil
					self._T.nextScan = 0
				end
				return false
			end
			local pccC = player.PlayerControllerComponent
			local mvC = player.MovementComponent
			local scC = player.StateComponent
			local onRope = isvalid(scC) and (scC.CurrentStateName == "CLIMB" or scC.CurrentStateName == "LADDER")
			-- 점프 궤적이 보이도록 부착을 잠깐 미룬다(정렬 직후 뛰어오른 0.22초 구간).
			if (self._T.ropeJumpUntil or 0) > now and not onRope then
				self._T.moving = false
				return true
			end
			-- ⚠ (신고 2026-08-09 "올라간 뒤 10~15초 가만히 있는다") **부착 실패 조기 종료.**
			--   그 자리에 로프가 없으면 ActionClimb은 아무 일도 하지 않는데, 이 분기는 컨트롤러를 끄고
			--   moving=false로 두기만 해서 캐릭터가 **완전히 멈춘 채** ropeUntil이 끝나기를 기다렸다.
			--   그 타임아웃은 `6.0 + 거리×1.2 + dy×1.5`라 실제로 10~15초다(실측 사례: dy=1.80·거리 3.4 → 12.8초,
			--   화면상 9.5초 정지 후 "대상 변경"으로 겨우 풀렸다. state=IDLE / ctrl=false / y 변화 0).
			--   점프 구간이 끝나고 1.2초 안에 CLIMB에 못 들어갔으면 실패로 보고 즉시 접어 평소 추적으로 넘긴다.
			if not onRope and isvalid(rbC) and rbC:IsOnGround()
				and (self._T.ropeClimbFrom or now) + 1.2 < now then
				self._T.ropeRetryUntil = now + 2.0   -- 같은 로프로 즉시 재시도해 튀는 것 방지
				self:EndRopeClimb(player, "부착 실패 - 즉시 종료(타임아웃 대기 안 함)")
				return false
			end
			if isvalid(pccC) and isvalid(mvC) then
				if pccC.Enable then pccC.Enable = false end
				if not onRope then
					-- 아직 안 잡았으면 ActionClimb으로 **부착**한다.
					-- ⚠ (실측 2026-08-09) moveOffset은 방향이 아니라 **이동량**처럼 동작한다 -
					--   Vector2(0,1)로 부르면 붙는 순간 1유닛 이상 위로 튀어(로그: JUMP y=1.26 → CLIMB y=2.95)
					--   "순간이동"처럼 보인다. 부착만 시키고 상승은 아래 MoveToDirection이 맡도록 작게 준다.
					pccC:ActionClimb(Vector2(0, 0.05), mvC:GetClimbableHeight())
				else
					-- ⚠ (실측 2026-08-09) ActionClimb을 계속 부르면 약 1유닛만 오르고 그 자리에서 멈춘다.
					--   부착 뒤의 실제 상승은 MoveToDirection이 담당한다 - MovementComponent.d.mlua의
					--   "deltaTime only applies when on the ladder"가 이 경로를 가리킨다.
					-- (신고 2026-08-09) 그대로 delta를 넘기면 **2.0유닛/초**로 달리기와 비슷해 "비정상적으로
					--   빠르다"는 신고가 났다. 델타를 줄여 원작 로프 체감(약 0.9유닛/초)에 맞춘다.
					mvC:MoveToDirection(Vector2(0, 1), delta * self.RopeClimbSpeedFactor)
				end
			end
			self._T.moving = false
			return true
		end

		-- ── 여기부터는 "새로 시작할지" 판단 ──
		-- 대상이 없거나 죽었으면 새 등반을 시작할 이유가 없다(target 인자를 없앤 뒤의 가드).
		if targetGone then return false end
		-- 앞점프로 닿는 높이면 로프를 쓸 이유가 없다(점프가 훨씬 빠르다).
		if dy < 1.1 then return false end
		if self:GetPlainJumpReach(player) >= dy then return false end
		-- 이동기가 있는 직업은 기존 경로(섬광/플래시 점프/텔레포트 등)를 그대로 쓴다.
		if self:GetFlashJumpReach() >= dy or self:GetDoubleJumpReach() >= dy or self:GetHasteJumpReach() >= dy then
			return false
		end
		if (self._T.ropeRetryUntil or 0) > now then return false end

		local mp = target.TransformComponent.WorldPosition
		local rope = self:FindUsableRope(player, pp, mp.y, mp.x)
		if rope == nil then
			-- 쓸 수 있는 로프가 없으면 잠시 재탐색을 쉰다(매 틱 전체 로프를 훑지 않도록).
			self._T.ropeRetryUntil = now + 1.0
			return false
		end
		self._T.ropeState = "approach"
		self._T.ropeX = rope.x
		-- 목표 높이는 대상의 발 높이. 로프 상단보다 위면 로프 상단까지만 올라간다.
		self._T.ropeGoalY = math.min(mp.y, rope.top)
		-- 타임아웃: 수평 거리 비례 + 등반 시간 여유(로프는 느리다).
		self._T.ropeUntil = now + 6.0 + math.abs(rope.x - pp.x) * 1.2 + dy * 1.5
		log("[AutoHunt] 로프 등반 시작 - 로프 x=" .. string.format("%.2f", rope.x)
			.. " 구간 " .. string.format("%.2f", rope.bot) .. "~" .. string.format("%.2f", rope.top)
			.. " / 대상 dy=" .. string.format("%.2f", dy))
		return true
	end

	@ExecSpace("ClientOnly")
	method number GetHasteJumpReach()
		if _HasteBuffUI:GetRemaining() <= 0 then return 0 end
		local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("헤이스트"))
		local mult = _SkillManager:GetHasteJumpRangeMult(lv)
		return 1.194 * mult * mult - 0.15
	end

	-- ── (나이트로드·섀도어) 플래시 점프 = 자동사냥 이동기 ────────────────
	-- 이 두 직업은 러시(대시)도 섬광도 드래곤 라이딩도 없어서, 그동안 "먼 대상까지 걸어가기"와
	-- "위 발판 대상 포기"밖에 없었다. 플래시 점프를 배웠으면 필요한 순간에만 꺼내 쓴다.

	@ExecSpace("ClientOnly")
	method integer GetFlashJumpLevel()
		-- 투자 레벨(0이면 미보유 - 아래 판단들이 전부 꺼진다).
		return _SkillManager:GetHeroSkillLevelByName("플래시 점프")
	end

	-- 점프 + 플래시 점프로 올라갈 수 있는 총 높이(월드 유닛). 안 배웠으면 0.
	-- 점프 정점(기본 1.194유닛 - 헤이스트 보정 중이면 그 높이)에서 쏘면 SetForce가 그 시점 속도를
	-- **덮어쓰기** 때문에 거기서 다시 (4.04×배율)²/2g 만큼 더 오른다. 더블 점프 실측(세로 힘 4.04 =
	-- 상승 0.4유닛)에서 유도하면 추가분은 0.4 × 배율². 여유 0.2는 발판 두께/타이밍 오차 몫이다.
	@ExecSpace("ClientOnly")
	method number GetFlashJumpReach()
		local lv = self:GetFlashJumpLevel()
		if lv <= 0 then return 0 end
		local base = 1.194
		local hasteReach = self:GetHasteJumpReach()
		if hasteReach + 0.15 > base then base = hasteReach + 0.15 end
		local scale = _SkillManager:GetFlashJumpForceScale(lv)
		return base + 0.4 * scale * scale - 0.2
	end

	-- 점프 → 정점에서 플래시 점프. 발동했으면 true.
	-- ⚠ 정점(0.34초 뒤)에 맞춰 쏘는 것이 핵심이다 - 플래시 점프의 SetForce는 남은 상승 속도를
	--   덮어쓰므로, 상승 중에 쏘면 그만큼 손해다(점프 속도 6.98 / 중력 20.4 → 정점까지 0.34초).
	--   그 사이에는 holdMoveUntil로 걷기/재선정을 멈춰 방향이 흔들리지 않게 한다.
	@ExecSpace("ClientOnly")
	method boolean TryFlashJumpMove(number now, Entity player, number dirX, string reason)
		if self:GetFlashJumpLevel() <= 0 then return false end
		-- 스킬 자체엔 쿨타임이 없지만(체공 1회 제한뿐) 자동사냥이 매 프레임 남발하지 않도록 간격을 둔다.
		if (self._T.nextFlashJump or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		self._T.nextFlashJump = now + 1.5
		self._T.jumpedAt = now
		self._T.holdMoveUntil = now + 0.34
		local pcc = player.PlayerControllerComponent
		if isvalid(pcc) then pcc.LookDirectionX = dirX end
		player.MovementComponent:Jump()
		local sc = player.StateComponent
		if isvalid(sc) then sc:ChangeState("JUMP") end
		-- 예약 취소용 세대 번호 - 그 사이 자동사냥이 꺼지거나 다시 도약하면 옛 예약은 무시한다.
		self._T.fjGen = (self._T.fjGen or 0) + 1
		local gen = self._T.fjGen
		_TimerService:SetTimerOnce(function()
			if self._T.fjGen ~= gen then return end
			if self.autoOn ~= true then return end
			local p = _UserService.LocalPlayer
			if not isvalid(p) then return end
			-- 시전 직전에 방향을 다시 못박는다(플래시 점프는 LookDirectionX로 도약 방향을 정한다).
			local pcc2 = p.PlayerControllerComponent
			if isvalid(pcc2) then pcc2.LookDirectionX = dirX end
			_SkillManager:TryFlashJump()
		end, 0.34)
		log("[AutoHunt] 플래시 점프 - " .. reason)
		return true
	end

	-- ── (신궁) 더블 점프 = 자동사냥 이동기 ────────────────────────────────
	-- 플래시 점프와 **완전히 같은 구조**다(지상에서 점프 → 정점에서 한 번 더 도약). 다른 점은
	-- 두 가지뿐 - 재사용 대기시간 5초가 있고, 도약 힘이 레벨과 무관하게 고정(가로 4.5 / 세로 4.04)이다.

	@ExecSpace("ClientOnly")
	method integer GetDoubleJumpLevel()
		-- 투자 레벨(0이면 미보유 - 아래 판단들이 전부 꺼진다).
		return _SkillManager:GetHeroSkillLevelByName("더블 점프")
	end

	-- 점프 + 더블 점프로 올라갈 수 있는 총 높이(월드 유닛). 안 배웠으면 0.
	-- 세로 힘 4.04 = 상승 약 0.4유닛(RunDoubleJumpMove 실측 주석).
	-- (요청 2026-08-10 "더블 점프를 유용하게") 여유를 0.2 → 0.05로 줄여 위 발판 추적 창(dy 1.2~reach)을
	-- 넓힌다 - 기존 창(1.2~1.39)이 0.19유닛뿐이라 위층 등반에 거의 발동하지 못했다. 헛도약해도
	-- 착지 후 걷기/로프 경로가 이어받고, 헛도약 2회면 TryJumpAttack 계열이 스스로 포기하므로 안전하다.
	@ExecSpace("ClientOnly")
	method number GetDoubleJumpReach()
		if self:GetDoubleJumpLevel() <= 0 then return 0 end
		local base = 1.194
		local hasteReach = self:GetHasteJumpReach()
		if hasteReach + 0.15 > base then base = hasteReach + 0.15 end
		return base + 0.4 - 0.05
	end

	-- 점프 → 정점에서 더블 점프. 발동했으면 true (플래시 점프와 동일한 0.34초 정점 타이밍).
	@ExecSpace("ClientOnly")
	method boolean TryDoubleJumpMove(number now, Entity player, number dirX, string reason)
		if self:GetDoubleJumpLevel() <= 0 then return false end
		-- 스킬 자체 쿨 5초 + 여유. 매 프레임 남발하지 않도록 간격을 둔다.
		if (self._T.nextDoubleJump or 0) > now then return false end
		-- (요청 2026-08-13) 더블 점프가 MP 10을 쓰게 됐다 - 못 내면 시작조차 하지 않는다.
		-- ⚠ 이 검사가 없으면 아래에서 평범한 점프(Jump)만 하고 0.34초 뒤 도약이 조용히 거부돼
		--   제자리에서 뛰기만 하는 이동 실패가 반복된다.
		if not _SkillManager:CanAffordSkillCost("더블 점프") then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		self._T.nextDoubleJump = now + 5.5
		self._T.jumpedAt = now
		self._T.holdMoveUntil = now + 0.34
		local pcc = player.PlayerControllerComponent
		if isvalid(pcc) then pcc.LookDirectionX = dirX end
		player.MovementComponent:Jump()
		local sc = player.StateComponent
		if isvalid(sc) then sc:ChangeState("JUMP") end
		-- 예약 취소용 세대 번호 - 그 사이 자동사냥이 꺼지거나 다시 도약하면 옛 예약은 무시한다.
		self._T.djGen = (self._T.djGen or 0) + 1
		local gen = self._T.djGen
		_TimerService:SetTimerOnce(function()
			if self._T.djGen ~= gen then return end
			if self.autoOn ~= true then return end
			local p = _UserService.LocalPlayer
			if not isvalid(p) then return end
			-- 시전 직전에 방향을 다시 못박는다(더블 점프는 LookDirectionX로 도약 방향을 정한다).
			local pcc2 = p.PlayerControllerComponent
			if isvalid(pcc2) then pcc2.LookDirectionX = dirX end
			_SkillManager:TryDoubleJump()
		end, 0.34)
		log("[AutoHunt] 더블 점프 - " .. reason)
		return true
	end

	-- ── (신궁) 체인샷 = 자동사냥 이동기 ───────────────────────────────────
	-- 8방향으로 체인을 쏴 지형에 박고, 0.4초 뒤 같은 키를 한 번 더 눌러 그 각도로 당겨져 날아간다.
	-- 섬광과 같은 자리(위아래로 떨어진 대상 추적 / 같은 층 먼 대상 가속)에서 쓴다.
	-- ⚠ 두 번째 입력이 "당기기"가 되려면 첫 발사에서 체인이 실제로 박혀야 한다 - 허공이면 당기기가
	--   무시되고 그냥 새 체인이 나가므로, 실패해도 안전하다(자체 쿨 2초가 남발을 막는다).

	@ExecSpace("ClientOnly")
	method boolean TryChainShotMove(number now, Entity player, number dirX, number dirY, string reason)
		if self._T.slotChainShots == nil or #self._T.slotChainShots == 0 then return false end
		if (self._T.nextChainShot or 0) > now then return false end
		-- (요청 2026-08-13) 체인샷이 MP 10을 쓰게 됐다 - 못 내면 이동 잠금(1.2초)을 걸기 전에 물러난다.
		if not _SkillManager:CanAffordSkillCost("체인샷") then return false end
		-- (요청 2026-08-13) 체인샷 쿨타임은 **당겨져 날아간 시점부터** 5초다 - 자동사냥은 발사 0.4초 뒤에
		-- 당기므로 실제로 다시 쓸 수 있는 건 발사 +5.4초다. 6.0초 간격이면 그 뒤에 오므로 그대로 둔다.
		self._T.nextChainShot = now + 6.0
		local key = self._T.slotChainShots[1].key
		-- 조준은 8방향이라 자동사냥 조준값(GetAimDirX/Y)을 그대로 쓴다 - 체인샷 시전 분기가
		-- 방향키 입력이 없을 때 이 값을 읽는다.
		self._T.aimDirX = dirX
		self._T.aimDirY = dirY
		self._T.holdMoveUntil = now + 1.2
		local pccC = player.PlayerControllerComponent
		if isvalid(pccC) then pccC.LookDirectionX = dirX end
		_SkillManager:UseSkillInSlot(key)   -- ① 체인 발사
		-- ② 0.4초 뒤 같은 키를 한 번 더 - 박혔으면 그 각도로 당겨져 날아간다.
		self._T.csGen = (self._T.csGen or 0) + 1
		local csGenNow = self._T.csGen
		_TimerService:SetTimerOnce(function()
			if self._T.csGen ~= csGenNow then return end
			if self.autoOn ~= true then return end
			_SkillManager:UseSkillInSlot(key)
		end, 0.4)
		log("[AutoHunt] 체인샷 이동 - " .. reason)
		return true
	end

	-- ── (히어로 3차, 요청 2026-08-09) 코마 = 구슬을 모아서 넓게 쓰는 다수기 ──
	-- 요청 요지
	--   · 패닉은 "보스나 잘 안 죽는 몬스터"가 아니면 쓸 일이 거의 없다.
	--   · 코마는 다수기다. 바로 옆 한두 마리는 근접 공격으로 잡으면 되지만, **위/아래 포함 주변에 적이
	--     많고 범위가 닿으면** 써주는 게 좋다. 사용 빈도를 늘려야 한다.
	--   · 몬스터가 약해 콤보 어택의 이득(+20%/구슬)을 다른 스킬로 별로 못 보면 **더 자주** 쓴다.
	--   · **구슬이 많을수록 범위가 넓어지므로 모아서 쓴다.**
	-- 서버 실판정(PlayerAttack.NotifyComaMotionEnded)과 **같은 식**을 클라에서 재현해 판단한다:
	--   halfW = 3.0 + (15.0-3.0) × (orb-1)/9,  halfH = halfW × 0.5,  전방위 박스, 가까운 순 최대 15명.
	--   → 구슬 1개면 ±3.0/±1.5(옆칸만), 5개면 ±8.3/±4.2(위아래 층까지), 10개면 ±15/±7.5.

	@ExecSpace("ClientOnly")
	method integer GetComboOrbCount(Entity player)
		-- 현재 쌓인 콤보 구슬 수. ComboOrbCount는 @Sync라 클라에서 그대로 읽힌다.
		if not isvalid(player) then return 0 end
		---@type PlayerAttack
		local pa = player:GetComponent(PlayerAttack)
		if not isvalid(pa) then return 0 end
		return math.max(0, pa.ComboOrbCount or 0)
	end

	@ExecSpace("ClientOnly")
	method integer GetComboOrbCapClient()
		-- 구슬 상한. 서버 GetComboOrbCap과 같은 식이지만 **투자 레벨을 클라의 SkillManager에서** 읽는다
		-- (서버 쪽 _T.comboSkillLv는 클라에 없어서 그대로 호출하면 항상 1이 나온다).
		local comboLv = _SkillManager:GetHeroSkillLevelByName("콤보 어택")
		local advLv = _SkillManager:GetHeroSkillLevelByName("어드밴스드 콤보")
		local cap = math.min(5, 1 + math.floor(math.max(1, comboLv) / 5))
		if advLv >= 1 then
			cap = cap + math.min(5, 1 + math.floor(advLv / 5))
		end
		return math.max(1, cap)
	end

	@ExecSpace("ClientOnly")
	method number GetComaHalfWidth(integer orbCount)
		-- 구슬 수 → 코마 판정 반폭(서버와 동일 식). 세로는 이 값의 절반.
		local orb = math.max(1, math.min(orbCount, 10))
		return 3.0 + (15.0 - 3.0) * (orb - 1) / 9
	end

	@ExecSpace("ClientOnly")
	method integer CountMonstersAlongRay(Entity player, Vector3 pp, number dirX, number dirY, number reach, number halfWidth, integer maxCount)
		-- (요청 2026-08-13) 조준 직선 위의 살아있는 몬스터 수 - 관통 화살(아이언 에로우)이 실제로 맞힐
		-- 마릿수를 근사한다. 서버 FindChainShotTargets와 같은 사영 방식이다: 진행 방향으로 reach까지,
		-- 선에서 halfWidth 안에 들어온 적만 세고 관통 상한(maxCount)에서 자른다.
		-- ⚠ 박스 카운트(CountMonstersInBox)로는 이 모양을 못 나타낸다 - 아이언 에로우는 8방향 대각선
		--   직선이라 "옆으로 넓은 박스"와 맞는 대상 집합이 다르다.
		local comps = self:GetMonsterComps(player)
		if comps == nil then return 0 end
		local len = math.sqrt(dirX * dirX + dirY * dirY)
		if len < 0.001 then return 0 end
		local nx = dirX / len
		local ny = dirY / len
		local n = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local wp = e.TransformComponent.WorldPosition
					local rx = wp.x - pp.x
					local ry = wp.y - pp.y
					local proj = rx * nx + ry * ny
					if proj >= 0 and proj <= reach then
						local perpX = rx - nx * proj
						local perpY = ry - ny * proj
						if math.sqrt(perpX * perpX + perpY * perpY) <= halfWidth then
							n = n + 1
						end
					end
				end
			end
		end
		return math.min(n, maxCount)
	end

	@ExecSpace("ClientOnly")
	method number GetArcherSkillScore(string skillName, Entity player, Vector3 pp, number lookDir)
		-- (요청 2026-08-13) 활 주력기의 **초당 기대 데미지**(상대 비교 전용 점수, 절대값에 의미 없음).
		--   점수 = 기대배율(%) × 타수 × 실제로 맞는 마릿수 ÷ 시전주기(초)
		--     · 스트레이프    : 발당 배율 × 4발 × **1명 고정**(단일 대상기)          ÷ 0.9
		--     · 아이스/파이어 샷 : 대상당 배율 × 박스(±4.95,±1.65) 안 최대 10명       ÷ 1.0
		--     · 아이언 에로우 : 대상당 배율 × 조준 직선 위 최대 6명(사거리 9유닛)     ÷ 0.75
		--   기준값은 전부 서버 실판정과 같은 숫자다(아이스 샷 4.95/1.65 = PlayerAttack의 대상 선정 박스,
		--   아이언 에로우 9유닛 = IronArrowProjectile의 Speed 6 × MaxLifetime 1.5, 관통 6 = MaxHitCount,
		--   스트레이프 5.0유닛 = PlayerAttack의 ArrowAimXReach/3×2.5).
		-- ⚠ 공용 위력 배율(0.6~1.0)·공격속도 배율은 네 스킬에 똑같이 걸리므로 **비율에서 상쇄된다** -
		--   넣지 않는다(넣어도 순위가 바뀌지 않고 계산만 늘어난다).
		-- ⚠ 맞는 적이 하나도 없으면 0을 돌려준다 - 허공 시전에 MP를 쓰지 않게 하기 위함이다.
		if skillName == "스트레이프" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("스트레이프"))
			local rate = (_SkillManager:GetStrafeMinPercent(lv) + _SkillManager:GetStrafeMaxPercent(lv)) / 2
			-- 단일 고정기라 마릿수는 항상 1 - 대신 사거리 안에 적이 하나도 없으면 값이 없다.
			if self:CountMonstersInFront(player, pp, lookDir, 5.0) < 1 then return 0 end
			return rate * 4.0 / 0.9
		elseif skillName == "아이스 샷" or skillName == "파이어 샷" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName(skillName))
			local rate = 0
			if skillName == "아이스 샷" then
				rate = (_SkillManager:GetIceShotMinPercent(lv) + _SkillManager:GetIceShotMaxPercent(lv)) / 2
			else
				rate = (_SkillManager:GetFireShotMinPercent(lv) + _SkillManager:GetFireShotMaxPercent(lv)) / 2
			end
			local n = self:CountMonstersInBox(player, pp, 4.95, 1.65)
			if n < 1 then return 0 end
			return rate * math.min(n, 10) / 1.0
		elseif skillName == "아이언 에로우" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("아이언 에로우"))
			local rate = (_SkillManager:GetIronArrowMinPercent(lv) + _SkillManager:GetIronArrowMaxPercent(lv)) / 2
			-- 조준은 시전 분기가 읽어가는 것과 **같은 8방향 값**을 쓴다(GetAimDirX/Y) - 여기서 다른
			-- 방향으로 세면 "직선에 6마리"라고 판단하고 엉뚱한 쪽으로 쏘게 된다.
			local aimX = self:GetAimDirX()
			local aimY = self:GetAimDirY()
			if aimX == 0 and aimY == 0 then aimX = lookDir end
			local n = self:CountMonstersAlongRay(player, pp, aimX, aimY, 9.0, 0.8, 6)
			if n < 1 then return 0 end
			return rate * n / 0.75
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method integer CountMonstersInBox(Entity player, Vector3 pp, number halfW, number halfH)
		-- 전방위 박스(|dx|≤halfW, |dy|≤halfH) 안의 살아있는 몬스터 수 - 코마 실판정과 같은 모양이다.
		-- ⚠ 기존 CountNearbyMonsters는 **원형 반경**이라 "위/아래 층까지 닿는" 코마 박스를 못 나타낸다.
		local comps = self:GetMonsterComps(player)
		if comps == nil then return 0 end
		local n = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local wp = e.TransformComponent.WorldPosition
					if math.abs(wp.x - pp.x) <= halfW and math.abs(wp.y - pp.y) <= halfH then
						n = n + 1
					end
				end
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method boolean IsWeakMonsterTarget(Entity target)
		-- "몬스터 수준이 낮아 콤보 어택의 이득을 다른 스킬로 별로 못 보는" 상황인가.
		-- 기본 공격 한두 대에 죽는 수준(전투력이 대상 최대 HP의 3배 이상)이면 구슬을 아껴 봐야
		-- +20%/구슬 버프가 실제 딜로 환산되지 않는다 - 그럴수록 코마로 **넓게 쓸어담는 게 이득**이다.
		if not isvalid(target) then return false end
		local mon = target:GetComponent("script.Monster")
		if mon == nil then return false end
		local maxHp = math.max(1, mon.MaxHp or 1)
		-- ⚠ (버그 수정 2026-08-14) **판정용 조회는 반드시 Peek이다.** GetEffectiveCombatPower는
		--   "지금 공격 스킬을 시전한다"는 신호라 ① 예약된 시전 스킬명을 소비해 **전투분석 사용 횟수를
		--   집계**하고 ② 다크사이트를 푼다. 이 메서드는 매 틱 도는 **점수 계산**인데 그걸 부르고 있어서,
		--   쿨다운 등으로 시전이 거부돼 남아 있던 예약명을 매 틱 집어삼켜 **사용 횟수가 폭증**했다
		--   (신고: "전투시간 1분이 넘어가면 사용 횟수가 갑자기 엄청 늘어난다" - 콤보 구슬이 쌓여
		--    코마/패닉 판정 경로가 매 틱 돌기 시작하는 시점과 일치).
		local cp = _SkillManager:PeekEffectiveCombatPower()
		return cp >= maxHp * 3.0
	end

	@ExecSpace("ClientOnly")
	method boolean TryComaCast(number now, Entity player, Vector3 pp, Entity target)
		-- 코마 자기 규칙. 시전했으면 true.
		if self._T.slotComas == nil or #self._T.slotComas == 0 then return false end
		-- ⚠ 자체 스로틀 필수: 코마/패닉은 공용 쿨다운(skillOnCooldown, 0.75×공속)을 쓰므로 쿨 중에는
		--   UseSkillInSlot이 조용히 거부한다. 스로틀이 없으면 조건이 참인 동안 매 틱 true를 돌려주며
		--   **다른 공격까지 막아** 제자리에 서 있게 된다(구슬이 안 줄어 조건이 계속 참이기 때문).
		if (self._T.nextComa or 0) > now then return false end
		local orb = self:GetComboOrbCount(player)
		if orb < 1 then return false end
		local cap = self:GetComboOrbCapClient()
		local halfW = self:GetComaHalfWidth(orb)
		local hit = math.min(15, self:CountMonstersInBox(player, pp, halfW, halfW * 0.5))
		-- 필요 대상 수 — **"모아서 쓴다"가 기본 원칙**(요청 2026-08-09).
		--   구슬 1개 ±3.0/±1.5 → 5개 ±8.3/±4.2 → 10개 ±15/±7.5로 범위가 크게 벌어지므로,
		--   덜 모은 상태에서 쏘는 것은 거의 항상 손해다. 그래서:
		--   · 구슬 상한(모으기 완료) = 더 모아도 범위가 안 커진다 → 문턱을 낮춰 자주 쓴다.
		--     약한 몬스터 구간이면 1마리라도 쓴다(어차피 구슬은 상한에서 놀고, 콤보 +20%/구슬의
		--     이득도 다른 스킬로 환산이 안 되는 구간이다).
		--   · 상한 -1 = 거의 다 모았다 → 4마리 이상이면 조금 앞당겨 쓴다.
		--   · 그 아래 = **참고 더 모은다.** 판정 상한이 15명이라 지금 범위에 이미 15명이 들어찬
		--     극단적인 경우에만(= 더 기다려도 더 못 때린다) 예외적으로 시전한다.
		-- ⚠ 초기 구현은 이 문턱이 6이라 구슬 1~2개의 **좁은 범위**로 계속 나갔다(실측: ±3.0에 9마리).
		--   몬스터가 빽빽한 맵에서는 6이 너무 쉽게 채워져 "모아 쓰기"가 사실상 무력화된다.
		local weak = self:IsWeakMonsterTarget(target)
		local need = 15
		if orb >= cap then
			need = 2
			if weak then need = 1 end
		elseif orb >= cap - 1 then
			need = 4
		end
		if hit < need then return false end
		self._T.nextComa = now + 1.0
		self._T.holdMoveUntil = now + 0.8 * _CharInfoManager:GetAttackSpeedMultiplier()
		self._T.lastAttackAt = now
		_SkillManager:UseSkillInSlot(self._T.slotComas[1].key)
		log("[AutoHunt] 코마 시전 (구슬 " .. tostring(orb) .. "/" .. tostring(cap)
			.. " 범위 ±" .. string.format("%.1f", halfW) .. "/±" .. string.format("%.1f", halfW * 0.5)
			.. " 대상 " .. tostring(hit) .. "마리 필요 " .. tostring(need)
			.. (weak and " 약한몹" or "") .. ")")
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean TryPanicCast(number now, Entity player, Vector3 pp, Entity target)
		-- 패닉 자기 규칙: **잘 죽지 않는 단일 대상(보스/탱커) 전용.** 시전했으면 true.
		-- 구슬 1개당 1000%~1200%의 단일기라 잡몹에게 쓰면 구슬만 날린다 - 그 구슬은 코마가 써야 한다.
		-- 기준: 남은 HP가 전투력의 5배를 넘는다(= 기본 공격 몇 대로는 안 죽는다).
		if self._T.slotPanics == nil or #self._T.slotPanics == 0 then return false end
		if (self._T.nextPanic or 0) > now then return false end   -- 코마와 같은 이유의 스로틀
		if self:GetComboOrbCount(player) < 1 then return false end
		local remain = self:GetTargetRemainHp(target)
		-- ⚠ (버그 수정 2026-08-14) 시전 여부를 **정하기 전**의 조회이므로 Peek을 쓴다
		--   (IsWeakMonsterTarget 주석 참고 - 사용 횟수 폭증·다크사이트 임의 해제의 원인이었다).
		local cp = _SkillManager:PeekEffectiveCombatPower()
		if remain < cp * 5.0 then return false end
		self._T.nextPanic = now + 1.0
		self._T.holdMoveUntil = now + 0.8 * _CharInfoManager:GetAttackSpeedMultiplier()
		self._T.lastAttackAt = now
		_SkillManager:UseSkillInSlot(self._T.slotPanics[1].key)
		log("[AutoHunt] 패닉 시전 (탱커 대상 - 남은HP " .. tostring(math.floor(remain))
			.. " ≥ 전투력×5 " .. tostring(math.floor(cp * 5.0)) .. ")")
		return true
	end

	-- ── (신궁) 스나이핑 = 직선 다수 + HP 비례 차징 ────────────────────────
	-- 좌우 직선만 때리는 관통 3명 차지기라, "전방 직선에 적이 여럿 늘어서 있을 때"만 쓴다.
	-- 차징 시간은 **대상의 HP 비율**에 비례한다(요청) - 다 죽어가는 적에게 10초를 모으는 것은 낭비다.

	-- ── 차지형 스킬 공용: "죽일 만큼만 모은다" ─────────────────────────────
	-- (신고 2026-08-07) "몬스터 수준에 맞지 않게 기를 너무 많이 모은다."
	-- 구 사양은 **대상 HP 비율**만 봤다 - 잡몹이라도 풀피면 무조건 완충이었다. 이제는
	-- "지금 전투력으로 이 대상을 죽이는 데 필요한 배율"을 역산해 딱 그만큼만 모은다.
	--   필요 배율 = 대상 남은 HP / (전투력 × 기본 최소 배율)
	--   차지 비율 t = 필요 배율 / 완충 배율   (0~1로 자름)

	@ExecSpace("ClientOnly")
	method number GetTargetRemainHp(Entity target)
		-- 대상의 남은 HP(몬스터가 아니거나 못 읽으면 0).
		if not isvalid(target) then return 0 end
		local mon = target:GetComponent("script.Monster")
		if mon == nil then return 0 end
		return math.max(0, mon.Hp or 0)
	end

	@ExecSpace("ClientOnly")
	method number GetChargeSecondsToKill(Entity target, number baseRate, number maxChargeMult, number fullSeconds, number minSeconds)
		-- baseRate = 무차지 1발의 기본 배율(전투력 대비). maxChargeMult = 완충 배율.
		-- 대상 HP를 못 읽으면(0) 완충한다 - 정보가 없을 때는 안전하게 세게 쏜다.
		local hp = self:GetTargetRemainHp(target)
		if hp <= 0 then return fullSeconds end
		local cp = _CharInfoManager:CalcCombatPower()
		local perShot = cp * math.max(0.0001, baseRate)
		if perShot <= 0 then return fullSeconds end
		-- 여유 1.15배 - 최소 배율로 계산했고 방어력/굴림 편차가 있어 살짝 넉넉히 모은다.
		local needMult = (hp * 1.15) / perShot
		local t = needMult / math.max(0.0001, maxChargeMult)
		if t < 0 then t = 0 end
		if t > 1 then t = 1 end
		return math.max(minSeconds, fullSeconds * t)
	end

	@ExecSpace("ClientOnly")
	method string FindIronArrowSlotKey()
		-- 아이언 에로우가 배정된 단축키(없으면 빈 문자열). 역할은 single이라 slotSingles에 들어 있다.
		if self._T.slotSingles == nil then return "" end
		for _, s in ipairs(self._T.slotSingles) do
			if s.name == "아이언 에로우" then return s.key end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method boolean TryIronArrowRanged(number now, Entity player, number dx, number dy)
		-- 아이언 에로우는 **8방향 관통 화살**이라 근접 사거리 밖 / 위아래 발판의 적에게도 그대로 꽂힌다.
		-- 붙을 때까지 걷기만 하느니 그 자리에서 쏘는 편이 이득이다(요청 2026-08-07).
		-- ⚠ 접근 분기(OnUpdate)에서 불러야 한다 - TryAttackCast는 근접 사거리 게이트 뒤에 있어
		--   먼 대상에게는 아예 도달하지 못한다(실측으로 확인한 사각).
		-- ⚠ (실측 2026-08-07) 조건이 "근접 사거리 밖"뿐이고 간격이 0.9초였을 때, 쏘느라 멈춘 사이
		--   대상에 붙지 못해 **아이언 에로우만 35연발**하고 피어싱/스트레이프가 한 번도 안 나갔다.
		--   → "걸어서 붙기 어려운 상황"으로 조건을 좁히고(위아래 발판이 다르거나 수평으로 꽤 멀 때)
		--     간격도 2.5초로 벌려 접근을 방해하지 않게 한다.
		local iaKey = self:FindIronArrowSlotKey()
		if iaKey == "" then return false end
		if (self._T.nextIronArrow or 0) > now then return false end
		-- ⚠ (실측) 다른 시전 잠금(피어싱 후딜 0.7초 등)이 걸려 있으면 UseSkillInSlot이 조용히 무시된다 -
		--   그런데도 2.5초 간격을 먹어버려 10번 시도 중 3번만 실제로 나갔다. 잠금 중이면 아예 넘긴다.
		if (self._T.holdMoveUntil or 0) > now then return false end
		local iaDist = math.sqrt(dx * dx + dy * dy)
		if iaDist <= 1.3 then return false end                       -- 근접 사거리면 평소 로테이션이 낫다
		if math.abs(dy) < 1.2 and math.abs(dx) < 3.0 then return false end  -- 곧 붙을 거리 - 걸어가는 게 낫다
		if math.abs(dx) > 7.0 or math.abs(dy) > 4.0 then return false end   -- 화살이 닿는 범위 밖
		local atkMultIa = _CharInfoManager:GetAttackSpeedMultiplier()
		-- (신고 2026-08-10) "화살이 아직 도달하지 않았는데 적이 안 죽은 걸로 보고 연발한다."
		-- 고정 2.5초 간격은 기모으기(0.7×공속) + 비행(거리/속도 6) + 처치 판정 반영보다 짧아,
		-- 첫 발이 죽일 적에게 결과를 보기 전에 두세 발을 낭비했다. 재시도는 **이번 화살이 대상에
		-- 도달하고 죽음이 반영될 시각 이후**(도달 +0.6초 여유)로 미룬다(최소 2.5초는 유지).
		local iaArrival = 0.7 * atkMultIa + iaDist / 6.0 + 0.6
		self._T.nextIronArrow = now + math.max(2.5, iaArrival)
		-- 8방향 조준값을 대상 쪽으로 못박아 둔다(시전 분기가 GetAimDirX/Y로 읽어간다).
		self._T.aimDirX = (dx > 0) and 1 or -1
		if dy >= 1.2 then self._T.aimDirY = 1
		elseif dy <= -1.2 then self._T.aimDirY = -1
		else self._T.aimDirY = 0 end
		local pccIa = player.PlayerControllerComponent
		if isvalid(pccIa) then pccIa.LookDirectionX = self._T.aimDirX end
		if self._T.moving then self:StopMoving() end
		-- 시전 모션 동안만 짧게 멈춘다 - 길게 잡으면 접근이 계속 밀려 위 35연발 사고가 재발한다.
		self._T.holdMoveUntil = now + 0.5 * atkMultIa
		self._T.nextAtk = now + 0.5 * atkMultIa
		_SkillManager:UseSkillInSlot(iaKey)
		log("[AutoHunt] 아이언 에로우 원거리 dist=" .. string.format("%.2f", iaDist)
			.. " dir=(" .. tostring(self._T.aimDirX) .. "," .. tostring(self._T.aimDirY) .. ")")
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean IsTargetToughForPiercing(Entity target)
		-- 완충 피어싱 한 방으로도 못 죽이는 "단단한" 대상인가.
		-- 스나이핑(완충 10초짜리 한 방)은 이런 대상에게만 값어치가 있다 - 잡몹에 10초를 모으면 손해다.
		local hp = self:GetTargetRemainHp(target)
		if hp <= 0 then return false end
		local pcLvT = math.max(1, _SkillManager:GetHeroSkillLevelByName("피어싱"))
		local baseT = _SkillManager:GetPiercingMinPercent(pcLvT) / 100
		local cpT = _CharInfoManager:CalcCombatPower()
		return hp > (cpT * baseT * 5.0)
	end

	@ExecSpace("ClientOnly")
	method number GetSnipingChargeSeconds(Entity target)
		-- 스나이핑: 완충 10초 / 완충 배율 100배. 죽일 만큼만 모으되 최소 0.5초는 모은다.
		local snLvC = math.max(1, _SkillManager:GetHeroSkillLevelByName("스나이핑"))
		return self:GetChargeSecondsToKill(target, _SkillManager:GetSnipingMinPercent(snLvC) / 100, 100.0, 10.0, 0.5)
	end

	@ExecSpace("ClientOnly")
	method boolean TrySnipingCast(number now, Entity player, Vector3 pp, Entity target)
		if self._T.slotSnipings == nil or #self._T.slotSnipings == 0 then return false end
		if (self._T.nextSniping or 0) > now then return false end
		-- (요청 2026-08-13) 스나이핑이 MP 50을 쓰게 됐다 - 못 내면 아예 시작하지 않는다.
		-- ⚠ 이 검사가 없으면 아래에서 이동 잠금(chargeSec+0.5초)과 자동 홀드를 먼저 걸어놓고
		--   StartSniping이 MP 부족으로 조용히 거부해, 캐릭터가 차징 시간만큼 아무것도 않고 서 있는다.
		if not _SkillManager:CanAffordSkillCost("스나이핑") then return false end
		-- 좌우 직선 판정: 바라보는 방향 전방 8유닛 안에 적이 **2마리 이상** 늘어서 있어야 한다
		-- (관통 3명이라 2명부터 이득 - 1명이면 스트레이프가 낫다).
		local lookDirSn = 1
		local pccSn = player.PlayerControllerComponent
		if isvalid(pccSn) and pccSn.LookDirectionX < 0 then lookDirSn = -1 end
		if self:CountMonstersInFront(player, pp, lookDirSn, 8.0) < 2 then return false end
		-- (요청 2026-08-07) "수준이 낮으면 스나이핑보다 피어싱 위주" - 완충 피어싱으로 죽는 잡몹에게는
		-- 스나이핑(완충 10초)을 아예 쓰지 않는다. 피어싱 슬롯이 없으면 이 제한을 걸지 않는다.
		if self._T.slotPiercings ~= nil and #self._T.slotPiercings > 0 and not self:IsTargetToughForPiercing(target) then
			return false
		end
		local chargeSec = self:GetSnipingChargeSeconds(target)
		self._T.nextSniping = now + chargeSec + 4.0
		-- 차징 내내 제자리에 서 있어야 한다(차징 중 이동속도 50% + 자세 유지).
		self._T.holdMoveUntil = now + chargeSec + 0.5
		self._T.nextAtk = now + chargeSec + 0.5
		-- ⚠ 실제 키를 누르지 않으므로 "누르고 있는 중"으로 표시해야 한다 - 안 그러면 차지 틱이 첫
		--   프레임에 "키를 뗐다"고 보고 charge=0으로 발사한다(2026-08-06 실측 버그).
		_SkillManager:SetChargeAutoHold("sniping", true)
		_SkillManager:UseSkillInSlot(self._T.slotSnipings[1].key)   -- 차지 시작
		-- 예약 취소용 세대 번호 - 자동사냥이 꺼지거나 새로 저격하면 옛 예약은 무시한다.
		self._T.snGen = (self._T.snGen or 0) + 1
		local snGenNow = self._T.snGen
		_TimerService:SetTimerOnce(function()
			if self._T.snGen ~= snGenNow then return end
			if self.autoOn ~= true then return end
			_SkillManager:ReleaseSniping()
		end, chargeSec)
		log("[AutoHunt] 스나이핑 저격 - 직선 " .. tostring(self:CountMonstersInFront(player, pp, lookDirSn, 8.0))
			.. "마리, 차징 " .. string.format("%.1f", chargeSec) .. "초 (대상 HP 비례)")
		return true
	end

	-- ── (신궁) 피어싱 = 넓게 훑는 짧은 차지기 ──────────────────────────────
	-- 스나이핑과 같은 차지 구조지만 완충이 1초라 부담 없이 자주 쓸 수 있고, 위아래 판정이 넓어
	-- 직선에 한 마리만 있어도 손해가 아니다 - 스나이핑(2마리 이상)보다 조건을 느슨하게 잡는다.

	@ExecSpace("ClientOnly")
	method boolean TryPiercingCast(number now, Entity player, Vector3 pp, Entity target)
		if self._T.slotPiercings == nil or #self._T.slotPiercings == 0 then return false end
		if (self._T.nextPiercing or 0) > now then return false end
		local lookDirPc = 1
		local pccPc = player.PlayerControllerComponent
		if isvalid(pccPc) and pccPc.LookDirectionX < 0 then lookDirPc = -1 end
		if self:CountMonstersInFront(player, pp, lookDirPc, 8.0) < 1 then return false end
		-- (요청 2026-08-07) 차징도 "죽일 만큼만" - 잡몹에게 완충 1초를 다 쓰지 않는다.
		-- 완충 1초 / 완충 배율 5배, 최소 0.15초(최소한의 기는 모은다).
		local fullPc = _SkillManager:GetPiercingFullChargeSeconds()
		local pcLvC = math.max(1, _SkillManager:GetHeroSkillLevelByName("피어싱"))
		local chargePc = self:GetChargeSecondsToKill(target,
			_SkillManager:GetPiercingMinPercent(pcLvC) / 100, 5.0, fullPc, 0.15)
		self._T.nextPiercing = now + chargePc + 1.0
		self._T.holdMoveUntil = now + chargePc + 0.4
		self._T.nextAtk = now + chargePc + 0.4
		-- ⚠ 스나이핑과 같은 이유로 "누르고 있는 중" 표시가 필요하다(TrySnipingCast 주석 참고).
		_SkillManager:SetChargeAutoHold("piercing", true)
		_SkillManager:UseSkillInSlot(self._T.slotPiercings[1].key)   -- 차지 시작
		self._T.pcGen = (self._T.pcGen or 0) + 1
		local pcGenNow = self._T.pcGen
		_TimerService:SetTimerOnce(function()
			if self._T.pcGen ~= pcGenNow then return end
			if self.autoOn ~= true then return end
			_SkillManager:ReleasePiercing()
		end, chargePc)
		log("[AutoHunt] 피어싱 - 직선 " .. tostring(self:CountMonstersInFront(player, pp, lookDirPc, 8.0))
			.. "마리, 차징 " .. string.format("%.2f", chargePc) .. "초")
		return true
	end

	@ExecSpace("ClientOnly")
	method void StopMoving()
		-- 자동 이동 종료: 이동을 멈추고 꺼뒀던 플레이어 컨트롤러를 복구한다 (수동 조작 재개 가능)
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) and not pcc.Enable then pcc.Enable = true end
			if self._T.moving == true then
				if isvalid(player.MovementComponent) then
					player.MovementComponent:Stop()
				end
				-- 정지 모션 복귀 (걷기 상태로 남아있으면 IDLE로)
				local sc = player.StateComponent
				if isvalid(sc) and sc.CurrentStateName == "MOVE" then
					sc:ChangeState("IDLE")
				end
			end
		end
		self._T.moving = false
		-- 끼임 감지 샘플 초기화 - 정지 후 새 걷기에서 이전 위치와 비교하는 오판 방지
		self._T.stuckLastX = nil
		self._T.stuckLastY = nil
		self._T.stuckCount = 0
	end

end
