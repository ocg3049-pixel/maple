@Logic
script AutoHuntManager extends Logic

	-- (M2) 자동사냥: F7 토글 - 용사 소환처럼 몬스터를 따라다니며, 스킬바에 배정된 스킬들을
	-- 용도(버프/소환수/광역/단일)에 맞게 알아서 골라 쓴다.
	-- · 이동: 클라 권한. 자동 이동 중에만 PlayerController를 끈다(입력 0이 이동을 덮는 문제) - 정지/OFF 시 복구.
	-- · 위/아래 발판 대상은 점프/다운점프로 따라간다. 걷기/정지 모션은 StateComponent WALK/IDLE로 맞춘다.
	-- · 동선은 하강 순환: 위(SpawnLocation)에서 시작해 아래층 적이 3배 이상 가까우면 다운점프로
	--   내려가며 사냥하고, 맨아래에서 사냥감이 끊기면 SpawnLocation으로 복귀해 다시 내려온다.
	-- · 공격/버프 시전은 전부 실제 버튼 경로(UseSkillInSlot)라 모션·쿨다운·위력 배율이 수동과 동일하다.
	property boolean autoOn = false
	property any keyHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.keyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		log("[AutoHunt] ready (F7 토글)")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.keyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
			self.keyHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- 자동사냥 토글 키는 키설정창(기능 "autohunt", 기본 F7)에서 바꿀 수 있다 - 강화창과 동일한 기능 매핑 판정.
		if _KeySettingManager:IsCapturingKey() then return end
		if _KeySettingManager:GetFuncForKeyEnum(event.key) ~= "autohunt" then return end
		self:Toggle()
	end

	@ExecSpace("ClientOnly")
	method void Toggle()
		self.autoOn = not self.autoOn
		local keyName = _KeySettingManager:GetKeyForFunc("autohunt")
		if keyName == "" then keyName = "F7" end
		if self.autoOn then
			self._T.target = nil
			self._T.chaseStart = _UtilLogic.ElapsedSeconds
			self._T.comboStep = 0
			self._T.noTargetSince = nil   -- 이전 세션 잔재로 켜자마자 복귀하는 것 방지
			_UIToast:ShowMessage("자동사냥 시작 (" .. keyName .. "로 중지)")
		else
			_UIToast:ShowMessage("자동사냥 중지")
			self._T.comboStep = 0
			self._T.rideFlight = false   -- (다크나이트) 비행 이동 중 OFF - 탑승 상태는 유저 조작에 맡긴다
			self:StopMoving()
		end
		-- (팔라딘) 서버 자동 가드(피격 타이밍 25% 자동 발동) 상태 동기화 - 가드 투자 레벨 동봉.
		_SkillManager:RequestSetAutoHuntState(self.autoOn, _SkillManager:GetHeroSkillLevelByName("가드"))
		log("[AutoHunt] " .. (self.autoOn and "ON" or "OFF"))
	end

	-- (P2) 자동 HP 물약: HP 30% 이하면 소비 탭의 HP포션을 자동 사용한다 (1초 주기 검사).
	-- 포션 힐(2초 간격 5틱)이 진행되는 동안은 다시 쓰지 않는다 - PotionShopManager의
	-- "이미 진행 중" 거부에 아이템만 소모되는 사고 방지.
	@ExecSpace("ClientOnly")
	method void TryAutoPotion(number now, Entity player)
		if (self._T.nextPotionCheck or 0) > now then return end
		self._T.nextPotionCheck = now + 1.0
		if (self._T.potionHealUntil or 0) > now then return end
		local pc = player.PlayerComponent
		if not isvalid(pc) then return end
		local maxHp = pc.MaxHp or 0
		if maxHp <= 0 then return end
		local hp = pc.Hp or 0
		if hp / maxHp > 0.3 then return end
		-- 소비 탭에서 HP포션 탐색 (이름이 첫 필드)
		for i = 1, 128 do
			local s = _UIEquipInventoryManager:GetTabItem("consume", i)
			if s ~= "" and string.find(s, "HP포션", 1, true) == 1 then
				-- (유실 방지) 수동 사용과 공용 게이트(TryUsePotion)로 통일 - 수락 시에만 아이템 소모.
				if not _PotionShopManager:TryUsePotion() then return end
				self._T.potionHealUntil = now + 10.5   -- 힐 5틱(2초 간격) + 여유
				_UIEquipInventoryManager:SetTabItem("consume", i, "")
				_UIEquipInventoryManager:RefreshUI()
				log("[AutoHunt] 자동 HP포션 사용 (HP " .. tostring(hp) .. "/" .. tostring(maxHp) .. ")")
				return
			end
		end
	end

	-- (P2) 몬스터 전멸 시 배회: 걷기(1~2초)와 대기(1~2.5초)를 교대하며 리젠을 기다린다.
	-- 발판 끝에 다다르면 방향을 반전해 떨어지지 않는다. 대상이 다시 잡히면 즉시 추적으로 복귀.
	@ExecSpace("ClientOnly")
	method void WanderTick(number now, Entity player, number delta)
		if (self._T.wanderPhaseUntil or 0) <= now then
			if self._T.wanderWalking == true then
				self._T.wanderWalking = false
				self._T.wanderPhaseUntil = now + 1.0 + _UtilLogic:RandomDouble() * 1.5
				self:StopMoving()
			else
				self._T.wanderWalking = true
				self._T.wanderDir = (_UtilLogic:RandomDouble() < 0.5) and -1 or 1
				self._T.wanderPhaseUntil = now + 1.0 + _UtilLogic:RandomDouble() * 1.0
				log("[AutoHunt] 배회 걷기 dir=" .. tostring(self._T.wanderDir))
			end
		end
		if self._T.wanderWalking == true then
			-- 발판 끝 감지 → 방향 반전 (떨어짐 방지)
			local rb = player.RigidbodyComponent
			if isvalid(rb) and rb:IsOnGround() and rb:PredictFootholdEnd(0.6, (self._T.wanderDir or 1) > 0) then
				self._T.wanderDir = -(self._T.wanderDir or 1)
			end
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) then
				if pcc.Enable then pcc.Enable = false end
				pcc.LookDirectionX = self._T.wanderDir or 1
			end
			player.MovementComponent:MoveToDirection(Vector2(self._T.wanderDir or 1, 0), delta)
			self._T.moving = true
			local sc = player.StateComponent
			if isvalid(sc) and sc.CurrentStateName == "IDLE" then
				sc:ChangeState("MOVE")
			end
			-- (신고) 배회 걷기 중에도 지형 턱에 끼면 점프로 탈출한다.
			self:CheckStuckAndJump(now, player, player.TransformComponent.WorldPosition)
		end
	end

	-- (섬광 등 조준 스킬 연동) 자동사냥이 켜져 있는지 - SkillManager가 조준 대체 여부 판단에 쓴다.
	@ExecSpace("ClientOnly")
	method boolean IsActive()
		return self.autoOn == true
	end

	-- 자동사냥이 지금 스스로 걷는 중인지(컨트롤러를 끄고 MoveToDirection으로 이동).
	-- PlayerAttack의 방향 잠금 강제 IDLE이 이 걷기와 싸우며 MOVE↔IDLE로 튕기지 않게,
	-- 걷는 동안은 방향 잠금이 물러나는 판단(ShouldEnforceDirectionLock)에 쓰인다.
	@ExecSpace("ClientOnly")
	method boolean IsAutoMoving()
		return self.autoOn == true and self._T.moving == true
	end

	-- 현재 대상 쪽 수평 조준 방향(-1/1). 대상이 없으면 바라보는 방향(LookDirectionX)을 쓴다.
	@ExecSpace("ClientOnly")
	method number GetAimDirX()
		if self._T.aimDirX ~= nil then return self._T.aimDirX end
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) and pcc.LookDirectionX < 0 then return -1 end
		end
		return 1
	end

	-- 현재 대상 쪽 수직 조준 방향(-1/0/1). 위아래로 제법 떨어진(|dy|≥1.2) 대상일 때만 ±1.
	@ExecSpace("ClientOnly")
	method number GetAimDirY()
		return self._T.aimDirY or 0
	end

	-- ── 스킬 용도 분류 ─────────────────────────────────────────────────────
	-- 스킬바에 배정된 스킬을 역할별로 나눈다. 미분류 스킬은 "manual"(자동사냥이 건드리지 않음).
	@ExecSpace("ClientOnly")
	method string GetSkillRole(string skillName)
		local roles = {
			-- 버프 (지속형 - 만료 전 주기 재시전)
			["부스터"] = "buff", ["분노"] = "buff", ["파워가드"] = "buff", ["메디테이션"] = "buff",
			["블레스"] = "buff", ["헤이스트"] = "buff", ["샤프 아이즈"] = "buff",
			["콤보 어택"] = "buff", ["홀리 매직쉘"] = "buff", ["브랜디쉬 강화"] = "buff",
			["불의 영역"] = "buff", ["빙하지대"] = "buff", ["발도술"] = "buff",
			-- (다크나이트) 드래곤 블러드: HP를 계속 소모하는 유지형이라 HP 게이트 + 버프바 잔여 확인이
			-- 필요한 전용 역할(주기 재시전만 하는 일반 buff와 다름 - DragonBloodTick 참고)
			["드래곤 블러드"] = "dragonblood",
			-- (다크나이트) 드래곤 라이딩: 미소환+쿨 종료 상태에서만 "소환"으로 사용(활성 중 재시전=탑승이라 금지)
			["드래곤 라이딩"] = "dragonride",
			-- (팔라딘) 아이언 월/속성필드도 지속형 버프 - 주기는 GetBuffPeriod가 투자 레벨로 계산
			["아이언 월"] = "buff", ["속성필드"] = "buff",
			-- (나이트로드) 지속시간형 버프 2종 - 주기는 GetBuffPeriod가 투자 레벨로 계산한다.
			--   · 암행: 1분+분배당 10초 (온히트 그림자 표창)
			--   · 쉐도우 파트너: 30초+분배당 10초 (표창 100개 소모 - 재고가 모자라면 자동으로 낮은
			--     번호 표창으로 내려가므로 시전 자체는 항상 성공한다)
			-- (섀도어, 2026-08-06) 암행2도 토글 → 지속시간 버프가 되면서 암행1과 같은 주기 유지 대상이 됐다.
			["암행"] = "buff", ["쉐도우 파트너"] = "buff", ["암행2"] = "buff",
			-- (나이트로드) 각성: 쿨 5분 고정 - 돌면 바로 쓰는 게 이득이라 전용 역할로 뺀다.
			["각성"] = "awakening",
			-- (나이트로드, 요청 2026-08-05) 드레인 샷: HP 보충기 전용 역할 - HP가 깎여 있으면
			-- 자체 쿨(5초)이 돌 때마다 로테이션에 앞서 우선 사용한다(TryAttackCast 상단 참고).
			["드레인 샷"] = "drainshot",
			-- (팔라딘) 리스토네이션: HP가 풀이 아닐 때만 30~60초 주기 회복 (요청)
			["리스토네이션"] = "restoration",
			-- (팔라딘) 궁병 지원: 120~150초 주기 사용 (요청)
			["궁병 지원"] = "archer",
			-- (팔라딘) 차지 블로우 속성 전환 4종: 속성 콤보 선설치 시퀀스(ElementComboTick)가 쓴다
			["디바인 스윙 강화"] = "chargemode", ["디바인 스티그마 강화"] = "chargemode",
			["디바인 저지먼트 강화"] = "chargemode", ["디바인 차지"] = "chargemode",
			-- 소환수 (주기 재소환 - 재사용 시 교체되는 기존 동작 활용)
			["용사 소환"] = "summon", ["힐러 소환"] = "summon", ["용 소환"] = "summon",
			["서먼 다크드래곤"] = "summon", ["바하뮤트"] = "summon", ["프리져"] = "summon",
			["피닉스"] = "summon", ["이프리트"] = "summon", ["엘퀴네스"] = "summon",
			-- 광역 (주변에 몬스터가 몰렸을 때 우선)
			["슬래시블러스트"] = "aoe", ["브랜디쉬"] = "aoe", ["돌진"] = "aoe", ["차지 블로우"] = "aoe",
			["블리자드"] = "aoe", ["메테오"] = "aoe", ["제네시스"] = "aoe", ["체인라이트닝"] = "aoe",
			["샤이닝 레이"] = "aoe", ["드래곤 로어"] = "aoe", ["트리플 스로우"] = "aoe",
			["쿼드러플 스로우"] = "aoe", ["아이스 샷"] = "aoe",
			-- (신궁, 요청 2026-08-06) 스트레이프는 화살 4발이 **적 하나**를 4번 때리는 단일 대상기다 -
			-- aoe로 두면 몰렸을 때 가중 3.0을 받아 진짜 광역인 아이스 샷을 밀어냈다(새비지블로우와 같은 이유).
			["스트레이프"] = "single",
			-- (섀도어 개편 2026-08-06) 새비지블로우는 전방 1명을 6번 때리는 **단일 대상** 스킬이라
			-- single로 옮긴다(광역으로 두면 몰렸을 때 가중 3.0을 받아 암살 주력을 밀어냈다).
			-- 어썰터/암살은 주변을 함께 치는 광역이라 aoe 그대로.
			["에로우 봄"] = "aoe", ["어썰터"] = "aoe", ["암살"] = "aoe",
			-- (섀도어) 다크사이트/연막은 전용 역할 - 로테이션이 아니라 자기 규칙으로 시전한다.
			["다크사이트"] = "darksight", ["연막"] = "smokescreen",
			-- (섀도어) 분신 소환: 살아 있을 때 다시 누르면 **위치 교환**이라 일반 summon으로 두면 안 된다
			-- (드래곤 라이딩과 같은 이유) - 미소환 + 쿨 종료일 때만 소환하는 전용 역할.
			["분신 소환"] = "shadowclone",
			["익스플로젼"] = "aoe", ["포이즌 미스트"] = "aoe", ["파이어 샷"] = "aoe",
			["폭풍의 시"] = "aoe",
			-- (다크나이트) 스피어 버스터: 3차 주력 광역 - 미분류라 자동사냥이 아예 안 쓰던 것 수정
			["스피어 버스터"] = "aoe",
			-- 이동기: 위아래로 제법 떨어진 대상 추적 전용 (요청 - 가까운 적에게는 쓰지 않는다)
			["섬광"] = "mobility",
			-- 대시: 같은 층의 먼 대상(3유닛↑) 접근 가속 (요청 - 이동 시 대시 스킬 활용)
			["러시"] = "dash",
			-- 단일 (기본 로테이션)
			["파워스트라이크"] = "single", ["럭키세븐"] = "single", ["더블스탭"] = "single",
			["새비지블로우"] = "single",
			["매직클로"] = "single", ["더블샷"] = "single", ["패닉"] = "single", ["코마"] = "single",
			["매직 미사일"] = "single", ["썬더볼트"] = "single", ["파이어에로우"] = "single",
			["홀리 에로우"] = "single", ["엔젤레이"] = "single", ["에로우 블로우"] = "single",
			["아이언 에로우"] = "single",
			["속사"] = "single", ["어벤져"] = "single",
			-- (신궁, 요청 2026-08-06) 체인샷은 **이동기**다 - 8방향으로 체인을 박고 그 각도로 당겨져
			-- 날아간다(지나친 적도 때리지만 주목적은 이동). 공격 로테이션에서 빼고 섬광과 같은 자리에 둔다.
			["체인샷"] = "chainshot",
			-- (신궁, 요청 2026-08-06) 스나이핑은 좌우 직선만 때리는 관통 3명 차지기 - 확률 로테이션이
			-- 아니라 "직선상에 적이 여럿일 때 + 대상 HP에 맞춘 차징"이라는 자기 규칙으로 쓴다.
			["스나이핑"] = "sniping",
			-- (신궁 2026-08-06 신설) 피어싱도 같은 차지 구조라 전용 역할이 필요하다 - 일반 로테이션에
			-- 넣으면 UseSkillInSlot이 차지를 "시작"만 하고 아무도 떼주지 않아 눌린 채로 굳는다.
			["피어싱"] = "piercing",
		}
		return roles[skillName] or "manual"
	end

	-- 스킬바 전체를 스캔해 역할별 슬롯 목록을 만든다 (5초 캐시).
	@ExecSpace("ClientOnly")
	method void RefreshSlotRoles()
		local now = _UtilLogic.ElapsedSeconds
		if self._T.roleCacheUntil ~= nil and self._T.roleCacheUntil > now then return end
		self._T.roleCacheUntil = now + 5.0
		local buffs, summons, aoes, singles, mobilities, dashes = {}, {}, {}, {}, {}, {}
		local restorations, archers, chargemodes, dragonbloods, dragonrides = {}, {}, {}, {}, {}
		local awakenings = {}
		local drainshots = {}
		local darksights, smokescreens, shadowclones = {}, {}, {}
		-- (신궁 2026-08-06) 체인샷 = 이동기 / 스나이핑 = 자기 규칙 차지기.
		local chainshots, snipings, piercings = {}, {}, {}
		local hotkeys = _SkillManager:ExportHotkeys()
		for key, slot in pairs(hotkeys) do
			if slot ~= nil and slot.name ~= nil and slot.name ~= "" then
				local role = self:GetSkillRole(slot.name)
				if role == "buff" then table.insert(buffs, { key = key, name = slot.name })
				elseif role == "summon" then table.insert(summons, { key = key, name = slot.name })
				elseif role == "aoe" then table.insert(aoes, { key = key, name = slot.name })
				elseif role == "single" then table.insert(singles, { key = key, name = slot.name })
				elseif role == "mobility" then table.insert(mobilities, { key = key, name = slot.name })
				elseif role == "dash" then table.insert(dashes, { key = key, name = slot.name })
				elseif role == "restoration" then table.insert(restorations, { key = key, name = slot.name })
				elseif role == "archer" then table.insert(archers, { key = key, name = slot.name })
				elseif role == "chargemode" then table.insert(chargemodes, { key = key, name = slot.name })
				elseif role == "dragonblood" then table.insert(dragonbloods, { key = key, name = slot.name })
				elseif role == "dragonride" then table.insert(dragonrides, { key = key, name = slot.name })
				elseif role == "awakening" then table.insert(awakenings, { key = key, name = slot.name })
				elseif role == "drainshot" then table.insert(drainshots, { key = key, name = slot.name })
				elseif role == "darksight" then table.insert(darksights, { key = key, name = slot.name })
				elseif role == "smokescreen" then table.insert(smokescreens, { key = key, name = slot.name })
				elseif role == "shadowclone" then table.insert(shadowclones, { key = key, name = slot.name })
				elseif role == "chainshot" then table.insert(chainshots, { key = key, name = slot.name })
				elseif role == "sniping" then table.insert(snipings, { key = key, name = slot.name })
				elseif role == "piercing" then table.insert(piercings, { key = key, name = slot.name })
				end
			end
		end
		self._T.slotBuffs = buffs
		self._T.slotSummons = summons
		self._T.slotAoes = aoes
		self._T.slotSingles = singles
		self._T.slotMobilities = mobilities
		self._T.slotDashes = dashes
		self._T.slotRestorations = restorations
		self._T.slotArchers = archers
		self._T.slotChargemodes = chargemodes
		self._T.slotDragonBloods = dragonbloods
		self._T.slotDragonRides = dragonrides
		self._T.slotAwakenings = awakenings
		self._T.slotDrainShots = drainshots
		self._T.slotDarkSights = darksights
		self._T.slotSmokeScreens = smokescreens
		self._T.slotShadowClones = shadowclones
		self._T.slotChainShots = chainshots
		self._T.slotSnipings = snipings
		self._T.slotPiercings = piercings
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- (신고 2026-08-04) 수동 조작 중에도 지형 턱/발판 이음매에 끼어 좌우 이동이 안 먹는 경우가
		-- 있다 - 자동사냥이 꺼져 있어도 수동 끼임 탈출 감시는 항상 돌린다(자동사냥 중에는 기존
		-- CheckStuckAndJump가 담당하므로 중복 방지를 위해 OFF일 때만).
		if not self.autoOn then
			local mp = _UserService.LocalPlayer
			if isvalid(mp) then self:ManualStuckTick(mp) end
			return
		end
		local player = _UserService.LocalPlayer
		if not isvalid(player) then return end
		-- 사망 중에는 일시정지 (부활하면 자동 재개)
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "DEAD" then
			self:StopMoving()
			return
		end
		local now = _UtilLogic.ElapsedSeconds

		-- (다크나이트, 요청 사양) 드래곤 라이딩 = "이동할 때만 탑승"하는 이동기.
		-- ① 자동사냥이 스스로 탑승한 비행 이동(rideFlight) 중이면 목표점까지 날아가고 도착 즉시 하차한다
		--    (하차한 드래곤은 소환수로서 따로 공격). 비행 시작은 아래 추적 분기(위층 대상)에서 건다.
		-- ② 그 외의 탑승(수동 탑승 등 - 비행 목표가 없는 상태)은 다른 스킬이 전부 막히고
		--    조작이 충돌하므로 자동 하차한다.
		if _SkillManager:IsDragonRideMounted() then
			if self._T.rideFlight == true then
				self:RideFlightTick(now, player, delta)
			elseif (self._T.nextDismount or 0) <= now then
				self._T.nextDismount = now + 1.5
				_SkillManager:ToggleDragonRide()
				log("[AutoHunt] 목표 없는 탑승 감지 - 자동 하차 (비행과 자동 이동 충돌 방지)")
			end
			return
		end
		self._T.rideFlight = false   -- 하차 상태면 비행 플래그 정리(안전망)

		-- (신고) 자동 점프/다운점프의 착지 복귀: 컨트롤러가 꺼진 동안 JUMP/FALL 상태로 남으면
		-- 이후 걷기/대기 모션이 안 나온다 - 점프 0.35초 뒤부터 착지가 확인되면 IDLE로 되돌린다.
		if (self._T.jumpedAt or 0) > 0 and now - self._T.jumpedAt > 0.35 then
			local rbLand = player.RigidbodyComponent
			if isvalid(rbLand) and rbLand:IsOnGround() then
				if isvalid(sc) and (sc.CurrentStateName == "JUMP" or sc.CurrentStateName == "FALL") then
					sc:ChangeState("IDLE")
				end
				self._T.jumpedAt = 0
			end
		end

		-- (P2) 자동 HP 물약: 위급 상황이라 홀드보다 먼저 본다
		self:TryAutoPotion(now, player)

		-- (신고 2026-08-06) "암살의 투명이 풀리기 전에 이곳저곳 이동한다"
		-- 암살은 **몸이 사라진 채 제자리에서** 연쇄 타격을 하고 그 자리로 돌아오는 연출이다. 그 사이에
		-- 자동사냥이 계속 걸어 다니면 보이지 않는 몸이 옮겨 다녀서, 복귀했을 때 엉뚱한 곳에 서 있게 된다.
		-- 사라져 있는 동안에는 이동/점프/대상 재선정을 전부 멈춘다(시전은 SkillManager가 이미 막는다 -
		-- 암살 중에는 암살 외 스킬 입력이 전부 거부된다). 물약은 위급 상황이라 위에서 먼저 처리한다.
		if _SkillManager:IsAssassinateActive() then
			if self._T.moving == true then self:StopMoving() end
			-- (실측) StopMoving 한 번만으로는 걷던 관성이 남아 0.1~0.4유닛 더 미끄러진다 - 사라져 있는
			-- 동안에는 매 틱 멈춰 세워 제자리를 지킨다.
			local mvAs = player.MovementComponent
			if isvalid(mvAs) then mvAs:Stop() end
			-- 정지 구간을 "끼임"으로 오판하지 않게 샘플을 비운다(시전 홀드와 같은 처리).
			self._T.stuckLastX = nil
			self._T.stuckLastY = nil
			return
		end

		-- (버그 수정) 시전 모션 홀드: 방금 스킬을 시전했다면 모션·잠금이 끝날 때까지
		-- 이동/점프/재선정을 하지 않는다 - 모션이 끝나기 전에 걸어나가 스윙이 끊기는 문제 방지.
		if (self._T.holdMoveUntil or 0) > now then
			-- 시전 홀드 동안의 정지를 "끼임"으로 오판하지 않게 샘플을 비운다 (재개 후 새로 잰다)
			self._T.stuckLastX = nil
			self._T.stuckLastY = nil
			return
		end
		-- (요청) 파이널어택 모션 존중: 스윙 모션 가드(파워스트라이크/슬래시블러스트/파이널어택/브랜디쉬)가
		-- 켜져 있는 동안은 다음 행동을 하지 않는다 - 파이널어택은 60% 확률 후발동이라 고정 홀드로는 못 잡는다.
		---@type PlayerAttack
		local paGuard = player:GetComponent(PlayerAttack)
		if isvalid(paGuard) and paGuard:IsBrandishMotionGuardOn() then
			return
		end

		self:RefreshSlotRoles()

		-- (팔라딘) 속성 콤보 선설치: 적이 없어도(이동 중에도) 지나가며 속성 연계를 미리 깔아둔다.
		if self:ElementComboTick(now, player) then return end

		-- 대상 탐색 (0.3초 주기 캐시)
		if self._T.target == nil or not isvalid(self._T.target) or (self._T.nextScan or 0) <= now then
			self._T.nextScan = now + 0.3
			local newTarget = self:FindTarget(player)
			if newTarget ~= self._T.target then
				self._T.target = newTarget
				self._T.chaseStart = now
			end
		end
		local target = self._T.target
		if target == nil or not isvalid(target) then
			-- (P2) 몬스터가 없어도 버프/소환수 유지는 계속하고, 그 외에는 배회하며 리젠을 기다린다.
			-- (요청) 맨아래 층에서 잡을 대상이 없으면(남은 적이 위층뿐이거나 전멸) 위로 복귀한다.
			-- (신고 2026-08-06) 중간 발판 정체: 남은 적이 위층뿐이면(도달 수단 없어 후보 제외) 맨아래가
			-- 아니라서 복귀도 못 하고 리젠까지 제자리 배회만 했다 - 무대상 4초 지속 시 중간에서도 복귀.
			if not self:TryUtilityCast(now) then
				if self:TryBottomReturn(now, player) then return end
				if self:TryNoTargetReturn(now, player) then return end
				self:WanderTick(now, player, delta)
			end
			return
		end
		self._T.noTargetSince = nil

		local mon = target:GetComponent("script.Monster")
		if mon == nil or mon.IsDead == true then
			self._T.target = nil
			return
		end

		local pp = player.TransformComponent.WorldPosition
		local mp = target.TransformComponent.WorldPosition
		local dx = mp.x - pp.x
		local dy = mp.y - pp.y
		-- (섀도어, 요청 2026-08-06) 다크사이트 잠복 중에는 대상의 **뒤통수 쪽 자리**를 목표로 걷는다.
		-- 그래야 은신이 풀리는 첫 공격이 백스탭 + 다크사이트 딜로 겹친다("적 뒤를 잡아서 더블스탭").
		-- dx만 뒤통수 자리 기준으로 바꾸고, 실제 공격 여부는 TryAttackCast의 게이트가 정한다.
		if self:IsDarkSightAmbushing(now) then
			dx = (mp.x + self:GetBehindDirOfTarget(target) * 0.9) - pp.x
		end
		-- (헛빵 수정) 실제 스킬 대상 선정(파스/슬블/차지 블로우)은 유클리드 반경 1.5인데, 박스
		-- 판정(|dx|≤1.3·|dy|<1.2)은 모서리에서 최대 1.76까지 통과시켜 허공 시전이 났다.
		-- 걷기 접근은 |dx|≤1.1로 더 붙고, 공격은 유클리드 거리 1.15 이내에서만 한다.
		local range = 1.1
		local dist = math.sqrt(dx * dx + dy * dy)
		-- 조준 방향 기억 - 섬광 등 방향키 조준 스킬이 "적 쪽 방향키를 누른 것처럼" 읽어간다(GetAimDirX/Y).
		-- 수직 조준은 위아래로 제법 떨어진(|dy|≥1.2) 대상일 때만 넣는다.
		if math.abs(dx) > 0.05 then
			self._T.aimDirX = (dx > 0) and 1 or -1
		end
		if dy >= 1.2 then
			self._T.aimDirY = 1
		elseif dy <= -1.2 then
			self._T.aimDirY = -1
		else
			self._T.aimDirY = 0
		end

		-- 상태 디버그 (2초 주기) - look = 현재 바라보는 방향(LookDirectionX)
		if (self._T.nextDbg or 0) <= now then
			self._T.nextDbg = now + 2.0
			local lookX = 0
			local pccDbg = player.PlayerControllerComponent
			if isvalid(pccDbg) then lookX = pccDbg.LookDirectionX end
			log("[AutoHunt] px=" .. string.format("%.2f", pp.x) .. " dx=" .. string.format("%.2f", dx) .. " dy=" .. string.format("%.2f", dy) .. " look=" .. tostring(lookX))
		end

		-- (버그 수정) 사거리 판정에 수직 거리도 포함한다 - |dx|만 보면 아래/위층 몬스터를 "사거리 내"로
		-- 오인해 허공에 파워스트라이크/슬래시블러스트를 발동했다. 같은 층(|dy|<1.2)일 때만 공격하고,
		-- 스킬 실판정(반경 1.5)보다 안쪽인 유클리드 1.15 이내까지 붙어야 공격한다 (헛빵 방지).
		-- (나이트로드, 요청) 각성 중에는 표창 3종이 드래곤 로어 범위(가로 ±15 / 세로 ±7.5)를 방향 무관으로
		-- 조준하므로 **제자리에서 거의 다 닿는다** - 굳이 걸어가지 않고 그 자리에서 계속 던진다.
		-- 표창 스킬이 하나도 배정돼 있지 않으면(근접 위주 구성) 평소처럼 접근한다.
		if self:IsAwakeningOn() and self:HasStarThrowSlot()
			and math.abs(dx) <= 15.0 and math.abs(dy) <= 7.5 then
			if self._T.moving then self:StopMoving() end
			self._T.chaseStart = now
			if math.abs(dx) > 0.05 then
				local pccAw = player.PlayerControllerComponent
				if isvalid(pccAw) then
					local wantAw = (dx > 0) and 1 or -1
					if pccAw.LookDirectionX ~= wantAw then
						pccAw.LookDirectionX = wantAw
						self._T.dirChangedAt = now
					end
				end
			end
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
			return
		end
		-- (요청 2026-08-06) 연막 안에서는 암살 사거리가 2배(9유닛)로 늘어난다 - 그 안의 대상은
		-- 걸어가지 않고 **제자리에서** 계속 암살로 끌어당긴다(각성 표창 제자리 사냥과 같은 처리).
		if self:ShouldSnipeWithAssassinate(dx, dy) then
			if self._T.moving then self:StopMoving() end
			self._T.chaseStart = now
			if math.abs(dx) > 0.05 then
				local pccSn = player.PlayerControllerComponent
				if isvalid(pccSn) then
					local wantSn = (dx > 0) and 1 or -1
					if pccSn.LookDirectionX ~= wantSn then
						pccSn.LookDirectionX = wantSn
						self._T.dirChangedAt = now
					end
				end
			end
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
			return
		end
		-- (신궁, 요청 2026-08-07) 접근 중이라도 아이언 에로우가 닿으면 그 자리에서 쏜다 -
		-- 8방향 관통이라 걸어가서 붙을 필요가 없다. 아래 접근 분기보다 **먼저** 본다(접근 분기는
		-- 이동만 하고 return 하므로, 뒤에 두면 먼 대상에게는 영영 기회가 없다).
		if self:TryIronArrowRanged(now, player, dx, dy) then return end
		if dist > 1.15 or math.abs(dy) >= 1.2 then
			-- (요청) 맨아래 층에서 남은 적이 수평으로 꽤 멀면(8유닛↑) 걸어가지 않고 위로 복귀해
			-- 위에서부터 다시 내려오며 잡는다 (하강 순환 동선).
			if math.abs(dx) >= 8.0 and self:TryBottomReturn(now, player) then return end
			-- 접근. 5초 넘게 사거리에 못 들면 이 대상을 3초간 제외하고 재선정한다.
			if (now - (self._T.chaseStart or now)) > 5.0 then
				if self._T.banned == nil then self._T.banned = {} end
				self._T.banned[target] = now + 3.0
				self._T.target = nil
				self:StopMoving()
				log("[AutoHunt] 추적 타임아웃 - 대상 제외 후 재선정")
				return
			end
			-- (다크나이트, 요청 사양) 위층 대상(dy≥1.2)은 드래곤 라이딩으로 날아 올라간다 - "이동할 때만
			-- 탑승"이고 도착하면 RideFlightTick이 즉시 하차시킨다(드래곤은 다시 소환수로 따로 공격).
			-- 소환이 활성일 때만(미탑승) 가능 - 소환 자체는 TryUtilityCast의 dragonride 유지가 담당.
			if dy >= 1.2 and (self._T.nextRideMove or 0) <= now
				and self._T.slotDragonRides ~= nil and #self._T.slotDragonRides > 0
				and _SkillManager:CanAutoMountDragonRide() then
				self._T.nextRideMove = now + 4.0
				self._T.rideFlight = true
				self._T.rideFlightX = mp.x
				-- (버그 수정 2026-08-04) 목표 높이를 몬스터 +0.3 → **+1.0**으로 올린다.
				-- 하차 처리(SkillManager.ToggleDragonRide)는 탑승 때 올렸던 만큼 캐릭터를 0.6 내리는데,
				-- +0.3에서 내리면 발판 표면보다 0.3 **아래**가 되어 발판이 캐릭터를 잡지 못하고
				-- 그대로 떨어졌다("올라가다 말고 다시 떨어진다"의 직접 원인). +1.0이면 하차 후에도
				-- 발판 위(+0.4)라 중력이 자연스럽게 착지시킨다.
				self._T.rideFlightY = mp.y + 1.0
				self._T.rideFlightStart = now
				-- (버그 수정) 거리 비례 타임아웃/진척 감시의 기준값을 탑승 시점에 기록해 둔다.
				self._T.rideFlightDist = math.sqrt(dx * dx + (dy + 1.0) * (dy + 1.0))
				self._T.rideProgressDist = nil
				self._T.rideProgressAt = now + 2.0
				_SkillManager:ToggleDragonRide()   -- 탑승 (하차는 RideFlightTick 도착 판정이)
				log("[AutoHunt] 드래곤 라이딩 비행 이동 시작 (dy=" .. string.format("%.2f", dy) .. ")")
				return
			end
			-- (요청) 섬광 = 상하 이동기: 위아래로 제법 떨어진(|dy|≥1.2) 대상을 쫓을 때만 시전한다 -
			-- 가까운/같은 높이 대상에게는 절대 쓰지 않는다 (공격 로테이션에서도 제외됨).
			if math.abs(dy) >= 1.2 and (self._T.nextFlash or 0) <= now
				and self._T.slotMobilities ~= nil and #self._T.slotMobilities > 0 then
				self._T.nextFlash = now + 2.5   -- 섬광 자체 쿨 2초 + 여유
				local pccF = player.PlayerControllerComponent
				if isvalid(pccF) then pccF.LookDirectionX = (dx > 0) and 1 or -1 end
				self._T.holdMoveUntil = now + 1.0
				_SkillManager:UseSkillInSlot(self._T.slotMobilities[1].key)
				log("[AutoHunt] 섬광 이동 시전 (dy=" .. string.format("%.2f", dy) .. ")")
				return
			end
			-- (신궁, 요청 2026-08-06) 체인샷 = 유동적 이동. 섬광과 같은 자리에서 쓴다 -
			-- 위아래로 떨어진 대상(|dy|≥1.2)이거나 같은 층에서 멀리(3유닛↑) 떨어졌을 때.
			if self._T.slotChainShots ~= nil and #self._T.slotChainShots > 0 then
				local csDirX = (dx > 0) and 1 or -1
				local csDirY = 0
				if dy >= 1.2 then csDirY = 1 elseif dy <= -1.2 then csDirY = -1 end
				if csDirY ~= 0 or math.abs(dx) >= 3.0 then
					if self:TryChainShotMove(now, player, csDirX, csDirY,
						"dx=" .. string.format("%.2f", dx) .. " dy=" .. string.format("%.2f", dy)) then
						return
					end
				end
			end
			-- 자동 이동 중에만 컨트롤러를 끈다 (입력 0이 이동을 덮는 문제 - 정지/OFF 시 복구)
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) and pcc.Enable then pcc.Enable = false end
			local dir = (dx > 0) and 1 or -1
			-- 바라보는 방향 = 이동 방향. 스킬 판정/이펙트는 전부 LookDirectionX를 읽으므로 직접 갱신한다
			if isvalid(pcc) then pcc.LookDirectionX = dir end
			-- (요청) 같은 층의 먼 대상(3유닛↑)은 대시(러시)로 가속 접근한다 - 질주 0.4초, 자체 쿨 3초
			if math.abs(dx) >= 3.0 and math.abs(dy) < 0.8 and (self._T.nextDash or 0) <= now
				and self._T.slotDashes ~= nil and #self._T.slotDashes > 0 then
				self._T.nextDash = now + 3.5
				self._T.aimDirX = dir
				_SkillManager:UseSkillInSlot(self._T.slotDashes[1].key)
				log("[AutoHunt] 대시 접근 (dx=" .. string.format("%.2f", dx) .. ")")
			end
			-- (나이트로드·섀도어, 요청) 플래시 점프는 **필요한 두 상황에서만** 쓴다.
			--   ① 위 발판 대상: 그냥 점프로는 못 닿는 높이도 점프+플래시 점프면 올라간다(사거리 안일 때만).
			--      가로로도 밀려나지만 그 위 발판에 올라서기만 하면 나머지는 걷기가 마무리한다.
			--   ② 같은 층 먼 대상: 이 두 직업은 러시(대시)가 없어 접근이 느리다 - 3유닛 이상 벌어졌고
			--      대시 슬롯도 없을 때만 가속용으로 쓴다(가까운 대상엔 절대 안 쓴다).
			if self:GetFlashJumpLevel() > 0 then
				local fjReach = self:GetFlashJumpReach()
				if dy >= 1.2 and dy <= fjReach then
					if self:TryFlashJumpMove(now, player, dir, "위 발판 추적 (dy=" .. string.format("%.2f", dy)
						.. " 사거리=" .. string.format("%.2f", fjReach) .. ")") then
						return
					end
				elseif math.abs(dy) < 0.8 and math.abs(dx) >= 3.0
					and (self._T.slotDashes == nil or #self._T.slotDashes == 0) then
					if self:TryFlashJumpMove(now, player, dir, "같은 층 가속 접근 (dx=" .. string.format("%.2f", dx) .. ")") then
						return
					end
				end
			end
			-- (신궁, 요청 2026-08-06) 더블 점프도 플래시 점프와 **같은 두 상황**에서만 쓴다.
			-- 두 스킬을 동시에 가진 직업은 없지만, 만에 하나 겹쳐도 플래시 점프가 먼저 소비되므로
			-- 여기까지 내려오지 않는다(위 분기가 return 한다).
			if self:GetDoubleJumpLevel() > 0 then
				local djReach = self:GetDoubleJumpReach()
				if dy >= 1.2 and dy <= djReach then
					if self:TryDoubleJumpMove(now, player, dir, "위 발판 추적 (dy=" .. string.format("%.2f", dy)
						.. " 사거리=" .. string.format("%.2f", djReach) .. ")") then
						return
					end
				elseif math.abs(dy) < 0.8 and math.abs(dx) >= 3.0
					and (self._T.slotDashes == nil or #self._T.slotDashes == 0) then
					if self:TryDoubleJumpMove(now, player, dir, "같은 층 가속 접근 (dx=" .. string.format("%.2f", dx) .. ")") then
						return
					end
				end
			end
			-- 같은 층이면 공격 거리(유클리드 1.15)에 들 때까지 계속 걷는다. 다른 층 대상은 수평 정렬이
			-- 끝나면(|dx|≤사거리) 좌우로 부들거리지 않게 제자리에서 점프/다운점프·섬광만 기다린다.
			if math.abs(dy) < 1.2 or math.abs(dx) > range then
				player.MovementComponent:MoveToDirection(Vector2(dir, 0), delta)
				self._T.moving = true
				-- 걷기 모션: 컨트롤러가 꺼진 동안 상태를 직접 맞춘다 (버튼 이동과 같은 모션).
				-- 플레이어 이동 상태명은 "MOVE"(PlayerControllerComponent가 등록 - animation-state.md §1.2),
				-- 아바타 상태 권한은 클라이언트라 ClientOnly 호출이 정상이다.
				if isvalid(sc) and sc.CurrentStateName == "IDLE" then
					sc:ChangeState("MOVE")
				end
				-- (신고) 걷는데 제자리면(지형 턱에 낌) 점프로 탈출한다.
				self:CheckStuckAndJump(now, player, pp)
			elseif self._T.moving then
				self:StopMoving()
			end
			-- (P2 개선) 위/아래 발판 추적: 수평으로 먼저 정렬한 뒤에만 점프/다운점프한다 -
			-- 멀리서 무의미하게 뛰어오르는 낭비 방지 (위 발판은 |dx|≤1.2, 아래 발판은 |dx|≤1.5에서만)
			-- (나이트로드, 요청) 헤이스트 점프 보정: 헤이스트가 켜져 있으면 점프력이 "바로 위 발판을
			-- 살짝 넘길 만큼"으로 미리 맞춰진다(PlayerAttack.HasteJumpAssistTick) - 그 사거리 안의
			-- 위층 대상은 점프로 확실히 올라갈 수 있다. 수평 정렬이 끝난 뒤에만 뛴다.
			if (self._T.nextJump or 0) <= now and dy >= 1.2 and math.abs(dx) <= 1.2
				and self:GetHasteJumpReach() >= dy then
				self._T.nextJump = now + 1.0
				self._T.jumpedAt = now
				player.MovementComponent:Jump()
				if isvalid(sc) then sc:ChangeState("JUMP") end
				log("[AutoHunt] 헤이스트 점프 보정으로 위 발판 추적 (dy=" .. string.format("%.2f", dy)
					.. " 사거리=" .. string.format("%.2f", self:GetHasteJumpReach()) .. ")")
				return
			end
			if (self._T.nextJump or 0) <= now then
				-- (요청) 위 발판의 적에게는 점프 자체를 하지 않는다 - 점프 정점 타이밍에만 닿는
				-- 공격은 난이도만 높다. 위층 적은 FindTarget에서 아예 제외되고(섬광 보유 시 예외),
				-- 아래층 적만 다운점프로 내려가 잡는다. 컨트롤러가 꺼진 동안엔 낙하 상태 전환도
				-- 직접 해줘야 모션이 나온다 (걷기 IDLE→MOVE와 같은 이유, 착지 복귀는 OnUpdate 상단).
				if dy < -0.8 and math.abs(dx) <= 1.5 then
					-- (신고 2026-08-06) 발밑에 착지 발판이 없으면 DownJump가 엔진에서 무시돼 0.8초마다
					-- 제자리 재시도(미세 이동)만 반복했다 - 레이캐스트로 착지 발판을 확인하고, 없으면
					-- 추적 타임아웃(5초)을 기다리지 않고 즉시 이 대상을 제외하고 재선정한다.
					local mapDJ = player.CurrentMap
					local fhDJ = isvalid(mapDJ) and mapDJ.FootholdComponent or nil
					local canLand = false
					if isvalid(fhDJ) then
						canLand = fhDJ:Raycast(Vector2(pp.x, pp.y - 0.3), Vector2(0, -1), 8.0) ~= nil
					end
					if not canLand then
						if self._T.banned == nil then self._T.banned = {} end
						self._T.banned[target] = now + 4.0
						self._T.target = nil
						self._T.nextScan = 0
						self:StopMoving()
						log("[AutoHunt] 아래 발판 없음 - 다운점프 불가 대상 제외 후 재선정")
						return
					end
					self._T.nextJump = now + 0.8
					self._T.jumpedAt = now
					player.MovementComponent:DownJump()
					if isvalid(sc) then sc:ChangeState("FALL") end
				end
			end
		else
			if self._T.moving then
				self:StopMoving()
			end
			self._T.chaseStart = now
			-- (버그 수정) 시전 직전 바라보는 방향을 대상 쪽으로 강제한다. 스킬 판정·모션·이펙트가 전부
			-- PlayerControllerComponent.LookDirectionX를 읽으므로 이 값을 직접 대입해야 방향이 바뀐다
			-- (기존 "짧은 이동" 방식은 LookDirectionX를 갱신하지 못해 반대 방향으로 시전됐음).
			-- (헛빵 수정 2) 방향이 실제로 바뀐 순간을 기록한다 - 서버는 시전 시점에 자기 복제본의
			-- LookDirectionX를 읽는데, 대입과 같은 프레임에 시전 RPC를 보내면 복제가 아직 옛 방향이라
			-- 등 뒤로 판정 박스가 열렸다(dir=-1 targets=0 다발). TryAttackCast가 이 시각을 보고
			-- 전환 직후 0.25초는 시전을 보류한다.
			if math.abs(dx) > 0.05 then
				local pccFace = player.PlayerControllerComponent
				if isvalid(pccFace) then
					local wantDir = (dx > 0) and 1 or -1
					if pccFace.LookDirectionX ~= wantDir then
						pccFace.LookDirectionX = wantDir
						self._T.dirChangedAt = now
					end
				end
			end
			-- ① 버프/소환수 유지가 우선 ② 아니면 주변 몬스터 수에 맞는 공격 스킬
			if not self:TryUtilityCast(now) then
				self:TryAttackCast(now, player, pp)
			end
		end
	end

	-- (신고) 끼임 탈출: 걷기 시도 중인데 실제로 거의 안 움직이면(지형 턱/모서리에 낌 - 점프나
	-- 이동기 없이는 못 빠져나옴) 전방 점프로 턱을 넘는다. 0.6초마다 이동량을 재고, 연속 3회
	-- 점프로도 못 빠져나오면 그 대상을 제외하고 재선정한다(도달 불가 지형).
	@ExecSpace("ClientOnly")
	method void CheckStuckAndJump(number now, Entity player, Vector3 pp)
		if (self._T.stuckCheckAt or 0) > now then return end
		local lastX = self._T.stuckLastX
		local lastY = self._T.stuckLastY
		self._T.stuckLastX = pp.x
		self._T.stuckLastY = pp.y
		self._T.stuckCheckAt = now + 0.6
		if lastX == nil then return end
		-- 걷기 시도 중 + 지상 + 0.6초간 이동량이 미미하면 끼임으로 판정 (공중/낙하 중은 제외)
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return end
		if math.abs(pp.x - lastX) >= 0.08 or math.abs(pp.y - lastY) >= 0.3 then
			self._T.stuckCount = 0
			return
		end
		self._T.stuckCount = (self._T.stuckCount or 0) + 1
		if self._T.stuckCount >= 3 then
			-- 점프로도 못 빠져나오는 지형: 대상을 잠시 제외하고 재선정한다.
			self._T.stuckCount = 0
			local target = self._T.target
			if target ~= nil and isvalid(target) then
				if self._T.banned == nil then self._T.banned = {} end
				self._T.banned[target] = now + 4.0
			end
			self._T.target = nil
			self._T.nextScan = 0
			self:StopMoving()
			log("[AutoHunt] 끼임 지속 - 대상 제외 후 재선정")
			return
		end
		-- (나이트로드·섀도어) 두 번째 시도부터는 평범한 점프로 이미 못 넘은 턱이므로 플래시 점프로
		-- 크게 넘어본다. 안 배웠거나 간격 제한에 걸리면 아래 평범한 점프로 그대로 떨어진다.
		if self._T.stuckCount >= 2 then
			local dirStuck = 1
			local pccStuck = player.PlayerControllerComponent
			if isvalid(pccStuck) then dirStuck = (pccStuck.LookDirectionX >= 0) and 1 or -1 end
			if self:TryFlashJumpMove(now, player, dirStuck, "끼임 탈출 (" .. tostring(self._T.stuckCount) .. "/3)") then
				return
			end
		end
		-- 전방 점프로 턱 넘기 (착지 복귀는 OnUpdate 상단의 jumpedAt 처리)
		player.MovementComponent:Jump()
		self._T.jumpedAt = now
		local sc = player.StateComponent
		if isvalid(sc) then sc:ChangeState("JUMP") end
		log("[AutoHunt] 끼임 감지 - 점프 탈출 시도 (" .. tostring(self._T.stuckCount) .. "/3)")
	end

	-- (신고 2026-08-04) 수동 조작 끼임 탈출: 이동키(좌/우 한쪽)를 누르고 있는데 지상에서 0.5초간
	-- 제자리면 지형 턱/발판 이음매에 낀 것으로 보고 자동 점프로 턱을 넘겨준다(자동사냥 끼임 탈출의
	-- 수동판 - CheckStuckAndJump와 상태를 분리해 서로 간섭하지 않는다). 시전 잠금(PlayerController
	-- 비활성) 중이나 공중에서는 판정하지 않는다.
	@ExecSpace("ClientOnly")
	method void ManualStuckTick(Entity player)
		local now = _UtilLogic.ElapsedSeconds
		local pcc = player.PlayerControllerComponent
		if not isvalid(pcc) or not pcc.Enable then
			self._T.mStuckLastX = nil
			return
		end
		local leftHeld = _InputService:IsKeyPressed(KeyboardKey.LeftArrow)
		local rightHeld = _InputService:IsKeyPressed(KeyboardKey.RightArrow)
		if leftHeld == rightHeld then   -- 안 누르거나 양쪽 동시 - 이동 의도 없음으로 보고 샘플 초기화
			self._T.mStuckLastX = nil
			return
		end
		-- (신고 2026-08-05) 시전 스윙 중에는 끼임 점프를 쏘지 않는다 - 드레인 샷처럼 컨트롤러를
		-- 끄지 않는 시전 중에 방향키를 잡고 있으면 제자리가 되는데, 이걸 지형 끼임으로 오인해
		-- "방향전환만 해도 자동으로 점프"하던 원인. 스윙이 끝나면 샘플을 새로 재기 시작한다.
		---@type PlayerAttack
		local paSwing = player:GetComponent(PlayerAttack)
		if isvalid(paSwing) and paSwing:IsSwingMotionActive() then
			self._T.mStuckLastX = nil
			return
		end
		if (self._T.mStuckCheckAt or 0) > now then return end
		local pp = player.TransformComponent.WorldPosition
		local lastX = self._T.mStuckLastX
		local lastY = self._T.mStuckLastY
		self._T.mStuckLastX = pp.x
		self._T.mStuckLastY = pp.y
		self._T.mStuckCheckAt = now + 0.5
		if lastX == nil then return end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return end
		if math.abs(pp.x - lastX) >= 0.08 or math.abs(pp.y - lastY) >= 0.3 then return end
		player.MovementComponent:Jump()
		local sc = player.StateComponent
		if isvalid(sc) and (sc.CurrentStateName == "IDLE" or sc.CurrentStateName == "MOVE") then
			sc:ChangeState("JUMP")
		end
		-- 좌표를 남겨 끼임 지점 분석 데이터로 쓴다(신고 재현 시 이 로그 위치가 문제 지형).
		log("[AutoHunt] 수동 끼임 감지 - 자동 점프 탈출 (x=" .. string.format("%.2f", pp.x) .. " y=" .. string.format("%.2f", pp.y) .. " dir=" .. (rightHeld and "R" or "L") .. ")")
	end

	-- (다크나이트) 드래곤 라이딩 비행 이동 1틱: 탑승 시점에 기록한 목표점(rideFlightX/Y)으로 직선 비행
	-- (KinematicMove 자유이동이라 MoveToDirection에 y성분이 그대로 먹힌다).
	--
	-- (버그 수정 2026-08-04) "위 발판으로 올라가려다 별로 못 간 상태에서 내려 다시 떨어진다"는 신고.
	-- 원인 두 가지:
	--   ① 도착 판정이 **유클리드 0.8**이라, 목표(몬스터)가 대각선으로 가까우면 아직 발판 높이에
	--      한참 못 미쳤는데도 도착으로 쳐서 공중에서 하차 → 발판이 없어 그대로 추락했다.
	--      → **수평으로 붙었고(|dx|≤0.6) 목표 높이까지 실제로 올라왔을 때(y ≥ 목표y-0.25)**만 도착.
	--   ② 안전망 타임아웃이 6초 고정이었는데, 탑승 이동속도가 스펙 개편으로 1.0~1.38배까지
	--      내려가(예전 3.2배) 같은 높이를 오르는 데 훨씬 오래 걸린다 - 정상 비행 도중에 타임아웃이
	--      먼저 터져 공중에서 내려버렸다. → 거리에 비례한 타임아웃(최소 8초, 최대 20초)으로 바꾸고,
	--      "2초 동안 목표까지의 거리가 0.2도 줄지 않으면" 막힌 것으로 보고 그때 하차한다.
	@ExecSpace("ClientOnly")
	method void RideFlightTick(number now, Entity player, number delta)
		local tx = self._T.rideFlightX or 0
		local ty = self._T.rideFlightY or 0
		local pp = player.TransformComponent.WorldPosition
		local fdx = tx - pp.x
		local fdy = ty - pp.y
		local fdist = math.sqrt(fdx * fdx + fdy * fdy)

		-- 진척 감시: 2초마다 거리를 비교해 0.2 이상 줄지 않았으면 막힌 것으로 본다.
		local stalled = false
		if (self._T.rideProgressAt or 0) <= now then
			local prev = self._T.rideProgressDist
			if prev ~= nil and (prev - fdist) < 0.2 then stalled = true end
			self._T.rideProgressDist = fdist
			self._T.rideProgressAt = now + 2.0
		end

		local elapsed = now - (self._T.rideFlightStart or now)
		local limit = math.max(8.0, math.min(20.0, (self._T.rideFlightDist or fdist) * 2.0 + 5.0))
		local arrived = (math.abs(fdx) <= 0.6 and pp.y >= (ty - 0.25))
		if arrived or stalled or elapsed > limit then
			self._T.rideFlight = false
			_SkillManager:ToggleDragonRide()   -- 하차 - 드래곤은 소환수로 복귀해 따로 공격
			self._T.holdMoveUntil = now + 0.8  -- 하차 워프 연출(0.5초) 동안 대기
			self._T.target = nil
			self._T.nextScan = 0
			local reason = "도착"
			if not arrived then
				if stalled then reason = "진척 없음" else reason = "시간 초과" end
			end
			log("[AutoHunt] 드래곤 라이딩 비행 종료(" .. reason .. ") - 하차 (dist="
				.. string.format("%.2f", fdist) .. " dy=" .. string.format("%.2f", fdy)
				.. " t=" .. string.format("%.1f", elapsed) .. "/" .. string.format("%.1f", limit) .. ")")
			return
		end
		local pcc = player.PlayerControllerComponent
		if isvalid(pcc) then
			if pcc.Enable then pcc.Enable = false end
			if math.abs(fdx) > 0.05 then pcc.LookDirectionX = (fdx > 0) and 1 or -1 end
		end
		-- (버그 수정) 목표 바로 아래에서 수평 성분이 0에 가까워지면 정규화 벡터가 흔들려 제자리를
		-- 맴돈다 - 아직 높이가 모자라면 상승(y)을 우선해 확실히 발판 높이까지 올라가게 한다.
		local dirX = fdx
		local dirY = fdy
		if fdy > 0.3 and math.abs(fdx) < 0.3 then
			dirX = 0
			dirY = fdy
		end
		local dlen = math.sqrt(dirX * dirX + dirY * dirY)
		if dlen < 0.0001 then dlen = 1 end
		player.MovementComponent:MoveToDirection(Vector2(dirX / dlen, dirY / dlen), delta)
		self._T.moving = true
	end

	-- (팔라딘, 요청) 속성 콤보 선설치: 3차부터는 적이 없어도 지나가며 속성 연계를 미리 깔아둔다.
	-- 예) 스윙 강화→차지 블로우→스티그마 강화→차지 블로우 후 주력 모드(디바인 차지)로 복귀.
	-- 25~40초 랜덤 주기. 속성 전환 스킬 + 차지 블로우가 퀵슬롯에 있을 때만 동작.
	-- 시퀀스가 진행 중이거나 이번 틱에 스텝을 시전했으면 true (다른 행동은 다음 틱에).
	@ExecSpace("ClientOnly")
	method boolean ElementComboTick(number now, Entity player)
		if (self._T.comboStep or 0) > 0 then
			-- 진행 중: 다음 스텝 시각이 되면 하나씩 시전한다.
			if (self._T.comboNextAt or 0) > now then return true end
			local steps = self._T.comboSteps
			if steps == nil or steps[self._T.comboStep] == nil then
				self._T.comboStep = 0
				return false
			end
			local step = steps[self._T.comboStep]
			self._T.comboStep = self._T.comboStep + 1
			if self._T.comboStep > #steps then self._T.comboStep = 0 end
			if step.hold then
				-- 차지 블로우 시전 스텝: 모션 동안 이동 금지
				self._T.holdMoveUntil = now + 0.9 * _CharInfoManager:GetAttackSpeedMultiplier()
				self._T.comboNextAt = now + 1.0
			else
				self._T.comboNextAt = now + 0.3   -- 속성 전환은 즉시형이라 짧게
			end
			_SkillManager:UseSkillInSlot(step.key)
			log("[AutoHunt] 속성 콤보 스텝: " .. step.name)
			return true
		end
		if (self._T.nextElemCombo or 0) > now then return false end
		if self._T.slotChargemodes == nil or #self._T.slotChargemodes == 0 then return false end
		-- (요청 보강) 속성필드 버프가 꺼져 있으면 차지 블로우가 필드를 남기지 않아 콤보가 헛돈다 -
		-- 버프가 켜질 때까지 시작하지 않는다(버프 유지는 TryUtilityCast가 담당, 주기 소모도 없음).
		if _ElemFieldBuffUI:GetRemaining() <= 0 then return false end
		local cbKey = nil
		if self._T.slotAoes ~= nil then
			for _, s in ipairs(self._T.slotAoes) do
				if s.name == "차지 블로우" then cbKey = s.key break end
			end
		end
		if cbKey == nil then return false end
		-- (요청) 연계 사슬 순서 고정: 불(스윙)→얼음(스티그마)→전기(저지먼트). 연계는
		-- "불 필드+얼음 차지 블로우 → 화상 저주 장판(20초)"과 "얼음 필드+전기 차지 블로우 →
		-- 감전 장판(20초)" 두 쌍뿐이라, 이 순서로만 시전해야 매 스텝의 필드가 다음 스텝에
		-- 소모된다. 기존처럼 슬롯 순서(임의)로 뽑으면 전기→불 같은 연계 불가 조합이 나와
		-- 필드만 깔리고 안 터지는 "연계 없는 허공 공격"이 됐다. 얼음이 없으면 어떤 필드도
		-- 소모될 수 없으므로 시퀀스를 시작하지 않는다 (끝나면 주력 디바인 차지로 복귀).
		local divineKey = nil
		local byName = {}
		for _, s in ipairs(self._T.slotChargemodes) do
			if s.name == "디바인 차지" then divineKey = s.key
			else byName[s.name] = s end
		end
		local fireS = byName["디바인 스윙 강화"]
		local iceS = byName["디바인 스티그마 강화"]
		local elecS = byName["디바인 저지먼트 강화"]
		if iceS == nil or (fireS == nil and elecS == nil) then return false end
		local elems = {}
		if fireS ~= nil then table.insert(elems, fireS) end
		table.insert(elems, iceS)
		if elecS ~= nil then table.insert(elems, elecS) end
		local steps = {}
		for _, s in ipairs(elems) do
			table.insert(steps, { key = s.key, name = s.name, hold = false })
			table.insert(steps, { key = cbKey, name = "차지 블로우", hold = true })
		end
		if divineKey ~= nil then
			table.insert(steps, { key = divineKey, name = "디바인 차지(복귀)", hold = false })
		end
		self._T.comboSteps = steps
		self._T.comboStep = 1
		self._T.comboNextAt = now
		-- (요청 보강) 속성 합성을 더 자주 쓰도록 주기 단축 (25~40초 → 14~22초)
		self._T.nextElemCombo = now + 14.0 + _UtilLogic:RandomDouble() * 8.0
		log("[AutoHunt] 속성 콤보 선설치 시작 (" .. tostring(#steps) .. "스텝)")
		return true
	end

	-- 버프별 재시전 주기(초). 대부분 5분 버프라 270초, 콤보 어택은 30분 버프라 25분(1500초).
	-- 자동사냥 ON 직후에는 lastCast가 비어 있어 어떤 주기든 즉시 1회 시전된다 - "꺼져 있으면 바로 켠다".
	@ExecSpace("ClientOnly")
	method number GetBuffPeriod(string skillName)
		if skillName == "콤보 어택" then return 1500.0 end
		-- (팔라딘) 지속시간이 투자 레벨 비례인 버프는 만료 2초 전에 갱신한다.
		if skillName == "아이언 월" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("아이언 월"))
			return math.max(10.0, 30.0 + 20.0 * (lv - 1) - 2.0)
		end
		if skillName == "속성필드" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("속성필드"))
			return math.max(10.0, 60.0 + 20.0 * (lv - 1) - 2.0)
		end
		-- (나이트로드) 암행 - 1분 + 분배당 10초. 만료 2초 전에 갱신한다.
		if skillName == "암행" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("암행"))
			return math.max(10.0, _SkillManager:GetAmhaengDuration(lv) - 2.0)
		end
		-- (섀도어) 암행2 - 암행1과 완전히 같은 지속시간 공식(GetAmhaengDuration)을 쓴다.
		if skillName == "암행2" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("암행2"))
			return math.max(10.0, _SkillManager:GetAmhaengDuration(lv) - 2.0)
		end
		-- (나이트로드) 쉐도우 파트너 - 30초 + 분배당 10초. 표창 100개를 먹지만 재고가 모자라면
		-- 낮은 번호 표창으로 자동 폴백하므로 주기 유지만 하면 된다.
		if skillName == "쉐도우 파트너" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("쉐도우 파트너"))
			return math.max(10.0, _SkillManager:GetShadowPartnerDurationForLevel(lv) - 2.0)
		end
		-- (히어로) 발도술도 지속시간이 투자 레벨 비례(30초 + 분배당 20초) - 만료 2초 전에 갱신한다.
		if skillName == "발도술" then
			local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("발도술"))
			return math.max(10.0, 30.0 + 20.0 * (lv - 1) - 2.0)
		end
		return 270.0
	end

	-- 버프(스킬별 주기 유지)·소환수(재소환 주기 290초)를 하나씩 돌아가며 유지한다.
	-- 이번 틱에 유틸 스킬을 시전했으면 true (공격은 다음 틱에).
	-- (나이트로드) 각성이 지금 켜져 있는가 - 제자리 사냥 판정에 쓴다.
	@ExecSpace("ClientOnly")
	method boolean IsAwakeningOn()
		return _SkillManager:IsAwakeningActive()
	end

	@ExecSpace("ClientOnly")
	method boolean HasPendingUtility(number now)
		-- 지금 "쓰고 싶은 유틸 스킬"이 하나라도 있는가. 암살 잠금을 풀지 말지 정하는 데만 쓴다
		-- (아래 TryUtilityCast의 실제 조건들 중 시간/쿨 게이트만 싸게 재확인한다).
		if self._T.lastCast == nil then return true end
		if self._T.slotBuffs ~= nil then
			for _, s in ipairs(self._T.slotBuffs) do
				if now - (self._T.lastCast[s.name] or -99999) >= self:GetBuffPeriod(s.name) then return true end
			end
		end
		if self._T.slotSummons ~= nil then
			for _, s in ipairs(self._T.slotSummons) do
				if now - (self._T.lastCast[s.name] or -99999) >= 290.0 then return true end
			end
		end
		if self._T.slotShadowClones ~= nil and #self._T.slotShadowClones > 0
			and _SkillManager:CanAutoSummonShadowClone() then return true end
		if self._T.slotSmokeScreens ~= nil and #self._T.slotSmokeScreens > 0
			and _SkillManager:CanAutoCastSmokeScreen() then return true end
		if self._T.slotDarkSights ~= nil and #self._T.slotDarkSights > 0
			and (self._T.nextDarkSight or 0) <= now and _SkillManager:CanAutoCastDarkSight() then return true end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean TryUtilityCast(number now)
		if (self._T.nextUtil or 0) > now then return false end
		if self._T.lastCast == nil then self._T.lastCast = {} end
		-- (버그 수정 2026-08-06) **암살 잠금이 유틸 스킬을 영영 굶긴다.**
		-- 암살로 사라져 있는 동안에는 UseSkillInSlot이 암살 외 모든 스킬을 거부하는데(의도된 규칙),
		-- 자동사냥이 암살을 주력으로 쓰면 홀드가 매 시전마다 갱신돼 그 구간이 끊기지 않는다.
		-- 실측: 20초 동안 "암살 중 - 다른 스킬 사용 불가 (분신 소환/연막/다크사이트/어썰터)"만 반복되고
		-- **분신이 한 번도 소환되지 않았다** - "분신이 공격을 안 한다"의 진짜 원인이었다.
		-- → 쓸 유틸이 실제로 밀려 있을 때만 홀드를 풀고, 잠깐(1.2초) 암살을 쉬어 시전 창을 만든다.
		if _SkillManager:IsAssassinateActive() then
			if self:HasPendingUtility(now) then
				_SkillManager:ReleaseAssassinateHold()
				self._T.assassinatePauseUntil = now + 1.2
				log("[AutoHunt] 암살 홀드 해제 - 밀린 유틸 스킬 시전 창 확보")
			end
			return false
		end
		-- (나이트로드, 요청 2026-08-06) 마크 오브 어쌔신: 배워뒀는데 꺼져 있으면 켠다(토글 ON 유지 -
		-- 자동사냥은 표창 소모 2배를 감수하고 표식 딜을 쓴다). 즉시 동작이라 return하지 않는다.
		if (self._T.nextMarkCheck or 0) <= now then
			self._T.nextMarkCheck = now + 5.0
			if not _SkillManager:IsAssassinMarkEnabled()
				and _SkillManager:GetHeroSkillLevelByName("마크 오브 어쌔신") >= 1 then
				_SkillManager:SetAssassinMarkEnabled(true)
				log("[AutoHunt] 마크 오브 어쌔신 자동 ON")
			end
		end
		-- (나이트로드, 요청 2026-08-06) 표창+ 주기 교체: 표창이 2종 이상 열려 있으면 10초~3분 랜덤
		-- 주기로 갈아끼우며 사냥한다. (요청 보강 2026-08-06) **가능한 높은 등급 우선** - 재고가
		-- 넉넉한(40개↑) 2번 이상 표창만 후보로, 번호가 높을수록 가중 2배씩(최고 등급 위주 + 약간의
		-- 다양성). 1번(무제한 기본 표창)은 다른 표창 재고가 전부 바닥일 때만 고른다 - 사냥 중
		-- 소진 시 낮은 번호로 내려가는 폴백은 TryConsumeShuriken이 따로 처리한다.
		-- 다른 유틸 시전을 막지 않는 즉시 동작이라 return하지 않는다.
		if _SkillManager:GetUnlockedShurikenCount() >= 2 then
			if (self._T.nextShurikenSwap or 0) <= now then
				local unlocked = _SkillManager:GetUnlockedShurikenCount()
				self._T.nextShurikenSwap = now + 10.0 + _UtilLogic:RandomDouble() * 170.0
				local cands = {}
				local total = 0
				for i = 2, unlocked do
					if _SkillManager:GetShurikenCount(i) >= 40 then
						local w = 2 ^ (i - 1)
						table.insert(cands, { idx = i, w = w })
						total = total + w
					end
				end
				local pick = 1
				if total > 0 then
					local r = _UtilLogic:RandomDouble() * total
					pick = cands[#cands].idx
					for _, c in ipairs(cands) do
						r = r - c.w
						if r <= 0 then
							pick = c.idx
							break
						end
					end
				end
				_SkillManager:AutoSelectShuriken(pick)
			end
		end
		-- (나이트로드, 요청) 각성은 쿨(5분 고정)이 돌면 **가장 먼저** 쓴다 - 지속 39초 동안 공속 +15단계에
		-- 표창 3종이 드래곤 로어 범위를 전부 조준하므로 아껴 봐야 손해다. 이미 켜져 있으면 건너뛴다.
		-- 실제 쿨 판정은 SkillManager의 전용 게이트가 하므로 여기서는 20초마다 조회만 재시도한다.
		if self._T.slotAwakenings ~= nil and #self._T.slotAwakenings > 0 then
			if (self._T.nextAwakening or 0) <= now and not self:IsAwakeningOn() then
				self._T.nextAwakening = now + 20.0
				if _SkillManager:CanAutoCastAwakening() then
					self._T.nextUtil = now + 1.2
					self._T.holdMoveUntil = now + 1.0
					_SkillManager:UseSkillInSlot(self._T.slotAwakenings[1].key)
					log("[AutoHunt] 각성 시전 (쿨 종료 - 즉시 사용)")
					return true
				end
			end
		end
		if self._T.slotBuffs ~= nil then
			for _, s in ipairs(self._T.slotBuffs) do
				local last = self._T.lastCast[s.name] or -99999
				if now - last >= self:GetBuffPeriod(s.name) then
					self._T.lastCast[s.name] = now
					self._T.nextUtil = now + 1.2   -- 유틸은 1.2초에 하나씩 (시전 모션 겹침 방지)
					self._T.holdMoveUntil = now + 1.0   -- 시전 모션 동안 이동 금지
					_SkillManager:UseSkillInSlot(s.key)
					log("[AutoHunt] 유지 시전: " .. s.name .. " (" .. s.key .. ")")
					return true
				end
			end
		end
		if self._T.slotSummons ~= nil then
			for _, s in ipairs(self._T.slotSummons) do
				local last = self._T.lastCast[s.name] or -99999
				-- (다크나이트) 서먼 다크드래곤은 지속 200~600초 + 쿨타임 10분(2026-08-04 개편)이라, 기본
				-- 290초 주기로 재시도하면 거부만 반복된다 - 쿨 종료 직후(605초)에 재소환하도록 전용 주기.
				local period = 290.0
				if s.name == "서먼 다크드래곤" then period = 605.0 end
				if now - last >= period then
					self._T.lastCast[s.name] = now
					self._T.nextUtil = now + 1.2
					self._T.holdMoveUntil = now + 1.0
					_SkillManager:UseSkillInSlot(s.key)
					log("[AutoHunt] 유지 시전: " .. s.name .. " (" .. s.key .. ")")
					return true
				end
			end
		end
		-- (다크나이트) 드래곤 라이딩: 미소환 + 재사용 대기 종료 상태에서만 "소환"으로 사용한다.
		-- 활성 중 재시전은 탑승 토글이라 CanAutoSummonDragonRide가 막는다(자동사냥은 절대 탑승하지 않음).
		if self._T.slotDragonRides ~= nil and #self._T.slotDragonRides > 0 then
			if (self._T.nextDragonRide or 0) <= now then
				self._T.nextDragonRide = now + 20.0   -- 조회 재시도 간격(실제 재소환은 자체 쿨 5분이 게이트)
				if _SkillManager:CanAutoSummonDragonRide() then
					self._T.nextUtil = now + 1.2
					self._T.holdMoveUntil = now + 1.0
					_SkillManager:UseSkillInSlot(self._T.slotDragonRides[1].key)
					log("[AutoHunt] 드래곤 라이딩 소환 (자동사냥은 탑승하지 않음)")
					return true
				end
			end
		end
		-- (다크나이트) 드래곤 블러드: HP를 계속 소모하는 유지형(10초마다 최대 HP 4%, 10% 이하 자동해제).
		-- 주기 재시전 대신 버프바 잔여로 꺼짐(자동해제 포함)을 감지해 재점화하되, HP 50% 미만이면
		-- 켜자마자 다시 자동해제로 떨어지는 낭비라 HP가 회복될 때까지 기다린다.
		if self._T.slotDragonBloods ~= nil and #self._T.slotDragonBloods > 0 then
			if (self._T.nextDragonBlood or 0) <= now then
				self._T.nextDragonBlood = now + 10.0
				if _DragonBloodBuffUI:GetRemaining() <= 3.0 then
					local playerDB = _UserService.LocalPlayer
					if isvalid(playerDB) then
						local pcDB = playerDB.PlayerComponent
						if isvalid(pcDB) and (pcDB.MaxHp or 0) > 0 and (pcDB.Hp or 0) / pcDB.MaxHp >= 0.5 then
							self._T.nextUtil = now + 1.2
							self._T.holdMoveUntil = now + 1.0
							_SkillManager:UseSkillInSlot(self._T.slotDragonBloods[1].key)
							log("[AutoHunt] 드래곤 블러드 재점화 (HP " .. tostring(pcDB.Hp) .. "/" .. tostring(pcDB.MaxHp) .. ")")
							return true
						end
					end
				end
			end
		end
		-- (팔라딘) 리스토네이션: HP가 풀이 아닐 때만 30~60초 랜덤 주기로 사용 (요청).
		if self._T.slotRestorations ~= nil and #self._T.slotRestorations > 0 then
			if (self._T.nextRestoration or 0) <= now then
				local player = _UserService.LocalPlayer
				if isvalid(player) then
					local pc = player.PlayerComponent
					if isvalid(pc) and (pc.Hp or 0) < (pc.MaxHp or 0) then
						self._T.nextRestoration = now + 30.0 + _UtilLogic:RandomDouble() * 30.0
						self._T.nextUtil = now + 1.2
						self._T.holdMoveUntil = now + 1.0
						_SkillManager:UseSkillInSlot(self._T.slotRestorations[1].key)
						log("[AutoHunt] 리스토네이션 시전 (HP " .. tostring(pc.Hp) .. "/" .. tostring(pc.MaxHp) .. ")")
						return true
					end
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 분신 소환: 미소환 + 재사용 대기(5분) 종료 상태에서만 소환한다.
		-- ⚠ 살아 있을 때 다시 누르면 위치 교환이라 절대 재시전하지 않는다(CanAutoSummonShadowClone).
		if self._T.slotShadowClones ~= nil and #self._T.slotShadowClones > 0 then
			if (self._T.nextShadowClone or 0) <= now then
				self._T.nextShadowClone = now + 15.0   -- 조회 재시도 간격(실제 게이트는 자체 쿨 5분)
				if _SkillManager:CanAutoSummonShadowClone() then
					self._T.nextUtil = now + 1.2
					self._T.holdMoveUntil = now + 1.0
					_SkillManager:UseSkillInSlot(self._T.slotShadowClones[1].key)
					log("[AutoHunt] 분신 소환 (자동사냥은 위치 교환을 쓰지 않는다)")
					return true
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 연막: 암살이 강화되는 구간이라 재사용 대기시간(3분)이 돌면
		-- 바로 깐다. 다만 광역 강화라 혼자 있는 몬스터 하나에 쓰면 낭비 - 주변에 2마리 이상일 때만.
		-- (연막 안에서의 스킬 선택 비율은 TryAttackCast의 섀도어 블록이 담당한다.)
		if self._T.slotSmokeScreens ~= nil and #self._T.slotSmokeScreens > 0 then
			if (self._T.nextSmokeScreen or 0) <= now then
				self._T.nextSmokeScreen = now + 10.0   -- 조회 재시도 간격(실제 게이트는 자체 쿨 3분)
				local playerSS = _UserService.LocalPlayer
				if isvalid(playerSS) and _SkillManager:CanAutoCastSmokeScreen() then
					local ppSS = playerSS.TransformComponent.WorldPosition
					if self:CountNearbyMonsters(playerSS, ppSS, 3.0) >= 2 then
						self._T.nextUtil = now + 1.2
						self._T.holdMoveUntil = now + 1.0
						_SkillManager:UseSkillInSlot(self._T.slotSmokeScreens[1].key)
						log("[AutoHunt] 연막 시전 (암살 강화 구간 진입)")
						return true
					end
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 다크사이트: "가끔" = 재사용 대기시간 ~ 그 4배 사이 랜덤 주기.
		-- 켜고 나면 3~10초 뒤에 적의 뒤를 잡아 때린다(DarkSightAmbushTick) - 그 사이에는 어떤 공격도
		-- 하지 않는다(공격 동작 자체가 은신을 풀기 때문).
		if self._T.slotDarkSights ~= nil and #self._T.slotDarkSights > 0 then
			if (self._T.nextDarkSight or 0) <= now and not _SkillManager:IsDarkSightActive() then
				if _SkillManager:CanAutoCastDarkSight() and isvalid(self._T.target) then
					local dsCd = math.max(1.0, _SkillManager:GetDarkSightAutoCooldown())
					self._T.nextDarkSight = now + dsCd + _UtilLogic:RandomDouble() * dsCd * 3.0
					-- 기습 시각: (요청 2026-08-06) **주변에 적이 있으면 1초 뒤** 바로 친다.
					-- 적이 없을 때만 2~5초 기다리며 뒤를 잡을 자리를 찾는다(잠복이 의미 있는 경우).
					local dsPlayer = _UserService.LocalPlayer
					local dsNear = 0
					if isvalid(dsPlayer) then
						dsNear = self:CountNearbyMonsters(dsPlayer, dsPlayer.TransformComponent.WorldPosition, 3.0)
					end
					if dsNear > 0 then
						self._T.dsAmbushAt = now + 1.0
					else
						self._T.dsAmbushAt = now + 2.0 + _UtilLogic:RandomDouble() * 3.0
					end
					-- 뒤를 못 잡고 이 시각을 넘기면 그냥 평소대로 싸운다(은신은 첫 공격에 알아서 풀린다).
					self._T.dsAmbushDeadline = self._T.dsAmbushAt + 6.0
					self._T.nextUtil = now + 1.2
					_SkillManager:UseSkillInSlot(self._T.slotDarkSights[1].key)
					log("[AutoHunt] 다크사이트 잠복 시작 (기습 "
						.. string.format("%.1f", self._T.dsAmbushAt - now) .. "초 뒤 / 다음 주기 "
						.. string.format("%.0f", self._T.nextDarkSight - now) .. "초)")
					return true
				end
				-- 아직 쿨이거나 대상이 없으면 짧게 뒤에 다시 본다(주기를 소모하지 않는다).
				self._T.nextDarkSight = math.max(self._T.nextDarkSight or 0, now + 2.0)
			end
		end
		-- (팔라딘) 궁병 지원: 120~150초 랜덤 주기로 사용 (요청).
		if self._T.slotArchers ~= nil and #self._T.slotArchers > 0 then
			if (self._T.nextArcher or 0) <= now then
				self._T.nextArcher = now + 120.0 + _UtilLogic:RandomDouble() * 30.0
				self._T.nextUtil = now + 1.2
				self._T.holdMoveUntil = now + 1.0
				_SkillManager:UseSkillInSlot(self._T.slotArchers[1].key)
				log("[AutoHunt] 궁병 지원 시전")
				return true
			end
		end
		return false
	end

	-- 공격 스킬 가중 랜덤 선택: 주변 3마리 이상이면 광역 가중↑, 아니면 균등.
	-- 상위 호환 규칙: 브랜디쉬가 배정돼 있으면 파워스트라이크/슬래시블러스트는 확률 1%로 강등
	-- (요청 사양 - 하위 스킬은 거의 쓰지 않고 브랜디쉬 위주로). (실쿨/미배정 처리는 SkillManager가 담당)
	@ExecSpace("ClientOnly")
	method void TryAttackCast(number now, Entity player, Vector3 pp)
		if (self._T.nextAtk or 0) > now then return end
		-- (나이트로드, 요청 2026-08-05) 각성 중에는 공속 +15단계로 스킬 쿨(0.73~0.80×공속)이 0.2초
		-- 안팎까지 줄어든다 - 0.5초 고정 틱이면 대부분을 흘려보내므로, "스킬 키를 누르고 있는 것처럼"
		-- 공속에 맞춰 틱을 좁힌다(하한 0.12초).
		local awakeningOn = self:IsAwakeningOn()
		local atkTick = 0.5
		if awakeningOn then
			atkTick = math.max(0.12, 0.85 * _CharInfoManager:GetAttackSpeedMultiplier())
		end
		self._T.nextAtk = now + atkTick
		-- (헛빵 수정) 시전 직전 재검증: 0.5초 주기 사이에 대상이 죽었거나 스킬 실판정 반경(1.5)
		-- 밖으로 벗어났으면 이번 시전을 건너뛴다 - 파스/슬블/차지 블로우 허공 시전 방지.
		local target = self._T.target
		if target == nil or not isvalid(target) then return end
		local monChk = target:GetComponent("script.Monster")
		if monChk == nil or monChk.IsDead == true then
			self._T.target = nil
			return
		end
		local tp = target.TransformComponent.WorldPosition
		local cdx = tp.x - pp.x
		local cdy = tp.y - pp.y
		-- (버그 수정 2026-08-05) 각성 제자리 사냥은 드래곤 로어 범위(±15/±7.5)의 대상을 그대로 두고
		-- 시전하는데, 이 사거리 게이트(1.3)가 그 대상을 걸러버려 제자리에서 아무것도 안 하고 서 있었다.
		-- 각성 + 표창 슬롯이면 로어 범위까지 허용한다(표창 3종이 방향 무관 자동조준하므로 헛빵이 아니다).
		-- (신고 2026-08-06) "연막을 쓰고 허공에다가 새비지 블로우를 쓴다"
		-- 연막 저격 구간에서는 대상이 최대 9유닛 밖에 있는데, 그 거리를 닿는 것은 **암살뿐**이다.
		-- 아래 로테이션이 근접 스킬(새비지블로우/어썰터/더블스탭)을 뽑으면 그대로 허공을 때린다 -
		-- "근접 사거리 밖에서의 저격인가"를 여기서 기억해 두고, 가중 계산 마지막에 암살만 남긴다.
		-- (신궁, 요청 2026-08-07) 아이언 에로우 = **닿지 않는 거리 전용**(공용 메서드).
		-- 제자리 사냥 분기(각성/연막)에서 여기까지 오는 경우를 위해 근접 게이트보다 먼저 한 번 본다.
		if self:TryIronArrowRanged(now, player, cdx, cdy) then return end
		local smokeSniping = false
		if awakeningOn and self:HasStarThrowSlot() then
			if math.abs(cdx) > 15.0 or math.abs(cdy) > 7.5 then return end
		elseif self:ShouldSnipeWithAssassinate(cdx, cdy) then
			-- 연막 중 암살 사거리(9유닛) 안이면 붙지 않고 그대로 시전한다.
			smokeSniping = math.sqrt(cdx * cdx + cdy * cdy) > 1.3
		else
			if math.sqrt(cdx * cdx + cdy * cdy) > 1.3 then return end
		end
		-- (헛빵 수정 2) 방향 전환 직후 0.25초는 시전 보류 - 서버의 LookDirectionX 복제가 아직 옛
		-- 방향이라 등 뒤로 시전됐다. 잠깐 기다렸다 재시도한다.
		-- (각성 예외) 각성 중 표창 3종은 방향 무관 조준이라 등 뒤 판정이 없다 - 보류 없이 바로 던진다.
		if not awakeningOn and (now - (self._T.dirChangedAt or -99)) < 0.25 then
			self._T.nextAtk = now + 0.15
			return
		end
		-- (사용자 신고) 점프 중(공중) 시전 금지 - 타격 판정은 시전 0.25초 뒤 그 시점 위치의 전방
		-- 박스(위 1.0/아래 0.5)라, 상승/하강 중에 쏘면 판정 순간 높이가 어긋나 빗맞는다. 지상에서만 쏜다.
		local rbAtk = player.RigidbodyComponent
		if isvalid(rbAtk) and not rbAtk:IsOnGround() then
			self._T.nextAtk = now + 0.15
			return
		end
		-- 대상이 현재 바라보는 방향의 뒤쪽이면 이번 틱은 방향만 맞추고 시전하지 않는다 (전방 박스 판정).
		-- (각성 예외) 방향 무관 조준이라 몸만 돌려두고 시전은 미루지 않는다.
		local pccDir = player.PlayerControllerComponent
		if isvalid(pccDir) and math.abs(cdx) > 0.05 then
			local wantDir = (cdx > 0) and 1 or -1
			if pccDir.LookDirectionX ~= wantDir then
				pccDir.LookDirectionX = wantDir
				self._T.dirChangedAt = now
				if not awakeningOn then
					self._T.nextAtk = now + 0.15
					return
				end
			end
		end
		-- (섀도어, 요청 2026-08-06) 다크사이트 잠복 중에는 **아무 공격도 하지 않는다** - 어떤 공격
		-- 동작이든 은신이 풀리기 때문이다.
		--   · 기습 시각(시전 3~10초 뒤) 전이면 무조건 참는다.
		--   · 기습 시각이 지났으면 **대상의 뒤를 잡았을 때만** 시전한다(그 한 방이 백스탭 + 다크사이트 딜).
		--   · 마감(기습 시각 +6초)까지 뒤를 못 잡으면 포기하고 평소대로 싸운다(첫 공격에 은신은 풀린다).
		if _SkillManager:IsDarkSightActive() and (self._T.dsAmbushDeadline or 0) > now then
			if now < (self._T.dsAmbushAt or 0) then
				self._T.nextAtk = now + 0.2
				return
			end
			local behindDir = self:GetBehindDirOfTarget(target)
			if ((pp.x - tp.x) * behindDir) <= 0 then
				self._T.nextAtk = now + 0.2
				return
			end
			self._T.dsAmbushDeadline = 0
			log("[AutoHunt] 다크사이트 기습 - 적 뒤를 잡고 시전")
		end
		-- (나이트로드, 요청 2026-08-05) 드레인 샷 = HP 보충기: HP가 90% 아래고 자체 쿨(5초)이 돌았으면
		-- 로테이션을 기다리지 않고 우선 사용한다. 대상이 사거리에 있는 지금이 기회다 - 맞혀야 회복된다.
		if self._T.slotDrainShots ~= nil and #self._T.slotDrainShots > 0
			and (self._T.nextDrainShot or 0) <= now then
			local pcDS = player.PlayerComponent
			if isvalid(pcDS) and (pcDS.MaxHp or 0) > 0 and (pcDS.Hp / pcDS.MaxHp) < 0.90 then
				self._T.nextDrainShot = now + 5.5
				self._T.holdMoveUntil = now + 0.8 * _CharInfoManager:GetAttackSpeedMultiplier()
				_SkillManager:UseSkillInSlot(self._T.slotDrainShots[1].key)
				log("[AutoHunt] 드레인 샷 (HP 보충)")
				return
			end
		end
		-- (신궁, 요청 2026-08-06) 스나이핑은 확률 로테이션이 아니라 자기 규칙으로 먼저 판단한다 -
		-- 좌우 직선만 때리는 관통 3명 차지기라 "전방 직선에 적이 2마리 이상"일 때만 쓰고,
		-- 차징 시간은 대상 HP 비율에 맞춘다(다 죽어가는 적에게 10초를 모으지 않는다).
		if self:TrySnipingCast(now, player, pp, target) then return end
		-- (신궁 2026-08-06) 피어싱도 같은 자기 규칙 차지기 - 스나이핑이 안 나갔을 때만 시도한다
		-- (둘 다 차지라 겹치면 서로의 차지를 취소한다).
		if self:TryPiercingCast(now, player, pp, target) then return end
		-- 다수 판정: 사거리권(1.6유닛)에 2마리 이상이면 광역 우선 (요청 - 다수면 슬래시블러스트 > 파워스트라이크)
		local nearby = self:CountNearbyMonsters(player, pp, 1.6)
		local crowded = (nearby >= 2)
		-- 돌진 각 판정: 바라보는 방향 전방 3유닛 직선상의 적 수 - 2마리 이상이면 밀어서 모을 수 있는 각
		local lookDir = 1
		local pccLook = player.PlayerControllerComponent
		if isvalid(pccLook) and pccLook.LookDirectionX < 0 then lookDir = -1 end
		local frontCount = self:CountMonstersInFront(player, pp, lookDir, 3.0)

		-- (요청) 상황별 가중: 1명일 땐 광역(슬래시블러스트 등) 확률을 확 낮추고(0.15),
		-- 다수일 땐 단일기(파워스트라이크 등) 확률을 확 낮춘다(0.15).
		local pool = {}
		if self._T.slotAoes ~= nil then
			for _, s in ipairs(self._T.slotAoes) do
				table.insert(pool, { key = s.key, name = s.name, w = crowded and 3.0 or 0.15 })
			end
		end
		if self._T.slotSingles ~= nil then
			for _, s in ipairs(self._T.slotSingles) do
				table.insert(pool, { key = s.key, name = s.name, w = crowded and 0.15 or 1.0 })
			end
		end

		-- 상위 호환 강등: 브랜디쉬 보유 시 하위 스킬 가중치 ×0.01 (≈1%)
		local hasBrandish = false
		local hasChargeBlow = false
		local hasSpearBurst = false
		for _, c in ipairs(pool) do
			if c.name == "브랜디쉬" then hasBrandish = true end
			if c.name == "차지 블로우" then hasChargeBlow = true end
			if c.name == "스피어 버스터" then hasSpearBurst = true end
		end
		if hasBrandish then
			for _, c in ipairs(pool) do
				if c.name == "파워스트라이크" or c.name == "슬래시블러스트" then
					c.w = c.w * 0.01
				end
			end
		end
		-- (다크나이트) 스피어 버스터 보유 시: 브랜디쉬/차지 블로우와 같은 상위 호환 규칙으로
		-- 파스/슬블을 1%로 강등하고 스피어 버스터가 주력이 된다(단독 대상에게도 기본 가중 1.0).
		if hasSpearBurst then
			for _, c in ipairs(pool) do
				if c.name == "파워스트라이크" or c.name == "슬래시블러스트" then
					c.w = c.w * 0.01
				elseif c.name == "스피어 버스터" and not crowded then
					c.w = 1.0
				end
			end
		end
		-- (팔라딘, 요청) 차지 블로우 보유 시: 파스/슬블은 1%로 강등하고 차지 블로우가 주력
		-- (단독 대상에게도 광역 강등 없이 기본 가중 1.0, 다수면 3.0 유지).
		if hasChargeBlow then
			for _, c in ipairs(pool) do
				if c.name == "파워스트라이크" or c.name == "슬래시블러스트" then
					c.w = c.w * 0.01
				elseif c.name == "차지 블로우" and not crowded then
					c.w = 1.0
				end
			end
		end

		-- (나이트로드, 요청 2026-08-05) 표창 상위호환 강등 - 브랜디쉬 규칙과 동일:
		-- 트리플 스로우 보유 시 럭키세븐 ×0.01, 쿼드러플 스로우 보유 시 트리플 스로우 ×0.01
		-- (셋 다 있으면 럭키세븐은 트리플의 1%의 다시 일부라 사실상 안 나온다).
		local hasTripleThrow = false
		local hasQuadThrow = false
		local hasAvenger = false
		for _, c in ipairs(pool) do
			if c.name == "트리플 스로우" then hasTripleThrow = true end
			if c.name == "쿼드러플 스로우" then hasQuadThrow = true end
			if c.name == "어벤져" then hasAvenger = true end
		end
		if hasTripleThrow then
			for _, c in ipairs(pool) do
				if c.name == "럭키세븐" then c.w = c.w * 0.01 end
			end
		end
		if hasQuadThrow then
			for _, c in ipairs(pool) do
				if c.name == "트리플 스로우" then c.w = c.w * 0.01 end
			end
		end
		-- (나이트로드, 요청 2026-08-05) 어벤져 우선: 어벤져는 관통 광역이라, 전방 직선(관통 사거리
		-- 8유닛)에 서로 떨어져 늘어선 적이 **5마리 이상**이면 트리플/쿼드러플보다 이득이다 -
		-- 표창 상위기들의 현재 가중(강등/몰림 보정 후)의 3배로 올린다.
		if hasAvenger then
			local avFront = self:CountMonstersInFront(player, pp, lookDir, 8.0)
			if avFront >= 5 then
				local starW = 0
				for _, c in ipairs(pool) do
					if (c.name == "쿼드러플 스로우" or c.name == "트리플 스로우" or c.name == "럭키세븐")
						and c.w > starW then
						starW = c.w
					end
				end
				local avW = math.max(starW, 0.15) * 3.0
				for _, c in ipairs(pool) do
					if c.name == "어벤져" and c.w < avW then c.w = avW end
				end
			end
			-- (요청 2026-08-06) 각성 중에는 어벤져를 거의 쓰지 않는다(×2%) - 각성은 표창 3종이
			-- 로어 범위 자동조준 + 전탄 크리티컬이 되는 구간이라 표창 연사가 압도적으로 이득.
			-- 위 전방 5마리 부스트가 걸렸더라도 이 감쇠가 마지막에 덮는다.
			if awakeningOn then
				for _, c in ipairs(pool) do
					if c.name == "어벤져" then c.w = c.w * 0.02 end
				end
			end
		end

		-- ── (섀도어, 요청 2026-08-06) 로테이션 ────────────────────────────────
		-- 상위 호환: 새비지블로우 > 더블스탭 (둘 다 배정돼 있으면 더블스탭은 1%).
		-- 4차: 암살이 주력(다수기) - 새비지블로우는 10%이고 그마저도 주변 적이 적을 때 위주.
		-- 연막 안: 어썰터 5% / 암살 92% / 새비지블로우 3%. 단 연막 안 적이 1~2명이면 새비지블로우.
		local hasSavage, hasAssassinate, hasDoubleStab, hasAssaulter = false, false, false, false
		for _, c in ipairs(pool) do
			if c.name == "새비지블로우" then hasSavage = true end
			if c.name == "암살" then hasAssassinate = true end
			if c.name == "더블스탭" then hasDoubleStab = true end
			if c.name == "어썰터" then hasAssaulter = true end
		end
		-- 어썰터 (신고: "연속으로 쓸 때도 있고 아예 안 쓸 때도 있다") - 스택이 찰 때마다 즉시 터지고
		-- 3스택이 쌓이면 세 번 연달아 나가던 것이 원인이다. **스택 보유 + 최소 간격** 두 조건을 함께
		-- 걸어 충전 리듬(1개당 10→5초)에 맞춰 띄엄띄엄 나가게 한다.
		if hasAssaulter then
			local asLvAuto = math.max(1, _SkillManager:GetHeroSkillLevelByName("어썰터"))
			self._T.assaulterSpacing = _SkillManager:GetAssaulterChargeSeconds(asLvAuto) * 0.9
			local asReady = (_SkillManager:GetAssaulterStacks() >= 1) and ((self._T.nextAssaulter or 0) <= now)
			if not asReady then
				for _, c in ipairs(pool) do
					if c.name == "어썰터" then c.w = 0 end
				end
			end
		end
		if hasSavage and hasDoubleStab then
			for _, c in ipairs(pool) do
				if c.name == "더블스탭" then c.w = c.w * 0.01 end
			end
		end
		if hasAssassinate then
			local smokeOn = _SkillManager:IsSmokeScreenActiveLocal()
			for _, c in ipairs(pool) do
				if smokeSniping then
					-- (버그 수정 2026-08-06, 신고 "연막 쓰고 허공에 새비지 블로우")
					-- 연막 저격 거리(근접 밖 ~ 9유닛)에서는 **암살만 닿는다**. 아래 "적이 1~2명이면
					-- 새비지블로우 100%" 규칙은 주변 적 수를 **플레이어 기준**으로 세는데, 저격 중에는
					-- 대상이 멀어 항상 0~2명으로 잡힌다 - 그래서 근접기인 새비지블로우가 100%로 뽑혀
					-- 허공을 때리고 있었다. 저격 거리에서는 암살에만 가중을 준다.
					-- ⚠ 여기서 암살 가중을 반드시 살려 둬야 한다 - 0으로 두면 아래 안전망에 걸려
					--   "저격 중 아무것도 못 쏘고 굳어버리는" 반대쪽 사고가 난다.
					if c.name == "암살" then c.w = 100.0 else c.w = 0 end
				elseif smokeOn and nearby <= 2 then
					-- 연막 안이지만 적이 1~2명 - 단일 대상 화력이 더 센 새비지블로우로 간다(요청).
					-- (근접 사거리 안일 때만 여기 온다 - 위 저격 분기가 먼저 걸러낸다.)
					if c.name == "새비지블로우" then c.w = 100.0
					elseif c.name == "암살" or c.name == "어썰터" then c.w = 0 end
				elseif smokeOn then
					if c.name == "암살" then c.w = 92.0
					elseif c.name == "어썰터" then c.w = (c.w > 0) and 5.0 or 0
					elseif c.name == "새비지블로우" then c.w = 3.0 end
				else
					if c.name == "암살" then c.w = 90.0
					elseif c.name == "새비지블로우" then c.w = (nearby <= 2) and 10.0 or 3.0
					elseif c.name == "어썰터" then c.w = (c.w > 0) and ((nearby >= 3) and 20.0 or 5.0) or 0 end
				end
			end
			-- (버그 수정 2026-08-06) 유틸 시전 창(1.2초) 동안은 암살을 쉰다 - 안 그러면 다음 틱에 다시
			-- 암살이 나가 잠금이 곧바로 걸려 분신 소환/연막/다크사이트가 또 밀린다.
			-- ⚠ 위 확률표가 암살 가중을 덮어쓰므로 **반드시 그 뒤**에서 0으로 만든다.
			if (self._T.assassinatePauseUntil or 0) > now then
				for _, c in ipairs(pool) do
					if c.name == "암살" then c.w = 0 end
				end
			end
		end

		-- ── (신궁, 요청 2026-08-06) 로테이션 ──────────────────────────────────
		-- ① 더블샷 ↔ 에로우 블로우는 **비슷한 비율**로 상황에 따라 갈린다 - 에로우 블로우는 강화를
		--    배우면 적중 지점에서 폭발해 주변 5명을 때리므로 **뭉쳤을 때 유리**하다.
		-- ② 차수 사다리: 퀵슬롯에 **더 높은 차수의 신궁 공격기**가 함께 있으면 아래 차수는 1%로 강등한다
		--    (브랜디쉬/차지 블로우/표창 상위호환과 같은 관례).
		--      1차 = 더블샷·에로우 블로우 / 2차 = 아이언 에로우 / 3차↑ = 스트레이프·아이스 샷·파이어 샷·속사·폭풍의 시
		-- ③ 스트레이프는 **단일 대상**에 강하고, 적이 뭉치면 **아이스 샷**이 주력이 된다.
		local hasDoubleShot, hasArrowBlow, hasIronArrow = false, false, false
		local hasHigherArcher = false
		for _, c in ipairs(pool) do
			if c.name == "더블샷" then hasDoubleShot = true end
			if c.name == "에로우 블로우" then hasArrowBlow = true end
			if c.name == "아이언 에로우" then hasIronArrow = true end
			if c.name == "스트레이프" or c.name == "아이스 샷" or c.name == "파이어 샷"
				or c.name == "속사" or c.name == "폭풍의 시" then
				hasHigherArcher = true
			end
		end
		if hasDoubleShot or hasArrowBlow or hasIronArrow then
			-- ① 1차 두 스킬의 상황 가중. 뭉치면 에로우 블로우(폭발), 단독이면 더블샷(2발) 쪽으로 기운다.
			--    어느 쪽이든 폭이 크지 않아 전체적으로는 "비슷한 비율"이 유지된다.
			for _, c in ipairs(pool) do
				if c.name == "에로우 블로우" then
					c.w = crowded and 2.0 or 0.8
				elseif c.name == "더블샷" then
					c.w = crowded and 0.8 or 1.6
				elseif c.name == "아이언 에로우" then
					-- 8방향 관통(최대 6명) - 위아래 발판까지 닿아 몰렸을 때 특히 좋다.
					c.w = crowded and 2.5 or 1.4
				end
			end
			-- ② 차수 사다리 강등.
			if hasIronArrow then
				for _, c in ipairs(pool) do
					if c.name == "더블샷" or c.name == "에로우 블로우" then c.w = c.w * 0.01 end
				end
			end
			if hasHigherArcher then
				for _, c in ipairs(pool) do
					if c.name == "더블샷" or c.name == "에로우 블로우" or c.name == "아이언 에로우" then
						c.w = c.w * 0.01
					end
				end
			end
		end
		-- ③ 스트레이프(단일 강력) ↔ 아이스 샷(몰림). 위 single/aoe 기본 가중을 상황에 맞게 덮는다.
		-- (요청 2026-08-07) 아이스 샷은 **위아래 유도 범위가 넓다**(±1.65) - 몰리지 않았더라도 대상이
		-- 위아래로 벌어져 있으면 "간혹" 나가는 편이 이득이다. 단독+같은 높이일 때만 낮게 둔다.
		local iceVertical = math.abs(cdy) >= 0.8
		for _, c in ipairs(pool) do
			if c.name == "스트레이프" then
				c.w = crowded and 0.6 or 3.0
			elseif c.name == "아이스 샷" then
				if crowded then
					c.w = 3.0
				elseif iceVertical then
					c.w = 1.2   -- 위아래로 벌어진 대상 - 유도 범위 덕에 스트레이프보다 잘 맞는다
				else
					c.w = 0.4
				end
			end
		end

		-- (다크나이트) 드래곤 로어 사용 규칙 — **주력기(스피어 버스터) 대비 사용 비율로 직접 지정한다**
		-- (요청 2026-08-05 재조정: 이전의 "감쇠 ×0.3 + 최소 간격 게이트 + 쓰고도 35% 남을 것" 조합은
		--  실제로는 거의 안 나왔다. 소모율이 마스터 51%라 "35% 여유" 조건이 사실상 HP 86% 이상을
		--  요구했고, 25초 간격 게이트가 남은 기회마저 잘라냈다. 셋 다 걷어내고 비율만 남긴다):
		--  ① HP가 **60% 이하면 사용하지 않는다**(가중 0).
		--  ② (요청 2026-08-05 재조정) **HP가 많을수록 더 자주** - 60%에서 20%, 100%(풀)에서 150%로
		--     비율이 **연속적으로** 올라간다(HP 80% = 85%, 90% = 117%).
		--     ⚠ 이전 사양은 "99% 이상이면 1:1, 그 아래는 전부 20%"인 계단식이었는데, 로어 자체가
		--       최대 HP의 41~70%를 먹어 한 번 쓰면 다시는 99%에 못 닿는다 - 결과적으로 항상 20%로
		--       굳어 "HP가 많은데도 안 쓴다"는 신고가 나왔다. 계단을 없애고 램프로 바꾼다.
		--  ③ 광역기라 단독 대상에게 쓰면 HP만 날린다 - 주변 2마리 이상일 때만 허용한다(기존 3마리에서 완화).
		-- ⚠ 비율의 기준은 "이 시점의 스피어 버스터 가중"이다. 위 상위호환/몰림 보정이 모두 끝난 뒤여야
		-- 하므로 이 블록의 위치를 앞으로 옮기지 말 것(몰림 3.0 / 단독 1.0 → 로어는 그 1/5 또는 1/3).
		local roarHpRatio = 1.0
		local pcHpGate = player.PlayerComponent
		if isvalid(pcHpGate) and (pcHpGate.MaxHp or 0) > 0 then
			roarHpRatio = (pcHpGate.Hp or 0) / pcHpGate.MaxHp
		end
		local roarSpearW = 0
		for _, c in ipairs(pool) do
			if c.name == "스피어 버스터" then roarSpearW = c.w end
		end
		local roarCrowded = (nearby >= 2)
		-- 소모량(최대 HP의 41~70%)보다 현재 HP가 적으면 시전 자체가 막힌다(SkillManager의 HP 부족 게이트).
		-- 뽑아 봐야 차단 + 토스트만 나오므로 여기서 미리 제외한다 - 투자 레벨이 낮아 소모율이 60%를
		-- 넘는 구간에서만 실제로 걸린다(마스터 51%, 30 마스터 41%면 60% 하한이 더 빡빡하다).
		local roarCostRatio = _SkillManager:GetDragonRoarHpCostPercent(
			math.max(1, _SkillManager:GetHeroSkillLevelByName("드래곤 로어"))) / 100
		for _, c in ipairs(pool) do
			if c.name == "드래곤 로어" then
				if roarHpRatio <= 0.60 or roarHpRatio <= roarCostRatio or not roarCrowded then
					c.w = 0
				else
					-- 스피어 버스터를 안 배웠거나 슬롯에 없으면 기준이 없다 - 광역 기본 가중(3.0)을 기준으로 삼는다.
					local baseW = (roarSpearW > 0) and roarSpearW or 3.0
					-- HP 60% → 100% 구간을 0.2 → 1.5로 선형 보간(계단 없음 - 위 ② 참고).
					local roarT = (roarHpRatio - 0.60) / 0.40
					if roarT < 0 then roarT = 0 end
					if roarT > 1 then roarT = 1 end
					local share = 0.2 + 1.3 * roarT
					c.w = baseW * share
				end
			end
		end

		-- 돌진 규칙 (요청): 전방 직선상에 적이 없으면 아예 쓰지 않는다(가중 0).
		-- (요청 2026-08-04) 좋은 스킬이지만 자동사냥 관전 시점에서 직업 컨셉(차지 블로우 속성
		-- 연계)을 가리므로 사용빈도 하향: 몰림 부스트 ×4 → ×1.5, 기본 가중 ×0.35(크게 감쇠),
		-- 여기에 최소 12초 간격 게이트 - 몰린 상황이 흔해 부스트만 낮춰서는 여전히 자주 나온다.
		for _, c in ipairs(pool) do
			if c.name == "돌진" then
				if frontCount <= 0 or (self._T.nextCharge or 0) > now then
					c.w = 0
				else
					c.w = c.w * 0.35
					if frontCount >= 2 then
						c.w = c.w * 1.5
					end
				end
			end
		end

		-- (안전망) 연막 저격 중에 암살 외 스킬이 남아 있으면 전부 지운다 - 위 섀도어 확률표 뒤에도
		-- 돌진/드래곤 로어 등 다른 직업 블록이 가중을 더할 수 있어, **모든 계산이 끝난 여기서** 한 번 더
		-- 못박는다. 암살조차 쓸 수 없는 순간이면(유틸 시전 창 1.2초 등) 이번 틱은 쉰다 -
		-- 아래 기본공격 폴백까지 가면 그것도 허공을 때린다.
		if smokeSniping then
			local snipeW = 0
			for _, c in ipairs(pool) do
				if c.name == "암살" then snipeW = c.w else c.w = 0 end
			end
			if snipeW <= 0 then
				self._T.nextAtk = now + 0.2
				return
			end
		end

		local total = 0
		for _, c in ipairs(pool) do total += c.w end
		if #pool == 0 or total <= 0 then
			-- 배정된 공격 스킬이 없으면 기본공격 (Control 공격과 동일 경로)
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) then pcc:ActionAttack() end
			return
		end

		local r = _UtilLogic:RandomDouble() * total
		local pick = pool[#pool]
		for _, c in ipairs(pool) do
			r = r - c.w
			if r <= 0 then
				pick = c
				break
			end
		end
		-- 돌진이 뽑혔으면 최소 간격(12초) 게이트를 갱신한다 (사용빈도 하향 - 위 돌진 규칙 참고)
		if pick.name == "돌진" then
			self._T.nextCharge = now + 12.0
		end
		-- (섀도어) 어썰터가 뽑혔으면 최소 간격을 건다 - 스택 3개를 한 번에 쏟지 않게 하는 장치.
		if pick.name == "어썰터" then
			self._T.nextAssaulter = now + (self._T.assaulterSpacing or 6.0)
		end
		-- (요청 2026-08-05) 드래곤 로어의 최소 간격 게이트(25초/12초)는 **삭제**했다.
		-- 사용 빈도를 "스피어 버스터 대비 비율"로 지정받았는데, 시간 게이트가 남아 있으면 뽑혀도
		-- 차단되어 실제 비율이 지정값보다 훨씬 낮아진다(빈도가 너무 낮다는 신고의 직접 원인).
		-- 빈도 조절은 위 HP 비례 가중 램프(60% 20% ~ 풀 150%)와 HP 60% 하한만으로 한다.
		-- 시전 모션 동안 이동 금지 (서버 컨트롤 잠금 0.65×공속 + 여유)
		self._T.holdMoveUntil = now + 0.8 * _CharInfoManager:GetAttackSpeedMultiplier()
		_SkillManager:UseSkillInSlot(pick.key)
	end

	-- (성능) 클라 몬스터 목록 0.3초 캐시: FindTarget(0.3초 주기) + 공격 틱의 Count 2회가 저마다
	-- 맵 전체 재귀 스캔을 돌려 클라당 초당 ~7회 순회가 쌓였다 - 한 목록을 셋이 공유한다
	-- (죽은 몬스터는 각 사용처의 IsDead 검사가 걸러낸다).
	@ExecSpace("ClientOnly")
	method table GetMonsterComps(Entity player)
		local now = _UtilLogic.ElapsedSeconds
		if self._T.monComps ~= nil and (now - (self._T.monCompsAt or -99)) < 0.3 then
			return self._T.monComps
		end
		local map = player.CurrentMap
		local comps = nil
		if isvalid(map) then
			comps = map:GetChildComponentsByTypeName("script.Monster", true)
		end
		if comps == nil then comps = {} end
		self._T.monComps = comps
		self._T.monCompsAt = now
		return comps
	end

	-- 바라보는 방향(dir) 전방 distX유닛 직선상(같은 높이)의 살아있는 몬스터 수 - 돌진 각 판정용.
	@ExecSpace("ClientOnly")
	method integer CountMonstersInFront(Entity player, Vector3 pp, number dir, number distX)
		local comps = self:GetMonsterComps(player)
		if comps == nil then return 0 end
		local count = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local wp = e.TransformComponent.WorldPosition
					local relX = (wp.x - pp.x) * dir
					if relX > 0 and relX <= distX and math.abs(wp.y - pp.y) <= 1.2 then
						count += 1
					end
				end
			end
		end
		return count
	end

	-- ── (섀도어) 다크사이트 잠복/뒤잡기 판정 ─────────────────────────────
	-- 잠복은 "다크사이트가 켜져 있고 아직 기습하지 않은" 구간이다. 그동안 추적 목표 x는 대상의
	-- 뒤통수 자리로 바뀌고(OnUpdate) 공격은 전부 보류된다(TryAttackCast).

	@ExecSpace("ClientOnly")
	method boolean IsDarkSightAmbushing(number now)
		if not _SkillManager:IsDarkSightActive() then return false end
		return (self._T.dsAmbushDeadline or 0) > now
	end

	@ExecSpace("ClientOnly")
	method number GetBehindDirOfTarget(Entity target)
		-- 대상의 뒤통수가 대상 기준 어느 쪽인가(-1 = 왼쪽 / 1 = 오른쪽).
		-- 몬스터는 오른쪽을 볼 때 Scale.x가 음수다(프로젝트 관례) - 서버 백스탭 판정
		-- (PlayerAttack.IsFacingRight)과 **같은 기준**이어야 기습이 실제로 백스탭으로 인정된다.
		if not isvalid(target) then return -1 end
		local flipped = false
		local tr = target.TransformComponent
		if isvalid(tr) and tr.Scale.x < 0 then flipped = not flipped end
		local spr = target.SpriteRendererComponent
		if isvalid(spr) and spr.FlipX == true then flipped = not flipped end
		if flipped then return -1 end
		return 1
	end

	@ExecSpace("ClientOnly")
	method integer CountNearbyMonsters(Entity player, Vector3 pp, number radius)
		local comps = self:GetMonsterComps(player)
		if comps == nil then return 0 end
		local count = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local wp = e.TransformComponent.WorldPosition
					if math.abs(wp.x - pp.x) <= radius and math.abs(wp.y - pp.y) <= 1.2 then
						count += 1
					end
				end
			end
		end
		return count
	end

	@ExecSpace("ClientOnly")
	method Entity FindTarget(Entity player)
		-- 현재 맵에서 살아있는 최근접 몬스터. 같은 높이(|dy|<1.5)를 우선하고,
		-- 추적 타임아웃으로 제외된 대상은 제외 시간이 지날 때까지 건너뛴다.
		local comps = self:GetMonsterComps(player)
		if comps == nil or #comps == 0 then return nil end
		local pp = player.TransformComponent.WorldPosition
		local now = _UtilLogic.ElapsedSeconds

		-- 1차: 같은 층(|dy|<1.5) 후보의 최근접 수평 거리 - "같은 층 가까운 곳에 적이 있나" 판정.
		-- 같은 패스에서 아래층(1.1유닛 이상 아래) 최근접 후보도 함께 찾는다 (하강 순환용).
		local sameLayerNearest = nil
		local belowBest = nil
		local belowBestDist = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local banUntil = nil
					if self._T.banned ~= nil then banUntil = self._T.banned[e] end
					if banUntil == nil or banUntil <= now then
						local wp = e.TransformComponent.WorldPosition
						local relY = wp.y - pp.y
						if math.abs(relY) < 1.5 then
							local dxA = math.abs(wp.x - pp.x)
							if sameLayerNearest == nil or dxA < sameLayerNearest then
								sameLayerNearest = dxA
							end
						elseif relY <= -1.1 then
							local dxB = wp.x - pp.x
							local dB = math.sqrt(dxB * dxB + relY * relY)
							if belowBest == nil or dB < belowBestDist then
								belowBest = e
								belowBestDist = dB
							end
						end
					end
				end
			end
		end
		-- (요청) 하강 우선 규칙: 같은 층 적의 수평 거리가 아래층 적까지 거리의 3배 이상이면
		-- 멀리 걸어가는 대신 아래층 적을 대상으로 삼아 다운점프로 내려간다.
		-- 같은 층에 적이 아예 없을 때도 아래층 적이 있으면 그쪽으로 내려간다.
		-- (신고 2026-08-06) 단, 그 대상의 x에 착지 발판이 없으면(플레이어 층 아래가 뚫린 지형)
		-- 다운점프로 내려갈 수 없다 - 하강 우선권을 주지 않는다(일반 점수 선정으로 넘어가고,
		-- 거기서 골라져도 다운점프 분기의 발밑 검사가 즉시 제외한다).
		if belowBest ~= nil then
			local mapFB = player.CurrentMap
			local fhFB = isvalid(mapFB) and mapFB.FootholdComponent or nil
			local belowReachable = true
			if isvalid(fhFB) then
				local bx = belowBest.TransformComponent.WorldPosition.x
				belowReachable = fhFB:Raycast(Vector2(bx, pp.y - 0.3), Vector2(0, -1), 8.0) ~= nil
			end
			if belowReachable and (sameLayerNearest == nil or sameLayerNearest >= belowBestDist * 3.0) then
				return belowBest
			end
		end
		-- (요청) 같은 층 가까운 곳(4유닛 내)에 적이 없으면 위아래 적의 페널티를 크게 완화해
		-- 수직 대상을 적극 선택한다 → 섬광(이동기) 사용 기회가 올라간다.
		local sameLayerClose = (sameLayerNearest ~= nil and sameLayerNearest <= 4.0)

		-- (요청) 위 발판의 적(위쪽으로 1.1유닛 이상)은 섬광 같은 상하 이동기가 없으면 도달 수단이
		-- 없다 - 위로 점프하는 접근을 없앴으므로 아예 대상 후보에서 제외한다. 아래층은 다운점프로
		-- 내려갈 수 있어 그대로 둔다.
		-- (다크나이트) 드래곤 라이딩 소환이 활성(미탑승)이면 탑승 비행으로 위층에 갈 수 있으므로
		-- 섬광과 동일하게 위층 적도 후보에 넣는다.
		-- (나이트로드) 헤이스트가 켜져 있으면 점프 보정 사거리만큼 위 발판에 올라갈 수 있다 -
		-- 그 높이 안의 위층 적은 후보에 넣는다(사거리 밖은 여전히 제외).
		-- (나이트로드·섀도어) 플래시 점프를 배웠으면 그 사거리 안의 위층 적도 후보에 넣는다
		-- (헤이스트 점프 보정과 같은 취급 - 실제 도약은 추적 분기의 TryFlashJumpMove가 한다).
		local hasteReach = self:GetHasteJumpReach()
		local flashReach = self:GetFlashJumpReach()
		local hasMobility = (self._T.slotMobilities ~= nil and #self._T.slotMobilities > 0)
			or (self._T.slotDragonRides ~= nil and #self._T.slotDragonRides > 0 and _SkillManager:CanAutoMountDragonRide())
		local best = nil
		local bestScore = 0
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				local e = comp.Entity
				if isvalid(e) and e.Visible ~= false then
					local banUntil = nil
					if self._T.banned ~= nil then banUntil = self._T.banned[e] end
					if banUntil == nil or banUntil <= now then
						local wp = e.TransformComponent.WorldPosition
						local relY = wp.y - pp.y
						if relY >= 1.1 and not hasMobility and relY > hasteReach and relY > flashReach then
							continue
						end
						local dxA = math.abs(wp.x - pp.x)
						local dyA = math.abs(relY)
						local score = dxA
						if dyA >= 1.5 then
							if sameLayerClose then
								score = score + dyA * 10 + 100
							else
								score = score + dyA * 2
							end
						end
						if best == nil or score < bestScore then
							best = e
							bestScore = score
						end
					end
				end
			end
		end
		return best
	end

	-- (요청) 하강 순환 복귀: 맨아래 층(발밑에 더 이상 발판이 없음)에서 사냥감이 끊기면
	-- 아랫점프로 떨어지는 대신(엔진이 맨아래 관통 낙하를 막음) 맵의 SpawnLocation(맨 위)으로
	-- 순간이동해 위에서부터 다시 내려오며 사냥한다 - 사다리 없이 아래로만 내려가는 동선.
	-- SpawnLocation이 없는 맵에서는 아무것도 하지 않는다. 복귀했으면 true.
	@ExecSpace("ClientOnly")
	method boolean TryBottomReturn(number now, Entity player)
		if (self._T.nextBottomReturn or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		local map = player.CurrentMap
		if not isvalid(map) then return false end
		local fh = map.FootholdComponent
		if not isvalid(fh) then return false end
		-- 발밑 0.3유닛 아래에서 아래로 8유닛 레이캐스트 - 발판이 잡히면 아직 맨아래가 아니다.
		-- 예외: 이 맵은 전폭 바닥 0.6 위에 선반 발판이 겹쳐 있어, 선반 위에 서 있어도
		-- 바로 아래(1유닛 이내) 바닥이 진짜 맨아래(그 밑에 발판 없음)면 맨아래로 취급한다.
		local pp = player.TransformComponent.WorldPosition
		local below = fh:Raycast(Vector2(pp.x, pp.y - 0.3), Vector2(0, -1), 8.0)
		if below ~= nil then
			local by = below:GetYByX(pp.x)
			if (pp.y - by) > 1.0 then return false end
			local below2 = fh:Raycast(Vector2(pp.x, by - 0.3), Vector2(0, -1), 8.0)
			if below2 ~= nil then return false end
		end
		return self:ReturnToSpawn(now, player, "맨아래 도달")
	end

	-- (신고 2026-08-06) 중간 발판 무대상 정체 복귀: 잡을 수 있는 대상이 하나도 없는 상태(남은 적이
	-- 위층뿐이라 후보 제외/추적 제외 중)가 4초 이상 이어지고 맵에 살아있는 몬스터는 있으면,
	-- 맨아래가 아니어도 스폰 지점으로 복귀해 하강 순환을 다시 시작한다.
	-- 전멸(살아있는 몬스터 0)이면 리젠 대기이므로 배회를 유지한다(헛복귀 반복 방지). 복귀했으면 true.
	@ExecSpace("ClientOnly")
	method boolean TryNoTargetReturn(number now, Entity player)
		if self._T.noTargetSince == nil then
			self._T.noTargetSince = now
			return false
		end
		if now - self._T.noTargetSince < 4.0 then return false end
		local comps = self:GetMonsterComps(player)
		local anyAlive = false
		for _, comp in ipairs(comps) do
			if isvalid(comp) and comp.IsDead ~= true then
				anyAlive = true
				break
			end
		end
		if not anyAlive then return false end
		if self:ReturnToSpawn(now, player, "무대상 4초 지속") then
			self._T.noTargetSince = nil
			return true
		end
		return false
	end

	-- 스폰 지점(맨 위) 복귀 공용 절차 - 맨아래 도달/중간 무대상 정체 두 경로가 함께 쓴다.
	@ExecSpace("ClientOnly")
	method boolean ReturnToSpawn(number now, Entity player, string reason)
		if (self._T.nextBottomReturn or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		local map = player.CurrentMap
		if not isvalid(map) then return false end
		local spawnE = map:GetChildByName("SpawnLocation", true)
		if not isvalid(spawnE) then return false end
		self._T.nextBottomReturn = now + 4.0
		-- 순간이동은 검증된 패턴대로 1회만 호출한다 (SetWorldPosition 반복 호출은 되돌림 버그).
		local sp = spawnE.TransformComponent.WorldPosition
		rb:SetWorldPosition(Vector2(sp.x, sp.y + 0.2))
		rb:PositionReset()
		self._T.target = nil
		self._T.nextScan = 0
		self._T.holdMoveUntil = now + 0.4
		local sc = player.StateComponent
		if isvalid(sc) and sc.CurrentStateName == "MOVE" then
			sc:ChangeState("IDLE")
		end
		log("[AutoHunt] 스폰 지점 복귀(" .. reason .. ") (" .. string.format("%.1f, %.1f", sp.x, sp.y) .. ")")
		return true
	end

	-- (나이트로드) 표창 스킬(럭키세븐/트리플/쿼드러플)이 퀵슬롯에 하나라도 있는가 -
	-- 각성 중 "제자리 사냥" 판정에 쓴다(표창이 없으면 각성 중에도 평소처럼 붙어야 한다).
	@ExecSpace("ClientOnly")
	method boolean HasAssassinateSlot()
		-- 암살이 퀵슬롯에 올라와 있는가(연막 중 원거리 시전 판단에 쓴다).
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "암살" then return true end
				end
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method number GetAssassinateReach()
		-- (요청 2026-08-06) **연막 안에서는 암살 사거리가 2배**가 된다 - 자동사냥이 그걸 활용해야 한다.
		-- 서버 FindNearestAssassinateTarget의 기준(원형 4.5, 연막 중 9.0)과 **같은 값**이어야
		-- "사거리 안이라 판단했는데 서버는 대상을 못 찾는" 헛빵이 안 난다.
		if _SkillManager:IsSmokeScreenActiveLocal() then return 9.0 end
		return 4.5
	end

	@ExecSpace("ClientOnly")
	method boolean ShouldSnipeWithAssassinate(number dx, number dy)
		-- 연막 중 + 암살 보유 + 대상이 암살 사거리 안이면 **걸어가지 않고 제자리에서** 시전한다.
		-- (각성 중 표창 3종이 로어 범위를 그대로 조준하는 것과 같은 처리 - 그 분기의 자매 규칙이다.)
		if not self:HasAssassinateSlot() then return false end
		if not _SkillManager:IsSmokeScreenActiveLocal() then return false end
		local reach = self:GetAssassinateReach()
		return math.sqrt(dx * dx + dy * dy) <= reach
	end

	@ExecSpace("ClientOnly")
	method boolean HasStarThrowSlot()
		local lists = { self._T.slotAoes, self._T.slotSingles }
		for _, lst in ipairs(lists) do
			if lst ~= nil then
				for _, s in ipairs(lst) do
					if s.name == "럭키세븐" or s.name == "트리플 스로우" or s.name == "쿼드러플 스로우" then
						return true
					end
				end
			end
		end
		return false
	end

	-- (나이트로드) 헤이스트 점프 보정으로 올라갈 수 있는 높이(월드 유닛). 헤이스트가 꺼져 있으면 0.
	-- 점프 높이는 점프력의 **제곱**에 비례한다(실측) - 보정 배율도 제곱으로 들어간다.
	-- 실제 보정은 서버(PlayerAttack.HasteJumpAssistTick)가 발판을 찾아 걸어주므로, 여기서는
	-- "그 사거리 안이면 올라갈 수 있다"는 판단 기준으로만 쓴다. 여유 0.15는 발판 두께/오차 몫.
	@ExecSpace("ClientOnly")
	method number GetHasteJumpReach()
		if _HasteBuffUI:GetRemaining() <= 0 then return 0 end
		local lv = math.max(1, _SkillManager:GetHeroSkillLevelByName("헤이스트"))
		local mult = _SkillManager:GetHasteJumpRangeMult(lv)
		return 1.194 * mult * mult - 0.15
	end

	-- ── (나이트로드·섀도어) 플래시 점프 = 자동사냥 이동기 ────────────────
	-- 이 두 직업은 러시(대시)도 섬광도 드래곤 라이딩도 없어서, 그동안 "먼 대상까지 걸어가기"와
	-- "위 발판 대상 포기"밖에 없었다. 플래시 점프를 배웠으면 필요한 순간에만 꺼내 쓴다.

	@ExecSpace("ClientOnly")
	method integer GetFlashJumpLevel()
		-- 투자 레벨(0이면 미보유 - 아래 판단들이 전부 꺼진다).
		return _SkillManager:GetHeroSkillLevelByName("플래시 점프")
	end

	-- 점프 + 플래시 점프로 올라갈 수 있는 총 높이(월드 유닛). 안 배웠으면 0.
	-- 점프 정점(기본 1.194유닛 - 헤이스트 보정 중이면 그 높이)에서 쏘면 SetForce가 그 시점 속도를
	-- **덮어쓰기** 때문에 거기서 다시 (4.04×배율)²/2g 만큼 더 오른다. 더블 점프 실측(세로 힘 4.04 =
	-- 상승 0.4유닛)에서 유도하면 추가분은 0.4 × 배율². 여유 0.2는 발판 두께/타이밍 오차 몫이다.
	@ExecSpace("ClientOnly")
	method number GetFlashJumpReach()
		local lv = self:GetFlashJumpLevel()
		if lv <= 0 then return 0 end
		local base = 1.194
		local hasteReach = self:GetHasteJumpReach()
		if hasteReach + 0.15 > base then base = hasteReach + 0.15 end
		local scale = _SkillManager:GetFlashJumpForceScale(lv)
		return base + 0.4 * scale * scale - 0.2
	end

	-- 점프 → 정점에서 플래시 점프. 발동했으면 true.
	-- ⚠ 정점(0.34초 뒤)에 맞춰 쏘는 것이 핵심이다 - 플래시 점프의 SetForce는 남은 상승 속도를
	--   덮어쓰므로, 상승 중에 쏘면 그만큼 손해다(점프 속도 6.98 / 중력 20.4 → 정점까지 0.34초).
	--   그 사이에는 holdMoveUntil로 걷기/재선정을 멈춰 방향이 흔들리지 않게 한다.
	@ExecSpace("ClientOnly")
	method boolean TryFlashJumpMove(number now, Entity player, number dirX, string reason)
		if self:GetFlashJumpLevel() <= 0 then return false end
		-- 스킬 자체엔 쿨타임이 없지만(체공 1회 제한뿐) 자동사냥이 매 프레임 남발하지 않도록 간격을 둔다.
		if (self._T.nextFlashJump or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		self._T.nextFlashJump = now + 1.5
		self._T.jumpedAt = now
		self._T.holdMoveUntil = now + 0.34
		local pcc = player.PlayerControllerComponent
		if isvalid(pcc) then pcc.LookDirectionX = dirX end
		player.MovementComponent:Jump()
		local sc = player.StateComponent
		if isvalid(sc) then sc:ChangeState("JUMP") end
		-- 예약 취소용 세대 번호 - 그 사이 자동사냥이 꺼지거나 다시 도약하면 옛 예약은 무시한다.
		self._T.fjGen = (self._T.fjGen or 0) + 1
		local gen = self._T.fjGen
		_TimerService:SetTimerOnce(function()
			if self._T.fjGen ~= gen then return end
			if self.autoOn ~= true then return end
			local p = _UserService.LocalPlayer
			if not isvalid(p) then return end
			-- 시전 직전에 방향을 다시 못박는다(플래시 점프는 LookDirectionX로 도약 방향을 정한다).
			local pcc2 = p.PlayerControllerComponent
			if isvalid(pcc2) then pcc2.LookDirectionX = dirX end
			_SkillManager:TryFlashJump()
		end, 0.34)
		log("[AutoHunt] 플래시 점프 - " .. reason)
		return true
	end

	-- ── (신궁) 더블 점프 = 자동사냥 이동기 ────────────────────────────────
	-- 플래시 점프와 **완전히 같은 구조**다(지상에서 점프 → 정점에서 한 번 더 도약). 다른 점은
	-- 두 가지뿐 - 재사용 대기시간 5초가 있고, 도약 힘이 레벨과 무관하게 고정(가로 4.5 / 세로 4.04)이다.

	@ExecSpace("ClientOnly")
	method integer GetDoubleJumpLevel()
		-- 투자 레벨(0이면 미보유 - 아래 판단들이 전부 꺼진다).
		return _SkillManager:GetHeroSkillLevelByName("더블 점프")
	end

	-- 점프 + 더블 점프로 올라갈 수 있는 총 높이(월드 유닛). 안 배웠으면 0.
	-- 세로 힘 4.04 = 상승 약 0.4유닛(RunDoubleJumpMove 실측 주석). 여유 0.2는 발판 두께/타이밍 오차 몫.
	@ExecSpace("ClientOnly")
	method number GetDoubleJumpReach()
		if self:GetDoubleJumpLevel() <= 0 then return 0 end
		local base = 1.194
		local hasteReach = self:GetHasteJumpReach()
		if hasteReach + 0.15 > base then base = hasteReach + 0.15 end
		return base + 0.4 - 0.2
	end

	-- 점프 → 정점에서 더블 점프. 발동했으면 true (플래시 점프와 동일한 0.34초 정점 타이밍).
	@ExecSpace("ClientOnly")
	method boolean TryDoubleJumpMove(number now, Entity player, number dirX, string reason)
		if self:GetDoubleJumpLevel() <= 0 then return false end
		-- 스킬 자체 쿨 5초 + 여유. 매 프레임 남발하지 않도록 간격을 둔다.
		if (self._T.nextDoubleJump or 0) > now then return false end
		local rb = player.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		self._T.nextDoubleJump = now + 5.5
		self._T.jumpedAt = now
		self._T.holdMoveUntil = now + 0.34
		local pcc = player.PlayerControllerComponent
		if isvalid(pcc) then pcc.LookDirectionX = dirX end
		player.MovementComponent:Jump()
		local sc = player.StateComponent
		if isvalid(sc) then sc:ChangeState("JUMP") end
		-- 예약 취소용 세대 번호 - 그 사이 자동사냥이 꺼지거나 다시 도약하면 옛 예약은 무시한다.
		self._T.djGen = (self._T.djGen or 0) + 1
		local gen = self._T.djGen
		_TimerService:SetTimerOnce(function()
			if self._T.djGen ~= gen then return end
			if self.autoOn ~= true then return end
			local p = _UserService.LocalPlayer
			if not isvalid(p) then return end
			-- 시전 직전에 방향을 다시 못박는다(더블 점프는 LookDirectionX로 도약 방향을 정한다).
			local pcc2 = p.PlayerControllerComponent
			if isvalid(pcc2) then pcc2.LookDirectionX = dirX end
			_SkillManager:TryDoubleJump()
		end, 0.34)
		log("[AutoHunt] 더블 점프 - " .. reason)
		return true
	end

	-- ── (신궁) 체인샷 = 자동사냥 이동기 ───────────────────────────────────
	-- 8방향으로 체인을 쏴 지형에 박고, 0.4초 뒤 같은 키를 한 번 더 눌러 그 각도로 당겨져 날아간다.
	-- 섬광과 같은 자리(위아래로 떨어진 대상 추적 / 같은 층 먼 대상 가속)에서 쓴다.
	-- ⚠ 두 번째 입력이 "당기기"가 되려면 첫 발사에서 체인이 실제로 박혀야 한다 - 허공이면 당기기가
	--   무시되고 그냥 새 체인이 나가므로, 실패해도 안전하다(자체 쿨 2초가 남발을 막는다).

	@ExecSpace("ClientOnly")
	method boolean TryChainShotMove(number now, Entity player, number dirX, number dirY, string reason)
		if self._T.slotChainShots == nil or #self._T.slotChainShots == 0 then return false end
		if (self._T.nextChainShot or 0) > now then return false end
		self._T.nextChainShot = now + 3.0   -- 체인샷 자체 쿨 2초 + 발사→당기기 왕복 여유
		local key = self._T.slotChainShots[1].key
		-- 조준은 8방향이라 자동사냥 조준값(GetAimDirX/Y)을 그대로 쓴다 - 체인샷 시전 분기가
		-- 방향키 입력이 없을 때 이 값을 읽는다.
		self._T.aimDirX = dirX
		self._T.aimDirY = dirY
		self._T.holdMoveUntil = now + 1.2
		local pccC = player.PlayerControllerComponent
		if isvalid(pccC) then pccC.LookDirectionX = dirX end
		_SkillManager:UseSkillInSlot(key)   -- ① 체인 발사
		-- ② 0.4초 뒤 같은 키를 한 번 더 - 박혔으면 그 각도로 당겨져 날아간다.
		self._T.csGen = (self._T.csGen or 0) + 1
		local csGenNow = self._T.csGen
		_TimerService:SetTimerOnce(function()
			if self._T.csGen ~= csGenNow then return end
			if self.autoOn ~= true then return end
			_SkillManager:UseSkillInSlot(key)
		end, 0.4)
		log("[AutoHunt] 체인샷 이동 - " .. reason)
		return true
	end

	-- ── (신궁) 스나이핑 = 직선 다수 + HP 비례 차징 ────────────────────────
	-- 좌우 직선만 때리는 관통 3명 차지기라, "전방 직선에 적이 여럿 늘어서 있을 때"만 쓴다.
	-- 차징 시간은 **대상의 HP 비율**에 비례한다(요청) - 다 죽어가는 적에게 10초를 모으는 것은 낭비다.

	-- ── 차지형 스킬 공용: "죽일 만큼만 모은다" ─────────────────────────────
	-- (신고 2026-08-07) "몬스터 수준에 맞지 않게 기를 너무 많이 모은다."
	-- 구 사양은 **대상 HP 비율**만 봤다 - 잡몹이라도 풀피면 무조건 완충이었다. 이제는
	-- "지금 전투력으로 이 대상을 죽이는 데 필요한 배율"을 역산해 딱 그만큼만 모은다.
	--   필요 배율 = 대상 남은 HP / (전투력 × 기본 최소 배율)
	--   차지 비율 t = 필요 배율 / 완충 배율   (0~1로 자름)

	@ExecSpace("ClientOnly")
	method number GetTargetRemainHp(Entity target)
		-- 대상의 남은 HP(몬스터가 아니거나 못 읽으면 0).
		if not isvalid(target) then return 0 end
		local mon = target:GetComponent("script.Monster")
		if mon == nil then return 0 end
		return math.max(0, mon.Hp or 0)
	end

	@ExecSpace("ClientOnly")
	method number GetChargeSecondsToKill(Entity target, number baseRate, number maxChargeMult, number fullSeconds, number minSeconds)
		-- baseRate = 무차지 1발의 기본 배율(전투력 대비). maxChargeMult = 완충 배율.
		-- 대상 HP를 못 읽으면(0) 완충한다 - 정보가 없을 때는 안전하게 세게 쏜다.
		local hp = self:GetTargetRemainHp(target)
		if hp <= 0 then return fullSeconds end
		local cp = _CharInfoManager:CalcCombatPower()
		local perShot = cp * math.max(0.0001, baseRate)
		if perShot <= 0 then return fullSeconds end
		-- 여유 1.15배 - 최소 배율로 계산했고 방어력/굴림 편차가 있어 살짝 넉넉히 모은다.
		local needMult = (hp * 1.15) / perShot
		local t = needMult / math.max(0.0001, maxChargeMult)
		if t < 0 then t = 0 end
		if t > 1 then t = 1 end
		return math.max(minSeconds, fullSeconds * t)
	end

	@ExecSpace("ClientOnly")
	method string FindIronArrowSlotKey()
		-- 아이언 에로우가 배정된 단축키(없으면 빈 문자열). 역할은 single이라 slotSingles에 들어 있다.
		if self._T.slotSingles == nil then return "" end
		for _, s in ipairs(self._T.slotSingles) do
			if s.name == "아이언 에로우" then return s.key end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method boolean TryIronArrowRanged(number now, Entity player, number dx, number dy)
		-- 아이언 에로우는 **8방향 관통 화살**이라 근접 사거리 밖 / 위아래 발판의 적에게도 그대로 꽂힌다.
		-- 붙을 때까지 걷기만 하느니 그 자리에서 쏘는 편이 이득이다(요청 2026-08-07).
		-- ⚠ 접근 분기(OnUpdate)에서 불러야 한다 - TryAttackCast는 근접 사거리 게이트 뒤에 있어
		--   먼 대상에게는 아예 도달하지 못한다(실측으로 확인한 사각).
		-- ⚠ (실측 2026-08-07) 조건이 "근접 사거리 밖"뿐이고 간격이 0.9초였을 때, 쏘느라 멈춘 사이
		--   대상에 붙지 못해 **아이언 에로우만 35연발**하고 피어싱/스트레이프가 한 번도 안 나갔다.
		--   → "걸어서 붙기 어려운 상황"으로 조건을 좁히고(위아래 발판이 다르거나 수평으로 꽤 멀 때)
		--     간격도 2.5초로 벌려 접근을 방해하지 않게 한다.
		local iaKey = self:FindIronArrowSlotKey()
		if iaKey == "" then return false end
		if (self._T.nextIronArrow or 0) > now then return false end
		-- ⚠ (실측) 다른 시전 잠금(피어싱 후딜 0.7초 등)이 걸려 있으면 UseSkillInSlot이 조용히 무시된다 -
		--   그런데도 2.5초 간격을 먹어버려 10번 시도 중 3번만 실제로 나갔다. 잠금 중이면 아예 넘긴다.
		if (self._T.holdMoveUntil or 0) > now then return false end
		local iaDist = math.sqrt(dx * dx + dy * dy)
		if iaDist <= 1.3 then return false end                       -- 근접 사거리면 평소 로테이션이 낫다
		if math.abs(dy) < 1.2 and math.abs(dx) < 3.0 then return false end  -- 곧 붙을 거리 - 걸어가는 게 낫다
		if math.abs(dx) > 7.0 or math.abs(dy) > 4.0 then return false end   -- 화살이 닿는 범위 밖
		local atkMultIa = _CharInfoManager:GetAttackSpeedMultiplier()
		self._T.nextIronArrow = now + 2.5
		-- 8방향 조준값을 대상 쪽으로 못박아 둔다(시전 분기가 GetAimDirX/Y로 읽어간다).
		self._T.aimDirX = (dx > 0) and 1 or -1
		if dy >= 1.2 then self._T.aimDirY = 1
		elseif dy <= -1.2 then self._T.aimDirY = -1
		else self._T.aimDirY = 0 end
		local pccIa = player.PlayerControllerComponent
		if isvalid(pccIa) then pccIa.LookDirectionX = self._T.aimDirX end
		if self._T.moving then self:StopMoving() end
		-- 시전 모션 동안만 짧게 멈춘다 - 길게 잡으면 접근이 계속 밀려 위 35연발 사고가 재발한다.
		self._T.holdMoveUntil = now + 0.5 * atkMultIa
		self._T.nextAtk = now + 0.5 * atkMultIa
		_SkillManager:UseSkillInSlot(iaKey)
		log("[AutoHunt] 아이언 에로우 원거리 dist=" .. string.format("%.2f", iaDist)
			.. " dir=(" .. tostring(self._T.aimDirX) .. "," .. tostring(self._T.aimDirY) .. ")")
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean IsTargetToughForPiercing(Entity target)
		-- 완충 피어싱 한 방으로도 못 죽이는 "단단한" 대상인가.
		-- 스나이핑(완충 10초짜리 한 방)은 이런 대상에게만 값어치가 있다 - 잡몹에 10초를 모으면 손해다.
		local hp = self:GetTargetRemainHp(target)
		if hp <= 0 then return false end
		local pcLvT = math.max(1, _SkillManager:GetHeroSkillLevelByName("피어싱"))
		local baseT = _SkillManager:GetPiercingMinPercent(pcLvT) / 100
		local cpT = _CharInfoManager:CalcCombatPower()
		return hp > (cpT * baseT * 5.0)
	end

	@ExecSpace("ClientOnly")
	method number GetSnipingChargeSeconds(Entity target)
		-- 스나이핑: 완충 10초 / 완충 배율 100배. 죽일 만큼만 모으되 최소 0.5초는 모은다.
		local snLvC = math.max(1, _SkillManager:GetHeroSkillLevelByName("스나이핑"))
		return self:GetChargeSecondsToKill(target, _SkillManager:GetSnipingMinPercent(snLvC) / 100, 100.0, 10.0, 0.5)
	end

	@ExecSpace("ClientOnly")
	method boolean TrySnipingCast(number now, Entity player, Vector3 pp, Entity target)
		if self._T.slotSnipings == nil or #self._T.slotSnipings == 0 then return false end
		if (self._T.nextSniping or 0) > now then return false end
		-- 좌우 직선 판정: 바라보는 방향 전방 8유닛 안에 적이 **2마리 이상** 늘어서 있어야 한다
		-- (관통 3명이라 2명부터 이득 - 1명이면 스트레이프가 낫다).
		local lookDirSn = 1
		local pccSn = player.PlayerControllerComponent
		if isvalid(pccSn) and pccSn.LookDirectionX < 0 then lookDirSn = -1 end
		if self:CountMonstersInFront(player, pp, lookDirSn, 8.0) < 2 then return false end
		-- (요청 2026-08-07) "수준이 낮으면 스나이핑보다 피어싱 위주" - 완충 피어싱으로 죽는 잡몹에게는
		-- 스나이핑(완충 10초)을 아예 쓰지 않는다. 피어싱 슬롯이 없으면 이 제한을 걸지 않는다.
		if self._T.slotPiercings ~= nil and #self._T.slotPiercings > 0 and not self:IsTargetToughForPiercing(target) then
			return false
		end
		local chargeSec = self:GetSnipingChargeSeconds(target)
		self._T.nextSniping = now + chargeSec + 4.0
		-- 차징 내내 제자리에 서 있어야 한다(차징 중 이동속도 50% + 자세 유지).
		self._T.holdMoveUntil = now + chargeSec + 0.5
		self._T.nextAtk = now + chargeSec + 0.5
		-- ⚠ 실제 키를 누르지 않으므로 "누르고 있는 중"으로 표시해야 한다 - 안 그러면 차지 틱이 첫
		--   프레임에 "키를 뗐다"고 보고 charge=0으로 발사한다(2026-08-06 실측 버그).
		_SkillManager:SetChargeAutoHold("sniping", true)
		_SkillManager:UseSkillInSlot(self._T.slotSnipings[1].key)   -- 차지 시작
		-- 예약 취소용 세대 번호 - 자동사냥이 꺼지거나 새로 저격하면 옛 예약은 무시한다.
		self._T.snGen = (self._T.snGen or 0) + 1
		local snGenNow = self._T.snGen
		_TimerService:SetTimerOnce(function()
			if self._T.snGen ~= snGenNow then return end
			if self.autoOn ~= true then return end
			_SkillManager:ReleaseSniping()
		end, chargeSec)
		log("[AutoHunt] 스나이핑 저격 - 직선 " .. tostring(self:CountMonstersInFront(player, pp, lookDirSn, 8.0))
			.. "마리, 차징 " .. string.format("%.1f", chargeSec) .. "초 (대상 HP 비례)")
		return true
	end

	-- ── (신궁) 피어싱 = 넓게 훑는 짧은 차지기 ──────────────────────────────
	-- 스나이핑과 같은 차지 구조지만 완충이 1초라 부담 없이 자주 쓸 수 있고, 위아래 판정이 넓어
	-- 직선에 한 마리만 있어도 손해가 아니다 - 스나이핑(2마리 이상)보다 조건을 느슨하게 잡는다.

	@ExecSpace("ClientOnly")
	method boolean TryPiercingCast(number now, Entity player, Vector3 pp, Entity target)
		if self._T.slotPiercings == nil or #self._T.slotPiercings == 0 then return false end
		if (self._T.nextPiercing or 0) > now then return false end
		local lookDirPc = 1
		local pccPc = player.PlayerControllerComponent
		if isvalid(pccPc) and pccPc.LookDirectionX < 0 then lookDirPc = -1 end
		if self:CountMonstersInFront(player, pp, lookDirPc, 8.0) < 1 then return false end
		-- (요청 2026-08-07) 차징도 "죽일 만큼만" - 잡몹에게 완충 1초를 다 쓰지 않는다.
		-- 완충 1초 / 완충 배율 5배, 최소 0.15초(최소한의 기는 모은다).
		local fullPc = _SkillManager:GetPiercingFullChargeSeconds()
		local pcLvC = math.max(1, _SkillManager:GetHeroSkillLevelByName("피어싱"))
		local chargePc = self:GetChargeSecondsToKill(target,
			_SkillManager:GetPiercingMinPercent(pcLvC) / 100, 5.0, fullPc, 0.15)
		self._T.nextPiercing = now + chargePc + 1.0
		self._T.holdMoveUntil = now + chargePc + 0.4
		self._T.nextAtk = now + chargePc + 0.4
		-- ⚠ 스나이핑과 같은 이유로 "누르고 있는 중" 표시가 필요하다(TrySnipingCast 주석 참고).
		_SkillManager:SetChargeAutoHold("piercing", true)
		_SkillManager:UseSkillInSlot(self._T.slotPiercings[1].key)   -- 차지 시작
		self._T.pcGen = (self._T.pcGen or 0) + 1
		local pcGenNow = self._T.pcGen
		_TimerService:SetTimerOnce(function()
			if self._T.pcGen ~= pcGenNow then return end
			if self.autoOn ~= true then return end
			_SkillManager:ReleasePiercing()
		end, chargePc)
		log("[AutoHunt] 피어싱 - 직선 " .. tostring(self:CountMonstersInFront(player, pp, lookDirPc, 8.0))
			.. "마리, 차징 " .. string.format("%.2f", chargePc) .. "초")
		return true
	end

	@ExecSpace("ClientOnly")
	method void StopMoving()
		-- 자동 이동 종료: 이동을 멈추고 꺼뒀던 플레이어 컨트롤러를 복구한다 (수동 조작 재개 가능)
		local player = _UserService.LocalPlayer
		if isvalid(player) then
			local pcc = player.PlayerControllerComponent
			if isvalid(pcc) and not pcc.Enable then pcc.Enable = true end
			if self._T.moving == true then
				if isvalid(player.MovementComponent) then
					player.MovementComponent:Stop()
				end
				-- 정지 모션 복귀 (걷기 상태로 남아있으면 IDLE로)
				local sc = player.StateComponent
				if isvalid(sc) and sc.CurrentStateName == "MOVE" then
					sc:ChangeState("IDLE")
				end
			end
		end
		self._T.moving = false
		-- 끼임 감지 샘플 초기화 - 정지 후 새 걷기에서 이전 위치와 비교하는 오판 방지
		self._T.stuckLastX = nil
		self._T.stuckLastY = nil
		self._T.stuckCount = 0
	end

end
