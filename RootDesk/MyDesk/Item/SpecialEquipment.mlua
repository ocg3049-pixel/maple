@Logic
script SpecialEquipment extends Logic
    method string Kind(string item)
        -- Keep identity stable through every starforce appearance change.
        return string.match(item or "", "|accessory:([%w_]+)") or ""
    end

    method table Catalog()
        -- Uploaded icons and verified avatar-item RUIDs share the same equipment format.
        return {
            {key="ring",name="연금술사의 반지",ruid="41785bcdc55e4af3a36010cfe3e4d51f",slot=10},
            {key="necklace",name="슈피겔만의 목걸이",ruid="b50086fa9a2246088e4b95f5db95d49d",slot=15},
            {key="pendant",name="봉인된 타임리스 펜던트",ruid="27e3caa8e0c3451385b5f644aa18c1a4",slot=15},
            {key="receiver",name="요원C의 낡은 수신기",ruid="225a01e0c52c4136a0900c2796ea0831",slot=14},
            {key="icebar",name="수박맛 아이스바",ruid="8fd14e71dcdd40588662f7675d38bf08",slot=26},
            {key="glasses",name="금이 간 안경",ruid="6374adc25b004cc98b6b7104bf73f669",slot=27}
        }
    end

    method boolean FixedPotential(string item)
        -- Cube and potential-scroll restrictions use one predicate.
        return self:Kind(item) ~= "" or _CashShopManager:IsHalfEarring(item)
    end

    @ExecSpace("ClientOnly")
    method string Normalize(string item)
        -- Rebuild fixed name, appearance and potential lines while retaining other metadata.
        local kind = self:Kind(item)
        if kind == "" then return item end
        local f = _EnhancementManager:SplitItemFieldsPreserve(item)
        local stars = math.max(0, math.min(5, math.floor(tonumber(f[4]) or 0)))
        local row = nil
        for _, r in ipairs(self:Catalog()) do if r.key == kind then row = r break end end
        if row == nil then return item end
        while #f < 17 do table.insert(f, "0") end
        f[1], f[2], f[3], f[4] = row.name, row.ruid, tostring(row.slot), tostring(stars)
        if kind == "icebar" then
            local names = {"수박맛 아이스바","초코맛 아이스바","메론맛 아이스바","포도맛 아이스바","레몬맛 아이스바","딸기맛 아이스바"}
            local ruids = {"8fd14e71dcdd40588662f7675d38bf08","cf77c3f276f3409b8dcaaceaf9561f99","08eb9023c49f4d868bbc6d653b5ead77","b0c633b382734ece9b5e8a6f831d4d44","46a9471b1e81475ba051129837d05912","d6f8aa48f84749a08a84a1e5ef2ce798"}
            f[1], f[2] = names[stars+1], ruids[stars+1]
        elseif kind == "glasses" then
            local names = {"금이 간 안경","드래곤 안경","고고학자의 안경","미카엘의 안경","오닉스 드래곤 안경","켄타의 물안경"}
            local ruids = {"6374adc25b004cc98b6b7104bf73f669","3bf2733c365d4baa9a2ff90ca7d0e51e","70b961ca96a445f89575a7e3957ac8e0","fb566010625a421c8b20a62a4956caf9","77c3d1c5e8464336a062e3394a1a933c","69d109835ebb434ab24c69ae547e3bd3"}
            f[1], f[2] = names[stars+1], ruids[stars+1]
        elseif stars == 5 then
            if kind == "necklace" then f[1],f[2]="슈피겔만의 혼돈 목걸이","e2489028a7ad48228d21267c3185c43f"
            elseif kind == "pendant" then f[1],f[2]="피어리스 펜던트","4e44e6fb0d93468da0561479d8ce743b"
            elseif kind == "receiver" then f[1]="요원C의 티타늄 수신기" end
        end
        f[7],f[8],f[9],f[13],f[14],f[15],f[16]="1","0","레전드리","0","0","0","0"
        if kind == "ring" then
            f[10],f[11],f[12]="아이템 드롭률 +10%","메소 획득량 +10%","0"
        else
            local hp,mp="1초마다 최대 HP의 0.5% 회복","1초마다 최대 MP의 0.5% 회복"
            if stars == 5 then
                f[10]=(kind=="necklace" or kind=="pendant") and "아이템 드롭률 +10%" or "메소 획득량 +10%"
                f[11],f[12]=hp,mp
            else f[10],f[11],f[12]=hp,mp,"0" end
        end
        return table.concat(f,"|")
    end

    @ExecSpace("ClientOnly")
    method string BuildAccessory(integer index)
        -- Every box result starts at zero stars and the same fixed grade.
        local row=self:Catalog()[index]
        if row==nil then return "" end
        return self:Normalize(row.name.."|"..row.ruid.."|"..tostring(row.slot).."|0|0|0|1|0|레전드리|0|0|0|0|0|0|0|accessory:"..row.key)
    end

    method string BoxKind(string item)
        -- Old normal boxes retain their identity and stack compatibility.
        local r=string.match(item or "","^[^|]*|([^|]*)") or ""
        if r=="fcaef6c94e144f498bac3c713e7e97e4" then return "premium" end
        if r=="1ba8494660c64b0a94a4c6bd0d67294c" then return "accessory" end
        if r=="90d3412612004466b328850446cb1d68" or (r=="47841bc4d3554cf0a68bd05f19de1f18" and not string.find(item,"cosmetic:",1,true)) then return "normal" end
        return ""
    end

    method string BoxItem(string kind, integer count)
        -- All boxes are consumables with an explicit stack count.
        local r,name="47841bc4d3554cf0a68bd05f19de1f18","장비 상자"
        if kind=="premium" then r,name="fcaef6c94e144f498bac3c713e7e97e4","고급 장비 상자"
        elseif kind=="accessory" then r,name="1ba8494660c64b0a94a4c6bd0d67294c","장신구 상자" end
        return name.."|"..r.."|0|0|0|0|"..tostring(math.max(1,math.min(999,count)))
    end

    method number StarProbability(integer stars, boolean premium)
        -- 강화된 모든 별의 확률을 2배로 올린다. 고급은 5성 이상 10배 관계를 유지한다.
        if stars<0 or stars>30 then return 0 end
        if stars==0 then return premium and 0.0625 or 0.4 end
        local p=0.6/(2^math.min(stars,29))
        if premium and stars>=5 then p=p*10 end
        return p
    end

    method integer RollStars(number roll, boolean premium)
        -- Cumulative probabilities sum to one, including the final 30-star tail.
        local sum=0
        for stars=0,30 do
            sum=sum+self:StarProbability(stars,premium)
            if roll<sum then return stars end
        end
        return 30
    end

    @ExecSpace("ClientOnly")
    method void OpenAccessoryBox(integer source)
        -- Reserve an empty slot before consuming; a full inventory spends nothing.
        local m=_UIEquipInventoryManager
        local box=m:GetTabItem("consume",source)
        if self:BoxKind(box)~="accessory" then return end
        local free=0
        for i=1,128 do if m:GetTabItem("equip",i)=="" then free=i break end end
        if free==0 then _UIToast:ShowMessage("장비 인벤토리에 빈칸이 필요합니다.") return end
        local item=self:BuildAccessory(_UtilLogic:RandomIntegerRange(1,6))
        m:SetTabItem("equip",free,item)
        m:SetTabItem("consume",source,m:WithStackCount(box,m:ParseCount(box)-1))
        m:RefreshUI()
        _CharacterPersistence:MarkDirty("accessory_box")
        _CosmeticBoxCatalog:ShowReveal(m:ParseName(item), m:ParseRUID(item))
        log("[AccessoryBox] opened slot="..tostring(free).." item="..m:ParseName(item))
    end

    @ExecSpace("ClientOnly")
    method number Bonus(string kind)
        -- Drop chance, meso quantity and regeneration are independent additive bonuses.
        local sum=0
        for _,slot in ipairs({10,11,12,13,14,15,26,27}) do
            local item=_UIEquipInventoryManager:GetEquip(slot)
            local key=self:Kind(item)
            local star=_UIEquipInventoryManager:ParseStars(item)
            if _CashShopManager:IsHalfEarring(item) and (kind=="drop" or kind=="meso") then sum=sum+20+2*math.min(5,star)
            elseif key~="" then
                if kind=="regen" and key~="ring" then sum=sum+0.5
                elseif key=="ring" and (kind=="drop" or kind=="meso") then sum=sum+10
                elseif star==5 and ((kind=="drop" and (key=="necklace" or key=="pendant")) or (kind=="meso" and (key=="receiver" or key=="icebar" or key=="glasses"))) then sum=sum+10 end
            end
        end
        return sum
    end

    @ExecSpace("ClientOnly")
    method table RewardBonuses()
        -- Status text and server synchronization share the same additive totals.
        local base = _SkillManager:GetBeginnerDropRatePct()
        return {drop=base+self:Bonus("drop"),meso=base+self:Bonus("meso")}
    end

    @ExecSpace("ClientOnly")
    method void SyncBonuses()
        -- Replacing values avoids stacking duplicate bonuses on UI refresh.
        local bonus=self:RewardBonuses()
        _SkillManager:RequestSyncRewardBonuses(bonus.drop,bonus.meso)
        _MpManager.regenPercentPerSecond=_SkillManager:GetBeginnerMpRegenPct()
        _SkillManager:RequestSyncHpRegen(_SkillManager:GetBeginnerHpRegenPct())
    end

    method table Slots()
        -- These existing locked positions become functional equipment slots.
        return {{10,"SlotRing","반지"},{15,"SlotPendant","펜던트"},{26,"SlotFaceAccessory","얼굴장식"},{27,"SlotEyeAccessory","눈장식"}}
    end

    @ExecSpace("ClientOnly")
    method void RefreshSlots()
        -- Use uploaded sprites directly and avatar items as thumbnails.
        for _,row in ipairs(self:Slots()) do
            local slot=_EntityService:GetEntityByPath("/ui/DefaultGroup/EquipWindow/"..row[2])
            if isvalid(slot) then
                local item=_UIEquipInventoryManager:GetEquip(row[1])
                slot.TextGUIRendererComponent.Text=item=="" and row[3] or ""
                local icon=slot:GetChildByName("Icon")
                icon.Enable=item~=""
                if item~="" then icon.SpriteGUIRendererComponent.ImageRUID=DataRef("thumbnail://".._UIEquipInventoryManager:ParseRUID(item)) end
            end
        end
        self:SyncBonuses()
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Standard inventory handling provides double-click equip and unequip.
        self._T.links={}
        for _,row in ipairs(self:Slots()) do
            local index=row[1]
            local slot=_EntityService:GetEntityByPath("/ui/DefaultGroup/EquipWindow/"..row[2])
            if isvalid(slot) then
                local conn=slot:ConnectEvent(ButtonClickEvent,function()
                    if _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EquipWindow",_InputService:GetCursorPosition()) then _UIEquipInventoryManager:OnSlotClick("equip",index) end
                end)
                table.insert(self._T.links,{entity=slot,connection=conn})
            end
        end
        log("[SpecialEquipment] accessory and equipment box rules ready")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release event connections when the world session ends.
        for _,link in ipairs(self._T.links or {}) do if isvalid(link.entity) then link.entity:DisconnectEvent(ButtonClickEvent,link.connection) end end
    end

    method table GuideLines()
        -- These descriptions use the same catalogue and probability functions as opening.
        local lines={"장신구 상자 · 6종 중 1개, 각각 1/6 (약 16.6667%)","모두 0성 / 레전드리 고정 잠재능력","최대 5성 · 강화로 오르는 능력치는 일반 장비와 동일","잠재능력·에디셔널 재설정 및 부여 불가","",
        "연금술사의 반지","아이템 드롭률 +10% / 메소 획득량 +10%","",
        "나머지 장신구 5종의 기본 잠재능력","초당 최대 HP 0.5% / 최대 MP 0.5% 회복","0차 HP·MP 회복 스킬에 더해집니다.","",
        "슈피겔만의 목걸이 → 5성: 혼돈 목걸이","봉인된 타임리스 펜던트 → 5성: 피어리스 펜던트","두 목걸이는 5성에 아이템 드롭률 +10% 추가",
        "요원C의 낡은 수신기 → 5성: 티타늄 수신기","수신기는 5성에 메소 획득량 +10% 추가","",
        "아이스바 외형 (0~5성 순서)","수박 → 초코 → 메론 → 포도 → 레몬 → 딸기","안경 외형 (0~5성 순서)","금이 간 → 드래곤 → 고고학자 → 미카엘","→ 오닉스 드래곤 → 켄타의 물안경","아이스바·안경은 5성에 메소 획득량 +10% 추가","",
        "드롭률 보너스는 기본 확률에 곱해집니다.","예: 기본 5% × (1 + 20%) = 6%","메소 보너스는 획득 금액에 적용됩니다.","",
        "장비 상자 / 고급 장비 상자","원하는 부위를 선택하고 강화된 장비를 뽑습니다.","고급 상자: 각 5성 이상 확률이 일반의 10배","0성: 일반 "..string.format("%.4g%%",100*self:StarProbability(0,false)).." / 고급 "..string.format("%.4g%%",100*self:StarProbability(0,true)),"5성 이상 합계: 일반 3.75% / 고급 37.5%"}
        for star=0,30 do table.insert(lines,tostring(star).."성: 일반 "..string.format("%.10g%%",100*self:StarProbability(star,false)).." / 고급 "..string.format("%.10g%%",100*self:StarProbability(star,true))) end
        return lines
    end
    method table TransparentSet()
        -- Transparent cosmetics retain a visible inventory icon while clearing their outfit slot.
        return {
            "투명 귀장식|b126bc4570f04c93b37f858a0c9a9400|deco|earacc|0|transparent:1",
            "투명 눈장식|d268af6548be4da7820371bc2beddab1|deco|eyeacc|0|transparent:1",
            "투명 신발|981c7e58c40a4c8a81f24386f87523a9|deco|shoes|0|transparent:1",
            "투명 망토|fa80ac34e1d54cd2b2dd4757b34149c5|deco|cape|0|transparent:1",
            "투명 장갑|ec0e9d6ac275405da228f015c24aebca|deco|glove|0|transparent:1",
            "투명 얼굴장식|b126bc4570f04c93b37f858a0c9a9400|deco|faceacc|0|transparent:1"
        }
    end

    @ExecSpace("ClientOnly")
    method void OpenTransparentSet(integer source)
        -- Check all six destination slots first so opening is all-or-nothing.
        local m=_UIEquipInventoryManager
        local box=m:GetTabItem("consume",source)
        if m:ParseRUID(box)~="483576f627ae4205a02425b1ecd7983f" then return end
        local free={}
        for i=1,128 do if m:GetTabItem("decorate",i)=="" then table.insert(free,i) end end
        if #free<6 then _UIToast:ShowMessage("치장 인벤토리에 빈칸 6개가 필요합니다.") return end
        for i,item in ipairs(self:TransparentSet()) do m:SetTabItem("decorate",free[i],item) end
        m:SetTabItem("consume",source,m:WithStackCount(box,m:ParseCount(box)-1))
        m:RefreshUI()
        _CharacterPersistence:MarkDirty("transparent_set")
        _UIToast:ShowMessage("투명 치장 아이템 6개를 획득했습니다.")
    end

end
