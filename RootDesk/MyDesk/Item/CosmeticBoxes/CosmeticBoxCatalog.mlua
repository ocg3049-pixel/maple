    method table Colors(string ruid)
        -- Search native family data first; parse only the matching style's color choices.
        self._T.colors=self._T.colors or {}
        if self._T.colors[ruid]~=nil then return self._T.colors[ruid] end
        for _, key in ipairs({"hair","face"}) do
            local c=self:Category(key)
            for part=1,c.parts do
                local raw=self:ReadData(key,part)
                if string.find(raw,ruid,1,true) then
                    for line in string.gmatch(raw,"[^\r\n]+") do
                        if string.find(line,ruid,1,true) then
                            local colors=string.match(line,"^[^\t]+\t[^\t]+\t[^\t]+\t[^\t]+\t(.+)$")
                            local choices={}
                            for entry in string.gmatch(colors or "","[^|]+") do
                                local r,n,label=string.match(entry,"^([^~]+)~([^~]+)~(.+)$")
                                if r then table.insert(choices,{n,r,label,true}) end
                            end
                            if #choices>0 then
                                for _, choice in ipairs(choices) do self._T.colors[choice[2]]=choices end
                                self._T.colors[ruid]=choices
                                return choices
                            end
                        end
                    end
                end
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method string Description(string item)
        local box=self:Box(self:BoxId(item))
        if box==nil then return "" end
        local count=box.key=="weapon" and #self:WeaponIndices(_UIMyInfoManager:GetSelectedCharacterJobIdx()) or box.count
        local text = tostring(count).."종 중 1개를 같은 확률로 획득합니다.\n각 아이템 확률: 1/"..tostring(count).."\n더블클릭으로 1개 사용 · 최대 999개 중첩"
        if self:HasNoShardReward(item) then
            text = text .. "\n<color=#FF6A6A>10·20·30레벨 달성 보상 상자</color>\n<color=#FF6A6A>이 상자에서 얻은 코디를 분해해도</color>\n<color=#FF6A6A>코디 조각을 얻을 수 없습니다. (0개)</color>"
        else
            if box.key=="skin" then
                text = text .. "\n캐시샵 구매 · 10레벨 달성 보상"
            else
                text = text .. "\n사냥 기본 드롭률: 상자 합계 " .. string.format("%.5f%%", _MonsterDropRules:GetCosmeticDropChance()*100)
            end
            text = text .. "\n일반 코디 분해 → 조각 1개\n기본 지급·레벨 보상 코디 → 조각 0개\n조각 30개 → 원하는 코디 1개"
        end
        return text .. (box.key=="weapon" and "\n공용 무기 포함 · 직업에 맞는 무기 등장" or "")
    end

    @ExecSpace("ClientOnly")
    method boolean GrantBox(string id, integer count)
        -- Reusable grant entry point; acquisition sources are intentionally not enabled yet.
        local inv=_UIEquipInventoryManager
        local item=self:BoxItem(id,count)
        if item=="" then return false end
        local stackKey=inv:ConsumableStackKey(item)
        local room=0
        for i=1,128 do
            local s=inv:GetTabItem("consume",i)
            if s=="" then room=room+999 elseif inv:ConsumableStackKey(s)==stackKey then room=room+999-inv:ParseCount(s) end
        end
        if room<count then return false end
        local left=count
        for pass=1,2 do
            for i=1,128 do
                local s=inv:GetTabItem("consume",i)
                if (pass==1 and s~="" and inv:ConsumableStackKey(s)==stackKey) or (pass==2 and s=="") then
                    local old=s=="" and 0 or inv:ParseCount(s)
                    local add=math.min(left,999-old)
                    if add>0 then inv:SetTabItem("consume",i,self:BoxItem(id,old+add)) left=left-add end
                    if left==0 then break end
                end
            end
            if left==0 then break end
        end
        inv:RefreshUI() _CharacterPersistence:MarkDirty("cosmetic_box_grant")
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean Open(integer sourceSlot)
        -- Validate destination capacity before rolling or consuming; all mutations happen without yielding.
        local inv=_UIEquipInventoryManager
        local item=inv:GetTabItem("consume",sourceSlot)
        local box=self:Box(self:BoxId(item))
        if box==nil then return false end
        local job=_UIMyInfoManager:GetSelectedCharacterJobIdx()
        if box.job>0 and box.job~=job then _UIToast:ShowMessage("해당 직업의 무기 상자만 사용할 수 있습니다.") return false end
        local tab=(box.key=="hair" or box.key=="face") and "equip" or "decorate"
        local empty=0
        for i=1,128 do if inv:GetTabItem(tab,i)=="" then empty=i break end end
        if empty==0 then _UIToast:ShowMessage(tab=="equip" and "장비 인벤토리에 빈칸이 필요합니다." or "치장 인벤토리에 빈칸이 필요합니다.") return false end
        local reward=self:Roll(box.id,job,_UtilLogic:RandomDouble())
        if reward==nil then return false end
        local result=self:RewardItem(reward)
        if result=="" then return false end
        if self:HasNoShardReward(item) then result=result.."|cosmetic-no-shards:1" end
        if inv:GetTabItem("consume",sourceSlot)~=item or inv:GetTabItem(tab,empty)~="" then return false end
        inv:SetTabItem(tab,empty,result)
        local remaining=inv:ParseCount(item)-1
        inv:SetTabItem("consume",sourceSlot,inv:WithStackCount(item,remaining))
        inv:CancelInvenDrag() inv:RefreshUI() inv:HideTooltip()
        _CharacterPersistence:MarkDirty("cosmetic_box_open")
        _AcquisitionLog:Push(reward.name.." +1",false)
        self:ShowReveal(reward.name,reward.ruid)
        _GameAudio:PlaySound("c6da79f93bc34e7cb213080a00f09fef",1)
        log("[CosmeticBox] opened="..box.id.." destination="..tab.." ruid="..reward.ruid)
        return true
    end
    method table NewCategories()
        local result={}
        for _,c in ipairs(self:Categories()) do if not string.find(c.key,"weapon_",1,true) then table.insert(result,c) end end
        return result
    end

    method table DropCategories()
        -- Keep the existing hunting pool; skin boxes are sold in the cash shop and given at level 10.
        local result={}
        for _,c in ipairs(self:NewCategories()) do if c.key~="skin" then table.insert(result,c) end end
        return result
    end

    method table WeaponIndices(integer job)
        self._T.weaponIndices=self._T.weaponIndices or {}
        if self._T.weaponIndices[job]~=nil then return self._T.weaponIndices[job] end
        local rows={}
        for value in string.gmatch(_CosmeticDataWeapon:Indices(job),"%d+") do table.insert(rows,tonumber(value)) end
        self._T.weaponIndices[job]=rows
        return rows
    end

    method table ParseRow(string line)
        local r,n,cat,jobs,colors=string.match(line,"^([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)\t(.+)$")
        if r==nil then return nil end
        return {ruid=r,name=n,category=cat,jobs=jobs,colors=colors}
    end

    method table RowAt(string key, integer index)
        local c=self:Category(key)
        if c==nil or index<1 or index>c.count then return nil end
        local chunk=math.floor((index-1)/100)+1
        local wanted=((index-1)%100)+1
        local i=0
        for line in string.gmatch(self:ReadData(key,chunk),"[^\r\n]+") do
            i=i+1
            if i==wanted then return self:ParseRow(line) end
        end
        return nil
    end

    method boolean Allowed(table row, integer job)
        if row == nil then return false end
        if row.jobs == "-" then return true end
        for value in string.gmatch(row.jobs or "", "%d+") do
            if tonumber(value) == job then return true end
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method void ShowReveal(string itemName, string ruid)
        -- Hide the previous texture before asynchronous loading; stale callbacks cannot replace a newer reward.
        local card = _EntityService:GetEntityByPath("/ui/CosmeticRevealGroup/Card")
        if not isvalid(card) then return end
        self._T.revealRevision = (self._T.revealRevision or 0) + 1
        local revision = self._T.revealRevision
        if self._T.revealReadyTimer ~= nil then _TimerService:ClearTimer(self._T.revealReadyTimer) self._T.revealReadyTimer = nil end
        self._T.revealTime = nil
        card.Enable = false
        local icon = card:GetChildByName("Icon").SpriteGUIRendererComponent
        icon.Color = Color(1, 1, 1, 0)
        icon.ImageRUID = DataRef("")
        card:GetChildByName("Name").TextGUIRendererComponent.Text = itemName
        local imageRuid = "thumbnail://" .. ruid
        _ResourceService:PreloadAsync({imageRuid}, function(results)
            if self._T.revealRevision ~= revision or not isvalid(card) or not isvalid(icon) then return end
            icon.ImageRUID = DataRef(imageRuid)
            -- Keep the renderer active but transparent while its cached image is applied.
            card.CanvasGroupComponent.GroupAlpha = 0
            card.Enable = true
            self._T.revealReadyTimer = _TimerService:SetTimerOnce(function()
                if self._T.revealRevision ~= revision or not isvalid(card) or not isvalid(icon) then return end
                self._T.revealReadyTimer = nil
                icon.Color = Color.white
                card.CanvasGroupComponent.GroupAlpha = 1
                card.UITransformComponent.UIScale = Vector3(1.08, 1.08, 1)
                for i = 0, 5 do card:GetChildByName("Spark" .. tostring(i)).Enable = true end
                self._T.revealTime = 0
                log("[CosmeticReveal] ready revision=" .. tostring(revision) .. " item=" .. itemName .. " ruid=" .. ruid)
            end, 0.05)
        end)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Brief gold rays and a readable item card after a successful grant.
        local card=_EntityService:GetEntityByPath("/ui/CosmeticRevealGroup/Card")
        if not isvalid(card) then return end
        if self._T.revealTime==nil then return end
        self._T.revealTime=self._T.revealTime+delta
        local t=self._T.revealTime
        local alpha=math.min(1,math.max(0,(4-t)/0.5))
        card.CanvasGroupComponent.GroupAlpha=alpha
        local scale=1+0.08*math.max(0,1-t/0.35)
        card.UITransformComponent.UIScale=Vector3(scale,scale,1)
        for i=0,5 do
            local spark=card:GetChildByName("Spark"..tostring(i))
            spark.Enable=t<1.1
            spark.UITransformComponent.UIRotation=Vector3(0,0,i*60+t*50)
        end
        if t>=4 then card.Enable=false self._T.revealTime=nil log("[CosmeticReveal] hide") end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Clear transient presentation; rewards were already committed before enqueueing.
        self._T.revealTime=nil
        self._T.revealRevision=(self._T.revealRevision or 0)+1
        if self._T.revealReadyTimer~=nil then _TimerService:ClearTimer(self._T.revealReadyTimer) self._T.revealReadyTimer=nil end
    end
end
