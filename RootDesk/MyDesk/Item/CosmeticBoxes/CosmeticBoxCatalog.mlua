        -- Stable category IDs and counts; append future items without changing existing boxes.
        if self._T.categories~=nil then return self._T.categories end
        self._T.categories={
            {key="hair",name="헤어",count=1729,parts=18,boxes=58,job=0},
            {key="face",name="성형",count=1462,parts=15,boxes=49,job=0},
