            {key="shoes",name="신발",count=959,parts=10,boxes=32,job=0},
            {key="glove",name="장갑",count=476,parts=5,boxes=16,job=0},
            {key="faceaccessory",name="얼굴장식",count=500,parts=5,boxes=17,job=0},
