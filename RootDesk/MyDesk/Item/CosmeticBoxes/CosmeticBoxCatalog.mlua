@Logic
script CosmeticBoxCatalog extends Logic
    property string boxRuid = "47841bc4d3554cf0a68bd05f19de1f18"

    method string BoxIcon(string key)
        -- Display-only artwork: saved box IDs and their reward pools remain stable.
        if string.find(key or "", "weapon_", 1, true) == 1 then key = "weapon" end
        self._T.boxIcons = self._T.boxIcons or {
            skin = "ed08e5bd07cc4c2d89b26084ba2b0b3d",
            hair = "d44c6859fdb8478d9100629808ff8b0a",
            face = "abb840bb38d44deb972eb551d0582c75",
            cap = "00a3ffb896994b4d8d6b04a6878ca62b",
            cape = "d7b1057f1c474397a00433ae0cde717e",
            coat = "c0e589927e394d9f8c62b0e5ad92a323",
            pants = "8c9b7bbc06fb4b9f94a70d858189dbc4",
            longcoat = "6027a72fe4e34a1c97c950263a09f78a",
            shoes = "88374b8335ef4a3ca94d42310c565fac",
            glove = "46b7a0131c23412aba0352907899de54",
            faceaccessory = "110ef9dfef2245b28bf974ff92fe1d3b",
            eyeaccessory = "7e1893c82fa5414bb8b90b6728b57fd7",
            earaccessory = "2d4f4af232a747ecb67fe354fbf6edef",
            weapon = "1a4565ca40b9491f85b0b8936e615961"
        }
        return self._T.boxIcons[key] or self.boxRuid
    end

