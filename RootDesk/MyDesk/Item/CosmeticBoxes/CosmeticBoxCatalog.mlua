            {key="earaccessory",name="귀장식",count=218,parts=3,boxes=8,job=0},
            {key="weapon",name="무기",count=3013,parts=31,boxes=1,job=0},
            {key="weapon_1",name="히어로 무기",count=23,parts=1,boxes=1,job=1},
            {key="weapon_2",name="팔라딘 무기",count=23,parts=1,boxes=1,job=2},
            {key="weapon_3",name="다크나이트 무기",count=23,parts=1,boxes=1,job=3},
            {key="weapon_4",name="비숍 무기",count=23,parts=1,boxes=1,job=4},
            {key="weapon_5",name="아크메이지(썬콜) 무기",count=23,parts=1,boxes=1,job=5},
            {key="weapon_6",name="아크메이지(불독) 무기",count=23,parts=1,boxes=1,job=6},
            {key="weapon_7",name="신궁 무기",count=23,parts=1,boxes=1,job=7},
            {key="weapon_8",name="보우마스터 무기",count=23,parts=1,boxes=1,job=8},
            {key="weapon_9",name="나이트로드 무기",count=22,parts=1,boxes=1,job=9},
            {key="weapon_10",name="섀도어 무기",count=23,parts=1,boxes=1,job=10},
            {key="skin",name="피부",count=18,parts=1,boxes=1,job=0},
        }
        return self._T.categories
    end

    method string ReadData(string key, integer part)
        -- Load only the requested category, not every avatar on login.
        if key=="skin" then
            if part~=1 then return "" end
            return [====[
04e82396b2ba40ab9d860f993447f3eb	뽀송 꽃잎 피부	body	-	-
2f62f3dbbbcb4809ae353831a4d62c5e	고져스 피부	body	-	-
3cf4cb29ae344577b9eed37e531688a4	크림 피부	body	-	-
504244b76e654f5db23dc62693106bc8	헬시 피부	body	-	-
5b510a5cb03b4ba9bfe1b1666b17b2cf	밀키 피부	body	-	-
7a420535a9bb41a1ae2d129576fdb383	엘프 피부	body	-	-
a7df8f459b2348f5ab88ee3fa0b1de05	태닝 피부	body	-	-
b103dbf5d7a741e4ba61ddb44d73966b	홍조 꽃잎 피부	body	-	-
b9c5c60cb0b8447caa6ac87db8c04ac2	스산 피부	body	-	-
bc8a35363dfd4d1ba6bb8c1ea67abd20	노블레스 피부	body	-	-
cac5feea57f84e7281e10fcce190b648	데모닉 피부	body	-	-
f3ab6f5110294f03925699374cc467ac	창백 피부	body	-	-
02daf02e8a8649318cd006c92beaa486	뽀송 라벤더 피부	body	-	-
ac753a90b98143db83b176ee59fd8237	은구슬 피부	body	-	-
b65a754c25174b10a24d0288ca0468a0	금구슬 피부	body	-	-
d2bb955141df400bb5acf8891cfe37ce	홍조 라벤더 피부	body	-	-
d7f9df9ca6a54191ad01096b93680b0a	동구슬 피부	body	-	-
e3927c5826b740b699b577c671d95d4f	옥구슬 피부	body	-	-
]====]
        end
        if key=="weapon" then return _CosmeticDataWeapon:Data(part) end
        if key=="hair" then return _CosmeticDataHair:Data(part) end
        if key=="face" then return _CosmeticDataFace:Data(part) end
        if key=="cap" then return _CosmeticDataCap:Data(part) end
        if key=="cape" then return _CosmeticDataCape:Data(part) end
        if key=="coat" then return _CosmeticDataCoat:Data(part) end
        if key=="pants" then return _CosmeticDataPants:Data(part) end
        if key=="longcoat" then return _CosmeticDataLongcoat:Data(part) end
        if key=="shoes" then return _CosmeticDataShoes:Data(part) end
        if key=="glove" then return _CosmeticDataGlove:Data(part) end
        if key=="faceaccessory" then return _CosmeticDataFaceaccessory:Data(part) end
        if key=="eyeaccessory" then return _CosmeticDataEyeaccessory:Data(part) end
        if key=="earaccessory" then return _CosmeticDataEaraccessory:Data(part) end
        if key=="weapon_1" then return _CosmeticDataWeapon1:Data(part) end
        if key=="weapon_2" then return _CosmeticDataWeapon2:Data(part) end
        if key=="weapon_3" then return _CosmeticDataWeapon3:Data(part) end
        if key=="weapon_4" then return _CosmeticDataWeapon4:Data(part) end
        if key=="weapon_5" then return _CosmeticDataWeapon5:Data(part) end
        if key=="weapon_6" then return _CosmeticDataWeapon6:Data(part) end
        if key=="weapon_7" then return _CosmeticDataWeapon7:Data(part) end
        if key=="weapon_8" then return _CosmeticDataWeapon8:Data(part) end
        if key=="weapon_9" then return _CosmeticDataWeapon9:Data(part) end
        if key=="weapon_10" then return _CosmeticDataWeapon10:Data(part) end
        return ""
    end

    method table Category(string key)
        -- Category lookup does not parse the large item catalog.
        for _, c in ipairs(self:Categories()) do if c.key==key then return c end end
        return nil
    end

    method table Items(string key)
        -- Parse frozen rows once, preserving their order and their original resource categories.
        self._T.items=self._T.items or {}
        self._T.byRuid=self._T.byRuid or {}
        if self._T.items[key]~=nil then return self._T.items[key] end
        local c=self:Category(key)
        if c==nil then return {} end
        local rows={}
        for part=1,c.parts do
            for line in string.gmatch(self:ReadData(key,part),"[^\r\n]+") do
                local r,n,cat,jobs,colors=string.match(line,"^([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)\t(.+)$")
                if r~=nil then
                    local row={ruid=r,name=n,category=cat,jobs=jobs,colors=colors}
                    table.insert(rows,row) self._T.byRuid[r]=row
                end
            end
        end
        self._T.items[key]=rows
        return rows
    end

    method table Box(string id)
        local key=string.match(id or "","^cosmetic:([%w_]+)$")
        if key~=nil then
            local c=self:Category(key)
            if c==nil or string.find(key,"weapon_",1,true) then return nil end
            return {id=id,key=key,page=0,name=c.name.." 코디 상자",job=0,count=c.count}
        end
        -- Already owned 30-item boxes keep their original pool and identity.
        local oldKey,index=string.match(id or "","^cosmetic:([%w_]+):(%d+)$")
        local c=oldKey and self:Category(oldKey) or nil
        local page=tonumber(index) or 0
        if c==nil or oldKey=="weapon" or page<1 or page>c.boxes then return nil end
        return {id=id,key=oldKey,page=page,name=c.name.." 랜덤 상자 "..tostring(page),job=c.job,count=math.min(30,c.count-(page-1)*30)}
    end

    method table Contents(string id)
        -- A box parses at most two 100-row chunks; never load an entire wardrobe to open one item.
        self._T.boxContents=self._T.boxContents or {}
        if self._T.boxContents[id]~=nil then return self._T.boxContents[id] end
        local box=self:Box(id)
        if box==nil then return {} end
        if box.page==0 then return self:Items(box.key) end
        local first=(box.page-1)*30+1
        local last=first+box.count-1
        local result={}
        for part=math.floor((first-1)/100)+1,math.floor((last-1)/100)+1 do
            local index=(part-1)*100
            for line in string.gmatch(self:ReadData(box.key,part),"[^\r\n]+") do
                index=index+1
                if index>=first and index<=last then
                    local r,n,cat,jobs,colors=string.match(line,"^([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)\t(.+)$")
                    if r then table.insert(result,{ruid=r,name=n,category=cat,jobs=jobs,colors=colors}) end
                end
            end
        end
        self._T.boxContents[id]=result
        return result
    end

    method string BoxItem(string id, integer count)
        -- Count is field 7; the stable box ID in field 8 prevents different boxes merging.
        local box=self:Box(id)
        if box==nil or count<1 or count>999 then return "" end
        return box.name.."|"..self.boxRuid.."|0|0|0|0|"..tostring(count).."|"..id
    end

    method boolean HasNoShardReward(string item)
        -- Source metadata survives stacking, opening, equipping, recoloring and saving.
        return string.find((item or "").."|", "|cosmetic-no-shards:1|", 1, true) ~= nil
    end

    method string LevelRewardBoxItem(string id, integer count)
        -- Milestone gifts share the normal pool but never grant dismantling currency.
        local item = self:BoxItem(id, count)
        if item == "" then return "" end
        return item .. "|cosmetic-no-shards:1"
    end

    method string BoxId(string item)
        return string.match(item or "","|(cosmetic:[%w_]+:%d+)") or string.match(item or "","|(cosmetic:[%w_]+)") or ""
    end

    method table Roll(string id, integer job, number randomValue)
        local box=self:Box(id)
        if box==nil or (box.job>0 and box.job~=job) then return nil end
        if box.page==0 then
            local indices=box.key=="weapon" and self:WeaponIndices(job) or nil
            local count=indices and #indices or box.count
            if count==0 then return nil end
            local pick=math.min(count,math.max(1,math.floor(randomValue*count)+1))
            return self:RowAt(box.key,indices and indices[pick] or pick)
        end
        local rows=self:Contents(id)
        if #rows==0 then return nil end
        return rows[math.min(#rows,math.max(1,math.floor(randomValue*#rows)+1))]
    end

    method string RewardItem(table row)
        -- Hair/face are actual equipment; every other reward only overrides appearance.
        if row.category=="hair" or row.category=="face" then
            return row.name.."|"..row.ruid.."|"..(row.category=="hair" and "2" or "1").."|0|0|0"..string.rep("|0",10).."|cosmetic-earned:1"
        end
        local cats={body="skin",cap="cap",cape="cape",coat="coat",pants="pants",longcoat="longcoat",shoes="shoes",glove="glove",faceaccessory="faceacc",eyeaccessory="eyeacc",earaccessory="earacc",weapon="weapon1",twohandweapon="weapon2"}
        local cat=cats[row.category]
        if cat==nil then return "" end
        return row.name.."|"..row.ruid.."|deco|"..cat.."|"..row.jobs..string.rep("|0",11).."|cosmetic-earned:1"
    end

    method boolean CanEquipWeapon(string item, integer job)
        -- New weapon rewards carry the confirmed job whitelist in field 5.
        local cat,jobs=string.match(item or "","|deco|(weapon[12])|([^|]+)")
        if cat==nil then return true end
        if jobs=="-" then return true end
        return self:Allowed({jobs=jobs}, job)
    end

    method string ResourceCategory(string ruid)
        -- Native string lookup avoids parsing thousands of items while refreshing the avatar.
        if ruid=="" then return "" end
        self._T.resourceCategories=self._T.resourceCategories or {}
        if self._T.resourceCategories[ruid]~=nil then return self._T.resourceCategories[ruid] end
        local raw=self:ResourceIndex()
        local first,last=string.find(raw,ruid.."\t",1,true)
        local category=first and string.match(raw,"([^\r\n]+)",last+1) or ""
        self._T.resourceCategories[ruid]=category
        return category
    end

