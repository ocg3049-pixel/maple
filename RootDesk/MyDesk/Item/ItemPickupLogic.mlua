@Logic
script ItemPickupLogic extends Logic

    -- 드랍 아이템을 특정 클라이언트에게 전달 (Server→Client RPC)
    @ExecSpace("Client")
    method void DeliverItem(string itemName, string itemRUID, string itemType)
        -- (요청 2026-08-07) 아이템이 캐릭터에게 다 빨려 들어와 습득이 확정되는 순간의 습득음.
        -- ⚠ 처음엔 DroppedItemComponent에 Client 메서드를 두었는데 **소리가 나지 않았다** -
        --   그 경로는 `self.Entity:Destroy()`가 먼저 실행돼 컴포넌트가 사라진 뒤라 RPC가 나가지 못한다.
        --   Logic은 엔티티 수명과 무관하니 여기서 재생한다(모든 습득 경로가 이 메서드로 모인다 -
        --   플레이어 충돌 습득도, 발판 없는 아이템 일괄 회수도 전부 DeliverItem을 탄다).
        -- 이미 습득한 본인에게만 오는 Client RPC라 별도 대상 지정이 필요 없다.
        _SoundService:PlaySound("c6da79f93bc34e7cb213080a00f09fef", 1.0)
        if itemType == "meso" then
            local amount = tonumber(itemName) or 0
            log("[ItemPickup] 메소 습득: " .. tostring(amount) .. "원")
            _UIEquipInventoryManager:AddMeso(amount)
        else
            log("[ItemPickup] 아이템 자동 습득: " .. itemName)
            _UIEquipInventoryManager:AddItemToInventory(itemName, itemRUID, itemType)
        end
    end

end
