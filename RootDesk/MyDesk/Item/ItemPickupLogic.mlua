@Logic
script ItemPickupLogic extends Logic

    -- 드랍 아이템을 특정 클라이언트에게 전달 (Server→Client RPC)
    @ExecSpace("Client")
    method void DeliverItem(string itemName, string itemRUID, string itemType)
        -- (요청 2026-08-07) 아이템이 캐릭터에게 다 빨려 들어와 습득이 확정되는 순간의 습득음.
        -- ⚠ 처음엔 DroppedItemComponent에 Client 메서드를 두었는데 **소리가 나지 않았다** -
        --   그 경로는 `self.Entity:Destroy()`가 먼저 실행돼 컴포넌트가 사라진 뒤라 RPC가 나가지 못한다.
        --   Logic은 엔티티 수명과 무관하니 여기서 재생한다(모든 습득 경로가 이 메서드로 모인다 -
        --   플레이어 충돌 습득도, 발판 없는 아이템 일괄 회수도 전부 DeliverItem을 탄다).
        -- 이미 습득한 본인에게만 오는 Client RPC라 별도 대상 지정이 필요 없다.
        _GameAudio:PlaySound("c6da79f93bc34e7cb213080a00f09fef", 1.0)
        if itemType == "meso" then
            local amount = tonumber(itemName) or 0
            if Environment:IsMakerPlay() then log("[ItemPickup] 메소 습득: " .. tostring(amount) .. "원") end
            _UIEquipInventoryManager:AddMeso(amount)
            if amount > 0 then _AcquisitionLog:Push("메소 +" .. _UIEquipInventoryManager:FormatMeso(amount), true) end
        else
            if Environment:IsMakerPlay() then log("[ItemPickup] 아이템 자동 습득: " .. itemName) end
            local added = _UIEquipInventoryManager:AddItemToInventory(itemName, itemRUID, "hunt:"..itemType)
            if added then
                self:ShowDropNotice(itemName,itemRUID,itemType)
                if itemRUID == "47841bc4d3554cf0a68bd05f19de1f18" and string.sub(itemType or "",1,9)~="cosmetic:" then itemName = "드롭 아이템" end
                _AcquisitionLog:Push(itemName .. " +1", false)
            end
        end
    end

    method boolean ShouldAnnounce(string name, string ruid, string itemType)
        -- Cosmetic boxes share an old normal-box icon, so identity includes their type.
        if itemType=="meso" then return false end
        if string.sub(itemType or "",1,9)=="cosmetic:" then return true end
        return name~="장비 상자" and name~="드롭 아이템" and ruid~="47841bc4d3554cf0a68bd05f19de1f18" and ruid~="90d3412612004466b328850446cb1d68"
    end

    @ExecSpace("Client")
    method void ShowDropNotice(string name, string ruid, string itemType)
        -- Only successful pickup paths call this; exclude meso and ordinary equipment boxes.
        if not self:ShouldAnnounce(name,ruid,itemType) then return end
        local gear=_FieldEquipmentDrops:ItemFromDescriptor(itemType)
        if gear~="" then name=name.." ("..tostring(_UIEquipInventoryManager:ParseStars(gear)).."성)" end
        self:ShowGoldNotice(name.." 아이템을 획득하셨습니다.")
    end

    @ExecSpace("ClientOnly")
    method void ShowGoldNotice(string message)
        -- Shared upper-center, backgroundless notification queue.
        self._T.noticeQueue=self._T.noticeQueue or {}
        table.insert(self._T.noticeQueue,message)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- A short queue preserves each pickup during bursts, with at most four visible messages.
        local now=_UtilLogic.ElapsedSeconds
        self._T.notices=self._T.notices or {}
        for i=#self._T.notices,1,-1 do
            local rec=self._T.notices[i] local age=now-rec.at
            if age>=2.8 or not isvalid(rec.node) or not _LoginFlow:IsInGame() then
                if isvalid(rec.node) then rec.node:Destroy() end
                table.remove(self._T.notices,i)
                if Environment:IsMakerPlay() then log("[VRF][DropNotice] expired") end
            else
                rec.node.UITransformComponent.anchoredPosition=Vector2(0,rec.y+age*30)
                rec.node.CanvasGroupComponent.GroupAlpha=math.max(0,1-age/2.8)
            end
        end
        if not _LoginFlow:IsInGame() then self._T.noticeQueue={} return end
        if #(self._T.noticeQueue or {})==0 or #self._T.notices>=4 or now<(self._T.nextNotice or 0) then return end
        local template=_EntityService:GetEntityByPath("/ui/CarnivalFeedbackUI/MessageTemplate")
        if not isvalid(template) then return end
        local node=_SpawnService:SpawnByEntity(template,"ItemPickupNotice",Vector3.zero,template.Parent,false)
        if not isvalid(node) then return end
        for _,rec in ipairs(self._T.notices) do rec.y=rec.y+38 end
        local tr=node.UITransformComponent
        tr.AlignmentOption=AlignmentType.Center tr.AnchorsMin=Vector2(.5,.5) tr.AnchorsMax=Vector2(.5,.5) tr.Pivot=Vector2(.5,.5)
        tr.anchoredPosition=Vector2(0,240)
        node.TextGUIRendererComponent.Text=table.remove(self._T.noticeQueue,1)
        node.TextGUIRendererComponent.FontColor=Color(1,0.82,0.32,1)
        node.SpriteGUIRendererComponent.Enable=false
        node.CanvasGroupComponent.GroupAlpha=1 node.CanvasGroupComponent.BlocksRaycasts=false
        node.Enable=true
        table.insert(self._T.notices,{node=node,at=now,y=240})
        self._T.nextNotice=now+.25
        if Environment:IsMakerPlay() then log("[VRF][DropNotice] created gold center text: "..node.TextGUIRendererComponent.Text) end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Clear all clones and queued messages when the session ends.
        for _,rec in ipairs(self._T.notices or {}) do if isvalid(rec.node) then rec.node:Destroy() end end
        self._T.notices={} self._T.noticeQueue={}
    end

end
