@Logic
script EnhancementManager extends Logic

	-- ─── 공통 경로 상수 ──────────────────────────────────────────────────
	-- RightPanel 하위
	property string pathSlotArea   = "/ui/DefaultGroup/EnhanceWindow/RightPanel/SlotArea"
	property string pathContent    = "/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea"
	-- LeftPanel 탭
	property string pathLeft       = "/ui/DefaultGroup/EnhanceWindow/LeftPanel"

	-- 강화 대상 아이템
	property string enhanceTargetName = ""
	property string enhanceTargetRUID = ""
	property number enhanceTargetInvenIdx = 0
	property integer enhanceLevel = 0
	property integer currentTab = 0   -- 0=없음 1=스타포스 2=주문서 3=추가옵션 4=잠재능력 5=에디셔널

	-- 큐브 리셋 UI 상태
	property integer potSelectedSlot = 0   -- 잠재능력 탭 선택 큐브 슬롯 (1-18, 0=미선택)
	property integer addSelectedSlot = 0   -- 에디셔널 탭 선택 큐브 슬롯
	property integer potCurrencyTab  = 0   -- 0=큐브, 1=메소
	property integer addCurrencyTab  = 0
	property integer scrollSelectedSlot = 0   -- 주문서 탭 선택 슬롯 (1-8, 0=미선택)
	property string enhanceTargetItemStr = ""  -- 대상 아이템 전체 문자열
	property string enhanceTargetSrcTab  = ""  -- 대상 아이템이 위치한 인벤 탭 키
	-- (신규) 장착 중인 장비를 대상으로 올린 경우 그 장비 슬롯(1~9). 0이면 인벤 아이템 대상(기존 경로).
	-- 강화/주문서/큐브 결과 반영과 파괴가 이 값으로 인벤·장비창 중 올바른 쪽에 기록된다.
	property integer enhanceTargetEquipSlot = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Initialize local enhancement state and one-shot result feedback.
		self._T.cubeFlash = nil
		self._T.cubeFlashElapsed = 0
		self._T.cubeFlashPeak = 0
		self._T.potCubeSlots = {}
		self._T.addCubeSlots = {}
		self._T.scrollSlots = {}
		self._T.tabPotDisabled = true   -- 아이템 없으면 기본 비활성화
		self._T.tabAddDisabled = true
		self._T.confirmInfoOnly = false   -- ConfirmDialog가 "사용 불가 아이템" 안내 전용인지 여부
		self._T.pendingCubeTab = 0
		self._T.pendingCubeOldItem = ""
		self._T.pendingCubeNewItem = ""
		self._T.pendingCubeGradeUp = false
		self._T.pendingCubeGradeCommitted = false
		self._T.pendingCubeChoice = ""
		self._T.confirmMode = ""
		-- 강화 열기 버튼 (인벤창 하단)
		self._T.cubeUseRequest = nil
		self._T.scrollUseRequest = nil
		local openBtn = _EntityService:GetEntityByPath("/ui/DefaultGroup/InvenWindow/MesoBar/EnhanceOpenBtn")
		log("[Enhance] openBtn isvalid=" .. tostring(isvalid(openBtn)))
		if isvalid(openBtn) then
			if not isvalid(openBtn:GetComponent("MOD.Core.UITouchReceiveComponent")) then
				openBtn:AddComponent("MOD.Core.UITouchReceiveComponent")
			end
			openBtn:ConnectEvent(UITouchDownEvent, self.OnOpenBtnClick)
			log("[Enhance] EnhanceOpenBtn wired")
		end

		-- 창 버튼 와이어링 후 숨기기
		self:WireWindowButtons()
		-- (원작 개편) 새 배경 스프라이트들의 렌더 순서 보정 - .ui 로드 시 배열 뒤에 추가된 배경이
		-- 기존 형제 위에 그려지므로 형제 맨 앞(index 1 = 맨 뒤 렌더)으로 내린다.
		self:ApplyRedesignZOrder()
		self:InitAmbientSparkles()
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow")
		if isvalid(w) then w.Enable = false end

		-- 키보드
		_InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		-- 탭 클릭 (ScreenTouchReleaseEvent: 마우스 클릭 100% 감지)
		_InputService:ConnectEvent(ScreenTouchReleaseEvent, self.OnScreenTabRelease)
		log("[Enhance] EnhancementManager ready")
	end

	@ExecSpace("ClientOnly")
	method void ApplyRedesignZOrder()
		-- 원작 스타일 리디자인으로 추가된 "배경" 스프라이트들을 각 부모의 형제 index 1로 내려
		-- 기존 컨텐츠(탭/슬롯/별 그리드/큐브 슬롯)가 배경 위에 그려지도록 보정한다.
		-- 같은 부모 안에서 여러 개를 내릴 때는 "가장 아래에 깔릴 것"을 마지막에 호출한다.
		local bgPaths = {
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/SlotArea/NamePillBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/SlotArea/RankupBarBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/SlotArea/SlotSectionBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/StarforceContent/ArrowPillBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/StarforceContent/StatBoxBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/StarforceContent/RateBoxBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/StarforceContent/CostBoxBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/StarforceContent/StarBoxBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/PotentialContent/CubePanel/CubePanelBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/PotentialContent/MesoPanel/MesoPanelBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/AdditionalContent/CubePanel/CubePanelBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/AdditionalContent/MesoPanel/MesoPanelBG",
			"/ui/DefaultGroup/EnhanceWindow/LeftPanel/SideBG",
			"/ui/DefaultGroup/EnhanceWindow/RightPanel/MainBG",
		}
		for _, p in ipairs(bgPaths) do
			local e = _EntityService:GetEntityByPath(p)
			if isvalid(e) and isvalid(e.UITransformComponent) then
				_UILogic:SetSiblingIndex(e.UITransformComponent, 1)
			end
		end
		-- The close control is a window-level sibling and must render above both panels.
		local close = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/CloseEnhance")
		if isvalid(close) then _UILogic:SetSiblingIndex(close.UITransformComponent, 1000000) end
		log("[Enhance] 리디자인 배경 z-order 및 닫기 버튼 전면 보정 완료")
	end

	-- ─── 버튼 / 탭 와이어링 ──────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void WireWindowButtons()
		-- 강화 버튼 (스타포스 컨텐츠 내)
		local enhBtn = _EntityService:GetEntityByPath(self.pathContent .. "/StarforceContent/EnhanceBtn")
		log("[Enhance] EnhanceBtn isvalid=" .. tostring(isvalid(enhBtn)))
		if isvalid(enhBtn) then
			if not isvalid(enhBtn:GetComponent("MOD.Core.UITouchReceiveComponent")) then
				enhBtn:AddComponent("MOD.Core.UITouchReceiveComponent")
			end
			enhBtn:ConnectEvent(UITouchDownEvent, self.OnEnhanceBtnClick)
			log("[Enhance] EnhanceBtn wired")
		end

		-- 탭 5개 와이어링: TabBG 스프라이트(SPR 엔티티)에 연결 - UITouchReceiveComponent는 SPR 엔티티에서만 동작
		local tabNames = {
			"EnhanceTab_Starforce",
			"EnhanceTab_Scroll",
			"EnhanceTab_AddOption",
			"EnhanceTab_Potential",
			"EnhanceTab_Additional",
		}
		for i, tabName in ipairs(tabNames) do
			local capturedIdx = i
			local tabPath = self.pathLeft .. "/" .. tabName
			local function tabHandler(e)
				if _StarforcePresentation.busy then return end
				if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
				log("[Enhance] 탭 클릭 idx=" .. tostring(capturedIdx))
				-- 미부여 아이템은 해당 잠재능력이 없다는 안내만 표시한다
				local isDisabled = (capturedIdx == 4 and self._T.tabPotDisabled) or (capturedIdx == 5 and self._T.tabAddDisabled)
				if isDisabled then
					if self.enhanceTargetItemStr ~= "" then
						self:ShowPotentialNotGrantedDialog(capturedIdx)
					end
					return
				end
				self:SelectTab(capturedIdx)
			end
			-- TabBG 스프라이트에 RaycastTarget=true + UITouchReceiveComponent 연결
			local tabBG = _EntityService:GetEntityByPath(tabPath .. "/TabBG")
			log("[Enhance] TabBG[" .. tabName .. "] found=" .. tostring(isvalid(tabBG)))
			if isvalid(tabBG) then
				tabBG.SpriteGUIRendererComponent.RaycastTarget = true
				if not isvalid(tabBG:GetComponent("MOD.Core.UITouchReceiveComponent")) then
					tabBG:AddComponent("MOD.Core.UITouchReceiveComponent")
				end
				tabBG:ConnectEvent(UITouchDownEvent, tabHandler)
				log("[Enhance] TabBG 연결 완료: " .. tabName)
			end
		end
		log("[Enhance] 탭 와이어링 완료")

		-- 큐브 리셋 UI 버튼 와이어링 (잠재능력 탭=4, 에디셔널 탭=5)
		local cubeTabInfos = {
			{ tabIdx=4, contentName="PotentialContent" },
			{ tabIdx=5, contentName="AdditionalContent" },
		}
		for _, info in ipairs(cubeTabInfos) do
			local tIdx = info.tabIdx
			local cPath = self.pathContent .. "/" .. info.contentName

			-- 메소 탭 버튼 (BG sprite에 연결 - SPR 엔티티에서만 UITouchReceive 동작)
			local mesoBG = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/MesoTabBG")
			if isvalid(mesoBG) then
				mesoBG.SpriteGUIRendererComponent.RaycastTarget = true
				if not isvalid(mesoBG:GetComponent("MOD.Core.UITouchReceiveComponent")) then
					mesoBG:AddComponent("MOD.Core.UITouchReceiveComponent")
				end
				local captTab = tIdx
				mesoBG:ConnectEvent(UITouchDownEvent, function(e)
					if e.TouchId ~= -1 then return end
					if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
					self:OnMesoTabTouch(captTab)
				end)
				log("[Enhance] MesoTabBG 연결 tab=" .. tostring(tIdx))
			end

			-- 큐브 탭 버튼 (BG sprite에 연결)
			local cubeBG = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/CubeTabBG")
			if isvalid(cubeBG) then
				cubeBG.SpriteGUIRendererComponent.RaycastTarget = true
				if not isvalid(cubeBG:GetComponent("MOD.Core.UITouchReceiveComponent")) then
					cubeBG:AddComponent("MOD.Core.UITouchReceiveComponent")
				end
				local captTab = tIdx
				cubeBG:ConnectEvent(UITouchDownEvent, function(e)
					if e.TouchId ~= -1 then return end
					if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
					self:OnCubeTabTouch(captTab)
				end)
				log("[Enhance] CubeTabBG 연결 tab=" .. tostring(tIdx))
			end

			-- 18개 큐브 슬롯 (SlotBG sprite에 연결)
			for i = 1, 18 do
				local slotBG = _EntityService:GetEntityByPath(cPath .. "/CubePanel/CubeGrid/CubeSlot" .. tostring(i) .. "/SlotBG")
				if isvalid(slotBG) then
					slotBG.SpriteGUIRendererComponent.RaycastTarget = true
					if not isvalid(slotBG:GetComponent("MOD.Core.UITouchReceiveComponent")) then
						slotBG:AddComponent("MOD.Core.UITouchReceiveComponent")
					end
					local captTab  = tIdx
					local captSlot = i
					slotBG:ConnectEvent(UITouchDownEvent, function(e)
						if e.TouchId ~= -1 then return end
						if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
						self:OnCubeSlotTouch(captTab, captSlot)
					end)
				end
			end

			-- 재설정하기 버튼 (BG sprite에 연결)
			local resetBG = _EntityService:GetEntityByPath(cPath .. "/ResetBtnBG")
			if isvalid(resetBG) then
				resetBG.SpriteGUIRendererComponent.RaycastTarget = true
				if not isvalid(resetBG:GetComponent("MOD.Core.UITouchReceiveComponent")) then
					resetBG:AddComponent("MOD.Core.UITouchReceiveComponent")
				end
				local captTab = tIdx
				resetBG:ConnectEvent(UITouchDownEvent, function(e)
					if e.TouchId ~= -1 then return end
					if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
					self:OnResetBtnTouch(captTab)
				end)
				log("[Enhance] ResetBtnBG 연결 tab=" .. tostring(tIdx))
			end

			-- 큐브 결과 비교: 현재/새 옵션 카드 자체를 선택 버튼으로 사용한다.
			for _, side in ipairs({"Current", "New"}) do
				local card = _EntityService:GetEntityByPath(cPath .. "/ComparePanel/" .. side .. "Card")
				if isvalid(card) then
					card.SpriteGUIRendererComponent.RaycastTarget = true
					if not isvalid(card:GetComponent("MOD.Core.UITouchReceiveComponent")) then
						card:AddComponent("MOD.Core.UITouchReceiveComponent")
					end
					local captTab = tIdx
					local chooseNew = (side == "New")
					card:ConnectEvent(UITouchDownEvent, function(e)
						if e.TouchId ~= -1 then return end
						if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
						self:OnCubeCompareChoice(captTab, chooseNew)
					end)
				end
			end
		end
		log("[Enhance] 큐브 UI 와이어링 완료")

		-- 강화 슬롯 hover → 아이템 설명창 / 클릭 → 클릭-클릭 배정 / 더블클릭 → ClearTarget
		-- (버그 수정) TargetSlotBG 루트는 UITransform만 있는 컨테이너라 터치가 전혀 오지 않았다 -
		-- 실제 보이는 슬롯 박스인 자식 SPR(TargetSlotBG/SlotBG)에 RaycastTarget+UITouchReceive를 붙여
		-- 와이어링한다 (탭 버튼 TabBG와 동일 패턴).
		local targetBG = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/SlotBG")
		if isvalid(targetBG) then
			targetBG.SpriteGUIRendererComponent.RaycastTarget = true
			if not isvalid(targetBG:GetComponent("MOD.Core.UITouchReceiveComponent")) then
				targetBG:AddComponent("MOD.Core.UITouchReceiveComponent")
			end
			self._T.lastTargetClickTime = 0
			targetBG:ConnectEvent(UITouchEnterEvent, function(e)
				if not _UIClickArbiter:IsTopmostAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
				if self.enhanceTargetInvenIdx > 0 then
					_UIEquipInventoryManager:ShowInvenTooltip(self.enhanceTargetInvenIdx)
				end
			end)
			targetBG:ConnectEvent(UITouchExitEvent, function(e)
				_UIEquipInventoryManager:HideTooltip()
			end)
			targetBG:ConnectEvent(UITouchDownEvent, function(e)
				if _StarforcePresentation.busy then return end
				if e.TouchId ~= -1 then return end
				if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
				-- (신규) 클릭-클릭 배정: 장비창/인벤에서 클릭해 둔 아이템이 있으면 이 슬롯에 대상으로 올린다.
				local pick = _UIEquipInventoryManager:ConsumeEnhancePick()
				if pick.win ~= nil then
					if pick.win == "equip" then
						self:SetEnhanceTargetFromEquip(pick.slot)
					else
						local ps = _UIEquipInventoryManager:GetInven(pick.slot)
						if ps ~= "" then
							self:SetEnhanceTarget(_UIEquipInventoryManager:ParseName(ps), _UIEquipInventoryManager:ParseInvenRUID(ps), pick.slot)
						end
					end
					-- 배정 직후의 클릭이 더블클릭 해제로 오인되지 않게 타임스탬프를 리셋한다
					self._T.lastTargetClickTime = 0
					return
				end
				local t = _UtilLogic.ElapsedSeconds
				if t - self._T.lastTargetClickTime < 0.5 then
					self:ClearTarget()
					self._T.lastTargetClickTime = 0
				else
					self._T.lastTargetClickTime = t
				end
			end)
			log("[Enhance] TargetSlotBG hover/클릭배정/더블클릭 연결")
		end

		-- 주문서 탭: 주문서 슬롯 8개 + 사용하기 버튼 와이어링 (탭 버튼과 동일 패턴)
		local smPath = self.pathContent .. "/ScrollContent/ScrollMain"
		for i = 1, 8 do
			local sBG = _EntityService:GetEntityByPath(smPath .. "/ScrollSlot" .. tostring(i) .. "/SlotBG")
			if isvalid(sBG) then
				sBG.SpriteGUIRendererComponent.RaycastTarget = true
				if not isvalid(sBG:GetComponent("MOD.Core.UITouchReceiveComponent")) then
					sBG:AddComponent("MOD.Core.UITouchReceiveComponent")
				end
				local captSlot = i
				sBG:ConnectEvent(UITouchDownEvent, function(e)
					if e.TouchId ~= -1 then return end
					if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
					self:OnScrollSlotTouch(captSlot)
				end)
			end
		end
		local useBtn = _EntityService:GetEntityByPath(smPath .. "/ScrollUseBtn")
		if isvalid(useBtn) then
			useBtn.SpriteGUIRendererComponent.RaycastTarget = true
			if not isvalid(useBtn:GetComponent("MOD.Core.UITouchReceiveComponent")) then
				useBtn:AddComponent("MOD.Core.UITouchReceiveComponent")
			end
			useBtn:ConnectEvent(UITouchDownEvent, function(e)
				if e.TouchId ~= -1 then return end
				if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
				self:ShowScrollConfirm()
			end)
			log("[Enhance] 주문서 탭 와이어링 완료")
		end

		-- 강화 확인 다이얼로그 확인/취소 버튼 (스프라이트에 UITouchReceive 연결 - 탭 버튼과 동일 패턴)
		local dlgBtns = {
			{ name = "DlgOkBG",     onTouch = self.OnConfirmOk },
			{ name = "DlgCancelBG", onTouch = self.OnConfirmCancel },
		}
		for _, info in ipairs(dlgBtns) do
			local btn = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/" .. info.name)
			if isvalid(btn) then
				btn.SpriteGUIRendererComponent.RaycastTarget = true
				if not isvalid(btn:GetComponent("MOD.Core.UITouchReceiveComponent")) then
					btn:AddComponent("MOD.Core.UITouchReceiveComponent")
				end
				btn:ConnectEvent(UITouchDownEvent, info.onTouch)
				log("[Enhance] 확인 다이얼로그 버튼 연결: " .. info.name)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SelectTab(integer idx)
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 큐브 결과를 선택하기 전에는 대상 탭을 유지한다.
		if (self._T.pendingCubeTab or 0) ~= 0 and idx ~= self._T.pendingCubeTab then self:RequireCubeChoice() return end
		-- 차콜 배경과 구분되는 청록색 선택 탭을 유지한다.
		self.currentTab = idx
		local TAB_ACTIVE    = Color(0.21, 0.74, 0.82, 1.0)
		local TAB_NORMAL    = Color(0.25, 0.32, 0.37, 1.0)
		local TAB_DISABLED  = Color(0.10, 0.11, 0.12, 1.0)
		local TAB_TEXT_ON   = Color(1.0, 1.0, 1.0, 1.0)
		local TAB_TEXT_OFF  = Color(0.82, 0.83, 0.85, 1.0)
		local TAB_TEXT_DIS  = Color(0.44, 0.45, 0.47, 1.0)

		local tabNames = {
			"EnhanceTab_Starforce",
			"EnhanceTab_Scroll",
			"EnhanceTab_AddOption",
			"EnhanceTab_Potential",
			"EnhanceTab_Additional",
		}
		local contentNames = {
			"StarforceContent",
			"ScrollContent",
			"AddOptionContent",
			"PotentialContent",
			"AdditionalContent",
		}

		-- 탭 색상 / 컨텐츠 패널 표시
		for i, tabName in ipairs(tabNames) do
			local tabPath = self.pathLeft .. "/" .. tabName
			local isDisabled = (i == 4 and self._T.tabPotDisabled) or (i == 5 and self._T.tabAddDisabled)
			local bgColor
			local textColor
			if i == idx then
				bgColor = TAB_ACTIVE; textColor = TAB_TEXT_ON
			elseif isDisabled then
				bgColor = TAB_DISABLED; textColor = TAB_TEXT_DIS
			else
				bgColor = TAB_NORMAL; textColor = TAB_TEXT_OFF
			end
			local bg = _EntityService:GetEntityByPath(tabPath .. "/TabBG")
			if isvalid(bg) then
				bg.SpriteGUIRendererComponent.Color = bgColor
			end
			local lbl = _EntityService:GetEntityByPath(tabPath .. "/TabLbl")
			if isvalid(lbl) then
				lbl.TextComponent.FontColor = textColor
			end
			local ct = _EntityService:GetEntityByPath(self.pathContent .. "/" .. contentNames[i])
			if isvalid(ct) then ct.Enable = (i == idx) end
		end

		-- idx=0(대기): DefaultContent 표시 / 나머지: 숨김
		local defContent = _EntityService:GetEntityByPath(self.pathContent .. "/DefaultContent")
		if isvalid(defContent) then defContent.Enable = (idx == 0) end

		-- 스타포스 탭 선택 시 현재 레벨로 UI 갱신
		if idx == 1 then
			self:UpdateStarforceUI(self.enhanceLevel)
		else
			self:UpdateStarforceProgressLabel(self.enhanceLevel)
		end

		-- 주문서 탭 선택 시 주문서 그리드/효과 갱신
		if idx == 2 then self:RefreshScrollContent() end

		-- 잠재능력 / 에디셔널 탭 선택 시 큐브 UI 갱신
		if idx == 4 or idx == 5 then self:RefreshCubeContent(idx) end

		-- (원작 개편) 우측 패널 좌상단 노란 영문 제목(STARFORCE/SCROLL/...)을 탭에 맞게 갱신
		local titles = { "STARFORCE", "SCROLL", "ADD OPTION", "POTENTIAL", "ADDITIONAL" }
		local titleEnt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/RightTitleText")
		if isvalid(titleEnt) then
			titleEnt.TextComponent.Text = (idx >= 1 and idx <= 5) and titles[idx] or "ENCHANT"
		end
		-- 사이드바 하단 보유 메소 갱신 + 탭 전환 시 열려있던 확인 다이얼로그는 닫는다
		self:UpdateMesoDisplay()
		self:HideEnhanceConfirm()

		log("[Enhance] SelectTab=" .. tostring(idx))
	end

	@ExecSpace("ClientOnly")
	method void UpdateMesoDisplay()
		-- 사이드바 하단 "보유 메소" 값을 원작 표기(억/만)로 갱신한다.
		local t = _EntityService:GetEntityByPath(self.pathLeft .. "/MesoValueText")
		if isvalid(t) then
			t.TextComponent.Text = _UIEquipInventoryManager:FormatMeso(_UIEquipInventoryManager.meso)
		end
	end

	-- ─── 키보드 / 버튼 이벤트 ────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- 채팅 중의 Space/P/Tab 입력을 강화 조작으로 처리하지 않는다.
		if _MapleHUDManager:IsChatTyping() then return end
		if _UIItemDiscardManager:BlocksInput() then return end
		-- 단축키 세팅의 퀵슬롯 리매핑 키 캡처 중에는 강화창 단축키를 무시한다
		if _KeySettingManager:IsCapturingKey() then return end
		-- 강화창 열기 키는 키설정(])에서 옮길 수 있으므로 기능 매핑으로 판정한다 (기본 O)
		if _KeySettingManager:GetFuncForKeyEnum(event.key) == "enhance" then
			self:ToggleWindow()
		elseif _UIClickArbiter:GetKeyboardWindow() ~= "/ui/DefaultGroup/EnhanceWindow" then
			return
		elseif event.key == KeyboardKey.P then
			-- (원작 개편) P 단축키도 버튼과 동일하게 확인 다이얼로그를 거친다.
			if self:IsWindowOpen() then self:ShowEnhanceConfirm() end
		elseif event.key == KeyboardKey.Space or event.key == KeyboardKey.Return or event.key == KeyboardKey.KeypadEnter then
			-- 첫 입력은 버튼과 동일한 안내창을 열고, 별도 입력으로만 확인한다.
			if not self:IsWindowOpen() then return end
			if self:IsConfirmDialogOpen() then
				-- 창이 열린 직후의 중복 입력/연타가 안내를 즉시 수락하지 않게 한다.
				if (self._T.confirmMode == "starforce" or self._T.confirmMode == "cube_use" or self._T.confirmMode == "scroll_use")
					and _UtilLogic.ElapsedSeconds - (self._T.confirmOpenedAt or -99) < 0.35 then
					return
				end
				-- (감사) 파괴 직후 뜨는 재구매 다이얼로그는 직전 강화 입력과 0.5초 이상 간격이 있어야
				-- Space로 수락된다 - 연타/매크로 중 파괴가 뜨면 유저 인지 없이 재구매→재등록→재강화
				-- 루프가 잔액 소진까지 돌던 문제 방지 (버튼 클릭 수락은 영향 없음).
				if self._T.pendingRebuySlot ~= nil
					and _UtilLogic.ElapsedSeconds - (self._T.lastEnhanceInputAt or -99) < 0.5 then
					return
				end
				log("[Enhance] keyboard confirm key=" .. tostring(event.key) .. " mode=" .. tostring(self._T.confirmMode))
				self:AcceptConfirmDialog()
			elseif event.key ~= KeyboardKey.Space then
				-- Enter confirms an existing dialog only; it never starts another paid action.
				return
			elseif self.currentTab == 1 then
				log("[Enhance] Space → 강화 안내")
				self:ShowEnhanceConfirm()
			elseif self.currentTab == 2 then
				-- The scroll shortcut uses the same validation/effects as its button.
				log("[Enhance] Space → 주문서 사용 안내")
				self:ShowScrollConfirm()
			elseif self.currentTab == 4 or self.currentTab == 5 then
				-- 큐브/메소 재설정도 버튼과 동일하게 사용 확인창을 먼저 연다.
				log("[Enhance] Space → 큐브 사용 안내 tab=" .. tostring(self.currentTab))
				self._T.lastEnhanceInputAt = _UtilLogic.ElapsedSeconds
				self:OnResetBtnTouch(self.currentTab)
			end
		elseif event.key == KeyboardKey.Tab then
            if _InformationBook:IsOpen() then return end
			-- Tab = 탭 순환 (잠긴 탭은 건너뜀)
			if self:IsWindowOpen() then self:CycleTab() end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsConfirmDialogOpen()
		-- 강화 확인 다이얼로그가 화면에 떠 있는지 (ESC/Space 분기용)
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		return self:IsWindowOpen() and isvalid(dlg) and dlg.Enable
	end

	@ExecSpace("ClientOnly")
	method void CycleTab()
		-- Tab 키: 스타포스→주문서→추가옵션→잠재능력→에디셔널→스타포스, 비활성(잠긴) 탭은 건너뜀
		local idx = self.currentTab
		if idx < 1 or idx > 5 then idx = 0 end
		for _ = 1, 5 do
			idx = idx % 5 + 1
			local disabled = (idx == 4 and self._T.tabPotDisabled) or (idx == 5 and self._T.tabAddDisabled)
			if not disabled then
				self:SelectTab(idx)
				log("[Enhance] Tab 순환 → " .. tostring(idx))
				return
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnOpenBtnClick(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/InvenWindow", e.TouchPoint) then return end
		log("[Enhance] OpenBtn clicked")
		self:ToggleWindow()
	end

	@ExecSpace("ClientOnly")
	method void OnCloseClick(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
		log("[Enhance] CloseBtn clicked")
		self:CloseWindow()
	end

	@ExecSpace("ClientOnly")
	method void OnEnhanceBtnClick(UITouchDownEvent e)
		-- 마우스 강화 요청도 공통 확인 절차로 보낸다.
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
		log("[Enhance] EnhanceBtn clicked")
		-- (원작 개편) 바로 강화하지 않고 원작처럼 "N 메소 / 강화를 시도하시겠습니까?" 확인 다이얼로그를 띄운다.
		self:ShowEnhanceConfirm()
	end

	-- ─── 강화 확인 다이얼로그 (원작 스타일) ──────────────────────────────
	@ExecSpace("ClientOnly")
	method void ShowEnhanceConfirm()
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		if not self:IsWindowOpen() or self.currentTab ~= 1 then return end
		if self:RequireCubeChoice() then return end
		-- 대상/최대단계/메소 부족은 기존 DoEnhance와 동일한 기준으로 미리 걸러 로그로 안내한다.
		if self:IsConfirmDialogOpen() then return end
		if self.enhanceTargetRUID == "" then
			self:AppendLog("아이템을 먼저 선택하세요.")
			return
		end
		if self.enhanceLevel >= _CashShopManager:GetMaxStars(self.enhanceTargetItemStr) then
			self:AppendLog("최대 강화 단계입니다.")
			return
		end
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		if not isvalid(dlg) then
			-- 안내창이 준비되지 않았을 때는 재화를 소모하지 않는다.
			self:AppendLog("강화 안내창을 열 수 없습니다. 창을 다시 열어주세요.")
			log_warning("[Enhance] 확인창 없음: 강화 요청 차단")
			return
		end
		if not self:CheckCurrentTarget() then return end
		local cost = self:GetStarforceCost(self.enhanceLevel)
		local txt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/DlgText")
		if isvalid(txt) then
			txt.TextComponent.Text = tostring(cost) .. " 메소\n\n강화를 시도하시겠습니까?"
		end
		self._T.confirmInfoOnly = false
		self._T.pendingRebuySlot = nil   -- (Phase 2) 모드 혼선 방지 - 강화 확인 모드로 초기화
		self._T.confirmMode = "starforce"
		self._T.confirmOpenedAt = _UtilLogic.ElapsedSeconds
		self._T.confirmTargetItem = self.enhanceTargetItemStr
		self._T.confirmTargetEquipSlot = self.enhanceTargetEquipSlot
		self._T.confirmTargetTab = self.enhanceTargetSrcTab
		self._T.confirmTargetIndex = self.enhanceTargetInvenIdx
		dlg.Enable = true
		log("[Enhance] 강화 확인창 열림: " .. self.enhanceTargetName .. " / " .. tostring(cost) .. " 메소")
	end

	-- 큐브(잠재능력/에디셔널)를 사용할 수 없는 아이템에 대해 시도했을 때 보여주는 안내 전용 다이얼로그.
	-- 기존 강화 확인 다이얼로그(ConfirmDialog)를 재사용하되, 확인을 눌러도 강화를 실행하지 않는다.
	@ExecSpace("ClientOnly")
	method void ShowItemUnusableDialog()
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		if not isvalid(dlg) then return end
		local txt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/DlgText")
		if isvalid(txt) then
			txt.TextComponent.Text = "해당 아이템을 사용할 수 없는 아이템입니다."
		end
		self._T.confirmInfoOnly = true
		self._T.pendingRebuySlot = nil
		dlg.Enable = true
	end

	-- (신규) 강화 불가 부위 안내 전용 다이얼로그 - 큐브용 안내(ShowItemUnusableDialog)와 문구만 다르다.
	@ExecSpace("ClientOnly")
	method void ShowEnhanceBlockedDialog()
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		if not isvalid(dlg) then return end
		local txt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/DlgText")
		if isvalid(txt) then
			txt.TextComponent.Text = "강화 불가 아이템입니다."
		end
		self._T.confirmInfoOnly = true
		self._T.pendingRebuySlot = nil
		dlg.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void HideEnhanceConfirm()
		-- Closing or switching tabs invalidates any unaccepted item-use request.
		self._T.cubeUseRequest = nil
		self._T.scrollUseRequest = nil
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		if isvalid(dlg) then dlg.Enable = false end
	end

	-- (Phase 2) 확인 다이얼로그 "확인"의 공통 처리 - 모드 우선순위: 안내 전용 → 재구매 → 강화 확인.
	@ExecSpace("ClientOnly")
	method void AcceptConfirmDialog()
		-- 열린 확인창에서 선택한 대상에 대해서만 한 번 실행한다.
		if not self:IsConfirmDialogOpen() then return end
		local mode = self._T.confirmMode
		local cubeRequest = self._T.cubeUseRequest
		local scrollRequest = self._T.scrollUseRequest
		self:HideEnhanceConfirm()
		if mode == "scroll_use" then
			self._T.confirmMode = ""
			self:ExecuteScrollUse(scrollRequest)
			return
		end
		if mode == "cube_use" then
			self._T.confirmMode = ""
			self:ExecuteCubeUse(cubeRequest)
			return
		end
		if self._T.confirmMode == "cube_choice" then
			self._T.confirmMode = ""
			self:ApplyPendingCubeChoice()
			return
		end
		-- 안내 전용(사용 불가/강화 불가) 다이얼로그였다면 닫기만 한다.
		if self._T.confirmInfoOnly then
			self._T.confirmInfoOnly = false
			return
		end
		-- 재구매 제안 다이얼로그였다면 구매를 실행한다.
		local rebuySlot = self._T.pendingRebuySlot
		if rebuySlot ~= nil and rebuySlot > 0 then
			self._T.pendingRebuySlot = nil
			self:DoRebuy(rebuySlot)
			return
		end
		self._T.confirmMode = ""
		if mode ~= "starforce" then return end
		if self._T.confirmTargetItem ~= self.enhanceTargetItemStr
			or self._T.confirmTargetEquipSlot ~= self.enhanceTargetEquipSlot
			or self._T.confirmTargetTab ~= self.enhanceTargetSrcTab
			or self._T.confirmTargetIndex ~= self.enhanceTargetInvenIdx then
			self:AppendLog("강화 대상이 변경되었습니다. 다시 확인해주세요.")
			return
		end
		self._T.lastEnhanceInputAt = _UtilLogic.ElapsedSeconds
		self:DoEnhance()
	end

	@ExecSpace("ClientOnly")
	method void ShowPotentialNotGrantedDialog(integer tabIdx)
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 확인을 눌러도 메소나 장비를 변경하지 않는 미부여 안내다.
		local kindName = (tabIdx == 4) and "잠재능력" or "에디셔널 잠재능력"
		local message = kindName .. "이 부여되지 않은 아이템입니다."
		self._T.confirmInfoOnly = true
		self._T.pendingRebuySlot = nil
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		if not isvalid(dlg) then
			self:AppendLog(message)
			return
		end
		local txt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/DlgText")
		if isvalid(txt) then txt.TextComponent.Text = message end
		dlg.Enable = true
		log("[Enhance] 미부여 안내 tab=" .. tostring(tabIdx) .. " message=" .. message)
	end

	@ExecSpace("ClientOnly")
	method void OnConfirmOk(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
		log("[Enhance] 확인 다이얼로그: 확인")
		self:AcceptConfirmDialog()
	end

	@ExecSpace("ClientOnly")
	method void OnConfirmCancel(UITouchDownEvent e)
		if e.TouchId ~= -1 then return end
		if not _UIClickArbiter:AcceptClickAt("/ui/DefaultGroup/EnhanceWindow", e.TouchPoint) then return end
		log("[Enhance] 확인 다이얼로그: 취소")
		-- 취소 시 재구매 확인 상태를 초기화한다.
		self._T.pendingRebuySlot = nil
		self._T.pendingCubeChoice = ""
		self._T.confirmMode = ""
		self:HideEnhanceConfirm()
	end

	@ExecSpace("ClientOnly")
	method void OnScreenTabRelease(ScreenTouchReleaseEvent e)
		-- 탭/버튼 클릭은 UITouchDownEvent (WireWindowButtons) 에서 처리
		-- ScreenTouchReleaseEvent 감지를 유지하면 중복 실행으로 잘못된 탭 선택 발생
		return
	end

	-- ─── 창 열기 / 닫기 / 토글 ───────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method boolean IsWindowOpen()
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow")
		return isvalid(w) and w.Enable
	end

	@ExecSpace("ClientOnly")
	method void OpenWindowWithTab(integer tabIdx)
        if self:RequireCubeChoice() then return end
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 강화창을 열고 지정 탭을 선택한다 (큐브 더블클릭 진입점)
		local dg = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(dg) and not dg.Enable then dg.Enable = true end
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow")
		if not isvalid(w) then log("[Enhance] OpenWindowWithTab: EnhanceWindow 없음") return end
		if not w.Enable then
			w.Enable = true
			local cur = w.UITransformComponent.anchoredPosition
			local isUnset = math.abs(cur.x) < 5 and math.abs(cur.y) < 5
			local isOffScreen = math.abs(cur.x) > 1000 or math.abs(cur.y) > 1000
			if isUnset or isOffScreen then
				w.UITransformComponent.anchoredPosition = Vector2(550, 0)
			end
		end
		-- 이미 대상 아이템이 올라가 있고, 그 아이템이 해당 잠재능력을 아직 개방하지 않았다면
		-- 탭을 열지 않는다 (좌측 탭 버튼 클릭과 동일한 기준 - tabPotDisabled/tabAddDisabled).
		-- 대상이 아직 없는 경우(enhanceTargetRUID=="")는 "아이템을 올려주세요" 안내 상태이므로 막지 않는다.
		local hasTarget = self.enhanceTargetRUID ~= ""
		local blocked = hasTarget and ((tabIdx == 4 and self._T.tabPotDisabled) or (tabIdx == 5 and self._T.tabAddDisabled))
		if blocked then
			-- 미부여 아이템은 안내만 표시한다
			self:ShowPotentialNotGrantedDialog(tabIdx)
			log("[Enhance] OpenWindowWithTab: 미부여 안내 tab=" .. tostring(tabIdx))
			return
		end
		self:SelectTab(tabIdx)
		if self.enhanceTargetRUID == "" then self:ClearTarget() end
		log("[Enhance] OpenWindowWithTab tab=" .. tostring(tabIdx))
	end

	@ExecSpace("ClientOnly")
	method void ToggleWindow()
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		if self:IsWindowOpen() then self:CloseWindow(); return end
		-- 재화를 이미 사용한 비교 결과가 닫기로 소실되지 않도록 한다.
		if self:RequireCubeChoice() then return end
		local dg = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(dg) and not dg.Enable then dg.Enable = true end

		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow")
		if not isvalid(w) then log("[Enhance] ToggleWindow: EnhanceWindow 없음") return end

		w.Enable = not w.Enable
		if w.Enable then
			local cur = w.UITransformComponent.anchoredPosition
			log("[Enhance] 열림 전 pos=" .. tostring(cur.x) .. "," .. tostring(cur.y))
			local isUnset = math.abs(cur.x) < 5 and math.abs(cur.y) < 5
			local isOffScreen = math.abs(cur.x) > 1000 or math.abs(cur.y) > 1000
			if isUnset or isOffScreen then
				w.UITransformComponent.anchoredPosition = Vector2(550, 0)
				log("[Enhance] 위치 550으로 설정")
			end
			self:SelectTab(1)
			if self.enhanceTargetRUID == "" then self:ClearTarget() end
			log("[Enhance] 창 열림")
		else
			log("[Enhance] 창 닫힘")
			self:ClearTarget()
			self:HideEnhanceConfirm()
		end
	end

	@ExecSpace("ClientOnly")
	method void CloseWindow()
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 중간 영역에서 옵션 선택을 마친 뒤 창을 닫는다.
		if self:RequireCubeChoice() then return end
		local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow")
		if isvalid(w) then w.Enable = false end
		self:ClearTarget()
		self:HideEnhanceConfirm()
		-- 클릭-클릭 대기 선택도 함께 폐기 (창을 닫으면 선택 상태가 남지 않게)
		local discard = _UIEquipInventoryManager:ConsumeEnhancePick()
	end

	-- (Phase 1) 강화 대상 6부위 판정 (GDD §2): 상의(3)·신발(5)·무기(6)·모자(7)·망토(8)·장갑(9)만 허용.
	-- 얼굴(1)·머리(2)·하의(4)와 잠금 칸(10~25 - 개방 시 이 표에 추가)은 강화 불가.
	@ExecSpace("ClientOnly")
	method boolean IsEnhanceableSlot(number slotIdx)
		return slotIdx == 14 or slotIdx == 3 or slotIdx == 5 or slotIdx == 6
			or slotIdx == 7 or slotIdx == 8 or slotIdx == 9
	end

	-- ─── 강화 대상 설정 (더블클릭 / 드래그 드롭 공통) ────────────────────
	@ExecSpace("ClientOnly")
	method void SetEnhanceTarget(string name, string ruid, number invenIdx)
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 비교 도중 장비가 바뀌면 결과가 다른 아이템에 적용될 수 있으므로 차단한다.
		if self:RequireCubeChoice() then return end
		-- (Phase 1) 강화 대상 6부위 제한: 아이템 문자열 3번째 필드(slotIdx)로 판정하고,
		-- 허용 외 부위는 기존 "사용 불가 아이템" 안내 다이얼로그를 띄운 뒤 등록하지 않는다.
		local candidate = _UIEquipInventoryManager:GetInven(invenIdx)
		if candidate ~= "" then
			local slotIdx = 0
			local fcount = 0
			local fpos = 1
			while true do
				local fj, _ = string.find(candidate, "|", fpos, true)
				fcount += 1
				if fcount == 3 then
					local fieldStr = fj and string.sub(candidate, fpos, fj - 1) or string.sub(candidate, fpos)
					slotIdx = math.floor(tonumber(fieldStr) or 0)
					break
				end
				if fj == nil then break end
				fpos = fj + 1
			end
			if not self:IsEnhanceableSlot(slotIdx) then
				self:ShowEnhanceBlockedDialog()
				log("[Enhance] 강화 불가 부위 거부: " .. name .. " slotIdx=" .. tostring(slotIdx))
				return
			end
		else
			-- 인벤 문자열이 비어 있으면 장착 중 아이템 경로 - RUID로 장착 슬롯(1~9)을 찾아 같은 기준으로 판정
			for i = 1, 9 do
				local eq = _UIEquipInventoryManager:GetEquip(i)
				if eq ~= "" and _UIEquipInventoryManager:ParseRUID(eq) == ruid then
					if not self:IsEnhanceableSlot(i) then
						self:ShowEnhanceBlockedDialog()
						log("[Enhance] 강화 불가 부위 거부(장착 중): " .. name .. " slot=" .. tostring(i))
						return
					end
					break
				end
			end
		end

		-- 새 대상 등록: 인벤 아이템 경로이므로 장착 대상 표시는 해제하고,
		-- 클릭-클릭 대기 중이던 선택(있다면)은 폐기해 이후 대상 슬롯 클릭이 옛 선택을 되살리지 않게 한다
		self.enhanceTargetEquipSlot = 0
		local discard = _UIEquipInventoryManager:ConsumeEnhancePick()

		self.enhanceTargetName = name
		self.enhanceTargetRUID = ruid
		self.enhanceTargetInvenIdx = invenIdx

		-- 아이템 문자열 및 탭 저장 (탭 전환 후에도 정확한 데이터 유지)
		self.enhanceTargetItemStr = _UIEquipInventoryManager:GetInven(invenIdx)
		self.enhanceTargetSrcTab  = _UIEquipInventoryManager._T.activeTab

		local s = self.enhanceTargetItemStr
		if s ~= "" then
			self.enhanceLevel = _UIEquipInventoryManager:ParseStars(s)
		else
			self.enhanceLevel = 0
		end

		self:ApplyEnhanceTargetUI()

		self:FocusEnhanceWindow()
        self:AppendLog("대상: " .. name)
		log("[Enhance] 대상 설정: " .. name .. " 인벤=" .. tostring(invenIdx))
	end

	@ExecSpace("ClientOnly")
	method void ApplyEnhanceTargetUI()
		-- 강화 대상 슬롯 영역 공용 갱신 - self.enhanceTargetName/RUID/enhanceLevel을 읽어
		-- 아이콘/이름/별/스타포스 탭/탭 비활성화를 일괄 반영한다 (인벤 등록·재구매 자동 등록 공용).
		local icon = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/TargetIcon")
		if isvalid(icon) then
			local spr = icon.SpriteGUIRendererComponent
			spr.ImageRUID = "thumbnail://" .. self.enhanceTargetRUID
			spr.Color = Color(1, 1, 1, 1)
		end

		local placeholder = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/PlaceholderIcon")
		if isvalid(placeholder) then placeholder.Enable = false end

		local prompt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/SlotPromptText")
		if isvalid(prompt) then prompt.Enable = false end

		local nameLabel = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetNameLabel")
		if isvalid(nameLabel) then
			nameLabel.Enable = true
			nameLabel.TextComponent.Text = self.enhanceTargetName
		end

		local starEnt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/StarLabel")
		if isvalid(starEnt) then
			starEnt.Enable = false
		end

		-- 스타포스 탭이 열려있으면 UI 갱신
		if self.currentTab == 1 then
			self:UpdateStarforceUI(self.enhanceLevel)
		end

		-- 탭 비활성화 갱신 및 큐브 UI 갱신
		self:UpdateTabDisabledState()
	end

	-- (신규) 장착 중인 장비(장비창 슬롯 1~9)를 강화 대상으로 올린다 - 클릭-클릭 배정 경로.
	-- 인벤 경로(SetEnhanceTarget)와 달리 invenIdx 대신 enhanceTargetEquipSlot에 장비 슬롯을 기억해,
	-- 강화/주문서/큐브 결과와 파괴가 장비창 문자열(SetEquipStr)에 직접 반영된다.
	@ExecSpace("ClientOnly")
	method void SetEnhanceTargetFromEquip(number equipSlot)
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 현재 장비의 큐브 비교가 완료되어야 다른 장비를 올릴 수 있다.
		if self:RequireCubeChoice() then return end
		local s = _UIEquipInventoryManager:GetEquip(equipSlot)
		if s == "" then return end
		if not self:IsEnhanceableSlot(equipSlot) then
			self:ShowEnhanceBlockedDialog()
			log("[Enhance] 강화 불가 부위 거부(장착 중): slot=" .. tostring(equipSlot))
			return
		end

		local name = _UIEquipInventoryManager:ParseName(s)
		local ruid = _UIEquipInventoryManager:ParseRUID(s)
		self.enhanceTargetName = name
		self.enhanceTargetRUID = ruid
		self.enhanceTargetInvenIdx = 0
		self.enhanceTargetEquipSlot = equipSlot
		self.enhanceTargetItemStr = s
		self.enhanceTargetSrcTab  = ""
		self.enhanceLevel = _UIEquipInventoryManager:ParseStars(s)

		-- 슬롯 아이콘 및 이름 업데이트 (SetEnhanceTarget과 동일한 표시 갱신)
		local icon = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/TargetIcon")
		if isvalid(icon) then
			local spr = icon.SpriteGUIRendererComponent
			spr.ImageRUID = "thumbnail://" .. ruid
			spr.Color = Color(1, 1, 1, 1)
		end
		local placeholder = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/PlaceholderIcon")
		if isvalid(placeholder) then placeholder.Enable = false end
		local prompt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/SlotPromptText")
		if isvalid(prompt) then prompt.Enable = false end
		local nameLabel = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetNameLabel")
		if isvalid(nameLabel) then
			nameLabel.Enable = true
			nameLabel.TextComponent.Text = name
		end
		local starEnt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/StarLabel")
		if isvalid(starEnt) then
			starEnt.TextComponent.Text = _UIEquipInventoryManager:GetStarText(self.enhanceLevel)
		end

		if self.currentTab == 1 then
			self:UpdateStarforceUI(self.enhanceLevel)
		end
		self:UpdateTabDisabledState()

		_UIEquipInventoryManager:ConsumeEnhancePick()
        self:FocusEnhanceWindow()
        self:AppendLog("대상: " .. name .. " (장착 중)")
		log("[Enhance] 대상 설정(장착 중): " .. name .. " 장비슬롯=" .. tostring(equipSlot))
	end

	-- 강화창이 열린 상태로 대상 아이템에 외부 변화(잠재능력/에디셔널 주문서 성공 등)가 생겼을 때
	-- 대상을 다시 올린 것처럼 캐시(enhanceTargetItemStr)와 표시를 즉시 재동기화한다.
	-- invenIdx가 현재 강화 대상과 다르면 아무 것도 하지 않는다.
	@ExecSpace("ClientOnly")
	method void RefreshTargetIfCurrent(number invenIdx)
		if self.enhanceTargetRUID == "" then return end
		if self.enhanceTargetInvenIdx ~= invenIdx then return end

		local s = _UIEquipInventoryManager:GetInven(invenIdx)
		if s == "" then
			-- 아이템이 사라짐(주문서 실패로 파괴 등) - 대상 해제
			self:ClearTarget()
			return
		end

		self.enhanceTargetItemStr = s
		self.enhanceLevel = _UIEquipInventoryManager:ParseStars(s)

		local starEnt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/StarLabel")
		if isvalid(starEnt) then
			starEnt.TextComponent.Text = _UIEquipInventoryManager:GetStarText(self.enhanceLevel)
		end
		if self.currentTab == 1 then
			self:UpdateStarforceUI(self.enhanceLevel)
		end

		-- 잠재능력/에디셔널 부여 여부가 바뀌었을 수 있으므로 탭 비활성화 상태 + 큐브 탭 내용을 다시 계산한다
		-- (현재 탭이 4/5면 RefreshCubeContent가 자동 호출되어 잠재능력 탭이 새로 올린 것처럼 갱신됨)
		self:UpdateTabDisabledState()
		log("[Enhance] 대상 재동기화: " .. self.enhanceTargetName .. " 인벤=" .. tostring(invenIdx))
	end

	-- ─── 강화 실행 ────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method string ReadCurrentTarget()
		-- 활성 인벤 탭 대신 등록 당시 원본 위치에서 최신 장비 문자열을 읽는다.
		if self.enhanceTargetEquipSlot > 0 then return _UIEquipInventoryManager:GetEquip(self.enhanceTargetEquipSlot) end
		local tab = self.enhanceTargetSrcTab ~= "" and self.enhanceTargetSrcTab or "equip"
		return _UIEquipInventoryManager:GetTabItem(tab, self.enhanceTargetInvenIdx)
	end

	@ExecSpace("ClientOnly")
	method void RefreshCurrentTarget()
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 주문서 사용 후 대상의 외형/별/보호/파괴를 다시 읽어 강화창에 반영한다.
		if self.enhanceTargetRUID == "" then return end
		local s = self:ReadCurrentTarget()
		if s == "" then self:ClearTarget() return end
		self.enhanceTargetItemStr = s
		self.enhanceTargetName = _UIEquipInventoryManager:ParseName(s)
		self.enhanceTargetRUID = _UIEquipInventoryManager:ParseRUID(s)
		self.enhanceLevel = _UIEquipInventoryManager:ParseStars(s)
		self:ApplyEnhanceTargetUI()
	end

	@ExecSpace("ClientOnly")
	method boolean CheckCurrentTarget()
		-- 대상 이동/교환 후 오래된 캐시로 다른 장비를 강화하지 않도록 다시 등록하게 한다.
		if self.enhanceTargetItemStr == "" then return false end
		if self:ReadCurrentTarget() ~= self.enhanceTargetItemStr then
			self:ClearTarget()
			self:AppendLog("장비 상태가 변경되었습니다. 대상을 다시 등록하세요.")
			return false
		end
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean ConsumeTargetProtection()
		-- 유효한 스타포스 시도가 확정된 뒤 보호를 먼저 제거한다. 실패 유지도 저장 대상이다.
		local s = self:ReadCurrentTarget()
		if not _UIEquipInventoryManager:HasStarforceProtection(s) then return false end
		local updated = _UIEquipInventoryManager:WithStarforceProtection(s, false)
		if self.enhanceTargetEquipSlot > 0 then
			_UIEquipInventoryManager:SetEquipStr(self.enhanceTargetEquipSlot, updated)
		else
			local tab = self.enhanceTargetSrcTab ~= "" and self.enhanceTargetSrcTab or "equip"
			_UIEquipInventoryManager:SetTabItem(tab, self.enhanceTargetInvenIdx, updated)
		end
		self.enhanceTargetItemStr = updated
		_UIEquipInventoryManager:HideTooltip()
		_CharacterPersistence:MarkDirty("starforce_protect_consumed")
		log("[Protect] 스타포스 1회 보호 소모: " .. self.enhanceTargetName)
		return true
	end

	@ExecSpace("ClientOnly")
	method void DoEnhance()
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- (감사) 매크로 연타 게이트: 최소 0.25초 간격. 오토클릭/키반복으로 초당 수십 회 강화가
		-- 돌면 시간 비용이 0이 되어 밸런스가 무너지고, 저장 스냅샷 병합으로 회당 감사도 불가능해진다.
		local nowGate = _UtilLogic.ElapsedSeconds
		if nowGate - (self._T.lastEnhanceGateAt or -99) < 0.25 then return end
		self._T.lastEnhanceGateAt = nowGate
		if self.enhanceTargetRUID == "" then
			self:AppendLog("아이템을 먼저 선택하세요.")
			log("[Enhance] DoEnhance: 대상 없음")
			return
		end
		if not self:CheckCurrentTarget() then return end
		if self.enhanceLevel >= _CashShopManager:GetMaxStars(self.enhanceTargetItemStr) then
			self:AppendLog("최대 강화 단계입니다.")
			return
		end

		local cost = self:GetStarforceCost(self.enhanceLevel)
		if _UIEquipInventoryManager.meso < cost then
			self:AppendLog("메소 부족! (" .. tostring(cost) .. "원 필요)")
			log("[Enhance] 메소 부족: " .. tostring(_UIEquipInventoryManager.meso))
			return
		end

		local stamp = self.enhanceTargetItemStr
		local sourceTab = self.enhanceTargetSrcTab
		local equipSlot = self.enhanceTargetEquipSlot
		local invenSlot = self.enhanceTargetInvenIdx
		self._T.starforceCommitPending = true
		local started = _StarforcePresentation:Begin(self.enhanceLevel, function()
			if self.enhanceTargetItemStr ~= stamp or self:ReadCurrentTarget() ~= stamp
				or self.enhanceTargetSrcTab ~= sourceTab or self.enhanceTargetEquipSlot ~= equipSlot
				or self.enhanceTargetInvenIdx ~= invenSlot then
				self:AppendLog("장비 상태가 변경되어 강화를 취소했습니다. 메소는 소모되지 않았습니다.")
				_StarforcePresentation:Cancel()
				return
			end
			self:ResolveStarforce()
		end)
		if not started then self._T.starforceCommitPending = false end
	end

	@ExecSpace("ClientOnly")
	method void ResolveStarforce()
		-- Called once after both attempt clips. Recheck before consuming protection or meso.
		if not _StarforcePresentation.busy or not self._T.starforceCommitPending then return end
		self._T.starforceCommitPending = false
		if not self:CheckCurrentTarget() or self.enhanceLevel >= _CashShopManager:GetMaxStars(self.enhanceTargetItemStr) then
			_StarforcePresentation:Cancel()
			return
		end
		local cost = self:GetStarforceCost(self.enhanceLevel)
		if _UIEquipInventoryManager.meso < cost then
			self:AppendLog("메소가 부족하여 강화를 취소했습니다.")
			_StarforcePresentation:Cancel()
			return
		end
		local result = "keep"
		local rebuySlot = 0
		local protected = self:ConsumeTargetProtection()
		_UIEquipInventoryManager:AddMeso(-cost)
		-- 사이드바 보유 메소 표시 갱신 (원작 개편)
		self:UpdateMesoDisplay()

		-- (Phase 2) 구간표 기반 4분기 판정: 성공 / 유지 / 하락(-1성) / 파괴 (GDD §4.2)
		local band = self:GetStarforceBand(self.enhanceLevel)
		local roll = _UtilLogic:RandomDouble() * 100
		log("[Enhance] roll=" .. tostring(roll) .. " band s/k/d/x=" .. tostring(band.success) .. "/" .. tostring(band.keep) .. "/" .. tostring(band.drop) .. "/" .. tostring(band.destroy))

		local starEnt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/StarLabel")

		if roll < band.success then
			-- 성공: +1성
			result = "success"
			self.enhanceLevel = self.enhanceLevel + 1
			self:UpdateInvenItemStars(self.enhanceLevel)
			if isvalid(starEnt) then
				starEnt.TextComponent.Text = _UIEquipInventoryManager:GetStarText(self.enhanceLevel)
			end
			self:UpdateStarforceUI(self.enhanceLevel)
			self:AppendLog("성공! +" .. tostring(self.enhanceLevel) .. "강")
			log("[Enhance] 강화 성공: " .. self.enhanceTargetName .. " +" .. tostring(self.enhanceLevel) .. "강")
		elseif roll < band.success + band.keep then
			-- 유지: 수치 변화 없음
			self:AppendLog("실패. 수치 유지.")
			log("[Enhance] 강화 실패 - 유지")
		elseif roll < band.success + band.keep + band.drop then
			-- (신규) 하락: -1성 (하한 0)
			result = "drop"
			self.enhanceLevel = math.max(0, self.enhanceLevel - 1)
			self:UpdateInvenItemStars(self.enhanceLevel)
			if isvalid(starEnt) then
				starEnt.TextComponent.Text = _UIEquipInventoryManager:GetStarText(self.enhanceLevel)
			end
			self:UpdateStarforceUI(self.enhanceLevel)
			self:AppendLog("실패! 1단계 하락 → +" .. tostring(self.enhanceLevel) .. "강")
			log("[Enhance] 강화 실패 - 하락 → +" .. tostring(self.enhanceLevel) .. "강")
		elseif protected then
			-- 파괴 결과만 유지로 바꾼다. 성공/유지/하락에서도 보호는 이미 소모되었다.
			self:AppendLog("프로텍트가 장비 파괴를 막았습니다. 별 수 유지. (보호 소모)")
			log("[Protect] 스타포스 파괴 방지: " .. self.enhanceTargetName)
		else
			-- 파괴: 아이템 소멸 후 기본 장비 재구매 제안 (Phase 2 재구매 루프)
			local destroyedSlot = self:GetTargetFieldNum(3)
			result = "destroy"
			rebuySlot = destroyedSlot
			self:DestroyTarget()
			self:AppendLog("실패! 아이템 파괴됨")
			log("[Enhance] 강화 실패 - 파괴 (부위 slotIdx=" .. tostring(destroyedSlot) .. ")")
			-- Rebuy follows the destruction presentation, never covers it.
		end
		if protected and self.enhanceTargetRUID ~= "" then
			self:UpdateStarforceUI(self.enhanceLevel)
		end
		_CharacterPersistence:MarkDirty("enhance_starforce")
		_StarforcePresentation:ShowResult(result, self.enhanceLevel, rebuySlot)
	end

	-- (Phase 2) 파괴 직후 기본 장비 재구매 제안 다이얼로그. 방어구 10,000 / 무기 50,000 메소 -
	-- "파괴의 아픔은 재구매비가 아니라 쌓은 성·잠재의 소멸"이라는 설계라 값은 싸게 유지한다 (GDD §4.2).
	@ExecSpace("ClientOnly")
	method void ShowRebuyDialog(number slotIdx)
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		if not isvalid(dlg) then return end
		local cost = (slotIdx == 6) and self:GetBalancePrice("rebuy_weapon", 50000) or self:GetBalancePrice("rebuy_armor", 10000)
		local partName = _UIEquipInventoryManager:GetEquipTypeBySlot(slotIdx)
		local txt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/DlgText")
		if isvalid(txt) then
			txt.TextComponent.Text = partName .. " 파괴!\n기본 장비 재구매: " .. tostring(cost) .. " 메소\n구매하시겠습니까?"
		end
		self._T.confirmInfoOnly = false
		self._T.pendingRebuySlot = slotIdx
		dlg.Enable = true
	end

	-- (Phase 2) 재구매 실행: 메소 차감 + 부위별 기본(0성·무잠재) 장비를 장비 탭에 지급.
	@ExecSpace("ClientOnly")
	method void DoRebuy(number slotIdx)
		local cost = (slotIdx == 6) and self:GetBalancePrice("rebuy_weapon", 50000) or self:GetBalancePrice("rebuy_armor", 10000)
		if _UIEquipInventoryManager.meso < cost then
			self:AppendLog("메소 부족! (" .. tostring(cost) .. "원 필요)")
			log("[Enhance] 재구매 실패 - 메소 부족")
			return
		end
		local grantedIdx = _UIEquipInventoryManager:GrantBasicEquipBySlot(slotIdx)
		if grantedIdx <= 0 then
			self:AppendLog("인벤토리(장비 탭)가 가득 찼습니다.")
			log("[Enhance] 재구매 실패 - 인벤 가득")
			return
		end
		_UIEquipInventoryManager:AddMeso(-cost)
		self:UpdateMesoDisplay()
		self:AppendLog("기본 장비 재구매 완료 (" .. tostring(cost) .. " 메소)")
		-- (요청) 재구매한 장비를 강화 대상 슬롯에 바로 올린다 - 파괴 → 재구매 → 즉시 재강화 루프
		self:SetEnhanceTargetFromRebuy(grantedIdx)
		log("[Enhance] 재구매 완료 slotIdx=" .. tostring(slotIdx) .. " cost=" .. tostring(cost) .. " → 강화 대상 자동 등록 (인벤 " .. tostring(grantedIdx) .. ")")
	end

	-- (신규) 재구매 직후 자동 등록: 방금 장비 탭 invenIdx에 지급된 기본 장비를 강화 대상으로 올린다.
	-- SetEnhanceTarget과 달리 탭을 "equip"으로 고정해 읽는다 - 재구매 시점의 활성 탭과 무관하게 동작.
	@ExecSpace("ClientOnly")
	method void SetEnhanceTargetFromRebuy(number invenIdx)
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		local s = _UIEquipInventoryManager:GetTabItem("equip", invenIdx)
		if s == "" then return end
		self.enhanceTargetEquipSlot = 0
		local discard = _UIEquipInventoryManager:ConsumeEnhancePick()
		self.enhanceTargetName = _UIEquipInventoryManager:ParseName(s)
		self.enhanceTargetRUID = _UIEquipInventoryManager:ParseRUID(s)
		self.enhanceTargetInvenIdx = invenIdx
		self.enhanceTargetItemStr = s
		self.enhanceTargetSrcTab = "equip"
		self.enhanceLevel = _UIEquipInventoryManager:ParseStars(s)
		self:ApplyEnhanceTargetUI()
		self:AppendLog("대상: " .. self.enhanceTargetName .. " (재구매 자동 등록)")
	end

	-- ─── 인벤 업데이트 ────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method table SplitItemFieldsPreserve(string s)
		-- (유실 방지) 아이템 문자열을 "|" 기준으로 빈 필드까지 보존하며 나눈다.
		-- gmatch("[^|]+")는 빈 필드를 소거해버려, 잠재만 부여된 아이템(f8·f13~16이 빈 필드)을
		-- 강화하는 순간 필드 인덱스가 앞으로 밀리며 잠재 등급/옵션이 오염된 채 저장되던 실버그의 원인.
		local fields = {}
		local start = 1
		while true do
			-- string.find는 (시작,끝) 2값 반환 - 둘 다 받아 LWA-1111 다중반환 경고를 피한다
			local pos, posEnd = string.find(s, "|", start, true)
			if pos == nil then
				table.insert(fields, string.sub(s, start))
				break
			end
			table.insert(fields, string.sub(s, start, pos - 1))
			start = pos + 1
		end
		return fields
	end

	@ExecSpace("ClientOnly")
	method void UpdateInvenItemStars(number newStars)
		-- 잠재능력 등 추가 필드 보존: stars(4번째) 필드만 교체 (빈 필드 보존 스플리터 필수)
		-- (신규) 장착 중 장비가 대상이면 장비창 문자열에 직접 반영한다 (스탯·레벨 즉시 갱신).
		if self.enhanceTargetEquipSlot > 0 then
			local es = _UIEquipInventoryManager:GetEquip(self.enhanceTargetEquipSlot)
			if es == "" then return end
			local previousLevel = _CharInfoManager:GetDisplayLevel()
			local efields = self:SplitItemFieldsPreserve(es)
			efields[4] = tostring(newStars)
			local newStr = table.concat(efields, "|")
			_UIEquipInventoryManager:SetEquipStr(self.enhanceTargetEquipSlot, newStr)
			-- 기본 상의 이관은 RefreshUI의 공간/하의 잠금 검사 후에만 확정한다.
			_UIEquipInventoryManager:RefreshUI()
			newStr = _UIEquipInventoryManager:GetEquip(self.enhanceTargetEquipSlot)
			self.enhanceTargetItemStr = newStr
			self.enhanceTargetName = _UIEquipInventoryManager:ParseName(newStr)
			self.enhanceTargetRUID = _UIEquipInventoryManager:ParseRUID(newStr)
			self:ApplyEnhanceTargetUI()
			_DecoWindowManager:ApplyAppearance()
			_CharacterPersistence:MarkDirty("enhance_equip")
			local currentLevel = _CharInfoManager:GetDisplayLevel()
			if currentLevel > previousLevel then self:PlayEquipmentLevelUp(previousLevel, currentLevel) end
			return
		end
		-- (버그 수정) 옛 코드가 "활성 탭 + 상한 20칸" 기준이라 ① 인벤 21번째 이후 슬롯의 아이템은
		-- 강화 결과가 조용히 유실됐고(신발 미반영 신고) ② 강화 중 탭을 바꾸면 엉뚱한 탭에 기록됐다.
		-- 잠재 부여 경로와 동일하게 등록 시점 탭(enhanceTargetSrcTab)에 고정하고 탭 전체 128칸을 허용한다.
		local idx = self.enhanceTargetInvenIdx
		if idx < 1 or idx > 128 then return end
		local srcTab = self.enhanceTargetSrcTab
		if srcTab == "" then srcTab = "equip" end
		local s = _UIEquipInventoryManager:GetTabItem(srcTab, idx)
		if s == "" then return end
		local fields = self:SplitItemFieldsPreserve(s)
		fields[4] = tostring(newStars)
		local newInvStr = _UIEquipInventoryManager:ResolveAppearance(table.concat(fields, "|"), _UIMyInfoManager:GetSelectedCharacterJobIdx())
		_UIEquipInventoryManager:SetTabItem(srcTab, idx, newInvStr)
		-- (버그 수정) 인벤 경로도 대상 캐시를 갱신한다 - 갱신하지 않으면 이후 주문서/큐브가
		-- 등록 시점의 별 수치로 아이템을 재조립해 강화 성과가 롤백되던 유실 버그.
		self.enhanceTargetItemStr = newInvStr
		self.enhanceTargetName = _UIEquipInventoryManager:ParseName(newInvStr)
		self.enhanceTargetRUID = _UIEquipInventoryManager:ParseRUID(newInvStr)
		self:ApplyEnhanceTargetUI()
		_UIEquipInventoryManager:RefreshUI()
		_CharacterPersistence:MarkDirty("enhance_inven")
	end

	@ExecSpace("ClientOnly")
	method void PlayEquipmentLevelUp(integer previousLevel, integer currentLevel)
		local player = _UserService.LocalPlayer
		if not isvalid(player) or currentLevel <= previousLevel then return end
        local avatar = player.AvatarRendererComponent
        local overlayLayer = isvalid(avatar) and avatar.SortingLayer or "Default"
        local overlayOrder = isvalid(avatar) and math.max(32769, avatar.OrderInLayer + 1) or 32769
        local ignoreMapLayer = isvalid(avatar) and avatar.IgnoreMapLayerCheck or false
		_EffectService:PlayEffectAttached("d92f2ec742d94285af771d33086773d3", player, Vector3.zero, 0, Vector3.one, false, {SortingLayer = overlayLayer, OrderInLayer = overlayOrder, IgnoreMapLayerCheck = ignoreMapLayer})
		_GameAudio:PlaySound("27d1c68e69384b19b7fa24783ab315f8", 1)
		log("[EquipmentLevelUp] " .. tostring(previousLevel) .. " -> " .. tostring(currentLevel))
	end

	@ExecSpace("ClientOnly")
	method void UpdateInvenItemName(string newName)
		-- 잠재능력 등 추가 필드 보존: name(1번째) 필드만 교체
		-- (버그 수정) 스타포스 반영과 동일 - 등록 시점 탭 고정 + 128칸 (옛 "활성 탭 + 20칸" 제거)
		local idx = self.enhanceTargetInvenIdx
		if idx < 1 or idx > 128 then return end
		local srcTab = self.enhanceTargetSrcTab
		if srcTab == "" then srcTab = "equip" end
		local s = _UIEquipInventoryManager:GetTabItem(srcTab, idx)
		if s ~= "" then
			local fields = self:SplitItemFieldsPreserve(s)
			fields[1] = newName
			local newStr = table.concat(fields, "|")
			_UIEquipInventoryManager:SetTabItem(srcTab, idx, newStr)
			self.enhanceTargetItemStr = newStr
			_UIEquipInventoryManager:RefreshUI()
		else
			local ruid = self.enhanceTargetRUID
			-- (Phase 1) 장착 슬롯 순회를 활성 9칸으로 확장 (망토8/장갑9 장착 중 강화 대응)
			for i = 1, 9 do
				local eq = _UIEquipInventoryManager:GetEquip(i)
				if eq ~= "" and _UIEquipInventoryManager:ParseRUID(eq) == ruid then
					local eqFields = self:SplitItemFieldsPreserve(eq)
					eqFields[1] = newName
					local newStr = table.concat(eqFields, "|")
					_UIEquipInventoryManager:SetEquipStr(i, newStr)
					self.enhanceTargetItemStr = newStr
					_UIEquipInventoryManager:RefreshUI()
					return
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void DestroyTarget()
		-- (신규) 장착 중 장비가 대상이면 장비창에서 직접 파괴한다 (외형·스탯·레벨 즉시 반영).
		if self.enhanceTargetEquipSlot > 0 then
			_UIEquipInventoryManager:SetEquipStr(self.enhanceTargetEquipSlot, "")
			_DecoWindowManager:ApplyAppearance()
			_UIEquipInventoryManager:RefreshUI()
			_CharacterPersistence:MarkDirty("enhance_destroy")
			log("[Enhance] 장착 장비 슬롯 " .. tostring(self.enhanceTargetEquipSlot) .. " 파괴")
			self:ClearTarget()
			return
		end
		local idx = self.enhanceTargetInvenIdx
		local ruid = self.enhanceTargetRUID
		-- (버그 수정) 스타포스 반영과 동일 - 등록 시점 탭 고정 + 128칸 (옛 "활성 탭 + 20칸" 제거)
		local srcTabD = self.enhanceTargetSrcTab
		if srcTabD == "" then srcTabD = "equip" end
		if idx >= 1 and idx <= 128 then
			local s = _UIEquipInventoryManager:GetTabItem(srcTabD, idx)
			if s ~= "" then
				_UIEquipInventoryManager:SetTabItem(srcTabD, idx, "")
			else
				-- (Phase 1) 장착 슬롯 순회를 활성 9칸으로 확장 (망토8/장갑9 장착 중 파괴 대응)
				for i = 1, 9 do
					local eq = _UIEquipInventoryManager:GetEquip(i)
					if eq ~= "" and _UIEquipInventoryManager:ParseRUID(eq) == ruid then
						_UIEquipInventoryManager:SetEquipStr(i, "")
						log("[Enhance] 장비 슬롯 " .. tostring(i) .. " 파괴")
						break
					end
				end
			end
			_UIEquipInventoryManager:RefreshUI()
			_CharacterPersistence:MarkDirty("enhance_destroy")
		end
		self:ClearTarget()
	end

	-- ─── 주문서 탭 (전용 주문서 그리드 + 사용하기) ──────────────────────
	@ExecSpace("ClientOnly")
	method void SetScrollLog(string msg)
		-- 주문서 탭 하단 결과 로그 한 줄 표시
		local ent = _EntityService:GetEntityByPath(self.pathContent .. "/ScrollContent/ScrollMain/ScrollLogText")
		if isvalid(ent) then ent.TextComponent.Text = msg end
	end

	@ExecSpace("ClientOnly")
	method integer GetTargetFieldNum(integer fieldIdx)
		-- 강화 대상 아이템 문자열의 N번째 파이프 필드를 숫자로 반환 (없으면 0)
		local s = self.enhanceTargetItemStr
		if s == "" then return 0 end
		local fields = {}
		local pos = 1
		while true do
			local j, _ = string.find(s, "|", pos, true)
			if j then fields[#fields+1] = string.sub(s, pos, j-1); pos = j+1
			else fields[#fields+1] = string.sub(s, pos); break end
		end
		return math.floor(tonumber(fields[fieldIdx]) or 0)
	end

	@ExecSpace("ClientOnly")
	method void RefreshScrollContent()
		-- 주문서 탭 UI 갱신: 대상 없음 → 안내 문구, 대상 있음 → 주문서 그리드/효과/사용 버튼
		local scPath = self.pathContent .. "/ScrollContent"
		local main = _EntityService:GetEntityByPath(scPath .. "/ScrollMain")
		local chev = _EntityService:GetEntityByPath(scPath .. "/PlaceholderChevron")
		local msg  = _EntityService:GetEntityByPath(scPath .. "/PlaceholderMsg")
		local hasItem = self.enhanceTargetItemStr ~= ""
		if isvalid(chev) then chev.Enable = not hasItem end
		if isvalid(msg)  then msg.Enable  = not hasItem end
		if isvalid(main) then main.Enable = hasItem end
		if not hasItem then return end

		-- 종류당 한 칸을 사용해 같은 주문서의 여러 스택이 다른 종류를 가리지 않게 한다.
		local validRUIDs = {}
		validRUIDs["314215aface349c48b81eee58065e1b7"] = true
		validRUIDs["bb6c1532d7364170a11abd2d8835bc81"] = true
		validRUIDs["a6c6ff42196548dd874b83332ad5b336"] = true
		validRUIDs["14267ae8e168458480697c148ddfdcab"] = true
		validRUIDs["0f134eebddee4b368062790b46afc26a"] = true
		local seenRUIDs = {}
		local previous = self._T.scrollSlots and self._T.scrollSlots[self.scrollSelectedSlot] or nil
		local consumeData = _UIEquipInventoryManager._T.tabData["consume"] or {}
		local slotFill = {}
		local found = 0
		for consumeSlot = 1, 128 do
			local cs = consumeData[consumeSlot] or ""
			if cs ~= "" then
				local ruid  = _UIEquipInventoryManager:ParseInvenRUID(cs)
				local count = _UIEquipInventoryManager:ParseCount(cs)
				if validRUIDs[ruid] and count > 0 and not seenRUIDs[ruid] then
					seenRUIDs[ruid] = true
					found = found + 1
					if found <= 8 then
						slotFill[found] = {
							consumeSlot = consumeSlot, ruid = ruid, count = count,
							itemName = _UIEquipInventoryManager:ParseName(cs),
						}
					end
				end
			end
		end
		self._T.scrollSlots = slotFill
		self.scrollSelectedSlot = 0
		if previous then
			for i, entry in ipairs(slotFill) do
				if entry.ruid == previous.ruid then self.scrollSelectedSlot = i break end
			end
		end

		-- 선택 유지: 소진되면 해제, 미선택이면 첫 주문서 자동 선택
		if self.scrollSelectedSlot > 0 and slotFill[self.scrollSelectedSlot] == nil then
			self.scrollSelectedSlot = 0
		end
		if self.scrollSelectedSlot == 0 and slotFill[1] ~= nil then
			self.scrollSelectedSlot = 1
		end

		local smPath = scPath .. "/ScrollMain"
		for i = 1, 8 do
			local slotPath = smPath .. "/ScrollSlot" .. tostring(i)
			local iconEnt  = _EntityService:GetEntityByPath(slotPath .. "/SlotIcon")
			local countEnt = _EntityService:GetEntityByPath(slotPath .. "/CountText")
			self:SetEnhanceItemSelection(slotPath, i == self.scrollSelectedSlot and slotFill[i] ~= nil)
			if slotFill[i] then
				if isvalid(iconEnt) then
					iconEnt.SpriteGUIRendererComponent.ImageRUID = "thumbnail://" .. slotFill[i].ruid
					iconEnt.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				end
				if isvalid(countEnt) then countEnt.TextComponent.Text = tostring(slotFill[i].count) end
			else
				if isvalid(iconEnt) then
					iconEnt.SpriteGUIRendererComponent.ImageRUID = ""
					iconEnt.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
				end
				if isvalid(countEnt) then countEnt.TextComponent.Text = "" end
			end
		end

		local emptyEnt = _EntityService:GetEntityByPath(smPath .. "/ScrollEmptyText")
		if isvalid(emptyEnt) then emptyEnt.Enable = (found == 0) end

		-- 선택 주문서 설명 + 효과/횟수
		local descEnt = _EntityService:GetEntityByPath(smPath .. "/ScrollDescText")
		local sel = slotFill[self.scrollSelectedSlot]
		if isvalid(descEnt) then
			if sel then
				local rate = sel.ruid == "bb6c1532d7364170a11abd2d8835bc81" and "90%" or "60%"
				if sel.ruid == "a6c6ff42196548dd874b83332ad5b336" then rate = "100%" end
				if sel.ruid == "14267ae8e168458480697c148ddfdcab" or sel.ruid == "0f134eebddee4b368062790b46afc26a" then rate = "70%" end
				descEnt.TextComponent.Text = sel.itemName .. "  |  성공 확률 " .. rate
			else
				descEnt.TextComponent.Text = ""
			end
		end
		local infoEnt = _EntityService:GetEntityByPath(smPath .. "/ScrollInfoText")
		if isvalid(infoEnt) then
			local scrolls = self:GetTargetFieldNum(5)
			local upgrade = self:GetTargetFieldNum(6)
			infoEnt.TextComponent.Text = "성공 시 주문서 강화 +1 (현재 +" .. tostring(scrolls) .. ")\n남은 업그레이드 가능 횟수 : " .. tostring(upgrade) .. "회"
			if sel and sel.ruid == "bb6c1532d7364170a11abd2d8835bc81" then
				infoEnt.TextComponent.Text = "성공: 스타포스 +1~5성 (각 20%, 최대 100성)\n실패: 장비 파괴 / 프로텍트 적용 시 1회 방지"
			elseif sel and sel.ruid == "a6c6ff42196548dd874b83332ad5b336" then
				local blocked = _UIEquipInventoryManager:SpecialScrollBlockedReason(sel.ruid, self.enhanceTargetItemStr)
				local state = blocked ~= "" and blocked or "사용 가능 (중복 적용 불가)"
				infoEnt.TextComponent.Text = "스타포스 30성 이하 장비 전용\n다음 스타포스 1회 파괴 방지 / 성공·실패 후 소모\n" .. state
			elseif sel and (sel.ruid == "14267ae8e168458480697c148ddfdcab" or sel.ruid == "0f134eebddee4b368062790b46afc26a") then
				local additional = sel.ruid == "0f134eebddee4b368062790b46afc26a"
				local label = additional and "에디셔널 잠재능력" or "잠재능력"
				local blocked = _UIEquipInventoryManager:SpecialScrollBlockedReason(sel.ruid, self.enhanceTargetItemStr)
				infoEnt.TextComponent.Text = "성공: 레어 " .. label .. " 부여\n실패: 장비 파괴 / 업그레이드 횟수 차감 없음"
				if blocked ~= "" then infoEnt.TextComponent.Text = infoEnt.TextComponent.Text .. "\n" .. blocked end
			end
		end
		log("[Enhance] RefreshScrollContent found=" .. tostring(found) .. " sel=" .. tostring(self.scrollSelectedSlot))
	end

	@ExecSpace("ClientOnly")
	method void OnScrollSlotTouch(integer slotIdx)
		-- 주문서 슬롯 클릭 → 선택
		if _StarforcePresentation.busy or self:IsConfirmDialogOpen() then return end
		if not self._T.scrollSlots or self._T.scrollSlots[slotIdx] == nil then
			log("[Enhance] 빈 주문서 슬롯: " .. tostring(slotIdx))
			return
		end
		self.scrollSelectedSlot = slotIdx
		self:RefreshScrollContent()
		log("[Enhance] 주문서 선택 slot=" .. tostring(slotIdx))
	end

	@ExecSpace("ClientOnly")
	method void ShowScrollConfirm()
		-- Button and Space ask first; merely opening this dialog never consumes a scroll.
		if _StarforcePresentation.busy or self:IsConfirmDialogOpen() then return end
		if not self:IsWindowOpen() or self.currentTab ~= 2 or (self._T.pendingCubeTab or 0) ~= 0 then return end
		if not self:CheckCurrentTarget() then
			self:SetScrollLog("강화할 장비를 먼저 올려주세요.")
			return
		end
		local sel = self._T.scrollSlots and self._T.scrollSlots[self.scrollSelectedSlot] or nil
		if sel == nil then self:SetScrollLog("사용할 주문서를 선택하세요."); return end
		local inv = _UIEquipInventoryManager
		local scroll = inv:GetTabItem("consume", sel.consumeSlot)
		if scroll == "" or inv:ParseInvenRUID(scroll) ~= sel.ruid or inv:ParseCount(scroll) <= 0 then
			self:SetScrollLog("주문서가 없거나 위치가 변경되었습니다.")
			self:RefreshScrollContent()
			return
		end
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		local txt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/DlgText")
		if not isvalid(dlg) or not isvalid(txt) then return end
		self._T.scrollUseRequest = { item=self.enhanceTargetItemStr, equipSlot=self.enhanceTargetEquipSlot,
			srcTab=self.enhanceTargetSrcTab, itemSlot=self.enhanceTargetInvenIdx,
			selection=self.scrollSelectedSlot, consumeIdx=sel.consumeSlot, ruid=sel.ruid, scroll=scroll }
		txt.TextComponent.Text = inv:GetDisplayName(self.enhanceTargetItemStr) .. "에\n" .. inv:ParseName(scroll) .. " 1개를\n사용하시겠습니까?\n\n사용 후에는 되돌릴 수 없습니다."
		self._T.confirmMode = "scroll_use"
		self._T.confirmInfoOnly = false
		self._T.pendingRebuySlot = nil
		self._T.confirmOpenedAt = _UtilLogic.ElapsedSeconds
		dlg.Enable = true
		log("[Enhance] scroll confirmation opened ruid=" .. sel.ruid)
	end

	@ExecSpace("ClientOnly")
	method void ExecuteScrollUse(table request)
		-- Revalidate the exact equipment/scroll snapshot after confirmation, then consume once.
		if request == nil or not self:IsWindowOpen() or self.currentTab ~= 2 then return end
		local sel = self._T.scrollSlots and self._T.scrollSlots[self.scrollSelectedSlot] or nil
		if request.item ~= self.enhanceTargetItemStr or request.item ~= self:ReadCurrentTarget()
			or request.equipSlot ~= self.enhanceTargetEquipSlot or request.srcTab ~= self.enhanceTargetSrcTab
			or request.itemSlot ~= self.enhanceTargetInvenIdx or request.selection ~= self.scrollSelectedSlot
			or sel == nil or request.consumeIdx ~= sel.consumeSlot or request.ruid ~= sel.ruid
			or request.scroll ~= _UIEquipInventoryManager:GetTabItem("consume", request.consumeIdx) then
			self:SetScrollLog("장비 또는 주문서가 변경되었습니다. 다시 확인해주세요.")
			log("[Enhance] stale scroll confirmation rejected")
			return
		end
		self:UseScrollOnTarget()
	end

	@ExecSpace("ClientOnly")
	method void UseScrollOnTarget()
		if _UIEquipInventoryManager:IsStarterEquipment(self.enhanceTargetItemStr) then
			self:SetScrollLog("생성 전용 장비에는 주문서를 사용할 수 없습니다.")
			return
		end
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		if self:IsConfirmDialogOpen() or (self._T.pendingCubeTab or 0) ~= 0 then return end
		-- 선택된 주문서의 효과별로 검증한 뒤 사용한다. 강화/보호는 업그레이드 횟수를 쓰지 않는다.
		if not self:CheckCurrentTarget() then return end
		if self.enhanceTargetItemStr == "" then
			self:SetScrollLog("강화할 장비를 먼저 올려주세요.")
			return
		end
		local sel = self._T.scrollSlots and self._T.scrollSlots[self.scrollSelectedSlot] or nil
		if sel == nil then
			self:SetScrollLog("사용할 주문서를 선택하세요.")
			return
		end
		local cdLive = _UIEquipInventoryManager:GetTabItem("consume", sel.consumeSlot)
		if cdLive == "" or _UIEquipInventoryManager:ParseInvenRUID(cdLive) ~= sel.ruid or _UIEquipInventoryManager:ParseCount(cdLive) <= 0 then
			self:SetScrollLog("주문서가 없거나 위치가 변경되었습니다.")
			self:RefreshScrollContent()
			return
		end
		if _UIEquipInventoryManager:IsSpecialEnhanceScroll(sel.ruid) then
			local tab = self.enhanceTargetSrcTab ~= "" and self.enhanceTargetSrcTab or "equip"
			local result = _UIEquipInventoryManager:UseSpecialEnhanceScroll("consume", sel.consumeSlot, self.enhanceTargetEquipSlot, tab, self.enhanceTargetInvenIdx, sel.ruid)
			self:SetScrollLog(result.message)
			self:AppendLog(result.message)
			self:RefreshScrollContent()
			return
		end
		if sel.ruid ~= "314215aface349c48b81eee58065e1b7" then return end

		-- 파이프 필드 파싱 (잠재능력 등 추가 필드 보존)
		local s = self.enhanceTargetItemStr
		local fields = {}
		local pos = 1
		while true do
			local j, _ = string.find(s, "|", pos, true)
			if j then fields[#fields+1] = string.sub(s, pos, j-1); pos = j+1
			else fields[#fields+1] = string.sub(s, pos); break end
		end

		local slotIdx = math.floor(tonumber(fields[3]) or 0)
		-- (Phase 1) 주문서도 강화 6부위 판정으로 통일 (기존 1~7 범위 검사 대체)
		if not self:IsEnhanceableSlot(slotIdx) then
			self:SetScrollLog("강화 가능한 장비(모자/상의/망토/장갑/신발/무기)에만 사용할 수 있습니다.")
			return
		end
		local upgrade = math.floor(tonumber(fields[6]) or 0)
		if upgrade <= 0 then
			self:SetScrollLog("업그레이드 가능 횟수가 없습니다.")
			return
		end

		if not _StarforcePresentation:BeginScroll(self.enhanceLevel) then
			self:SetScrollLog("강화 이펙트를 준비 중입니다. 잠시 후 다시 시도하세요.")
			return
		end
		-- 주문서 1개 소비 (소비 탭 직접 감소 — 큐브 소비와 동일 패턴)
		local consumeIdx = sel.consumeSlot
		local cd = _UIEquipInventoryManager._T.tabData["consume"][consumeIdx] or ""
		if cd ~= "" then
			local cf = {}
			local cp = 1
			while true do
				local cj, _ = string.find(cd, "|", cp, true)
				if cj then cf[#cf+1] = string.sub(cd, cp, cj-1); cp = cj+1
				else cf[#cf+1] = string.sub(cd, cp); break end
			end
			while #cf < 7 do cf[#cf+1] = "0" end
			local cnt = (tonumber(cf[7]) or 0) - 1
			if cnt <= 0 then
				_UIEquipInventoryManager._T.tabData["consume"][consumeIdx] = ""
			else
				cf[7] = tostring(cnt)
				_UIEquipInventoryManager._T.tabData["consume"][consumeIdx] = table.concat(cf, "|")
			end
		end

		-- 60% 성공: 성공 시 scrolls(+N) 증가, 성공/실패 무관 업그레이드 횟수 1 차감
		local success = _UtilLogic:RandomDouble() < 0.6
		fields[6] = tostring(upgrade - 1)
		if success then
			fields[5] = tostring(math.floor(tonumber(fields[5]) or 0) + 1)
		end
		local newStr = table.concat(fields, "|")
		self.enhanceTargetItemStr = newStr

		-- 원본 위치에 반영 - (신규) 장착 중 장비 대상이면 장비창, 아니면 인벤 원본 탭
		if self.enhanceTargetEquipSlot > 0 then
			_UIEquipInventoryManager:SetEquipStr(self.enhanceTargetEquipSlot, newStr)
			_CharacterPersistence:MarkDirty("enhance_scroll")
		else
			local srcTab = self.enhanceTargetSrcTab
			if srcTab == "" then srcTab = "equip" end
			_UIEquipInventoryManager._T.tabData[srcTab][self.enhanceTargetInvenIdx] = newStr
		end
		_UIEquipInventoryManager:RefreshUI()

		-- 대상 이름 라벨 갱신 ("이름+N")
		_CharacterPersistence:MarkDirty("enhance_scroll")
		local nameLabel = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetNameLabel")
		if isvalid(nameLabel) then
			nameLabel.TextComponent.Text = _UIEquipInventoryManager:GetDisplayName(newStr)
		end

		if success then
			self:SetScrollLog("성공! 주문서 강화 +" .. fields[5] .. "  (남은 횟수 " .. fields[6] .. "회)")
		else
			self:SetScrollLog("실패.  (남은 횟수 " .. fields[6] .. "회)")
		end
		self:RefreshScrollContent()
		log("[Enhance] 주문서 사용 success=" .. tostring(success) .. " scrolls=" .. fields[5] .. " upgrade=" .. fields[6])
		_StarforcePresentation:ShowResult(success and "success" or "maintain", self.enhanceLevel, 0)
	end

	-- ─── 스타포스 UI 업데이트 ────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void UpdateStarforceUI(integer level)
		-- Both states use one font and size; only the fill and color change.
		if _StarforcePresentation.busy and _StarforcePresentation.displayedLevel >= 0 then
			level = _StarforcePresentation.displayedLevel
		end
		local sfPath = self.pathContent .. "/StarforceContent"
		for i = 1, 100 do
			local star = _EntityService:GetEntityByPath(sfPath .. "/Star_" .. tostring(i))
			if isvalid(star) then
				star.Enable = i <= _CashShopManager:GetMaxStars(self.enhanceTargetItemStr)
				local achieved = i <= level
				star.SpriteGUIRendererComponent.Enable = false
				star.SpriteGUIRendererComponent.Color = Color(1, 0.84, 0.24, 1)
				star.TextComponent.Enable = true
				star.TextComponent.FontSize = 19
				star.TextComponent.Text = achieved and "★" or "☆"
				star.TextComponent.FontColor = achieved and Color(1, 0.84, 0.24, 1) or Color.white
			end
		end
		local arrow = _EntityService:GetEntityByPath(sfPath .. "/LevelArrow")
		if isvalid(arrow) then arrow.Enable = false end
		local comparison = _EntityService:GetEntityByPath(sfPath .. "/ArrowPillBG")
		if isvalid(comparison) then comparison.Enable = false end
		self:UpdateStarforceProgressLabel(level)

		-- 상승 수치
		local statsEnt = _EntityService:GetEntityByPath(sfPath .. "/StatsText")
		if isvalid(statsEnt) then
			statsEnt.TextComponent.Text = self:GetStarforceStatText(level)
		end

		-- 강화 확률 텍스트 - (Phase 2) 구간표 기반 4항목 표시
		local rateEnt = _EntityService:GetEntityByPath(sfPath .. "/RateText")
		if isvalid(rateEnt) then
			local band = self:GetStarforceBand(level)
			if _UIEquipInventoryManager:HasStarforceProtection(self.enhanceTargetItemStr) then
				band.keep = band.keep + band.destroy
				band.destroy = 0
			end
			rateEnt.TextComponent.Text = "성공 " .. tostring(band.success) .. "% | 유지 " .. tostring(band.keep)
				.. "% | 하락 " .. tostring(band.drop) .. "% | 파괴 " .. tostring(band.destroy) .. "%"
			if _UIEquipInventoryManager:HasStarforceProtection(self.enhanceTargetItemStr) then
				rateEnt.TextComponent.Text = rateEnt.TextComponent.Text .. "\n프로텍트 적용: 이번 강화 후 소모"
			end
		end

		-- 사용 재화
		local costEnt = _EntityService:GetEntityByPath(sfPath .. "/CostText")
		if isvalid(costEnt) then
			local cost = self:GetStarforceCost(level)
			costEnt.TextComponent.Text = "사용 재화            " .. tostring(cost) .. " 메소"
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateStarforceProgressLabel(integer level)
		-- 아이템명 아래에 현재 별 수와 다음 단계를 표시한다. 대상 없음·다른 탭에서는 숨긴다.
		local label = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetNameLabel/StarforceProgressText")
		if not isvalid(label) then return end
		local show = self.currentTab == 1 and self.enhanceTargetItemStr ~= ""
		label.Enable = show
		if not show then
			label.TextGUIRendererComponent.Text = ""
			return
		end
		local current = math.max(0, math.min(100, level))
		local text = "★ " .. tostring(current) .. "성"
		if current >= _CashShopManager:GetMaxStars(self.enhanceTargetItemStr) then
			text = text .. " (최대)"
		else
			text = text .. " > " .. tostring(current + 1) .. "성"
		end
		label.TextGUIRendererComponent.Text = text
		log("[Enhance] starforce progress=" .. text)
	end

	@ExecSpace("ClientOnly")
	method string GetStarforceStatText(integer level)
		if _CashShopManager:IsHalfEarring(self.enhanceTargetItemStr) then
			return "아이템 드롭률  +2%\n메소 획득량  +2%\n공격력  +3"
		end
		-- (전투력 개편 2026-08-08) 구간표 폐지 - 1성당 "직업 주스탯 +4, 공격력 +3" 균일.
		-- CharInfoManager.CalcStarforceStats(실제 적용)와 반드시 같은 값을 표시해야 한다.
		-- (마력 분리 2026-08-12) 스타포스 공격력은 마력에도 같은 값으로 들어간다(무기 기본옵션과 동일 규칙) -
		-- 마법 직업도 스타포스로 전투력이 오르도록. 표기도 "공격력/마력"으로 맞춘다.
		return _CharInfoManager:GetMainStatName() .. "  +4\n공격력/마력  +3"
	end

	-- (Phase 2) 스타포스 구간표 (GDD §4.2) - 현재 성 수 기준 성공/유지/하락/파괴 %와 회당 비용(메소).
	-- "저구간은 값싸고 거의 성공 / 고구간은 하락·파괴 지옥, 20~30성 = 최상위 성취"가 설계 의도.
	-- (Phase 5) Balance/StarforceTable.csv가 진실의 원천 - 없거나 손상이면 아래 하드코딩 폴백.
	@ExecSpace("ClientOnly")
	method table GetStarforceBand(integer level)
		-- 표시와 실제 판정이 동일한 테스트 확률을 사용한다. 원본 구간표/비용은 수정하지 않는다.
		local band = self:GetBaseStarforceBand(level)
		if self._T.testGuaranteedStarforce == true or (level < 3 and _UIEquipInventoryManager:IsStarterEquipment(self.enhanceTargetItemStr)) then
			band.success = 100
			band.keep = 0
			band.drop = 0
			band.destroy = 0
		end
		return band
	end

	@ExecSpace("ClientOnly")
	method void SetTestGuaranteedStarforce(boolean enabled)
		-- 개발 테스트용 세션 상태. 캐릭터 저장 데이터에는 포함하지 않는다.
		self._T.testGuaranteedStarforce = enabled
		self:UpdateStarforceUI(self.enhanceLevel)
		if enabled then
			_UIToast:ShowMessage("개발 테스트: 강화 성공 확률 100% 적용")
		else
			_UIToast:ShowMessage("개발 테스트: 강화 성공 확률을 원래대로 복원")
		end
		log("[EnhanceTest] 성공 확률 100%=" .. tostring(enabled))
	end

	@ExecSpace("ClientOnly")
	method table GetBaseStarforceBand(integer level)
		-- CSV 로드 (최초 1회 캐싱): minStar 오름차순 밴드 목록
		if self._T.sfBands == nil then
			local bands = nil
			local ok, ds = pcall(function() return _DataService:GetTable("StarforceTable") end)
			if ok and ds ~= nil then
				local n = ds:GetRowCount()
				if n >= 3 then
					bands = {}
					for i = 1, n do
						table.insert(bands, {
							minStar = math.floor(tonumber(ds:GetCell(i, "minStar")) or 0),
							success = tonumber(ds:GetCell(i, "success")) or 0,
							keep    = tonumber(ds:GetCell(i, "keep")) or 0,
							drop    = tonumber(ds:GetCell(i, "drop")) or 0,
							destroy = tonumber(ds:GetCell(i, "destroy")) or 0,
							cost    = tonumber(ds:GetCell(i, "cost")) or 0,
						})
					end
					log("[Enhance] StarforceTable CSV 로드 완료 (" .. tostring(n) .. "구간)")
				end
			end
			self._T.sfBands = bands or false   -- false = 폴백 사용 표시
		end
		if self._T.sfBands ~= false and self._T.sfBands ~= nil then
			local best = nil
			for _, b in ipairs(self._T.sfBands) do
				if level >= b.minStar and (best == nil or b.minStar > best.minStar) then
					best = b
				end
			end
			if best ~= nil then
				return { success = best.success, keep = best.keep, drop = best.drop, destroy = best.destroy, cost = best.cost }
			end
		end
		-- (재보정 v4 - 요청 2026-08-08) 전 구간 성공 70% / 파괴 30% 고정 - 유지·하락 없음.
		-- 비용은 v2 유지. CSV(Balance/StarforceTable.csv)와 동일 값.
		if level < 5 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 300 }
		elseif level < 10 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 1000 }
		elseif level < 12 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 2500 }
		elseif level < 15 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 5000 }
		elseif level < 17 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 12000 }
		elseif level < 20 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 30000 }
		elseif level < 22 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 90000 }
		elseif level < 25 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 250000 }
		elseif level < 30 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 600000 }
		elseif level < 40 then return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 2000000 }
		else return { success = 70, keep = 0, drop = 0, destroy = 30, cost = 6000000 }
		end
	end

	@ExecSpace("ClientOnly")
	method integer GetStarforceCost(integer level)
		-- (Phase 2) 비용은 구간표 단일 출처로 위임한다 (기존 호출부 호환 유지)
		return math.floor(self:GetStarforceBand(level).cost)
	end

	-- (Phase 5) 밸런스 가격 조회 - Balance/ShopPrice.csv의 key 행을 읽고, 없으면 기본값.
	@ExecSpace("ClientOnly")
	method integer GetBalancePrice(string priceKey, integer defaultPrice)
		if self._T.shopPrices == nil then
			local prices = nil
			local ok, ds = pcall(function() return _DataService:GetTable("ShopPrice") end)
			if ok and ds ~= nil then
				local n = ds:GetRowCount()
				if n >= 1 then
					prices = {}
					for i = 1, n do
						local k = ds:GetCell(i, "key")
						local v = tonumber(ds:GetCell(i, "price"))
						if k ~= nil and k ~= "" and v ~= nil then prices[k] = math.floor(v) end
					end
					log("[Enhance] ShopPrice CSV 로드 완료 (" .. tostring(n) .. "행)")
				end
			end
			self._T.shopPrices = prices or false
		end
		if self._T.shopPrices ~= false and self._T.shopPrices ~= nil then
			local v = self._T.shopPrices[priceKey]
			if v ~= nil then return v end
		end
		return defaultPrice
	end

	-- ─── 초기화 ───────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method boolean HasEnhanceTarget()
		-- 강화 대상이 슬롯에 올라가 있는지 (인벤 경로/장착 경로 공통) - 인벤 이동 잠금 등이 참조한다.
		return self.enhanceTargetEquipSlot > 0 or self.enhanceTargetInvenIdx > 0
	end

	@ExecSpace("ClientOnly")
	method void ClearTarget()
		-- Do not switch targets/tabs or repeat actions during the Starforce sequence.
		if _StarforcePresentation.busy then return end
		-- 선택 대기 중인 큐브 결과는 대상 슬롯 더블클릭으로 버리지 않는다.
		if self:RequireCubeChoice() then return end
		self:ClearPendingCubeChoice()
		self.enhanceTargetName = ""
		self.enhanceTargetRUID = ""
		self.enhanceTargetInvenIdx = 0
		self.enhanceTargetEquipSlot = 0
		self.enhanceLevel = 0
		self.enhanceTargetItemStr = ""
		self.enhanceTargetSrcTab  = ""
		self.potSelectedSlot = 0
		self.addSelectedSlot = 0
		if self.currentTab == 1 then self:UpdateStarforceUI(0) end
		self:UpdateStarforceProgressLabel(0)

		local icon = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/TargetIcon")
		if isvalid(icon) then
			icon.SpriteGUIRendererComponent.ImageRUID = ""
			icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0)
		end

		local placeholder = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/PlaceholderIcon")
		if isvalid(placeholder) then placeholder.Enable = true end

		local prompt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/SlotPromptText")
		if isvalid(prompt) then prompt.Enable = true end

		local nameLabel = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetNameLabel")
		if isvalid(nameLabel) then
			nameLabel.Enable = false
			nameLabel.TextComponent.Text = ""
		end

		local starEnt = _EntityService:GetEntityByPath(self.pathSlotArea .. "/TargetSlotBG/StarLabel")
		if isvalid(starEnt) then starEnt.TextComponent.Text = "" end

		local levelText = _EntityService:GetEntityByPath(self.pathContent .. "/StarforceContent/EnhanceLevelText")
		if isvalid(levelText) then levelText.TextComponent.Text = "+0강" end

		-- 탭 비활성화 갱신 (아이템 없음)
		self:UpdateTabDisabledState()
	end

	-- ─── 탭 비활성화 상태 갱신 ──────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void UpdateTabDisabledState()
		local hasPot = false
		local hasAdd = false
		local s = self.enhanceTargetItemStr
		if s ~= "" then
			local fields = {}
			local pos = 1
			while true do
				local j, _ = string.find(s, "|", pos, true)
				if j then fields[#fields+1] = string.sub(s, pos, j-1); pos = j+1
				else fields[#fields+1] = string.sub(s, pos); break end
			end
			if #fields >= 8 then
				hasPot = (tonumber(fields[7]) or 0) >= 1
				hasAdd = (tonumber(fields[8]) or 0) >= 1
			end
		end
		self._T.tabPotDisabled = not hasPot
		self._T.tabAddDisabled = not hasAdd

		-- 현재 탭이 비활성화된 경우 대기 상태(0)로 전환
		if (self.currentTab == 4 and self._T.tabPotDisabled) or
		   (self.currentTab == 5 and self._T.tabAddDisabled) then
			self:SelectTab(0)
		elseif self.currentTab == 4 or self.currentTab == 5 then
			self:RefreshCubeContent(self.currentTab)
		else
			-- 다른 탭 유지 — 탭 색상만 SelectTab 재호출로 갱신
			self:SelectTab(self.currentTab)
		end
		log("[Enhance] TabDisabled pot=" .. tostring(self._T.tabPotDisabled) .. " add=" .. tostring(self._T.tabAddDisabled))
	end

	-- ─── 큐브 리셋: 상태 표시 갱신 ─────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void RefreshCubeContent(integer tabIdx)
		-- 잠재능력(4) 또는 에디셔널(5) 탭의 우측 패널 상태 결정 후 UI 갱신
		if (self._T.pendingCubeTab or 0) ~= 0 then return end
		local contentName = tabIdx == 4 and "PotentialContent" or "AdditionalContent"
		local cPath = self.pathContent .. "/" .. contentName

		local function setStatePanel(noItem, incompat, itemInfo)
			local pNone = _EntityService:GetEntityByPath(cPath .. "/NoItemPanel")
			local pInco = _EntityService:GetEntityByPath(cPath .. "/IncompatiblePanel")
			local pItem = _EntityService:GetEntityByPath(cPath .. "/ItemInfoPanel")
			if isvalid(pNone) then pNone.Enable = noItem   end
			if isvalid(pInco) then pInco.Enable = incompat  end
			if isvalid(pItem) then pItem.Enable = itemInfo  end
		end

		local s = self.enhanceTargetItemStr
		if s == "" then
			setStatePanel(true, false, false)
			return
		end

		-- 파이프 구분 필드 파싱
		local fields = {}
		local pos = 1
		while true do
			local j, _ = string.find(s, "|", pos, true)
			if j then fields[#fields+1] = string.sub(s, pos, j-1); pos = j+1
			else fields[#fields+1] = string.sub(s, pos); break end
		end

		if #fields < 8 then
			-- 잠재능력 필드가 없는 오래된 아이템 형식
			setStatePanel(false, true, false)
			return
		end

		local relevantField = (tabIdx == 4) and (tonumber(fields[7]) or 0) or (tonumber(fields[8]) or 0)
		if relevantField == 0 then
			setStatePanel(false, true, false)
			return
		end

		-- 등급 및 옵션 표시
		local gradeIdx = tabIdx == 4 and 9 or 13
		local opt1Idx  = tabIdx == 4 and 10 or 14
		local opt2Idx  = tabIdx == 4 and 11 or 15
		local opt3Idx  = tabIdx == 4 and 12 or 16

		local grade = tonumber(fields[gradeIdx]) or 1
		if grade < 1 then grade = 1 end
		if grade > 4 then grade = 4 end

		local opt1 = (#fields >= opt1Idx) and fields[opt1Idx] or ""
		local opt2 = (#fields >= opt2Idx) and fields[opt2Idx] or ""
		local opt3 = (#fields >= opt3Idx) and fields[opt3Idx] or ""

		local gradeNames  = {"레어", "에픽", "유니크", "레전드리"}
		local barEnt = _EntityService:GetEntityByPath(cPath .. "/ItemInfoPanel/GradeBarBG")
		if isvalid(barEnt) then barEnt.SpriteGUIRendererComponent.Color = Color(0.16, 0.17, 0.19, 1) end

		local titleEnt = _EntityService:GetEntityByPath(cPath .. "/ItemInfoPanel/GradeTitleText")
		if isvalid(titleEnt) then
			titleEnt.TextComponent.Text = gradeNames[grade]
			titleEnt.TextComponent.FontColor = self:GetCubeGradeColor(grade)
		end

		local o1 = _EntityService:GetEntityByPath(cPath .. "/ItemInfoPanel/Opt1Text")
		local o2 = _EntityService:GetEntityByPath(cPath .. "/ItemInfoPanel/Opt2Text")
		local o3 = _EntityService:GetEntityByPath(cPath .. "/ItemInfoPanel/Opt3Text")
		if isvalid(o1) then o1.TextComponent.Text = opt1 end
		if isvalid(o2) then o2.TextComponent.Text = opt2 end
		if isvalid(o3) then o3.TextComponent.Text = opt3 end

		setStatePanel(false, false, true)
		self:UpdateCubeGrid(tabIdx)

		-- 초기 탭 상태 색상 적용 (큐브 탭 기본 선택)
		local currTab = (tabIdx == 4) and self.potCurrencyTab or self.addCurrencyTab
		if currTab == 1 then self:OnMesoTabTouch(tabIdx) else self:OnCubeTabTouch(tabIdx) end

		log("[Cube] RefreshCubeContent tab=" .. tostring(tabIdx) .. " grade=" .. tostring(grade))
	end

	-- ─── 큐브 리셋: 그리드 채우기 ────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void UpdateCubeGrid(integer tabIdx)
		-- 소비 인벤에서 해당 탭 큐브를 탐색해 그리드 슬롯에 배치
		local contentName = tabIdx == 4 and "PotentialContent" or "AdditionalContent"
		local gridPath = self.pathContent .. "/" .. contentName .. "/CubePanel/CubeGrid"
		local previousSlots = tabIdx == 4 and self._T.potCubeSlots or self._T.addCubeSlots
		local previousIndex = tabIdx == 4 and self.potSelectedSlot or self.addSelectedSlot
		local previous = previousSlots and previousSlots[previousIndex] or nil

		local validRUIDs = {}
		if tabIdx == 4 then
			validRUIDs["b2300eda46f3445e9b1c6e774a2ee95a"] = true
			validRUIDs["b8f0af90c30b462f859f45bdc1878d8b"] = true
		else
			validRUIDs["af5404f4c8fc4ec78ccc1a57446f69db"] = true
			validRUIDs["9c2a12b9a92f44d4b6dd95c7fb182ac9"] = true
		end

		local consumeData = _UIEquipInventoryManager._T.tabData["consume"] or {}
		local slotFill = {}
		local gridIdx  = 0

		for consumeSlot = 1, 128 do
			local cs = consumeData[consumeSlot] or ""
			if cs ~= "" then
				local ruid  = _UIEquipInventoryManager:ParseInvenRUID(cs)
				local count = _UIEquipInventoryManager:ParseCount(cs)
				if validRUIDs[ruid] and count > 0 then
					gridIdx = gridIdx + 1
					if gridIdx <= 18 then
						slotFill[gridIdx] = { consumeSlot=consumeSlot, ruid=ruid, count=count }
					end
				end
			end
		end

		if tabIdx == 4 then self._T.potCubeSlots = slotFill
		else self._T.addCubeSlots = slotFill end

		-- 기존 선택 유지: 선택된 큐브가 소진된 경우에만 해제
		local newSel = 0
		if previous then
			for i, entry in ipairs(slotFill) do
				if entry.consumeSlot == previous.consumeSlot and entry.ruid == previous.ruid then newSel = i break end
			end
		end
		if tabIdx == 4 then self.potSelectedSlot = newSel
		else self.addSelectedSlot = newSel end

		for i = 1, 18 do
			local slotPath = gridPath .. "/CubeSlot" .. tostring(i)
			local iconEnt  = _EntityService:GetEntityByPath(slotPath .. "/SlotIcon")
			local countEnt = _EntityService:GetEntityByPath(slotPath .. "/CountText")
			self:SetEnhanceItemSelection(slotPath, i == newSel and slotFill[i] ~= nil)
			if slotFill[i] then
				if isvalid(iconEnt) then
					iconEnt.SpriteGUIRendererComponent.ImageRUID = "thumbnail://" .. slotFill[i].ruid
					iconEnt.SpriteGUIRendererComponent.Color = Color(1,1,1,1)
				end
				if isvalid(countEnt) then
					countEnt.TextComponent.Text = tostring(slotFill[i].count)
				end
			else
				if isvalid(iconEnt) then
					iconEnt.SpriteGUIRendererComponent.ImageRUID = ""
					iconEnt.SpriteGUIRendererComponent.Color = Color(1,1,1,0)
				end
				if isvalid(countEnt) then countEnt.TextComponent.Text = "" end
			end
		end
		log("[Cube] UpdateCubeGrid tab=" .. tostring(tabIdx) .. " found=" .. tostring(gridIdx))
	end

	-- ─── 큐브 리셋: 슬롯 클릭 ────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void OnCubeSlotTouch(integer tabIdx, integer slotIdx)
		-- A pending result may be rerolled with another cube; confirmation locks payment.
		if _StarforcePresentation.busy or self:IsConfirmDialogOpen() then return end
		if self:RequireCubeChoice() then return end
		local isDisabled = (tabIdx == 4 and self._T.tabPotDisabled) or (tabIdx == 5 and self._T.tabAddDisabled)
		if isDisabled then
			self:ShowPotentialNotGrantedDialog(tabIdx)
			return
		end
		local cubeSlots = (tabIdx == 4) and self._T.potCubeSlots or self._T.addCubeSlots
		if not cubeSlots or not cubeSlots[slotIdx] then
			log("[Cube] 빈 슬롯: " .. tostring(slotIdx))
			return
		end

		if tabIdx == 4 then self.potSelectedSlot = slotIdx
		else self.addSelectedSlot = slotIdx end

		local contentName = tabIdx == 4 and "PotentialContent" or "AdditionalContent"
		local gridPath = self.pathContent .. "/" .. contentName .. "/CubePanel/CubeGrid"

		for i = 1, 18 do
			self:SetEnhanceItemSelection(gridPath .. "/CubeSlot" .. tostring(i), i == slotIdx)
		end
		log("[Cube] 슬롯 선택 tab=" .. tostring(tabIdx) .. " slot=" .. tostring(slotIdx))
	end

	@ExecSpace("ClientOnly")
	method void SetEnhanceItemSelection(string slotPath, boolean selected)
		-- A light backing, bright frame and explicit label stay legible on dark panels.
		local bg = _EntityService:GetEntityByPath(slotPath .. "/SlotBG")
		if isvalid(bg) then
			bg.SpriteGUIRendererComponent.ImageRUID = DataRef(selected and "2860136c06ab075439721c027de365af" or "9e8f2d33d640491484ba6d1941f45c3e")
			bg.SpriteGUIRendererComponent.Type = selected and ImageType.Sliced or ImageType.Simple
			bg.SpriteGUIRendererComponent.Color = selected and Color(0.76, 0.89, 1, 1) or Color.white
		end
		local marker = _EntityService:GetEntityByPath(slotPath .. "/Selection")
		if isvalid(marker) then marker.Enable = selected end
		local count = _EntityService:GetEntityByPath(slotPath .. "/CountText")
		if isvalid(count) then count.TextComponent.FontColor = selected and Color(0.10, 0.16, 0.23, 1) or Color.white end
	end

	-- ─── 큐브 리셋: 메소/큐브 탭 전환 ───────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void OnMesoTabTouch(integer tabIdx)
		-- 비교 중에도 같은 탭의 재화를 바꿀 수 있지만 확인 중에는 고정한다.
		if self:IsConfirmDialogOpen() then return end
		if self:RequireCubeChoice() then return end
		local cPath = self.pathContent .. "/" .. (tabIdx == 4 and "PotentialContent" or "AdditionalContent")
		local mesoPanel = _EntityService:GetEntityByPath(cPath .. "/MesoPanel")
		local cubePanel = _EntityService:GetEntityByPath(cPath .. "/CubePanel")
		if isvalid(mesoPanel) then mesoPanel.Enable = true  end
		if isvalid(cubePanel) then cubePanel.Enable = false end

		local mesoBG = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/MesoTabBG")
		local cubeBG = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/CubeTabBG")
		if isvalid(mesoBG) then mesoBG.SpriteGUIRendererComponent.Color = Color(0.28, 0.31, 0.20, 1) end
		if isvalid(cubeBG) then cubeBG.SpriteGUIRendererComponent.Color = Color(0.17, 0.18, 0.20, 1) end

		local mesoTxt = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/MesoTabBtn/MesoTabText")
		local cubeTxt = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/CubeTabBtn/CubeTabText")
		if isvalid(mesoTxt) then mesoTxt.TextComponent.FontColor = Color(0.82,0.96,0.31,1) end
		if isvalid(cubeTxt) then cubeTxt.TextComponent.FontColor = Color(0.50, 0.56, 0.62, 1) end

		-- (버그 수정) 사용 재화 비용 표시 - MesoCostText가 어디서도 채워지지 않아 "- 메소"로 남던 것.
		local costTxt = _EntityService:GetEntityByPath(cPath .. "/MesoPanel/MesoCostText")
		if isvalid(costTxt) then
			local cost = (tabIdx == 4) and self:GetBalancePrice("reset_potential", 100000) or self:GetBalancePrice("reset_additional", 150000)
			costTxt.TextComponent.Text = self:FormatMesoComma(cost) .. " 메소"
		end

		if tabIdx == 4 then self.potCurrencyTab = 1 else self.addCurrencyTab = 1 end
	end

	-- 1000 단위 콤마 표기 (예: 100000 → "100,000")
	@ExecSpace("ClientOnly")
	method string FormatMesoComma(number amount)
		local s = tostring(math.floor(amount))
		local out = ""
		local len = string.len(s)
		for i = 1, len do
			out = out .. string.sub(s, i, i)
			local remain = len - i
			if remain > 0 and remain % 3 == 0 then out = out .. "," end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void OnCubeTabTouch(integer tabIdx)
		-- 비교 중에도 같은 탭의 재화를 바꿀 수 있지만 확인 중에는 고정한다.
		if self:IsConfirmDialogOpen() then return end
		if self:RequireCubeChoice() then return end
		local cPath = self.pathContent .. "/" .. (tabIdx == 4 and "PotentialContent" or "AdditionalContent")
		local mesoPanel = _EntityService:GetEntityByPath(cPath .. "/MesoPanel")
		local cubePanel = _EntityService:GetEntityByPath(cPath .. "/CubePanel")
		if isvalid(mesoPanel) then mesoPanel.Enable = false end
		if isvalid(cubePanel) then cubePanel.Enable = true  end

		local mesoBG = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/MesoTabBG")
		local cubeBG = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/CubeTabBG")
		if isvalid(mesoBG) then mesoBG.SpriteGUIRendererComponent.Color = Color(0.17, 0.18, 0.20, 1) end
		if isvalid(cubeBG) then cubeBG.SpriteGUIRendererComponent.Color = Color(0.28, 0.31, 0.20, 1) end

		local mesoTxt = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/MesoTabBtn/MesoTabText")
		local cubeTxt = _EntityService:GetEntityByPath(cPath .. "/CurrencyTabRow/CubeTabBtn/CubeTabText")
		if isvalid(mesoTxt) then mesoTxt.TextComponent.FontColor = Color(0.50, 0.56, 0.62, 1) end
		if isvalid(cubeTxt) then cubeTxt.TextComponent.FontColor = Color(0.82,0.96,0.31,1) end

		if tabIdx == 4 then self.potCurrencyTab = 0 else self.addCurrencyTab = 0 end
	end

	-- ─── 큐브 결과 비교/선택 ────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void ClearPendingCubeChoice()
		-- 비교 카드만 닫고 기존 등급/옵션 영역과 재설정 버튼을 복구한다.
		self:StopCubeResultFlash()
		self._T.pendingCubeTab = 0
		self._T.pendingCubeOldItem = ""
		self._T.pendingCubeNewItem = ""
		self._T.pendingCubeGradeUp = false
		self._T.pendingCubeGradeCommitted = false
		self._T.pendingCubeChoice = ""
		self._T.confirmMode = ""
		for _, name in ipairs({"PotentialContent", "AdditionalContent"}) do
			local panel = _EntityService:GetEntityByPath(self.pathContent .. "/" .. name .. "/ComparePanel")
			if isvalid(panel) then panel.Enable = false end
			local info = _EntityService:GetEntityByPath(self.pathContent .. "/" .. name .. "/ItemInfoPanel")
			if isvalid(info) then info.Enable = self.enhanceTargetRUID ~= "" end
			local reset = _EntityService:GetEntityByPath(self.pathContent .. "/" .. name .. "/ResetBtnBG")
			if isvalid(reset) then
				reset.Enable = true
				reset.SpriteGUIRendererComponent.Color = Color.white
				if isvalid(reset.CanvasGroupComponent) then reset.CanvasGroupComponent.Interactable = true end
			end
			local label = _EntityService:GetEntityByPath(self.pathContent .. "/" .. name .. "/ResetBtnBG/ResetBtnText")
			if isvalid(label) then label.TextComponent.Text = "재설정하기" end
		end
	end

	@ExecSpace("ClientOnly")
	method Color GetCubeGradeColor(integer grade)
		-- Bright grade text on neutral dark surfaces, shared by both potential tabs.
		if grade == 2 then return Color(0.79, 0.59, 1, 1) end
		if grade == 3 then return Color(1, 0.88, 0.30, 1) end
		if grade == 4 then return Color(0.70, 0.96, 0.38, 1) end
		return Color(0.48, 0.83, 1, 1)
	end

	@ExecSpace("ClientOnly")
	method boolean CommitPendingCubeGradeUp()
		-- Grade-ups are mandatory: include the new result in the same save as its payment.
		-- The comparison remains open until acknowledged, but quitting cannot restore the old grade.
		if (self._T.pendingCubeTab or 0) == 0 or not self._T.pendingCubeGradeUp then return false end
		if self._T.pendingCubeGradeCommitted then return true end
		if self:ReadCurrentTarget() ~= self._T.pendingCubeOldItem then return false end
		local selected = self._T.pendingCubeNewItem
		if selected == "" then return false end
		self.enhanceTargetItemStr = selected
		if self.enhanceTargetEquipSlot > 0 then
			_UIEquipInventoryManager:SetEquipStr(self.enhanceTargetEquipSlot, selected)
		else
			local srcTab = self.enhanceTargetSrcTab ~= "" and self.enhanceTargetSrcTab or "equip"
			_UIEquipInventoryManager._T.tabData[srcTab][self.enhanceTargetInvenIdx] = selected
		end
		self._T.pendingCubeGradeCommitted = true
		log("[Cube] grade-up committed before save; acknowledgement required tab=" .. tostring(self._T.pendingCubeTab))
		return true
	end

	@ExecSpace("ClientOnly")
	method void ShowCubeCompare(integer tabIdx, string oldItem, string newItem, boolean gradeUp)
		-- 별도 창 대신 현재 탭의 등급/옵션 카드 자리에서 이전/새 결과를 보여준다.
		self._T.pendingCubeTab = tabIdx
		self._T.pendingCubeOldItem = oldItem
		self._T.pendingCubeNewItem = newItem
		self._T.pendingCubeGradeUp = gradeUp
		self._T.pendingCubeGradeCommitted = false
		self._T.pendingCubeChoice = ""
		local content = (tabIdx == 4) and "PotentialContent" or "AdditionalContent"
		local root = self.pathContent .. "/" .. content .. "/ComparePanel"
		local panel = _EntityService:GetEntityByPath(root)
		if not isvalid(panel) then return end
		local function parseItem(s)
			local f = {}
			local pos = 1
			while true do
				local j, _ = string.find(s, "|", pos, true)
				if j then f[#f+1] = string.sub(s, pos, j-1); pos = j+1
				else f[#f+1] = string.sub(s, pos); break end
			end
			while #f < 16 do f[#f+1] = "" end
			return f
		end
		local oldF = parseItem(oldItem)
		local newF = parseItem(newItem)
		-- Compare the same equipment in the same slot without writing either preview.
		local slot = self.enhanceTargetEquipSlot > 0 and self.enhanceTargetEquipSlot or (tonumber(oldF[3]) or 0)
		local powerText = _EntityService:GetEntityByPath(root .. "/PowerDelta")
		if isvalid(powerText) then
			local delta = self:GetCubeCombatPowerDelta(slot, oldItem, newItem)
			local sign = delta > 0 and "+" or (delta < 0 and "-" or "")
			powerText.TextGUIRendererComponent.Text = "새 옵션 전투력 " .. sign .. _UIEquipInventoryManager:FormatKoreanNumber(math.abs(delta))
			powerText.TextGUIRendererComponent.FontColor = delta > 0 and Color(1,0.88,0.30,1) or (delta < 0 and Color(1,0.66,0.63,1) or Color(0.78,0.93,1,1))
			log("[Cube] combat power preview tab=" .. tostring(tabIdx) .. " delta=" .. tostring(delta))
		end
		local gradeIdx = (tabIdx == 4) and 9 or 13
		local optIdx = (tabIdx == 4) and 10 or 14
		local gradeNames = {"레어", "에픽", "유니크", "레전드리"}
		for _, info in ipairs({{"Current", oldF}, {"New", newF}}) do
			local side = info[1]
			local fields = info[2]
			local grade = tonumber(fields[gradeIdx]) or 1
			if grade < 1 then grade = 1 elseif grade > 4 then grade = 4 end
			local gradeEnt = _EntityService:GetEntityByPath(root .. "/" .. side .. "Card/Grade")
			if isvalid(gradeEnt) then
				gradeEnt.TextGUIRendererComponent.Text = gradeNames[grade]
				gradeEnt.TextGUIRendererComponent.FontColor = self:GetCubeGradeColor(grade)
			end
			for i = 1, 3 do
				local optEnt = _EntityService:GetEntityByPath(root .. "/" .. side .. "Card/Opt" .. tostring(i))
				if isvalid(optEnt) then optEnt.TextGUIRendererComponent.Text = fields[optIdx + i - 1] or "-" end
			end
		end
		local currentCard = _EntityService:GetEntityByPath(root .. "/CurrentCard")
		if isvalid(currentCard) then
			currentCard.SpriteGUIRendererComponent.Color = gradeUp and Color(0.68,0.70,0.74,1) or Color(1,1,1,1)
			if isvalid(currentCard.CanvasGroupComponent) then currentCard.CanvasGroupComponent.Interactable = not gradeUp end
		end
		local currentTitle = _EntityService:GetEntityByPath(root .. "/CurrentCard/Title")
		if isvalid(currentTitle) then currentTitle.TextGUIRendererComponent.Text = gradeUp and "현재 옵션 · 선택 불가" or "현재 옵션" end
		local hint = _EntityService:GetEntityByPath(root .. "/Hint")
		if isvalid(hint) then
			hint.TextGUIRendererComponent.Text = gradeUp and "등급 상승! 새 옵션 선택 필수" or "선택 전 현재 옵션 유지"
			hint.TextGUIRendererComponent.FontColor = gradeUp and Color(1,0.88,0.30,1) or Color(0.78,0.91,1,1)
		end
		panel.Enable = true
		local infoPanel = _EntityService:GetEntityByPath(self.pathContent .. "/" .. content .. "/ItemInfoPanel")
		if isvalid(infoPanel) then infoPanel.Enable = false end
		local reset = _EntityService:GetEntityByPath(self.pathContent .. "/" .. content .. "/ResetBtnBG")
		if isvalid(reset) then
			reset.Enable = true
			reset.SpriteGUIRendererComponent.Color = gradeUp and Color(0.48,0.50,0.54,1) or Color.white
			if isvalid(reset.CanvasGroupComponent) then reset.CanvasGroupComponent.Interactable = not gradeUp end
		end
		local label = _EntityService:GetEntityByPath(self.pathContent .. "/" .. content .. "/ResetBtnBG/ResetBtnText")
		if isvalid(label) then label.TextComponent.Text = gradeUp and "새 옵션을 먼저 선택해주세요" or "다시 재설정하기" end
		self:UpdateCubeGrid(tabIdx)
		log("[UIRepair] inline cube comparison tab=" .. tostring(tabIdx) .. " gradeUp=" .. tostring(gradeUp))
	end

	@ExecSpace("ClientOnly")
	method void OnCubeCompareChoice(integer tabIdx, boolean chooseNew)
		-- 카드 선택을 같은 영역에서 바로 확정한다. 별도 확인 팝업을 열지 않는다.
		if _StarforcePresentation.busy or self:IsConfirmDialogOpen() then return end
		if self._T.pendingCubeTab ~= tabIdx or self._T.pendingCubeNewItem == "" then return end
		if not chooseNew and self._T.pendingCubeGradeUp then
			return
		end
		self._T.pendingCubeChoice = chooseNew and "new" or "current"
		self:ApplyPendingCubeChoice()
	end

	@ExecSpace("ClientOnly")
	method void ApplyPendingCubeChoice()
		-- Commit the chosen result exactly once, never over a moved/replaced item.
		local tabIdx = self._T.pendingCubeTab
		if tabIdx == 0 or self._T.pendingCubeChoice == "" then return end
		if self._T.pendingCubeChoice ~= "new" and self._T.pendingCubeChoice ~= "current" then return end
		if self._T.pendingCubeGradeUp and self._T.pendingCubeChoice ~= "new" then return end
		if self._T.pendingCubeGradeCommitted then
			-- The result was already saved with its payment. Acknowledge only, without writing
			-- the old slot again if the player has since moved/equipped the upgraded item.
			self:ClearPendingCubeChoice()
            _CharacterPersistence:MarkDirty("enhance_cube_choice")
            _CharacterPersistence:FlushToServer()
			if self:CheckCurrentTarget() then self:RefreshCubeContent(tabIdx) end
			log("[Cube] saved grade-up acknowledged tab=" .. tostring(tabIdx))
			return
		end
		if self:ReadCurrentTarget() ~= self._T.pendingCubeOldItem then
			self:AppendLog("장비 상태가 변경되어 옵션을 적용할 수 없습니다. 원래 장비 위치를 확인해주세요.")
			return
		end
		local selected = (self._T.pendingCubeChoice == "new") and self._T.pendingCubeNewItem or self._T.pendingCubeOldItem
		self.enhanceTargetItemStr = selected
		if self.enhanceTargetEquipSlot > 0 then
			_UIEquipInventoryManager:SetEquipStr(self.enhanceTargetEquipSlot, selected)
		else
			local srcTab = self.enhanceTargetSrcTab
			if srcTab == "" then srcTab = "equip" end
			_UIEquipInventoryManager._T.tabData[srcTab][self.enhanceTargetInvenIdx] = selected
		end
		_UIEquipInventoryManager:RefreshUI()
		self:ClearPendingCubeChoice()
        _CharacterPersistence:MarkDirty("enhance_cube_choice")
        _CharacterPersistence:FlushToServer()
		self:RefreshCubeContent(tabIdx)
		log("[Cube] 옵션 선택 적용 tab=" .. tostring(tabIdx))
	end

	-- ─── 큐브 리셋: 재설정 실행 ─────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method number GetCubeCombatPowerDelta(integer slot, string oldItem, string newItem)
		-- Hypothetical equipment previews must not alter the live attack-speed cache.
		if slot < 1 or slot > 25 then return 0 end
		local savedAttackSpeed = _CharInfoManager._T.lastItemAtkSpdPct
		local before = _CharInfoManager:CalcCombatPowerSwap(slot, oldItem)
		local after = _CharInfoManager:CalcCombatPowerSwap(slot, newItem)
		_CharInfoManager._T.lastItemAtkSpdPct = savedAttackSpeed
		return after - before
	end

	@ExecSpace("ClientOnly")
	method void StopCubeResultFlash()
		-- End the one-shot overlay without leaving an invisible input blocker.
		local flash = self._T.cubeFlash
		if isvalid(flash) then
			flash.CanvasGroupComponent.GroupAlpha = 0
			log("[Cube] new-option flash finished peak=" .. tostring(self._T.cubeFlashPeak or 0))
		end
		self._T.cubeFlash = nil
		self._T.cubeFlashElapsed = 0
	end

	@ExecSpace("ClientOnly")
	method void PlayCubeResultFeedback(integer tabIdx)
		-- Only a newly paid result plays the shared Starforce success SFX and one flash.
		self:StopCubeResultFlash()
		local content = tabIdx == 4 and "PotentialContent" or "AdditionalContent"
		local flash = _EntityService:GetEntityByPath(self.pathContent .. "/" .. content .. "/ComparePanel/NewCard/ResultFlash")
		if isvalid(flash) then
			flash.Enable = true
			flash.CanvasGroupComponent.GroupAlpha = 0
			self._T.cubeFlash = flash
			self._T.cubeFlashElapsed = 0
			self._T.cubeFlashPeak = 0
			log("[Cube] new-option flash started tab=" .. tostring(tabIdx))
		end
		_StarforcePresentation:PlaySuccessSound()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
        if self._T.restoreCubeReady and _LoginFlow.phase == "ingame" then
            self._T.restoreCubeReady = nil
            self:ShowPendingCubeWindow()
        end
		-- A single quick rise and smooth fade; no blinking loop or delayed timer.
		self:UpdateAmbientSparkles(delta)
		local flash = self._T.cubeFlash
		if not isvalid(flash) then return end
		if not flash.EnabledInHierarchy then self:StopCubeResultFlash() return end
		self._T.cubeFlashElapsed += delta
		local t = self._T.cubeFlashElapsed
		if t >= 0.4 then self:StopCubeResultFlash() return end
		local intensity = t < 0.07 and (t / 0.07) or (1 - (t - 0.07) / 0.33)
		flash.CanvasGroupComponent.GroupAlpha = 0.38 * intensity * intensity * (3 - 2 * intensity)
		self._T.cubeFlashPeak = math.max(self._T.cubeFlashPeak or 0, flash.CanvasGroupComponent.GroupAlpha)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
        if self._T.focusTimer then _TimerService:ClearTimer(self._T.focusTimer) end
		-- Clear presentation references at session teardown.
		self:StopCubeResultFlash()
		self._T.ambientSparkles = nil
	end

	@ExecSpace("ClientOnly")
	method void InitAmbientSparkles()
		-- Reuse three quiet, non-interactive glints around the registration slot.
		self._T.ambientSparkles = {}
		local base = "/ui/DefaultGroup/EnhanceWindow/RightPanel/SlotArea/SlotSectionBG/AmbientSpark"
		for i = 0, 2 do
			local e = _EntityService:GetEntityByPath(base .. tostring(i))
			if isvalid(e) then
				e.SpriteGUIRendererComponent.Color = Color(0.82, 0.96, 1, 0)
				table.insert(self._T.ambientSparkles, {entity = e, age = -0.2 - i * 0.55, duration = 0})
			end
		end
		log("[EnhanceUI] ambient glints ready: " .. tostring(#self._T.ambientSparkles))
	end

	@ExecSpace("ClientOnly")
	method void UpdateAmbientSparkles(number delta)
		-- Randomize only while invisible; smoothly fade each glint near the item.
		for _, rec in ipairs(self._T.ambientSparkles or {}) do
			local e = rec.entity
			if not isvalid(e) or not e.EnabledInHierarchy then continue end
			rec.age += delta
			if rec.age < 0 then continue end
			if rec.duration == 0 then
				local side = _UtilLogic:RandomDouble() < 0.5 and -1 or 1
				e.UITransformComponent.anchoredPosition = Vector2(side * (65 + 150 * _UtilLogic:RandomDouble()), 4 + 66 * _UtilLogic:RandomDouble())
				local width = 40 + 12 * _UtilLogic:RandomDouble()
				e.UITransformComponent.RectSize = Vector2(width, width * 1.93)
				e.SpriteGUIRendererComponent.PlayRate = 0.35 + 0.15 * _UtilLogic:RandomDouble()
				rec.duration = 1.2 + 0.8 * _UtilLogic:RandomDouble()
				rec.peak = 0.45 + 0.2 * _UtilLogic:RandomDouble()
				rec.age = 0
			end
			local t = math.min(1, rec.age / rec.duration)
			local fade = math.sin(math.pi * t)
			e.SpriteGUIRendererComponent.Color = Color(0.82, 0.96, 1, rec.peak * fade * fade)
			if t >= 1 then
				e.SpriteGUIRendererComponent.Color = Color(0.82, 0.96, 1, 0)
				rec.age = -0.2 - 0.6 * _UtilLogic:RandomDouble()
				rec.duration = 0
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnResetBtnTouch(integer tabIdx)
		-- Button and Space both open a confirmation; opening/cancelling never spends.
		if _StarforcePresentation.busy or self:IsConfirmDialogOpen() then return end
		if self:RequireCubeChoice() then return end
		local request = self:PrepareCubeUse(tabIdx)
		if request == nil then return end
		local dlg = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog")
		local txt = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow/RightPanel/ConfirmDialog/DlgText")
		if not isvalid(dlg) or not isvalid(txt) then
			self:AppendLog("사용 확인창을 열 수 없습니다. 창을 다시 열어주세요.")
			return
		end
		local payment = request.usingMeso and (self:FormatMesoComma(request.mesoCost) .. " 메소") or (request.cubeName .. " 1개")
		local hint = (self._T.pendingCubeTab or 0) ~= 0 and "현재 옵션은 유지되고, 새 옵션만 다시 생성됩니다." or "새 옵션을 선택하기 전까지 현재 옵션이 유지됩니다."
		txt.TextComponent.Text = payment .. "를 사용하여\n" .. (tabIdx == 4 and "잠재능력" or "에디셔널 잠재능력") .. "을 재설정하시겠습니까?\n\n" .. hint
		self._T.cubeUseRequest = request
		self._T.confirmMode = "cube_use"
		self._T.confirmInfoOnly = false
		self._T.pendingRebuySlot = nil
		self._T.confirmOpenedAt = _UtilLogic.ElapsedSeconds
		dlg.Enable = true
		log("[Cube] use confirmation opened tab=" .. tostring(tabIdx) .. " payment=" .. payment)
	end

	@ExecSpace("ClientOnly")
	method table PrepareCubeUse(integer tabIdx)
		if _CashShopManager:IsHalfEarring(self:ReadCurrentTarget()) then
			self:AppendLog("하프 이어링은 잠재능력과 에디셔널 잠재능력을 재설정할 수 없습니다.")
			return nil
		end
		-- Validate live equipment and payment for both opening and accepting a request.
		if _StarforcePresentation.busy then return nil end
		if (self._T.pendingCubeTab or 0) ~= 0 and self._T.pendingCubeGradeUp then
			self:AppendLog("등급이 상승했습니다. 새 옵션을 선택한 뒤 다시 재설정할 수 있습니다.")
			log("[Cube] reroll blocked: grade-up acknowledgement required")
			return nil
		end
		if (self._T.pendingCubeTab or 0) ~= 0 and self._T.pendingCubeTab ~= tabIdx then return nil end
		if (tabIdx ~= 4 and tabIdx ~= 5) or self.currentTab ~= tabIdx or not self:IsWindowOpen() then return nil end
		if not self:CheckCurrentTarget() then return nil end
		local isDisabled = (tabIdx == 4 and self._T.tabPotDisabled) or (tabIdx == 5 and self._T.tabAddDisabled)
		if isDisabled then
			self:ShowPotentialNotGrantedDialog(tabIdx)
			return nil
		end
		-- (Phase 3) 재화 탭 분기: 메소 탭이면 큐브 없이 메소로 재설정한다 (잠재 10만/에디 15만,
		-- 확률은 레드큐브/에디셔널큐브와 동일). 큐브 탭이면 기존 큐브 소모 방식.
		local currTab = (tabIdx == 4) and self.potCurrencyTab or self.addCurrencyTab
		local usingMeso = (currTab == 1)
		local cubeRUID = ""
		local consumeIdx = 0
		local mesoCost = 0
		local cubeName = ""
		if usingMeso then
			mesoCost = (tabIdx == 4) and self:GetBalancePrice("reset_potential", 100000) or self:GetBalancePrice("reset_additional", 150000)
			if _UIEquipInventoryManager.meso < mesoCost then
				self:AppendLog("메소가 부족합니다. " .. self:FormatMesoComma(mesoCost) .. " 메소가 필요합니다.")
				return nil
			end
			cubeRUID = (tabIdx == 4) and "b2300eda46f3445e9b1c6e774a2ee95a" or "af5404f4c8fc4ec78ccc1a57446f69db"
		else
			local selectedSlot = (tabIdx == 4) and self.potSelectedSlot or self.addSelectedSlot
			if selectedSlot == 0 then
				self:AppendLog("사용할 큐브를 먼저 선택하세요.")
				return nil
			end

			local cubeSlots = (tabIdx == 4) and self._T.potCubeSlots or self._T.addCubeSlots
			if not cubeSlots or not cubeSlots[selectedSlot] then
				log("[Cube] 슬롯 데이터 없음")
				return nil
			end

			local cubeInfo = cubeSlots[selectedSlot]
			cubeRUID   = cubeInfo.ruid
			consumeIdx = cubeInfo.consumeSlot
			local live = _UIEquipInventoryManager:GetTabItem("consume", consumeIdx)
			if live == "" or _UIEquipInventoryManager:ParseInvenRUID(live) ~= cubeRUID or _UIEquipInventoryManager:ParseCount(live) <= 0 then
				self:AppendLog("선택한 큐브가 없거나 위치가 변경되었습니다. 다시 선택하세요.")
				self:UpdateCubeGrid(tabIdx)
				return nil
			end
			cubeName = _UIEquipInventoryManager:ParseName(live)
		end

		local s = self.enhanceTargetItemStr
		if s == "" then return nil end
		if (self._T.pendingCubeTab or 0) ~= 0 and self._T.pendingCubeOldItem ~= s then
			self:AppendLog("장비 상태가 변경되었습니다. 기존 결과를 확인해주세요.")
			return nil
		end
		local content = tabIdx == 4 and "PotentialContent" or "AdditionalContent"
		if not isvalid(_EntityService:GetEntityByPath(self.pathContent .. "/" .. content .. "/ComparePanel")) then
			self:AppendLog("옵션 비교창을 준비하지 못해 사용을 취소했습니다.")
			return nil
		end
		return { tab=tabIdx, item=s, equipSlot=self.enhanceTargetEquipSlot, srcTab=self.enhanceTargetSrcTab,
			itemSlot=self.enhanceTargetInvenIdx, usingMeso=usingMeso, cubeRUID=cubeRUID,
			consumeIdx=consumeIdx, mesoCost=mesoCost, cubeName=cubeName }
	end

	@ExecSpace("ClientOnly")
	method void ExecuteCubeUse(table request)
		-- Only an accepted, unchanged request may roll options and consume one payment.
		if request == nil then return end
		local live = self:PrepareCubeUse(request.tab)
		if live == nil then return end
		for _, key in ipairs({"tab", "item", "equipSlot", "srcTab", "itemSlot", "usingMeso", "cubeRUID", "consumeIdx", "mesoCost"}) do
			if live[key] ~= request[key] then
				self:AppendLog("장비 또는 사용 재화가 변경되었습니다. 다시 확인해주세요.")
				log("[Cube] stale confirmation rejected key=" .. key)
				return
			end
		end
		local nowGate = _UtilLogic.ElapsedSeconds
		if nowGate - (self._T.lastEnhanceGateAt or -99) < 0.25 then return end
		self._T.lastEnhanceGateAt = nowGate
		local tabIdx = request.tab
		local s = request.item
		local usingMeso = request.usingMeso
		local mesoCost = request.mesoCost
		local cubeRUID = request.cubeRUID
		local consumeIdx = request.consumeIdx

		-- 파이프 필드 파싱
		local fields = {}
		local pos = 1
		while true do
			local j, _ = string.find(s, "|", pos, true)
			if j then fields[#fields+1] = string.sub(s, pos, j-1); pos = j+1
			else fields[#fields+1] = string.sub(s, pos); break end
		end
		while #fields < 16 do fields[#fields+1] = "" end

		local gradeIdx = tabIdx == 4 and 9  or 13
		local opt1Idx  = tabIdx == 4 and 10 or 14
		local opt2Idx  = tabIdx == 4 and 11 or 15
		local opt3Idx  = tabIdx == 4 and 12 or 16

		local curGrade = tonumber(fields[gradeIdx]) or 1
		if curGrade < 1 then curGrade = 1 end
		if curGrade > 4 then curGrade = 4 end

		-- 등급 업그레이드 판정 (레전드리는 업그레이드 불가)
		local newGrade = curGrade
		if curGrade < 4 then
			if _UtilLogic:RandomDouble() < self:GetGradeUpgradeProb(cubeRUID, curGrade) then
				newGrade = curGrade + 1
				log("[Cube] 등급 업: " .. tostring(curGrade) .. "→" .. tostring(newGrade))
			end
		end

		-- 장비 분류 판별 (slotIdx 3번째 필드: 6=무기, 9=장갑 - 무기/장갑은 전용 특수 옵션이 풀에 추가된다)
		local slotIdx = tonumber(fields[3]) or 0
		local equipType = _UIEquipInventoryManager:GetEquipTypeBySlot(slotIdx)

		-- 슬롯별 옵션 티어 및 텍스트 결정
		local isPot = (tabIdx == 4)
		local opt1 = self:GetRandomOption(self:RollOptionTier(cubeRUID, newGrade, 1), isPot, equipType)
		local opt2 = self:GetRandomOption(self:RollOptionTier(cubeRUID, newGrade, 2), isPot, equipType)
		local opt3 = self:GetRandomOption(self:RollOptionTier(cubeRUID, newGrade, 3), isPot, equipType)

		fields[gradeIdx] = tostring(newGrade)
		fields[opt1Idx]  = opt1
		fields[opt2Idx]  = opt2
		fields[opt3Idx]  = opt3

		local newItemStr = table.concat(fields, "|")
		-- Ordinary rolls keep the current item; mandatory grade-ups are committed before saving.

		-- 재화 소모: 메소 재설정이면 메소 차감, 큐브 재설정이면 큐브 1개 소비
		if usingMeso then
			_UIEquipInventoryManager:AddMeso(-mesoCost)
			self:UpdateMesoDisplay()
		else
			local cd = _UIEquipInventoryManager._T.tabData["consume"][consumeIdx] or ""
			if cd ~= "" then
				local cf = {}
				local cp = 1
				while true do
					local cj, _ = string.find(cd, "|", cp, true)
					if cj then cf[#cf+1] = string.sub(cd, cp, cj-1); cp = cj+1
					else cf[#cf+1] = string.sub(cd, cp); break end
				end
				while #cf < 7 do cf[#cf+1] = "0" end
				local cnt = (tonumber(cf[7]) or 0) - 1
				if cnt <= 0 then
					_UIEquipInventoryManager._T.tabData["consume"][consumeIdx] = ""
				else
					cf[7] = tostring(cnt)
					_UIEquipInventoryManager._T.tabData["consume"][consumeIdx] = table.concat(cf, "|")
				end
			end
		end

		self:ShowCubeCompare(tabIdx, s, newItemStr, newGrade > curGrade)
		if newGrade > curGrade then self:CommitPendingCubeGradeUp() end
		self:PlayCubeResultFeedback(tabIdx)
		_UIEquipInventoryManager:RefreshUI()
		_CharacterPersistence:MarkDirty("enhance_cube_use")
        _CharacterPersistence:FlushToServer()
		log("[Cube] 리셋 결과 생성 (" .. (usingMeso and ("메소 " .. tostring(mesoCost)) or "큐브") .. ") grade=" .. tostring(newGrade) .. " " .. opt1 .. " / " .. opt2 .. " / " .. opt3)
	end

	-- ─── 큐브 리셋: 확률 테이블 ─────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method number GetGradeUpgradeProb(string cubeRUID, integer fromGrade)
		-- fromGrade: 1=레어, 2=에픽, 3=유니크 → 업그레이드 확률 반환
		if cubeRUID == "b2300eda46f3445e9b1c6e774a2ee95a" then
			if fromGrade == 1 then return 0.060
			elseif fromGrade == 2 then return 0.018
			else return 0.003 end
		elseif cubeRUID == "b8f0af90c30b462f859f45bdc1878d8b" then
			if fromGrade == 1 then return 0.150
			elseif fromGrade == 2 then return 0.035
			else return 0.014 end
		elseif cubeRUID == "af5404f4c8fc4ec78ccc1a57446f69db" then
			if fromGrade == 1 then return 0.023810
			elseif fromGrade == 2 then return 0.009804
			else return 0.007 end
		elseif cubeRUID == "9c2a12b9a92f44d4b6dd95c7fb182ac9" then
			if fromGrade == 1 then return 0.047619
			elseif fromGrade == 2 then return 0.019608
			else return 0.007 end
		end
		return 0.0
	end

	@ExecSpace("ClientOnly")
	method integer RollOptionTier(string cubeRUID, integer currentGrade, integer slotPos)
		-- 슬롯 위치와 큐브 종류에 따른 옵션 등급 결정
		if currentGrade <= 1 then return 1 end

		local roll = _UtilLogic:RandomDouble()
		local isEdi = (cubeRUID == "af5404f4c8fc4ec78ccc1a57446f69db" or cubeRUID == "9c2a12b9a92f44d4b6dd95c7fb182ac9")
		local isBlack = (cubeRUID == "b8f0af90c30b462f859f45bdc1878d8b")

		if slotPos == 1 then
			-- 1번 슬롯은 항상 현재 등급
			return currentGrade
		end

		if isEdi then
			-- 에디셔널 계열: slot2/3 같은 확률
			if currentGrade == 2 then return (roll < 0.047619)  and 2 or 1 end
			if currentGrade == 3 then return (roll < 0.019608)  and 3 or 2 end
			if currentGrade == 4 then return (roll < 0.019608)  and 4 or 3 end
		else
			-- 레드/블랙큐브
			local prob = 0.0
			if slotPos == 2 then
				if currentGrade == 2 then prob = isBlack and 0.20 or 0.10
				elseif currentGrade == 3 then prob = isBlack and 0.20 or 0.10
				else prob = isBlack and 0.20 or 0.10 end
			else
				if currentGrade == 2 then prob = isBlack and 0.05 or 0.01
				elseif currentGrade == 3 then prob = isBlack and 0.05 or 0.01
				else prob = isBlack and 0.05 or 0.01 end
			end
			return (roll < prob) and currentGrade or (currentGrade - 1)
		end
		return currentGrade - 1
	end

	@ExecSpace("ClientOnly")
	method string GetRandomOption(integer grade, boolean isPotential, string equipType)
		-- (전투력 개편 2026-08-08) 잠재/에디셔널 공용 단일 풀로 전면 교체 - 풀 정의는
		-- UIEquipInventoryManager.RollPotOption 한 곳이다(주문서 부여와 큐브 재설정이 같은 풀).
		-- grade: 1레어 / 2에픽 / 3유니크 / 4레전드리 (RollOptionTier 결과).
		-- 에디셔널(isPotential=false)은 같은 풀에서 **수치 절반**(RollAddPotOption)으로 뽑는다.
		local gradeName = _UIEquipInventoryManager:NormalizeGradeName(tostring(grade))
		if isPotential then
			return _UIEquipInventoryManager:RollPotOption(equipType, gradeName, 1)
		end
		return _UIEquipInventoryManager:RollAddPotOption(equipType, gradeName, 1)
	end

	-- ─── 로그 ─────────────────────────────────────────────────────────────
	@ExecSpace("ClientOnly")
	method void AppendLog(string msg)
		local logEnt = _EntityService:GetEntityByPath(self.pathContent .. "/StarforceContent/LogBG/EnhanceLogText")
		if not isvalid(logEnt) then return end
		local cur = logEnt.TextComponent.Text
		local newText = msg
		if cur ~= "" then newText = msg .. "\n" .. cur end
		local lines = {}
		for line in string.gmatch(newText, "[^\n]+") do
			table.insert(lines, line)
			if #lines >= 3 then break end
		end
		logEnt.TextComponent.Text = table.concat(lines, "\n")
	end

    @ExecSpace("ClientOnly")
    method boolean RequireCubeChoice()
        -- Paid results remain pending until a deliberate choice, including after reconnect.
        if (self._T.pendingCubeTab or 0) == 0 then return false end
        if _UtilLogic.ElapsedSeconds >= (self._T.cubeNoticeUntil or 0) then
            self._T.cubeNoticeUntil = _UtilLogic.ElapsedSeconds + 1
            _UIToast:ShowMessage("잠재능력을 먼저 선택해주세요. 현재 옵션 또는 새 옵션을 눌러 선택할 수 있습니다.")
            log("[Cube] other action blocked: choice required")
        end
        self:ShowPendingCubeWindow()
        return true
    end

    @ExecSpace("ClientOnly")
    method void ShowPendingCubeWindow()
        -- Reopen the existing comparison; never roll or charge again.
        local tab = self._T.pendingCubeTab or 0
        if tab == 0 then return end
        local w = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow")
        if not isvalid(w) then return end
        _EntityService:GetEntityByPath("/ui/DefaultGroup").Enable = true
        w.Enable = true
        local pos = w.UITransformComponent.anchoredPosition
        if math.abs(pos.x) > 1000 or math.abs(pos.y) > 1000 or (math.abs(pos.x) < 5 and math.abs(pos.y) < 5) then
            w.UITransformComponent.anchoredPosition = Vector2(550, 0)
        end
        self:SelectTab(tab)
        self:FocusEnhanceWindow()
    end

    @ExecSpace("ClientOnly")
    method string ExportPendingCubeChoice()
        -- Use the same snapshot as payment and inventory, with no separate storage race.
        if (self._T.pendingCubeTab or 0) == 0 then return "" end
        return table.concat({"PCUBE", "1", tostring(self._T.pendingCubeTab),
            tostring(self.enhanceTargetEquipSlot), tostring(self.enhanceTargetInvenIdx),
            self.enhanceTargetSrcTab == "" and "-" or self.enhanceTargetSrcTab,
            self._T.pendingCubeGradeUp and "1" or "0", self._T.pendingCubeGradeCommitted and "1" or "0",
            self._T.pendingCubeOldItem, self._T.pendingCubeNewItem}, "\t")
    end

    @ExecSpace("ClientOnly")
    method void RestorePendingCubeChoice(string raw)
        -- Inventory must already be restored. Clear the previous character's transient selection.
        self._T.restoreCubeReady = nil
        self:ClearPendingCubeChoice()
        self:ClearTarget()
        local line = string.match("\n" .. raw, "\n(PCUBE\t[^\n]+)")
        if line == nil then return end
        local f = _CharacterPersistence:SplitTabs(line)
        local tab = tonumber(f[3]) or 0
        if f[2] ~= "1" or (tab ~= 4 and tab ~= 5) or #f ~= 10 then
            log_warning("[Cube] invalid pending choice snapshot") return
        end
        local equipSlot, invenIdx = tonumber(f[4]) or 0, tonumber(f[5]) or 0
        local src = f[6] == "-" and "" or f[6]
        local committed = f[8] == "1"
        local expected = committed and f[10] or f[9]
        local current = ""
        if equipSlot > 0 then current = _UIEquipInventoryManager:GetEquip(equipSlot)
        elseif _UIEquipInventoryManager._T.tabData[src] ~= nil then current = _UIEquipInventoryManager._T.tabData[src][invenIdx] or "" end
        if current == "" or current ~= expected then
            log_warning("[Cube] pending choice target does not match inventory") return
        end
        self.enhanceTargetEquipSlot = equipSlot
        self.enhanceTargetInvenIdx = invenIdx
        self.enhanceTargetSrcTab = src
        self.enhanceTargetItemStr = current
        self.enhanceTargetName = _UIEquipInventoryManager:ParseName(current)
        self.enhanceTargetRUID = _UIEquipInventoryManager:ParseRUID(current)
        self.enhanceLevel = _UIEquipInventoryManager:ParseStars(current)
        self:ApplyEnhanceTargetUI()
        self:SelectTab(tab)
        self:ShowCubeCompare(tab, f[9], f[10], f[7] == "1")
        self._T.pendingCubeGradeCommitted = committed
        self._T.restoreCubeReady = true
        log("[Cube] pending choice restored tab=" .. tostring(tab))
    end

    @ExecSpace("ClientOnly")
    method void FocusEnhanceWindow()
        -- Registration can originate from a rear window; finish focus after its pointer handlers.
        local path = "/ui/DefaultGroup/EnhanceWindow"
        _UIEquipInventoryManager:BringWindowToFront(path)
        if self._T.focusTimer then _TimerService:ClearTimer(self._T.focusTimer) end
        self._T.focusTimer = _TimerService:SetTimerOnce(function()
            self._T.focusTimer = nil
            if self:IsWindowOpen() then _UIEquipInventoryManager:BringWindowToFront(path) end
        end, 0.01)
    end
end
