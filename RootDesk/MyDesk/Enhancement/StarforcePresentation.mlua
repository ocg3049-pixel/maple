@Logic
script StarforcePresentation extends Logic

	property boolean busy = false
	property integer displayedLevel = -1
	property string itemPath = "/ui/DefaultGroup/EnhanceWindow/RightPanel/SlotArea/TargetSlotBG"
	property string starPath = "/ui/DefaultGroup/EnhanceWindow/RightPanel/ContentArea/StarforceContent"
	property string screenPath = "/ui/StarforceEffects/Center"
	property string tryRUID = "3d98d0b0453c444383849217bb7f031b"
	property string successRUID = "2ed0563b97a741ad9f64728ab9763897"
	property string failureRUID = "c25385f308af40a39a9df7b57e82385c"
	property number tryPlayRate = 3
	property number starPlayRate = 4
	property number successPlayRate = 2
	property number tryScale = 0.6
	property number successScale = 1.7
	property number starScale = 0.4
	property Vector2 starCoreOffset = Vector2(12, -10)

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Own only visual state: inventory, meso and persistence stay in EnhancementManager.
		self.busy = false
		self.displayedLevel = -1
		self._T.jobs = {}
		self._T.connections = {}
		self._T.ready = false
		self._T.starting = false
		self._T.totalTime = 0
		self._T.alive = true
		self._T.sequence = 0
		self._T.frameGroups = {}
		self._T.visibleFrames = {}
		self._T.frameWarmups = {}
		self._T.resourcesLoaded = false
		self._T.summarySounds = {"8b4cd62a5a6c467e993c7069a91e2691", "309eeb25de994445b1071cbe23c61d81", "9b9b02aa20a44adf8a762d1725aa5f6f", "ef894263660943afa0f0df8944b86d89", "2f367836f204400fb5df880d387c5523"}
		self._T.highSounds = {"9f5d1b04026d483cb1960451187bc6f9", "20a5b2a3254e436a8cbaf621676f0190", "1dd326f4fb674f8b8bd7639d2427e8fa", "b7fbd873b97449a6b970aafe5ad26b54", "666b488e72af4a308852e1dd143da17f"}
		self._T.successSound = "9912a4a56e644e3fa3e3d77cb0bcbb90"
		-- 1.5x source gain with peak limiting; PlaySound itself is capped at volume 1.
		self._T.destroySound = "23709ac4583749198799d4f5e1be4582"
		self._T.destroyItemSound = "7d78666acb234f6fbdfb6d68bd709d2a"
		-- Supplied 2026-09-21: preserve source dimensions and ori.txt registration.
		-- Complete 0..8 sequence, including supplied missing frames 6/7 and their ori.txt origins.
		self._T.successTextFrames = {
			{ruid="6a675c393dc8473dbc16b09a4af609fc", w=312, h=68, ox=161, oy=34, index=0},
			{ruid="2e67be36b8b24832b0ff0a81e8797ec8", w=876, h=320, ox=435, oy=280, index=1},
			{ruid="8c24064567d546728c4f800ce9ca1858", w=876, h=320, ox=435, oy=280, index=2},
			{ruid="7bf86dff64d34f22b792a118f6ee5ae7", w=876, h=320, ox=435, oy=280, index=3},
			{ruid="00d6624eb9e34dcb85748380db7347ec", w=876, h=320, ox=435, oy=280, index=4},
			{ruid="52398747810c4ae09dc929fea8214d07", w=872, h=284, ox=430, oy=250, index=5},
			{ruid="f140026af9444e0e9a6d59fb8d763a0e", w=824, h=268, ox=412, oy=233, index=6},
			{ruid="a570eabc0eff402eb2701d6845eaf7ea", w=772, h=248, ox=392, oy=211, index=7},
			{ruid="201eeae4d5224cd3906ffaeb667d39db", w=268, h=68, ox=139, oy=34, index=8}
		}
		self._T.starFillFrames = {
			{ruid="b36733d3614a49cfa2e4791f8717f181", w=155, h=188, ox=68, oy=85, index=0},
			{ruid="119bf52164c4419c95b6908c0a38e765", w=137, h=158, ox=56, oy=69, index=1},
			{ruid="096ebfb8db2f4c3bb9ff30773e67dda0", w=144, h=144, ox=60, oy=61, index=2},
			{ruid="3a6efb4478e64b65899ba67ad464caa3", w=146, h=146, ox=61, oy=62, index=3},
			{ruid="bea62ab1e6ed40f49f44752b6d1c65ae", w=148, h=147, ox=62, oy=62, index=4},
			{ruid="4bd83166f99b4385905850431c81202b", w=141, h=141, ox=58, oy=60, index=5}
		}
		self._T.destroyTextFrames = {
			{ruid="78e7c365e193428fb8dffcd06bdeb135", w=528, h=304, ox=257, oy=163, index=0},
			{ruid="06d8549c2d154236bdea1de58ccfc364", w=524, h=304, ox=247, oy=163, index=1},
			{ruid="21a56956e51249efa818845353154424", w=520, h=300, ox=238, oy=162, index=2},
			{ruid="b879b5cd792c4ff3afe1f8e26d6a824e", w=512, h=296, ox=229, oy=160, index=3},
			{ruid="87b3f026a1bd4b2dad218068d8ad8220", w=504, h=292, ox=223, oy=159, index=4},
			{ruid="34b889a2b9bc4af9a950412857caebc1", w=500, h=288, ox=220, oy=159, index=5},
			{ruid="c10fa2db02fa4f1ba0135d13ee94356c", w=492, h=284, ox=214, oy=157, index=6},
			{ruid="4e497f1c93624dc4bdbc3d493881e142", w=488, h=284, ox=211, oy=156, index=7},
			{ruid="c2eb4db7a71b47f2879d8cfc89924917", w=484, h=284, ox=209, oy=156, index=8},
			{ruid="047d2b1ddcd74d6497b16e95a276a886", w=480, h=280, ox=208, oy=154, index=9},
			{ruid="6f6fc744cd1e4990ac45b327397316ef", w=456, h=252, ox=208, oy=141, index=10}
		}
		-- Frame 0 is absent; preserve the actual 1..16 indices from ori.txt.
		self._T.destroyItemFrames = {
			{ruid="735e69bdb6364f8bb2e60fb601dd2932", w=335, h=341, ox=166, oy=166, index=1},
			{ruid="7587551ebbe84f7d8692fea4800dae33", w=323, h=340, ox=163, oy=165, index=2},
			{ruid="ad5d0287a6ad47eba7086d30656e2acb", w=331, h=339, ox=159, oy=166, index=3},
			{ruid="0b9bddb352434b65838ab85364e20ace", w=336, h=335, ox=163, oy=167, index=4},
			{ruid="8752eecfa470432cb698bc3fdf9de11c", w=344, h=325, ox=166, oy=150, index=5},
			{ruid="a09bad62feba4064b36f2b9dd5f22826", w=346, h=335, ox=163, oy=163, index=6},
			{ruid="fa77f939dabe4b0592e76f63f0dc09c9", w=341, h=332, ox=167, oy=164, index=7},
			{ruid="b7865c9ca1d5438ca6313754a2c8a914", w=334, h=326, ox=163, oy=159, index=8},
			{ruid="6ebba79425024b7d97eb8fb762616f8f", w=327, h=317, ox=158, oy=146, index=9},
			{ruid="10e7e0211a4e492c833b1685bfee4369", w=331, h=321, ox=160, oy=148, index=10},
			{ruid="217d29670d124d069efe7207e209df4b", w=335, h=322, ox=162, oy=148, index=11},
			{ruid="7b2235a36be4468b928e06627de091ac", w=339, h=326, ox=164, oy=150, index=12},
			{ruid="b20fad7c58b8462587020112dfa8c5a2", w=331, h=323, ox=161, oy=155, index=13},
			{ruid="5922e004c94f4e268fc3ca9932c63832", w=335, h=325, ox=163, oy=155, index=14},
			{ruid="936f7109d2a84325ab08eb93019e0ab3", w=313, h=323, ox=144, oy=153, index=15},
			{ruid="99a3b49c214f4420bf378a5b6a61cb38", w=309, h=316, ox=145, oy=154, index=16}
		}
		self._T.paths = {
			self.itemPath .. "/TryFx1", self.itemPath .. "/TryFx2",
			self.itemPath .. "/ResultFx", self.itemPath .. "/DestroyFx",
			self.itemPath .. "/DestroyLeadIn", self.starPath .. "/StarFillFx",
			self.screenPath .. "/SuccessFx", self.screenPath .. "/DestroyFx"
		}
		for _, path in ipairs(self._T.paths) do
			local entity = _EntityService:GetEntityByPath(path)
			if isvalid(entity) then
				entity.Enable = false
				local capturedPath = path
				local eventHandler = entity:ConnectEvent(SpriteGUIAnimPlayerEndEvent, function()
					self:CompleteClip(capturedPath)
				end)
				table.insert(self._T.connections, {entity=entity, eventHandler=eventHandler})
				local startHandler = entity:ConnectEvent(SpriteGUIAnimPlayerStartEvent, function()
					self:StartClip(capturedPath)
				end)
				local frameHandler = entity:ConnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, function(event)
					self:UpdateClipFrame(capturedPath, event.FrameIndex, event.TotalFrameCount)
				end)
				table.insert(self._T.connections, {entity=entity, startHandler=startHandler, frameHandler=frameHandler})
			end
		end
		self:PrepareFrames(self.screenPath .. "/DestroyFx", self._T.destroyTextFrames, 2)
		self:PrepareFrames(self.itemPath .. "/DestroyFx", self._T.destroyItemFrames, 1.2)
		-- Lettering: SUCCESS 45px * 1.7 ~= DESTROYED 38px * 2; ignore surrounding rays.
		self:PrepareFrames(self.screenPath .. "/SuccessFx", self._T.successTextFrames, self.successScale)
		self:PrepareFrames(self.starPath .. "/StarFillFx", self._T.starFillFrames, self.starScale)
		local lead = _EntityService:GetEntityByPath(self.itemPath .. "/DestroyLeadIn")
		if isvalid(lead) then
			lead.UITransformComponent.Pivot = Vector2(129 / 269, 1 - 142 / 312)
			lead.UITransformComponent.RectSize = Vector2(322.8, 374.4)
			lead.UITransformComponent.anchoredPosition = Vector2.zero
			lead.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.None
		end
		local resources = {self.tryRUID, self.successRUID, self.failureRUID,
			self._T.successSound, self._T.destroySound, self._T.destroyItemSound, "bb981266810a4d65b59687af9b6bafe5"}
		for _, id in ipairs(self._T.summarySounds) do table.insert(resources, id) end
		for _, id in ipairs(self._T.highSounds) do table.insert(resources, id) end
		for _, frame in ipairs(self._T.destroyTextFrames) do table.insert(resources, frame.ruid) end
		for _, frame in ipairs(self._T.destroyItemFrames) do table.insert(resources, frame.ruid) end
		for _, frame in ipairs(self._T.successTextFrames) do table.insert(resources, frame.ruid) end
		for _, frame in ipairs(self._T.starFillFrames) do table.insert(resources, frame.ruid) end
		_ResourceService:PreloadAsync(resources, function(results)
			if not self._T.alive then return end
			for index, status in pairs(results) do
				if status ~= PreloadResultStatus.Success then
					log_warning("[StarforceFX] preload failed index=" .. tostring(index) .. " status=" .. tostring(status))
					return
				end
			end
			self._T.resourcesLoaded = true
			log("[StarforceFX] textures loaded; waiting for active renderer layouts")
		end)
	end

	@ExecSpace("ClientOnly")
	method boolean Begin(integer level, any onResolve)
		-- Lock before one attempt flash; currency is not charged until onResolve.
		if self.busy or self._T.starting then return false end
		if not self:AreFramesReady(true) then
			_EnhancementManager:AppendLog("강화 이펙트를 불러오는 중입니다. 잠시 후 다시 시도하세요.")
			return false
		end
		self._T.starting = true
		self._T.sequence = self._T.sequence + 1
		self.displayedLevel = level
		self._T.resolve = onResolve
		self._T.destroyed = false
		self._T.rebuySlot = 0
		self._T.pendingFinish = false
		self._T.totalTime = 0
		self._T.fillLevel = nil
		self._T.starFilled = false
		self._T.scrollResult = false
		self._T.attemptSound = self:GetFillSound(level + 1)
		self.busy = true
		self._T.starting = false
		self:SetStatus("강화 중…")
		self:PlayClip(self.itemPath .. "/TryFx1", self.tryRUID, 1, function()
			log("[StarforceFX] attempt 1/1 completed")
			local resolve = self._T.resolve
			self._T.resolve = nil
			if resolve then resolve() end
		end)
		log("[StarforceFX] begin level=" .. tostring(level))
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean BeginScroll(integer level)
		-- Reserve the item preview before a scroll transaction can remove the equipment.
		if self.busy or self._T.starting or not self:AreFramesReady(false) then return false end
		self._T.starting = true
		self._T.sequence = self._T.sequence + 1
		self.displayedLevel = level
		self._T.resolve = nil
		self._T.destroyed = false
		self._T.rebuySlot = 0
		self._T.pendingFinish = false
		self._T.totalTime = 0
		self._T.fillLevel = nil
		self._T.starFilled = false
		self._T.scrollResult = true
		-- Publish busy only after every field read by OnUpdate has been initialized.
		self.busy = true
		self._T.starting = false
		log("[StarforceFX] scroll result reserved level=" .. tostring(level))
		return true
	end

	@ExecSpace("ClientOnly")
	method void PlayClip(string path, string ruid, number duration, any onDone)
		-- Onetime animation completion drives the sequence; watchdog prevents a stuck UI.
		if not self.busy then return end
		local sequence = self._T.sequence
		local entity = _EntityService:GetEntityByPath(path)
		if not isvalid(entity) then
			log_error("[StarforceFX] missing entity " .. path)
			self:Cancel()
			return
		end
		entity.Enable = false
		local renderer = entity.SpriteGUIRendererComponent
		local transform = entity.UITransformComponent
		local playRate = 1
		if ruid == self.tryRUID then
			playRate = self.tryPlayRate
			local icon = _EntityService:GetEntityByPath(self.itemPath .. "/TargetIcon")
			local center = isvalid(icon) and icon.UITransformComponent.anchoredPosition or Vector2.zero
			-- Native pivot is below the ring: its visual center is (12, 139) from origin.
			-- Preserve native frame registration instead of independently fitting each frame.
			transform.RectSize = Vector2(312, 306)
			transform.UIScale = Vector3(self.tryScale, self.tryScale, 1)
			transform.anchoredPosition = center - Vector2(12, 139) * self.tryScale
			renderer.PreserveSprite = PreserveSpriteType.NativeSize
		end
		renderer.ImageRUID = DataRef(ruid)
		renderer.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
		renderer.StartFrameIndex = 0
		renderer.EndFrameIndex = 2147483647
		renderer.PlayRate = playRate
		renderer.Color = Color.white
		if not self.busy or self._T.sequence ~= sequence then return end
		self._T.jobs[path] = {entity=entity, ruid=ruid, duration=duration / playRate, remaining=5, onDone=onDone, started=false, textSoundPlayed=false}
		entity.Enable = true
		log("[StarforceFX] clip start " .. path .. " ruid=" .. ruid .. " speed=" .. tostring(playRate))
	end

	@ExecSpace("ClientOnly")
	method void StartClip(string path)
		-- Match audio to native playback, not to an asynchronous resource assignment.
		local job = self._T.jobs[path]
		if not self.busy or job == nil or job.started then return end
		job.started = true
		-- Loading/renderer activation time is not part of the clip's playback duration.
		job.remaining = job.duration + 0.5
		if job.ruid == self.tryRUID then
			_SoundService:PlaySound(self._T.attemptSound, 0.7)
			log("[StarforceFX] attempt sound=" .. self._T.attemptSound .. " volume=0.7")
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateClipFrame(string path, integer frameIndex, integer totalFrames)
		-- Keep native attempt/item clips synchronized; supplied frame sequences use elapsed time.
		local job = self._T.jobs[path]
		if not self.busy or job == nil or job.frames ~= nil then return end
		self:StartClip(path)
	end

	@ExecSpace("ClientOnly")
	method void FillStar()
		-- Fill once while the flash is still playing; end-of-clip is a fallback only.
		if not self.busy or self._T.starFilled or self._T.fillLevel == nil then return end
		self._T.starFilled = true
		local level = self._T.fillLevel
		self.displayedLevel = level
		_EnhancementManager:UpdateStarforceUI(level)
		log("[StarforceFX] star filled=" .. tostring(level) .. " progress=0.6 sound=none")
	end

	@ExecSpace("ClientOnly")
	method void CompleteClip(string path)
		-- Remove the job before invoking a callback to make completion idempotent.
		local job = self._T.jobs[path]
		if job == nil then return end
		self._T.jobs[path] = nil
		if isvalid(job.entity) then
			if job.frames ~= nil then
				self:HideFrameGroup(path)
			else
				job.entity.Enable = false
				job.entity.SpriteGUIRendererComponent.ImageRUID = DataRef("")
			end
		end
		log("[StarforceFX] clip end " .. path)
		if job.onDone ~= nil then job.onDone() end
	end

	@ExecSpace("ClientOnly")
	method void ShowResult(string result, integer nextLevel, integer rebuySlot)
		-- Show the committed outcome without re-running or changing the enhancement roll.
		if not self.busy then return end
		self._T.resolve = nil
		self._T.rebuySlot = rebuySlot
		log("[StarforceFX] result=" .. result .. " next=" .. tostring(nextLevel))
		if result == "success" then
			self:SetStatus("강화 성공!")
			self:PlayFrames(self.screenPath .. "/SuccessFx", self._T.successTextFrames, 1.23 / self.successPlayRate, false)
			self:PlayClip(self.itemPath .. "/ResultFx", self.successRUID, 0.48, nil)
			-- Start the star with the result, without waiting for the item flash to finish.
			if not self._T.scrollResult then
				local star = _EntityService:GetEntityByPath(self.starPath .. "/Star_" .. tostring(nextLevel))
				local flash = _EntityService:GetEntityByPath(self.starPath .. "/StarFillFx")
				if not isvalid(star) or not isvalid(flash) then self:Cancel() return end
				-- Both are siblings. Register the PNG's bright core, not its old clip origin.
				flash.UITransformComponent.anchoredPosition = star.UITransformComponent.anchoredPosition - self.starCoreOffset * self.starScale
				self._T.fillLevel = nextLevel
				self:PlayFrames(self.starPath .. "/StarFillFx", self._T.starFillFrames, 1.8 / self.starPlayRate, true)
			end
			self._T.pendingFinish = true
		elseif result == "destroy" then
			self:SetStatus("장비 파괴")
			-- Publish the running flag last: first-use native calls may yield to OnUpdate.
			self._T.destroyElapsed = 0
			self._T.lastTextFrame = 1
			self._T.lastItemFrame = 0
			local text = _EntityService:GetEntityByPath(self.screenPath .. "/DestroyFx")
			if isvalid(text) and isvalid(text.CanvasGroupComponent) then text.CanvasGroupComponent.GroupAlpha = 1 end
			self:DrawFrame(self.screenPath .. "/DestroyFx", self._T.destroyTextFrames[1])
			local lead = _EntityService:GetEntityByPath(self.itemPath .. "/DestroyLeadIn")
			if isvalid(lead) then lead.Enable = true end
			self._T.destroyed = true
			log("[StarforceFX] destroy: both 1.5x-gain sounds started, fixed ori.txt frames started")
			_SoundService:PlaySound(self._T.destroySound, 1)
			_SoundService:PlaySound(self._T.destroyItemSound, 1)
		else
			self:SetStatus(result == "drop" and "강화 실패 · 단계 하락" or "강화 실패 · 단계 유지")
			self:PlayClip(self.itemPath .. "/ResultFx", self.failureRUID, 0.84, function()
				self.displayedLevel = nextLevel
				if not self._T.scrollResult then _EnhancementManager:UpdateStarforceUI(nextLevel) end
				self._T.pendingFinish = true
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method string GetFillSound(integer level)
		-- Tiers use the attained level; 28+ keeps the fifth high-tier sound.
		if level <= 15 then
			return self._T.summarySounds[math.max(1, math.min(5, math.ceil(level / 3)))]
		end
		return self._T.highSounds[math.max(1, math.min(5, math.ceil((level - 15) / 3)))]
	end

	@ExecSpace("ClientOnly")
	method void PrepareFrames(string path, table frames, number scale)
		-- Keep immutable frame renderers alive; show/hide pixels, not their native lifecycle.
		local group = _EntityService:GetEntityByPath(path)
		if not isvalid(group) then return end
		group.CanvasGroupComponent.GroupAlpha = 0
		group.UITransformComponent.anchoredPosition = Vector2.zero
		if isvalid(group.SpriteGUIRendererComponent) then group.SpriteGUIRendererComponent.Enable = false end
		local entries = {}
		for _, frame in ipairs(frames) do
			local entity = _EntityService:GetEntityByPath(path .. "/Frame_" .. tostring(frame.index))
			if not isvalid(entity) then
				log_error("[StarforceFX] missing prepared frame " .. path .. "/Frame_" .. tostring(frame.index))
				return
			end
			entity.SpriteGUIRendererComponent:SetAlpha(0)
			local transform = entity.UITransformComponent
			transform.Pivot = Vector2(frame.ox / frame.w, 1 - frame.oy / frame.h)
			transform.RectSize = Vector2(frame.w * scale, frame.h * scale)
			transform.anchoredPosition = Vector2.zero
			entity.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.None
			entity.Enable = true
			entries[frame.index] = entity
		end
		self._T.frameGroups[path] = entries
		self._T.frameWarmups[path] = {group=group, frames=frames, scale=scale, elapsed=0, ticks=0, applied=false, ready=false}
		group.Enable = true
		log("[StarforceFX] fixed-origin frames=" .. tostring(#frames) .. " scale=" .. tostring(scale) .. " path=" .. path)
	end

	@ExecSpace("ClientOnly")
	method void UpdateFrameWarmups(number delta)
		-- Inactive enhancement tabs cannot warm up: count only real active UI frames.
		if not self._T.resourcesLoaded then return end
		for path, warmup in pairs(self._T.frameWarmups or {}) do
			if not warmup.ready and isvalid(warmup.group) and warmup.group.EnabledInHierarchy then
				warmup.elapsed = warmup.elapsed + delta
				warmup.ticks = warmup.ticks + 1
				if warmup.elapsed >= 0.12 and warmup.ticks >= 4 then
					if not warmup.applied then
						-- Apply registration AFTER first activation/resource initialization has settled.
						for _, frame in ipairs(warmup.frames) do
							local entity = self._T.frameGroups[path][frame.index]
							entity.SpriteGUIRendererComponent.PreserveSprite = PreserveSpriteType.None
							local transform = entity.UITransformComponent
							transform.Pivot = Vector2(frame.ox / frame.w, 1 - frame.oy / frame.h)
							transform.RectSize = Vector2(frame.w * warmup.scale, frame.h * warmup.scale)
							transform.anchoredPosition = Vector2.zero
						end
						warmup.applied = true
						warmup.elapsed = 0
						warmup.ticks = 0
					else
						warmup.ready = true
						log("[StarforceFX] active frame layout ready count=" .. tostring(#warmup.frames) .. " path=" .. path)
					end
				end
			end
		end
		self._T.ready = self:AreFramesReady(false)
	end

	@ExecSpace("ClientOnly")
	method boolean AreFramesReady(boolean includeStar)
		-- A transaction may start only when every renderer used by its outcomes is prepared.
		if not self._T.resourcesLoaded then return false end
		local count = 0
		for path, warmup in pairs(self._T.frameWarmups or {}) do
			count = count + 1
			if (includeStar or path ~= self.starPath .. "/StarFillFx") and not warmup.ready then return false end
		end
		return count == 4
	end

	@ExecSpace("ClientOnly")
	method void HideFrameGroup(string path)
		-- Leave native renderers initialized between attempts without visible pixels/input.
		local group = _EntityService:GetEntityByPath(path)
		if isvalid(group) then group.CanvasGroupComponent.GroupAlpha = 0 end
		local previous = self._T.visibleFrames[path]
		if isvalid(previous) then previous.SpriteGUIRendererComponent:SetAlpha(0) end
		self._T.visibleFrames[path] = nil
	end

	@ExecSpace("ClientOnly")
	method void DrawFrame(string path, table frame)
		-- Select cached pixels without re-enabling/reloading a frame on its first use.
		local entries = self._T.frameGroups[path]
		local entity = entries and entries[frame.index] or nil
		if not isvalid(entity) then return end
		local previous = self._T.visibleFrames[path]
		if isvalid(previous) then previous.SpriteGUIRendererComponent:SetAlpha(0) end
		entity.SpriteGUIRendererComponent:SetAlpha(1)
		self._T.visibleFrames[path] = entity
		local group = _EntityService:GetEntityByPath(path)
		if isvalid(group) then group.CanvasGroupComponent.GroupAlpha = 1 end
	end

	@ExecSpace("ClientOnly")
	method void PlaySuccessSound()
		-- One shared cue for the Starforce success text and newly rerolled options.
		_SoundService:PlaySound(self._T.successSound, 1)
		log("[EnhanceSFX] success sound=" .. self._T.successSound)
	end

	@ExecSpace("ClientOnly")
	method void PlayFrames(string path, table frames, number duration, boolean fillsStar)
		-- Play immutable PNG frames at their registered origin; no asynchronous RUID swaps.
		if not self.busy then return end
		local group = _EntityService:GetEntityByPath(path)
		if not isvalid(group) or self._T.frameGroups[path] == nil or #frames == 0 then
			log_error("[StarforceFX] missing frame sequence " .. path)
			self:Cancel()
			return
		end
		group.CanvasGroupComponent.GroupAlpha = 1
		local onDone = nil
		if fillsStar then onDone = function() self:FillStar() end end
		self._T.jobs[path] = {entity=group, frames=frames, duration=duration, elapsed=0,
			remaining=duration + 0.5, lastFrame=1, fillsStar=fillsStar, onDone=onDone, started=true}
		self:DrawFrame(path, frames[1])
		if not fillsStar then
			self:PlaySuccessSound()
			log("[StarforceFX] SUCCESS supplied text visible; sound=" .. self._T.successSound)
		end
		log("[StarforceFX] supplied frames start count=" .. tostring(#frames) .. " duration=" .. tostring(duration) .. " path=" .. path)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Advance only local presentation; never mutate inventory or currency from this tick.
		self:UpdateFrameWarmups(delta)
		if not self.busy then return end
		local window = _EntityService:GetEntityByPath("/ui/DefaultGroup/EnhanceWindow")
		if not isvalid(window) or not window.EnabledInHierarchy or _LoginFlow.phase ~= "ingame" then
			self:Cancel()
			return
		end
		self._T.totalTime = self._T.totalTime + delta
		if self._T.totalTime > 15 then self:Cancel() return end
		-- A cold texture upload/frame hitch must not jump straight past the opening frames.
		local visualDelta = math.max(0, math.min(delta, 0.05))
		local expired = {}
		local finishedFrames = {}
		for path, job in pairs(self._T.jobs) do
			if job.frames ~= nil then
				job.elapsed = math.min(job.duration, job.elapsed + visualDelta)
				local progress = job.elapsed / job.duration
				local frameIndex = math.min(#job.frames, math.floor(progress * #job.frames) + 1)
				if frameIndex ~= job.lastFrame then
					self:DrawFrame(path, job.frames[frameIndex])
					job.lastFrame = frameIndex
				end
				if job.fillsStar and progress >= 0.6 then self:FillStar() end
				-- Fade the final supplied image continuously, including the missing text 6/7 gap.
				local fade = math.max(0, math.min(1, (progress - 0.7) / 0.3))
				job.entity.CanvasGroupComponent.GroupAlpha = 1 - fade * fade * (3 - 2 * fade)
				if progress >= 1 then table.insert(finishedFrames, path) end
			else
				job.remaining = job.remaining - delta
				if job.remaining <= 0 then table.insert(expired, path) end
			end
		end
		for _, path in ipairs(finishedFrames) do
			log("[StarforceFX] supplied frames complete alpha=0 path=" .. path)
			self:CompleteClip(path)
		end
		for _, path in ipairs(expired) do
			log_warning("[StarforceFX] animation watchdog " .. path)
			self:CompleteClip(path)
		end
		if self._T.destroyed then
			local elapsed = self._T.destroyElapsed + visualDelta
			self._T.destroyElapsed = elapsed
			local textIndex = math.min(11, math.floor(elapsed / 0.09) + 1)
			if textIndex ~= self._T.lastTextFrame then
				self:DrawFrame(self.screenPath .. "/DestroyFx", self._T.destroyTextFrames[textIndex])
				self._T.lastTextFrame = textIndex
			end
			-- Keep fading while the final supplied frame is held: no partial-opacity plateau.
			local text = _EntityService:GetEntityByPath(self.screenPath .. "/DestroyFx")
			local fade = math.max(0, math.min(1, (elapsed - 0.54) / 1.11))
			local alpha = 1 - fade * fade * (3 - 2 * fade)
			if isvalid(text) and isvalid(text.CanvasGroupComponent) then text.CanvasGroupComponent.GroupAlpha = alpha end
			if elapsed >= 0.06 and elapsed < 1.02 then
				local lead = _EntityService:GetEntityByPath(self.itemPath .. "/DestroyLeadIn")
				if isvalid(lead) then lead.Enable = false end
				local itemIndex = math.min(16, math.floor((elapsed - 0.06) / 0.06) + 1)
				if itemIndex ~= self._T.lastItemFrame then
					self:DrawFrame(self.itemPath .. "/DestroyFx", self._T.destroyItemFrames[itemIndex])
					self._T.lastItemFrame = itemIndex
				end
			end
			if elapsed >= 1.02 then
				self:HideFrameGroup(self.itemPath .. "/DestroyFx")
				local icon = _EntityService:GetEntityByPath(self.itemPath .. "/TargetIcon")
				if isvalid(icon) then icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0) end
			end
			if elapsed >= 1.65 then
				log("[StarforceFX] destroy frames complete: text=11 item=16 alpha=" .. tostring(alpha))
				self:Finish()
			end
		elseif self._T.pendingFinish and next(self._T.jobs) == nil then
			self:Finish()
		end
	end

	@ExecSpace("ClientOnly")
	method void SetStatus(string message)
		-- Keep the enhancement button readable while repeat input is locked.
		local status = _EntityService:GetEntityByPath(self.starPath .. "/PresentationStatus")
		if isvalid(status) then
			status.UITransformComponent.anchoredPosition = Vector2(0, -230)
			status.UITransformComponent.RectSize = Vector2(460, 22)
			status.TextGUIRendererComponent.Text = message
			status.Enable = message ~= ""
		end
	end

	@ExecSpace("ClientOnly")
	method void HideEffects()
		-- Clear clip IDs between attempts so the next attempt restarts at frame zero.
		-- Invalidate callbacks before touching native renderers, which can emit end events.
		self._T.sequence = (self._T.sequence or 0) + 1
		self._T.jobs = {}
		self._T.resolve = nil
		self._T.starting = false
		self._T.fillLevel = nil
		_EnhancementManager._T.starforceCommitPending = false
		for path, _ in pairs(self._T.frameGroups or {}) do self:HideFrameGroup(path) end
		for _, path in ipairs(self._T.paths or {}) do
			local entity = _EntityService:GetEntityByPath(path)
			if isvalid(entity) and self._T.frameGroups[path] == nil then
				entity.Enable = false
				if self._T.frameGroups[path] == nil and not string.find(path, "Destroy") then
					entity.SpriteGUIRendererComponent.ImageRUID = DataRef("")
				end
			end
		end
		self:SetStatus("")
	end

	@ExecSpace("ClientOnly")
	method void Finish()
		-- Release the UI only after all outcome visuals; rebuy is shown after destruction.
		local destroyed = self._T.destroyed
		local slot = self._T.rebuySlot or 0
		self:HideEffects()
		self.busy = false
		self.displayedLevel = -1
		self._T.destroyed = false
		self._T.pendingFinish = false
		if destroyed then
			_EnhancementManager:ClearTarget()
			if _EnhancementManager:IsEnhanceableSlot(slot) then _EnhancementManager:ShowRebuyDialog(slot) end
		else
			_EnhancementManager:RefreshCurrentTarget()
		end
		log("[StarforceFX] completed; input unlocked")
	end

	@ExecSpace("ClientOnly")
	method void Cancel()
		-- Before resolve: no charge. After resolve: retain committed data and refresh its view.
		self._T.rebuySlot = 0
		self:Finish()
		log("[StarforceFX] presentation cancelled")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- No deferred callbacks or listeners may leak into the next play session.
		self._T.alive = false
		self:HideEffects()
		self.busy = false
		self.displayedLevel = -1
		for _, connection in ipairs(self._T.connections or {}) do
			if isvalid(connection.entity) then
				if connection.eventHandler then connection.entity:DisconnectEvent(SpriteGUIAnimPlayerEndEvent, connection.eventHandler) end
				if connection.startHandler then connection.entity:DisconnectEvent(SpriteGUIAnimPlayerStartEvent, connection.startHandler) end
				if connection.frameHandler then connection.entity:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, connection.frameHandler) end
			end
		end
		self._T.connections = {}
	end
end
